Name: myx.distro-agents
Title: magic-team & its tooling, installation and integration package
Augments: developer-sdk:recommended

Declares: \
	distro-image-sync:source-prepare-pull:repo:myx/myx.distro-agents:main:git@github.com:myx/myx.distro-agents.git \
	magic-team:permissions:workspace:*:allow-write:*:source/**/MAGIC.md \
	magic-team:permissions:workspace:*:allow-write:*:.local/temp/** \
	magic-team:permissions:workspace:*:allow-tool:magic-architect:WebFetch \
	magic-team:permissions:workspace:*:allow-tool:magic-architect:WebSearch \
	magic-team:permissions:workspace:*:allow-read:magic-tester:source/**/sh-test/** \
	magic-team:permissions:workspace:*:allow-read:magic-tester:source/**/test/** \
	magic-team:permissions:workspace:*:allow-read:magic-tester:source/**/tests/** \
	magic-team:permissions:workspace:*:allow-read:magic-tester:.local/myx/** \
	magic-team:permissions:workspace:*-testbed:allow-write:magic-tester:** \

Requires: \
	myx/myx.distro-source \

Provides: \
	myx/myx.distro-agents \

