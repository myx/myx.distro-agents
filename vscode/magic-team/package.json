{
  "name": "magic-team-panel",
  "displayName": "The Conclave",
  "publisher": "myx",
  "version": "0.0.2",
  "private": true,
  "engines": {
    "vscode": "^1.74.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onView:magic-team.conclave"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "magic-team",
          "title": "The Conclave",
          "icon": "$(organization)"
        }
      ]
    },
    "views": {
      "magic-team": [
        {
          "type": "webview",
          "id": "magic-team.conclave",
          "name": "The Conclave"
        }
      ]
    }
  }
}
