#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.InternTeamDataFinalGcDeletion.include -- the
## --intern-team-data-final-gc-deletion op for DistroAgentsTools.fn.sh's
## dispatcher. Sourced lazily from that exact op's own dispatcher arm via the
## standard $MDLT_ORIGIN-based path. Not standalone: relies on being
## dot-sourced for $1/$@/$MDSC_CMD.
##

AgentsToolsFinalGcScanDir(){
	local scanDir="$1" nowEpoch="$2"
	local path fileBase thresholdDays fileMtime ageSeconds thresholdSeconds
	for path in "$scanDir"/*.md ; do
		[ -f "$path" ] || continue
		fileBase="${path##*/}"
		case "$fileBase" in
			warning-*|reflection-*) thresholdDays=1 ;;
			*)                      thresholdDays=7 ;;
		esac
		fileMtime="$( stat -f '%m' "$path" 2>/dev/null || stat -c '%Y' "$path" 2>/dev/null )"
		[ -z "$fileMtime" ] && continue
		ageSeconds=$(( nowEpoch - fileMtime ))
		thresholdSeconds=$(( thresholdDays * 86400 ))
		[ "$ageSeconds" -lt "$thresholdSeconds" ] && continue
		if ! rm -f -- "$path" ; then
			gcScanFailedPath="$path"
			return 1
		fi
		gcDeletedCount=$(( gcDeletedCount + 1 ))
		gcDeletedPaths+=( "$path" )
	done
	return 0
}

case "$1" in

	--intern-team-data-final-gc-deletion)
		shift
		local opContext="<no --context given>"
		local ctxWanted="" ctxArg
		for ctxArg in "$@" ; do
			if [ -n "$ctxWanted" ] ; then opContext="$ctxArg" ; ctxWanted="" ; continue ; fi
			[ "$ctxArg" = "--context" ] && ctxWanted="1"
		done

		local callingMember="$1"
		shift || true
		if [ -z "$callingMember" ] ; then
			echo "$MDSC_CMD: team-data-final-gc-deletion: ⛔ ERROR: syntax is <team-member> [--context <caller-op>]" >&2
			set +e ; return 1
		fi
		if [ "$1" = "--context" ] ; then
			if [ -z "${2:-}" ] ; then
				echo "$MDSC_CMD: team-data-final-gc-deletion: ⛔ ERROR: --context: value required" >&2
				set +e ; return 1
			fi
			shift 2
		fi
		if [ $# -gt 0 ] ; then
			echo "$MDSC_CMD: team-data-final-gc-deletion: ⛔ ERROR: invalid option: $1" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$callingMember" "<team-member>" team-data-final-gc-deletion || { set +e ; return 1 ; }
		[ -n "${MDAT_DATA_ROOT:-}" ] || {
			echo "$MDSC_CMD: team-data-final-gc-deletion: ⛔ ERROR: MDAT_DATA_ROOT is not set" >&2
			set +e ; return 1
		}

		local nowEpoch ; nowEpoch="$( date +%s )"
		local gcDeletedPaths=() gcDeletedCount=0 gcScanFailedPath=""
		local inboxDeletedCount=0 boardDeletedCount=0

		local inboxBase=""
		inboxBase="$( cd "$MDAT_DATA_ROOT/inboxes" 2>/dev/null && pwd -P )" || inboxBase=""
		if [ -n "$inboxBase" ] ; then
			local memberDir memberProcessed
			for memberDir in "$inboxBase"/*/ ; do
				[ -d "$memberDir" ] || continue
				memberProcessed="$( cd "${memberDir}processed" 2>/dev/null && pwd -P )" || memberProcessed=""
				[ -z "$memberProcessed" ] && continue
				case "$memberProcessed" in
					"$inboxBase"/*) ;;
					*)
						echo "$MDSC_CMD: team-data-final-gc-deletion: ⚠️ WARNING: skipping $memberProcessed -- escapes inbox root $inboxBase" >&2
						continue
					;;
				esac
				gcDeletedCount=0
				if ! AgentsToolsFinalGcScanDir "$memberProcessed" "$nowEpoch" ; then
					echo "$MDSC_CMD: team-data-final-gc-deletion: ⛔ ERROR: could not delete $gcScanFailedPath" >&2
					set +e ; return 1
				fi
				inboxDeletedCount=$(( inboxDeletedCount + gcDeletedCount ))
			done
		fi

		## Board source: one fixed folder, no per-member fan-out.
		local boardProcessed=""
		boardProcessed="$( cd "$MDAT_DATA_ROOT/board/processed" 2>/dev/null && pwd -P )" || boardProcessed=""
		if [ -n "$boardProcessed" ] ; then
			gcDeletedCount=0
			if ! AgentsToolsFinalGcScanDir "$boardProcessed" "$nowEpoch" ; then
				echo "$MDSC_CMD: team-data-final-gc-deletion: ⛔ ERROR: could not delete $gcScanFailedPath" >&2
				set +e ; return 1
			fi
			boardDeletedCount=$(( boardDeletedCount + gcDeletedCount ))
		fi

		echo "team-data-final-gc: $inboxDeletedCount inbox-items, $boardDeletedCount board-items deleted."

		if [ "${#gcDeletedPaths[@]}" -gt 0 ] ; then
			local repoRoot=""
			repoRoot="$( git -C "$MDAT_DATA_ROOT" rev-parse --show-toplevel 2>/dev/null )" || repoRoot=""
			if [ -n "$repoRoot" ] ; then
				local gitOut="" gitRc=0
				gitOut="$( git -C "$repoRoot" add -- "${gcDeletedPaths[@]}" 2>&1 )" || gitRc=$?
				if [ "$gitRc" -ne 0 ] ; then
					echo "$MDSC_CMD: team-data-final-gc-deletion: ⛔ ERROR: git add failed for deleted paths: $gitOut" >&2
					set +e ; return 1
				fi
				gitOut="$( git -C "$repoRoot" commit -m "- team-data-final-gc-deletion" -- "${gcDeletedPaths[@]}" 2>&1 )" || gitRc=$?
				if [ "$gitRc" -ne 0 ] ; then
					echo "$MDSC_CMD: team-data-final-gc-deletion: ⛔ ERROR: git commit failed for deleted paths: $gitOut" >&2
					set +e ; return 1
				fi
			fi
		fi

		if [ "$(( inboxDeletedCount + boardDeletedCount ))" -eq 0 ] ; then
			set +e ; return 2
		fi
		return 0
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
