#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

## AgentsHarnessMcpConfig.include -- how a registered MCP server resolves to a process:
## its command, args and env, and the workspace's server names. Sourced by
## AgentsHarnessMcpClient.sh, which launches servers, and by the installer
## (--install-vscode-integrations, --make-harness-indices), which writes the index.
##
## ONE SOURCE, OUR OWN: the servers our installer registers for a workspace, composed
## here by AgentsHarnessMcpServersPrimary exactly as --install-vscode-integrations
## composes them -- myx.distro from the workspace's own installed DistroAgentsTools.fn.sh,
## myx.common from the workspace's own installed myx.common, each with MMDAPP in its env.
## `.local/agents/mcp.servers.json`, `.mcp.json` and `.vscode/mcp.json` are outputs the
## installer writes from the same registration for external tools, and nothing here
## reads them back: a server added to one of them by hand is that tool's, not ours.
##
## THE INDEX, `.local/agents/mcp.servers.index`, is that composition already resolved,
## written by the installer on install and on every upgrade, so the harness reads it
## with `read` and builtins alone. It is used while it is of this format version, names
## this workspace, and was written by this file's own content (one cksum); otherwise, or
## with no index, the harness composes the same servers itself -- the same answer.
##
## Index format, version 2: one record per line, fields TAB-separated, every free-text
## field encoded for `printf '%b'` -- backslash doubled, newline as \n, TAB as \t:
##   myx.distro mcp.servers.index 2
##   sum <TAB> <the workspace and this file's cksum>
##   keys <TAB> <rc> <TAB> <the server names, newline-separated>
##   server <TAB> <name>                 then, for that server:
##   command <TAB> <rc> <TAB> <value>
##   args <TAB> <rc> <TAB> <count>       then <count> lines:  arg <TAB> <value>
##   env <TAB> <rc>                      then one line per key:  envpair <TAB> <key> <TAB> <value>
##   end

agentsMcpConfigHere="${harnessHere:-$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib}"
agentsMcpIndexHeader="myx.distro mcp.servers.index 2"

## What a resolution published, for the launcher.
harnessMcpResCmdRc=0
harnessMcpResCmd=""
harnessMcpResArgsRc=0
harnessMcpResArgs=()
harnessMcpResEnvRc=0
harnessMcpResEnvKeys=()
harnessMcpResEnvVals=()
harnessMcpResKeysRc=0
harnessMcpResKeys=""
## Where the servers came from, for the harness to say: the index, or computed.
harnessMcpFrom=""

## One value, encoded for `printf '%b'`, into harnessMcpEnc.
harnessMcpEnc=""
AgentsHarnessMcpEnc(){ ## text
	harnessMcpEnc="${1//\\/\\\\}"
	harnessMcpEnc="${harnessMcpEnc//$'\n'/\\n}"
	harnessMcpEnc="${harnessMcpEnc//$'\t'/\\t}"
}

## Its inverse, into harnessMcpDec. Never `printf -v` an empty result: bash 3.2 then
## leaves the buffer of the one before.
harnessMcpDec=""
AgentsHarnessMcpDec(){ ## encoded text
	harnessMcpDec=""
	[ -z "$1" ] || printf -v harnessMcpDec '%b' "$1"
}

## The whole content of one file as `read -d ''` gives it, into harnessMcpFileRaw;
## non-zero when there is no readable file.
harnessMcpFileRaw=""
AgentsHarnessMcpFileRaw(){ ## file
	harnessMcpFileRaw=""
	[ -f "$1" ] && [ -r "$1" ] || return 1
	IFS= read -r -d '' harnessMcpFileRaw < "$1" || :
}

## A server set under composition, in the index body's own record shape: the names in
## harnessMcpSpecNames (newline-separated), the records in harnessMcpSpec.
harnessMcpSpec=""
harnessMcpSpecNames=""
AgentsHarnessMcpSpecReset(){
	harnessMcpSpec=""
	harnessMcpSpecNames=""
}
## Adds one server: name, command, how many env pairs follow, the pairs, then the args.
AgentsHarnessMcpSpecAdd(){ ## name, command, env pair count, key, value, ..., args...
	local addName="$1" addCmd="$2" addEnvCount="$3" addEnv=""
	shift 3
	while [ "$addEnvCount" -gt 0 ] ; do
		AgentsHarnessMcpEnc "$1" ; addEnv="${addEnv}envpair"$'\t'"$harnessMcpEnc"
		AgentsHarnessMcpEnc "$2" ; addEnv="${addEnv}"$'\t'"$harnessMcpEnc"$'\n'
		shift 2
		addEnvCount=$(( addEnvCount - 1 ))
	done
	AgentsHarnessMcpEnc "$addName" ; harnessMcpSpec="${harnessMcpSpec}server"$'\t'"$harnessMcpEnc"$'\n'
	AgentsHarnessMcpEnc "$addCmd" ; harnessMcpSpec="${harnessMcpSpec}command"$'\t'"0"$'\t'"$harnessMcpEnc"$'\n'
	harnessMcpSpec="${harnessMcpSpec}args"$'\t'"0"$'\t'"$#"$'\n'
	while [ "$#" -gt 0 ] ; do
		AgentsHarnessMcpEnc "$1" ; harnessMcpSpec="${harnessMcpSpec}arg"$'\t'"$harnessMcpEnc"$'\n'
		shift
	done
	harnessMcpSpec="${harnessMcpSpec}env"$'\t'"0"$'\n'"$addEnv"
	harnessMcpSpecNames="${harnessMcpSpecNames:+$harnessMcpSpecNames$'\n'}$addName"
}

## THE PRIMARY COMPOSITION: the servers --install-vscode-integrations registers for this
## workspace when run from it ($MMDAPP), with the same command, args and env it writes,
## and under the same conditions -- each only where its server script is installed and
## executable.
AgentsHarnessMcpServersPrimary(){ ## workspace
	local primaryWs primaryCommon primaryDistro
	AgentsHarnessMcpSpecReset
	[ -n "$1" ] && [ -d "$1" ] || return 0
	primaryWs="$( cd "$1" && pwd )" || return 0
	primaryDistro="$1/.local/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
	primaryCommon="$primaryWs/.local/myx/myx.common/os-myx.common/host/tarball/share/myx.common/bin/lib/agentMcpServer.Common"
	[ ! -x "$primaryDistro" ] || AgentsHarnessMcpSpecAdd "myx.distro" "$primaryDistro" 1 MMDAPP "$primaryWs" --intern-mcp-server --run
	[ ! -x "$primaryCommon" ] || AgentsHarnessMcpSpecAdd "myx.common" "$primaryCommon" 1 MMDAPP "$primaryWs" --run
	return 0
}

## What an index vouches for, into harnessMcpSum: the workspace, and this file's cksum.
harnessMcpSum=""
AgentsHarnessMcpSum(){ ## workspace
	local sumCrc="" sumSize="" sumRest=""
	harnessMcpSum=""
	read -r sumCrc sumSize sumRest <<< "$( LC_ALL=C cksum "$agentsMcpConfigHere/AgentsHarnessMcpConfig.include" 2>/dev/null )"
	[ -n "$sumSize" ] || return 1
	harnessMcpSum="workspace=$1"$'\n'"code=$sumCrc $sumSize"
}

## The whole index for one workspace, on stdout: of the primary composition, or, given
## use-spec, of the servers the caller composed into harnessMcpSpec.
AgentsHarnessMcpIndexText(){ ## workspace [use-spec]
	AgentsHarnessMcpSum "$1" || return 1
	[ "${2:-}" = use-spec ] || AgentsHarnessMcpServersPrimary "$1"
	printf '%s\n' "$agentsMcpIndexHeader"
	AgentsHarnessMcpEnc "$harnessMcpSum" ; printf 'sum\t%s\n' "$harnessMcpEnc"
	AgentsHarnessMcpEnc "$harnessMcpSpecNames" ; printf 'keys\t0\t%s\n' "$harnessMcpEnc"
	printf '%send\n' "$harnessMcpSpec"
}

## Writes a workspace's index atomically. Non-zero only when writing failed.
AgentsHarnessMcpIndexWrite(){ ## workspace [use-spec]
	local writeIndex="$1/.local/agents/mcp.servers.index" writeTmp
	mkdir -p "$1/.local/agents" || return 1
	writeTmp="$writeIndex.tmp.$$"
	AgentsHarnessMcpIndexText "$1" "${2:-}" > "$writeTmp" || { rm -f "$writeTmp" ; return 1 ; }
	chmod 644 "$writeTmp" && mv -f "$writeTmp" "$writeIndex" || { rm -f "$writeTmp" ; return 1 ; }
}

## The loaded table.
harnessMcpIndexKeysRc=0
harnessMcpIndexKeys=""
harnessMcpIndexNames=()
harnessMcpIndexLines=()
harnessMcpIndexAt=()
## The workspace and index file state the table was loaded for.
harnessMcpLoadedFor=""

## Parses index text into the table above; non-zero when it is not a whole index of
## this version vouching for this workspace and this file.
AgentsHarnessMcpIndexParse(){ ## workspace, text
	local parseLine parseTag parseRest parseAt=0 parseSum=""
	harnessMcpIndexKeysRc=0
	harnessMcpIndexKeys=""
	harnessMcpIndexNames=()
	harnessMcpIndexLines=()
	harnessMcpIndexAt=()
	while IFS= read -r parseLine ; do
		harnessMcpIndexLines+=( "$parseLine" )
		parseTag="${parseLine%%$'\t'*}"
		parseRest="${parseLine#*$'\t'}"
		case "$parseTag" in
			sum) AgentsHarnessMcpDec "$parseRest" ; parseSum="$harnessMcpDec" ;;
			keys)
				harnessMcpIndexKeysRc="${parseRest%%$'\t'*}"
				AgentsHarnessMcpDec "${parseRest#*$'\t'}" ; harnessMcpIndexKeys="$harnessMcpDec"
			;;
			server)
				AgentsHarnessMcpDec "$parseRest"
				harnessMcpIndexNames+=( "$harnessMcpDec" )
				harnessMcpIndexAt+=( "$parseAt" )
			;;
		esac
		parseAt=$(( parseAt + 1 ))
	## The here-string adds the newline the text's own last line already ends in.
	done <<< "${2%$'\n'}"
	## A header or a tail that is not there is an index cut short: never used.
	if [ "${harnessMcpIndexLines[0]-}" = "$agentsMcpIndexHeader" ] && [ "${harnessMcpIndexLines[$(( parseAt - 1 ))]-}" = "end" ] \
		&& AgentsHarnessMcpSum "$1" && [ "$parseSum" = "$harnessMcpSum" ] ; then
		return 0
	fi
	harnessMcpIndexKeysRc=0
	harnessMcpIndexKeys=""
	harnessMcpIndexNames=()
	harnessMcpIndexLines=()
	harnessMcpIndexAt=()
	return 1
}

## Loads this workspace's servers: from its index when that vouches for them, else
## composed here from the primary sources. Re-loads only when the index file changed.
AgentsHarnessMcpLoad(){
	local loadWs="${MMDAPP:-}" loadState="absent"
	if AgentsHarnessMcpFileRaw "$loadWs/.local/agents/mcp.servers.index" ; then
		loadState="present:$harnessMcpFileRaw"
	fi
	[ "$loadWs"$'\n'"$loadState" != "$harnessMcpLoadedFor" ] || return 0
	harnessMcpLoadedFor="$loadWs"$'\n'"$loadState"
	if [ -n "$loadWs" ] && [ "$loadState" != absent ] && AgentsHarnessMcpIndexParse "$loadWs" "$harnessMcpFileRaw" ; then
		harnessMcpFrom="$loadWs/.local/agents/mcp.servers.index"
		return 0
	fi
	harnessMcpFrom="the servers this workspace's installer registers, computed"
	AgentsHarnessMcpIndexParse "$loadWs" "$( AgentsHarnessMcpIndexText "$loadWs" )" || :
}

## The server names.
AgentsHarnessMcpKeys(){
	AgentsHarnessMcpLoad
	harnessMcpResKeysRc="$harnessMcpIndexKeysRc"
	harnessMcpResKeys="$harnessMcpIndexKeys"
}

## One server resolved; harnessMcpResCmdRc is 3 when it is not registered.
AgentsHarnessMcpResolve(){ ## server name
	local resolveName="$1" resolveIdx=0 resolveAt="" resolveLine resolveTag resolveRest
	AgentsHarnessMcpLoad
	harnessMcpResCmdRc=0
	harnessMcpResCmd=""
	harnessMcpResArgsRc=0
	harnessMcpResArgs=()
	harnessMcpResEnvRc=0
	harnessMcpResEnvKeys=()
	harnessMcpResEnvVals=()
	while [ "$resolveIdx" -lt "${#harnessMcpIndexNames[@]}" ] ; do
		if [ "${harnessMcpIndexNames[$resolveIdx]}" = "$resolveName" ] ; then
			resolveAt="${harnessMcpIndexAt[$resolveIdx]}"
			break
		fi
		resolveIdx=$(( resolveIdx + 1 ))
	done
	if [ -z "$resolveAt" ] ; then
		harnessMcpResCmdRc=3
		return 0
	fi
	while : ; do
		resolveAt=$(( resolveAt + 1 ))
		resolveLine="${harnessMcpIndexLines[$resolveAt]-end}"
		resolveTag="${resolveLine%%$'\t'*}"
		resolveRest="${resolveLine#*$'\t'}"
		case "$resolveTag" in
			command)
				harnessMcpResCmdRc="${resolveRest%%$'\t'*}"
				AgentsHarnessMcpDec "${resolveRest#*$'\t'}" ; harnessMcpResCmd="$harnessMcpDec"
			;;
			args) resolveRest="${resolveRest%%$'\t'*}" ; harnessMcpResArgsRc="$resolveRest" ;;
			arg) AgentsHarnessMcpDec "$resolveRest" ; harnessMcpResArgs+=( "$harnessMcpDec" ) ;;
			env) harnessMcpResEnvRc="$resolveRest" ;;
			envpair)
				AgentsHarnessMcpDec "${resolveRest%%$'\t'*}" ; harnessMcpResEnvKeys+=( "$harnessMcpDec" )
				AgentsHarnessMcpDec "${resolveRest#*$'\t'}" ; harnessMcpResEnvVals+=( "$harnessMcpDec" )
			;;
			*) break ;;
		esac
	done
}
