#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

case "$1" in
	--make-agents-indices)
		shift
		if [ $# -ne 0 ] ; then
			echo "$MDSC_CMD: ⛔ ERROR: --make-agents-indices takes no arguments, got: $*" >&2
			set +e ; return 1
		fi
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.Registries.include"
		AgentsToolsRegistryAgentsIndicesBuild || { set +e ; return 1 ; }
		return 0
	;;

	--make-workspace-integrations)
		shift

		if [ -z "$MDLT_ORIGIN" ] || [ "$MDLT_ORIGIN" = "$MMDAPP/.local" ] ; then
			mkdir -p "$MMDAPP/.agents"
		fi

		## First, so the steps below start from the registries of this workspace's members.
		DistroAgentsTools --make-agents-indices || { set +e ; return 1 ; }
		DistroAgentsTools --make-console-command "$@" || { set +e ; return 1 ; }
		DistroAgentsTools --install-workspace-integrations "$@" || { set +e ; return 1 ; }
		## The restrictions -- the hooks that route a client's tool calls to this
		## workspace's own myx.distro tooling -- are part of what an integrated
		## workspace IS, so making the integrations installs them, every run and
		## with nothing asked first: the op writes its own named hook set over
		## whatever it finds, so reinstalling is how they stay current and there
		## is no second state saying whether they are there.
		## Given no "$@": what this op forwards is --quiet and --scope, which
		## that op does not take, and the workspace it works on is the $MMDAPP
		## default it resolves for itself -- the same one --make-console-command
		## above writes its console into.
		DistroAgentsTools --install-workspace-restrictions || { set +e ; return 1 ; }
		## Last, so the indexes describe the settings.json and access roots every step
		## above has just finished writing.
		DistroAgentsTools --make-harness-indices || { set +e ; return 1 ; }
		return 0
	;;
	--make-harness-indices)
		shift
		if [ $# -ne 0 ] ; then
			echo "$MDSC_CMD: ⛔ ERROR: --make-harness-indices takes no arguments, got: $*" >&2
			set +e ; return 1
		fi
		## The harness's own first-class indexes, read with builtins at every harness start
		## instead of recomputing them: the access roots (AgentsHarnessRootsIndex.include)
		## and the PreToolUse hook list (AgentsHarnessHooksLoad.include). Each is produced by
		## the very code the harness otherwise runs, and each is used only while what it was
		## produced from is unchanged -- so a missing or stale one costs time, never a
		## different answer. One section per origin a harness of this workspace runs from:
		## this one, and the installed tree a served MCP call runs from.
		local indexDir="$MMDAPP/.local/agents" indexOrigins indexOrigin indexHere indexSection indexRoots="" indexHooks="" indexKind indexText indexFile
		mkdir -p "$indexDir" || { set +e ; return 1 ; }
		indexOrigins="$MDLT_ORIGIN"
		[ "$MMDAPP/.local" = "$MDLT_ORIGIN" ] || indexOrigins="$indexOrigins"$'\n'"$MMDAPP/.local"
		while IFS= read -r indexOrigin ; do
			indexHere="$indexOrigin/myx/myx.distro-agents/sh-lib"
			[ -f "$indexHere/AgentsHarnessRootsIndex.include" ] && [ -f "$indexHere/AgentsHarnessHooksLoad.include" ] || continue
			if indexSection="$(
				MDLT_ORIGIN="$indexOrigin" harnessHere="$indexHere"
				. "$indexHere/AgentsTools.ClientAccessRoots.include" && . "$indexHere/AgentsHarnessRootsIndex.include" && AgentsHarnessRootsIndexSection "$MMDAPP"
			)" ; then
				indexRoots="$indexRoots$indexSection"$'\n'
			fi
			if indexSection="$(
				MDLT_ORIGIN="$indexOrigin" harnessHere="$indexHere"
				. "$indexHere/AgentsTools.ClientToolPolicy.include" && . "$indexHere/AgentsHarnessHooksLoad.include" \
					&& indexText="$( AgentsToolsClientToolPolicyRerouteHookKeys )" && AgentsHarnessHooksIndexSection "$MMDAPP" "$indexText"
			)" ; then
				indexHooks="$indexHooks$indexSection"$'\n'
			fi
		done <<< "$indexOrigins"
		## The MCP server index too, from mcp.servers.json as it stands -- the same writer
		## --install-vscode-integrations runs beside that JSON, so this op alone, as the
		## source-prepare build runs it, leaves every harness index current.
		( harnessHere="$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib" ; . "$harnessHere/AgentsHarnessMcpConfig.include" \
			&& AgentsHarnessMcpIndexWrite "$indexDir/mcp.servers.json" "$indexDir/mcp.servers.index" ) || {
			echo "$MDSC_CMD: ⛔ ERROR: --make-harness-indices: could not write $indexDir/mcp.servers.index" >&2
			set +e ; return 1
		}
		## Each parent session's list of its children, rebuilt from the spawn records --
		## the authority -- so that sessions spawned before the spawn op listed its own are
		## listed too; then the mark that tells the harness the lists are complete. The mark
		## is taken away first, so a harness never trusts a list being rebuilt.
		local childrenDir="$MMDAPP/.local/agents/children" childLine childFile childParent
		mkdir -p "$childrenDir" || { set +e ; return 1 ; }
		rm -f "$childrenDir/.indexed"
		rm -f "$childrenDir"/*
		while IFS= read -r childLine ; do
			[ -n "$childLine" ] || continue
			childFile="${childLine%%:parent-session-id: *}"
			childParent="${childLine#*:parent-session-id: }"
			case "$childParent" in ''|*/*|.|..) continue ;; esac
			printf '%s\n' "${childFile#"$MMDAPP/.local/agents/spawned/"}" >> "$childrenDir/$childParent" || {
				echo "$MDSC_CMD: ⛔ ERROR: --make-harness-indices: could not list a child in $childrenDir/$childParent" >&2
				set +e ; return 1
			}
		done <<< "$( LC_ALL=C grep -H '^parent-session-id: ' "$MMDAPP"/.local/agents/spawned/*/*.md 2>/dev/null )"
		: > "$childrenDir/.indexed" || { set +e ; return 1 ; }
		echo "🧭 harness children lists written under .local/agents/children" >&2
		for indexKind in roots hooks ; do
			indexFile="$indexDir/harness.$indexKind.index"
			case "$indexKind" in
				roots) indexText="$indexRoots" ;;
				hooks) indexText="$indexHooks" ;;
			esac
			if [ -z "$indexText" ] ; then
				rm -f "$indexFile"
				echo "🙋 WARNING: no harness $indexKind index -- nothing it would be produced from read cleanly here, so the harness computes it at every start" >&2
				continue
			fi
			## Built beside the target and renamed over it, so a reader never meets half an index.
			if ! { printf 'myx.distro harness.%s.index 1\n%s' "$indexKind" "$indexText" > "$indexFile.tmp.$$" && chmod 644 "$indexFile.tmp.$$" && mv -f "$indexFile.tmp.$$" "$indexFile" ; } ; then
				rm -f "$indexFile.tmp.$$"
				echo "$MDSC_CMD: ⛔ ERROR: --make-harness-indices: could not write $indexFile" >&2
				set +e ; return 1
			fi
			echo "🧭 harness $indexKind index written: ${indexFile#$MMDAPP/}" >&2
		done
		return 0
	;;
	--make-console-command)
		shift
		set -e
		# shortcut for: `DistroAgentsTools --make-console-script`
		## Built beside the target and renamed over it, never written in place. A direct
		## redirect truncates on open, so a generation that dies partway leaves a
		## truncated but still-executable console -- and AgentsTools.Owner.include:599
		## records this redirection measured doing exactly that. The gate in
		## AgentsTools.Owner.include deliberately does NOT guard against that stub: a
		## reader cannot make a non-atomic writer safe, and a size or tail-token check
		## only moves the race. It is fixed here, at the writer, or not at all.
		## Same directory on purpose, against this family's .local/temp convention:
		## rename is atomic only within a filesystem, and nothing guarantees .local is
		## the same one. Same-directory needs no such assumption.
		local consoleTempFile="$( mktemp "$MMDAPP/DistroAgentsConsole.sh.XXXXXX" )"
		cat "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsConsoleShellScript.template.sh" \
		> "$consoleTempFile"

		## What the spawn proxy greps for before it will start anything. Checked on the
		## candidate, so a stale template leaves the working console in place instead of
		## destroying it -- a complete-but-wrong console is the same booby trap as a
		## truncated one.
		grep -q 'cli-configured' "$consoleTempFile" || {
			rm -f "$consoleTempFile"
			echo "$MDSC_CMD: ⛔ ERROR: --make-console-command: the console generated from $MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsConsoleShellScript.template.sh carries no --cli-configured arm, so an agent-initiated spawn through it would be refused rather than started. That template is what predates the arm -- point MDLT_CONSOLE_ORIGIN at a tree whose template carries it and run this again. Nothing was installed: the existing console at $MMDAPP/DistroAgentsConsole.sh is unchanged." >&2
			set +e ; return 1
		}

		## chmod AFTER the validate and BEFORE the rename, and both halves matter.
		## mv carries the temp's mode onto the target, so setting it after the rename
		## would leave a mode-600 console -- which the integrations gate then regenerates
		## on every apply, forever, presenting as a permissions fault rather than a
		## generation one. Setting it before the validate would instead leave an
		## executable stub behind on an aborted run, which is the artefact this removes.
		chmod 770 "$consoleTempFile"
		mv "$consoleTempFile" "$MMDAPP/DistroAgentsConsole.sh"

		if [ "$1" != "--quiet" ] ; then
			local consoles="$( ls $MMDAPP/Distro*Console.sh | sed 's|^|	|g' )"
			printf \
				"\nNote: DistroAgentsConsole.sh created, now you can run:\n%s\n\n" \
				"$consoles" \
			>&2
		fi

		return 0
	;;
	--make-console-script)
		shift
		cat "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsConsoleShellScript.template.sh"
		return 0
	;;
	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
