#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

case "$1" in
	--make-workspace-integrations)
		shift

		if [ -z "$MDLT_ORIGIN" ] || [ "$MDLT_ORIGIN" = "$MMDAPP/.local" ] ; then
			mkdir -p "$MMDAPP/.agents"
		fi

		DistroAgentsTools --make-console-command "$@" || { set +e ; return 1 ; }
		DistroAgentsTools --install-workspace-integrations "$@" || { set +e ; return 1 ; }
		return 0
	;;
	--make-console-command)
		shift
		set -e
		# shortcut for: `DistroAgentsTools --make-console-script`
		cat "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsConsoleShellScript.template.sh" \
		> "$MMDAPP/DistroAgentsConsole.sh"
		chmod 770 "$MMDAPP/DistroAgentsConsole.sh"

		## What the spawn proxy greps for before it will start anything.
		grep -q 'cli-configured' "$MMDAPP/DistroAgentsConsole.sh" || {
			echo "$MDSC_CMD: ⛔ ERROR: --make-console-command: the console just written to $MMDAPP/DistroAgentsConsole.sh carries no --cli-configured arm, so an agent-initiated spawn through it is refused rather than started. It was generated from $MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsConsoleShellScript.template.sh, and that template is what predates the arm -- point MDLT_CONSOLE_ORIGIN at a tree whose template carries it and run this again. The previous console has already been overwritten by this one." >&2
			set +e ; return 1
		}

		if [ "$1" != "--quiet" ] ; then
			local consoles="$( ls $MMDAPP/Distro*Console.sh | sed 's|^|	|g' )"
			printf \
				"\nNote: DistroAgentsConsole.sh created, now you can run:\n%s\n\n" \
				"$consoles" \
			>&2
		fi

		return 0
	;;
	--make-console-script)
		shift
		cat "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsConsoleShellScript.template.sh"
		return 0
	;;
	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
