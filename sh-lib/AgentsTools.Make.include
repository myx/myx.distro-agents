#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

case "$1" in
	--make-workspace-integrations)
		shift

		if [ -z "$MDLT_ORIGIN" ] || [ "$MDLT_ORIGIN" = "$MMDAPP/.local" ] ; then
			mkdir -p "$MMDAPP/.agents"
		fi

		DistroAgentsTools --make-console-command "$@"
		DistroAgentsTools --install-workspace-integrations "$@"
		return 0
	;;
	--make-console-command)
		shift
		set -e
		# shortcut for: `DistroAgentsTools --make-console-script`
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.Make.DistroAgentsConsoleShellScript.include" \
		> "$MMDAPP/DistroAgentsConsole.sh"
		chmod 770 "$MMDAPP/DistroAgentsConsole.sh"

		if [ "$1" != "--quiet" ] ; then
			local consoles="$( ls $MMDAPP/Distro*Console.sh | sed 's|^|	|g' )"
			printf \
				"\nNote: DistroAgentsConsole.sh created, now you can run:\n%s\n\n" \
				"$consoles" \
			>&2
		fi

		return 0
	;;
	--make-console-script)
		shift
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.Make.DistroAgentsConsoleShellScript.include"
		return 0
	;;
	*)
		echo "⛔ ERROR: $MDSC_CMD: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
