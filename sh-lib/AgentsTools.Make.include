#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

case "$1" in
	--make-agents-indices)
		shift
		if [ $# -ne 0 ] ; then
			echo "$MDSC_CMD: ⛔ ERROR: --make-agents-indices takes no arguments, got: $*" >&2
			set +e ; return 1
		fi
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.Registries.include"
		AgentsToolsRegistryAgentsIndicesBuild || { set +e ; return 1 ; }
		## The member index, from this workspace's own member registry first and the
		## machine-wide directory second (AgentsTools.TeamRegistry.include).
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.TeamRegistry.include"
		AgentsToolsTeamMemberIndexWrite "$MMDAPP" || {
			echo "$MDSC_CMD: ⛔ ERROR: --make-agents-indices: could not write the member index in $MMDAPP/.local/agents" >&2
			set +e ; return 1
		}
		echo "# $MDSC_CMD --make-agents-indices: wrote $MMDAPP/.local/agents/members.index" >&2
		return 0
	;;

	--make-workspace-integrations)
		shift

		if [ -z "$MDLT_ORIGIN" ] || [ "$MDLT_ORIGIN" = "$MMDAPP/.local" ] ; then
			mkdir -p "$MMDAPP/.agents"
		fi

		## First, so the steps below start from the registries of this workspace's members.
		DistroAgentsTools --make-agents-indices || { set +e ; return 1 ; }
		DistroAgentsTools --make-console-command "$@" || { set +e ; return 1 ; }
		DistroAgentsTools --install-workspace-integrations "$@" || { set +e ; return 1 ; }
		## The restrictions are a manual opt-in (--install-workspace-restrictions). Where the
		## user installed them, their reroute hook is in place, and they are kept current
		## here; where not, they are never installed by this op.
		## Given no "$@": what this op forwards is --quiet and --scope, which
		## that op does not take, and the workspace it works on is the $MMDAPP
		## default it resolves for itself.
		if [ -f "$MMDAPP/.claude/hooks/deny-native-tool-reroute.sh" ] ; then
			DistroAgentsTools --install-workspace-restrictions || { set +e ; return 1 ; }
		fi
		## Last, so the indexes describe the access roots, grants and servers every step
		## above has just finished registering.
		DistroAgentsTools --make-harness-indices || { set +e ; return 1 ; }
		return 0
	;;
	--make-harness-indices)
		shift
		if [ $# -ne 0 ] ; then
			echo "$MDSC_CMD: ⛔ ERROR: --make-harness-indices takes no arguments, got: $*" >&2
			set +e ; return 1
		fi
		## The harness's own first-class indexes, read at every harness start instead of
		## recomputing them: the access roots (AgentsHarnessRootsIndex.include), the
		## PreToolUse hook list (AgentsHarnessHooksLoad.include) and the MCP servers
		## (AgentsHarnessMcpConfig.include). Each is produced from OUR OWN primary data by the
		## very code the harness otherwise runs -- never from a file written for an external
		## tool (.claude/settings.json, mcp.servers.json, .mcp.json, .vscode/mcp.json) --
		## computed ONCE and used by a harness of this workspace whichever origin it runs
		## from, and only while what it was produced from is unchanged -- so a missing or
		## stale one costs time, never a different answer.
		## The children lists are not this op's: the spawn proxy appends each child and the
		## main loop repairs them (AgentsTools.ChildrenIndex.include).
		local indexDir="$MMDAPP/.local/agents" indexHere="$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib" indexRoots indexHooks indexKind indexText indexFile
		mkdir -p "$indexDir" || { set +e ; return 1 ; }
		indexRoots="$(
			harnessHere="$indexHere"
			. "$indexHere/AgentsTools.ClientAccessRoots.include" && . "$indexHere/AgentsHarnessRootsIndex.include" \
				&& AgentsHarnessRootsIndexText "$MMDAPP"
		)" || indexRoots=""
		indexHooks="$(
			harnessHere="$indexHere"
			. "$indexHere/AgentsTools.ClientToolPolicy.include" && . "$indexHere/AgentsHarnessHooksLoad.include" \
				&& AgentsHarnessHooksIndexText
		)" || indexHooks=""
		## The MCP server index too, from the servers our installer registers (never read
		## back from mcp.servers.json) -- the same writer --install-vscode-integrations runs,
		## so this op alone, as the source-prepare build runs it, leaves every harness index current.
		( harnessHere="$indexHere" ; . "$harnessHere/AgentsHarnessMcpConfig.include" \
			&& AgentsHarnessMcpIndexWrite "$MMDAPP" ) || {
			echo "$MDSC_CMD: ⛔ ERROR: --make-harness-indices: could not write $indexDir/mcp.servers.index" >&2
			set +e ; return 1
		}
		for indexKind in roots hooks ; do
			indexFile="$indexDir/harness.$indexKind.index"
			case "$indexKind" in
				roots) indexText="$indexRoots" ;;
				hooks) indexText="$indexHooks" ;;
			esac
			if [ -z "$indexText" ] ; then
				rm -f "$indexFile"
				echo "🙋 WARNING: no harness $indexKind index -- nothing it would be produced from read cleanly here, so the harness computes it at every start" >&2
				continue
			fi
			## Built beside the target and renamed over it, so a reader never meets half an index.
			if ! { printf '%s\n' "$indexText" > "$indexFile.tmp.$$" && chmod 644 "$indexFile.tmp.$$" && mv -f "$indexFile.tmp.$$" "$indexFile" ; } ; then
				rm -f "$indexFile.tmp.$$"
				echo "$MDSC_CMD: ⛔ ERROR: --make-harness-indices: could not write $indexFile" >&2
				set +e ; return 1
			fi
			echo "🧭 harness $indexKind index written: ${indexFile#$MMDAPP/}" >&2
		done
		return 0
	;;
	--make-console-command)
		shift
		set -e
		# shortcut for: `DistroAgentsTools --make-console-script`
		## Built beside the target and renamed over it, never written in place. A direct
		## redirect truncates on open, so a generation that dies partway leaves a
		## truncated but still-executable console -- and AgentsTools.Owner.include:599
		## records this redirection measured doing exactly that. The gate in
		## AgentsTools.Owner.include deliberately does NOT guard against that stub: a
		## reader cannot make a non-atomic writer safe, and a size or tail-token check
		## only moves the race. It is fixed here, at the writer, or not at all.
		## Same directory on purpose, against this family's .local/temp convention:
		## rename is atomic only within a filesystem, and nothing guarantees .local is
		## the same one. Same-directory needs no such assumption.
		local consoleTempFile="$( mktemp "$MMDAPP/DistroAgentsConsole.sh.XXXXXX" )"
		cat "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsConsoleShellScript.template.sh" \
		> "$consoleTempFile"

		## What the spawn proxy greps for before it will start anything. Checked on the
		## candidate, so a stale template leaves the working console in place instead of
		## destroying it -- a complete-but-wrong console is the same booby trap as a
		## truncated one.
		grep -q 'cli-configured' "$consoleTempFile" || {
			rm -f "$consoleTempFile"
			echo "$MDSC_CMD: ⛔ ERROR: --make-console-command: the console generated from $MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsConsoleShellScript.template.sh carries no --cli-configured arm, so an agent-initiated spawn through it would be refused rather than started. That template is what predates the arm -- point MDLT_CONSOLE_ORIGIN at a tree whose template carries it and run this again. Nothing was installed: the existing console at $MMDAPP/DistroAgentsConsole.sh is unchanged." >&2
			set +e ; return 1
		}

		## chmod AFTER the validate and BEFORE the rename, and both halves matter.
		## mv carries the temp's mode onto the target, so setting it after the rename
		## would leave a mode-600 console -- which the integrations gate then regenerates
		## on every apply, forever, presenting as a permissions fault rather than a
		## generation one. Setting it before the validate would instead leave an
		## executable stub behind on an aborted run, which is the artefact this removes.
		chmod 770 "$consoleTempFile"
		mv "$consoleTempFile" "$MMDAPP/DistroAgentsConsole.sh"

		if [ "$1" != "--quiet" ] ; then
			local consoles="$( ls $MMDAPP/Distro*Console.sh | sed 's|^|	|g' )"
			printf \
				"\nNote: DistroAgentsConsole.sh created, now you can run:\n%s\n\n" \
				"$consoles" \
			>&2
		fi

		return 0
	;;
	--make-console-script)
		shift
		cat "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsConsoleShellScript.template.sh"
		return 0
	;;
	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
