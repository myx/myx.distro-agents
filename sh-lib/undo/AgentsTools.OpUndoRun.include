#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

## AgentsTools.OpUndoRun.include -- the operation `--undo-run`, sourced by AgentsTools.UndoRecord.include with the operation's arguments.
## --undo-run <record-id> [--session-id <id>]: takes the inverse, one step at a time, each step
## recorded before it is made so a stopped run resumes. A part whose own operands moved is left
## for its siblings to run past. Closes the record and drops the hold, or closes it `settled`
## where every part already carries a verdict and nothing is left to put back.
		shift
		local undoRunId="" undoRunSession="" undoRunDir="" undoRunLock="${MMDAPP%/}/.local/temp/undo-run.lock" undoRunTries=0
		local undoRunNo=0 undoRunKey undoRunPartDir undoRunTool undoRunOp undoRunArg undoRunRc=0 undoRunWord="" undoRunSteps="" undoHoldDir=""
		while [ $# -gt 0 ] ; do
			case "$1" in
				--session-id) undoRunSession="${2:-}" ; shift 2 ;;
				--*) echo "⛔ ERROR: $MDSC_CMD --undo-run: invalid option: $1" >&2 ; set +e ; return 1 ;;
				*) undoRunId="$1" ; shift ;;
			esac
		done
		undoRunDir="$( AgentsToolsUndoFind "$undoRunId" "$undoRunSession" )" || { set +e ; return 1 ; }
		case "$( AgentsToolsUndoField "$undoRunDir" state )" in
			open) ;;
			done|accepted) printf 'nothing to do: the record is already %s\n' "$( AgentsToolsUndoField "$undoRunDir" state )" ; return 0 ;;
			*) printf 'not run: the record is %s, so it promises nothing to run\n' "$( AgentsToolsUndoField "$undoRunDir" state )" ; set +e ; return 1 ;;
		esac
		## A change whose every part carries a verdict needs no answer of his: nothing is left to put
		## back, so it closes `settled` and releases its hold. A change with a part left and no step to
		## take has every part blocked, and says so.
		undoRunSteps="$( AgentsToolsUndoSteps "$undoRunDir" )"
		if [ -z "$undoRunSteps" ] ; then
			if [ "$( AgentsToolsUndoPartsUnsettled "$undoRunDir" )" != 0 ] ; then
				printf 'not run: %s\n' "$( AgentsToolsUndoBlockedBy "$undoRunDir" | LC_ALL=C tr '\n' ';' | LC_ALL=C sed 's/;*$//' )"
				set +e ; return 1
			fi
			AgentsToolsUndoSet "$undoRunDir" state settled || { echo "⛔ ERROR: $MDSC_CMD --undo-run: could not close the record" >&2 ; set +e ; return 1 ; }
			undoHoldDir="$( AgentsToolsUndoField "$undoRunDir" hold-dir )"
			[ -z "$undoHoldDir" ] || AgentsToolsUndoHoldDrop "$undoHoldDir" "$( AgentsToolsUndoField "$undoRunDir" session-id )" "$undoRunId"
			printf 'SETTLED %s\n' "$undoRunId"
			return 0
		fi
		undoRunWord="$( AgentsToolsUndoOwnerWord "$undoRunDir" "reject" )" || { set +e ; return 1 ; }
		mkdir -p "${undoRunLock%/*}" 2> /dev/null || :
		until mkdir "$undoRunLock" 2> /dev/null ; do
			undoRunTries=$(( undoRunTries + 1 ))
			[ "$undoRunTries" -le 120 ] || { echo "⛔ ERROR: $MDSC_CMD --undo-run: the lock stays taken: $undoRunLock" >&2 ; set +e ; return 1 ; }
			sleep 5
		done
		trap 'rm -rf -- "$undoRunLock"' EXIT
		while IFS=$'\t' read -r undoRunTool undoRunOp undoRunArg undoRunKey ; do
			[ -n "$undoRunKey" ] || continue
			undoRunNo=$(( undoRunNo + 1 ))
			if LC_ALL=C grep -Fxq -- "made"$'\t'"$undoRunKey" "$undoRunDir/steps" 2> /dev/null ; then
				printf '  step %s already made\n' "$undoRunKey"
				continue
			fi
			## The base a file inverse puts back is its own part's: a step key names its part first.
			undoRunPartDir="$( AgentsToolsUndoPartDir "$undoRunDir" "${undoRunKey%%.*}" )"
			printf 'made\t%s\n' "$undoRunKey" >> "$undoRunDir/steps"
			AgentsToolsUndoStepRun "$undoRunPartDir" "$undoRunTool" "$undoRunOp" "$undoRunArg" || { undoRunRc=1 ; break ; }
			printf '  step %s %s %s\n' "$undoRunKey" "$undoRunTool" "$undoRunOp"
		done <<< "$undoRunSteps"
		rm -rf -- "$undoRunLock"
		if [ "$undoRunRc" -ne 0 ] ; then
			printf 'stopped: a step failed, and the record stays open at step %s\n' "$undoRunKey" >&2
			set +e ; return 1
		fi
		AgentsToolsUndoSet "$undoRunDir" state done || :
		undoHoldDir="$( AgentsToolsUndoField "$undoRunDir" hold-dir )"
		[ -z "$undoHoldDir" ] || AgentsToolsUndoHoldDrop "$undoHoldDir" "$( AgentsToolsUndoField "$undoRunDir" session-id )" "$undoRunId"
		printf 'RAN %s\n' "$undoRunId"
		return 0
