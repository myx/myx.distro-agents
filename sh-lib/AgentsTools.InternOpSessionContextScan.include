#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.InternOpSessionContextScan.include -- the --intern-op-session-context-scan op for
## DistroAgentsTools.fn.sh's dispatcher. Sourced lazily from that exact op's
## own dispatcher arm (not a wildcard -- this file holds one op only) via the
## standard $MDLT_ORIGIN-based path. Not standalone: relies on being
## dot-sourced for $1/$@/$MDSC_CMD.
##

. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.CommsSlack.include"

case "$1" in

	--intern-op-session-context-scan)
		shift
		local opContext="<no --context given>"
		local ctxWanted="" ctxArg
		for ctxArg in "$@" ; do
			if [ -n "$ctxWanted" ] ; then
				opContext="$ctxArg" ; ctxWanted="" ; continue
			fi
			if [ "$ctxArg" = "--context" ] ; then ctxWanted="1" ; fi
		done
		local actingMember="$1"
		shift || true
		if [ -z "$actingMember" ] ; then
			echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: syntax is <team-member> [options...] -- the acting member is required, since it is the identity every comms read in this scan acts as" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$actingMember" "<team-member>" session-context-scan || { set +e ; return 1 ; }

		local states=() headers=() typePrefixes=() items=()
		local allTypes="false" owner=""
		local commsCutoffKind="" commsCutoffValue=""
		local commsDoAll="false" commsDoSlack="false" commsDoEmail="false" commsDoTrello="false"
		local commsDoSlackTags="false"
		local commsMemberScopeOnly="false"
		local doInboxInquiryActive="false" doInboxInquiryAll="false"
		local doInboxReflections="false" doInboxNotes="false"
		local doInboxOther="false"
		## Read-only widening of the INBOX section only. Never touches actingMember:
		## the acting identity, the credentials every comms read uses, the board's
		## owner scoping and the named-item lookup all stay with actingMember, and
		## nothing here writes into another member's inbox.
		local inboxAlsoMembers=() alsoSeen
		local doBoardRelatedActive="false" doBoardRelatedAll="false"
		local itemIncludeInbox="false"
		while [ $# -gt 0 ] ; do
			case "$1" in
				--state)
					if [ -z "$2" ] ; then
						echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --state: value required" >&2
						set +e ; return 1
					fi
					case "$2" in
						backlog|pending|running|blocked|parked|processed|archived|retained)
						;;
						*)
							echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --state: invalid state: $2" >&2
							set +e ; return 1
						;;
					esac
					states+=( "$2" )
					shift 2
				;;
				--header)
					if [ -z "$2" ] ; then
						echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --header: value required" >&2
						set +e ; return 1
					fi
					headers+=( "$2" )
					shift 2
				;;
				--type-prefix:*)
					local prefixVal="${1#--type-prefix:}"
					if [ -z "$prefixVal" ] ; then
						echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --type-prefix: value required" >&2
						set +e ; return 1
					fi
					typePrefixes+=( "$prefixVal" )
					shift
				;;
				--all-types)
					allTypes="true"
					shift
				;;
				--filter-owner)
					if [ -z "$2" ] ; then
						echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --filter-owner: value required" >&2
						set +e ; return 1
					fi
					owner="$2"
					shift 2
				;;
				--item)
					if [ -z "$2" ] ; then
						echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --item: value required" >&2
						set +e ; return 1
					fi
					items+=( "$2" )
					shift 2
				;;
				--comms-do-all)    commsDoAll="true" ; shift ;;
				--intern-op-do-slack)  commsDoSlack="true" ; shift ;;
				--comms-do-email)  commsDoEmail="true" ; shift ;;
				--comms-do-trello) commsDoTrello="true" ; shift ;;
				--intern-op-do-slack-tags) commsDoSlackTags="true" ; shift ;;
				--comms-member-scope-only) commsMemberScopeOnly="true" ; shift ;;
				--do-inbox-inquiry-active) doInboxInquiryActive="true" ; shift ;;
				--do-inbox-inquiry-all)    doInboxInquiryAll="true" ; shift ;;
				--do-inbox-reflections)    doInboxReflections="true" ; shift ;;
				--do-inbox-notes)          doInboxNotes="true" ; shift ;;
				--do-inbox-other)          doInboxOther="true" ; shift ;;
				--do-inbox-also-member)
					if [ -z "${2:-}" ] ; then
						echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --do-inbox-also-member: value required" >&2
						set +e ; return 1
					fi
					AgentsToolsAssertBareName "$2" "<team-member>" session-context-scan || { set +e ; return 1 ; }
					if [ "$2" = "$actingMember" ] ; then
						echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --do-inbox-also-member: $2 is already the acting <team-member>, whose own inbox this scan reads anyway -- naming it again would print the same inbox twice" >&2
						set +e ; return 1
					fi
					for alsoSeen in "${inboxAlsoMembers[@]+"${inboxAlsoMembers[@]}"}" ; do
						if [ "$alsoSeen" = "$2" ] ; then
							echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --do-inbox-also-member: $2 given more than once -- one inbox, one set of sections" >&2
							set +e ; return 1
						fi
					done
					inboxAlsoMembers+=( "$2" )
					shift 2
				;;
				--do-board-related-active) doBoardRelatedActive="true" ; shift ;;
				--do-board-related-all)    doBoardRelatedAll="true" ; shift ;;
				--item-include-inbox)      itemIncludeInbox="true" ; shift ;;
				--comms-since-date-time|--comms-since-utime)
					if [ -z "${2:-}" ] ; then
						echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: $1: value required" >&2
						set +e ; return 1
					fi
					if [ -n "$commsCutoffKind" ] ; then
						echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --comms-since-date-time and --comms-since-utime are mutually exclusive, and neither is repeatable -- one cut-off, one spelling" >&2
						set +e ; return 1
					fi
					case "$1" in
						--comms-since-utime)
							case "$2" in
								''|*[!0123456789.]*|*.*.*|.*|*.)
									echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --comms-since-utime: must be epoch seconds, optionally with a fractional part (e.g. 1786140114 or 1786140114.450349): $2" >&2
									set +e ; return 1
								;;
							esac
						;;
						--comms-since-date-time)
							case "$2" in
								[0-9][0-9][0-9][0-9]-[0-1][0-9]-[0-3][0-9]*) ;;
								*)
									echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --comms-since-date-time: must start with YYYY-MM-DD: $2" >&2
									set +e ; return 1
								;;
							esac
						;;
					esac
					commsCutoffKind="$1"
					commsCutoffValue="$2"
					shift 2
				;;
				--context)
					if [ -z "${2:-}" ] ; then
						echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --context: value required" >&2
						set +e ; return 1
					fi
					shift 2
				;;
				*)
					echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done

		if [ "$allTypes" = "true" ] && [ ${#typePrefixes[@]} -gt 0 ] ; then
			echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --all-types and --type-prefix: are mutually exclusive" >&2
			set +e ; return 1
		fi
		if [ "$allTypes" = "false" ] && [ ${#typePrefixes[@]} -eq 0 ] ; then
			echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: exactly one of --all-types or --type-prefix:<value>... is required -- no implicit type default" >&2
			set +e ; return 1
		fi

		## A cut-off with nothing to apply it to is a caller mistake, not a
		## no-op: it reads like comms were requested when none were.
		if [ -n "$commsCutoffKind" ] && [ "$commsDoAll" != "true" ] && [ "$commsDoSlack" != "true" ] \
			&& [ "$commsDoEmail" != "true" ] && [ "$commsDoTrello" != "true" ] ; then
			echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: $commsCutoffKind given with no comms selector (--comms-do-all, --intern-op-do-slack, --comms-do-email, --comms-do-trello) -- a cut-off applies to a requested comms scan, and requesting none is never implied to mean all" >&2
			set +e ; return 1
		fi
		if [ "$commsDoSlackTags" = "true" ] && [ "$commsDoAll" != "true" ] && [ "$commsDoSlack" != "true" ] ; then
			echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --intern-op-do-slack-tags is an additional Slack/IM source and needs the IM scan itself -- pass it alongside --intern-op-do-slack or --comms-do-all" >&2
			set +e ; return 1
		fi
		if [ "$commsMemberScopeOnly" = "true" ] && [ "$commsDoAll" != "true" ] && [ "$commsDoSlack" != "true" ] \
			&& [ "$commsDoEmail" != "true" ] && [ "$commsDoTrello" != "true" ] ; then
			echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --comms-member-scope-only restricts a requested comms scan and needs one -- pass it alongside --comms-do-all, --intern-op-do-slack, --comms-do-email or --comms-do-trello" >&2
			set +e ; return 1
		fi
		## --comms-do-all is the whole set, not a shorthand to combine with
		## part of it -- same fixed-wrapper discipline as --all-types.
		if [ "$commsDoAll" = "true" ] && { [ "$commsDoSlack" = "true" ] || [ "$commsDoEmail" = "true" ] || [ "$commsDoTrello" = "true" ] ; } ; then
			echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --comms-do-all and the individual --intern-op-do-slack/--comms-do-email/--comms-do-trello selectors are mutually exclusive" >&2
			set +e ; return 1
		fi

		if [ "$doInboxInquiryActive" = "true" ] && [ "$doInboxInquiryAll" = "true" ] ; then
			echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --do-inbox-inquiry-active and --do-inbox-inquiry-all are mutually exclusive -- both fill the same section, and a section carrying two scopes states neither" >&2
			set +e ; return 1
		fi
		## A widening with nothing to widen is a caller mistake, not an empty result:
		## the extra inboxes would silently print four "not requested" sections and
		## read as "that member's inbox holds nothing".
		if [ ${#inboxAlsoMembers[@]} -gt 0 ] \
			&& [ "$doInboxInquiryActive" != "true" ] && [ "$doInboxInquiryAll" != "true" ] \
			&& [ "$doInboxReflections" != "true" ] && [ "$doInboxNotes" != "true" ] \
			&& [ "$doInboxOther" != "true" ] ; then
			echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --do-inbox-also-member widens the inbox sections, and no --do-inbox-* section was requested -- there is nothing to widen" >&2
			set +e ; return 1
		fi
		if [ "$doBoardRelatedActive" = "true" ] && [ "$doBoardRelatedAll" = "true" ] ; then
			echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --do-board-related-active and --do-board-related-all are mutually exclusive -- both fill the same section, and a section carrying two scopes states neither" >&2
			set +e ; return 1
		fi

		local boardRelatedStatesText=""
		if [ "$doBoardRelatedActive" = "true" ] || [ "$doBoardRelatedAll" = "true" ] ; then
			if [ -n "$owner" ] && [ "$owner" != "$actingMember" ] ; then
				echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --do-board-related-* scopes the board to the acting <team-member> ($actingMember) while --filter-owner names $owner -- disagreeing values are an error, not an intersection" >&2
				set +e ; return 1
			fi
			owner="$actingMember"
			local boardRelatedStates=()
			if [ "$doBoardRelatedAll" = "true" ] ; then
				boardRelatedStates=( backlog pending running blocked parked processed archived retained )
				boardRelatedStatesText="backlog|pending|running|blocked|parked|processed|archived|retained"
			else
				boardRelatedStates=( backlog pending running blocked parked )
				boardRelatedStatesText="backlog|pending|running|blocked|parked"
			fi
			if [ ${#states[@]} -gt 0 ] ; then
				local statesGiven="" statesWanted="" sg
				for sg in "${states[@]}" ; do statesGiven+="|$sg" ; done
				for sg in "${boardRelatedStates[@]}" ; do statesWanted+="|$sg" ; done
				if [ "$statesGiven" != "$statesWanted" ] ; then
					echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --do-board-related-* supplies its own state set ($boardRelatedStatesText) and the --state values given do not match it -- disagreeing values are an error, not an intersection" >&2
					set +e ; return 1
				fi
			fi
			states=( "${boardRelatedStates[@]}" )
		fi

		if [ ${#states[@]} -eq 0 ] ; then
			states=( backlog pending running blocked parked processed archived retained )
		fi

		[ -n "${MDAT_DATA_ROOT:-}" ] || {
			echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: MDAT_DATA_ROOT is not set" >&2
			set +e ; return 1
		}
		local headersJoined="" sep=""
		if [ ${#headers[@]} -gt 0 ] ; then
			for h in "${headers[@]}" ; do
				headersJoined+="$sep$h"
				sep=$'\034'
			done
		fi

		local matchedFiles=() matchedStates=()
		local inboxEmittedPaths=()
		local boardScanned=0
		local state f base it tp matched ownerVal
		for state in "${states[@]}" ; do
			for f in "$MDAT_DATA_ROOT/board/$state"/*.md ; do
				[ -f "$f" ] || continue
				boardScanned=$(( boardScanned + 1 ))
				base="${f##*/}"

				if [ ${#items[@]} -gt 0 ] ; then
					matched="false"
					for it in "${items[@]}" ; do
						if [ "$it" = "$base" ] ; then matched="true" ; break ; fi
					done
					[ "$matched" = "true" ] || continue
				fi

				if [ "$allTypes" != "true" ] ; then
					matched="false"
					for tp in "${typePrefixes[@]}" ; do
						case "$base" in
							"$tp"*) matched="true" ; break ;;
						esac
					done
					[ "$matched" = "true" ] || continue
				fi

				if [ -n "$owner" ] ; then
					ownerVal="$( LC_ALL=C awk '/^owner: / { sub(/^owner: /, "") ; print ; exit }' "$f" )"
					[ "$ownerVal" = "$owner" ] || continue
				fi

				matchedFiles+=( "$f" )
				matchedStates+=( "$state" )
			done
		done

		## OLDEST FIRST, ACROSS EVERY STATE. The two loops above walk state by state
		## and glob each one, so the list arrived ordered by state and then
		## LEXICALLY BY FILENAME -- which sorts on the item TYPE first, because a
		## name is `<type>-<YYYYMMDDTHHMMZ>-<slug>.md`. Every `dispatch-*` therefore
		## preceded every `note-*` regardless of age, and a state's items never
		## interleaved with another's at all. That is not a chronological order and
		## it is not this scan's to impose: every list an input-scan returns is
		## ordered oldest to newest.
		##
		## The key is the timestamp embedded in the name, which is fixed-width UTC
		## and therefore sorts lexically in chronological order. The two arrays are
		## PARALLEL -- matchedStates[i] describes matchedFiles[i] -- so they are
		## sorted together through one keyed record and split back apart; sorting
		## either alone would silently re-label every item.
		## A name carrying no timestamp keeps its arrival position at the END rather
		## than being given an invented date: unknown is not oldest.
		if [ ${#matchedFiles[@]} -gt 1 ] ; then
			local boardSorted="" boardIndex=0 boardState="" boardFile=""
			## The key is derived in awk, not in a shell `case`: a bracket range in a
			## shell pattern is collation-dependent and this family does not use one.
			## A name carrying no timestamp gets "~" (0x7E, above every digit under
			## LC_ALL=C) and lands at the END -- unknown is not oldest -- with the
			## original arrival index breaking ties so the sort is stable.
			boardSorted="$( for (( boardIndex = 0 ; boardIndex < ${#matchedFiles[@]} ; boardIndex++ )) ; do
					printf '%s\t%s\t%s\n' "$boardIndex" "${matchedStates[$boardIndex]}" "${matchedFiles[$boardIndex]}"
				done | LC_ALL=C awk -F '\t' '
					{
						base = $3
						sub(/^.*\//, "", base)
						key = base
						sub(/^[^-]*-/, "", key)
						sub(/-.*$/, "", key)
						if ( key !~ /^[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T/ ) { key = "~" ; }
						printf("%s\t%s\t%s\t%s\n", key, $1, $2, $3)
					}
				' | LC_ALL=C sort -t "$( printf '\t' )" -k1,1 -k2,2n )"
			matchedFiles=()
			matchedStates=()
			while IFS="$( printf '\t' )" read -r boardIndex boardIndex boardState boardFile ; do
				[ -n "$boardFile" ] || continue
				matchedFiles+=( "$boardFile" )
				matchedStates+=( "$boardState" )
			done <<- BOARDEOF
			$boardSorted
			BOARDEOF
		fi

		local sessionContextEngaged="false"
		if [ -n "$commsCutoffKind" ] || [ "$commsDoAll" = "true" ] || [ "$commsDoSlack" = "true" ] \
			|| [ "$commsDoEmail" = "true" ] || [ "$commsDoTrello" = "true" ] \
			|| [ "$doInboxInquiryActive" = "true" ] || [ "$doInboxInquiryAll" = "true" ] \
			|| [ "$doInboxReflections" = "true" ] || [ "$doInboxNotes" = "true" ] \
			|| [ "$doInboxOther" = "true" ] \
			|| [ "$doBoardRelatedActive" = "true" ] || [ "$doBoardRelatedAll" = "true" ] ; then
			sessionContextEngaged="true"
		fi

		local sessionContextSourcesTotal=0 sessionContextSourcesScanned=0

		if [ "$sessionContextEngaged" = "true" ] ; then
			local commsItemsAwk="$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsSessionContextCommsItems.awk"

			local sessionContextCapIm=128 sessionContextCapEmail=128 sessionContextCapTrello=64
			local sessionContextThreadContextBefore=3

			local wantSlack="false" wantEmail="false" wantTrello="false"
			if [ "$commsDoAll" = "true" ] || [ "$commsDoSlack" = "true" ] ; then wantSlack="true" ; fi
			if [ "$commsDoAll" = "true" ] || [ "$commsDoEmail" = "true" ] ; then wantEmail="true" ; fi
			if [ "$commsDoAll" = "true" ] || [ "$commsDoTrello" = "true" ] ; then wantTrello="true" ; fi

			local imIdentity="<unresolved>" emailIdentity="<not configured>" trelloIdentity="<unresolved>"

			local cutoffEpoch=""
			if [ "$commsCutoffKind" = "--comms-since-utime" ] ; then
				cutoffEpoch="$commsCutoffValue"
			elif [ "$commsCutoffKind" = "--comms-since-date-time" ] ; then
				cutoffEpoch="$( printf '%s\n' "$commsCutoffValue" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsIsoToEpoch.awk" )" || {
					echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --comms-since-date-time: could not convert to epoch seconds: $commsCutoffValue" >&2
					set +e ; return 1
				}
			fi
			local sessionContextDefaultCutoffDays=3
			local commsCutoffDefaulted="false"
			if [ "$wantSlack" = "true" ] && [ -z "$cutoffEpoch" ] ; then
				local nowEpoch=""
				nowEpoch="$( date +%s )" || nowEpoch=""
				case "$nowEpoch" in
					''|*[!0123456789]*)
						echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: no cut-off was given and date +%s did not return epoch seconds ($nowEpoch) -- refusing to fall back to an unbounded scan" >&2
						set +e ; return 1
					;;
				esac
				cutoffEpoch=$(( nowEpoch - sessionContextDefaultCutoffDays * 86400 ))
				commsCutoffDefaulted="true"
			fi

			local imBlocks="" imInstrument="" imSourcesTotal=0 imSourcesScanned=0 imPartial=""
			local imFailed="false" imAnySourceFailed="false"
			if [ "$wantSlack" = "true" ] ; then
				if [ "$commsCutoffDefaulted" = "true" ] ; then
					imInstrument="cut-off defaulted to the last $sessionContextDefaultCutoffDays days -- no --comms-since-date-time or --comms-since-utime was given (applied client-side; Slack oldest= is deliberately NOT used, so thread discovery can still see parents older than the cut-off)"
				else
					imInstrument="cut-off $commsCutoffKind $commsCutoffValue (applied client-side; Slack oldest= is deliberately NOT used, so thread discovery can still see parents older than the cut-off)"
				fi

				## THE SOURCE SET, TWO SCOPES CHOSEN BY WHICH TOKEN IS IN PLAY. Not one
				## set with an identity fan-out bolted onto it:
				##
				##   BOT_TOKEN  -- the `magic-team` channel, the `human-owner` DM, and
				##                 the bot's OWN DMs. The first two were this list's
				##                 entire content and are still exactly right for the
				##                 scope; the bot's own DMs were the missing third.
				##   USER_TOKEN -- for a persona holding one: ALL of its DMs, and all
				##                 of its mentions.
				##
				## Each spec is `identity|target|label|source-key`:
				##   identity   which token reads it -- `bot` or `user`.
				##   target     what --intern-op-slack-check is given.
				##   label      the document's `source:` value, and therefore the key
				##              the renderer groups by. It carries the persona, so one
				##              correspondent writing to two personas stays two groups.
				##   source-key `<auth-id>-<conversation-id>`, this source's stable
				##              name for a caller that wants to speak about one source
				##              in its own records. The scan itself reads nothing by
				##              it: it holds no per-source position to look up.
				local slackSourceSpecs=()
				local slackOwnCredentials="true"
				local slackRosterIdentityArg="--identity both"
				if [ "$commsMemberScopeOnly" = "true" ] ; then
					## Presence only -- reduced to a boolean on the next lines and
					## dropped. No credential is compared, stored or printed.
					local ownTokenPresent=""
					ownTokenPresent="$( DistroAgentsTools --member-config-option "$actingMember" --select SLACK_USER_TOKEN )" || ownTokenPresent=""
					slackOwnCredentials="false"
					[ -z "$ownTokenPresent" ] || slackOwnCredentials="true"
					ownTokenPresent=""

					## A client-* member reads under its OWN user token and nothing
					## else, so its roster is enumerated for that identity alone. Asking
					## for the bot leg here would resolve to the TEAM's shared bot token
					## -- a different workspace entirely -- which is exactly what the
					## partial note below has always refused to do.
					slackRosterIdentityArg="--identity user"

					local configuredSources="" configuredSource
					configuredSources="$( DistroAgentsTools --member-config-option "$actingMember" --select SLACK_CONVERSATIONS )" || configuredSources=""
					for configuredSource in ${configuredSources//,/ } ; do
						slackSourceSpecs+=( "user|$configuredSource|$configuredSource|" )
					done

					if [ "$slackOwnCredentials" != "true" ] ; then
						slackSourceSpecs=()
						imSourcesTotal=$(( imSourcesTotal + 1 ))
						imAnySourceFailed="true"
						imPartial="$imPartial**NOTE:** partial -- Slack not scanned, $actingMember holds no Slack credentials of its own; this scan never reads Slack under the team's shared credentials"$'\n'
					fi
				else
					slackSourceSpecs=( "bot|magic-team|magic-team|" "bot|human-owner|human-owner|" )
				fi
				local ownSlackId="" ownResolveOutput=""
				if [ "$slackOwnCredentials" = "true" ] ; then
					ownResolveOutput="$( DistroAgentsTools --magic-comms-slack-resolve-ids "$actingMember" )" || true
				fi
				ownSlackId="$( printf '%s\n' "$ownResolveOutput" | LC_ALL=C sed -n 's/^AUTH_USER_ID=//p' | head -1 )" || ownSlackId=""
				if [ -z "$ownSlackId" ] && [ "$slackOwnCredentials" = "true" ] ; then
					imPartial="$imPartial**NOTE:** partial -- identity-widening skipped, own Slack user id could not be resolved; watched-channel and open-thread reads unaffected"$'\n'
				fi
				## Reused for the section's `identity:` line -- no second lookup.
				[ -z "$ownSlackId" ] || imIdentity="$ownSlackId"

				local threadTargets=() dt discovered

				## EVERY DM OF EVERY PERSONA, ENUMERATED FROM SLACK, THIS PASS.
				## Not a configured list and not a remembered one: a correspondent who
				## writes for the first time -- or for the first time in a year -- is
				## invisible to both, and that invisibility is the whole defect. The
				## roster op re-fetches conversations.list every call for exactly that
				## reason; see its own header.
				##
				## A DM IS ADDRESSED BY PRESENCE. Nobody @-mentions anyone in a direct
				## conversation, they just write, so no mention or addressing test
				## gates a DM's top-level messages -- they are read because the
				## conversation is ours. (The `vaneId` test in
				## AgentsSlackHistoryThreadTargets.awk is a WIDENER, not a filter: it
				## reads `if (!fresh && !vaneHit) continue`, so it only ever ADDS a
				## thread that is ours but stale. A fresh thread is discovered with or
				## without it, in a DM as in a channel. Nothing there needed changing,
				## and nothing there may be turned into a DM scope test.)
				local dmRosterOutput="" dmRosterRc=0
				if [ "$slackOwnCredentials" = "true" ] ; then
					dmRosterOutput="$( DistroAgentsTools --magic-comms-slack-conversations-roster "$actingMember" $slackRosterIdentityArg )" || dmRosterRc=$?
				else
					dmRosterRc=4
				fi
				## Only rc 0 is a roster that can be trusted to be complete. A partial
				## one is USED -- what it did enumerate is real -- and said out loud,
				## because the alternative is silently sweeping a subset.
				case "$dmRosterRc" in
					0)	;;
					3)
						imPartial="$imPartial**NOTE:** partial -- the DM roster came back INCOMPLETE (one identity could not be enumerated); the conversations below are real but are not known to be all of them"$'\n'
						imAnySourceFailed="true"
					;;
					*)
						dmRosterOutput=""
						if [ "$slackOwnCredentials" = "true" ] ; then
							imSourcesTotal=$(( imSourcesTotal + 1 ))
							imAnySourceFailed="true"
							imPartial="$imPartial**NOTE:** partial -- NO DM was enumerated: conversations.list could not be read for any identity, so nothing here says how many direct conversations exist or whether any carries unread traffic. This is an UNKNOWN inventory, never an empty one"$'\n'
						fi
					;;
				esac

				## The human-owner DM is already read, under BOTH identities, by the
				## `human-owner` alias above -- its fan-out resolves one DM per identity
				## and asserts each against the counterparty. Its conversations appear
				## in both rosters too, so they are skipped HERE rather than the alias
				## being dropped: the alias path carries a counterparty control this
				## one does not, and removing a working control to remove a duplicate
				## is a bad trade.
				local humanOwnerParty=""
				if [ "$commsMemberScopeOnly" != "true" ] ; then
					humanOwnerParty="$( DistroAgentsToolsResolveTarget human-owner | LC_ALL=C sed -n 's/^CHANNEL=//p' )" || humanOwnerParty=""
					case "$humanOwnerParty" in
						U*|W*)	;;
						*)	humanOwnerParty="" ;;
					esac
				fi

				local rosterLine rosterIdentity rosterAuth rosterConv rosterKind rosterParty rosterHandle
				local rosterPersona="" rosterDmCount=0
				## Handles for the `user:` lines, from the roster's OWN users.list fetch
				## -- no second call. Exported rather than passed, because the same map
				## has to reach the thread-fetch jobs this scan backgrounds, and a
				## tenth positional argument to reach them would be worse than a name.
				COMMS_USER_HANDLES=""
				while IFS= read -r rosterLine ; do
					case "$rosterLine" in
						"IDENTITY|"*)
							## The persona's own handle, for the label a reader sees.
							rosterPersona="$( printf '%s\n' "$rosterLine" | LC_ALL=C sed -n 's/.*|handle=\([^|]*\)|.*/\1/p' )"
							continue
						;;
						"USER|"*)
							COMMS_USER_HANDLES="$COMMS_USER_HANDLES$( printf '%s\n' "$rosterLine" | LC_ALL=C awk -F '|' '{ printf("%s\t%s", $2, $3) ; }' )"$'\n'
							continue
						;;
						"CONV|"*)	;;
						*)	continue ;;
					esac
					rosterIdentity="$( printf '%s\n' "$rosterLine" | LC_ALL=C sed -n 's/.*|identity=\([^|]*\)|.*/\1/p' )"
					rosterAuth="$( printf '%s\n' "$rosterLine" | LC_ALL=C sed -n 's/.*|auth=\([^|]*\)|.*/\1/p' )"
					rosterConv="$( printf '%s\n' "$rosterLine" | LC_ALL=C sed -n 's/.*|id=\([^|]*\)|.*/\1/p' )"
					rosterKind="$( printf '%s\n' "$rosterLine" | LC_ALL=C sed -n 's/.*|kind=\([^|]*\)|.*/\1/p' )"
					rosterParty="$( printf '%s\n' "$rosterLine" | LC_ALL=C sed -n 's/.*|counterparty=\([^|]*\)|.*/\1/p' )"
					rosterHandle="$( printf '%s\n' "$rosterLine" | LC_ALL=C sed -n 's/.*|handle=\([^|]*\)|.*/\1/p' )"
					[ -n "$rosterConv" ] && [ -n "$rosterAuth" ] || continue
					if [ -n "$humanOwnerParty" ] && [ "$rosterParty" = "$humanOwnerParty" ] ; then continue ; fi
					## An unresolved handle keeps the party id rather than an empty
					## name: a group heading has to identify SOMEONE.
					[ "$rosterHandle" != "-" ] && [ -n "$rosterHandle" ] || rosterHandle="$rosterParty"
					slackSourceSpecs+=( "$rosterIdentity|$rosterConv|$rosterKind:$rosterHandle@${rosterPersona:-$rosterAuth}|$rosterAuth-$rosterConv" )
					rosterDmCount=$(( rosterDmCount + 1 ))
				done <<- EOF
				$dmRosterOutput
				EOF
				export COMMS_USER_HANDLES

				## ALL MENTIONS FOR EVERY USER_TOKEN PERSONA -- the channel-side half of
				## the same rule. In a channel a mention is HOW a message becomes ours,
				## where in a DM presence already is.
				##
				## The hits are turned into thread targets rather than rendered
				## separately, so a mention is read, trimmed, grouped and capped by the
				## one pipeline every other message goes through -- no second rendering
				## path, and no mention-specific handling rule.
				##
				## THIS IS A USER_TOKEN CAPABILITY AND CANNOT BE MADE A BOT ONE. Slack's
				## search.messages refuses a bot token outright, at any scope; so the
				## bot persona's mentions are only ever the ones sitting in the
				## conversations it is already read above. That is Slack's limit, not a
				## gap in this scan, and it is stated rather than left to be inferred.
				if [ "$commsDoSlackTags" = "true" ] ; then
					imSourcesTotal=$(( imSourcesTotal + 1 ))
					local mentionUserToken=""
					mentionUserToken="$( DistroAgentsTools --member-config-option "$actingMember" --select SLACK_USER_TOKEN )" || mentionUserToken=""
					local mentionHasToken="false"
					[ -z "$mentionUserToken" ] || mentionHasToken="true"
					mentionUserToken=""

					if [ "$mentionHasToken" != "true" ] ; then
						imPartial="$imPartial**NOTE:** partial -- mention search not run for $actingMember: it holds no SLACK_USER_TOKEN, and Slack's search.messages is refused to a bot token at any scope. Mentions of the bot identity are covered only where they sit in a conversation read above; no conclusion about mentions elsewhere is supported by this document"$'\n'
						imAnySourceFailed="true"
					elif [ -z "$ownSlackId" ] ; then
						imPartial="$imPartial**NOTE:** partial -- mention search not run, this persona's own Slack user id could not be resolved, so there was no term to search for"$'\n'
						imAnySourceFailed="true"
					else
						local mentionAfter="" mentionRc=0 mentionResponse="" mentionHits=""
						mentionAfter="$( printf '%s\n' "$(( ${cutoffEpoch%%.*} - 86400 ))" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsEpochToIsoDate.awk" )" || mentionAfter=""
						if [ -z "$mentionAfter" ] ; then
							imPartial="$imPartial**NOTE:** partial -- mention search not run, the search window's start date could not be derived from cut-off $cutoffEpoch"$'\n'
							imAnySourceFailed="true"
						else
							## One day early on purpose: Slack's own `after:` is
							## day-granular and exclusive, and the real sub-second
							## cut-off is applied by the trim every source already goes
							## through. Same over-fetch --member-comms-slack-search-messages
							## documents at its own call site.
							mentionResponse="$( DistroAgentsTools --intern-op-slack-call "$actingMember" \
								--api search.messages --identity user \
								--form "query=<@$ownSlackId> after:$mentionAfter" \
								--form sort=timestamp --form sort_dir=desc --form count=100 --form page=1 \
								--context "--intern-op-session-context-scan (mentions of $ownSlackId)" )" || mentionRc=$?
							if [ "$mentionRc" != "0" ] ; then
								imPartial="$imPartial**NOTE:** partial -- mention search FAILED for <@$ownSlackId>; nothing here says whether this persona was mentioned anywhere outside the conversations read above"$'\n'
								imAnySourceFailed="true"
							else
								## Reuses the generic list reader rather than a second
								## copy of a matches parser: search nests its array at
								## `messages.matches`, which is just another array path.
								mentionHits="$( printf '%s\n' "$mentionResponse" | LC_ALL=C awk \
									-v array=messages.matches -v want=channel.id,ts \
									-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsSlackListRecords.awk" )" || mentionHits=""
								local mentionChannel mentionTs mentionCount=0
								while IFS="$( printf '\t' )" read -r mentionChannel mentionTs ; do
									[ -n "$mentionChannel" ] && [ -n "$mentionTs" ] || continue
									threadTargets+=( "$mentionChannel:$mentionTs" )
									mentionCount=$(( mentionCount + 1 ))
								done <<- MENTIONEOF
								$mentionHits
								MENTIONEOF
								imSourcesScanned=$(( imSourcesScanned + 1 ))
								imInstrument="$imInstrument; mentions of <@$ownSlackId> searched since $mentionAfter ($mentionCount hit(s), read through the same per-conversation pipeline as everything else)"
							fi
						fi
					fi
				fi

				## Said once, after both scopes have contributed: a member with nothing
				## configured AND nothing enumerated really has no source, and that is
				## the only case in which this scan reads no Slack at all.
				if [ "$slackOwnCredentials" = "true" ] && [ ${#slackSourceSpecs[@]} -eq 0 ] ; then
					imSourcesTotal=$(( imSourcesTotal + 1 ))
					imAnySourceFailed="true"
					imPartial="$imPartial**NOTE:** partial -- Slack not scanned, no conversation is configured for $actingMember and none was enumerated for any identity it holds"$'\n'
				fi

				local commsCutoffTrimAwkProgram='
					## Float-free ordering key: zero-padded seconds then exactly six
					## fractional digits, compared as a STRING, never + 0 -- awk converts
					## through strtod, whose decimal point is locale-dependent. Returns ""
					## for anything unparseable, the EMPTY value an unparsed `ts:` line
					## carries included; read that as "cannot be dated", never as 0, and
					## KEEP the block. This is the single place that decides it.
					function tskey(v,   d, sec, frac) {
						gsub(/^[ \t]+|[ \t\r]+$/, "", v)
						d = index(v, ".")
						if (d == 0) { sec = v ; frac = "" ; }
						else { sec = substr(v, 1, d - 1) ; frac = substr(v, d + 1) ; }
						if (sec !~ /^[0-9]+$/ || length(sec) > 16) return ""
						frac = substr(frac "000000", 1, 6)
						if (frac !~ /^[0-9]+$/) return ""
						while (length(sec) < 16) sec = "0" sec
						return sec frac
					}
					function flush(   i, t) {
						if (nb == 0) return
						t = ""
						for (i = 1; i <= nb; i++) t = t blk[i] "\n"
						body[++nblk] = t
						bkey[nblk] = curKey
						nb = 0 ; curKey = "" ;
					}
					BEGIN {
						cutKey = tskey(cut)
						## An unparseable cut-off must never widen the scan to everything:
						## an empty key makes every real key compare greater.
						if (cutKey == "") {
							printf("⛔ ERROR: AgentsTools.InternOpSessionContextScan.include: cut-off is not a parseable timestamp: %s -- treat as NOT SCANNED, never as empty\n", cut) > "/dev/stderr"
							bad = 1
							exit 1
						}
					}
					## Must precede the buffering rule, so a heading closes the PREVIOUS
					## block and then lands in the new one. Never `next` here.
					/^## / { flush() ; }
					{ if ($0 != "") blk[++nb] = $0 ; }
					## Offset derived from the colon, never a second hardcoded count
					## that has to keep agreeing with the pattern.
					/^ts:/ { if (curKey == "") curKey = tskey(substr($0, index($0, ":") + 1)) ; }
					END {
						if (bad) exit 1
						flush()
						## Oldest-first over a plain index array -- POSIX awk has no asort.
						## Collected back-to-front: Slack pages back newest-first.
						m = 0
						for (i = nblk; i >= 1; i--) ord[++m] = i
						for (x = 2; x <= m; x++) {
							v = ord[x] ; j = x - 1
							while (j >= 1 && bkey[ord[j]] > bkey[v]) { ord[j + 1] = ord[j] ; j-- ; }
							ord[j + 1] = v
						}
						## Dated and undatable separated, so the context window counts real
						## messages rather than blocks with no position in the ordering.
						nd = 0 ; nu = 0
						for (x = 1; x <= m; x++) {
							if (bkey[ord[x]] == "") { und[++nu] = ord[x] ; }
							else { dat[++nd] = ord[x] ; }
						}
						first = 0
						for (x = 1; x <= nd; x++) {
							if (bkey[dat[x]] > cutKey) { first = x ; break ; }
						}
						## Nothing newer than the cut-off emits NOTHING, undatable blocks
						## included: a conversation with no new content is not new.
						if (first == 0) exit 0
						for (x = 1; x <= nu; x++) printf("%s\n", body[und[x]])
						start = first - ctx
						if (start < 1) start = 1
						for (x = start; x <= nd; x++) printf("%s\n", body[dat[x]])
					}
				'

				local dmIdentityMapFile
				dmIdentityMapFile="$MMDAPP/.local/temp/mdat-sweep-dm-identity.$$"
				mkdir -p "$MMDAPP/.local/temp" && : > "$dmIdentityMapFile" || { set +e ; return 1 ; }
				trap 'rm -f "$dmIdentityMapFile"' EXIT

				## Per-conversation resume points, `label<TAB>channel<TAB>identity<TAB>ts<TAB>origin`,
				## collected as the loop resolves each source and handed to the
				## renderer so the document can state, per correspondent, where this
				## pass actually started. That is what makes it auditable; today a
				## reader cannot tell one source's starting point from another's.
				local imSourceResume=""

				local slackSpec slackName slackResolved slackChannel slackRaw slackJson slackBlocks
				local specIdentity specTarget
				for slackSpec in ${slackSourceSpecs[@]+"${slackSourceSpecs[@]}"} ; do
					specIdentity="${slackSpec%%|*}"
					slackName="${slackSpec#*|}"
					specTarget="${slackName%%|*}"
					slackName="${slackName#*|}"
					slackName="${slackName%%|*}"

					imSourcesTotal=$(( imSourcesTotal + 1 ))
					slackResolved="$( DistroAgentsToolsResolveTarget "$specTarget" )" || {
						imPartial="$imPartial**NOTE:** partial -- $slackName not scanned, no channel id configured"$'\n'
						imAnySourceFailed="true"
						continue
					}
					slackChannel="$( printf '%s\n' "$slackResolved" | sed -n 's/^CHANNEL=//p' )"
					local slackUserId=""
					slackUserId="$( printf '%s\n' "$slackResolved" | sed -n 's/^USER_ID=//p' )" || slackUserId=""
					local slackCheckTarget="$slackChannel:"
					if [ "$commsMemberScopeOnly" != "true" ] && [ "$specTarget" = "human-owner" ] ; then
						slackCheckTarget="$specTarget"
					fi

					## WHERE THIS SOURCE RESUMES FROM: the cut-off this pass was GIVEN,
					## the same one for every source. This scan holds no position of
					## its own and reads none -- it is stateless, and a caller wanting
					## a different floor states a different --comms-since-*. Recording
					## how far a read got is the calling reader's own business, kept in
					## the calling reader's own state-and-lock note, and the scan
					## neither reads nor writes it.
					imSourceResume="$imSourceResume$slackName	$slackChannel	$specIdentity	$cutoffEpoch	pass cut-off"$'\n'

					local slackCheckRc=0
					## --page-until, NOT --oldest. The read below is now paged to
					## the end of a conversation instead of stopping after one
					## page, and with nothing bounding the walk that means every
					## watched source is re-read from its first message on every
					## pass. This bounds how far back the PAGING goes -- to the
					## same cut-off this scan already applies client-side -- while
					## leaving Slack's own `oldest=` unsent, so the page that
					## straddles the cut-off still arrives whole and thread
					## discovery keeps seeing parents older than it.
					local slackPageUntilArgs=()
					if [ -n "$cutoffEpoch" ] ; then
						slackPageUntilArgs=( --page-until "$cutoffEpoch" )
					fi
					## The spec names which token reads this source. `bot` keeps the
					## identity every team-side source has always been read under; `user`
					## is the persona's own token, which is what a USER_TOKEN persona's
					## own DMs and the whole client-* path have always needed.
					slackRaw="$( if [ "$specIdentity" = "bot" ] ; then
						DistroAgentsTools --intern-op-slack-check "$actingMember" "$slackCheckTarget" "${slackPageUntilArgs[@]+"${slackPageUntilArgs[@]}"}" --identity-bot --raw
					else
						DistroAgentsTools --intern-op-slack-check "$actingMember" "$slackCheckTarget" "${slackPageUntilArgs[@]+"${slackPageUntilArgs[@]}"}" --raw
					fi )" || slackCheckRc=$?
					if [ "$slackCheckRc" != "0" ] && [ "$slackCheckRc" != "3" ] ; then
						imPartial="$imPartial**NOTE:** partial -- $slackName not scanned, --intern-op-slack-check failed"$'\n'
						imAnySourceFailed="true"
						continue
					fi
					if [ "$slackCheckRc" = "3" ] ; then
						imPartial="$imPartial**NOTE:** partial -- $slackName partially scanned, one of the human-owner's two DMs could not be read (--intern-op-slack-check rc=3); the other DM's content below is real, not the missing half"$'\n'
						imAnySourceFailed="true"
					fi
					slackJson="$( printf '%s\n' "$slackRaw" | sed '1d' )"
					printf '%s\n' "$slackJson" | LC_ALL=C awk '
						/^## dm=/ {
							rest = $0
							sub(/^## dm=/, "", rest)
							id = rest ; sub(/ .*/, "", id)
							## `identity=` IS OPTIONAL ON THIS MARKER -- the same
							## optionality AgentsSessionContextCommsItems.awk already
							## honours at its own copy of this rule. Without this
							## positive test the sub() below simply does not match,
							## `idn` keeps the whole remainder, and the first word of
							## it -- the channel id itself -- is recorded as though it
							## were an identity name. That mapping is then non-empty,
							## so the follow-up thread read takes the "some identity
							## was mapped" branch and silently reads under the member
							## token where it had been reading under the bot token.
							idn = ""
							if (rest ~ /identity=/) {
								idn = rest ; sub(/^.*identity=/, "", idn) ; sub(/ .*/, "", idn)
							}
							if (id != "" && idn != "") print id, idn
						}
					' | sort -u >> "$dmIdentityMapFile"
					slackBlocks="$( printf '%s\n' "$slackJson" | LC_ALL=C awk -v kind=slack -v source="$slackName" -v channel="$slackChannel" -f "$commsItemsAwk" )" || {
						imPartial="$imPartial**NOTE:** partial -- $slackName not scanned, response was an API failure, not an empty channel"$'\n'
						imAnySourceFailed="true"
						continue
					}
					## Trimmed against THIS source's resume point, the same value the
					## paging was bounded by -- two different cut-offs over one read is
					## how a message ends up fetched and then silently dropped.
					if [ -n "$cutoffEpoch" ] && [ -n "$slackBlocks" ] ; then
						slackBlocks="$( printf '%s\n' "$slackBlocks" | LC_ALL=C awk -v cut="$cutoffEpoch" -v ctx=0 "$commsCutoffTrimAwkProgram" )" || {
							imPartial="$imPartial**NOTE:** partial -- $slackName not scanned, cut-off filter over the channel page failed"$'\n'
							imAnySourceFailed="true"
							continue
						}
					fi
					imSourcesScanned=$(( imSourcesScanned + 1 ))
					[ -z "$slackBlocks" ] || imBlocks="$imBlocks$slackBlocks"$'\n\n'

					discovered="$( printf '%s\n' "$slackJson" | LC_ALL=C awk -v channel="$slackChannel" -v oldest="$cutoffEpoch" -v vaneId="$ownSlackId" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsSlackHistoryThreadTargets.awk" )" || {
						imPartial="$imPartial**NOTE:** partial -- thread discovery failed for $slackName, watched-channel read above unaffected"$'\n'
						discovered=""
					}
					[ -z "$discovered" ] || discovered="$( printf '%s\n' "$discovered" | sort -u )"
					while IFS= read -r dt ; do
						[ -n "$dt" ] || continue
						threadTargets+=( "$dt" )
					done <<- EOF
					$discovered
					EOF
				done

				if [ "$commsMemberScopeOnly" != "true" ] && [ ${#matchedFiles[@]} -gt 0 ] ; then
					local boardThreads
					boardThreads="$( LC_ALL=C awk '
						function strip(v) {
							sub(/^[^:]*:[ \t]*/, "", v)
							gsub(/^[ \t]+|[ \t]+$/, "", v)
							gsub(/^"|"$/, "", v)
							return v
						}
						function flush(   n, f) {
							n = split(val, f, ":")
							if (n == 3 && f[1] == "slack" && f[2] != "" && f[3] != "") { print f[2] ":" f[3]; }
							val = ""
						}
						FNR == 1 { flush(); }
						/^communication-channel-id:/ { val = strip($0); next; }
						END { flush(); }
					' "${matchedFiles[@]}" )" || boardThreads=""
					[ -z "$boardThreads" ] || boardThreads="$( printf '%s\n' "$boardThreads" | sort -u )"
					while IFS= read -r dt ; do
						[ -n "$dt" ] || continue
						threadTargets+=( "$dt" )
					done <<- EOF
					$boardThreads
					EOF
				fi

				local threadFetchWorkDir
				threadFetchWorkDir="$MMDAPP/.local/temp/mdat-sweep-threads.$$"
				mkdir -p "$MMDAPP/.local/temp" && rm -rf "$threadFetchWorkDir" && mkdir "$threadFetchWorkDir" || { set +e ; return 1 ; }
				trap 'rm -rf "$threadFetchWorkDir" ; rm -f "$dmIdentityMapFile"' EXIT

				local threadTrimAwkFile="$threadFetchWorkDir/trim.awk"
				printf '%s\n' "$commsCutoffTrimAwkProgram" > "$threadTrimAwkFile"

				## Default 6, overridable -- unbounded fan-out risks Slack 429s
				## this scan never had to handle serially.
				local threadFetchWorkers="${ENV_MAGIC_SWEEP_THREAD_WORKERS:-6}"
				case "$threadFetchWorkers" in
					*[!0123456789]*|''|0)
						threadFetchWorkers=6
					;;
				esac

				## Real function, not inline, only because a backgrounded job
				## needs a callable unit -- single-consumer otherwise.
				AgentsSessionContextThreadFetchOne(){
					local memberName="$1" dt="$2" cutoffEpoch="$3" ctxBefore="$4" commsItemsAwkFile="$5" trimAwkFile="$6" workDir="$7" memberScopeOnly="$8" identityMapFile="$9"
					local dtChannel="${dt%%:*}"
					local outBase
					outBase="$( printf '%s' "$dt" | LC_ALL=C cksum | LC_ALL=C awk '{ print $1 }' )"
					local blocksFile="$workDir/blocks.$outBase" statusFile="$workDir/status.$outBase"
					local fetchRaw fetchJson fetchBlocks
					local dtIdentity=""
					if [ -n "$identityMapFile" ] && [ -f "$identityMapFile" ] ; then
						dtIdentity="$( LC_ALL=C awk -v ch="$dtChannel" '$1 == ch { print $2 ; exit }' "$identityMapFile" )"
					fi
					## Same paging bound as the watched-source read above: a long
					## thread is paged to its end, but only back as far as this
					## scan's own cut-off needs.
					local dtPageUntilArgs=()
					if [ -n "$cutoffEpoch" ] ; then
						dtPageUntilArgs=( --page-until "$cutoffEpoch" )
					fi
					fetchRaw="$( if [ "$memberScopeOnly" = "true" ] ; then
						DistroAgentsTools --intern-op-slack-check "$memberName" "$dt" "${dtPageUntilArgs[@]+"${dtPageUntilArgs[@]}"}" --raw
					elif [ "$dtIdentity" = "bot" ] ; then
						DistroAgentsTools --intern-op-slack-check "$memberName" "$dt" "${dtPageUntilArgs[@]+"${dtPageUntilArgs[@]}"}" --identity-bot --raw
					elif [ "$dtIdentity" != "" ] ; then
						## A non-bot, non-empty mapped identity ("user"): omitting
						## --identity-bot resolves to the token memberName holds.
						DistroAgentsTools --intern-op-slack-check "$memberName" "$dt" "${dtPageUntilArgs[@]+"${dtPageUntilArgs[@]}"}" --raw
					else
						DistroAgentsTools --intern-op-slack-check "$memberName" "$dt" "${dtPageUntilArgs[@]+"${dtPageUntilArgs[@]}"}" --identity-bot --raw
					fi )" || {
						printf 'FAIL:--intern-op-slack-check failed\n' > "$statusFile"
						return 0
					}
					fetchJson="$( printf '%s\n' "$fetchRaw" | sed '1d' )"
					fetchBlocks="$( printf '%s\n' "$fetchJson" | LC_ALL=C awk -v kind=slack -v source="thread:$dt" -v channel="$dtChannel" -f "$commsItemsAwkFile" )" || {
						printf 'FAIL:response was an API failure, not an empty thread\n' > "$statusFile"
						return 0
					}
					if [ -n "$cutoffEpoch" ] && [ -n "$fetchBlocks" ] ; then
						fetchBlocks="$( printf '%s\n' "$fetchBlocks" | LC_ALL=C awk -v cut="$cutoffEpoch" -v ctx="$ctxBefore" -f "$trimAwkFile" )" || {
							printf 'FAIL:cut-off filter over the reply set failed\n' > "$statusFile"
							return 0
						}
					fi
					[ -z "$fetchBlocks" ] || printf '%s\n' "$fetchBlocks" > "$blocksFile"
					printf 'OK\n' > "$statusFile"
					return 0
				}

				local uniqueThreads dt
				uniqueThreads="$( printf '%s\n' "${threadTargets[@]+"${threadTargets[@]}"}" | LC_ALL=C sort -u )" || uniqueThreads=""
				while IFS= read -r dt ; do
					[ -n "$dt" ] || continue
					while [ "$( jobs -pr | wc -l | tr -d '[:space:]' )" -ge "$threadFetchWorkers" ] ; do
						sleep 0.2
					done
					AgentsSessionContextThreadFetchOne "$actingMember" "$dt" "$cutoffEpoch" "$sessionContextThreadContextBefore" "$commsItemsAwk" "$threadTrimAwkFile" "$threadFetchWorkDir" "$commsMemberScopeOnly" "$dmIdentityMapFile" &
				done <<- EOF
				$uniqueThreads
				EOF
				wait

				## Merge after `wait`, same sorted order as before -- no
				## concurrent writer here, so no lock is needed.
				while IFS= read -r dt ; do
					[ -n "$dt" ] || continue
					imSourcesTotal=$(( imSourcesTotal + 1 ))
					local outBase statusLine blocksFile statusFile
					outBase="$( printf '%s' "$dt" | LC_ALL=C cksum | LC_ALL=C awk '{ print $1 }' )"
					blocksFile="$threadFetchWorkDir/blocks.$outBase"
					statusFile="$threadFetchWorkDir/status.$outBase"
					if [ -f "$statusFile" ] ; then statusLine="$( cat "$statusFile" )" ; else statusLine="FAIL:no status file -- job never ran or was lost" ; fi
					case "$statusLine" in
						OK)
							imSourcesScanned=$(( imSourcesScanned + 1 ))
							[ -f "$blocksFile" ] && imBlocks="$imBlocks$( cat "$blocksFile" )"$'\n\n'
						;;
						*)
							imPartial="$imPartial**NOTE:** partial -- thread $dt not scanned, ${statusLine#FAIL:}"$'\n'
							imAnySourceFailed="true"
						;;
					esac
				done <<- EOF
				$uniqueThreads
				EOF

				rm -rf "$threadFetchWorkDir"
				rm -f "$dmIdentityMapFile"
				trap - EXIT
				unset -f AgentsSessionContextThreadFetchOne
				unset COMMS_USER_HANDLES

				[ "$imSourcesScanned" -gt 0 ] || imFailed="true"

				## THREAD ROOTS ARRIVE TWICE: conversations.history emits a thread's
				## root, and that thread's conversations.replies read emits it again.
				## The first copy is the one kept -- the history one, so the grouping
				## filter below keeps the channel's own recency rank.
				if [ -n "$imBlocks" ] ; then
					local imDeduped=""
					imDeduped="$( printf '%s' "$imBlocks" | LC_ALL=C awk '
						/^## / { dropping = ($0 in seen) ; seen[$0] = 1 ; }
						!dropping { print ; }
					' )" || imDeduped=""
					[ -z "$imDeduped" ] || imBlocks="$imDeduped"$'\n\n'
				fi
			fi

			local emailBlocks="" emailInstrument="" emailFailed="false"
			local emailUidsTotal=0 emailNotConfigured="false"
			if [ "$wantEmail" = "true" ] ; then
				emailInstrument="unread-semantics (IMAP UID SEARCH UNSEEN)"
				## The mailbox this scan reads as, from the acting member's own
				## scope. A member with no EMAIL_USER keeps the stated default.
				local emailUser="" emailHost="" emailPass=""
				emailUser="$( DistroAgentsTools --agents-config-option "$actingMember" --select EMAIL_USER )" || emailUser=""
				[ -z "$emailUser" ] || emailIdentity="$emailUser"
				emailHost="$( DistroAgentsTools --agents-config-option "$actingMember" --select EMAIL_IMAP_HOST )" || emailHost=""
				emailPass="$( DistroAgentsTools --agents-config-option "$actingMember" --select EMAIL_APP_PASSWORD )" || emailPass=""
				## Mirrors --member-comms-email-check's own gate exactly: an optional
				## source nothing is configured for must not read as one that failed.
				if [ -z "$emailHost" ] || [ -z "$emailUser" ] || [ -z "$emailPass" ] ; then
					emailNotConfigured="true"
				fi
				local emailCheck emailUids emailUid
				if [ "$emailNotConfigured" = "false" ] ; then
					emailCheck="$( DistroAgentsTools --member-comms-email-check "$actingMember" )" || emailFailed="true"
				fi
				if [ "$emailNotConfigured" = "false" ] && [ "$emailFailed" = "false" ] ; then
					emailUids="$( printf '%s\n' "$emailCheck" | LC_ALL=C awk '
						{ sub(/\r$/, ""); }
						/^\* SEARCH/ { seenSearch = 1; for (i = 3; i <= NF; i++) print $i; }
						END {
							if (!seenSearch) {
								printf("⛔ ERROR: AgentsTools.InternOpSessionContextScan.include: --member-comms-email-check returned no SEARCH response line -- treat as NOT SCANNED, never as empty\n") > "/dev/stderr"
								exit 1
							}
						}
					' )" || emailFailed="true"
				fi
				if [ "$emailFailed" = "false" ] ; then
					local emailReadRc emailBlock emailFetched=0
					local emailWorkFile="$MMDAPP/.local/temp/mdat-sweep-email.$$"
					mkdir -p "$MMDAPP/.local/temp" && : > "$emailWorkFile" || { set +e ; return 1 ; }
					while IFS= read -r emailUid ; do
						[ -n "$emailUid" ] || continue
						emailUidsTotal=$(( emailUidsTotal + 1 ))
						## Fetch only what the cap will render: every read is its own IMAP login.
						[ "$emailFetched" -lt "$sessionContextCapEmail" ] || continue
						emailFetched=$(( emailFetched + 1 ))
						emailReadRc=0
						## A subshell and a file, never $(): a command substitution truncates
						## raw message bytes at the first NUL, and a direct call would leak
						## the op's own `set +e` into the rest of this scan.
						( DistroAgentsTools --member-comms-email-read "$actingMember" "$emailUid" ) > "$emailWorkFile" || emailReadRc=$?
						if [ "$emailReadRc" -ne 0 ] ; then
							emailBlocks="$emailBlocks## email-message $emailUid"$'\n'"mailbox: INBOX"$'\n'"status: unseen"$'\n'"fetch: not read -- --member-comms-email-read returned $emailReadRc; the message is UNKNOWN, not empty"$'\n'$'\n'
							continue
						fi
						emailBlock=""
						emailBlock="$( AGENTS_EMAIL_UID="$emailUid" AGENTS_EMAIL_MAILBOX="INBOX" AGENTS_EMAIL_STATUS="unseen" python3 "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsSessionContextEmailItem.py" < "$emailWorkFile" )" || emailBlock=""
						if [ -z "$emailBlock" ] ; then
							emailBlocks="$emailBlocks## email-message $emailUid"$'\n'"mailbox: INBOX"$'\n'"status: unseen"$'\n'"fetch: not rendered -- the message was fetched but could not be parsed into a block"$'\n'$'\n'
							continue
						fi
						emailBlocks="$emailBlocks$emailBlock"$'\n'$'\n'
					done <<- EOF
					$emailUids
					EOF
					rm -f "$emailWorkFile"
				fi
			fi

			local trelloBlocks="" trelloInstrument="" trelloFailed="false"
			local trelloNotConfigured="false"
			if [ "$wantTrello" = "true" ] ; then
				trelloInstrument="unread-semantics (Trello read_filter=unread)"
				local trelloKey="" trelloToken=""
				trelloKey="$( DistroAgentsTools --agents-config-option "$actingMember" --select TRELLO_KEY )" || trelloKey=""
				trelloToken="$( DistroAgentsTools --agents-config-option "$actingMember" --select TRELLO_TOKEN )" || trelloToken=""
				## Mirrors --member-comms-trello-check's own gate, same reason as the email
				## gate above: that op gives "no credentials" and "no answer" one status.
				if [ -z "$trelloKey" ] || [ -z "$trelloToken" ] ; then
					trelloNotConfigured="true"
				fi
				local trelloWhoami="" trelloUser="" trelloId=""
				if [ "$trelloNotConfigured" = "false" ] ; then
					trelloWhoami="$( DistroAgentsTools --member-comms-trello-whoami "$actingMember" )" || trelloWhoami=""
					trelloUser="$( printf '%s\n' "$trelloWhoami" | LC_ALL=C sed -n 's/^TRELLO_USERNAME=//p' | head -1 )" || trelloUser=""
					trelloId="$( printf '%s\n' "$trelloWhoami" | LC_ALL=C sed -n 's/^TRELLO_USER_ID=//p' | head -1 )" || trelloId=""
				fi
				if [ -n "$trelloUser" ] && [ -n "$trelloId" ] ; then
					trelloIdentity="@$trelloUser / $trelloId"
				fi
				local trelloJson
				## The ACTING MEMBER, same reason as the email check above.
				if [ "$trelloNotConfigured" = "false" ] ; then
					trelloJson="$( DistroAgentsTools --member-comms-trello-check "$actingMember" )" || trelloFailed="true"
				fi
				if [ "$trelloNotConfigured" = "false" ] && [ "$trelloFailed" = "false" ] ; then
					trelloBlocks="$( printf '%s\n' "$trelloJson" | LC_ALL=C awk -v kind=trello -f "$commsItemsAwk" )" || {
						trelloFailed="true"
						trelloBlocks=""
					}
					[ -z "$trelloBlocks" ] || trelloBlocks="$trelloBlocks"$'\n\n'
				fi
			fi

			local imCount emailCount trelloCount
			imCount="$( printf '%s' "$imBlocks" | LC_ALL=C awk 'BEGIN { c = 0; } /^## / { c++; } END { print c; }' )"
			emailCount="$( printf '%s' "$emailBlocks" | LC_ALL=C awk 'BEGIN { c = 0; } /^## / { c++; } END { print c; }' )"
			trelloCount="$( printf '%s' "$trelloBlocks" | LC_ALL=C awk 'BEGIN { c = 0; } /^## / { c++; } END { print c; }' )"

			local anyCommsRequested="false" anyCommsConfigured="false" allCommsEmptyAndScanned="true"
			if [ "$wantSlack" = "true" ] || [ "$wantEmail" = "true" ] || [ "$wantTrello" = "true" ] ; then
				anyCommsRequested="true"
			fi
			## A source nothing is configured for was never looked at: it cannot
			## be empty and it cannot have failed, so it decides nothing here.
			if [ "$wantSlack" = "true" ] ; then anyCommsConfigured="true" ; fi
			if [ "$wantEmail" = "true" ]  && [ "$emailNotConfigured" = "false" ]  ; then anyCommsConfigured="true" ; fi
			if [ "$wantTrello" = "true" ] && [ "$trelloNotConfigured" = "false" ] ; then anyCommsConfigured="true" ; fi
			if [ "$wantSlack" = "true" ]  && { [ "$imCount" != "0" ]     || [ "$imAnySourceFailed" = "true" ] ; } ; then allCommsEmptyAndScanned="false" ; fi
			if [ "$wantEmail" = "true" ]  && [ "$emailNotConfigured" = "false" ]  && { [ "$emailCount" != "0" ]  || [ "$emailFailed" = "true" ] ; }  ; then allCommsEmptyAndScanned="false" ; fi
			if [ "$wantTrello" = "true" ] && [ "$trelloNotConfigured" = "false" ] && { [ "$trelloCount" != "0" ] || [ "$trelloFailed" = "true" ] ; } ; then allCommsEmptyAndScanned="false" ; fi

			if [ "$wantSlack" = "true" ] ; then
				sessionContextSourcesTotal=$(( sessionContextSourcesTotal + imSourcesTotal ))
				sessionContextSourcesScanned=$(( sessionContextSourcesScanned + imSourcesScanned ))
			fi
			## An unconfigured optional source enters neither counter: un-scanned would
			## report partial for ever, scanned would assert a read that never happened.
			if [ "$wantEmail" = "true" ] && [ "$emailNotConfigured" = "false" ] ; then
				sessionContextSourcesTotal=$(( sessionContextSourcesTotal + 1 ))
				[ "$emailFailed" = "true" ] || sessionContextSourcesScanned=$(( sessionContextSourcesScanned + 1 ))
			fi
			if [ "$wantTrello" = "true" ] && [ "$trelloNotConfigured" = "false" ] ; then
				sessionContextSourcesTotal=$(( sessionContextSourcesTotal + 1 ))
				[ "$trelloFailed" = "true" ] || sessionContextSourcesScanned=$(( sessionContextSourcesScanned + 1 ))
			fi

			printf '# New Incoming Communications\n\n'
			if [ "$anyCommsRequested" = "false" ] ; then
				printf '**NOTE:** not requested\n\n'
			elif [ "$anyCommsConfigured" = "false" ] ; then
				printf '**NOTE:** no scan was made -- no requested comms source is configured in this member'"'"'s own scope\n\n'
			elif [ "$allCommsEmptyAndScanned" = "true" ] ; then
				printf '**NOTE:** no new incoming communications\n\n'
			fi

			printf '## Incoming IM Updates\n\n'
			if [ "$wantSlack" != "true" ] ; then
				printf '**NOTE:** not requested\n\n'
			elif [ "$imFailed" = "true" ] ; then
				printf 'identity: slack %s (config: %s)\n' "$imIdentity" "$actingMember"
				printf 'instrument: %s\n' "$imInstrument"
				printf 'sources-scanned: %s of %s\n' "$imSourcesScanned" "$imSourcesTotal"
				printf '**NOTE:** no scan was made -- no watched Slack source could be read\n'
				[ -z "$imPartial" ] || printf '%s' "$imPartial"
				printf '\n'
			else
				printf 'identity: slack %s (config: %s)\n' "$imIdentity" "$actingMember"
				printf 'instrument: %s\n' "$imInstrument"
				printf 'sources-scanned: %s of %s\n' "$imSourcesScanned" "$imSourcesTotal"
				printf 'sort: oldest first -- conversations ordered by their own newest message, messages oldest first within each conversation (no message-level merge across conversations)\n'
				printf 'cap: %s conversations -- a thread, channel or DM is ONE unit however many messages it carries\n' "$sessionContextCapIm"
				printf 'messages-read: %s\n' "$imCount"
				[ -z "$imPartial" ] || printf '%s' "$imPartial"
				if [ "$imCount" = "0" ] ; then
					printf '**NOTE:** no new incoming IM updates -- scanned %s of %s sources, 0 messages matched %s\n\n' \
						"$imSourcesScanned" "$imSourcesTotal" "$imInstrument"
				else
					local imRendered=""
					imRendered="$( printf '%s' "$imBlocks" | IM_SOURCE_RESUME="$imSourceResume" LC_ALL=C awk -v cap="$sessionContextCapIm" '
							## Deliberately the same key function as the per-thread trim above:
							## two orderings that must agree are not two implementations.
							function tskey(v,   d, sec, frac) {
								gsub(/^[ \t]+|[ \t\r]+$/, "", v)
								d = index(v, ".")
								if (d == 0) { sec = v ; frac = "" ; }
								else { sec = substr(v, 1, d - 1) ; frac = substr(v, d + 1) ; }
								if (sec !~ /^[0-9]+$/ || length(sec) > 16) return ""
								frac = substr(frac "000000", 1, 6)
								if (frac !~ /^[0-9]+$/) return ""
								while (length(sec) < 16) sec = "0" sec
								return sec frac
							}
							function trim(v) {
								gsub(/^[ \t]+|[ \t\r]+$/, "", v)
								return v
							}
							## Resume points arrive through the ENVIRONMENT, never `-v`:
							## one-true-awk rejects a newline inside a `-v` value outright
							## ("awk: newline in string ... at source line 1", measured), so
							## a multi-line map cannot be passed that way at all.
							function loadResume(   raw, nl, i, f) {
								raw = ENVIRON["IM_SOURCE_RESUME"]
								nl = split(raw, rl, "\n")
								for (i = 1; i <= nl; i++) {
									if (rl[i] == "") continue
									split(rl[i], f, "\t")
									resumeChannel[f[1]] = f[2]
									resumeIdentity[f[1]] = f[3]
									resumeTs[f[1]] = f[4]
									resumeOrigin[f[1]] = f[5]
								}
							}
							function flush(   i, t, g) {
								if (nb == 0) return
								t = ""
								for (i = 1; i <= nb; i++) t = t blk[i] "\n"
								body[++nblk] = t
								bkey[nblk] = curKey
								g = (curSource == "" ? "(source unstated)" : curSource)
								bsrc[nblk] = g
								if (!(g in gseen)) { gseen[g] = 1 ; gname[++ng] = g ; gmax[g] = "" ; gn[g] = 0 ; }
								gn[g]++
								## An undatable conversation ranks HIGHEST, so the cap never
								## deletes one whose recency could not be established. "~"
								## (0x7E) sorts above any digit under LC_ALL=C.
								if (curKey == "") { gmax[g] = "~" ; }
								else if (gmax[g] != "~" && curKey > gmax[g]) { gmax[g] = curKey ; }
								nb = 0 ; curKey = "" ; curSource = "" ;
							}
							/^## / { flush() ; }
							{ if ($0 != "") blk[++nb] = $0 ; }
							/^ts:/     { if (curKey == "")    curKey    = tskey(substr($0, index($0, ":") + 1)) ; }
							/^source:/ { if (curSource == "") curSource = trim(substr($0, index($0, ":") + 1)) ; }
							END {
								flush()
								loadResume()
								## ONE comparator drives both stages: a conversation is ranked by
								## its own NEWEST message, SELECTION keeps the top `cap` of that
								## ranking and PRESENTATION renders that same window ascending.
								for (i = 1; i <= ng; i++) gord[i] = i
								for (x = 2; x <= ng; x++) {
									v = gord[x] ; j = x - 1
									while (j >= 1 && gmax[gname[gord[j]]] > gmax[gname[v]]) { gord[j + 1] = gord[j] ; j-- ; }
									gord[j + 1] = v
								}
								## gord ascends by recency, so the cap keeps the TAIL, never the head.
								keepFrom = ng - cap + 1
								if (keepFrom < 1) keepFrom = 1
								printf("conversations: %d shown of %d\n", ng - keepFrom + 1, ng)
								## Truncation is never silent: a dropped conversation WAS read and
								## still counts toward sources-scanned, and each one is named.
								if (keepFrom > 1) {
									dropped = ""
									for (x = 1; x < keepFrom; x++) {
										g = gname[gord[x]]
										dropped = dropped (dropped == "" ? "" : ", ") g " (" gn[g] " messages)"
									}
									printf("**NOTE:** truncated -- %d conversations found, capped at %d; %d dropped as least-recently-active. Their sources WERE read and are counted in sources-scanned above -- this is a display cap, not an unread source. Dropped: %s\n", ng, cap, keepFrom - 1, dropped)
								}
								printf("\n")
								for (x = keepFrom; x <= ng; x++) {
									g = gname[gord[x]]
									## ONE HEADING PER CORRESPONDENT, naming who this is, which
									## conversation it is, which persona read it, and where THIS
									## pass started in it. The resume point per conversation is
									## what makes the document auditable at all: with one shared
									## cut-off a reader could not tell one source apart from
									## another, and thirty conversations rendered as one flat
									## stream of opaque ids can only be handled in bulk -- which
									## is exactly what forces a DM-specific rule. Grouping is
									## what lets the ORDINARY handling rules apply per message
									## without conflating whose message is whose.
									##
									## `### ` deliberately, not `## `: every block scanner in
									## this pipeline keys on a literal "## " and none of them
									## matches a third hash.
									if (g in resumeChannel) {
										printf("### %s -- conversation %s, read as %s, resumed from %s (%s)\n\n", \
											g, resumeChannel[g], resumeIdentity[g], resumeTs[g], resumeOrigin[g])
									}
									## A `thread:` group has no heading and needs none: a
									## thread is DISCOVERED inside a source that already has
									## one, and does not carry a pointer of its own. Printing
									## "resume point not recorded" against every one of them
									## would bury the sources that do carry one.
									m = 0
									for (i = nblk; i >= 1; i--) if (bsrc[i] == g) ord[++m] = i
									for (y = 2; y <= m; y++) {
										v = ord[y] ; j = y - 1
										while (j >= 1 && bkey[ord[j]] > bkey[v]) { ord[j + 1] = ord[j] ; j-- ; }
										ord[j + 1] = v
									}
									for (y = 1; y <= m; y++) printf("%s\n", body[ord[y]])
								}
							}
					' )" || {
						imRendered=""
						printf 'conversations: unknown -- the grouping/cap filter failed\n'
						printf '**NOTE:** partial -- the conversation grouping/cap filter failed; IM item blocks are omitted from this document, though their sources WERE read and are counted in sources-scanned above\n\n'
					}
					## Guarded, so the failure path above does not also emit the
					## stray blank-line pair an empty render would produce here.
					[ -z "$imRendered" ] || printf '%s\n\n' "$imRendered"
				fi
			fi

			printf '## Incoming Email Updates\n\n'
			if [ "$wantEmail" != "true" ] ; then
				printf '**NOTE:** not requested\n\n'
			elif [ "$emailNotConfigured" = "true" ] ; then
				## No sources-scanned: line -- an unconfigured optional source has no
				## denominator to be a fraction of.
				printf 'identity: email %s (config: %s)\n' "$emailIdentity" "$actingMember"
				printf 'instrument: %s\n' "$emailInstrument"
				printf '**NOTE:** no scan was made -- EMAIL_IMAP_HOST/EMAIL_USER/EMAIL_APP_PASSWORD are not all set in this member'"'"'s own scope; this source is optional, is counted in no source total, and does not make the scan partial\n\n'
			elif [ "$emailFailed" = "true" ] ; then
				printf 'identity: email %s (config: %s)\n' "$emailIdentity" "$actingMember"
				printf 'instrument: %s\n' "$emailInstrument"
				printf 'sources-scanned: 0 of 1\n'
				printf '**NOTE:** no scan was made -- --member-comms-email-check failed\n\n'
			else
				printf 'identity: email %s (config: %s)\n' "$emailIdentity" "$actingMember"
				printf 'instrument: %s\n' "$emailInstrument"
				printf 'sources-scanned: 1 of 1\n'
				printf 'cap: %s\n' "$sessionContextCapEmail"
				[ -z "$commsCutoffKind" ] || printf 'cut-off-applied: no -- this service accepts no cut-off; unread semantics used instead\n'
				if [ "$emailCount" = "0" ] ; then
					printf '**NOTE:** no new incoming email updates -- scanned 1 of 1 sources, 0 messages matched %s\n\n' "$emailInstrument"
				else
					## The UID count, not the block count: the fetch loop stops at the cap,
					## so a block count could never exceed it and would disclose no cut.
					[ "$emailUidsTotal" -le "$sessionContextCapEmail" ] || printf '**NOTE:** truncated -- %s items found, capped at %s\n' "$emailUidsTotal" "$sessionContextCapEmail"
					printf '\n'
					printf '%s' "$emailBlocks" | LC_ALL=C awk -v cap="$sessionContextCapEmail" '/^## / { c++; } c <= cap'
				fi
			fi

			printf '## Incoming Trello Updates\n\n'
			if [ "$wantTrello" != "true" ] ; then
				printf '**NOTE:** not requested\n\n'
			elif [ "$trelloNotConfigured" = "true" ] ; then
				## No sources-scanned: line, same reason as the email section.
				printf 'identity: trello %s (config: %s)\n' "$trelloIdentity" "$actingMember"
				printf 'instrument: %s\n' "$trelloInstrument"
				printf '**NOTE:** no scan was made -- TRELLO_KEY/TRELLO_TOKEN are not both set in this member'"'"'s own scope; this source is optional, is counted in no source total, and does not make the scan partial\n\n'
			elif [ "$trelloFailed" = "true" ] ; then
				printf 'identity: trello %s (config: %s)\n' "$trelloIdentity" "$actingMember"
				printf 'instrument: %s\n' "$trelloInstrument"
				printf 'sources-scanned: 0 of 1\n'
				printf '**NOTE:** no scan was made -- --member-comms-trello-check failed or did not answer with JSON\n\n'
			else
				printf 'identity: trello %s (config: %s)\n' "$trelloIdentity" "$actingMember"
				printf 'instrument: %s\n' "$trelloInstrument"
				printf 'sources-scanned: 1 of 1\n'
				printf 'cap: %s\n' "$sessionContextCapTrello"
				[ -z "$commsCutoffKind" ] || printf 'cut-off-applied: no -- this service accepts no cut-off; unread semantics used instead\n'
				if [ "$trelloCount" = "0" ] ; then
					printf '**NOTE:** no new incoming Trello updates -- scanned 1 of 1 sources, 0 notifications matched %s\n\n' "$trelloInstrument"
				else
					[ "$trelloCount" -le "$sessionContextCapTrello" ] || printf '**NOTE:** truncated -- %s items found, capped at %s\n' "$trelloCount" "$sessionContextCapTrello"
					printf '\n'
					printf '%s' "$trelloBlocks" | LC_ALL=C awk -v cap="$sessionContextCapTrello" '/^## / { c++; } c <= cap'
				fi
			fi

			local sessionContextCapInbox=64
			local sessionContextCapInboxItemBytes=8192
			local inboxDir
			local inboxScanned inboxMatched=() inboxOrdered inboxScopeLine inboxFilterText inboxHeading inboxPrefix
			local inboxSpec inboxWanted inboxWithProcessed ii
			local inboxFilterDesc inboxCandidates=() ci inboxEmit=()

			## The acting member's own inbox first -- byte-for-byte the same sections as
			## before this option existed -- and then one labelled group per widened
			## inbox. A widened inbox is READ and shown, never acted as and never
			## written to; the banner below states that in the document as well, so a
			## reader of the scan cannot mistake a client's inbox for the coordinator's.
			local inboxMembers=( "$actingMember" ) inboxMember inboxHeadingText
			for alsoSeen in "${inboxAlsoMembers[@]+"${inboxAlsoMembers[@]}"}" ; do
				inboxMembers+=( "$alsoSeen" )
			done

			for inboxMember in "${inboxMembers[@]}" ; do
				if [ "$inboxMember" != "$actingMember" ] ; then
					printf '## Additional Inbox -- %s\n\n' "$inboxMember"
					printf 'scope: inboxes/%s/ -- read-only widening. The acting identity stays %s: this scan does not act as %s, reads none of its credentials or comms sources, and writes nothing into its inbox.\n\n' \
						"$inboxMember" "$actingMember" "$inboxMember"
				fi
				inboxDir="$MDAT_DATA_ROOT/inboxes/$inboxMember"

				for inboxSpec in \
					"Active Inbox Inquiry Items inquiry- $doInboxInquiryActive$doInboxInquiryAll $doInboxInquiryAll" \
					"Current Inbox Reflections reflection- $doInboxReflections false" \
					"Current Inbox Notes note- $doInboxNotes false" \
					"Other Inbox Items -other- $doInboxOther false" \
				; do
					inboxWithProcessed="${inboxSpec##* }"
					inboxSpec="${inboxSpec% *}"
					inboxWanted="${inboxSpec##* }"
					inboxSpec="${inboxSpec% *}"
					inboxPrefix="${inboxSpec##* }"
					inboxHeading="${inboxSpec% *}"
					if [ "$inboxMember" = "$actingMember" ] ; then
						inboxHeadingText="$inboxHeading"
					else
						inboxHeadingText="$inboxHeading -- $inboxMember"
					fi

					case "$inboxWanted" in
						*true*)
							printf '## %s\n' "$inboxHeadingText"
						;;
						*)
							printf '## %s\n\n' "$inboxHeadingText"
							printf '**NOTE:** not requested\n\n'
							continue
						;;
					esac

					if [ "$inboxWithProcessed" = "true" ] ; then
						inboxScopeLine="inboxes/$inboxMember/*.md -- top level plus processed/"
						inboxFilterText="including processed/"
					else
						inboxScopeLine="inboxes/$inboxMember/*.md -- top level only, excluding processed/"
						inboxFilterText="excluding processed/"
					fi
					if [ "$inboxPrefix" = "-other-" ] ; then
						inboxFilterDesc="a prefix other than inquiry-*/reflection-*/note-*"
					else
						inboxFilterDesc="$inboxPrefix*"
					fi
					printf 'scope: %s\n' "$inboxScopeLine"
					printf 'cap: %s\n' "$sessionContextCapInbox"

					inboxScanned=0
					inboxCandidates=()
					if [ -d "$inboxDir" ] ; then
						for f in "$inboxDir"/*.md ; do
							[ -f "$f" ] && inboxCandidates+=( "$f" )
						done
						if [ "$inboxWithProcessed" = "true" ] && [ -d "$inboxDir/processed" ] ; then
							for f in "$inboxDir/processed"/*.md ; do
								[ -f "$f" ] && inboxCandidates+=( "$f" )
							done
						fi
					fi
					inboxScanned=${#inboxCandidates[@]}
					inboxMatched=()
					ci=0
					while [ "$ci" -lt "$inboxScanned" ] ; do
						f="${inboxCandidates[$ci]}"
						ci=$(( ci + 1 ))
						case "$inboxPrefix" in
							-other-)
								case "${f##*/}" in
									inquiry-*|reflection-*|note-*) ;;
									*) inboxMatched+=( "$f" ) ;;
								esac
							;;
							*)
								case "${f##*/}" in "$inboxPrefix"*) inboxMatched+=( "$f" ) ;; esac
							;;
						esac
					done

					if [ ${#inboxMatched[@]} -eq 0 ] ; then
						printf '**NOTE:** no new %s -- scanned %s items, 0 matched %s in inboxes/%s/ (%s)\n\n' \
							"$inboxHeading" "$inboxScanned" "$inboxFilterDesc" "$inboxMember" "$inboxFilterText"
						continue
					fi

					[ ${#inboxMatched[@]} -le "$sessionContextCapInbox" ] || printf '**NOTE:** truncated -- %s items found, capped at %s -- OLDEST kept, newest not shown\n' "${#inboxMatched[@]}" "$sessionContextCapInbox"
					printf '\n'
					inboxOrdered="$( LC_ALL=C ls -tr "${inboxMatched[@]}" )" || inboxOrdered=""
					inboxEmit=()
					ii=0
					while IFS= read -r f ; do
						[ -n "$f" ] || continue
						ii=$(( ii + 1 ))
						[ "$ii" -le "$sessionContextCapInbox" ] || break
						inboxEmit+=( "$f" )
					done <<< "$inboxOrdered"
					[ ${#inboxEmit[@]} -eq 0 ] || LC_ALL=C awk \
						-v bodyByteCap="$sessionContextCapInboxItemBytes" \
						-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsInboxItemBlockPrint.awk" \
						"${inboxEmit[@]}"
					## Named-item lookup below is the ACTING member's own inbox only, so
					## only its paths belong in the already-emitted set.
					if [ "$inboxMember" = "$actingMember" ] ; then
						[ ${#inboxEmit[@]} -eq 0 ] || inboxEmittedPaths+=( "${inboxEmit[@]}" )
					fi
				done
			done

			local boardStatesText="" boardTypeText="" boardOwnerText="" boardScopeLine bs
			for bs in "${states[@]}" ; do
				boardStatesText="${boardStatesText:+$boardStatesText|}$bs"
			done
			if [ "$allTypes" = "true" ] ; then
				boardTypeText="all types"
			else
				for bs in "${typePrefixes[@]}" ; do
					boardTypeText="${boardTypeText:+$boardTypeText|}$bs"
				done
				boardTypeText="types: $boardTypeText"
			fi
			if [ -n "$owner" ] ; then
				boardOwnerText="owner: $owner"
			else
				boardOwnerText="any owner"
			fi
			boardScopeLine="board/<state>/*.md -- $boardStatesText, $boardTypeText, $boardOwnerText"

			printf '## Board Items\n'
			if [ ${#matchedFiles[@]} -gt 0 ] \
				|| [ "$doBoardRelatedActive" = "true" ] || [ "$doBoardRelatedAll" = "true" ] ; then
				printf 'scope: %s\n' "$boardScopeLine"
			fi
			if [ ${#matchedFiles[@]} -eq 0 ] \
				&& { [ "$doBoardRelatedActive" = "true" ] || [ "$doBoardRelatedAll" = "true" ] ; } ; then
				printf '**NOTE:** no new Board Items -- scanned %s items, 0 matched owner: %s across %s\n\n' \
					"$boardScanned" "$actingMember" "$boardRelatedStatesText"
			else
				printf '\n'
			fi
		fi

		local h val mi
		mi=0
		while [ "$mi" -lt "${#matchedFiles[@]}" ] ; do
			f="${matchedFiles[$mi]}"
			state="${matchedStates[$mi]}"
			mi=$(( mi + 1 ))
			base="${f##*/}"

			printf '## %s/%s\n' "$state" "$base"
			if [ ${#headers[@]} -eq 0 ] ; then
				LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsBoardItemFrontmatterPrint.awk" "$f"
			else
				LC_ALL=C awk -v headers="$headersJoined" '
					BEGIN {
						n = split(headers, order, "\034")
						for (i = 1; i <= n; i++) {
							vals[order[i]] = ""
							fallback[order[i]] = ""
						}
					}
					!seen_fm && $0 == "---" {
						seen_fm = 1
						in_fm = 1
						next
					}
					in_fm && $0 == "---" {
						in_fm = 0
						closed_fm = 1
						next
					}
					closed_fm { next }
					{
						pos = index($0, ": ")
						if (pos > 0) {
							key = substr($0, 1, pos - 1)
							if (key in vals) {
								if (in_fm) {
									if (vals[key] == "") vals[key] = substr($0, pos + 2)
								} else {
									if (fallback[key] == "") fallback[key] = substr($0, pos + 2)
								}
							}
						}
					}
					END {
						for (i = 1; i <= n; i++) {
							key = order[i]
							val = vals[key]
							if (!seen_fm && val == "") val = fallback[key]
							printf "%s: %s\n", key, val
						}
					}
				' "$f"
			fi
			printf '\n'
		done

		if [ "$itemIncludeInbox" = "true" ] && [ ${#items[@]} -gt 0 ] ; then
			local namedInboxDir="$MDAT_DATA_ROOT/inboxes/$actingMember"
			local namedEmit=() namedMissing=() namedFound namedPath ni
			for it in "${items[@]}" ; do
				namedFound="false"
				## Already rendered by the board walk above -- named, found,
				## nothing further to do for it here.
				for f in "${matchedFiles[@]+"${matchedFiles[@]}"}" ; do
					if [ "${f##*/}" = "$it" ] ; then namedFound="true" ; break ; fi
				done
				if [ "$namedFound" = "false" ] ; then
					for namedPath in "$namedInboxDir/$it" "$namedInboxDir/processed/$it" ; do
						if [ -f "$namedPath" ] ; then
							namedFound="true"
							local namedSeen="false" namedPrev
							for namedPrev in "${inboxEmittedPaths[@]+"${inboxEmittedPaths[@]}"}" ; do
								if [ "$namedPrev" = "$namedPath" ] ; then namedSeen="true" ; break ; fi
							done
							[ "$namedSeen" = "true" ] || namedEmit+=( "$namedPath" )
							break
						fi
					done
				fi
				[ "$namedFound" = "true" ] || namedMissing+=( "$it" )
			done

			## Same one-process-per-batch rule as the sweep sections, and the
			## same framing -- a named item is not a different kind of block.
			[ ${#namedEmit[@]} -eq 0 ] || LC_ALL=C awk \
				-v bodyByteCap="$sessionContextCapInboxItemBytes" \
				-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsInboxItemBlockPrint.awk" \
				"${namedEmit[@]}"

			ni=0
			while [ "$ni" -lt "${#namedMissing[@]}" ] ; do
				printf '**NOTE:** named item not found -- %s, searched every board state and inboxes/%s/ including processed/\n\n' \
					"${namedMissing[$ni]}" "$actingMember"
				ni=$(( ni + 1 ))
			done
		fi

		if [ "$sessionContextSourcesTotal" -eq 0 ] || [ "$sessionContextSourcesScanned" -eq "$sessionContextSourcesTotal" ] ; then
			return 0
		fi
		if [ "$sessionContextSourcesScanned" -eq 0 ] ; then
			set +e ; return 4
		fi
		set +e ; return 3
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
