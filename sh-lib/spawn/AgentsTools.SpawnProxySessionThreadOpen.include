#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

			## Human-owner's own correction: the team-channel root is not the tooling
			## thread. One short human line, titled by --session-name-or-comment or
			## else the routine's name and the member -- no id block, no host, no timestamps. That detail
			## lives in the agent-log-thread's own session start post below.
			## The root is the session's own post, seeded by the tooling, never a member's
			## message: it names the session, by its name or comment, else its id, and who
			## started it where that is known -- the member whose session brings the others in.
			## Its text is its own template's (sh-lib/templates/session-thread.root.format.md),
			## and the name, free text a caller chose, reaches Slack as itself
			## (AgentsToolsSpawnProxySessionRootPost). The thread under it is the participants' own.
			## Posted where this spawn runs, as its other settings are read: this workspace, so the
			## token and the conversation are always one Slack's.
			## The title is the session's own (S21.20): the one its opening run gave it, read off its records where this run only joins it.
			## A work-duty's root is posted in the owner's conversation and every other session's in the team's.
			local rootTitle="$sessionCommentKept"
			if [ -z "$rootTitle" ] ; then
				type AgentsToolsSpawnedSessionRecords > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.StartedRecords.include"
				rootTitle="$( AgentsToolsSpawnedSessionRecords "$sessionId" own 2> /dev/null | head -1 )" || rootTitle=""
				[ -z "$rootTitle" ] || rootTitle="$( AgentsToolsSpawnSandboxRecordHeader "$rootTitle" session-comment )"
			fi
			[ -n "$rootTitle" ] || rootTitle="$callerName"
			local rootTarget="magic-team"
			[ -z "$workDutyStart" ] || rootTarget="human-owner"
			## The frames this session begins with, as its own record will carry them, so the opening post
			## says the path the session starts on (S6.27). Read from the session when it already has them.
			local rootStack="$routineStackLines"
			if [ -n "$routineStackLines" ] && [ "$sessionId" != "$MDAT_SPAWN_SESSION_ID" ] ; then
				rootStack="$( AgentsToolsSessionRoutineStackLines "$sessionId" )" || rootStack=""
				rootStack="${rootStack:-$routineStackLines}"
			fi
			sessionThread="$(
				AgentsToolsSpawnProxySessionRootPost "$callerName" "$rootTitle" "$spawnStartedBy" "$rootTarget" "$rootStack"
			)" || sessionThread=""
			## Recorded at once as the session's, so the member brought in next finds it, and the
			## session that brought this one in does (session-current, AgentsToolsSessionCurrentThreadFind).
			## A duty records it for its own session too, which it starts alone and restarts into.
			if [ -n "$sessionThread" ] && { [ -n "$sessionJoined" ] || [ -n "$workDutyStart" ] ; } ; then
				type AgentsSessionThreadSet > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.include"
				AgentsSessionThreadSet "$sessionId" "$sessionThread" 2> /dev/null \
					|| echo "$MDSC_CMD: agent-spawn-proxy: ⚠️ WARNING: the session thread $sessionThread of $sessionId could not be recorded, so a member brought in before this spawn is recorded may open another" >&2
			fi
