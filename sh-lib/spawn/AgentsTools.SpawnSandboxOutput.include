#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.SpawnSandboxOutput.include -- what a closed sandbox keeps in its output/, and what goes.
##
## A run's output/ holds two kinds of thing. A COPY OF A SOURCE TREE is a path listed in output/copies.manifest, one line a
## copy, TAB-separated: its path under output/, the source root it came from, its bytes, and the stamp it was taken at. A
## STAGED PATCH OR NOTE is the run's own work, and stays.
##
## Only a path the manifest names is removed, and a .patch, .diff or .md file is kept whatever names it. A path no line names is kept: the
## release walks nothing of the copies. A sandbox with no work standing is emptied by the sweep (AgentsTools.CleanupSweep.include).
##
## Sourced, never run. Functions only.
##

## Removes the source-tree copies one sandbox left in its output/, and keeps everything else. The sandbox comes by its folder
## name, never by a path: the spawned store is this concern's own (AgentsSpawnedStoreDirInto). Prints the store-relative path
## of each one removed, and nothing where there was nothing to remove. rc 0.
AgentsToolsSpawnSandboxReleaseOutput(){ ## sandbox folder name
	local sbxName="${1:-}" sbxRoot="" sbxOut sbxManifest sbxPaths sbxPath sbxFull
	case "$sbxName" in ''|.|..|-*|*/*|*[[:space:]]*) return 0 ;; esac
	type AgentsSpawnedStoreDirInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.Paths.include"
	AgentsSpawnedStoreDirInto sbxRoot "$MMDAPP" || return 0
	sbxOut="$sbxRoot/$sbxName/output"
	[ -d "$sbxOut" ] || return 0
	sbxManifest="$sbxOut/copies.manifest"
	sbxPaths=""
	if [ -f "$sbxManifest" ] ; then
		sbxPaths="$( LC_ALL=C awk -F '\t' 'NF { path = $1 ; sub( /\/+$/, "", path ) ; if ( path != "" ) print path ; }' "$sbxManifest" 2> /dev/null )" || sbxPaths=""
	fi
	while IFS= read -r sbxPath ; do
		[ -n "$sbxPath" ] || continue
		case "$sbxPath" in
			/*|..|../*|*/..|*/../*)
				printf '# %s: kept %s/output/%s, which copies.manifest names by no path inside output/\n' "${MDSC_CMD:-DistroAgentsTools}" "$sbxName" "$sbxPath" >&2
				continue
			;;
			*.patch|*.diff|*.md) continue ;;
		esac
		sbxFull="$sbxOut/$sbxPath"
		[ -e "$sbxFull" ] || continue
		rm -rf -- "$sbxFull" 2> /dev/null || { printf '# %s: could not remove the copy %s/output/%s\n' "${MDSC_CMD:-DistroAgentsTools}" "$sbxName" "$sbxPath" >&2 ; continue ; }
		printf '%s\n' "$sbxName/output/$sbxPath"
		## The folders the copy stood in go with it where they are empty, up to output/ and never past it.
		sbxFull="${sbxFull%/*}"
		while [ "$sbxFull" != "$sbxOut" ] && rmdir "$sbxFull" 2> /dev/null ; do sbxFull="${sbxFull%/*}" ; done
	done <<< "$sbxPaths"
	return 0
}
