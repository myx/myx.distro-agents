#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.SpawnSandbox.include -- what a spawn sandbox's input/ holds, and when it
## is emptied; and the sandbox's own reads: its record's path, the sandbox a run stands in, its
## CheckList digests and its log tail. Sourced, never run. Functions only. Contract: MAGIC.md, "Spawn sandbox input/".
##

## THE CLOCK OF A START: the whole seconds each step of a start took, kept in $agentsStartSteps as `<step>=<n>s` words and said
## by the start milestone of the session (AgentsToolsStartStepsSay). Begin starts the clock; Mark closes the step that ran since
## the last mark under its name. Plain variables of the one process that runs the start, so a mark inside `$( )` is lost: a mark
## stands in the start's own body. A step that does not run is not marked, and is not in the line.
## Each step is also appended to `launch.steps` beside the launcher's `launch` (and its bare `launch.noticed`), one `<step>=<n>s`
## a line. That record needs no data root, so a start is timed in a Just Agents workspace too, where the transcript milestone
## that carries the line is never written. `launch`'s own mtime is left alone: the Wait takes the session start from it.
## The dispatcher is loaded on its first call, never at load: most loads of this file never call it.
type DistroAgentsTools > /dev/null 2>&1 || DistroAgentsTools(){ unset -f DistroAgentsTools ; . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"&& DistroAgentsTools "$@" ; }

## THE PARTS, each one concern, split by concern; sourced here so every caller of this include keeps every function.
. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/common/AgentsTools.FrontmatterKey.include"
. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/spawn/AgentsTools.SpawnStartSteps.include"
. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/spawn/AgentsTools.SpawnSandboxInput.include"
. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.SessionThreads.include"
. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.RunRoute.include"
. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/spawn/AgentsTools.SpawnSessionParent.include"
. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionSeats.include"
. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/wait/AgentsTools.MemberWaitSourcesDefault.include"
. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/spawn/AgentsTools.SpawnProxyRootMarks.include"
. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/spawn/AgentsTools.SpawnProxyNotices.include"
. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/spawn/AgentsTools.SpawnSandboxSweep.include"
. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.ItemReviewer.include"
. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/spawn/AgentsTools.SpawnProxyClose.include"

## The sandbox a run's record stands in, into the named variable: the name of its folder in the spawn store. rc 1 where the run has no record.
AgentsSessionRunSandboxInto(){ ## variable, run
	local sandboxRecord=""
	printf -v "$1" '%s' ""
	type AgentsSessionRunRecordInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.include"
	AgentsSessionRunRecordInto sandboxRecord "${2:-}" || return 1
	sandboxRecord="${sandboxRecord%/*}"
	printf -v "$1" '%s' "${sandboxRecord##*/}"
}

## The record file of a run, from its sandbox's name and its record's name (the two fields the record rows carry), so a
## caller holding those never builds a path into the store itself: the store answers its own folder. rc 1 where no such
## record is there, or either name is no bare name.
AgentsSessionSandboxRecordPath(){ ## sandbox, run id
	local pathSandbox="${1:-}" pathRun="${2:-}" pathStore="" pathFile=""
	case "$pathSandbox:$pathRun" in */*|*[[:space:]]*|:*) return 1 ;; esac
	case "$pathSandbox" in ''|-|.|..) return 1 ;; esac
	case "$pathRun" in ''|-|.|..) return 1 ;; esac
	type AgentsSpawnedStoreDirInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.include"
	AgentsSpawnedStoreDirInto pathStore "${MMDAPP:-}" || return 1
	printf -v pathFile '%s/%s/%s.spawn.md' "$pathStore" "$pathSandbox" "$pathRun"
	[ -f "$pathFile" ] || return 1
	printf '%s\n' "$pathFile"
	return 0
}

## A member's CheckList in a spawn sandbox, one line: `<kept yes|no><TAB><last write, epoch or -><TAB><open items><TAB><an open item on any
## list there, yes|no><TAB><the item in progress, or nothing>`.
AgentsSessionSandboxChecklist(){ ## sandbox, member
	local listStore="" listDir="" listFiles=() listFile listKept=no listAt="-"
	case "${1:-}" in ''|-|.|..|*/*|*[[:space:]]*) printf 'no\t-\t0\tno\t\n' ; return 0 ;; esac
	type AgentsSpawnedStoreDirInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.include"
	AgentsSpawnedStoreDirInto listStore "${MMDAPP:-}" || { printf 'no\t-\t0\tno\t\n' ; return 0 ; }
	printf -v listDir '%s/%s' "$listStore" "$1"
	for listFile in "$listDir"/*.checklist.md ; do [ ! -f "$listFile" ] || listFiles+=( "$listFile" ) ; done
	if [ -f "$listDir/${2:-}.checklist.md" ] ; then
		listKept=yes
		listAt="$( stat -f %m "$listDir/${2:-}.checklist.md" 2> /dev/null || stat -c %Y "$listDir/${2:-}.checklist.md" 2> /dev/null )" || listAt="-"
	fi
	[ ${#listFiles[@]} -gt 0 ] || { printf 'no\t-\t0\tno\t\n' ; return 0 ; }
	LC_ALL=C awk -v ownList="$listDir/${2:-}.checklist.md" -v listKept="$listKept" -v listAt="${listAt:--}" '
		/^- \[ \]/ { anyOpen = 1 }
		FILENAME != ownList { next }
		/^- \[ \] / { openCount++ }
		/^- \[~\] / && doingText == "" { doingText = $0 ; sub( /^- \[~\] /, "", doingText ) ; sub( / \(in progress: .*/, "", doingText ) }
		END { printf "%s\t%s\t%d\t%s\t%s\n", listKept, listAt, openCount, ( anyOpen ? "yes" : "no" ), doingText }
	' "${listFiles[@]}" 2> /dev/null
}

## A member's CheckList in a spawn sandbox, its lines: first the name of the file it is kept in, then each line. rc 1 where there is none.
AgentsSessionSandboxChecklistLines(){ ## sandbox, member
	local linesStore="" linesFile="" linesOne
	case "${1:-}:${2:-}" in :*|*:|*/*|-:*|*:-|.:*|..:*|*:.|*:..) return 1 ;; esac
	type AgentsSpawnedStoreDirInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.include"
	AgentsSpawnedStoreDirInto linesStore "${MMDAPP:-}" || return 1
	printf -v linesFile '%s/%s/%s.checklist.md' "$linesStore" "${1:-}" "${2:-}"
	[ -f "$linesFile" ] || return 1
	printf '%s\n' "$linesFile"
	while IFS= read -r linesOne || [ -n "$linesOne" ] ; do printf '%s\n' "$linesOne" ; done < "$linesFile"
	return 0
}

## The last lines of a run's session log: first the name of the log, then the lines. The log in its sandbox first, else its session's. rc 1 for none.
AgentsSessionSandboxLogTail(){ ## sandbox, session, lines
	local tailSpawned="" tailSessions="" tailLog
	type AgentsSessionStoreDirInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.include"
	AgentsSpawnedStoreDirInto tailSpawned "${MMDAPP:-}" || return 1
	AgentsSessionStoreDirInto tailSessions "${MMDAPP:-}" || return 1
	for tailLog in "$tailSpawned/${1:-}/session.log" "$tailSessions/${2:-}/session.log" ; do
		[ -f "$tailLog" ] || continue
		printf '%s\n' "$tailLog"
		tail -n "$3" "$tailLog" 2> /dev/null
		return 0
	done
	return 1
}

## The CheckList the calling run keeps: first its member, then its lines. The one under its native session's store, else under its spawn's sandbox.
AgentsSessionOwnChecklistLines(){ ## native session id (may be empty), spawn sandbox (may be empty)
	local ownSessionStore="" ownSpawnStore="" ownList ownLine ownMember
	type AgentsSessionStoreDirInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.include"
	AgentsSessionStoreDirInto ownSessionStore "${MMDAPP:-}" || ownSessionStore="/nonexistent/.local/agents/sessions"
	AgentsSpawnedStoreDirInto ownSpawnStore "${MMDAPP:-}" || ownSpawnStore="/nonexistent/.local/agents/spawned"
	for ownList in "$ownSessionStore/${1:-none}"/*.checklist.md "$ownSpawnStore/${2:-none}"/*.checklist.md ; do
		[ -f "$ownList" ] || continue
		ownMember="${ownList##*/}"
		printf '%s\n' "${ownMember%.checklist.md}"
		while IFS= read -r ownLine || [ -n "$ownLine" ] ; do printf '%s\n' "$ownLine" ; done < "$ownList"
		return 0
	done
	return 0
}
## The write that can fail is a redirection on a subshell, stderr silenced first, since a failed redirection on a special builtin ends a POSIX shell.
## fd 4 closed or not writable falls back to stderr.
AgentsToolsDaemonLine(){ ## text...
	( printf '%s\n' "$*" ) 2> /dev/null >&4 || printf '%s\n' "$*" >&2
}

## Reports housekeeping lines to the daemon output and as one message into the event-track thread of this spawn's coworking session; nothing goes to stdout or stderr.
## The thread is found through the session's one record, by this spawn's own id (AgentsTools.EventTrackThread.include), never through a file of the sandbox, which spawns may share.
AgentsToolsHousekeepingReport(){ ## member, lines
	local reportThread="" reportLine
	[ -n "$2" ] || return 0
	while IFS= read -r reportLine ; do
		AgentsToolsDaemonLine "$reportLine"
	done <<< "$2"
	type AgentsToolsEventTrackThreadOfInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/event-track/AgentsTools.EventTrackThread.include"
	reportThread=""
	AgentsToolsEventTrackThreadOfInto reportThread "${MDAT_SPAWN_SESSION_ID:-}"
	[ -n "$reportThread" ] || return 0
	type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
	printf '%s\n' "$2" | DistroAgentsTools --intern-op-event-track-post "$1" "$reportThread" --kind activity --session-id "${MDAT_SPAWN_SESSION_ID:-}" \
		--field what="board housekeeping" --from-stdin > /dev/null 2>&1 || :
	return 0
}

## THE CONTROL THREADS OF TEST RIGS LEFT INSIDE SPAWN SANDBOXES, `<sandbox><TAB><pid><TAB><began><TAB><its pid file inside the sandbox>` a line,
## from every `output/**/control/pid` there whose first word is a number. The walk of the spawn store to depth 14 ran minutes under load, so
## its list is kept in schedule/supervise.rig-pids and reread within MDAT_SUPERVISE_RIG_WALK_SECONDS (900, 0 for a walk in every call). A list past
## that bound is renewed by one walk in the background while the call answers from the list it has; its caller still tests the pid and the record.
AgentsSessionRigControlRows(){
	local rigKept="${MMDAPP:-/nonexistent}/.local/agents/schedule/supervise.rig-pids" rigStore=""
	[ -n "${MMDAPP:-}" ] || return 0
	type AgentsSpawnedStoreDirInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.include"
	AgentsSpawnedStoreDirInto rigStore "$MMDAPP" || return 0
	local rigTtl="${MDAT_SUPERVISE_RIG_WALK_SECONDS:-900}" rigAt=0 rigFile rigPid rigRest rigSandbox rigWalker="" rigWalk=yes
	case "$rigTtl" in ''|*[!0123456789]*) rigTtl=900 ;; esac
	if [ "$rigTtl" -gt 0 ] && [ -f "$rigKept" ] ; then
		rigAt="$( stat -f %m "$rigKept" 2> /dev/null || stat -c %Y "$rigKept" 2> /dev/null )" || rigAt=0
		case "$rigAt" in ''|*[!0123456789]*) rigAt=0 ;; esac
	fi
	if [ "$rigTtl" -eq 0 ] || [ $(( $( date +%s ) - rigAt )) -ge "$rigTtl" ] ; then
		mkdir -p "${rigKept%/*}" 2> /dev/null
		## The kept list is replaced after every walk, whatever find's status: in a store that changes while it is walked, find
		## nearly always meets a file that went away and exits 1, and a list kept only on success was never renewed (MEL's was a day
		## old, so every scan walked for minutes). A list short of a vanished path is safe: the caller tests each pid and record.
		## ONE WALK, two ways to run it: with a TTL it runs in the background, one at a time (rig-pids.walk holds the walker's pid, and a
		## lock whose walker is gone is taken over); with TTL 0 it runs at once, with no lock, and this call waits for it.
		if [ "$rigTtl" -gt 0 ] ; then
			{ read -r rigWalker < "$rigKept.walk/pid" ; } 2> /dev/null || rigWalker=""
			case "$rigWalker" in ''|*[!0123456789]*) ;; *) kill -0 "$rigWalker" 2> /dev/null || rm -rf "$rigKept.walk" ;; esac
			mkdir "$rigKept.walk" 2> /dev/null || rigWalk=""
		fi
		if [ -n "$rigWalk" ] ; then
			## ONLY A SANDBOX THAT CAN HOLD A RIG NOT YET SEEN IS WALKED: one with a started run, one with a record written since a TTL before the last
			## walk's start, one the kept list names, and one with no record. A finished sandbox past that was walked whole after it ended. The kept
			## list carries its walk's start as its time, so the next walk reads that bound from it.
			( rigStart="$( date '+%Y%m%d%H%M.%S' )"
				type AgentsToolsSpawnedRecordRows > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.StartedRecords.include"
				rigWalkNames=()
				rigNames="$( find "$MMDAPP/.local/agents/spawned" -mindepth 1 -maxdepth 1 -type d 2> /dev/null )"
				while IFS= read -r rigOne ; do
					[ -z "$rigOne" ] || rigWalkNames+=( "$rigOne" )
				done <<< "$( AgentsToolsSpawnedRecordRows "$MMDAPP" status | RIG_NAMES="$rigNames" RIG_KEPT="$rigKept" RIG_STORE="$rigStore/" \
					LC_ALL=C awk -F '\t' -v since="$(( rigAt - rigTtl ))" '
					BEGIN { while ( ( getline keptLine < ENVIRON["RIG_KEPT"] ) > 0 ) if ( index( keptLine, ENVIRON["RIG_STORE"] ) == 1 ) { keptName = substr( keptLine, length( ENVIRON["RIG_STORE"] ) + 1 ) ; sub( /\/.*/, "", keptName ) ; listed[keptName] = 1 ; } }
					{ recorded[$1] = 1 ; if ( $4 == "spawn-started" || $3 + 0 >= since + 0 ) open[$1] = 1 ; }
					END { count = split( ENVIRON["RIG_NAMES"], dirName, "\n" ) ; for ( at = 1 ; at <= count ; at++ ) { sub( /.*\//, "", dirName[at] ) ; if ( dirName[at] != "" && ( !( dirName[at] in recorded ) || ( dirName[at] in open ) || ( dirName[at] in listed ) ) ) print dirName[at] ; } }' )"
				: > "$rigKept.tmp"
				[ ${#rigWalkNames[@]} -eq 0 ] || ( cd "$rigStore" && find "${rigWalkNames[@]}" -mindepth 5 -maxdepth 13 \( -name .git -o -name node_modules \) -prune -o -path '*/output/*' -path '*/control/pid' -type f -print 2> /dev/null ) \
					| RIG_STORE="$rigStore/" LC_ALL=C awk '{ print ENVIRON["RIG_STORE"] $0 ; }' > "$rigKept.tmp"
				mv -f "$rigKept.tmp" "$rigKept" ; touch -t "$rigStart" "$rigKept" ; [ "$rigTtl" -eq 0 ] || rm -rf "$rigKept.walk" ) > /dev/null 2>&1 < /dev/null &
			if [ "$rigTtl" -eq 0 ] ; then wait "$!" 2> /dev/null || : ; else printf '%s\n' "$!" > "$rigKept.walk/pid" 2> /dev/null ; fi
		fi
	fi
	[ -f "$rigKept" ] || return 0
	while IFS= read -r rigFile ; do
		[ -n "$rigFile" ] || continue
		rigPid="" ; rigRest=""
		{ read -r rigPid rigRest < "$rigFile" ; } 2> /dev/null || continue
		case "${rigPid:-}" in ''|*[!0123456789]*) continue ;; esac
		rigSandbox="${rigFile#"$rigStore"/}" ; rigSandbox="${rigSandbox%%/*}"
		printf '%s\t%s\t%s\t%s\n' "$rigSandbox" "$rigPid" "$rigRest" "${rigFile#"$rigStore"/"$rigSandbox"/}"
	done < "$rigKept"
	return 0
}

## THE NOTE BESIDE A RIG'S CONTROL PID FILE that a polite signal did not end: `<pid> <began>`, the two the pid file holds, kept
## in a file of its own so the next pass knows the same process answered nothing and may be ended harder. A file and not a variable,
## because the pass that writes it and the pass that reads it are different processes. It stands beside the pid file, so it goes
## when the rig does, and only the store's owner builds its path.
AgentsSessionRigTermNoteInto(){ ## variable, sandbox, the pid file inside the sandbox, pid, the began moment
	local termNote="" termLine="" termStore=""
	type AgentsSpawnedStoreDirInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.include"
	printf -v "$1" '%s' "none"
	case "${2:-}" in ''|-|.|..|*/*|*[[:space:]]*) return 0 ;; esac
	case "${3:-}" in ''|/*|*..*|*[[:space:]]*) return 0 ;; esac
	AgentsSpawnedStoreDirInto termStore "${MMDAPP:-}" || return 0
	printf -v termNote '%s/%s/%s.term' "$termStore" "$2" "$3"
	[ -f "$termNote" ] || return 0
	{ IFS= read -r termLine < "$termNote" ; } 2> /dev/null || termLine=""
	case "$termLine" in
		'') return 0 ;;
		"${4:-} ${5:-}") printf -v "$1" '%s' "same" ;;
		*) printf -v "$1" '%s' "other" ;;
	esac
	return 0
}

AgentsSessionRigTermNoteSet(){ ## sandbox, the pid file inside the sandbox, pid, the began moment
	local termNote="" termStore="" setWorkspace="${MMDAPP:-/nonexistent}"
	type AgentsSpawnedStoreDirInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.include"
	case "${1:-}" in ''|-|.|..|*/*|*[[:space:]]*) return 1 ;; esac
	case "${2:-}" in ''|/*|*..*|*[[:space:]]*) return 1 ;; esac
	AgentsSpawnedStoreDirInto termStore "$setWorkspace" || return 1
	printf -v termNote '%s/%s/%s.term' "$termStore" "$1" "$2"
	## made whole or not at all, so a reader never takes half a note for a whole one
	mkdir -p "${termNote%/*}" 2> /dev/null && printf '%s %s\n' "${3:-}" "${4:-}" > "$termNote.tmp" && mv -f "$termNote.tmp" "$termNote" && return 0
	rm -f -- "$termNote.tmp" 2> /dev/null ; return 1
}

AgentsSessionRigTermNoteClear(){ ## sandbox, the pid file inside the sandbox
	local termNote="" termStore=""
	type AgentsSpawnedStoreDirInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.include"
	case "${1:-}" in ''|-|.|..|*/*|*[[:space:]]*) return 1 ;; esac
	case "${2:-}" in ''|/*|*..*|*[[:space:]]*) return 1 ;; esac
	AgentsSpawnedStoreDirInto termStore "${MMDAPP:-}" || return 1
	printf -v termNote '%s/%s/%s.term' "$termStore" "$1" "$2"
	## tested first, since a pass clears one for every rig whose thread has gone, and most rigs have no note
	[ -e "$termNote" ] || return 0
	rm -f -- "$termNote" 2> /dev/null || return 1
}
