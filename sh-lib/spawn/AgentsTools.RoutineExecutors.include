#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.RoutineExecutors.include -- the ONE parse of a routine's `executors:` value, for the shell
## callers of it. Sourced, never run. Functions only.
##
## The rule itself is AgentsRoutineExecutorsParse.awk beside this file, read by every caller here and
## preloaded by the awk programs that read many routine files in one pass. An entry is a member, then
## optionally one parenthetical of its own parameters. Entries are separated by a comma, as the spawner has always
## read them, and a reader that tests one name takes the names a value holds, split on a comma or a whitespace run
## outside a parenthetical.
##
## What a parameter means, and whether the grammar has it, is AgentsToolsPresetDeclaredSpec's
## (sh-lib/settings/AgentsTools.Preset.include).
##

## The rule's own file: the answer to one question about one value.
AgentsToolsRoutineExecutorsParse(){ ## the mode (entries|member-list|members|params), the value, the member
	EXECUTORS_VALUE="$2" EXECUTORS_MEMBER="${3:-}" LC_ALL=C awk -v mode="$1" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/spawn/AgentsRoutineExecutorsParse.awk" < /dev/null
}

## The entries of one executors value, one a line as `<member><TAB><parameters>`, both trimmed, an entry
## naming neither left out: the form a reader takes that judges each entry on its own.
AgentsToolsRoutineExecutorsEntries(){ ## executors value
	AgentsToolsRoutineExecutorsParse entries "${1:-}"
}

## The members one executors value names, its parameters stripped, on one line space-separated, one an entry: the
## form a reader that tests one entry against the set takes.
AgentsToolsRoutineExecutorsMemberList(){ ## executors value
	AgentsToolsRoutineExecutorsParse member-list "${1:-}"
}

## The names one executors value names, its parameters stripped, on one line space-separated, one a name wherever
## a comma or a whitespace run stands outside a parenthetical: the form a reader that tests one name takes.
AgentsToolsRoutineExecutorsMembers(){ ## executors value
	AgentsToolsRoutineExecutorsParse members "${1:-}"
}

## The parameters the entry for a member carries, as written, and nothing where the entry carries none.
AgentsToolsRoutineExecutorsParams(){ ## executors value, member
	AgentsToolsRoutineExecutorsParse params "${1:-}" "${2:-}"
}
