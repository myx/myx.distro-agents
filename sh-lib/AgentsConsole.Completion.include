#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

case "$1" in
	--completion-helper-agents)
		shift
		(
			. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsConsole.CompletionHelperAgents.fn.include"
			AgentsConsoleCompletionHelperAgents "$@"
		)
	;;
	--completion-require)
		shift
		Agents --completion-all \
		| grep -e '\.fn\.sh$' \
		| sort -u \
		| sed 's:\.fn\.sh$::'
		return 0
	;;
	--completion-agents)
		shift
		Agents --completion-all \
		| grep '^\(DistroAgents\|Agents\).*.fn.sh$' \
		| sort -u \
		| sed 's:\.fn\.sh$::'
		return 0
	;;
	--completion-all)
		shift
		(
			MDPATH=""
			for ITEM in ".local" "system" "deploy" "source" "remote" "agents" ; do
				if [ -d "$MDLT_ORIGIN/myx/myx.distro-$ITEM/sh-scripts" ] ; then
					MDPATH+=" $MDLT_ORIGIN/myx/myx.distro-$ITEM/sh-scripts"
				fi
			done

			find $MDPATH -type 'f' -name '*.sh' \
			| sed -E "s:^$MDLT_ORIGIN/myx/myx.distro-(.local|system|deploy|source|remote|agents)/sh-scripts/::g" \
			| sort
		)
		return 0
	;;
	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
