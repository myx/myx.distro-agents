#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

## AgentsTools.OpOwnerCredentialStoreVerify.include -- the operation `--owner-credential-store-verify`, sourced by AgentsTools.Owner.include with the operation's arguments.
		shift
		if [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --owner-credential-store-verify: takes no arguments" >&2
			set +e ; return 1
		fi
		local storeDir ; storeDir="$( AgentsSettingsStoreDir "$MMDAPP" )"
		if [ ! -d "$storeDir" ] ; then
			echo "# $MDSC_CMD --owner-credential-store-verify: $storeDir does not exist yet (nothing to verify)" >&2
			return 0
		fi

		local storeFailed=0
		local storePerm
		storePerm="$( stat -c '%a' "$storeDir" 2>/dev/null || stat -f '%Lp' "$storeDir" 2>/dev/null )"
		if [ "$storePerm" = "770" ] ; then
			echo "OK   770  $storeDir"
		else
			echo "BAD  ${storePerm:-?}  $storeDir  (expected 770)"
			storeFailed=1
		fi

		local storeFile
		for storeFile in $( AgentsSettingsScopes "$MMDAPP" ) ; do
			storeFile="$( AgentsSettingsScopeFile "$MMDAPP" "$storeFile" )"
			storePerm="$( stat -c '%a' "$storeFile" 2>/dev/null || stat -f '%Lp' "$storeFile" 2>/dev/null )"
			if [ "$storePerm" = "660" ] ; then
				echo "OK   660  $storeFile"
			else
				echo "BAD  ${storePerm:-?}  $storeFile  (expected 660)"
				storeFailed=1
			fi
		done

		if [ "$storeFailed" = "1" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --owner-credential-store-verify: one or more paths under $storeDir are not hardened to 660/770" >&2
			set +e ; return 1
		fi
		echo "# $MDSC_CMD --owner-credential-store-verify: all paths under $storeDir are correctly hardened (770 dir / 660 files)" >&2
		return 0
