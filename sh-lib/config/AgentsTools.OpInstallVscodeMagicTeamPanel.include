#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

## AgentsTools.OpInstallVscodeMagicTeamPanel.include -- the operation `--install-vscode-magic-team-panel`, sourced by AgentsTools.Install.include with the operation's arguments.
## Installs the Magic-Team VS Code panel: one authoritative unpacked copy in the
## workspace's own .local/agents/vscode-magic-team-panel/, linked into every folder the
## generated .code-workspace lists, and into the workspace root too, as
## <folder>/.vscode/extensions/magic-team-panel -- VS Code's local workspace extension.
## The root link is this slot's own exception to "the workspace root is never a VS Code
## folder" (MAGIC.md): it is the folder start.sh's own --extensions-dir reads. Also linked
## into $HOME, since a .code-workspace file is opened directly, without start.sh. Links
## follow --install-skillset-symlinks' own form. Needs no VS Code. Internal step of
## --install-vscode-integrations, out of help. See MAGIC.md.
		shift
		local panelWorkspace="${1:-$MMDAPP}"
		local panelSource="$MDLT_ORIGIN/myx/myx.distro-agents/vscode/magic-team"
		local panelSkillset="$MDLT_ORIGIN/myx/myx.distro-agents/skillset/magic-team/magic-team"
		local panelHome="$panelWorkspace/.local/agents/vscode-magic-team-panel"
		## The panel's files, named once: the check, the sum and the copy below all read this list.
		local panelFile panelFiles=( "$panelSource/package.json" "$panelSource/extension.js" "$panelSource/panel.js" "$panelSource/instructions.md" \
			"$panelSkillset/magic-team.basic.md" "$panelSkillset/resources/the-conclave.mark.svg" )
		for panelFile in ${panelFiles[@]+"${panelFiles[@]}"} ; do
			if [ ! -f "$panelFile" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --install-vscode-magic-team-panel: panel source file missing: $panelFile" >&2
				set +e ; return 1
			fi
		done
		## The payload in a fixed order: the sum decides a rewrite, so a changed team text
		## reaches the panel with no version bump.
		local panelSum
		panelSum="$( cat ${panelFiles[@]+"${panelFiles[@]}"} | cksum )" || {
			echo "⛔ ERROR: $MDSC_CMD --install-vscode-magic-team-panel: could not sum the panel payload" >&2
			set +e ; return 1
		}
		if [ "$( cat "$panelHome/.payload-sum" 2>/dev/null )" = "$panelSum" ] ; then
			echo "# $MDSC_CMD --install-vscode-magic-team-panel: panel unchanged: ${panelHome#"$panelWorkspace"/}" >&2
		else
			## Assembled beside the copy and swapped in by two renames, the old copy restored if
			## the second fails, so a failure never leaves the workspace with no panel. A crashed
			## earlier run's build siblings are swept first.
			local panelRc=0
			(
				mkdir -p "${panelHome%/*}" || exit 1
				rm -rf "${panelHome%/*}"/.vscode-magic-team-panel.* || exit 1
				panelBuild="$( mktemp -d "${panelHome%/*}/.vscode-magic-team-panel.XXXXXX" )" || exit 1
				trap 'rm -rf "$panelBuild"' EXIT
				cp ${panelFiles[@]+"${panelFiles[@]}"} "$panelBuild/" || exit 1
				printf '%s\n' "$panelSum" > "$panelBuild/.payload-sum" || exit 1
				chmod 755 "$panelBuild" || exit 1
				[ ! -e "$panelHome" ] || mv "$panelHome" "$panelBuild.old" || exit 1
				mv "$panelBuild" "$panelHome" || { [ ! -e "$panelBuild.old" ] || mv "$panelBuild.old" "$panelHome" ; exit 1 ; }
				rm -rf "$panelBuild.old"
			) || panelRc=$?
			if [ "$panelRc" != "0" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --install-vscode-magic-team-panel: could not write ${panelHome#"$panelWorkspace"/} -- any panel that was there is kept" >&2
				set +e ; return 1
			fi
			echo "🧩 Magic-Team panel written: ${panelHome#"$panelWorkspace"/}" >&2
		fi
		## Every folder the generated workspace file lists, and the workspace root, get the link.
		if ! AgentsToolsVscodeFolderLinks "$panelWorkspace" "$panelHome" ".vscode/extensions/magic-team-panel" install-vscode-magic-team-panel also-root ; then
			set +e ; return 1
		fi
		## Also linked into $HOME: a .code-workspace file is opened directly, without start.sh (MAGIC.md).
		local panelHomeSlot="$HOME/.vscode/extensions/magic-team-panel"
		mkdir -p "$HOME/.vscode/extensions" || {
			echo "⛔ ERROR: $MDSC_CMD --install-vscode-magic-team-panel: cannot create $HOME/.vscode/extensions" >&2
			set +e ; return 1
		}
		if [ -L "$panelHomeSlot" ] && [ ! -e "$panelHomeSlot" ] ; then
			echo "# $MDSC_CMD --install-vscode-magic-team-panel: $panelHomeSlot is a dangling symlink (points at $( readlink "$panelHomeSlot" ), which does not exist) -- reclaiming the slot" >&2
			rm -f "$panelHomeSlot" || {
				echo "⛔ ERROR: $MDSC_CMD --install-vscode-magic-team-panel: failed to remove dangling symlink: $panelHomeSlot" >&2
				set +e ; return 1
			}
		fi
		if [ "$panelHomeSlot" -ef "$panelHome" ] ; then
			echo "# $MDSC_CMD --install-vscode-magic-team-panel: $panelHomeSlot already linked" >&2
		elif [ -e "$panelHomeSlot" ] || [ -L "$panelHomeSlot" ] ; then
			echo "🙋 WARNING: $MDSC_CMD --install-vscode-magic-team-panel: real content at $panelHomeSlot, left untouched (outside the workspace)" >&2
		else
			AgentsToolsLinkMake "$panelHome" "$panelHomeSlot" || {
				echo "⛔ ERROR: $MDSC_CMD --install-vscode-magic-team-panel: failed to create symlink: $panelHomeSlot" >&2
				set +e ; return 1
			}
			echo "🔗 linked: $panelHomeSlot" >&2
		fi
		return 0
