#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.CredentialDisplay.include -- the one form in which a credential is printed (F11.8 of the
## refactorings epic). Sourced, never run. Functions only, and pure: no file, no setting, no output but the
## form itself. Whatever prints the value of a credential, in a row, a message or a file, asks this file
## for it and makes no form of its own.
##
## THE FORM: the first quarter of the value, rounded down, not less than 4 and not more than 20
## characters, then a `*` for every character after them, even for a long key. A value of fewer than 4
## characters is all `*`. A password inside a URL, `scheme://user:password@host`, is masked alone: the
## rest of the URL stands as it is. Which key is a credential is each console plugin's to enumerate
## (AgentsToolsManagerConfigKeySecret, sh-lib/manager/AgentsTools.ManagerConfig.include).
##

## A credential as it is printed, a value of any length.
AgentsToolsCredentialShown(){ ## value
	local LC_ALL=C shownValue="$1" shownLength shownHead=0 shownRest
	shownLength="${#shownValue}"
	if [ "$shownLength" -ge 4 ] ; then
		shownHead=$(( shownLength / 4 ))
		[ "$shownHead" -ge 4 ] || shownHead=4
		[ "$shownHead" -le 20 ] || shownHead=20
	fi
	printf '%s' "${shownValue:0:shownHead}"
	[ "$shownLength" -gt "$shownHead" ] || return 0
	printf -v shownRest '%*s' $(( shownLength - shownHead )) ''
	printf '%s' "${shownRest// /*}"
}

## A value that may hold URLs, as it is printed: the password of each `scheme://user:password@host` word
## masked as a credential, every other character as it stands. The words are parted by a blank, as
## WEB_ALLOW_PREFIXES keeps its URLs. rc 0 when a password was masked, rc 1 when the value held none.
AgentsToolsCredentialUrlShown(){ ## value
	local urlRest="$1" urlOut="" urlGap="" urlWord urlTail urlAuthority urlUser urlMasked=1
	while : ; do
		urlWord="${urlRest%% *}"
		case "$urlWord" in
			*://*@*)
				urlAuthority="${urlWord#*://}" ; urlTail=""
				case "$urlAuthority" in
					*[/?#]*) urlTail="${urlAuthority#"${urlAuthority%%[/?#]*}"}" ; urlAuthority="${urlAuthority%%[/?#]*}" ;;
				esac
				case "$urlAuthority" in
					*:*@*)
						urlUser="${urlAuthority%@*}"
						urlWord="${urlWord%%://*}://${urlUser%%:*}:$( AgentsToolsCredentialShown "${urlUser#*:}" )@${urlAuthority##*@}$urlTail"
						urlMasked=0
					;;
				esac
			;;
		esac
		urlOut="$urlOut$urlGap$urlWord"
		[ "${urlRest%% *}" != "$urlRest" ] || break
		urlRest="${urlRest#* }" ; urlGap=" "
	done
	printf '%s' "$urlOut"
	return "$urlMasked"
}
