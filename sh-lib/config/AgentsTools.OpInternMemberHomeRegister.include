#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

## AgentsTools.OpInternMemberHomeRegister.include -- the operation `--intern-member-home-register`, sourced by AgentsTools.Install.include with the operation's arguments.
## Every member's home of this workspace
## (AgentsTools.MemberHomes.include). Run by --make-workspace-integrations.
		shift
		if [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-member-home-register: takes no arguments" >&2
			set +e ; return 1
		fi
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.TeamRegistry.include"
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.MemberHomes.include"
		## AN INSTALL IS OF ITS OWN WORKSPACE ALONE (the human-owner): no other workspace is walked, read or written here.
		local homesStatus=0
		AgentsToolsMemberHomesWrite || homesStatus=1
		[ "$homesStatus" = "0" ] || { set +e ; return 1 ; }
		return 0
