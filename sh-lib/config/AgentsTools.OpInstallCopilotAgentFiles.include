#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

## AgentsTools.OpInstallCopilotAgentFiles.include -- the operation `--install-copilot-agent-files`, sourced by AgentsTools.Install.include with the operation's arguments.
## Generates one ~/.copilot/agents/<member>.agent.md per active team-member --
## copilot's on-disk equivalent of claude's inline --agents JSON. Acting
## members only: a reference-only member is never spawned, so it gets no
## agent file; no --workspace here since that reads $MDAT_SKILLSET_ROOT, fixed
## at DistroAgentsTools() entry, not an op-level flag. Internal step of
## --install-workspace-integrations, out of help, same as --install-copilot-access-fragment.
		shift

		while [ "$#" -gt 0 ] ; do
			case "$1" in
				*)
					echo "⛔ ERROR: $MDSC_CMD --install-copilot-agent-files: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done

		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/client/AgentsTools.ClientAccessRoots.include"

		local agentsDir="$HOME/.copilot/agents"
		mkdir -p "$agentsDir" || {
			echo "⛔ ERROR: $MDSC_CMD --install-copilot-agent-files: cannot create $agentsDir" >&2
			set +e ; return 1
		}

		## One line so `local` masks grep's exit 1 on a legitimately empty member set.
		local memberDirs ; memberDirs="$( AgentsToolsClientAccessRootsMembers acting )"
		local memberCount="$( printf '%s' "$memberDirs" | grep -c '' )"
		if [ "$memberCount" -lt 1 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --install-copilot-agent-files: this workspace resolved no member skillset directories -- refusing to write copilot agent files for zero members" >&2
			set +e ; return 1
		fi

		local memberDir memberName agentFile agentTmp agentText agentExisting hadError="false" writtenCount=0
		while IFS= read -r memberDir ; do
			[ -n "$memberDir" ] || continue
			memberName="${memberDir%/}" ; memberName="${memberName##*/}"
			agentFile="$agentsDir/$memberName.agent.md"
			agentTmp="$agentFile.tmp.$$"
			printf -v agentText -- '---\nname: %s\ndescription: magic-team member %s\n---\nYou are %s, a magic-team member. Read your own skill files before acting.\n' \
				"$memberName" "$memberName" "$memberName"
			agentExisting="" ; [ ! -f "$agentFile" ] || [ ! -r "$agentFile" ] || IFS= read -r -d '' agentExisting < "$agentFile" || :
			[ "$agentExisting" != "$agentText" ] || continue
			if ! printf '%s' "$agentText" > "$agentTmp" ; then
				echo "⛔ ERROR: $MDSC_CMD --install-copilot-agent-files: could not write $agentFile" >&2
				rm -f "$agentTmp" ; hadError="true" ; continue
			fi
			## Real content is never overwritten -- same refusal as
			## --install-skillset-symlinks's own "real content ... will not
			## overwrite", extended here to a file that exists but no longer
			## matches what this op would generate (a foreign hand-placed file
			## and a stale prior generation are indistinguishable without a
			## registry, so both are treated as real content and left alone).
			if [ -e "$agentFile" ] ; then
				echo "🙋 WARNING: $MDSC_CMD --install-copilot-agent-files: real content at $agentFile, left untouched (outside the workspace)" >&2
				rm -f "$agentTmp" ; continue
			fi
			if ! mv -f "$agentTmp" "$agentFile" ; then
				echo "⛔ ERROR: $MDSC_CMD --install-copilot-agent-files: could not install $agentFile" >&2
				rm -f "$agentTmp" ; hadError="true" ; continue
			fi
			writtenCount=$(( writtenCount + 1 ))
		done <<< "$memberDirs"

		if [ "$hadError" = "true" ] ; then
			set +e ; return 1
		fi
		echo "✅ copilot agent files configured (${memberCount} member(s), ${writtenCount} updated)" >&2
		return 0
