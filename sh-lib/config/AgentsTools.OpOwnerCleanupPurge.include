#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

## AgentsTools.OpOwnerCleanupPurge.include -- the operation `--owner-cleanup-purge`, sourced by AgentsTools.Owner.include with the operation's arguments.
		shift
		if [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --owner-cleanup-purge: takes no arguments -- always purges $MMDAPP/.local/.cleanup" >&2
			set +e ; return 1
		fi
		local cleanupDir="$MMDAPP/.local/.cleanup"
		local cleanupHold cleanupHoldState cleanupUnresolved=""
		local cleanupSpawned=""
		type AgentsSpawnedStoreDirInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.Paths.include"
		AgentsSpawnedStoreDirInto cleanupSpawned "$MMDAPP" || return 1
		type AgentsToolsUndoHoldState > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/undo/AgentsTools.UndoHold.include"
		for cleanupHold in "$cleanupSpawned"/*/undo.hold ; do
			[ -f "$cleanupHold" ] || continue
			cleanupHoldState="$( AgentsToolsUndoHoldState "$cleanupHold" )"
			case "$cleanupHoldState" in
				absent) ;;
				missing) cleanupUnresolved="$cleanupUnresolved $( AgentsToolsUndoHoldUnresolved "$cleanupHold" | LC_ALL=C tr '\n' ' ' )"
					echo "⛔ ERROR: $MDSC_CMD --owner-cleanup-purge: refusing -- ${cleanupHold%/undo.hold} carries a hold naming no open record, so what it protects cannot be told from what it does not:${cleanupUnresolved}" >&2
					set +e ; return 1
				;;
				*) echo "⛔ ERROR: $MDSC_CMD --owner-cleanup-purge: refusing -- an open undo record holds a sandbox of this workspace: $cleanupHold" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ ! -d "$cleanupDir" ] ; then
			echo "# $MDSC_CMD --owner-cleanup-purge: $cleanupDir does not exist -- nothing to purge" >&2
			return 0
		fi
		echo "# $MDSC_CMD --owner-cleanup-purge: purging all contents of $cleanupDir (folder itself stays)" >&2
		local cleanupEntry
		for cleanupEntry in "$cleanupDir"/* "$cleanupDir"/.[!.]* ; do
			[ -e "$cleanupEntry" ] || [ -L "$cleanupEntry" ] || continue
			echo "  rm -rf $cleanupEntry" >&2
			rm -rf -- "$cleanupEntry"
		done
		echo "# $MDSC_CMD --owner-cleanup-purge: done" >&2
		return 0
