#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

## AgentsTools.OpOwnerCredentialStoreHarden.include -- the operation `--owner-credential-store-harden`, sourced by AgentsTools.Owner.include with the operation's arguments.
		shift
		if [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --owner-credential-store-harden: takes no arguments -- always hardens the agents settings store of $MMDAPP" >&2
			set +e ; return 1
		fi
		local storeDir ; storeDir="$( AgentsSettingsStoreDir "$MMDAPP" )"
		if [ ! -d "$storeDir" ] ; then
			echo "# $MDSC_CMD --owner-credential-store-harden: $storeDir does not exist yet (nothing to harden)" >&2
			return 0
		fi
		local storeFailed=0
		chmod 770 "$storeDir" || storeFailed=1
		local storeFile
		for storeFile in $( AgentsSettingsScopes "$MMDAPP" ) ; do
			storeFile="$( AgentsSettingsScopeFile "$MMDAPP" "$storeFile" )"
			chmod 660 "$storeFile" || storeFailed=1
		done
		if [ "$storeFailed" = "1" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --owner-credential-store-harden: could not set 770/660 on every path under $storeDir" >&2
			set +e ; return 1
		fi
		type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
		DistroAgentsTools --owner-credential-store-verify || return 1
		return 0
