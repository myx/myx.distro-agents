#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

## Every link this file makes goes through AgentsToolsLinkMake: it refuses a link from a sandbox into source (epic S23.11).
. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/spawn/AgentsTools.SandboxLinks.include"

## Root-independent member enumeration for --install-skillset-symlinks: the
## bundled member names plus the workspace-declared team-member sources. Both
## are identical for every target root, so the fan branch scans once and threads
## the result through. Sets caller vars scanMemberNames / scanMemberSources /
## scanDiscoveryTrusted / scanDiscoveryError, so it always returns 0. Needs
## DistroAgentsTools() on the stack for $MDSC_CMD and $MDLT_ORIGIN.
AgentsToolsInstallScanMembers(){
	local scanWorkspace="$1" scanRemoveMode="$2" scanBundleRoot="$3"
	local scanMemberDir

	scanMemberNames=""
	scanMemberSources=""
	scanDiscoveryTrusted="true"
	scanDiscoveryError="false"

	if [ "$scanRemoveMode" = "true" ] ; then
		echo "# $MDSC_CMD --install-skillset-symlinks --remove: removing every line owned by this workspace, linking skipped" >&2
	else
		scanMemberNames="$(
			for scanMemberDir in "$scanBundleRoot"/*/ ; do
				[ -d "${scanMemberDir%/}" ] || continue
				basename "${scanMemberDir%/}"
			done | sort -u
		)"
	fi

	local selectedProjects selectStatus declaredMembers declaredStatus

	if [ "$scanRemoveMode" = "true" ] ; then
		scanMemberSources=""
	else
		## Both tools run in-process: a spawn wipes MDSC_*, re-detects its own input
		## spec and lands on a cache directory that is not there, rebuilding the
		## index on every touch. Bootstrap is the one every *.fn.sh tail carries,
		## since this op also runs with no distro context at all.
		## The index tier is established here rather than inherited, exactly as
		## --make-agents-indices does for its grants, and for the same reasons: reached
		## with no tier selected (an MCP execute call, a shell function) the scan reads no
		## index at all, and an inherited prepared or output cache that lags source drops real
		## team-member declarations. Source, the tier the agents console selects.
		## Another workspace is scanned in a subshell moved to its root, so its own index
		## is read and this process keeps its own.
		local scanSwitch=""
		[ "$scanWorkspace" = "$MMDAPP" ] || scanSwitch="$scanWorkspace"
		if [ -z "$scanSwitch" ] && ! DistroAgentsContext --distro-from-source ; then
			echo "⛔ ERROR: $MDSC_CMD --install-skillset-symlinks: COULD-NOT-CHECK declared team-members: cannot establish an input spec for workspace $scanWorkspace" >&2
			scanDiscoveryError="true" ; scanDiscoveryTrusted="false"
			return 0
		fi
		## Require loads by origin path -- Distro() alone resolves through PATH, which only a console session carries.
		Require ListDistroProjects || :
		Require ListDistroDeclares || :

		selectStatus=0
		if [ -z "$scanSwitch" ] ; then
			selectedProjects="$( Distro ListDistroProjects --select-all )" || selectStatus=$?
		else
			selectedProjects="$( AgentsToolsWorkspaceSwitch "$scanSwitch" ; DistroAgentsContext --distro-from-source || exit 97 ; Distro ListDistroProjects --select-all )" || selectStatus=$?
			if [ "$selectStatus" = "97" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --install-skillset-symlinks: COULD-NOT-CHECK declared team-members: cannot establish an input spec for workspace $scanWorkspace" >&2
				scanDiscoveryError="true" ; scanDiscoveryTrusted="false"
				return 0
			fi
		fi

		## --select-from-env refuses an empty selection, so an empty one is never
		## handed to it: the arm below reports that case for itself.
		declaredStatus=0
		if [ -z "$scanSwitch" ] ; then
			[ -z "$selectedProjects" ] || declaredMembers="$( MDSC_SELECT_PROJECTS="$selectedProjects" Distro ListDistroDeclares --select-from-env --filter-and-cut 'magic-team:team-member' )" || declaredStatus=$?
		else
			[ -z "$selectedProjects" ] || declaredMembers="$( AgentsToolsWorkspaceSwitch "$scanSwitch" ; DistroAgentsContext --distro-from-source || exit 97 ; MDSC_SELECT_PROJECTS="$selectedProjects" Distro ListDistroDeclares --select-from-env --filter-and-cut 'magic-team:team-member' )" || declaredStatus=$?
		fi

		if [ "$selectStatus" != "0" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --install-skillset-symlinks: COULD-NOT-CHECK declared team-members: ListDistroProjects --select-all exited $selectStatus for workspace $scanWorkspace" >&2
			scanDiscoveryError="true" ; scanDiscoveryTrusted="false"
		elif [ -z "$selectedProjects" ] ; then
			## A scan that succeeded and found nothing: with no project there is no
			## project declaring a member, so nothing was left undone and this is
			## not an error. A scan that could not read the index is not this case:
			## ListDistroProjects exits non-zero then, and the arm above reports it.
			## An empty set is still never read as 'every member disappeared', so
			## removal stays suppressed.
			## A RIG HAS NO DISTRO PROJECTS TO SELECT, AND THAT IS NOT A DEFECT TO REPORT. A deployed
			## workspace carries its tooling in .local and its members in the BUNDLED skillset beside
			## it: `source` holds no project.inf at all (measured on both rigs), so the selection is
			## empty by construction, not by failure. Warning here made every install print the same
			## pair of warnings in four directories -- a warning on a successful install is an error,
			## and it trains the reader to ignore the line that matters. The bundled skillset IS the
			## declared member set on such a workspace, so discovery is TRUSTED from it, and removal
			## still only ever takes what a scan positively found.
			if [ -d "$scanBundleRoot" ] ; then
				scanDiscoveryTrusted="true"
			else
				echo "🙋 WARNING: $MDSC_CMD --install-skillset-symlinks: workspace $scanWorkspace selects no distro projects and carries no bundled skillset, so none declares a team-member -- the bundled members are linked and nothing is removed" >&2
				scanDiscoveryTrusted="false"
			fi
		elif [ "$declaredStatus" != "0" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --install-skillset-symlinks: COULD-NOT-CHECK declared team-members: ListDistroDeclares --filter-and-cut exited $declaredStatus for workspace $scanWorkspace" >&2
			scanDiscoveryError="true" ; scanDiscoveryTrusted="false"
		else
			local dLine dProject dRest dSkillsetPath dHostGlob dMember dHostShort dHostFull
			dHostShort="$( hostname -s 2>/dev/null )" || dHostShort=""
			dHostFull="$( hostname 2>/dev/null )" || dHostFull=""
			while IFS= read -r dLine ; do
				[ -n "$dLine" ] || continue
				dProject="${dLine%% *}"
				dRest="${dLine#* }"
				dHostGlob="${dRest##*:}"
				dSkillsetPath="${dRest%:*}"
				dMember="$( basename "$dSkillsetPath" )"
				if [ -z "$dHostGlob" ] || [ "$dSkillsetPath" = "$dRest" ] ; then
					echo "⛔ ERROR: $MDSC_CMD --install-skillset-symlinks: malformed team-member declare in $dProject: magic-team:team-member:$dRest (expected skillset/<name>:<host-glob>)" >&2
					scanDiscoveryError="true"
					continue
				fi
				case "$dHostShort" in
					$dHostGlob) ;;
					*)
						case "$dHostFull" in
							$dHostGlob) ;;
							*)
								continue
							;;
						esac
					;;
				esac
				if [ ! -d "$scanWorkspace/source/$dProject/$dSkillsetPath" ] ; then
					echo "⛔ ERROR: $MDSC_CMD --install-skillset-symlinks: $dProject declares team-member $dMember but its skillset directory is missing: $scanWorkspace/source/$dProject/$dSkillsetPath" >&2
					scanDiscoveryError="true"
					continue
				fi
				scanMemberSources="${scanMemberSources}${dMember} ${scanWorkspace}/source/${dProject}/${dSkillsetPath}"$'\n'
			done <<< "$declaredMembers"
		fi
	fi
}

## Classifies one resolved symlink target ($1) against a workspace root ($2) for the
## --install-skillset-symlinks report. Sets caller vars classifyHome / classifyWspace,
## which the caller copies -- the same assign-to-caller shape AgentsToolsInstallScanMembers
## uses for its own scan* vars. Anything not under $2 is extern: another workspace, the
## shared origin, off-tree.
AgentsToolsInstallClassifyTarget(){
	local classifyTarget="$1" classifyWorkspace="$2"
	case "$classifyTarget" in
		"$classifyWorkspace"/.local/*) classifyWspace=".local" ; classifyHome="yes" ;;
		"$classifyWorkspace"/source/*) classifyWspace="source" ; classifyHome="yes" ;;
		'')                            classifyWspace="-"      ; classifyHome="-" ;;
		*)                             classifyWspace="extern" ; classifyHome="no" ;;
	esac
}

## Links one authoritative path into every folder the workspace's generated
## .code-workspace lists, as <folder>/<slot>: the workspace root is never a VS Code folder,
## so what VS Code reads per folder reaches it only this way (MAGIC.md). The link form is
## --install-skillset-symlinks' own: a dangling link is reclaimed, a link already to the
## authoritative path is kept, and a link elsewhere or real content is reported and never
## overwritten. Args: workspace, authoritative path, slot relative to each folder, context
## for messages, and an optional 5th arg -- any non-empty value also links the slot into the
## workspace root itself, by the same per-slot rules, for a caller whose own target is read
## from the workspace root regardless of which listed folder is open (e.g. start.sh's own
## --extensions-dir). Returns 1 when any slot could not be settled, each stated.
AgentsToolsVscodeFolderLinks(){
	local linkWorkspace="$1" linkTarget="$2" linkRelative="$3" linkContext="$4" linkAlsoRoot="$5"
	local linkWsFile="$linkWorkspace/${linkWorkspace##*/}.code-workspace"
	if [ ! -f "$linkWsFile" ] ; then
		echo "🙋 WARNING: $MDSC_CMD --$linkContext: no generated workspace file at $linkWsFile, so no VS Code folder gets $linkRelative yet -- the next integrations run links them" >&2
		return 0
	fi
	local linkFolder linkSlot linkHadError="false" linkNew="" linkKept="" linkWorkspaceReal
	if [ ! -e "$linkTarget" ] ; then
		echo "# $MDSC_CMD --$linkContext: $linkTarget does not exist yet, so no VS Code folder gets $linkRelative -- the next integrations run links it" >&2
		return 0
	fi
	linkWorkspaceReal="$( cd -P "$linkWorkspace" && pwd -P )" || {
		echo "⛔ ERROR: $MDSC_CMD --$linkContext: cannot resolve the workspace $linkWorkspace" >&2 ; return 1 ; }
	while IFS= read -r linkFolder ; do
		[ -n "$linkFolder" ] || continue
		linkFolder="${linkFolder%/}"
		if [ ! -d "$linkFolder" ] ; then
			echo "# $MDSC_CMD --$linkContext: listed folder absent, not linked: $linkFolder" >&2
			continue
		fi
		case "$( cd -P "$linkFolder" && pwd -P )/" in
			"$linkWorkspaceReal"/*) ;;
			*) echo "🙋 WARNING: $MDSC_CMD --$linkContext: listed folder lies outside the workspace, left untouched: $linkFolder" >&2 ; continue ;;
		esac
		linkSlot="$linkFolder/$linkRelative"
		if [ -L "$linkSlot" ] && [ ! -e "$linkSlot" ] ; then
			echo "# $MDSC_CMD --$linkContext: $linkSlot is a dangling symlink (points at $( readlink "$linkSlot" ), which does not exist) -- reclaiming the slot" >&2
			if ! rm -f "$linkSlot" ; then
				echo "⛔ ERROR: $MDSC_CMD --$linkContext: failed to remove dangling symlink: $linkSlot" >&2
				linkHadError="true" ; continue
			fi
		elif [ "$linkSlot" -ef "$linkTarget" ] ; then
			linkKept="$linkKept." ; continue
		elif [ -L "$linkSlot" ] || [ -e "$linkSlot" ] ; then
			case "$( cd -P "${linkSlot%/*}" && pwd -P )/" in
				"$linkWorkspaceReal"/*) ;;
				*) echo "🙋 WARNING: $MDSC_CMD --$linkContext: $linkSlot lies outside the workspace, left untouched" >&2 ; continue ;;
			esac
			[ -L "$linkSlot" ] || [ ! -d "$linkSlot" ] || case "$( cd -P "$linkTarget" && pwd -P )/" in "$( cd -P "$linkSlot" && pwd -P )"/*)
				echo "⛔ ERROR: $MDSC_CMD --$linkContext: $linkSlot holds $linkTarget itself, not removed" >&2 ; linkHadError="true" ; continue ;;
			esac
			rm -rf -- "$linkSlot" || { echo "⛔ ERROR: $MDSC_CMD --$linkContext: failed to remove $linkSlot" >&2 ; linkHadError="true" ; continue ; }
			echo "# $MDSC_CMD --$linkContext: removed: $linkSlot" >&2
		fi
		if ! { mkdir -p "${linkSlot%/*}" && AgentsToolsLinkMake "$linkTarget" "$linkSlot" ; } ; then
			echo "⛔ ERROR: $MDSC_CMD --$linkContext: failed to create symlink: $linkSlot" >&2
			linkHadError="true" ; continue
		fi
		linkNew="$linkNew." ; echo "🔗 linked: $linkSlot" >&2
	done < <( { [ -z "$linkAlsoRoot" ] || printf '%s\n' "$linkWorkspace" ; LC_ALL=C awk '{ t = $0 ; while ( match( t, /"path"[ \t]*:[ \t]*"[^"]*"/ ) ) { v = substr( t, RSTART, RLENGTH ) ; sub( /^"path"[ \t]*:[ \t]*"/, "", v ) ; sub( /"$/, "", v ) ; print v ; t = substr( t, RSTART + RLENGTH ) ; } ; }' "$linkWsFile" ; } )
	echo "# $MDSC_CMD --$linkContext: $linkRelative: ${#linkNew} folder(s) newly linked, ${#linkKept} already linked" >&2
	[ "$linkHadError" = "false" ]
}
## Resolves the icon for a --install-skillset-symlinks / --install-skillset-report-render row's
## MEMBER column ($1) into the caller's `reportWho`, the same assign-to-caller-var shape
## AgentsToolsInstallClassifyTarget uses for classifyHome/classifyWspace. $2, when non-empty, is
## the member's own already-resolved explicit/custom icon -- it always wins over the default of
## the member's kind and is passed straight through untouched. That default is not listed here:
## it is the one list a message's author line takes it from too (AgentsToolsTeamMemberKindIcon,
## AgentsTools.TeamRegistry.include). No caller wires a $2 in yet (there is
## no explicit-icon source plumbed into this report today); the parameter exists so a future one
## has a seam here without another edit to the four call sites.
AgentsToolsInstallReportIcon(){
	local iconName="$1" iconExplicit="$2"
	if [ -n "$iconExplicit" ] ; then
		reportWho="$iconExplicit"
		return 0
	fi
	type AgentsToolsTeamMemberKindIcon > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.TeamRegistry.include"
	reportWho="$( AgentsToolsTeamMemberKindIcon "$iconName" )"
}

## A user-home slot that already links to another workspace's copy of a member: which copy
## holds it (human-owner, 2026-10-09). Prints `claim` when this workspace holds the member in
## its own source/ and the link reaches another workspace's installed copy (under
## <workspace>/.local/myx/): the source workspace relinks the slot to its own copy. Prints
## `keep` when the link reaches another workspace's source copy: the link stays and this
## workspace registers its own copy -- an installed copy never takes the slot from a source
## one, and a second source copy is one WARNING naming both, nothing more. Prints nothing
## for any other slot, which the rules after it decide as before.
AgentsToolsInstallSlotClaim(){ ## scope, workspace, slot, this workspace's own copy, member
	local claimScope="$1" claimWorkspace="$2" claimSlot="$3" claimOwn="$4" claimMember="$5" claimLinked
	## In the workspace scope the same rule holds: an installed copy never takes the slot from a source one. A member link
	## into any .local/myx install, this workspace's own included, is relinked to the bundled copy where that is a source copy.
	if [ "$claimScope" = "workspace" ] && [ -L "$claimSlot" ] && [ ! "$claimSlot" -ef "$claimOwn" ] ; then
		claimLinked="$( readlink "$claimSlot" )"
		case "$claimLinked" in
			/*/.local/myx/*)
				case "$claimOwn" in
					*/.local/myx/*) ;;
					*)
						echo "# $MDSC_CMD --install-skillset-symlinks: $claimSlot links to the installed copy $claimLinked -- relinking to the source copy $claimOwn" >&2
						printf '%s\n' claim
					;;
				esac
			;;
		esac
		return 0
	fi
	[ "$claimScope" = "user-home" ] && [ -L "$claimSlot" ] || return 0
	[ ! "$claimSlot" -ef "$claimOwn" ] || return 0
	claimLinked="$( readlink "$claimSlot" )"
	case "$claimLinked" in
		"$claimWorkspace"/*) return 0 ;;
		/*/.local/myx/*)
			case "$claimOwn" in
				"$claimWorkspace/source/"*)
					echo "# $MDSC_CMD --install-skillset-symlinks: $claimSlot links to another workspace's installed copy $claimLinked, and this workspace holds $claimMember in its source -- relinking to $claimOwn" >&2
					printf '%s\n' claim
				;;
			esac
		;;
		/*/source/*)
			case "$claimOwn" in
				"$claimWorkspace/source/"*)
					echo "🙋 WARNING: $MDSC_CMD --install-skillset-symlinks: $claimMember has two source copies: $claimSlot keeps $claimLinked, and this workspace's own $claimOwn is registered beside it" >&2
				;;
			esac
			printf '%s\n' keep
		;;
	esac
	return 0
}

## Whether a link this workspace does not own is still the RIG's own skillset (item 22). A rig is ONE workspace
## per machine -- the mode AgentsToolsWorkspaceMode reads, `team-rig` -- so a link that leaves both this workspace
## and its origin has no second workspace on the machine to belong to. That is exactly what the foreign branch
## below would separate, and on a rig there is nothing there to separate: what such a link reaches is the rig's
## own skillset, through an install prefix or a name the one workspace carried before it moved. Recognised by what
## it is, a `<...>/skillset/<member>` copy of this family's own; a target of any other shape points elsewhere and
## stays foreign, rig or no rig. Off a rig this is always false, so nothing changes there.
AgentsToolsInstallRigOwnSkillset(){ ## resolved link target, the member or rules-file name it should hold
	local rigOwnTarget="${1%/}" rigOwnName="$2" rigOwnMode=""
	case "$rigOwnTarget" in
		*/skillset/*) ;;
		*) return 1 ;;
	esac
	[ "${rigOwnTarget##*/}" = "$rigOwnName" ] || return 1
	type AgentsToolsWorkspaceMode > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.TeamDataGate.include"
	read -r rigOwnMode _ <<< "$( AgentsToolsWorkspaceMode )" || return 1
	[ "$rigOwnMode" = "team-rig" ]
}

## Whether a path lies inside one of the machine's registered workspace places (S14.2). A rig holds its main workspace
## and extra ones (sketch 15.3), and the places registry is the list of them: on a rig a link into any registered
## workspace place is the rig's own, so it is neither foreign nor warned about. A rig that registers no extra
## workspace behaves as it did; off a rig this is always false.
AgentsToolsInstallRigWorkspacePlace(){ ## path
	local placePath="${1%/}" placeMode="" placeFile placeName placeKind placeCeiling placeRoot placeDeclared
	[ -n "$placePath" ] || return 1
	type AgentsToolsWorkspaceMode > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.TeamDataGate.include"
	read -r placeMode _ <<< "$( AgentsToolsWorkspaceMode )" || return 1
	[ "$placeMode" = "team-rig" ] || return 1
	placeFile="${MMDAPP%/}/.local/agents/directories.registry"
	[ -f "$placeFile" ] || return 1
	while IFS=$'\t' read -r placeName placeKind placeCeiling placeRoot placeDeclared ; do
		[ "$placeKind" = "workspace" ] || continue
		[ -n "$placeRoot" ] || continue
		case "$placePath/" in "${placeRoot%/}/"*) return 0 ;; esac
	done < "$placeFile"
	return 1
}

## The DeepSeek Harness home patch (F4.2): one `- insert:` row in $HOME/.dsh/cordis.patch.yml,
## the file DSH applies over every profile, so every chat of this workspace reaches the
## myx-distro server with no preset chosen and no default. A machine with no DSH home is not
## an error. No YAML reader is run -- a tool that may be absent must not decide the result:
## the row is plain block YAML, values single-quoted, and a row of ours already there is
## found by its id and replaced whole, so a second run leaves the bytes the first one wrote.
agentsDshPatchBegin='# >>> myx.distro-agents: myx-distro MCP client row for DeepSeek Harness -- managed block, replaced on update >>>'
agentsDshPatchEnd='# <<< myx.distro-agents: myx-distro MCP client row for DeepSeek Harness <<<'

## One YAML scalar, single-quoted: a single quote is doubled, every other byte is itself.
## Sets agentsDshValue.
AgentsToolsInstallDshPatchValue(){ ## text
	agentsDshValue="'$( printf '%s' "$1" | LC_ALL=C sed "s/'/''/g" )'"
}

## Writes the row, marker comments included, to a file. The `- insert:` item is the shape
## DSH's own hand install used and the shape the brief fixes.
AgentsToolsInstallDshPatchRow(){ ## workspace, file
	local rowWorkspace="$1" rowFile="$2" rowCommand rowRoot
	AgentsToolsInstallDshPatchValue "$rowWorkspace/.local/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
	rowCommand="$agentsDshValue"
	AgentsToolsInstallDshPatchValue "$rowWorkspace"
	rowRoot="$agentsDshValue"
	{
		printf '%s\n' "$agentsDshPatchBegin"
		printf '%s\n' '- insert:'
		printf '%s\n' '    - id: myx-distro-mcp'
		printf '%s\n' "      name: '@deepseek-ai/dsh-mcp-client'"
		printf '%s\n' '      config:'
		printf '%s\n' '        serverName: myx-distro'
		printf '%s\n' '        transport: stdio'
		printf '%s\n' "        command: $rowCommand"
		printf '%s\n' '        args:'
		printf '%s\n' '          - --intern-mcp-server'
		printf '%s\n' '          - --run'
		printf '%s\n' '        env:'
		printf '%s\n' "          MMDAPP: $rowRoot"
		printf '%s\n' '        failOnStartupError: false'
		printf '%s\n' "$agentsDshPatchEnd"
	} > "$rowFile"
}

## Whether one line of a patch file is an `id:` line at all; when it is, agentsDshRowId is
## its value, quotes taken off. Used only for this file's own two-space block style, which
## is what an install of ours writes and what the hand install that preceded it wrote.
AgentsToolsInstallDshPatchId(){ ## line
	local idLine="$1" idTrim idValue
	idTrim="${idLine#"${idLine%%[![:space:]]*}"}"
	## The id of an insert row sits on a sequence item of its own: `- id: ...`, and the
	## indentation is the only thing between the two forms of the same row.
	case "$idTrim" in
		-\ *) idTrim="${idTrim#- }" ; idTrim="${idTrim#"${idTrim%%[![:space:]]*}"}" ;;
	esac
	case "$idTrim" in
		id:*) ;;
		*) return 1 ;;
	esac
	idValue="${idTrim#id:}"
	idValue="${idValue#"${idValue%%[![:space:]]*}"}"
	idValue="${idValue%"${idValue##*[![:space:]]}"}"
	case "$idValue" in
		\'*\') idValue="${idValue#\'}" ; idValue="${idValue%\'}" ;;
		\"*\") idValue="${idValue#\"}" ; idValue="${idValue%\"}" ;;
	esac
	agentsDshRowId="$idValue"
	return 0
}

## The DSH home-patch write, called by --install-vscode-integrations itself: no name of its
## own and no option of its own. One argument, the workspace whose MCP server the row mounts.
AgentsToolsInstallDshHomePatch(){ ## workspace
	local patchWorkspace="${1:-$MMDAPP}" patchDsHome patchFile
	local patchBeginAt patchEndAt patchCount patchIdx patchLine patchAction patchMode patchTemp
	local patchTrim patchFirst patchSignificant patchBlockStart patchBlockEnd patchBlockScan patchBlockIds patchBlockMine patchFound
	local patchLines

	if [ ! -d "$patchWorkspace" ] ; then
		echo "⛔ ERROR: $MDSC_CMD --install-vscode-integrations: the workspace does not resolve to a directory -- nothing was installed" >&2
		return 1
	fi
	patchWorkspace="$( cd "$patchWorkspace" && pwd )"
	case "$patchWorkspace" in
		*$'\n'*)
			echo "⛔ ERROR: $MDSC_CMD --install-vscode-integrations: the workspace path carries a newline, which the harness patch cannot hold -- nothing was installed" >&2
			return 1
		;;
	esac
	if [ ! -x "$patchWorkspace/.local/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh" ] ; then
		echo "⛔ ERROR: $MDSC_CMD --install-vscode-integrations: the workspace is not a set-up myx.distro workspace, so its MCP server cannot be named -- nothing was installed" >&2
		return 1
	fi

	## No DSH home: the harness is not installed for this user. Not an error, and no file:
	## a machine without the app gets the rest of the integrations and no harness patch.
	if [ -z "${HOME:-}" ] || [ ! -d "$HOME/.dsh" ] ; then
		echo "# $MDSC_CMD --install-vscode-integrations: DeepSeek Harness is not installed there -- its home patch is unchanged" >&2
		return 0
	fi
	patchDsHome="$HOME/.dsh"
	patchFile="$patchDsHome/cordis.patch.yml"

	(
		umask 022
		patchBase="$MMDAPP/.local/temp"
		[ -z "${MDAT_SPAWN_SANDBOX_ROOT:-}" ] || patchBase="$MDAT_SPAWN_SANDBOX_ROOT/output"
		mkdir -p "$patchBase" || { echo "⛔ ERROR: $MDSC_CMD --install-vscode-integrations: cannot make the step's scratch folder -- nothing was changed" >&2 ; exit 1 ; }
		patchTmp="$( mktemp -d "$patchBase/dsh-home-patch.XXXXXX" )" || { echo "⛔ ERROR: $MDSC_CMD --install-vscode-integrations: cannot make the step's scratch folder -- nothing was changed" >&2 ; exit 1 ; }
		trap 'rm -rf "$patchTmp"' EXIT
		AgentsToolsInstallDshPatchRow "$patchWorkspace" "$patchTmp/want" || { echo "⛔ ERROR: $MDSC_CMD --install-vscode-integrations: cannot write the row this step installs -- nothing was changed" >&2 ; exit 1 ; }

		if [ -L "$patchFile" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --install-vscode-integrations: the DeepSeek Harness home patch is a symbolic link, and installing would put a file where the link is -- left unchanged" >&2
			exit 1
		fi
		if [ -e "$patchFile" ] && [ ! -f "$patchFile" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --install-vscode-integrations: the DeepSeek Harness home patch is not a regular file -- left unchanged" >&2
			exit 1
		fi
		if [ -f "$patchFile" ] && [ ! -r "$patchFile" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --install-vscode-integrations: the DeepSeek Harness home patch cannot be read -- left unchanged" >&2
			exit 1
		fi

		patchCount=0
		if [ -f "$patchFile" ] ; then
			while IFS= read -r patchLine || [ -n "$patchLine" ] ; do
				patchLines[$patchCount]="$patchLine"
				patchCount=$(( patchCount + 1 ))
			done < "$patchFile"
		fi

		patchBeginAt=0
		patchIdx=0
		while [ "$patchIdx" -lt "$patchCount" ] ; do
			[ "${patchLines[$patchIdx]}" != "$agentsDshPatchBegin" ] || { patchBeginAt=$(( patchIdx + 1 )) ; break ; }
			patchIdx=$(( patchIdx + 1 ))
		done
		patchEndAt=0
		if [ "$patchBeginAt" -gt 0 ] ; then
			patchIdx="$patchBeginAt"
			while [ "$patchIdx" -lt "$patchCount" ] ; do
				[ "${patchLines[$patchIdx]}" != "$agentsDshPatchEnd" ] || { patchEndAt=$(( patchIdx + 1 )) ; break ; }
				patchIdx=$(( patchIdx + 1 ))
			done
			if [ "$patchEndAt" = "0" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --install-vscode-integrations: the managed block in the DeepSeek Harness home patch has no closing marker, so nothing tells a writer what it may replace -- left unchanged" >&2
				exit 1
			fi
		fi

		if [ "$patchBeginAt" -gt 0 ] ; then
			patchIdx=$(( patchBeginAt - 1 ))
			: > "$patchTmp/have"
			while [ "$patchIdx" -lt "$patchEndAt" ] ; do
				printf '%s\n' "${patchLines[$patchIdx]}" >> "$patchTmp/have"
				patchIdx=$(( patchIdx + 1 ))
			done
			if cmp -s "$patchTmp/have" "$patchTmp/want" ; then
				echo "✅ $MDSC_CMD --install-vscode-integrations: DeepSeek Harness home patch already current -- nothing changed" >&2
				exit 0
			fi
			patchAction="updated"
			patchBlockStart=$(( patchBeginAt - 1 ))
			patchBlockEnd="$patchEndAt"
		else
			## No marker of ours: adopt a row the hand install wrote, one top-level
			## `- insert:` item holding exactly one id, ours. Anything else is another
			## row's and is never touched.
			patchFound=0
			patchBlockStart=0
			while [ "$patchBlockStart" -lt "$patchCount" ] ; do
				case "${patchLines[$patchBlockStart]}" in
					-|-\ *) ;;
					*) patchBlockStart=$(( patchBlockStart + 1 )) ; continue ;;
				esac
				case "${patchLines[$patchBlockStart]}" in
					"- insert:"*) ;;
					*) patchBlockStart=$(( patchBlockStart + 1 )) ; continue ;;
				esac
				patchBlockEnd=$(( patchBlockStart + 1 ))
				while [ "$patchBlockEnd" -lt "$patchCount" ] ; do
					case "${patchLines[$patchBlockEnd]}" in
						-|-\ *) break ;;
					esac
					patchBlockEnd=$(( patchBlockEnd + 1 ))
				done
				patchBlockIds=0 ; patchBlockMine=0 ; patchBlockScan="$patchBlockStart"
				while [ "$patchBlockScan" -lt "$patchBlockEnd" ] ; do
					if AgentsToolsInstallDshPatchId "${patchLines[$patchBlockScan]}" ; then
						patchBlockIds=$(( patchBlockIds + 1 ))
						[ "$agentsDshRowId" != "myx-distro-mcp" ] || patchBlockMine=$(( patchBlockMine + 1 ))
					fi
					patchBlockScan=$(( patchBlockScan + 1 ))
				done
				if [ "$patchBlockIds" = "1" ] && [ "$patchBlockMine" = "1" ] ; then
					patchFound=1 ; break
				fi
				patchBlockStart="$patchBlockEnd"
			done
			if [ "$patchFound" = "1" ] ; then
				patchAction="updated"
			else
				patchAction="installed"
			fi
		fi

		: > "$patchTmp/new"
		if [ "$patchBeginAt" -gt 0 ] || [ "$patchFound" = "1" ] ; then
			patchIdx=0
			while [ "$patchIdx" -lt "$patchBlockStart" ] ; do
				printf '%s\n' "${patchLines[$patchIdx]}" >> "$patchTmp/new"
				patchIdx=$(( patchIdx + 1 ))
			done
			cat "$patchTmp/want" >> "$patchTmp/new"
			patchIdx="$patchBlockEnd"
			while [ "$patchIdx" -lt "$patchCount" ] ; do
				printf '%s\n' "${patchLines[$patchIdx]}" >> "$patchTmp/new"
				patchIdx=$(( patchIdx + 1 ))
			done
		else
			## An existing block list is kept as it is, comments included, and the row
			## appended after it. An empty flow list (`[]`, comments around it allowed)
			## is the one shape an appended block item would make invalid, so it alone is
			## replaced by the row. Any other first shape -- a non-empty flow list, a
			## mapping -- is refused rather than made into a file that is not YAML: this
			## writer knows a block sequence, and it runs no YAML reader.
			patchFirst="" ; patchSignificant=0
			patchIdx=0
			while [ "$patchIdx" -lt "$patchCount" ] ; do
				patchTrim="${patchLines[$patchIdx]}"
				patchTrim="${patchTrim#"${patchTrim%%[![:space:]]*}"}"
				patchTrim="${patchTrim%"${patchTrim##*[![:space:]]}"}"
				patchIdx=$(( patchIdx + 1 ))
				case "$patchTrim" in
					""|"#"*) continue ;;
				esac
				patchSignificant=$(( patchSignificant + 1 ))
				[ -n "$patchFirst" ] || patchFirst="$patchTrim"
			done
			case "$patchFirst" in
				"") ;;
				"[]")
					[ "$patchSignificant" = "1" ] || {
						echo "⛔ ERROR: $MDSC_CMD --install-vscode-integrations: the DeepSeek Harness home patch is a flow-style list this step cannot extend without a YAML reader -- left unchanged" >&2
						exit 1
					}
				;;
				-|-\ *) ;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --install-vscode-integrations: the DeepSeek Harness home patch is not a block list this step can extend without a YAML reader -- left unchanged" >&2
					exit 1
				;;
			esac
			if [ -z "$patchFirst" ] || [ "$patchFirst" = "[]" ] ; then
				: # the row alone
			else
				patchIdx=0
				while [ "$patchIdx" -lt "$patchCount" ] ; do
					printf '%s\n' "${patchLines[$patchIdx]}" >> "$patchTmp/new"
					patchIdx=$(( patchIdx + 1 ))
				done
			fi
			cat "$patchTmp/want" >> "$patchTmp/new"
		fi

		patchMode="644"
		if [ -f "$patchFile" ] ; then
			patchMode="$( stat -c '%a' "$patchFile" 2> /dev/null || stat -f '%Lp' "$patchFile" 2> /dev/null )"
			if [ -z "$patchMode" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --install-vscode-integrations: cannot read the mode of the DeepSeek Harness home patch, so a replacement could not be given the same one -- left unchanged" >&2
				exit 1
			fi
		fi
		patchTemp="$( mktemp "$patchDsHome/cordis.patch.yml.XXXXXX" )" || { echo "⛔ ERROR: $MDSC_CMD --install-vscode-integrations: cannot write beside the DeepSeek Harness home patch -- nothing was changed" >&2 ; exit 1 ; }
		if ! cat "$patchTmp/new" > "$patchTemp" ; then
			rm -f "$patchTemp"
			echo "⛔ ERROR: $MDSC_CMD --install-vscode-integrations: cannot write the DeepSeek Harness home patch -- nothing was changed" >&2
			exit 1
		fi
		if ! chmod "$patchMode" "$patchTemp" ; then
			rm -f "$patchTemp"
			echo "⛔ ERROR: $MDSC_CMD --install-vscode-integrations: cannot give the DeepSeek Harness home patch its mode -- nothing was changed" >&2
			exit 1
		fi
		if ! mv -f "$patchTemp" "$patchFile" ; then
			rm -f "$patchTemp"
			echo "⛔ ERROR: $MDSC_CMD --install-vscode-integrations: cannot install the DeepSeek Harness home patch -- nothing was changed" >&2
			exit 1
		fi

		case "$patchAction" in
			installed) echo "🧩 $MDSC_CMD --install-vscode-integrations: DeepSeek Harness home patch installed -- the myx-distro MCP client row" >&2 ;;
			updated) echo "🧩 $MDSC_CMD --install-vscode-integrations: DeepSeek Harness home patch updated -- the myx-distro MCP client row" >&2 ;;
		esac
		exit 0
	)
}

case "$1" in

	--install-skillset-symlinks)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/config/AgentsTools.OpInstallSkillsetSymlinks.include"
	;;

	--install-skillset-report-render)
		shift
		[ -s "$MDSC_SKILLSET_REPORT" ] || return 0
		LC_ALL=C awk -F'\t' -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/config/AgentsInstallSkillsetReportRender.awk" "$MDSC_SKILLSET_REPORT" >&2
		return 0
	;;

	--intern-member-home-register)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/config/AgentsTools.OpInternMemberHomeRegister.include"
	;;

	--install-claude-permissions)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/config/AgentsTools.OpInstallClaudePermissions.include"
	;;

	--install-workspace-restrictions)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/config/AgentsTools.OpInstallWorkspaceRestrictions.include"
	;;

	--install-copilot-access-fragment)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/config/AgentsTools.OpInstallCopilotAccessFragment.include"
	;;

	--install-copilot-agent-files)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/config/AgentsTools.OpInstallCopilotAgentFiles.include"
	;;

	--install-vscode-magic-team-panel)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/config/AgentsTools.OpInstallVscodeMagicTeamPanel.include"
	;;

	--install-claude-workspace-trust)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/config/AgentsTools.OpInstallClaudeWorkspaceTrust.include"
	;;

	--install-workspace-integrations)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/config/AgentsTools.OpInstallWorkspaceIntegrations.include"
	;;

	--install-vscode-integrations)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/config/AgentsTools.OpInstallVscodeIntegrations.include"
	;;
	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
