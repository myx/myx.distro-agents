#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.OwnerSetupOptionSpec.include -- the option catalogue of the
## --owner-setup-<domain> family. Sourced, never run. Functions only.
##
## A reader of one option takes its scope from here rather than restating it:
## optionSpec="$( AgentsToolsOwnerSetupOptionSpec KEY )", then "${optionSpec%%|*}".
##

## The catalogue: `scope|placeholder|secret|how-to-obtain`, one entry per option
## any domain may declare. `secret` marks a value that never travels in argv.
## THIS is the single definition of an option -- a domain names it and takes
## these, rather than restating any of them.
AgentsToolsOwnerSetupOptionSpec(){
	case "$1" in
		## No '|' inside a field: it is this line's own separator, so one in a
		## placeholder splits the entry and every later field arrives shifted.
		SPAWN_CLI_SERVICE)
			printf '%s\n' 'magic-team|<cli-name>|plain|the agent CLI this workspace starts -- copilot, claude, claude-native, grok, grok-native or scaleway. A spawned agent runs non-interactively, where the console accepts only copilot, claude, claude-native, grok and scaleway.'
		;;
		WEB_ALLOW_PREFIXES)
			printf '%s\n' 'magic-team|<url-prefix>[ <url-prefix>...]|plain|extra URL prefixes WebFetch may fetch, beyond the built-in http and https prefixes of wikipedia.org and freebsd.org. Space-separated, such as https://docs.example.org/api/. A prefix covers its scheme, its host and the subdomains of that host, and every path that starts with its own.'
		;;
		WEB_DENY_PREFIXES)
			printf '%s\n' 'magic-team|<url-prefix>[ <url-prefix>...]|plain|URL prefixes WebFetch never fetches, even under an allowed or built-in prefix. Space-separated, matched as WEB_ALLOW_PREFIXES is. A WebSearch result under one of them is no longer kept outside allowed_domains.'
		;;
		HARNESS_STREAM_ATTEMPTS)
			printf '%s\n' 'magic-team|<attempts>|plain|how many attempts one round of a harness run may make before it gives up, in whole numbers from 1 to 10. A round that fails on a temporary refusal (HTTP 429, 500, 502, 503, 504, 529, or an error type that says the same) is retried with a backoff; a final refusal ends the round at once. Unset is 3.'
		;;
		HARNESS_RETRY_DELAY)
			printf '%s\n' 'magic-team|<seconds>|plain|how long a harness run waits before its first retry of a round, in whole seconds from 0 to 30. Each later wait doubles, never past 30. Unset is 1. Zero retries at once.'
		;;
		HARNESS_PARALLEL_TOOL_CALLS)
			printf '%s\n' 'magic-team|<on|off>|plain|whether a spawn tells its server that the server may take parallel tool calls, on the OpenAI chat wire. Unset asks for nothing, so a server that does not take the field is never asked it. Set it only where the service is known to accept it.'
		;;
		HUMAN_OWNER_CONSOLE_ACCOUNT)
			printf '%s\n' 'magic-team|<account>|plain|the account at the console that is the human-owner: the name the console runs as, without the user- prefix. An action of that person -- a kill, an answer to an escalation -- is the owner'"'"'s own, confirmed with him in his own conversation instead of being asked of a session thread. Unset means the console is not mapped to any owner, and every owner action escalates.'
		;;
		## The one override of the wait round every CLI service has a number of its own for
		## (AgentsTools.CliService.include).
		WAIT_ROUND_SECONDS)
			printf '%s\n' 'magic-team|<seconds>|plain|how long a wait of a session that brings nothing runs before it comes back, in whole seconds, for every session of this workspace whatever CLI it runs on. Left unset each CLI service takes its own: a little under the lifetime of its prompt cache where that is known, else 270, under a five-minute cache. Set it only where the cache of the service in use here is known to live longer or shorter than that.'
		;;
		## The window of the work-duty input scan's collect (F4.1, AgentsTools.InternOpWorkDuty.include).
		WAIT_COLLECT_SECONDS)
			printf '%s\n' 'magic-team|<seconds>|plain|how long the work-duty input scan collects the team channel before it returns, in whole seconds, for every session of this workspace. A message tagged to the member, in the team channel or its session thread, and any direct message end the collect at once. A minute when it is not set.'
		;;
		## The keys of a preset (AgentsTools.Preset.include), which stand in a block of their own, preset-<name>, and so in
		## no one scope of the catalogue: scope `-`. Their text is what a person editing a preset reads.
		PRESET_EXTEND)
			printf '%s\n' '-|<preset-name>|plain|the preset whose parameters this one inherits, in a preset block preset-<name>. Its own value of a key stands ahead of the inherited one, but for the CLI service: where a preset extends, that is the one of the parent and cannot be edited.'
		;;
		PRESET_CLI_SERVICE)
			printf '%s\n' '-|<cli-service>|plain|the CLI service of a preset that extends nothing: claude, copilot, grok, gemini, scaleway, standard-v1, deepseek, local, claude-native, copilot-native or grok-native. The credentials the preset takes are those of that service, under the names its CLI reads.'
		;;
		PRESET_ENDPOINT_URL)
			printf '%s\n' '-|<https-url>|plain|the endpoint the CLI service of the preset is reached at, optional: an https URL (http for 127.0.0.1, [::1] and localhost only), such as one of a gateway or a provider that speaks the wire of that service. Left unset the endpoint is the one the harness leg of the service states.'
		;;
		PRESET_MODEL_OR_MACRO)
			printf '%s\n' '-|<macro-or-model>|plain|the model of the preset, optional: a macro, low or easy, normal or default, high or hard, which picks the tier of the harness, or a model name, which is the model of that tier for a harness leg (claude, copilot, grok, scaleway). A native CLI is passed no model, so for it the model is stored and nothing uses it. Left unset the tier asked stands.'
		;;
		PRESET_EFFORT)
			printf '%s\n' '-|<effort>|plain|how hard the model thinks, optional: unset (no effort sent, the default of the model), none (no reasoning, sent as each service expresses it), low, normal or high. High takes a normal model to the heavy tier, which is the harness effort high. A harness leg sends it; --manager-session-effort changes it while the run goes on.'
		;;
		PRESET_INPUT_CACHE_TIME)
			printf '%s\n' '-|<5m-or-1h>|plain|how long the provider keeps the input cache that the cache markers of a harness run on the Anthropic wire ask for, optional: 5m, which is the provider default and puts nothing in a marker, or 1h, which a work-duty loop uses to keep its prefix over its idle waits. A native CLI keeps its own.'
		;;
		PRESET_CONTEXT_MAX_SIZE)
			printf '%s\n' '-|<tokens>|plain|the context at which a harness run summarises its work and restarts, in whole tokens, optional: the largest context this service really gives, less the room the reply needs. A number far below the service account'"'"'s own window restarts the run early and pays its whole prompt again, and the harness says so at start. Left unset the service'"'"'s own window less its output maximum governs.'
		;;
		PRESET_EXTRA_SPAWN_LINE)
			printf '%s\n' '-|<one line>|plain|one instruction that corrects the dispatch for the model of the preset. The human-owner writes it here and nobody else does: the spawner puts it into the dispatch it crafts, and no member is told where it came from.'
		;;
		## The tier settings (AgentsTools.Preset.include, F10.2): the team's, and optionally a member's own in its scope, which
		## stands ahead of the team's. Scope magic-team, where the minimum to run team members is SPAWN_TIER_NORMAL.
		SPAWN_TIER_LOW)
			printf '%s\n' 'magic-team|<preset>[:<effort>]|plain|the preset a spawn runs on at the low tier (the tier asked, SPAWN_HARNESS_TIER, being light), with an effort after a colon where wanted: low, default or normal, high or hard. A member scope may set its own, which stands ahead of the team. Read in the workspace that pays for the spawn. Where it is not set the default tier is used.'
		;;
		SPAWN_TIER_NORMAL)
			printf '%s\n' 'magic-team|<preset>[:<effort>]|plain|the preset a spawn runs on at the default tier (the tier asked being normal, or none), with an effort after a colon where wanted: low, default or normal, high or hard. The minimum to run team members is this one in the team scope; a member scope may set its own, which stands ahead of the team. Read in the workspace that pays for the spawn.'
		;;
		SPAWN_TIER_HIGH)
			printf '%s\n' 'magic-team|<preset>[:<effort>]|plain|the preset a spawn runs on at the high tier (the tier asked, SPAWN_HARNESS_TIER, being heavy), with an effort after a colon where wanted: low, default or normal, high or hard. A member scope may set its own, which stands ahead of the team. Read in the workspace that pays for the spawn. Where it is not set the default tier is used.'
		;;
		## The team place in Confluence: a general team key, not the publish step alone. Its
		## Google counterpart is found by listing, never configured: the folder named magic-team.
		CONFLUENCE_SPACE)
			printf '%s\n' 'magic-team|<space-key>|plain|the key of the Confluence space the team keeps as its own place, as in its URL after /spaces/. Each member reaches it with its own CONFLUENCE_SITE, CONFLUENCE_USER and CONFLUENCE_API_TOKEN. A value set in a member scope wins for that member alone.'
		;;
		TEAM_DATA_DIRECTORY)
			printf '%s\n' 'magic-coordinator|<abs-path>|plain|the directory holding the board and the inboxes. Left unset it is .local/agents/team-data-root inside this workspace; set it only to share team data between workspaces. Any path this account can write to; it is created on first use.'
		;;
		TEAM_DATA_GIT_REMOTE)
			printf '%s\n' 'magic-team|<git-remote-url>|plain|the clone URL of a repository you own, which the team data is pushed to. An empty repository is fine.'
		;;
		## Changing this on a running rig DELETES and re-clones the team-data checkout on
		## the next iteration: myx.common git/clonePull switches branches by removing the
		## working tree, ahead of any conflict handling, so onConflict does not protect it.
		## Correct for command data pulled from a remote, and surprising from a settings
		## edit, which is why it is said here rather than at the call site.
		TEAM_DATA_BRANCH)
			printf '%s\n' 'magic-team|<branch-name>|plain|the branch of the team-data repository this workspace tracks. Left unset the loop tracks "main".'
		;;
		TEAM_DATA_GIT_USER_NAME)
			printf '%s\n' 'magic-team|<name>|plain|the author name on the team-data commits the tooling makes, written into that repository only. Left unset, git resolves its own identity.'
		;;
		TEAM_DATA_GIT_USER_EMAIL)
			printf '%s\n' 'magic-team|<email>|plain|the author email on the team-data commits the tooling makes, written into that repository only. Left unset, git resolves its own identity.'
		;;
		## The CLI services' credentials below are the CLIs' OWN variable names,
		## not keys coined here: each is the name its CLI already reads out of its
		## environment, so what is stored and what the console exports are one
		## string and no mapping between them can drift. claude's two are
		## alternatives -- an API key or a subscription token -- so neither is ever
		## required, and which one a machine uses is that machine's answer rather
		## than this catalogue's.
		##
		## A CREDENTIAL STANDS IN THE PRESET OF ITS CLI SERVICE, preset-<service>,
		## and never in magic-team: that is where AgentsToolsPresetCredentialHolder
		## and the spawn's preset chain (AgentsToolsPresetOverlay) read it, so a key
		## stored in the team scope is one no spawn is ever given. The setup creates
		## that preset where it is not there yet, then writes the value into it.
		ANTHROPIC_API_KEY)
			printf '%s\n' 'preset-claude|<sk-ant-...>|secret|claude reads this name itself. console.anthropic.com, API keys, Create key -- billed per use. Alternative to CLAUDE_CODE_OAUTH_TOKEN; set one, not both.'
		;;
		CLAUDE_CODE_OAUTH_TOKEN)
			printf '%s\n' 'preset-claude|<oauth-token>|secret|claude reads this name itself, and bills a Claude subscription rather than API use. Run "claude setup-token" once on a machine with a browser and store what it prints. Alternative to ANTHROPIC_API_KEY.'
		;;
		COPILOT_GITHUB_TOKEN)
			printf '%s\n' 'preset-copilot|<github-token>|secret|copilot reads this name itself, ahead of GH_TOKEN and GITHUB_TOKEN. A github.com fine-grained personal access token carrying the Copilot Requests permission; classic ghp_ tokens are refused.'
		;;
		## Scaleway is a cloud service provider, not a model: a secret key is scoped
		## by Project and policy and reaches every model that Project carries --
		## confirmed live -- so there is ONE credential name, the key, and never one
		## per model. Which model a run uses is the preset's PRESET_MODEL_OR_MACRO,
		## exported to the leg as HARNESS_MODEL_LIGHT/MAIN (F10.2); a preset named
		## after a model, mel-scaleway-deepseek or any other, is only a name.
		SCALEWAY_API_KEY)
			printf '%s\n' 'preset-scaleway|<key>|secret|AgentsScalewayHarness.sh reads this name itself, for every tier, and the preset names the model. console.scaleway.com, IAM, API Keys -- a Project-scoped key carrying the GenerativeApisFullAccess policy.'
		;;
		XAI_API_KEY)
			printf '%s\n' 'preset-grok|<xai-...>|secret|AgentsGrokHarness.sh reads this name itself, for every tier. console.x.ai, API Keys, Create API Key.'
		;;
		DEEPSEEK_API_KEY)
			printf '%s\n' 'preset-deepseek|<key>|secret|AgentsDeepseekHarness.sh reads this name itself, for every tier. platform.deepseek.com, API keys, Create new API key.'
		;;
		SLACK_BOT_TOKEN)
			printf '%s\n' 'magic-team|<xoxb-token>|secret|api.slack.com/apps, your app, OAuth and Permissions, Bot User OAuth Token.'
		;;
		## The credentials of the outside systems a member's own scope holds, which no owner-setup
		## domain declares: scope `-`, none of them being the scope of one place (Systems skips an
		## entry with it). They are here to be marked secret: they print only as F11.8 says.
		SLACK_APP_TOKEN)
			printf '%s\n' '-|<xapp-token>|secret|the app-level token of a Slack app, which the Socket Mode connection reads from the scope of the member, then from the team.'
		;;
		SLACK_USER_TOKEN)
			printf '%s\n' '-|<xoxp-token>|secret|the Slack user token of a member: a post made with it acts as that member, otherwise as the bot.'
		;;
		JIRA_API_TOKEN)
			printf '%s\n' '-|<api-token>|secret|the Atlassian API token the Jira calls of a member sign in with, kept in its own scope beside JIRA_SITE and JIRA_USER.'
		;;
		CONFLUENCE_API_TOKEN)
			printf '%s\n' '-|<api-token>|secret|the Atlassian API token the Confluence calls of a member sign in with, kept in its own scope beside CONFLUENCE_SITE and CONFLUENCE_USER.'
		;;
		EMAIL_APP_PASSWORD)
			printf '%s\n' '-|<app-password>|secret|the app password of the mailbox of a member, kept in its own scope beside its other EMAIL_ settings.'
		;;
		GOOGLE_ACCOUNT_PASSWORD)
			printf '%s\n' '-|<password>|secret|the password of the Google account of a member, kept in its own scope beside its other GOOGLE_ settings.'
		;;
		ATLASSIAN_ACCOUNT_PASSWORD)
			printf '%s\n' '-|<password>|secret|the password of the Atlassian account of a member, kept in its own scope beside its other Atlassian settings.'
		;;
		TRELLO_KEY)
			printf '%s\n' '-|<api-key>|secret|the Trello API key the Trello calls of a member sign in with, kept in its own scope.'
		;;
		TRELLO_TOKEN)
			printf '%s\n' '-|<token>|secret|the Trello token that goes with TRELLO_KEY, kept in the same scope.'
		;;
		GOOGLE_CLIENT_SECRET)
			printf '%s\n' '-|<client-secret>|secret|the client secret of the Google OAuth client the Google calls of a member use, kept in its own scope beside GOOGLE_CLIENT_ID and GOOGLE_REFRESH_TOKEN.'
		;;
		GOOGLE_REFRESH_TOKEN)
			printf '%s\n' '-|<refresh-token>|secret|the Google refresh token the Google calls of a member exchange for an access token, kept in its own scope.'
		;;
		SLACK_WORKSPACE_DOMAIN)
			printf '%s\n' 'magic-team|<name>.slack.com|plain|the workspace subdomain as it appears in its own Slack URL.'
		;;
		SLACK_CHANNEL_MAGIC_TEAM)
			printf '%s\n' 'magic-team|<channel-id>|plain|the team channel id: open the channel, View channel details, the id sits at the bottom and starts with C.'
		;;
		SLACK_CHANNEL_HUMAN_OWNER)
			printf '%s\n' 'magic-team|<user-id>|plain|your own member id: your profile, More, Copy member ID. It starts with U.'
		;;
		## The owners role (F6.10, T8): the members a question to the role addresses, and the quorum that settles it.
		## The members are one authenticated Slack account per line (user ids); a console account is never a member.
		HUMAN_OWNER_MEMBERS)
			printf '%s\n' 'magic-team|<account>[ <account>...]|plain|the authenticated Slack accounts of the owners role, one per line (user ids, each starting with U). A question to the role addresses every one of them, and the quorum (HUMAN_OWNER_QUORUM) decides from their answers. A console account is never a member: it maps only to a confirmation.'
		;;
		HUMAN_OWNER_QUORUM)
			printf '%s\n' 'magic-team|<kind>=<rule>[ ...]|plain|how the answers of the owners role settle a question, one kind=rule pair: all, first, any-approves, any-rejects or majority, for each question kind (permission, decision, question, readback). Left unset every kind settles on the first answer.'
		;;
		SLACK_CHANNEL_EVENT_TRACK)
			printf '%s\n' 'magic-team|<channel-id>|plain|the activity-log channel id, read like the team channel. Left unset this traffic goes to the team channel instead.'
		;;
		SLACK_CHANNEL_EVENT_ALERT)
			printf '%s\n' 'magic-team|<channel-id>|plain|the alert channel id, read like the team channel. Left unset this traffic goes to the team channel instead.'
		;;
	esac
}
