#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

## AgentsTools.OpInstallClaudeWorkspaceTrust.include -- the operation `--install-claude-workspace-trust`, sourced by AgentsTools.Install.include with the operation's arguments.
## Records claude's workspace trust (hasTrustDialogAccepted) for --workspace in
## $HOME/.claude.json. Internal step of --install-workspace-integrations and
## --owner-setup-claude(-native) --apply, out of help.
		shift

		local workspaceArg
		while [ "$#" -gt 0 ] ; do
			case "$1" in
				--workspace)
					if [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --install-claude-workspace-trust: --workspace requires a value" >&2
						set +e ; return 1
					fi
					workspaceArg="$2" ; shift 2
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --install-claude-workspace-trust: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done

		local workspace="${workspaceArg:-$MMDAPP}"
		if [ ! -d "$workspace" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --install-claude-workspace-trust: workspace not found: $workspace" >&2
			set +e ; return 1
		fi
		workspace="$( cd "$workspace" && pwd )"

		if [ -L "$HOME/.claude.json" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --install-claude-workspace-trust: $HOME/.claude.json is a symlink, and recording trust replaces that file -- which would leave a regular file where you put a link" >&2
			set +e ; return 1
		fi
		if [ ! -f "$HOME/.claude.json" ] ; then
			## CLAUDE THAT HAS NOT RUN HERE YET IS NOT A BROKEN INSTALL: its own state file is made by claude itself on its first run, so the
			## trust line is added the next time this runs, and nothing else of the setup waits on it.
			echo "🙋 WARNING: $MDSC_CMD --install-claude-workspace-trust: claude's own state file is absent ($HOME/.claude.json), so no trust line is written this run -- start claude once here, then run this again" >&2
			set +e ; return 0
		fi
		local setupTrustLine="$( MYX_CLAUDEVERIFY_PROJECT_PATH="$workspace" \
			MYX_CLAUDEVERIFY_PROJECT_TRUE="hasTrustDialogAccepted" \
			LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsClaudeSettingsVerify.awk" \
			< "$HOME/.claude.json" 2>/dev/null || : )"
		case "$setupTrustLine" in
			*": OK")
				echo "# $MDSC_CMD --install-claude-workspace-trust: $workspace is already trusted"
			;;
			*)
				## The mode is carried onto the replacement rather than
				## asserted: this file is claude's, and an apply is not the
				## place to decide what it should be. A mode that cannot be
				## read stops the run, since the alternative is a file left at
				## whatever the ambient umask gave.
				local setupTrustMode="$( stat -c '%a' "$HOME/.claude.json" 2>/dev/null || stat -f '%Lp' "$HOME/.claude.json" 2>/dev/null )"
				if [ -z "$setupTrustMode" ] ; then
					echo "⛔ ERROR: $MDSC_CMD --install-claude-workspace-trust: could not read the mode of $HOME/.claude.json, so a replacement could not be given the same one -- nothing was changed" >&2
					set +e ; return 1
				fi
				local setupTrustRc=0
				(
					## umask first, so the replacement is never briefly wider than
					## the file it replaces; the chmod below then matches it exactly.
					umask 077
					trustTempFile="$HOME/.claude.json.$$"
					trap 'rm -f -- "$trustTempFile"' EXIT
					: > "$trustTempFile"
					chmod "$setupTrustMode" "$trustTempFile"
					## Explicitly tested, never left to set -e: the caller below
					## tests this subshell, which suspends set -e within it, and an
					## untested failure here would install the writer's own zero
					## bytes over claude's state file.
					MYX_CLAUDETRUST_PROJECT_PATH="$workspace" \
						MYX_CLAUDETRUST_PROJECT_TRUE="hasTrustDialogAccepted" \
						LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsClaudeProjectTrustUpsert.awk" \
						< "$HOME/.claude.json" >>"$trustTempFile" || exit 1
					mv "$trustTempFile" "$HOME/.claude.json" || exit 1
				) || setupTrustRc=$?
				if [ "$setupTrustRc" != "0" ] ; then
					echo "⛔ ERROR: $MDSC_CMD --install-claude-workspace-trust: could not record trust for $workspace in $HOME/.claude.json, which is unchanged -- the reason above is the writer's own" >&2
					set +e ; return 1
				fi
				echo "# $MDSC_CMD --install-claude-workspace-trust: trust recorded for $workspace"
			;;
		esac
		return 0
