#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

## AgentsTools.OpOwnerCredentialStoreSelfTest.include -- the operation `--owner-credential-store-self-test`, sourced by AgentsTools.Owner.include with the operation's arguments.
		shift
		if [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --owner-credential-store-self-test: takes no arguments" >&2
			set +e ; return 1
		fi
		echo "# $MDSC_CMD --owner-credential-store-self-test: exercising --agents-config-option permission-hardening under umask 022 (ignoring caller's ambient umask)" >&2

		local probeKey="DAT_SELFTEST_PROBE"
		local probeVal="selftest-$$-$( date +%s )"
		local probeFailed=0

		type AgentsToolsConfigOption > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/settings/AgentsTools.ConfigOption.include"
		if ! ( umask 022 ; AgentsToolsConfigOption magic-coordinator --upsert "$probeKey" "$probeVal" >/dev/null ) ; then
			echo "⛔ ERROR: $MDSC_CMD --owner-credential-store-self-test: --upsert under umask 022 failed" >&2
			set +e ; return 1
		fi

		type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
		DistroAgentsTools --owner-credential-store-verify || probeFailed=1

		type AgentsToolsConfigOption > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/settings/AgentsTools.ConfigOption.include"
		if [ "$( AgentsToolsConfigOption magic-coordinator --select "$probeKey" )" != "$probeVal" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --owner-credential-store-self-test: probe key round-trip mismatch" >&2
			probeFailed=1
		fi

		type AgentsToolsConfigOption > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/settings/AgentsTools.ConfigOption.include"
		AgentsToolsConfigOption magic-coordinator --delete "$probeKey" >/dev/null

		## Each file this package seeds or publishes, at the mode it claims for it. A file
		## that is absent is stated and not asserted: there is nothing to hold a mode.
		local modeWant modePath modeGot
		for modeWant in \
			"600:$HOME/.claude.json" \
			"644:$MMDAPP/.local/agents/mcp.servers.json" \
			"644:$MMDAPP/.vscode/mcp.json" \
			"644:$MMDAPP/.mcp.json" \
		; do
			modePath="${modeWant#*:}" ; modeWant="${modeWant%%:*}"
			if [ ! -e "$modePath" ] ; then
				echo "# $MDSC_CMD --owner-credential-store-self-test: $modePath is absent, so its mode 0$modeWant is not asserted" >&2
				continue
			fi
			modeGot="$( stat -c '%a' "$modePath" 2>/dev/null || stat -f '%Lp' "$modePath" 2>/dev/null )"
			if [ "$modeGot" = "$modeWant" ] ; then
				echo "# $MDSC_CMD --owner-credential-store-self-test: $modePath is 0$modeWant: OK" >&2
			else
				echo "⛔ ERROR: $MDSC_CMD --owner-credential-store-self-test: $modePath is 0${modeGot:-<unreadable>}, and this package claims 0$modeWant for it" >&2
				probeFailed=1
			fi
		done

		if [ "$probeFailed" = "1" ] ; then
			echo "⛔ $MDSC_CMD --owner-credential-store-self-test: FAILED" >&2
			set +e ; return 1
		fi
		echo "# $MDSC_CMD --owner-credential-store-self-test: PASSED -- permission hardening holds under umask 022, and every present seeded or published file holds its mode" >&2
		return 0
