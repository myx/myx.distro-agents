#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.Member.include -- the --member-* operation-group body for
## DistroAgentsTools.fn.sh's single dispatcher, sourced lazily (only when
## $1 actually matches --member-*) from that file's own `--member-*)` arm,
## via the absolute $MDLT_ORIGIN-based path already used for every other
## cross-file source in this family (see --agents-config-option and the
## --pretty AgentsSlackMessagesFormat.awk reference in the same file).
##
## Not standalone-executable: relies on being dot-sourced into
## DistroAgentsTools's own function scope for $1/$@, the $MDSC_CMD local,
## and self-recursive calls back into the DistroAgentsTools function name.
##
## Owns a complete, self-contained `case "$1" in ... esac` -- the only
## shape that externalizes a whole multi-arm operation group without
## reintroducing the reverted per-op-function pattern (a separate
## DistroAgentsTools<OpName> function per op) that caused a real bare
## self-call bug; see myx.distro-agents/CLAUDE.md's "DistroAgentsTools --
## gotchas" section. Splitting these 8 arms into 8 separate functions is
## the one thing NOT to do here, even though this file only holds one
## group -- consistency with the reverted-pattern lesson, not a
## per-file judgment call.
##
## Carries its own `*)` default arm, deliberately duplicating the outer
## dispatcher's own catch-all error text: once the outer dispatcher routes
## every --member-* invocation into this file via its own wildcard arm, an
## unrecognized --member-<typo> would otherwise be swallowed here silently
## instead of falling through to the outer case's catch-all -- this
## default arm is what keeps that failure mode identical to every other
## invalid option.
##

case "$1" in

	## Verb-suffixed name matches the existing
	## --owner-workspace-upsert/-forget/-list/-current convention for the
	## --owner-* prefix. Backs magic-team.armed.md's Process/dynamics rule
	## formulation "note it for later" no-approval-available fallback --
	## unlike the board, inbox write access is NOT exclusive to one member;
	## any member may post a note into any other member's inbox (that's the
	## whole cross-member handoff mechanism). Thin wrapper over the shared
	## --intern-op-member-inbox-upsert primitive -- not called by, and does
	## not call, its sibling --member-upsert-member-inquiry/
	## --member-upsert-inbox-reflection ops below.
	--member-upsert-inbox-note)
		shift
		DistroAgentsTools --intern-op-member-inbox-upsert "$@" --context --member-upsert-inbox-note || return 1
		return 0
	;;

	## The real op backing magic-team.armed.md's Process/dynamics rule
	## formulation's other no-approval-available fallback, "pass it to
	## another member" (as distinct from that section's "note it for
	## later," which --member-upsert-inbox-note backs). Thin wrapper over
	## the shared --intern-op-member-inbox-upsert primitive, same as
	## --member-upsert-inbox-note -- does not call that sibling op directly.
	## --edit-patch-from-stdin passes straight through to the shared
	## primitive, same as every other option -- no special-case rejection
	## (human-owner decision 2026-08-27, reversing the earlier carve-out).
	--member-upsert-member-inquiry)
		shift
		DistroAgentsTools --intern-op-member-inbox-upsert "$@" --context --member-upsert-member-inquiry || return 1
		return 0
	;;

	## For reflection-type inbox items specifically -- kept as its own
	## distinctly-named op because reflection notes are a real,
	## already-established content family in this team's inboxes (see e.g.
	## this team's own reflection-note examples: a frontmatter block --
	## source/type/from/posted_at/owner/approved_by/references -- followed
	## by a "# Reflection: <title>" heading and "## What happened"/"## Why
	## this is worth keeping"-style sections), distinct from a plain
	## free-form note or a passed inquiry. <item-filename> is conventionally
	## expected to contain "reflection-" in its slug, matching every
	## existing example, but this is a naming convention to follow, not
	## something enforced here. Thin wrapper over the shared
	## --intern-op-member-inbox-upsert primitive, same as
	## --member-upsert-inbox-note -- does not call that sibling op directly.
	--member-upsert-inbox-reflection)
		shift
		DistroAgentsTools --intern-op-member-inbox-upsert "$@" --context --member-upsert-inbox-reflection || return 1
		return 0
	;;

	## Append one transcript entry into a transcript file under the shared
	## audit tree. Writes exactly one canonical entry block per call:
	##
	##   <speaker-name> (<timestamp>):
	##
	##   > <message line 1>
	##   > <message line 2>
	##
	## Target path is fixed to:
	##   <team-data-directory>/audit/<YYYY-MM>/<transcript-file-name>
	##   (team-data-directory resolved via --intern-config-board-location)
	##
	## Per magic-team.shared.md's transcript-* location predicate -- not a
	## board/*/ state folder. transcript-* is a named board-item type by
	## filename/frontmatter convention (magic-team.armed.md), but unlike
	## task-/project-/inquiry- it is not walked through the board's lifecycle
	## states (magic-team.board.md). <YYYY-MM> is derived from the date
	## embedded in <transcript-file-name> (transcript-YYYY-MM-DD-*), falling
	## back to the current UTC year-month if the name doesn't carry one.
	## <team-member>'s own skill directory must still exist (sanity check that
	## the member is real) even though the transcript itself no longer lives
	## under it. audit/ and its <YYYY-MM>/ subfolder are created on demand
	## (lazily, same convention as --member-upsert-inbox-note's inbox/
	## handling). --workspace-root stays required/validated (caller-
	## environment sanity check) but does not feed the target path.
	##
	## Missing target file is an error unless --create is passed.
	##
	## <team-member> is an enforced first positional argument -- same
	## convention every other --magic-*/--routine-*/--member-* op in this
	## family already uses (e.g. --member-upsert-inbox-note's <member>
	## <item-filename>, --magic-grooming-to-backlog's <team-member>
	## <item-filename>): consumed immediately after shift, validated before
	## any flag parsing, never an order-independent --member <name> flag
	## sitting alongside the rest.
	--member-append-session-transcript)
		shift
		local memberName="$1"
		shift || true
		if [ -z "$memberName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --member-append-session-transcript: syntax is <team-member> --speaker <speaker-name> --timestamp <ISO-UTC-date-time> (--message <verbatim-text>|--from-stdin|--from-file <path>) --transcript-name <transcript-file-name> --workspace-root <path> [--create]" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$memberName" "<team-member>" member-append-session-transcript || { set +e ; return 1 ; }
		local speakerName timestampUtc messageText transcriptName workspaceRoot
		local messageFromStdin="false" messageFile messageArgProvided="false"
		local allowCreate="false"
		while [ $# -gt 0 ] ; do
			case "$1" in
				--speaker)
					speakerName="$2"
					shift 2
				;;
				--timestamp)
					timestampUtc="$2"
					shift 2
				;;
				--message)
					messageText="$2"
					messageArgProvided="true"
					shift 2
				;;
				## --message-from-stdin/--message-file are the superseded spellings,
				## kept as working shims per MAGIC.md's "Deprecated operation names" --
				## removed from help output, --from-stdin/--from-file are what's shown.
				--message-from-stdin|--from-stdin)
					messageFromStdin="true"
					shift
				;;
				--message-file|--from-file)
					messageFile="$2"
					shift 2
				;;
				--transcript-name)
					transcriptName="$2"
					shift 2
				;;
				--workspace-root)
					workspaceRoot="$2"
					shift 2
				;;
				--create)
					allowCreate="true"
					shift
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --member-append-session-transcript: unrecognized argument: $1" >&2
					set +e ; return 1
				;;
			esac
		done

		if [ -z "$speakerName" ] || [ -z "$timestampUtc" ] || [ -z "$transcriptName" ] || [ -z "$workspaceRoot" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --member-append-session-transcript: required args: --speaker --timestamp --transcript-name --workspace-root" >&2
			set +e ; return 1
		fi
		local payloadSources=0
		if [ "$messageArgProvided" = "true" ] ; then
			payloadSources=$((payloadSources + 1))
		fi
		if [ "$messageFromStdin" = "true" ] ; then
			payloadSources=$((payloadSources + 1))
		fi
		if [ -n "$messageFile" ] ; then
			payloadSources=$((payloadSources + 1))
		fi
		if [ "$payloadSources" -ne 1 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --member-append-session-transcript: provide exactly one payload source: --message, --from-stdin, or --from-file" >&2
			set +e ; return 1
		fi
		if [ "$messageFromStdin" = "true" ] ; then
			messageText="$(cat)"
		elif [ -n "$messageFile" ] ; then
			if [ ! -f "$messageFile" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-append-session-transcript: message file not found: $messageFile" >&2
				set +e ; return 1
			fi
			messageText="$(cat -- "$messageFile")"
		fi
		AgentsToolsAssertBareName "$transcriptName" "<transcript-file-name>" member-append-session-transcript || { set +e ; return 1 ; }
		case "$workspaceRoot" in
			/*)
			;;
			*)
				echo "⛔ ERROR: $MDSC_CMD --member-append-session-transcript: --workspace-root must be absolute: $workspaceRoot" >&2
				set +e ; return 1
			;;
		esac
		if [ ! -d "$workspaceRoot" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --member-append-session-transcript: workspace root not found: $workspaceRoot" >&2
			set +e ; return 1
		fi
		if ! printf '%s' "$timestampUtc" | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?Z$' ; then
			echo "⛔ ERROR: $MDSC_CMD --member-append-session-transcript: --timestamp must be ISO UTC date-time (suffix Z): $timestampUtc" >&2
			set +e ; return 1
		fi

		local memberDir="$HOME/.claude/skills/$memberName"
		if [ ! -d "$memberDir" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --member-append-session-transcript: no such member skill directory: $memberDir" >&2
			set +e ; return 1
		fi
		local yearMonth
		case "$transcriptName" in
			transcript-[0-9][0-9][0-9][0-9]-[0-9][0-9]-*)
				yearMonth="$( printf '%s' "$transcriptName" | sed -E 's/^transcript-([0-9]{4})-([0-9]{2})-.*/\1-\2/' )"
			;;
			*)
				yearMonth="$( date -u +%Y-%m )"
			;;
		esac
		[ -n "${MDAT_DATA_ROOT:-}" ] || {
			echo "⛔ ERROR: $MDSC_CMD --member-append-session-transcript: MDAT_DATA_ROOT is not set" >&2
			set +e ; return 1
		}
		local transcriptDir="$MDAT_DATA_ROOT/audit/$yearMonth"
		mkdir -p "$transcriptDir" || {
			echo "⛔ ERROR: $MDSC_CMD --member-append-session-transcript: can't create transcript directory: $transcriptDir" >&2
			set +e ; return 1
		}
		local target="$transcriptDir/$transcriptName"
		if [ ! -f "$target" ] && [ "$allowCreate" != "true" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --member-append-session-transcript: transcript does not exist (pass --create to allow creation): $target" >&2
			set +e ; return 1
		fi
		if [ ! -f "$target" ] ; then
			: > "$target" || {
				echo "⛔ ERROR: $MDSC_CMD --member-append-session-transcript: failed to create transcript: $target" >&2
				set +e ; return 1
			}
		fi

		local tmpEntry
		tmpEntry="$MMDAPP/.local/temp/mdat-session-transcript-entry.$$"
		mkdir -p "$MMDAPP/.local/temp" && : > "$tmpEntry" || {
			echo "⛔ ERROR: $MDSC_CMD --member-append-session-transcript: failed to create temp file" >&2
			set +e ; return 1
		}
		trap 'rm -f -- "$tmpEntry"' EXIT

		printf '%s (%s):\n\n' "$speakerName" "$timestampUtc" > "$tmpEntry"
		printf '%s' "$messageText" | awk '{ print "> " $0 } END { if (NR == 0) print "> " }' >> "$tmpEntry"
		printf '\n' >> "$tmpEntry"

		local addedBytes addedLines
		addedBytes="$( wc -c < "$tmpEntry" | tr -d '[:space:]' )"
		addedLines="$( wc -l < "$tmpEntry" | tr -d '[:space:]' )"
		cat "$tmpEntry" >> "$target" || {
			echo "⛔ ERROR: $MDSC_CMD --member-append-session-transcript: failed to append to transcript: $target" >&2
			set +e ; return 1
		}
		rm -f -- "$tmpEntry"
		trap - EXIT

		echo "# $MDSC_CMD --member-append-session-transcript: appended ${target#"$MDAT_DATA_ROOT/audit"/} (+${addedLines} lines, +${addedBytes} bytes)" >&2
		echo "$target"
		return 0
	;;

	## Read-only audit-item access without exposing raw path handling to
	## callers. The caller supplies only document name, plus optional
	## line range.
	--member-read-audit-item)
		shift
		local memberName="$1"
		shift || true
		local documentName="$1"
		shift || true
		if [ -z "$memberName" ] || [ -z "$documentName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --member-read-audit-item: syntax is <team-member> <document-name> [--start-line <N> --end-line <N>]" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$memberName" "<team-member>" member-read-audit-item || { set +e ; return 1 ; }
		local memberDir="$HOME/.claude/skills/$memberName"
		if [ ! -d "$memberDir" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --member-read-audit-item: no such member skill directory: $memberDir" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$documentName" "<document-name>" member-read-audit-item || { set +e ; return 1 ; }
		case "$documentName" in
			transcript-*)
			;;
			*)
				echo "⛔ ERROR: $MDSC_CMD --member-read-audit-item: only transcript-* documents are allowed: $documentName" >&2
				set +e ; return 1
			;;
		esac

		local startLine="" endLine=""
		while [ $# -gt 0 ] ; do
			case "$1" in
				--start-line)
					startLine="$2"
					shift 2
				;;
				--end-line)
					endLine="$2"
					shift 2
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --member-read-audit-item: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done

		if [ -n "$startLine" ] || [ -n "$endLine" ] ; then
			if [ -z "$startLine" ] || [ -z "$endLine" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-read-audit-item: --start-line and --end-line must be provided together" >&2
				set +e ; return 1
			fi
		fi
		[ -n "${MDAT_DATA_ROOT:-}" ] || {
			echo "⛔ ERROR: $MDSC_CMD --member-read-audit-item: MDAT_DATA_ROOT is not set" >&2
			set +e ; return 1
		}
		local auditRoot="$MDAT_DATA_ROOT/audit"
		local lookupFolders=()
		local yearMonth=""
		case "$documentName" in
			transcript-[0-9][0-9][0-9][0-9]-[0-9][0-9]-*)
				yearMonth="$( printf '%s' "$documentName" | sed -E 's/^transcript-([0-9]{4})-([0-9]{2})-.*/\1-\2/' )"
				lookupFolders+=( "$auditRoot/$yearMonth" )
			;;
		esac
		lookupFolders+=( "$auditRoot" )
		local readArgs=( --intern-op-data-read "$documentName" --context --member-read-audit-item )
		local folder
		for folder in "${lookupFolders[@]}" ; do
			readArgs+=( --lookup-folder "$folder" )
		done

		if [ -n "$startLine" ] ; then
			readArgs+=( --start-line "$startLine" --end-line "$endLine" )
			DistroAgentsTools "${readArgs[@]}"
		else
			DistroAgentsTools "${readArgs[@]}"
		fi
		return $?
	;;

	## Read one board item by filename and optional state restrictions, with
	## optional line range. Path lookup remains inside --intern-op-data-read.
	--member-read-board-item)
		shift
		local memberName="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$memberName" ] || [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --member-read-board-item: syntax is <team-member> <item-name> [--board-state <state>]... [--start-line <N> --end-line <N>]" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$memberName" "<team-member>" member-read-board-item || { set +e ; return 1 ; }
		local memberDir="$HOME/.claude/skills/$memberName"
		if [ ! -d "$memberDir" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --member-read-board-item: no such member skill directory: $memberDir" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$itemName" "<item-name>" member-read-board-item || { set +e ; return 1 ; }
		case "$itemName" in
			*-*.md)
			;;
			*)
				echo "⛔ ERROR: $MDSC_CMD --member-read-board-item: item name must match <type>-<name>.md: $itemName" >&2
				set +e ; return 1
			;;
		esac

		local boardStates=()
		local startLine="" endLine=""
		while [ $# -gt 0 ] ; do
			case "$1" in
				--board-state)
					case "$2" in
						backlog|pending|running|blocked|parked|processed|archived|retained)
							boardStates+=( "$2" )
						;;
						*)
							echo "⛔ ERROR: $MDSC_CMD --member-read-board-item: invalid --board-state: $2" >&2
							set +e ; return 1
						;;
					esac
					shift 2
				;;
				--start-line)
					startLine="$2"
					shift 2
				;;
				--end-line)
					endLine="$2"
					shift 2
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --member-read-board-item: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done

		if [ -n "$startLine" ] || [ -n "$endLine" ] ; then
			if [ -z "$startLine" ] || [ -z "$endLine" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-read-board-item: --start-line and --end-line must be provided together" >&2
				set +e ; return 1
			fi
		fi
		if [ ${#boardStates[@]} -eq 0 ] ; then
			boardStates=( backlog pending running blocked parked processed archived retained )
		fi
		[ -n "${MDAT_DATA_ROOT:-}" ] || {
			echo "⛔ ERROR: $MDSC_CMD --member-read-board-item: MDAT_DATA_ROOT is not set" >&2
			set +e ; return 1
		}
		local readArgs=( --intern-op-data-read "$itemName" --context --member-read-board-item )
		local boardState
		for boardState in "${boardStates[@]}" ; do
			readArgs+=( --lookup-folder "$MDAT_DATA_ROOT/board/$boardState" )
		done

		if [ -n "$startLine" ] ; then
			readArgs+=( --start-line "$startLine" --end-line "$endLine" )
		fi
		DistroAgentsTools "${readArgs[@]}"
		return $?
	;;

	## <member> -- read-only discovery, same document shape as
	## --magic-grooming-input-scan (thin wrapper over
	## --intern-op-session-context-scan; see that file for the actual scan/filter/
	## format mechanics). Personal, not routine-dictated -- see
	## magic-team.armed.md's Engineering & operating discipline section:
	## every member runs this against its own name as it becomes armed,
	## regardless of which routine triggered the arming. <member> is this
	## op's real defining input (not an override of some other fixed
	## default) and stays; no --state/--header flags alongside it --
	## dedicated wrappers are fixed, not flexible, a caller wanting a
	## different scan shape calls --intern-op-session-context-scan directly instead.
	## Fixed filters: --filter-owner <member> (this op's whole point -- "what's
	## currently assigned to me") and --all-types (no board-item-type
	## restriction; a member's own work spans every type). Always
	## backlog/pending/running/blocked/parked -- same "active work" list as
	## --magic-grooming-input-scan, this op's own closest analog (no
	## textual basis yet for a narrower one; an implementation choice to
	## flag for review, not independently re-derived from a routine's own
	## text the way grooming's/sweep's lists were). Always every
	## frontmatter field. Appends this same member's own inbox/ contents as
	## a second section, identical `## inbox/<item-filename>` + frontmatter
	## shape (the shared AgentsBoardItemFrontmatterPrint.awk, reused rather
	## than duplicated) -- a lazily-created, possibly-absent inbox/ is a
	## silent empty section, not an error (same laziness as
	## --member-upsert-inbox-note's own inbox/ handling).
	--member-work-session-input-scan)
		shift
		local memberName="$1"
		shift || true
		if [ -z "$memberName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --member-work-session-input-scan: syntax is <member>" >&2
			set +e ; return 1
		fi
		if [ $# -gt 0 ] ; then
			case "$1" in
				--*)
					echo "⛔ ERROR: $MDSC_CMD --member-work-session-input-scan: invalid option: $1 -- syntax is <team-member>, no other arguments -- an input-scan reads all baseline-relevant items itself. SEE $HOME/.claude/skills/magic-team/magic-team.armed.md" >&2
					set +e ; return 1
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --member-work-session-input-scan: syntax is <team-member>, no other arguments -- an input-scan reads all baseline-relevant items itself, an item name is not a parameter. SEE $HOME/.claude/skills/magic-team/magic-team.armed.md" >&2
					set +e ; return 1
				;;
			esac
		fi
		AgentsToolsAssertBareName "$memberName" "<team-member>" member-work-session-input-scan || { set +e ; return 1 ; }
		local memberDir="$HOME/.claude/skills/$memberName"
		if [ ! -d "$memberDir" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --member-work-session-input-scan: no such member skill directory: $memberDir" >&2
			set +e ; return 1
		fi

		## ONE MECHANISM FOR THIS MEMBER'S OWN INBOX, NOT TWO. The four typed
		## --do-inbox-* sections REPLACE the hand-rolled uncapped
		## `## inbox/<file>` walk that used to follow this call; they are not
		## run alongside it. Two sections describing one folder -- one with
		## bodies and one without, disagreeing on order and on membership --
		## is the double-description this document exists to prevent, and it
		## would render the same items twice.
		##
		## The earlier ruling that kept the hand-rolled walk rested on two
		## premises that no longer hold: that the typed sections dropped most
		## of a large inbox to a cap the human-owner had not set, and that they
		## carried no bodies. He has since set the cap himself and required
		## full bodies. The replacement is lossless only because of
		## `## Other Inbox Items` -- the old walk's one unique contribution was
		## exactly the items whose prefix is none of the typed three.
		DistroAgentsTools --intern-op-session-context-scan "$memberName" \
			--state backlog --state pending --state running --state blocked --state parked \
			--all-types --filter-owner "$memberName" \
			--do-inbox-inquiry-active --do-inbox-reflections \
			--do-inbox-notes --do-inbox-other \
			--context --member-work-session-input-scan
		return $?
	;;

	## Lives here, not in the outer dispatcher, because --member-help matches
	## the dispatcher's own --member-* wildcard arm -- and that arm is earlier
	## in dispatch order, so it wins. An exact --member-help route further down
	## the outer case could never fire: bash takes the first matching arm, and
	## every string --member-help matches, --member-* matches too. The arm has
	## to exist where the glob actually lands, which is this file. Same lazy
	## $MDLT_ORIGIN-based source as the dispatcher used, and no shift before it
	## -- AgentsTools.MemberHelp.include does its own $1 match and its own
	## shift, unchanged by the move.
	--member-help)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.MemberHelp.include"
		return $?
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
