#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.Member.include -- the --member-* operation-group body for
## DistroAgentsTools.fn.sh's single dispatcher, sourced lazily (only when
## $1 actually matches --member-*) from that file's own `--member-*)` arm,
## via the absolute $MDLT_ORIGIN-based path already used for every other
## cross-file source in this family (see --agents-config-option and the
## --pretty AgentsSlackMessagesFormat.awk reference in the same file).
##

case "$1" in

	--member-inbox-note-upsert|--member-upsert-inbox-note)
		shift
		DistroAgentsTools --intern-op-member-inbox-upsert "$@" --context --member-inbox-note-upsert || return 1
		return 0
	;;

	--member-upsert-member-inquiry)
		shift
		DistroAgentsTools --intern-op-member-inbox-upsert "$@" --context --member-upsert-member-inquiry || return 1
		return 0
	;;

	--member-inbox-reflection-upsert|--member-upsert-inbox-reflection)
		shift
		DistroAgentsTools --intern-op-member-inbox-upsert "$@" --context --member-inbox-reflection-upsert || return 1
		return 0
	;;

	--member-append-session-transcript)
		shift
		local memberName="$1"
		shift || true
		if [ -z "$memberName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --member-append-session-transcript: syntax is <team-member> --speaker <speaker-name> --timestamp <ISO-UTC-date-time> (--message <verbatim-text>|--from-stdin|--from-file <path>) --transcript-name <transcript-file-name> --workspace-root <path> [--create]" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$memberName" "<team-member>" member-append-session-transcript || { set +e ; return 1 ; }
		local speakerName timestampUtc messageText transcriptName workspaceRoot
		local messageFromStdin="false" messageFile messageArgProvided="false"
		local allowCreate="false"
		while [ $# -gt 0 ] ; do
			case "$1" in
				--speaker)
					speakerName="$2"
					shift 2
				;;
				--timestamp)
					timestampUtc="$2"
					shift 2
				;;
				--message)
					messageText="$2"
					messageArgProvided="true"
					shift 2
				;;
				--message-from-stdin|--from-stdin)
					messageFromStdin="true"
					shift
				;;
				--message-file|--from-file)
					messageFile="$2"
					shift 2
				;;
				--transcript-name)
					transcriptName="$2"
					shift 2
				;;
				--workspace-root)
					workspaceRoot="$2"
					shift 2
				;;
				--create)
					allowCreate="true"
					shift
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --member-append-session-transcript: unrecognized argument: $1" >&2
					set +e ; return 1
				;;
			esac
		done

		if [ -z "$speakerName" ] || [ -z "$timestampUtc" ] || [ -z "$transcriptName" ] || [ -z "$workspaceRoot" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --member-append-session-transcript: required args: --speaker --timestamp --transcript-name --workspace-root" >&2
			set +e ; return 1
		fi
		local payloadSources=0
		if [ "$messageArgProvided" = "true" ] ; then
			payloadSources=$((payloadSources + 1))
		fi
		if [ "$messageFromStdin" = "true" ] ; then
			payloadSources=$((payloadSources + 1))
		fi
		if [ -n "$messageFile" ] ; then
			payloadSources=$((payloadSources + 1))
		fi
		if [ "$payloadSources" -ne 1 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --member-append-session-transcript: provide exactly one payload source: --message, --from-stdin, or --from-file" >&2
			set +e ; return 1
		fi
		if [ "$messageFromStdin" = "true" ] ; then
			messageText="$(cat)"
		elif [ -n "$messageFile" ] ; then
			if [ ! -f "$messageFile" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-append-session-transcript: message file not found: $messageFile" >&2
				set +e ; return 1
			fi
			messageText="$(cat -- "$messageFile")"
		fi
		AgentsToolsAssertBareName "$transcriptName" "<transcript-file-name>" member-append-session-transcript || { set +e ; return 1 ; }
		case "$workspaceRoot" in
			/*)
			;;
			*)
				echo "⛔ ERROR: $MDSC_CMD --member-append-session-transcript: --workspace-root must be absolute: $workspaceRoot" >&2
				set +e ; return 1
			;;
		esac
		if [ ! -d "$workspaceRoot" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --member-append-session-transcript: workspace root not found: $workspaceRoot" >&2
			set +e ; return 1
		fi
		if ! printf '%s' "$timestampUtc" | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?Z$' ; then
			echo "⛔ ERROR: $MDSC_CMD --member-append-session-transcript: --timestamp must be ISO UTC date-time (suffix Z): $timestampUtc" >&2
			set +e ; return 1
		fi

		local memberDir="$HOME/.claude/skills/$memberName"
		if [ ! -d "$memberDir" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --member-append-session-transcript: no such member skill directory: $memberDir" >&2
			set +e ; return 1
		fi
		local yearMonth
		case "$transcriptName" in
			transcript-[0-9][0-9][0-9][0-9]-[0-9][0-9]-*)
				yearMonth="$( printf '%s' "$transcriptName" | sed -E 's/^transcript-([0-9]{4})-([0-9]{2})-.*/\1-\2/' )"
			;;
			*)
				yearMonth="$( date -u +%Y-%m )"
			;;
		esac
		[ -n "${MDAT_DATA_ROOT:-}" ] || {
			echo "⛔ ERROR: $MDSC_CMD --member-append-session-transcript: MDAT_DATA_ROOT is not set" >&2
			set +e ; return 1
		}
		local transcriptDir="$MDAT_DATA_ROOT/audit/$yearMonth"
		mkdir -p "$transcriptDir" || {
			echo "⛔ ERROR: $MDSC_CMD --member-append-session-transcript: can't create transcript directory: $transcriptDir" >&2
			set +e ; return 1
		}
		local target="$transcriptDir/$transcriptName"
		if [ ! -f "$target" ] && [ "$allowCreate" != "true" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --member-append-session-transcript: transcript does not exist (pass --create to allow creation): $target" >&2
			set +e ; return 1
		fi
		if [ ! -f "$target" ] ; then
			: > "$target" || {
				echo "⛔ ERROR: $MDSC_CMD --member-append-session-transcript: failed to create transcript: $target" >&2
				set +e ; return 1
			}
		fi

		local tmpEntry
		tmpEntry="$MMDAPP/.local/temp/mdat-session-transcript-entry.$$"
		mkdir -p "$MMDAPP/.local/temp" && : > "$tmpEntry" || {
			echo "⛔ ERROR: $MDSC_CMD --member-append-session-transcript: failed to create temp file" >&2
			set +e ; return 1
		}
		trap 'rm -f -- "$tmpEntry"' EXIT

		printf '%s (%s):\n\n' "$speakerName" "$timestampUtc" > "$tmpEntry"
		printf '%s' "$messageText" | awk '{ print "> " $0 } END { if (NR == 0) print "> " }' >> "$tmpEntry"
		printf '\n' >> "$tmpEntry"

		local addedBytes addedLines
		addedBytes="$( wc -c < "$tmpEntry" | tr -d '[:space:]' )"
		addedLines="$( wc -l < "$tmpEntry" | tr -d '[:space:]' )"
		cat "$tmpEntry" >> "$target" || {
			echo "⛔ ERROR: $MDSC_CMD --member-append-session-transcript: failed to append to transcript: $target" >&2
			set +e ; return 1
		}
		rm -f -- "$tmpEntry"
		trap - EXIT

		echo "# $MDSC_CMD --member-append-session-transcript: appended ${target#"$MDAT_DATA_ROOT/audit"/} (+${addedLines} lines, +${addedBytes} bytes)" >&2
		echo "$target"
		return 0
	;;

	--member-read-audit-item)
		shift
		local memberName="$1"
		shift || true
		local documentName="$1"
		shift || true
		if [ -z "$memberName" ] || [ -z "$documentName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --member-read-audit-item: syntax is <team-member> <document-name> [--start-line <N> --end-line <N>]" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$memberName" "<team-member>" member-read-audit-item || { set +e ; return 1 ; }
		local memberDir="$HOME/.claude/skills/$memberName"
		if [ ! -d "$memberDir" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --member-read-audit-item: no such member skill directory: $memberDir" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$documentName" "<document-name>" member-read-audit-item || { set +e ; return 1 ; }
		case "$documentName" in
			transcript-*)
			;;
			*)
				echo "⛔ ERROR: $MDSC_CMD --member-read-audit-item: only transcript-* documents are allowed: $documentName" >&2
				set +e ; return 1
			;;
		esac

		local startLine="" endLine=""
		while [ $# -gt 0 ] ; do
			case "$1" in
				--start-line)
					startLine="$2"
					shift 2
				;;
				--end-line)
					endLine="$2"
					shift 2
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --member-read-audit-item: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done

		if [ -n "$startLine" ] || [ -n "$endLine" ] ; then
			if [ -z "$startLine" ] || [ -z "$endLine" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-read-audit-item: --start-line and --end-line must be provided together" >&2
				set +e ; return 1
			fi
		fi
		[ -n "${MDAT_DATA_ROOT:-}" ] || {
			echo "⛔ ERROR: $MDSC_CMD --member-read-audit-item: MDAT_DATA_ROOT is not set" >&2
			set +e ; return 1
		}
		local auditRoot="$MDAT_DATA_ROOT/audit"
		local lookupFolders=()
		local yearMonth=""
		case "$documentName" in
			transcript-[0-9][0-9][0-9][0-9]-[0-9][0-9]-*)
				yearMonth="$( printf '%s' "$documentName" | sed -E 's/^transcript-([0-9]{4})-([0-9]{2})-.*/\1-\2/' )"
				lookupFolders+=( "$auditRoot/$yearMonth" )
			;;
		esac
		lookupFolders+=( "$auditRoot" )
		local readArgs=( --intern-op-data-read "$documentName" --context --member-read-audit-item )
		local folder
		for folder in "${lookupFolders[@]}" ; do
			readArgs+=( --lookup-folder "$folder" )
		done

		if [ -n "$startLine" ] ; then
			readArgs+=( --start-line "$startLine" --end-line "$endLine" )
			DistroAgentsTools "${readArgs[@]}"
		else
			DistroAgentsTools "${readArgs[@]}"
		fi
		return $?
	;;

	## Read one board item by filename and optional state restrictions, with
	## optional line range. Path lookup remains inside --intern-op-data-read.
	--member-read-board-item)
		shift
		local memberName="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$memberName" ] || [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --member-read-board-item: syntax is <team-member> <item-name> [--board-state <state>]... [--start-line <N> --end-line <N>]" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$memberName" "<team-member>" member-read-board-item || { set +e ; return 1 ; }
		local memberDir="$HOME/.claude/skills/$memberName"
		if [ ! -d "$memberDir" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --member-read-board-item: no such member skill directory: $memberDir" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$itemName" "<item-name>" member-read-board-item || { set +e ; return 1 ; }
		case "$itemName" in
			*-*.md)
			;;
			*)
				echo "⛔ ERROR: $MDSC_CMD --member-read-board-item: item name must match <type>-<name>.md: $itemName" >&2
				set +e ; return 1
			;;
		esac

		local boardStates=()
		local startLine="" endLine=""
		while [ $# -gt 0 ] ; do
			case "$1" in
				--board-state)
					case "$2" in
						backlog|pending|running|blocked|parked|processed|archived|retained)
							boardStates+=( "$2" )
						;;
						*)
							echo "⛔ ERROR: $MDSC_CMD --member-read-board-item: invalid --board-state: $2" >&2
							set +e ; return 1
						;;
					esac
					shift 2
				;;
				--start-line)
					startLine="$2"
					shift 2
				;;
				--end-line)
					endLine="$2"
					shift 2
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --member-read-board-item: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done

		if [ -n "$startLine" ] || [ -n "$endLine" ] ; then
			if [ -z "$startLine" ] || [ -z "$endLine" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-read-board-item: --start-line and --end-line must be provided together" >&2
				set +e ; return 1
			fi
		fi
		if [ ${#boardStates[@]} -eq 0 ] ; then
			boardStates=( backlog pending running blocked parked processed archived retained )
		fi
		[ -n "${MDAT_DATA_ROOT:-}" ] || {
			echo "⛔ ERROR: $MDSC_CMD --member-read-board-item: MDAT_DATA_ROOT is not set" >&2
			set +e ; return 1
		}
		local readArgs=( --intern-op-data-read "$itemName" --context --member-read-board-item )
		local boardState
		for boardState in "${boardStates[@]}" ; do
			readArgs+=( --lookup-folder "$MDAT_DATA_ROOT/board/$boardState" )
		done

		if [ -n "$startLine" ] ; then
			readArgs+=( --start-line "$startLine" --end-line "$endLine" )
		fi
		DistroAgentsTools "${readArgs[@]}"
		return $?
	;;

	--member-inbox-item-read)
		shift
		local memberName="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$memberName" ] || [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --member-inbox-item-read: syntax is <member> <item-filename> [--start-line <N> --end-line <N>]" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$memberName" "<member>" member-inbox-item-read || { set +e ; return 1 ; }
		local memberDir="$HOME/.claude/skills/$memberName"
		if [ ! -d "$memberDir" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --member-inbox-item-read: no such member skill directory: $memberDir" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$itemName" "<item-filename>" member-inbox-item-read || { set +e ; return 1 ; }
		case "$itemName" in
			note-*|inquiry-*|reflection-*|warning-*)
			;;
			*)
				echo "⛔ ERROR: $MDSC_CMD --member-inbox-item-read: only note-*/inquiry-*/reflection-*/warning-* items are allowed: $itemName" >&2
				set +e ; return 1
			;;
		esac

		local startLine="" endLine=""
		while [ $# -gt 0 ] ; do
			case "$1" in
				--start-line)
					startLine="$2"
					shift 2
				;;
				--end-line)
					endLine="$2"
					shift 2
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --member-inbox-item-read: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done

		if [ -n "$startLine" ] || [ -n "$endLine" ] ; then
			if [ -z "$startLine" ] || [ -z "$endLine" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-inbox-item-read: --start-line and --end-line must be provided together" >&2
				set +e ; return 1
			fi
		fi
		[ -n "${MDAT_DATA_ROOT:-}" ] || {
			echo "⛔ ERROR: $MDSC_CMD --member-inbox-item-read: MDAT_DATA_ROOT is not set" >&2
			set +e ; return 1
		}
		local inboxDir="$MDAT_DATA_ROOT/inboxes/$memberName"
		local readArgs=( --intern-op-data-read "$itemName" --context --member-inbox-item-read \
			--lookup-folder "$inboxDir" --lookup-folder "$inboxDir/processed" )

		if [ -n "$startLine" ] ; then
			readArgs+=( --start-line "$startLine" --end-line "$endLine" )
		fi
		DistroAgentsTools "${readArgs[@]}"
		return $?
	;;

	--member-work-session-input-scan)
		shift
		local memberName="$1"
		shift || true
		if [ -z "$memberName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --member-work-session-input-scan: syntax is <member>" >&2
			set +e ; return 1
		fi
		if [ $# -gt 0 ] ; then
			case "$1" in
				--*)
					echo "⛔ ERROR: $MDSC_CMD --member-work-session-input-scan: invalid option: $1 -- syntax is <team-member>, no other arguments -- an input-scan reads all baseline-relevant items itself. SEE $HOME/.claude/skills/magic-team/magic-team.armed.md" >&2
					set +e ; return 1
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --member-work-session-input-scan: syntax is <team-member>, no other arguments -- an input-scan reads all baseline-relevant items itself, an item name is not a parameter. SEE $HOME/.claude/skills/magic-team/magic-team.armed.md" >&2
					set +e ; return 1
				;;
			esac
		fi
		AgentsToolsAssertBareName "$memberName" "<team-member>" member-work-session-input-scan || { set +e ; return 1 ; }
		local memberDir="$HOME/.claude/skills/$memberName"
		if [ ! -d "$memberDir" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --member-work-session-input-scan: no such member skill directory: $memberDir" >&2
			set +e ; return 1
		fi

		DistroAgentsTools --intern-op-session-context-scan "$memberName" \
			--state backlog --state pending --state running --state blocked --state parked \
			--all-types --filter-owner "$memberName" \
			--do-inbox-inquiry-active --do-inbox-reflections \
			--do-inbox-notes --do-inbox-other \
			--context --member-work-session-input-scan
		return $?
	;;

	--member-help)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.MemberHelp.include"
		return $?
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
