#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.MemberCommsConfluence.include -- the raw per-member Confluence
## Cloud comms operations: identity, page read, CQL search, comment read, page
## create, page update, comment add. Transport is the shared Atlassian layer
## (AgentsTools.InternOpAtlassianCall.include) plus the two Atlassian JSON
## readers beside it -- no Python worker is involved.
##

## The shared Atlassian layer, sourced for its definitions only. Its own case
## ends in a branch that does nothing when $1 is none of its own operations, so
## this dispatches nothing and is safe to repeat.
. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.InternOpAtlassianCall.include"

case "$1" in

		--member-comms-confluence-whoami)
			shift
			local memberName="$1"
			shift || true
			if [ -z "$memberName" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-whoami: syntax is <team-member> -- the acting member is required, since an API token resolves to exactly one Atlassian account and this operation exists to say which one" >&2
				set +e ; return 1
			fi
			if [ $# -gt 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-whoami: takes exactly one argument" >&2
				set +e ; return 1
			fi
			local confluenceBody confluenceRc=0
			confluenceBody="$( AgentsToolsAtlassianCall "$memberName" confluence GET /wiki/rest/api/user/current member-comms-confluence-whoami "" )" || confluenceRc=$?
			if [ "$confluenceRc" -ne 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-whoami: COULD NOT DETERMINE which Atlassian account ${memberName}'s credential resolves to (rc=$confluenceRc) -- the acting identity is UNKNOWN, which is NOT the same as anonymous; the diagnostic above is the site's own" >&2
				set +e ; return "$confluenceRc"
			fi
			local confluenceFieldAwk="$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsAtlassianJsonField.awk"
			local confluenceAccountId="$( printf '%s\n' "$confluenceBody" | LC_ALL=C awk -v path=accountId -f "$confluenceFieldAwk" 2>/dev/null )"
			if [ -z "$confluenceAccountId" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-whoami: the current-user call returned no accountId, so the acting identity is UNKNOWN. This is a POSITIVE test on what is present: an empty user is not evidence of an anonymous identity, it is evidence the question was not answered" >&2
				set +e ; return 3
			fi
			printf 'CONFLUENCE_ACCOUNT_ID=%s\n' "$confluenceAccountId"
			printf 'CONFLUENCE_ACCOUNT_EMAIL=%s\n' "$( printf '%s\n' "$confluenceBody" | LC_ALL=C awk -v path=email -v optional=1 -f "$confluenceFieldAwk" 2>/dev/null )"
			## publicName-or-displayName, actually falling back this time: the
			## Python worker this replaces got exactly this wrong (`%` binds
			## tighter than `or`, so it always printed the literal word "None"
			## whenever publicName was absent) -- verified by running both
			## branches of that bug, not read off the old source.
			local confluencePublicName="$( printf '%s\n' "$confluenceBody" | LC_ALL=C awk -v path=publicName -v optional=1 -f "$confluenceFieldAwk" 2>/dev/null )"
			local confluenceDisplayName="$( printf '%s\n' "$confluenceBody" | LC_ALL=C awk -v path=displayName -v optional=1 -f "$confluenceFieldAwk" 2>/dev/null )"
			printf 'CONFLUENCE_ACCOUNT_NAME=%s\n' "${confluencePublicName:-$confluenceDisplayName}"
			return 0
		;;

		--member-comms-confluence-page-read)
			shift
			local memberName="$1"
			shift || true
			local confluencePageId="$1"
			shift || true
			if [ -z "$memberName" ] || [ -z "$confluencePageId" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-read: syntax is <team-member> <page-id> [--format storage|atlas_doc_format] -- the acting member is required, since a page is readable only by identities it is shared with" >&2
				set +e ; return 1
			fi
			local confluenceFormat=""
			while [ $# -gt 0 ] ; do
				case "$1" in
					--format)
						shift
						if [ -z "$1" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-read: --format requires a value: storage or atlas_doc_format" >&2
							set +e ; return 1
						fi
						confluenceFormat="$1" ; shift
					;;
					*)
						echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-read: invalid option: $1" >&2
						set +e ; return 1
					;;
				esac
			done
			[ -n "$confluenceFormat" ] || confluenceFormat=storage
			local confluenceReadPath="/wiki/api/v2/pages/$( AgentsToolsAtlassianUrlEncode "$confluencePageId" )?body-format=$( AgentsToolsAtlassianUrlEncode "$confluenceFormat" )"
			local confluenceBody confluenceRc=0
			confluenceBody="$( AgentsToolsAtlassianCall "$memberName" confluence GET "$confluenceReadPath" member-comms-confluence-page-read "" )" || confluenceRc=$?
			if [ "$confluenceRc" -ne 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-read: COULD NOT READ page $confluencePageId as $memberName (rc=$confluenceRc) -- the content is UNKNOWN, not empty. Note a 404 from Confluence does NOT establish that the page is absent: it returns 404 both for missing content and for content this account cannot see. The diagnostic above is the site's own" >&2
				set +e ; return "$confluenceRc"
			fi
			local confluenceFieldAwk="$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsAtlassianJsonField.awk"
			## atlas_doc_format's own value is a JSON document (ADF), not a scalar,
			## so it is captured raw; storage's is already a plain XHTML string.
			local confluenceBodyRawFlag=()
			[ "$confluenceFormat" = storage ] || confluenceBodyRawFlag=( -v raw=1 )
			local confluencePageValue confluenceValueRc=0
			confluencePageValue="$( printf '%s\n' "$confluenceBody" | LC_ALL=C awk -v path="body.$confluenceFormat.value" "${confluenceBodyRawFlag[@]}" -f "$confluenceFieldAwk" 2>/dev/null )" || confluenceValueRc=$?
			if [ "$confluenceValueRc" -ne 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-read: the page returned no $confluenceFormat body, so its content is UNKNOWN rather than empty. This is a POSITIVE test on what is present" >&2
				set +e ; return 3
			fi
			printf '# page %s: title=%s version=%s spaceId=%s format=%s\n' \
				"$confluencePageId" \
				"$( printf '%s\n' "$confluenceBody" | LC_ALL=C awk -v path=title -v optional=1 -f "$confluenceFieldAwk" 2>/dev/null )" \
				"$( printf '%s\n' "$confluenceBody" | LC_ALL=C awk -v path=version.number -v optional=1 -f "$confluenceFieldAwk" 2>/dev/null )" \
				"$( printf '%s\n' "$confluenceBody" | LC_ALL=C awk -v path=spaceId -v optional=1 -f "$confluenceFieldAwk" 2>/dev/null )" \
				"$confluenceFormat" >&2
			printf '%s' "$confluencePageValue"
			return 0
		;;

		--member-comms-confluence-page-search)
			shift
			local memberName="$1"
			shift || true
			local confluenceCql="$1"
			shift || true
			if [ -z "$memberName" ] || [ -z "$confluenceCql" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-search: syntax is <team-member> <cql> [--limit <n>] -- the acting member is required, since a search returns only what that identity can see. For a plain text search the CQL is: text ~ \"term\"" >&2
				set +e ; return 1
			fi
			local confluenceLimit=""
			while [ $# -gt 0 ] ; do
				case "$1" in
					--limit)
						shift
						if [ -z "$1" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-search: --limit requires a value" >&2
							set +e ; return 1
						fi
						confluenceLimit="$1" ; shift
					;;
					*)
						echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-search: invalid option: $1" >&2
						set +e ; return 1
					;;
				esac
			done
			[ -n "$confluenceLimit" ] || confluenceLimit=25
			local confluenceSearchPath="/wiki/rest/api/search?cql=$( AgentsToolsAtlassianUrlEncode "$confluenceCql" )&limit=$( AgentsToolsAtlassianUrlEncode "$confluenceLimit" )"
			local confluenceBody confluenceRc=0
			confluenceBody="$( AgentsToolsAtlassianCall "$memberName" confluence GET "$confluenceSearchPath" member-comms-confluence-page-search "" )" || confluenceRc=$?
			if [ "$confluenceRc" -ne 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-search: COULD NOT SEARCH as $memberName (rc=$confluenceRc) -- the result set is UNKNOWN, not empty; nothing is known from this call about whether any content matches. The diagnostic above is the site's own" >&2
				set +e ; return "$confluenceRc"
			fi
			local confluenceRows confluenceRowsRc=0
			confluenceRows="$( printf '%s\n' "$confluenceBody" | LC_ALL=C awk -v array=results -v want='content.id,content.type,title,lastModified,url' -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsAtlassianListRecords.awk" )" || confluenceRowsRc=$?
			if [ "$confluenceRowsRc" -ne 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-search: the search returned no results field, so the result set is UNKNOWN rather than empty" >&2
				set +e ; return 3
			fi
			printf 'CONTENT_ID\tTYPE\tTITLE\tLAST_MODIFIED\tURL\n'
			[ -z "$confluenceRows" ] || printf '%s\n' "$confluenceRows"
			## This endpoint carries no isLast/total at all, unlike Jira's -- said
			## explicitly rather than left to read as a confirmed-complete page.
			echo "# member-comms-confluence-page-search: more: unknown -- this endpoint reports no isLast/total, so whether results exist beyond this page cannot be determined from the response" >&2
			return 0
		;;

		--member-comms-confluence-page-create)
			shift
			local memberName="$1"
			shift || true
			if [ -z "$memberName" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-create: syntax is <team-member> (--space <key>|--space-id <numeric-id>) --title <text> (--body-storage <html>|--body-storage-from-stdin|--body-storage-from-file <path>) [--parent-id <id>] -- the acting member is required, since the page is created under that identity and only in a space it can see" >&2
				set +e ; return 1
			fi
			local confluenceSpaceKey="" confluenceSpaceId="" confluenceTitle="" confluenceTitleGiven="false"
			local confluenceParentId="" confluenceBodyStorage="" confluenceBodyGiven="false"
			while [ $# -gt 0 ] ; do
				case "$1" in
					--space)
						shift
						if [ -z "${1:-}" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-create: --space requires a value" >&2
							set +e ; return 1
						fi
						confluenceSpaceKey="$1" ; shift
					;;
					--space-id)
						shift
						if [ -z "${1:-}" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-create: --space-id requires a value" >&2
							set +e ; return 1
						fi
						confluenceSpaceId="$1" ; shift
					;;
					--title)
						shift
						if [ -z "${1:-}" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-create: --title requires a value" >&2
							set +e ; return 1
						fi
						confluenceTitle="$1" ; confluenceTitleGiven="true" ; shift
					;;
					--parent-id)
						shift
						if [ -z "${1:-}" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-create: --parent-id requires a value" >&2
							set +e ; return 1
						fi
						confluenceParentId="$1" ; shift
					;;
					--body-storage)
						shift
						if [ -z "${1:-}" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-create: --body-storage requires a value" >&2
							set +e ; return 1
						fi
						confluenceBodyStorage="$1" ; confluenceBodyGiven="true" ; shift
					;;
					--body-storage-from-stdin)
						confluenceBodyStorage="$( cat )" ; confluenceBodyGiven="true" ; shift
					;;
					--body-storage-from-file)
						shift
						if [ -z "${1:-}" ] || [ ! -f "$1" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-create: --body-storage-from-file: file not found: ${1:-}" >&2
							set +e ; return 1
						fi
						confluenceBodyStorage="$( cat "$1" )" ; confluenceBodyGiven="true" ; shift
					;;
					*)
						echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-create: invalid option: $1" >&2
						set +e ; return 1
					;;
				esac
			done
			if [ -n "$confluenceSpaceKey" ] && [ -n "$confluenceSpaceId" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-create: --space and --space-id are mutually exclusive -- give exactly one" >&2
				set +e ; return 1
			fi
			if [ -z "$confluenceSpaceKey" ] && [ -z "$confluenceSpaceId" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-create: one of --space <key> or --space-id <numeric id> is required -- REST v2 wants the numeric space id, not the key; --space resolves the key to an id first" >&2
				set +e ; return 1
			fi
			if [ -n "$confluenceSpaceId" ] ; then
				case "$confluenceSpaceId" in
					*[!0123456789]*)
						echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-create: --space-id must be a whole number, got: $confluenceSpaceId" >&2
						set +e ; return 1
					;;
				esac
			fi
			if [ -n "$confluenceParentId" ] ; then
				case "$confluenceParentId" in
					*[!0123456789]*)
						echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-create: --parent-id must be a whole number, got: $confluenceParentId" >&2
						set +e ; return 1
					;;
				esac
			fi
			if [ "$confluenceTitleGiven" != "true" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-create: --title is required" >&2
				set +e ; return 1
			fi
			if [ "$confluenceBodyGiven" != "true" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-create: one of --body-storage, --body-storage-from-stdin or --body-storage-from-file is required" >&2
				set +e ; return 1
			fi

			if [ -n "$confluenceSpaceKey" ] ; then
				local confluenceSpaceLookupBody confluenceSpaceLookupRc=0
				confluenceSpaceLookupBody="$( AgentsToolsAtlassianCall "$memberName" confluence GET "/wiki/api/v2/spaces?keys=$( AgentsToolsAtlassianUrlEncode "$confluenceSpaceKey" )" member-comms-confluence-page-create "" )" || confluenceSpaceLookupRc=$?
				if [ "$confluenceSpaceLookupRc" -ne 0 ] ; then
					echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-create: COULD NOT RESOLVE space '$confluenceSpaceKey' to its numeric id as $memberName (rc=$confluenceSpaceLookupRc) -- nothing was created. The diagnostic above is the site's own" >&2
					set +e ; return "$confluenceSpaceLookupRc"
				fi
				local confluenceSpaceRows confluenceSpaceRowsRc=0
				confluenceSpaceRows="$( printf '%s\n' "$confluenceSpaceLookupBody" | LC_ALL=C awk -v array=results -v want='id,key' -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsAtlassianListRecords.awk" )" || confluenceSpaceRowsRc=$?
				if [ "$confluenceSpaceRowsRc" -ne 0 ] ; then
					echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-create: the space lookup returned no results array (rc=$confluenceSpaceRowsRc) -- nothing was created" >&2
					set +e ; return 1
				fi
				local confluenceSpaceMatches confluenceSpaceMatchCount
				confluenceSpaceMatches="$( printf '%s\n' "$confluenceSpaceRows" | LC_ALL=C awk -F'\t' -v want="$confluenceSpaceKey" '$2 == want { print $1 }' )"
				confluenceSpaceMatchCount=0
				[ -z "$confluenceSpaceMatches" ] || confluenceSpaceMatchCount="$( printf '%s\n' "$confluenceSpaceMatches" | awk 'END { print NR }' )"
				if [ "$confluenceSpaceMatchCount" -ne 1 ] ; then
					echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-create: space key '$confluenceSpaceKey' resolved to $confluenceSpaceMatchCount ids as $memberName, not exactly one -- nothing was created. A 0 usually means this identity cannot see that space or the key is wrong; pass --space-id directly if the numeric id is already known" >&2
					set +e ; return 1
				fi
				confluenceSpaceId="$confluenceSpaceMatches"
			fi

			local confluenceTitleEsc confluenceBodyEsc
			confluenceTitleEsc="$( printf '%s' "$confluenceTitle" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsMcpJsonEscape.awk" )"
			confluenceBodyEsc="$( printf '%s' "$confluenceBodyStorage" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsMcpJsonEscape.awk" )"
			local confluenceCreateBody="{\"spaceId\":\"$confluenceSpaceId\",\"status\":\"current\",\"title\":\"$confluenceTitleEsc\""
			[ -n "$confluenceParentId" ] && confluenceCreateBody="$confluenceCreateBody,\"parentId\":\"$confluenceParentId\""
			confluenceCreateBody="$confluenceCreateBody,\"body\":{\"representation\":\"storage\",\"value\":\"$confluenceBodyEsc\"}}"

			local confluenceRc=0
			AgentsToolsAtlassianCall "$memberName" confluence POST /wiki/api/v2/pages member-comms-confluence-page-create "$confluenceCreateBody" || confluenceRc=$?
			if [ "$confluenceRc" -ne 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-create: COULD NOT CREATE the page as $memberName (rc=$confluenceRc) -- the diagnostic above is the site's own. HTTP 400 there usually means a missing field or a bad spaceId/parentId; HTTP 404 means parentId is absent or invisible" >&2
				set +e ; return "$confluenceRc"
			fi
			return 0
		;;

		--member-comms-confluence-page-update)
			shift
			local memberName="$1"
			shift || true
			local confluencePageId="$1"
			shift || true
			if [ -z "$memberName" ] || [ -z "$confluencePageId" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-update: syntax is <team-member> <page-id> --version <n> --title <text> --status <value> (--body-storage <html>|--body-storage-from-stdin|--body-storage-from-file <path>) [--space-id <numeric-id>] -- <n> is the version this caller already read (e.g. via --member-comms-confluence-page-read), NEVER re-read here: this operation computes <n>+1 and submits it, so re-reading the version right before the write would defeat the optimistic lock this endpoint exists to provide. This is a FULL REPLACE: --title and --status are required on every call and are overwritten with whatever is passed, even when only the body actually changed" >&2
				set +e ; return 1
			fi
			local confluenceVersion="" confluenceTitle="" confluenceTitleGiven="false"
			local confluenceStatus="" confluenceStatusGiven="false" confluenceSpaceId=""
			local confluenceBodyStorage="" confluenceBodyGiven="false"
			while [ $# -gt 0 ] ; do
				case "$1" in
					--version)
						shift
						if [ -z "${1:-}" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-update: --version requires a value" >&2
							set +e ; return 1
						fi
						confluenceVersion="$1" ; shift
					;;
					--title)
						shift
						if [ -z "${1:-}" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-update: --title requires a value" >&2
							set +e ; return 1
						fi
						confluenceTitle="$1" ; confluenceTitleGiven="true" ; shift
					;;
					--status)
						shift
						if [ -z "${1:-}" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-update: --status requires a value" >&2
							set +e ; return 1
						fi
						confluenceStatus="$1" ; confluenceStatusGiven="true" ; shift
					;;
					--space-id)
						shift
						if [ -z "${1:-}" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-update: --space-id requires a value" >&2
							set +e ; return 1
						fi
						confluenceSpaceId="$1" ; shift
					;;
					--body-storage)
						shift
						if [ -z "${1:-}" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-update: --body-storage requires a value" >&2
							set +e ; return 1
						fi
						confluenceBodyStorage="$1" ; confluenceBodyGiven="true" ; shift
					;;
					--body-storage-from-stdin)
						confluenceBodyStorage="$( cat )" ; confluenceBodyGiven="true" ; shift
					;;
					--body-storage-from-file)
						shift
						if [ -z "${1:-}" ] || [ ! -f "$1" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-update: --body-storage-from-file: file not found: ${1:-}" >&2
							set +e ; return 1
						fi
						confluenceBodyStorage="$( cat "$1" )" ; confluenceBodyGiven="true" ; shift
					;;
					*)
						echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-update: invalid option: $1" >&2
						set +e ; return 1
					;;
				esac
			done
			case "$confluenceVersion" in
				''|*[!0123456789]*)
					echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-update: --version must be the whole number this caller already read as the page's current version, got: '$confluenceVersion'" >&2
					set +e ; return 1
				;;
			esac
			if [ -n "$confluenceSpaceId" ] ; then
				case "$confluenceSpaceId" in
					*[!0123456789]*)
						echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-update: --space-id must be a whole number, got: $confluenceSpaceId" >&2
						set +e ; return 1
					;;
				esac
			fi
			if [ "$confluenceTitleGiven" != "true" ] || [ "$confluenceStatusGiven" != "true" ] || [ "$confluenceBodyGiven" != "true" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-update: --title, --status and one of --body-storage/--body-storage-from-stdin/--body-storage-from-file are all required -- this is a full-resource replace, so a field left out is not left unchanged, it is overwritten" >&2
				set +e ; return 1
			fi

			local confluenceIdEsc confluenceStatusEsc confluenceTitleEsc confluenceBodyEsc
			confluenceIdEsc="$( printf '%s' "$confluencePageId" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsMcpJsonEscape.awk" )"
			confluenceStatusEsc="$( printf '%s' "$confluenceStatus" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsMcpJsonEscape.awk" )"
			confluenceTitleEsc="$( printf '%s' "$confluenceTitle" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsMcpJsonEscape.awk" )"
			confluenceBodyEsc="$( printf '%s' "$confluenceBodyStorage" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsMcpJsonEscape.awk" )"
			local confluenceNextVersion=$(( confluenceVersion + 1 ))
			local confluenceUpdateBody="{\"id\":\"$confluenceIdEsc\",\"status\":\"$confluenceStatusEsc\",\"title\":\"$confluenceTitleEsc\",\"version\":{\"number\":$confluenceNextVersion}"
			[ -n "$confluenceSpaceId" ] && confluenceUpdateBody="$confluenceUpdateBody,\"spaceId\":\"$confluenceSpaceId\""
			confluenceUpdateBody="$confluenceUpdateBody,\"body\":{\"representation\":\"storage\",\"value\":\"$confluenceBodyEsc\"}}"

			local confluenceRc=0
			AgentsToolsAtlassianCall "$memberName" confluence PUT "/wiki/api/v2/pages/$( AgentsToolsAtlassianUrlEncode "$confluencePageId" )" member-comms-confluence-page-update "$confluenceUpdateBody" || confluenceRc=$?
			if [ "$confluenceRc" = "5" ] ; then
				echo "⛔ ERROR CONFLICT: $MDSC_CMD --member-comms-confluence-page-update: HTTP 409 updating page $confluencePageId as $memberName -- the version submitted ($confluenceNextVersion) is stale. Re-read the page for the real current version/title/body and decide whether to reapply this edit on the new content -- NEVER resubmit version+1 unchanged" >&2
				set +e ; return "$confluenceRc"
			fi
			if [ "$confluenceRc" -ne 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-update: COULD NOT UPDATE page $confluencePageId as $memberName (rc=$confluenceRc) -- the diagnostic above is the site's own" >&2
				set +e ; return "$confluenceRc"
			fi
			return 0
		;;

		## Footer comments on one page, as TSV with its own header row.
		--member-comms-confluence-comment-read)
			shift
			local memberName="$1"
			shift || true
			local confluencePageId="$1"
			shift || true
			if [ -z "$memberName" ] || [ -z "$confluencePageId" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-comment-read: syntax is <team-member> <page-id> -- the acting member is required, since comments are visible only to identities the page is shared with" >&2
				set +e ; return 1
			fi
			if [ $# -gt 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-comment-read: invalid option: $1" >&2
				set +e ; return 1
			fi
			local confluenceCommentPath="/wiki/api/v2/pages/$( AgentsToolsAtlassianUrlEncode "$confluencePageId" )/footer-comments?body-format=storage&limit=100"
			local confluenceBody confluenceRc=0
			confluenceBody="$( AgentsToolsAtlassianCall "$memberName" confluence GET "$confluenceCommentPath" member-comms-confluence-comment-read "" )" || confluenceRc=$?
			if [ "$confluenceRc" -ne 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-comment-read: COULD NOT READ comments on page $confluencePageId as $memberName (rc=$confluenceRc) -- the comment list is UNKNOWN, not empty; the diagnostic above is the site's own" >&2
				set +e ; return "$confluenceRc"
			fi
			local confluenceRows confluenceRowsRc=0
			confluenceRows="$( printf '%s\n' "$confluenceBody" | LC_ALL=C awk -v array=results -v want='id,version.authorId,version.createdAt,body.storage.value' -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsAtlassianListRecords.awk" )" || confluenceRowsRc=$?
			if [ "$confluenceRowsRc" -ne 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-comment-read: the comments call returned no results field, so the comment list is UNKNOWN rather than empty" >&2
				set +e ; return 3
			fi
			printf 'COMMENT_ID\tVERSION_AUTHOR_ID\tCREATED\tBODY\n'
			[ -z "$confluenceRows" ] || printf '%s\n' "$confluenceRows"
			## Same gap as page-search: no isLast/total on this endpoint either.
			echo "# member-comms-confluence-comment-read: more: unknown -- this endpoint reports no isLast/total, so whether comments exist beyond this page cannot be determined from the response" >&2
			return 0
		;;

		--member-comms-confluence-comment-add)
			shift
			local memberName="$1"
			shift || true
			local confluencePageId="$1"
			shift || true
			if [ -z "$memberName" ] || [ -z "$confluencePageId" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-comment-add: syntax is <team-member> <page-id> (--body-storage <html>|--body-storage-from-stdin|--body-storage-from-file <path>) [--parent-comment-id <id>] -- the acting member is required, since the comment is posted under that identity. There is no ADF path here, same as the read side: the body is always Confluence's own storage format" >&2
				set +e ; return 1
			fi
			local confluenceBodyStorage="" confluenceBodyGiven="false" confluenceParentCommentId=""
			while [ $# -gt 0 ] ; do
				case "$1" in
					--body-storage)
						shift
						if [ -z "${1:-}" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-comment-add: --body-storage requires a value" >&2
							set +e ; return 1
						fi
						confluenceBodyStorage="$1" ; confluenceBodyGiven="true" ; shift
					;;
					--body-storage-from-stdin)
						confluenceBodyStorage="$( cat )" ; confluenceBodyGiven="true" ; shift
					;;
					--body-storage-from-file)
						shift
						if [ -z "${1:-}" ] || [ ! -f "$1" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-comment-add: --body-storage-from-file: file not found: ${1:-}" >&2
							set +e ; return 1
						fi
						confluenceBodyStorage="$( cat "$1" )" ; confluenceBodyGiven="true" ; shift
					;;
					--parent-comment-id)
						shift
						if [ -z "${1:-}" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-comment-add: --parent-comment-id requires a value" >&2
							set +e ; return 1
						fi
						confluenceParentCommentId="$1" ; shift
					;;
					*)
						echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-comment-add: invalid option: $1" >&2
						set +e ; return 1
					;;
				esac
			done
			if [ "$confluenceBodyGiven" != "true" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-comment-add: one of --body-storage, --body-storage-from-stdin or --body-storage-from-file is required" >&2
				set +e ; return 1
			fi
			if [ -n "$confluenceParentCommentId" ] ; then
				case "$confluenceParentCommentId" in
					*[!0123456789]*)
						echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-comment-add: --parent-comment-id must be a whole number, got: $confluenceParentCommentId" >&2
						set +e ; return 1
					;;
				esac
			fi
			local confluencePageIdEsc confluenceBodyEsc
			confluencePageIdEsc="$( printf '%s' "$confluencePageId" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsMcpJsonEscape.awk" )"
			confluenceBodyEsc="$( printf '%s' "$confluenceBodyStorage" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsMcpJsonEscape.awk" )"
			## Atlassian's real POST /wiki/api/v2/footer-comments requires
			## EXACTLY ONE of pageId/parentCommentId, not both -- confirmed
			## live via a genuine HTTP 400 when both were sent together. So
			## these two are mutually exclusive in the body, not additive:
			## a threaded reply names its parent comment only, a top-level
			## comment names its page only.
			local confluenceCommentBody
			if [ -n "$confluenceParentCommentId" ] ; then
				confluenceCommentBody="{\"parentCommentId\":\"$confluenceParentCommentId\",\"body\":{\"representation\":\"storage\",\"value\":\"$confluenceBodyEsc\"}}"
			else
				confluenceCommentBody="{\"pageId\":\"$confluencePageIdEsc\",\"body\":{\"representation\":\"storage\",\"value\":\"$confluenceBodyEsc\"}}"
			fi

			local confluenceRc=0
			AgentsToolsAtlassianCall "$memberName" confluence POST /wiki/api/v2/footer-comments member-comms-confluence-comment-add "$confluenceCommentBody" || confluenceRc=$?
			if [ "$confluenceRc" -ne 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-comment-add: COULD NOT COMMENT on page $confluencePageId as $memberName (rc=$confluenceRc) -- the diagnostic above is the site's own. HTTP 400 there usually means a malformed storage body or a missing pageId; HTTP 404 means the page is absent or invisible" >&2
				set +e ; return "$confluenceRc"
			fi
			return 0
		;;

		*)
			echo "⛔ ERROR: $MDSC_CMD: unknown --member-comms-confluence-* operation: $1 -- the supported operations are --member-comms-confluence-whoami, --member-comms-confluence-page-search, --member-comms-confluence-page-read, --member-comms-confluence-page-create, --member-comms-confluence-page-update, --member-comms-confluence-comment-read and --member-comms-confluence-comment-add" >&2
			set +e ; return 1
		;;

esac
