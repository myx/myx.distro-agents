#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.MemberCommsConfluence.include -- the raw per-member Confluence
## Cloud comms operations (identity, page read, CQL search, comment read).
##

AgentsToolsConfluenceResolveMember() {
	local opName="$1"
	local memberName="$2"

	AgentsToolsAssertBareName "$memberName" "<team-member>" "$opName" || return 1
	case "$memberName" in
		routine-*)
		;;
		*)
			if [ ! -d "$HOME/.claude/skills/$memberName" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --$opName: no such member skill directory: $HOME/.claude/skills/$memberName" >&2
				return 1
			fi
		;;
	esac

	confluenceSite="$( DistroAgentsTools --agents-config-option "$memberName" --select CONFLUENCE_SITE )"
	confluenceUser="$( DistroAgentsTools --agents-config-option "$memberName" --select CONFLUENCE_USER )"
	confluenceToken="$( DistroAgentsTools --agents-config-option "$memberName" --select CONFLUENCE_API_TOKEN )"
	if [ -z "$confluenceSite" ] || [ -z "$confluenceUser" ] || [ -z "$confluenceToken" ] ; then
		echo "⛔ ERROR: $MDSC_CMD --$opName: CONFLUENCE_SITE/CONFLUENCE_USER/CONFLUENCE_API_TOKEN not fully set in ${memberName}'s own scope in .local/.agents" >&2
		return 1
	fi

	local confluenceNewline=$'\n'
	case "$confluenceSite$confluenceUser$confluenceToken" in
		*"$confluenceNewline"*)
			echo "⛔ ERROR: $MDSC_CMD --$opName: CONFLUENCE_SITE/CONFLUENCE_USER/CONFLUENCE_API_TOKEN in ${memberName}'s own scope in .local/.agents contains a newline -- none of them ever legitimately does, so the config is corrupted. The value is NOT stripped or repaired here: the resulting 401 would be misread as a revoked credential" >&2
			return 1
		;;
	esac
	return 0
}

AgentsToolsConfluenceCall() {
	AGENTS_CONFLUENCE_SITE="$confluenceSite" \
	AGENTS_CONFLUENCE_USER="$confluenceUser" \
	AGENTS_CONFLUENCE_API_TOKEN="$confluenceToken" \
	AGENTS_CONFLUENCE_OP="$1" \
	AGENTS_CONFLUENCE_PAGE_ID="${confluencePageId:-}" \
	AGENTS_CONFLUENCE_CQL="${confluenceCql:-}" \
	AGENTS_CONFLUENCE_LIMIT="${confluenceLimit:-}" \
	AGENTS_CONFLUENCE_FORMAT="${confluenceFormat:-}" \
	python3 "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsConfluenceApiCall.py"
}

case "$1" in

		--member-comms-confluence-whoami)
			shift
			local memberName="$1"
			shift || true
			if [ -z "$memberName" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-whoami: syntax is <team-member> -- the acting member is required, since an API token resolves to exactly one Atlassian account and this operation exists to say which one" >&2
				set +e ; return 1
			fi
			if [ $# -gt 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-whoami: takes exactly one argument" >&2
				set +e ; return 1
			fi
			local confluenceSite confluenceUser confluenceToken
			AgentsToolsConfluenceResolveMember member-comms-confluence-whoami "$memberName" || { set +e ; return 1 ; }
			local confluenceRc=0
			AgentsToolsConfluenceCall whoami || confluenceRc=$?
			if [ "$confluenceRc" -ne 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-whoami: COULD NOT DETERMINE which Atlassian account ${memberName}'s credential resolves to (worker rc=$confluenceRc) -- the acting identity is UNKNOWN, which is NOT the same as anonymous; the worker's own diagnostic is above" >&2
				set +e ; return "$confluenceRc"
			fi
			return 0
		;;

		--member-comms-confluence-page-read)
			shift
			local memberName="$1"
			shift || true
			local confluencePageId="$1"
			shift || true
			if [ -z "$memberName" ] || [ -z "$confluencePageId" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-read: syntax is <team-member> <page-id> [--format storage|atlas_doc_format] -- the acting member is required, since a page is readable only by identities it is shared with" >&2
				set +e ; return 1
			fi
			local confluenceFormat=""
			while [ $# -gt 0 ] ; do
				case "$1" in
					--format)
						shift
						if [ -z "$1" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-read: --format requires a value: storage or atlas_doc_format" >&2
							set +e ; return 1
						fi
						confluenceFormat="$1" ; shift
					;;
					*)
						echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-read: invalid option: $1" >&2
						set +e ; return 1
					;;
				esac
			done
			local confluenceSite confluenceUser confluenceToken
			AgentsToolsConfluenceResolveMember member-comms-confluence-page-read "$memberName" || { set +e ; return 1 ; }
			local confluenceRc=0
			AgentsToolsConfluenceCall page-read || confluenceRc=$?
			if [ "$confluenceRc" -ne 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-read: COULD NOT READ page $confluencePageId as $memberName (worker rc=$confluenceRc) -- the content is UNKNOWN, not empty. Note a 404 from Confluence does NOT establish that the page is absent: it returns 404 both for missing content and for content this account cannot see. The worker's own diagnostic is above" >&2
				set +e ; return "$confluenceRc"
			fi
			return 0
		;;

		--member-comms-confluence-page-search)
			shift
			local memberName="$1"
			shift || true
			local confluenceCql="$1"
			shift || true
			if [ -z "$memberName" ] || [ -z "$confluenceCql" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-search: syntax is <team-member> <cql> [--limit <n>] -- the acting member is required, since a search returns only what that identity can see. For a plain text search the CQL is: text ~ \"term\"" >&2
				set +e ; return 1
			fi
			local confluenceLimit=""
			while [ $# -gt 0 ] ; do
				case "$1" in
					--limit)
						shift
						if [ -z "$1" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-search: --limit requires a value" >&2
							set +e ; return 1
						fi
						confluenceLimit="$1" ; shift
					;;
					*)
						echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-search: invalid option: $1" >&2
						set +e ; return 1
					;;
				esac
			done
			local confluenceSite confluenceUser confluenceToken
			AgentsToolsConfluenceResolveMember member-comms-confluence-page-search "$memberName" || { set +e ; return 1 ; }
			local confluenceRc=0
			AgentsToolsConfluenceCall page-search || confluenceRc=$?
			if [ "$confluenceRc" -ne 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-search: COULD NOT SEARCH as $memberName (worker rc=$confluenceRc) -- the result set is UNKNOWN, not empty; nothing is known from this call about whether any content matches. The worker's own diagnostic is above" >&2
				set +e ; return "$confluenceRc"
			fi
			return 0
		;;

		## Footer comments on one page, as TSV with its own header row.
		--member-comms-confluence-comment-read)
			shift
			local memberName="$1"
			shift || true
			local confluencePageId="$1"
			shift || true
			if [ -z "$memberName" ] || [ -z "$confluencePageId" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-comment-read: syntax is <team-member> <page-id> -- the acting member is required, since comments are visible only to identities the page is shared with" >&2
				set +e ; return 1
			fi
			if [ $# -gt 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-comment-read: invalid option: $1" >&2
				set +e ; return 1
			fi
			local confluenceSite confluenceUser confluenceToken
			AgentsToolsConfluenceResolveMember member-comms-confluence-comment-read "$memberName" || { set +e ; return 1 ; }
			local confluenceRc=0
			AgentsToolsConfluenceCall comment-read || confluenceRc=$?
			if [ "$confluenceRc" -ne 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-confluence-comment-read: COULD NOT READ comments on page $confluencePageId as $memberName (worker rc=$confluenceRc) -- the comment list is UNKNOWN, not empty; the worker's own diagnostic is above" >&2
				set +e ; return "$confluenceRc"
			fi
			return 0
		;;

		*)
			echo "⛔ ERROR: $MDSC_CMD: unknown --member-comms-confluence-* operation: $1 -- this family is read-only today; the supported operations are --member-comms-confluence-whoami, --member-comms-confluence-page-read, --member-comms-confluence-page-search and --member-comms-confluence-comment-read" >&2
			set +e ; return 1
		;;

esac
