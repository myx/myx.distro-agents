#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

case "$1" in

		--member-comms-confluence-space-list)
			shift
			local actingMember="${1:-}"
			shift || { printf '%s\n' "⛔ ERROR: $MDSC_CMD --member-comms-confluence-space-list: <team-member> missing" >&2 ; set +e ; return 1 ; }
			[ -n "$actingMember" ] || { printf '%s\n' "⛔ ERROR: $MDSC_CMD --member-comms-confluence-space-list: <team-member> missing" >&2 ; set +e ; return 1 ; }
			case "$#:${1:-}" in
				0:|2:--cursor) ;;
				*) printf '%s\n' "⛔ ERROR: $MDSC_CMD --member-comms-confluence-space-list: not accepted: $actingMember $*" >&2 ; set +e ; return 1 ;;
			esac
			local opRc=0
			DistroAgentsTools --intern-op-atlassian-confluence-space-list --member "$actingMember" --context member-comms-confluence-space-list "$@" || opRc=$?
			if [ "$opRc" -ne 0 ] ; then set +e ; return "$opRc" ; fi
			return 0
		;;

		--member-comms-confluence-page-read)
			shift
			local actingMember="${1:-}" pageId="${2:-}"
			shift || { printf '%s\n' "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-read: <team-member> missing" >&2 ; set +e ; return 1 ; }
			[ -n "$actingMember" ] || { printf '%s\n' "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-read: <team-member> missing" >&2 ; set +e ; return 1 ; }
			shift || { printf '%s\n' "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-read: <page-id> missing" >&2 ; set +e ; return 1 ; }
			[ -n "$pageId" ] || { printf '%s\n' "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-read: <page-id> missing" >&2 ; set +e ; return 1 ; }
			case "$#:${1:-}" in
				0:|2:--format) ;;
				*) printf '%s\n' "⛔ ERROR: $MDSC_CMD --member-comms-confluence-page-read: not accepted: $actingMember $pageId $*" >&2 ; set +e ; return 1 ;;
			esac
			local opRc=0
			DistroAgentsTools --intern-op-atlassian-confluence-page-read --member "$actingMember" --context member-comms-confluence-page-read --page-id "$pageId" "$@" || opRc=$?
			if [ "$opRc" -ne 0 ] ; then set +e ; return "$opRc" ; fi
			return 0
		;;

		*)
			printf '%s\n' "⛔ ERROR: $MDSC_CMD: unknown --member-comms-confluence-* operation: $1 -- the supported operations are --member-comms-confluence-space-list and --member-comms-confluence-page-read" >&2
			set +e ; return 1
		;;

esac
