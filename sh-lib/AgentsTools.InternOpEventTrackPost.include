#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.InternOpEventTrackPost.include -- --intern-op-event-track-post, the one path of
## the tooling's own tracking posts: the posts in a spawn's event-track thread, and the
## tooling's status notes in a session thread. Never a member's message.
##
## The text is the tooling template sh-lib/templates/event-track.post.format.md, read
## from this package's own sh-lib, so the template and the code that fills it are always
## the same version. This op fills its slots (AgentsEventTrackPostFill.awk): blocks, each a
## subject header then its lines, every line given becoming one operation's line by its own
## template, never posted as it came and never as a code block. It cuts the post into
## posts of at most 4000 characters, fixed in code: Slack's limit for a message's `text`,
## the field this op sends (AgentsEventTrackPostFill.awk). It posts each once and never
## edits a post: what is learned later is a new post, a reply in the thread. Nothing of
## the member send's addressing runs: no addressee, no author line, no conversation lookup.
##
## Transport: --intern-op-slack-call, so its bot-token resolution and Retry-After handling
## apply unchanged, under the bot identity every tracking post has used (the member's own
## bot token where it has one, else the team's). One line per post in the monthly
## comms-slack-send.YYYY-MM.log, in the member send's own columns. Reports the first post
## as SENT_MESSAGE_CHANNEL/SENT_MESSAGE_TS/SENT_MESSAGE_THREAD_TS on stderr, as the member
## send does. No --help entry (internal primitive).
##
## Dual use: sourced with any other first argument it only defines its functions.
##

agentsEventTrackPostLib="$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib"

. "$agentsEventTrackPostLib/AgentsTools.ToolingTemplate.include"

## The template, from this package's own sh-lib/templates/ (AgentsToolsToolingTemplate).
AgentsEventTrackPostTemplate(){
	AgentsToolsToolingTemplate event-track.post.format.md
}

## Renders the posts into a directory, one file each (000001, ...); rc 3 for a kind the
## template has no block for, 1 when nothing could be rendered.
AgentsEventTrackPostRender(){ ## kind, member, session id, out dir, lines file, name=value...
	local renderKind="$1" renderMember="$2" renderSession="$3" renderDir="$4" renderLines="$5" renderFields="" renderField
	shift 5
	[ -f "$( AgentsEventTrackPostTemplate )" ] || return 1
	## One field per line: a newline or CR in a value is sent as %0A or %0D, so it can never open another field.
	for renderField in "$@" ; do
		renderField="${renderField//$'\n'/%0A}"
		renderFields="$renderFields${renderField//$'\r'/%0D}"$'\n'
	done
	## Values travel through the environment, not -v, which would decode backslashes in them.
	## The team's members, so a line's by= opens a block regarding that member only when it names one:
	## every workspace's, from the member directory (AgentsTools.TeamRegistry.include).
	type AgentsToolsTeamMemberDirectoryText > /dev/null 2>&1 || . "$agentsEventTrackPostLib/AgentsTools.TeamRegistry.include"
	## Who a message's Slack account is: the team's own account cache, read only, `<id>=<name>` each.
	local renderUsers=""
	[ ! -s "${MMDAPP:-}/.local/.agents/slack-mention-ids.cache" ] \
		|| renderUsers="$( LC_ALL=C awk -F= 'NR > 1 && $1 ~ /^[A-Za-z0-9_.-]+$/ && $2 ~ /^[A-Z0-9]+$/ { printf " %s=%s", $2, $1 }' "$MMDAPP/.local/.agents/slack-mention-ids.cache" 2>/dev/null )"
	## A feed post's session keeps its previous Wait set beside its feed, so a Wait shows what it
	## waited on only where that changed (AgentsTools.EventTrackFeed.include); only for a session
	## whose directory is already there.
	local renderWaitState=""
	case "$renderSession" in ''|*/*|.|..|*' '*) ;; *)
		[ "$renderKind" != "feed" ] || [ ! -d "${MMDAPP:-}/.local/agents/sessions/$renderSession" ] \
			|| renderWaitState="$MMDAPP/.local/agents/sessions/$renderSession/event-track.wait-on"
	;; esac
	## The transcript formatter first, for its redaction and tool names.
	ETP_KIND="$renderKind" ETP_MEMBER="$renderMember" ETP_SESSION="$renderSession" ETP_FIELDS="$renderFields" \
		ETP_DIR="$renderDir" ETP_MEMBERS=" $( [ -z "${MDAT_SKILLSET_ROOT:-}" ] || AgentsToolsTeamMemberDirectoryText 2>/dev/null | cut -f1 | tr '\n' ' ' )" \
		ETP_USERS="$renderUsers" ETP_WAIT_STATE="$renderWaitState" \
		LC_ALL=C awk -f "$agentsEventTrackPostLib/AgentsSessionTranscriptFormat.awk" -f "$agentsEventTrackPostLib/AgentsEventTrackPostFill.awk" \
		"$( AgentsEventTrackPostTemplate )" "$renderLines"
}

## One line in the monthly send log, in the member send's columns: time, member, target,
## channel, identity, ok|failed, reason, session id ('-' when none).
AgentsEventTrackPostLog(){ ## member, target, channel, ok|failed, reason
	local logDir="$MMDAPP/.local/agents" logStamp logReason logSession
	logStamp="$( date -u +%Y%m%dT%H%M%SZ )"
	logReason="$( printf '%s' "$5" | LC_ALL=C tr -c 'A-Za-z0-9_.:=/ -' '_' )"
	logSession="$( printf '%s' "${harnessSessionId:-${MDAT_SPAWN_SESSION_ID:-${CLAUDE_CODE_SESSION_ID:-}}}" | LC_ALL=C tr '\t\n\r' '___' )"
	{ mkdir -p "$logDir" && printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$logStamp" "$1" "$2" "$3" bot "$4" "$logReason" "${logSession:--}" \
		>> "$logDir/comms-slack-send.${logStamp:0:4}-${logStamp:4:2}.log" ; } 2>/dev/null \
		|| echo "⚠️ WARNING: $MDSC_CMD --intern-op-event-track-post: could not append this post's outcome to the send log" >&2
	return 0
}

case "$1" in

	--intern-op-event-track-post)
		shift
		local etpMember="${1:-}" etpTarget="${2:-}"
		[ $# -lt 2 ] || shift 2
		local etpKind="" etpSession="" etpStdin="false" etpFields=()
		while [ $# -gt 0 ] ; do
			case "$1" in
				--kind|--session-id|--field|--context)
					if [ $# -lt 2 ] ; then
						echo "⛔ ERROR: $MDSC_CMD --intern-op-event-track-post: $1 needs a value" >&2
						set +e ; return 1
					fi
					case "$1" in
						--kind) etpKind="$2" ;;
						--session-id) etpSession="$2" ;;
						--field)
							case "$2" in
								?*=*) etpFields+=( "$2" ) ;;
								*)
									echo "⛔ ERROR: $MDSC_CMD --intern-op-event-track-post: --field takes <name>=<value>, got: $2" >&2
									set +e ; return 1
								;;
							esac
						;;
					esac
					shift 2
				;;
				--from-stdin) etpStdin="true" ; shift ;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --intern-op-event-track-post: invalid option: $1 -- syntax is <member> <target> --kind <kind> [--session-id <id>] [--field <name>=<value>]... [--from-stdin]" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$etpMember" ] || [ -z "$etpTarget" ] || [ -z "$etpKind" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-op-event-track-post: syntax is <member> <target> --kind <kind> [--session-id <id>] [--field <name>=<value>]... [--from-stdin]" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$etpMember" "<member>" event-track-post || { set +e ; return 1 ; }
		AgentsToolsAssertBareName "$etpKind" "--kind" event-track-post || { set +e ; return 1 ; }
		case "$etpMember" in
			routine-*) ;;
			*)
				if [ ! -d "$MDAT_SKILLSET_ROOT/$etpMember" ] ; then
					echo "⛔ ERROR: $MDSC_CMD --intern-op-event-track-post: no such member skill directory: $MDAT_SKILLSET_ROOT/$etpMember" >&2
					set +e ; return 1
				fi
			;;
		esac

		. "$agentsEventTrackPostLib/AgentsTools.CommsSlack.include"
		local etpResolved="" etpResolveRc=0 etpChannel="" etpThread=""
		etpResolved="$( DistroAgentsToolsResolveTarget "$etpTarget" )" || etpResolveRc=$?
		if [ "$etpResolveRc" != "0" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-op-event-track-post: could not resolve a channel for target '$etpTarget'" >&2
			set +e ; return 1
		fi
		etpChannel="$( printf '%s\n' "$etpResolved" | sed -n 's/^CHANNEL=//p' )"
		etpThread="$( printf '%s\n' "$etpResolved" | sed -n 's/^THREAD_TS=//p' )"

		local etpDir=""
		etpDir="$( mkdir -p "$MMDAPP/.local/temp" && mktemp -d "$MMDAPP/.local/temp/mdat-event-track-post.XXXXXX" )" || {
			echo "⛔ ERROR: $MDSC_CMD --intern-op-event-track-post: could not create a scratch directory under $MMDAPP/.local/temp -- nothing was posted" >&2
			set +e ; return 1
		}
		mkdir -p "$etpDir/posts"
		if [ "$etpStdin" = "true" ] ; then cat > "$etpDir/lines" ; else : > "$etpDir/lines" ; fi
		local etpRenderRc=0
		AgentsEventTrackPostRender "$etpKind" "$etpMember" "$etpSession" "$etpDir/posts" "$etpDir/lines" ${etpFields[@]+"${etpFields[@]}"} || etpRenderRc=$?
		local etpPosts=()
		local etpPostFile
		for etpPostFile in "$etpDir/posts"/* ; do
			[ ! -f "$etpPostFile" ] || etpPosts+=( "$etpPostFile" )
		done
		if [ "$etpRenderRc" != "0" ] || [ "${#etpPosts[@]}" -eq 0 ] ; then
			rm -rf "$etpDir"
			if [ "$etpRenderRc" = "3" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --intern-op-event-track-post: the template has no block for kind '$etpKind': $( AgentsEventTrackPostTemplate )" >&2
			else
				echo "⛔ ERROR: $MDSC_CMD --intern-op-event-track-post: the post could not be rendered from $( AgentsEventTrackPostTemplate ) (rc $etpRenderRc)" >&2
			fi
			set +e ; return 1
		fi

		## One post per part. A post to a conversation opens a thread; its later parts go there.
		local etpMetadata="{\"event_type\":\"magic_sender\",\"event_payload\":{\"sender\":\"$etpMember\",\"tracking\":\"$etpKind\"}}"
		local etpIndex=0 etpText etpPayload etpResponse etpRc etpJoined="false" etpTs etpError
		for etpPostFile in "${etpPosts[@]}" ; do
			etpIndex=$(( etpIndex + 1 ))
			etpText="$( LC_ALL=C awk -f "$agentsEventTrackPostLib/AgentsMcpJsonEscape.awk" < "$etpPostFile" )"
			etpPayload="{\"channel\":\"$etpChannel\",\"text\":\"$etpText\"${etpThread:+,\"thread_ts\":\"$etpThread\"},\"metadata\":$etpMetadata}"
			while : ; do
				etpRc=0
				etpResponse="$( DistroAgentsTools --intern-op-slack-call "$etpMember" --api chat.postMessage --identity bot --json-body "$etpPayload" \
					--context --intern-op-event-track-post 2> "$etpDir/call.err" )" || etpRc=$?
				## The shared call's own warnings (a rate limit waited out) are said here too.
				LC_ALL=C grep -F '⚠️ WARNING' "$etpDir/call.err" >&2 || :
				[ "$etpRc" != "0" ] || break
				## The bot not yet in the conversation joins it once, as the member send does for a top-level post.
				if [ "$etpJoined" = "false" ] && [ -z "$etpThread" ] && LC_ALL=C grep -q '"error":"not_in_channel"' "$etpDir/call.err" ; then
					etpJoined="true"
					if DistroAgentsTools --intern-op-slack-call "$etpMember" --api conversations.join --identity bot --form "channel=$etpChannel" \
						--context --intern-op-event-track-post > /dev/null 2>&1 ; then
						continue
					fi
				fi
				break
			done
			if [ "$etpRc" != "0" ] ; then
				etpError="$( LC_ALL=C grep -m1 'ERROR' "$etpDir/call.err" 2>/dev/null )" || etpError=""
				AgentsEventTrackPostLog "$etpMember" "$etpTarget" "$etpChannel" failed "not posted: event-track $etpKind part $etpIndex of ${#etpPosts[@]} error=$( printf '%s' "$etpError" | LC_ALL=C sed -n 's/.*"error":"\([a-z_]*\)".*/\1/p' | head -n 1 )"
				rm -rf "$etpDir"
				echo "⛔ ERROR: $MDSC_CMD --intern-op-event-track-post: the $etpKind post, part $etpIndex of ${#etpPosts[@]}, was not posted to $etpTarget: ${etpError:-the Slack call failed}" >&2
				set +e ; return 1
			fi
			etpTs="$( printf '%s\n' "$etpResponse" | LC_ALL=C awk -v path=ts -v optional=1 -v dialect=slack -f "$agentsEventTrackPostLib/AgentsHarnessJsonField.awk" 2>/dev/null )" || etpTs=""
			[ -n "$etpTs" ] || etpTs="$( printf '%s\n' "$etpResponse" | LC_ALL=C awk -v path=message.ts -v optional=1 -v dialect=slack -f "$agentsEventTrackPostLib/AgentsHarnessJsonField.awk" 2>/dev/null )" || etpTs=""
			AgentsEventTrackPostLog "$etpMember" "$etpTarget" "$etpChannel" ok "event-track $etpKind posted ts=$etpTs"
			if [ "$etpIndex" = "1" ] ; then
				echo "SENT_MESSAGE_CHANNEL=$etpChannel" >&2
				echo "SENT_MESSAGE_TS=$etpTs" >&2
				echo "SENT_MESSAGE_THREAD_TS=${etpThread:-$etpTs}" >&2
			fi
			printf 'EVENT_TRACK_POST=%s:%s\n' "$etpChannel" "$etpTs"
			## The later parts of a post that opened a thread go into it.
			[ -n "$etpThread" ] || [ -z "$etpTs" ] || etpThread="$etpTs"
		done
		rm -rf "$etpDir"
		return 0
	;;

esac
