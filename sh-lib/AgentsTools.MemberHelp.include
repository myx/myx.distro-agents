#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.MemberHelp.include -- --member-help <team-member>'s own
## operation group for DistroAgentsTools.fn.sh's dispatcher. Sourced lazily
## from the `--member-help)` arm inside AgentsTools.Member.include, via the
## standard $MDLT_ORIGIN-based path.
## Not standalone: relies on being dot-sourced for $1/$@/$MDSC_CMD.
##
## That arm lives in Member.include rather than in the outer dispatcher
## because --member-help matches the dispatcher's own earlier --member-*
## wildcard arm, which wins -- an exact --member-help route in the outer case
## could never be reached. See that arm's own comment for the full reasoning.
##
## Two-section output:
## - `# Duty instructions` -- the raw operation-name list this specific
##   member's own <name>.armed.md declares in its own "## DistroAgentsTools
##   magic-tooling operations" bullet list ("what this member is on duty to
##   use", straight from its own file).
## - `# Tooling help output` -- the filtered real syntax lines from
##   Help.DistroAgentsTools.include matching: the shared/floor operations
##   every member gets (magic-team.armed.md's own tooling section), this
##   member's own declared list above, and this member's own role-family
##   common-prefix filter (below) -- never the whole, unfiltered
##   Help.DistroAgentsTools.help.md.
##
## Data source is the deployed skillset, $HOME/.claude/skills/<name>/<name>.armed.md
## -- same skill-root convention --librarian-list-team-files already uses,
## not a new one invented here.
##

case "$1" in

	--member-help)
		shift
		local targetMember="$1"
		shift || true
		if [ -z "$targetMember" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --member-help: syntax is <team-member>" >&2
			set +e ; return 1
		fi
		if [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --member-help: takes exactly one argument" >&2
			set +e ; return 1
		fi

		## Every recognized role-family prefix its own hardcoded arm (not one
		## combined `a|b|c)` line) -- never a directory-existence test, since
		## oncall-*/expert-*/warden-* currently have zero live members, so
		## testing for a real folder would wrongly reject a valid,
		## just-not-yet-created name. Each arm sets $commonPrefixes,
		## this role-family's own common tooling filter -- one prefix per
		## line, vertical/array-shaped so the actual list is readable at a
		## glance, not buried in a long horizontal string. `--member-*` is
		## common to every arm (confirmed). Console ops are a hard
		## requirement for keeper-*/warden-* specifically (their own
		## contract's console-session rule, magic-team.shared.md's "Armed &
		## Routine contracts") -- not for magic-*/partner-*/client-*/oncall-*/
		## expert-* (partner-*/client-* do get console ops, but per-member,
		## via their own .armed.md's declared list -- their own contract
		## makes those available, not a standing requirement; oncall-*/
		## expert-* are external billed resources that don't touch this
		## tool's own console-session machinery at all).
		local commonPrefixes
		case "$targetMember" in
			magic-coordinator)
				commonPrefixes=(
					"--member-*"
					"--owner-workspace-list"
					"--check-*"
					"--member-comms-email-send"
					"--member-comms-email-mark-seen"
					"--magic-*"
					"--console-*"
					"--member-comms-slack-react"
					"--routine-*"
				)
			;;
			magic-librarian)
				commonPrefixes=(
					"--member-*"
					"--librarian-*"
				)
			;;
			magic-devops)
				commonPrefixes=(
					"--member-*"
					"--install-*"
				)
			;;
			magic-*)
				commonPrefixes=(
					"--member-*"
				)
			;;
			partner-*|client-*)
				commonPrefixes=(
					"--member-*"
				)
			;;
			keeper-*|warden-*)
				commonPrefixes=(
					"--member-*"
					"--console-*"
				)
			;;
			oncall-*|expert-*)
				commonPrefixes=(
					"--member-*"
				)
			;;
			human-owner)
				## Investigated: human-owner.armed.md's own tooling section
				## exists but is currently empty -- non-acting, "MUST NOT
				## execute tooling directly -- escalate via the coordinator
				## flow." `--owner-*` is obviously theirs regardless of that
				## empty list: the whole namespace exists to manage the
				## human-owner's own workspace registry.
				commonPrefixes=(
					"--help"
					"--member-*"
					"--owner-*"
				)
			;;
			*)
				echo "⛔ ERROR: $MDSC_CMD --member-help: not a recognized team-member naming pattern: $targetMember" >&2
				set +e ; return 1
			;;
		esac

		local skillRoot="$HOME/.claude/skills"
		local memberFile="$skillRoot/$targetMember/$targetMember.armed.md"
		if [ ! -f "$memberFile" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --member-help: no such team-member: $targetMember ($memberFile not found)" >&2
			set +e ; return 1
		fi

		local floorFile="$skillRoot/magic-team/magic-team.armed.md"
		local helpInclude="$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/help/Help.DistroAgentsTools.include"
		local helpMd="$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/help/Help.DistroAgentsTools.help.md"

		## Extracts bare `--op-name`/`--op-prefix-*` tokens from a file's own
		## "## DistroAgentsTools magic-tooling operations" bullet list --
		## stops at the next "## " heading, same block a human reads. Every
		## closing `}` below is preceded by a `;` even on a single-statement
		## line (magic-developer's reference/shell.md axiom: some AWK
		## implementations reject the missing-semicolon form as a hard parse
		## error).
		ExtractOpNames(){
			awk '
				/^## DistroAgentsTools magic-tooling operations/ { inBlock=1; next; }
				inBlock && /^## / { inBlock=0; }
				inBlock && /^- `--/ {
					## Every backtick-quoted op on the bullet, not just the
					## first. The previous form cut the line at its first
					## closing backtick, so a bullet naming two or more ops
					## yielded only the leading one -- against the real
					## magic-team.armed.md that silently dropped three
					## (--owner-workspace-upsert, --owner-workspace-forget,
					## --magic-heartbeat-state-upsert) from the set a member is
					## told it may use, while members are instructed to execute
					## nothing outside that set. Under-reporting here does not
					## fail loudly; it quietly narrows the mandate a member
					## believes it has.
					##
					## NOTE for future editors: this comment sits INSIDE a
					## single-quoted AWK program. An apostrophe here closes
					## that quote and breaks the file -- keep this block
					## apostrophe-free.
					line=$0;
					while (match(line, /`--[^`]*`/)) {
						tok = substr(line, RSTART + 1, RLENGTH - 2);
						## Trim any argument spec carried inside the backticks
						## (e.g. `--member-help <team-member>`) -- the op name
						## is the first whitespace-delimited word.
						sub(/[ \t].*$/, "", tok);
						if (tok != "") { print tok; };
						line = substr(line, RSTART + RLENGTH);
					}
				}
			' "$1"
		}

		## A member declaring zero ops of its own is legitimate, not fatal --
		## e.g. human-owner, non-acting, real zero-bullet tooling section.
		## Floor + this member's own role-family common filter (set above)
		## still apply regardless, so there's still real content to show
		## even when $ownOpNames comes back empty.
		local ownOpNames
		ownOpNames="$( ExtractOpNames "$memberFile" | sort -u )"

		echo "# Duty instructions" >&2
		echo >&2
		if [ -n "$ownOpNames" ] ; then
			echo "$targetMember's own declared operations ($memberFile):" >&2
			printf '%s\n' "$ownOpNames" | sed 's/^/  /' >&2
		else
			echo "$targetMember declares no operations of its own ($memberFile) -- floor + role-family common filter still apply below." >&2
		fi
		echo >&2

		local floorOpNames
		floorOpNames="$( ExtractOpNames "$floorFile" | sort -u )"

		local allNames
		allNames="$( { printf '%s\n' "$floorOpNames" ; printf '%s\n' "$ownOpNames" ; printf '%s\n' "${commonPrefixes[@]}" ; } | sort -u )"

		echo "# Tooling help output" >&2
		echo >&2

		## A name matching nothing in either help file is silently skipped,
		## not an error: an op named in a member's own tooling list or a
		## common-prefix filter that isn't yet help-documented is that op's
		## own pairing gap, not this filter's problem to raise. Every
		## closing `}` below is preceded by a `;` even on a single-statement
		## line (magic-developer's reference/shell.md axiom: some AWK
		## implementations reject the missing-semicolon form as a hard parse
		## error).

		## Short syntax lines (Help.DistroAgentsTools.include), one op per
		## real line there, deduped -- a name may legitimately match more
		## than one real line (an exact floor entry and a `--member-*`
		## common-prefix entry can both match the same op), so that line
		## must not print twice. Passed to AWK via ENVIRON, not `-v`: `-v`
		## chokes on a raw embedded newline ("newline in string"), ENVIRON
		## reads the process environment directly and doesn't have that
		## limitation.
		export MDAT_MEMBER_HELP_NAMES="$allNames"
		awk '
			BEGIN {
				count = split(ENVIRON["MDAT_MEMBER_HELP_NAMES"], arr, "\n");
				for (i = 1; i <= count; i++) { if (arr[i] != "") nameList[arr[i]] = 1; };
			}
			{
				msg = $0;
				sub(/^echo "/, "", msg);
				sub(/" >&2$/, "", msg);
				for (nm in nameList) {
					matched = 0;
					if (substr(nm, length(nm), 1) == "*") {
						prefix = substr(nm, 1, length(nm) - 1);
						if (index(msg, "DistroAgentsTools.fn.sh " prefix) > 0) { matched = 1; };
					} else {
						needle = "DistroAgentsTools.fn.sh " nm;
						pos = index(msg, needle);
						if (pos > 0) {
							after = substr(msg, pos + length(needle), 1);
							if (after == " " || after == "") { matched = 1; };
						};
					};
					if (matched) { break; };
				};
				if (matched && !(msg in seen)) { print msg; seen[msg] = 1; };
			}
		' "$helpInclude"

		echo >&2

		## Full multi-line manual entries (Help.DistroAgentsTools.help.md).
		## Op-header lines are two real tabs then `--op-name` -- everything
		## from there up to (not including) the next such header line, or a
		## bare `## ` heading (the file's own trailing Notes:/Examples:
		## appendix after the last op entry -- same termination pattern
		## ExtractOpNames already uses, otherwise the last matched entry
		## bleeds into that trailing content all the way to EOF), belongs to
		## that one entry, same block a human reading the raw file sees.
		## State machine: a new header line decides match/no-match for
		## `inBlock`; every other line just inherits whatever `inBlock` the
		## last header line set. `printed[]` dedupes the same reason as the
		## short-syntax pass above. Same ENVIRON passing as the short-syntax
		## pass above, same reason.
		awk '
			BEGIN {
				count = split(ENVIRON["MDAT_MEMBER_HELP_NAMES"], arr, "\n");
				for (i = 1; i <= count; i++) { if (arr[i] != "") nameList[arr[i]] = 1; };
			}
			/^## / { inBlock = 0; }
			/^\t\t--/ {
				tmp = $0;
				sub(/^\t\t/, "", tmp);
				split(tmp, parts, " ");
				opName = parts[1];
				inBlock = 0;
				for (nm in nameList) {
					if (substr(nm, length(nm), 1) == "*") {
						prefix = substr(nm, 1, length(nm) - 1);
						if (index(opName, prefix) == 1) { inBlock = 1; break; };
					} else if (opName == nm) { inBlock = 1; break; };
				};
				if (inBlock) {
					if (opName in printed) { inBlock = 0; } else { printed[opName] = 1; };
				};
			}
			inBlock { print; }
		' "$helpMd"

		return 0
	;;

	*)
		echo "⛔ ERROR: $MDSC_CMD: invalid option: $1 -- rejected by AgentsTools.MemberHelp.include's own default (*) branch, the operation group sourced by the --member-help arm inside AgentsTools.Member.include, which the --member-* dispatcher route reaches; no operation of that name is defined in this include" >&2
		set +e ; return 1
	;;
esac