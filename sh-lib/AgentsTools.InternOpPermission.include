#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.InternOpPermission.include -- refusal records and grants, per session.
##
## A permission refusal is a logged fact with an id, never a verdict. It is recorded
## in the session's own store before anything is posted, so an escalation can name
## it and a grant can take its tool and target from it rather than from the text of
## a request. The store is local runtime state and never a git tree:
## .local/agents/sessions/<session-id>/, beside the pending-reply store.
##

## A value is always natural. Storing it is a presentation like any other, so each
## format escapes only what that format itself needs, and reading it back
## materialises the natural value (AgentsHarnessRefusedTargetDecode, in
## AgentsUniversalHarness.sh, for the refusal record).
## The refusal record is a one-line-per-field front-matter file read by a person:
## it needs only %, newline, CR and edge whitespace escaped, so a colon or a comma
## stays as it is and a URL reads as a URL.
AgentsToolsPermissionEscapeRecord(){ ## value
	local escValue="$1" escLead="" escTail="" escChar
	escValue="${escValue//%/%25}"
	escValue="${escValue//$'\n'/%0A}"
	escValue="${escValue//$'\r'/%0D}"
	while : ; do
		escChar="${escValue%"${escValue#?}"}"
		case "$escChar" in
			' ') escLead="$escLead%20" ;;
			$'\t') escLead="$escLead%09" ;;
			*) break ;;
		esac
		escValue="${escValue#?}"
	done
	while : ; do
		escChar="${escValue#"${escValue%?}"}"
		case "$escChar" in
			' ') escTail="%20$escTail" ;;
			$'\t') escTail="%09$escTail" ;;
			*) break ;;
		esac
		escValue="${escValue%?}"
	done
	printf '%s' "$escLead$escValue$escTail"
}

## The grants file is a colon-delimited line with the target as one field, so that
## format also needs the comma and the colon escaped. Takes a value already in the
## record form, a stored record's target included, so it never double-escapes.
AgentsToolsPermissionRecordToGrantField(){ ## record-form value
	local grantField="$1"
	grantField="${grantField//,/%2C}"
	grantField="${grantField//:/%3A}"
	printf '%s' "$grantField"
}

## A natural value serialised for the grants file; what a grant match compares.
AgentsToolsPermissionEscape(){ ## value
	AgentsToolsPermissionRecordToGrantField "$( AgentsToolsPermissionEscapeRecord "$1" )"
}

## The session's own directory in the store, created on first use. Prints it.
AgentsToolsPermissionSessionDir(){ ## session id
	local sessionDir="$MMDAPP/.local/agents/sessions/$1"
	mkdir -p "$sessionDir" 2>/dev/null || return 1
	printf '%s' "$sessionDir"
}

## Where a refusal was made, as the lines its record and its post both carry: the short
## host name, and the workspace by its name -- never its path. One source, so the two
## never differ.
AgentsToolsPermissionRefusalWhere(){
	local whereHost whereWorkspace="${MMDAPP%/}"
	whereHost="$( hostname -s 2>/dev/null )" || whereHost=""
	whereWorkspace="${whereWorkspace##*/}"
	printf 'host: %s\n' "${whereHost:-unknown}"
	printf 'workspace: %s\n' "${whereWorkspace:-unknown}"
}

## One refusal's event-track post: the `refusal` tracking post, the same fields for every
## refusal, where it was made from the same source as its record.
AgentsToolsPermissionRefusalPost(){ ## owner, session dir, refusal id, session id, tool, target, reason
	local postWhere
	postWhere="$( AgentsToolsPermissionRefusalWhere )"
	AgentsToolsPermissionEventTrack "$1" "$2" --kind refusal --session-id "$4" --field what="Permission refused" --field refusal-id="$3" \
		--field host="$( printf '%s\n' "$postWhere" | LC_ALL=C sed -n 's/^host: //p' )" \
		--field workspace="$( printf '%s\n' "$postWhere" | LC_ALL=C sed -n 's/^workspace: //p' )" \
		--field tool="$5" --field target="$6" --field reason="${7:-none}"
}

## Posts one event-track entry for the session, through the tooling's own tracking post:
## into its thread when one is recorded, otherwise as a new top-level post whose thread is
## then recorded. Never fails its caller: a post that does not happen is one stderr warning.
AgentsToolsPermissionEventTrack(){ ## member, session dir, --intern-op-event-track-post arguments...
	local trackMember="$1" trackDir="$2" trackTarget="event-track" trackThread="" trackOut
	shift 2
	[ -n "$( DistroAgentsTools --agents-config-option magic-team --select SLACK_CHANNEL_EVENT_TRACK 2>/dev/null )" ] || {
		echo "⚠️ WARNING: $MDSC_CMD: no event-track channel is configured, so this refusal is recorded locally only" >&2
		return 0
	}
	## Opening the session's thread is a read, a post and a record: under the local lock,
	## two first refusals at once open one thread, and the second threads into it.
	. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.LocalLock.include"
	local trackLock=""
	if AgentsToolsLocalLockTake "event-track-${trackDir##*/}" 30 "the event-track thread of ${trackDir##*/}" ; then
		trackLock="$agentsLocalLockPath"
	else
		echo "⚠️ WARNING: $MDSC_CMD: the event-track thread lock could not be taken, so this post may open a second thread" >&2
	fi
	[ ! -s "$trackDir/event-track.thread" ] || IFS= read -r trackThread < "$trackDir/event-track.thread" || :
	[ -z "$trackThread" ] || trackTarget="$trackThread"
	trackOut="$MMDAPP/.local/temp/mdat-permission-track.$$"
	mkdir -p "$MMDAPP/.local/temp" || { AgentsToolsLocalLockGive "$trackLock" ; return 0 ; }
	DistroAgentsTools --intern-op-event-track-post "$trackMember" "$trackTarget" "$@" > /dev/null 2> "$trackOut" || {
		echo "⚠️ WARNING: $MDSC_CMD: the refusal is recorded locally but was NOT posted to event-track: $( LC_ALL=C grep -m1 '⛔' "$trackOut" 2>/dev/null )" >&2
		rm -f "$trackOut"
		AgentsToolsLocalLockGive "$trackLock"
		return 0
	}
	if [ -z "$trackThread" ] ; then
		LC_ALL=C awk -F= '
			$1 == "SENT_MESSAGE_CHANNEL" { sentChannel = $2 ; }
			$1 == "SENT_MESSAGE_TS" { sentTs = $2 ; }
			END { if ( sentChannel != "" && sentTs != "" ) { print sentChannel ":" sentTs ; } }
		' "$trackOut" > "$trackDir/event-track.thread" 2>/dev/null || :
	fi
	rm -f "$trackOut"
	AgentsToolsLocalLockGive "$trackLock"
	return 0
}

## One ignored planned allow, said once per session: a marker keyed by the entry's cksum
## stops the same entry being posted on every call it could not admit. Advisory: a post
## that does not happen never changes a verdict.
AgentsToolsPermissionPlannedIgnored(){ ## member, session id, dispatch item, entry, reason
	local ignoredDir ignoredKey
	ignoredDir="$( AgentsToolsPermissionSessionDir "$2" )" || return 0
	ignoredKey="$( printf '%s' "$4" | LC_ALL=C cksum | LC_ALL=C tr ' ' '-' )" || return 0
	mkdir "$ignoredDir/planned-ignored-$ignoredKey" 2>/dev/null || return 0
	AgentsToolsPermissionEventTrack "$1" "$ignoredDir" --kind refusal --session-id "$2" --field what="Planned allow ignored" \
		--field dispatch="$3" --field entry="$4" --field reason="$5"
	return 0
}

## A path resolved exactly as the harness gate resolves it (AgentsHarnessPathAllowed in
## AgentsUniversalHarness.sh), so a refusal or grant keyed here matches one keyed there:
## the parent through pwd -P, then a symlink leaf that ends at an existing file followed
## to that file. Prints the path as given where it does not resolve.
AgentsToolsPermissionResolvePath(){ ## path
	local resolvePath="$1" resolveReal resolveHops=0 resolveLink resolveDir
	case "$resolvePath" in
		/*) ;;
		*) printf '%s' "$resolvePath" ; return 0 ;;
	esac
	if [ -d "$resolvePath" ] ; then
		resolveReal="$( cd "$resolvePath" 2>/dev/null && pwd -P )" || resolveReal=""
	else
		resolveDir="${resolvePath%/*}"
		[ -n "$resolveDir" ] || resolveDir="/"
		resolveReal="$( cd "$resolveDir" 2>/dev/null && pwd -P )" || resolveReal=""
		if [ -n "$resolveReal" ] ; then
			case "$resolveReal" in
				*/) resolveReal="$resolveReal${resolvePath##*/}" ;;
				*)  resolveReal="$resolveReal/${resolvePath##*/}" ;;
			esac
		fi
	fi
	[ -n "$resolveReal" ] || { printf '%s' "$resolvePath" ; return 0 ; }
	while [ -L "$resolveReal" ] && [ -e "$resolveReal" ] ; do
		resolveHops=$(( resolveHops + 1 ))
		[ "$resolveHops" -le 40 ] || break
		resolveLink="$( readlink "$resolveReal" 2>/dev/null )" || break
		[ -n "$resolveLink" ] || break
		case "$resolveLink" in
			/*) ;;
			*) resolveLink="${resolveReal%/*}/$resolveLink" ;;
		esac
		resolveDir="${resolveLink%/*}"
		[ -n "$resolveDir" ] || resolveDir="/"
		resolveDir="$( cd "$resolveDir" 2>/dev/null && pwd -P )" || break
		case "$resolveDir" in
			*/) resolveReal="$resolveDir${resolveLink##*/}" ;;
			*)  resolveReal="$resolveDir/${resolveLink##*/}" ;;
		esac
	done
	printf '%s' "$resolveReal"
}

## One PermissionRequest decision, as Claude Code reads it from a hook's stdout.
AgentsToolsPermissionHookDecision(){ ## allow|deny, message (deny only)
	if [ "$1" = "allow" ] ; then
		printf '{"hookSpecificOutput":{"hookEventName":"PermissionRequest","decision":{"behavior":"allow"}}}\n'
		return 0
	fi
	printf '{"hookSpecificOutput":{"hookEventName":"PermissionRequest","decision":{"behavior":"deny","message":"%s"}}}\n' \
		"$( printf '%s' "$2" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsMcpJsonEscape.awk" )"
}

## What a member holds, by layer: the one computation every approve path, pass-on and
## set split asks (AgentsTools.PermissionHolds.include).
. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.PermissionHolds.include"
## The grants index and the session permission indices built from it (AgentsTools.Grants.include):
## a grant opened, used up or revoked here touches its store, so they are rebuilt.
. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.Grants.include"

## A permission entry `<tool>:<target>` split into permEntryTool and permEntryTarget; the
## tool a bare name, the target natural. rc 1, saying why, for an entry of no tool.
AgentsToolsPermissionEntrySplit(){ ## entry, context
	permEntryTool="${1%%:*}" ; permEntryTarget=""
	case "$1" in
		*:*) permEntryTarget="${1#*:}" ;;
	esac
	AgentsToolsAssertBareName "$permEntryTool" "entry tool" "$2" || return 1
	return 0
}

## A new reference id with a prefix (pass-, set-), or rc 1.
AgentsToolsPermissionNewRef(){ ## prefix
	local refUuid
	refUuid="$( uuidgen 2>/dev/null | LC_ALL=C tr 'ABCDEF' 'abcdef' )" || refUuid=""
	[ -n "$refUuid" ] || return 1
	printf '%s%s' "$1" "$refUuid"
}

## The registered place a natural target lies in, as name:relative (--intern-directory-of), a
## <path>/** pattern keeping its /**. Nothing for a target that is no absolute path, or lies in
## no place. A hint only: a grant is matched by its path.
AgentsToolsPermissionPlaceHint(){ ## natural target
	local hintBase="$1" hintTail="" hintOf
	case "$hintBase" in /*) ;; *) return 0 ;; esac
	case "$hintBase" in *$'\n'*|*$'\t'*) return 0 ;; esac
	case "$hintBase" in */'**') hintBase="${hintBase%/\*\*}" ; hintTail="/**" ;; esac
	hintOf="$( DistroAgentsTools --intern-directory-of "$hintBase" 2> /dev/null )" || return 0
	[ -n "$hintOf" ] || return 0
	case "$hintOf:$hintTail" in *':.:/**') hintOf="${hintOf%.}" ; hintTail="**" ;; esac
	printf '%s%s' "$hintOf" "$hintTail"
}

## A write tool asked for in a read-only place is refused before anything is asked or granted,
## naming the route to take instead: the session sandbox output/ when the session has one,
## else another suitable location. rc 1 refused, said on stderr; 0 otherwise.
AgentsToolsPermissionCeilingRefuse(){ ## tool, natural target, session id, entry as asked
	local ceilBase="$2" ceilPlace ceilRecord ceilRoute="find another suitable location"
	case " Edit Write Execute " in *" $1 "*) ;; *) return 0 ;; esac
	case "$ceilBase" in /*) ;; *) return 0 ;; esac
	case "$ceilBase" in */'**') ceilBase="${ceilBase%/\*\*}" ;; esac
	ceilBase="$( AgentsToolsPermissionResolvePath "$ceilBase" )"
	ceilPlace="$( AgentsToolsGrantsCeilingPlace "${MMDAPP%/}" "$ceilBase" )" || return 0
	case "$3" in
		''|*/*|.|..) ;;
		*)
			for ceilRecord in "${MMDAPP%/}/.local/agents/spawned"/*/"$3.md" ; do
				[ -f "$ceilRecord" ] || continue
				ceilRoute="write to the session sandbox output/ instead, or a folder under it: ${ceilRecord%/*}/output/"
				break
			done
		;;
	esac
	echo "$MDSC_CMD: ⛔ ERROR: $ceilPlace is a read-only place, so no write is granted there: $4 -- $ceilRoute" >&2
	return 1
}

## One permission entry made ready to ask for: split into permEntryTool and permEntryTarget, an
## @<name>[:<glob>] target resolved through --intern-directory-resolve to a path under that
## place (the glob a path, ** or <path>/**, relative, never with a .. segment), and
## permEntryPlace its place as name:relative, a hint, or empty. A write in a read-only place is
## refused. rc 1, said on stderr.
AgentsToolsPermissionEntryPlace(){ ## entry, session id
	local placeName placeGlob placePath
	permEntryPlace=""
	AgentsToolsPermissionEntrySplit "$1" permission-set-request || return 1
	case "$permEntryTarget" in
		@*)
			placeName="${permEntryTarget#@}" ; placeGlob=""
			case "$placeName" in *:*) placeGlob="${placeName#*:}" ; placeName="${placeName%%:*}" ;; esac
			case "/$placeGlob/" in
				*/../*) echo "$MDSC_CMD: ⛔ ERROR: an entry glob has a .. segment: $1" >&2 ; return 1 ;;
			esac
			case "$placeGlob" in
				/*) echo "$MDSC_CMD: ⛔ ERROR: an entry glob is relative to its place, never absolute: $1" >&2 ; return 1 ;;
			esac
			case "${placeGlob%/\*\*}" in
				'**'|'') ;;
				*'*'*|*'?'*|*'['*) echo "$MDSC_CMD: ⛔ ERROR: an entry glob is a path, ** or <path>/** under its place, no other pattern: $1" >&2 ; return 1 ;;
			esac
			placePath="$( DistroAgentsTools --intern-directory-resolve "$placeName" )" || {
				echo "$MDSC_CMD: ⛔ ERROR: the entry names no place this workspace can resolve, so nothing is asked: $1" >&2
				return 1
			}
			placePath="$( AgentsToolsPermissionResolvePath "$placePath" )"
			case "$placeGlob" in
				''|'**') permEntryTarget="${placePath%/}/**" ; permEntryPlace="$placeName:**" ;;
				*) permEntryTarget="${placePath%/}/$placeGlob" ; permEntryPlace="$placeName:$placeGlob" ;;
			esac
		;;
		*) permEntryPlace="$( AgentsToolsPermissionPlaceHint "$permEntryTarget" )" ;;
	esac
	AgentsToolsPermissionCeilingRefuse "$permEntryTool" "$permEntryTarget" "$2" "$1" || return 1
	return 0
}

## One ask of the permission-escalation input scan, as `## permission ask <id>` and one
## `<field>: <value>` line each: where and when it was asked, by whom, the refused call (its
## target natural and as its place's name:relative), why and for which task, who holds it (the
## scan's caller first when it does, then the participants, the human-owner last), and the open
## permission-set asks of the same item or session. Read against the ask's own workspace.
AgentsToolsPermissionEscalationAsk(){ ## caller, workspace root, pending id, asked-at
	local eaBy="$1" eaRoot="${2%/}" eaId="$3" eaAt="$4" eaFile eaLine eaOwner="" eaSession="" eaRefusal="" eaItem="" eaTaskRef="" eaReason=""
	local eaRecord="" eaTool="" eaTarget="" eaPlace="" eaHolders="" eaSets="" eaSetFile eaSetItem eaSetSession eaSetEntries
	eaFile="$eaRoot/.local/agents/pending/$eaId.md"
	[ -f "$eaFile" ] || return 0
	while IFS= read -r eaLine ; do
		case "$eaLine" in
			'owner: '*) eaOwner="${eaLine#owner: }" ;;
			'session-id: '*) eaSession="${eaLine#session-id: }" ;;
			'refusal-id: '*) eaRefusal="${eaLine#refusal-id: }" ;;
			'item: '*) eaItem="${eaLine#item: }" ;;
			'task-ref: '*) eaTaskRef="${eaLine#task-ref: }" ;;
			'reason: '*) eaReason="${eaLine#reason: }" ;;
			'# '*) break ;;
		esac
	done < "$eaFile"
	case "$eaSession:$eaRefusal" in
		*/*|*:|:*) ;;
		*) eaRecord="$eaRoot/.local/agents/sessions/$eaSession/$eaRefusal.md" ;;
	esac
	if [ -n "$eaRecord" ] && [ -f "$eaRecord" ] ; then
		eaTool="$( AgentsToolsPermissionField "$eaRecord" tool )"
		eaTarget="$( AgentsToolsPermissionRecordDecode "$( AgentsToolsPermissionField "$eaRecord" target )" )"
		eaPlace="$( AgentsToolsPermissionPlaceHint "$eaTarget" )"
		## Holds and holders in the ask's own workspace: its session stores and its grants index.
		eaHolders="$( MMDAPP="$eaRoot"
			eaLine="$( AgentsToolsPermissionHolds "$eaBy" "$eaTool" "$eaTarget" "$eaSession" 2> /dev/null )" && printf '%s %s\n' "$eaBy" "${eaLine%% *}"
			AgentsToolsPermissionHolders "$eaTool" "$eaTarget" "$eaSession" "$eaItem" "$eaBy $eaOwner" 2> /dev/null
		)"
		eaHolders="$( printf '%s\n' "$eaHolders" | LC_ALL=C awk 'NF { printf "%s%s", ( n++ ? ", " : "" ), $0 ; }' )"
	fi
	for eaSetFile in "$eaRoot/.local/agents/pending"/*.set ; do
		[ -f "$eaSetFile" ] && [ -f "${eaSetFile%.set}.md" ] || continue
		[ "$( AgentsToolsPermissionField "${eaSetFile%.set}.md" status )" = "reply-pending" ] || continue
		eaSetItem="" ; eaSetSession="" ; eaSetEntries=""
		while IFS= read -r eaLine ; do
			case "$eaLine" in
				'item: '*) eaSetItem="${eaLine#item: }" ;;
				'session-id: '*) eaSetSession="${eaLine#session-id: }" ;;
				'entry: '*) eaSetEntries="${eaSetEntries:+$eaSetEntries, }${eaLine#entry: }" ;;
			esac
		done < "$eaSetFile"
		{ [ -n "$eaItem" ] && [ "$eaSetItem" = "$eaItem" ] ; } || { [ -n "$eaSession" ] && [ "$eaSetSession" = "$eaSession" ] ; } || continue
		eaSetFile="${eaSetFile##*/}"
		eaSets="${eaSets:+$eaSets; }${eaSetFile%.set} ($eaSetEntries)"
	done
	printf '\n## permission ask %s\n\n' "$eaId"
	printf 'workspace: %s\n' "$eaRoot"
	printf 'asked-at: %s\n' "${eaAt:-unknown}"
	printf 'member: %s\n' "${eaOwner:-unknown}"
	printf 'session: %s\n' "${eaSession:-none}"
	printf 'refusal: %s\n' "${eaRefusal:-none}"
	if [ -n "$eaTool" ] ; then
		printf 'tool: %s\n' "$eaTool"
		printf 'target: %s\n' "$eaTarget"
		printf 'place: %s\n' "${eaPlace:--}"
	else
		printf 'tool: unknown -- the refusal record is not in this workspace\n'
	fi
	printf 'reason: %s\n' "${eaReason:-none given}"
	printf 'task-ref: %s\n' "${eaTaskRef:-none given}"
	printf 'item: %s\n' "${eaItem:-none}"
	printf 'holders: %s\n' "${eaHolders:-unknown}"
	printf 'set-requests: %s\n' "${eaSets:-none}"
}

case "$1" in

	--intern-op-permission-hook)
		shift
		MDSC_CMD="$MDSC_CMD --intern-op-permission-hook"
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsContext.UseAgentsTools.include"
		## A native client's PermissionRequest, decided for an unattended session the way
		## the harness gate decides its own calls: a grant for this session, tool and
		## target admits; anything else is a recorded refusal, denied with its id and the
		## way to ask. It always prints a decision, because none is a deny with no reason.
		local hookMember="$1" hookInput hookSession hookTool hookTarget hookGrant hookId
		hookInput="$( cat )"
		hookSession="$( printf '%s\n' "$hookInput" | LC_ALL=C awk -v path=session_id -v optional=1 -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsHarnessJsonField.awk" 2>/dev/null )" || hookSession=""
		hookTool="$( printf '%s\n' "$hookInput" | LC_ALL=C awk -v path=tool_name -v optional=1 -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsHarnessJsonField.awk" 2>/dev/null )" || hookTool=""
		## The session a spawn was given wins: it is the id every grant and refusal of this run is keyed by.
		[ -z "${MDAT_SPAWN_SESSION_ID:-}" ] || hookSession="$MDAT_SPAWN_SESSION_ID"
		## A file tool's path, a command's exact text, or the whole input as sent.
		hookTarget="$( printf '%s\n' "$hookInput" | LC_ALL=C awk -v path=tool_input.file_path -v optional=1 -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsHarnessJsonField.awk" 2>/dev/null ; printf 'x' )"
		hookTarget="${hookTarget%x}" ; hookTarget="${hookTarget%$'\n'}"
		if [ -n "$hookTarget" ] ; then
			hookTarget="$( AgentsToolsPermissionResolvePath "$hookTarget" )"
		else
			hookTarget="$( printf '%s\n' "$hookInput" | LC_ALL=C awk -v path=tool_input.command -v optional=1 -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsHarnessJsonField.awk" 2>/dev/null ; printf 'x' )"
			hookTarget="${hookTarget%x}" ; hookTarget="${hookTarget%$'\n'}"
		fi
		[ -n "$hookTarget" ] || hookTarget="$( printf '%s\n' "$hookInput" | LC_ALL=C awk -v path=tool_input -v mode=raw -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsHarnessJsonField.awk" 2>/dev/null )" || hookTarget=""
		if [ -z "$hookMember" ] || [ -z "$hookSession" ] || [ -z "$hookTool" ] || [ -z "$hookTarget" ] ; then
			AgentsToolsPermissionHookDecision deny "Refused, and not recorded: the member, session, tool or target of this call could not be read, so it cannot be escalated by id."
			return 0
		fi
		hookGrant="$( DistroAgentsTools --intern-op-permission-grant-read "$hookMember" --session-id "$hookSession" --tool "$hookTool" --target "$hookTarget" 2>/dev/null )" || hookGrant=""
		hookGrant="$( printf '%s\n' "$hookGrant" | LC_ALL=C sed -n 's/^GRANT: //p' | head -1 )"
		case "$hookGrant" in
			'session '*|'task '*|'planned '*|'standing '*)
				AgentsToolsPermissionHookDecision allow
				return 0
			;;
			'once '*)
				if DistroAgentsTools --intern-op-permission-grant-consume --session-id "$hookSession" --refusal-id "${hookGrant#once }" > /dev/null 2>&1 ; then
					AgentsToolsPermissionHookDecision allow
					return 0
				fi
			;;
		esac
		hookId="$( DistroAgentsTools --intern-op-permission-refusal-log "$hookMember" --session-id "$hookSession" --tool "$hookTool" \
			--target "$hookTarget" --reason "a native $hookTool call this unattended session holds no grant for" 2>/dev/null \
			| LC_ALL=C sed -n 's/^\(refusal-[0-9a-f-]*\)$/\1/p' | head -1 )"
		if [ -z "$hookId" ] ; then
			AgentsToolsPermissionHookDecision deny "Refused. REFUSAL-ID: none -- recording the refusal failed, so it cannot be escalated by id."
			return 0
		fi
		AgentsToolsPermissionHookDecision deny "Refused. REFUSAL-ID: $hookId. This is a refusal, not a verdict. If this task needs the call, ask for it with AskUserQuestion kind=permission, refusal_id=$hookId, a reason and a task_ref, addressed to the coordinator in this session. Carry on with work that does not need it. A granted call is retried exactly as it was made."
		return 0
	;;

	--intern-op-permission-refusal-log)
		shift
		MDSC_CMD="$MDSC_CMD --intern-op-permission-refusal-log"
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsContext.UseAgentsTools.include"
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.CommsSlack.include"
		local refusalOwner="$1"
		shift || true
		local refusalSession="" refusalTool="" refusalTarget="" refusalReason=""
		while [ $# -gt 0 ] ; do
			case "$1" in
				--session-id) refusalSession="${2:-}" ; shift 2 ;;
				--tool) refusalTool="${2:-}" ; shift 2 ;;
				--target) refusalTarget="${2:-}" ; shift 2 ;;
				--reason) refusalReason="${2:-}" ; shift 2 ;;
				*)
					echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		## A call refused before it named a target (a path argument missing, or passed under a name
		## the tool does not take) is still a refusal, and still gets an id to escalate by.
		[ -n "$refusalTarget" ] || refusalTarget="(no target given)"
		if [ -z "$refusalOwner" ] || [ -z "$refusalSession" ] || [ -z "$refusalTool" ] ; then
			echo "$MDSC_CMD: ⛔ ERROR: syntax is <team-member> --session-id <id> --tool <tool> --target <target> [--reason <text>]" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$refusalOwner" "<team-member>" permission-refusal-log || { set +e ; return 1 ; }
		AgentsToolsAssertBareName "$refusalSession" "--session-id" permission-refusal-log || { set +e ; return 1 ; }
		AgentsToolsAssertBareName "$refusalTool" "--tool" permission-refusal-log || { set +e ; return 1 ; }
		local refusalId refusalDir
		refusalId="$( uuidgen 2>/dev/null | LC_ALL=C tr 'ABCDEF' 'abcdef' )"
		if [ -z "$refusalId" ] ; then
			echo "$MDSC_CMD: ⛔ ERROR: no id could be generated, so no refusal was recorded" >&2
			set +e ; return 1
		fi
		refusalId="refusal-$refusalId"
		refusalDir="$( AgentsToolsPermissionSessionDir "$refusalSession" )" || {
			echo "$MDSC_CMD: ⛔ ERROR: can't create the session store for $refusalSession, so no refusal was recorded" >&2
			set +e ; return 1
		}
		{
			printf '%s\n' "---"
			printf 'status: %s\n' "refused"
			printf 'owner: %s\n' "$refusalOwner"
			AgentsToolsPermissionRefusalWhere
			printf 'session-id: %s\n' "$refusalSession"
			printf 'tool: %s\n' "$refusalTool"
			printf 'target: %s\n' "$( AgentsToolsPermissionEscapeRecord "$refusalTarget" )"
			printf 'refused-at: %s\n' "$( date +"%Y-%m-%d %H:%M %z" )"
			printf '%s\n' "---"
			printf '\n# Refused\n\n%s\n' "${refusalReason:-no reason given}"
		} > "$refusalDir/$refusalId.md" || {
			rm -f "$refusalDir/$refusalId.md"
			echo "$MDSC_CMD: ⛔ ERROR: can't write the refusal record, so no refusal id exists" >&2
			set +e ; return 1
		}
		## The id on stdout before the post, because the record already stands without it.
		printf '%s\n' "$refusalId"
		AgentsToolsPermissionRefusalPost "$refusalOwner" "$refusalDir" "$refusalId" \
			"$refusalSession" "$refusalTool" "$refusalTarget" "$refusalReason"
		return 0
	;;

	--intern-op-permission-grant-open)
		shift
		MDSC_CMD="$MDSC_CMD --intern-op-permission-grant-open"
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsContext.UseAgentsTools.include"
		local grantBy="$1"
		shift || true
		local grantSession="" grantRefusal="" grantKind="" grantTask=""
		while [ $# -gt 0 ] ; do
			case "$1" in
				--session-id) grantSession="${2:-}" ; shift 2 ;;
				--refusal-id) grantRefusal="${2:-}" ; shift 2 ;;
				--kind) grantKind="${2:-}" ; shift 2 ;;
				--task) grantTask="${2:-}" ; shift 2 ;;
				*)
					echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$grantBy" ] || [ -z "$grantSession" ] || [ -z "$grantRefusal" ] || [ -z "$grantKind" ] ; then
			echo "$MDSC_CMD: ⛔ ERROR: syntax is <granting-member> --session-id <id> --refusal-id <id> --kind once|session|task [--task <item>]" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$grantBy" "<granting-member>" permission-grant-open || { set +e ; return 1 ; }
		AgentsToolsAssertBareName "$grantSession" "--session-id" permission-grant-open || { set +e ; return 1 ; }
		AgentsToolsAssertBareName "$grantRefusal" "--refusal-id" permission-grant-open || { set +e ; return 1 ; }
		case "$grantKind" in
			once|session) ;;
			task)
				## A task grant lives while its item is open, so it names one that is.
				grantTask="${grantTask##*/}" ; grantTask="${grantTask%.md}"
				if [ -z "$grantTask" ] || ! AgentsToolsAssertBareName "$grantTask" "--task" permission-grant-open || ! AgentsToolsPermissionItemOpen "$grantTask" ; then
					echo "$MDSC_CMD: ⛔ ERROR: a task grant needs --task <item> naming an open board item, got: ${grantTask:-none}" >&2
					set +e ; return 1
				fi
			;;
			*)
				echo "$MDSC_CMD: ⛔ ERROR: --kind must be once|session|task: $grantKind" >&2
				set +e ; return 1
			;;
		esac
		local grantDir="$MMDAPP/.local/agents/sessions/$grantSession"
		local grantRecord="$grantDir/$grantRefusal.md"
		if [ ! -f "$grantRecord" ] ; then
			echo "$MDSC_CMD: ⛔ ERROR: no refusal $grantRefusal is recorded for session $grantSession, so nothing is granted" >&2
			set +e ; return 1
		fi
		## Tool and target come from the record, never from the request that asked.
		local grantOwner="" grantTool="" grantTarget="" grantLine
		while IFS= read -r grantLine ; do
			case "$grantLine" in
				'owner: '*) grantOwner="${grantLine#owner: }" ;;
				'tool: '*) grantTool="${grantLine#tool: }" ;;
				'target: '*) grantTarget="${grantLine#target: }" ;;
				'# '*) break ;;
			esac
		done < "$grantRecord"
		if [ -z "$grantOwner" ] || [ -z "$grantTool" ] || [ -z "$grantTarget" ] ; then
			echo "$MDSC_CMD: ⛔ ERROR: the refusal record $grantRecord lacks its owner, tool or target, so nothing is granted" >&2
			set +e ; return 1
		fi
		if [ "$grantBy" = "$grantOwner" ] ; then
			echo "$MDSC_CMD: ⛔ ERROR: $grantBy asked for this call and cannot grant it to itself, so nothing is granted" >&2
			set +e ; return 1
		fi
		## No approving what you do not hold: the approver holds this tool and target, or is
		## the human-owner. Refused with rc 3 and the holders up the chain, for the caller to
		## re-address the request to.
		local grantNatural grantHeld grantHolders grantPlace
		grantNatural="$( AgentsToolsPermissionRecordDecode "$grantTarget" )"
		## No write is granted in a read-only place, by anyone: refused first, with the route.
		AgentsToolsPermissionCeilingRefuse "$grantTool" "$grantNatural" "$grantSession" "$grantTool:$grantNatural" || { set +e ; return 1 ; }
		if ! grantHeld="$( AgentsToolsPermissionHolds "$grantBy" "$grantTool" "$grantNatural" "$grantSession" )" ; then
			grantHolders="$( AgentsToolsPermissionHolders "$grantTool" "$grantNatural" "$grantSession" "$grantTask" "$grantOwner $grantBy" | LC_ALL=C awk '{ printf "%s%s", ( NR > 1 ? " " : "" ), $1 ; }' )" || grantHolders="human-owner"
			printf 'NOT-HOLDS: %s %s %s\n' "$grantBy" "$grantTool" "$grantNatural"
			printf 'HOLDERS: %s\n' "$grantHolders"
			echo "$MDSC_CMD: ⛔ ERROR: $grantBy does not hold $grantTool $grantNatural, so it cannot grant it; nothing is granted -- the request goes up to: $grantHolders" >&2
			set +e ; return 3
		fi
		## The record's target is in record form and the grants line is colon-delimited, so it
		## becomes a grants field here.
		grantTarget="$( AgentsToolsPermissionRecordToGrantField "$grantTarget" )"
		## A task grant's item beside its refusal record, which stays as it was written.
		if [ "$grantKind" = "task" ] ; then
			printf '%s\n' "$grantTask" > "$grantDir/$grantRefusal.task" || {
				echo "$MDSC_CMD: ⛔ ERROR: can't record the task of the grant for $grantRefusal, so nothing is granted" >&2
				set +e ; return 1
			}
		fi
		## The place its path lies in, as name:relative, recorded beside it as a hint.
		grantPlace="$( AgentsToolsPermissionPlaceHint "$grantNatural" )"
		if [ -n "$grantPlace" ] ; then
			printf '%s\t%s\n' "$grantNatural" "$grantPlace" > "$grantDir/$grantRefusal.places" \
				|| echo "⚠️ WARNING: $MDSC_CMD: the place of the grant for $grantRefusal was not recorded: $grantPlace" >&2
			printf 'PLACE: %s\n' "$grantPlace"
		fi
		## Stamped to the second: an Allow once lapses unused a TTL after it (AgentsToolsPermissionOnceLive).
		printf '%s:%s:%s:%s:%s:%s\n' "$grantKind" "$grantTool" "$grantTarget" "$grantBy" "$( date -u +%Y%m%dT%H%M%SZ )" "$grantRefusal" >> "$grantDir/grants" || {
			echo "$MDSC_CMD: ⛔ ERROR: can't write the grant for $grantRefusal, so nothing is granted" >&2
			set +e ; return 1
		}
		printf 'GRANT: %s %s\n' "$grantKind" "$grantRefusal"
		return 0
	;;

	--intern-op-permission-grant-read)
		shift
		MDSC_CMD="$MDSC_CMD --intern-op-permission-grant-read"
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsContext.UseAgentsTools.include"
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.CommsSlack.include"
		local readMember="$1"
		shift || true
		local readSession="" readTool="" readTarget=""
		while [ $# -gt 0 ] ; do
			case "$1" in
				--session-id) readSession="${2:-}" ; shift 2 ;;
				--tool) readTool="${2:-}" ; shift 2 ;;
				--target) readTarget="${2:-}" ; shift 2 ;;
				*)
					echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$readMember" ] || [ -z "$readSession" ] || [ -z "$readTool" ] || [ -z "$readTarget" ] ; then
			echo "$MDSC_CMD: ⛔ ERROR: syntax is <team-member> --session-id <id> --tool <tool> --target <target>" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$readSession" "--session-id" permission-grant-read || { set +e ; return 1 ; }
		local readDir="$MMDAPP/.local/agents/sessions/$readSession"
		local readWant readEntry readKind readRest readEntryTool readEntryTarget readBy readFound readCow
		readWant="$( AgentsToolsPermissionEscape "$readTarget" )"
		## What the member holds by the floor or standing -- a tool row such as WebFetch for
		## a member that holds it -- admits with no grant at all: every spawn has its (a) and (b).
		## So does the routine the session runs, for this session: `standing routine <name>`.
		if readFound="$( AgentsToolsPermissionHolds "$readMember" "$readTool" "$readTarget" "$readSession" )" ; then
			case "$readFound" in
				floor|standing|'routine '*)
					printf 'GRANT: standing %s\n' "$readFound"
					return 0
				;;
			esac
		fi
		## Granted, passed and set grants (AgentsToolsPermissionGrantScan): this session's own
		## store, then the store of the coworking session it joined. Each is the member's own,
		## signed by someone else; a once is used up in this session's own store.
		while IFS= read -r readCow ; do
			[ -n "$readCow" ] || continue
			readFound="$( AgentsToolsPermissionGrantScan "$MMDAPP/.local/agents/sessions/$readCow" "$readMember" "$readTool" "$readTarget" use "$readDir" )" || continue
			printf 'GRANT: %s\n' "$readFound"
			return 0
		done <<< "$( AgentsToolsPermissionRelatedStores "$readSession" )"
		## Planned allows -- the approved permission set a dispatch carries: the session's
		## dispatch item and the one item it tracks. The same self-grant rule applies; a
		## session entry is session-wide, a task entry lives while the item carrying it is open.
		[ -n "${MDAT_DATA_ROOT:-}" ] && [ -d "$MDAT_DATA_ROOT/board" ] || { set +e ; return 1 ; }
		local readItem readDispatch="" readTracks="" readPlanned="" readLine readState readItemSession readItemSpawn readItemOwner readItemAllows readItemTracks
		for readItem in "$MDAT_DATA_ROOT"/board/*/dispatch-*.md ; do
			[ -f "$readItem" ] || continue
			readItemSession="" ; readItemSpawn="" ; readItemOwner="" ; readItemAllows="" ; readItemTracks="" ; readState=""
			while IFS= read -r readLine ; do
				case "$readState:$readLine" in
					':---') readState=front ;;
					front:---) break ;;
					'front:session-id: '*) readItemSession="${readLine#session-id: }" ;;
					'front:spawn-id: '*) readItemSpawn="${readLine#spawn-id: }" ;;
					'front:owner: '*) readItemOwner="${readLine#owner: }" ;;
					'front:allows: '*) readItemAllows="${readLine#allows: }" ;;
					'front:tracks: '*) readItemTracks="${readLine#tracks: }" ;;
					:*) break ;;
				esac
			done < "$readItem"
			## A spawn that joined a coworking session is found by its own spawn id.
			[ "$readItemSession" = "$readSession" ] || [ "$readItemSpawn" = "$readSession" ] || continue
			[ "$readItemOwner" = "$readMember" ] || continue
			readDispatch="$readItem" ; readTracks="$readItemTracks"
			[ -z "$readItemAllows" ] || readPlanned="${readItem##*/}"$'\t'"$readItemAllows"
			break
		done
		[ -n "$readDispatch" ] || { set +e ; return 1 ; }
		## The tracked item's own allows, found by its bare name in whichever state holds it.
		if [ -n "$readTracks" ] && AgentsToolsAssertBareName "$readTracks" "tracks" permission-grant-read 2>/dev/null ; then
			for readItem in "$MDAT_DATA_ROOT"/board/*/"$readTracks" "$MDAT_DATA_ROOT"/board/*/"$readTracks.md" ; do
				[ -f "$readItem" ] || continue
				readState=""
				while IFS= read -r readLine ; do
					case "$readState:$readLine" in
						':---') readState=front ;;
						front:---) break ;;
						'front:allows: '*) readPlanned="${readPlanned:+$readPlanned$'\n'}${readItem##*/}"$'\t'"${readLine#allows: }" ;;
						:*) break ;;
					esac
				done < "$readItem"
				break
			done
		fi
		## Comma-separated entries; a target is escaped, so it never holds a comma. An entry
		## that can never admit anything is said once per session in its event-track thread,
		## so a planned allow that was written wrong does not fail silently. One signed by a
		## member who does not hold it is ignored the same way: no approving what you don't hold.
		local readIgnored readShape readCarrier readList readNatural
		while IFS=$'\t' read -r readCarrier readList ; do
			[ -n "$readCarrier" ] || continue
			while [ -n "$readList" ] ; do
				readEntry="${readList%%,*}"
				if [ "$readEntry" != "$readList" ] ; then readList="${readList#*,}" ; else readList="" ; fi
				readEntry="${readEntry# }"
				[ -n "$readEntry" ] || continue
				readKind="${readEntry%%:*}" ; readRest="${readEntry#*:}"
				readEntryTool="${readRest%%:*}" ; readRest="${readRest#*:}"
				readEntryTarget="${readRest%%:*}" ; readRest="${readRest#*:}"
				readBy="${readRest%%:*}"
				readShape="${readEntry//[!:]/}"
				readIgnored=""
				if [ "${#readShape}" -lt 4 ] || [ -z "$readEntryTool" ] || [ -z "$readEntryTarget" ] ; then
					readIgnored="it is not <kind>:<tool>:<target>:<granted-by>:<time>"
				elif [ "$readKind" != "session" ] && [ "$readKind" != "task" ] ; then
					readIgnored="its kind is $readKind, and a planned allow is session-wide or task-wide"
				elif [ -z "$readBy" ] ; then
					readIgnored="it names nobody who granted it"
				elif [ "$readBy" = "$readMember" ] ; then
					readIgnored="it is signed by the session's own member"
				fi
				if [ -n "$readIgnored" ] ; then
					AgentsToolsPermissionPlannedIgnored "$readMember" "$readSession" "${readDispatch##*/}" "$readEntry" "$readIgnored"
					continue
				fi
				[ "$readEntryTool" = "$readTool" ] || continue
				readNatural="$( AgentsToolsPermissionUnescape "$readEntryTarget" )"
				[ "$readEntryTarget" = "$readWant" ] || AgentsToolsPermissionCovers "$readNatural" "$readTarget" || continue
				[ "$readKind" != "task" ] || AgentsToolsPermissionItemOpen "$readCarrier" || continue
				if ! AgentsToolsPermissionHolds "$readBy" "$readEntryTool" "$readNatural" > /dev/null ; then
					AgentsToolsPermissionPlannedIgnored "$readMember" "$readSession" "${readDispatch##*/}" "$readEntry" "it is signed by $readBy, who does not hold it"
					continue
				fi
				printf 'GRANT: planned %s\n' "${readDispatch##*/}"
				return 0
			done
		done <<< "$readPlanned"
		set +e ; return 1
	;;

	--intern-op-permission-grant-consume)
		shift
		MDSC_CMD="$MDSC_CMD --intern-op-permission-grant-consume"
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsContext.UseAgentsTools.include"
		local consumeSession="" consumeRefusal=""
		while [ $# -gt 0 ] ; do
			case "$1" in
				--session-id) consumeSession="${2:-}" ; shift 2 ;;
				--refusal-id) consumeRefusal="${2:-}" ; shift 2 ;;
				*)
					echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$consumeSession" ] || [ -z "$consumeRefusal" ] ; then
			echo "$MDSC_CMD: ⛔ ERROR: syntax is --session-id <id> --refusal-id <id>" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$consumeSession" "--session-id" permission-grant-consume || { set +e ; return 1 ; }
		AgentsToolsAssertBareName "$consumeRefusal" "--refusal-id" permission-grant-consume || { set +e ; return 1 ; }
		## One mkdir is the whole lock: the first caller to create the marker uses the grant.
		mkdir -p "$MMDAPP/.local/agents/sessions/$consumeSession/consumed" 2>/dev/null || { set +e ; return 1 ; }
		mkdir "$MMDAPP/.local/agents/sessions/$consumeSession/consumed/$consumeRefusal" 2>/dev/null || { set +e ; return 1 ; }
		AgentsToolsGrantsStoreTouch "$MMDAPP/.local/agents/sessions/$consumeSession"
		printf 'CONSUMED: %s\n' "$consumeRefusal"
		return 0
	;;

	## Whether a member holds one permission, and through which layer. Always rc 0 once
	## the arguments are good: the answer is the line, HOLDS <layer> or NOT-HOLDS.
	--intern-op-permission-holds)
		shift
		MDSC_CMD="$MDSC_CMD --intern-op-permission-holds"
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsContext.UseAgentsTools.include"
		local holdsMember="${1:-}" holdsTool="${2:-}" holdsTarget="${3:-}" holdsSession="" holdsLayer
		shift 3 2>/dev/null || shift $#
		while [ $# -gt 0 ] ; do
			case "$1" in
				--session-id) holdsSession="${2:-}" ; shift 2 ;;
				*)
					echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$holdsMember" ] || [ -z "$holdsTool" ] ; then
			echo "$MDSC_CMD: ⛔ ERROR: syntax is <member> <tool> <target> [--session-id <id>]" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$holdsMember" "<member>" permission-holds || { set +e ; return 1 ; }
		AgentsToolsAssertBareName "$holdsTool" "<tool>" permission-holds || { set +e ; return 1 ; }
		[ -z "$holdsSession" ] || AgentsToolsAssertBareName "$holdsSession" "--session-id" permission-holds || { set +e ; return 1 ; }
		if holdsLayer="$( AgentsToolsPermissionHolds "$holdsMember" "$holdsTool" "$holdsTarget" "$holdsSession" )" ; then
			printf 'HOLDS %s\n' "$holdsLayer"
		else
			printf 'NOT-HOLDS\n'
		fi
		return 0
	;;

	## Who holds one permission among a session's and a task's participants, one
	## `HOLDER: <member> <layer>` line each, `HOLDER: human-owner human-owner` always last.
	--intern-op-permission-holders)
		shift
		MDSC_CMD="$MDSC_CMD --intern-op-permission-holders"
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsContext.UseAgentsTools.include"
		local holdersTool="${1:-}" holdersTarget="${2:-}" holdersSession="" holdersTask="" holdersExclude="" holdersLine
		shift 2 2>/dev/null || shift $#
		while [ $# -gt 0 ] ; do
			case "$1" in
				--session-id) holdersSession="${2:-}" ; shift 2 ;;
				--task) holdersTask="${2:-}" ; shift 2 ;;
				--exclude) holdersExclude="$holdersExclude ${2:-}" ; shift 2 ;;
				*)
					echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$holdersTool" ] ; then
			echo "$MDSC_CMD: ⛔ ERROR: syntax is <tool> <target> [--session-id <id>] [--task <item>] [--exclude <member>]..." >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$holdersTool" "<tool>" permission-holders || { set +e ; return 1 ; }
		while IFS= read -r holdersLine ; do
			[ -z "$holdersLine" ] || printf 'HOLDER: %s\n' "$holdersLine"
		done <<< "$( AgentsToolsPermissionHolders "$holdersTool" "$holdersTarget" "$holdersSession" "$holdersTask" "$holdersExclude" )"
		return 0
	;;

	## Passing a held permission on. The member's own judgement whether to; tooling
	## enforces only the limits: no more than the passer holds, no longer than its own
	## grant lives, and only to a participant of the session or task, or a member it
	## spawned for it. Written as a grant of the receiver's own, signed by the passer.
	## The target may name a place, @<name>[:<glob>], resolved as a set request's entry is;
	## a write in a read-only place is refused with its route; a session pass needs the
	## passer in the session too; the store is touched, so session indices rebuild.
	--member-permission-pass|--intern-op-permission-pass)
		local passOp="$1"
		shift
		MDSC_CMD="$MDSC_CMD $passOp"
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsContext.UseAgentsTools.include"
		local passBy="${1:-}" passTo="" passTool="" passTarget="" passKind="" passTask="" passSession="${MDAT_SPAWN_SESSION_ID:-${CLAUDE_CODE_SESSION_ID:-}}"
		shift || true
		while [ $# -gt 0 ] ; do
			case "$1" in
				--to) passTo="${2:-}" ; shift 2 ;;
				--tool) passTool="${2:-}" ; shift 2 ;;
				--target) passTarget="${2:-}" ; shift 2 ;;
				--kind) passKind="${2:-}" ; shift 2 ;;
				--task) passTask="${2:-}" ; shift 2 ;;
				--session-id) passSession="${2:-}" ; shift 2 ;;
				*)
					echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$passBy" ] || [ -z "$passTo" ] || [ -z "$passTool" ] || [ -z "$passKind" ] || [ -z "$passSession" ] ; then
			echo "$MDSC_CMD: ⛔ ERROR: syntax is <passing-member> --to <member> --tool <tool> --target <target> --kind once|session|task [--task <item>] [--session-id <id>]" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$passBy" "<passing-member>" permission-pass || { set +e ; return 1 ; }
		AgentsToolsAssertBareName "$passTo" "--to" permission-pass || { set +e ; return 1 ; }
		AgentsToolsAssertBareName "$passTool" "--tool" permission-pass || { set +e ; return 1 ; }
		AgentsToolsAssertBareName "$passSession" "--session-id" permission-pass || { set +e ; return 1 ; }
		[ "$passOp" != "--member-permission-pass" ] || AgentsToolsActingMemberCheck "$passBy" "${passOp#--}" || { set +e ; return 1 ; }
		if [ "$passTo" = "$passBy" ] ; then
			echo "$MDSC_CMD: ⛔ ERROR: $passBy cannot pass a permission to itself, so nothing is passed" >&2
			set +e ; return 1
		fi
		passTask="${passTask##*/}" ; passTask="${passTask%.md}"
		case "$passKind" in
			once|session) ;;
			task)
				if [ -z "$passTask" ] || ! AgentsToolsAssertBareName "$passTask" "--task" permission-pass || ! AgentsToolsPermissionItemOpen "$passTask" ; then
					echo "$MDSC_CMD: ⛔ ERROR: a task pass needs --task <item> naming an open board item, got: ${passTask:-none}" >&2
					set +e ; return 1
				fi
			;;
			*)
				echo "$MDSC_CMD: ⛔ ERROR: --kind must be once|session|task: $passKind" >&2
				set +e ; return 1
			;;
		esac
		## The target: a place by name resolved to its path, a path in a place said as
		## name:relative, a write in a read-only place refused (AgentsToolsPermissionEntryPlace).
		local permEntryTool permEntryTarget permEntryPlace passPlace
		AgentsToolsPermissionEntryPlace "$passTool:$passTarget" "$passSession" || { set +e ; return 1 ; }
		passTarget="$permEntryTarget" ; passPlace="$permEntryPlace"
		## Limit one: no more than the passer holds.
		local passHeld passLayer passFromKind passFromRef passFromTask="" passStore
		if ! passHeld="$( AgentsToolsPermissionHolds "$passBy" "$passTool" "$passTarget" "$passSession" )" ; then
			echo "$MDSC_CMD: ⛔ ERROR: $passBy does not hold $passTool ${passTarget:-(any target)} in session $passSession, so it cannot pass it on -- ask for it instead" >&2
			set +e ; return 1
		fi
		## Limit two: no longer than the passer's own grant lives. Standing and floor
		## permissions outlive any session; a session grant outlives its tasks; a task
		## grant passes on only for the same task, or once.
		passLayer="${passHeld%% *}"
		case "$passLayer" in
			routine)
				## A routine's allow ends with the session, which a task may outlive.
				if [ "$passKind" = "task" ] ; then
					echo "$MDSC_CMD: ⛔ ERROR: $passBy holds $passTool only for this session's ${passHeld#routine }, so it passes it only once or for the session, not as task" >&2
					set +e ; return 1
				fi
			;;
			granted|set|passed)
				passFromKind="${passHeld#* }" ; passFromRef="${passFromKind#* }" ; passFromKind="${passFromKind%% *}"
				if [ "$passFromKind" = "task" ] ; then
					while IFS= read -r passStore ; do
						[ -n "$passStore" ] && [ -f "$MMDAPP/.local/agents/sessions/$passStore/$passFromRef.md" ] || continue
						passFromTask="$( AgentsToolsPermissionField "$MMDAPP/.local/agents/sessions/$passStore/$passFromRef.md" task )"
						[ -n "$passFromTask" ] || [ ! -f "$MMDAPP/.local/agents/sessions/$passStore/$passFromRef.task" ] || IFS= read -r passFromTask < "$MMDAPP/.local/agents/sessions/$passStore/$passFromRef.task" || :
						break
					done <<< "$( AgentsToolsPermissionRelatedStores "$passSession" )"
					if [ "$passKind" = "session" ] || { [ "$passKind" = "task" ] && [ "$passTask" != "$passFromTask" ] ; } ; then
						echo "$MDSC_CMD: ⛔ ERROR: $passBy holds $passTool only for task ${passFromTask:-unknown}, so it passes it only once or for that task, not as $passKind${passTask:+ for $passTask}" >&2
						set +e ; return 1
					fi
				fi
			;;
		esac
		## Limit three: the receiver takes part in the session or task, or was spawned by the passer for it.
		if ! AgentsToolsPermissionParticipants "$passSession" "$passTask" | LC_ALL=C grep -q -x -F -- "$passTo" ; then
			echo "$MDSC_CMD: ⛔ ERROR: $passTo takes no part in session $passSession${passTask:+ or task $passTask}, so $passBy cannot pass it a permission there" >&2
			set +e ; return 1
		fi
		## A session pass: the passer takes part in that session too.
		if [ "$passKind" = "session" ] && ! AgentsToolsPermissionParticipants "$passSession" "" | LC_ALL=C grep -q -x -F -- "$passBy" ; then
			echo "$MDSC_CMD: ⛔ ERROR: $passBy takes no part in session $passSession, so it cannot pass a permission for it" >&2
			set +e ; return 1
		fi
		## Kept where the receiver reads it: the coworking session's store, or the passer's own.
		local passRef passDir
		passDir="$MMDAPP/.local/agents/sessions/$( AgentsToolsPermissionShareStore "$passSession" )"
		passRef="$( AgentsToolsPermissionNewRef pass- )" || {
			echo "$MDSC_CMD: ⛔ ERROR: no id could be generated, so nothing is passed" >&2
			set +e ; return 1
		}
		mkdir -p "$passDir" 2>/dev/null || {
			echo "$MDSC_CMD: ⛔ ERROR: can't create the session store for $passSession, so nothing is passed" >&2
			set +e ; return 1
		}
		{
			printf '%s\n' "---"
			printf 'status: %s\n' "passed"
			printf 'owner: %s\n' "$passTo"
			printf 'passed-by: %s\n' "$passBy"
			printf 'held-as: %s\n' "$passHeld"
			printf 'session-id: %s\n' "$passSession"
			printf 'tool: %s\n' "$passTool"
			printf 'target: %s\n' "$( AgentsToolsPermissionEscapeRecord "$passTarget" )"
			printf 'kind: %s\n' "$passKind"
			[ -z "$passTask" ] || printf 'task: %s\n' "$passTask"
			printf 'passed-at: %s\n' "$( date +"%Y-%m-%d %H:%M %z" )"
			printf '%s\n' "---"
			printf '\n# Passed\n\n%s passed %s %s to %s.\n' "$passBy" "$passTool" "${passTarget:-(any target)}" "$passTo"
		} > "$passDir/$passRef.md" || {
			rm -f "$passDir/$passRef.md"
			echo "$MDSC_CMD: ⛔ ERROR: can't write the pass record, so nothing is passed" >&2
			set +e ; return 1
		}
		## The place its path lies in, as name:relative, recorded beside it as a hint.
		if [ -n "$passPlace" ] ; then
			printf '%s\t%s\n' "$passTarget" "$passPlace" > "$passDir/$passRef.places" \
				|| echo "⚠️ WARNING: $MDSC_CMD: the place of $passRef was not recorded: $passPlace" >&2
			printf 'PLACE: %s:%s is %s\n' "$passTool" "$passTarget" "$passPlace"
		fi
		printf '%s:%s:%s:%s:%s:%s\n' "$passKind" "$passTool" "$( AgentsToolsPermissionEscape "$passTarget" )" "$passBy" "$( date -u +%Y%m%dT%H%M%SZ )" "$passRef" >> "$passDir/grants" || {
			echo "$MDSC_CMD: ⛔ ERROR: can't write the grant for $passRef, so nothing is passed" >&2
			AgentsToolsGrantsStoreTouch "$passDir"
			set +e ; return 1
		}
		## Every session index joining this store is rebuilt at its next check.
		AgentsToolsGrantsStoreTouch "$passDir"
		printf 'GRANT: %s %s\n' "$passKind" "$passRef"
		return 0
	;;

	## A task's or session's permission set, asked for at spawn or brief time. Entries any
	## participant already holds are held, and pass on per --member-permission-pass when the
	## holder delegates. The rest are the extras, asked of the human-owner as ONE
	## permission-set escalation: allow-set, deny or edit.
	--magic-permission-set-request)
		shift
		MDSC_CMD="$MDSC_CMD --magic-permission-set-request"
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsContext.UseAgentsTools.include"
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.ItemDecisions.include"
		local setBy="${1:-}" setItem="${2:-}" setScope="task" setSession="${MDAT_SPAWN_SESSION_ID:-${CLAUDE_CODE_SESSION_ID:-}}" setEntries="" setExtra="" setHeld="" setNamed=""
		shift 2 2>/dev/null || shift $#
		while [ $# -gt 0 ] ; do
			case "$1" in
				--entry) setEntries="${setEntries}${2:-}"$'\n' ; shift 2 ;;
				--scope) setScope="${2:-}" ; shift 2 ;;
				--session-id) setSession="${2:-}" ; shift 2 ;;
				--participant) setNamed="${setNamed}${2:-}"$'\n' ; shift 2 ;;
				*)
					echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$setBy" ] || [ -z "$setItem" ] || [ -z "$setEntries" ] ; then
			echo "$MDSC_CMD: ⛔ ERROR: syntax is <magic-coordinator> <item> --entry <tool:target>... [--scope task|session] [--session-id <id>] [--participant <member>]..." >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$setBy" "<magic-coordinator>" permission-set-request || { set +e ; return 1 ; }
		AgentsToolsMagicCallerCheck "--magic-permission-set-request" || { set +e ; return 1 ; }
		setItem="${setItem##*/}" ; setItem="${setItem%.md}"
		AgentsToolsAssertBareName "$setItem" "<item>" permission-set-request || { set +e ; return 1 ; }
		AgentsToolsDecisionsItemPath "$setItem" > /dev/null || {
			echo "$MDSC_CMD: ⛔ ERROR: no board item $setItem, so there is nothing to record the set on" >&2
			set +e ; return 1
		}
		case "$setScope" in
			task|session) ;;
			*) echo "$MDSC_CMD: ⛔ ERROR: --scope must be task|session: $setScope" >&2 ; set +e ; return 1 ;;
		esac
		if [ -n "$setSession" ] ; then
			AgentsToolsAssertBareName "$setSession" "--session-id" permission-set-request || { set +e ; return 1 ; }
		elif [ "$setScope" = "session" ] ; then
			echo "$MDSC_CMD: ⛔ ERROR: a session-scoped set needs the session, and this caller names none" >&2
			set +e ; return 1
		fi
		## Each entry's place first, before anything is said or asked: an @<name>:<glob> target
		## resolved, a path in a place shown as name:relative, a write in a read-only place refused.
		local setResolved="" setPlaces="" setOne permEntryTool permEntryTarget permEntryPlace
		while IFS= read -r setOne ; do
			[ -n "$setOne" ] || continue
			AgentsToolsPermissionEntryPlace "$setOne" "$setSession" || { set +e ; return 1 ; }
			case "$setOne" in
				*:@*) setResolved="${setResolved}${permEntryTool}:${permEntryTarget}"$'\n' ;;
				*) setResolved="${setResolved}${setOne}"$'\n' ;;
			esac
			[ -z "$permEntryPlace" ] || setPlaces="${setPlaces}${permEntryTarget}"$'\t'"${permEntryPlace}"$'\n'
			[ -z "$permEntryPlace" ] || printf 'PLACE: %s:%s is %s\n' "$permEntryTool" "$permEntryTarget" "$permEntryPlace"
		done <<< "$setEntries"
		setEntries="$setResolved"
		## The participants, held entries and extras, each said.
		local setParticipants setLine setHolder
		setParticipants="$( { AgentsToolsPermissionParticipants "$setSession" "$setItem" ; printf '%s' "$setNamed" ; } | LC_ALL=C awk 'NF && $1 != "human-owner" && !seenMember[$1]++ { print $1 ; }' )"
		printf 'PARTICIPANTS: %s\n' "$( printf '%s\n' "$setParticipants" | LC_ALL=C tr '\n' ' ' | LC_ALL=C sed 's/ *$//' )"
		while IFS= read -r setLine ; do
			[ -n "$setLine" ] || continue
			AgentsToolsPermissionEntrySplit "$setLine" permission-set-request || { set +e ; return 1 ; }
			case "$permEntryTarget" in
				*/../*|*/..) echo "$MDSC_CMD: ⛔ ERROR: an entry target has a .. segment: $setLine" >&2 ; set +e ; return 1 ;;
			esac
			setHolder="$( AgentsToolsPermissionHolders "$permEntryTool" "$permEntryTarget" "$setSession" "$setItem" "" | LC_ALL=C awk '$1 != "human-owner" { print ; exit ; }' )" || setHolder=""
			if [ -n "$setHolder" ] && printf '%s\n' "$setParticipants" | LC_ALL=C grep -q -x -F -- "${setHolder%% *}" ; then
				printf 'HELD: %s by %s\n' "$setLine" "$setHolder"
				setHeld="${setHeld}${setLine} (${setHolder%% *})"$'\n'
			else
				printf 'EXTRA: %s\n' "$setLine"
				setExtra="${setExtra}${setLine}"$'\n'
			fi
		done <<< "$setEntries"
		if [ -z "$setExtra" ] ; then
			printf 'PERMISSION-SET: held -- every entry is held by a participant, and passes on when its holder delegates\n'
			return 0
		fi
		## ONE ask for the extras, to the human-owner, as the team bot.
		local setBody setOut setChannel setTs setAddressees setAsking setId
		setBody="$( {
			printf '# 🔐 Permission set\n\n'
			printf 'May the participants of %s have these for this %s?\n\n' "$setItem" "$setScope"
			printf '**➕ Asked for**\n'
			printf '%s' "$setExtra" | LC_ALL=C awk 'NF { print "- " $0 ; }'
			if [ -n "$setHeld" ] ; then
				printf '\n**✅ Already held, passed on by the holder**\n'
				printf '%s' "$setHeld" | LC_ALL=C awk 'NF { print "- " $0 ; }'
			fi
			if [ -n "$setPlaces" ] ; then
				printf '\n**📍 Places**\n'
				printf '%s' "$setPlaces" | LC_ALL=C awk -F'\t' 'NF >= 2 { print "- " $1 " is " $2 ; }'
			fi
			printf '\n**👥 Participants**\n'
			printf '%s\n' "$setParticipants" | LC_ALL=C awk 'NF { print "- " $0 ; }'
			printf '\nReply with the first word: allow-set, deny, or edit followed by the change.\n'
		} )"
		setOut="$( printf '%s\n' "$setBody" | DistroAgentsTools --intern-op-comms-slack-send-message "$setBy" human-owner --identity-bot --address-to human-owner --from-stdin 2>&1 )" || {
			echo "$MDSC_CMD: ⛔ ERROR: the permission-set ask could not be posted, so nothing was asked or recorded: $( LC_ALL=C grep -m1 '⛔' <<< "$setOut" )" >&2
			set +e ; return 1
		}
		setChannel="$( LC_ALL=C sed -n 's/^SENT_MESSAGE_CHANNEL=//p' <<< "$setOut" | head -1 )"
		setTs="$( LC_ALL=C sed -n 's/^SENT_MESSAGE_TS=//p' <<< "$setOut" | head -1 )"
		setAddressees="$( LC_ALL=C sed -n 's/^SENT_MESSAGE_ADDRESSEES=//p' <<< "$setOut" | head -1 )"
		setAsking="$( printf '%s\n' "$setOut" | LC_ALL=C grep '^{' | LC_ALL=C awk -v path=message.user -v optional=1 -v dialect=slack -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsHarnessJsonField.awk" 2>/dev/null | LC_ALL=C sort -u | LC_ALL=C tr '\n' ' ' )" || setAsking=""
		if [ -z "$setChannel" ] || [ -z "$setTs" ] || [ -z "$setAddressees" ] ; then
			echo "$MDSC_CMD: ⛔ ERROR: the permission-set ask was posted but its thread or addressee could not be named, so its answer could not be recognised" >&2
			set +e ; return 1
		fi
		setId="$( printf '%s\n' "$setBody" | DistroAgentsTools --intern-op-pending-reply-open "$setBy" --to "$setChannel" \
			${setSession:+--session-id "$setSession"} --kind permission-set --address-to human-owner --channel "$setChannel" \
			--question-ts "$setTs" --thread-ts "$setTs" --addressees "$setAddressees" ${setAsking:+--asking-accounts " $setAsking"} \
			--item "$setItem" --ask-identity bot --context "$MDSC_CMD" 2>/dev/null )" || setId=""
		if [ -z "$setId" ] ; then
			echo "$MDSC_CMD: ⛔ ERROR: the permission-set ask was posted at $setChannel:$setTs but not recorded, so its answer cannot be applied" >&2
			set +e ; return 1
		fi
		## What an allow-set applies, beside the record.
		{
			printf 'scope: %s\n' "$setScope"
			printf 'item: %s\n' "$setItem"
			printf 'session-id: %s\n' "$setSession"
			printf 'participants: %s\n' "$( printf '%s\n' "$setParticipants" | LC_ALL=C tr '\n' ' ' | LC_ALL=C sed 's/ *$//' )"
			printf '%s' "$setExtra" | LC_ALL=C awk 'NF { print "entry: " $0 ; }'
			printf '%s' "$setPlaces" | LC_ALL=C awk 'NF { print "place: " $0 ; }'
		} > "$MMDAPP/.local/agents/pending/$setId.set" || {
			echo "$MDSC_CMD: ⛔ ERROR: the permission-set ask $setId is recorded but its entries are not, so an allow-set would grant nothing" >&2
			set +e ; return 1
		}
		printf 'PERMISSION-SET: asked %s\n' "$setId"
		printf 'WAIT-ID: ask:%s\n' "$setId"
		return 0
	;;

	## An approved permission set, applied: a grant of the set's scope for every
	## participant and every extra entry, signed by the approver; for a task, also the
	## item's `allows:`, so a later dispatch tracking it carries the set; and the set on
	## the item's Decisions. Called by the escalation verdict path only.
	--intern-op-permission-set-apply)
		shift
		MDSC_CMD="$MDSC_CMD --intern-op-permission-set-apply"
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsContext.UseAgentsTools.include"
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.ItemDecisions.include"
		local applySetId="${1:-}" applySetBy="${2:-}" applySetFile applySetLine applySetScope="" applySetItem="" applySetSession="" applySetParts="" applySetEntries="" applySetPlaces=""
		if [ -z "$applySetId" ] || [ -z "$applySetBy" ] ; then
			echo "$MDSC_CMD: ⛔ ERROR: syntax is <pending-id> <approver>" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$applySetId" "<pending-id>" permission-set-apply || { set +e ; return 1 ; }
		AgentsToolsAssertBareName "$applySetBy" "<approver>" permission-set-apply || { set +e ; return 1 ; }
		applySetFile="$MMDAPP/.local/agents/pending/$applySetId.set"
		[ -f "$applySetFile" ] || { echo "$MDSC_CMD: ⛔ ERROR: no permission set is recorded for $applySetId" >&2 ; set +e ; return 1 ; }
		while IFS= read -r applySetLine ; do
			case "$applySetLine" in
				'scope: '*) applySetScope="${applySetLine#scope: }" ;;
				'item: '*) applySetItem="${applySetLine#item: }" ;;
				'session-id: '*) applySetSession="${applySetLine#session-id: }" ;;
				'participants: '*) applySetParts="${applySetLine#participants: }" ;;
				'entry: '*) applySetEntries="${applySetEntries}${applySetLine#entry: }"$'\n' ;;
				'place: '*) applySetPlaces="${applySetPlaces}${applySetLine#place: }"$'\n' ;;
			esac
		done < "$applySetFile"
		[ -n "$applySetEntries" ] || { echo "$MDSC_CMD: ⛔ ERROR: the permission set $applySetId names no entry" >&2 ; set +e ; return 1 ; }
		local applySetTime applySetPart applySetRef applySetDir applySetCount=0 applySetAllows="" applySetText="" permEntryTool permEntryTarget
		applySetTime="$( date -u +%Y%m%dT%H%MZ )"
		## Grants for the participants, in the session's store.
		if [ -n "$applySetSession" ] && AgentsToolsAssertBareName "$applySetSession" "session-id" permission-set-apply 2>/dev/null ; then
			applySetDir="$MMDAPP/.local/agents/sessions/$( AgentsToolsPermissionShareStore "$applySetSession" )"
			mkdir -p "$applySetDir" 2>/dev/null || { echo "$MDSC_CMD: ⛔ ERROR: can't create the session store for $applySetSession" >&2 ; set +e ; return 1 ; }
			for applySetPart in $applySetParts ; do
				AgentsToolsAssertBareName "$applySetPart" "participant" permission-set-apply 2>/dev/null || continue
				applySetRef="$( AgentsToolsPermissionNewRef set- )" || { echo "$MDSC_CMD: ⛔ ERROR: no id could be generated" >&2 ; set +e ; return 1 ; }
				{
					printf '%s\n' "---"
					printf 'status: %s\n' "set"
					printf 'owner: %s\n' "$applySetPart"
					printf 'approved-by: %s\n' "$applySetBy"
					printf 'session-id: %s\n' "$applySetSession"
					printf 'kind: %s\n' "$applySetScope"
					[ "$applySetScope" != "task" ] || printf 'task: %s\n' "$applySetItem"
					printf 'escalation: %s\n' "$applySetId"
					printf '%s\n' "---"
					printf '\n# Permission set\n\n'
					printf '%s' "$applySetEntries" | LC_ALL=C awk 'NF { print "- " $0 ; }'
				} > "$applySetDir/$applySetRef.md" || { echo "$MDSC_CMD: ⛔ ERROR: can't write the set record for $applySetPart" >&2 ; set +e ; return 1 ; }
				## The places its entries were asked by, as name:relative, beside it.
				[ -z "$applySetPlaces" ] || printf '%s' "$applySetPlaces" > "$applySetDir/$applySetRef.places" \
					|| echo "⚠️ WARNING: $MDSC_CMD: the places of the set grants for $applySetPart were not recorded" >&2
				while IFS= read -r applySetLine ; do
					[ -n "$applySetLine" ] || continue
					AgentsToolsPermissionEntrySplit "$applySetLine" permission-set-apply 2>/dev/null || continue
					printf '%s:%s:%s:%s:%s:%s\n' "$applySetScope" "$permEntryTool" "$( AgentsToolsPermissionEscape "$permEntryTarget" )" "$applySetBy" "$applySetTime" "$applySetRef" >> "$applySetDir/grants" \
						|| { echo "$MDSC_CMD: ⛔ ERROR: can't write the set grants for $applySetPart" >&2 ; set +e ; return 1 ; }
					applySetCount=$(( applySetCount + 1 ))
				done <<< "$applySetEntries"
			done
		fi
		## The entries, as the item's planned allows (a task set) and on its Decisions.
		while IFS= read -r applySetLine ; do
			[ -n "$applySetLine" ] || continue
			AgentsToolsPermissionEntrySplit "$applySetLine" permission-set-apply 2>/dev/null || continue
			applySetAllows="${applySetAllows:+$applySetAllows,}task:$permEntryTool:$( AgentsToolsPermissionEscape "$permEntryTarget" ):$applySetBy:$applySetTime"
			applySetText="${applySetText:+$applySetText, }$applySetLine"
		done <<< "$applySetEntries"
		local applySetPath applySetState applySetOld
		if [ "$applySetScope" = "task" ] && applySetPath="$( AgentsToolsDecisionsItemPath "$applySetItem" )" ; then
			applySetState="${applySetPath%/*}" ; applySetState="${applySetState##*/}"
			applySetOld="$( AgentsToolsDecisionsField "$applySetPath" allows )" || applySetOld=""
			printf '{ print ; }\n' | DistroAgentsTools --intern-op-board-upsert-move-edit "$applySetState" "${applySetPath##*/}" --from-state:"$applySetState" \
				--edit-script-from-stdin:awk "--header:upsert:allows:${applySetOld:+$applySetOld,}$applySetAllows" \
				--context "$MDSC_CMD" --log-verb:updated > /dev/null 2>&1 \
				|| echo "⚠️ WARNING: $MDSC_CMD: the set is granted, but not written as $applySetItem's allows, so a later dispatch tracking it does not carry it" >&2
		fi
		DistroAgentsTools --intern-op-decisions-append "$applySetBy" "$applySetItem" --kind verdict \
			--text "permission set approved for the $applySetScope ($applySetParts): $applySetText" --source "$applySetId" \
			--context "$MDSC_CMD" > /dev/null 2>&1 \
			|| echo "⚠️ WARNING: $MDSC_CMD: the set is granted, but not recorded on $applySetItem's Decisions" >&2
		printf 'GRANT: set %s entries for %s\n' "$applySetCount" "${applySetParts:-nobody}"
		return 0
	;;

	## magic-coordinator.permission-escalation.routine's input scan: the stub, and the
	## implementation only the stub uses.
	--magic-permission-escalation-input-scan)
		shift
		MDSC_CMD="$MDSC_CMD --magic-permission-escalation-input-scan"
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsContext.UseAgentsTools.include"
		if [ -z "${1:-}" ] || [ $# -gt 1 ] ; then
			echo "$MDSC_CMD: ⛔ ERROR: syntax is <team-member>, no other arguments -- an input scan reads every ask itself" >&2
			set +e ; return 1
		fi
		DistroAgentsTools --intern-op-permission-escalation-input-scan "$1"
		return $?
	;;

	## The oldest 20 open permission asks addressed to permission-escalation.routine (or its full
	## name), across every workspace this machine knows (AgentsToolsPlacesWorkspaceRoots), this
	## one first; each as AgentsToolsPermissionEscalationAsk prints it.
	--intern-op-permission-escalation-input-scan)
		shift
		MDSC_CMD="$MDSC_CMD --intern-op-permission-escalation-input-scan"
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsContext.UseAgentsTools.include"
		local escBy="${1:-}" escRoot escRows="" escEpoch escId escAt escTotal escCap=20
		if [ -z "$escBy" ] || [ $# -gt 1 ] ; then
			echo "$MDSC_CMD: ⛔ ERROR: syntax is <team-member>" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$escBy" "<team-member>" permission-escalation-input-scan || { set +e ; return 1 ; }
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.ReviewFlow.include"
		type AgentsToolsPlacesWorkspaceRoots > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.Places.include"
		while IFS= read -r escRoot ; do
			[ -n "$escRoot" ] && [ -d "$escRoot" ] || continue
			escRows="$escRows$( AgentsPendingAsksForRoutine permission-escalation "$escRoot" | LC_ALL=C awk -F'\t' -v OFS='\t' -v root="$escRoot" '$3 == "permission" { print $1, root, $2, $5 ; }' )"$'\n'
		done <<< "$( AgentsToolsPlacesWorkspaceRoots "${MMDAPP%/}" 2> /dev/null )"
		escRows="$( printf '%s' "$escRows" | LC_ALL=C awk 'NF' | LC_ALL=C sort -t "$( printf '\t' )" -k1,1n -k3,3 )"
		escTotal="$( printf '%s' "$escRows" | LC_ALL=C awk 'NF { n++ ; } END { print n + 0 ; }' )"
		printf '%s\n\n' "## permission asks addressed to permission-escalation.routine"
		if [ "$escTotal" = 0 ] ; then
			printf '(none)\n'
			return 0
		fi
		printf 'shown: %s of %s, oldest first\n' "$(( escTotal < escCap ? escTotal : escCap ))" "$escTotal"
		while IFS=$'\t' read -r escEpoch escRoot escId escAt ; do
			[ -n "$escId" ] || continue
			AgentsToolsPermissionEscalationAsk "$escBy" "$escRoot" "$escId" "$escAt"
		done <<< "$( printf '%s\n' "$escRows" | head -n "$escCap" )"
		return 0
	;;

	## Revokes one grant of a session store by its reference (refusal-, pass- or set-<id>): a
	## marker beside its record, and the store touched, so every session index joining it is
	## rebuilt without it and every reader leaves it out. The coordinator stub and the
	## implementation are one arm, as pass is.
	--magic-permission-revoke|--intern-op-permission-revoke)
		local revokeOp="$1"
		shift
		MDSC_CMD="$MDSC_CMD $revokeOp"
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsContext.UseAgentsTools.include"
		local revokeRef="${1:-}" revokeSession="" revokeStore="" revokeOne revokeLine revokeFound="" revokeBy
		shift || true
		while [ $# -gt 0 ] ; do
			case "$1" in
				--session-id) revokeSession="${2:-}" ; shift 2 ;;
				*)
					echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$revokeRef" ] ; then
			echo "$MDSC_CMD: ⛔ ERROR: syntax is <ref> [--session-id <id>]" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$revokeRef" "<ref>" permission-revoke || { set +e ; return 1 ; }
		[ -z "$revokeSession" ] || AgentsToolsAssertBareName "$revokeSession" "--session-id" permission-revoke || { set +e ; return 1 ; }
		## The store whose grants name it: one the named session reads, else any holding its record.
		local revokeStores=""
		[ -z "$revokeSession" ] || revokeStores=$'\n'"$( AgentsToolsPermissionRelatedStores "$revokeSession" )"$'\n'
		for revokeOne in "$MMDAPP/.local/agents/sessions"/*/"$revokeRef.md" ; do
			[ -f "$revokeOne" ] && [ -f "${revokeOne%/*}/grants" ] || continue
			revokeLine="${revokeOne%/*}" ; revokeLine="${revokeLine##*/}"
			case "${revokeSession:+$revokeStores}" in ''|*$'\n'"$revokeLine"$'\n'*) ;; *) continue ;; esac
			while IFS= read -r revokeLine ; do
				case "$revokeLine" in *":$revokeRef") revokeFound=1 ; break ;; esac
			done < "${revokeOne%/*}/grants"
			[ -z "$revokeFound" ] || { revokeStore="${revokeOne%/*}" ; break ; }
		done
		if [ -z "$revokeStore" ] ; then
			echo "$MDSC_CMD: ⛔ ERROR: no grant $revokeRef is recorded${revokeSession:+ in session $revokeSession}, so nothing is revoked" >&2
			set +e ; return 1
		fi
		if [ -e "$revokeStore/revoked/$revokeRef" ] ; then
			printf 'REVOKED: %s already\n' "$revokeRef"
			return 0
		fi
		revokeBy="$( AgentsToolsActingMember )"
		mkdir -p "$revokeStore/revoked" 2>/dev/null \
			&& printf 'revoked-by: %s\nrevoked-at: %s\n' "${revokeBy:-human-owner}" "$( date +"%Y-%m-%d %H:%M %z" )" > "$revokeStore/revoked/$revokeRef" || {
			echo "$MDSC_CMD: ⛔ ERROR: can't write the revoke marker in $revokeStore, so $revokeRef stands" >&2
			set +e ; return 1
		}
		AgentsToolsGrantsStoreTouch "$revokeStore"
		## A task grant's entries leave its item's `allows:` too, so no later dispatch tracking the
		## item carries them, and the revoke goes on the item's Decisions. Best effort: the grant
		## is revoked either way. An allows entry is its grants line without the trailing ref.
		local revokeEntries="" revokeTask="" revokePath revokeState revokeOld revokeNew="" revokeEntry revokeText="" revokeAllowsGone=""
		while IFS= read -r revokeLine ; do
			case "$revokeLine" in
				"task:"*":$revokeRef") revokeEntries="$revokeEntries${revokeLine%":$revokeRef"}"$'\n' ;;
			esac
		done < "$revokeStore/grants"
		if [ -n "$revokeEntries" ] ; then
			. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.ItemDecisions.include"
			revokeTask="$( AgentsToolsPermissionField "$revokeStore/$revokeRef.md" task )"
			[ -n "$revokeTask" ] || [ ! -f "$revokeStore/$revokeRef.task" ] || IFS= read -r revokeTask < "$revokeStore/$revokeRef.task" || :
			revokeTask="${revokeTask##*/}" ; revokeTask="${revokeTask%.md}"
			if [ -n "$revokeTask" ] && revokePath="$( AgentsToolsDecisionsItemPath "$revokeTask" )" ; then
				revokeState="${revokePath%/*}" ; revokeState="${revokeState##*/}"
				revokeOld="$( AgentsToolsDecisionsField "$revokePath" allows )"
				while [ -n "$revokeOld" ] ; do
					revokeEntry="${revokeOld%%,*}"
					if [ "$revokeEntry" != "$revokeOld" ] ; then revokeOld="${revokeOld#*,}" ; else revokeOld="" ; fi
					revokeEntry="${revokeEntry# }"
					[ -n "$revokeEntry" ] || continue
					case $'\n'"$revokeEntries" in *$'\n'"$revokeEntry"$'\n'*) continue ;; esac
					revokeNew="${revokeNew:+$revokeNew,}$revokeEntry"
				done
				if [ "$revokeNew" != "$( AgentsToolsDecisionsField "$revokePath" allows )" ] ; then
					if printf '{ print ; }\n' | DistroAgentsTools --intern-op-board-upsert-move-edit "$revokeState" "${revokePath##*/}" --from-state:"$revokeState" \
						--edit-script-from-stdin:awk "$( if [ -n "$revokeNew" ] ; then printf -- '--header:upsert:allows:%s' "$revokeNew" ; else printf -- '--header:remove:allows' ; fi )" \
						--context "$MDSC_CMD" --log-verb:updated > /dev/null 2>&1 ; then
						revokeAllowsGone="$revokeTask"
					else
						echo "⚠️ WARNING: $MDSC_CMD: $revokeRef is revoked, but it is still written as $revokeTask's allows, so a later dispatch tracking it may carry it" >&2
					fi
				fi
				while IFS= read -r revokeEntry ; do
					[ -n "$revokeEntry" ] || continue
					revokeEntry="${revokeEntry#task:}"
					revokeText="${revokeText:+$revokeText, }${revokeEntry%%:*}:$( AgentsToolsPermissionUnescape "$( printf '%s' "${revokeEntry#*:}" | LC_ALL=C sed 's/:[^:]*:[^:]*$//' )" )"
				done <<< "$revokeEntries"
				DistroAgentsTools --intern-op-decisions-append "${revokeBy:-human-owner}" "$revokeTask" --kind verdict \
					--text "task grant $revokeRef revoked: $revokeText" --source "$revokeRef" --context "$MDSC_CMD" > /dev/null 2>&1 \
					|| echo "⚠️ WARNING: $MDSC_CMD: $revokeRef is revoked, but not recorded on $revokeTask's Decisions" >&2
			fi
		fi
		printf 'REVOKED: %s\n' "$revokeRef"
		[ -z "$revokeAllowsGone" ] || printf 'ALLOWS-REMOVED: %s\n' "$revokeAllowsGone"
		return 0
	;;

	## One member's effective grants, one TAB-separated row each: kind (floor, standing,
	## session, task, once), read, write or the tool, target, its place as name:relative or -,
	## origin, expiry (AgentsToolsGrantsMemberList). Revoked, used, lapsed and ended ones are
	## left out. The coordinator stub names any member; a member's own lists its own only.
	--magic-permission-list|--member-permission-list|--intern-op-permission-list)
		local listOp="$1"
		shift
		MDSC_CMD="$MDSC_CMD $listOp"
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsContext.UseAgentsTools.include"
		local listMember="" listSession=""
		if [ "$listOp" != "--magic-permission-list" ] ; then
			listMember="${1:-}"
			shift || true
		fi
		while [ $# -gt 0 ] ; do
			case "$1" in
				--member)
					if [ "$listOp" != "--magic-permission-list" ] ; then
						echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
						set +e ; return 1
					fi
					listMember="${2:-}" ; shift 2
				;;
				--session-id) listSession="${2:-}" ; shift 2 ;;
				*)
					echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$listMember" ] ; then
			case "$listOp" in
				--magic-permission-list) echo "$MDSC_CMD: ⛔ ERROR: syntax is --member <member> [--session-id <id>]" >&2 ;;
				*) echo "$MDSC_CMD: ⛔ ERROR: syntax is <team-member> [--session-id <id>]" >&2 ;;
			esac
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$listMember" "<member>" permission-list || { set +e ; return 1 ; }
		[ -z "$listSession" ] || AgentsToolsAssertBareName "$listSession" "--session-id" permission-list || { set +e ; return 1 ; }
		[ "$listOp" != "--member-permission-list" ] || AgentsToolsActingMemberCheck "$listMember" "${listOp#--}" || { set +e ; return 1 ; }
		AgentsToolsGrantsMemberList "${MMDAPP%/}" "$listMember" "$listSession" || {
			echo "$MDSC_CMD: ⛔ ERROR: the grants of $listMember could not be listed: no grants index could be read or built" >&2
			set +e ; return 1
		}
		return 0
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid operation: $1" >&2
		set +e ; return 1
	;;

esac
