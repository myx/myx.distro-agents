#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.MagicTeamRoster.include -- the team roster cache's own
## --magic-team-roster-* operation group for DistroAgentsTools.fn.sh's
## dispatcher. Sourced lazily from the `--magic-team-roster-*)` wildcard arm
## via the standard $MDLT_ORIGIN-based path. Not standalone: relies on being
## dot-sourced for $1/$@/$MDSC_CMD.
##

case "$1" in

	--magic-team-roster-upsert)
		shift
		local callingMember="$1"
		shift || true
		if [ -z "$callingMember" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-team-roster-upsert: syntax is <team-member> -- content via stdin, --from-file <path>, or --edit-patch-from-stdin" >&2
			set +e ; return 1
		fi
		[ -n "${MDAT_DATA_ROOT:-}" ] || {
			echo "⛔ ERROR: $MDSC_CMD --magic-team-roster-upsert: MDAT_DATA_ROOT is not set" >&2
			set +e ; return 1
		}
		local stateDir="$MDAT_DATA_ROOT/inboxes/magic-coordinator"
		mkdir -p "$stateDir" || {
			echo "⛔ ERROR: $MDSC_CMD --magic-team-roster-upsert: can't create inbox directory: $stateDir" >&2
			set +e ; return 1
		}
		local target="$stateDir/note-20260804T0000Z-team-roster.md"
		local content contentFromFile="false" bodyMode="" bodyModeCount=0
		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-file)
					if [ -z "$2" ] || [ ! -f "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --magic-team-roster-upsert: --from-file: file not found: $2" >&2
						set +e ; return 1
					fi
					content="$( cat "$2" )"
					contentFromFile="true"
					bodyMode="file"
					bodyModeCount=$(( bodyModeCount + 1 ))
					shift 2
				;;
				--edit-patch-from-stdin)
					bodyMode="patch"
					bodyModeCount=$(( bodyModeCount + 1 ))
					shift
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --magic-team-roster-upsert: unrecognized argument: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ "$bodyModeCount" -gt 1 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-team-roster-upsert: --from-file and --edit-patch-from-stdin are mutually exclusive" >&2
			set +e ; return 1
		fi
		if [ "$bodyMode" = "patch" ] ; then
			local patchJson existingContent contentFile patchFile
			patchJson="$( cat )"
			if [ -f "$target" ] ; then existingContent="$( cat "$target" )" ; else existingContent="" ; fi
			contentFile="$MMDAPP/.local/temp/mdat-team-roster-patch-content.$$"
			mkdir -p "$MMDAPP/.local/temp" && : > "$contentFile" || { set +e ; return 1 ; }
			patchFile="$MMDAPP/.local/temp/mdat-team-roster-patch-spec.$$"
			mkdir -p "$MMDAPP/.local/temp" && : > "$patchFile" || { set +e ; return 1 ; }
			printf '%s' "$existingContent" > "$contentFile"
			printf '%s' "$patchJson" > "$patchFile"
			content="$( python3 "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsBoardItemPatchApply.py" "$contentFile" "$patchFile" )" || { rm -f "$contentFile" "$patchFile" ; set +e ; return 1 ; }
			rm -f "$contentFile" "$patchFile"
		else
			[ "$contentFromFile" = "true" ] || content="$( cat )"
		fi
		if [ -z "$content" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-team-roster-upsert: empty content -- refusing to erase the stored team roster" >&2
			set +e ; return 1
		fi
		printf '%s\n' "$content" > "$target"
		echo "# $MDSC_CMD --magic-team-roster-upsert: wrote ${target#"$stateDir"/} ($( printf '%s\n' "$content" | wc -l | tr -d '[:space:]' ) lines)" >&2
		return 0
	;;

	--magic-team-roster-read)
		shift
		local callingMember="$1"
		shift || true
		if [ -z "$callingMember" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-team-roster-read: <team-member> required" >&2
			set +e ; return 1
		fi
		if [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-team-roster-read: takes no arguments" >&2
			set +e ; return 1
		fi
		[ -n "${MDAT_DATA_ROOT:-}" ] || {
			echo "⛔ ERROR: $MDSC_CMD --magic-team-roster-read: MDAT_DATA_ROOT is not set" >&2
			set +e ; return 1
		}
		## Same fixed literal filename as --magic-team-roster-upsert above --
		## must match exactly, since this is a read of the SAME document.
		local target="$MDAT_DATA_ROOT/inboxes/magic-coordinator/note-20260804T0000Z-team-roster.md"
		if [ -f "$target" ] ; then
			cat "$target"
		else
			echo "NO_RECORD"
		fi
		return 0
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
