#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.InternOpInboxToProcessed.include -- the
## --intern-op-inbox-to-processed op for DistroAgentsTools.fn.sh's
## dispatcher. Sourced lazily from that exact op's own dispatcher arm
## Not standalone: relies on being dot-sourced for $1/$@/$MDSC_CMD.
##

case "$1" in

	--intern-op-inbox-to-processed)
		shift
		local opContext="<no --context given>"
		local ctxWanted="" ctxArg
		for ctxArg in "$@" ; do
			if [ -n "$ctxWanted" ] ; then
				opContext="$ctxArg" ; ctxWanted="" ; continue
			fi
			if [ "$ctxArg" = "--context" ] ; then ctxWanted="1" ; fi
		done

		local inboxMember="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$inboxMember" ] || [ -z "$itemName" ] ; then
			echo "$MDSC_CMD: inbox-to-processed: ⛔ ERROR: syntax is <member> <item-filename> [--header:<upsert|append|remove>:name[:value]]... [--upsert-from-stdin|--edit-script-from-stdin:<py|awk>|--edit-patch-from-stdin]" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$inboxMember" "<member>" inbox-to-processed || { set +e ; return 1 ; }
		AgentsToolsAssertBareName "$itemName" "<item-filename>" inbox-to-processed || { set +e ; return 1 ; }
		case "$itemName" in
			*.md) ;;
			*)
				echo "$MDSC_CMD: inbox-to-processed: ⛔ ERROR: <item-filename> must end in .md -- every inbox item is a markdown document: $itemName" >&2
				set +e ; return 1
			;;
		esac

		[ -n "${MDAT_DATA_ROOT:-}" ] || {
			echo "$MDSC_CMD: inbox-to-processed: ⛔ ERROR: MDAT_DATA_ROOT is not set" >&2
			set +e ; return 1
		}

		local bodyMode="" scriptLang="" bodyModeCount=0
		## Set below when the caller names processed-at, which overrides the move stamp.
		local callerSetProcessedAt="false"
		local headerOpsFile
		headerOpsFile="$MMDAPP/.local/temp/mdat-inbox-to-processed-headers.$$"
		mkdir -p "$MMDAPP/.local/temp" && : > "$headerOpsFile" || { set +e ; return 1 ; }
		trap 'rm -f "$headerOpsFile"' EXIT

		while [ $# -gt 0 ] ; do
			case "$1" in
				--header:*)
					local headerSpec="${1#--header:}"
					local headerOp="${headerSpec%%:*}"
					local headerRest="${headerSpec#*:}"
					local headerName headerValue
					case "$headerRest" in
						*:*) headerName="${headerRest%%:*}" ; headerValue="${headerRest#*:}" ;;
						*)   headerName="$headerRest" ; headerValue="" ;;
					esac
					if [ -z "$headerName" ] ; then
						echo "$MDSC_CMD: inbox-to-processed: ⛔ ERROR: --header:$headerOp: field name required" >&2
						set +e ; return 1
					fi
					case "$headerOp" in
						upsert|append)
							if [ -z "$headerValue" ] ; then
								echo "$MDSC_CMD: inbox-to-processed: ⛔ ERROR: --header:$headerOp:$headerName requires a value" >&2
								set +e ; return 1
							fi
							if [ "$headerName" = "approved-by" ] ; then
								if ! printf '%s' "$headerValue" | grep -Eq '^[A-Za-z][A-Za-z0-9_-]* \([^,()]+, [0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?Z\)$' ; then
									echo "$MDSC_CMD: inbox-to-processed: ⛔ ERROR: --header:$headerOp:approved-by: value must match '<team-member> (<session-id>, <date-time>)' (ISO UTC date-time, suffix Z): $headerValue" >&2
									set +e ; return 1
								fi
							fi
						;;
						remove) : ;;
						*)
							echo "$MDSC_CMD: inbox-to-processed: ⛔ ERROR: --header: unrecognized operation: $headerOp (upsert/append/remove)" >&2
							set +e ; return 1
						;;
					esac
					if [ "$headerName" = "processed-at" ] ; then
						callerSetProcessedAt="true"
					fi
					printf '%s\t%s\t%s\n' "$headerOp" "$headerName" "$headerValue" >> "$headerOpsFile"
					shift
				;;
				--upsert-from-stdin)
					bodyMode="stdin"
					bodyModeCount=$(( bodyModeCount + 1 ))
					shift
				;;
				--edit-script-from-stdin:*)
					scriptLang="${1#--edit-script-from-stdin:}"
					case "$scriptLang" in
						py|awk) ;;
						*)
							echo "$MDSC_CMD: inbox-to-processed: ⛔ ERROR: --edit-script-from-stdin must be :py or :awk: $scriptLang" >&2
							set +e ; return 1
						;;
					esac
					bodyMode="script"
					bodyModeCount=$(( bodyModeCount + 1 ))
					shift
				;;
				--edit-patch-from-stdin)
					bodyMode="patch"
					bodyModeCount=$(( bodyModeCount + 1 ))
					shift
				;;
				--context)
					if [ -z "${2:-}" ] ; then
						echo "$MDSC_CMD: inbox-to-processed: ⛔ ERROR: --context: value required" >&2
						set +e ; return 1
					fi
					shift 2
				;;
				*)
					echo "$MDSC_CMD: inbox-to-processed: ⛔ ERROR: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done

		if [ "$bodyModeCount" -gt 1 ] ; then
			echo "$MDSC_CMD: inbox-to-processed: ⛔ ERROR: --upsert-from-stdin, --edit-script-from-stdin, and --edit-patch-from-stdin are mutually exclusive" >&2
			set +e ; return 1
		fi

		local inboxBase="" inboxDirResolved=""
		inboxBase="$( cd "$MDAT_DATA_ROOT/inboxes" 2>/dev/null && pwd -P )" || inboxBase=""
		if [ -z "$inboxBase" ] ; then
			echo "$MDSC_CMD: inbox-to-processed: ⛔ ERROR: no such inbox root: $MDAT_DATA_ROOT/inboxes" >&2
			set +e ; return 1
		fi
		inboxDirResolved="$( cd "$MDAT_DATA_ROOT/inboxes/$inboxMember" 2>/dev/null && pwd -P )" || inboxDirResolved=""
		if [ -z "$inboxDirResolved" ] ; then
			echo "$MDSC_CMD: inbox-to-processed: ⛔ ERROR: no such inbox: $MDAT_DATA_ROOT/inboxes/$inboxMember" >&2
			set +e ; return 1
		fi
		case "$inboxDirResolved" in
			"$inboxBase"/*) ;;
			*)
				echo "$MDSC_CMD: inbox-to-processed: ⛔ ERROR: resolved inbox directory escapes the inbox root ($inboxBase): $inboxDirResolved" >&2
				set +e ; return 1
			;;
		esac
		local sourcePath="$inboxDirResolved/$itemName"
		if [ ! -f "$sourcePath" ] ; then
			echo "$MDSC_CMD: inbox-to-processed: ⛔ ERROR: item not found in inbox root: $sourcePath" >&2
			set +e ; return 1
		fi

		local targetDir="$inboxDirResolved/processed"
		if [ ! -d "$targetDir" ] ; then
			echo "$MDSC_CMD: inbox-to-processed: ⛔ ERROR: no such inbox processed directory: $targetDir" >&2
			set +e ; return 1
		fi
		local targetPath="$targetDir/$itemName"
		if [ -e "$targetPath" ] ; then
			echo "$MDSC_CMD: inbox-to-processed: ⛔ ERROR: processed target already exists, refusing to overwrite: $targetPath (source left in place: $sourcePath)" >&2
			set +e ; return 1
		fi

		local body
		if [ "$bodyMode" = "script" ] ; then
			local scriptContent existingContent scriptFile
			scriptContent="$( cat )"
			existingContent="$( cat "$sourcePath" )"
			scriptFile="$MMDAPP/.local/temp/mdat-inbox-to-processed-script.$$"
			mkdir -p "$MMDAPP/.local/temp" && : > "$scriptFile" || { set +e ; return 1 ; }
			printf '%s' "$scriptContent" > "$scriptFile"
			case "$scriptLang" in
				py)  body="$( printf '%s\n' "$existingContent" | python3 "$scriptFile" )" ;;
				awk) body="$( printf '%s\n' "$existingContent" | LC_ALL=C awk -f "$scriptFile" )" ;;
			esac
			rm -f "$scriptFile"
		elif [ "$bodyMode" = "stdin" ] ; then
			body="$( cat )"
		elif [ "$bodyMode" = "patch" ] ; then
			local patchJson existingContent
			patchJson="$( cat )"
			existingContent="$( cat "$sourcePath" )"
			body="$( printf '%s%s' "$patchJson" "$existingContent" | python3 "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsBoardItemPatchApply.py" )"
		else
			body="$( cat "$sourcePath" )"
		fi

		## Move stamp: this op's target state is fixed in its own name. Contract: MAGIC.md.
		if [ "$callerSetProcessedAt" = "false" ] ; then
			local probeState
			probeState="$( printf '%s\n' "$body" | LC_ALL=C awk -v fieldName=processed-at -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsBoardItemFrontmatterFieldProbe.awk" )" || probeState=""
			## `|| ...` because this file runs under `set -e`: a bare capture aborts the op instead of returning through its own error path.
			if [ "$probeState" = "FRONTMATTER" ] ; then
				local processedAt ; processedAt="$( date +"%Y-%m-%d %H:%M %z" )"
				printf '%s\t%s\t%s\n' upsert processed-at "$processedAt" >> "$headerOpsFile"
			fi
		fi

		if [ -s "$headerOpsFile" ] ; then
			body="$( printf '%s\n' "$body" | LC_ALL=C awk -v opsFile="$headerOpsFile" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsBoardItemHeaderOpsApply.awk" )" || { rm -f "$headerOpsFile" ; set +e ; return 1 ; }
		fi

		if [ -z "$body" ] ; then
			echo "$MDSC_CMD: inbox-to-processed: ⛔ ERROR: empty result -- refusing to write an empty inbox item" >&2
			set +e ; return 1
		fi

		local tmpFile
		tmpFile="$MMDAPP/.local/temp/mdat-inbox-to-processed-result.$$"
		mkdir -p "$MMDAPP/.local/temp" && : > "$tmpFile" || { set +e ; return 1 ; }
		printf '%s\n' "$body" > "$tmpFile"
		mv "$tmpFile" "$targetPath"

		## Commit gate: .git presence in the team-data root, presence only --
		## this op never pushes. Mirrors --intern-op-board-upsert-move-edit's
		## both-ends move commit. Tracked-state is read before the source is
		## removed: git add on a vanished untracked path would fail the op
		## after the move already happened.
		local repoRoot="" sourceTracked="false"
		repoRoot="$( git -C "$MDAT_DATA_ROOT" rev-parse --show-toplevel 2>/dev/null )" || repoRoot=""
		if [ -n "$repoRoot" ] ; then
			[ -z "$( git -C "$repoRoot" ls-files -- "$sourcePath" 2>/dev/null )" ] || sourceTracked="true"
		fi

		## `--` guards a later edit that bypasses validation.
		rm -f -- "$sourcePath"
		echo "# $MDSC_CMD: inbox-to-processed: wrote ${targetPath#"$inboxDirResolved"/}, previous ${sourcePath#"$inboxDirResolved"/} deleted" >&2

		## Both ends of the move in one commit: the processed/ copy that now
		## holds the item, and the source whose removal git must record.
		if [ -n "$repoRoot" ] ; then
			local ctxForMsg="$opContext"
			if [ "$ctxForMsg" = "<no --context given>" ] ; then ctxForMsg="--intern-op-inbox-to-processed" ; fi
			local commitPaths=( "$targetPath" )
			[ "$sourceTracked" = "true" ] && commitPaths+=( "$sourcePath" )
			local gitOut="" gitRc=0
			gitOut="$( git -C "$repoRoot" add -- "${commitPaths[@]}" 2>&1 )" || gitRc=$?
			if [ "$gitRc" -ne 0 ] ; then
				echo "$MDSC_CMD: inbox-to-processed: ⛔ ERROR: git add failed for ${commitPaths[*]}: $gitOut" >&2
				rm -f "$headerOpsFile" ; trap - EXIT ; set +e ; return 1
			fi
			gitOut="$( git -C "$repoRoot" commit -m "* processed: $ctxForMsg" -- "${commitPaths[@]}" 2>&1 )" || gitRc=$?
			if [ "$gitRc" -ne 0 ] ; then
				echo "$MDSC_CMD: inbox-to-processed: ⛔ ERROR: git commit failed for ${commitPaths[*]}: $gitOut" >&2
				rm -f "$headerOpsFile" ; trap - EXIT ; set +e ; return 1
			fi
			echo "# $MDSC_CMD: inbox-to-processed: committed ${targetPath#"$MDAT_DATA_ROOT"/}" >&2
		fi

		rm -f "$headerOpsFile"
		trap - EXIT
		return 0
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
