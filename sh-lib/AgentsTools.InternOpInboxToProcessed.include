#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.InternOpInboxToProcessed.include -- the
## --intern-op-inbox-to-processed op for DistroAgentsTools.fn.sh's
## dispatcher. Sourced lazily from that exact op's own dispatcher arm (not a
## wildcard -- one intern-op primitive per file, same convention as
## AgentsTools.InternOpBoardUpsertMoveEdit.include / InternOpBoardTrash.include
## / InternOpBoardRename.include) via the standard $MDLT_ORIGIN-based path.
## Not standalone: relies on being dot-sourced for $1/$@/$MDSC_CMD.
##
## No --help entry: internal plumbing, called by --librarian-inbox-to-processed.
##
## Fills the one gap those two intern-ops don't cover: neither
## --intern-op-board-upsert-move-edit's --from-inbox: source (reads
## inboxes/<member>/processed/, writes board/<state>/) nor
## --intern-op-board-trash's --from-inbox: source (reads
## inboxes/<member>/processed/, writes trash/) can move an item OUT of a
## member's live inbox/ ROOT -- both already assume processed/ as the
## starting point. This op is that missing first step:
## inboxes/<member>/<item-filename> (root) -> inboxes/<member>/processed/<item-filename>.
##
## Body/header mechanics deliberately mirror
## AgentsTools.InternOpBoardUpsertMoveEdit.include's own --from-inbox arm as
## closely as the different source/target allow -- same three mutually
## exclusive body-input modes, same --header:* upsert/append/remove parsing
## (including approved-by's shape check), same externalized
## AgentsBoardItemHeaderOpsApply.awk / AgentsBoardItemPatchApply.py, same
## atomic mv-into-place. One deliberate difference: the target directory is
## not caller-supplied (there is exactly one destination -- this member's own
## inboxes/<member>/processed/), so there is no <to-state> positional and no
## board-state whitelist here.
##
## Old-source handling ALSO mirrors the --from-inbox sibling: once the new
## content is written to inboxes/<member>/processed/<item-filename>, the
## ORIGINAL root file is `mv`'d to trash/ (a standalone sibling of board/,
## not one of its own states) rather than removed outright -- not destroyed,
## just relocated, same "leaves a copy in trash/ too" shape
## --librarian-inbox-to-retained's own header comment documents for its
## sibling.
##

case "$1" in

	## <member> <item-filename>
	##   [--header:<upsert|append|remove>:name[:value]]...
	##   [--upsert-from-stdin|--edit-script-from-stdin:<py|awk>|--edit-patch-from-stdin]
	##
	## Source: inboxes/<member>/<item-filename> (the live inbox ROOT --
	## never processed/, trash/, or any other subdirectory). Target:
	## inboxes/<member>/processed/<item-filename>.
	##
	## Body resolution identical to
	## AgentsTools.InternOpBoardUpsertMoveEdit.include's own: none of the
	## three modes given means the body is the existing (root) file's
	## content, unchanged. --header:* ops apply on top, in the order given.
	--intern-op-inbox-to-processed)
		shift
		## --context <caller-op>: see
		## AgentsTools.InternOpBoardUpsertMoveEdit.include's own copy of this
		## block for the full reasoning. Pre-scanned before any validation so
		## every message here can name the invoking operation.
		local opContext="<no --context given>"
		local ctxWanted="" ctxArg
		for ctxArg in "$@" ; do
			if [ -n "$ctxWanted" ] ; then
				opContext="$ctxArg" ; ctxWanted="" ; continue
			fi
			if [ "$ctxArg" = "--context" ] ; then ctxWanted="1" ; fi
		done

		local inboxMember="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$inboxMember" ] || [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-op-inbox-to-processed (internal operation, invoked via $opContext): syntax is <member> <item-filename> [--header:<upsert|append|remove>:name[:value]]... [--upsert-from-stdin|--edit-script-from-stdin:<py|awk>|--edit-patch-from-stdin]" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$inboxMember" "<member>" "$MDSC_CMD --intern-op-inbox-to-processed (internal operation, invoked via $opContext)" || { set +e ; return 1 ; }
		AgentsToolsAssertBareName "$itemName" "<item-filename>" "$MDSC_CMD --intern-op-inbox-to-processed (internal operation, invoked via $opContext)" || { set +e ; return 1 ; }
		case "$itemName" in
			*.md) ;;
			*)
				echo "⛔ ERROR: $MDSC_CMD --intern-op-inbox-to-processed (internal operation, invoked via $opContext): <item-filename> must end in .md -- every inbox item is a markdown document: $itemName" >&2
				set +e ; return 1
			;;
		esac

		[ -n "${MDAT_DATA_ROOT:-}" ] || {
			echo "⛔ ERROR: $MDSC_CMD --intern-op-inbox-to-processed (internal operation, invoked via $opContext): MDAT_DATA_ROOT is not set" >&2
			set +e ; return 1
		}

		local bodyMode="" scriptLang="" bodyModeCount=0
		local headerOpsFile
		headerOpsFile="$( mktemp "${TMPDIR:-/tmp}/mdat-intern-op-headers.XXXXXX" )" || { set +e ; return 1 ; }
		trap 'rm -f "$headerOpsFile"' EXIT

		while [ $# -gt 0 ] ; do
			case "$1" in
				--header:*)
					local headerSpec="${1#--header:}"
					local headerOp="${headerSpec%%:*}"
					local headerRest="${headerSpec#*:}"
					local headerName headerValue
					case "$headerRest" in
						*:*) headerName="${headerRest%%:*}" ; headerValue="${headerRest#*:}" ;;
						*)   headerName="$headerRest" ; headerValue="" ;;
					esac
					if [ -z "$headerName" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --intern-op-inbox-to-processed (internal operation, invoked via $opContext): --header:$headerOp: field name required" >&2
						set +e ; return 1
					fi
					case "$headerOp" in
						upsert|append)
							if [ -z "$headerValue" ] ; then
								echo "⛔ ERROR: $MDSC_CMD --intern-op-inbox-to-processed (internal operation, invoked via $opContext): --header:$headerOp:$headerName requires a value" >&2
								set +e ; return 1
							fi
							## approved-by's required shape -- same check,
							## same reasoning, as
							## AgentsTools.InternOpBoardUpsertMoveEdit.include's
							## own copy: not duplicated policy, a fact about
							## the field itself.
							if [ "$headerName" = "approved-by" ] ; then
								if ! printf '%s' "$headerValue" | grep -Eq '^[A-Za-z][A-Za-z0-9_-]* \([^,()]+, [0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?Z\)$' ; then
									echo "⛔ ERROR: $MDSC_CMD --intern-op-inbox-to-processed (internal operation, invoked via $opContext): --header:$headerOp:approved-by: value must match '<team-member> (<session-id>, <date-time>)' (ISO UTC date-time, suffix Z): $headerValue" >&2
									set +e ; return 1
								fi
							fi
						;;
						remove) : ;;
						*)
							echo "⛔ ERROR: $MDSC_CMD --intern-op-inbox-to-processed (internal operation, invoked via $opContext): --header: unrecognized operation: $headerOp (upsert/append/remove)" >&2
							set +e ; return 1
						;;
					esac
					printf '%s\t%s\t%s\n' "$headerOp" "$headerName" "$headerValue" >> "$headerOpsFile"
					shift
				;;
				--upsert-from-stdin)
					bodyMode="stdin"
					bodyModeCount=$(( bodyModeCount + 1 ))
					shift
				;;
				--edit-script-from-stdin:*)
					scriptLang="${1#--edit-script-from-stdin:}"
					case "$scriptLang" in
						py|awk) ;;
						*)
							echo "⛔ ERROR: $MDSC_CMD --intern-op-inbox-to-processed (internal operation, invoked via $opContext): --edit-script-from-stdin must be :py or :awk: $scriptLang" >&2
							set +e ; return 1
						;;
					esac
					bodyMode="script"
					bodyModeCount=$(( bodyModeCount + 1 ))
					shift
				;;
				--edit-patch-from-stdin)
					bodyMode="patch"
					bodyModeCount=$(( bodyModeCount + 1 ))
					shift
				;;
				--context)
					if [ -z "${2:-}" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --intern-op-inbox-to-processed (internal operation, invoked via $opContext): --context: value required" >&2
						set +e ; return 1
					fi
					shift 2
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --intern-op-inbox-to-processed (internal operation, invoked via $opContext): invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done

		## Three-way check via a counter, same idiom as
		## AgentsTools.InternOpBoardUpsertMoveEdit.include's own copy -- a
		## pairwise scriptLang/bodyMode comparison only catches one of the
		## six possible orderings across three flags.
		if [ "$bodyModeCount" -gt 1 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-op-inbox-to-processed (internal operation, invoked via $opContext): --upsert-from-stdin, --edit-script-from-stdin, and --edit-patch-from-stdin are mutually exclusive" >&2
			set +e ; return 1
		fi

		##
		## Source resolution. Root of the member's inbox ONLY -- never
		## processed/, trash/, or any other subdirectory. `cd` + `pwd -P`
		## rather than `realpath` (not POSIX) or `readlink -f` (absent on
		## macOS before Monterey) -- same idiom as the --from-inbox: sources
		## in AgentsTools.InternOpBoardUpsertMoveEdit.include /
		## AgentsTools.InternOpBoardTrash.include.
		##
		local inboxBase="" inboxDirResolved=""
		inboxBase="$( cd "$MDAT_DATA_ROOT/inboxes" 2>/dev/null && pwd -P )" || inboxBase=""
		if [ -z "$inboxBase" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-op-inbox-to-processed (internal operation, invoked via $opContext): no such inbox root: $MDAT_DATA_ROOT/inboxes" >&2
			set +e ; return 1
		fi
		inboxDirResolved="$( cd "$MDAT_DATA_ROOT/inboxes/$inboxMember" 2>/dev/null && pwd -P )" || inboxDirResolved=""
		if [ -z "$inboxDirResolved" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-op-inbox-to-processed (internal operation, invoked via $opContext): no such inbox: $MDAT_DATA_ROOT/inboxes/$inboxMember" >&2
			set +e ; return 1
		fi
		## Containment tested WITH the separator -- "$inboxBase"/* , never a
		## bare "$inboxBase"* prefix. Same reasoning as both sibling
		## intern-ops' own copy of this check.
		case "$inboxDirResolved" in
			"$inboxBase"/*) ;;
			*)
				echo "⛔ ERROR: $MDSC_CMD --intern-op-inbox-to-processed (internal operation, invoked via $opContext): resolved inbox directory escapes the inbox root ($inboxBase): $inboxDirResolved" >&2
				set +e ; return 1
			;;
		esac
		local sourcePath="$inboxDirResolved/$itemName"
		if [ ! -f "$sourcePath" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-op-inbox-to-processed (internal operation, invoked via $opContext): item not found in inbox root: $sourcePath" >&2
			set +e ; return 1
		fi

		local targetDir="$inboxDirResolved/processed"
		if [ ! -d "$targetDir" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-op-inbox-to-processed (internal operation, invoked via $opContext): no such inbox processed directory: $targetDir" >&2
			set +e ; return 1
		fi
		local targetPath="$targetDir/$itemName"
		if [ -e "$targetPath" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-op-inbox-to-processed (internal operation, invoked via $opContext): processed target already exists, refusing to overwrite: $targetPath (source left in place: $sourcePath)" >&2
			set +e ; return 1
		fi

		## Pre-flight trash-collision refusal, same reasoning as
		## AgentsTools.InternOpBoardUpsertMoveEdit.include's own copy: check
		## BEFORE any write, so a collision aborts with the tree exactly as
		## it was found rather than with the item duplicated.
		if [ -e "$MDAT_DATA_ROOT/trash/$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-op-inbox-to-processed (internal operation, invoked via $opContext): trash target already exists, refusing to overwrite: $MDAT_DATA_ROOT/trash/$itemName (nothing written; source left in place)" >&2
			set +e ; return 1
		fi

		local body
		if [ "$bodyMode" = "script" ] ; then
			local scriptContent existingContent scriptFile
			scriptContent="$( cat )"
			existingContent="$( cat "$sourcePath" )"
			scriptFile="$( mktemp "${TMPDIR:-/tmp}/mdat-intern-op-script.XXXXXX" )" || { set +e ; return 1 ; }
			printf '%s' "$scriptContent" > "$scriptFile"
			case "$scriptLang" in
				py)  body="$( printf '%s\n' "$existingContent" | python3 "$scriptFile" )" ;;
				awk) body="$( printf '%s\n' "$existingContent" | LC_ALL=C awk -f "$scriptFile" )" ;;
			esac
			rm -f "$scriptFile"
		elif [ "$bodyMode" = "stdin" ] ; then
			body="$( cat )"
		elif [ "$bodyMode" = "patch" ] ; then
			local patchJson existingContent contentFile patchFile
			patchJson="$( cat )"
			existingContent="$( cat "$sourcePath" )"
			contentFile="$( mktemp "${TMPDIR:-/tmp}/mdat-intern-op-patch-content.XXXXXX" )" || { set +e ; return 1 ; }
			patchFile="$( mktemp "${TMPDIR:-/tmp}/mdat-intern-op-patch-spec.XXXXXX" )" || { set +e ; return 1 ; }
			printf '%s' "$existingContent" > "$contentFile"
			printf '%s' "$patchJson" > "$patchFile"
			body="$( python3 "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsBoardItemPatchApply.py" "$contentFile" "$patchFile" )"
			rm -f "$contentFile" "$patchFile"
		else
			body="$( cat "$sourcePath" )"
		fi

		if [ -s "$headerOpsFile" ] ; then
			body="$( printf '%s\n' "$body" | LC_ALL=C awk -v opsFile="$headerOpsFile" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsBoardItemHeaderOpsApply.awk" )" || { rm -f "$headerOpsFile" ; set +e ; return 1 ; }
		fi

		if [ -z "$body" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-op-inbox-to-processed (internal operation, invoked via $opContext): empty result -- refusing to write an empty inbox item" >&2
			set +e ; return 1
		fi

		local tmpFile
		tmpFile="$( mktemp "${TMPDIR:-/tmp}/mdat-intern-op-result.XXXXXX" )" || { set +e ; return 1 ; }
		printf '%s\n' "$body" > "$tmpFile"
		mv "$tmpFile" "$targetPath"

		##
		## HAZARD: trash/ is FLAT and `mv` has no -n, so a basename
		## collision overwrites silently, exit 0, no diagnostic -- same
		## hazard AgentsTools.InternOpBoardUpsertMoveEdit.include's own
		## --from-inbox arm documents. Re-checked here (not just in the
		## pre-flight above) because the pre-flight predicate depends on
		## nothing the write produces, but a file could in principle appear
		## in trash/ during the write itself; neither check subsumes the
		## other. `--` before the operands is independent of that: guards a
		## later edit that bypasses validation.
		##
		if [ -e "$MDAT_DATA_ROOT/trash/$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-op-inbox-to-processed (internal operation, invoked via $opContext): trash target already exists, refusing to overwrite: $MDAT_DATA_ROOT/trash/$itemName (new item already written to $targetPath; source left in place: $sourcePath)" >&2
			set +e ; return 1
		fi
		mv -- "$sourcePath" "$MDAT_DATA_ROOT/trash/$itemName"
		echo "# $MDSC_CMD --intern-op-inbox-to-processed: wrote $targetPath, previous $sourcePath moved to $MDAT_DATA_ROOT/trash/$itemName" >&2

		rm -f "$headerOpsFile"
		trap - EXIT
		return 0
	;;

	*)
		echo "⛔ ERROR: $MDSC_CMD: invalid option: $1 (invoked via $opContext) -- rejected by AgentsTools.InternOpInboxToProcessed.include's own default (*) branch, the operation group sourced by the --intern-op-inbox-to-processed dispatcher route; no operation of that name is defined in this include" >&2
		set +e ; return 1
	;;
esac
