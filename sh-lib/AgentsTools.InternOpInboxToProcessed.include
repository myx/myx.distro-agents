#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.InternOpInboxToProcessed.include -- the
## --intern-op-inbox-to-processed op for DistroAgentsTools.fn.sh's
## dispatcher. Sourced lazily from that exact op's own dispatcher arm
## Not standalone: relies on being dot-sourced for $1/$@/$MDSC_CMD.
##
## Marks one inbox item handled IN PLACE: stamps `processed-at` into its own
## frontmatter (creating the block when it has none) and commits the item. The
## item stays in the inbox root; readers drop marked items from their active
## scopes and the GC collects them once the stamp is older than the type
## retention. Nothing is moved: the per-member processed/ folder is legacy,
## read-only, and drained by the GC. Contract: MAGIC.md.
##

. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.OutputStyle.include"

case "$1" in

	--intern-op-inbox-to-processed)
		shift
		local opContext="<no --context given>"
		local ctxWanted="" ctxArg
		for ctxArg in "$@" ; do
			if [ -n "$ctxWanted" ] ; then
				opContext="$ctxArg" ; ctxWanted="" ; continue
			fi
			if [ "$ctxArg" = "--context" ] ; then ctxWanted="1" ; fi
		done

		local inboxMember="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$inboxMember" ] || [ -z "$itemName" ] ; then
			echo "$MDSC_CMD: inbox-to-processed: ⛔ ERROR: syntax is <member> <item-filename> [--header:<upsert|append|remove>:name[:value]]... [--upsert-from-stdin|--edit-script-from-stdin:<py|awk>|--edit-patch-from-stdin]" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$inboxMember" "<member>" inbox-to-processed || { set +e ; return 1 ; }
		AgentsToolsAssertBareName "$itemName" "<item-filename>" inbox-to-processed || { set +e ; return 1 ; }
		case "$itemName" in
			*.md) ;;
			*)
				echo "$MDSC_CMD: inbox-to-processed: ⛔ ERROR: <item-filename> must end in .md -- every inbox item is a markdown document: $itemName" >&2
				set +e ; return 1
			;;
		esac

		[ -n "${MDAT_DATA_ROOT:-}" ] || {
			echo "$MDSC_CMD: inbox-to-processed: ⛔ ERROR: MDAT_DATA_ROOT is not set" >&2
			set +e ; return 1
		}

		local bodyMode="" scriptLang="" bodyModeCount=0
		## Set below when the caller names processed-at, which overrides the tool's stamp.
		local callerSetProcessedAt="false"
		## Header ops accumulate here and are materialised once, immediately before
		## the .awk that reads them by path -- so no early return can leak a file.
		local headerOps=""

		while [ $# -gt 0 ] ; do
			case "$1" in
				--header:*)
					local headerSpec="${1#--header:}"
					local headerOp="${headerSpec%%:*}"
					local headerRest="${headerSpec#*:}"
					local headerName headerValue
					case "$headerRest" in
						*:*) headerName="${headerRest%%:*}" ; headerValue="${headerRest#*:}" ;;
						*)   headerName="$headerRest" ; headerValue="" ;;
					esac
					if [ -z "$headerName" ] ; then
						echo "$MDSC_CMD: inbox-to-processed: ⛔ ERROR: --header:$headerOp: field name required" >&2
						set +e ; return 1
					fi
					case "$headerOp" in
						upsert|append)
							if [ -z "$headerValue" ] ; then
								echo "$MDSC_CMD: inbox-to-processed: ⛔ ERROR: --header:$headerOp:$headerName requires a value" >&2
								set +e ; return 1
							fi
							if [ "$headerName" = "approved-by" ] ; then
								if ! printf '%s' "$headerValue" | grep -Eq '^[A-Za-z][A-Za-z0-9_-]* \([^,()]+, [0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?Z\)$' ; then
									echo "$MDSC_CMD: inbox-to-processed: ⛔ ERROR: --header:$headerOp:approved-by: value must match '<team-member> (<session-id>, <date-time>)' (ISO UTC date-time, suffix Z): $headerValue" >&2
									set +e ; return 1
								fi
							fi
						;;
						remove) : ;;
						*)
							echo "$MDSC_CMD: inbox-to-processed: ⛔ ERROR: --header: unrecognized operation: $headerOp (upsert/append/remove)" >&2
							set +e ; return 1
						;;
					esac
					if [ "$headerName" = "processed-at" ] ; then
						callerSetProcessedAt="true"
					fi
					headerOps="$headerOps$headerOp"$'\t'"$headerName"$'\t'"$headerValue"$'\n'
					shift
				;;
				--upsert-from-stdin)
					bodyMode="stdin"
					bodyModeCount=$(( bodyModeCount + 1 ))
					shift
				;;
				--edit-script-from-stdin:*)
					scriptLang="${1#--edit-script-from-stdin:}"
					case "$scriptLang" in
						py|awk) ;;
						*)
							echo "$MDSC_CMD: inbox-to-processed: ⛔ ERROR: --edit-script-from-stdin must be :py or :awk: $scriptLang" >&2
							set +e ; return 1
						;;
					esac
					bodyMode="script"
					bodyModeCount=$(( bodyModeCount + 1 ))
					shift
				;;
				--edit-patch-from-stdin)
					bodyMode="patch"
					bodyModeCount=$(( bodyModeCount + 1 ))
					shift
				;;
				--context)
					if [ -z "${2:-}" ] ; then
						echo "$MDSC_CMD: inbox-to-processed: ⛔ ERROR: --context: value required" >&2
						set +e ; return 1
					fi
					shift 2
				;;
				*)
					echo "$MDSC_CMD: inbox-to-processed: ⛔ ERROR: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done

		if [ "$bodyModeCount" -gt 1 ] ; then
			echo "$MDSC_CMD: inbox-to-processed: ⛔ ERROR: --upsert-from-stdin, --edit-script-from-stdin, and --edit-patch-from-stdin are mutually exclusive" >&2
			set +e ; return 1
		fi

		local inboxBase="" inboxDirResolved=""
		inboxBase="$( cd "$MDAT_DATA_ROOT/inboxes" 2>/dev/null && pwd -P )" || inboxBase=""
		if [ -z "$inboxBase" ] ; then
			echo "$MDSC_CMD: inbox-to-processed: ⛔ ERROR: no such inbox root: $MDAT_DATA_ROOT/inboxes" >&2
			set +e ; return 1
		fi
		inboxDirResolved="$( cd "$MDAT_DATA_ROOT/inboxes/$inboxMember" 2>/dev/null && pwd -P )" || inboxDirResolved=""
		if [ -z "$inboxDirResolved" ] ; then
			echo "$MDSC_CMD: inbox-to-processed: ⛔ ERROR: no such inbox: $MDAT_DATA_ROOT/inboxes/$inboxMember" >&2
			set +e ; return 1
		fi
		case "$inboxDirResolved" in
			"$inboxBase"/*) ;;
			*)
				echo "$MDSC_CMD: inbox-to-processed: ⛔ ERROR: resolved inbox directory escapes the inbox root ($inboxBase): $inboxDirResolved" >&2
				set +e ; return 1
			;;
		esac
		local sourcePath="$inboxDirResolved/$itemName"
		if [ ! -f "$sourcePath" ] ; then
			## Legacy layout: items drained before the in-place marker sit in
			## processed/ until the GC collects them. They are already handled, so a
			## plain re-mark succeeds as a no-op; an edit is refused -- that folder is
			## read-only now and nothing new is ever written into it.
			if [ -f "$inboxDirResolved/processed/$itemName" ] ; then
				if [ -z "$headerOps" ] && [ -z "$bodyMode" ] ; then
					echo "# $MDSC_CMD: inbox-to-processed: $itemName already processed (legacy processed/), nothing to do" >&2
					return 0
				fi
				echo "$MDSC_CMD: inbox-to-processed: ⛔ ERROR: $itemName sits in the legacy processed/ folder, which is read-only -- it is already processed and cannot be edited: $inboxDirResolved/processed/$itemName" >&2
				set +e ; return 1
			fi
			echo "$MDSC_CMD: inbox-to-processed: ⛔ ERROR: item not found in inbox root: $sourcePath" >&2
			set +e ; return 1
		fi

		## Already marked: the item keeps its original processed-at (it is the GC's
		## retention clock), and a plain re-mark is a successful no-op -- no write,
		## no commit. Edits still apply to an already-marked item.
		local existingProcessedAt="" existingMarked="false" existingLine=""
		existingLine="$( LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsInboxProcessedAtList.awk" "$sourcePath" )" || existingLine=""
		## `|| ...` because this file runs under `set -e`: a bare capture aborts the op instead of returning through its own error path.
		if [ -n "$existingLine" ] ; then
			existingMarked="true"
			existingProcessedAt="${existingLine#*$'\t'}"
		fi
		if [ "$existingMarked" = "true" ] && [ -z "$headerOps" ] && [ -z "$bodyMode" ] ; then
			echo "# $MDSC_CMD: inbox-to-processed: $itemName already processed (processed-at: $existingProcessedAt), nothing to do" >&2
			return 0
		fi

		local body
		if [ "$bodyMode" = "script" ] ; then
			## Both interpreters take the program as an argument, so the script
			## read from stdin never becomes a file.
			local scriptContent existingContent
			scriptContent="$( cat )"
			existingContent="$( cat "$sourcePath" )"
			case "$scriptLang" in
				py)  body="$( printf '%s\n' "$existingContent" | python3 -c "$scriptContent" )" ;;
				awk) body="$( printf '%s\n' "$existingContent" | LC_ALL=C awk "$scriptContent" )" ;;
			esac
		elif [ "$bodyMode" = "stdin" ] ; then
			body="$( cat )"
			## Measured, never refused. Only this branch carries the caller's own
			## new text: script and patch derive a body from content somebody else
			## wrote, and a plain mark only adds the stamp.
			printf '%s' "$body" | AgentsToolsOutputStyleRefusal "$inboxMember" "" "$itemName" "" none || :
		elif [ "$bodyMode" = "patch" ] ; then
			local patchJson existingContent
			patchJson="$( cat )"
			existingContent="$( cat "$sourcePath" )"
			body="$( printf '%s%s' "$patchJson" "$existingContent" | python3 "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsBoardItemPatchApply.py" )"
		else
			body="$( cat "$sourcePath" )"
		fi

		## The processed marker: this op's whole effect is fixed in its own name.
		## Contract: MAGIC.md. A `default` op, so it never overrides a processed-at
		## the resulting body already carries, and the header awk creates the
		## frontmatter block when the item has none. An item already marked keeps
		## its original time even when an edit body dropped the field.
		if [ "$callerSetProcessedAt" = "false" ] ; then
			local stampValue="$existingProcessedAt"
			[ -n "$stampValue" ] || stampValue="$( date +"%Y-%m-%d %H:%M %z" )"
			headerOps="${headerOps}default"$'\t'"processed-at"$'\t'"$stampValue"$'\n'
		fi

		## The ops file has to be a real path -- it is the awk's own `-v opsFile=`
		## input. It is created inside this substitution's own subshell, so its
		## trap is that subshell's and can never disarm the caller's, and the trap
		## is armed before the file exists, so every exit from the block removes
		## it: a failed mkdir or write, a failed awk, or a signal.
		if [ -n "$headerOps" ] ; then
			body="$(
				headerOpsFile="$MMDAPP/.local/temp/mdat-inbox-to-processed-headers.$$"
				trap 'rm -f "$headerOpsFile"' EXIT
				mkdir -p "$MMDAPP/.local/temp" || exit 1
				printf '%s' "$headerOps" > "$headerOpsFile" || exit 1
				printf '%s\n' "$body" | LC_ALL=C awk -v opsFile="$headerOpsFile" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsBoardItemHeaderOpsApply.awk"
			)" || { set +e ; return 1 ; }
		fi

		if [ -z "$body" ] ; then
			echo "$MDSC_CMD: inbox-to-processed: ⛔ ERROR: empty result -- refusing to write an empty inbox item" >&2
			set +e ; return 1
		fi

		## In place, through a sibling temp file and a rename, so a failed write
		## never leaves a half-written item. The temp name is a dotfile not ending
		## in .md, so no `*.md` inbox scan can ever see it.
		local tempPath="$inboxDirResolved/.$itemName.inbox-to-processed.$$"
		if ! printf '%s\n' "$body" > "$tempPath" || ! mv -f -- "$tempPath" "$sourcePath" ; then
			rm -f -- "$tempPath"
			echo "$MDSC_CMD: inbox-to-processed: ⛔ ERROR: could not write the marked item: $sourcePath" >&2
			set +e ; return 1
		fi
		echo "# $MDSC_CMD: inbox-to-processed: marked ${sourcePath#"$inboxDirResolved"/} processed in place" >&2

		## Commit gate: .git presence in the team-data root, presence only --
		## this op never pushes. One path: the item itself, edited in place.
		local repoRoot=""
		repoRoot="$( git -C "$MDAT_DATA_ROOT" rev-parse --show-toplevel 2>/dev/null )" || repoRoot=""
		if [ -n "$repoRoot" ] ; then
			local ctxForMsg="$opContext"
			if [ "$ctxForMsg" = "<no --context given>" ] ; then ctxForMsg="--intern-op-inbox-to-processed" ; fi
			local commitPaths=( "$sourcePath" )
			local gitOut="" gitRc=0
			gitOut="$( git -C "$repoRoot" add -- "${commitPaths[@]}" 2>&1 )" || gitRc=$?
			if [ "$gitRc" -ne 0 ] ; then
				echo "$MDSC_CMD: inbox-to-processed: ⛔ ERROR: git add failed for ${commitPaths[*]}: $gitOut" >&2
				set +e ; return 1
			fi
			## An edit of an already-marked item can leave the bytes as they were;
			## a commit of nothing would fail the op after a successful write.
			if git -C "$repoRoot" diff --cached --quiet -- "${commitPaths[@]}" 2>/dev/null ; then
				echo "# $MDSC_CMD: inbox-to-processed: ${sourcePath#"$MDAT_DATA_ROOT"/} unchanged, nothing to commit" >&2
				return 0
			fi
			gitOut="$( git -C "$repoRoot" commit -m "* processed: $ctxForMsg" -- "${commitPaths[@]}" 2>&1 )" || gitRc=$?
			if [ "$gitRc" -ne 0 ] ; then
				echo "$MDSC_CMD: inbox-to-processed: ⛔ ERROR: git commit failed for ${commitPaths[*]}: $gitOut" >&2
				set +e ; return 1
			fi
			echo "# $MDSC_CMD: inbox-to-processed: committed ${sourcePath#"$MDAT_DATA_ROOT"/}" >&2
		fi

		return 0
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
