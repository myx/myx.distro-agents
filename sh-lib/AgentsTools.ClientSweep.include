#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.ClientSweep.include -- the --client-sweep-* operation group for
## DistroAgentsTools.fn.sh's dispatcher. Sourced lazily from the
## `--client-sweep-*)` wildcard arm via the standard $MDLT_ORIGIN-based path.
## Not standalone: relies on being dot-sourced for $1/$@/$MDSC_CMD.
##

case "$1" in

	--client-sweep-input-scan)
		shift
		local clientMember="$1"
		shift || true
		if [ -z "$clientMember" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --client-sweep-input-scan: syntax is <client-* member> [--comms-since-date-time <value>|--comms-since-utime <value>]" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$clientMember" "<team-member>" client-sweep-input-scan || { set +e ; return 1 ; }

		local clientKind=""
		case "$clientMember" in
			client-*)  clientKind="client" ;;
			*)
				echo "⛔ ERROR: $MDSC_CMD --client-sweep-input-scan: this operation reads one external member's own accounts and labels the whole document as that member's, so it runs only as a client-* member: $clientMember" >&2
				set +e ; return 1
			;;
		esac

		local commsCutoffArgs=()
		while [ $# -gt 0 ] ; do
			case "$1" in
				--comms-since-date-time|--comms-since-utime)
					if [ -z "${2:-}" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --client-sweep-input-scan: $1: value required" >&2
						set +e ; return 1
					fi
					if [ ${#commsCutoffArgs[@]} -gt 0 ] ; then
						echo "⛔ ERROR: $MDSC_CMD --client-sweep-input-scan: --comms-since-date-time and --comms-since-utime are mutually exclusive, and neither is repeatable -- one cut-off, one spelling" >&2
						set +e ; return 1
					fi
					commsCutoffArgs=( "$1" "$2" )
					shift 2
				;;
				--*)
					echo "⛔ ERROR: $MDSC_CMD --client-sweep-input-scan: invalid option: $1 -- syntax is <client-* member> [--comms-since-date-time <value>|--comms-since-utime <value>] -- an input-scan reads all baseline-relevant items itself. SEE $HOME/.claude/skills/magic-team/magic-team.shared.md" >&2
					set +e ; return 1
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --client-sweep-input-scan: syntax is <client-* member> [--comms-since-date-time <value>|--comms-since-utime <value>] -- an input-scan reads all baseline-relevant items itself, an item name is not a parameter. SEE $HOME/.claude/skills/magic-team/magic-team.shared.md" >&2
					set +e ; return 1
				;;
			esac
		done

		printf '# Incoming Communications Sweep -- %s\n\n' "$clientMember"
		printf 'member: %s\n' "$clientMember"
		printf 'member-kind: %s\n' "$clientKind"
		printf 'scope: this member'"'"'s own COMMS sources only -- its own credentials, its own configured sources; no team-scoped comms source and no team credential is read here. Board items and inbox items below are this member'"'"'s own, by owner and by inbox\n\n'

		DistroAgentsTools --client-sweep-config-check "$clientMember" || true
		printf '\n'

		DistroAgentsTools --intern-op-session-context-scan "$clientMember" \
			--state backlog --state pending --state running --state blocked \
			--all-types --filter-owner "$clientMember" \
			--do-inbox-inquiry-active --do-inbox-reflections \
			--do-inbox-notes --do-inbox-other \
			--comms-do-all --comms-member-scope-only "${commsCutoffArgs[@]}" \
			--context --client-sweep-input-scan
		return $?
	;;

	## What an external member must hold for its own sweep to mean anything.
	## Declared here by the stub; the intern-op infers nothing from key names.
	--client-sweep-config-check)
		shift
		local checkMember="$1"
		shift || true
		if [ -z "$checkMember" ] || [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --client-sweep-config-check: syntax is <client-* member>" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$checkMember" "<team-member>" client-sweep-config-check || { set +e ; return 1 ; }

		local conversationsMode="--required"
		case "$checkMember" in
			client-*) ;;
			*)
				## Names what is actually wrong -- not a client -- rather than
				## naming a category the member may never have been in.
				echo "⛔ ERROR: $MDSC_CMD --client-sweep-config-check: runs only as a client-* member: $checkMember" >&2
				set +e ; return 1
			;;
		esac

		DistroAgentsTools --intern-op-check-configs "$checkMember" \
			"$conversationsMode" "SLACK_CONVERSATIONS:<conversation-id>[,<conversation-id>]..." \
			--optional "SLACK_USER_TOKEN:<token>" \
			--optional "SLACK_BOT_TOKEN:<token>" \
			--optional "EMAIL_IMAP_HOST:<host>" \
			--optional "EMAIL_USER:<email-address>" \
			--optional "EMAIL_APP_PASSWORD:<app-password>" \
			--optional "TRELLO_KEY:<key>" \
			--optional "TRELLO_TOKEN:<token>" \
			--expect-secret SLACK_USER_TOKEN \
			--expect-secret SLACK_BOT_TOKEN \
			--expect-secret EMAIL_APP_PASSWORD \
			--expect-secret TRELLO_KEY \
			--expect-secret TRELLO_TOKEN \
			--resolve-slack-workspace-into SLACK_WORKSPACE_DOMAIN \
			--context --client-sweep-config-check
		return $?
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
