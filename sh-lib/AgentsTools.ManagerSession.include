#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.ManagerSession.include -- the --manager-session-* operations: the console's own
## view of the coworking sessions of this workspace. Sourced from the `--manager-session-*)`
## arm of AgentsTools.Manager.include; who may call was asked where the family is dispatched.
##
## A session is no stored thing: it is the rows of the spawned-sessions registry that carry
## one session-id, grouped at read time (AgentsManagerSessionRows.awk). A reader that passes
## by updates the registry: an operation here rebuilds what it reads, in the same call, and
## measures which runs are alive by the one rule the render uses
## (AgentsToolsRegistryMeasureRows, AgentsTools.Registries.include).
## The list reads the whole workspace and rebuilds both registries each time. The read of one
## session, and of what its runs did, reads the registries as they lie and rebuilds one only
## where it is missing or does not hold its store as the store is now, by the names in it and
## never by a time (AgentsToolsManagerSessionScope), so one call opens the records and the
## stores of one session, never of all.
## One operation acts: the kill ends the runs an id names, found in those same rows, with
## the registry of the runs rebuilt first, so that no run of the session is missed.
## A session shows two more things, at the end of its row: the state its control thread
## stored for it, with when, as the registry holds them (session-state, session-state-at),
## beside the state that is derived here at each call; and whether that thread lives, which
## no registry holds: it is measured at each call (AgentsToolsManagerSessionControls).
## One starts: the control thread of a session where it does not live, by the one function
## every starter of a thread calls, and with --all the check the advance lock take and the
## main loop make too (AgentsTools.SessionControlStart.include).
##

type AgentsToolsRegistryMeasureRows > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.Registries.include"

## Whether a live run sits inside a Wait call, by its own store, .local/agents/sessions/<spawn
## id>: `waiting` when the last line of its milestones is `wait going idle`, which a Wait
## writes as it starts, and its wait/state, which a wait writes as it ends, is older than
## that line or was never written; `working` otherwise, a run with no milestones among them.
## Working is one thing here: no file of a run's store says a tool call from thinking. Asked
## of a live run only. stat(1) differs by platform: its flavour is the caller's, probed once.
AgentsToolsManagerRunActivity(){ ## spawn id, stat flavour (bsd, gnu)
	local activityDir activityLine activityLast="" activityEnded="" activityYear activityMonth activityStamp
	case "${1:-}" in ''|*/*|.|..) printf 'working\n' ; return 0 ;; esac
	activityDir="$MMDAPP/.local/agents/sessions/$1"
	[ -f "$activityDir/milestones" ] || { printf 'working\n' ; return 0 ; }
	while IFS= read -r activityLine || [ -n "$activityLine" ] ; do
		[ -z "$activityLine" ] || activityLast="$activityLine"
	done < "$activityDir/milestones"
	case "$activityLast" in
		[0123456789][0123456789][0123456789][0123456789]-[0123456789][0123456789]-[0123456789][0123456789]T[0123456789][0123456789]:[0123456789][0123456789]:[0123456789][0123456789]Z' wait going idle') ;;
		*) printf 'working\n' ; return 0 ;;
	esac
	[ -f "$activityDir/wait/state" ] || { printf 'waiting\n' ; return 0 ; }
	case "${2:-}" in
		bsd) activityEnded="$( stat -f '%m' "$activityDir/wait/state" 2>/dev/null )" || activityEnded="" ;;
		gnu) activityEnded="$( stat -c '%Y' "$activityDir/wait/state" 2>/dev/null )" || activityEnded="" ;;
	esac
	## A wait/state that cannot be dated says nothing of a wait: working, as any run not known to wait.
	case "$activityEnded" in ''|*[!0123456789]*) printf 'working\n' ; return 0 ;; esac
	## The line's own time, `2026-10-12T23:15:19Z`, as seconds since 1970, by the calendar alone.
	activityYear=$(( 10#${activityLast:0:4} )) ; activityMonth=$(( 10#${activityLast:5:2} ))
	[ "$activityMonth" -gt 2 ] || { activityYear=$(( activityYear - 1 )) ; activityMonth=$(( activityMonth + 12 )) ; }
	activityStamp=$(( ( 365 * activityYear + activityYear / 4 - activityYear / 100 + activityYear / 400 + ( 153 * ( activityMonth - 3 ) + 2 ) / 5 + 10#${activityLast:8:2} - 719469 ) * 86400 + 10#${activityLast:11:2} * 3600 + 10#${activityLast:14:2} * 60 + 10#${activityLast:17:2} ))
	if [ "$activityEnded" -lt "$activityStamp" ] ; then printf 'waiting\n' ; else printf 'working\n' ; fi
	return 0
}

## The one-minute load average of this host, as one figure; `-` where it cannot be read.
AgentsToolsManagerLoadAverage(){
	local loadText
	loadText="$( LC_ALL=C uptime 2>/dev/null )" || loadText=""
	case "$loadText" in
		*'load averages: '*) loadText="${loadText##*load averages: }" ;;
		*'load average: '*) loadText="${loadText##*load average: }" ;;
		*) loadText="" ;;
	esac
	loadText="${loadText%%[ ,]*}"
	case "$loadText" in ''|*[!0123456789.]*) loadText="-" ;; esac
	printf '%s\n' "$loadText"
}

## For how long the full name of this host is kept once it was read, and for how long what
## stands in its place is kept where it could not be read, in seconds: a day, and an hour.
agentsManagerHostFullSeconds=86400
agentsManagerHostPlainSeconds=3600

## THE FULL NAME OF THIS HOST, for the eye of whoever reads the counters of the list, and for
## nothing else: the `host` of a record, the folder of a wait and every question whether a
## run is of this host go by the short name, `hostname -s`, as before. One word, never empty:
## what `hostname -f` gives where that resolves, else the plain `hostname`, else the short
## name, `unknown` where the host says none.
## ASKED ONCE, AND KEPT. The list is called every ten seconds, each time as a process of its
## own, and the full name is a question to the resolver, which on a host whose resolver is
## broken does not answer for many seconds. So the answer is kept in the machine's own folder,
## $HOME/.agents/magic-team/host-full-name, one line, `<short name> <name> <asked, seconds
## since 1970> <kept for, seconds>`, put in place by one rename, and a call reads that file
## and asks the host nothing while the line is of this short name and not older than it says.
## AND BOUNDED. Where it is asked, the lookup is a process of its own, given one second: one
## that has not answered by then is ended, and so is no lookup that every later call would
## start again, since what stands in its place is kept too, for an hour. A name that reads
## `localhost` is no name of this host. With no folder to keep the answer in, the host is not
## asked at all, and the plain name stands.
## What a call costs more than the short name it read before: one reading of the time and
## one of a file of one line; the lookup itself once a day.
AgentsToolsManagerHostName(){
	local hostShort="" hostDir="" hostKept="" hostFor="" hostFull="" hostAsked="" hostHeld="" hostNow="" hostAside="" hostPid="" hostTurns=0 hostPlain=""
	hostShort="$( hostname -s 2> /dev/null )" || hostShort=""
	hostShort="${hostShort%%[[:space:]]*}"
	[ -n "$hostShort" ] || hostShort="unknown"
	hostNow="$( date +%s 2> /dev/null )" || hostNow=""
	case "$hostNow" in ''|*[!0123456789]*) hostNow=0 ;; esac
	if [ -n "${HOME:-}" ] ; then hostDir="$HOME/.agents/magic-team" ; hostKept="$hostDir/host-full-name" ; fi
	if [ -n "$hostKept" ] && [ -f "$hostKept" ] ; then
		{ read -r hostFor hostFull hostAsked hostHeld < "$hostKept" ; } 2> /dev/null || :
		case "$hostAsked" in ''|*[!0123456789]*|????????????*) hostFull="" ; hostAsked=0 ;; esac
		case "$hostHeld" in ''|*[!0123456789]*|????????*) hostFull="" ; hostHeld=0 ;; esac
		if [ -z "$hostFull" ] || [ "$hostFor" != "$hostShort" ] || [ "$hostNow" -lt "$hostAsked" ] || [ "$(( hostNow - hostAsked ))" -ge "$hostHeld" ] ; then hostFull="" ; fi
	fi
	if [ -z "$hostFull" ] ; then
		hostHeld="$agentsManagerHostPlainSeconds"
		if [ -n "$hostDir" ] && mkdir -p "$hostDir" 2> /dev/null && hostAside="$( mktemp "$hostDir/host-full-name.XXXXXX" 2> /dev/null )" ; then
			( exec hostname -f ) > "$hostAside" 2> /dev/null < /dev/null &
			hostPid=$!
			while kill -0 "$hostPid" 2> /dev/null && [ "$hostTurns" -lt 20 ] ; do sleep 0.05 ; hostTurns=$(( hostTurns + 1 )) ; done
			if kill -0 "$hostPid" 2> /dev/null ; then
				## Ended, and its file left to it: what is kept is written to another.
				kill -TERM "$hostPid" 2> /dev/null || :
				rm -f "$hostAside" 2> /dev/null
				hostAside="$( mktemp "$hostDir/host-full-name.XXXXXX" 2> /dev/null )" || hostAside=""
			elif wait "$hostPid" 2> /dev/null ; then
				{ IFS= read -r hostFull < "$hostAside" ; } 2> /dev/null || :
				hostFull="${hostFull%%[[:space:]]*}" ; hostFull="${hostFull%.}"
				case "$hostFull" in localhost|localhost.*) hostFull="" ;; esac
				[ -z "$hostFull" ] || hostHeld="$agentsManagerHostFullSeconds"
			fi
		fi
		if [ -z "$hostFull" ] ; then
			hostPlain="$( hostname 2> /dev/null )" || hostPlain=""
			hostFull="${hostPlain%%[[:space:]]*}"
			[ -n "$hostFull" ] || hostFull="$hostShort"
		fi
		if [ -n "$hostAside" ] ; then
			{ printf '%s %s %s %s\n' "$hostShort" "$hostFull" "$hostNow" "$hostHeld" > "$hostAside" && chmod 644 "$hostAside" && mv -f "$hostAside" "$hostKept" ; } 2> /dev/null || rm -f "$hostAside" 2> /dev/null || :
		fi
	fi
	printf '%s\n' "$hostFull"
	return 0
}

## THE CONTROL THREAD OF A SESSION, WHETHER IT LIVES: measured now, at every call, and never
## stored. A thread keeps two things in the session's own folder, sessions/<session id>/control/,
## for as long as it lives: a pid file and a lock, which is a link. Each names it as
## `<pid> <start>`, its process and when that process began (AgentsTools.InternSessionControl.include).
## Prints one line for each session that has either, `<session id> <word> <pid>`:
##   alive  the process one of the two names is still that process: that pid, begun then;
##   gone   neither names such a process: no process has the pid, or another has taken it,
##          begun at another time, or it has ended and is only not collected yet.
## A session with neither has no line: it has no control thread. <pid> is the process the word
## is said of: the live one, else the one the pid file names, else the lock's; `-` where what
## stands there names none.
## The folders are listed by the shell, once, and the processes all of them name are asked of
## the process list in ONE read (AgentsToolsRegistryProcessesBegan), never one a session; a
## link is read only where a session has one. With an id, that one session alone is looked at.
AgentsToolsManagerSessionControls(){ ## session id (every session of the workspace where not given)
	local controlsRoot="$MMDAPP/.local/agents/sessions" controlsFile controlsId controlsLine controlsNamed="" controlsFound="" controlsTab=$'\t' controlsNl=$'\n'
	case "${1:-}" in
		'') set -- "$controlsRoot"/*/control/pid "$controlsRoot"/*/control/lock ;;
		-|.|..|*/*) return 0 ;;
		*) set -- "$controlsRoot/$1/control/pid" "$controlsRoot/$1/control/lock" ;;
	esac
	for controlsFile in "$@" ; do
		controlsLine=""
		case "$controlsFile" in
			*/pid)
				[ -f "$controlsFile" ] || continue
				{ IFS= read -r controlsLine < "$controlsFile" ; } 2> /dev/null || :
			;;
			*)
				[ -L "$controlsFile" ] || continue
				controlsLine="$( readlink "$controlsFile" 2> /dev/null )" || controlsLine=""
			;;
		esac
		controlsId="${controlsFile%/control/*}" ; controlsId="${controlsId##*/}"
		## One line a pid file or a lock, the pid files first: what it names stays one field.
		controlsLine="${controlsLine//"$controlsTab"/ }"
		controlsFound="$controlsFound$controlsId$controlsTab$controlsLine$controlsNl"
		controlsNamed="$controlsNamed$controlsLine$controlsNl"
	done
	[ -n "$controlsFound" ] || return 0
	{ printf '%s' "$controlsNamed" | AgentsToolsRegistryProcessesBegan ; printf '=\n%s' "$controlsFound" ; } | LC_ALL=C awk -F "$controlsTab" '
		$0 == "=" { controlsRead = 1 ; next ; }
		! controlsRead { controlsNow[$0] = 1 ; next ; }
		{
			if (!( $1 in sessionAt )) { sessionAt[$1] = ++sessionTotal ; sessionOf[sessionTotal] = $1 ; }
			namedPid = $2 ; sub( / .*/, "", namedPid ) ;
			if (namedPid !~ /^[0-9]+$/) namedPid = "-" ;
			if ($2 in controlsNow) { if (!( $1 in livePid )) livePid[$1] = namedPid ; }
			else if (!( $1 in namedOf ) || namedOf[$1] == "-") namedOf[$1] = namedPid ;
		}
		END {
			for (sessionNo = 1 ; sessionNo <= sessionTotal ; sessionNo++) {
				sessionId = sessionOf[sessionNo] ;
				if (sessionId in livePid) print sessionId, "alive", livePid[sessionId] ;
				else print sessionId, "gone", namedOf[sessionId] ;
			}
		}
	' || :
	return 0
}

## The rows --manager-session-list prints: both session registries rebuilt, every row
## measured, then grouped, sorted and counted. Fails, printing nothing, where a registry
## cannot be rebuilt: a stale file is never listed as though it were fresh.
AgentsToolsManagerSessionRows(){ ## the operation as it was called, "active" for the active sessions only (may be empty)
	local rowsOp="$1" rowsActive="${2:-}" rowsFile rowsPending rowsSpawn rowsWaiting=" " rowsStat="" rowsTab=$'\t'
	local measuredRows="" measuredDated="" measuredAny="false"
	rowsFile="$( AgentsToolsRegistryFile spawned-sessions )"
	rowsPending="$( AgentsToolsRegistryFile pending-replies )"
	if ! AgentsToolsRegistrySpawnedSessionsRebuild || ! AgentsToolsRegistryPendingRepliesRebuild ; then
		echo "⛔ ERROR: $MDSC_CMD $rowsOp: the session registries could not be rebuilt in ${rowsFile%/*} -- nothing is listed" >&2
		return 1
	fi
	[ -d "$MMDAPP/.local/agents/spawned" ] || echo "# $MDSC_CMD $rowsOp: no spawn sandbox root exists yet, so no session has run in this workspace" >&2
	AgentsToolsRegistryMeasureRows "$rowsFile" "" "" 16
	if stat -f '%m' / > /dev/null 2>&1 ; then
		rowsStat="bsd"
	elif stat -c '%Y' / > /dev/null 2>&1 ; then
		rowsStat="gnu"
	fi
	## The store of a live run is read, never of an ended one: but for one small file of each
	## run that has it, its tokens, which the awk of the rows reads for the total of a session
	## (AgentsManagerSessionTokens.awk). No transcript and no record is opened for that.
	while IFS= read -r rowsSpawn ; do
		[ -n "$rowsSpawn" ] || continue
		[ "$( AgentsToolsManagerRunActivity "$rowsSpawn" "$rowsStat" )" != "waiting" ] || rowsWaiting="$rowsWaiting$rowsSpawn "
	done <<< "$( printf '%s' "$measuredDated" | LC_ALL=C awk 'NF == 18 && $12 == "running" { print $8 ; }' )"
	printf '%s' "$measuredDated" \
		| MDAT_MANAGER_WAITING="$rowsWaiting" MDAT_MANAGER_CONTROL="$( AgentsToolsManagerSessionControls )" MDAT_MANAGER_AGENTS="$MMDAPP/.local/agents" LC_ALL=C awk -v activeOnly="${rowsActive:+1}" -v loadAverage="$( AgentsToolsManagerLoadAverage )" -v hostName="$( AgentsToolsManagerHostName )" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsManagerSessionTokens.awk" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsManagerSessionRows.awk" "$rowsPending" - \
		| LC_ALL=C sort -t "$rowsTab" -k1,1nr -k2,2n -k3,3n -k4,4n -k5,5n \
		| LC_ALL=C cut -f6-
}

## The record of each row of a spawned-sessions registry given on standard input, where it is
## found by its name, <store>/<tracking-name>/<spawn-id>.md. `entries`: one entry pair a
## record for AgentsRegistryHeaderRows.awk, the sandbox then the record, so that awk reads
## what those records say now. `kept`: the rows that have no such record, as they are, a row
## with no spawn id and one whose file is gone among them.
AgentsToolsManagerSessionRecordEntries(){ ## the store, spawned; entries or kept -- stdin: registry rows
	local entriesStore="$1" entriesWant="$2" entriesLine entriesTracking entriesSkip entriesSpawn entriesRest entriesFile
	while IFS= read -r entriesLine ; do
		[ -n "$entriesLine" ] || continue
		read -r entriesTracking entriesSkip entriesSkip entriesSkip entriesSkip entriesSkip entriesSkip entriesSpawn entriesRest <<< "$entriesLine"
		entriesFile=""
		case "$entriesTracking/$entriesSpawn" in
			*/*/*|*/-|*/|/*) ;;
			*) [ ! -f "$entriesStore/$entriesTracking/$entriesSpawn.md" ] || entriesFile="$entriesStore/$entriesTracking/$entriesSpawn.md" ;;
		esac
		if [ "$entriesWant" = "kept" ] ; then
			[ -n "$entriesFile" ] || printf '%s\n' "$entriesLine"
		elif [ -n "$entriesFile" ] ; then
			AgentsToolsRegistryRowsEntry D "$entriesTracking"
			AgentsToolsRegistryRowsEntry S "$entriesFile"
		fi
	done
	return 0
}

## The one session an id names, for an operation that reads one session and never the
## workspace: its rows of the spawned-sessions registry, measured, and as the list prints
## them. The id is a session's, or a run's own: a session's id shows the session, and the own
## id of a run that joined one shows the session that run belongs to, with that run chosen.
## The founder's own id is its session's, so "run" as the third word takes the id as a run's
## own alone. Into five variables of the caller: scopeSession, the session; scopeRun, the one
## run chosen, `-` for every run of the session; scopeMeasured, the measured rows of the
## session (measuredDated of AgentsToolsRegistryMeasureRows); scopeListed, its `session` row
## and its `run` rows in the form and the order of the list; scopeControl, its control thread
## as it was measured for that row (AgentsToolsManagerSessionControls), empty where it has none.
##
## A registry stores what the tooling needs to work fast, so the registries are read as they
## lie, and only one session's rows are measured. A reader that passes by still updates what
## it reads, and a read of a session holds every run of it that has a record now: a registry
## is taken as it lies only while it holds its store as the store is now, and is rebuilt
## first, once, where it does not (AgentsManagerSessionScope.awk). spawned-sessions: every
## sandbox folder the store has and no other, each with as many record rows as it has record
## files, every row of sixteen columns, and a row of the id. pending-replies: every ask by
## its name and no other, and of each ask of the session the status its record says now. No
## time is compared: a record added to a folder the session already has moves no time a row
## names, and the shell's newer-than test counts whole seconds. What a record of the session
## says is then read from the record itself, at every call, so a status that moved is never
## old, and no registry is rebuilt for it; the state its control thread stored is read with
## it, from the session's own folder. The cost: the names in the store are listed, one
## folder a sandbox, and the records of the one session are read; no other record is opened.
## A board item that starts or stops waiting on a reply is the one change not seen here: its
## row is rebuilt by the next reader that rebuilds pending-replies, as the list does. Fails,
## rc 1 and one line, where no record carries the id, or a registry cannot be rebuilt: the
## line ends with what its caller then did not do, `nothing is shown` where it names none.
AgentsToolsManagerSessionScope(){ ## the operation as it was called, the id, "run" where the id is a run's own alone (may be empty), what is not done on a failure (may be empty)
	local scopeOp="$1" scopeId="$2" scopeOwn="${3:-}" scopeNot="${4:-nothing is shown}" scopeFile scopePending scopeStore scopePicked="" scopeRows="" scopeAge="" scopeFresh=""
	local scopeLib="$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib" scopeIds scopeReread
	local scopeTracking scopeSkip scopeSpawn scopeLive scopeRest scopeTemp scopeStat="" scopeWaiting=" " scopeState="" scopeTab=$'\t' scopeNl=$'\n'
	local measuredRows="" measuredDated="" measuredAny="false"
	scopeSession="" ; scopeRun="" ; scopeMeasured="" ; scopeListed="" ; scopeControl=""
	scopeFile="$( AgentsToolsRegistryFile spawned-sessions )"
	scopePending="$( AgentsToolsRegistryFile pending-replies )"
	scopeStore="$MMDAPP/.local/agents/spawned"
	if [ -d "$scopeStore" ] ; then
		if [ ! -f "$scopeFile" ] ; then
			if AgentsToolsRegistrySpawnedSessionsRebuild ; then scopeFresh="yes" ; else scopeFresh="failed" ; fi
		fi
		while [ "$scopeFresh" != "failed" ] ; do
			## `fresh` or `stale`, whether the registry holds every sandbox folder and every record
			## file the store has now; then, where a row carries the id, the run chosen, the
			## session, and the rows of that session as they stand in the file. The store is
			## listed by the shell, a name each, and no file of it is opened.
			scopePicked="$( { printf '%s\n' "$scopeStore"/*/ ; printf '%s\n' "$scopeStore"/*/*.md ; } \
				| MDAT_MANAGER_ID="$scopeId" MDAT_MANAGER_STORE="$scopeStore/" LC_ALL=C awk -v scopeMode=runs -v ownOnly="${scopeOwn:+1}" \
					-f "$scopeLib/AgentsRegistryHeaderRows.awk" -f "$scopeLib/AgentsManagerSessionScope.awk" "$scopeFile" - 2>/dev/null )" || scopePicked=""
			scopeAge=${scopePicked%%"$scopeNl"*}
			case "$scopePicked" in *"$scopeNl"*) scopePicked=${scopePicked#*"$scopeNl"} ;; *) scopePicked="" ;; esac
			## Rebuilt once in a call: where it does not hold the store as it is now, or no row of the id.
			[ -z "$scopeFresh" ] || break
			[ "$scopeAge" != "fresh" ] || [ -z "$scopePicked" ] || break
			if AgentsToolsRegistrySpawnedSessionsRebuild ; then scopeFresh="yes" ; else scopeFresh="failed" ; fi
		done
	fi
	if [ "$scopeFresh" != "failed" ] && [ -n "$scopePicked" ] ; then
		scopeRun=${scopePicked%%"$scopeNl"*} ; scopePicked=${scopePicked#*"$scopeNl"}
		scopeSession=${scopePicked%%"$scopeNl"*} ; scopeRows=${scopePicked#*"$scopeNl"}
		## The asks' registry, by the same comparison: an ask of the session carries the session's
		## id or the own id of one of its runs.
		scopeIds=" $scopeSession "
		while read -r scopeTracking scopeSkip scopeSkip scopeSkip scopeSkip scopeSkip scopeSkip scopeSpawn scopeRest ; do
			[ -z "$scopeSpawn" ] || [ "$scopeSpawn" = "-" ] || scopeIds="$scopeIds$scopeSpawn "
		done <<< "$scopeRows"
		if [ ! -f "$scopePending" ] || [ "$( printf '%s\n' "$MMDAPP/.local/agents/pending"/*.md \
				| MDAT_MANAGER_IDS="$scopeIds" MDAT_MANAGER_STORE="$MMDAPP/.local/agents/pending/" LC_ALL=C awk -v scopeMode=asks \
					-f "$scopeLib/AgentsRegistryHeaderRows.awk" -f "$scopeLib/AgentsManagerSessionScope.awk" "$scopePending" - 2>/dev/null )" != "fresh" ] ; then
			AgentsToolsRegistryPendingRepliesRebuild || scopeFresh="failed"
		fi
	fi
	if [ "$scopeFresh" = "failed" ] ; then
		echo "⛔ ERROR: $MDSC_CMD $scopeOp: the session registries could not be rebuilt in ${scopeFile%/*} -- $scopeNot" >&2
		return 1
	fi
	if [ -z "$scopePicked" ] ; then
		if [ -n "$scopeOwn" ] ; then scopeRest="the own id of a run" ; else scopeRest="the id of a session or the own id of a run" ; fi
		echo "⛔ ERROR: $MDSC_CMD $scopeOp: no record of this workspace carries '$scopeId' as $scopeRest -- $scopeNot" >&2
		return 1
	fi
	## What each record of the session says now, by the registry's own reader of a record, in
	## place of what its row said when the registry was built: a status that moved, a date
	## set, a name given since. A row with no record to find by its name, its spawn id unknown
	## or its file gone, stands as the registry has it.
	## The state its control thread stored is read with them, from the session's own folder,
	## where it is a file.
	scopeState="$MMDAPP/.local/agents/sessions/$scopeSession/control/state"
	case "$scopeSession" in -|.|..|*/*) scopeState="" ;; esac
	scopeReread="$( {
			[ -z "$scopeState" ] || [ ! -f "$scopeState" ] || AgentsToolsRegistryRowsEntry T "$scopeState"
			AgentsToolsManagerSessionRecordEntries "$scopeStore" entries <<< "$scopeRows"
		} | LC_ALL=C awk -v registryRows=spawned -v registryColumns=16 -f "$scopeLib/AgentsRegistryHeaderRows.awk" )"
	scopeRows="$( AgentsToolsManagerSessionRecordEntries "$scopeStore" kept <<< "$scopeRows" )$scopeNl$scopeReread"
	## The one measuring of a row takes a registry file: the rows of this session alone, in a
	## file of this call's own, so that no other session is measured for it.
	mkdir -p "$MMDAPP/.local/temp" && scopeTemp="$( mktemp "$MMDAPP/.local/temp/mdat-manager-session.XXXXXX" )" || {
		echo "⛔ ERROR: $MDSC_CMD $scopeOp: could not create a scratch file under $MMDAPP/.local/temp -- $scopeNot" >&2
		return 1
	}
	printf '%s\n' "$scopeRows" > "$scopeTemp"
	AgentsToolsRegistryMeasureRows "$scopeTemp" "" "" 16
	rm -f "$scopeTemp"
	scopeMeasured="$measuredDated"
	## The store of a live run is read, never of an ended one.
	while read -r scopeTracking scopeSkip scopeSkip scopeSkip scopeSkip scopeSkip scopeSkip scopeSpawn scopeSkip scopeSkip scopeSkip scopeLive scopeRest ; do
		[ "$scopeLive" = "running" ] || continue
		if [ -z "$scopeStat" ] ; then
			if stat -f '%m' / > /dev/null 2>&1 ; then scopeStat="bsd" ; elif stat -c '%Y' / > /dev/null 2>&1 ; then scopeStat="gnu" ; else scopeStat="none" ; fi
		fi
		[ "$( AgentsToolsManagerRunActivity "$scopeSpawn" "$scopeStat" )" != "waiting" ] || scopeWaiting="$scopeWaiting$scopeSpawn "
	done <<< "$scopeMeasured"
	## Grouped, ordered and named as the list does it, by the list's own awk; its counters row,
	## the last, counts this session alone and is no row of a read.
	scopeControl="$( AgentsToolsManagerSessionControls "$scopeSession" )"
	scopeListed="$( printf '%s' "$scopeMeasured" \
		| MDAT_MANAGER_WAITING="$scopeWaiting" MDAT_MANAGER_CONTROL="$scopeControl" MDAT_MANAGER_AGENTS="$MMDAPP/.local/agents" LC_ALL=C awk -v loadAverage="-" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsManagerSessionTokens.awk" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsManagerSessionRows.awk" "$scopePending" - \
		| LC_ALL=C sort -t "$scopeTab" -k1,1nr -k2,2n -k3,3n -k4,4n -k5,5n \
		| LC_ALL=C cut -f6- )"
	scopeListed=${scopeListed%counters"$scopeTab"*}
	scopeListed=${scopeListed%"$scopeNl"}
	return 0
}

## The end of one run's transcript, read over all its parts: `cut` or `whole` on the first
## line, whether anything of the transcript is left out, then the fewest whole events at its
## end that hold at least the lines asked for (AgentsManagerSessionTranscript.awk, tail). Only
## the last parts are opened, as many as hold those lines; where the text taken starts inside
## a body whose head line stands before it, more is taken. rc 1 for a run with no transcript.
AgentsToolsManagerTranscriptTail(){ ## spawn id, lines
	local tailWant="$2" tailParts=() tailPart tailFrom tailTotal tailCount tailTake tailBefore tailText
	while IFS= read -r tailPart ; do
		[ -z "$tailPart" ] || tailParts+=( "$tailPart" )
	done <<< "$( AgentsTranscriptParts "$1" )"
	[ "${#tailParts[@]}" -gt 0 ] || return 1
	tailTake=$(( tailWant + 64 ))
	while : ; do
		tailFrom="${#tailParts[@]}" ; tailTotal=0
		while [ "$tailFrom" -gt 0 ] && [ "$tailTotal" -lt "$tailTake" ] ; do
			tailFrom=$(( tailFrom - 1 ))
			tailCount="$( wc -l < "${tailParts[$tailFrom]}" 2>/dev/null | tr -d ' ' )"
			case "$tailCount" in ''|*[!0123456789]*) tailCount=0 ;; esac
			tailTotal=$(( tailTotal + tailCount ))
		done
		tailBefore=0
		[ "$tailFrom" -eq 0 ] && [ "$tailTotal" -le "$tailTake" ] || tailBefore=1
		tailText="$( cat "${tailParts[@]:$tailFrom}" 2>/dev/null | tail -n "$tailTake" )"
		case "$tailBefore:$tailText" in
			'1:>'*) tailTake=$(( tailTake * 4 )) ; continue ;;
		esac
		break
	done
	printf '%s\n' "$tailText" | LC_ALL=C awk -v transcriptMode=tail -v wantLines="$tailWant" -v linesBefore="$tailBefore" \
		-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsSessionTranscriptFormat.awk" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsManagerSessionTranscript.awk"
}

## How long a run is given to end on the polite signal before the hard one is sent, and how
## long the hard one is then given, in seconds: the two seconds TaskStop waits.
agentsManagerKillPoliteSeconds=2

## The name the console's user has in the operating system, which a kill is recorded under:
## one word, as a Decisions line and a record header take it; `unknown` where the system
## gives none.
AgentsToolsManagerConsoleUser(){
	local userName
	userName="$( id -un 2>/dev/null )" || userName=""
	[ -n "$userName" ] || userName="${USER:-${LOGNAME:-}}"
	userName="$( printf '%s' "$userName" | LC_ALL=C tr -s ' \t\r\n' '_' )"
	printf '%s\n' "${userName:-unknown}"
}

## Says on a run's own record that it was killed, by whom and when: `killed-by` and
## `killed-at`, through this package's own header writer, aside and then one rename. Written
## before anything is signalled, so the supervising shell of the run, which closes the record
## when the run has ended, finds them there: they are what keeps its handback retry from
## starting a killed run again (AgentsToolsSpawnProxyRetryClosed), and what a later start of
## the session reads. rc 1 where the record could not be written.
AgentsToolsManagerKillMark(){ ## spawn record file, who, when
	local markOps markBody
	[ -f "$1" ] || return 1
	mkdir -p "$MMDAPP/.local/temp" 2>/dev/null || return 1
	markOps="$( mktemp "$MMDAPP/.local/temp/mdat-manager-kill-ops.XXXXXX" )" || return 1
	printf 'upsert\tkilled-by\t%s\nupsert\tkilled-at\t%s\n' "$2" "$3" > "$markOps" || { rm -f "$markOps" ; return 1 ; }
	markBody="$( LC_ALL=C awk -v opsFile="$markOps" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsBoardItemHeaderOpsApply.awk" < "$1" 2>/dev/null )" || markBody=""
	rm -f "$markOps"
	[ -n "$markBody" ] || return 1
	{ printf '%s\n' "$markBody" > "$1.killed.$$" && mv -f "$1.killed.$$" "$1" ; } 2>/dev/null || { rm -f "$1.killed.$$" ; return 1 ; }
	return 0
}

## The ordered ending of a killed run, recorded where the tooling records every ending it
## orders (AgentsReviewEndChild, AgentsTools.ReviewFlow.include): one `dismissed` line in the
## Decisions of the run's own dispatch item and one ENDING line in its transcript, under the
## name given, with the reason `manager-kill`. Its own item is the one its record links that
## names this run as its spawn-id, or, written before session-id and spawn-id were split, as
## its session-id alone. A run with no item of its own has the line of its transcript alone.
## Each record in a subshell of its own: the tooling it calls leaves set -e behind. Prints
## the name of the item, or `-`. Never fails its caller, which has loaded the review flow.
AgentsToolsManagerKillRecord(){ ## spawn id, who
	local recordItem="" recordPath="" recordOwn=""
	if recordItem="$( AgentsReviewItemOfSession "$1" )" && recordPath="$( AgentsToolsDecisionsItemPath "$recordItem" )" ; then
		recordOwn="$( AgentsToolsDecisionsField "$recordPath" spawn-id )"
		[ -n "$recordOwn" ] || recordOwn="$( AgentsToolsDecisionsField "$recordPath" session-id )"
		[ "$recordOwn" = "$1" ] || recordPath=""
	else
		recordPath=""
	fi
	if [ -n "$recordPath" ] ; then
		( AgentsReviewEndChild "$2" "$recordPath" manager-kill no ) > /dev/null || :
		recordItem="${recordPath##*/}"
		printf '%s\n' "${recordItem%.md}"
		return 0
	fi
	( AgentsTranscriptEvent "$1" ENDING "" 0 kind dismissed by "$2" text "manager-kill: no dispatch item, the process is stopped by manager-kill" ) > /dev/null 2>&1 || :
	printf '%s\n' "-"
	return 0
}

## The process ids of its input, the first word of a line each, as one line with a space
## between them, each once. Only a number above 1 is ever one: nothing else is handed to a signal, 0 being the caller's own
## process group and 1 the first process of the host.
AgentsToolsManagerKillPids(){ ## -- stdin: process ids, a line each
	LC_ALL=C awk '$1 ~ /^[0-9]+$/ && $1 + 0 > 1 && ! pidSeen[$1]++ { printf "%s%s", ( pidSaid++ ? " " : "" ), $1 ; }'
}

## What is left of a run that was signalled, as one line with a space between the pids: the
## processes that were signalled and are still the processes they were, and whatever is the
## run's now, read in the one place a stop reads it too (AgentsToolsRegistryRunLeft,
## AgentsTools.Registries.include).
AgentsToolsManagerKillLeft(){ ## spawn id, the processes signalled as `<pid> <start>` lines (may be empty)
	AgentsToolsRegistryRunLeft "$1" "$2" | AgentsToolsManagerKillPids
}

## Waits until none of the processes given is there any more, the polite time at most.
AgentsToolsManagerKillWait(){ ## pids, space-separated
	local waitLeft=$(( agentsManagerKillPoliteSeconds * 4 )) waitPid waitAny
	while [ "$waitLeft" -gt 0 ] ; do
		waitAny=""
		for waitPid in $1 ; do
			! kill -0 "$waitPid" 2>/dev/null || { waitAny="yes" ; break ; }
		done
		[ -n "$waitAny" ] || return 0
		sleep 0.25
		waitLeft=$(( waitLeft - 1 ))
	done
	return 0
}

## What --manager-session-kill does: ends the runs an id names, the hard way. No closure of
## a routine runs and no agent is asked anything; the confirmation is its caller's.
## The runs are those the read of one session finds for the id (AgentsToolsManagerSessionScope):
## the id of a session names every run of it, the own id of a run that joined one names that
## run alone, and with "run" the id is a run's own alone, also where it is its session's, as
## it is for the run that founded one. The registry of the runs is rebuilt first, always: a
## member that joined the session since it was last built has its record in a folder that
## was there already, which the read of one session does not look into, and no run of a
## session may be missed here. A run is signalled only while it is alive on this host by
## the list's own measure, and what is signalled is the run with what it started, by the one
## walk a stop uses too (AgentsToolsRegistryRunProcesses, AgentsTools.Registries.include):
## its own processes by the one rule a run is recognised by, and every process those
## started, to any depth, at this moment: a helper server, a tool command, the child of that
## command that hangs. Each by its own pid, never a process group: the group of a run holds
## its supervising shell. That shell is never reached, standing above the run's own
## processes, and so still closes the record of its run. Nor is a run of another spawn, or
## the shell that supervises one, though the killed run started them.
## For each such run the ending is recorded first, as TaskStop records one, under the name
## the console's user has in the operating system; then TERM; then, once the polite time
## has passed for all of them together, KILL to what is still there: the processes that
## were signalled, each still the process it was, the same pid begun at another time being
## another process, and whatever is the run's by then. Nothing is said to have ended until
## that was read again and nothing is left. What is left after both is kept in the run's own
## store, as a stop keeps what it left (AgentsToolsRegistryRunLeftKeep); and what an earlier
## stop or kill kept there is ended with the run, also where the run itself is alive no more.
## Prints one row a run the id names, TAB-separated, in the form the help entry gives. rc 1
## with nothing printed where the registry cannot be rebuilt or the id names no record; rc 1
## after its rows where a run could not be ended.
## Where the control thread of the session carries the kill out for a console, the name the
## ending is recorded under is the one the request of that console gives
## (AgentsTools.SessionControlRequest.include).
AgentsToolsManagerSessionKill(){ ## the operation as it was called, the id, "run" where the id is a run's own alone (may be empty), the name the ending is recorded under where the console's user is another's (may be empty)
	local killOp="$1" killId="$2" killOwn="${3:-}" killTab=$'\t' killFile killUser killStamp killAt killPid killSeen=" "
	local killKind killSession killSpawn killMember killStatus killLive killRest killRecord killFound killLeft
	local killAny="" killHard="" killStuck=0
	local killSessions=() killSpawns=() killMembers=() killStatuses=() killOutcomes=() killPids=() killItems=() killBegan=()
	local scopeSession="" scopeRun="" scopeMeasured="" scopeListed="" scopeControl=""
	if [ -d "$MMDAPP/.local/agents/spawned" ] && ! AgentsToolsRegistrySpawnedSessionsRebuild ; then
		killFile="$( AgentsToolsRegistryFile spawned-sessions )"
		echo "⛔ ERROR: $MDSC_CMD $killOp: the session registries could not be rebuilt in ${killFile%/*} -- nothing was signalled" >&2
		return 1
	fi
	AgentsToolsManagerSessionScope "$killOp" "$killId" "$killOwn" "nothing was signalled" || return 1
	killUser="${4:-}"
	[ -n "$killUser" ] || killUser="$( AgentsToolsManagerConsoleUser )"
	killStamp="$( date +"%Y-%m-%d %H:%M %z" )"
	type AgentsToolsRegistryRunLeftKeep > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.Registries.include"
	type AgentsReviewEndChild > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.ReviewFlow.include"
	## The `run` rows of the session, as the list prints them: the one run chosen, or each.
	while IFS="$killTab" read -r killKind killSession killSpawn killMember killStatus killLive killRest ; do
		[ "$killKind" = "run" ] && [ -n "$killSpawn" ] || continue
		[ "$scopeRun" = "-" ] || [ "$killSpawn" = "$scopeRun" ] || continue
		## A spawn id that two records carry is one run, and is ended once.
		case "$killSeen" in *" $killSpawn "*) continue ;; esac
		[ "$killSpawn" = "-" ] || killSeen="$killSeen$killSpawn "
		killAt="${#killSpawns[@]}"
		killSessions[killAt]="$killSession" ; killSpawns[killAt]="$killSpawn" ; killMembers[killAt]="$killMember" ; killStatuses[killAt]="$killStatus"
		killOutcomes[killAt]="$killLive" ; killPids[killAt]="" ; killItems[killAt]="-" ; killBegan[killAt]=""
		## A run of this host. One that was alive when it was measured: its processes are read
		## now, and it may have ended since. And, alive or not, what an earlier stop or kill of
		## it signalled and left, kept in its store (AgentsToolsRegistryRunLeftKept): a process
		## the run had started, which no walk from the run finds any more.
		case "$killLive" in running|no-process) ;; *) continue ;; esac
		killOutcomes[killAt]="no-process"
		killRecord="$( AgentsToolsRegistrySpawnRecord "$killSpawn" < /dev/null )"
		killFound="$( { [ "$killLive" != "running" ] || AgentsToolsRegistryRunProcesses "$killSpawn" "$killRecord" < /dev/null ; AgentsToolsRegistryRunLeftKept "$killSpawn" < /dev/null ; } | AgentsToolsManagerKillPids )"
		[ -n "$killFound" ] || continue
		## The ending first, then the signal: on its record, on its item, in its transcript.
		[ -n "$killRecord" ] && AgentsToolsManagerKillMark "$killRecord" "$killUser" "$killStamp" < /dev/null \
			|| echo "⚠️ WARNING: $MDSC_CMD $killOp: the record of run $killSpawn could not be marked as killed, so its handback retry may start it once more" >&2
		killItems[killAt]="$( AgentsToolsManagerKillRecord "$killSpawn" "$killUser" < /dev/null )"
		## Each with when it began, so that what is still there later is known to be that process.
		killBegan[killAt]="$( printf '%s\n' $killFound | AgentsToolsRegistryProcessesBegan )"
		for killPid in $killFound ; do
			kill -TERM "$killPid" 2>/dev/null || :
		done
		killPids[killAt]="$killFound" ; killOutcomes[killAt]="signalled"
		killAny="$killAny $killFound"
	done <<< "$scopeListed"
	if [ -n "$killAny" ] ; then
		AgentsToolsManagerKillWait "$killAny"
		killAt=0 ; killAny=""
		while [ "$killAt" -lt "${#killSpawns[@]}" ] ; do
			if [ "${killOutcomes[killAt]}" = "signalled" ] ; then
				killLeft="$( AgentsToolsManagerKillLeft "${killSpawns[killAt]}" "${killBegan[killAt]}" )"
				if [ -z "$killLeft" ] ; then
					killOutcomes[killAt]="ended"
				else
					for killPid in $killLeft ; do
						kill -KILL "$killPid" 2>/dev/null || :
					done
					killOutcomes[killAt]="hard" ; killHard="yes"
					killAny="$killAny $killLeft"
				fi
			fi
			killAt=$(( killAt + 1 ))
		done
		[ -z "$killHard" ] || AgentsToolsManagerKillWait "$killAny"
		killAny="yes"
	fi
	killAt=0
	while [ "$killAt" -lt "${#killSpawns[@]}" ] ; do
		if [ "${killOutcomes[killAt]}" = "hard" ] ; then
			killLeft="$( AgentsToolsManagerKillLeft "${killSpawns[killAt]}" "${killBegan[killAt]}" )"
			if [ -z "$killLeft" ] ; then
				killOutcomes[killAt]="killed"
			else
				killOutcomes[killAt]="not-ended" ; killStuck=$(( killStuck + 1 ))
			fi
		fi
		## What is still there is kept in the run's store, for the next kill or stop of it; with
		## nothing left, nothing is kept any more.
		if [ -n "${killPids[killAt]}" ] ; then
			if [ "${killOutcomes[killAt]}" = "not-ended" ] ; then
				AgentsToolsRegistryRunLeftKeep "${killSpawns[killAt]}" "$killLeft"
			else
				AgentsToolsRegistryRunLeftKeep "${killSpawns[killAt]}" ""
			fi
		fi
		killFound="${killPids[killAt]}"
		printf 'kill\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "${killSessions[killAt]}" "${killSpawns[killAt]}" "${killMembers[killAt]}" "${killOutcomes[killAt]}" "${killStatuses[killAt]}" \
			"$( [ -n "$killFound" ] && printf '%s' "$killFound" | LC_ALL=C tr ' ' ',' || printf '%s' "-" )" "${killItems[killAt]}"
		killAt=$(( killAt + 1 ))
	done
	if [ -z "$killAny" ] ; then
		if [ "$scopeRun" = "-" ] ; then
			echo "# $MDSC_CMD $killOp: no run of session $scopeSession is alive on this host, so nothing was signalled" >&2
		else
			echo "# $MDSC_CMD $killOp: run $scopeRun is not alive on this host, so nothing was signalled" >&2
		fi
	fi
	if [ "$killStuck" -gt 0 ] ; then
		echo "⛔ ERROR: $MDSC_CMD $killOp: $killStuck run(s) could not be ended: TERM and then KILL were sent, and a process is still there -- see the not-ended row(s)" >&2
		return 1
	fi
	return 0
}

## For how long the kill of a session waits for the supervising shells of the runs it ended
## to close their records, in seconds, before it says what state the session is in.
agentsManagerFinishWaitSeconds=5

## WHAT THE KILL OF A SESSION FINISHES, once what lived of it is ended: the session is left
## with nothing pending. With "plan" nothing is done, and the same rows say what would be.
## Run by the console's own call, never by the control thread: it ends no process.
## THE QUESTIONS. Every question that still waits and was asked by the session or by a run of
## it is dismissed, through the one dismissal the console has (--manager-pending-reply-dismiss),
## with the reason that the session was killed from the console, and by whom: so it is
## withdrawn by `console:<account>`, and its trace stands in its own thread, as that path
## leaves it. No record of a question is closed here. For one run alone, the questions that
## very run asked, once it is ended: nobody is left to hear their answer.
## THE RECORDS, for a whole session alone. A record of it that is still open, with no process
## behind it and no supervising shell alive to close it, is closed as the tooling closes a
## run that ended without its close (AgentsToolsSessionControlDeathClose, the two closers of
## the advance pass), its dispatch item with it, and marked first as killed from the console:
## `killed-by`, `killed-at` (AgentsToolsManagerKillMark), and the ordered ending on its item
## and in its transcript where this kill did not record it (AgentsToolsManagerKillRecord).
## Its end is told to whoever requested the run, as every closer tells one: as a run that was
## killed where this or an earlier kill ended its process, and else as a record that was
## closed from the console, its run having ended before. A record whose supervising shell
## lives is that shell's to close: it is waited for a few seconds, and left to it.
## Never of another host: a run this host cannot measure is not touched, nor its questions.
## A run that still lives is not touched either: its kill said that it could not be ended.
## Rows, TAB-separated, after the rows of the kill: `dismiss` a question, `close` a record,
## and for a whole session one `finish` row last, which sums it: how many runs were ended,
## how many questions dismissed, how many records closed, and the state the session reads
## now. A second kill of the same session finds nothing left, and its `finish` row says so.
AgentsToolsManagerSessionFinish(){ ## the operation as it was called, the id, "run" where the id is a run's own alone (may be empty), "plan" where nothing is to be done (may be empty), how many runs the kill ended
	local finishOp="$1" finishId="$2" finishOwn="${3:-}" finishPlan="${4:-}" finishEnded="${5:-0}" finishTab=$'\t' finishNl=$'\n'
	local finishWho finishStamp finishWhole="" finishIds=" " finishReason finishKind finishSession finishSpawn finishMember finishStatus finishLive finishRest
	local finishKey finishSource finishAsker finishOwner finishAskStatus finishAsk finishRc finishRecord finishShell finishItem finishFound
	local finishDismissed=0 finishClosed=0 finishState="-" finishWait=0 finishAt finishMarked
	local finishSpawns=() finishMembers=() finishRecords=() finishWaits=()
	local scopeSession="" scopeRun="" scopeMeasured="" scopeListed="" scopeControl=""
	AgentsToolsManagerSessionScope "$finishOp" "$finishId" "$finishOwn" "nothing more was done" || return 1
	[ "$scopeRun" != "-" ] || finishWhole="yes"
	finishSession="$scopeSession"
	finishWho="$( AgentsToolsManagerConsoleUser )"
	finishStamp="$( date +"%Y-%m-%d %H:%M %z" )"
	## Why a question is dismissed: a line of the note template, `# Reasons`, never a text
	## written here (sh-lib/templates/tooling-note.post.format.md).
	type AgentsToolsAskPostFill > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.AskPost.include"
	if [ -n "$finishWhole" ] ; then
		finishReason="$( ASKP_BLOCK="Reasons/session-killed" ASKP_F_by="$finishWho" AgentsToolsAskPostFill block tooling-note.post.format.md "" 2> /dev/null )" || finishReason=""
		finishIds=" $finishSession "
	else
		finishReason="$( ASKP_BLOCK="Reasons/asker-killed" ASKP_F_by="$finishWho" AgentsToolsAskPostFill block tooling-note.post.format.md "" 2> /dev/null )" || finishReason=""
	fi
	[ -n "$finishReason" ] || echo "⚠️ WARNING: $MDSC_CMD $finishOp: the reason of a dismissal could not be filled from its template (tooling-note.post.format.md, Reasons), so a question is dismissed with none" >&2
	finishEnded=0
	## The runs: whose questions are dismissed, and whose records are this call's to close.
	while IFS="$finishTab" read -r finishKind finishRest finishSpawn finishMember finishStatus finishLive finishRest ; do
		[ "$finishKind" = "run" ] || continue
		[ -n "$finishWhole" ] || [ "$finishSpawn" = "$scopeRun" ] || continue
		finishRecord="" ; finishFound=""
		case "$finishSpawn" in ''|-) ;; *) finishRecord="$( AgentsToolsRegistrySpawnRecord "$finishSpawn" < /dev/null )" ;; esac
		if [ -n "$finishPlan" ] ; then
			## What a kill would end: the run with what it started, as the walk finds it now.
			[ "$finishLive" != "running" ] || finishFound="$( AgentsToolsRegistryRunProcesses "$finishSpawn" "$finishRecord" < /dev/null | AgentsToolsManagerKillPids )"
			if [ -n "$finishFound" ] ; then
				finishEnded=$(( finishEnded + 1 ))
				printf 'kill\t%s\t%s\t%s\twould-end\t%s\t%s\t-\n' "$finishSession" "$finishSpawn" "$finishMember" "$finishStatus" "$( printf '%s' "$finishFound" | LC_ALL=C tr ' ' ',' )"
			else
				printf 'kill\t%s\t%s\t%s\t%s\t%s\t-\t-\n' "$finishSession" "$finishSpawn" "$finishMember" "$( [ "$finishLive" != "running" ] && printf '%s' "$finishLive" || printf 'no-process' )" "$finishStatus"
			fi
		fi
		case "$finishLive" in
			no-process) ;;
			running) [ -n "$finishPlan" ] || continue ;;
			*) continue ;;
		esac
		case "$finishSpawn" in ''|-) continue ;; esac
		case "$finishIds" in *" $finishSpawn "*) ;; *) finishIds="$finishIds$finishSpawn " ;; esac
		[ -n "$finishWhole" ] && [ "$finishStatus" = "spawn-started" ] && [ -n "$finishRecord" ] || continue
		finishSpawns[${#finishSpawns[@]}]="$finishSpawn" ; finishMembers[${#finishMembers[@]}]="$finishMember" ; finishRecords[${#finishRecords[@]}]="$finishRecord"
	done <<< "$scopeListed"
	[ -n "$finishPlan" ] || finishEnded="${5:-0}"
	## The questions that wait, as the registry of them holds them, which the read above has
	## held to the store.
	while read -r finishKey finishSource finishAsker finishOwner finishAskStatus finishRest ; do
		[ "$finishSource" = "ask" ] && [ "$finishAskStatus" = "reply-pending" ] || continue
		case "$finishIds" in *" $finishAsker "*) ;; *) continue ;; esac
		finishAsk="${finishKey%.md}"
		if [ -n "$finishPlan" ] ; then
			printf 'dismiss\t%s\t%s\t%s\twould-dismiss\n' "$finishSession" "$finishAsk" "$finishAsker"
			finishDismissed=$(( finishDismissed + 1 ))
			continue
		fi
		finishRc=0
		( DistroAgentsTools --manager-pending-reply-dismiss --id "$finishAsk" --reason "$finishReason" ) > /dev/null < /dev/null || finishRc=$?
		if [ "$finishRc" = 0 ] ; then
			printf 'dismiss\t%s\t%s\t%s\tdismissed\n' "$finishSession" "$finishAsk" "$finishAsker"
			finishDismissed=$(( finishDismissed + 1 ))
		else
			printf 'dismiss\t%s\t%s\t%s\tnot-dismissed\n' "$finishSession" "$finishAsk" "$finishAsker"
		fi
	done < <( LC_ALL=C grep -v '^#' "$( AgentsToolsRegistryFile pending-replies )" 2> /dev/null )
	## The records. Those a supervising shell still closes are given a few seconds first.
	if [ "${#finishSpawns[@]}" -gt 0 ] ; then
		type AgentsToolsSessionControlDeathClose > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.SessionControlDeath.include"
		type AgentsReviewEndChild > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.ReviewFlow.include"
		finishAt=0
		while [ "$finishAt" -lt "${#finishSpawns[@]}" ] ; do
			finishWaits[finishAt]=""
			[ "$( AgentsToolsRegistryRecordedSupervisor "${finishRecords[finishAt]}" )" != "alive" ] || finishWaits[finishAt]="yes"
			finishAt=$(( finishAt + 1 ))
		done
		if [ -z "$finishPlan" ] ; then
			finishWait=$(( agentsManagerFinishWaitSeconds * 4 ))
			while [ "$finishWait" -gt 0 ] ; do
				finishFound="" ; finishAt=0
				while [ "$finishAt" -lt "${#finishSpawns[@]}" ] ; do
					[ -z "${finishWaits[finishAt]}" ] || [ "$( AgentsToolsRegistryHeader "$( AgentsToolsRegistryFrontmatter "${finishRecords[finishAt]}" )" status )" != "spawn-started" ] || finishFound="yes"
					finishAt=$(( finishAt + 1 ))
				done
				[ -n "$finishFound" ] || break
				sleep 0.25
				finishWait=$(( finishWait - 1 ))
			done
		fi
		finishAt=0
		while [ "$finishAt" -lt "${#finishSpawns[@]}" ] ; do
			finishSpawn="${finishSpawns[finishAt]}" ; finishMember="${finishMembers[finishAt]}" ; finishRecord="${finishRecords[finishAt]}"
			finishAt=$(( finishAt + 1 ))
			[ "$( AgentsToolsRegistryHeader "$( AgentsToolsRegistryFrontmatter "$finishRecord" )" status )" = "spawn-started" ] || continue
			if [ -n "${finishWaits[finishAt - 1]}" ] ; then
				printf 'close\t%s\t%s\t%s\tleft\t-\n' "$finishSession" "$finishSpawn" "$finishMember"
				continue
			fi
			if [ -n "$finishPlan" ] ; then
				printf 'close\t%s\t%s\t%s\twould-close\t-\n' "$finishSession" "$finishSpawn" "$finishMember"
				finishClosed=$(( finishClosed + 1 ))
				continue
			fi
			## Marked and recorded here where no kill ended its process: such a record is told
			## as one that was closed, and one a kill had marked as a run that was killed.
			finishMarked="$( AgentsToolsRegistryHeader "$( AgentsToolsRegistryFrontmatter "$finishRecord" )" killed-at )"
			finishItem="-"
			case "$finishMarked" in
				''|-)
					finishMarked=""
					AgentsToolsManagerKillMark "$finishRecord" "$finishWho" "$finishStamp" < /dev/null \
						|| echo "⚠️ WARNING: $MDSC_CMD $finishOp: the record of run $finishSpawn could not be marked as killed from the console" >&2
					finishItem="$( AgentsToolsManagerKillRecord "$finishSpawn" "$finishWho" < /dev/null )"
				;;
			esac
			if ( AgentsToolsSessionControlDeathClose "$finishRecord" ) > /dev/null 2>&1 < /dev/null ; then
				( AgentsToolsSpawnProxyEndNotice "$finishRecord" "$( [ -n "$finishMarked" ] || printf 'closed' )" ) > /dev/null < /dev/null || :
				[ "$finishItem" != "-" ] || finishItem="$( AgentsToolsRegistryHeader "$( AgentsToolsRegistryFrontmatter "$finishRecord" )" spawns )"
				printf 'close\t%s\t%s\t%s\tclosed\t%s\n' "$finishSession" "$finishSpawn" "$finishMember" "${finishItem:--}"
				finishClosed=$(( finishClosed + 1 ))
			else
				printf 'close\t%s\t%s\t%s\tnot-closed\t-\n' "$finishSession" "$finishSpawn" "$finishMember"
			fi
		done
	fi
	[ -n "$finishWhole" ] || return 0
	## The state the session reads now, by the read of one session: its records and its
	## questions as they stand after this.
	if [ -z "$finishPlan" ] ; then
		scopeSession="" ; scopeRun="" ; scopeMeasured="" ; scopeListed="" ; scopeControl=""
		AgentsToolsManagerSessionScope "$finishOp" "$finishSession" "" "its state could not be read again" 2> /dev/null || :
	fi
	while IFS="$finishTab" read -r finishKind finishRest finishRest finishStatus finishRest ; do
		[ "$finishKind" != "session" ] || { finishState="$finishStatus" ; break ; }
	done <<< "$scopeListed"
	printf 'finish\t%s\t%s\t%s\t%s\t%s\n' "$finishSession" "$finishEnded" "$finishDismissed" "$finishClosed" "${finishState:--}"
	return 0
}

case "$1" in

	## The sessions of this workspace, each with its runs, then one row of counters: TAB-separated
	## rows a screen reads. Their form is the help entry's.
	--manager-session-list)
		local listOp="$1" listActive=""
		shift
		while [ $# -gt 0 ] ; do
			case "$1" in
				--active) listActive="active" ; shift ;;
				*)
					echo "⛔ ERROR: $MDSC_CMD $listOp: syntax is [--active], got: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		AgentsToolsManagerSessionRows "$listOp" "$listActive" || { set +e ; return 1 ; }
		return 0
	;;

	## One session, or one run of it, in full: its rows as the list prints them, what it was
	## started for, and each run's record and store. TAB-separated rows a screen reads; their
	## form is the help entry's. It reads one session's records and stores, never another's.
	--manager-session-read)
		local readOp="$1" readId="" readOwn="" readStores="" readSkip readSpawn readRest
		local scopeSession="" scopeRun="" scopeMeasured="" scopeListed="" scopeControl=""
		shift
		while [ $# -gt 0 ] ; do
			case "$1" in
				--session-id)
					if [ $# -lt 2 ] || [ -z "$2" ] || [ "$2" = "-" ] ; then
						echo "⛔ ERROR: $MDSC_CMD $readOp: --session-id needs an id -- syntax is --session-id <id> [--run]" >&2
						set +e ; return 1
					fi
					readId="$2" ; shift 2
				;;
				--run) readOwn="run" ; shift ;;
				*)
					echo "⛔ ERROR: $MDSC_CMD $readOp: syntax is --session-id <id> [--run], got: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$readId" ] ; then
			echo "⛔ ERROR: $MDSC_CMD $readOp: syntax is --session-id <id> [--run], got no --session-id" >&2
			set +e ; return 1
		fi
		AgentsToolsManagerSessionScope "$readOp" "$readId" "$readOwn" || { set +e ; return 1 ; }
		## Which runs have a store of their own: a folder is asked of the shell, not of awk.
		while read -r readSkip readSkip readSkip readSkip readSkip readSkip readSkip readSpawn readRest ; do
			case "$readSpawn" in ''|-|.|..|*/*) continue ;; esac
			[ ! -d "$MMDAPP/.local/agents/sessions/$readSpawn" ] || readStores="$readStores$readSpawn"$'\n'
		done <<< "$scopeMeasured"
		[ "$scopeRun" != "-" ] || scopeRun=""
		printf '%s\n' "$scopeListed" \
			| MDAT_MANAGER_AGENTS="$MMDAPP/.local/agents" MDAT_MANAGER_ROWS="$scopeMeasured" MDAT_MANAGER_STORES="$readStores" MDAT_MANAGER_RUN="$scopeRun" MDAT_MANAGER_CONTROL="$scopeControl" \
				LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsManagerSessionTokens.awk" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsManagerSessionRead.awk" "$( AgentsToolsRegistryFile pending-replies )" -
		return 0
	;;

	## What one run, or every run of one session, did: the lines the tracking thread of the
	## session shows, from where they last, the run's transcript, in the order of their times,
	## the newest last. A run with no transcript gives the end of its session log in their
	## place, and --log asks for that raw log of every run; a `source` row says which of the
	## two each run gave. TAB-separated rows a screen reads; their form is the help entry's.
	--manager-session-transcript-read)
		local transcriptOp="$1" transcriptId="" transcriptOwn="" transcriptTail=200 transcriptLog=""
		local transcriptSyntax="--session-id <id> [--run] [--tail <lines>] [--log]"
		local transcriptLib="$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib" transcriptTab=$'\t' transcriptNl=$'\n' transcriptBs='\'
		local transcriptSources="" transcriptLogs="" transcriptFeed="" transcriptFrom=""
		local runKind runSession runSpawn runMember runRest runSource runPath runShown runLines runCut runRows runFrom
		local scopeSession="" scopeRun="" scopeMeasured="" scopeListed="" scopeControl=""
		shift
		while [ $# -gt 0 ] ; do
			case "$1" in
				--session-id)
					if [ $# -lt 2 ] || [ -z "$2" ] || [ "$2" = "-" ] ; then
						echo "⛔ ERROR: $MDSC_CMD $transcriptOp: --session-id needs an id -- syntax is $transcriptSyntax" >&2
						set +e ; return 1
					fi
					transcriptId="$2" ; shift 2
				;;
				--tail)
					case "${2:-}" in
						''|0*|*[!0123456789]*)
							echo "⛔ ERROR: $MDSC_CMD $transcriptOp: --tail needs a count of lines, 1 or more, got: ${2:-nothing} -- syntax is $transcriptSyntax" >&2
							set +e ; return 1
						;;
					esac
					transcriptTail="$2" ; shift 2
				;;
				--run) transcriptOwn="run" ; shift ;;
				--log) transcriptLog="log" ; shift ;;
				*)
					echo "⛔ ERROR: $MDSC_CMD $transcriptOp: syntax is $transcriptSyntax, got: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$transcriptId" ] ; then
			echo "⛔ ERROR: $MDSC_CMD $transcriptOp: syntax is $transcriptSyntax, got no --session-id" >&2
			set +e ; return 1
		fi
		AgentsToolsManagerSessionScope "$transcriptOp" "$transcriptId" "$transcriptOwn" || { set +e ; return 1 ; }
		type AgentsTranscriptParts > /dev/null 2>&1 || . "$transcriptLib/AgentsTools.SessionTranscript.include"
		while IFS="$transcriptTab" read -r runKind runSession runSpawn runMember runRest ; do
			[ "$runKind" = "run" ] || continue
			[ "$scopeRun" = "-" ] || [ "$runSpawn" = "$scopeRun" ] || continue
			## Where this run's lines are read from: its transcript where it has one, else its
			## session log; with --log its session log alone.
			runSource="none" ; runPath=""
			case "$runSpawn" in
				-|.|..|*/*|*' '*) ;;
				*)
					if [ -z "$transcriptLog" ] && runPath="$( AgentsTranscriptBase "$runSpawn" )" ; then
						runSource="transcript"
					elif [ -f "$MMDAPP/.local/agents/sessions/$runSpawn/session.log" ] ; then
						runSource="session-log" ; runPath="$MMDAPP/.local/agents/sessions/$runSpawn/session.log"
					else
						runPath=""
					fi
				;;
			esac
			runShown="${runPath:--}"
			runShown=${runShown//"$transcriptBs"/"$transcriptBs$transcriptBs"}
			runShown=${runShown//"$transcriptTab"/"${transcriptBs}t"}
			transcriptSources="${transcriptSources}source$transcriptTab$runSpawn$transcriptTab$runMember$transcriptTab$runSource$transcriptTab$runShown$transcriptNl"
			case "$runSource" in
				session-log)
					runRows="$( tail -n "$transcriptTail" "$runPath" 2>/dev/null \
						| MDAT_MANAGER_SPAWN="$runSpawn" MDAT_MANAGER_MEMBER="$runMember" LC_ALL=C awk -v transcriptMode=log -f "$transcriptLib/AgentsSessionTranscriptFormat.awk" -f "$transcriptLib/AgentsManagerSessionTranscript.awk" )"
					[ -z "$runRows" ] || transcriptLogs="$transcriptLogs$runRows$transcriptNl"
				;;
				transcript)
					runLines="$( AgentsToolsManagerTranscriptTail "$runSpawn" "$transcriptTail" )" || runLines=""
					runCut=${runLines%%"$transcriptNl"*}
					case "$runLines" in *"$transcriptNl"*) runLines=${runLines#*"$transcriptNl"} ;; *) runLines="" ;; esac
					[ -n "$runLines" ] || continue
					## Each operation as the line the tracking thread shows for it, by the tracking
					## post's own renderer and its template; no post is made, and nothing is written.
					type AgentsEventTrackPostRender > /dev/null 2>&1 || . "$transcriptLib/AgentsTools.InternOpEventTrackPost.include"
					runRows="$( printf '%s\n' "$runLines" | ETP_ROWS=1 AgentsEventTrackPostRender feed "$runMember" "" "" - \
						| MDAT_MANAGER_SPAWN="$runSpawn" MDAT_MANAGER_MEMBER="$runMember" LC_ALL=C awk -v transcriptMode=feed -f "$transcriptLib/AgentsSessionTranscriptFormat.awk" -f "$transcriptLib/AgentsManagerSessionTranscript.awk" )"
					[ -n "$runRows" ] || continue
					transcriptFeed="$transcriptFeed$runRows$transcriptNl"
					## A run whose transcript is cut holds nothing before its first line here: the
					## lines of a session start where every run's are held, the latest such moment.
					if [ "$runCut" = "cut" ] ; then
						runFrom=${runRows#feed"$transcriptTab"} ; runFrom=${runFrom%%"$transcriptTab"*}
						[ "$runFrom" = "-" ] || { [ -n "$transcriptFrom" ] && [ ! "$runFrom" \> "$transcriptFrom" ] ; } || transcriptFrom="$runFrom"
					fi
				;;
			esac
		done <<< "$scopeListed"
		printf '%s' "$transcriptSources$transcriptLogs"
		[ -z "$transcriptFeed" ] || printf '%s' "$transcriptFeed" \
			| LC_ALL=C sort -s -t "$transcriptTab" -k2,2 \
			| LC_ALL=C awk -F "$transcriptTab" -v fromMoment="$transcriptFrom" '$2 == "-" || $2 >= fromMoment'
		return 0
	;;

	## One run, or every live run of one session, ended the hard way, and one row a run saying
	## what happened to it: TAB-separated rows a screen reads, their form the help entry's. It
	## asks for no confirmation: that is the screen's.
	--manager-session-kill)
		local killOp="$1" killId="" killOwn="" killPlan="" killRows="" killRc=0 killEnded=0
		shift
		## The escalation words (F6.10, AgentsTools.Authority.include), taken out wherever they stand.
		type AgentsToolsAuthorityGate > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.Authority.include"
		AgentsToolsAuthorityFlags "$@" || { set +e ; return 1 ; }
		set -- "${agentsAuthorityRest[@]}"
		while [ $# -gt 0 ] ; do
			case "$1" in
				--session-id)
					if [ $# -lt 2 ] || [ -z "$2" ] || [ "$2" = "-" ] ; then
						echo "⛔ ERROR: $MDSC_CMD $killOp: --session-id needs an id -- syntax is --session-id <id> [--run] [--plan]" >&2
						set +e ; return 1
					fi
					killId="$2" ; shift 2
				;;
				--run) killOwn="run" ; shift ;;
				--plan) killPlan="plan" ; shift ;;
				*)
					echo "⛔ ERROR: $MDSC_CMD $killOp: syntax is --session-id <id> [--run] [--plan], got: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$killId" ] ; then
			echo "⛔ ERROR: $MDSC_CMD $killOp: syntax is --session-id <id> [--run] [--plan], got no --session-id" >&2
			set +e ; return 1
		fi
		## WHO CARRIES IT OUT. Where the control thread of the session lives, the thread does:
		## it is asked by a request in its folder and woken, and what it did is printed here.
		## Where none lives, or it does not take the request in time, this call does, as
		## before, and says so in one line (AgentsToolsSessionControlRequestKill).
		type AgentsToolsSessionControlRequestKill > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.SessionControlRequest.include"
		## The thread's own call carries the kill out, and no more: what the kill of a session
		## finishes is done by the console that asked, once it has the rows of the kill. Nor
		## does the thread's call about a death, whose answer `kill` ends what lives of the
		## session: it settles the record of its dead run itself, and asks for the kill alone
		## (controlMode is that call's own, AgentsTools.InternSessionControl.include).
		if [ -n "${agentsSessionControlCarried:-}" ] || [ "${controlMode:-}" = "--death" ] ; then
			AgentsToolsSessionControlRequestKill "$killOp" "$killId" "$killOwn" || { set +e ; return 1 ; }
			return 0
		fi
		## THE AUTHORITY to end it (F6.10): over one run, whoever it reports to; over a whole session,
		## whoever its founding run reports to; the owners role; or a grant of it. A plan ends nothing,
		## and an id no record here carries is refused as it was, below.
		if [ -z "$killPlan" ] && [ -n "$( LC_ALL=C grep -l -x -F -e "session-id: $killId" -e "spawn-id: $killId" "$MMDAPP"/.local/agents/spawned/*/*.md 2> /dev/null | head -1 )" ] ; then
			local killRecord=""
			type AgentsToolsSessionRunRecord > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.SpawnSandbox.include"
			if [ -n "$killOwn" ] ; then
				killRecord="$( AgentsToolsSessionRunRecord "$killId" )" || killRecord=""
			else
				killRecord="$( AgentsToolsAuthoritySessionRecord "$killId" )" || killRecord="$( AgentsToolsSessionRunRecord "$killId" )" || killRecord=""
			fi
			AgentsToolsAuthorityGate "the end of $( [ -n "$killOwn" ] && printf 'run' || printf 'session' ) $killId" "$killId" "$killRecord" "" console \
				"$killOp" --session-id "$killId" ${killOwn:+--run} || :
			AgentsToolsAuthorityExit || { set +e ; return "$agentsAuthorityExit" ; }
		fi
		## THEN THE SESSION IS FINISHED: its questions dismissed, its open records closed, and
		## rows that say so after the rows of the kill (AgentsToolsManagerSessionFinish). With
		## --plan nothing is ended and nothing is done: the same rows say what would be.
		if [ -z "$killPlan" ] ; then
			killRows="$( AgentsToolsSessionControlRequestKill "$killOp" "$killId" "$killOwn" )" || killRc=$?
			[ -z "$killRows" ] || printf '%s\n' "$killRows"
			[ "$killRc" = 0 ] || { set +e ; return 1 ; }
			killEnded="$( printf '%s\n' "$killRows" | LC_ALL=C awk -F'\t' '$1 == "kill" && ( $5 == "ended" || $5 == "killed" ) { rowsEnded++ } END { print rowsEnded + 0 }' )"
		fi
		AgentsToolsManagerSessionFinish "$killOp" "$killId" "$killOwn" "$killPlan" "$killEnded" || { set +e ; return 1 ; }
		return 0
	;;

	## The control thread of one session started where it does not live, or, with --all, of
	## every session of this workspace that needs one and has none alive: the check now of the
	## manager, the one the advance lock take and the main loop make too
	## (AgentsTools.SessionControlStart.include). One row a session, TAB-separated, their form
	## the help entry's. A thread is started detached and is asked only whether it took the
	## lock of its session, within a bound; no process is ended, and no agent is involved.
	--manager-session-control-start)
		local controlOp="$1" controlId="" controlAll="" controlSyntax="(--session-id <id>|--all)"
		local controlTab=$'\t' controlBs='\' controlLines="" controlAnswer="" controlFailed=0 controlDeadline=0 controlLeft=0
		local controlSession controlWord controlPid controlWhy controlHosts controlOutcome
		local scopeSession="" scopeRun="" scopeMeasured="" scopeListed="" scopeControl=""
		shift
		while [ $# -gt 0 ] ; do
			case "$1" in
				--session-id)
					if [ $# -lt 2 ] || [ -z "$2" ] || [ "$2" = "-" ] ; then
						echo "⛔ ERROR: $MDSC_CMD $controlOp: --session-id needs an id -- syntax is $controlSyntax" >&2
						set +e ; return 1
					fi
					controlId="$2" ; shift 2
				;;
				--all) controlAll="all" ; shift ;;
				*)
					echo "⛔ ERROR: $MDSC_CMD $controlOp: syntax is $controlSyntax, got: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$controlId$controlAll" ] || { [ -n "$controlId" ] && [ -n "$controlAll" ] ; } ; then
			echo "⛔ ERROR: $MDSC_CMD $controlOp: syntax is $controlSyntax: one session by its id, or --all, and not both" >&2
			set +e ; return 1
		fi
		type AgentsToolsSessionControlStart > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.SessionControlStart.include"
		if [ -n "$controlAll" ] ; then
			## The check now: every session of the workspace is read, and a line comes back for
			## each that needed a thread and had none alive.
			controlLines="$( AgentsToolsSessionControlCheckWorkspace )" || {
				echo "⛔ ERROR: $MDSC_CMD $controlOp: the sessions registry could not be rebuilt in $MMDAPP/.local/agents -- nothing was started" >&2
				set +e ; return 1
			}
		else
			## One session by name, the id taken as the read of a session takes it: the registry
			## of the runs is rebuilt first, always, so that a run that joined the session a
			## moment ago is among its rows. A start by name is made at once: the pause of the
			## check is not asked.
			if [ -d "$MMDAPP/.local/agents/spawned" ] && ! AgentsToolsRegistrySpawnedSessionsRebuild ; then
				echo "⛔ ERROR: $MDSC_CMD $controlOp: the sessions registry could not be rebuilt in $MMDAPP/.local/agents -- nothing was started" >&2
				set +e ; return 1
			fi
			AgentsToolsManagerSessionScope "$controlOp" "$controlId" "" "nothing was started" || { set +e ; return 1 ; }
			controlSession="$scopeSession"
			controlAnswer="$( printf '%s\n' "$controlSession" | AgentsToolsSessionControlLive )" || controlAnswer=""
			controlWord="" ; controlHosts=""
			## What the rows of the session say, their thirteen first words being the measured row.
			read -r controlPid controlWord controlHosts <<< "$( printf '%s' "$scopeMeasured" | LC_ALL=C cut -d ' ' -f 1-13 | AgentsToolsSessionControlJudged )" || :
			if [ -n "$controlAnswer" ] ; then
				controlLines="$controlSession alive ${controlAnswer#* }"
			elif [ "$controlWord" = "finished" ] ; then
				controlLines="$controlSession needless - every run of it has closed its record, and a finished session needs no thread"
			elif [ "$controlWord" = "foreign" ] ; then
				controlLines="$controlSession failed - its open records are runs of another host ($controlHosts), which cannot be watched from here"
			elif [ "$controlWord" = "unmeasured" ] ; then
				controlLines="$controlSession failed - its open records name no host or no run, so that no run of it can be told alive or gone from here"
			elif [ "$controlWord" != "running" ] && [ "$controlWord" != "open" ] ; then
				controlLines="$controlSession failed - the rows of its runs could not be read as a session"
			elif AgentsToolsSessionControlWaited "$controlSession" ; then
				controlLines="$controlSession needless - the start that opened it is one its caller waits on, and that caller watches it"
			else
				controlAnswer="$( AgentsToolsSessionControlStart "$controlSession" )" || :
				controlLines="$controlSession ${controlAnswer:-failed - the start said nothing}"
			fi
			## A session that needs none keeps nothing of a thread that died: the pid file and the
			## lock such a thread left are removed, where neither names a thread that lives, and
			## the session then reads as one that has no thread (AgentsToolsSessionControlLeftovers).
			case "$controlLines" in "$controlSession needless - "*) AgentsToolsSessionControlLeftovers "$controlSession" ;; esac
		fi
		## What became of each start is asked before its row is printed, all of them within one
		## bound: a thread holds its session within a second or so of its start.
		controlDeadline=$(( SECONDS + agentsSessionControlHoldSeconds ))
		while read -r controlSession controlWord controlPid controlWhy ; do
			[ -n "$controlSession" ] || continue
			if [ "$controlWord" = "started" ] ; then
				controlLeft=$(( controlDeadline - SECONDS ))
				[ "$controlLeft" -gt 0 ] || controlLeft=0
				controlAnswer="$( AgentsToolsSessionControlStartOutcome "$controlSession" "$controlPid" "$controlLeft" )" || :
				read -r controlWord controlPid controlWhy <<< "${controlAnswer:-failed - nothing could be read of the start}" || :
			fi
			case "$controlWord" in
				started|alive) controlOutcome="$controlWord" ;;
				needless) controlOutcome="not-needed" ;;
				held) controlOutcome="not-started" ;;
				*) controlOutcome="not-started" ; controlFailed=$(( controlFailed + 1 )) ;;
			esac
			controlWhy=${controlWhy//"$controlBs"/"$controlBs$controlBs"}
			controlWhy=${controlWhy//"$controlTab"/"${controlBs}t"}
			printf 'control\t%s\t%s\t%s\t%s\n' "$controlSession" "$controlOutcome" "${controlPid:--}" "${controlWhy:--}"
		done <<< "$controlLines"
		[ -n "$controlLines" ] || echo "# $MDSC_CMD $controlOp: no session of this workspace needs its control thread started, so nothing was started" >&2
		if [ "$controlFailed" -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD $controlOp: $controlFailed control thread(s) could not be started -- see the not-started row(s)" >&2
			set +e ; return 1
		fi
		return 0
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
