#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.Owner.include -- the --owner-* operation-group body for
## DistroAgentsTools.fn.sh's single dispatcher, sourced lazily (only when
## $1 actually matches --owner-*) from that file's own `--owner-*)` arm,
## via the absolute $MDLT_ORIGIN-based path already used for every other
## cross-file source in this family (see --agents-config-option and the
## --pretty AgentsSlackMessagesFormat.awk reference in the same file).
##
## Not standalone-executable: relies on being dot-sourced into
## DistroAgentsTools's own function scope for $1/$@, the $MDSC_CMD local,
## and self-recursive calls back into the DistroAgentsTools function name.
##
## Owns a complete, self-contained `case "$1" in ... esac` -- the only
## shape that externalizes a whole multi-arm operation group without
## reintroducing the reverted per-op-function pattern (a separate
## DistroAgentsTools<OpName> function per op) that caused a real bare
## self-call bug; see myx.distro-agents/CLAUDE.md's "DistroAgentsTools --
## gotchas" section. Splitting these 4 arms into 4 separate functions is
## the one thing NOT to do here, even though this file only holds one
## group -- consistency with the reverted-pattern lesson, not a
## per-file judgment call.
##
## Carries its own `*)` default arm, deliberately duplicating the outer
## dispatcher's own catch-all error text: once the outer dispatcher routes
## every --owner-* invocation into this file via its own wildcard arm, an
## unrecognized --owner-<typo> would otherwise be swallowed here silently
## instead of falling through to the outer case's catch-all -- this
## default arm is what keeps that failure mode identical to every other
## invalid option.
##

case "$1" in

	## Manages human-owner.workspaces.md, the bare one-absolute-path-per-line
	## file at
	## $HOME/.claude/skills/human-owner/human-owner.workspaces.md that is the
	## ONLY authoritative source of truth for the workspace paths the team
	## tracks (see magic-team.armed.md's "Workspace" entry -- that file never
	## states a literal path itself). Every line in the target file IS data
	## (no header/prose, unlike --write-inbox-note's free-form note body), so
	## matching is always exact-whole-line (`grep -Fx`), never a regex/glob --
	## this also makes a path containing spaces or shell metacharacters safe
	## as long as the caller passes it as one argument. <path> must be
	## absolute; a single trailing slash is stripped before comparing/storing
	## so `/foo/bar` and `/foo/bar/` collapse to one entry (`/` itself is
	## special-cased so stripping never reduces it to an empty/blank line).
	## Existence of <path> on disk is deliberately NOT checked -- a tracked
	## workspace may legitimately live on a currently-unmounted volume (e.g.
	## /Volumes/ws-2017). Same temp-file+trap+mv idiom as
	## LocalTools.Config.include's own --upsert/--delete.
	--owner-workspace-upsert)
		shift
		local wsPath="$1"
		shift || true
		if [ -z "$wsPath" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --owner-workspace-upsert: <path> required" >&2
			set +e ; return 1
		fi
		case "$wsPath" in
			/*)
			;;
			*)
				echo "⛔ ERROR: $MDSC_CMD --owner-workspace-upsert: path must be absolute: $wsPath" >&2
				set +e ; return 1
			;;
		esac
		[ "$wsPath" = "/" ] || wsPath="${wsPath%/}"
		local ownerDir="$HOME/.claude/skills/human-owner"
		if [ ! -d "$ownerDir" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --owner-workspace-upsert: no such skill directory: $ownerDir" >&2
			set +e ; return 1
		fi
		local ownerFile="$ownerDir/human-owner.workspaces.md"
		touch "$ownerFile"
		if grep -Fxq -- "$wsPath" "$ownerFile" ; then
			echo "# $MDSC_CMD --owner-workspace-upsert: already tracked: $wsPath" >&2
			return 0
		fi
		## Guard against a missing trailing newline on the existing file --
		## a bare `>>` append onto a file whose last byte isn't already a
		## newline silently merges the new path
		## onto the end of the previous last line instead of starting a new
		## one (`grep '^/'` in --owner-workspace-list then reads both as one
		## bogus concatenated path). `-s`/non-empty-tail-byte check, not
		## `wc -l`-based, since a single-line file with no trailing newline
		## has "1 line" by most line-counting tools despite lacking the
		## newline this op actually depends on.
		if [ -s "$ownerFile" ] && [ -n "$( tail -c1 -- "$ownerFile" )" ] ; then
			printf '\n' >> "$ownerFile"
		fi
		printf '%s\n' "$wsPath" >> "$ownerFile"
		echo "# $MDSC_CMD --owner-workspace-upsert: added: $wsPath" >&2
		return 0
	;;

	--owner-workspace-forget)
		shift
		local wsPath="$1"
		shift || true
		if [ -z "$wsPath" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --owner-workspace-forget: <path> required" >&2
			set +e ; return 1
		fi
		[ "$wsPath" = "/" ] || wsPath="${wsPath%/}"
		local ownerFile="$HOME/.claude/skills/human-owner/human-owner.workspaces.md"
		if [ ! -f "$ownerFile" ] ; then
			echo "# $MDSC_CMD --owner-workspace-forget: $ownerFile does not exist -- nothing to forget" >&2
			return 0
		fi
		if ! grep -Fxq -- "$wsPath" "$ownerFile" ; then
			echo "# $MDSC_CMD --owner-workspace-forget: not tracked, nothing to do: $wsPath" >&2
			return 0
		fi
		(
			tmp="$ownerFile.$$"
			trap 'rm -f -- "$tmp"' EXIT
			: > "$tmp"
			grep -Fxv -- "$wsPath" "$ownerFile" >>"$tmp" 2>/dev/null || :
			mv "$tmp" "$ownerFile"
		)
		echo "# $MDSC_CMD --owner-workspace-forget: removed: $wsPath" >&2
		return 0
	;;

	--owner-workspace-list)
		shift
		if [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --owner-workspace-list: takes no arguments" >&2
			set +e ; return 1
		fi
		local ownerFile="$HOME/.claude/skills/human-owner/human-owner.workspaces.md"
		if [ ! -f "$ownerFile" ] ; then
			echo "# $MDSC_CMD --owner-workspace-list: $ownerFile does not exist -- no workspaces tracked yet" >&2
			return 0
		fi
		grep '^/' "$ownerFile" || :
		return 0
	;;

	## Registers this tool's own workspace root ($MMDAPP) into the same
	## tracked-workspace registry --owner-workspace-upsert maintains, then
	## prints it to stdout -- a one-shot "track + tell me where I am"
	## convenience op for a caller that already knows it wants the
	## current workspace tracked and doesn't want to spell out $MMDAPP
	## itself. Delegates to --owner-workspace-upsert internally (same
	## self-call idiom as --agents-config-option's own internal callers
	## above) rather than duplicating its file-write logic.
	--owner-workspace-current)
		shift
		if [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --owner-workspace-current: takes no arguments" >&2
			set +e ; return 1
		fi
		DistroAgentsTools --owner-workspace-upsert "$MMDAPP" || return 1
		echo "$MMDAPP"
		return 0
	;;

	## Installs/updates the baseline VS Code + Claude Code integrations for
	## this workspace: workspace-local MCP wiring
	## for both clients -- .vscode/mcp.json ("servers" key, VS Code/
	## Copilot-Chat's own schema) and .mcp.json ("mcpServers" key, Claude
	## Code's own project-scope schema, and also what Copilot CLI reads since
	## it dropped .vscode/mcp.json support) -- both pointing at the same
	## resolved myx.common bin/lib/agentMcpServer.Common, launched with
	## --run, plus Claude Code's home local scope
	## (~/.claude.json projects["<workspace>"].mcpServers) delegated to
	## myx.common's own setup/agentMcp against that same resolved copy.
	## Finally it regenerates this workspace's `.code-workspace` through that
	## workspace's own Source Console, which is what makes the generated
	## `chat.agentSkillsLocations` key (the magic-team member-discovery
	## setting) exist -- so the install path leaves nothing further owed.
	## Non-destructive to unrelated MCP servers in any of those
	## files: only upserts/overwrites the one "myx" server key. Requires the
	## target workspace to already be a set-up myx.distro workspace -- checks for
	## .local/myx/myx.distro-.local/sh-lib/LocalContext.include, the same
	## marker file SystemContext.SetInputSpec.include uses elsewhere in this
	## codebase to detect a real origin -- before doing anything else.
	--owner-install-vscode-integrations)
		shift
		local workspaceArg
		while [ $# -gt 0 ] ; do
			case "$1" in
				--workspace)
					workspaceArg="$2" ; shift 2
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --owner-install-vscode-integrations: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done

		local workspace
		workspace="${workspaceArg:-$MMDAPP}"
		if [ ! -d "$workspace" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --owner-install-vscode-integrations: workspace not found: $workspace" >&2
			set +e ; return 1
		fi
		workspace="$( cd "$workspace" && pwd )"

		local localContextMarker="$workspace/.local/myx/myx.distro-.local/sh-lib/LocalContext.include"
		if [ ! -f "$localContextMarker" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --owner-install-vscode-integrations: not a set-up myx.distro workspace (missing $localContextMarker)" >&2
			set +e ; return 1
		fi

		local failed=0

		echo "# $MDSC_CMD --owner-install-vscode-integrations: workspace=$workspace" >&2

		##
		## THIS OP INSTALLS NO EXTENSIONS, BY INSTRUCTION.
		##
		## An earlier revision ran `code --install-extension` for
		## github.copilot, github.copilot-chat and anthropic.claude-code, and
		## reported a missing `code` CLI as a FAIL. Both are removed:
		## human-owner's instruction is "DO NOT INSTALL 3RD-PARTY PLUGINS ETC
		## / DO NOT INSTALL COPILOT - SETUP THE SETTINGS FOR IT". Which
		## extensions the user runs is the user's choice; this op's job is to
		## configure the workspace so that whatever client IS present can
		## discover this workspace's MCP server and its magic-team members.
		##
		## Nothing here shells out to `code` at all any more, so a machine
		## with no VS Code CLI on PATH is no longer a partial install.
		##
		## The member-discovery half of "setup the settings for it" is not
		## WRITTEN here: it is a generated `.code-workspace` settings
		## fragment (AgentsTools.Make.VSCodeSettingsFragment.include), because
		## the `.code-workspace` is regenerated by
		## myx.distro-source's BuildCodeWorkspaceData and anything this op
		## poked into that file directly would be erased on the next build.
		## It is however TRIGGERED here -- see the regeneration step at the
		## end of this op, which runs that build rather than writing the file.
		##

		## Resolve the myx.common install ROOT (the `share/myx.common`
		## directory), not the server script alone: the home-scope
		## delegation further down needs the root too, and both
		## registrations must describe the SAME copy or an MCP host would
		## get two different servers depending on which config it read.
		##
		## The server lives at bin/lib/agentMcpServer.Common. It used to be
		## include/data/agentMcpServer.sh, and probing for that old path is
		## what made this op fail outright on a machine with no stale cache
		## (nothing matches -> "unresolved") while silently registering a
		## months-old deprecated server on a machine that still had one.
		##
		## Workspace-local copies are probed before any globally installed
		## myx.common, deliberately: a workspace carries the copy it is
		## actually built against, whereas a /usr/local install is routinely
		## older -- confirmed live on this machine, where the global install
		## predates bin/lib/agentMcpServer.Common existing at all and would
		## have resolved to nothing usable.
		##
		## `mcpRootFound` separately remembers a copy that exists but is not
		## executable, so that case can be reported as the one-line chmod it
		## actually is instead of being flattened into "not found".
		local mcpRoot="" mcpRootFound=""
		local c
		for c in \
			"$workspace/.local/myx/myx.common/os-myx.common/host/tarball/share/myx.common" \
			"$workspace/myx.common/os-myx.common/host/tarball/share/myx.common" \
			"$workspace/source/myx/myx.common/os-myx.common/host/tarball/share/myx.common" \
		; do
			[ -f "$c/bin/lib/agentMcpServer.Common" ] || continue
			[ -n "$mcpRootFound" ] || mcpRootFound="$c"
			if [ -x "$c/bin/lib/agentMcpServer.Common" ] ; then
				mcpRoot="$c"
				break
			fi
		done
		if [ -z "$mcpRoot" ] && command -v myx.common >/dev/null 2>&1 ; then
			local root
			root="$( myx.common which lib/catMarkdown 2>/dev/null )"
			root="${root%/bin/lib/catMarkdown*}"
			if [ -n "$root" ] && [ -f "$root/bin/lib/agentMcpServer.Common" ] ; then
				[ -n "$mcpRootFound" ] || mcpRootFound="$root"
				[ -x "$root/bin/lib/agentMcpServer.Common" ] && mcpRoot="$root"
			fi
		fi

		local serverScript=""
		[ -z "$mcpRoot" ] || serverScript="$mcpRoot/bin/lib/agentMcpServer.Common"

		local vscodeMcpDir="$workspace/.vscode"
		mkdir -p "$vscodeMcpDir"

		if [ -z "$serverScript" ] ; then
			if [ -n "$mcpRootFound" ] ; then
				echo "FAIL mcp-server-path found but not executable: $mcpRootFound/bin/lib/agentMcpServer.Common" >&2
				echo "   fix with: chmod +x $mcpRootFound/bin/lib/agentMcpServer.Common" >&2
			else
				echo "FAIL mcp-server-path unresolved (bin/lib/agentMcpServer.Common not found under workspace/.local, workspace source, or a globally installed myx.common)" >&2
			fi
			failed=1
		else
			## Home-scope tier FIRST, workspace-scope tiers after it.
			##
			## ~/.claude.json's projects["<workspace>"].mcpServers is Claude
			## Code's own local scope, and no file inside the workspace can
			## supply it -- without it a fresh machine has no myx MCP server
			## for any Claude Code session started outside a trusted project
			## config. It is delegated to myx.common's own setup/agentMcp
			## rather than reimplemented: that script edits ~/.claude.json by
			## surgical byte-range splice (never a full reparse/rewrite of a
			## file that holds far more than MCP config), and a second
			## implementation of that is not worth owning.
			##
			## MYXROOT is pinned to the copy resolved above instead of
			## letting setup/agentMcp fall back to its own /usr/local default:
			## the global install is routinely older and may not carry
			## bin/lib/agentMcpServer.Common at all, in which case delegation
			## would simply fail. MYX_AGENTMCP_TARGET_CWD states the target
			## workspace explicitly rather than depending on this process's
			## own cwd (see that script's header for why that env var exists).
			##
			## Running it first, not last, is deliberate: its own workspace
			## tier re-writes .vscode/mcp.json as a side effect, so the
			## workspace loop below stays the LAST writer of every file this
			## op is accountable for -- which is what makes that loop's
			## verification meaningful.
			##
			## This tier used to be non-fatal, on the reasoning that
			## ~/.claude.json only exists once Claude Code has been run at
			## least once and that the workspace-scope .mcp.json below already
			## covers Claude Code for THIS workspace. Both halves of that were
			## wrong in the one scenario this op exists for. The premise is
			## gone: setup/agentMcp now seeds ~/.claude.json when it is absent
			## instead of refusing, so "never run yet" is no longer a reason
			## this tier cannot succeed. And the consolation was never
			## equivalent -- the home scope is what serves a Claude Code
			## session started outside a trusted project config, which no file
			## inside the workspace can supply. So a tier that did not write
			## its target is now counted as a failure like every other target
			## here: on a fresh machine the op reported OK and exit 0 while
			## silently installing 2 of its 3 MCP registrations, which is the
			## acceptance scenario passing without being installed.
			##
			## The exit code is consumed only by --install-workspace-
			## integrations and --install-vscode-integrations, which both
			## propagate it straight up; nothing tolerates a non-zero here by
			## design.
			local homeSetup="$mcpRoot/bin/setup/agentMcp.Common"
			if [ ! -x "$homeSetup" ] ; then
				echo "FAIL mcp-home not present/executable, ~/.claude.json local scope NOT registered: $homeSetup" >&2
				failed=1
			elif MYXROOT="$mcpRoot" MYX_AGENTMCP_TARGET_CWD="$workspace" "$homeSetup" ; then
				echo "OK mcp-home ~/.claude.json local scope registered for $workspace" >&2
			else
				echo "FAIL mcp-home ~/.claude.json local-scope registration did not complete (see above)" >&2
				failed=1
			fi

			## Two workspace MCP config targets, same "myx" stdio entry,
			## different client schema: VS Code/Copilot-Chat reads
			## .vscode/mcp.json (top-level key "servers"); Claude Code's own
			## project scope reads .mcp.json at the workspace root (top-level
			## key "mcpServers") -- Claude Code does not read
			## .vscode/mcp.json. .mcp.json is also what Copilot CLI reads
			## since it dropped .vscode/mcp.json support, so these two files
			## between them cover every client this workspace registers for.
			## Same upsert script for both, parameterized by target path +
			## key name via argv rather than duplicated verbatim.
			local mcpTarget
			for mcpTarget in \
				"$vscodeMcpDir/mcp.json:servers" \
				"$workspace/.mcp.json:mcpServers" \
			; do
				local mcpFile="${mcpTarget%%:*}"
				local mcpKey="${mcpTarget#*:}"
				echo "# Upserting MCP server entry in $mcpFile" >&2
				## '["--run"]' is not optional decoration:
				## bin/lib/agentMcpServer.Common prints usage and exits 1 on a
				## bare invocation instead of entering the server loop (its own
				## header states this), so an entry without it registers a
				## command the host can launch but that can never serve.
				if ! python3 "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsMcpServerJsonUpsert.py" "$mcpFile" "$serverScript" "$mcpKey" '["--run"]' ; then
					echo "FAIL mcp-upsert $mcpFile" >&2
					failed=1
					continue
				fi
				echo "OK mcp-upsert $mcpFile" >&2
				## Deterministic mode on every config this op writes, rather
				## than whatever the caller's ambient umask happened to be --
				## the same don't-trust-the-ambient-umask principle --self-test
				## already applies to the permission-hardening chain. 0644 is
				## the correct mode HERE: these files carry a path and a flag,
				## no secret, and must stay readable by every MCP client that
				## reads them. This is deliberately NOT the 700/600 hardening
				## --verify-permissions enforces, which is scoped to
				## .local/.agents credential state and does not apply to
				## workspace MCP config.
				if ! chmod 0644 "$mcpFile" ; then
					echo "FAIL mcp-chmod $mcpFile" >&2
					failed=1
				fi
				## Verify the ENTRY, not merely that the string "myx" occurs
				## somewhere in the file. The exact defect this op is being
				## fixed for -- a registered command that could never start
				## the server, because "args": ["--run"] was absent -- sailed
				## through the previous grep-for-'"myx"' check unnoticed, and
				## so would a command pointing at a long-deprecated server
				## path. Assert both fields, against the values just written.
				if python3 -c 'import json, sys
d = json.load(open(sys.argv[1], encoding="utf-8"))
e = d.get(sys.argv[2], {}).get("myx")
sys.exit(0 if isinstance(e, dict) and e.get("command") == sys.argv[3] and e.get("args") == ["--run"] else 1)' \
					"$mcpFile" "$mcpKey" "$serverScript" ; then
					echo "OK mcp-check myx entry launches $serverScript --run ($mcpFile)" >&2
				else
					echo "FAIL mcp-check myx entry missing or not launching $serverScript --run ($mcpFile)" >&2
					failed=1
				fi
			done
		fi

		##
		## The member-discovery half: the generated `.code-workspace`'s
		## `chat.agentSkillsLocations` key
		## (AgentsTools.Make.VSCodeSettingsFragment.include). This step does
		## not write that key -- it runs the build that emits it. A direct
		## write is not an option and never was: the `.code-workspace` is
		## generated wholesale by myx.distro-source's BuildCodeWorkspaceData,
		## so anything poked in from here survives only until the next build.
		## Triggering the build is the only durable way to make the key exist,
		## and the build is idempotent, so running it here costs a rebuild of
		## a file that is generated anyway.
		##
		## Without this step the install path left a fresh machine exactly
		## half-wired: symlinks and MCP config installed, the key absent, and
		## the user expected to know that a second, different command -- a
		## Source Console regeneration -- was still owed. The checklist below
		## said so in prose, which is documentation of a gap, not a fix.
		##
		## Invoked through the TARGET workspace's own `DistroSourceConsole.sh
		## --non-interactive` -- the same call shape BuildCodeWorkspaceData
		## itself uses to reach back into the source tools, and the same one
		## the ⌘⇧B tasks use -- rather than by sourcing myx.distro-source's
		## includes into this process: the console resolves that workspace's
		## OWN origin from its own `.local/MDLT.settings.env`, which is the
		## only correct answer when `--workspace` names a workspace other than
		## the one this process runs from.
		##
		## Ordering note, and the second gap this closes: BuildCodeWorkspaceData
		## gates every Agents fragment on `$workspace/DistroAgentsConsole.sh`
		## being present. The local-tools make loop
		## (myx.distro-.local/sh-lib/LocalTools.Make.include) runs its Source
		## pass -- which builds the `.code-workspace` -- BEFORE its Agents
		## pass, which is what creates that console script, so on a genuinely
		## fresh workspace the first build emits no Agents fragment at all.
		## By the time THIS op can run, the console script exists, so this
		## regeneration is also the run that first picks the fragment up.
		##
		if [ ! -x "$workspace/DistroSourceConsole.sh" ] ; then
			echo "WARN code-workspace regeneration skipped: no executable $workspace/DistroSourceConsole.sh -- chat.agentSkillsLocations stays absent until this workspace's source tools are installed" >&2
		elif ! echo 'DistroSourceTools.fn.sh --make-code-workspace --quiet' | "$workspace/DistroSourceConsole.sh" --non-interactive >&2 ; then
			echo "FAIL code-workspace regeneration (DistroSourceTools --make-code-workspace) failed for $workspace" >&2
			failed=1
		else
			echo "OK code-workspace regenerated via $workspace/DistroSourceConsole.sh" >&2
			## Verify the KEY, not merely that the build exited 0 -- the
			## fragment is emitted behind two gates inside the generated file
			## (the Agents console script, and the fragment include being
			## present under this workspace's origin), and a skipped fragment
			## is not an error there. Same principle as the mcp-check above:
			## assert the thing the op exists to produce.
			local wsFile="$workspace/${workspace##*/}.code-workspace"
			if grep -q 'chat\.agentSkillsLocations' "$wsFile" 2>/dev/null ; then
				echo "OK code-workspace-check chat.agentSkillsLocations present in $wsFile" >&2
			else
				echo "FAIL code-workspace-check chat.agentSkillsLocations absent from $wsFile -- magic-team members will not be discoverable by the VS Code chat client" >&2
				failed=1
			fi
		fi

		echo "# Command Palette checklist:" >&2
		echo "# 1) MCP (VS Code/Copilot-Chat): MCP: List Servers -> expect 'myx' visible" >&2
		echo "# 2) MCP (Claude Code): run 'claude mcp list' in $workspace -> expect 'myx' visible" >&2
		echo "# 3) Chat: Open Chat -> tools list includes myx tools once trusted/started" >&2
		echo "# 4) Members (Copilot Chat): Chat -> expect the magic-team skills listed; this workspace's" >&2
		echo "#    .code-workspace registers them via chat.agentSkillsLocations, which this op has just" >&2
		echo "#    regenerated (see the code-workspace lines above); VS Code picks that up live -- no window reload needed." >&2
		echo "#    But chat.agentSkillsLocations is a trust-restricted setting: an untrusted workspace drops it" >&2
		echo "#    entirely and NO members appear -- grant workspace trust first (a fresh machine starts untrusted)." >&2
		echo "# 5) Extensions are NOT installed by this op, by instruction -- install whichever chat" >&2
		echo "#    client you want yourself; the settings written here are ready for it either way." >&2
		echo "# Trust/Restart note: after mcp.json/.mcp.json changes, trust/start the server if prompted; reload VS Code window if tools are not visible." >&2

		if [ "$failed" -eq 0 ] ; then
			echo "OK --owner-install-vscode-integrations" >&2
			return 0
		fi

		echo "PARTIAL --owner-install-vscode-integrations (see FAIL lines above)" >&2
		set +e ; return 1
	;;

	*)
		echo "⛔ ERROR: $MDSC_CMD: invalid option: $1 -- rejected by AgentsTools.Owner.include's own default (*) branch, the operation group sourced by the --owner-* dispatcher route; no operation of that name is defined in this include" >&2
		set +e ; return 1
	;;
esac
