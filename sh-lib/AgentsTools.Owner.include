#!/usr/bin/env bash

## One readable status row, `<label> ..... <status>`. The dot run is a fixed
## field so a column of rows aligns; a label longer than the field gets no dots
## rather than pushing its own status out of the column.
## Rows belong to the readable mode alone, so the row calls can sit beside the
## detail blocks they summarise rather than in a second pass over the same
## facts; $setupOperation is the caller's own, which bash scopes dynamically.
AgentsToolsOwnerSetupRow(){
	[ -z "$setupOperation" ] || return 0
	local rowLabel="$1" rowStatus="$2"
	local rowDots="........................"
	printf '  %s %s %s\n' "$rowLabel" "${rowDots:${#rowLabel}}" "$rowStatus"
}

case "$1" in

	--owner-workspace-upsert)
		shift
		local wsPath="$1"
		shift || true
		if [ -z "$wsPath" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --owner-workspace-upsert: <path> required" >&2
			set +e ; return 1
		fi
		case "$wsPath" in
			/*)
			;;
			*)
				echo "⛔ ERROR: $MDSC_CMD --owner-workspace-upsert: path must be absolute: $wsPath" >&2
				set +e ; return 1
			;;
		esac
		[ "$wsPath" = "/" ] || wsPath="${wsPath%/}"
		## Local machine data, held beside the skill symlinks rather than inside
		## the packaged skill folder, which is a public git working tree. See MAGIC.md.
		## The directory is storage for that data, not a member set, so it is created on first use.
		local ownerDir="$HOME/.claude/skills"
		mkdir -p "$ownerDir" || {
			echo "⛔ ERROR: $MDSC_CMD --owner-workspace-upsert: can't create skills directory: $ownerDir" >&2
			set +e ; return 1
		}
		local ownerFile="$ownerDir/.human-owner.workspaces.md"
		touch "$ownerFile"
		if grep -Fxq -- "$wsPath" "$ownerFile" ; then
			echo "# $MDSC_CMD --owner-workspace-upsert: already tracked: $wsPath" >&2
			return 0
		fi
		if [ -s "$ownerFile" ] && [ -n "$( tail -c1 -- "$ownerFile" )" ] ; then
			printf '\n' >> "$ownerFile"
		fi
		printf '%s\n' "$wsPath" >> "$ownerFile"
		echo "# $MDSC_CMD --owner-workspace-upsert: added: $wsPath" >&2
		return 0
	;;

	--owner-workspace-forget)
		shift
		local wsPath="$1"
		shift || true
		if [ -z "$wsPath" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --owner-workspace-forget: <path> required" >&2
			set +e ; return 1
		fi
		[ "$wsPath" = "/" ] || wsPath="${wsPath%/}"
		local ownerFile="$HOME/.claude/skills/.human-owner.workspaces.md"
		if [ ! -f "$ownerFile" ] ; then
			echo "# $MDSC_CMD --owner-workspace-forget: $ownerFile does not exist -- nothing to forget" >&2
			return 0
		fi
		if ! grep -Fxq -- "$wsPath" "$ownerFile" ; then
			echo "# $MDSC_CMD --owner-workspace-forget: not tracked, nothing to do: $wsPath" >&2
			return 0
		fi
		(
			tmp="$ownerFile.$$"
			trap 'rm -f -- "$tmp"' EXIT
			: > "$tmp"
			grep -Fxv -- "$wsPath" "$ownerFile" >>"$tmp" 2>/dev/null || :
			mv "$tmp" "$ownerFile"
		)
		echo "# $MDSC_CMD --owner-workspace-forget: removed: $wsPath" >&2
		return 0
	;;

	--owner-workspace-list)
		shift
		if [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --owner-workspace-list: takes no arguments" >&2
			set +e ; return 1
		fi
		local ownerFile="$HOME/.claude/skills/.human-owner.workspaces.md"
		if [ ! -f "$ownerFile" ] ; then
			echo "# $MDSC_CMD --owner-workspace-list: $ownerFile does not exist -- no workspaces tracked yet" >&2
			return 0
		fi
		grep '^/' "$ownerFile" || :
		return 0
	;;

	--owner-workspace-current)
		shift
		if [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --owner-workspace-current: takes no arguments" >&2
			set +e ; return 1
		fi
		DistroAgentsTools --owner-workspace-upsert "$MMDAPP" || return 1
		echo "$MMDAPP"
		return 0
	;;

	--owner-credential-store-verify)
		shift
		local storeDir="$MMDAPP/.local/.agents"
		if [ ! -d "$storeDir" ] ; then
			echo "# $MDSC_CMD --owner-credential-store-verify: $storeDir does not exist yet (nothing to verify)" >&2
			return 0
		fi

		local storeFailed=0
		local storePerm
		storePerm="$( stat -f '%Lp' "$storeDir" 2>/dev/null || stat -c '%a' "$storeDir" 2>/dev/null )"
		if [ "$storePerm" = "770" ] ; then
			echo "OK   770  $storeDir"
		else
			echo "BAD  ${storePerm:-?}  $storeDir  (expected 770)"
			storeFailed=1
		fi

		local storeFile
		for storeFile in "$storeDir"/*.agent.env ; do
			[ -e "$storeFile" ] || continue
			storePerm="$( stat -f '%Lp' "$storeFile" 2>/dev/null || stat -c '%a' "$storeFile" 2>/dev/null )"
			if [ "$storePerm" = "660" ] ; then
				echo "OK   660  $storeFile"
			else
				echo "BAD  ${storePerm:-?}  $storeFile  (expected 660)"
				storeFailed=1
			fi
		done

		if [ "$storeFailed" = "1" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --owner-credential-store-verify: one or more paths under $storeDir are not hardened to 660/770" >&2
			set +e ; return 1
		fi
		echo "# $MDSC_CMD --owner-credential-store-verify: all paths under $storeDir are correctly hardened (770 dir / 660 files)" >&2
		return 0
	;;

	--owner-credential-store-harden)
		shift
		if [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --owner-credential-store-harden: takes no arguments -- always hardens $MMDAPP/.local/.agents" >&2
			set +e ; return 1
		fi
		local storeDir="$MMDAPP/.local/.agents"
		if [ ! -d "$storeDir" ] ; then
			echo "# $MDSC_CMD --owner-credential-store-harden: $storeDir does not exist yet (nothing to harden)" >&2
			return 0
		fi
		local storeFailed=0
		chmod 770 "$storeDir" || storeFailed=1
		local storeFile
		for storeFile in "$storeDir"/*.agent.env ; do
			[ -e "$storeFile" ] || continue
			chmod 660 "$storeFile" || storeFailed=1
		done
		if [ "$storeFailed" = "1" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --owner-credential-store-harden: could not set 770/660 on every path under $storeDir" >&2
			set +e ; return 1
		fi
		DistroAgentsTools --owner-credential-store-verify || return 1
		return 0
	;;

	--owner-credential-store-self-test)
		shift
		echo "# $MDSC_CMD --owner-credential-store-self-test: exercising --agents-config-option permission-hardening under umask 022 (ignoring caller's ambient umask)" >&2

		local probeKey="DAT_SELFTEST_PROBE"
		local probeVal="selftest-$$-$( date +%s )"
		local probeFailed=0

		if ! ( umask 022 ; DistroAgentsTools --agents-config-option magic-coordinator --upsert "$probeKey" "$probeVal" >/dev/null ) ; then
			echo "⛔ ERROR: $MDSC_CMD --owner-credential-store-self-test: --upsert under umask 022 failed" >&2
			set +e ; return 1
		fi

		DistroAgentsTools --owner-credential-store-verify || probeFailed=1

		if [ "$( DistroAgentsTools --agents-config-option magic-coordinator --select "$probeKey" )" != "$probeVal" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --owner-credential-store-self-test: probe key round-trip mismatch" >&2
			probeFailed=1
		fi

		DistroAgentsTools --agents-config-option magic-coordinator --delete "$probeKey" >/dev/null

		if [ "$probeFailed" = "1" ] ; then
			echo "⛔ $MDSC_CMD --owner-credential-store-self-test: FAILED" >&2
			set +e ; return 1
		fi
		echo "# $MDSC_CMD --owner-credential-store-self-test: PASSED -- permission hardening holds under umask 022" >&2
		return 0
	;;

	--owner-cleanup-purge)
		shift
		if [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --owner-cleanup-purge: takes no arguments -- always purges $MMDAPP/.local/.cleanup" >&2
			set +e ; return 1
		fi
		local cleanupDir="$MMDAPP/.local/.cleanup"
		if [ ! -d "$cleanupDir" ] ; then
			echo "# $MDSC_CMD --owner-cleanup-purge: $cleanupDir does not exist -- nothing to purge" >&2
			return 0
		fi
		echo "# $MDSC_CMD --owner-cleanup-purge: purging all contents of $cleanupDir (folder itself stays)" >&2
		local cleanupEntry
		for cleanupEntry in "$cleanupDir"/* "$cleanupDir"/.[!.]* ; do
			[ -e "$cleanupEntry" ] || [ -L "$cleanupEntry" ] || continue
			echo "  rm -rf $cleanupEntry" >&2
			rm -rf -- "$cleanupEntry"
		done
		echo "# $MDSC_CMD --owner-cleanup-purge: done" >&2
		return 0
	;;

	## --owner-setup-<domain> -- per-domain setup op family, one domain per macro
	## part of a working installation. A bare call, --check, --apply,
	## --print-apply-command and --wizard are its five states. MAGIC.md's own
	## "The --owner-setup-* family" section carries the contract: argument
	## grammar, what each state does, what a domain declares, and which subjects
	## are settings rather than preconditions.
	--owner-setup-*)
		local setupDomain="${1#--owner-setup-}"
		shift
		local setupAllWorkspaces="" setupSetAsDefault="" setupOperation=""
		local setupWorkspaceRoot="" setupAccessRoots="" setupAccessRootReal=""
		local setupValuesFromStdin="" setupOptionArgs=()
		while [ $# -gt 0 ] ; do
			case "$1" in
				--values-from-stdin) setupValuesFromStdin="yes" ; shift ;;
				--workspace-root|--access-root)
					if [ -z "${2:-}" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --owner-setup-$setupDomain: $1: a path is required" >&2
						set +e ; return 1
					fi
					case "$1" in
						--workspace-root) setupWorkspaceRoot="${2%/}" ;;
						## Stored resolved and absolute, never as given. This value becomes
						## an --add-dir token on the agent's own launch line, and the console
						## changes to $MMDAPP before exec, so a relative path grants a
						## directory nobody named: '.' would grant the whole workspace and
						## '..' its parent, from a typo. Resolving through cd/pwd -P settles
						## absoluteness, existence, '.'/'..' and a whitespace-only value in
						## one test. Colon-joined because a config value holds one line, so a
						## path carrying ':' cannot be expressed and is refused, not split.
						--access-root)
							case "$2" in
								*:*)
									echo "⛔ ERROR: $MDSC_CMD --owner-setup-$setupDomain: --access-root: a path containing ':' cannot be stored in this setting: $2" >&2
									set +e ; return 1
								;;
							esac
							## Tested as given, before resolving: `cd .` succeeds and
							## pwd -P then returns an absolute path, so resolving first
							## would accept '.' and grant whatever directory the caller
							## happened to be in.
							case "$2" in
								/*) ;;
								*)
									echo "⛔ ERROR: $MDSC_CMD --owner-setup-$setupDomain: --access-root: must be given as an absolute path, starting with '/': $2" >&2
									set +e ; return 1
								;;
							esac
							setupAccessRootReal="$( cd "$2" 2>/dev/null && pwd -P || : )"
							case "$setupAccessRootReal" in
								/*) ;;
								*)
									echo "⛔ ERROR: $MDSC_CMD --owner-setup-$setupDomain: --access-root: must name an existing directory by absolute path; this does not resolve to one: $2" >&2
									set +e ; return 1
								;;
							esac
							setupAccessRoots="${setupAccessRoots}${setupAccessRoots:+:}$setupAccessRootReal"
						;;
					esac
					shift 2
				;;
				--check|--apply|--print-apply-command|--wizard)
					setupOperation="$1"
					shift
					if [ $# -gt 0 ] ; then
						echo "⛔ ERROR: $MDSC_CMD --owner-setup-$setupDomain: $setupOperation is a sub-operation and takes the LAST position -- every option and its value comes before it. Found after it: $1" >&2
						set +e ; return 1
					fi
				;;
				--all-workspaces) setupAllWorkspaces="yes" ; shift ;;
				--set-as-default) setupSetAsDefault="yes" ; shift ;;
				## Any other flag is one of this domain's configuration options. Its
				## key is the flag without the dashes, uppercased, dashes as
				## underscores -- mechanical, so no option name is known here. The
				## engine holds the catalogue and refuses a name this domain has
				## not declared, which is where a typo is caught.
				--*)
					if [ -z "${2:-}" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --owner-setup-$setupDomain: $1: a value is required -- options first, then one of --check, --apply, --print-apply-command or --wizard last" >&2
						set +e ; return 1
					fi
					setupOptionArgs+=( --value "$( printf '%s' "${1#--}" | tr 'a-z-' 'A-Z_' )=$2" )
					shift 2
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --owner-setup-$setupDomain: unknown argument: $1 -- options first, then one of --check, --apply, --print-apply-command or --wizard last" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ "$setupOperation" = "--wizard" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --owner-setup-$setupDomain: --wizard is not built yet -- --apply carries the same setup non-interactively, a bare call writes the readable status and names that command, --check writes the per-setting detail, and --print-apply-command writes the command an --apply would carry out" >&2
			set +e ; return 1
		fi
		## Each option and sub-operation is accepted only by a domain that declares
		## it, so a flag is never taken and then ignored.
		if [ -n "$setupAllWorkspaces" ] ; then
			case "$setupDomain" in
				claude) ;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --owner-setup-$setupDomain: --all-workspaces is accepted only by a domain whose diagnosis spans workspaces" >&2
					set +e ; return 1
				;;
			esac
		fi
		## An option whose meaning depends on the sub-operation is refused in the
		## wrong company rather than accepted and dropped.
		if [ -n "$setupWorkspaceRoot" ] && [ -n "$setupAllWorkspaces" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --owner-setup-$setupDomain: --workspace-root names one workspace and --all-workspaces reports every registered one, so they do not combine" >&2
			set +e ; return 1
		fi
		if [ -n "$setupAccessRoots" ] && [ "$setupOperation" != "--apply" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --owner-setup-$setupDomain: --access-root supplies a value to store and so takes effect only with --apply" >&2
			set +e ; return 1
		fi
		if [ -n "$setupValuesFromStdin" ] && [ "$setupOperation" != "--apply" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --owner-setup-$setupDomain: --values-from-stdin supplies a set of values to store and so takes effect only with --apply" >&2
			set +e ; return 1
		fi
		## The flag as it was given, read back out of the key it was folded into,
		## so a name the domain does not take shows itself here rather than later.
		if [ ${#setupOptionArgs[@]} -ne 0 ] && [ "$setupOperation" != "--apply" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --owner-setup-$setupDomain: --$( printf '%s' "${setupOptionArgs[1]%%=*}" | tr 'A-Z_' 'a-z-' ) supplies a value to store and so takes effect only with --apply" >&2
			set +e ; return 1
		fi
		if [ -n "$setupAllWorkspaces" ] && [ "$setupOperation" = "--print-apply-command" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --owner-setup-$setupDomain: --all-workspaces reports on every registered workspace and --print-apply-command writes the command for exactly one, so they do not combine" >&2
			set +e ; return 1
		fi
		if [ -n "$setupAllWorkspaces" ] && [ "$setupOperation" = "--apply" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --owner-setup-$setupDomain: --all-workspaces reports on every registered workspace and --apply changes exactly one, so they do not combine -- run --apply from each workspace you mean to change" >&2
			set +e ; return 1
		fi
		if [ -n "$setupSetAsDefault" ] && [ "$setupOperation" != "--apply" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --owner-setup-$setupDomain: --set-as-default changes the selection and so takes effect only with --apply, which is the sub-operation that carries a change out" >&2
			set +e ; return 1
		fi
		## Each domain declares its own option set, what installs its own subject,
		## and which of its values only make sense together. Nothing about what an
		## option MEANS lives here: the engine holds that, and refuses a name a
		## domain has not declared, so a new domain is a new declaration and never
		## a change to the engine. A domain's subject is its own name.
		local setupDeclareArgs=()
		case "$setupDomain" in
			claude|copilot)
				## SPAWN_CLI_SERVICE is not declared required: the service selection
				## below is what sets it, so requiring it too would refuse the very
				## call that supplies it. It does block a spawn, and the arm below
				## carries that: unset, it is a needs-apply blocker rather than a
				## value the reader is asked for. CLIENT_ACCESS_ROOTS_EXTRA blocks
				## nothing -- it widens grants the installer already makes -- so it
				## is optional in full and a bare call never names it.
				setupDeclareArgs=(
					--allow SPAWN_CLI_SERVICE
					--allow CLIENT_ACCESS_ROOTS_EXTRA
					--service-key SPAWN_CLI_SERVICE --service-value "$setupDomain"
					--install-probe "command -v $setupDomain"
				)
				## Declared only where myx.common carries the installer; copilot has none.
				[ "$setupDomain" != "claude" ] || setupDeclareArgs+=( --install-command "myx.common install/$setupDomain" )
				## Its own credential, under the CLI's own variable name, because
				## that name is what the generated console exports and the CLI then
				## reads -- one string, so nothing maps and nothing drifts. Never
				## required: claude's two are alternatives, and on a machine whose
				## CLI is already logged in interactively none of them is needed at
				## all. What is authenticated is asked of the CLI in the arm below,
				## which is the only answer that is worth anything.
				case "$setupDomain" in
					claude)  setupDeclareArgs+=( --allow ANTHROPIC_API_KEY --allow CLAUDE_CODE_OAUTH_TOKEN ) ;;
					copilot) setupDeclareArgs+=( --allow COPILOT_GITHUB_TOKEN ) ;;
				esac
			;;
			slack)
				setupDeclareArgs=(
					--require SLACK_CHANNEL_MAGIC_TEAM
					--require SLACK_CHANNEL_HUMAN_OWNER
					## SLACK_USER_TOKEN is not declared here: it is a per-member
					## identity, held in each member's own scope, not one value the
					## workspace has. Declaring it would ask for it once and write
					## it somewhere no member reads.
					--allow SLACK_BOT_TOKEN
					--allow SLACK_WORKSPACE_DOMAIN
					--allow SLACK_CHANNEL_EVENT_TRACK
					--allow SLACK_CHANNEL_EVENT_ALERT
					--require-together SLACK_BOT_TOKEN,SLACK_WORKSPACE_DOMAIN
				)
			;;
			storage)
				setupDeclareArgs=(
					--require TEAM_DATA_DIRECTORY
					--allow TEAM_DATA_GIT_REMOTE
				)
			;;
		esac

		## One reads the domain's declaration to carry the setup out, the other to
		## write the command that would.
		case "$setupOperation" in
			--apply|--print-apply-command)
				if [ ${#setupDeclareArgs[@]} -eq 0 ] ; then
					echo "⛔ ERROR: $MDSC_CMD --owner-setup-$setupDomain: this domain declares no options" >&2
					set +e ; return 1
				fi
				## The engine's own mode word for the sub-operation asked for.
				local setupEngineMode="--render-full"
				[ "$setupOperation" != "--apply" ] || setupEngineMode="--apply"

				## claude's workspace trust, recorded before anything else this apply
				## writes: claude discards EVERY permissions.allow entry of an
				## untrusted workspace, so whatever gets configured below is inert
				## until this is set. It is not an option in the catalogue -- it lives
				## in claude's own machine-global state file rather than in a config
				## scope of ours -- which is why the domain carries it here instead of
				## declaring it. --print-apply-command changes nothing and so is out.
				if [ "$setupDomain" = "claude" ] && [ "$setupOperation" = "--apply" ] ; then
					local setupTrustRoot="${setupWorkspaceRoot:-${MMDAPP%/}}"
					if [ -L "$HOME/.claude.json" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --owner-setup-$setupDomain --apply: $HOME/.claude.json is a symlink, and recording trust replaces that file -- which would leave a regular file where you put a link" >&2
						set +e ; return 1
					fi
					if [ ! -f "$HOME/.claude.json" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --owner-setup-$setupDomain --apply: claude's own state file is absent, and this writes into that file rather than standing a replacement in its place -- start claude once so it writes $HOME/.claude.json, then re-run" >&2
						set +e ; return 1
					fi
					local setupTrustLine="$( MYX_CLAUDEVERIFY_PROJECT_PATH="$setupTrustRoot" \
						MYX_CLAUDEVERIFY_PROJECT_TRUE="hasTrustDialogAccepted" \
						LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsClaudeSettingsVerify.awk" \
						< "$HOME/.claude.json" 2>/dev/null || : )"
					case "$setupTrustLine" in
						*": OK")
							echo "# $MDSC_CMD --owner-setup-$setupDomain --apply: $setupTrustRoot is already trusted"
						;;
						*)
							## The mode is carried onto the replacement rather than
							## asserted: this file is claude's, and an apply is not the
							## place to decide what it should be. A mode that cannot be
							## read stops the run, since the alternative is a file left at
							## whatever the ambient umask gave.
							local setupTrustMode="$( stat -f '%Lp' "$HOME/.claude.json" 2>/dev/null || stat -c '%a' "$HOME/.claude.json" 2>/dev/null )"
							if [ -z "$setupTrustMode" ] ; then
								echo "⛔ ERROR: $MDSC_CMD --owner-setup-$setupDomain --apply: could not read the mode of $HOME/.claude.json, so a replacement could not be given the same one -- nothing was changed" >&2
								set +e ; return 1
							fi
							local setupTrustRc=0
							(
								## umask first, so the replacement is never briefly wider than
								## the file it replaces; the chmod below then matches it exactly.
								umask 077
								trustTempFile="$HOME/.claude.json.$$"
								trap 'rm -f -- "$trustTempFile"' EXIT
								: > "$trustTempFile"
								chmod "$setupTrustMode" "$trustTempFile"
								## Explicitly tested, never left to set -e: the caller below
								## tests this subshell, which suspends set -e within it, and an
								## untested failure here would install the writer's own zero
								## bytes over claude's state file.
								MYX_CLAUDETRUST_PROJECT_PATH="$setupTrustRoot" \
									MYX_CLAUDETRUST_PROJECT_TRUE="hasTrustDialogAccepted" \
									LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsClaudeProjectTrustUpsert.awk" \
									< "$HOME/.claude.json" >>"$trustTempFile" || exit 1
								mv "$trustTempFile" "$HOME/.claude.json" || exit 1
							) || setupTrustRc=$?
							if [ "$setupTrustRc" != "0" ] ; then
								echo "⛔ ERROR: $MDSC_CMD --owner-setup-$setupDomain --apply: could not record trust for $setupTrustRoot in $HOME/.claude.json, which is unchanged -- the reason above is the writer's own" >&2
								set +e ; return 1
							fi
							echo "# $MDSC_CMD --owner-setup-$setupDomain --apply: trust recorded for $setupTrustRoot"
						;;
					esac
				fi

				local setupApplyRc=0
				DistroAgentsTools --intern-op-owner-setup "$setupDomain" "$setupEngineMode" \
					--workspace "${setupWorkspaceRoot:-${MMDAPP%/}}" \
					"${setupDeclareArgs[@]}" \
					${setupOptionArgs[@]+"${setupOptionArgs[@]}"} \
					${setupAccessRoots:+--value} ${setupAccessRoots:+"CLIENT_ACCESS_ROOTS_EXTRA=$setupAccessRoots"} \
					${setupValuesFromStdin:+--values-from-stdin} \
					${setupSetAsDefault:+--set-as-default} || setupApplyRc=$?
				if [ "$setupApplyRc" != "0" ] ; then
					[ "$setupOperation" != "--apply" ] || echo "⛔ ERROR: $MDSC_CMD --owner-setup-$setupDomain --apply: stopped at the settings step, so nothing after it ran -- the reason above is that step's own" >&2
					return "$setupApplyRc"
				fi
				[ "$setupOperation" = "--apply" ] || return 0

				## The rest of the setup, so one --apply leaves the domain ready
				## instead of handing the reader steps to run himself. Ordered by
				## real dependency: trust above comes first, because claude
				## discards the permissions.allow entries written below while the
				## workspace is untrusted; the engine call above stores
				## CLIENT_ACCESS_ROOTS_EXTRA, which both the copilot access
				## fragment and the claude permissions are built from; and the
				## console those write is what the verification then reads.
				(
					MMDAPP="${setupWorkspaceRoot:-${MMDAPP%/}}"
					unset MDAT_SKILLSET_ROOT MDAT_DATA_ROOT
					## Every step runs inside a subshell of its own and is tested
					## explicitly, so a failure ends the sequence at the step that
					## failed and is reported by name. Both halves are needed on
					## bash 3.2: this outer subshell is tested by the caller, which
					## suspends set -e inside it, and a step that aborts on its own
					## -- --make-console-command's redirection is measured doing
					## exactly that -- would otherwise take this subshell down with
					## it and skip the handler naming the step.

					## The workspace integrations -- the generated console, the
					## member links, claude's permissions and the copilot access
					## fragment -- belong to every domain the generated console
					## launches, which is exactly the ones declaring
					## SPAWN_CLI_SERVICE. Read off the declaration, so a new CLI
					## domain gets this by declaring rather than by reopening here.
					case " ${setupDeclareArgs[*]} " in
						*" --service-key SPAWN_CLI_SERVICE "*)
							## The domain's own diagnosis is the gate: it already
							## knows this domain's preconditions, so a workspace
							## already current has nothing rewritten over it.
							if ! ( DistroAgentsTools "--owner-setup-$setupDomain" ) >/dev/null 2>&1 ; then
								( DistroAgentsTools --make-workspace-integrations --quiet ) || {
									echo "⛔ ERROR: $MDSC_CMD --owner-setup-$setupDomain --apply: stopped at the workspace integrations step -- the settings above are stored, the console and the access grants are not" >&2
									exit 1
								}
							fi
						;;
					esac

					## The apply's own verdict on its own work, in place of telling
					## the reader to re-run the diagnosis himself. Its status is
					## this operation's status: a setup that wrote everything and
					## is still not ready has not set the workspace up.
					echo ""
					( DistroAgentsTools "--owner-setup-$setupDomain" ) || {
						echo "⛔ ERROR: $MDSC_CMD --owner-setup-$setupDomain --apply: applied, and this workspace is still not ready -- what is left is named above" >&2
						exit 1
					}
				) || { set +e ; return 1 ; }
				return 0
			;;
		esac

		[ "$setupOperation" != "--check" ] || echo "# $MDSC_CMD --owner-setup-$setupDomain --check: read-only diagnosis (nothing applied)"
		## Each arm leaves its verdict here rather than returning it, so the
		## pointer below is reached by every domain and not written once per arm.
		local setupRc=0
		case "$setupDomain" in
			slack)
				## Activity-log and alert channels never gate: with neither set the
				## traffic they carry falls back to the team channel, so an absent
				## one costs routing, not a working installation.
				DistroAgentsTools --intern-op-check-configs magic-coordinator \
					--optional "SLACK_CHANNEL_EVENT_TRACK:<channel-id>" \
					--optional "SLACK_CHANNEL_EVENT_ALERT:<channel-id>" \
					--required "SLACK_CHANNEL_MAGIC_TEAM:<channel-id>" \
					--required "SLACK_CHANNEL_HUMAN_OWNER:<user-id>" \
					--expect-id-kind SLACK_CHANNEL_EVENT_TRACK:channel \
					--expect-id-kind SLACK_CHANNEL_EVENT_ALERT:channel \
					--expect-id-kind SLACK_CHANNEL_MAGIC_TEAM:channel \
					--expect-id-kind SLACK_CHANNEL_HUMAN_OWNER:user \
					--context --owner-setup-slack || setupRc=$?
				DistroAgentsTools --intern-op-check-configs magic-team \
					--optional "SLACK_BOT_TOKEN:<token>" \
					--expect-secret SLACK_BOT_TOKEN \
					--context --owner-setup-slack || true
			;;
			storage)
				DistroAgentsTools --intern-op-check-configs magic-coordinator \
					--required "TEAM_DATA_DIRECTORY:<path>" \
					--expect-path-exists "TEAM_DATA_DIRECTORY:${MDAT_DATA_ROOT:-}" \
					--context --owner-setup-storage || setupRc=$?
				DistroAgentsTools --intern-op-check-configs magic-team \
					--optional "TEAM_DATA_GIT_REMOTE:<git-remote-url>" \
					--context --owner-setup-storage || true
			;;
			copilot)
				## What a spawn actually needs: the proxy runs
				## DistroAgentsConsole.sh --cli-configured --non-interactive, which
				## takes SPAWN_CLI_SERVICE, refuses to guess when it is unset, and
				## execs copilot with --allow-all-tools and the access fragment's
				## --add-dir tokens. Each of those is a subject below. Authentication
				## is the one gate nothing here can read.
				local setupHere="${setupWorkspaceRoot:-${MMDAPP%/}}"
				local setupToolPath="$setupHere/.local/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
				## setupSetupSteps carries only what --apply cannot do; a finding
				## --apply closes sets setupNeedsApply instead, and one that also has
				## to repoint an existing selection sets setupApplyDefault with it.
				local setupBlockers="" setupSetupSteps="" setupNeedsApply="" setupApplyDefault=""
				local setupCliValue setupConsole setupFragment setupCredential
				local setupFragmentRoots setupCurrentRoots setupRootLine
				local setupStaleRoots="" setupMissingRoots=""

				if command -v copilot >/dev/null 2>&1 ; then
					[ "$setupOperation" != "--check" ] || echo "COPILOT_CLI_INSTALLED: OK"
					AgentsToolsOwnerSetupRow "Copilot CLI" "installed"
				else
					[ "$setupOperation" != "--check" ] || {
						echo "COPILOT_CLI_INSTALLED: FAIL"
						echo "  warn: copilot is not in PATH -- once it is the selected CLI the console"
						echo "        exits rather than substituting another one, so nothing starts here"
						echo "  fix:  $setupToolPath --owner-setup-copilot --apply"
					}
					AgentsToolsOwnerSetupRow "Copilot CLI" "NOT INSTALLED"
					setupNeedsApply="yes"
					setupBlockers="$setupBlockers COPILOT_CLI_INSTALLED"
					setupRc=1
				fi

				## What a spawn will actually carry, which is the only half of copilot's
				## authentication this workspace owns. copilot's own `help environment`
				## names COPILOT_GITHUB_TOKEN, GH_TOKEN and GITHUB_TOKEN, in that
				## precedence, as taking precedence over previously stored credentials --
				## so a stored token IS the whole answer for a machine that has one, and
				## the console exports it under that same name. Its VALIDITY is still not
				## readable: copilot carries no status or auth sub-command, and the one
				## command that would settle it, `copilot login`, writes the system
				## credential store and on a machine with no token opens an interactive
				## flow, so a read-only diagnosis cannot run it. An interactive login
				## already done on this machine is equally unreadable here, which is why
				## an absent token WARNs rather than fails.
				setupCredential=""
				if [ -f "$setupHere/.local/.agents/magic-team.agent.env" ] ; then
					setupCredential="$( MMDAPP="$setupHere" ; DistroAgentsTools --agents-config-option magic-team --select COPILOT_GITHUB_TOKEN || : )"
				fi
				if [ -n "$setupCredential" ] ; then
					[ "$setupOperation" != "--check" ] || {
						echo "COPILOT_GITHUB_TOKEN: OK"
						echo "  note: configured here, so the console exports it and copilot takes it"
						echo "        ahead of anything in the system credential store -- this machine"
						echo "        needs no interactive copilot login"
						echo "  warn: stored, not verified: copilot offers nothing that reads a token"
						echo "        back without writing its credential store, so a token that is"
						echo "        wrong or expired surfaces at the first spawn and not here"
					}
					AgentsToolsOwnerSetupRow "Copilot credential" "configured"
				else
					[ "$setupOperation" != "--check" ] || {
						echo "COPILOT_GITHUB_TOKEN: WARN"
						echo "  warn: unset here, so a spawn carries no credential of this workspace's"
						echo "        and copilot falls back to whatever login this account already has"
						echo "        -- which is nothing at all on a machine set up from scratch"
						echo "  why:  this does not FAIL, because an interactive 'copilot login' done"
						echo "        on this machine is a working setup that nothing here can read"
						echo "  fix:  $setupToolPath --owner-setup-copilot --print-apply-command"
					}
					AgentsToolsOwnerSetupRow "Copilot credential" "not configured"
				fi
				## The credential itself is never echoed: only whether it is non-empty is
				## ever read out of it, here and everywhere else it is touched.
				setupCredential=""

				## Read only where the scope file already exists: a --select through
				## --agents-config-option creates the file it reads.
				setupCliValue=""
				if [ -f "$setupHere/.local/.agents/magic-team.agent.env" ] ; then
					setupCliValue="$( MMDAPP="$setupHere" ; DistroAgentsTools --agents-config-option magic-team --select SPAWN_CLI_SERVICE || : )"
				fi
				if [ -z "$setupCliValue" ] ; then
					[ "$setupOperation" != "--check" ] || {
						echo "SPAWN_CLI_SERVICE: FAIL"
						echo "  warn: unset here, so a spawn exits rc=5 without choosing a CLI and its"
						echo "        caller falls back to an internal agent rather than starting copilot"
						echo "  why:  the setting lives in $setupHere/.local/.agents/, so"
						echo "        selecting copilot in one workspace does nothing for any other"
						echo "  fix:  $setupToolPath --owner-setup-copilot --apply"
					}
					AgentsToolsOwnerSetupRow "CLI selection" "NOT SET (spawn fails)"
					## --apply closes this one itself: the domain declares
					## --service-key SPAWN_CLI_SERVICE, and the engine's service
					## selection writes it wherever nothing is selected. So it is a
					## needs-apply blocker rather than a value the reader supplies,
					## and the what-is-missing command below never names it.
					setupNeedsApply="yes"
					setupBlockers="$setupBlockers SPAWN_CLI_SERVICE"
					setupRc=1
				elif [ "$setupCliValue" = "copilot" ] ; then
					[ "$setupOperation" != "--check" ] || echo "SPAWN_CLI_SERVICE: OK"
					AgentsToolsOwnerSetupRow "CLI selection" "copilot"
				else
					[ "$setupOperation" != "--check" ] || {
						echo "SPAWN_CLI_SERVICE: WARN"
						echo "  warn: set to '$setupCliValue', so this workspace runs $setupCliValue and never copilot"
						echo "  fix:  $setupToolPath --owner-setup-copilot --set-as-default --apply"
					}
					AgentsToolsOwnerSetupRow "CLI selection" "$setupCliValue"
					setupNeedsApply="yes" ; setupApplyDefault="yes"
				fi

				## copilot needs two markers claude does not: --allow-all-tools, which
				## its own help makes a requirement of non-interactive mode, and the
				## branch that reads the fragment into --add-dir tokens.
				setupConsole="$setupHere/DistroAgentsConsole.sh"
				if [ ! -f "$setupConsole" ] ; then
					[ "$setupOperation" != "--check" ] || {
						echo "AGENTS_CONSOLE_SCRIPT: FAIL"
						echo "  warn: this workspace has no agents console, so nothing here starts an"
						echo "        agent at all"
						echo "  path: $setupConsole"
						echo "  fix:  $setupToolPath --make-workspace-integrations"
					}
					AgentsToolsOwnerSetupRow "Agents console" "MISSING"
					setupNeedsApply="yes"
					setupBlockers="$setupBlockers AGENTS_CONSOLE_SCRIPT"
					setupRc=1
				elif ! grep -q 'cli-configured' "$setupConsole" 2>/dev/null || ! grep -q 'DISTRO_CONSOLE_EXEC' "$setupConsole" 2>/dev/null || ! grep -qF 'copilot-add-dir.fragment' "$setupConsole" 2>/dev/null || ! grep -qF 'allow-all-tools' "$setupConsole" 2>/dev/null || ! grep -q 'DAGC_CLI_CREDENTIALS' "$setupConsole" 2>/dev/null ; then
					[ "$setupOperation" != "--check" ] || {
						echo "AGENTS_CONSOLE_SCRIPT: FAIL"
						echo "  warn: generated before the console could refuse a spawn with no CLI"
						echo "        selected, announce DISTRO_CONSOLE_EXEC, feed the access fragment"
						echo "        into copilot's --add-dir argv, pass --allow-all-tools, or export"
						echo "        this workspace's stored credential into the CLI it starts -- copilot"
						echo "        requires that flag non-interactively, without the fragment it"
						echo "        launches with no granted directory at all, and without the export a"
						echo "        stored token reaches nothing and every spawn runs unauthenticated"
						echo "  path: $setupConsole"
						echo "  fix:  $setupToolPath --make-workspace-integrations"
						echo "  then: re-run this check -- what that regenerates from is the template"
						echo "        under the origin MDLT_CONSOLE_ORIGIN selects, not the path above"
					}
					AgentsToolsOwnerSetupRow "Agents console" "STALE"
					setupNeedsApply="yes"
					setupBlockers="$setupBlockers AGENTS_CONSOLE_SCRIPT"
					setupRc=1
				else
					[ "$setupOperation" != "--check" ] || echo "AGENTS_CONSOLE_SCRIPT: OK"
					AgentsToolsOwnerSetupRow "Agents console" "current"
				fi

				## The fragment is copilot's whole access grant -- it carries no
				## settings.json -- and only --install-copilot-access-fragment
				## rewrites it, so a root added to or dropped from the access set
				## after the last install leaves it granting the wrong directories
				## with nothing else saying so. Current means: what the installer
				## would write from here right now, root for root.
				setupFragment="$setupHere/.claude/copilot-add-dir.fragment"
				if [ ! -s "$setupFragment" ] ; then
					[ "$setupOperation" != "--check" ] || {
						echo "CLIENT_ACCESS_ROOTS: FAIL"
						echo "  warn: no access fragment, so the console launches copilot with no"
						echo "        --add-dir root at all and a spawned agent is denied on its very"
						echo "        first read of .agents/skills/<member>/<member>.basic.md"
						echo "  path: $setupFragment"
						echo "  fix:  $setupToolPath --make-workspace-integrations"
					}
					AgentsToolsOwnerSetupRow "Skill access roots" "NO GRANTS"
					setupNeedsApply="yes"
					setupBlockers="$setupBlockers CLIENT_ACCESS_ROOTS"
					setupRc=1
				else
					setupFragmentRoots="$( grep '^/' "$setupFragment" || : )"
					setupCurrentRoots="$( . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.ClientAccessRoots.include" ; AgentsToolsClientAccessRoots "$setupHere" )"
					while IFS= read -r setupRootLine ; do
						[ -n "$setupRootLine" ] || continue
						case "$setupCurrentRoots" in
							"$setupRootLine"|"$setupRootLine"$'\n'*|*$'\n'"$setupRootLine"|*$'\n'"$setupRootLine"$'\n'*) ;;
							*) setupStaleRoots="${setupStaleRoots}$setupRootLine"$'\n' ;;
						esac
					done <<< "$setupFragmentRoots"
					while IFS= read -r setupRootLine ; do
						[ -n "$setupRootLine" ] || continue
						case "$setupFragmentRoots" in
							"$setupRootLine"|"$setupRootLine"$'\n'*|*$'\n'"$setupRootLine"|*$'\n'"$setupRootLine"$'\n'*) ;;
							*) setupMissingRoots="${setupMissingRoots}$setupRootLine"$'\n' ;;
						esac
					done <<< "$setupCurrentRoots"
					if [ -z "$setupStaleRoots" ] && [ -z "$setupMissingRoots" ] ; then
						[ "$setupOperation" != "--check" ] || echo "CLIENT_ACCESS_ROOTS: OK"
						AgentsToolsOwnerSetupRow "Skill access roots" "current"
					else
						[ "$setupOperation" != "--check" ] || {
							echo "CLIENT_ACCESS_ROOTS: FAIL"
							echo "  warn: the fragment no longer matches the access-root set it was built"
							echo "        from, so copilot is launched against the directories below and"
							echo "        not the ones this workspace now resolves:"
							while IFS= read -r setupRootLine ; do
								[ -n "$setupRootLine" ] || continue
								echo "        granted, no longer in the set: $setupRootLine"
							done <<< "$setupStaleRoots"
							while IFS= read -r setupRootLine ; do
								[ -n "$setupRootLine" ] || continue
								echo "        in the set, not granted:       $setupRootLine"
							done <<< "$setupMissingRoots"
							echo "  why:  the fragment is written once, when the workspace integrations are"
							echo "        installed; changing CLIENT_ACCESS_ROOTS_EXTRA, or adding or retiring"
							echo "        a member, moves the set underneath it and rewrites nothing"
							echo "  path: $setupFragment"
							echo "  fix:  $setupToolPath --make-workspace-integrations"
						}
						AgentsToolsOwnerSetupRow "Skill access roots" "STALE"
						setupNeedsApply="yes"
						setupBlockers="$setupBlockers CLIENT_ACCESS_ROOTS"
						setupRc=1
					fi
				fi

				## One command, because --apply now carries out every finding above
				## that a command can carry out. Anything left in setupSetupSteps
				## is there because nothing can, and says so in its own prose.
				if [ -z "$setupOperation" ] ; then
					echo ""
					if [ -n "$setupNeedsApply" ] ; then
						echo "To set this workspace up, run:"
						echo "  $setupToolPath --owner-setup-copilot${setupApplyDefault:+ --set-as-default} --apply"
						[ -z "$setupSetupSteps" ] || {
							echo ""
							echo "That command does not close these on its own:"
							printf '%s' "$setupSetupSteps"
						}
					elif [ -n "$setupSetupSteps" ] ; then
						echo "This workspace is not ready, and no command closes what is left:"
						printf '%s' "$setupSetupSteps"
					elif [ -n "$setupBlockers" ] ; then
						echo "This workspace is not ready, and no single command closes what is left."
						echo "Run --check for the detail on:$setupBlockers"
					else
						echo "This workspace is set up for copilot."
					fi
				fi
			;;
			claude)
				local setupRegistry="$MDAT_SKILLSET_ROOT/.linked.magic-team.members.txt"
				## Trailing slash stripped once, because every basename and prefix
				## test below reads this: "$MMDAPP/" yields an empty basename, and a
				## run keyed on it diagnoses nothing while still exiting 0.
				local setupHere="${setupWorkspaceRoot:-${MMDAPP%/}}"

				## The console's own two sets. A spawned agent is always launched
				## --non-interactive, and the console narrows its scan to the second
				## set there, so a CLI outside it can be configured and still never
				## run. Both sets are interim: which CLI gets selected is meant to
				## come from config options that are not settled yet.
				local setupKnownClis="copilot claude grok"
				local setupSpawnClis="copilot claude"
				local setupAutoCli="" setupCliName
				for setupCliName in $setupSpawnClis ; do
					command -v "$setupCliName" >/dev/null 2>&1 || continue
					setupAutoCli="$setupCliName"
					break
				done

				local setupClaudePath="$( command -v claude || : )"
				local setupClaudeMissing=""
				if [ -z "$setupClaudePath" ] ; then
					setupRc=1
					setupClaudeMissing="yes"
					[ "$setupOperation" != "--check" ] || {
						echo "CLAUDE_CLI_INSTALLED: FAIL"
						echo "  warn: claude is not in PATH, so no workspace on this machine runs it"
						echo "  fix:  myx.common install/claude"
					}
					AgentsToolsOwnerSetupRow "Claude CLI" "NOT INSTALLED"
				else
					[ "$setupOperation" != "--check" ] || echo "CLAUDE_CLI_INSTALLED: OK"
					AgentsToolsOwnerSetupRow "Claude CLI" "installed"
				fi

				## Every root actually diagnosed, one absolute path per line, and the
				## registered names no live member link reaches. Resolving to roots
				## rather than iterating names is what keeps two workspaces sharing a
				## basename apart, since the registry records only the basename.
				local setupTargets="" setupUnresolved="" setupLabels="" setupSlot setupWalk setupPick
				if [ -z "$setupAllWorkspaces" ] ; then
					setupTargets="$setupHere"$'\n'
				else
					if [ ! -s "$setupRegistry" ] ; then
						echo "WORKSPACE_REGISTRY: FAIL"
						echo "  warn: the skillset installer's own workspace registry is missing or empty,"
						echo "        so there is no list of workspaces to diagnose"
						echo "  path: $setupRegistry"
						echo "  fix:  $setupHere/.local/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh --make-workspace-integrations"
						set +e ; return 1
					fi
					setupLabels=" $( awk -F: 'NF >= 4 { print $2 ; }' "$setupRegistry" | sort -u | tr '\n' ' ' )"
					if [ "$setupLabels" = " " ] ; then
						echo "WORKSPACE_REGISTRY: FAIL"
						echo "  warn: the registry holds no line carrying a workspace name, so it names"
						echo "        nothing to diagnose -- a non-empty file is not a readable one"
						echo "  path: $setupRegistry"
						echo "  fix:  $setupHere/.local/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh --make-workspace-integrations"
						set +e ; return 1
					fi
					[ "$setupOperation" != "--check" ] || echo "WORKSPACE_REGISTRY: OK"

					## A root is recovered by walking a live member link up to an
					## ancestor carrying a registered name, preferring the innermost
					## one that is a workspace: a bare innermost match picks a mid-path
					## directory that merely shares a name. Where no candidate is a
					## workspace the innermost match still stands, so an unmounted
					## volume reports as unreachable instead of as unknown. The glob
					## carries no trailing slash for the same reason -- that form
					## matches directories, and a link into an unmounted volume dangles.
					for setupSlot in "$MDAT_SKILLSET_ROOT"/* ; do
						[ -L "$setupSlot" ] || continue
						setupWalk="$( readlink "$setupSlot" || : )"
						case "$setupWalk" in /*) ;; *) continue ;; esac
						setupPick=""
						while [ -n "$setupWalk" ] ; do
							setupWalk="${setupWalk%/*}"
							case "$setupLabels " in
								*" ${setupWalk##*/} "*)
									[ -n "$setupPick" ] || setupPick="$setupWalk"
									if [ -d "$setupWalk/.local" ] ; then setupPick="$setupWalk" ; break ; fi
								;;
							esac
						done
						[ -n "$setupPick" ] || continue
						case "$setupTargets" in
							*$'\n'"$setupPick"$'\n'*) ;;
							"$setupPick"$'\n'*) ;;
							*) setupTargets="${setupTargets}${setupPick}"$'\n' ;;
						esac
					done

					## A registered name nothing resolved to is reported by name, since
					## its root is exactly what could not be established.
					local setupSeen
					for setupPick in $setupLabels ; do
						setupSeen=""
						while IFS= read -r setupWalk ; do
							[ "${setupWalk##*/}" = "$setupPick" ] || continue
							setupSeen="yes"
						done <<< "$setupTargets"
						[ -n "$setupSeen" ] || setupUnresolved="$setupUnresolved $setupPick"
					done
				fi

				local setupLabel setupRoot setupToolPath setupDiagnosed=0
				local setupTrustLine setupCliValue setupConsole setupFragment setupAuthLine
				local setupMemberSlot setupMemberReal setupGrant setupGrantReal
				local setupCovered setupUncovered setupMemberCount
				## setupSetupSteps carries only what --apply cannot do; a finding
				## --apply closes sets setupNeedsApply instead, and one that also has
				## to repoint an existing selection sets setupApplyDefault with it.
				local setupWillRun setupBlockers setupVerdict="" setupSetupSteps
				local setupNeedsApply setupApplyDefault

				for setupLabel in $setupUnresolved ; do
					echo ""
					echo "## workspace $setupLabel"
					echo "WORKSPACE_ROOT: WARN"
					echo "  warn: registered, but no live member symlink resolves into a workspace of"
					echo "        this name, so its root path is unknown and nothing about it can be"
					echo "        diagnosed"
					echo "  why:  the registry records only basename(workspace); the root itself is"
					echo "        recovered from where a member symlink actually points"
					echo "  fix:  drop its lines from $setupRegistry if no such workspace exists any"
					echo "        more; otherwise run --make-workspace-integrations from it, so that"
					echo "        a member links into it again"
					setupVerdict="${setupVerdict}$( printf '  %-28s not diagnosed -- workspace root unknown' "$setupLabel" )"$'\n'
					## A registered name reaching no workspace is a fault in the registry,
					## so it fails the run rather than passing quietly.
					setupRc=1
				done

				while IFS= read -r setupRoot ; do
					[ -n "$setupRoot" ] || continue
					setupLabel="${setupRoot##*/}"
					setupBlockers="" ; setupWillRun="" ; setupSetupSteps=""
					setupNeedsApply="" ; setupApplyDefault=""

					if [ "$setupOperation" = "--check" ] || [ -n "$setupAllWorkspaces" ] ; then
						echo ""
						echo "## workspace $setupLabel"
					fi

					if [ ! -d "$setupRoot" ] ; then
						[ "$setupOperation" != "--check" ] || {
							echo "WORKSPACE_ROOT: WARN"
							echo "  warn: not reachable right now -- an unmounted volume reads exactly like"
							echo "        this, so this is not a misconfiguration and nothing was checked"
							echo "  path: $setupRoot"
							echo "  fix:  mount it and re-run, or drop its lines from $setupRegistry"
						}
						AgentsToolsOwnerSetupRow "Workspace root" "NOT REACHABLE"
						setupVerdict="${setupVerdict}$( printf '  %-28s not diagnosed -- %s is not reachable' "$setupLabel" "$setupRoot" )"$'\n'
						continue
					fi
					if [ ! -d "$setupRoot/.local" ] ; then
						[ "$setupOperation" != "--check" ] || {
							echo "WORKSPACE_ROOT: WARN"
							echo "  warn: this is a directory but not a myx.distro workspace -- it carries no"
							echo "        .local, so it has no console, no config scope and no installation"
							echo "  path: $setupRoot"
							echo "  fix:  drop its lines from $setupRegistry, or set a workspace up there"
						}
						AgentsToolsOwnerSetupRow "Workspace root" "NOT A WORKSPACE"
						setupVerdict="${setupVerdict}$( printf '  %-28s not diagnosed -- %s is not a workspace' "$setupLabel" "$setupRoot" )"$'\n'
						## A registered name resolving to something that is not a workspace
						## is a fault; an unreachable volume above is not, and so leaves the
						## status alone while still counting as nothing diagnosed.
						setupRc=1
						continue
					fi
					setupDiagnosed=$(( setupDiagnosed + 1 ))
					[ "$setupOperation" != "--check" ] || echo "WORKSPACE_ROOT: OK"
					setupToolPath="$setupRoot/.local/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
					if [ -n "$setupClaudeMissing" ] ; then
						setupNeedsApply="yes"
						setupBlockers="$setupBlockers CLAUDE_CLI_INSTALLED"
					fi

					## One boolean, through the settings verifier this package already
					## owns: its output is OK/MISSING per asserted setting and it never
					## echoes a value, so no other content of that file can escape. A
					## structural failure prints no such line at all, which is what
					## separates "not trusted" from "could not be read".
					setupTrustLine=""
					if [ -f "$HOME/.claude.json" ] ; then
						setupTrustLine="$( MYX_CLAUDEVERIFY_PROJECT_PATH="$setupRoot" \
							MYX_CLAUDEVERIFY_PROJECT_TRUE="hasTrustDialogAccepted" \
							LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsClaudeSettingsVerify.awk" \
							< "$HOME/.claude.json" 2>/dev/null || : )"
					fi
					case "$setupTrustLine" in
						*": OK")
							[ "$setupOperation" != "--check" ] || echo "WORKSPACE_TRUSTED: OK"
							AgentsToolsOwnerSetupRow "Workspace trust" "accepted"
						;;
						*": MISSING")
							[ "$setupOperation" != "--check" ] || {
								echo "WORKSPACE_TRUSTED: FAIL"
								echo "  warn: claude discards EVERY permissions.allow entry of this workspace's"
								echo "        .claude/settings.json while it is untrusted, so nothing else here"
								echo "        can take effect -- this one comes before all of them"
								echo "  fix:  $setupToolPath --owner-setup-claude --apply"
							}
							AgentsToolsOwnerSetupRow "Workspace trust" "NOT ACCEPTED"
							setupNeedsApply="yes"
							setupBlockers="$setupBlockers WORKSPACE_TRUSTED"
							setupRc=1
						;;
						*)
							[ "$setupOperation" != "--check" ] || {
								echo "WORKSPACE_TRUSTED: WARN"
								echo "  warn: undetermined -- claude's own state file is absent or could not be"
								echo "        parsed, so trust is neither confirmed nor denied here"
								echo "  path: $HOME/.claude.json"
								echo "  fix:  start claude in $setupRoot; an untrusted workspace says so on"
								echo "        startup, naming the permissions.allow entries it is ignoring"
							}
							AgentsToolsOwnerSetupRow "Workspace trust" "unknown"
						;;
					esac

					## Read only where the scope file already exists: a --select through
					## --agents-config-option creates the file it reads, and this
					## operation applies nothing.
					setupCliValue=""
					if [ -f "$setupRoot/.local/.agents/magic-team.agent.env" ] ; then
						setupCliValue="$( MMDAPP="$setupRoot" ; DistroAgentsTools --agents-config-option magic-team --select SPAWN_CLI_SERVICE || : )"
					fi
					setupWillRun="$setupCliValue"
					if [ -z "$setupCliValue" ] ; then
						setupWillRun="${setupAutoCli:-nothing}"
						[ "$setupOperation" != "--check" ] || {
							echo "SPAWN_CLI_SERVICE: FAIL"
							echo "  warn: unset here, so an agent-initiated spawn in this workspace fails"
							echo "        rather than choosing a CLI, and its caller falls back to an"
							echo "        internal spawn -- --cli-auto still scans, but only for a console"
							echo "        the human-owner starts himself"
							echo "  why:  the setting lives in $setupRoot/.local/.agents/, so setting it in"
							echo "        one workspace does nothing for any other"
							echo "  fix:  $setupToolPath --owner-setup-claude --apply"
						}
						AgentsToolsOwnerSetupRow "CLI selection" "NOT SET (spawn fails)"
						## --apply closes this one itself: the domain declares
						## --service-key SPAWN_CLI_SERVICE, and the engine's service
						## selection writes it wherever nothing is selected. So it is a
						## needs-apply blocker rather than a value the reader supplies,
						## and the what-is-missing command below never names it.
						setupNeedsApply="yes"
						setupBlockers="$setupBlockers SPAWN_CLI_SERVICE"
						setupRc=1
					else
						setupCliName=""
						case " $setupKnownClis " in *" $setupCliValue "*) setupCliName="known" ;; esac
						if [ -z "$setupCliName" ] ; then
							[ "$setupOperation" != "--check" ] || {
								echo "SPAWN_CLI_SERVICE: FAIL"
								echo "  warn: set to '$setupCliValue', which the console does not accept -- it"
								echo "        exits on an unsupported CLI rather than choosing another"
								echo "  fix:  $setupToolPath --owner-setup-claude --set-as-default --apply"
							}
							AgentsToolsOwnerSetupRow "CLI selection" "REJECTED ($setupCliValue)"
							setupNeedsApply="yes" ; setupApplyDefault="yes"
							setupBlockers="$setupBlockers SPAWN_CLI_SERVICE"
							setupRc=1
						elif ! command -v "$setupCliValue" >/dev/null 2>&1 ; then
							[ "$setupOperation" != "--check" ] || {
								echo "SPAWN_CLI_SERVICE: FAIL"
								echo "  warn: set to '$setupCliValue', which is not in PATH -- an explicitly"
								echo "        selected CLI is never substituted, so the console exits instead"
								echo "        of falling back to another one or to a shell"
								echo "  fix:  myx.common install/$setupCliValue"
							}
							AgentsToolsOwnerSetupRow "CLI selection" "$setupCliValue NOT INSTALLED"
							setupNeedsApply="yes" ; setupApplyDefault="yes"
							setupBlockers="$setupBlockers SPAWN_CLI_SERVICE"
							setupRc=1
						else
							setupCliName=""
							case " $setupSpawnClis " in *" $setupCliValue "*) setupCliName="spawnable" ;; esac
							if [ -z "$setupCliName" ] ; then
								[ "$setupOperation" != "--check" ] || {
									echo "SPAWN_CLI_SERVICE: WARN"
									echo "  warn: set to '$setupCliValue', which runs interactively but not for a"
									echo "        spawned agent -- those are launched non-interactively, where the"
									echo "        console accepts only '$setupSpawnClis'"
									echo "  fix:  $setupToolPath --owner-setup-claude --set-as-default --apply"
								}
								AgentsToolsOwnerSetupRow "CLI selection" "$setupCliValue (cannot be spawned)"
								## A selection no spawn can use blocks the thing this domain
								## exists for, so it carries a step like any other blocker.
								setupNeedsApply="yes" ; setupApplyDefault="yes"
								setupBlockers="$setupBlockers SPAWN_CLI_SERVICE"
								setupRc=1
							elif [ "$setupCliValue" = "claude" ] ; then
								[ "$setupOperation" != "--check" ] || echo "SPAWN_CLI_SERVICE: OK"
								AgentsToolsOwnerSetupRow "CLI selection" "claude"
							else
								[ "$setupOperation" != "--check" ] || {
									echo "SPAWN_CLI_SERVICE: WARN"
									echo "  warn: set to '$setupCliValue', so this workspace runs $setupCliValue, not claude"
									echo "  fix:  $setupToolPath --owner-setup-claude --set-as-default --apply"
								}
								AgentsToolsOwnerSetupRow "CLI selection" "$setupCliValue"
								setupNeedsApply="yes" ; setupApplyDefault="yes"
							fi
						fi
					fi

					## Whether a spawn here will authenticate, asked of claude itself with
					## this workspace's own stored credential in scope -- which is the
					## question, and not whether the human at this terminal happens to be
					## logged in. The export lives in the probe's own subshell and reaches
					## nothing else. claude's JSON verdict names authMethod and never
					## echoes a value, so no part of the credential can leave through it,
					## and an API key, a subscription token, an interactive login and a
					## Bedrock/Vertex provider all answer loggedIn true -- so no working
					## machine is misread as unauthenticated.
					setupAuthLine=""
					if [ -z "$setupClaudeMissing" ] ; then
						setupAuthLine="$(
							MMDAPP="$setupRoot"
							for setupAuthKey in ANTHROPIC_API_KEY CLAUDE_CODE_OAUTH_TOKEN ; do
								[ -f "$setupRoot/.local/.agents/magic-team.agent.env" ] || continue
								setupAuthValue="$( DistroAgentsTools --agents-config-option magic-team --select "$setupAuthKey" 2>/dev/null || : )"
								[ -n "$setupAuthValue" ] || continue
								export "$setupAuthKey=$setupAuthValue"
							done
							claude auth status --json </dev/null 2>/dev/null || :
						)"
					fi
					case "$setupAuthLine" in
						*'"loggedIn": true'*)
							[ "$setupOperation" != "--check" ] || echo "SPAWN_CLI_AUTHENTICATED: OK"
							AgentsToolsOwnerSetupRow "Claude authentication" "authenticated"
						;;
						*'"loggedIn": false'*)
							[ "$setupOperation" != "--check" ] || {
								echo "SPAWN_CLI_AUTHENTICATED: FAIL"
								echo "  warn: claude has no credential here, from this workspace's config or"
								echo "        from this account's own login, so every spawn starts a CLI that"
								echo "        cannot reach the API and the main loop fails each iteration"
								echo "  why:  a spawned CLI is handed no credential by anything but the"
								echo "        console, which exports what is stored under claude's own"
								echo "        variable names -- unset here, there is nothing to export"
								echo "  fix:  $setupToolPath --owner-setup-claude --print-apply-command"
								echo "        -- store ANTHROPIC_API_KEY (console.anthropic.com, API keys) or"
								echo "        CLAUDE_CODE_OAUTH_TOKEN (claude setup-token, on a machine with a"
								echo "        browser). Either one alone is enough; on a machine with a browser"
								echo "        'claude auth login' is the third way and needs no stored value."
							}
							AgentsToolsOwnerSetupRow "Claude authentication" "NOT AUTHENTICATED"
							## Carried as a step, not left to the what-is-missing render: a
							## credential is not declarable as required here -- the two are
							## alternatives, and a machine already logged in interactively
							## needs neither -- so the render, which names required options,
							## correctly names none and a bare call would otherwise say
							## nothing is waiting on a value while this machine cannot run.
							setupSetupSteps="${setupSetupSteps}  authenticate claude: --apply cannot invent a credential, so supply one to it -- $setupToolPath --owner-setup-claude --print-apply-command writes the exact stdin-fed form for ANTHROPIC_API_KEY or CLAUDE_CODE_OAUTH_TOKEN, either alone being enough. On a machine with a browser 'claude auth login' does it instead and stores nothing here."$'\n'
							setupBlockers="$setupBlockers SPAWN_CLI_AUTHENTICATED"
							setupRc=1
						;;
						*)
							[ "$setupOperation" != "--check" ] || {
								echo "SPAWN_CLI_AUTHENTICATED: WARN"
								echo "  warn: undetermined -- claude is absent from PATH, or too old to carry"
								echo "        'auth status', so its sign-in state was neither confirmed nor"
								echo "        denied and an unauthenticated spawn would surface at first use"
							}
							AgentsToolsOwnerSetupRow "Claude authentication" "unknown"
						;;
					esac

					setupConsole="$setupRoot/DistroAgentsConsole.sh"
					if [ ! -f "$setupConsole" ] ; then
						[ "$setupOperation" != "--check" ] || {
							echo "AGENTS_CONSOLE_SCRIPT: FAIL"
							echo "  warn: this workspace has no agents console, so nothing here starts an"
							echo "        agent at all"
							echo "  path: $setupConsole"
							echo "  fix:  $setupToolPath --make-workspace-integrations"
							echo "  then: re-run this check -- what that regenerates from is the template"
							echo "        under the origin MDLT_CONSOLE_ORIGIN selects, not the path above"
						}
						AgentsToolsOwnerSetupRow "Agents console" "MISSING"
						setupNeedsApply="yes"
						setupWillRun="nothing"
						setupBlockers="$setupBlockers AGENTS_CONSOLE_SCRIPT"
						setupRc=1
					elif ! grep -q 'SPAWN_CLI_SERVICE' "$setupConsole" 2>/dev/null || ! grep -q 'DISTRO_CONSOLE_EXEC' "$setupConsole" 2>/dev/null || ! grep -q 'cli-configured' "$setupConsole" 2>/dev/null || ! grep -q 'DAGC_CLI_CREDENTIALS' "$setupConsole" 2>/dev/null ; then
						[ "$setupOperation" != "--check" ] || {
							echo "AGENTS_CONSOLE_SCRIPT: FAIL"
							echo "  warn: generated before the console could read SPAWN_CLI_SERVICE, announce"
							echo "        DISTRO_CONSOLE_EXEC, refuse a spawn with no CLI selected, or export"
							echo "        this workspace's stored credential into the CLI it starts, so an"
							echo "        agent-initiated spawn here scans PATH and starts whichever CLI it"
							echo "        finds, and starts it with no credential of this workspace's at all"
							echo "  path: $setupConsole"
							echo "  fix:  $setupToolPath --make-workspace-integrations"
							echo "  then: re-run this check -- what that regenerates from is the template"
							echo "        under the origin MDLT_CONSOLE_ORIGIN selects, not the path above"
						}
						AgentsToolsOwnerSetupRow "Agents console" "STALE"
						setupNeedsApply="yes"
						setupWillRun="unknown"
						setupBlockers="$setupBlockers AGENTS_CONSOLE_SCRIPT"
						setupRc=1
					else
						[ "$setupOperation" != "--check" ] || echo "AGENTS_CONSOLE_SCRIPT: OK"
						AgentsToolsOwnerSetupRow "Agents console" "current"
					fi

					setupFragment="$setupRoot/.claude/copilot-add-dir.fragment"
					setupUncovered="" ; setupMemberCount=0
					if [ ! -d "$setupRoot/.agents/skills" ] ; then
						[ "$setupOperation" != "--check" ] || {
							echo "CLIENT_ACCESS_ROOTS: FAIL"
							echo "  warn: this workspace has no .agents/skills directory, so an agent spawned"
							echo "        here finds no team member to load"
							echo "  fix:  $setupToolPath --make-workspace-integrations"
						}
						AgentsToolsOwnerSetupRow "Skill access roots" "NO MEMBERS"
						setupNeedsApply="yes"
						setupBlockers="$setupBlockers CLIENT_ACCESS_ROOTS"
						setupRc=1
					elif [ ! -s "$setupFragment" ] ; then
						[ "$setupOperation" != "--check" ] || {
							echo "CLIENT_ACCESS_ROOTS: FAIL"
							echo "  warn: no access fragment, so the console launches the CLI with no --add-dir"
							echo "        root at all and a spawned agent is denied on its very first read of"
							echo "        .agents/skills/<member>/<member>.basic.md"
							echo "  path: $setupFragment"
							echo "  fix:  $setupToolPath --make-workspace-integrations"
						}
						AgentsToolsOwnerSetupRow "Skill access roots" "NO GRANTS"
						setupNeedsApply="yes"
						setupBlockers="$setupBlockers CLIENT_ACCESS_ROOTS"
						setupRc=1
					else
						for setupMemberSlot in "$setupRoot"/.agents/skills/* ; do
							[ -L "$setupMemberSlot" ] || continue
							## The grant builder skips a reference-only member, so no grant
							## for one is intended rather than missing.
							if [ -f "$setupMemberSlot/SKILL.md" ] && grep -q '^status: reference-only' "$setupMemberSlot/SKILL.md" 2>/dev/null ; then
								continue
							fi
							## Compared as resolved directories, never as link text: a
							## relative link, and two paths reaching one directory through
							## different symlinked parents, both read as uncovered otherwise
							## -- and the advice that follows would be to re-point a link
							## that is already correct.
							setupMemberReal="$( cd "$setupMemberSlot" 2>/dev/null && pwd -P || : )"
							[ -n "$setupMemberReal" ] || continue
							setupMemberCount=$(( setupMemberCount + 1 ))
							setupCovered=""
							while IFS= read -r setupGrant ; do
								case "$setupGrant" in /*) ;; *) continue ;; esac
								setupGrantReal="$( cd "$setupGrant" 2>/dev/null && pwd -P || : )"
								[ -n "$setupGrantReal" ] || continue
								case "$setupMemberReal/" in "$setupGrantReal"/*) setupCovered="yes" ;; esac
							done < "$setupFragment"
							[ -n "$setupCovered" ] || setupUncovered="${setupUncovered}$setupMemberSlot|$setupMemberReal "
						done
						if [ "$setupMemberCount" -eq 0 ] ; then
							[ "$setupOperation" != "--check" ] || {
								echo "CLIENT_ACCESS_ROOTS: FAIL"
								echo "  warn: .agents/skills holds no member link that resolves, so nothing was"
								echo "        inspected -- an empty member tree is not a granted one"
								echo "  fix:  $setupToolPath --make-workspace-integrations"
							}
							AgentsToolsOwnerSetupRow "Skill access roots" "NO MEMBERS"
							setupNeedsApply="yes"
							setupBlockers="$setupBlockers CLIENT_ACCESS_ROOTS"
							setupRc=1
						elif [ -z "$setupUncovered" ] ; then
							[ "$setupOperation" != "--check" ] || echo "CLIENT_ACCESS_ROOTS: OK"
							AgentsToolsOwnerSetupRow "Skill access roots" "complete"
						else
							[ "$setupOperation" != "--check" ] || {
								echo "CLIENT_ACCESS_ROOTS: FAIL"
								echo "  warn: an agent spawned here is denied on its first read of each member"
								echo "        below, because the copy its workspace link resolves to is not one"
								echo "        of the directories the grant set names:"
								for setupMemberSlot in $setupUncovered ; do
									echo "        ${setupMemberSlot%%|*}"
									echo "          -> ${setupMemberSlot#*|}"
								done
								echo "  why:  the grant names each member's directory as $MDAT_SKILLSET_ROOT"
								echo "        resolves it. A link reaching a second copy of the same member is a"
								echo "        different directory, and regenerating the fragment does not move"
								echo "        it -- an existing link is kept exactly as it is."
								echo "  fix:  re-point each link above at the directory $MDAT_SKILLSET_ROOT/<member>"
								echo "        resolves to, then run $setupToolPath --owner-setup-claude --apply"
							}
							AgentsToolsOwnerSetupRow "Skill access roots" "INCOMPLETE"
							## The one finding here nothing carries out: --install-skillset-symlinks
							## keeps an existing link exactly as it is, whatever it points at,
							## so no run of it moves this one.
							setupSetupSteps="${setupSetupSteps}  re-point the member links --check lists at the directories $MDAT_SKILLSET_ROOT resolves to -- an existing link is never moved for you"$'\n'
							setupBlockers="$setupBlockers CLIENT_ACCESS_ROOTS"
							setupRc=1
						fi
					fi

					if [ -n "$setupBlockers" ] ; then
						setupVerdict="${setupVerdict}$( printf '  %-28s runs %-8s -- blocked by:%s' "$setupLabel" "$setupWillRun" "$setupBlockers" )"$'\n'
					else
						setupVerdict="${setupVerdict}$( printf '  %-28s runs %-8s -- ready' "$setupLabel" "$setupWillRun" )"$'\n'
					fi

					## The pointer, and it is the point of this mode: one command,
					## because --apply now carries out every finding above that a
					## command can carry out. Anything left in setupSetupSteps is
					## there because nothing can, and says so in its own prose.
					if [ -z "$setupOperation" ] && [ -z "$setupAllWorkspaces" ] ; then
						echo ""
						if [ -n "$setupNeedsApply" ] ; then
							echo "To set this workspace up, run:"
							echo "  $setupToolPath --owner-setup-claude${setupApplyDefault:+ --set-as-default} --apply"
							[ -z "$setupSetupSteps" ] || {
								echo ""
								echo "That command does not close these on its own:"
								printf '%s' "$setupSetupSteps"
							}
						elif [ -n "$setupSetupSteps" ] ; then
							echo "This workspace is not ready, and no command closes what is left:"
							printf '%s' "$setupSetupSteps"
						elif [ -n "$setupBlockers" ] ; then
							echo "This workspace is not ready, and no single command closes what is left."
							echo "Run --check for the detail on:$setupBlockers"
						else
							echo "This workspace is set up for claude."
						fi
					fi
				done <<< "$setupTargets"

				## Nothing diagnosed is not a pass: every workspace unreachable, or a
				## registry naming none that resolve, otherwise exits 0 having checked
				## nothing at all.
				if [ "$setupDiagnosed" -eq 0 ] ; then
					echo ""
					echo "⛔ no workspace could be diagnosed -- none of the registered names resolved to a reachable workspace" >&2
					setupRc=1
				fi

				if [ -n "$setupAllWorkspaces" ] ; then
					echo ""
					echo "## which workspace runs what"
					printf '%s' "$setupVerdict"
				fi
			;;
			*)
				echo "$setupDomain: no checks defined yet"
				echo "  note: no required settings are defined for this domain -- the"
				echo "        --owner-setup-* family is open and grows as domains are defined."
			;;
		esac

		## The other half of a bare call: the status above, then the command that
		## supplies what this domain REQUIRES and does not yet have. Rendered by the
		## same engine as --print-apply-command, in its required-and-unset form, so
		## the placeholders and the how-to-obtain lines cannot drift from the full
		## template. An optional setting is deliberately not named here -- beside a
		## required one it reads as the thing standing between the reader and a
		## working setup -- and --print-apply-command below is where every setting
		## this domain takes is written out. --check writes the per-setting detail
		## instead, and --all-workspaces spans workspaces one command cannot name.
		if [ -z "$setupOperation" ] && [ -z "$setupAllWorkspaces" ] && [ ${#setupDeclareArgs[@]} -ne 0 ] ; then
			local setupStillMissing="" setupRenderRc=0
			setupStillMissing="$( DistroAgentsTools --intern-op-owner-setup "$setupDomain" --render-missing \
				--workspace "${setupWorkspaceRoot:-${MMDAPP%/}}" "${setupDeclareArgs[@]}" )" || setupRenderRc=$?
			echo ""
			if [ "$setupRenderRc" -ne 0 ] ; then
				setupRc="$setupRenderRc"
			elif [ -n "$setupStillMissing" ] ; then
				echo "To supply what $setupDomain requires, run:"
				printf '%s\n' "$setupStillMissing"
			else
				echo "Nothing here is waiting on a value from you."
				echo "  ${setupWorkspaceRoot:-${MMDAPP%/}}/.local/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh --owner-setup-$setupDomain --print-apply-command   -- every setting this domain takes, optional ones included, for changing one"
			fi
		fi
		return "$setupRc"
	;;


	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
