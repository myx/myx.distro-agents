#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.ClientToolPolicy.include -- the single source of WHICH client tools
## are rerouted, and of the keys each installed hook is recognised by. It is NOT
## the source of what a refusal says: that wording lives in the hook script that
## says it, sh-lib/client-hooks/deny-native-tool-reroute.sh, where a person opening
## the hook can read it. Two different facts, one home each.
## Also the single source of the fixed claude permission grants: allow, deny and MCP servers.
##
## Dot-sourced. Nothing here is an operation, so there is no flag and no
## help pair; a consumer calls these functions directly.
##

## The canonicalization format version, one token on one line.
## NO READER ON THIS TREE, and the four-field subject-decision-reason-redirect
## record format it versions has been removed -- the wording those records carried
## is now written out in the hook script itself. Left in place rather than deleted,
## because an unread thing is as often an unimplemented intent as it is residue,
## and that is the human-owner's call. Whoever rules on it: the token below names a
## record format that no longer exists.
AgentsToolsClientToolPolicyFormatVersion(){
	printf '%s\n' "subject-decision-reason-redirect"
}

## The fixed permissions.allow grants, one JSON array.
## SendMessage sits alongside Agent/Task for the same reason those two do:
## a dispatched member has to be able to reach the session that dispatched
## it, and a spawn it made, without a prompt interrupting an unattended run.
AgentsToolsClientToolPolicyClaudeAllowJson(){
	printf '%s\n' '["mcp__myx_common", "mcp__myx_distro", "Agent", "Task", "SendMessage"]'
}

## The fixed permissions.deny additions, one JSON array.
## Bash is deliberately NOT here: a static permissions.deny entry cannot be made
## conditional on the spawn markers, so it would block Bash outright for our own
## spawned sessions too, with no escape. The hooks.PreToolUse entry for Bash already
## denies-with-reroute for a genuine native-harness session and allows a spawned one
## through -- see deny-native-tool-reroute.sh. Shell commands still run through
## mcp__myx_distro__execute, its mcp__myx_distro__Monitor twin, myx.common's
## lib_execShStdin, and the native Monitor tool, which is neither denied nor rerouted.
## Native Slack MCP tool, hard-blocked -- separate path from the team's own sanctioned
## --member-comms-slack-* ops, which this cannot reach.
AgentsToolsClientToolPolicyClaudeDenyJson(){
	printf '%s\n' '["mcp__claude_ai_Slack"]'
}

## The vendor copilot CLI's own memory tools, one comma-separated value for its
## --excluded-tools, which hides them from the model (copilot-native launches only:
## AgentsConsoleShellScript.template.sh). store_memory writes Copilot Memory, a store kept
## by GitHub and shared with the repository's collaborators; vote_memory rates one. Like
## the claude memory directory, it is not team knowledge. copilot 1.0.87 changelog: "Inject
## repo memories in the prompt and add memory storage tool"; its session-events schema
## names both tools. Prompt mode (-p) already runs without memory unless --enable-memory.
AgentsToolsClientToolPolicyCopilotExcludedTools(){
	printf '%s\n' "store_memory,vote_memory"
}

## The top-level settings --install-workspace-restrictions fixes in a workspace's
## .claude/settings.json, one `<key><TAB><JSON scalar>` per line; each is set to exactly
## this value and no other key is touched. autoMemoryEnabled false: claude's own
## auto-memory (the prompt telling the model to keep ~/.claude/projects/<p>/memory/, and
## the MEMORY.md it loads into context) is off -- that store is not team knowledge
## (human-owner, 2026-10-07). Claude Code 2.1.236 reads it from project settings: "When
## false, Claude will not read from or write to the auto-memory directory."
AgentsToolsClientToolPolicyClaudeSettings(){
	printf '%s\t%s\n' "autoMemoryEnabled" "false"
}

## The enabledMcpjsonServers entries, one JSON array.
AgentsToolsClientToolPolicyClaudeMcpServersJson(){
	printf '%s\n' '["myx.distro", "myx.common"]'
}

## The native tools that are rerouted, one per line. THE SINGLE SOURCE OF THE SET:
## the installer writes one PreToolUse entry per name here, and the hook keys below
## are derived from the same names, so no consumer states the set a second time.
## The refusal each one answers with is in the hook script, keyed by these same
## names. A name here with no case there denies loudly rather than falling through,
## because a hook emitting no decision reads as ALLOW.
##
## The set is the overlap between the harness tool floor this estate's MCP serves
## and the tools a *-native client offers, less the tools a reroute would break:
## anything addressing state owned by the process that created it (an agent
## registry, a caller to hand back to, a job handle) cannot work from a tools/call,
## which runs in a fresh process -- and anything answering about the client's own
## context answers about the harness instead, which is a different answer rather
## than the same job done elsewhere. NotebookEdit is native with no served
## counterpart at all, so there is nothing to route it to.
##
## An empty list would install no reroute while still succeeding, so it is refused.
AgentsToolsClientToolPolicyRerouteToolNames(){
	local policyToolNames="" policyToolName
	for policyToolName in Bash AskUserQuestion Read Write Edit Glob Grep WebFetch WebSearch PushNotification ; do
		case "$policyToolName" in
			""|*[!A-Za-z]*)
				echo "⛔ ERROR: AgentsToolsClientToolPolicyRerouteToolNames: '$policyToolName' is not a bare tool name, and a PreToolUse matcher is written from it verbatim" >&2
				return 1
			;;
		esac
		policyToolNames="${policyToolNames}${policyToolName}"$'\n'
	done
	if [ -z "$policyToolNames" ] ; then
		echo "⛔ ERROR: AgentsToolsClientToolPolicyRerouteToolNames: no tool names -- an empty set installs no reroute at all while still reporting success" >&2
		return 1
	fi
	printf '%s' "$policyToolNames"
}

## The script every reroute entry runs, as one path relative to the workspace root.
## Named once because the installer copies it, the entries call it, and the class
## filter below recognises it.
AgentsToolsClientToolPolicyRerouteHookPath(){
	printf '%s\n' ".claude/hooks/deny-native-tool-reroute.sh"
}

## The hook scripts earlier installs wrote and this one retires, one per line,
## as file names under .claude/hooks. Each was one tool's own script and is now
## a case in the reroute hook. The installer removes both halves from this one
## list: the PreToolUse entry running it first, then the file.
AgentsToolsClientToolPolicyRetiredHookNames(){
	printf '%s\n' "deny-bash-tool.sh" "deny-ask-user-question-tool.sh"
}

## The permissions.deny entries earlier installs wrote into a workspace's
## .claude/settings.json and this one retires, one per line, each the exact entry
## text. The settings merge removes an entry only on an exact match, so a narrower
## rule a user added beside it is never touched. Static denies of a tool the hooks
## and permission policy govern belong to neither: a blanket "Bash" deny blocked
## our own spawned sessions too, which the reroute hook lets through.
AgentsToolsClientToolPolicyRetiredDenyEntries(){
	printf '%s\n' "Bash"
}

## The permissions.allow entries earlier installs wrote into a workspace's
## .claude/settings.json and none writes any more, one per line, each the exact entry
## text: the PreToolUse hooks decide every call, so no file grant is written. A Read
## on the workspace's skills root and on each reference read root, a Read and an Edit
## on the team scratchpad, as AgentsTools.ClientAccessRoots.include yields them. The
## settings merge removes each on an exact match, so a rule a user added stays; a Read
## on a source/ or .agents root goes there by its shape.
##   $1 = workspace root
AgentsToolsClientToolPolicyRetiredAllowEntries(){
	local retiredWs="${1%/}" retiredRoots
	[ -n "$retiredWs" ] || return 1
	type AgentsToolsClientAccessReferenceRoots >/dev/null 2>&1 || . "${harnessHere:-$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib}/AgentsTools.ClientAccessRoots.include" || return 1
	retiredRoots="$( AgentsToolsClientAccessReferenceRoots read "$retiredWs" )" || return 1
	printf 'Read(/%s/**)\n' "$retiredWs/.claude/skills"
	printf '%s\n' "$retiredRoots" | LC_ALL=C awk 'NF { print "Read(/" $0 "/**)" ; }'
	retiredRoots="$( AgentsToolsClientAccessReferenceRoots write "$retiredWs" )" || return 1
	printf '%s\n' "$retiredRoots" | LC_ALL=C awk 'NF { print "Read(/" $0 "/**)" ; print "Edit(/" $0 "/**)" ; }'
}

## The deny-reroute keys, one per line: the hooks that exist to route a *-native
## client toward this estate's own MCP tooling, and which therefore must not apply
## inside our own universal harness -- there the destination is already what is
## running. The class is declared here and never read out of hooks.PreToolUse,
## because a *-native client reads that same array and an entry cannot carry a
## marker only one of its two readers honours.
## One key covers every reroute entry, because they all run the one script: the
## class question is which script an entry runs, not which tool it governs.
## An empty result is the legitimate "no policy is deny-reroute" and is not an
## error; a non-zero return is, and a consumer must tell the two apart.
AgentsToolsClientToolPolicyRerouteHookKeys(){
	local policyRerouteKeys="" policyRerouteKey
	for policyRerouteKey in "$( AgentsToolsClientToolPolicyRerouteHookPath )" ; do
		case "$policyRerouteKey" in
			""|*$'\t'*|*$'\n'*)
				echo "⛔ ERROR: AgentsToolsClientToolPolicyRerouteHookKeys: a hook key is empty or carries a tab or a newline, so a consumer would read a class this never declared" >&2
				return 1
			;;
		esac
		policyRerouteKeys="${policyRerouteKeys}${policyRerouteKey}"$'\n'
	done
	printf '%s' "$policyRerouteKeys"
}

## EVERY HOOK THIS ESTATE INSTALLS, one record per line -- the single source both the
## harness hook index (AgentsHarnessHooksLoad.include) and the settings.json hooks
## description (--install-workspace-restrictions) are built from, so they cannot disagree:
##   event <TAB> class <TAB> key <TAB> matcher <TAB> script <TAB> argument
## event is the client hook event; class is `all` (applies everywhere, our own harness
## included), `reroute` (routes a *-native client to our MCP tooling, so never applies in
## our harness) or `native` (a *-native client only: an event our harness has no
## counterpart for, or a decision our harness makes itself); key is the
## dedupe key the settings merge and verifier recognise the entry by; script is a file
## name under sh-lib/client-hooks (installed under .claude/hooks); matcher and argument
## may be empty. Ordered as the installer has always written them.
AgentsToolsClientToolPolicyHookRecords(){
	local recordScript recordTools recordTool recordOut=""
	recordScript="$( AgentsToolsClientToolPolicyRerouteHookPath )" || return 1
	recordTools="$( AgentsToolsClientToolPolicyRerouteToolNames )" || return 1
	recordOut="PreToolUse	all	.claude/hooks/deny-memory-md-read.sh	Read	deny-memory-md-read.sh	"$'\n'
	## Glob and Grep run the same read guard, one entry each with the tool as its argument:
	## a key of their own, so an install that already wired the Read entry still adds them.
	## After the Read record, whose key is a prefix of theirs.
	recordOut="${recordOut}PreToolUse	all	.claude/hooks/deny-memory-md-read.sh Glob	Glob	deny-memory-md-read.sh	Glob"$'\n'
	recordOut="${recordOut}PreToolUse	all	.claude/hooks/deny-memory-md-read.sh Grep	Grep	deny-memory-md-read.sh	Grep"$'\n'
	recordOut="${recordOut}PreToolUse	all	.claude/hooks/protect-memory-md.sh	Edit|Write	protect-memory-md.sh	"$'\n'
	## A spawned member: allow a native file tool call its session index grants, deny a write
	## in a read-only place, and leave anything else to the client and the PermissionRequest hook.
	recordOut="${recordOut}PreToolUse	native	.claude/hooks/allow-granted-native-tool.sh	Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob	allow-granted-native-tool.sh	"$'\n'
	recordOut="${recordOut}PermissionRequest	native	.claude/hooks/permission-request-escalation.sh		permission-request-escalation.sh	"$'\n'
	## A root session, one the tooling did not spawn: its end, and its resume under the same id
	## (AgentsToolsGrantsSessionEnded reads the marker). A spawned one is closed by its proxy.
	## The end carries its own timeout, 5 s: the client gives SessionEnd hooks 1.5 s in all by
	## default, and the marker and store touch must never be cut; the rest runs detached.
	recordOut="${recordOut}SessionEnd	native	.claude/hooks/root-session-end.sh end		root-session-end.sh	end	5"$'\n'
	recordOut="${recordOut}SessionStart	native	.claude/hooks/root-session-end.sh resume	resume	root-session-end.sh	resume"$'\n'
	while IFS= read -r recordTool ; do
		[ -n "$recordTool" ] || continue
		recordOut="${recordOut}PreToolUse	reroute	$recordScript $recordTool	$recordTool	${recordScript##*/}	$recordTool"$'\n'
	done <<< "$recordTools"
	printf '%s' "$recordOut"
}

## The dedupe keys, one per line -- the plain substring each installed hook
## is recognised by inside the raw hooks.PreToolUse text. A consumer captures
## this with $( ), which strips the final newline, and passes it on that call
## as MYX_CLAUDEVERIFY_HOOK_KEYS. An empty element there reports OK against
## any non-empty PreToolUse, and an empty list asserts nothing at all while
## still succeeding, so both are refused here rather than emitted.
## ONE KEY PER REROUTED TOOL, not one for the shared script: the verifier's job is
## to catch an entry the settings merge failed to add, and every reroute entry runs
## the same script, so a key naming the script alone would report OK with all but
## one of them missing.
AgentsToolsClientToolPolicyHookKeys(){
	local policyHookKeys="" policyHookKey policyHookTool policyHookScript
	policyHookScript="$( AgentsToolsClientToolPolicyRerouteHookPath )" || return 1
	while IFS= read -r policyHookTool ; do
		[ -n "$policyHookTool" ] || continue
		policyHookKeys="${policyHookKeys}${policyHookScript} ${policyHookTool}"$'\n'
	done <<< "$( AgentsToolsClientToolPolicyRerouteToolNames )"
	if [ -z "$policyHookKeys" ] ; then
		echo "⛔ ERROR: AgentsToolsClientToolPolicyHookKeys: the reroute tool set yielded no keys, so the verifier would assert nothing about the reroute hooks" >&2
		return 1
	fi
	for policyHookKey in ".claude/hooks/deny-memory-md-read.sh" ".claude/hooks/deny-memory-md-read.sh Glob" ".claude/hooks/deny-memory-md-read.sh Grep" ".claude/hooks/protect-memory-md.sh" ".claude/hooks/allow-granted-native-tool.sh" ; do
		case "$policyHookKey" in
			""|*$'\t'*|*$'\n'*)
				echo "⛔ ERROR: AgentsToolsClientToolPolicyHookKeys: a hook key is empty or carries a tab or a newline, which the verifier reads as an assertion it never made" >&2
				return 1
			;;
		esac
		policyHookKeys="${policyHookKeys}${policyHookKey}"$'\n'
	done
	if [ -z "$policyHookKeys" ] ; then
		echo "⛔ ERROR: AgentsToolsClientToolPolicyHookKeys: no hook keys -- an empty list makes the verifier assert nothing and report success" >&2
		return 1
	fi
	printf '%s' "$policyHookKeys"
}
