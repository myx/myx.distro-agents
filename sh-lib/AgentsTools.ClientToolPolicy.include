#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.ClientToolPolicy.include -- the single source of WHICH client tools
## are rerouted, and of the keys each installed hook is recognised by. It is NOT
## the source of what a refusal says: that wording lives in the hook script that
## says it, sh-lib/client-hooks/deny-native-tool-reroute.sh, where a person opening
## the hook can read it. Two different facts, one home each.
##
## Dot-sourced. Nothing here is an operation, so there is no flag and no
## help pair; a consumer calls these functions directly.
##

## The canonicalization format version, one token on one line.
## NO READER ON THIS TREE, and the four-field subject-decision-reason-redirect
## record format it versions has been removed -- the wording those records carried
## is now written out in the hook script itself. Left in place rather than deleted,
## because an unread thing is as often an unimplemented intent as it is residue,
## and that is the human-owner's call. Whoever rules on it: the token below names a
## record format that no longer exists.
AgentsToolsClientToolPolicyFormatVersion(){
	printf '%s\n' "subject-decision-reason-redirect"
}

## The native tools that are rerouted, one per line. THE SINGLE SOURCE OF THE SET:
## the installer writes one PreToolUse entry per name here, and the hook keys below
## are derived from the same names, so no consumer states the set a second time.
## The refusal each one answers with is in the hook script, keyed by these same
## names. A name here with no case there denies loudly rather than falling through,
## because a hook emitting no decision reads as ALLOW.
##
## The set is the overlap between the harness tool floor this estate's MCP serves
## and the tools a *-native client offers, less the tools a reroute would break:
## anything addressing state owned by the process that created it (an agent
## registry, a caller to hand back to, a job handle) cannot work from a tools/call,
## which runs in a fresh process -- and anything answering about the client's own
## context answers about the harness instead, which is a different answer rather
## than the same job done elsewhere. NotebookEdit is native with no served
## counterpart at all, so there is nothing to route it to.
##
## An empty list would install no reroute while still succeeding, so it is refused.
AgentsToolsClientToolPolicyRerouteToolNames(){
	local policyToolNames="" policyToolName
	for policyToolName in Bash AskUserQuestion Read Write Edit Glob Grep WebFetch WebSearch ; do
		case "$policyToolName" in
			""|*[!A-Za-z]*)
				echo "⛔ ERROR: AgentsToolsClientToolPolicyRerouteToolNames: '$policyToolName' is not a bare tool name, and a PreToolUse matcher is written from it verbatim" >&2
				return 1
			;;
		esac
		policyToolNames="${policyToolNames}${policyToolName}"$'\n'
	done
	if [ -z "$policyToolNames" ] ; then
		echo "⛔ ERROR: AgentsToolsClientToolPolicyRerouteToolNames: no tool names -- an empty set installs no reroute at all while still reporting success" >&2
		return 1
	fi
	printf '%s' "$policyToolNames"
}

## The script every reroute entry runs, as one path relative to the workspace root.
## Named once because the installer copies it, the entries call it, and the class
## filter below recognises it.
AgentsToolsClientToolPolicyRerouteHookPath(){
	printf '%s\n' ".claude/hooks/deny-native-tool-reroute.sh"
}

## The deny-reroute keys, one per line: the hooks that exist to route a *-native
## client toward this estate's own MCP tooling, and which therefore must not apply
## inside our own universal harness -- there the destination is already what is
## running. The class is declared here and never read out of hooks.PreToolUse,
## because a *-native client reads that same array and an entry cannot carry a
## marker only one of its two readers honours.
## One key covers every reroute entry, because they all run the one script: the
## class question is which script an entry runs, not which tool it governs.
## An empty result is the legitimate "no policy is deny-reroute" and is not an
## error; a non-zero return is, and a consumer must tell the two apart.
AgentsToolsClientToolPolicyRerouteHookKeys(){
	local policyRerouteKeys="" policyRerouteKey
	for policyRerouteKey in "$( AgentsToolsClientToolPolicyRerouteHookPath )" ; do
		case "$policyRerouteKey" in
			""|*$'\t'*|*$'\n'*)
				echo "⛔ ERROR: AgentsToolsClientToolPolicyRerouteHookKeys: a hook key is empty or carries a tab or a newline, so a consumer would read a class this never declared" >&2
				return 1
			;;
		esac
		policyRerouteKeys="${policyRerouteKeys}${policyRerouteKey}"$'\n'
	done
	printf '%s' "$policyRerouteKeys"
}

## The dedupe keys, one per line -- the plain substring each installed hook
## is recognised by inside the raw hooks.PreToolUse text. A consumer captures
## this with $( ), which strips the final newline, and passes it on that call
## as MYX_CLAUDEVERIFY_HOOK_KEYS. An empty element there reports OK against
## any non-empty PreToolUse, and an empty list asserts nothing at all while
## still succeeding, so both are refused here rather than emitted.
## ONE KEY PER REROUTED TOOL, not one for the shared script: the verifier's job is
## to catch an entry the settings merge failed to add, and every reroute entry runs
## the same script, so a key naming the script alone would report OK with eight of
## the nine missing.
AgentsToolsClientToolPolicyHookKeys(){
	local policyHookKeys="" policyHookKey policyHookTool policyHookScript
	policyHookScript="$( AgentsToolsClientToolPolicyRerouteHookPath )" || return 1
	while IFS= read -r policyHookTool ; do
		[ -n "$policyHookTool" ] || continue
		policyHookKeys="${policyHookKeys}${policyHookScript} ${policyHookTool}"$'\n'
	done <<< "$( AgentsToolsClientToolPolicyRerouteToolNames )"
	if [ -z "$policyHookKeys" ] ; then
		echo "⛔ ERROR: AgentsToolsClientToolPolicyHookKeys: the reroute tool set yielded no keys, so the verifier would assert nothing about the reroute hooks" >&2
		return 1
	fi
	for policyHookKey in ".claude/hooks/deny-memory-md-read.sh" ; do
		case "$policyHookKey" in
			""|*$'\t'*|*$'\n'*)
				echo "⛔ ERROR: AgentsToolsClientToolPolicyHookKeys: a hook key is empty or carries a tab or a newline, which the verifier reads as an assertion it never made" >&2
				return 1
			;;
		esac
		policyHookKeys="${policyHookKeys}${policyHookKey}"$'\n'
	done
	if [ -z "$policyHookKeys" ] ; then
		echo "⛔ ERROR: AgentsToolsClientToolPolicyHookKeys: no hook keys -- an empty list makes the verifier assert nothing and report success" >&2
		return 1
	fi
	printf '%s' "$policyHookKeys"
}
