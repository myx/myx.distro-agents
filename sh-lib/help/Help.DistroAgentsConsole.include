#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

echo >&2
echo "This is DistroAgentsConsole. It runs in DistroAgents context and provides following commands:" >&2
echo >&2

if type Action >/dev/null 2>&1 ; then
	Action --help
fi
if type Require >/dev/null 2>&1 ; then
	Require --help
fi
if type Agents >/dev/null 2>&1 ; then
	Agents --help
fi
if type Source >/dev/null 2>&1 ; then
	Source --help
fi
if type Deploy >/dev/null 2>&1 ; then
	Deploy --help
fi
if type Remote >/dev/null 2>&1 ; then
	Remote --help
fi
if type Distro >/dev/null 2>&1 ; then
	Distro --help
fi

echo >&2
echo "CLI entry commands ('claude', 'copilot') are available directly in this shell." >&2
echo "Command completions are available by pressing TAB after command and a space." >&2
echo >&2