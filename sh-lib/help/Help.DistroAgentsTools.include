## --help-setup-<domain> answers ahead of the syntax block: it is asked for one
## domain's manual, and the syntax lines below would be noise in front of it.
## Routed by glob, so a domain gaining a setup document becomes readable with no
## arm added anywhere.
case "$1" in
	--help-setup-*)
		local helpSetupDomain="${1#--help-setup-}"
		AgentsToolsAssertBareName "$helpSetupDomain" "<domain>" "help-setup" || { set +e ; return 1 ; }
		local helpSetupFile="$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/help/Help.DistroAgentsTools-setup-$helpSetupDomain.help.md"
		if [ ! -f "$helpSetupFile" ] ; then
			local helpSetupKnown="" helpSetupOther
			for helpSetupOther in "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/help/Help.DistroAgentsTools-setup-"*.help.md ; do
				[ -f "$helpSetupOther" ] || continue
				helpSetupOther="${helpSetupOther##*/Help.DistroAgentsTools-setup-}"
				helpSetupKnown="$helpSetupKnown --help-setup-${helpSetupOther%.help.md}"
			done
echo "⛔ ERROR: $MDSC_CMD --help-setup-$helpSetupDomain: this domain carries no setup document.${helpSetupKnown:+ Documented domains:$helpSetupKnown}" >&2
			set +e ; return 1
		fi
echo "" >&2
echo "# Setup manual: $helpSetupDomain" >&2
echo "" >&2
		## cat, never catMarkdown: the renderer reads an underscore as emphasis and
		## drops it, and every configuration key in this document carries one.
		cat "$helpSetupFile" >&2
		return 0
	;;
esac

## --help-syntax <op> prints the syntax lines of that one operation, and a word ending in `-`
## those of every operation it begins, a family such as --magic-: the manual's own syntax
## lines, which this file's match one for one. A word that names none is refused.
case "$1:${2:-}" in
	--help-syntax:?*)
		local helpSyntaxWant="$2" helpSyntaxLines
		helpSyntaxLines="$( LC_ALL=C awk -v want="$helpSyntaxWant" '
			/^##/ { exit }
			index( $0, "📘 syntax: " ) == 1 {
				split( substr( $0, length( "📘 syntax: " ) + 1 ), words, " " ) ; op = words[2] ; gsub( /[][]/, "", op )
				if ( op == want || ( want ~ /-$/ && index( op, want ) == 1 ) ) print
			}' "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/help/Help.DistroAgentsTools.help.md" )"
		if [ -z "$helpSyntaxLines" ] ; then
echo "⛔ ERROR: $MDSC_CMD --help-syntax $helpSyntaxWant: no operation is named so, or begins so -- $MDSC_CMD --help-syntax lists them all" >&2
			set +e ; return 1
		fi
		printf '%s\n' "$helpSyntaxLines" >&2
		return 0
	;;
esac

## The default syntax: the entry points a reader starts from. Every other
## operation's syntax sits behind --help-syntax, and the manual behind --help.
## Every echo stays flush-left, inside a case arm too: --member-help cuts this
## file on a ^echo anchor, and an indented line silently breaks that cut.
echo "📘 syntax: DistroAgentsTools.fn.sh --agents-config-option <entity-id> <operation>" >&2
echo "📘 syntax: DistroAgentsTools.fn.sh --help-setup-<domain>" >&2
echo "📘 syntax: DistroAgentsTools.fn.sh --install-workspace-integrations [--scope workspace|user-home] [--workspace <path>]" >&2
echo "📘 syntax: DistroAgentsTools.fn.sh --install-workspace-restrictions [--workspace <path>]" >&2
echo "📘 syntax: DistroAgentsKnowledge.fn.sh --member-help [--team-member <team-member>]" >&2
echo "📘 syntax: DistroAgentsTools.fn.sh --owner-setup-<domain> [<config-option>...] [--all-workspaces] [--set-as-default] [--check|--apply|--print-apply-command|--wizard]" >&2
echo "📘 syntax: DistroAgentsTools.fn.sh [--help-syntax [<op>]]" >&2
echo "📘 syntax: DistroAgentsTools.fn.sh [--help]" >&2

