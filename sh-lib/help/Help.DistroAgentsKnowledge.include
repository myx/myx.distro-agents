#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

## The help of DistroAgentsKnowledge.fn.sh: What the team has written, searched; and the registries of projects, places, namespaces and members, read.
## The three forms are DistroAgentsTools.fn.sh's: no word the default syntax, the entry points a reader starts from;
## --help-syntax the syntax line of every operation of the file, read from the one table of the family,
## sh-lib/help/Help.DistroAgentsTools.include; --help the manual, sh-lib/help/Help.DistroAgentsKnowledge.help.md.
## Every echo stays flush-left: --member-help cuts help files on a ^echo anchor.

## The default syntax: the entry points a reader starts from. Every other operation's syntax sits behind
## --help-syntax, and the manual behind --help.
echo "📘 syntax: DistroAgentsKnowledge.fn.sh [--mdat-output-format json] [<project selector: --select-*|--filter-*|--remove-*>] (--add-source-docs|--add-board-items|--add-vault-items|--add-inbox-items)... (--query-keyword <text>|--query-pattern <regex>|--query-glob <glob>|--query-open-and|--query-open-or|--query-close)..." >&2
echo "📘 syntax: DistroAgentsKnowledge.fn.sh --member-help [--team-member <team-member>]" >&2
echo "📘 syntax: DistroAgentsKnowledge.fn.sh --get-roster [--team-member <team-member>]" >&2
echo "📘 syntax: DistroAgentsKnowledge.fn.sh --list-places" >&2
echo "📘 syntax: DistroAgentsKnowledge.fn.sh --get-place-path <name>[/<relative>]" >&2
echo "📘 syntax: DistroAgentsKnowledge.fn.sh [--help-syntax [<op>]]" >&2
echo "📘 syntax: DistroAgentsKnowledge.fn.sh [--help]" >&2

case "$1" in

	--help-syntax)
		type AgentsToolsFrontSyntax > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsContext.FrontTable.include"
		AgentsToolsFrontSyntax "${MDSC_CMD:-DistroAgentsKnowledge}" "${2:-}"
		return $?
	;;

	--help)
		myx.common lib/catMarkdown "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/help/Help.DistroAgentsKnowledge.help.md" >&2
		return 0
	;;

esac
