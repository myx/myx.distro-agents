#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

## The help of AgentDispatcherTools.fn.sh: The duties of the coordinator: routine state, the roster, the client operations.
## The three forms are DistroAgentsTools.fn.sh's: no word the default syntax, the entry points a reader starts from;
## --help-syntax the syntax line of every operation of the file, read from the one table of the family,
## sh-lib/help/Help.DistroAgentsTools.include; --help the manual, sh-lib/help/Help.AgentDispatcherTools.help.md.
## Every echo stays flush-left: --member-help cuts help files on a ^echo anchor.

## The default syntax: the entry points a reader starts from. Every other operation's syntax sits behind
## --help-syntax, and the manual behind --help.
echo "📘 syntax: AgentDispatcherTools.fn.sh --roster-upsert [--team-member <team-member>] [--from-file <path>|--edit-patch-from-stdin]" >&2
echo "📘 syntax: AgentDispatcherTools.fn.sh --spawns [--team-member <team-member>] [--active|--waiting|--all]" >&2
echo "📘 syntax: AgentDispatcherTools.fn.sh --tasks [--team-member <team-member>]" >&2
echo "📘 syntax: AgentDispatcherTools.fn.sh --spawn-run [--select-workspace <place-name>] (--routine <selector>|--routine-default) [<DistroAgentsDispatcher.fn.sh --spawn-session options>]" >&2
echo "📘 syntax: AgentDispatcherTools.fn.sh --spawn-run <member> [--session-id <id>|--new-session] [--settings-workspace <name>] [--cli-service <name>] [--description <text>] [--prompt-file <path>] < prompt" >&2
echo "📘 syntax: AgentDispatcherTools.fn.sh --contacts [--team-member <team-member>] [--organisation <slug>] [--reached-by <member>]" >&2
echo "📘 syntax: AgentDispatcherTools.fn.sh --epic-update [--team-member <team-member>] <epic-file> (--set-status <feature-id> <status>|--add-settled <feature-id> [--date <YYYY-MM-DD>] [--owner <name>] <text...>)" >&2
echo "📘 syntax: AgentDispatcherTools.fn.sh [--help-syntax [<op>]]" >&2
echo "📘 syntax: AgentDispatcherTools.fn.sh [--help]" >&2

case "$1" in

	--help-syntax)
		type AgentsToolsFrontSyntax > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsContext.FrontTable.Help.include"
		AgentsToolsFrontSyntax "${MDSC_CMD:-AgentDispatcherTools}" "${2:-}"
		return $?
	;;

	--help)
		myx.common lib/catMarkdown "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/help/Help.AgentDispatcherTools.help.md" >&2
		return 0
	;;

esac
