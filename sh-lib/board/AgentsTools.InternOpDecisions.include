#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.InternOpDecisions.include -- the ops over a board item's `## Decisions`
## section (AgentsTools.ItemDecisions.include): the tooling's own append, and the member
## stub a member records a clarification, resolution or dismissal with (--record-decision of
## DistroAgentsQuestions.fn.sh). Sourced from the dispatcher's `--intern-op-decisions-*` arm and the tool file's; relies on being
## dot-sourced for $1/$@/$MDSC_CMD.
##

. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.ItemDecisions.include"

case "$1" in

	## The tooling's own: any kind, any <who>, and blockers cleared on request.
	--intern-op-decisions-append|--record-decision)
		local decOp="$1"
		shift
		MDSC_CMD="$MDSC_CMD $decOp"
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsContext.UseAgentsTools.include"
		local decWho="${1:-}" decItem="${2:-}" decKind="" decText="" decSource="" decClear="" decMentions="" decReadback="" decStrike="" decReason="" decWith="" decWait=false decReview=
		shift 2 2>/dev/null || shift $#
		while [ $# -gt 0 ] ; do
			case "$1" in
				--kind|--text|--source|--clear-if-mentions|--context|--readback|--strike|--reason|--with)
					[ $# -ge 2 ] || { echo "$MDSC_CMD: ⛔ ERROR: $1 requires a value" >&2 ; set +e ; return 1 ; }
					case "$1" in
						--kind) decKind="$2" ;;
						--text) decText="$2" ;;
						--source) decSource="$2" ;;
						--readback) decReadback="$2" ;;
						--with) decWith="$2" ;;
						--strike) decStrike="$2" ;;
						--reason) decReason="$2" ;;
						--clear-if-mentions) decMentions="$decMentions $2" ;;
					esac
					shift 2
				;;
				--clears-blocker|--clear-blockers) decClear="all" ; shift ;;
				--wait) decWait=true ; shift ;;
				--review) decReview=1 ; shift ;;
				*)
					echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$decWho" ] || [ -z "$decItem" ] || { [ -z "$decStrike" ] && [ -z "$decReview" ] && { [ -z "$decKind" ] || [ -z "$decText" ] ; } ; } ; then
			echo "$MDSC_CMD: ⛔ ERROR: syntax is <team-member> <item-filename> --kind <kind> --text <one line> (--with <party> [--wait]|--readback <pending-id>) [--source <ts-or-id>] [--clears-blocker], or --strike <exact line> --reason <text>, or --review --with <party> [--wait]" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "${decItem##*/}" "<item-filename>" decisions || { set +e ; return 1 ; }
		if [ "$decOp" = "--record-decision" ] ; then
			AgentsToolsAssertBareName "$decWho" "<team-member>" decision-record || { set +e ; return 1 ; }
			## An answer or a verdict is the tooling's to record, from the ask it closes.
			case "$decKind" in
				clarification|resolved|dismissed|'') ;;
				*)
					echo "$MDSC_CMD: ⛔ ERROR: a member records clarification, resolved or dismissed; $decKind is recorded by the tooling when an ask closes" >&2
					set +e ; return 1
				;;
			esac
			[ -n "$decMentions" ] && { echo "$MDSC_CMD: ⛔ ERROR: invalid option: --clear-if-mentions" >&2 ; set +e ; return 1 ; }
			## Who records, with or without --clears-blocker: the item's own parties only; magic-coordinator also strikes and reviews.
			AgentsToolsActingMemberCheck "$decWho" record-decision || { set +e ; return 1 ; }
			local decPath=""
			if decPath="$( AgentsToolsDecisionsItemPath "$decItem" )" && ! AgentsToolsItemIsParty "$decPath" "$decWho" \
				&& { [ "$decWho" != magic-coordinator ] || [ -z "$decStrike$decReview" ] ; } ; then
				echo "$MDSC_CMD: ⛔ ERROR: $decWho is not the owner, executor or reviewer of ${decPath##*/}, nor the member of its spawned session, so it records nothing on it" >&2
				set +e ; return 1
			fi
			## A recorded line is struck through, never deleted: by the member it names, the item's owner, or
			## magic-coordinator above them, and only through the readback that confirmed the strike.
			if [ -n "$decStrike" ] ; then
				[ -n "$decReason" ] || { echo "$MDSC_CMD: ⛔ ERROR: --reason <why the line is struck> is required with --strike" >&2 ; set +e ; return 1 ; }
				[ -z "$decKind" ] && [ -z "$decText" ] || { echo "$MDSC_CMD: ⛔ ERROR: --strike takes no --kind and no --text: it marks the line it names" >&2 ; set +e ; return 1 ; }
				local strPath="" strWriter=""
				strPath="$( AgentsToolsDecisionsItemPath "$decItem" )" || { echo "$MDSC_CMD: ⛔ ERROR: no board item ${decItem%.md} in any board state, so nothing was struck" >&2 ; set +e ; return 1 ; }
				strWriter="$( AgentsToolsDecisionsOneLine "$decStrike" 300 | LC_ALL=C awk '{ print $3 }' )"
				if [ "$decWho" != "$strWriter" ] && [ "$decWho" != magic-coordinator ] && ! AgentsToolsMemberListHas "$( AgentsToolsDecisionsField "$strPath" owner )" "$decWho" ; then
					echo "$MDSC_CMD: ⛔ ERROR: $decWho neither wrote that line (${strWriter:-an unnamed member}), owns ${decItem%.md}, nor is magic-coordinator above them, so it strikes nothing" >&2
					set +e ; return 1
				fi
			fi
			## A review reads back every unconfirmed line of the item as one list, each with its proposed action, and its answer applies them.
			if [ -n "$decReview" ] ; then
				[ -z "$decKind" ] && [ -z "$decText" ] && [ -z "$decStrike" ] && [ -z "$decReadback" ] && [ -n "$decWith" ] \
					|| { echo "$MDSC_CMD: ⛔ ERROR: --review takes --with <party>, and no --kind, --text, --strike or --readback: it reads back the unconfirmed lines of the item as one list" >&2 ; set +e ; return 1 ; }
				[ -n "$decPath" ] || { echo "$MDSC_CMD: ⛔ ERROR: no board item ${decItem%.md} in any board state, so nothing was reviewed" >&2 ; set +e ; return 1 ; }
				if [ "$decWho" != magic-coordinator ] && ! AgentsToolsMemberListHas "$( AgentsToolsDecisionsField "$decPath" owner )" "$decWho" ; then
					echo "$MDSC_CMD: ⛔ ERROR: $decWho neither owns ${decItem%.md} nor is magic-coordinator, so it reviews nothing on it" >&2
					set +e ; return 1
				fi
				local revPlan="${MDAT_DECISIONS_REVIEW_PLAN:-}" revList
				## An unconfirmed line: a member kind with no confirmed readback behind it, neither struck nor confirmed.
				[ -n "$revPlan" ] || revPlan="$( MDAT_DECISIONS_MARKER="$( printf '<!-- decisions-of: %s -->' "${decItem%.md}" )" LC_ALL=C awk "$agentsDecisionsOwnAwk"'
					{ line[NR] = $0 ; }
					END {
						start = decisionsOwn( NR, ENVIRON["MDAT_DECISIONS_MARKER"] ) ;
						if ( ! start ) { exit ; }
						last = decisionsEnd( NR, start ) ;
						for ( i = start + 1 ; i <= last ; i++ ) {
							if ( line[i] !~ /^- / || line[i] ~ / \[(struck by|confirmed by) [^]]*\]$/ || index( line[i], "(readback " ) > 0 || index( line[i], "(his message slack:" ) > 0 ) { continue ; }
							lineKind = line[i] ; sub( /^- [^ ]+ [^ ]+ /, "", lineKind ) ; sub( /:.*$/, "", lineKind ) ;
							if ( lineKind != "clarification" && lineKind != "resolved" && lineKind != "dismissed" ) { continue ; }
							tailAt = index( line[i], " (" ) ; lineTail = ( tailAt ? substr( line[i], tailAt ) : "" ) ;
							lineAction = "prune" ;
							if ( lineTail ~ /withdrawn/ ) { lineAction = "re-ask" ; } else if ( lineTail ~ /answered by|settled/ ) { lineAction = "confirm" ; }
							printf "%d\t%s\t%s\n", ++lineNumber, lineAction, struckBase( line[i] ) ;
						}
					}
				' "$decPath" )"
				[ -n "$revPlan" ] || { printf 'DECISION-REVIEW-NONE %s: no unconfirmed line on its Decisions, so nothing was asked\n' "${decItem%.md}" ; return 0 ; }
				## The person reads each line as who, what kind, the day and its words; the exact line stays in the plan the answer applies.
				revList="$( printf '%s\n' "$revPlan" | LC_ALL=C awk -F'\t' '
					{
						rowLine = substr( $0, length( $1 ) + length( $2 ) + 3 ) ; split( rowLine, rowWord, " " ) ;
						rowWho = rowWord[3] ; if ( rowWho ~ /^[UW][0-9A-Z]+$/ ) { rowWho = "a Slack reply" ; }
						rowKind = rowWord[4] ; sub( /:$/, "", rowKind ) ;
						rowText = rowLine ; sub( /^- [^ ]+ [^ ]+ [^ ]+ /, "", rowText ) ;
						tailAt = index( rowText, " (" ) ; if ( tailAt ) { rowText = substr( rowText, 1, tailAt - 1 ) ; }
						if ( length( rowText ) > 200 ) { rowText = substr( rowText, 1, 197 ) ; sub( /[\300-\377][\200-\277]*$/, "", rowText ) ; rowText = rowText "..." ; }
						printf "%s. %s: %s, %s, %s\n> %s\n", $1, $2, rowWho, rowKind, substr( rowWord[2], 1, 10 ), rowText ;
					}
				' )"
				AgentsToolsDecisionReadbackOpen "$decWho" "$decItem" review "$revList" "$decSource" "$decWith" "$decWait" "$revPlan" || { set +e ; return 1 ; }
				return 0
			fi
			## A DECISION LANDS ONLY THROUGH ITS CONFIRMED READBACK: the one it was made with confirmed its exact text (yes), or edited it (edit).
			## The line takes its text, its approver and its time from that readback's own record, never from the caller.
			## --with asks that readback (AgentsToolsDecisionReadbackOpen), and its answer lands the decision, or the strike, by itself.
			if [ -n "$decWith" ] && [ -n "$decReadback" ] ; then
				echo "$MDSC_CMD: ⛔ ERROR: --with asks a new readback and --readback names one already answered, so give one of them; nothing was asked or recorded" >&2
				set +e ; return 1
			fi
			## HIS OWN MESSAGE IS HIS DECISION (owner 2026-11-19): a source that is his own Slack message, its author read from the comms cache,
			## records the decision from it at once, with that provenance, and asks him nothing. A strike still goes through its readback.
			if [ -z "$decReadback" ] && [ -z "$decStrike" ] && [ -n "$decSource" ] ; then
				type AgentsToolsDecisionSourceOwnerMessage > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.ItemDecisions.include"
				local decOwnMessage=""
				if decOwnMessage="$( AgentsToolsDecisionSourceOwnerMessage "$decSource" )" ; then
					AgentsToolsDecisionsAppendTracked "$decWho" "$decItem" "$decKind" "$decText" "$decOwnMessage" "$decClear" "$decMentions" || { set +e ; return 1 ; }
					return 0
				fi
			fi
			if [ -z "$decReadback" ] ; then
				[ -n "$decWith" ] || {
					echo "$MDSC_CMD: ⛔ ERROR: a decision is recorded only through its confirmed readback: name the one it was made with by --with <party>, and its exact text is read back to them and recorded once they confirm or edit it; or name a readback they already confirmed by --readback <pending id>" >&2
					set +e ; return 1 ; }
				[ -z "$decClear" ] || { echo "$MDSC_CMD: ⛔ ERROR: --clears-blocker is not carried through a readback still to answer; record the decision, then clear the blocker" >&2 ; set +e ; return 1 ; }
				if [ -n "$decStrike" ] ; then
					AgentsToolsDecisionReadbackOpen "$decWho" "$decItem" strike "$( AgentsToolsDecisionsOneLine "$decReason" 300 )" "$decSource" "$decWith" "$decWait" "$decStrike" || { set +e ; return 1 ; }
				else
					AgentsToolsDecisionReadbackOpen "$decWho" "$decItem" "$decKind" "$( AgentsToolsDecisionsOneLine "$decText" 300 )" "$decSource" "$decWith" "$decWait" || { set +e ; return 1 ; }
				fi
				return 0
			fi
			type AgentsToolsPendingRecordPath > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.Authority.include"
			local decRbFile decRbKind="" decRbStatus="" decRbItem="" decRbVerdict="" decRbEdit="" decRbBy="" decRbAt="" decRbUnderstood=""
			decRbFile="$( AgentsToolsPendingRecordPath "$decReadback" )" || { echo "$MDSC_CMD: ⛔ ERROR: no readback $decReadback in the ask store, so nothing was recorded" >&2 ; set +e ; return 1 ; }
			IFS=$'\037' read -r decRbKind decRbStatus decRbItem decRbVerdict decRbEdit decRbBy decRbAt decRbUnderstood < <( LC_ALL=C awk '
				$0 == "---" { dashes++ ; next ; }
				dashes == 1 { colon = index( $0, ": " ) ; if ( colon > 1 ) { field[ substr( $0, 1, colon - 1 ) ] = substr( $0, colon + 2 ) ; } next ; }
				dashes >= 2 && index( $0, "**📥 What I understood**" ) == 1 { inside = 1 ; next ; }
				inside && $0 ~ /^[ \t]*$/ { if ( understood != "" ) { inside = 0 ; } next ; }
				inside { understood = ( understood == "" ? $0 : understood " " $0 ) ; }
				END { printf "%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\n", field["kind"], field["status"], field["item"], field["verdict"], field["verdict-text"], field["answered-by"], field["resolved-at"], understood ; }
			' "$decRbFile" 2> /dev/null )
			if [ "$decRbKind" != readback ] || [ "$decRbStatus" != reply-received ] ; then
				echo "$MDSC_CMD: ⛔ ERROR: $decReadback is no answered readback (kind ${decRbKind:-none}, status ${decRbStatus:-none}), so nothing was recorded" >&2
				set +e ; return 1
			fi
			if [ "${decRbItem%.md}" != "${decItem%.md}" ] ; then
				echo "$MDSC_CMD: ⛔ ERROR: readback $decReadback is on ${decRbItem:-no item}, not on ${decItem%.md}, so nothing was recorded" >&2
				set +e ; return 1
			fi
			case "$decRbVerdict" in
				yes)
					## A strike's readback is about the line, so it confirms the reason given for it.
					if [ -n "$decStrike" ] ; then
						[ "$( AgentsToolsDecisionsOneLine "$decReason" 300 )" = "$( AgentsToolsDecisionsOneLine "$decRbUnderstood" 300 )" ] || {
							echo "$MDSC_CMD: ⛔ ERROR: the reason differs from what readback $decReadback confirmed, so nothing was struck: confirmed was: $decRbUnderstood" >&2
							set +e ; return 1 ; }
					else
						[ "$( AgentsToolsDecisionsOneLine "$decText" 300 )" = "$( AgentsToolsDecisionsOneLine "$decRbUnderstood" 300 )" ] || {
							echo "$MDSC_CMD: ⛔ ERROR: the text differs from what readback $decReadback confirmed, so nothing was recorded: confirmed was: $decRbUnderstood" >&2
							set +e ; return 1 ; }
					fi
				;;
				edit|correct)
					[ -n "$decRbEdit" ] || { echo "$MDSC_CMD: ⛔ ERROR: readback $decReadback was edited with no words of the edit, so nothing was recorded" >&2 ; set +e ; return 1 ; }
					if [ -n "$decStrike" ] ; then decReason="$decRbEdit" ; else decText="$decRbEdit" ; fi
				;;
				*)
					echo "$MDSC_CMD: ⛔ ERROR: readback $decReadback was not confirmed (verdict ${decRbVerdict:-none}), so nothing was recorded" >&2
					set +e ; return 1
				;;
			esac
			## A strike is confirmed by the line's own confirmer, the human-owner, or a contact at tier-admin or tier-owner.
			if [ -n "$decStrike" ] ; then
				local strBy=""
				strBy="$( printf '%s\n' "$decStrike" | LC_ALL=C sed -n 's/.*(readback [^,]*, confirmed by \([^ ,)]*\) at .*/\1/p' | head -1 )"
				type AgentsToolsPermissionIsHumanOwner > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.PermissionHolds.include"
				if { [ -z "$strBy" ] || [ "${decRbBy:-}" != "$strBy" ] ; } && ! AgentsToolsPermissionIsHumanOwner "${decRbBy:-}" && ! AgentsToolsDecisionAccountDecides "${decRbBy:-}" "${strPath:-}" ; then
					echo "$MDSC_CMD: ⛔ ERROR: readback $decReadback was answered by ${decRbBy:-nobody}, who did not confirm that line${strBy:+ ($strBy did)}, is not the human-owner, and holds no tier-admin or tier-owner, so nothing was struck: put the strike to ${strBy:+$strBy, }the human-owner or a contact with those rights" >&2
					set +e ; return 1
				fi
			fi
			if [ -n "$decPath" ] && LC_ALL=C grep -q -F -- "(readback $decReadback," "$decPath" 2> /dev/null ; then
				echo "$MDSC_CMD: ⛔ ERROR: readback $decReadback is already recorded on ${decPath##*/}, so it records nothing twice" >&2
				set +e ; return 1
			fi
			decSource="readback $decReadback, confirmed by ${decRbBy:-unknown} at ${decRbAt:-unknown}${decSource:+, $decSource}"
			## A RULING HE NEVER GAVE IS NOT A MEMBER'S TO RECORD (task-20261117T2332Z): text that tells a decision by the
			## human-owner is recorded only with the message, or the ask's verdict, it came from.
			if printf '%s\n' "$decText" | LC_ALL=C awk '{ if ( $0 ~ /(^|[^A-Za-z])([Hh]is|[Hh]er|[Hh]e|[Ss]he|human-owner|the owner)(\047s)?[ \t]+(ruling|rulings|verdict|verdicts|decision|decisions|decided|ruled|said|says|words|answer|answered|order|ordered|wants|wanted|asked|approval|approved)([^A-Za-z]|$)/ ) { hit = 1 ; } } END { exit ( hit ? 0 : 1 ) ; }' ; then
				type AgentsToolsPermissionIsHumanOwner > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.PermissionHolds.include"
				local ownSourced="" ownSource ownFirst ownRest ownChannel="" ownRecord
				AgentsToolsPermissionIsHumanOwner "${decRbBy:-}" && ownSourced="his readback"
				if [ -z "$ownSourced" ] ; then
					ownSource="${decSource#readback "$decReadback", confirmed by ${decRbBy:-unknown} at ${decRbAt:-unknown}}" ; ownSource="${ownSource#, }"
					ownFirst="${ownSource%%,*}"
					case "$ownFirst" in
						slack:*:*)
							ownRest="${ownFirst#slack:}" ; ownChannel="${ownRest%%:*}"
							type AgentsToolsConfigOption > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/settings/AgentsTools.ConfigOption.include"
							[ "$ownChannel" != "$( AgentsToolsConfigOption magic-team --select SLACK_CHANNEL_HUMAN_OWNER 2> /dev/null )" ] || ownSourced="his message $ownFirst"
						;;
						'')
							;;
						*)
							if ownRecord="$( AgentsToolsPendingRecordPath "$ownFirst" 2> /dev/null )" \
								&& [ "$( AgentsToolsDecisionsField "$ownRecord" status )" = "reply-received" ] ; then
								AgentsToolsPermissionIsHumanOwner "$( AgentsToolsDecisionsField "$ownRecord" answered-by )" && ownSourced="his verdict $ownFirst"
							fi
						;;
					esac
				fi
				[ -n "$ownSourced" ] || {
					echo "$MDSC_CMD: ⛔ ERROR: this text tells a decision by the human-owner, so it is recorded only with the message or the ask's verdict it came from: name that in --source, as slack:<his conversation>:<ts> or the pending id he answered, or record a readback he confirmed. His ruling is not yours to state." >&2
					set +e ; return 1 ; }
			fi
		fi
		## A strike marks a stored line, so it goes to its own appender and appends no new line.
		if [ -n "$decStrike" ] ; then
			AgentsToolsDecisionsStrike "$decWho" "$decItem" "$decStrike" "$decReason" "$decSource" || { set +e ; return 1 ; }
			return 0
		fi
		## A dispatch item's line goes on the task it `tracks:` too, one level only.
		AgentsToolsDecisionsAppendTracked "$decWho" "$decItem" "$decKind" "$decText" "$decSource" "$decClear" "$decMentions" || { set +e ; return 1 ; }
		return 0
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid operation: $1" >&2
		set +e ; return 1
	;;

esac
