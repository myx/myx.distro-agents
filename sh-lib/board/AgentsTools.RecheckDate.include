#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.RecheckDate.include -- the one recheck-date calculation every
## writer shares: the routine lock ops' fixed offsets and the board ops'
## --recheck-in, and the one test of whether a recheck-date holds beside a
## `condition:`, which every reader and writer of one takes. Sourced by AgentsTools.InternOpBoardUpsertMoveEdit.include and
## the AgentsTools.Magic{Advance,Daily,Grooming,Retro}.include
## groups. Contract: MAGIC.md.
##

if ! type AgentsToolsRecheckDate > /dev/null 2>&1 ; then

	## Prints now + <minutes>, moved by a random whole number of minutes within
	## ±<jitter-minutes> when given, as `YYYY-MM-DD HH:MM +0000` (UTC). Epoch
	## arithmetic and LocalEpochToIsoDate.awk, never date(1) arithmetic (MAGIC.md).
	## Returns 2 on a value not shaped <minutes>[±<jitter-minutes>], printing
	## nothing; returns the awk's status when the date cannot be computed.
	AgentsToolsRecheckDate(){ ## <minutes>[±<jitter-minutes>]
		local spec="${1:-}"
		case "${spec%%±*}:${spec#*±}" in
			*[!0-9:]*|:*|*:) return 2 ;;
		esac
		local minutes="${spec%%±*}" jitter=0 epoch day rem
		case "$spec" in *±*) jitter="${spec#*±}" ;; esac
		minutes=$(( 10#$minutes ))
		jitter=$(( 10#$jitter ))
		if [ "$jitter" -gt 0 ] ; then
			minutes=$(( minutes + RANDOM % ( 2 * jitter + 1 ) - jitter ))
		fi
		epoch=$(( $( date +%s ) + minutes * 60 ))
		day="$( printf '%s\n' "$epoch" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/output/LocalEpochToIsoDate.awk" )" || return
		rem=$(( epoch % 86400 ))
		printf '%s %02d:%02d +0000' "$day" "$(( rem / 3600 ))" "$(( rem % 3600 / 60 ))"
	}

fi

## WHETHER A RECHECK-DATE HOLDS beside a `condition:` (board-model.md, "`condition` and `recheck-date`"): rc 0 where the condition is
## unmet, so the date holds; rc 1 where it is absent, or its first word, past leading spaces and in any case, is `met` or `none`.
AgentsToolsRecheckConditionUnmet(){ ## condition text
	local conditionWord="${1:-}"
	conditionWord="${conditionWord#"${conditionWord%%[![:space:]]*}"}"
	case "$conditionWord" in
		''|[Mm][Ee][Tt]|[Mm][Ee][Tt][[:space:]:.,]*|[Nn][Oo][Nn][Ee]|[Nn][Oo][Nn][Ee][[:space:]:.,]*) return 1 ;;
	esac
	return 0
}

## A RECHECK-DATE ON A PENDING ITEM RE-CHECKS AN UNMET CONDITION, for every writer into board-pending: the item's text on stdin, printed back.
## Beside no unmet `condition:`, a date the write sets (an `upsert` or `append` of `recheck-date` among its header operations) is refused, rc 1
## and nothing printed, and a date the text carries is dropped with a warning.
AgentsToolsRecheckPendingBody(){ ## writer label, item name, header operations (`<op>TAB<name>TAB<value>` lines)
	local pendingBody="$( cat )"
	local pendingCondition="$( printf '%s\n' "$pendingBody" | LC_ALL=C awk 'NR == 1 { if ( $0 != "---" ) exit ; next ; } $0 == "---" { exit ; } index( $0, "condition: " ) == 1 { print substr( $0, 12 ) ; exit ; }' )"
	if AgentsToolsRecheckConditionUnmet "$pendingCondition" ; then printf '%s\n' "$pendingBody" ; return 0 ; fi
	case $'\n'"${3:-}" in
		*$'\n'upsert$'\t'recheck-date$'\t'*|*$'\n'append$'\t'recheck-date$'\t'*)
			echo "$1: ⛔ ERROR: $2: a recheck-date on a pending item re-checks an unmet condition, and its condition reads '${pendingCondition:-nothing}'. Write condition: unmet: <what it waits for> beside the date, or set no date -- nothing was written" >&2
			return 1
		;;
	esac
	printf '%s\n' "$pendingBody" | LC_ALL=C awk -v itemLabel="$1: $2" '
		{ bodyLine[ NR ] = $0 ; }
		NR == 1 { inFront = ( $0 == "---" ) ; next ; }
		inFront && $0 == "---" { inFront = 0 ; frontEnd = NR ; next ; }
		END {
			for ( lineAt = 1 ; lineAt <= NR ; lineAt++ ) {
				if ( lineAt < frontEnd && index( bodyLine[ lineAt ], "recheck-date: " ) == 1 ) { recheckDropped = 1 ; continue ; }
				print bodyLine[ lineAt ] ;
			}
			if ( recheckDropped ) print "# " itemLabel ": recheck-date not kept: its condition is absent, none or met, so the item is ready to start" > "/dev/stderr" ;
		}
	'
}
