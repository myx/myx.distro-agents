#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.ReviewFlow.include -- how a dispatched board item enters review, the
## verdicts on it, and every ending of its child the tooling orders. Sourced, never run;
## functions only. The ops are AgentsTools.InternOpReview.include; the hooks call these
## functions from the spawn close, SubagentHandback, Wait, TaskStop, the archive move,
## the trash and the spawn proxy. Contract: MAGIC.md, "Review and ordered endings".
##
## States: `running` (in progress, asks included), `review` (a handback arrived, or the
## child ended with no verdict), `processed` (accepted), `pending` (rejected, for a fresh
## session). Only an item in `running` ever enters `review`.
## Every entry, verdict and ending is one line in the item's `## Decisions`
## (AgentsTools.ItemDecisions.include) and one line in its session transcript
## (AgentsTools.SessionTranscript.include): REVIEW, VERDICT or ENDING.
## A handback whose reviewer is the human-owner also asks him, by a review prompt whose
## answer is the verdict ("the review prompt", below).
##

agentsReviewLib="$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib"

## The team tooling: the dispatcher's own function where this shell has it, else the script.
AgentsReviewTools(){
	if type DistroAgentsTools > /dev/null 2>&1 ; then
		DistroAgentsTools "$@"
	else
		"$BASH" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh" "$@"
	fi
}

AgentsReviewLoad(){
	type AgentsToolsDecisionsItemPath > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.ItemDecisions.include"
	type AgentsToolsSpawnSandboxRecordHeader > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SpawnSandbox.include"
	type AgentsTranscriptEvent > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionTranscript.include"
	return 0
}

## The board state folder of a board item path.
AgentsReviewStateOfPath(){ ## item path
	local statePath="${1%/*}"
	printf '%s' "${statePath##*/}"
}

## REVIEW_WAIT_LIMIT from the team config: how long a child waits in review for its verdict.
AgentsReviewWaitLimit(){
	local limitValue
	limitValue="$( AgentsReviewTools --agents-config-option magic-team --select-default REVIEW_WAIT_LIMIT 3600 2> /dev/null )" || limitValue=3600
	case "$limitValue" in ''|*[!0123456789]*) limitValue=3600 ;; esac
	printf '%s' "$limitValue"
}

## One Decisions line on the item (and on the item it tracks), and one line in the
## transcript of the session that works it. Never fails its caller.
AgentsReviewRecord(){ ## who, item name, decisions kind, text, transcript event, spawn id (empty: the item's own)
	local recWho="${1:-unknown}" recItem="${2%.md}" recKind="$3" recText="$4" recEvent="$5" recSpawn="${6:-}" recPath
	AgentsReviewLoad
	if [ -z "$recSpawn" ] && recPath="$( AgentsToolsDecisionsItemPath "$recItem" )" ; then
		recSpawn="$( AgentsToolsDecisionsField "$recPath" spawn-id )"
	fi
	AgentsReviewTools --intern-op-decisions-append "$recWho" "$recItem" --kind "$recKind" --text "$recText" \
		--source "${recSpawn:-no-session}" --context "${MDSC_CMD:-review}" > /dev/null 2>&1 \
		|| echo "⚠️ WARNING: ${MDSC_CMD:-review}: the $recKind of $recItem was not recorded in its Decisions" >&2
	case "$recSpawn" in
		''|-) ;;
		*) AgentsTranscriptEvent "$recSpawn" "$recEvent" "" 0 item "$recItem" kind "$recKind" by "$recWho" text "$recText" 2> /dev/null || : ;;
	esac
	return 0
}

## The board item a session works: its spawn record's `spawns:` dispatch item, else its
## `spawned-by:` item. Prints the file name; rc 1 when it works none on the board.
AgentsReviewItemOfSession(){ ## spawn id
	local sesRecord sesField sesLink
	case "$1" in ''|*/*|.|..) return 1 ;; esac
	[ -n "${MMDAPP:-}" ] || return 1
	AgentsReviewLoad
	for sesRecord in "$MMDAPP/.local/agents/spawned"/*/"$1.md" ; do
		[ -f "$sesRecord" ] || continue
		for sesField in spawns spawned-by ; do
			sesLink="$( AgentsToolsSpawnSandboxRecordHeader "$sesRecord" "$sesField" )"
			sesLink="${sesLink%%,*}" ; sesLink="${sesLink%% *}" ; sesLink="${sesLink%.md}"
			[ -n "$sesLink" ] && AgentsToolsDecisionsItemPath "$sesLink" > /dev/null || continue
			printf '%s.md\n' "$sesLink"
			return 0
		done
	done
	return 1
}

## The spawn record of an item's child: the one its spawn-id names, else the one live record
## linking it. Prints the path; rc 1 when there is none, or more than one live candidate.
AgentsReviewChildRecord(){ ## item path
	local childSpawn childCandidate childFolder childFound=""
	AgentsReviewLoad
	childSpawn="$( AgentsToolsSpawnSandboxRecordHeader "$1" spawn-id )"
	if [ -n "$childSpawn" ] && [ "$childSpawn" != "-" ] ; then
		for childCandidate in "$MMDAPP/.local/agents/spawned"/*/"$childSpawn.md" ; do
			[ ! -f "$childCandidate" ] || { printf '%s\n' "$childCandidate" ; return 0 ; }
		done
		return 1
	fi
	for childFolder in $( AgentsToolsSpawnSandboxFoldersOfItem "$1" ) ; do
		for childCandidate in "$MMDAPP/.local/agents/spawned/$childFolder"/*.md ; do
			[ -f "$childCandidate" ] || continue
			[ "$( AgentsToolsSpawnSandboxRecordHeader "$childCandidate" status )" = spawn-started ] || continue
			[ -z "$childFound" ] || return 1
			childFound="$childCandidate"
		done
	done
	[ -n "$childFound" ] || return 1
	printf '%s\n' "$childFound"
}

## Whether a spawn record's session still runs: status started and, on this host, a process
## that runs as its spawn id, by the one rule of the spawned-sessions render
## (AgentsToolsRegistrySpawnRuns, AgentsTools.Registries.include). rc 0 live; rc 1 ended,
## with the reason printed.
AgentsReviewChildLive(){ ## record path
	local liveSpawn="${1##*/}" liveStatus liveHost thisHost
	liveSpawn="${liveSpawn%.md}"
	liveStatus="$( AgentsToolsSpawnSandboxRecordHeader "$1" status )"
	[ "$liveStatus" = spawn-started ] || { printf 'spawn %s has already ended (status %s)\n' "$liveSpawn" "${liveStatus:--}" ; return 1 ; }
	liveHost="$( AgentsToolsSpawnSandboxRecordHeader "$1" host )"
	thisHost="$( hostname -s 2> /dev/null )" || thisHost="unknown"
	[ "$liveHost" = "$thisHost" ] || return 0
	type AgentsToolsRegistrySpawnRuns > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/registry/AgentsTools.Registries.include"
	! AgentsToolsRegistrySpawnRuns "$liveSpawn" "$1" || return 0
	printf 'spawn %s is not running on this host, so its session has ended\n' "$liveSpawn"
	return 1
}

## A message to a live child in its own session thread, addressed to its member -- the
## same send an accept's DISMISSED uses. Prints `sent <member> <thread>`, or `not sent: <why>`.
AgentsReviewSendToChild(){ ## sending member, record path, body
	local sendBy="$1" sendRecord="$2" sendBody="$3" sendSpawn="${2##*/}" sendMember sendThread="" sendOut
	sendSpawn="${sendSpawn%.md}"
	sendMember="$( AgentsToolsSpawnSandboxRecordHeader "$sendRecord" owner )"
	[ -n "$sendMember" ] || { printf 'not sent: spawn %s names no owner member to address\n' "$sendSpawn" ; return 1 ; }
	[ "$sendMember" != "$sendBy" ] || { printf 'not sent: the sending member %s is the child member itself, and its own Wait ignores what it authored\n' "$sendBy" ; return 1 ; }
	sendThread="$( AgentsToolsSpawnSandboxRecordHeader "$sendRecord" session-thread )"
	if [ -z "$sendThread" ] || [ "$sendThread" = "-" ] ; then
		sendThread=""
		[ ! -f "${sendRecord%/*}/session.thread" ] || IFS= read -r sendThread < "${sendRecord%/*}/session.thread" || :
	fi
	AgentsToolsSpawnConversationThreadValid "$sendThread" || { printf 'not sent: spawn %s has no session thread to post in\n' "$sendSpawn" ; return 1 ; }
	if sendOut="$( printf '%s' "$sendBody" | AgentsReviewTools --intern-op-comms-slack-send-message "$sendBy" "$sendThread" --identity-bot --address-to "$sendMember" --from-stdin 2>&1 )" ; then
		printf 'sent %s %s\n' "$sendMember" "$sendThread"
		return 0
	fi
	printf 'not sent: the send to %s in %s failed: %s\n' "$sendMember" "$sendThread" "$( printf '%s\n' "$sendOut" | LC_ALL=C grep -m1 'ERROR' )"
	return 1
}

## running -> review, and from running only. A handback is recorded whatever the state;
## any other entry only when it moves the item. A spawn id that is not the item's own
## child moves nothing. Prints one REVIEW: line.
AgentsReviewToReview(){ ## who, item file name, kind (handback|review), reason word, spawn id (may be empty), detail text (may be empty)
	local toWho="$1" toItem="${2%.md}.md" toKind="$3" toReason="$4" toSpawn="${5:-}" toDetail="${6:-}" toPath toState toItemSpawn
	AgentsReviewLoad
	toPath="$( AgentsToolsDecisionsItemPath "$toItem" )" || { printf 'REVIEW: not moved: no board item %s\n' "${toItem%.md}" ; return 1 ; }
	toState="$( AgentsReviewStateOfPath "$toPath" )"
	toItemSpawn="$( AgentsToolsDecisionsField "$toPath" spawn-id )"
	if [ -n "$toSpawn" ] && [ -n "$toItemSpawn" ] && [ "$toItemSpawn" != "-" ] && [ "$toItemSpawn" != "$toSpawn" ] ; then
		printf 'REVIEW: not moved: %s belongs to spawn %s, not %s\n' "${toItem%.md}" "$toItemSpawn" "$toSpawn"
		return 0
	fi
	if [ "$toState" != running ] ; then
		[ "$toKind" != handback ] || AgentsReviewRecord "$toWho" "$toItem" handback "$toReason${toDetail:+: $toDetail} (item in $toState, not moved)" REVIEW "$toSpawn"
		printf 'REVIEW: not moved: %s is in %s; only a running item enters review\n' "${toItem%.md}" "$toState"
		return 0
	fi
	mkdir -p "$MDAT_DATA_ROOT/board/review" 2> /dev/null || :
	if ! AgentsReviewTools --intern-op-board-upsert-move-edit review "$toItem" --from-state:running \
		--header:upsert:review-since-epoch:"$( date +%s )" --header:upsert:review-reason:"$toReason" \
		--context "${MDSC_CMD:-review}" --log-verb:updated > /dev/null 2>&1 ; then
		printf 'REVIEW: not moved: the move of %s to review failed\n' "${toItem%.md}"
		return 1
	fi
	AgentsReviewRecord "$toWho" "$toItem" "$toKind" "$toReason${toDetail:+: $toDetail}" REVIEW "$toSpawn"
	printf 'REVIEW: %s running->review (%s)\n' "${toItem%.md}" "$toReason"
	return 0
}

## An ordered ending: the item's child dismissed through the accept's own send, and the
## reason recorded. --no-dismiss records only (the process is stopped another way).
## Prints one END-DISMISS line.
AgentsReviewEndChild(){ ## sending member, item path, reason, dismiss (yes|no)
	local endBy="$1" endPath="$2" endReason="$3" endOut
	AgentsReviewLoad
	[ -f "$endPath" ] || { printf 'END-DISMISS (%s): not sent: no item at %s\n' "$endReason" "$endPath" ; return 0 ; }
	if [ "${4:-yes}" = no ] ; then
		endOut="recorded only, the process is stopped by $endReason"
	else
		endOut="$( AgentsToolsBoardAcceptDismissChild "$endBy" "$endPath" )"
		endOut="${endOut#ACCEPT-DISMISS: }"
	fi
	printf 'END-DISMISS (%s): %s\n' "$endReason" "$endOut"
	AgentsReviewRecord "$endBy" "${endPath##*/}" dismissed "$endReason: $endOut" ENDING ""
	## An item archived or trashed takes no verdict any more: its open review prompt closes with it.
	case "$endReason" in archived|trashed) AgentsReviewPromptSettle "$endBy" "${endPath##*/}" "$endReason" ;; esac
	return 0
}

## The state a verdict may start from, or an ERROR line and rc 1.
AgentsReviewVerdictPath(){ ## item name, allowed states (space-separated)
	local vPath vState
	vPath="$( AgentsToolsDecisionsItemPath "$1" )" || { echo "$MDSC_CMD: ⛔ ERROR: no board item ${1%.md} in any board state" >&2 ; return 1 ; }
	vState="$( AgentsReviewStateOfPath "$vPath" )"
	case " $2 " in
		*" $vState "*) printf '%s\n' "$vPath" ; return 0 ;;
	esac
	echo "$MDSC_CMD: ⛔ ERROR: ${1%.md} is in $vState; this verdict applies to an item in: $2" >&2
	return 1
}

## The awk program that appends one titled section to an item body, from the environment.
agentsReviewSectionAwk='{ print ; } END { print "" ; print ENVIRON["MDAT_REVIEW_HEAD"] ; print "" ; print ENVIRON["MDAT_REVIEW_TEXT"] ; }'

## Moves an item to another state with one titled section appended, through the board edit primitive.
AgentsReviewMoveWithSection(){ ## item name, from state, to state, section heading, text, extra header ops...
	local mvItem="${1%.md}.md" mvFrom="$2" mvTo="$3" mvHead="$4" mvText="$5"
	shift 5
	mkdir -p "$MDAT_DATA_ROOT/board/$mvTo" 2> /dev/null || :
	printf '%s' "$agentsReviewSectionAwk" | MDAT_REVIEW_HEAD="$mvHead" MDAT_REVIEW_TEXT="$mvText" AgentsReviewTools --intern-op-board-upsert-move-edit "$mvTo" "$mvItem" \
		--from-state:"$mvFrom" --edit-script-from-stdin:awk "$@" --context "${MDSC_CMD:-review}" --log-verb:updated
}

## The CLI a spawn resolves to: the service its caller named, else the workspace's
## SPAWN_CLI_SERVICE (a spawn never scans PATH). Prints it, or `none`.
AgentsReviewCliResolved(){ ## service named by the caller (may be empty)
	local cliName="${1:-}"
	[ -n "$cliName" ] || cliName="$( AgentsReviewTools --agents-config-option magic-team --select SPAWN_CLI_SERVICE 2> /dev/null )" || cliName=""
	printf '%s' "${cliName:-none}"
}

## What a resume compares beside the CLI: SPAWN_CLI_SERVICE as configured, `+`, a short
## hash of the vendor binary's `--version` output (`-` for a CLI that is no vendor binary).
AgentsReviewCliSetting(){ ## resolved cli
	local setValue setBin="" setHash="-"
	setValue="$( AgentsReviewTools --agents-config-option magic-team --select SPAWN_CLI_SERVICE 2> /dev/null )" || setValue=""
	case "$1" in
		claude-native) setBin=claude ;;
		copilot-native) setBin=copilot ;;
		grok-native) setBin=grok ;;
	esac
	if [ -n "$setBin" ] && command -v "$setBin" > /dev/null 2>&1 ; then
		setHash="$( "$setBin" --version < /dev/null 2> /dev/null | LC_ALL=C cksum | LC_ALL=C awk '{ printf "%08x", $1 ; }' )" || setHash="-"
	fi
	printf '%s+%s' "${setValue:-none}" "${setHash:--}"
}

## WHAT A RESTART OF AN ENDED SESSION IS STARTED WITH, of the two spawn settings a task may
## carry of its own: read from that session's record, never asked for again. The service
## it was started on by name is its `cli-asked`, which the spawn writes only where one was
## named for it; a session started on the configured service has none, and its restart
## follows the configuration as it is now. The workspace that paid for it is its
## `paying-workspace`, always. A record written before either was kept names none.
AgentsReviewRecordCliAsked(){ ## record path -- the service that session was started on by name, or nothing
	local askedCli
	askedCli="$( AgentsToolsSpawnSandboxRecordHeader "$1" cli-asked )"
	case "$askedCli" in ''|none|-) return 0 ;; esac
	printf '%s' "$askedCli"
}
AgentsReviewRecordPaying(){ ## record path -- the name of the workspace that paid for that session, or nothing
	local payingName
	payingName="$( AgentsToolsSpawnSandboxRecordHeader "$1" paying-workspace )"
	case "$payingName" in ''|unknown|-) return 0 ;; esac
	printf '%s' "$payingName"
}
## The CLI and the CLI setting a restart of that session gets now, tab-separated, read the
## way its spawn will read them: in the workspace that paid for the session, on the
## service it was started on by name. A paying workspace this machine no longer knows
## reads as none named: the restart's own spawn is what refuses it, by name.
AgentsReviewRecordCliNow(){ ## record path
	local nowName nowPaid="" nowCli
	nowName="$( AgentsReviewRecordPaying "$1" )"
	if [ -n "$nowName" ] ; then
		type AgentsToolsWorkspaceByName > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.MemberWorkspace.include"
		nowPaid="$( AgentsToolsWorkspaceByName "$nowName" 2> /dev/null )" || nowPaid=""
	fi
	(
		export MDAT_SPAWN_SETTINGS_WORKSPACE="$nowPaid"
		nowCli="$( AgentsReviewCliResolved "$( AgentsReviewRecordCliAsked "$1" )" )"
		printf '%s\t%s' "$nowCli" "$( AgentsReviewCliSetting "$nowCli" )"
	)
}

## Whether a returned item's ended session can be resumed in its own native transcript
## rather than started anew. rc 0 eligible; rc 1 with the reason printed.
AgentsReviewResumeEligible(){ ## record path (may be empty)
	local elRecord="$1" elSpawn elCli elNow elNowBoth elHost thisHost elJsonl elFound=""
	[ -n "$elRecord" ] && [ -f "$elRecord" ] || { printf 'no spawn record of the old session' ; return 1 ; }
	elSpawn="${elRecord##*/}" ; elSpawn="${elSpawn%.md}"
	elCli="$( AgentsToolsSpawnSandboxRecordHeader "$elRecord" cli )"
	case "$elCli" in
		claude|claude-native) ;;
		*) printf 'the old session ran on %s, not claude or claude-native' "${elCli:-an unrecorded cli}" ; return 1 ;;
	esac
	elNowBoth="$( AgentsReviewRecordCliNow "$elRecord" )"
	elNow="${elNowBoth%%$'\t'*}"
	[ "$elNow" = "$elCli" ] || { printf 'the cli is now %s, the old session ran on %s' "$elNow" "$elCli" ; return 1 ; }
	[ "${elNowBoth#*$'\t'}" = "$( AgentsToolsSpawnSandboxRecordHeader "$elRecord" cli-setting )" ] \
		|| { printf 'the cli setting changed since the old session' ; return 1 ; }
	elHost="$( AgentsToolsSpawnSandboxRecordHeader "$elRecord" host )"
	thisHost="$( hostname -s 2> /dev/null )" || thisHost="unknown"
	[ "$elHost" = "$thisHost" ] || { printf 'the old session ran on host %s, not %s' "${elHost:--}" "$thisHost" ; return 1 ; }
	for elJsonl in "${HOME:-/nonexistent}/.claude/projects"/*/"$elSpawn.jsonl" ; do
		[ ! -f "$elJsonl" ] || elFound=yes
	done
	[ -n "$elFound" ] || { printf 'the old session has no native transcript' ; return 1 ; }
	! AgentsReviewChildLive "$elRecord" > /dev/null || { printf 'the old session is still running' ; return 1 ; }
	return 0
}

## A returned item's ended session, started again: the same coworking session, sandbox and
## board item (--dispatch-doc:reuse). Where AgentsReviewResumeEligible holds and the session
## can be joined, its native session is resumed with the corrections (the proxy's
## AgentsToolsSpawnProxyConsoleRun); else a new process, its brief the item with its
## Decisions first. Which path ran is recorded: `restart: resumed` or `restart: new-process (<why>)`.
## A NEW PROCESS ON PURPOSE: with MDAT_REVIEW_RESTART_FRESH set by its caller nothing is
## resumed, whatever could be: the answer `fresh` to the question about a dead run
## (AgentsToolsSessionControlDeathAct, AgentsTools.SessionControlDeath.include).
AgentsReviewRestart(){ ## item name, record path (may be empty), corrections text, who
	local rsItem="${1%.md}.md" rsRecord="$2" rsText="${3:-}" rsWho="${4:-unknown}" rsMember="" rsTracking="" rsSession="" rsThread="" rsPath rsOut rsRc=0
	local rsFrom="" rsWhy="" rsPaying="" rsAsked="" rsParent="" rsStart="" rsReports="" rsInitiator="" rsReplaced=""
	rsPath="$( AgentsToolsDecisionsItemPath "$rsItem" )" || return 1
	## Taken here and taken out of the environment: the run that is started must not inherit it.
	local rsFresh="${MDAT_REVIEW_RESTART_FRESH:-}"
	unset MDAT_REVIEW_RESTART_FRESH
	if [ -n "$rsFresh" ] ; then
		rsWhy="a fresh start was asked for"
	elif rsWhy="$( AgentsReviewResumeEligible "$rsRecord" )" ; then
		rsFrom="${rsRecord##*/}" ; rsFrom="${rsFrom%.md}"
	fi
	## Not a native resume: a universal-harness session resumes from its kept context
	## (AgentsTools.HarnessResume.include), a separate branch end to end. Its reason replaces
	## the native one only for a session that did not run on claude at all.
	local rsContext="" rsContextWhy=""
	if [ -z "$rsFrom" ] && [ -z "$rsFresh" ] ; then
		type AgentsReviewContextResumeEligible > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsTools.HarnessResume.include"
		if rsContextWhy="$( AgentsReviewContextResumeEligible "$rsRecord" )" ; then
			rsContext="$rsContextWhy"
		else
			case "$rsWhy:$rsContextWhy" in
				*'native CLI'*|'no spawn record'*) ;;
				'the old session ran on '*) rsWhy="$rsContextWhy" ;;
			esac
		fi
	fi
	if [ -n "$rsRecord" ] && [ -f "$rsRecord" ] ; then
		rsMember="$( AgentsToolsSpawnSandboxRecordHeader "$rsRecord" owner )"
		rsTracking="$( AgentsToolsSpawnSandboxRecordHeader "$rsRecord" tracking-name )"
		rsSession="$( AgentsToolsSpawnSandboxRecordHeader "$rsRecord" session-id )"
		rsThread="$( AgentsToolsSpawnSandboxRecordHeader "$rsRecord" session-thread )"
		rsPaying="$( AgentsReviewRecordPaying "$rsRecord" )"
		rsAsked="$( AgentsReviewRecordCliAsked "$rsRecord" )"
		rsParent="$( AgentsToolsSpawnSandboxRecordHeader "$rsRecord" parent-session-id )"
		rsStart="$( AgentsToolsSpawnSandboxRecordHeader "$rsRecord" start-context )"
		## Its initiator, the member that brought it in: the one it reports to where it names nobody.
		rsInitiator="$( AgentsToolsSpawnSandboxRecordHeader "$rsRecord" parent-member )"
		## Where it reported to, as its record names it: what it had, and no more.
		rsReports="$( AgentsToolsSpawnSandboxRecordHeader "$rsRecord" "$agentsRunRouteField" )"
	fi
	[ -n "$rsMember" ] || rsMember="$( AgentsToolsDecisionsField "$rsPath" owner )"
	[ -n "$rsMember" ] || { printf 'RETURN: not restarted: no member is recorded for %s\n' "${rsItem%.md}" ; return 1 ; }
	set -- --intern-op-agent-spawn-proxy "$rsMember" --from-board "$rsItem" --board-state running --dispatch-doc:reuse
	[ -z "$rsTracking" ] || set -- "$@" --tracking-name "$rsTracking"
	## Paid from the workspace that paid for the run it replaces, and on the service that run
	## was started on by name: both off its record (above), neither asked for again.
	[ -z "$rsPaying" ] || set -- "$@" --spawn-settings-workspace "$rsPaying"
	[ -z "$rsAsked" ] || set -- "$@" --spawn-cli-service "$rsAsked"
	## Started by the session that started the run it replaces, whoever restarts it: off its record.
	## A run that had no parent session has none when it goes on, whoever restarts it.
	if [ -n "$rsParent" ] ; then
		set -- "$@" --parent-session "$rsParent"
	elif [ -n "$rsRecord" ] && [ -f "$rsRecord" ] ; then
		set -- "$@" --parent-none
	fi
	[ -z "$rsReports" ] || set -- "$@" --reports-to "$rsReports"
	[ -z "$rsInitiator" ] || set -- "$@" --parent-member "$rsInitiator"
	## The run it replaces, by its spawn id: the restart takes over that run's seat in the session (F6.9).
	if [ -n "$rsRecord" ] && [ -f "$rsRecord" ] ; then
		rsReplaced="${rsRecord##*/}" ; rsReplaced="${rsReplaced%.md}"
		set -- "$@" --restarted-from "$rsReplaced"
	fi
	## Joined only where the session has a thread to join by; the proxy refuses a join it cannot make.
	## A resumed session keeps the thread it remembers, so it resumes only when joined there.
	## Joined, it goes on with the participation of the run it replaces, so it keeps its start-context too.
	if [ -n "$rsSession" ] && [ -n "$rsThread" ] && [ "$rsThread" != "-" ] ; then
		rsOut="$( [ -z "$rsFrom" ] || export MDAT_SPAWN_RESUME_FROM="$rsFrom" MDAT_SPAWN_RESUME_TEXT="$rsText" ; [ -z "$rsContext" ] || export MDAT_SPAWN_RESUME_CONTEXT="$rsContext" MDAT_SPAWN_RESUME_TEXT="$rsText" ; AgentsReviewTools "$@" --session-id "$rsSession" ${rsStart:+--start-context "$rsStart"} --context "${MDSC_CMD:-review}" 2>&1 )" || rsRc=$?
		[ "$rsRc" = 0 ] || {
			rsRc=0
			[ -z "$rsFrom" ] || { rsFrom="" ; rsWhy="the session $rsSession could not be joined" ; }
			[ -z "$rsContext" ] || { rsContext="" ; rsWhy="the session $rsSession could not be joined" ; }
			rsOut="$( AgentsReviewTools "$@" --context "${MDSC_CMD:-review}" 2>&1 )" || rsRc=$?
		}
	else
		[ -z "$rsFrom" ] || { rsFrom="" ; rsWhy="the old session has no thread to join" ; }
		[ -z "$rsContext" ] || { rsContext="" ; rsWhy="the old session has no thread to join" ; }
		rsOut="$( AgentsReviewTools "$@" --context "${MDSC_CMD:-review}" 2>&1 )" || rsRc=$?
	fi
	if [ "$rsRc" != 0 ] ; then
		printf 'RETURN: not restarted: the spawn of %s for %s failed (rc %s): %s\n' "$rsMember" "${rsItem%.md}" "$rsRc" "$( printf '%s\n' "$rsOut" | LC_ALL=C grep -m1 'ERROR' )"
		return 1
	fi
	## A resume records its own path once it runs (the proxy); a new process is recorded here.
	[ -n "$rsFrom" ] || [ -n "$rsContext" ] || AgentsReviewRecord "$rsWho" "$rsItem" review "restart: new-process ($rsWhy)" RESTART ""
	printf 'RETURN: restarted %s on %s, session %s, sandbox %s, %s\n' "$rsMember" "${rsItem%.md}" "$( printf '%s\n' "$rsOut" | LC_ALL=C sed -n 's/^SESSION_ID=//p' | head -1 )" "${rsTracking:-new}" \
		"$( if [ -n "$rsFrom" ] ; then printf 'resuming %s' "$rsFrom" ; elif [ -n "$rsContext" ] ; then printf 'resuming its kept context %s' "$rsContext" ; else printf 'new process (%s)' "$rsWhy" ; fi )"
	return 0
}

## Review items addressed to a routine (`review-by: <name>.routine`, or its full
## `<member>.<name>.routine`), one `- <item> [review-by: <value>]` line each, or `(none)`.
AgentsReviewItemsForRoutine(){ ## routine short name, e.g. grooming or advance
	local rfPath rfBy rfCount=0
	AgentsReviewLoad
	for rfPath in "$MDAT_DATA_ROOT"/board/review/*.md ; do
		[ -f "$rfPath" ] || continue
		rfBy="$( AgentsToolsSpawnSandboxRecordHeader "$rfPath" review-by )"
		case "$rfBy" in
			"$1.routine"|*".$1.routine") ;;
			*) continue ;;
		esac
		rfPath="${rfPath##*/}"
		printf -- '- %s [review-by: %s]\n' "${rfPath%.md}" "$rfBy"
		rfCount=$(( rfCount + 1 ))
	done
	[ "$rfCount" -gt 0 ] || printf '(none)\n'
	return 0
}

## Open asks addressed to a routine (`address-to: <name>.routine`, or its full
## `<member>.<name>.routine`) in one workspace's pending-reply store, oldest first by
## `asked-at`: one `<epoch>\t<pending id>\t<kind>\t<address-to>\t<asked-at>` line each,
## nothing when none. An `asked-at` of another shape sorts first, as epoch 0.
AgentsPendingAsksForRoutine(){ ## routine short name, e.g. permission-escalation; workspace (default: this one)
	local paRoot="${2:-${MMDAPP:-}}" paFile paLine paStatus paTo paKind paAt paRows=""
	paRoot="${paRoot%/}"
	[ -n "$paRoot" ] && [ -d "$paRoot/.local/agents/pending" ] || return 0
	for paFile in "$paRoot/.local/agents/pending"/*.md ; do
		[ -f "$paFile" ] || continue
		paStatus="" ; paTo="" ; paKind="" ; paAt=""
		while IFS= read -r paLine ; do
			case "$paLine" in
				'status: '*) paStatus="${paLine#status: }" ;;
				'address-to: '*) paTo="${paLine#address-to: }" ;;
				'kind: '*) paKind="${paLine#kind: }" ;;
				'asked-at: '*) paAt="${paLine#asked-at: }" ;;
				'# '*) break ;;
			esac
		done < "$paFile"
		[ "$paStatus" = "reply-pending" ] || continue
		case "$paTo" in
			"$1.routine"|*".$1.routine") ;;
			*) continue ;;
		esac
		paFile="${paFile##*/}"
		paRows="$paRows${paFile%.md}"$'\t'"${paKind:-question}"$'\t'"$paTo"$'\t'"$paAt"$'\n'
	done
	[ -n "$paRows" ] || return 0
	## The epoch by the one ISO reader (AgentsIsoToEpoch.awk); `asked-at` is `YYYY-MM-DD HH:MM +HHMM`.
	LC_ALL=C paste <( printf '%s' "$paRows" | LC_ALL=C awk -F'\t' '
		$4 ~ /^[0-9][0-9][0-9][0-9]-[01][0-9]-[0-3][0-9] [0-2][0-9]:[0-5][0-9] [-+][0-9][0-9][0-9][0-9]$/ { print substr( $4, 1, 10 ) "T" substr( $4, 12, 5 ) ":00" substr( $4, 18 ) ; next ; }
		{ print "1970-01-01T00:00:00Z" ; }
	' | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/output/AgentsIsoToEpoch.awk" ) <( printf '%s' "$paRows" ) | LC_ALL=C sort -t "$( printf '\t' )" -k1,1n -k2,2
}

## Where a spawn's handback goes when it names session-parent: the parent session's own
## thread, else magic-coordinator's -- the newest live magic-coordinator spawn with a
## thread -- so a handback, and the DISMISSED it leads to, always have a thread.
## The parent's own thread is the one on its spawn record, else the one recorded for the
## coworking session it works in (sessions/<session-id>/session.thread): a parent that
## started alone, or a native client's session, has its thread opened by the first member
## it brings in, and carries none on a record of its own. Never a tracking thread: a
## handback is a member's message (AgentsToolsEventTrackThreadIs).
## Only for a spawn that has a parent. Prints `<channel>:<ts>`; rc 1 for none.
AgentsToolsSpawnParentThread(){ ## parent session id, this spawn's own id
	local ptParent="$1" ptOwn="$2" ptRecord ptThread="" ptBest="" ptBestRecord="" ptTrack="" ptSession="" ptOne
	case "$ptParent" in ''|none|*/*|.|..) return 1 ;; esac
	[ -n "${MMDAPP:-}" ] || return 1
	AgentsReviewLoad
	type AgentsToolsEventTrackThreadIs > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.EventTrackThread.include"
	ptTrack="$( AgentsToolsEventTrackChannel )"
	for ptRecord in "$MMDAPP/.local/agents/spawned"/*/"$ptParent.md" ; do
		[ -f "$ptRecord" ] || continue
		ptThread="$( AgentsToolsSpawnSandboxRecordHeader "$ptRecord" session-thread )"
		AgentsToolsSpawnConversationThreadValid "$ptThread" && ! AgentsToolsEventTrackThreadIs "$ptThread" "$ptTrack" && { printf '%s\n' "$ptThread" ; return 0 ; }
		[ -n "$ptSession" ] || ptSession="$( AgentsToolsSpawnSandboxRecordHeader "$ptRecord" session-id )"
	done
	for ptOne in "$ptSession" "$ptParent" ; do
		case "$ptOne" in ''|*/*|.|..) continue ;; esac
		ptThread=""
		[ ! -s "$MMDAPP/.local/agents/sessions/$ptOne/session.thread" ] || IFS= read -r ptThread < "$MMDAPP/.local/agents/sessions/$ptOne/session.thread" || :
		AgentsToolsSpawnConversationThreadValid "$ptThread" && ! AgentsToolsEventTrackThreadIs "$ptThread" "$ptTrack" && { printf '%s\n' "$ptThread" ; return 0 ; }
	done
	for ptRecord in "$MMDAPP/.local/agents/spawned"/*/*.md ; do
		[ -f "$ptRecord" ] || continue
		case "${ptRecord##*/}" in "$ptOwn.md") continue ;; esac
		[ "$( AgentsToolsSpawnSandboxRecordHeader "$ptRecord" owner )" = magic-coordinator ] || continue
		[ "$( AgentsToolsSpawnSandboxRecordHeader "$ptRecord" status )" = spawn-started ] || continue
		ptThread="$( AgentsToolsSpawnSandboxRecordHeader "$ptRecord" session-thread )"
		AgentsToolsSpawnConversationThreadValid "$ptThread" || continue
		! AgentsToolsEventTrackThreadIs "$ptThread" "$ptTrack" || continue
		if [ -z "$ptBestRecord" ] || [ "$ptRecord" -nt "$ptBestRecord" ] ; then
			ptBest="$ptThread" ; ptBestRecord="$ptRecord"
		fi
	done
	[ -n "$ptBest" ] || return 1
	printf '%s\n' "$ptBest"
	return 0
}

## For a Wait of a session whose own item waits in review: `expired` once
## REVIEW_WAIT_LIMIT seconds have passed since it entered review, else the seconds left.
## rc 1, nothing printed, when the session's item is not in review.
## THE LIMIT DOES NOT RUN WHILE A QUESTION ABOUT THE DEATH OF A RUN STANDS OPEN in the session
## this run works in, whichever run of it died and whoever was asked
## (AgentsToolsSessionControlDeathQuestion, AgentsTools.SessionControlDeath.include): rc 1 then,
## nothing printed, so the Wait is not bounded by the limit and nobody is dismissed by it. A
## run that handed back and waits for its review is alive and waiting, also while the one who
## would review it is the dead one. Once the question is closed the limit runs again, counted
## from the moment it was closed where that is later than the moment the item entered review.
AgentsReviewWaitLeft(){ ## spawn id
	local leftItem leftPath leftSince leftLimit leftNow leftRecord leftSession="" leftHold=""
	AgentsReviewLoad
	leftItem="$( AgentsReviewItemOfSession "$1" )" || return 1
	leftPath="$( AgentsToolsDecisionsItemPath "$leftItem" )" || return 1
	[ "$( AgentsReviewStateOfPath "$leftPath" )" = review ] || return 1
	[ "$( AgentsToolsDecisionsField "$leftPath" spawn-id )" = "$1" ] || return 1
	leftSince="$( AgentsToolsDecisionsField "$leftPath" review-since-epoch )"
	case "$leftSince" in ''|*[!0123456789]*) return 1 ;; esac
	for leftRecord in "${MMDAPP:-/nonexistent}/.local/agents/spawned"/*/"$1.md" ; do
		[ ! -f "$leftRecord" ] || leftSession="$( AgentsToolsSpawnSandboxRecordHeader "$leftRecord" session-id )"
	done
	case "$leftSession" in ''|-|*/*|.|..) leftSession="" ;; esac
	if [ -n "$leftSession" ] && [ -f "$MMDAPP/.local/agents/sessions/$leftSession/control/dead" ] ; then
		type AgentsToolsSessionControlDeathQuestion > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionControlDeath.include" 2> /dev/null || :
		leftHold="$( AgentsToolsSessionControlDeathQuestion "$leftSession" 2> /dev/null )" || leftHold=""
		case "$leftHold" in
			open) return 1 ;;
			''|*[!0123456789]*) ;;
			*) [ "$leftHold" -le "$leftSince" ] || leftSince="$leftHold" ;;
		esac
	fi
	leftLimit="$( AgentsReviewWaitLimit )"
	leftNow="$( date +%s )"
	if [ $(( leftNow - leftSince )) -ge "$leftLimit" ] ; then
		printf 'expired\n'
	else
		printf '%s\n' "$(( leftSince + leftLimit - leftNow ))"
	fi
	return 0
}

## The review limit reached: the ending recorded once per review entry (the item stays in
## review, and a return can restart the same session). Prints the Wait result the session ends on.
AgentsReviewWaitExpire(){ ## who, spawn id
	local exItem exPath exSince exDir exMark=""
	exItem="$( AgentsReviewItemOfSession "$2" )" || return 1
	exPath="$( AgentsToolsDecisionsItemPath "$exItem" )" || return 1
	exSince="$( AgentsToolsDecisionsField "$exPath" review-since-epoch )"
	exDir="$( AgentsTranscriptSessionDir "$2" 2> /dev/null )" || exDir=""
	[ -z "$exDir" ] || [ ! -f "$exDir/review-expired" ] || IFS= read -r exMark < "$exDir/review-expired" || :
	if [ "$exMark" != "$exSince" ] ; then
		AgentsReviewRecord "$1" "$exItem" dismissed "review-wait-expired: no verdict within $( AgentsReviewWaitLimit )s; the item stays in review" ENDING "$2"
		[ -z "$exDir" ] || { mkdir -p "$exDir" 2> /dev/null && printf '%s\n' "$exSince" > "$exDir/review-expired" 2> /dev/null ; } || :
	fi
	printf 'WAIT-RESULT: DISMISSED\nWAIT-DISMISSED-BY: tooling (review-wait-expired: no verdict on %s within %ss; it stays in review)\n' "${exItem%.md}" "$( AgentsReviewWaitLimit )"
	return 0
}

## Every live spawn dismissed with reason shutdown: DISMISSED into its session thread, and the
## ending recorded on the item it works. One SHUTDOWN line per spawn, then a count.
AgentsReviewShutdown(){ ## sending member
	local sdBy="$1" sdRecord sdSpawn sdItem sdWhy sdSent=0 sdSeen=0
	AgentsReviewLoad
	for sdRecord in "$MMDAPP/.local/agents/spawned"/*/*.md ; do
		[ -f "$sdRecord" ] || continue
		sdWhy="$( AgentsReviewChildLive "$sdRecord" )" || continue
		sdSpawn="${sdRecord##*/}" ; sdSpawn="${sdSpawn%.md}"
		sdSeen=$(( sdSeen + 1 ))
		sdWhy="$( AgentsReviewSendToChild "$sdBy" "$sdRecord" DISMISSED )" && sdSent=$(( sdSent + 1 ))
		printf 'SHUTDOWN: spawn %s: %s\n' "$sdSpawn" "$sdWhy"
		sdItem="$( AgentsReviewItemOfSession "$sdSpawn" )" || continue
		AgentsReviewRecord "$sdBy" "$sdItem" dismissed "shutdown: $sdWhy" ENDING "$sdSpawn"
	done
	printf 'SHUTDOWN: %s of %s live spawn(s) dismissed\n' "$sdSent" "$sdSeen"
	return 0
}

## ---- the review prompt (sh-lib/templates/review-prompt.post.format.md) ----
## A handback whose reviewer is a person asks him: one post, as the team bot, answered by a
## click or a reply. Its pending-reply record is of kind review, so its answer is read and
## applied where every typed answer is (AgentsTools.MemberEscalation.include), and given
## here, through the same operations a reviewer runs.

## One part of the review prompt filled from its own template, by the filler the ask posts
## use: the template and the answer form are the ones the table of the asks names for a
## review (AgentsTools.AskPost.include). The slots travel in the caller's environment, as
## ASKP_F_<slot>.
AgentsReviewPromptFill(){ ## want (post|reactions|block), block `<Section>/<heading>` (with block)
	type AgentsToolsAskKindRow > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.AskPost.include"
	AgentsToolsAskKindRow review || return 3
	ASKP_BLOCK="${2:-}" AgentsToolsAskPostFill "$1" "$agentsAskRowTemplate" "$agentsAskRowForm"
}

## The review prompt of one handback: posted to the human-owner as the team bot, from its
## template -- who handed back, the task in words (AgentsTools.TaskText.include), the outcome
## line of the handback, the session and its thread, how to answer. Only where the item's
## `review-by` names him: a reviewer that is a member, a session or a routine gets none. Its
## record is the handing-back member's own, so the verdict, or a comment, comes back on that
## session's Wait, which the prompt joins as a wait item; its click answers are placed under
## it. Never fails the handback: prints one REVIEW-PROMPT line, or nothing where none is due.
AgentsReviewPromptPost(){ ## who handed back, item file name, its spawn id, outcome line (may be empty)
	local rpWho="$1" rpItem="${2%.md}" rpSpawn="${3:-}" rpOutcome="${4:-}" rpPath rpRecord="" rpCandidate rpTask rpName rpNames="" rpTaskText rpCow rpThread rpSessionText=""
	local rpBody rpOut rpChannel rpTs rpAddressees rpAsking rpId
	rpPath="$( AgentsToolsDecisionsItemPath "$rpItem" )" || return 0
	## Who reviews it: its review-by, else where its run reports to (AgentsToolsItemReviewer). A
	## person at a console (`user-<account>`) is asked as the human-owner is, for now.
	case "$( AgentsToolsItemReviewer "$rpPath" )" in
		human-owner|user-?*) ;;
		*) return 0 ;;
	esac
	type AgentsToolsAskPostReact > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.AskPost.include"
	type AgentsToolsTaskText > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.TaskText.include"
	rpTask="$( AgentsToolsTaskText "$rpPath" )"
	for rpName in "$( AgentsToolsTaskTextValue "$rpTask" item )" "$( AgentsToolsTaskTextValue "$rpTask" dispatch )" ; do
		[ -z "$rpName" ] || rpNames="$rpNames${rpNames:+ · }\`$rpName\`"
	done
	rpTaskText="$( ASKP_F_task_title="$( AgentsToolsTaskTextValue "$rpTask" title )" ASKP_F_task_names="$rpNames" \
		ASKP_F_task_text="$( AgentsToolsTaskTextValue "$rpTask" text )" AgentsReviewPromptFill block "Lines/task" 2> /dev/null )" || rpTaskText=""
	## The session that handed back: its short id, its thread, and what its spawn said it is for.
	for rpCandidate in "$MMDAPP/.local/agents/spawned"/*/"${rpSpawn:-none}.md" ; do
		[ ! -f "$rpCandidate" ] || { rpRecord="$rpCandidate" ; break ; }
	done
	rpCow="$( [ -z "$rpRecord" ] || AgentsToolsSpawnSandboxRecordHeader "$rpRecord" session-id )"
	if [ -n "$rpCow" ] ; then
		rpThread="$( AgentsToolsSpawnSandboxRecordHeader "$rpRecord" session-thread )"
		if [ -z "$rpThread" ] || [ "$rpThread" = "-" ] ; then
			rpThread=""
			[ ! -f "${rpRecord%/*}/session.thread" ] || IFS= read -r rpThread < "${rpRecord%/*}/session.thread" || :
		fi
		type AgentsToolsPermissionSetThreadShown > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.InternOpPermission.include"
		rpSessionText="$( ASKP_F_session_id="${rpCow:0:8}" ASKP_F_session_thread="$( AgentsToolsPermissionSetThreadShown "$rpWho" "$rpThread" )" \
			ASKP_F_session_description="$( AgentsToolsTaskTextLine "$( AgentsToolsSpawnSandboxRecordHeader "$rpRecord" description )" )" AgentsReviewPromptFill block "Lines/session" 2> /dev/null )" || rpSessionText=""
	fi
	rpOutcome="$( AgentsToolsTaskTextKept "$rpOutcome" )"
	rpBody="$( ASKP_F_member="$rpWho" ASKP_F_task="$rpTaskText" ASKP_F_outcome="$rpOutcome" ASKP_F_session="$rpSessionText" AgentsReviewPromptFill post 2> /dev/null )" || rpBody=""
	if [ -z "$rpBody" ] ; then
		printf 'REVIEW-PROMPT: not asked: the prompt for %s could not be filled from its template\n' "$rpItem"
		return 0
	fi
	rpOut="$( printf '%s\n' "$rpBody" | AgentsReviewTools --intern-op-comms-slack-send-message "$rpWho" human-owner --identity-bot --address-to human-owner --from-stdin 2>&1 )" || {
		printf 'REVIEW-PROMPT: not asked: the prompt for %s could not be posted: %s\n' "$rpItem" "$( printf '%s\n' "$rpOut" | LC_ALL=C grep -m1 'ERROR' )"
		return 0
	}
	rpChannel="$( printf '%s\n' "$rpOut" | LC_ALL=C sed -n 's/^SENT_MESSAGE_CHANNEL=//p' | head -1 )"
	rpTs="$( printf '%s\n' "$rpOut" | LC_ALL=C sed -n 's/^SENT_MESSAGE_TS=//p' | head -1 )"
	rpAddressees="$( printf '%s\n' "$rpOut" | LC_ALL=C sed -n 's/^SENT_MESSAGE_ADDRESSEES=//p' | head -1 )"
	rpAsking="$( printf '%s\n' "$rpOut" | LC_ALL=C grep '^{' | LC_ALL=C awk -v path=message.user -v optional=1 -v dialect=slack -f "$agentsReviewLib/harness/AgentsHarnessJsonField.awk" 2> /dev/null | LC_ALL=C sort -u | LC_ALL=C tr '\n' ' ' )" || rpAsking=""
	if [ -z "$rpChannel" ] || [ -z "$rpTs" ] || [ -z "$rpAddressees" ] ; then
		printf 'REVIEW-PROMPT: posted for %s, but its thread or addressee could not be named, so its answer cannot be read\n' "$rpItem"
		return 0
	fi
	## What the post was filled with is kept beside its record, so it is filled again once it takes no answer.
	rpId="$( printf '%s\n' "$rpBody" | AgentsReviewTools --intern-op-pending-reply-open "$rpWho" --to "$rpChannel" ${rpSpawn:+--session-id "$rpSpawn"} \
		--kind review --address-to human-owner --blocked-on "reply from human-owner" --channel "$rpChannel" --question-ts "$rpTs" --thread-ts "$rpTs" \
		--addressees "$rpAddressees" ${rpAsking:+--asking-accounts " $rpAsking"} --item "$rpItem" --ask-identity bot \
		--fields "$( AgentsToolsAskPostFieldsPack member "$rpWho" task "$rpTaskText" outcome "$rpOutcome" session "$rpSessionText" )" --context "${MDSC_CMD:-review}" 2> /dev/null )" || rpId=""
	if [ -z "$rpId" ] ; then
		printf 'REVIEW-PROMPT: posted for %s at %s:%s but not recorded, so its answer cannot be read\n' "$rpItem" "$rpChannel" "$rpTs"
		return 0
	fi
	## Its click answers, the names its template gives (`# Reactions`), placed as the identity
	## that posted it. They are never an answer themselves: only his own click is.
	AgentsToolsAskPostReact "$rpWho" "$rpChannel:$rpTs" bot add $( AgentsReviewPromptFill reactions 2> /dev/null )
	## The prompt joins the Wait of the session that handed back, where its answer arrives.
	[ -z "$rpSpawn" ] || AgentsReviewTools --intern-op-wait-for-input "$rpWho" --wait-add --wait-session-id "$rpSpawn" --wait-source "ask:$rpId" > /dev/null 2>&1 \
		|| echo "⚠️ WARNING: ${MDSC_CMD:-review}: the review prompt $rpId is asked, but it could not join the Wait of session $rpSpawn" >&2
	printf 'REVIEW-PROMPT: asked human-owner %s\n' "$rpId"
	printf 'WAIT-ID: ask:%s\n' "$rpId"
	return 0
}

## The text of a review verdict, from the thread verdict it was read with
## (AgentsToolsEscalationThreadVerdict): what follows the word in its reply, then each
## clarification on it -- the rest of that reply and every later one; for a click, every
## reply of the person in the thread. One line, its parts joined by " / ", as the lines of a
## message are where a clarification is kept (AgentsPendingReplyClarifications.awk).
AgentsReviewPromptText(){ ## thread verdict output
	printf '%s\n' "$1" | LC_ALL=C awk -F'\t' '
		NR == 1 { restAt = index( $1, " -- " ) ; if ( restAt > 0 ) { textAll = substr( $1, restAt + 4 ) ; } next ; }
		$1 == "CLARIFY" { textOne = $0 ; sub( /^CLARIFY\t[^\t]*\t[^\t]*\t/, "", textOne ) ; textAll = textAll ( textAll == "" ? "" : " / " ) textOne ; }
		END { if ( textAll != "" ) { print textAll ; } }'
}

## One open review prompt closed with no verdict of its own: its record withdrawn, with who
## and why; its thread told (`# Notes` of the template); its post marked, its click answers
## taken off and its How to answer part edited away (AgentsToolsAskPostClose). Nothing goes
## on the item's Decisions: what settled the review is there already. Each step after the
## close is best effort.
AgentsReviewPromptClose(){ ## record file, pending id, who closes it, why
	local pcFile="$1" pcId="$2" pcWho="$3" pcWhy="$4" pcOwner pcChannel pcTs pcNote
	type AgentsToolsAskPostClose > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.AskPost.include"
	AgentsReviewTools --intern-op-pending-reply-close "$pcId" --if-open --status withdrawn --withdrawn-by "$pcWho" --withdraw-reason "$pcWhy" \
		--no-decision --context "${MDSC_CMD:-review}" > /dev/null 2>&1 || return 0
	pcOwner="$( AgentsToolsDecisionsField "$pcFile" owner )"
	pcChannel="$( AgentsToolsDecisionsField "$pcFile" channel )"
	pcTs="$( AgentsToolsDecisionsField "$pcFile" question-ts )"
	[ -n "$pcOwner" ] && [ -n "$pcChannel" ] && [ -n "$pcTs" ] || return 0
	pcNote="$( ASKP_F_reason="$pcWhy" AgentsReviewPromptFill block "Notes/settled" 2> /dev/null )" || pcNote=""
	## It carries the addressee of the prompt it follows, as the prompt named it.
	local pcArgs=( "$pcOwner" "$pcChannel:$pcTs" --identity-bot --from-stdin ) pcTo
	pcTo="$( AgentsToolsDecisionsField "$pcFile" address-to )"
	[ -z "$pcTo" ] || pcArgs=( "${pcArgs[@]}" --address-to "$pcTo" )
	[ -z "$pcNote" ] || printf '%s\n' "$pcNote" | AgentsReviewTools --intern-op-comms-slack-send-message "${pcArgs[@]}" > /dev/null 2>&1 \
		|| echo "⚠️ WARNING: ${MDSC_CMD:-review}: the review prompt $pcId is closed, but its thread was not told" >&2
	AgentsToolsAskPostClose "$pcFile" "$pcTs" cancelled edit
	return 0
}

## The open review prompts of an item, closed once its review is settled another way: a
## verdict a reviewer typed, or the item archived or trashed. None then goes on asking, and
## none is reminded of. The prompt a verdict is being given from is not one of them
## (MDAT_REVIEW_PROMPT_GIVING, set by AgentsReviewPromptVerdict). Never fails its caller.
AgentsReviewPromptSettle(){ ## who settled it, item file name, what was done, in a word
	local psWho="$1" psItem="${2%.md}" psWord="$3" psFile psId
	[ -d "${MMDAPP:-/nonexistent}/.local/agents/pending" ] || return 0
	while IFS= read -r psFile ; do
		[ -f "$psFile" ] || continue
		psId="${psFile##*/}" ; psId="${psId%.md}"
		[ "$psId" != "${MDAT_REVIEW_PROMPT_GIVING:-}" ] || continue
		[ "$( AgentsToolsDecisionsField "$psFile" kind )" = "review" ] && [ "$( AgentsToolsDecisionsField "$psFile" status )" = "reply-pending" ] || continue
		AgentsReviewPromptClose "$psFile" "$psId" "$psWho" "$psItem was $psWord by $psWho" < /dev/null
	done < <( LC_ALL=C grep -r -l -x -F --include='*.md' -- "item: $psItem" "$MMDAPP/.local/agents/pending" 2> /dev/null )
	return 0
}

## A review prompt's verdict, given through the review flow as the reviewer's own typed
## operation gives it, signed human-owner: who answered is the person the prompt was
## addressed to. rc 0: given. rc 1, with the reason printed as one line (`# Returned` of the
## template): not given -- a return or a reject with no text yet, one the review flow did not
## take, or a review that is no longer open, whose prompt is then closed.
AgentsReviewPromptVerdict(){ ## record file, pending id, verdict (accept|return|reject), its text (may be empty), answered by (his account, or his name)
	local pvFile="$1" pvId="$2" pvVerdict="$3" pvText="${4:-}" pvBy="$5" pvItem pvPath pvState="" pvOut pvRc=0 pvWhy
	type AgentsToolsPermissionIsHumanOwner > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.PermissionHolds.include"
	pvItem="$( AgentsToolsDecisionsField "$pvFile" item )"
	if ! AgentsToolsPermissionIsHumanOwner "$pvBy" ; then
		ASKP_F_by="$pvBy" ASKP_F_verdict="$pvVerdict" ASKP_F_item="$pvItem" ASKP_F_reason="only the human-owner gives a verdict by this prompt" AgentsReviewPromptFill block "Returned/not-applied" || :
		return 1
	fi
	pvBy="human-owner"
	pvPath="$( AgentsToolsDecisionsItemPath "$pvItem" )" && pvState="$( AgentsReviewStateOfPath "$pvPath" )"
	if [ "$pvState" != "review" ] ; then
		pvWhy="the item is in ${pvState:-no board state}"
		AgentsReviewPromptClose "$pvFile" "$pvId" tooling "$pvItem is no longer in review"
		ASKP_F_by="$pvBy" ASKP_F_verdict="$pvVerdict" ASKP_F_item="$pvItem" ASKP_F_reason="$pvWhy" AgentsReviewPromptFill block "Returned/closed" || :
		return 1
	fi
	case "$pvVerdict" in
		accept) ;;
		return|reject)
			if [ -z "$pvText" ] ; then
				ASKP_F_by="$pvBy" ASKP_F_verdict="$pvVerdict" ASKP_F_item="$pvItem" AgentsReviewPromptFill block "Returned/no-text" || :
				return 1
			fi
		;;
		*)
			ASKP_F_by="$pvBy" ASKP_F_verdict="$pvVerdict" ASKP_F_item="$pvItem" ASKP_F_reason="it is no verdict of a review" AgentsReviewPromptFill block "Returned/not-applied" || :
			return 1
		;;
	esac
	pvOut="$( printf '%s' "$pvText" | MDAT_REVIEW_PROMPT_GIVING="$pvId" AgentsReviewTools "--intern-op-review-$pvVerdict" "$pvBy" "$pvItem" ${pvText:+--from-stdin} --context "${MDSC_CMD:-review}" 2>&1 )" || pvRc=$?
	[ "$pvRc" != 0 ] || return 0
	pvWhy="$( printf '%s\n' "$pvOut" | LC_ALL=C grep -m1 'ERROR' | LC_ALL=C sed 's/^.*ERROR: //' )" || pvWhy=""
	[ -n "$pvWhy" ] || pvWhy="$( printf '%s\n' "$pvOut" | LC_ALL=C grep . | tail -1 )" || pvWhy=""
	## A verdict the flow gave and could not finish -- a return it could not deliver -- has
	## moved the item: it is given, and what was left undone is said.
	if pvPath="$( AgentsToolsDecisionsItemPath "$pvItem" )" && [ "$( AgentsReviewStateOfPath "$pvPath" )" != "review" ] ; then
		echo "⚠️ WARNING: ${MDSC_CMD:-review}: the $pvVerdict of $pvItem by $pvBy is given, but not finished: ${pvWhy:-the review operation failed (rc $pvRc)}" >&2
		return 0
	fi
	ASKP_F_by="$pvBy" ASKP_F_verdict="$pvVerdict" ASKP_F_item="$pvItem" ASKP_F_reason="${pvWhy:-the review operation failed (rc $pvRc)}" AgentsReviewPromptFill block "Returned/not-applied" || :
	return 1
}

## The one entry of the review ops (AgentsTools.InternOpReview.include), by verb.
AgentsReviewOp(){ ## verb, who, item, new item, text, reason, session id, dismiss (yes|no)
	local opVerb="$1" opWho="$2" opItem="${3%.md}" opNew="${4%.md}" opText="$5" opReason="$6" opSession="$7" opDismiss="${8:-yes}"
	local opPath opState opRecord opWhy opOut
	AgentsReviewLoad
	[ -z "$opItem" ] || opItem="$opItem.md"
	case "$opVerb" in
		handback)
			opSession="${opSession:-${MDAT_SPAWN_SESSION_ID:-}}"
			[ -n "$opSession" ] || { echo "$MDSC_CMD: ⛔ ERROR: --session-id <spawn-id> is required, and this process has none" >&2 ; return 1 ; }
			opItem="$( AgentsReviewItemOfSession "$opSession" )" || { printf 'REVIEW: nothing to move: session %s works no board item\n' "$opSession" ; return 0 ; }
			## An item nobody reviews (its review-by, else where its run reports to, is `none`) does not
			## enter review on a handback: that handback is its run's report.
			if opPath="$( AgentsToolsDecisionsItemPath "$opItem" )" && [ "$( AgentsToolsItemReviewer "$opPath" )" = none ] ; then
				printf 'REVIEW: nothing to move: nobody reviews %s, so the handback is its report\n' "${opItem%.md}"
				return 0
			fi
			opOut="$( AgentsReviewToReview "$opWho" "$opItem" handback handback "$opSession" "${opText:-}" )" || :
			[ -z "$opOut" ] || printf '%s\n' "$opOut"
			## Moved into review now: a reviewer that is a person is asked, once, by a review prompt.
			case "$opOut" in *' running->review '*) AgentsReviewPromptPost "$opWho" "$opItem" "$opSession" "${opText:-}" ;; esac
			return 0
		;;
		request)
			[ -n "$opReason" ] || { echo "$MDSC_CMD: ⛔ ERROR: --reason <text> is required" >&2 ; return 1 ; }
			AgentsReviewToReview "$opWho" "$opItem" review review-requested "" "by $opWho: $opReason" || return 1
			return 0
		;;
		accept)
			opPath="$( AgentsReviewVerdictPath "$opItem" "review running" )" || return 1
			opState="$( AgentsReviewStateOfPath "$opPath" )"
			## In this context, never the reviewer's workspace: the item is on the spawner's board.
			type AgentsToolsBoardToProcessed > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/magic/AgentsTools.MagicBoard.include"
			opOut="$( AgentsToolsBoardToProcessed "$opWho" "$opItem" --from-state:"$opState" 2>&1 )" || {
				printf '%s\n' "$opOut" >&2
				echo "$MDSC_CMD: ⛔ ERROR: the move of ${opItem%.md} to processed failed, so nothing was accepted" >&2
				return 1
			}
			printf '%s\n' "$opOut" | LC_ALL=C grep -v '^# ' || :
			opWhy="$( printf '%s\n' "$opOut" | LC_ALL=C sed -n 's/^ACCEPT-DISMISS: //p' | head -1 )"
			AgentsReviewRecord "$opWho" "$opItem" verdict "accepted${opText:+: $opText}${opWhy:+ (child: $opWhy)}" VERDICT ""
			AgentsReviewPromptSettle "$opWho" "$opItem" accepted
			printf 'VERDICT: %s accepted -> processed\n' "${opItem%.md}"
			return 0
		;;
		return)
			[ -n "$opText" ] || { echo "$MDSC_CMD: ⛔ ERROR: the corrections are required, with --message <text> or --from-stdin" >&2 ; return 1 ; }
			opPath="$( AgentsReviewVerdictPath "$opItem" "review" )" || return 1
			AgentsReviewMoveWithSection "$opItem" review running "## Review: returned ($( date -u +%Y-%m-%dT%H:%MZ ), $opWho)" "$opText" \
				--header:remove:review-since-epoch --header:remove:review-reason > /dev/null 2>&1 || {
				echo "$MDSC_CMD: ⛔ ERROR: the move of ${opItem%.md} back to running failed, so nothing was returned" >&2
				return 1
			}
			AgentsReviewRecord "$opWho" "$opItem" verdict "returned: $opText" VERDICT ""
			AgentsReviewPromptSettle "$opWho" "$opItem" returned
			opPath="$( AgentsToolsDecisionsItemPath "$opItem" )" || return 1
			opRecord="$( AgentsReviewChildRecord "$opPath" )" || opRecord=""
			if [ -n "$opRecord" ] && AgentsReviewChildLive "$opRecord" > /dev/null ; then
				opWhy="$( AgentsReviewSendToChild "$opWho" "$opRecord" "$( printf 'RETURNED for corrections on %s. Continue the same task, then hand back again.\n\n%s' "${opItem%.md}" "$opText" )" )" || {
					printf 'RETURN: not delivered: %s\n' "${opWhy#not sent: }"
					return 1
				}
				printf 'RETURN: delivered to %s in %s\n' "$( printf '%s' "$opWhy" | cut -d' ' -f2 )" "$( printf '%s' "$opWhy" | cut -d' ' -f3 )"
				return 0
			fi
			AgentsReviewRestart "$opItem" "$opRecord" "$opText" "$opWho" || return 1
			return 0
		;;
		reject)
			[ -n "$opText" ] || { echo "$MDSC_CMD: ⛔ ERROR: the corrections are required, with --message <text> or --from-stdin" >&2 ; return 1 ; }
			opPath="$( AgentsReviewVerdictPath "$opItem" "review running" )" || return 1
			opState="$( AgentsReviewStateOfPath "$opPath" )"
			AgentsReviewMoveWithSection "$opItem" "$opState" pending "## Review: rejected ($( date -u +%Y-%m-%dT%H:%MZ ), $opWho)" "$opText" \
				--header:upsert:status:review-rejected --header:remove:review-since-epoch --header:remove:review-reason > /dev/null 2>&1 || {
				echo "$MDSC_CMD: ⛔ ERROR: the move of ${opItem%.md} to pending failed, so nothing was rejected" >&2
				return 1
			}
			opWhy="$( AgentsToolsBoardAcceptDismissChild "$opWho" "$MDAT_DATA_ROOT/board/pending/$opItem" )"
			opWhy="${opWhy#ACCEPT-DISMISS: }"
			printf 'REJECT-DISMISS: %s\n' "$opWhy"
			AgentsReviewRecord "$opWho" "$opItem" verdict "rejected: $opText (child: $opWhy)" VERDICT ""
			AgentsReviewPromptSettle "$opWho" "$opItem" rejected
			printf 'VERDICT: %s rejected -> pending\n' "${opItem%.md}"
			return 0
		;;
		follow-up)
			[ -n "$opNew" ] || { echo "$MDSC_CMD: ⛔ ERROR: <new-item-name> is required" >&2 ; return 1 ; }
			[ -n "$opText" ] || { echo "$MDSC_CMD: ⛔ ERROR: the new item body is required, on stdin with --from-stdin" >&2 ; return 1 ; }
			AgentsToolsDecisionsItemPath "$opItem" > /dev/null || { echo "$MDSC_CMD: ⛔ ERROR: no board item ${opItem%.md} in any board state" >&2 ; return 1 ; }
			! AgentsToolsDecisionsItemPath "$opNew" > /dev/null || { echo "$MDSC_CMD: ⛔ ERROR: a board item ${opNew} already exists" >&2 ; return 1 ; }
			mkdir -p "$MDAT_DATA_ROOT/board/pending" 2> /dev/null || :
			printf '%s\n' "$opText" | AgentsReviewTools --intern-op-board-upsert-move-edit pending "$opNew.md" --create --acting-member:"$opWho" \
				--upsert-from-stdin --header:upsert:follows-up:"${opItem%.md}" --context "${MDSC_CMD:-review}" --log-verb:created > /dev/null || {
				echo "$MDSC_CMD: ⛔ ERROR: the follow-up item $opNew could not be created" >&2
				return 1
			}
			AgentsReviewRecord "$opWho" "$opItem" verdict "follow-up: $opNew" VERDICT ""
			printf 'FOLLOW-UP: %s created in pending, follows-up %s\n' "$opNew" "${opItem%.md}"
			return 0
		;;
		end)
			[ -n "$opReason" ] || { echo "$MDSC_CMD: ⛔ ERROR: --reason <reason> is required" >&2 ; return 1 ; }
			opPath="$( AgentsToolsDecisionsItemPath "$opItem" )" || { echo "$MDSC_CMD: ⛔ ERROR: no board item ${opItem%.md} in any board state" >&2 ; return 1 ; }
			AgentsReviewEndChild "$opWho" "$opPath" "$opReason" "$opDismiss"
			return 0
		;;
		shutdown)
			AgentsReviewShutdown "$opWho"
			return 0
		;;
	esac
	echo "$MDSC_CMD: ⛔ ERROR: invalid review operation: $opVerb" >&2
	return 1
}

## Its dependencies, loaded once with it, so no function finds one missing in this shell.
AgentsReviewLoad
