#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.BoardPendingRepliesEntries.include -- the board's part of the pending-replies registry: one entry line a board
## item that may be waiting on a reply. Sourced, never run. Functions only. The registry is built in
## questions/AgentsTools.RegistryPendingRepliesRows.include.
##

## THE ITEMS COME FROM A KEPT LIST, never from a walk of `board/running` and `board/blocked`. The list
## (`.local/agents/board/waiting-replies.index`, AgentsTools.BoardWaitingRepliesIndex.include) is written by the one board
## write path that sets or clears an item's `blocked-on`, so a rebuild of this registry opens its size in items that wait on
## a reply, never the size of a board state. An item the list names that has since lost its header is dropped by the rows awk,
## as it always was. No data root: none.
AgentsToolsBoardPendingRepliesEntries(){
	type AgentsToolsRegistryRowsEntry > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.Registries.include"
	type AgentsToolsBoardWaitingRepliesIndexInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.BoardWaitingRepliesIndex.include"
	local waitFile waitLine waitState waitItem
	[ -n "${MDAT_DATA_ROOT:-}" ] || return 0
	AgentsToolsBoardWaitingRepliesIndexInto waitFile "${MMDAPP:-}" || return 0
	[ -f "$waitFile" ] || return 0
	while IFS= read -r waitLine ; do
		waitState="${waitLine%%/*}" ; waitItem="${waitLine#*/}"
		case "$waitState" in running|blocked) ;; *) continue ;; esac
		case "$waitItem" in ''|.|..|*/*) continue ;; esac
		[ -f "$MDAT_DATA_ROOT/board/$waitState/$waitItem" ] || continue
		AgentsToolsRegistryRowsEntry B "$MDAT_DATA_ROOT/board/$waitState/$waitItem"
	done < "$waitFile"
	return 0
}
