#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.ItemReviewer.include -- who reviews a board item. Split out of AgentsTools.SpawnSandbox.include by concern, its functions unchanged. Sourced, never
## run; it relies on what AgentsTools.SpawnSandbox.include sources for it.
##
## Who reviews an item: its `review-by`, where it names one (`none`: nobody), else whoever the
## run of its spawn-id reports to (AgentsToolsRunRoute), `none` included. Empty for an item with
## no review-by and no run of its own here, which magic-coordinator reviews, as it always did.
AgentsToolsItemReviewer(){ ## item path
	local reviewerBy reviewerSpawn reviewerRecord reviewerRoute
	type AgentsToolsAssertBareName > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.BareName.include"
	type AgentsToolsFrontmatterKey > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/common/AgentsTools.FrontmatterKey.include"
	reviewerBy="$( AgentsToolsFrontmatterKey "$1" review-by )"
	[ -z "$reviewerBy" ] || { printf '%s\n' "$reviewerBy" ; return 0 ; }
	reviewerSpawn="$( AgentsToolsFrontmatterKey "$1" spawn-id )"
	AgentsToolsAssertBareName "$reviewerSpawn" "the item's spawn-id" AgentsToolsItemReviewer 2> /dev/null || return 0
	type AgentsSessionRunRecordInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.include"
	AgentsSessionRunRecordInto reviewerRecord "$reviewerSpawn" || return 0
	type AgentsToolsRunRoute > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.RunRoute.include"
	## No named reviewer, so the next rung's, never the person's: empty is magic-coordinator's.
	reviewerRoute="$( AgentsToolsRunRoute "$reviewerRecord" )"
	case "$reviewerRoute" in human-owner|user-*) reviewerRoute="" ;; esac
	printf '%s\n' "$reviewerRoute"
	return 0
}

## THE RUNG BELOW THE DUTY (S6.28): the reviewer an item reads who can still take its verdict, as
## `<session>:<member>`, else rc 1 and the item is the duty's. Open: such a reviewer with a live run there.
## The asking run's own session reads rc 1, whether the run carries that session's id or was joined into
## it and carries its own: its record names the session it belongs to. A bare member, a routine and the
## person read rc 1 too: no record says which of a member's runs works an item, a routine takes its own
## next run, and the person's item is the last resort's, as it always was.
AgentsToolsItemReviewerParentRung(){ ## item path
	local rungReviewer rungSession rungMember rungAsking rungRecord=""
	type AgentsToolsRunRouteAvailable > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.RunRoute.include"
	rungReviewer="$( AgentsToolsItemReviewer "$1" )"
	case "$rungReviewer" in
		*:*)
			rungSession="${rungReviewer%%:*}" ; rungMember="${rungReviewer#*:}"
			type AgentsToolsActingSession > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.ActingMember.include"
			rungAsking="$( AgentsToolsActingSession )"
			[ "$rungAsking" != "$rungSession" ] || return 1
			if [ -n "$rungAsking" ] ; then
				type AgentsSessionRunRecordInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.include"
				type AgentsToolsFrontmatterKey > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/common/AgentsTools.FrontmatterKey.include"
				AgentsSessionRunRecordInto rungRecord "$rungAsking" || rungRecord=""
				[ -z "$rungRecord" ] || [ "$( AgentsToolsFrontmatterKey "$rungRecord" session-id )" != "$rungSession" ] || return 1
			fi
			AgentsToolsRunRouteAvailable "$rungSession" "$rungMember" "" || return 1
			printf '%s\n' "$rungReviewer"
			return 0
		;;
	esac
	return 1
}

## ---- THE SEAT, AND WHEN A RUN IS DISMISSED (F6.9) ----
## THE SEAT. A member is active once in a session: of its runs there, the one that holds its
## seat reads the session and posts in it, and there is no seatless run. The seat is a
## file of the session's own folder, sessions/<session>/seats/<member>, holding the spawn id of
## the run that holds it. A run takes it at its first read of the session or post to it (the
## served Wait and SendMessage of the harness), and a start by the spawn proxy takes it at once,
## which refuses to start a second run of a member whose seat a live run holds. A run that finds
## the seat held by a live run at its first read or post is refused outright, naming the holder
## and <session>:<member>, and ends (AgentsHarnessSeatRefuse). The first run to
## take it holds it, and start times play no part. A holder that no longer runs holds nothing:
## the next live run of its member takes the seat at its next read or post. A restart, known by
## `restarted-from: <spawn-id>` on its record, takes it over from the run it replaces while that
## one lives. The close of a run gives up the seat it holds.
