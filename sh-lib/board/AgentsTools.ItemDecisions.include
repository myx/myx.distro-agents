#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.ItemDecisions.include -- a board item's `## Decisions` section: the dated
## record of every answer, verdict, resolution and clarification that binds the item, so a
## reopened or continued task loses none of them. Definitions only, sourced by the op file
## AgentsTools.InternOpDecisions.include, the pending-reply store and the readers that show
## the section first (the spawn brief, conversation.md, the session-context scan).
##
## One line per decision, appended oldest first, read newest first:
##   - <UTC> <who> <kind>: <one line> (<source ts or id>)
## The section is the item's OWN one: a `## Decisions` heading, outside the frontmatter and
## any fenced block, immediately followed by the marker line `<!-- decisions-of: <item> -->`
## naming this item. A copy quoted from another item names that item, so it is never taken.
## An item from before the marker: its last unmarked `## Decisions` outside a fence that no
## `## Brief` heading precedes (a dispatch brief's quotes all sit under its `## Brief`).
## Shown elsewhere, a section is headed `### Decisions (from <item>)`, which never collides.
## A dispatch item that `tracks:` a task records each line on that task too, one level only.
##

## The kinds a Decisions line carries.
## handback and review are the review flow's own (AgentsTools.ReviewFlow.include).
agentsDecisionsKinds=" answer verdict resolved dismissed clarification handback review handler "

## The board path of an item, by name (with or without .md, a board/<state>/ prefix dropped).

## Prints nothing and rc 1 when no board state holds it.
AgentsToolsDecisionsItemPath(){ ## item name
	local pathFound
	AgentsToolsBoardItemInto pathFound "$1" || return 1
	printf '%s\n' "$pathFound"
}

## The board path of an item in one named state, into the named variable, rc 1 where the state or the name is none:
## no process, and no caller builds a board state's path of its own.
AgentsToolsBoardStatePathInto(){ ## variable, state, item file name
	printf -v "$1" '%s' ""
	case "${2:-}" in ''|*/*|.|..) return 1 ;; esac
	case "${3:-}" in ''|*/*|.|..) return 1 ;; esac
	[ -n "${MDAT_DATA_ROOT:-}" ] || return 1
	printf -v "$1" '%s/board/%s/%s' "$MDAT_DATA_ROOT" "$2" "$3"
}

## THE BOARD'S ITEMS, into the named array, a path each: those whose file name starts with the prefix (empty for every item),
## in the states named, else in every state folder the board holds. The one walk of the board's folders; a reader of many
## items takes it and never names the folders. No process. Empty where there are none.
AgentsToolsBoardItemsInto(){ ## array variable, name prefix, state...
	local itemsVar="$1" itemsPrefix="${2:-}" itemsOne itemsState
	case "$itemsVar" in ''|*[!A-Za-z0-9_]*) return 1 ;; esac
	eval "$itemsVar=()"
	[ -n "${MDAT_DATA_ROOT:-}" ] || return 0
	case "$itemsPrefix" in */*) return 1 ;; esac
	shift 2 2> /dev/null || shift $#
	if [ $# -eq 0 ] ; then
		for itemsOne in "$MDAT_DATA_ROOT/board"/*/"$itemsPrefix"*.md ; do
			[ -f "$itemsOne" ] && eval "$itemsVar+=( \"\$itemsOne\" )"
		done
		return 0
	fi
	for itemsState in "$@" ; do
		case "$itemsState" in ''|*/*|.|..) continue ;; esac
		for itemsOne in "$MDAT_DATA_ROOT/board/$itemsState/$itemsPrefix"*.md ; do
			[ -f "$itemsOne" ] && eval "$itemsVar+=( \"\$itemsOne\" )"
		done
	done
	return 0
}

## THE BOARD'S STATE FOLDERS, into the named array, a path each: those of the states named, else of every state of the one list
## (AgentsTools.BoardStates.include). A folder the board does not hold yet is named all the same: an empty state is no fault, and a
## writer makes it. The lookup folders a reader of one item takes, so no other part builds one. No process.
AgentsToolsBoardStateFoldersInto(){ ## array variable, state...
	local foldersVar="$1" foldersState
	case "$foldersVar" in ''|*[!A-Za-z0-9_]*) return 1 ;; esac
	eval "$foldersVar=()"
	[ -n "${MDAT_DATA_ROOT:-}" ] || return 0
	type AgentsToolsBoardReady > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.BoardStates.include"
	shift
	[ $# -gt 0 ] || set -- $agentsBoardStates
	[ $# -gt 0 ] || return 1
	for foldersState in "$@" ; do
		case "$foldersState" in ''|*/*|.|..) continue ;; esac
		eval "$foldersVar+=( \"\$MDAT_DATA_ROOT/board/\$foldersState\" )"
	done
	return 0
}

## Whether a board item of that name stands in one of the states named: rc 0 it does. No process: a permission check
## on every tool call asks it.
AgentsToolsBoardItemInStates(){ ## item name (with or without .md), state...
	local inName="${1##*/}" inState
	inName="${inName%.md}"
	[ -n "$inName" ] && [ -n "${MDAT_DATA_ROOT:-}" ] || return 1
	case "$inName" in .|..|-*) return 1 ;; esac
	shift
	for inState in "$@" ; do
		[ ! -f "$MDAT_DATA_ROOT/board/$inState/$inName.md" ] || return 0
	done
	return 1
}

## The first of the states named whose folder the board holds but cannot list, printed; rc 1 where every one that exists
## reads. A state the board does not have is no failure: a fresh board holds only the states it uses.
AgentsToolsBoardStateUnreadable(){ ## state...
	local badState
	[ -n "${MDAT_DATA_ROOT:-}" ] || return 1
	for badState in "$@" ; do
		[ -e "$MDAT_DATA_ROOT/board/$badState" ] || continue
		[ -d "$MDAT_DATA_ROOT/board/$badState" ] && [ -r "$MDAT_DATA_ROOT/board/$badState" ] && continue
		printf '%s' "$badState"
		return 0
	done
	return 1
}

## The board item of that name into the named variable, in whichever state holds it, as the item handle the board's own
## readers take. The search order is derived from the board's own two lists, never named here: the five active states
## first, then the rest of the one list, so a name a live state and the backlog both hold answers its live one. rc 1,
## the variable empty, where no state holds it. No process: the form a control-thread tick and a Wait round take.
AgentsToolsBoardItemInto(){ ## variable, item name (with or without .md)
	local itemName="${2##*/}" itemState itemSeen=" "
	printf -v "$1" '%s' ""
	itemName="${itemName%.md}"
	[ -n "$itemName" ] && [ -n "${MDAT_DATA_ROOT:-}" ] || return 1
	case "$itemName" in .|..|-*) return 1 ;; esac
	type AgentsToolsBoardReady > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.BoardStates.include"
	for itemState in $agentsBoardActiveStates $agentsBoardStates ; do
		case "$itemSeen" in *" $itemState "*) continue ;; esac
		itemSeen="$itemSeen$itemState "
		## AN ITEM NAMED WITHOUT `.md` IS THE SAME ITEM: the name as it stands is tried first, then the `.md` form every writer gives it.
		[ -f "$MDAT_DATA_ROOT/board/$itemState/$itemName" ] || [ -f "$MDAT_DATA_ROOT/board/$itemState/$itemName.md" ] || continue
		if [ -f "$MDAT_DATA_ROOT/board/$itemState/$itemName" ] ; then
			printf -v "$1" '%s' "$MDAT_DATA_ROOT/board/$itemState/$itemName"
		else
			printf -v "$1" '%s' "$MDAT_DATA_ROOT/board/$itemState/$itemName.md"
		fi
		return 0
	done
	return 1
}

## The state and the headers of the board item of that name, in one read: the state into the state variable, then each
## `<variable>=<key>` pair, the first line of its key in the item's first frontmatter block. rc 1, every variable empty,
## where no state holds the item. One awk and no other process: a supervise round reads every held run's item with it.
AgentsToolsBoardItemHeadersInto(){ ## item name, state variable, variable=key...
	local headItem="" headPair headOne headKeys="" headValues=""
	printf -v "$2" '%s' ""
	for headPair in "${@:3}" ; do printf -v "${headPair%%=*}" '%s' "" ; headKeys="$headKeys ${headPair#*=}" ; done
	AgentsToolsBoardItemInto headItem "$1" || return 1
	headOne="${headItem%/*}" ; printf -v "$2" '%s' "${headOne##*/}"
	[ $# -gt 2 ] || return 0
	headValues="$( LC_ALL=C awk -v keys="$headKeys" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/core/AgentsFrontmatterHeaderValues.awk" "$headItem" 2> /dev/null )"
	{ for headPair in "${@:3}" ; do IFS= read -r headOne || headOne="" ; printf -v "${headPair%%=*}" '%s' "$headOne" ; done ; } <<< "$headValues"
	return 0
}

## ONE STRING THAT CHANGES WHEN ONE BOARD ITEM DOES: its state, and its whole file. A Wait on `board:<item name>` keeps it as
## the source's rendering, so an item that moves between two states, leaves the board or is rewritten is an arrival, and an item
## the board does not hold renders `absent`. No process: the lookup and the read are the board's own, and a tick may call it.
AgentsToolsBoardItemSignatureInto(){ ## variable, item name (with or without .md)
	local sigName="${2##*/}" sigItem="" sigText=""
	printf -v "$1" '%s' "absent"
	sigName="${sigName%.md}"
	case "$sigName" in ''|.|..|-*) return 0 ;; esac
	AgentsToolsBoardItemInto sigItem "$sigName" || return 0
	IFS= read -r -d '' sigText < "$sigItem" 2> /dev/null || :
	sigItem="${sigItem%/*}"
	printf -v "$1" '%s' "${sigItem##*/}"$'\n'"$sigText"
	return 0
}

## The item an ask belongs to, as its name without .md: the first item name in <task ref>

## that a board state holds, else the `spawns:` dispatch item of the session's own spawn
## record, else nothing (rc 1).
AgentsToolsDecisionsItemFromRef(){ ## task ref text, session id
	local refText="$1" refSession="$2" refName refSpawns
	while IFS= read -r refName ; do
		[ -n "$refName" ] || continue
		AgentsToolsDecisionsItemPath "$refName" > /dev/null && { printf '%s\n' "${refName%.md}" ; return 0 ; }
	done < <( printf '%s\n' "$refText" | LC_ALL=C grep -oE '[a-z][a-z0-9]*-[0-9]{8}T[0-9]{4}([0-9]{2})?Z(-[A-Za-z0-9_.-]*[A-Za-z0-9_-])?' )
	type AgentsSessionRunHeadersInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.include"
	AgentsSessionRunHeadersInto "$refSession" refSpawns=spawns || return 1
	refSpawns="${refSpawns%%,*}" ; refSpawns="${refSpawns%% *}"
	[ -n "$refSpawns" ] && AgentsToolsDecisionsItemPath "$refSpawns" > /dev/null || return 1
	printf '%s\n' "${refSpawns%.md}"
}

## Text as one line: whitespace runs to one space, trimmed, cut at <max> bytes (default 300) on a UTF-8 boundary.
AgentsToolsDecisionsOneLine(){ ## text, max
	printf '%s' "$1" | LC_ALL=C tr -s ' \t\r\n' '    ' | LC_ALL=C awk -v max="${2:-300}" \
		-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/core/AgentsProgressLineSafe.awk" \
		-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsDecisionsOneLine.awk"
}

## The first line of a question, as both sides of a re-ask compare it: the first line that
## is neither blank nor a heading, one line, cut at 160 characters.
AgentsToolsDecisionsQuestionFirst(){ ## question text
	AgentsToolsDecisionsOneLine "$( printf '%s\n' "$1" | LC_ALL=C awk '$0 !~ /^#/ && $0 !~ /^[ \t]*$/ { print ; exit ; }' )" 160
}

## Text compared loosely: lower case, every run of other than letters and digits one space.
AgentsToolsDecisionsNorm(){ ## text
	printf '%s\n' "$1" | LC_ALL=C tr 'A-Z' 'a-z' | LC_ALL=C sed -e 's/[^a-z0-9][^a-z0-9]*/ /g' -e 's/^ //' -e 's/ $//' | LC_ALL=C tr -d '\n'
}

## The marker line that makes a `## Decisions` heading the item's own.
## awk functions over line[1..n], shared by the reader and the board edit, so both take the
## same section: decisionsOwn() is the own heading's line number (0 when none), and

## decisionsEnd() the section's last non-blank line before the next heading.

agentsDecisionsOwnAwk='
	function struckBase( s ) {
		while ( sub( / \[(struck by|confirmed by|backfilled) [^]]*\]$/, "", s ) ) { }
		return s ;
	}
	function decisionsOwn( n, marker,    i, inFm, inFence, sawBrief, marked, legacy ) {
		inFm = 0 ; inFence = 0 ; sawBrief = 0 ; marked = 0 ; legacy = 0 ;
		for ( i = 1 ; i <= n ; i++ ) {
			if ( i == 1 && line[i] == "---" ) { inFm = 1 ; continue ; }
			if ( inFm ) { if ( line[i] == "---" ) { inFm = 0 ; } continue ; }
			if ( line[i] ~ /^[ \t]*(```|~~~)/ ) { inFence = ! inFence ; continue ; }
			if ( inFence ) { continue ; }
			if ( line[i] ~ /^## Brief[ \t]*$/ ) { sawBrief = 1 ; continue ; }
			if ( line[i] !~ /^## Decisions[ \t]*$/ ) { continue ; }
			if ( i < n && line[i + 1] == marker ) { marked = i ; }
			else if ( ! sawBrief ) { legacy = i ; }
		}
		return ( marked ? marked : legacy ) ;
	}
	function decisionsEnd( n, start,    i, last ) {
		last = start ;
		for ( i = start + 1 ; i <= n ; i++ ) {
			if ( line[i] ~ /^##? / ) { break ; }
			if ( line[i] !~ /^[ \t]*$/ ) { last = i ; }
		}
		return last ;
	}
'

## The awk program the body writes run (AgentsToolsDecisionsKeep): the stored item first, the new
## body second. It takes the own section of each by the reader's own functions, so a line the
## reader sees is a line this keeps. A refusal exits before anything reaches stdout.
agentsDecisionsKeepAwk="$agentsDecisionsOwnAwk"'
	{ if ( FILENAME == ENVIRON["MDAT_KEEP_STORED"] ) { storedLine[++storedCount] = $0 ; } else { bodyLine[++bodyCount] = $0 ; } ; }
	END {
		bodyEnd = bodyCount ;
		while ( bodyEnd > 0 && bodyLine[bodyEnd] ~ /^[ \t]*$/ ) { bodyEnd-- ; }
		if ( bodyEnd == 0 ) { exit 0 ; }
		if ( storedCount > 0 ) {
			for ( i = 1 ; i <= storedCount ; i++ ) { line[i] = storedLine[i] ; }
			storedStart = decisionsOwn( storedCount, marker ) ;
		}
		if ( storedStart > 0 ) {
			storedLast = decisionsEnd( storedCount, storedStart ) ;
			for ( i = storedStart ; i <= storedLast ; i++ ) { keptLine[++keptCount] = line[i] ; }
			for ( i = storedStart + 1 ; i <= storedLast ; i++ ) { if ( line[i] ~ /^- / ) { recorded[++recordedCount] = struckBase( line[i] ) ; } ; }
		}
		if ( bodyCount > 0 ) {
			for ( i = 1 ; i <= bodyCount ; i++ ) { line[i] = bodyLine[i] ; }
			bodyStart = decisionsOwn( bodyCount, marker ) ;
		}
		if ( bodyStart > 0 ) {
			bodyLast = decisionsEnd( bodyCount, bodyStart ) ;
			for ( i = bodyStart + 1 ; i <= bodyLast ; i++ ) { if ( line[i] ~ /^- / ) { carried[++carriedCount] = struckBase( line[i] ) ; } ; }
		}
		## A body brings no unrecorded decision line and changes no recorded one; only the writer and the mark of a strike do.
		allowLine = ENVIRON["MDAT_DECISIONS_LINE"] ; allowMark = ENVIRON["MDAT_DECISIONS_MARK"] ;
		for ( j = 1 ; j <= carriedCount ; j++ ) {
			isRecorded = 0 ;
			for ( i = 1 ; i <= recordedCount ; i++ ) { if ( recorded[i] == carried[j] ) { isRecorded = 1 ; } ; }
			if ( isRecorded || ( allowLine != "" && ( carried[j] == allowLine || carried[j] == "- " allowLine ) ) ) { continue ; }
			printf "⛔ ERROR: %s: %s: this write brings a decision line that was never recorded, so nothing was written. A decision lands only through its confirmed readback: --record-decision <item> --kind <kind> --text <its text> --with <the one it was made with>. The line: %s\n", cmdName, keepLabel, carried[j] > "/dev/stderr" ;
			forgedCount++ ;
		}
		if ( bodyStart > 0 ) {
			for ( i = 1 ; i <= keptCount ; i++ ) {
				if ( keptLine[i] !~ /^- / ) { continue ; }
				keptBase = struckBase( keptLine[i] ) ;
				for ( j = bodyStart + 1 ; j <= bodyLast ; j++ ) {
					if ( bodyLine[j] !~ /^- / || bodyLine[j] == keptLine[i] || struckBase( bodyLine[j] ) != keptBase ) { continue ; }
					if ( allowMark != "" && substr( bodyLine[j], length( bodyLine[j] ) - length( allowMark ) + 1 ) == allowMark ) { continue ; }
					printf "⛔ ERROR: %s: %s: this write changes a recorded decision, so nothing was written. A decision is struck only through --record-decision <item> --strike <line> --reason <why> --with <party>. The line: %s\n", cmdName, keepLabel, keptLine[i] > "/dev/stderr" ;
					forgedCount++ ;
				}
			}
		}
		if ( keepMode == "edit" ) {
			for ( i = 1 ; i <= recordedCount ; i++ ) {
				storedTimes = 0 ; carriedTimes = 0 ;
				for ( j = 1 ; j <= recordedCount ; j++ ) { if ( recorded[j] == recorded[i] ) { storedTimes++ ; } ; }
				for ( j = 1 ; j <= carriedCount ; j++ ) { if ( carried[j] == recorded[i] ) { carriedTimes++ ; } ; }
				if ( carriedTimes >= storedTimes ) { continue ; }
				printf "⛔ ERROR: %s: %s: this write would drop a recorded decision, so nothing was written: %s\n", cmdName, keepLabel, recorded[i] > "/dev/stderr" ;
				dropped++ ;
			}
		}
		if ( forgedCount > 0 || dropped > 0 ) { exit 1 ; }
		if ( recordedCount == 0 ) {
			for ( i = 1 ; i <= bodyCount ; i++ ) { print bodyLine[i] ; }
			exit 0 ;
		}
		for ( j = 1 ; j <= carriedCount ; j++ ) {
			known = 0 ;
			for ( i = 1 ; i <= recordedCount ; i++ ) { if ( recorded[i] == carried[j] ) { known = 1 ; } ; }
			if ( ! known ) { extra[++extraCount] = carried[j] ; }
		}
		if ( bodyStart > 0 ) {
			for ( i = 1 ; i < bodyStart ; i++ ) { print bodyLine[i] ; }
			## A carried struck line wins over the stored copy it strikes: the mark is the newer truth.
			for ( i = 1 ; i <= keptCount ; i++ ) {
				keptOut = keptLine[i] ;
				if ( keptLine[i] ~ /^- / ) {
					keptBase = struckBase( keptLine[i] ) ;
					for ( j = bodyStart + 1 ; j <= bodyLast ; j++ ) {
						if ( bodyLine[j] !~ /^- / ) { continue ; }
						if ( struckBase( bodyLine[j] ) == keptBase && bodyLine[j] != keptLine[i] ) { keptOut = bodyLine[j] ; }
					}
				}
				print keptOut ;
			}
			for ( i = 1 ; i <= extraCount ; i++ ) { print extra[i] ; }
			for ( i = bodyLast + 1 ; i <= bodyCount ; i++ ) { print bodyLine[i] ; }
			exit 0 ;
		}
		bodyEnd = bodyCount ;
		while ( bodyEnd > 0 && bodyLine[bodyEnd] ~ /^[ \t]*$/ ) { bodyEnd-- ; }
		for ( i = 1 ; i <= bodyEnd ; i++ ) { print bodyLine[i] ; }
		print "" ;
		for ( i = 1 ; i <= keptCount ; i++ ) { print keptLine[i] ; }
		for ( i = 1 ; i <= extraCount ; i++ ) { print extra[i] ; }
	}
'

## A body write keeps the item's recorded Decisions: the new body on stdin, the kept one on stdout.
## `keep` is a whole body, and puts the recorded block back; `edit` is a body derived from the item, and refuses where a
## recorded line would go. Both refuse a decision line the body brings that was never recorded, and a recorded line it changes.
## A refusal names each such line on stderr, prints nothing on stdout, and returns 1.
AgentsToolsDecisionsKeep(){ ## stored item path, mode (keep|edit), label
	local keepPath="$1" keepMode="$2" keepLabel="${3:-decision-keep}"
	## A new item has no recorded decisions, so every decision line its body brings is refused: it is read against an empty one.
	[ -f "$keepPath" ] || keepPath=/dev/null
	LC_ALL=C MDAT_KEEP_STORED="$keepPath" awk -v keepMode="$keepMode" -v keepLabel="$keepLabel" \
		-v cmdName="${MDSC_CMD:-board-upsert-move-edit}" -v marker="$( markerName="${3:-${keepPath##*/}}" ; printf '<!-- decisions-of: %s -->\n' "${markerName%.md}" )" \
		"$agentsDecisionsKeepAwk" "$keepPath" -
}

## The section's lines, newest first, at most <cap> (default 30).
AgentsToolsDecisionsLines(){ ## item path, cap
	[ -f "$1" ] || return 0
	LC_ALL=C awk -v cap="${2:-30}" -v marker="$( markerName="${1##*/}" ; printf '<!-- decisions-of: %s -->\n' "${markerName%.md}" )" "$agentsDecisionsOwnAwk"'
		{ line[NR] = $0 ; }
		END {
			start = decisionsOwn( NR, marker ) ;
			if ( ! start ) { exit ; }
			last = decisionsEnd( NR, start ) ;
			for ( i = start + 1 ; i <= last ; i++ ) { if ( line[i] ~ /^- / ) { found[++n] = line[i] ; } ; }
			for ( i = n ; i >= 1 && shown < cap + 0 ; i-- ) { print found[i] ; shown++ ; }
		}
	' "$1" 2> /dev/null
}

## The section as a block to show ahead of other context (a brief, conversation.md, a scan),
## headed `### Decisions (from <item>)` so it is never taken for the own section of the item
## it is quoted into; nothing at all when the item has no decision yet.
AgentsToolsDecisionsBlock(){ ## item path, cap
	local blockLines blockAll blockName="${1##*/}"
	blockLines="$( AgentsToolsDecisionsLines "$1" "${2:-30}" )"
	[ -n "$blockLines" ] || return 0
	blockAll="$( AgentsToolsDecisionsLines "$1" 100000 | LC_ALL=C awk 'END { print NR ; }' )"
	printf '### Decisions (from %s)\n\nBinding, newest first%s.\n\n' "${blockName%.md}" \
		"$( [ "$blockAll" -le "${2:-30}" ] || printf ', %s of %s shown -- the rest are in the item' "${2:-30}" "$blockAll" )"
	printf '%s\n' "$blockLines"
}

## The items whose Decisions bind a spawn, one path per line, no repeats: its own item, the
## item that one `tracks:`, and every `spawns:` item of the spawn records in its sandbox root,
## which is where the asks of a session it replaces or joins were recorded.
AgentsToolsDecisionsRelatedPaths(){ ## board item path (may be empty), sandbox root (may be empty)
	local relSeen=" " relName relPath relRecord
	{
		[ -z "$1" ] || printf '%s\n' "$1"
		[ -z "$1" ] || [ ! -f "$1" ] || AgentsToolsDecisionsField "$1" tracks
		if [ -n "$2" ] ; then
			for relRecord in "$2"/*.md ; do
				[ -f "$relRecord" ] || continue
				LC_ALL=C awk '$0 == "---" { if ( ++fm == 2 ) exit ; next ; } fm == 1 && index( $0, "spawns: " ) == 1 { print substr( $0, 9 ) ; exit ; }' "$relRecord" 2> /dev/null \
					| LC_ALL=C tr ',' '\n' | LC_ALL=C sed 's/^ *//;s/ *$//'
			done
		fi
	} | while IFS= read -r relName ; do
		[ -n "$relName" ] || continue
		case "$relName" in
			/*) relPath="$relName" ;;
			*) relPath="$( AgentsToolsDecisionsItemPath "$relName" )" || continue ;;
		esac
		[ -f "$relPath" ] || continue
		case "$relSeen" in *" ${relPath##*/} "*) continue ;; esac
		relSeen="$relSeen${relPath##*/} "
		printf '%s\n' "$relPath"
	done
}

## The newest Decisions line that already answers a question: an answer, verdict, resolution
## or clarification whose text holds the question's first line, compared loosely. A first
## line under 12 characters is never matched, since it would match too much.
AgentsToolsDecisionsEarlier(){ ## item path, question text
	local earlyQuestion earlyLine earlyBody
	earlyQuestion="$( AgentsToolsDecisionsNorm "$( AgentsToolsDecisionsQuestionFirst "$2" )" )"
	[ "${#earlyQuestion}" -ge 12 ] || return 1
	while IFS= read -r earlyLine ; do
		case "$earlyLine" in
			*' answer: '*|*' verdict: '*|*' resolved: '*|*' clarification: '*) ;;
			*) continue ;;
		esac
		## A struck line decides nothing, so it never stops the same question being asked again.
		case "$earlyLine" in *'[struck by '*) continue ;; esac
		earlyBody="$( AgentsToolsDecisionsNorm "$earlyLine" )"
		case " $earlyBody " in
			*" $earlyQuestion "*) printf '%s\n' "$earlyLine" ; return 0 ;;
		esac
	done < <( AgentsToolsDecisionsLines "$1" 100000 )
	return 1
}

## The board path of the item a dispatch item `tracks:` (the task it works on): one level,
## never the item itself. rc 1 when it tracks nothing on the board.
AgentsToolsDecisionsTracked(){ ## item path
	local trackedName trackedPath
	[ -f "$1" ] || return 1
	trackedName="$( AgentsToolsDecisionsField "$1" tracks )"
	trackedName="${trackedName%% *}" ; trackedName="${trackedName%.md}"
	[ -n "$trackedName" ] || return 1
	trackedPath="$( AgentsToolsDecisionsItemPath "$trackedName" )" || return 1
	[ "${trackedPath##*/}" != "${1##*/}" ] || return 1
	printf '%s\n' "$trackedPath"
}

## The owners of the dispatch items that `tracks:` this item, one a line, each once: the board's own
## walk of its dispatch items and its own reading of them, so a caller names an item and builds no path.
## One awk pass, never a process per item: a permission check asks it.
AgentsToolsDecisionsTrackingOwners(){ ## item name (with or without .md)
	local trackName="${1##*/}" trackItems
	trackName="${trackName%.md}"
	[ -n "$trackName" ] || return 0
	AgentsToolsBoardItemsInto trackItems "dispatch-" || return 0
	[ "${#trackItems[@]}" -gt 0 ] || return 0
	LC_ALL=C awk -v item="$trackName" '
		FNR == 1 { fence = 0 ; owner = "" ; tracks = "" ; }
		$0 == "---" { fence++ ; if ( fence > 1 ) { if ( tracks == item || tracks == item ".md" ) print owner ; nextfile ; } ; next ; }
		fence == 1 && index( $0, "owner: " ) == 1 && owner == "" { owner = substr( $0, 8 ) ; }
		fence == 1 && index( $0, "tracks: " ) == 1 && tracks == "" { tracks = substr( $0, 9 ) ; }
	' ${trackItems[@]+"${trackItems[@]}"} 2> /dev/null || :
}

## AgentsToolsDecisionsEarlier over the item, then the item it tracks, so a later session on
## the same task under a new dispatch finds the answer. Prints `<item name> | <line>`.
AgentsToolsDecisionsEarlierTracked(){ ## item path, question text
	local etPath etLine
	for etPath in "$1" "$( AgentsToolsDecisionsTracked "$1" )" ; do
		[ -n "$etPath" ] || continue
		etLine="$( AgentsToolsDecisionsEarlier "$etPath" "$2" )" || continue
		etPath="${etPath##*/}"
		printf '%s | %s\n' "${etPath%.md}" "$etLine"
		return 0
	done
	return 1
}

## One frontmatter field of an item, empty when absent.
AgentsToolsDecisionsField(){ ## item path, field
	LC_ALL=C awk -v key="$2" '
		NR == 1 && $0 == "---" { inFm = 1 ; next ; }
		inFm && $0 == "---" { exit ; }
		inFm && index( $0, key ": " ) == 1 { print substr( $0, length( key ) + 3 ) ; exit ; }
	' "$1" 2> /dev/null
}

## The member of a session, the `owner:` of its spawn record here; nothing when it has none.
AgentsToolsSessionMember(){ ## session id
	local smRecord
	case "$1" in ''|-|none|*/*|.|..) return 0 ;; esac
	[ -n "${MMDAPP:-}" ] || return 0
	type AgentsSessionRunRecordInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.include"
	AgentsSessionRunRecordInto smRecord "$1" || :
	for smRecord in ${smRecord:+"$smRecord"} ; do
		[ -f "$smRecord" ] || continue
		AgentsToolsDecisionsField "$smRecord" owner
		return 0
	done
	return 0
}

## Whether a comma-separated member list names <member>. rc 0 when it does.
AgentsToolsMemberListHas(){ ## list, member
	local mlEntry
	[ -n "$2" ] || return 1
	while IFS= read -r mlEntry ; do
		mlEntry="${mlEntry#"${mlEntry%%[![:space:]]*}"}" ; mlEntry="${mlEntry%"${mlEntry##*[![:space:]]}"}"
		[ "$mlEntry" != "$2" ] || return 0
	done <<< "$( printf '%s\n' "$1" | LC_ALL=C tr ',' '\n' )"
	return 1
}

## Whether <member> is an executor of the routine a routine name names (AgentsToolsRoutineFile,
## AgentsTools.TeamRegistry.include): one its `executors:` lists, or any member where they list
## magic-team or `*`. rc 0 an executor; rc 1 not, or no such routine.
AgentsToolsRoutineIsExecutor(){ ## routine name, member
	local reFile reExec
	type AgentsToolsRoutineFile > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.TeamRegistry.include"
	reFile="$( AgentsToolsRoutineFile "$1" )" || return 1
	reExec="$( AgentsToolsDecisionsField "$reFile" executors )"
	case ",$( printf '%s' "$reExec" | LC_ALL=C tr -d ' \t' )," in
		*,magic-team,*|*,\*,*) return 0 ;;
	esac
	AgentsToolsMemberListHas "$reExec" "$2" && return 0
	return 1
}

## Whether <member>, calling from this process, is the reviewer of an item: its `review-by`,
## else whoever the run of its spawn-id reports to (AgentsToolsItemReviewer). Empty (no
## review-by and no run of its own) or magic-coordinator: magic-coordinator; none: nobody;
## human-owner, and user-<account> for now: the human, from no spawned session; <name>.routine:
## an executor of that routine (magic-team or `*`: any member); <session>[:<member>]: that
## session itself, the member it names, or the member of its spawn record; a member name: that
## member. rc 0 the reviewer, rc 1 not.
AgentsToolsItemIsReviewer(){ ## item path, member
	local irBy irSession="" irMember="" irDir
	type AgentsToolsItemReviewer > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.ItemReviewer.include"
	irBy="$( AgentsToolsItemReviewer "$1" )"
	## A member or routine of any workspace (AgentsTools.TeamRegistry.include), not this one's own index alone.
	type AgentsToolsTeamMemberDirectory > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.TeamRegistry.include"
	case "$irBy" in
		''|magic-coordinator)
			[ "$2" = magic-coordinator ] && return 0
			return 1
		;;
		none) return 1 ;;
		human-owner|user-?*)
			type AgentsToolsActingMember > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.ActingMember.include"
			[ -z "$( AgentsToolsActingMember )" ] && return 0
			return 1
		;;
		*.routine)
			AgentsToolsRoutineIsExecutor "$irBy" "$2" && return 0
			return 1
		;;
		*:*) irSession="${irBy%%:*}" ; irMember="${irBy#*:}" ;;
		magic-*|keeper-*|warden-*|partner-*|client-*|oncall-*|expert-*) irMember="$irBy" ;;
		*)
			if irDir="$( AgentsToolsTeamMemberDirectory "$irBy" )" && [ -f "$irDir/SKILL.md" ] ; then
				irMember="$irBy"
			else
				irSession="$irBy"
			fi
		;;
	esac
	[ -z "$irMember" ] || [ "$2" != "$irMember" ] || return 0
	[ -n "$irSession" ] || return 1
	type AgentsToolsActingSessionIs > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.ActingMember.include"
	AgentsToolsActingSessionIs "$irSession" && return 0
	[ "$( AgentsToolsSessionMember "$irSession" )" != "$2" ] || return 0
	return 1
}

## Whether <member>, calling from this process, may ask for an item's review: its owner, or
## the session that spawned its child -- that session itself or its member -- by the
## `parent-spawn-id:` of the spawn record its `spawn-id:` names. rc 0 may, rc 1 not.
AgentsToolsItemIsOwnerOrParent(){ ## item path, member
	local opSpawn opParent
	AgentsToolsMemberListHas "$( AgentsToolsDecisionsField "$1" owner )" "$2" && return 0
	opSpawn="$( AgentsToolsDecisionsField "$1" spawn-id )"
	case "$opSpawn" in ''|-|*/*|.|..) return 1 ;; esac
	type AgentsSessionRunRecordInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.include"
	AgentsSessionRunRecordInto opParent "$opSpawn" || :
	for opParent in ${opParent:+"$opParent"} ; do
		[ -f "$opParent" ] || continue
		opParent="$( AgentsToolsDecisionsField "$opParent" parent-spawn-id )"
		case "$opParent" in ''|-|none) return 1 ;; esac
		type AgentsToolsActingSession > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.ActingMember.include"
		[ "$( AgentsToolsActingSession )" != "$opParent" ] || return 0
		[ "$( AgentsToolsSessionMember "$opParent" )" != "$2" ] || return 0
		return 1
	done
	return 1
}

## Whether <member>, calling from this process, is a party to an item: its owner, its
## reviewer (AgentsToolsItemIsReviewer), or the member of a spawn that works it -- the one
## its `spawn-id:` names, or one whose `spawns:`/`spawned-by:` names it. rc 0 a party.
AgentsToolsItemIsParty(){ ## item path, member
	local ipSpawn ipName="${1##*/}"
	ipName="${ipName%.md}"
	AgentsToolsMemberListHas "$( AgentsToolsDecisionsField "$1" owner )" "$2" && return 0
	AgentsToolsItemIsReviewer "$1" "$2" && return 0
	ipSpawn="$( AgentsToolsDecisionsField "$1" spawn-id )"
	case "$ipSpawn" in
		''|-|*/*|.|..) ;;
		*) [ "$( AgentsToolsSessionMember "$ipSpawn" )" != "$2" ] || return 0 ;;
	esac
	[ -n "${MMDAPP:-}" ] && [ -n "$2" ] || return 1
	## Every spawn record in one pass: one of <member>'s whose spawns/spawned-by names the item.
	local ipRecords=()
	type AgentsToolsSpawnedAllRecordsInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.StartedRecords.include"
	AgentsToolsSpawnedAllRecordsInto ipRecords
	LC_ALL=C awk -v who="$2" -v item="$ipName" '
		FNR == 1 { fm = 0 ; owner = "" ; linked = 0 ; }
		$0 == "---" { if ( ++fm == 2 && owner == who && linked ) { found = 1 ; exit ; } next ; }
		fm == 1 && index( $0, "owner: " ) == 1 { owner = substr( $0, 8 ) ; }
		fm == 1 && ( index( $0, "spawns: " ) == 1 || index( $0, "spawned-by: " ) == 1 ) {
			links = $0 ; sub( /^[a-z-]+: /, "", links ) ; gsub( / /, "", links ) ;
			n = split( links, part, "," ) ;
			for ( i = 1 ; i <= n ; i++ ) { one = part[i] ; sub( /\.md$/, "", one ) ; if ( one == item ) { linked = 1 ; } ; }
		}
		END { exit ( found ? 0 : 1 ) ; }
	' ${ipRecords[@]+"${ipRecords[@]}"} /dev/null 2> /dev/null && return 0
	return 1
}

## A closed pending-reply record's outcome, as one line on its item's Decisions: an answer, a
## typed verdict (with its text), a settle as resolved, an unknown reply as dismissed, an amend
## as an answer. A received one also clears the item's blocked-on/condition where that text
## names this ask (its id, question ts or thread ts). Best effort: a record with no item, or
## a board edit that fails, is logged and never undoes the close.
AgentsToolsDecisionsFromPending(){ ## pending id, record file, status, amend (1 or empty), answer ts
	local decId="$1" decFile="$2" decStatus="$3" decAmend="$4" decAnswerTs="$5" decKey decValue
	local decItem="" decKind="" decTag="" decVerdict="" decVerdictText="" decBy="" decTo="" decQts="" decTts="" decChannel="" decAmendBy="" decFirst="" decWithdrawnBy="" decWithdrawReason="" decClosedBy=""
	local decLineKind decWho decText decMentions="" decDocument=""
	[ -f "$decFile" ] || return 0
	while IFS=$'\t' read -r decKey decValue ; do
		case "$decKey" in
			item) decItem="$decValue" ;;
			kind) decKind="$decValue" ;;
			question-tag) decTag="$decValue" ;;
			verdict) decVerdict="$decValue" ;;
			verdict-text) decVerdictText="$decValue" ;;
			answered-by) decBy="$decValue" ;;
			address-to) decTo="$decValue" ;;
			question-ts) decQts="$decValue" ;;
			thread-ts) decTts="$decValue" ;;
			channel) decChannel="$decValue" ;;
			amended-by) decAmendBy="$decValue" ;;
			withdrawn-by) decWithdrawnBy="$decValue" ;;
			withdraw-reason) decWithdrawReason="$decValue" ;;
			closed-by) decClosedBy="$decValue" ;;
			first) decFirst="$decValue" ;;
		esac
	done < <( LC_ALL=C awk '
		$0 == "---" { dashes++ ; next ; }
		dashes == 1 { colon = index($0, ": ") ; if ( colon > 1 ) { printf "%s\t%s\n", substr($0, 1, colon - 1), substr($0, colon + 2) ; } next ; }
		dashes >= 2 && $0 !~ /^#/ && $0 !~ /^[ \t]*$/ { printf "first\t%s\n", $0 ; exit ; }
	' "$decFile" 2>/dev/null )
	## A decision's own readback lands that decision, or goes up where its party cannot decide, and writes nothing else.
	if [ -n "$( AgentsToolsDecisionReadbackSlot "$decFile" decision-kind )" ] ; then
		[ "$decStatus" = reply-received ] && [ -n "$decItem" ] || return 0
		case "$decVerdict" in yes|edit) ;; *) return 0 ;; esac
		decDocument="$( AgentsToolsDecisionsItemPath "$decItem" 2> /dev/null )" || decDocument=""
		[ -z "$decDocument" ] || ! LC_ALL=C grep -q -F -- "(readback $decId," "$decDocument" 2> /dev/null || return 0
		local decOwner decText decSource decUp decAsk=() decOut decSentUp
		## A review applies its list line by line, or goes up with it where its answerer holds no rights over the item.
		if [ "$( AgentsToolsDecisionReadbackSlot "$decFile" decision-kind )" = review ] ; then
			[ -n "$decDocument" ] && ! LC_ALL=C grep -q -F -- "readback $decId," "$decDocument" 2> /dev/null || return 0
			[ -z "$( AgentsToolsDecisionReadbackSlot "$decFile" escalated )" ] || return 0
			local revOwner revRows revNumber revAction revLine revKind revText revAt revSent
			revOwner="$( AgentsToolsDecisionsField "$decFile" owner )" ; revAt="$( date -u +%Y-%m-%dT%H:%MZ )"
			## The plan is the readback's decision-strike slot, kept escaped on one line; an edit's numbered words change its actions.
			revRows="$( MDAT_REVIEW_EDIT="$( [ "$decVerdict" != edit ] || printf '%s' "$decVerdictText" )" LC_ALL=C awk '
				index( $0, "decision-strike\t" ) == 1 {
					rawValue = substr( $0, 17 ) ; plainText = "" ;
					for ( charAt = 1 ; charAt <= length( rawValue ) ; charAt++ ) {
						oneChar = substr( rawValue, charAt, 1 ) ;
						if ( oneChar == "\\" && charAt < length( rawValue ) ) { charAt++ ; oneChar = substr( rawValue, charAt, 1 ) ; if ( oneChar == "n" ) { oneChar = "\n" ; } ; }
						plainText = plainText oneChar ;
					}
					rowCount = split( plainText, planRow, "\n" ) ;
				}
				END {
					editText = ENVIRON["MDAT_REVIEW_EDIT"] ;
					while ( match( editText, /[0-9]+[ .:)-]*(prune|confirm|re-ask)/ ) ) {
						editPair = substr( editText, RSTART, RLENGTH ) ; editText = substr( editText, RSTART + RLENGTH ) ;
						editNumber = editPair ; sub( /[^0-9].*$/, "", editNumber ) ;
						editAction = editPair ; sub( /^[0-9]+[ .:)-]*/, "", editAction ) ;
						wantAction[ editNumber + 0 ] = editAction ;
					}
					for ( rowAt = 1 ; rowAt <= rowCount ; rowAt++ ) {
						if ( split( planRow[rowAt], rowField, "\t" ) < 3 || rowField[2] !~ /^(prune|confirm|re-ask)$/ ) { continue ; }
						rowNumber = rowField[1] ; rowAction = rowField[2] ;
						rowLine = substr( planRow[rowAt], length( rowField[1] ) + length( rowField[2] ) + 3 ) ;
						if ( ( rowNumber + 0 ) in wantAction ) { rowAction = wantAction[ rowNumber + 0 ] ; }
						printf "%s\t%s\t%s\n", rowNumber, rowAction, rowLine ;
					}
				}
			' "${decFile%.md}.fields" 2> /dev/null )"
			[ -n "$revRows" ] || { echo "${MDSC_CMD:-pending-reply-close}: ⚠️ WARNING: review readback $decId holds no list, so nothing changed on $decItem" >&2 ; return 0 ; }
			type AgentsToolsPermissionIsHumanOwner > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.PermissionHolds.include"
			if ! AgentsToolsPermissionIsHumanOwner "${decBy:-}" && ! AgentsToolsDecisionAccountDecides "${decBy:-}" "$decDocument" ; then
				decOut="$( env -u CLAUDE_CODE_SESSION_ID -u MDAT_SESSION_ID MDAT_SPAWN_SESSION_ID="$( AgentsToolsDecisionsField "$decFile" session-id )" MDAT_SPAWN_AGENT="$revOwner" \
					MDAT_DECISIONS_REVIEW_PLAN="$revRows" \
					"$BASH" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh" --record-decision --team-member "$revOwner" "$decItem" --review --with human-owner \
					--source "confirmed by ${decBy:-unknown} in readback $decId" 2>&1 < /dev/null )" \
					|| echo "${MDSC_CMD:-pending-reply-close}: ⚠️ WARNING: review readback $decId was answered by ${decBy:-nobody}, who holds no rights over $decItem, and it did not go up: $( printf '%s\n' "$decOut" | LC_ALL=C grep -m1 -E 'ERROR' )" >&2
				revSent="$( printf '%s\n' "$decOut" | LC_ALL=C sed -n 's/^DECISION-ASKED \([^ ]*\) .*/\1/p' | head -1 )"
				[ -z "$revSent" ] || printf 'escalated\t%s\n' "$revSent" >> "${decFile%.md}.fields" || :
				return 0
			fi
			while IFS=$'\t' read -r revNumber revAction revLine <&3 ; do
				case "$revAction" in
					confirm)
						AgentsToolsDecisionsStrike "$revOwner" "$decItem" "$revLine" "confirmed in review" "" " [confirmed by ${decBy:-unknown}: readback $decId, at $revAt]" > /dev/null \
							|| echo "${MDSC_CMD:-pending-reply-close}: ⚠️ WARNING: review readback $decId: line $revNumber of $decItem was not confirmed" >&2
					;;
					prune|re-ask)
						AgentsToolsDecisionsStrike "$revOwner" "$decItem" "$revLine" "$( [ "$revAction" = prune ] && echo 'pruned: no confirmation behind it' || echo 'asked again: no confirmation behind it' )" "readback $decId, confirmed by ${decBy:-unknown} at $revAt" > /dev/null \
							|| { echo "${MDSC_CMD:-pending-reply-close}: ⚠️ WARNING: review readback $decId: line $revNumber of $decItem was not struck" >&2 ; continue ; }
						[ "$revAction" = re-ask ] || continue
						revKind="$( printf '%s\n' "$revLine" | LC_ALL=C awk '{ sub( /:$/, "", $4 ) ; print $4 ; }' )"
						revText="${revLine#- * * * }" ; revText="${revText%% (*}"
						env -u CLAUDE_CODE_SESSION_ID -u MDAT_SESSION_ID MDAT_SPAWN_SESSION_ID="$( AgentsToolsDecisionsField "$decFile" session-id )" MDAT_SPAWN_AGENT="$revOwner" \
							"$BASH" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh" --record-decision --team-member "$revOwner" "$decItem" --kind "$revKind" --text "$revText" \
							--with "${decTo:-human-owner}" --source "asked again from review readback $decId" > /dev/null 2>&1 < /dev/null \
							|| echo "${MDSC_CMD:-pending-reply-close}: ⚠️ WARNING: review readback $decId: line $revNumber of $decItem is struck, but its text was not asked again" >&2
					;;
				esac
			done 3<<< "$revRows"
			return 0
		fi
		decOwner="$( AgentsToolsDecisionsField "$decFile" owner )"
		decText="$( AgentsToolsDecisionReadbackSlot "$decFile" understood )"
		decSource="$( AgentsToolsDecisionReadbackSlot "$decFile" decision-source )"
		decUp="$( AgentsToolsDecisionReadbackSlot "$decFile" decision-escalate )"
		if [ -n "$( AgentsToolsDecisionReadbackSlot "$decFile" decision-strike )" ] ; then
			decAsk=( --strike "$( AgentsToolsDecisionReadbackSlot "$decFile" decision-strike )" --reason "$decText" --readback "$decId" ${decSource:+--source "$decSource"} )
		elif [ -n "$decUp" ] ; then
			[ -z "$( AgentsToolsDecisionReadbackSlot "$decFile" escalated )" ] || return 0
			[ "$decVerdict" != edit ] || decText="$decVerdictText"
			[ -n "$decText" ] || { echo "${MDSC_CMD:-pending-reply-close}: ⚠️ WARNING: readback $decId was edited with no words of the edit, so nothing went up" >&2 ; return 0 ; }
			decAsk=( --kind "$( AgentsToolsDecisionReadbackSlot "$decFile" decision-kind )" --text "$decText" --with "$decUp" --source "confirmed by ${decBy:-unknown} in readback $decId${decSource:+, $decSource}" )
		else
			decAsk=( --kind "$( AgentsToolsDecisionReadbackSlot "$decFile" decision-kind )" --text "$decText" --readback "$decId" ${decSource:+--source "$decSource"} )
		fi
		decOut="$( env -u CLAUDE_CODE_SESSION_ID -u MDAT_SESSION_ID MDAT_SPAWN_SESSION_ID="$( AgentsToolsDecisionsField "$decFile" session-id )" MDAT_SPAWN_AGENT="$decOwner" \
			"$BASH" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh" --record-decision --team-member "$decOwner" "$decItem" "${decAsk[@]}" 2>&1 < /dev/null )" \
			|| echo "${MDSC_CMD:-pending-reply-close}: ⚠️ WARNING: readback $decId is closed with $decVerdict, but it did not land on $decItem: $( printf '%s\n' "$decOut" | LC_ALL=C grep -m1 -E 'ERROR|CORRECTION' )" >&2
		## A decision sent up keeps the readback it went up as, so it goes up once.
		decSentUp="$( printf '%s\n' "$decOut" | LC_ALL=C sed -n 's/^DECISION-ASKED \([^ ]*\) .*/\1/p' | head -1 )"
		[ -z "$decUp" ] || [ -z "$decSentUp" ] || printf 'escalated\t%s\n' "$decSentUp" >> "${decFile%.md}.fields" || :
		return 0
	fi
	decWho="${decBy:-${decTo:-unknown}}"
	case "${decKind:-question}:$decStatus" in
		*:reply-unknown) decLineKind="dismissed" ; decVerdict="no answer known" ;;
		## Withdrawn by its asker: never an answer, so it decides nothing.
		*:withdrawn) decLineKind="dismissed" ; decWho="${decWithdrawnBy:-$decWho}" ; decVerdict="withdrawn by its asker, no answer taken: ${decWithdrawReason:-no reason given}" ;;
		question:*)
			decLineKind="answer"
			case "$decVerdict" in settled:*) decLineKind="resolved" ;; esac
		;;
		*) decLineKind="verdict" ;;
	esac
	[ -z "$decVerdictText" ] || decVerdict="$decVerdict -- $decVerdictText"
	[ "$decClosedBy" != "readback" ] || decVerdict="$decVerdict (closed by the asker's readback)"
	## A proposal's verdict is given to its document, so the line names it by its link.
	if [ "${decKind:-question}:$decStatus" = "proposal:reply-received" ] ; then
		decDocument="$( LC_ALL=C awk -F'\t' '$1 == "document" { print $2 ; exit ; }' "${decFile%.md}.fields" 2> /dev/null )"
		[ -z "$decDocument" ] || decVerdict="$decVerdict (document: $decDocument)"
	fi
	if [ -n "$decAmend" ] ; then
		decLineKind="answer" ; decWho="${decAmendBy:-$decWho}" ; decVerdict="amended: $decVerdict"
	fi
	decText="${decTag:+$decTag }$( AgentsToolsDecisionsOneLine "$( printf '%s\n' "$decFirst" | LC_ALL=C awk '$0 !~ /^#/ && $0 !~ /^[ \t]*$/ { print ; exit ; }' )" 160 ) -> ${decVerdict:-(answered; the answer text was not recorded)}"
	[ "$decStatus" != "reply-received" ] || [ -n "$decAmend" ] || decMentions="$decId $decQts $decTts"
	type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
	[ -z "$decItem" ] || DistroAgentsTools --intern-op-decisions-append "$decWho" "$decItem" --kind "$decLineKind" --text "$decText" \
		--source "$decId${decAnswerTs:+, ${decChannel:+$decChannel:}$decAnswerTs}" \
		$( for decKey in $decMentions ; do printf -- '--clear-if-mentions %s ' "$decKey" ; done ) \
		--context "${MDSC_CMD:-pending-reply-close}" > /dev/null 2>&1 \
		|| echo "${MDSC_CMD:-pending-reply-close}: ⚠️ WARNING: $decId is closed, but its outcome was not recorded on item $decItem's Decisions" >&2
	## Every other open item that waits on the ask by name gets the same line, its source naming the item the ask was filed
	## on, and its blocker naming the ask cleared where the ask was answered: an item learns an answer whatever item it was
	## asked for.
	local decWaiter decTracked=""
	[ -z "$decItem" ] || decTracked="$( AgentsToolsDecisionsTracked "$( AgentsToolsDecisionsItemPath "$decItem" )" )" || decTracked=""
	for decWaiter in $( AgentsToolsDecisionsWaitersOf "$decId" "$decItem" "${decTracked##*/}" ) ; do
		DistroAgentsTools --intern-op-decisions-append "$decWho" "$decWaiter" --kind "$decLineKind" --text "$decText" \
			--source "$decId${decItem:+, asked on $decItem}" \
			$( for decKey in $decMentions ; do printf -- '--clear-if-mentions %s ' "$decKey" ; done ) \
			--context "${MDSC_CMD:-pending-reply-close}" > /dev/null 2>&1 \
			|| echo "${MDSC_CMD:-pending-reply-close}: ⚠️ WARNING: $decId is closed, but its outcome was not recorded on item $decWaiter, which waits on it" >&2
	done
	return 0
}

## One slot of a pending-reply record's post, as kept beside it (`<id>.fields`, AgentsToolsAskPostFieldsPack): a doubled
## backslash read back as one. Empty where the record keeps no such slot.
AgentsToolsDecisionReadbackSlot(){ ## record file, slot
	local slotValue
	slotValue="$( LC_ALL=C awk -F'\t' -v key="$2" '$1 == key { print substr( $0, length( key ) + 2 ) ; exit ; }' "${1%.md}.fields" 2> /dev/null )"
	printf '%s' "${slotValue//\\\\/\\}"
}

## One text as a JSON string, quotes included.
AgentsToolsDecisionJsonText(){ ## text
	local jsonText="$1"
	jsonText="${jsonText//\\/\\\\}" ; jsonText="${jsonText//\"/\\\"}"
	jsonText="${jsonText//$'\t'/\\t}" ; jsonText="${jsonText//$'\r'/\\r}" ; jsonText="${jsonText//$'\n'/\\n}"
	printf '"%s"' "$jsonText"
}

## A decision asked before it is recorded: its exact text read back to its party, whose answer lands it (AgentsToolsDecisionsFromPending).
## One closing line: DECISION-RECORDED, DECISION-ASKED, DECISION-ESCALATED or DECISION-NOT-RECORDED. rc 1 where nothing was asked.
## A contact decides a decision itself where the team gives it the rights over the team's work: tier-admin or tier-owner, its
## team-wide tier read from its record. A board item names no project, so a project's own tier is not read yet. rc 0 where it decides.
AgentsToolsDecisionPartyDecides(){ ## party, written contact:<id> for a contact, item path (its projects and products are the scopes read)
	local pdScope
	case "$1" in contact:?*) ;; *) return 1 ;; esac
	type AgentsToolsContactsStore > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/contacts/AgentsTools.ContactsRecord.include"
	type AgentsToolsContactsTierFor > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/contacts/AgentsTools.ContactsTiers.include"
	AgentsToolsContactsSlug "${1#contact:}" 2> /dev/null || return 1
	AgentsToolsContactsStore decision-readback 2> /dev/null || return 1
	AgentsToolsContactsPersonRead "$contactsPersons/${1#contact:}.md" || return 1
	for pdScope in "" $( [ ! -f "${2:-}" ] || LC_ALL=C awk 'NR == 1 && $0 == "---" { inFm = 1 ; next ; } inFm && $0 == "---" { exit ; } inFm && /^(projects|products): / { sub( /^[a-z]+: /, "" ) ; gsub( /,/, " " ) ; print ; }' "$2" ) ; do
		case "$( AgentsToolsContactsTierFor "$pdScope" )" in tier-admin|tier-owner) return 0 ;; esac
	done
	return 1
}

## The same for the account that answered a readback: the contact whose `slack-id` it is, by its tier. rc 0 where it decides.
AgentsToolsDecisionAccountDecides(){ ## account, item path (its projects and products are the scopes read)
	local adFile
	[ -n "$1" ] || return 1
	type AgentsToolsContactsStore > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/contacts/AgentsTools.ContactsRecord.include"
	AgentsToolsContactsStore decision-readback 2> /dev/null || return 1
	for adFile in "$contactsPersons"/*.md ; do
		[ -f "$adFile" ] || continue
		## A coordinate is written bare, `URIGADMIN1`, or with the team it is on, `client-ndm:URIGADMIN1`, and the
		## store writes the labelled form. The account is the same one either way, and a record holding several is
		## read one by one.
		LC_ALL=C awk -v want="$1" '
			$0 == "---" { fence++ ; if ( fence > 1 ) { exit ; } ; next ; }
			fence == 1 && /^(slack-id|slack-conversation): / {
				coordinate = $0 ;
				sub( /^[a-z-]+: /, "", coordinate ) ;
				held = split( coordinate, oneValue, "," ) ;
				for ( valueAt = 1 ; valueAt <= held ; valueAt++ ) {
					value = oneValue[valueAt] ;
					gsub( /^[[:space:]]+|[[:space:]]+$/, "", value ) ;
					sub( /^[^:]+:/, "", value ) ;
					if ( value == want ) { found = 1 ; exit ; }
				}
			}
			END { exit found ? 0 : 1 }
		' "$adFile" 2> /dev/null || continue
		adFile="${adFile##*/}"
		! AgentsToolsDecisionPartyDecides "contact:${adFile%.md}" "${2:-}" || return 0
	done
	return 1
}

## A strike is asked the same way (kind strike, the struck line last): its reason is what is read back, and its answer strikes the line.
AgentsToolsDecisionReadbackOpen(){ ## member, item, kind, text, source (may be empty), party, wait (true|false), the line to strike (strike only)
	local roItem="${2##*/}" roJson roOut roId roFile roStatus roVerdict roBy roPath="" roTitle=""
	roItem="${roItem%.md}"
	## The person reads the item by its heading; its id goes in the context.
	roPath="$( AgentsToolsDecisionsItemPath "$roItem" 2> /dev/null )" || roPath=""
	[ -z "$roPath" ] || roTitle="$( LC_ALL=C awk '/^# / { sub( /^# +/, "" ) ; print ; exit ; }' "$roPath" 2> /dev/null )"
	roTitle="${roTitle:-the task in the context}"
	## The human-owner, a party of the item and a contact with rights decide it; anyone else confirms, and it goes up to him.
	local roEscalate=""
	## The human-owner decides, by name or by his own account on this workspace (SLACK_CHANNEL_HUMAN_OWNER): a party that is his account is him.
	type AgentsToolsPermissionIsHumanOwner > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.PermissionHolds.include"
	if { [ -z "${8:-}" ] || [ "$3" = review ] ; } && ! AgentsToolsPermissionIsHumanOwner "$6" && ! { [ "$3" != review ] && [ -n "$roPath" ] && AgentsToolsItemIsParty "$roPath" "$6" ; } && ! AgentsToolsDecisionPartyDecides "$6" "$roPath" ; then
		roEscalate="human-owner"
	fi
	roJson="{\"to\":$( AgentsToolsDecisionJsonText "$6" ),\"address_to\":$( AgentsToolsDecisionJsonText "$6" )"
	if [ -n "${8:-}" ] && [ "$3" != review ] ; then
		roJson="$roJson,\"question\":$( AgentsToolsDecisionJsonText "May a decision on $roTitle be dropped, for the reason below?" )"
		roJson="$roJson,\"context\":$( AgentsToolsDecisionJsonText "Board item $roItem. The decision to drop: $8" )"
		roJson="$roJson,\"understood\":$( AgentsToolsDecisionJsonText "$4" )"
		roJson="$roJson,\"source\":$( AgentsToolsDecisionJsonText "${5:-the strike $1 asks on $roTitle}" )"
		roJson="$roJson,\"will_do\":$( AgentsToolsDecisionJsonText "Mark that decision struck on the task with this reason, naming you and the time. Nothing is deleted. A no keeps it." )"
	elif [ "$3" = review ] ; then
		roJson="$roJson,\"question\":$( AgentsToolsDecisionJsonText "Which of these unconfirmed decisions on $roTitle stand?" )"
		roJson="$roJson,\"context\":$( AgentsToolsDecisionJsonText "Board item $roItem. No line below has a confirmed readback behind it. Each line carries the action proposed for it: confirm keeps it as yours, prune strikes it, and re-ask strikes it and asks its text again." )"
		roJson="$roJson,\"understood\":$( AgentsToolsDecisionJsonText "$4" )"
		roJson="$roJson,\"source\":$( AgentsToolsDecisionJsonText "${5:-the review $1 asks on $roTitle}" )"
		roJson="$roJson,\"will_do\":$( AgentsToolsDecisionJsonText "yes: each line gets its listed action. edit: name the lines to change, such as 3 confirm, 5 prune, and the rest get their listed action. no: nothing changes.${roEscalate:+ You do not hold the rights over this task, so once you answer, the list goes to the $roEscalate to decide.}" )"
	else
		roJson="$roJson,\"question\":$( AgentsToolsDecisionJsonText "Is this the decision on $roTitle, as you made it?" )"
		roJson="$roJson,\"context\":$( AgentsToolsDecisionJsonText "Board item $roItem." )"
		roJson="$roJson,\"understood\":$( AgentsToolsDecisionJsonText "$4" )"
		roJson="$roJson,\"source\":$( AgentsToolsDecisionJsonText "${5:-the decision $1 made with you on $roTitle}" )"
		if [ -n "$roEscalate" ] ; then
			roJson="$roJson,\"will_do\":$( AgentsToolsDecisionJsonText "Once you confirm it, it goes to the $roEscalate to decide, since you do not hold the rights over this task. Nothing is recorded before that. An edit sends your words instead. A no ends it here." )"
		else
			roJson="$roJson,\"will_do\":$( AgentsToolsDecisionJsonText "Record it on that task as a $3, naming you and the time. An edit records your words instead. A no records nothing." )"
		fi
	fi
	roJson="$roJson,\"wait\":$7}"
	roOut="$( printf '%s' "$roJson" | env MDAT_ASK_DECISION_KIND="$3" MDAT_ASK_DECISION_ITEM="$roItem" MDAT_ASK_DECISION_SOURCE="${5:-}" MDAT_ASK_DECISION_STRIKE="${8:-}" MDAT_ASK_DECISION_ESCALATE="$roEscalate" MDAT_SPAWN_AGENT="$1" \
		"$BASH" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsUniversalHarness.sh" --intern-tool ConfirmReadback )"
	printf '%s\n' "$roOut"
	## Asked means recorded: with no record, nothing was asked, and the harness said why above.
	roId="$( printf '%s\n' "$roOut" | LC_ALL=C grep -o -E '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}' | head -1 )"
	type AgentsToolsPendingRecordPath > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.PendingPaths.include"
	if [ -z "$roId" ] || ! roFile="$( AgentsToolsPendingRecordPath "$roId" )" ; then
		printf 'DECISION-NOT-ASKED %s: no readback was recorded, so nothing was asked or recorded; what the ask said is above\n' "$roItem"
		return 1
	fi
	roStatus="$( AgentsToolsDecisionsField "$roFile" status )"
	roVerdict="$( AgentsToolsDecisionsField "$roFile" verdict )" ; roBy="$( AgentsToolsDecisionsField "$roFile" answered-by )"
	roPath="$( AgentsToolsDecisionsItemPath "$roItem" 2> /dev/null )" || roPath=""
	if [ -n "$roPath" ] && LC_ALL=C grep -q -F -- "(readback $roId," "$roPath" 2> /dev/null ; then
		printf 'DECISION-RECORDED %s (readback %s, %s by %s)\n' "$roItem" "$roId" "$roVerdict" "${roBy:-unknown}"
	elif [ -n "$( AgentsToolsDecisionReadbackSlot "$roFile" escalated )" ] ; then
		printf 'DECISION-ESCALATED %s: %s confirmed it, and it went to the %s as readback %s. It lands on %s once that is confirmed, by itself.\n' "$roId" "$6" "$roEscalate" "$( AgentsToolsDecisionReadbackSlot "$roFile" escalated )" "$roItem"
	elif [ "$roStatus" = reply-pending ] ; then
		[ -z "$roEscalate" ] || printf 'NOTE: %s does not hold the rights over %s, so once confirmed the decision goes to the %s to decide.\n' "$6" "$roItem" "$roEscalate"
		printf 'DECISION-ASKED %s %s: it lands on %s once they confirm or edit it, by itself, and a no lands nothing. Its answer reaches you on your session floor and by Wait sources=ask:%s.\n' "$roId" "$6" "$roItem" "$roId"
	else
		printf 'DECISION-NOT-RECORDED %s: %s by %s, so nothing is on %s. Work the decision out with %s again, then ask it again.\n' "$roId" "${roVerdict:-${roStatus:-no answer}}" "${roBy:-nobody}" "$roItem" "$6"
	fi
	return 0
}

## The open items that wait on an ask by name, one a line: those of the backlog and the active states whose `condition:` or
## `blocked-on:` names its id, but the items named (the one the ask is filed on and the one that item tracks, which their own
## append covers). One awk pass, no process per item.
AgentsToolsDecisionsWaitersOf(){ ## ask id, item name the ask is filed on (may be empty), item that item tracks (may be empty)
	local waitItems
	[ -n "${1:-}" ] || return 0
	type AgentsToolsBoardReady > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.BoardStates.include"
	AgentsToolsBoardItemsInto waitItems "" backlog $agentsBoardActiveStates || return 0
	[ "${#waitItems[@]}" -gt 0 ] || return 0
	LC_ALL=C awk -v id="$1" -v own="${2%.md}" -v tracked="${3%.md}" '
		FNR == 1 { fence = 0 ; name = FILENAME ; sub( /^.*\//, "", name ) ; sub( /\.md$/, "", name ) ; }
		$0 == "---" { fence++ ; if ( fence > 1 ) nextfile ; next ; }
		fence == 1 && ( index( $0, "condition: " ) == 1 || index( $0, "blocked-on: " ) == 1 ) && index( $0, id ) && name != own && name != tracked { print name ; nextfile ; }
	' "${waitItems[@]}" 2> /dev/null || :
}

## The line an answered ask appends to a status, `<id> answered <verdict> by <who> at <time>`, from its closed record: an amended
## one's correction, its giver and its moment. rc 1, printing nothing, for a record with no verdict: unanswered, withdrawn or unknown.
AgentsToolsDecisionsStatusLine(){ ## pending id, record file
	local lineKey lineValue lineStatus="" lineVerdict="" lineBy="" lineAt="" lineAmendBy="" lineAmendAt=""
	while IFS=$'\t' read -r lineKey lineValue ; do
		case "$lineKey" in
			status) lineStatus="$lineValue" ;;
			verdict) lineVerdict="$lineValue" ;;
			answered-by) lineBy="$lineValue" ;;
			resolved-at) lineAt="$lineValue" ;;
			amended-by) lineAmendBy="$lineValue" ;;
			amended-at) lineAmendAt="$lineValue" ;;
		esac
	done < <( LC_ALL=C awk '$0 == "---" { if ( ++dashes == 2 ) { exit ; } next ; } dashes == 1 { colon = index( $0, ": " ) ; if ( colon > 1 ) { printf "%s\t%s\n", substr( $0, 1, colon - 1 ), substr( $0, colon + 2 ) ; } ; }' "$2" 2> /dev/null )
	[ "$lineStatus" = reply-received ] && [ -n "$lineVerdict" ] || return 1
	printf '%s answered %s by %s at %s' "$1" "$( AgentsToolsDecisionsOneLine "$lineVerdict" 160 )" "${lineAmendBy:-${lineBy:-unknown}}" "${lineAmendAt:-${lineAt:-unknown}}"
}

## The open items whose `status:` or `condition:` names an ask, one `<item path><TAB><first eight characters of its id>` a line: an
## id whole or by its short form alike, standing as its own word; only <id>'s where one is given. One awk pass over the backlog and
## the active states.
AgentsToolsDecisionsStatusNamers(){ ## ask id (empty for every one)
	local namerItems
	type AgentsToolsBoardReady > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.BoardStates.include"
	AgentsToolsBoardItemsInto namerItems "" backlog $agentsBoardActiveStates || return 0
	[ "${#namerItems[@]}" -gt 0 ] || return 0
	LC_ALL=C awk -v wantHead="${1:0:8}" '
		FNR == 1 { fence = 0 ; }
		$0 == "---" { fence++ ; if ( fence > 1 ) { nextfile ; } next ; }
		fence == 1 && ( index( $0, "status: " ) == 1 || index( $0, "condition: " ) == 1 ) {
			restText = " " substr( $0, index( $0, ": " ) + 2 ) " " ;
			while ( match( restText, /[^A-Za-z0-9][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][^A-Za-z0-9]/ ) ) {
				idHead = substr( restText, RSTART + 1, 8 ) ;
				restText = substr( restText, RSTART + 9 ) ;
				if ( wantHead != "" && idHead != wantHead ) { continue ; }
				if ( ! ( ( FILENAME SUBSEP idHead ) in seenPair ) ) { seenPair[ FILENAME SUBSEP idHead ] = 1 ; printf "%s\t%s\n", FILENAME, idHead ; }
			}
		}
	' "${namerItems[@]}" 2> /dev/null || :
}

## One line appended to an open item's `status:` through the board writer: never a move and never a body edit, and nothing where
## the status already holds that line. Prints `STATUS-ANSWERED <item> <state> <id>`; with <dry> set it writes nothing and prints
## `STATUS-STALE <item> <state> <id>`. rc 1 where the edit failed.
AgentsToolsDecisionsStatusAppend(){ ## item path, the line, pending id, dry (1 or empty)
	local statName="${1##*/}" statPath="$1" statState statOld statLock="" statRc=0
	case "$( AgentsToolsDecisionsField "$statPath" status )" in *"$2"*) return 0 ;; esac
	statState="${statPath%/*}" ; statState="${statState##*/}"
	if [ -n "${4:-}" ] ; then
		printf 'STATUS-STALE %s %s %s\n' "${statName%.md}" "$statState" "$3"
		return 0
	fi
	type AgentsToolsBoardReady > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.BoardStates.include"
	. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/common/AgentsTools.LocalLock.include"
	AgentsToolsLocalLockTake "decisions-${statName%.md}" 30 "the Decisions of $statName" && statLock="$agentsLocalLockPath" \
		|| echo "⚠️ WARNING: ${MDSC_CMD:-status-append}: the lock on $statName could not be taken; writing its status without it" >&2
	## Read under the lock: the item may have left the open states, or have the line from another writer, since it was found.
	statPath="$( AgentsToolsDecisionsItemPath "$statName" )" || { [ -z "$statLock" ] || AgentsToolsLocalLockGive "$statLock" ; return 1 ; }
	statState="${statPath%/*}" ; statState="${statState##*/}"
	statOld="$( AgentsToolsDecisionsField "$statPath" status )"
	case " backlog $agentsBoardActiveStates " in *" $statState "*) ;; *) [ -z "$statLock" ] || AgentsToolsLocalLockGive "$statLock" ; return 0 ;; esac
	case "$statOld" in *"$2"*) [ -z "$statLock" ] || AgentsToolsLocalLockGive "$statLock" ; return 0 ;; esac
	type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
	DistroAgentsTools --intern-op-board-upsert-move-edit "$statState" "$statName" --from-state:"$statState" \
		--header:upsert:status:"${statOld:+$statOld | }$2" --context "${MDSC_CMD:-status-append}" --log-verb:updated > /dev/null 2>&1 < /dev/null || statRc=$?
	[ -z "$statLock" ] || AgentsToolsLocalLockGive "$statLock"
	if [ "$statRc" != 0 ] ; then
		echo "${MDSC_CMD:-status-append}: ⛔ ERROR: the board edit of $statName failed, so its status still lacks: $2" >&2
		return 1
	fi
	printf 'STATUS-ANSWERED %s %s %s\n' "${statName%.md}" "$statState" "$3"
}

## AN ANSWER REACHES THE STATUS OF EVERY OPEN ITEM THAT NAMES ITS ASK: its record's own `item:`, and each item whose `status:` or
## `condition:` names its id, gets its line (AgentsToolsDecisionsStatusAppend). Best effort: a failed edit is said, and never undoes the close.
AgentsToolsDecisionsStatusFromPending(){ ## pending id, record file
	local fromLine fromItem fromPath fromHead fromDone=" "
	fromLine="$( AgentsToolsDecisionsStatusLine "$1" "$2" )" || return 0
	type AgentsToolsBoardReady > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.BoardStates.include"
	fromItem="$( AgentsToolsDecisionsField "$2" item )"
	if [ -n "$fromItem" ] && AgentsToolsBoardItemInStates "$fromItem" backlog $agentsBoardActiveStates && fromPath="$( AgentsToolsDecisionsItemPath "$fromItem" )" ; then
		fromDone=" $fromPath "
		AgentsToolsDecisionsStatusAppend "$fromPath" "$fromLine" "$1" > /dev/null || :
	fi
	while IFS=$'\t' read -r fromPath fromHead ; do
		case "$fromDone" in *" $fromPath "*) continue ;; esac
		fromDone="$fromDone$fromPath "
		AgentsToolsDecisionsStatusAppend "$fromPath" "$fromLine" "$1" > /dev/null || :
	done < <( AgentsToolsDecisionsStatusNamers "$1" )
	return 0
}

## One clarification or correction on a question's answer, as a `clarification` line on the
## Decisions of the item the question belongs to: who wrote it, its text, and the question it
## is on by its pending id. Best effort, as for the answer line: a record with no item records
## nothing here, and a board edit that fails is logged.
AgentsToolsDecisionsClarification(){ ## pending id, record file, author, text, message ts
	local clItem clTag clChannel
	[ -f "$2" ] || return 0
	clItem="$( AgentsToolsDecisionsField "$2" item )"
	[ -n "$clItem" ] || return 0
	## The asking account's own posts in the thread are the ask itself, never a clarification.
	case " $( AgentsToolsDecisionsField "$2" asking-accounts ) " in *" ${3:-unknown} "*) return 0 ;; esac
	clTag="$( AgentsToolsDecisionsField "$2" question-tag )"
	clChannel="$( AgentsToolsDecisionsField "$2" channel )"
	type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
	DistroAgentsTools --intern-op-decisions-append "${3:-unknown}" "$clItem" --kind clarification \
		--text "on $1${clTag:+ ($clTag)}: $4" --source "${5:+${clChannel:+$clChannel:}$5}" \
		--context "${MDSC_CMD:-pending-reply-clarify}" > /dev/null 2>&1 \
		|| echo "${MDSC_CMD:-pending-reply-clarify}: ⚠️ WARNING: a clarification on $1 was kept on its record, but not on item $clItem's Decisions" >&2
	return 0
}

## The awk program the board edit runs to add one line: at the end of the item's own
## `## Decisions` section, or as a new marked section at the end. The line and the marker
## come from MDAT_DECISIONS_LINE and MDAT_DECISIONS_MARKER, so no text of them is ever part
## of a program.
agentsDecisionsAppendAwk="$agentsDecisionsOwnAwk"'
	{ line[NR] = $0 ; }
	END {
		add = ENVIRON["MDAT_DECISIONS_LINE"] ; marker = ENVIRON["MDAT_DECISIONS_MARKER"] ;
		start = ( marker == "" ? 0 : decisionsOwn( NR, marker ) ) ;
		if ( start ) {
			last = decisionsEnd( NR, start ) ;
			for ( i = 1 ; i <= NR ; i++ ) {
				print line[i] ;
				if ( i == last ) { if ( last == start || line[last] == marker ) { print "" ; } print add ; }
			}
		} else {
			n = NR ; while ( n > 0 && line[n] ~ /^[ \t]*$/ ) { n-- ; }
			for ( i = 1 ; i <= n ; i++ ) { print line[i] ; }
			print "" ; print "## Decisions" ; print marker ; print "" ; print add ;
		}
	}
'

## Appends one line to an item's Decisions, through the board edit primitive, under a lock
## per item. Clears `blocked-on` and `condition` when <clear> is `all`, or each one whose
## text names any of the space-separated <mentions>. rc 1 when the item is not on the board
## or the edit failed; prints `DECISION-RECORDED <item> <state>` and any `BLOCKER-CLEARED <field>`.
AgentsToolsDecisionsAppend(){ ## who, item, kind, text, source, clear (all|empty), mentions
	local appWho="$1" appItem="$2" appKind="$3" appText="$4" appSource="$5" appClear="$6" appMentions="$7"
	local appPath appState appName appLine appLock="" appField appValue appMention appRc=0 appHeaders=() appCleared=""
	case "$agentsDecisionsKinds" in *" $appKind "*) ;; *) echo "$MDSC_CMD: ⛔ ERROR: kind must be one of:$agentsDecisionsKinds-- got: ${appKind:-<none>}" >&2 ; return 1 ;; esac
	appPath="$( AgentsToolsDecisionsItemPath "$appItem" )" || { echo "$MDSC_CMD: ⛔ ERROR: no board item $appItem in any board state, so no decision was recorded" >&2 ; return 1 ; }
	appName="${appPath##*/}" ; appState="${appPath%/*}" ; appState="${appState##*/}"
	appWho="$( AgentsToolsDecisionsOneLine "$appWho" 80 )" ; appWho="${appWho%% *}"
	appText="$( AgentsToolsDecisionsOneLine "$appText" 300 )"
	[ -n "$appText" ] || { echo "$MDSC_CMD: ⛔ ERROR: the decision text is empty, so nothing was recorded" >&2 ; return 1 ; }
	## The source is the line's provenance -- the readback, who confirmed it and when, and what it went up from -- so it is kept as long as its text.
	appSource="$( AgentsToolsDecisionsOneLine "$appSource" 300 )"
	appLine="- $( date -u +%Y-%m-%dT%H:%MZ ) ${appWho:-unknown} $appKind: $appText${appSource:+ ($appSource)}"
	. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/common/AgentsTools.LocalLock.include"
	AgentsToolsLocalLockTake "decisions-${appName%.md}" 30 "the Decisions of $appName" && appLock="$agentsLocalLockPath" \
		|| echo "⚠️ WARNING: $MDSC_CMD: the Decisions lock on $appName could not be taken; recording without it" >&2
	## Read under the lock: the item may have moved state since it was found.
	appPath="$( AgentsToolsDecisionsItemPath "$appItem" )" || { [ -z "$appLock" ] || AgentsToolsLocalLockGive "$appLock" ; return 1 ; }
	appState="${appPath%/*}" ; appState="${appState##*/}"
	for appField in blocked-on condition ; do
		appValue="$( AgentsToolsDecisionsField "$appPath" "$appField" )"
		[ -n "$appValue" ] || continue
		if [ "$appClear" = "all" ] ; then
			appHeaders+=( "--header:remove:$appField" ) ; appCleared="$appCleared $appField"
			continue
		fi
		for appMention in $appMentions ; do
			case "$appValue" in
				*"$appMention"*) appHeaders+=( "--header:remove:$appField" ) ; appCleared="$appCleared $appField" ; break ;;
			esac
		done
	done
	type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
	printf '%s' "$agentsDecisionsAppendAwk" | MDAT_DECISIONS_LINE="$appLine" MDAT_DECISIONS_MARKER="$( markerName="${appName##*/}" ; printf '<!-- decisions-of: %s -->\n' "${markerName%.md}" )" DistroAgentsTools --intern-op-board-upsert-move-edit "$appState" "$appName" \
		--from-state:"$appState" --edit-script-from-stdin:awk "${appHeaders[@]+"${appHeaders[@]}"}" \
		--context "${MDSC_CMD:-decisions-append}" --log-verb:updated || appRc=$?
	[ -z "$appLock" ] || AgentsToolsLocalLockGive "$appLock"
	if [ "$appRc" != "0" ] ; then
		echo "$MDSC_CMD: ⛔ ERROR: the board edit of $appName failed, so the decision was not recorded" >&2
		return 1
	fi
	printf 'DECISION-RECORDED %s %s\n' "${appName%.md}" "$appState"
	for appField in $appCleared ; do printf 'BLOCKER-CLEARED %s\n' "$appField" ; done
	return 0
}

## The awk program the strike runs: it marks one stored line struck, and refuses where that line
## stands not on the item, or already carries a mark. The line and the mark come from
## MDAT_DECISIONS_BASE and MDAT_DECISIONS_MARK, so no text of them is ever part of a program.
agentsDecisionsStrikeAwk="$agentsDecisionsOwnAwk"'
	{ line[NR] = $0 ; }
	END {
		base = ENVIRON["MDAT_DECISIONS_BASE"] ; mark = ENVIRON["MDAT_DECISIONS_MARK"] ; marker = ENVIRON["MDAT_DECISIONS_MARKER"] ;
		## A line named with its backfill suffix is the same line.
		base = struckBase( base ) ;
		start = ( marker == "" ? 0 : decisionsOwn( NR, marker ) ) ;
		if ( ! start ) { printf "⛔ ERROR: %s: no Decisions section, so no line was struck\n", ENVIRON["MDAT_DECISIONS_CMD"] > "/dev/stderr" ; exit 1 ; }
		last = decisionsEnd( NR, start ) ;
		for ( i = start + 1 ; i <= last ; i++ ) {
			if ( line[i] !~ /^- / ) { continue ; }
			if ( struckBase( line[i] ) != base ) { continue ; }
			if ( line[i] ~ / \[struck by [^]]*\]$/ ) { printf "⛔ ERROR: %s: that line is already struck\n", ENVIRON["MDAT_DECISIONS_CMD"] > "/dev/stderr" ; exit 1 ; }
			if ( index( mark, " [confirmed by " ) == 1 && line[i] ~ / \[confirmed by [^]]*\]$/ ) { printf "⛔ ERROR: %s: that line is already confirmed\n", ENVIRON["MDAT_DECISIONS_CMD"] > "/dev/stderr" ; exit 1 ; }
			line[i] = line[i] mark ; found = 1 ;
		}
		if ( ! found ) { printf "⛔ ERROR: %s: no line of its Decisions is exactly that text, so nothing was struck\n", ENVIRON["MDAT_DECISIONS_CMD"] > "/dev/stderr" ; exit 1 ; }
		for ( i = 1 ; i <= NR ; i++ ) { print line[i] ; }
	}
'

## Struck through a recorded line, never deleted: the line stays in place carrying ` [struck by <who>: <reason>]`,
## so a correction reads beside what it corrects. rc 1 when the item is not on the board, no line of its
## own Decisions is exactly that text, or the edit failed; prints `DECISION-STRUCK <item> <state>`. The dismissed line
## names its source: the readback that confirmed the strike, who confirmed it and when, so that readback strikes once.
AgentsToolsDecisionsStrike(){ ## who, item, the exact line, the reason, source (the confirming readback), the confirmation mark to set instead of a strike
	local strikeWho="$1" strikeItem="$2" strikeLine strikeWhy="${3:-}" strikeText="${4:-}"
	## The line is matched whole, as long as it is: a cut copy matches no stored line.
	strikeLine="${3//$'\n'/ }" ; strikeWhy="$( AgentsToolsDecisionsOneLine "$4" 160 )"
	strikeWho="$( AgentsToolsDecisionsOneLine "$strikeWho" 80 )" ; strikeWho="${strikeWho%% *}"
	local strikePath strikeState strikeName strikeLock="" strikeRc=0 strikeMark
	[ -n "$strikeLine" ] || { echo "$MDSC_CMD: ⛔ ERROR: the line to strike is empty, so nothing was struck" >&2 ; return 1 ; }
	[ -n "$strikeWhy" ] || { echo "$MDSC_CMD: ⛔ ERROR: --reason is required to strike a recorded line" >&2 ; return 1 ; }
	strikePath="$( AgentsToolsDecisionsItemPath "$strikeItem" )" || { echo "$MDSC_CMD: ⛔ ERROR: no board item $strikeItem in any board state, so nothing was struck" >&2 ; return 1 ; }
	strikeName="${strikePath##*/}"
	strikeMark="${6:- [struck by ${strikeWho:-unknown}: $strikeWhy]}"
	. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/common/AgentsTools.LocalLock.include"
	AgentsToolsLocalLockTake "decisions-${strikeName%.md}" 30 "the Decisions of $strikeName" && strikeLock="$agentsLocalLockPath" \
		|| echo "⚠️ WARNING: $MDSC_CMD: the Decisions lock on $strikeName could not be taken; striking without it" >&2
	strikePath="$( AgentsToolsDecisionsItemPath "$strikeItem" )" || { [ -z "$strikeLock" ] || AgentsToolsLocalLockGive "$strikeLock" ; return 1 ; }
	strikeState="${strikePath%/*}" ; strikeState="${strikeState##*/}"
	type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
	printf '%s' "$agentsDecisionsStrikeAwk" | MDAT_DECISIONS_BASE="$strikeLine" MDAT_DECISIONS_MARK="$strikeMark" MDAT_DECISIONS_CMD="$MDSC_CMD" \
		MDAT_DECISIONS_MARKER="$( markerName="${strikeName##*/}" ; printf '<!-- decisions-of: %s -->\n' "${markerName%.md}" )" \
		DistroAgentsTools --intern-op-board-upsert-move-edit "$strikeState" "$strikeName" \
		--from-state:"$strikeState" --edit-script-from-stdin:awk \
		--context "${MDSC_CMD:-decisions-strike}" --log-verb:updated || strikeRc=$?
	[ -z "$strikeLock" ] || AgentsToolsLocalLockGive "$strikeLock"
	if [ "$strikeRc" != "0" ] ; then
		echo "$MDSC_CMD: ⛔ ERROR: the board edit of $strikeName failed, so no line was struck" >&2
		return 1
	fi
	if [ -n "${6:-}" ] ; then
		printf 'DECISION-CONFIRMED %s %s\n' "${strikeName%.md}" "$strikeState"
		return 0
	fi
	## The mark stays in place, and one dismissed line records the text, the reason and who struck it.
	AgentsToolsDecisionsAppend "$strikeWho" "$strikeName" dismissed "the line struck: $strikeLine -- ${strikeWhy}" "${5:-strike confirmed}" "" "" > /dev/null \
		|| echo "⚠️ WARNING: $MDSC_CMD: $strikeName carries the strike, but its dismissed line was not recorded" >&2
	printf 'DECISION-STRUCK %s %s\n' "${strikeName%.md}" "$strikeState"
	## A FAKE, DROPPED, IS ASKED AGAIN where it still binds: a line with no confirmed readback behind it never was a decision, so the
	## caller is told how to put it to the one it was made with.
	case "$strikeLine" in
		*"(readback "*", confirmed by "*) ;;
		*"(his message slack:"*", by "*) ;;
		*) printf 'NEXT: the struck line had no confirmed readback, so it was never a decision. Where it still binds, ask it again: --record-decision %s --kind <clarification|resolved|dismissed> --text "<its text>" --with <the one it was made with>\n' "${strikeName%.md}" ;;
	esac
	return 0
}

## HIS OWN MESSAGE IS HIS DECISION (): where the source's first part names a Slack message, `slack:<channel>:<ts>`,

## that the comms cache holds and whose author is the human-owner's own account here, it prints the provenance
## `his message slack:<channel>:<ts>, by <account> at <time>`, rc 0. Anything else, or a message the cache does not hold, is rc 1.
AgentsToolsDecisionSourceOwnerMessage(){ ## source
	local somFirst="${1%%,*}" somRest somChannel somTs somLine="" somUser="" somDir somAt
	case "$somFirst" in slack:*:*) ;; *) return 1 ;; esac
	somRest="${somFirst#slack:}" ; somChannel="${somRest%%:*}" ; somTs="${somRest#*:}"
	case "$somChannel" in ''|*[!A-Za-z0-9]*) return 1 ;; esac
	case "$somTs" in ''|*[!0-9.]*) return 1 ;; esac
	for somDir in "${MMDAPP:-}"/.local/cache/comms/slack/slack-*"$somChannel"* ; do
		[ -d "$somDir" ] || continue
		somLine="$( LC_ALL=C awk -v ts="$somTs" 'index( $0, ts " | " ) == 1 { print ; exit ; }' "$somDir"/*/messages.txt 2> /dev/null )"
		[ -n "$somLine" ] || continue
		somUser="${somLine#"$somTs | "}" ; somUser="${somUser%% |*}"
		break
	done
	case "$somUser" in ''|*[!A-Z0-9]*) return 1 ;; esac
	type AgentsToolsPermissionIsHumanOwner > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.PermissionHolds.include"
	AgentsToolsPermissionIsHumanOwner "$somUser" || return 1
	somAt="$( LC_ALL=C date -u -r "${somTs%%.*}" +%Y-%m-%dT%H:%MZ 2> /dev/null || LC_ALL=C date -u -d "@${somTs%%.*}" +%Y-%m-%dT%H:%MZ 2> /dev/null )"
	printf 'his message %s, by %s at %s\n' "$somFirst" "$somUser" "${somAt:-unknown}"
}

## AgentsToolsDecisionsAppend, and then the same line on the item it `tracks:` (the task a
## dispatch item works on), so a later dispatch on that task finds it. One level only: the
## tracked item's own `tracks:` is never followed. The tracked line names the dispatch in its
## source; only the blockers that name the ask (<mentions>) are cleared there, never `all`.
## rc is the first append's: a tracked append that fails is a warning.
AgentsToolsDecisionsAppendTracked(){ ## who, item, kind, text, source, clear (all|empty), mentions
	local atPath atTracked atName
	AgentsToolsDecisionsAppend "$@" || return 1
	atPath="$( AgentsToolsDecisionsItemPath "$2" )" && atTracked="$( AgentsToolsDecisionsTracked "$atPath" )" || return 0
	atName="${atPath##*/}" ; atName="${atName%.md}"
	AgentsToolsDecisionsAppend "$1" "${atTracked##*/}" "$3" "$4" "${5:+$5, }via $atName" "" "$7" \
		|| echo "⚠️ WARNING: $MDSC_CMD: the decision is on $atName, but not on the item it tracks, ${atTracked##*/}" >&2
	return 0
}
