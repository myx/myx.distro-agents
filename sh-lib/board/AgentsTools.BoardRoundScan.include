#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.BoardRoundScan.include -- the sections of a scan that a round of the board's rules reads (F7.12): the board's items of the
## active states, the review items addressed to the advance routine, the registries of sessions, and the documents due a round.
## The coordinator's work-duty scan prints them from here -- the scan the work-duty, the manual start of the advance routine and the daily declare -- so there is
## one reading of the board for the rules of magic-team.advance.routine, wherever they are run. (The advance scan, --intern-op-advance-input-scan, is retired.)
## Sourced, never run; functions only. All are pure reads: what a round acts on first (what a dead spawn left open, the edges of the
## dependencies) is done by the tooling before, in the main loop's housekeeping (AgentsTools.SpawnHousekeeping.include,
## AgentsTools.BoardDependencies.include).
##
## S4.5/5.5: AgentsToolsBoardRoundSections' own call to the session-context-scan board digest, once per active board item (239 of them on
## prv-farm's real team data), re-derived the fixed type table and, for a --for-round check, rescanned the whole real spawned/ tree -- both
## again per item. Timed against that real data: 37s, almost all of it there. This function now scans each of those ONCE here and exports them
## (AGENTS_BOARD_TYPE_TABLE_CACHE, AGENTS_BOARD_LIVE_HOLDERS_CACHE) for AgentsTools.BoardItemHandler.include's functions to use instead of
## recomputing -- an opt-in override those functions fall back from when unset, so every other caller (AgentsBoardItemHandlerCheck.test.sh
## among them) keeps its original, unchanged behaviour. AgentsToolsBoardRecheckDueSection had the same one-fork-per-file shape, and now asks
## the one due predicate (AgentsTools.BoardStates.include) for the whole board in one pass.
##

## The board digest, the review items addressed to advance.routine and the registries. rc: that of the digest.
AgentsToolsBoardRoundSections(){ ## calling member, the operation the scan is called as (for the log)
	local roundRc=0
	## One scan of the type table and of the real spawned/ tree, for this one round -- not kept past this call, and not visible to any
	## caller of AgentsToolsBoardTypeTable/AgentsToolsBoardItemHolders that does not itself set these two variables.
	## Computed into plain locals FIRST: declaring the AGENTS_BOARD_*_CACHE locals before they hold a real value would
	## already read as "set" to the very call below that is supposed to compute them, short-circuiting it to empty.
	local roundTypeTable roundLiveHolders
	type AgentsToolsBoardTypeTable > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.BoardItemHandler.include"
	roundTypeTable="$( AgentsToolsBoardTypeTable )" || roundTypeTable=""
	roundLiveHolders="$( AgentsToolsBoardLiveHolders )" || roundLiveHolders=""
	local AGENTS_BOARD_TYPE_TABLE_CACHE="$roundTypeTable" AGENTS_BOARD_LIVE_HOLDERS_CACHE="$roundLiveHolders"
	export AGENTS_BOARD_TYPE_TABLE_CACHE AGENTS_BOARD_LIVE_HOLDERS_CACHE
	## Scoped to what the rules act on, per the owner's "grooming reads backlog+inquiries+notes, advance does not": no backlog (promotion is
	## grooming's), and no inbox at all: the one caller, the work-duty scan, prints the own inbox (notes among it, the pending-slack-reaction and
	## pending-trello-update records check-pending-comms-actions reads) in its first section, and a second print of the notes was 56 KB of the
	## scan's 190. Inquiries, reflections and the client-* inboxes are read by --intern-op-grooming-input-scan.
	printf '\n%s\n\n' "## board digest"
	type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
	DistroAgentsTools --intern-op-session-context-scan "$1" \
		--state pending --state running --state review --state blocked --state parked \
		--all-types \
		--no-inbox-inquiry \
		--no-inbox-reflections \
		--no-inbox-notes \
		--no-slack --no-email --no-trello \
		--no-inbox-other \
		--no-board-related \
		--context "$2" || roundRc=$?
	## The review items this routine reviews on this run (AgentsTools.ReviewFlow.include). The coordinator's
	## work-duty reviews an item whose parent no longer runs, so its scan is the one that lists them (S24.7).
	type AgentsReviewItemsForRoutine > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.ReviewFlow.include"
	printf '\n%s\n\n' "## review items addressed to advance.routine"
	AgentsReviewItemsForRoutine advance "$1"
	## All three registries ride in the scan's output because the round that reads the board also needs to know who can be spawned, what is
	## actually running and what is waiting on an answer. The rescan is what keeps each one a cache rather than a record anyone maintains by
	## hand. The instruction to poll these and compare them with the board's own running items lives in magic-team.advance.routine.
	type AgentsToolsRegistryRenderAll > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.Registries.include"
	printf '\n'
	AgentsToolsRegistryRenderAll || :
	return "$roundRc"
}

## THE DOCUMENTS DUE A ROUND, and the inputs that decided it: one
## `- <state>/<item> recheck-date <date|-> last-round-at <date|->` line each, else `(none)`. The predicate itself is
## `AgentsToolsBoardItemDue` (AgentsTools.BoardStates.include), asked once for the whole board: a guarantee names a
## predicate, never a set this section filters, so every line here carries the very dates the answer came from.
## A DOCUMENT THE SECTION COULD NOT READ IS NAMED IN ONE `not read:` LINE, and the section returns rc 1. A fault is
## never an empty set: the duty reads this section, and a silent `(none)` over an unreadable board would read as a
## sweep with nothing to do.
AgentsToolsBoardRecheckDueSection(){
	local dueState dueFile dueFiles=() dueRows dueLabel dueRecheck dueLast dueCount=0 dueBlind=0 dueRc=0
	type AgentsToolsBoardItemDue > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.BoardStates.include"
	printf '\n%s\n\n' "## recheck dates due"
	for dueState in $agentsBoardActiveStates ; do
		for dueFile in "$MDAT_DATA_ROOT/board/$dueState"/*.md ; do
			[ -f "$dueFile" ] || continue
			dueFiles+=( "$dueFile" )
		done
	done
	if [ ${#dueFiles[@]} -gt 0 ] ; then
		dueRows="$( AgentsToolsBoardItemDue "${dueFiles[@]}" )" || dueRc=$?
		while IFS=$'\x1c' read -r dueFile dueDue dueWhy dueRecheck dueLast ; do
			[ -n "$dueFile" ] || continue
			if [ "$dueWhy" = not-read ] ; then
				printf 'not read: %s -- so the rows below are not the whole answer\n' "${dueFile#"$MDAT_DATA_ROOT/board/"}"
				dueBlind=$(( dueBlind + 1 ))
				continue
			fi
			[ "$dueDue" = yes ] || continue
			dueLabel="${dueFile#"$MDAT_DATA_ROOT/board/"}"
			printf -- '- %s recheck-date %s last-round-at %s\n' "$dueLabel" "$dueRecheck" "$dueLast"
			dueCount=$(( dueCount + 1 ))
		done <<< "$dueRows"
	fi
	[ "$dueCount" -gt 0 ] || [ "$dueBlind" -gt 0 ] || printf '(none)\n'
	## rc 1: a document could not be read, and is named above, so the set this section printed is
	## incomplete. rc 2: the predicate could not answer at all (a path that is no board item file),
	## and there is no set to print. A caller tests the status; it never reads a fault as `(none)`.
	if [ "$dueBlind" -gt 0 ] ; then return 1 ; fi
	[ "$dueRc" -lt 2 ] || return "$dueRc"
	return 0
}
