#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.BoardStates.include -- the states of the board, what a state means for a round, and
## the one function that makes the board ready to be written. Sourced, never run. Functions only.
##
## THE BOARD is $MDAT_DATA_ROOT/board: a folder a state, and an item a `.md` file that
## moves between them. git keeps no empty folder, so a clone of the team data has only the
## states that hold an item, and a new store has none: a state folder that is not there is
## an EMPTY STATE, never a fault. Whoever only reads the board takes it so and makes
## nothing. Whoever writes it calls AgentsToolsBoardReady first.
##
## THE FIVE ACTIVE STATES are the states a sweep gives a round or a recheck to. A round is one
## iteration on one document, and `AgentsToolsBoardItemDue` is the one answer to whether a
## document is due one (S16 stage 2). Its period is `agentsBoardStaleWindowSeconds`, the one
## constant the code carries for it.
##

## THE ONE LIST of the states a board item can be in. A state added here has its folder made by
## AgentsToolsBoardReady with no further code, and is one the item lookup searches. Every group of
## states a reader needs is a named subset below, so no reader outside this file holds a state name
## of its own, and a state added here is placed in the subsets it belongs to.
agentsBoardStates="backlog pending running review blocked parked processed archived retained"

## THE OPEN STATES: an item whose work may still be done. THE CONCLUDED STATES: an item whose work is
## over. THE SETTLED STATES: the concluded states an item does not leave again. Retained is concluded
## and live, so a pointer may still bring it back to processed.
agentsBoardOpenStates="backlog pending running review blocked parked"
agentsBoardConcludedStates="processed archived retained"
agentsBoardSettledStates="processed archived"

## THE LIVE STATES: a state a `blocked-by` or `spawned-by` pointer may come from, so a concluded item
## stays live while a live one points at it. Processed and retained are not live.
agentsBoardLiveStates="backlog pending running review blocked parked archived"

## THE ACTIVE STATES: what a sweep gives a round or a recheck to, and no other. Backlog is grooming's
## work, and a done state is nobody's. THE UNDERWAY STATES: the four states a concern acts on an item
## of an epic in.
agentsBoardActiveStates="pending running review blocked parked"
agentsBoardUnderwayStates="pending running review blocked"

## THE AWAITING STATES: an item still to be acted on, with none set aside for a later condition.
agentsBoardAwaitingStates="backlog pending running review blocked"

## THE WORK STATES: an item a run is at work on. THE WAITING-REPLY STATES: an item a run may hold while
## it waits for an answer. THE QUEUED STATES: what a start pass reads, pending to start and running
## already started.
agentsBoardWorkStates="running review"
agentsBoardWaitingReplyStates="running blocked"
agentsBoardQueuedStates="pending running"

## THE MOVING STATES: what the morning review samples item by item, from the states an item moves out
## of to the one it is filed in.
agentsBoardMovingStates="running review blocked parked processed"

## THE DISPLAY STATES: every state, in the order the console prints the board's counts.
agentsBoardDisplayStates="running review blocked pending backlog parked retained processed archived"

## THE STALENESS WINDOW, in seconds: how long a document a round has visited stays out of the
## next sweep's set. Stated once, here, and every reader asks this name.
agentsBoardStaleWindowSeconds=3600


## Makes the board ready to be written: its folder, and the folder of every state of the one list, or of the states
## named where a caller names some. Called by the one operation every board write goes through
## (--intern-op-board-upsert-move-edit), by the writers that put a file into the board themselves, and by the step
## that sets a workspace up (--owner-setup-storage --apply). A named state outside the one list is refused: a folder
## the vocabulary does not know is a state no reader would ever read. Makes folders only, never a file, so it adds
## nothing a commit of the team data would carry. rc 1, saying which, where a folder cannot be made.
AgentsToolsBoardReady(){ ## state...
	local readyState
	[ $# -gt 0 ] || set -- $agentsBoardStates
	[ -n "${MDAT_DATA_ROOT:-}" ] || return 0
	for readyState in "$@" ; do
		case " $agentsBoardStates " in
			*" $readyState "*) ;;
			*) echo "⛔ ERROR: ${MDSC_CMD:-DistroAgentsTools}: no such board state: $readyState" >&2 ; return 1 ;;
		esac
		[ -d "$MDAT_DATA_ROOT/board/$readyState" ] || mkdir -p "$MDAT_DATA_ROOT/board/$readyState" 2> /dev/null || {
			echo "⛔ ERROR: ${MDSC_CMD:-DistroAgentsTools}: can't create board state directory: $MDAT_DATA_ROOT/board/$readyState" >&2
			return 1
		}
	done
	return 0
}

## THE ITEMS OF THE BOARD COUNTED BY STATE, one `<state> <count>` line each: the states named, in that order, then each other
## folder of the board they leave out, by its name. A state whose folder is not there is not printed at all, and a state of no
## item counts none, since git keeps no empty folder. Nothing where the board is not there. The one reader of a count by state;
## the manager screen's team data panel takes it, so no other part lists the board's folders.
AgentsToolsBoardStateCounts(){ ## state...
	local countState countSeen=" " countFolder countItem countCount
	[ -n "${MDAT_DATA_ROOT:-}" ] || return 0
	[ $# -gt 0 ] || set -- $agentsBoardStates
	for countState in "$@" ; do
		case "$countState" in ''|.|..|*/*) continue ;; esac
		countSeen="$countSeen$countState "
		[ -d "$MDAT_DATA_ROOT/board/$countState" ] || continue
		countCount=0
		for countItem in "$MDAT_DATA_ROOT/board/$countState"/*.md ; do
			[ -f "$countItem" ] && countCount=$(( countCount + 1 ))
		done
		printf '%s %s\n' "$countState" "$countCount"
	done
	for countFolder in "$MDAT_DATA_ROOT/board"/*/ ; do
		[ -d "$countFolder" ] || continue
		countState="${countFolder%/}" ; countState="${countState##*/}"
		case "$countSeen" in *" $countState "*) continue ;; esac
		countCount=0
		for countItem in "$MDAT_DATA_ROOT/board/$countState"/*.md ; do
			[ -f "$countItem" ] && countCount=$(( countCount + 1 ))
		done
		printf '%s %s\n' "$countState" "$countCount"
	done
	return 0
}

## One frontmatter date-time as epoch seconds, or nothing where the value is no date-time its
## one reader takes.
AgentsToolsBoardItemEpoch(){ ## date-time
	case "$1" in
		[0-9][0-9][0-9][0-9]-[0-1][0-9]-[0-3][0-9]*) ;;
		*) return 0 ;;
	esac
	printf '%s\n' "$1" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/output/LocalIsoToEpoch.awk" 2> /dev/null
}

## WHETHER A DOCUMENT IS DUE A ROUND, and why. THE predicate of the guarantee: its folder is one
## of the five active states, `recheck-date` is absent, past, unreadable or, on a pending item, set beside no unmet
## `condition:` (AgentsToolsRecheckConditionUnmet), and `last-round-at` is absent or
## older than the staleness window. Prints ONE LINE FOR EVERY item file given, never a filtered
## set, so a reader works the answer out from the inputs rather than trusting a filter. The five
## fields are `\x1c`-separated, since a tab is IFS whitespace and would shift an empty field:
##   <item path> <yes|no> <why> <recheck-date or -> <last-round-at or ->
## The why is `due`, `not-an-active-state`, `recheck-date-ahead`, `round-inside-the-window` or
## `not-read`. A date its reader cannot take holds nothing back. rc 0 where one is due, 1 where
## none is, 2 where a path is no board item file OR a document could not be read: a fault is
## never reported as an empty set, and the document that could not be read is named.
AgentsToolsBoardItemDue(){ ## item file...
	local duePath dueState dueRecheck dueLast dueCondition dueRows dueNow dueEpoch dueWhy dueAny=0 dueUnread=0
	type AgentsToolsRecheckConditionUnmet > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.RecheckDate.include"
	local dueRead=() dueBlind=()
	[ $# -gt 0 ] || return 1
	for duePath in "$@" ; do
		[ -f "$duePath" ] || { echo "⛔ ERROR: ${MDSC_CMD:-DistroAgentsTools}: AgentsToolsBoardItemDue: not a board item file: $duePath" >&2 ; return 2 ; }
		[ -r "$duePath" ] || { dueBlind+=( "$duePath" ) ; continue ; }
		dueRead+=( "$duePath" )
	done
	dueNow="$( date +%s )"
	## One awk pass for the frontmatter of every file: a scan asks this of the whole board, and a
	## fork per file is what F7.12's own sections were batched to remove. The fields are separated
	## by \x1c and never by a tab: a tab is IFS whitespace, so `read` would collapse an empty
	## field and shift the next one into its place.
	dueRows=""
	if [ ${#dueRead[@]} -gt 0 ] ; then
		dueRows="$(
			LC_ALL=C awk '
				function dueRow(path, state, recheck, lastRound, condition) {
					printf "%s\x1c%s\x1c%s\x1c%s\x1c%s\n", path, state, recheck, lastRound, condition ;
				}
				FNR == 1 {
					if (seenPath != "") { dueRow(seenPath, seenState, seenRecheck, seenLast, seenCondition) ; } ;
					fm = 0 ; seenPath = FILENAME ; seenState = "" ; seenRecheck = "" ; seenLast = "" ; seenCondition = "" ; conditionSeen = 0 ;
					pathDepth = split(FILENAME, pathPart, "/") ;
					if (pathDepth > 1) { seenState = pathPart[pathDepth - 1] ; } ;
					if ($0 == "---") { fm = 1 ; } ;
					next ;
				}
				fm == 1 && $0 == "---" { fm = 0 ; next ; } ;
				fm == 1 && index($0, "recheck-date: ") == 1 { seenRecheck = substr($0, 15) ; next ; } ;
				fm == 1 && index($0, "last-round-at: ") == 1 { seenLast = substr($0, 16) ; next ; } ;
				fm == 1 && ! conditionSeen && index($0, "condition: ") == 1 { conditionSeen = 1 ; seenCondition = substr($0, 12) ; next ; } ;
				END { if (seenPath != "") { dueRow(seenPath, seenState, seenRecheck, seenLast, seenCondition) ; } ; } ;
			' ${dueRead[@]+"${dueRead[@]}"}
		)" || return 2
	fi
	while IFS=$'\x1c' read -r duePath dueState dueRecheck dueLast dueCondition ; do
		[ -n "$duePath" ] || continue
		[ -n "$dueRecheck" ] || dueRecheck="-"
		[ -n "$dueLast" ] || dueLast="-"
		dueWhy="due"
		case " $agentsBoardActiveStates " in
			*" $dueState "*) ;;
			*) dueWhy="not-an-active-state" ;;
		esac
		## On a pending item a recheck-date re-checks an unmet condition, and beside any other it holds nothing back (board-model.md).
		if [ "$dueWhy" = due ] && [ "$dueRecheck" != - ] && { [ "$dueState" != pending ] || AgentsToolsRecheckConditionUnmet "$dueCondition" ; } ; then
			dueEpoch="$( AgentsToolsBoardItemEpoch "$dueRecheck" )"
			case "$dueEpoch" in
				''|*[!0123456789]*) ;;
				*) [ "$dueEpoch" -le "$dueNow" ] || dueWhy="recheck-date-ahead" ;;
			esac
		fi
		if [ "$dueWhy" = due ] && [ "$dueLast" != - ] ; then
			dueEpoch="$( AgentsToolsBoardItemEpoch "$dueLast" )"
			case "$dueEpoch" in
				''|*[!0123456789]*) ;;
				*) [ "$(( dueEpoch + agentsBoardStaleWindowSeconds ))" -le "$dueNow" ] || dueWhy="round-inside-the-window" ;;
			esac
		fi
		printf '%s\x1c%s\x1c%s\x1c%s\x1c%s\n' "$duePath" "$( [ "$dueWhy" = due ] && printf yes || printf no )" "$dueWhy" "$dueRecheck" "$dueLast"
		[ "$dueWhy" != due ] || dueAny=1
	done <<< "$dueRows"
	## A DOCUMENT THAT COULD NOT BE READ IS AN ANSWER OF ITS OWN, never a missing row: the caller
	## learns its name and that the set it got is incomplete.
	for duePath in ${dueBlind[@]+"${dueBlind[@]}"} ; do
		printf '%s\x1c%s\x1c%s\x1c%s\x1c%s\n' "$duePath" no not-read - -
		dueUnread=1
	done
	[ "$dueUnread" = 0 ] || return 2
	[ "$dueAny" = 1 ]
}
