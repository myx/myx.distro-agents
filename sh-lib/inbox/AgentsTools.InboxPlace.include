#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.InboxPlace.include -- where an item of a member's inbox lives: the one answer
## every inbox operation, scan, Wait and the GC ask (MAGIC.md, "Inbox items live in incoming/
## and processed/"). In-context helpers with no operation of their own. Sourced for its
## functions only:
##   type AgentsToolsInboxFolders > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/inbox/AgentsTools.InboxPlace.include"
##
## THE SPLIT INBOX. An inbox holds two folders, `incoming/` and `processed/`, and an item's
## processed stamp (`processed-at` in its front matter) decides its folder: no stamp, incoming/;
## the stamp, processed/. The stamp stays the retention clock of the GC. Readers never see the
## folders: an operation names an item, never its folder, and sees incoming/ alone unless it is
## given --include-processed.
##
## Every store is split since F4.3's one-time move: no inbox is read or written at its root. A
## folder that is not there yet is made by the first write into it; git keeps no empty folder.
##




## The folders a read of that inbox looks in, one a line, in their order: incoming/, and
## processed/ after it where `yes` includes the processed.
AgentsToolsInboxFolders(){ ## member, include processed (yes|no)
	local folders=()
	AgentsToolsInboxFoldersInto folders "$1" "${2:-no}"
	[ ${#folders[@]} -eq 0 ] || printf '%s\n' "${folders[@]}"
}

## The same folders into the named array. The form a caller on a Wait tick or a tool call takes, since it runs no
## subshell. Empty where the store root is not set.
AgentsToolsInboxFoldersInto(){ ## array variable, member, include processed (yes|no)
	local foldersVar="$1" foldersRoot="" foldersIncoming="" foldersProcessed=""
	case "$foldersVar" in ''|*[!A-Za-z0-9_]*) return 1 ;; esac
	eval "$foldersVar=()"
	AgentsToolsInboxRootInto foldersRoot || return 0
	printf -v foldersIncoming '%s/%s/incoming' "$foldersRoot" "$2"
	eval "$foldersVar+=( \"\$foldersIncoming\" )"
	if [ "${3:-no}" = "yes" ] ; then
		printf -v foldersProcessed '%s/%s/processed' "$foldersRoot" "$2"
		eval "$foldersVar+=( \"\$foldersProcessed\" )"
	fi
	return 0
}

## The folder the inboxes stand in, into the named variable: what a caller checks a resolved folder against. rc 1,
## the variable empty, where the store root is not set.
AgentsToolsInboxRootInto(){ ## variable
	[ -n "${MDAT_DATA_ROOT:-}" ] || return 1
	printf -v "$1" '%s' "$MDAT_DATA_ROOT/inboxes"
}

## One of those two folders into the named variable: the form a caller needing a single folder takes. rc 1, the
## variable empty, where the folder name is neither or the store root is not set.
AgentsToolsInboxFolderInto(){ ## variable, member, incoming|processed
	local folderWanted=""
	[ -n "$2" ] || return 1
	[ -n "${MDAT_DATA_ROOT:-}" ] || return 1
	case "$3" in incoming|processed) ;; *) return 1 ;; esac
	printf -v folderWanted '%s/inboxes/%s/%s' "$MDAT_DATA_ROOT" "$2" "$3"
	printf -v "$1" '%s' "$folderWanted"
}

## The path of the item of that name in that inbox's incoming/, there or not yet: the form a caller that names one
## item takes. rc 1, the variable empty, where the store root is not set or the name is no bare file name.
AgentsToolsInboxItemInto(){ ## variable, member, item name
	local itemFolder=""
	case "$3" in ''|./*|../*|*/*|.|..) return 1 ;; esac
	AgentsToolsInboxFolderInto itemFolder "$2" incoming || return 1
	printf -v "$1" '%s/%s' "$itemFolder" "$3"
}

## THE ITEMS of that inbox into the named array, a path each: that member's, or every inbox's where no member is
## named. The one walk of the inboxes, so a reader of many items takes this and names no folder. No process. Empty
## where no inbox is there or holds none.
AgentsToolsInboxFilesInto(){ ## array variable, member (empty for every inbox), include processed (yes|no)
	local filesVar="$1" filesMember="${2:-}" filesFolders=() filesFolder filesOne
	case "$filesVar" in ''|*[!A-Za-z0-9_]*) return 1 ;; esac
	eval "$filesVar=()"
	[ -n "${MDAT_DATA_ROOT:-}" ] || return 0
	if [ -n "$filesMember" ] ; then
		AgentsToolsInboxFoldersInto filesFolders "$filesMember" "${3:-no}"
	else
		for filesFolder in "$MDAT_DATA_ROOT/inboxes"/*/incoming "$MDAT_DATA_ROOT/inboxes"/*/processed ; do
			[ -d "$filesFolder" ] && filesFolders+=( "$filesFolder" )
		done
	fi
	for filesFolder in ${filesFolders[@]+"${filesFolders[@]}"} ; do
		for filesOne in "$filesFolder"/*.md ; do
			[ -f "$filesOne" ] && eval "$filesVar+=( \"\$filesOne\" )"
		done
	done
	return 0
}

## The path of the item of that name in that inbox, where a read finds it: rc 1, and nothing
## printed, where it is in none of the folders the read looks in (AgentsToolsInboxFolders).
AgentsToolsInboxItemFind(){ ## member, item name, include processed (yes|no)
	local findFolder
	while IFS= read -r findFolder ; do
		[ -f "$findFolder/$2" ] && { printf '%s\n' "$findFolder/$2" ; return 0 ; }
	done < <( AgentsToolsInboxFolders "$1" "${3:-no}" )
	return 1
}

## Whether the item of that name lies in that inbox's processed/: rc 0 where it does. Kept as this store's own test: a
## caller in another concern must ask it, never build the path itself.
AgentsToolsInboxItemProcessed(){ ## member, item name
	[ -f "$MDAT_DATA_ROOT/inboxes/$1/processed/$2" ]
}

## Makes an inbox ready to be written: its folder, and its incoming/ and processed/. The one function a writer that
## puts an item into an inbox calls before it writes, and the one a check calls before it hands an inbox to the code
## under test. Makes folders only, never a file, so it adds nothing a commit of the team data would carry, like
## AgentsToolsBoardReady's own (sh-lib/board/AgentsTools.BoardStates.include). rc 1, saying which, where a folder
## cannot be made.
AgentsToolsInboxReady(){ ## member
	local readyFolder readyMade=""
	[ -n "${MDAT_DATA_ROOT:-}" ] || return 0
	case "$1" in ''|.|..|*/*) return 1 ;; esac
	for readyFolder in "$MDAT_DATA_ROOT/inboxes/$1/incoming" "$MDAT_DATA_ROOT/inboxes/$1/processed" ; do
		[ -d "$readyFolder" ] || mkdir -p "$readyFolder" 2> /dev/null || {
			echo "⛔ ERROR: ${MDSC_CMD:-DistroAgentsTools}: can't create inbox directory: $readyFolder" >&2
			return 1
		}
	done
	return 0
}

## The path of a standing note of that inbox, the state and lock notes of the routines among
## them, there or not yet. A member's inbox has standing notes in both folders, for different things:
## those of magic-coordinator are its work, an item with no processed stamp in incoming/
## (AgentsToolsInboxFolders); the state and lock note of a routine of any other member is no work of
## that member, so it lives in processed/ with a stamp, out of the demand the schedule reads in
## incoming/, out of the scans and out of Wait (AgentsToolsInboxNoteProcessed says which).
AgentsToolsInboxNotePath(){ ## member, note name
	if AgentsToolsInboxNoteProcessed "$1" "$2" ; then
		local notePlace
		notePlace="$MDAT_DATA_ROOT/inboxes/$1/processed"
		## A note of this kind found in incoming/ alone is moved to its place on the first lookup, so every reader and
		## writer meets it in one place, whichever older writer put it in incoming/.
		if [ ! -f "$notePlace/$2" ] && [ -f "$MDAT_DATA_ROOT/inboxes/$1/incoming/$2" ] ; then
			mkdir -p "$notePlace" 2> /dev/null && mv -f "$MDAT_DATA_ROOT/inboxes/$1/incoming/$2" "$notePlace/$2" 2> /dev/null || :
		fi
		printf '%s/%s\n' "$notePlace" "$2"
	else
		printf '%s/inboxes/%s/incoming/%s\n' "$MDAT_DATA_ROOT" "$1" "$2"
	fi
}

## THE INSTRUCTION EVERY DELIVERED INBOX BLOCK CARRIES (S18.3): what the reading run does with each item it was handed, so an item ends
## handled instead of growing the pile. The wording is magic-librarian's and is revised here, in the one place every delivery reads.
AgentsToolsInboxInstruction(){
	printf '%s\n' 'inbox items: handle each item, then trash it with --trash-inbox-item, or --mark-inbox-processed where the record must stay, or keep it with a stated reason.'
}

## THE INDEX OF LOCK NOTES: every note a routine declares as its `routine-lock-document` (`inbox:<member>:<note>`), read from the
## routines of the members the tooling's directory answers (the folders AgentsTools.SpawnRoutine.include reads), one note name a
## line, each once. A lock note is the tooling's: the routine lock reads it at its own place, so no member operation moves or trashes one.
AgentsToolsInboxLockNoteNames(){
	local lockMember lockRoot
	type AgentsToolsTeamMemberDirectoryText > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.TeamRegistry.include"
	while IFS=$'\t' read -r lockMember lockRoot ; do
		[ -n "$lockRoot" ] && [ -d "$lockRoot" ] || continue
		find -L "$lockRoot" -name '*.routine.md' -type f 2> /dev/null
	done <<< "$( AgentsToolsTeamMemberDirectoryText )" \
		| LC_ALL=C tr '\n' '\0' | LC_ALL=C xargs -0 grep -h '^routine-lock-document:' 2> /dev/null \
		| LC_ALL=C awk '{ sub( /^routine-lock-document: */, "" ) ; n = split( $0, lockValues, /[ ,]+/ ) ; for ( i = 1 ; i <= n ; i++ ) { lockName = lockValues[i] ; sub( /.*:/, "", lockName ) ; if ( lockName ~ /^note-.*\.md$/ && !seenName[lockName]++ ) print lockName ; } }'
}

## Whether a note is a routine's lock note: by the index of the routines' own declarations, or by the convention's name, which also
## covers a lock note no routine of this member view declares.
AgentsToolsInboxIsLockNote(){ ## note name
	case "$1" in note-*-state-and-lock.md) return 0 ;; note-*.md) ;; *) return 1 ;; esac
	AgentsToolsInboxLockNoteNames | LC_ALL=C grep -q -x -F -- "$1"
}

## Whether a standing note lives in processed/: rc 0 for the state and lock note of a routine (`note-<stamp>-<word>-state-and-lock.md`) in the inbox
## of a member other than magic-coordinator.
AgentsToolsInboxNoteProcessed(){ ## member, note name
	[ "$1" != "magic-coordinator" ] || return 1
	case "$2" in note-*-state-and-lock.md) return 0 ;; esac
	return 1
}
