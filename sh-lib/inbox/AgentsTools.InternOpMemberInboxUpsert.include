#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.InternOpMemberInboxUpsert.include -- the
## --intern-op-member-inbox-upsert op for DistroAgentsTools.fn.sh's
## dispatcher. Sourced lazily from that exact op's own dispatcher arm (not a
## wildcard -- this file holds one op only) via the standard
## $MDLT_ORIGIN-based path. Not standalone: relies on being dot-sourced for
## $1/$@/$MDSC_CMD.
##
## Where the item goes is the inbox's to say (AgentsTools.InboxPlace.include): the folder
## its processed stamp picks, incoming/ or processed/, an item already there found in
## incoming/, or in processed/ too with --include-processed, and moved when its stamp
## changes its folder.
##

. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.OutputStyle.include"
type AgentsToolsInboxDir > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/inbox/AgentsTools.InboxPlace.include"

case "$1" in

	--intern-op-member-inbox-upsert)
		shift
		local opContext="<no --context given>"
		local ctxWanted="" ctxArg
		for ctxArg in "$@" ; do
			if [ -n "$ctxWanted" ] ; then
				opContext="$ctxArg" ; ctxWanted="" ; continue
			fi
			if [ "$ctxArg" = "--context" ] ; then ctxWanted="1" ; fi
		done
		local memberName="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$memberName" ] || [ -z "$itemName" ] ; then
			echo "$MDSC_CMD: member-inbox-upsert: ⛔ ERROR: syntax is <member> <item-filename> [--from-member <member>] [--include-processed] [--standing yes|no] [--no-commit] -- content via stdin, --from-file <path>, --upsert-from-slots, or --edit-patch-from-stdin" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$memberName" "<member>" member-inbox-upsert || { set +e ; return 1 ; }
		AgentsToolsAssertBareName "$itemName" "<item-filename>" member-inbox-upsert || { set +e ; return 1 ; }
		local memberDir="$MDAT_SKILLSET_ROOT/$memberName"
		if [ ! -d "$memberDir" ] ; then
			echo "$MDSC_CMD: member-inbox-upsert: ⛔ ERROR: no such member skill directory: $memberDir" >&2
			set +e ; return 1
		fi
		[ -n "${MDAT_DATA_ROOT:-}" ] || {
			echo "$MDSC_CMD: member-inbox-upsert: ⛔ ERROR: MDAT_DATA_ROOT is not set" >&2
			set +e ; return 1
		}
		local includeProcessed="no" existingPath="" noCommit="no" standingValue="" replyRequested="" replyValue=""
		local target=""
		local content contentFromFile="false" bodyMode="" bodyModeCount=0
		## Who is writing: the `from` a new item is stamped with when its content names none.
		## A spawned session's own member when not given, else user-<account> for a person at a console.
		local fromMember="${MDAT_SPAWN_AGENT:-}" fromAccount=""
		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-file)
					if [ -z "$2" ] || [ ! -f "$2" ] ; then
						echo "$MDSC_CMD: member-inbox-upsert: ⛔ ERROR: --from-file: file not found: $2" >&2
						set +e ; return 1
					fi
					content="$( cat "$2" )"
					contentFromFile="true"
					bodyMode="file"
					bodyModeCount=$(( bodyModeCount + 1 ))
					shift 2
				;;
				--edit-patch-from-stdin)
					bodyMode="patch"
					bodyModeCount=$(( bodyModeCount + 1 ))
					shift
				;;
				--upsert-from-slots)
					bodyMode="slots"
					bodyModeCount=$(( bodyModeCount + 1 ))
					shift
				;;
				--from-member)
					if [ -z "${2:-}" ] ; then
						echo "$MDSC_CMD: member-inbox-upsert: ⛔ ERROR: --from-member: value required" >&2
						set +e ; return 1
					fi
					AgentsToolsAssertBareName "$2" "--from-member" member-inbox-upsert || { set +e ; return 1 ; }
					fromMember="$2"
					shift 2
				;;
				--context)
					if [ -z "${2:-}" ] ; then
						echo "$MDSC_CMD: member-inbox-upsert: ⛔ ERROR: --context: value required" >&2
						set +e ; return 1
					fi
					shift 2
				;;
				--include-processed)
					includeProcessed="yes"
					shift
				;;
				## The write only: the caller that writes many items in one pass commits them once, at its end
				## (AgentsToolsTeamDataCommitPaths), where a commit per item would be a commit per note.
				--no-commit)
					noCommit="yes"
					shift
				;;
				## A note only: sets the header `standing: yes|no` (inbox-item.note's contract). A standing note is in force until it is processed
				## (AgentDispatcherTools.fn.sh --standing-directives, and the brief of a spawn).
				--standing)
					case "${2:-}" in
						yes|no) standingValue="$2" ;;
						*) echo "$MDSC_CMD: member-inbox-upsert: ⛔ ERROR: --standing is yes or no: ${2:-<nothing>}" >&2 ; set +e ; return 1 ;;
					esac
					shift 2
				;;
				## An inquiry only: sets the header `reply-requested: yes`, so the member it asks for asks back for a note with the outcome.
				--reply-requested)
					replyRequested="yes"
					shift
				;;
				## An inquiry only (K2): --reply sets `reply-requested: yes`, so marking the inquiry processed
				## sends one note with the outcome to its requester. Mirrors --request-update --reply.
				--reply)
					replyValue="yes"
					shift
				;;
				*)
					echo "$MDSC_CMD: member-inbox-upsert: ⛔ ERROR: unrecognized argument: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		case "$standingValue:$itemName" in
			:*|*:note-*) ;;
			*) echo "$MDSC_CMD: member-inbox-upsert: ⛔ ERROR: --standing is for a note (note-*), and this is $itemName -- nothing was written" >&2 ; set +e ; return 1 ;;
		esac
		case "$replyValue:$itemName" in
			:*|*:inquiry-*) ;;
			*) echo "$MDSC_CMD: member-inbox-upsert: ⛔ ERROR: --reply is for an inquiry (inquiry-*), and this is $itemName -- nothing was written" >&2 ; set +e ; return 1 ;;
		esac
		if [ "$bodyModeCount" -gt 1 ] ; then
			echo "$MDSC_CMD: member-inbox-upsert: ⛔ ERROR: --from-file, --upsert-from-slots and --edit-patch-from-stdin are mutually exclusive" >&2
			set +e ; return 1
		fi
		## The item as it is now, where a read finds it, a processed one only with
		## --include-processed: without it, an item of that name that is processed is refused,
		## never shadowed by a second one in incoming/.
		existingPath="$( AgentsToolsInboxItemFind "$memberName" "$itemName" "$includeProcessed" )" || existingPath=""
		if [ -z "$existingPath" ] && AgentsToolsInboxItemProcessed "$memberName" "$itemName" ; then
			echo "$MDSC_CMD: member-inbox-upsert: ⛔ ERROR: $itemName is a processed item of $memberName's inbox, which this call does not see -- give --include-processed to update it; nothing was written" >&2
			set +e ; return 1
		fi
		target="${existingPath:-$( AgentsToolsInboxDir "$memberName" )/$itemName}"
		if [ "$bodyMode" = "patch" ] ; then
			local patchJson existingContent
			patchJson="$( cat )"
			if [ -f "$target" ] ; then existingContent="$( cat "$target" )" ; else existingContent="" ; fi
			content="$( printf '%s%s' "$patchJson" "$existingContent" | python3 "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsBoardItemPatchApply.py" "$opContext" )" || { set +e ; return 1 ; }
		elif [ "$bodyMode" = "slots" ] ; then
			## --upsert-from-slots: the member gives only the slot values; the writer renders the document's
			## body from its template (sh-lib/templates/inbox-item.<type>.document.format.md), and the
			## front matter is stamped by the creation defaults below, as on any create.
			type AgentsToolsToolingTemplateFill > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.ToolingTemplate.include"
			type AgentsToolsItemNameType > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.ItemNameShape.include"
			local slotsBlock slotsType slotsFile
			slotsBlock="$( cat )"
			slotsType="$( AgentsToolsItemNameType "$itemName" )"
			[ -n "$slotsType" ] || { echo "$MDSC_CMD: member-inbox-upsert: ⛔ ERROR: --upsert-from-slots: the item name names no type: $itemName" >&2 ; set +e ; return 1 ; }
			[ -f "$( AgentsToolsToolingTemplate "inbox-item.$slotsType.document.format.md" )" ] || { echo "$MDSC_CMD: member-inbox-upsert: ⛔ ERROR: --upsert-from-slots: no document template for the inbox type $slotsType (inbox-item.$slotsType.document.format.md)" >&2 ; set +e ; return 1 ; }
			mkdir -p "$MMDAPP/.local/temp" || { echo "$MDSC_CMD: member-inbox-upsert: ⛔ ERROR: --upsert-from-slots: the temp folder could not be made" >&2 ; set +e ; return 1 ; }
			slotsFile="$( mktemp "$MMDAPP/.local/temp/mdat-intern-op-inbox-slots.XXXXXX" )" || { echo "$MDSC_CMD: member-inbox-upsert: ⛔ ERROR: --upsert-from-slots: a slots temp file could not be made" >&2 ; set +e ; return 1 ; }
			printf '%s\n' "$slotsBlock" > "$slotsFile" || { rm -f "$slotsFile" ; set +e ; return 1 ; }
			content="$( IDS_SLOTS="$slotsFile" AgentsToolsToolingTemplateFill "inbox-item.$slotsType.document.format.md" inbox/AgentsInboxItemDocumentFill.awk )" \
				|| { rm -f "$slotsFile" ; echo "$MDSC_CMD: member-inbox-upsert: ⛔ ERROR: --upsert-from-slots: the document for inbox type $slotsType could not be filled from its template" >&2 ; set +e ; return 1 ; }
			rm -f "$slotsFile"
			[ -n "$content" ] || { echo "$MDSC_CMD: member-inbox-upsert: ⛔ ERROR: --upsert-from-slots: the slots fill to an empty document -- nothing was written" >&2 ; set +e ; return 1 ; }
		else
			[ "$contentFromFile" = "true" ] || content="$( cat )"
			## Measured, never refused: this tier reports and the write proceeds.
			## Only this branch carries the caller's own new text -- a patch merges
			## into content somebody else wrote, and measuring that would report
			## against the wrong author.
			printf '%s' "$content" | AgentsToolsOutputStyleRefusal "$memberName" "" "$itemName" "" none || :
		fi
		if [ -z "$content" ] ; then
			echo "$MDSC_CMD: member-inbox-upsert: ⛔ ERROR: empty content -- refusing to write an empty inbox item" >&2
			set +e ; return 1
		fi
		## A new item's name is checked against the naming Rule, and its type against the store, by the write
		## gate below (AgentsToolsDocValidateGate): said, never refused, never rewritten. An item that already
		## exists is updated under the name it has.
		type AgentsToolsDocValidateGate > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.DocValidate.include"
		## created vs updated is decided before the write, while the target's
		## prior presence still tells the two apart.
		local existedBefore="false"
		if [ -n "$existingPath" ] ; then existedBefore="true" ; fi

		## A new item's required headers -- type, from, date, owner, document-contract -- stamped only where the
		## content names none of them: type from the name's prefix, from the writing member
		## when known, date now, owner the member whose inbox this is, and the contract the type names. Never on an update:
		## those are creation facts, and the one updating is not the one who created it.
		## A body opening a frontmatter block it never closes is written as given, as before:
		## there is no frontmatter to complete, and the header awk would refuse it.
		local openFrontmatter="false"
		if [ "${content%%$'\n'*}" = "---" ] && [ "$( printf '%s\n' "$content" | LC_ALL=C awk -v fieldName=type -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsBoardItemFrontmatterFieldProbe.awk" )" = "NONE" ] ; then
			openFrontmatter="true"
		fi
		if [ "$existedBefore" = "false" ] && [ "$openFrontmatter" = "false" ] ; then
			[ -n "$fromMember" ] && AgentsToolsAssertBareName "$fromMember" "MDAT_SPAWN_AGENT" member-inbox-upsert 2>/dev/null || fromMember=""
			## A person at a console, with no session spawned, is user-<account> (the team member default of the common
			## option set, F2.2); with not even an account, the item has no writer and the gate refuses it.
			if [ -z "$fromMember" ] && [ -z "${MDAT_SPAWN_AGENT:-}" ] && fromAccount="$( AgentsToolsConsoleAccount )" && [ -n "$fromAccount" ] ; then
				fromMember="user-$fromAccount"
				AgentsToolsAssertBareName "$fromMember" "user-\$USER" member-inbox-upsert 2>/dev/null || fromMember=""
			fi
			local createDefaults="" createType
			createType="$( AgentsToolsItemNameType "$itemName" )"
			[ -z "$createType" ] || createDefaults="default"$'\t'"type"$'\t'"$createType"$'\n'
			[ -z "$fromMember" ] || createDefaults="${createDefaults}default"$'\t'"from"$'\t'"$fromMember"$'\n'
			createDefaults="${createDefaults}default"$'\t'"date"$'\t'"$( date +"%Y-%m-%d %H:%M %z" )"$'\n'
			createDefaults="${createDefaults}default"$'\t'"owner"$'\t'"$memberName"$'\n'
			if [ -n "$createType" ] && AgentsToolsDocValidateContractFile "inbox-item.$createType" > /dev/null ; then
				createDefaults="${createDefaults}default"$'\t'"document-contract"$'\t'"inbox-item.$createType"$'\n'
			fi
			## Same ops file discipline as --intern-op-board-upsert-move-edit: a real path the
			## awk reads, made and removed inside this one subshell, and this call's own: by mktemp,
			## never by $$, which every subshell of one shell shares.
			content="$(
				mkdir -p "$MMDAPP/.local/temp" && headerOpsFile="$( mktemp "$MMDAPP/.local/temp/mdat-intern-op-inbox-headers.XXXXXX" )" || exit 1
				trap 'rm -f "$headerOpsFile"' EXIT
				printf '%s' "$createDefaults" > "$headerOpsFile" || exit 1
				printf '%s\n' "$content" | LC_ALL=C awk -v opsFile="$headerOpsFile" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsBoardItemHeaderOpsApply.awk"
			)" || { set +e ; return 1 ; }
		fi
		## --standing: the header set on the content as it would be written, over a value it has; the rest of the content as it is.
		if [ -n "$standingValue" ] ; then
			if [ "$openFrontmatter" = "true" ] ; then
				echo "$MDSC_CMD: member-inbox-upsert: ⛔ ERROR: --standing: the content opens a frontmatter block it never closes -- nothing was written" >&2
				set +e ; return 1
			fi
			content="$(
				mkdir -p "$MMDAPP/.local/temp" && headerOpsFile="$( mktemp "$MMDAPP/.local/temp/mdat-intern-op-inbox-standing.XXXXXX" )" || exit 1
				trap 'rm -f "$headerOpsFile"' EXIT
				printf 'upsert\tstanding\t%s\n' "$standingValue" > "$headerOpsFile" || exit 1
				printf '%s\n' "$content" | LC_ALL=C awk -v opsFile="$headerOpsFile" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsBoardItemHeaderOpsApply.awk"
			)" || { set +e ; return 1 ; }
		fi
		## --reply: the `reply-requested: yes` header set on the content, over a value it has; the rest as it is.
		if [ -n "$replyValue" ] ; then
			if [ "$openFrontmatter" = "true" ] ; then
				echo "$MDSC_CMD: member-inbox-upsert: ⛔ ERROR: --reply: the content opens a frontmatter block it never closes -- nothing was written" >&2
				set +e ; return 1
			fi
			content="$(
				mkdir -p "$MMDAPP/.local/temp" && headerOpsFile="$( mktemp "$MMDAPP/.local/temp/mdat-intern-op-inbox-reply.XXXXXX" )" || exit 1
				trap 'rm -f "$headerOpsFile"' EXIT
				printf 'upsert\treply-requested\tyes\n' > "$headerOpsFile" || exit 1
				printf '%s\n' "$content" | LC_ALL=C awk -v opsFile="$headerOpsFile" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsBoardItemHeaderOpsApply.awk"
			)" || { set +e ; return 1 ; }
		fi
		## --reply-requested: the header `reply-requested: yes` on the content as it would be written, over a value it has; the rest as it is.
		if [ -n "$replyRequested" ] ; then
			if [ "$openFrontmatter" = "true" ] ; then
				echo "$MDSC_CMD: member-inbox-upsert: ⛔ ERROR: --reply-requested: the content opens a frontmatter block it never closes -- nothing was written" >&2
				set +e ; return 1
			fi
			content="$(
				mkdir -p "$MMDAPP/.local/temp" && headerOpsFile="$( mktemp "$MMDAPP/.local/temp/mdat-intern-op-inbox-reply.XXXXXX" )" || exit 1
				trap 'rm -f "$headerOpsFile"' EXIT
				printf 'upsert\treply-requested\tyes\n' > "$headerOpsFile" || exit 1
				printf '%s\n' "$content" | LC_ALL=C awk -v opsFile="$headerOpsFile" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsBoardItemHeaderOpsApply.awk"
			)" || { set +e ; return 1 ; }
		fi
		## The folder the item's stamp picks, as written: an item whose stamp changes its
		## folder moves there, nothing of it left where it was.
		local movedFrom="" stampedNow="no"
		[ "$( printf '%s\n' "$content" | LC_ALL=C awk -v fieldName=processed-at -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsBoardItemFrontmatterFieldProbe.awk" )" != "HAS" ] || stampedNow="yes"
		target="$( AgentsToolsInboxDirFor "$memberName" "$stampedNow" )/$itemName"
		[ -z "$existingPath" ] || [ "$existingPath" = "$target" ] || movedFrom="$existingPath"
		## THE WRITE GATE (AgentsTools.DocValidate.include): the item as it would be, against the item as it is. A fault of
		## its contract that this write introduces, and whose rule refuses, refuses the write and nothing is written; one
		## whose rule reports is said and the write goes on.
		local gateMode="change" gateLabel="$itemName"
		[ -n "$existingPath" ] || { gateMode="create" ; gateLabel="new item" ; }
		printf '%s\n' "$content" | AgentsToolsDocValidateGate member-inbox-upsert "$gateLabel" inbox "$itemName" "$existingPath" "$gateMode" || { set +e ; return 1 ; }
		mkdir -p "${target%/*}" || {
			echo "$MDSC_CMD: member-inbox-upsert: ⛔ ERROR: can't create inbox directory: ${target%/*}" >&2
			set +e ; return 1
		}
		printf '%s\n' "$content" > "$target"
		[ -z "$movedFrom" ] || rm -f -- "$movedFrom"
		echo "# $MDSC_CMD: member-inbox-upsert: wrote $itemName ($( printf '%s\n' "$content" | wc -l | tr -d '[:space:]' ) lines)" >&2

		## Commit gate: .git presence in the team-data root, presence only --
		## this op never pushes. Mirrors --intern-op-board-upsert-move-edit.
		local repoRoot=""
		repoRoot="$( git -C "$MDAT_DATA_ROOT" rev-parse --show-toplevel 2>/dev/null )" || repoRoot=""
		if [ -n "$repoRoot" ] && [ "$noCommit" = "no" ] ; then
			local msgPrefix="+" msgAction="created"
			if [ "$existedBefore" = "true" ] ; then msgPrefix="*" ; msgAction="updated" ; fi
			local ctxForMsg="$opContext"
			if [ "$ctxForMsg" = "<no --context given>" ] ; then ctxForMsg="--intern-op-member-inbox-upsert" ; fi
			local gitOut="" gitRc=0 commitPaths=( "$target" )
			[ -z "$movedFrom" ] || commitPaths+=( "$movedFrom" )
			gitOut="$( git -C "$repoRoot" add -A -- "${commitPaths[@]}" 2>&1 )" || gitRc=$?
			if [ "$gitRc" -ne 0 ] ; then
				echo "$MDSC_CMD: member-inbox-upsert: ⛔ ERROR: git add failed for $target: $gitOut" >&2
				set +e ; return 1
			fi
			gitOut="$( git -C "$repoRoot" commit -m "$msgPrefix $msgAction: $ctxForMsg" -- "${commitPaths[@]}" 2>&1 )" || gitRc=$?
			if [ "$gitRc" -ne 0 ] ; then
				echo "$MDSC_CMD: member-inbox-upsert: ⛔ ERROR: git commit failed for $target: $gitOut" >&2
				set +e ; return 1
			fi
			echo "# $MDSC_CMD: member-inbox-upsert: committed ${target#"$MDAT_DATA_ROOT"/}" >&2
		fi
		return 0
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
