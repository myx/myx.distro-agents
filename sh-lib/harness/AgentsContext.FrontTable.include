## The operations the harness and MCP tools run, whose result `--mdat-output-format json` before the name wraps in one JSON object (DistroAgentsTools.fn.sh has the
## internal ones). sh-test/harness/AgentsBatchToolsCheck.test.sh holds the list to the words the harness runs.
agentsFrontJsonOps="--slack-delete-message --slack-send-message --upsert-inbox-inquiry --wait-for-input"

## Whether the call is a name of this tool file: the name is the first word, or the one after `--mdat-output-format json`. Says nothing.
AgentsToolsFrontKnows(){ ## entry function name, arguments...
	local knowsOp="${2:-}"
	[ "${2:-}" != --mdat-output-format ] || [ "${3:-}" != json ] || knowsOp="${4:-}"
	[ -n "$knowsOp" ] || return 1
	printf '%s\n%s\n' "$agentsFrontTable" "$agentsFrontStubs" | LC_ALL=C awk -F'\t' -v key="$1" -v op="$knowsOp" '$1 == key && ( $2 == op || op == "--help-syntax" ) { found = 1 ; exit } END { exit ( found ? 0 : 1 ) }'
}

## The tool file a name was moved to from the file given, or rc 1: the stub row of that file.
AgentsToolsFrontStubOwner(){ ## tool file, name
	printf '%s\n' "$agentsFrontStubs" | LC_ALL=C awk -F'\t' -v key="$1" -v op="$2" '$1 == key && $2 == op { print $3 ; found = 1 ; exit } END { exit ( found ? 0 : 1 ) }'
}

## Whether the call is a name of any tool file of the table (the first word, or the one after `--mdat-output-format json`).
AgentsToolsFrontAny(){ ## arguments...
	local anyOp="${1:-}"
	[ "${1:-}" != --mdat-output-format ] || [ "${2:-}" != json ] || anyOp="${3:-}"
	[ -n "$anyOp" ] || return 1
	printf '%s\n' "$agentsFrontTable" | LC_ALL=C awk -F'\t' -v op="$anyOp" '$2 == op { found = 1 ; exit } END { exit ( found ? 0 : 1 ) }'
}

## The tool file that owns a name, and who may call the name.
AgentsToolsFrontFile(){ ## name
	printf '%s\n' "$agentsFrontTable" | LC_ALL=C awk -F'\t' -v op="$1" '$2 == op { print $1 ; exit }'
}
AgentsToolsFrontAudience(){ ## name
	printf '%s\n' "$agentsFrontTable" | LC_ALL=C awk -F'\t' -v op="$1" '$2 == op { print $3 ; exit }'
}

## Who may call every name that begins with a prefix (a name is its own prefix): `coordinator` where there is at least one and all are the coordinator's only,
## else `member`.
AgentsToolsFrontPrefixAudience(){ ## prefix
	printf '%s\n' "$agentsFrontTable" | LC_ALL=C awk -F'\t' -v want="$1" 'index( $2, want ) == 1 { n++ ; if ( $3 != "coordinator" ) other = 1 } END { print ( n > 0 && !other ) ? "coordinator" : "member" }'
}

## Every name whose audience is the one given (`member`, `coordinator`), one a line.
AgentsToolsFrontNamesOf(){ ## audience
	printf '%s\n' "$agentsFrontTable" | LC_ALL=C awk -F'\t' -v who="$1" '$3 == who { print $2 }'
}

## What each tool file is, in a sentence: the first line the tool index shows under it.
agentsFrontSummary='DistroAgentsSession	ThisSession, your own session: post to its thread with --post-session-channel, and run its routine. Every wait already brings its thread replies.
DistroAgentsKnowledge	What the team has written, searched; and the registries of projects, places, namespaces and members, read.
DistroAgentsDispatcher	The runs of the team and everything about them: sessions, spawns, flags and the schedule.
DistroAgentsTesting	The testing system: tests, retests and the report.
DistroAgentsContacts	The people subsystem: contacts, organisations and what a contact may ask for.
AgentDispatcherTools	The duties of the coordinator: routine state, the roster, the client operations.
DistroAgentsItems	The items of the stores of the team: board, inbox, audit and vault.
DistroAgentsQuestions	Every ask of the team: escalations, permission requests, decisions and the replies pending to them.
DistroAgentsGrants	The permission registry: what a member holds, passes on and has revoked.
DistroAgentsSlack	The Slack operations of the team.
DistroAgentsAtlassian	The Jira and Confluence operations of the team.
DistroAgentsGoogle	The Google operations of the team.
DistroAgentsMail	The mail operations of the team.
DistroAgentsTrello	The Trello operations of the team.'

## The tool files the myx.distro MCP serves as one tool each, the operation as the argument: the external services, the contacts, AgentDispatcherTools (the coordinator's
## role surface, whose spawn starts the sessions of a root-harness session) and DistroAgentsDispatcher, Questions, Items, Knowledge and Testing. An operation's audience is the
## column of the table above, checked at call time. DistroAgentsGrants and DistroAgentsSession are not served: ThisSession is a floor tool of the harness. A tool is listed for everyone.
agentsFrontSecondary='DistroAgentsSlack
DistroAgentsAtlassian
DistroAgentsGoogle
DistroAgentsMail
DistroAgentsTrello
DistroAgentsContacts
AgentDispatcherTools
DistroAgentsDispatcher
DistroAgentsQuestions
DistroAgentsItems
DistroAgentsKnowledge
DistroAgentsTesting'

AgentsToolsFrontSummary(){ ## entry function name
	printf '%s\n' "$agentsFrontSummary" | LC_ALL=C awk -F'\t' -v key="$1" '$1 == key { print $2 ; exit }'
}

## The names of a tool file, one a line; and what a bare call of a tool file prints: the syntax line of each of its
## operations, one a line, its first form where an operation has several -- the entry points a reader starts from.
## Every form of every operation is what --help-syntax is asked for by name.
AgentsToolsFrontOps(){ ## entry function name
	printf '%s\n' "$agentsFrontTable" | LC_ALL=C awk -F'\t' -v key="$1" '$1 == key { print $2 }'
}
AgentsToolsFrontHelp(){ ## entry function name, what the tool is
	printf '%s: %s\n' "$1" "$2"
	AgentsToolsFrontSyntaxLines "$1" "" first-form
}

## The syntax lines of a tool file's names, one name's, or those of every name a prefix ending in `-` begins: the lines of the
## file's own manual, sh-lib/help/Help.<file>.help.md, which is where a tool's syntax is written, and of the shared include,
## sh-lib/help/Help.DistroAgentsTools.include, only where no manual is there to read. Prints them, and nothing where the file
## has none. With `first-form`, one line for each name, its first, which is the short list a bare call prints.
AgentsToolsFrontSyntaxLines(){ ## entry function name, a name or a prefix (optional), first-form (optional)
	local synManual="$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/help/Help.$1.help.md"
	[ -f "$synManual" ] || synManual="$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/help/Help.DistroAgentsTools.include"
	LC_ALL=C awk -v tool="$1.fn.sh" -v want="${2:-}" -v form="${3:-}" '
		{
			line = $0 ; sub( /^echo "/, "", line ) ; sub( /" >&2$/, "", line )
			if ( index( line, "📘 syntax: " ) != 1 ) next
			split( substr( line, length( "📘 syntax: " ) + 1 ), words, " " ) ; op = words[2] ; gsub( /[][]/, "", op )
			if ( words[1] != tool ) next
			if ( want != "" && op != want && ! ( want ~ /-$/ && index( op, want ) == 1 ) ) next
			if ( form == "first-form" ) { if ( op in listed ) next ; listed[op] = 1 }
			print line
		}' "$synManual"
}

## `--help-syntax [<name>]` of a tool file: those lines on stderr, or the refusal of a word that names none.
AgentsToolsFrontSyntax(){ ## entry function name, a name or a prefix (optional)
	local synOut
	synOut="$( AgentsToolsFrontSyntaxLines "$1" "${2:-}" )"
	if [ -z "$synOut" ] ; then
		echo "⛔ ERROR: ${MDSC_CMD:-$1} --help-syntax ${2:-}: no operation of $1 is named so, or begins so -- $1 --help-syntax lists them all" >&2
		return 1
	fi
	printf '%s\n' "$synOut" >&2
}

## DistroAgentsTools.fn.sh's one rule for them: the call goes on in the tool file that owns the name.
AgentsToolsFrontRoute(){ ## arguments...
	local routeOp="${1:-}" routeFile
	[ "${1:-}" != --mdat-output-format ] || [ "${2:-}" != json ] || routeOp="${3:-}"
	routeFile="$( AgentsToolsFrontFile "$routeOp" )"
	type "$routeFile" > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/$routeFile.fn.sh"
	"$routeFile" "$@"
}

## What an old name was replaced by: its refusal line, or nothing for a name that was never one.
AgentsToolsFrontRetired(){ ## name
	local retiredNow
	retiredNow="$( printf '%s\n' "$agentsFrontRetired" | LC_ALL=C awk -F'\t' -v op="$1" '$1 == op { print $2 ; exit }' )"
	[ -n "$retiredNow" ] || return 1
	case "$retiredNow" in
		\(*) printf '%s: ⛔ ERROR: %s is retired: %s\n' "${MDSC_CMD:-DistroAgentsTools}" "$1" "${retiredNow#(}" | LC_ALL=C sed 's/)$//' ;;
		*) printf '%s: ⛔ ERROR: %s was renamed: use %s -- nothing was done\n' "${MDSC_CMD:-DistroAgentsTools}" "$1" "$retiredNow" ;;
	esac
}
