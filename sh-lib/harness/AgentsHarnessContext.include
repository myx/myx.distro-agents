#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsHarnessContext.include -- the universal harness keeps its model context.
## Sourced by AgentsUniversalHarness.sh on the model path only, after the wire adapter;
## functions only, and every one returns 0 on its own failure except the resume, whose
## failure the harness turns into its exit (rc 7, before any request is made).
##
## THE FILE: $MDAT_SPAWN_SANDBOX_ROOT/context.jsonl, the exact message array this leg
## sends -- system text, a reference to the tools, then every message record byte for
## byte (tool_use ids, tool results and thinking signatures included), one JSON object
## a line. The layout is AgentsHarnessContextTranscript.awk's header comment. Local
## working state: never committed, removed with the sandbox. Kept only for a spawned,
## non-waiting session (MDAT_SPAWN_SANDBOX_ROOT, MDAT_SPAWN_SESSION_ID, and no
## MDAT_SPAWN_CALLER_WAITS=true); MDAT_HARNESS_CONTEXT=off turns it off. A --wait spawn
## and a native session are untouched.
##
## Records are appended as the array grows (AgentsHarnessContextSync), so the file is
## always the array as last sent; a new leg (summarise-and-restart) rewrites it whole.
## THE TRANSCRIPT and the event-track feed read the model rounds from here, live: each time the file gains records, the lines for them are
## rendered once (AgentsHarnessContextFeed) and appended to both, so a run's audit log is as current as a native run's.
## THE RESUME: MDAT_HARNESS_RESUME_CONTEXT names a file to continue from. Its array is
## loaded as stored and the prompt this process was given -- the review corrections --
## is appended as a new user turn, so the request begins with the old one byte for byte. A root this leg has that the kept messages do not
## name (a child's) comes with that turn (F10.7), never into the system text or a record kept.
##

harnessContextFile=""
harnessContextCount=0
harnessContextLeg=0
harnessContextFrom=0
harnessContextFeed=""
harnessContextLastAssistant=0
harnessContextResumed=0
harnessContextAwk=( -f "$harnessHere/harness/AgentsHarnessJsonField.awk" -f "$harnessHere/transcript/AgentsSessionTranscriptFormat.awk" -f "$harnessHere/harness/AgentsHarnessContextTranscript.awk" )

AgentsHarnessContextEscape(){ ## raw text -- a JSON string body
	printf '%s' "$1" | LC_ALL=C awk -f "$harnessHere/mcp/AgentsMcpJsonEscape.awk"
}

## The tools array exactly as AgentsWireRequestBody places it.
AgentsHarnessContextToolsJson(){
	case "$harnessWire" in
		AnthropicMessages) printf '%s' "${agentsWireToolsJson%]}${harnessMcpToolsJson:-}]" ;;
		*) printf '%s' "${harnessToolsJson%]}${harnessMcpToolsJson:-}]" ;;
	esac
}

## The system text as sent: the Anthropic wire's own rendering, else the escaped text
## its first message carries.
AgentsHarnessContextSystemJson(){
	case "$harnessWire" in
		AnthropicMessages) printf '%s' "${agentsWireSystemJson:-}" ;;
		*) AgentsHarnessContextEscape "$harnessSystemText" ;;
	esac
}

AgentsHarnessContextMachine(){
	hostname -s 2>/dev/null || echo unknown
}

## The kept-context file of one run in a sandbox folder, by what the files say, never by the folder's name (a folder is named for its
## session, or for a tracking name): the run's own context.<spawn id>.jsonl where it has one; else context.jsonl where that is free or
## its header names this run; else, another run holding context.jsonl, context.<spawn id>.jsonl. Printed.
AgentsHarnessContextFileOf(){ ## sandbox folder, spawn id
	local ofRoot="${1%/}" ofSession=""
	[ ! -f "$ofRoot/context.$2.jsonl" ] || { printf '%s/context.%s.jsonl' "$ofRoot" "$2" ; return 0 ; }
	if [ -s "$ofRoot/context.jsonl" ] ; then
		ofSession="$( head -1 "$ofRoot/context.jsonl" 2> /dev/null | LC_ALL=C sed -n 's/.*"session":"\([^"]*\)".*/\1/p' )"
		[ -z "$ofSession" ] || [ "$ofSession" = "$2" ] || { printf '%s/context.%s.jsonl' "$ofRoot" "$2" ; return 0 ; }
	fi
	printf '%s/context.jsonl' "$ofRoot"
}

## Decides whether this run keeps its context, and says where. Called once, before the loop.
AgentsHarnessContextInit(){
	local initDir
	harnessContextFile=""
	harnessContextFeed=""
	[ "${MDAT_HARNESS_CONTEXT:-on}" != "off" ] || return 0
	[ -n "${MDAT_SPAWN_SANDBOX_ROOT:-}" ] && [ -d "$MDAT_SPAWN_SANDBOX_ROOT" ] || return 0
	[ -n "${MDAT_SPAWN_SESSION_ID:-}" ] || return 0
	[ "${MDAT_SPAWN_CALLER_WAITS:-}" != "true" ] || return 0
	[ "$( AgentsTranscriptSessionKey 2>/dev/null )" = "$MDAT_SPAWN_SESSION_ID" ] || return 0
	## ONE FILE A RUN: the sandbox folder is the session's, shared by every run that joined it, so a run keeps context.jsonl only in a folder
	## named for it (the session's own executor) and context.<spawn id>.jsonl in one it joined. One name for all of them had a joined run
	## rewrite the executor's file at its start and both append to it, so the executor's records and lines no longer matched, its transcript
	## stopped, and its kept context held another run's messages (AgentsHarnessContextFileOf, the one rule its readers use too).
	harnessContextFile="$( AgentsHarnessContextFileOf "$MDAT_SPAWN_SANDBOX_ROOT" "$MDAT_SPAWN_SESSION_ID" )"
	## A RESUME TAKES OVER THE FILE IT CONTINUES: the run it resumes has ended (AgentsReviewContextResumeEligible refuses a live one, and
	## AgentsHarnessContextResume refuses a file whose writer still runs), and the kept context becomes this run's, in the same file.
	case "${MDAT_HARNESS_RESUME_CONTEXT:-}" in "${MDAT_SPAWN_SANDBOX_ROOT%/}"/context*.jsonl) harnessContextFile="$MDAT_HARNESS_RESUME_CONTEXT" ;; esac
	## The transcript is rendered from the log from here on, not written by the per-call hooks.
	agentsTranscriptFromLog=1
	if initDir="$( AgentsTranscriptSessionDir "$MDAT_SPAWN_SESSION_ID" 2>/dev/null )" && mkdir -p "$initDir" 2>/dev/null ; then
		printf '%s\n' "$harnessContextFile" > "$initDir/context" 2>/dev/null || :
		## Its feed, while that is switched on (AgentsTools.EventTrackThread.include).
		type AgentsEventTrackFeedPathInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/event-track/AgentsTools.EventTrackThread.include"
		AgentsEventTrackFeedPathInto harnessContextFeed "$MDAT_SPAWN_SESSION_ID"
	fi
	return 0
}

## One message line; the record last, as its own bytes, or escaped where it holds a newline.
AgentsHarnessContextLine(){ ## n, kind, meta fragment (starting with a comma, or empty), record
	local lineRecord="$4" lineMs
	lineMs="$( date +%s )000" || lineMs=0
	case "$lineRecord" in
		*$'\n'*)
			printf '{"type":"message","n":%s,"leg":%s,"kind":"%s","round":%s,"ts":"%s","ms":%s%s,"record_text":"%s"}\n' \
				"$1" "$harnessContextLeg" "$2" "${harnessRound:-0}" "$( date -u +%Y-%m-%dT%H:%M:%SZ )" "${lineMs:-0}" "$3" "$( AgentsHarnessContextEscape "$lineRecord" )"
		;;
		*)
			printf '{"type":"message","n":%s,"leg":%s,"kind":"%s","round":%s,"ts":"%s","ms":%s%s,"record":%s}\n' \
				"$1" "$harnessContextLeg" "$2" "${harnessRound:-0}" "$( date -u +%Y-%m-%dT%H:%M:%SZ )" "${lineMs:-0}" "$3" "$lineRecord"
		;;
	esac
}

## A leg's file, written whole: header, system, tools reference, and every message so far.
## from: the messages this session did not produce (a resume's loaded ones), never rendered.
AgentsHarnessContextBegin(){ ## from (default 0)
	local beginTools beginTemp beginIndex=0 beginKind
	[ -n "$harnessContextFile" ] || return 0
	type AgentsToolsRunProcessStart > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/run/AgentsTools.RunProcesses.include"
	harnessContextLeg=$(( harnessContextLeg + 1 ))
	harnessContextFrom="${1:-0}"
	harnessContextLastAssistant=0
	beginTools="$( AgentsHarnessContextToolsJson )"
	beginTemp="$harnessContextFile.$$"
	{
		## The writer is the run's own process, with its start: a resume refuses the file while that process still runs (AgentsHarnessContextResume).
		printf '{"type":"context","version":1,"session":"%s","member":"%s","service":"%s","model":"%s","api_host":"%s","wire":"%s","machine":"%s","leg":%s,"from":%s,"ts":"%s","cache_key":"%s","system_shared":%s,"task":"%s","writer_pid":%s,"writer_start":"%s"}\n' \
			"$MDAT_SPAWN_SESSION_ID" "$( AgentsHarnessContextEscape "${harnessAgent:-}" )" "$( AgentsHarnessContextEscape "${harnessProviderName:-}" )" \
			"$( AgentsHarnessContextEscape "${harnessModel:-}" )" "$( AgentsHarnessContextEscape "${harnessHost:-}" )" "$harnessWire" \
			"$( AgentsHarnessContextEscape "$( AgentsHarnessContextMachine )" )" "$harnessContextLeg" "$harnessContextFrom" "$( date -u +%Y-%m-%dT%H:%M:%SZ )" \
			"${agentsWirePromptCacheKey:-}" "${agentsWireSystemSharedBytes:-0}" "$( AgentsHarnessContextEscape "$harnessPrompt" )" \
			"$$" "$( AgentsToolsRunProcessStart "$$" )"
		printf '{"type":"system","text":"%s"}\n' "$( AgentsHarnessContextSystemJson )"
		printf '{"type":"tools","cksum":"%s","bytes":%s}\n' "$( printf '%s' "$beginTools" | LC_ALL=C cksum | LC_ALL=C awk '{ print $1 ; }' )" "$( printf '%s' "$beginTools" | LC_ALL=C wc -c | tr -d ' ' )"
		while [ "$beginIndex" -lt "${#harnessMessages[@]}" ] ; do
			case "${harnessMessages[$beginIndex]}" in
				'{"role":"assistant"'*) beginKind=assistant ; harnessContextLastAssistant=$(( beginIndex + 1 )) ;;
				'{"role":"tool"'*|'{"role":"user","content":[{"type":"tool_result"'*) beginKind=tool ;;
				*) beginKind=user ;;
			esac
			## The first record is the task; on the chat-completions wire it is the system text, and the task follows.
			case "$harnessWire:$beginIndex" in
				AnthropicMessages:0) beginKind=task ;;
				AnthropicMessages:*) ;;
				*:0) beginKind=system ;;
				*:1) beginKind=task ;;
			esac
			AgentsHarnessContextLine "$(( beginIndex + 1 ))" "$beginKind" "" "${harnessMessages[$beginIndex]}"
			beginIndex=$(( beginIndex + 1 ))
		done
	} > "$beginTemp" 2>/dev/null && mv -f "$beginTemp" "$harnessContextFile" 2>/dev/null || {
		rm -f "$beginTemp" 2>/dev/null
		echo "${harnessWarn}⚠️  WARNING:${harnessOff} $harnessSelfName: the model context could not be kept in $harnessContextFile -- this run carries on without it, and cannot be resumed" >&2
		harnessContextFile=""
		agentsTranscriptFromLog=""
		return 0
	}
	harnessContextCount="${#harnessMessages[@]}"
	return 0
}

## Appends every record the array gained since the last call, each with the kind and
## meta given; then the new lines go to the event-track feed, where there is one.
AgentsHarnessContextSync(){ ## kind (user|assistant|tool), meta fragment
	local syncKind="$1" syncMeta="${2:-}" syncFirst
	[ -n "$harnessContextFile" ] || return 0
	[ -f "$harnessContextFile" ] || { AgentsHarnessContextBegin "$harnessContextFrom" ; return 0 ; }
	[ "$harnessContextCount" -lt "${#harnessMessages[@]}" ] || return 0
	syncFirst=$(( harnessContextCount + 1 ))
	while [ "$harnessContextCount" -lt "${#harnessMessages[@]}" ] ; do
		AgentsHarnessContextLine "$(( harnessContextCount + 1 ))" "$syncKind" "$syncMeta" "${harnessMessages[$harnessContextCount]}" >> "$harnessContextFile" 2>/dev/null || :
		harnessContextCount=$(( harnessContextCount + 1 ))
		[ "$syncKind" != "assistant" ] || harnessContextLastAssistant="$harnessContextCount"
	done
	AgentsHarnessContextFeed "$syncFirst"
	## A MILESTONE OF A KEPT-CONTEXT LOOP COMMITS AFTER ITS LINES ARE FED: the tool's own lines reach the transcript from this log, after the
	## tool ran, so a milestone taken at the tool's end committed before them and carried nothing new (the ask's ASK and ANSWER lines landed
	## in a later commit). AgentsTranscriptToolDone leaves the milestone here (agentsTranscriptMilestoneAfterFeed) and this is where it commits.
	if [ -n "${agentsTranscriptMilestoneAfterFeed:-}" ] ; then
		AgentsTranscriptMilestone "$( AgentsTranscriptSessionKey )" "$agentsTranscriptMilestoneAfterFeed" || :
		agentsTranscriptMilestoneAfterFeed=""
	fi
	return 0
}

## The new lines, by the transcript's own reader, to the session's transcript and to the event-track feed where there is one. The
## read starts at the latest assistant record, which the calls' arguments come from.
AgentsHarnessContextFeed(){ ## first new message n
	local feedStart="$1" feedLines feedPath
	[ "$harnessContextLastAssistant" -lt 1 ] || [ "$harnessContextLastAssistant" -ge "$feedStart" ] || feedStart="$harnessContextLastAssistant"
	feedLines="$( tail -n +"$(( feedStart + 3 ))" "$harnessContextFile" 2>/dev/null | LC_ALL=C awk -v from="$1" ${harnessContextAwk[@]+"${harnessContextAwk[@]}"} 2>/dev/null )" || feedLines=""
	[ -n "$feedLines" ] || return 0
	[ -z "$harnessContextFeed" ] || printf '%s\n' "$feedLines" >> "$harnessContextFeed" 2>/dev/null || :
	feedPath="$( AgentsTranscriptPath "$MDAT_SPAWN_SESSION_ID" 2>/dev/null )" || return 0
	AgentsTranscriptAppend "$feedPath" "$feedLines"
	return 0
}

## The meta of an assistant record: this round's tokens, as the transcript reads them.
AgentsHarnessContextAssistantMeta(){
	local metaIn=0 metaCr=0 metaCw=0 metaOut=0
	[ ! -s "$harnessScratch/stream.usage.detail" ] || read -r metaIn metaCr metaCw metaOut < "$harnessScratch/stream.usage.detail" || :
	printf ',"in":%s,"cache_read":%s,"cache_write":%s,"out":%s' "${metaIn:-0}" "${metaCr:-0}" "${metaCw:-0}" "${metaOut:-0}"
}

## WHAT A CALL ITSELF RAN, KEPT WHERE ITS RECORD READS IT: every tool runs in the subshell of harnessResult="$( ... )"
## (AgentsHarnessRun.include), so a variable it sets is gone when the record is written, and every call was all machinery --
## a 256 s Wait counted 256 s, and the pace gate held starts it should allow. The span goes to a file of the run's scratch too.
AgentsHarnessToolRunMsKeep(){ ## milliseconds the call itself ran
	harnessToolRunMs="$1"
	[ -z "${harnessScratch:-}" ] || printf '%s\n' "$1" > "$harnessScratch/tool.run.ms" 2> /dev/null || :
}

## The meta of a tool result: the call it answers, how long it ran and how it came out.
AgentsHarnessContextToolMeta(){ ## tool name, call id, result, preset outcome
	local metaDur=0 metaMach=0 metaCalls=""
	## A BATCH IS ITS CALLS (the owner's pace ruling): the engine leaves one tooling value a call in the run's scratch, and the
	## record carries that list. Its own mach_ms then counts nothing to the reader that knows the list.
	if [ -n "${harnessScratch:-}" ] && [ -f "$harnessScratch/tool.calls.ms" ] ; then
		{ IFS= read -r metaCalls < "$harnessScratch/tool.calls.ms" ; } 2> /dev/null || metaCalls=""
		rm -f "$harnessScratch/tool.calls.ms" 2> /dev/null || :
	fi
	[ -z "$metaCalls" ] || printf ',"calls_mach_ms":[%s]' "$metaCalls"
	[ -z "${agentsTranscriptT0:-}" ] || metaDur=$(( $( date +%s )000 - agentsTranscriptT0 ))
	## The span the tool kept from inside its subshell (AgentsHarnessToolRunMsKeep), read once and taken away, so no later call reads it.
	if [ -n "${harnessScratch:-}" ] && [ -f "$harnessScratch/tool.run.ms" ] ; then
		[ -n "${harnessToolRunMs:-}" ] || { IFS= read -r harnessToolRunMs < "$harnessScratch/tool.run.ms" ; } 2> /dev/null || :
		rm -f "$harnessScratch/tool.run.ms" 2> /dev/null || :
	fi
	## A WRAPPED TOOL'S SPAN, under its call's id (AgentsHarnessTaskBody): taken for the call it names only, and taken away either way.
	if [ -n "${harnessScratch:-}" ] && [ -f "$harnessScratch/tool.run.ms.call" ] ; then
		local metaCallId="" metaCallMs=""
		{ read -r metaCallId metaCallMs < "$harnessScratch/tool.run.ms.call" ; } 2> /dev/null || :
		[ -n "${harnessToolRunMs:-}" ] || [ "$metaCallId" != "$2" ] || harnessToolRunMs="$metaCallMs"
		rm -f "$harnessScratch/tool.run.ms.call" 2> /dev/null || :
	fi
	## MACHINERY TIME (the owner's pace ruling): what the tooling spent around the call, which is the call's whole time less what the
	## call itself ran -- the Bash child's run (AgentsHarnessToolsBash sets harnessToolRunMs around its wait), the Wait's own waiting
	## (AgentsHarnessWait sets it from the seconds waited). A tool that sets nothing is all machinery. The pace gate reads mach_ms.
	case "${harnessToolRunMs:-}" in ''|*[!0-9]*) metaMach="$metaDur" ;; *) metaMach=$(( metaDur - harnessToolRunMs )) ; [ "$metaMach" -ge 0 ] || metaMach=0 ;; esac
	harnessToolRunMs=""
	printf ',"tool":"%s","id":"%s","dur_ms":%s,"mach_ms":%s,"outcome":"%s"' "$( AgentsHarnessContextEscape "$1" )" "$( AgentsHarnessContextEscape "$2" )" "$metaDur" "$metaMach" "$( AgentsTranscriptOutcomeOf "$3" "$4" )"
}

## A reply with no tool call, kept as the assistant turn it was, so a resume continues
## after it: the Anthropic wire's own blocks, else the chat-completions text message.
AgentsHarnessContextAssistantRecord(){
	case "$harnessWire" in
		AnthropicMessages) AgentsWireAssistantToolCallsRecord "" ;;
		*) printf '{"role":"assistant","content":"%s"%s}' "$( AgentsHarnessContextEscape "$( AgentsWireFinalContent )" )" "$( AgentsWireReasoningField )" ;;
	esac
}

## That reply appended and kept: the final answer, a closing round's, a summary's.
AgentsHarnessContextReply(){
	[ -n "$harnessContextFile" ] || return 0
	harnessMessages+=( "$( AgentsHarnessContextAssistantRecord )" )
	AgentsHarnessContextSync assistant "$( AgentsHarnessContextAssistantMeta )"
	return 0
}

## A header field of a context file, decoded.
AgentsHarnessContextHeader(){ ## file, field
	local headerValue
	headerValue="$( head -1 "$1" | LC_ALL=C awk -v path="$2" -v optional=1 -v sentinel=1 -f "$harnessHere/harness/AgentsHarnessJsonField.awk" 2>/dev/null )" || headerValue=""
	printf '%s' "${headerValue%X}"
}

## The roots of this leg that the kept first messages do not name (a child's, spawned since: AgentsHarnessRunRootsText), as the paragraph
## that tells a run its own roots; nothing where it names them all. A root named by no record before is told with the message that brings it,
## and is never written back into the system text or into a record already kept, which a resumed request must begin with byte for byte.
AgentsHarnessContextResumeRoots(){ ## the kept system text and first records, as the context holds them
	local rootsKept="$1" rootsLine rootsNew="" rootsNewWrite=""
	while IFS= read -r rootsLine ; do
		[ -z "$rootsLine" ] || case "$rootsKept" in *'\n'"$( AgentsHarnessContextEscape "$rootsLine" )"'\n'*) ;; *) rootsNew="${rootsNew}${rootsLine}"$'\n' ;; esac
	done <<< "$harnessRunRoots"
	while IFS= read -r rootsLine ; do
		[ -z "$rootsLine" ] || case "$rootsKept" in *'\n'"$( AgentsHarnessContextEscape "$rootsLine" )"'\n'*) ;; *) rootsNewWrite="${rootsNewWrite}${rootsLine}"$'\n' ;; esac
	done <<< "$harnessRunWriteRoots"
	[ -z "$rootsNew$rootsNewWrite" ] || AgentsHarnessRunRootsText "$rootsNew" "$rootsNewWrite"
}

## Loads MDAT_HARNESS_RESUME_CONTEXT in place of AgentsWireInitMessages, then appends the
## corrections. rc 1, with the reason on stderr, when it is not this run's to continue:
## another model, service, API host, wire or machine, or a file that does not parse.
## STRICT JSON AT THE DOOR (measured 2026-11-25): a tool record can pass this file's own validator and still be
## rejected by the provider -- "messages[26]: expected value at line 47 column 246268", request 2ebc679f -- and a
## resumed session then dies in one second and can never come back. Every line is parsed strictly here, and a line that
## fails is replaced by a short note record, so the request body is always valid JSON and the resume goes on.
AgentsHarnessContextRepair(){ ## file -- rc 0 always; a NOTE on stderr for each line it replaced
	python3 - "$1" <<'PY' || :
import json,sys
path=sys.argv[1]
lines=open(path,encoding='utf-8',errors='replace').read().split('\n')
if lines and lines[-1]=='' : lines=lines[:-1]
out=[]; bad=0
for line in lines:
    try:
        json.loads(line); out.append(line); continue
    except Exception:
        bad+=1
        try: head=json.loads(line.split(',"record"')[0]+'}')
        except Exception: head=None
        note='[record dropped at resume: it failed strict JSON validation]'
        if isinstance(head,dict) and head.get('type')=='message':
            head.pop('record',None); head.pop('record_text',None)
            head['record']={'role':'user','content':note}
            out.append(json.dumps(head,ensure_ascii=False,separators=(',',':')))
        else:
            out.append(json.dumps({'type':'message','kind':'assistant','record':{'role':'user','content':note}},ensure_ascii=False,separators=(',',':')))
## A FILE THAT MIXED TWO WRITERS OR TWO ERAS numbers its messages twice over and loads nowhere (the header's own
## warning): the order is the conversation, so the numbers are re-cut in that order here, 1 to N, and the file resumes.
numbers=[]
for line in out:
    try: obj=json.loads(line)
    except Exception: continue
    if obj.get('type')=='message':
        try: numbers.append(int(obj.get('n')))
        except Exception: numbers.append(-1)
renumber = numbers != list(range(1,len(numbers)+1))
if renumber:
    index=0
    for at,line in enumerate(out):
        try: obj=json.loads(line)
        except Exception: continue
        if obj.get('type')!='message': continue
        index+=1
        obj['n']=index
        out[at]=json.dumps(obj,ensure_ascii=False,separators=(',',':'))
if bad or renumber:
    open(path,'w',encoding='utf-8').write('\n'.join(out)+'\n')
    if bad: sys.stderr.write('NOTE: %d record(s) of the kept context failed strict JSON and were replaced at resume\n'%bad)
    if renumber: sys.stderr.write('NOTE: the kept context numbered its messages out of order across eras; they were re-cut 1 to %d at resume\n'%index)
PY
	return 0
}

AgentsHarnessContextResume(){
	local resumeFile="$MDAT_HARNESS_RESUME_CONTEXT" resumeCount resumeIndex=1 resumeDir resumeWhy="" resumeSystem resumeTools resumeKey resumeTask resumeRoots resumeCallId resumeCallIds resumeAnswered resumeWriter
	type AgentsToolsRunProcessStart > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/run/AgentsTools.RunProcesses.include"
	[ ! -s "$resumeFile" ] || AgentsHarnessContextRepair "$resumeFile" || :
	if [ ! -s "$resumeFile" ] ; then
		resumeWhy="no context file at $resumeFile"
	elif ! resumeCount="$( LC_ALL=C awk -v mode=validate ${harnessContextAwk[@]+"${harnessContextAwk[@]}"} "$resumeFile" 2>&1 )" ; then
		resumeWhy="$resumeFile does not parse: $resumeCount"
	elif [ "$( AgentsHarnessContextHeader "$resumeFile" model )" != "$harnessModel" ] ; then
		resumeWhy="the context was kept for model $( AgentsHarnessContextHeader "$resumeFile" model ), this run is $harnessModel"
	elif [ "$( AgentsHarnessContextHeader "$resumeFile" service )" != "$harnessProviderName" ] ; then
		resumeWhy="the context was kept for service $( AgentsHarnessContextHeader "$resumeFile" service ), this run is $harnessProviderName"
	elif [ "$( AgentsHarnessContextHeader "$resumeFile" api_host )" != "$harnessHost" ] ; then
		resumeWhy="the context was kept for API host $( AgentsHarnessContextHeader "$resumeFile" api_host ), this run is $harnessHost"
	elif [ "$( AgentsHarnessContextHeader "$resumeFile" wire )" != "$harnessWire" ] ; then
		resumeWhy="the context was kept on wire $( AgentsHarnessContextHeader "$resumeFile" wire ), this run is $harnessWire"
	elif [ "$( AgentsHarnessContextHeader "$resumeFile" machine )" != "$( AgentsHarnessContextMachine )" ] ; then
		resumeWhy="the context was kept on host $( AgentsHarnessContextHeader "$resumeFile" machine ), not $( AgentsHarnessContextMachine )"
	## Two writers in one file number its records twice over, and the file then loads nowhere: the run that writes it must have ended.
	elif resumeWriter="$( AgentsHarnessContextHeader "$resumeFile" writer_pid )" && [ -n "$resumeWriter" ] && [ "$resumeWriter" != "$$" ] && kill -0 "$resumeWriter" 2> /dev/null \
		&& [ "$( AgentsToolsRunProcessStart "$resumeWriter" )" = "$( AgentsHarnessContextHeader "$resumeFile" writer_start )" ] ; then
		resumeWhy="its writer is still running: process $resumeWriter, started $( AgentsHarnessContextHeader "$resumeFile" writer_start )"
	elif [ "${resumeCount:-0}" -lt 1 ] ; then
		resumeWhy="the context holds no message"
	fi
	if [ -n "$resumeWhy" ] ; then
		echo "${harnessBad}⛔ ERROR:${harnessOff} $harnessSelfName: MDAT_HARNESS_RESUME_CONTEXT cannot be resumed here -- $resumeWhy. Nothing was sent." >&2
		return 1
	fi
	resumeDir="$harnessScratch/resume"
	mkdir -p "$resumeDir" && LC_ALL=C awk -v mode=extract -v dir="$resumeDir" ${harnessContextAwk[@]+"${harnessContextAwk[@]}"} "$resumeFile" > /dev/null 2>&1 || {
		echo "${harnessBad}⛔ ERROR:${harnessOff} $harnessSelfName: the records of $resumeFile could not be read back. Nothing was sent." >&2
		return 1
	}
	## The system line's own bytes: `{"type":"system","text":"` ... `"}`.
	resumeSystem="$( sed -n 2p "$resumeFile" )"
	resumeSystem="${resumeSystem#\{\"type\":\"system\",\"text\":\"}"
	resumeSystem="${resumeSystem%\"\}}"
	## The system as it was sent -- the blocks and their marker, split where the header says (system_shared) -- and not rendered again.
	AgentsWireSystemReplay "$resumeSystem" "$( AgentsHarnessContextHeader "$resumeFile" system_shared )"
	harnessMessages=()
	while [ "$resumeIndex" -le "$resumeCount" ] ; do
		harnessMessages+=( "$( cat "$resumeDir/rec.$resumeIndex" ; printf X )" )
		harnessMessages[$(( resumeIndex - 1 ))]="${harnessMessages[$(( resumeIndex - 1 ))]%X}"
		resumeIndex=$(( resumeIndex + 1 ))
	done
	rm -rf "$resumeDir" 2>/dev/null || :
	## A run that died inside a tool round leaves calls with no result, and a provider refuses that history for good: each gets one now (S6.16).
	## EVERY KEPT RECORD IS READ, not the last alone: a death after the first result leaves that result as the last record,
	## and the call beside it would otherwise stay unanswered for ever. The chat wire's turn carries its calls as `tool_calls`,
	## the Messages wire's as `tool_use` blocks, and a result names its call `tool_call_id` or `tool_use_id`.
	resumeCallIds="" ; resumeAnswered=""
	resumeIndex=0
	while [ "$resumeIndex" -lt "$resumeCount" ] ; do
		case "${harnessMessages[$resumeIndex]}" in
			'{"role":"assistant"'*'"tool_calls"'*)
				resumeCallIds="$resumeCallIds$( printf '%s' "${harnessMessages[$resumeIndex]}" | LC_ALL=C grep -o -E '"id":"[^"]+"' | LC_ALL=C sed -E 's/^"id":"//; s/"$//' )"$'\n'
			;;
			'{"role":"assistant"'*'"type":"tool_use"'*)
				resumeCallIds="$resumeCallIds$( printf '%s' "${harnessMessages[$resumeIndex]}" | LC_ALL=C grep -o -E '"type":"tool_use","id":"[^"]+"' | LC_ALL=C sed -E 's/^"type":"tool_use","id":"//; s/"$//' )"$'\n'
			;;
			*'"tool_call_id":"'*|*'"tool_use_id":"'*)
				while IFS= read -r resumeCallId ; do
					[ -z "$resumeCallId" ] || resumeAnswered="$resumeAnswered $resumeCallId"
				done <<< "$( printf '%s' "${harnessMessages[$resumeIndex]}" | LC_ALL=C grep -o -E '"(tool_call_id|tool_use_id)":"[^"]+"' | LC_ALL=C sed -E 's/^"[a-z_]+":"//; s/"$//' )"
			;;
		esac
		resumeIndex=$(( resumeIndex + 1 ))
	done
	while IFS= read -r resumeCallId ; do
		[ -n "$resumeCallId" ] || continue
		case " $resumeAnswered " in *" $resumeCallId "*) continue ;; esac
		harnessMessages+=( "$( AgentsWireToolResultRecord "$resumeCallId" "ERROR: the run ended before this call gave a result, so it did not complete." "" )" )
	done <<< "$resumeCallIds"
	## The same prompt-cache routing key the context was kept under, where the wire has one.
	resumeKey="$( AgentsHarnessContextHeader "$resumeFile" cache_key )"
	if [ -n "$resumeKey" ] && [ -n "${agentsWirePromptCacheKey:-}" ] && [ "$resumeKey" != "$agentsWirePromptCacheKey" ] ; then
		harnessExtraHeaders="${harnessExtraHeaders//$agentsWirePromptCacheKey/$resumeKey}"
		agentsWirePromptCacheKey="$resumeKey"
	fi
	resumeTools="$( sed -n 3p "$resumeFile" | LC_ALL=C awk -v path=cksum -v optional=1 -f "$harnessHere/harness/AgentsHarnessJsonField.awk" 2>/dev/null )" || resumeTools=""
	[ "$resumeTools" = "$( AgentsHarnessContextToolsJson | LC_ALL=C cksum | LC_ALL=C awk '{ print $1 ; }' )" ] \
		|| echo "${harnessWarn}⚠️  WARNING:${harnessOff} $harnessSelfName: the tool set differs from the one the context was kept with -- resuming anyway, but the prompt cache will not cover the tools" >&2
	## The corrections are the new user turn; the task a later restart re-renders keeps both.
	resumeTask="$( AgentsHarnessContextHeader "$resumeFile" task )"
	resumeRoots="$( AgentsHarnessContextResumeRoots "${agentsWireSystemJson:-}${harnessMessages[0]:-}${harnessMessages[1]:-}" )"
	if [ -n "$resumeRoots" ] ; then
		harnessMessages+=( "$( AgentsWireUserRecord "$resumeRoots"$'\n\n'"$harnessPrompt" )" )
	else
		harnessMessages+=( "$( AgentsWireUserRecord "$harnessPrompt" )" )
	fi
	[ -z "$resumeTask" ] || printf -v harnessPrompt '%s\n\n%s' "$resumeTask" "$harnessPrompt"
	printf '%s\n' "${harnessValue}♻️  resumed${harnessOff} ${harnessDim}-- $resumeCount messages from $resumeFile, then the corrections as a new user turn${harnessOff}" >&2
	harnessContextResumed="$resumeCount"
	[ -z "${MDAT_HARNESS_RESUME_MARKER:-}" ] || : > "$MDAT_HARNESS_RESUME_MARKER" 2>/dev/null || :
	return 0
}
