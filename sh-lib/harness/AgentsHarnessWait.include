#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

## AgentsHarnessWait.include: dismissal records, seats, the Wait tool and the CheckList it names on every return. Sourced by AgentsUniversalHarness.sh, definitions only.

## The mark's file. rc 1, nothing printed, for a session that keeps none.
AgentsHarnessDismissedFile(){
	[ -n "${MDAT_SPAWN_SESSION_ID:-}" ] && [ -n "${MMDAPP:-}" ] && AgentsHarnessBareName "$MDAT_SPAWN_SESSION_ID" || return 1
	case "$MDAT_SPAWN_SESSION_ID" in .|..) return 1 ;; esac
	printf '%s' "$MMDAPP/.local/agents/sessions/$MDAT_SPAWN_SESSION_ID/dismissed"
}

## Keeps the dismissal, once: who dismissed this session, as its Wait said it.
AgentsHarnessDismissedKeep(){ ## who dismissed it (the WAIT-DISMISSED-BY value)
	local keepFile keepTemp
	keepFile="$( AgentsHarnessDismissedFile )" || return 0
	[ ! -f "$keepFile" ] || return 0
	keepTemp="$( mkdir -p "${keepFile%/*}" && mktemp "$keepFile.tmp.XXXXXX" )" || return 0
	{ printf '%s\n' "${1:-unknown}" > "$keepTemp" && chmod 644 "$keepTemp" && mv -f "$keepTemp" "$keepFile" ; } 2> /dev/null || rm -f -- "$keepTemp"
	return 0
}

## THE PARK MARK (S27.2), the same marker convention as the dismissal's: the file that says this
## run handed back with nothing pending and waits for a verdict. It is the one home of the fact,
## so the registry derives `awaiting review` from it rather than from a field set beside it.
AgentsHarnessParkedFile(){
	[ -n "${MDAT_SPAWN_SESSION_ID:-}" ] && [ -n "${MMDAPP:-}" ] && AgentsHarnessBareName "$MDAT_SPAWN_SESSION_ID" || return 1
	case "$MDAT_SPAWN_SESSION_ID" in .|..) return 1 ;; esac
	printf '%s' "$MMDAPP/.local/agents/sessions/$MDAT_SPAWN_SESSION_ID/parked"
}

## Whether this run is parked: rc 0 where the mark stands, rc 1 where it does not.
AgentsHarnessParked(){
	local parkedPath
	parkedPath="$( AgentsHarnessParkedFile )" || return 1
	[ -f "$parkedPath" ]
}

## THE ACTIVITY WORD OF A RUN (S27.4): `sessions/<spawn-id>/activity`, one line, overwritten, the
## same one-writer marker convention as `dismissed` and `.armed`. It says what the run is doing,
## never what it achieved. The round and the time travel beside the word, so a reader compares it
## against the run instead of trusting it, and a word left by a dead process is never the answer.
AgentsHarnessActivityWrite(){ ## the word: `thinking`, or `tool <name>`
	local actFile
	actFile="$( AgentsHarnessDismissedFile )" || return 0
	actFile="${actFile%/dismissed}/activity"
	mkdir -p "${actFile%/*}" 2> /dev/null || return 0
	printf '%s %s %s\n' "${harnessRound:-0}" "$( date +%s 2> /dev/null )" "$1" > "$actFile" 2> /dev/null || :
}

## Who dismissed this session, printed. rc 1 for a session that was not dismissed.
AgentsHarnessDismissedBy(){
	local byFile byLine=""
	byFile="$( AgentsHarnessDismissedFile )" || return 1
	[ -f "$byFile" ] || return 1
	IFS= read -r byLine < "$byFile" || :
	printf '%s' "${byLine:-unknown}"
}

## Why a run that is about to end refused went no further, kept beside the record where the
## closer reads it into `end-reason` (AgentsToolsSpawnProxyCloseSandboxOnce): the same marker
## convention the `.harness` and `.armed` files use, so an operator reads the reason on the
## session's own state rather than digging it out of a log. One line, newlines and tabs
## collapsed. Nothing for a run no spawn named (a served call, a native CLI), which keeps no
## such record and no such marker.
AgentsHarnessRefusalKeep(){ ## the reason, one line
	local keepRoot="${MDAT_SPAWN_SANDBOX_ROOT:-}" keepSession="${MDAT_SPAWN_SESSION_ID:-}" keepReason keepFile keepTemp
	[ -n "$keepRoot" ] && [ -n "$keepSession" ] && [ -n "${1:-}" ] || return 0
	keepFile="$keepRoot/$keepSession.refused"
	keepReason="$( printf '%s' "$1" | LC_ALL=C tr '\n\t' '  ' )"
	keepTemp="$( mktemp "$keepFile.tmp.XXXXXX" 2> /dev/null )" || return 0
	{ printf '%s\n' "$keepReason" > "$keepTemp" 2>/dev/null && chmod 644 "$keepTemp" && mv -f "$keepTemp" "$keepFile" ; } 2>/dev/null || rm -f -- "$keepTemp"
	## Every refusal is flagged, not only the usage limit (sketch 3.6): one line appended to
	## `<spawn-id>.refused-log` each time this run hits one, the same append convention
	## `.restarts` already uses, so the closer counts it the same way into the record's
	## `refused:` header. `.refused` above stays the single latest reason alone, for
	## end-reason; this is the count, never read for its own text.
	printf '%s\n' "$( date -u +%Y-%m-%dT%H:%M:%SZ )" >> "$keepRoot/$keepSession.refused-log" 2> /dev/null || :
	return 0
}

## Each summarise-and-restart of this run, kept beside the run record where the closer reads
## it into the record's `restarts:` header (AgentsToolsSpawnProxyCloseSandboxOnce): the same
## marker convention the `.harness`, `.armed` and `.refused` files use. One line per restart,
## `<number> <the threshold it restarted at> <UTC time>`, so the record says how many and the
## line itself still says when and at what size. Nothing for a run no spawn named (a served
## call, a native CLI), which keeps no such record and no such marker.
AgentsHarnessRestartKeep(){ ## restart number, the threshold it restarted at
	local keepRoot="${MDAT_SPAWN_SANDBOX_ROOT:-}" keepSession="${MDAT_SPAWN_SESSION_ID:-}" keepFile
	[ -n "$keepRoot" ] && [ -n "$keepSession" ] || return 0
	case "$keepSession" in ''|.|..|*/*) return 0 ;; esac
	keepFile="$keepRoot/$keepSession.restarts"
	printf '%s %s %s\n' "${1:-0}" "${2:-0}" "$( date -u +%Y-%m-%dT%H:%M:%SZ )" >> "$keepFile" 2> /dev/null || :
	return 0
}

## The last line of a result for a dismissed session: what is left for it to do.
AgentsHarnessDismissedNext(){
	local nextFile
	if nextFile="$( AgentsHarnessDismissedFile )" && [ -f "$nextFile.handback" ] ; then
		printf 'NEXT: you are dismissed and your handback is given -- end your run now, and call nothing more\n'
	else
		printf 'NEXT: you are dismissed -- give your handback if you have not, then end your run\n'
	fi
}

AgentsHarnessDismissedAfter(){ ## tool name
	local afterFile afterDelay afterSession afterGrace="${MDAT_DISMISSED_END_GRACE:-60}"
	case "$1" in SubagentHandback|Wait|SendMessage) ;; *) return 0 ;; esac
	afterFile="$( AgentsHarnessDismissedFile )" && [ -f "$afterFile.handback" ] || return 0
	if [ -z "$harnessToolOnly" ] ; then
		harnessDismissedEnd=1
		return 0
	fi
	AgentsHarnessWholeNumber "$afterGrace" || afterGrace=60
	afterDelay=2 ; [ "$1" != "SubagentHandback" ] || afterDelay="$afterGrace"
	afterSession="$MDAT_SPAWN_SESSION_ID"
	type AgentsToolsRegistryRunWords > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.Registries.include" 2> /dev/null || return 0
	(
		trap '' HUP INT
		afterFd=3 ; while [ "$afterFd" -lt 64 ] ; do eval "exec $afterFd>&-" ; afterFd=$(( afterFd + 1 )) ; done
		sleep "$afterDelay"
		afterWord="$( AgentsHarnessSessionWordPids "$afterSession" )"
		afterPids=""
		for afterPid in $afterWord ; do
			[ "$( ps -p "$afterPid" -ww -o args= 2> /dev/null | AgentsToolsRegistryRunWords )" != "$afterSession" ] || afterPids="$afterPids $afterPid"
		done
		[ -n "$afterPids" ] || [ -n "$afterWord" ] || afterPids="$( AgentsHarnessSessionPids "$afterSession" )"
		[ -n "$afterPids" ] || exit 0
		printf '# %s: the tooling ends this run: it was dismissed, its handback is given, and it did not end by itself\n' "$( date -u +%Y-%m-%dT%H:%M:%SZ )" >> "$MMDAPP/.local/agents/sessions/$afterSession/session.log" 2> /dev/null
		for afterPid in $afterPids ; do
			kill -TERM "$afterPid" 2> /dev/null
		done
		exit 0
	) > /dev/null 2>&1 < /dev/null &
	return 0
}

## This run's seat in its session: rc 0, nothing printed, where it holds it or has none to hold
## (no spawn record of its own, a record that names no session, or a seat that cannot be read
## now); rc 1, the holder's spawn id printed, where another live run of its member holds it.
AgentsHarnessSeatTake(){
	local seatRecord="" seatSession="" seatHolder="" seatRc=0
	seatRecord="$( AgentsHarnessSpawnRecordPath "${MDAT_SPAWN_SESSION_ID:-}" )" && [ -n "$seatRecord" ] || return 0
	type AgentsToolsSessionSeatTake > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SpawnSandbox.include" 2> /dev/null || return 0
	seatSession="$( AgentsToolsSpawnSandboxRecordHeader "$seatRecord" session-id )"
	[ -n "$seatSession" ] || return 0
	seatHolder="$( AgentsToolsSessionSeatTake "$seatSession" "$harnessAgent" "$seatRecord" )" || seatRc=$?
	[ "$seatRc" = "1" ] && [ -n "$seatHolder" ] || return 0
	printf '%s' "$seatHolder"
	return 1
}

## Whether the run that holds this run's seat is its restart: its record names this run as the
## one it restarts (`restarted-from:`). rc 0 it is.
AgentsHarnessSeatPassed(){ ## the holder's spawn id
	local passedRecord=""
	passedRecord="$( AgentsToolsSessionRunRecord "$1" )" || return 1
	[ "$( AgentsToolsSpawnSandboxRecordHeader "$passedRecord" restarted-from )" = "${MDAT_SPAWN_SESSION_ID:-}" ]
}

## Whether a served wait reads this run's session: with its default sources (its session thread
## and the threads it continues), with slack:session-current, or continuing its stored wait.
## A chat: source is the session's one chat file, which is the session channel of a session
## whose external side is the root-native printback kind (F2.3), so a wait on it reads the session too.
AgentsHarnessWaitReadsSession(){ ## sources, mode
	case "$2" in
		continue) return 0 ;;
		close) return 1 ;;
	esac
	[ -n "$1" ] || return 0
	case " $1 " in
		*" slack:$harnessCurrentName "*) return 0 ;;
		*" chat:"*) return 0 ;;
	esac
	return 1
}

## Whether a dismissal of this run waits (AgentsToolsSessionDismissHeld): rc 0 it does, the
## participants of its session that still run printed on one line.
AgentsHarnessDismissWaits(){
	local waitsRecord="" waitsOthers=""
	waitsRecord="$( AgentsHarnessSpawnRecordPath "${MDAT_SPAWN_SESSION_ID:-}" )" && [ -n "$waitsRecord" ] || return 1
	type AgentsToolsSessionDismissHeld > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SpawnSandbox.include" 2> /dev/null || return 1
	waitsOthers="$( AgentsToolsSessionDismissHeld "$waitsRecord" )" || return 1
	printf '%s' "$waitsOthers" | LC_ALL=C tr '\n' ' ' | LC_ALL=C sed 's/ $//'
}

## A dismissal held while others of this run's session ran (AgentsToolsSessionDismissHold), given
## once it may be: kept as this run's dismissal, and printed as the Wait result it is, rc 0. rc 1
## where none is held, or where it still waits.
AgentsHarnessDismissHeldGive(){
	local giveFile giveBy="" giveHandback=""
	[ -n "${MDAT_SPAWN_SESSION_ID:-}" ] && [ -n "${MMDAPP:-}" ] && AgentsHarnessBareName "$MDAT_SPAWN_SESSION_ID" || return 1
	giveFile="$MMDAPP/.local/agents/sessions/$MDAT_SPAWN_SESSION_ID/dismiss-held"
	[ -f "$giveFile" ] || return 1
	! AgentsHarnessDismissWaits > /dev/null || return 1
	{ IFS= read -r giveBy ; IFS= read -r giveHandback ; } < "$giveFile" || :
	AgentsHarnessDismissedKeep "${giveBy:-unknown}"
	[ "$giveHandback" != "handback-given" ] || : > "$( AgentsHarnessDismissedFile ).handback" 2> /dev/null || :
	rm -f "$giveFile"
	printf 'WAIT-RESULT: DISMISSED\nWAIT-DISMISSED-BY: %s\n# held while other runs of this session ran, and given now that they have ended\n' "${giveBy:-unknown}"
	return 0
}

## The refusal of a run that finds its member's seat held by a live run of its session, at its
## first read of the session or post to it: printed, naming the holder and where to ask it
## (<session>:<member>, as the spawn proxy's refusal at start names it), and the run ended the one
## way a run is ended -- a dismissed mark whose handback is marked given, so the harness ends it
## once this call is over (AgentsHarnessDismissedAfter). rc 0.
AgentsHarnessSeatRefuse(){ ## what was refused (read, sent), the holder's spawn id
	local refuseSession="" refuseMark=""
	type AgentsToolsSpawnSandboxRecordHeader > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SpawnSandbox.include" 2> /dev/null || :
	refuseSession="$( AgentsToolsSpawnSandboxRecordHeader "$( AgentsHarnessSpawnRecordPath "${MDAT_SPAWN_SESSION_ID:-}" )" session-id )"
	printf 'ERROR: not %s: run %s holds the seat of %s in session %s, and a member is active once in a session. This run is refused and ends. Send what it should do there with SendMessage to %s:%s.\n' \
		"$1" "$2" "$harnessAgent" "$refuseSession" "$refuseSession" "$harnessAgent"
	AgentsHarnessDismissedKeep "tooling (the seat of $harnessAgent in its session is held by run $2, so this run is refused)"
	refuseMark="$( AgentsHarnessDismissedFile )" && : > "$refuseMark.handback" 2> /dev/null || :
	printf 'NEXT: end your run now, and call nothing more\n'
	return 0
}

## The one line a Wait adds about the caller's own CheckList, on every return that is not the idle one: the count and never the
## items, so a quiet round and a delivered one cost a member about ten tokens. A session the harness gives no place for a list says
## nothing, having nowhere to keep one, and neither does a call that waits for an ask (its output is the ask's, not a Wait result's).
AgentsHarnessWaitCheckListLine(){
	local lineCounts="" lineRc=0 lineAll=0 lineOpen=0 lineActive=0
	lineCounts="$( AgentsHarnessCheckListCounts )" ; lineRc=$?
	case "$lineRc" in
		0) ;;
		1) printf 'CHECKLIST: none on record, so write one with CheckList\n' ; return 0 ;;
		*) return 0 ;;
	esac
	lineAll="${lineCounts%% *}" lineOpen="${lineCounts#* }" lineOpen="${lineOpen%% *}" lineActive="${lineCounts##* }"
	if [ "$lineActive" != "0" ] ; then
		printf 'CHECKLIST: %s pending, %s in progress\n' "$lineOpen" "$lineActive"
	elif [ "$lineOpen" != "0" ] ; then
		printf 'CHECKLIST: %s pending\n' "$lineOpen"
	else
		printf 'CHECKLIST: all %s closed\n' "$lineAll"
	fi
}

## THE RUN'S BACKGROUND JOBS, beside its CheckList: a job of the session's processes/ with no status, not closed and with a live pid
## is still running, unfinished work of this run, so every Wait names it and how to collect it.
AgentsHarnessWaitBackgroundLine(){
	local bgSession bgDir bgFile bgName bgPid bgRest bgList="" bgCount=0
	bgSession="$( AgentsHarnessSessionKey )" || return 0
	[ -n "$bgSession" ] && AgentsHarnessBareName "$bgSession" || return 0
	bgDir="$MMDAPP/.local/agents/sessions/$bgSession/processes"
	for bgFile in "$bgDir"/process-*.pid ; do
		[ -f "$bgFile" ] || continue
		bgName="${bgFile##*/}" ; bgName="${bgName%.pid}"
		[ ! -f "$bgDir/$bgName.status" ] && [ ! -f "$bgDir/$bgName.closed" ] || continue
		bgPid="" ; read -r bgPid bgRest < "$bgFile" 2> /dev/null || :
		case "$bgPid" in ''|*[!0123456789]*) continue ;; esac
		kill -0 "$bgPid" 2> /dev/null || continue
		bgCount=$(( bgCount + 1 )) ; bgList="$bgList $bgName"
	done
	[ "$bgCount" -gt 0 ] || return 0
	printf 'BACKGROUND: %s running:%s -- collect each with TaskOutput, or Wait sources=process:<handle>\n' "$bgCount" "$bgList"
}

## AN ITEM PAST ITS DUE TIME IS A FLOOR SOURCE (S13.9): the items of the caller's own CheckList whose due time
## has come are returned at once, ahead of every other source and before any probe, in a `CheckList pending:`
## block under one line saying what they are. The reaction layer puts a fresh state in front of the member
## rather than at the end of a wait, which is the whole point of a due time: a duty written on the list is not
## missed because a quiet round came first. A call that waits for an ask is the ask's, and carries none of it.
AgentsHarnessWaitCheckListDue(){
	local dueOut="" dueRc=0
	[ "$1" = "true" ] || return 0
	dueOut="$( AgentsHarnessCheckListDue )" ; dueRc=$?
	[ "$dueRc" = "0" ] || return 0
	printf 'CheckList pending: these items of your list are past their due time, and they are yours to close before you wait again.\n%s\n' "$dueOut"
	return 0
}

## The idle Wait (owner 2026-10-31): a call naming no source of its own, from a session that has handed back since the floor last
## returned an arrival, or that is a work duty's own quiet loop, is that member asking for more work, a review or DISMISSED. Its open
## items are returned at once then, before any probe and any wait, so it finishes or closes them first; what the floor already holds
## comes with this return, from the reply layer every tool result carries, so nothing is probed for it and no network is read.
## EVERY SUCH CALL, WHILE ANY ITEM IS PENDING (S22 item 6): the list is the queue, so a member that has handed back is given its
## open items on each idle call, not once and then left to wait. A call that names a source of its own, and `mode continue`, are
## waiting on purpose and check nothing.
## The mark `handback.given`, in the same folder, is written by a delivered handback and cleared by a Wait that delivers an arrival:
## it is the whole of "has handed back since its last arrival", one local file, and a work duty needs none of it.
AgentsHarnessWaitCheckListIdle(){ ## the sources the call itself named, its mode
	local idleOwn="$1" idleModeArg="$2" idleOpen="" idleRc=0 idleCount=0 idleItem=""
	local idleFolder="" idleGiven="" idleActive=0
	[ -z "$idleOwn" ] || return 0
	case "$idleModeArg" in default) ;; *) return 0 ;; esac
	idleOpen="$( AgentsHarnessCheckListOpenItems )" ; idleRc=$?
	[ "$idleRc" = "0" ] || return 0
	while IFS= read -r idleItem ; do
		[ -z "$idleItem" ] || idleCount=$(( idleCount + 1 ))
	done <<< "$idleOpen"
	[ "$idleCount" -gt 0 ] || return 0
	AgentsHarnessCheckListPlace || return 0
	idleFolder="$checkListFolder"
	if ! AgentsHarnessWorkDuty ; then
		[ -f "$idleFolder/handback.given" ] || return 0
		IFS= read -r idleGiven < "$idleFolder/handback.given" || :
		case "$idleGiven" in ''|*[!0123456789]*) return 0 ;; esac
	fi
	idleActive="$( AgentsHarnessCheckListCounts )" ; idleActive="${idleActive##* }"
	case "$idleActive" in ''|*[!0123456789]*) idleActive=0 ;; esac
	if [ "$idleActive" != "0" ] ; then
		printf 'CHECKLIST: %s pending, %s in progress. Finish or close them before you wait for DISMISSED.\n%s' "$idleCount" "$idleActive" "$idleOpen"
	else
		printf 'CHECKLIST: %s pending. Finish or close them before you wait for DISMISSED.\n%s' "$idleCount" "$idleOpen"
	fi
}

## A DISMISSAL IS NEVER HELD BEHIND THE CHECKLIST (S12.15): the session's chat file is its primary channel, and a DISMISSED for this
## run that waits there makes the Wait read it, rather than give the open items first. Otherwise a run whose list holds an open item
## -- a work duty's always may -- could never be dismissed by a message. A look at the floor the Wait would deliver (AgentsToolsSessionChatFloor,
## with no delivery, so no pointer moves), with the one dismissal rule the Wait uses. rc 0 one is there. One local file, no network.
AgentsHarnessWaitChatDismissal(){
	local peekKey="" peekFloor=""
	type AgentsToolsSessionChatFloor > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionChat.include" 2> /dev/null || return 1
	peekKey="$( AgentsToolsSessionChatKey )"
	[ -n "$peekKey" ] && [ -n "$harnessAgent" ] || return 1
	peekFloor="$( AgentsToolsSessionChatFloor "$peekKey" "$harnessAgent" 2> /dev/null )" || return 1
	[ -n "$peekFloor" ] || return 1
	printf '%s\n' "$peekFloor" | dismissalMember="$harnessAgent" dismissalRun="${MDAT_SPAWN_SESSION_ID:-}" LC_ALL=C awk -f "$harnessHere/questions/AgentsDismissalMatch.awk" -f "$harnessHere/harness/AgentsHarnessWaitDismissed.awk" > /dev/null 2>&1
}

## A Wait that delivered an arrival answers whatever handback was given before it: the mark is cleared here, so the next idle Wait
## is one again only after another handback. One local file, removed, and nothing read from the network.
AgentsHarnessWaitCheckListAnswered(){
	local answeredFolder=""
	AgentsHarnessCheckListPlace || return 0
	answeredFolder="$checkListFolder"
	[ ! -f "$answeredFolder/handback.given" ] || rm -f "$answeredFolder/handback.given" 2> /dev/null || :
	return 0
}

## The wait happens HERE, in this process, inside one tool call: the model spends
## nothing while nothing is happening and its context does not grow, which is the
## whole reason this is a tool and not a loop of reads. Through the team's own
## long-poll operation and no other path -- no Slack call of this harness's own and
## no credential in argv; which input sources exist is that operation's business,
## never this file's. Output to a file rather than a capture: the operation drives
## reads that fork curl, and a capture returns on pipe EOF rather than on the
## process it ran.
##
## A wait that comes back with nothing is NOT an error and is never dressed as one:
## the operation's own WAIT-RESULT line is passed through untouched, so the model
## reads TIMEOUT and ERROR as the different things they are.
## A call naming a mode (arguments 7 to 11: mode, seen, note, done, wait) is a stateful wait kept per
## session; an internal caller passing six arguments or fewer gets today's stateless wait. The mode
## `once` is the exception: it reads one named source in one round and keeps nothing (S22 item 8).
AgentsHarnessToolWait(){
	local toolSources="$1" toolTimeout="$2" toolPoll="$3" toolSince="$4" toolAddressee="$5" toolIncludeOwn="$6" waitRc=0 waitDiag="" waitSource waitStateful="false" waitSession waitName waitThread waitOwnSources="$1" waitIdleReturn=""
	local waitCounts waitBusy waitFloorOnly="" waitAll waitOpen waitActive
	local toolMode="${7:-}" toolSeen="${8:-}" toolNote="${9:-}" toolDone="${10:-}" toolWaitIds="${11:-}"
	## unwait names one source to drop from the stored wait on demand -- the same
	## kind:target (or slack:session-current/slack:session-parent alias) `sources`
	## takes, resolved the identical way, below, before this becomes a drop call
	## instead of a wait. Takes no timeout/poll/since/addressee/include-own: a
	## drop runs once and returns, like --wait-close already does.
	local toolUnwait="${13:-}" waitUnwaitMode="false"
	if [ -n "$toolUnwait" ] ; then
		waitUnwaitMode="true"
		toolSources="$toolUnwait"
	fi
	if [ $# -ge 7 ] ; then
		waitStateful="true"
		[ -n "$toolMode" ] || toolMode="default"
		case "$toolMode" in
			default|continue|close) ;;
			once)
				## The one-off read (S22 item 8): one named source, one round, and the registered sources left as
				## they were. The operation's own stateless call is the whole of it, so nothing is stored and no
				## mode reaches the operation.
				[ -z "$toolUnwait" ] || { printf 'ERROR: mode once reads a source and unwait drops one, so they are not named in one call. Nothing was read.\n' ; return 0 ; }
				case "$toolSources" in
					'') printf 'ERROR: mode once reads exactly one named source, and none was named. Nothing was read.\n' ; return 0 ;;
					*[[:space:]]*) printf 'ERROR: mode once reads exactly one named source, and several were named: %s. Nothing was read.\n' "$toolSources" ; return 0 ;;
				esac
				waitStateful="false"
				## One round, so a bound the caller names never turns the read into a wait.
				toolTimeout=0
			;;
			*) printf 'ERROR: mode must be default, continue, close or once, got: %s\n' "$toolMode" ; return 0 ;;
		esac
	fi
	## An asking call waits on this session's stored wait too (a twelfth argument, `ask`): the
	## same stateful round, given back as the operation printed it. What it means for the ask
	## and for whatever else arrived is that call's to say (AgentsHarnessAsk).
	local waitTool="$waitStateful" toolAsking="${12:-}"
	[ "$toolAsking" != "ask" ] || waitTool="false"
	if [ -z "$harnessAgent" ] ; then
		printf 'ERROR: this harness was started without --agent, so it has no team identity to wait as, and one is never guessed here. Nothing was waited on.%s\n' "${harnessAgentMissing:+ ($harnessAgentMissing)}" ; return 0
	fi
	if [ ! -x "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh" ] ; then
		printf 'ERROR: the team tooling is not present at the origin this workspace resolves, %s, and no other wait path exists here. Nothing was waited on.\n' "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh" ; return 0
	fi
	## A session that was dismissed does not wait again: every later Wait is that dismissal,
	## returned at once with the line that says what is left to do, so no wait keeps it alive.
	local waitDismissedEarlier=""
	if waitDismissedEarlier="$( AgentsHarnessDismissedBy )" ; then
		printf 'WAIT-RESULT: DISMISSED\nWAIT-DISMISSED-BY: %s\n# this session was dismissed before this call, so nothing was waited on\n' "$waitDismissedEarlier"
		[ "$waitTool" != "true" ] || AgentsHarnessDismissedNext
		return 0
	fi
	## THE SEAT (F6.9), on the tool's own wait of a spawned run: a dismissal held while others of
	## its session ran is given once they have ended; a wait that reads its session takes its seat
	## there, or finds the run that holds it (waitSeatHolder), which refuses it (AgentsHarnessSeatRefuse);
	## a run whose seat passed to the run that restarts it is dismissed by the tooling.
	local waitRecord="" waitSeatHolder="" waitHeldOthers=""
	[ "$waitTool" != "true" ] || waitRecord="$( AgentsHarnessSpawnRecordPath "${MDAT_SPAWN_SESSION_ID:-}" 2> /dev/null )" || waitRecord=""
	if [ -n "$waitRecord" ] ; then
		type AgentsToolsSessionSeatTake > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SpawnSandbox.include" 2> /dev/null || :
		if AgentsHarnessDismissHeldGive ; then
			AgentsHarnessDismissedNext
			return 0
		fi
		! AgentsHarnessWaitReadsSession "$toolSources" "$toolMode" || waitSeatHolder="$( AgentsHarnessSeatTake )" || :
		if [ -n "$waitSeatHolder" ] && AgentsHarnessSeatPassed "$waitSeatHolder" ; then
			printf 'WAIT-RESULT: DISMISSED\nWAIT-DISMISSED-BY: tooling (the seat of this run in its session passed to %s, the run that restarts it)\n' "$waitSeatHolder"
			AgentsHarnessDismissedKeep "tooling (the seat of this run in its session passed to $waitSeatHolder, the run that restarts it)"
			AgentsHarnessDismissedNext
			return 0
		fi
		if [ -n "$waitSeatHolder" ] ; then
			AgentsHarnessSeatRefuse read "$waitSeatHolder"
			return 0
		fi
	fi
	## The RETURN bound. A caller's own timeout is honoured, validated the way Bash validates
	## its own. With none, this harness waits until something arrives (empty is no bound),
	## and a served call returns by harnessServedWaitBound, safely under the client cutoff.
	## Either is cut down to a ceiling rather than refused: a bound that is too long is a
	## bound, and refusing it would turn a waitable question into an error.
	if [ -n "$toolTimeout" ] ; then
		if ! AgentsHarnessWholeNumber "$toolTimeout" ; then
			printf 'ERROR: timeout must be a whole number of seconds, got: %s\n' "$toolTimeout" ; return 0
		fi
	else
		toolTimeout="$harnessServedWaitBound"
	fi
	[ -z "$harnessServedWaitBound" ] || [ "$toolTimeout" -le "$harnessServedWaitBound" ] || toolTimeout="$harnessServedWaitBound"
	if [ -n "$harnessWaitTimeout" ] ; then
		[ -n "$toolTimeout" ] && [ "$toolTimeout" -le "$harnessWaitTimeout" ] || toolTimeout="$harnessWaitTimeout"
	fi
	## A session whose handback waits in review waits for its verdict at most REVIEW_WAIT_LIMIT
	## seconds (AgentsTools.ReviewFlow.include): bounded to what is left, and at the limit the
	## tooling ends it, recorded. The item stays in review. Only the tool's own stateful wait.
	## Nothing is loaded for a session with no spawn record, which has no item to review.
	if [ "$waitTool" = "true" ] && [ "${MDAT_SPAWN_CALLER_WAITS:-}" != "true" ] && [ -n "$( AgentsHarnessSessionKey )" ] \
		&& [ -n "$( ls "${MMDAPP:-/nonexistent}"/.local/agents/spawned/*/"$( AgentsHarnessSessionKey ).spawn.md" 2> /dev/null )" ] ; then
		local waitReviewLeft=""
		type AgentsReviewWaitLeft > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.ReviewFlow.include" 2> /dev/null || :
		waitReviewLeft="$( AgentsReviewWaitLeft "$( AgentsHarnessSessionKey )" 2> /dev/null )" || waitReviewLeft=""
		case "$waitReviewLeft" in
			'') ;;
			expired)
				## The limit dismisses no run while another participant of its session runs, or a run that needs it (F6.9): the wait goes on.
				if [ -n "$waitRecord" ] && AgentsToolsSessionLimitHeld "$waitRecord" > /dev/null ; then
					waitReviewLeft=""
				else
					waitDismissedEarlier="$( AgentsReviewWaitExpire "${harnessAgent:-unknown}" "$( AgentsHarnessSessionKey )" 2> /dev/null )" || :
					[ -z "$waitDismissedEarlier" ] || printf '%s\n' "$waitDismissedEarlier"
					waitDismissedEarlier="$( printf '%s\n' "$waitDismissedEarlier" | LC_ALL=C sed -n 's/^WAIT-DISMISSED-BY: //p' | head -1 )"
					[ -z "$waitDismissedEarlier" ] || AgentsHarnessDismissedKeep "$waitDismissedEarlier"
					printf 'NEXT: you are dismissed -- end your run\n'
					return 0
				fi
			;;
			*) [ -n "$toolTimeout" ] && [ "$toolTimeout" -le "$waitReviewLeft" ] || toolTimeout="$waitReviewLeft" ;;
		esac
	fi
	if [ -n "$toolPoll" ] && ! AgentsHarnessWholeNumber "$toolPoll" ; then
		printf 'ERROR: poll_interval must be a whole number of seconds, got: %s\n' "$toolPoll" ; return 0
	fi
	if [ -n "$toolSince" ] ; then
		if ! AgentsHarnessWholeNumber "${toolSince%%.*}" ; then
			printf 'ERROR: since_utime must be epoch seconds, or a Slack message ts written <epoch>.<micros>, got: %s\n' "$toolSince" ; return 0
		fi
		if [ "$toolSince" != "${toolSince#*.}" ] && ! AgentsHarnessWholeNumber "${toolSince#*.}" ; then
			printf 'ERROR: since_utime must be epoch seconds, or a Slack message ts written <epoch>.<micros>, got: %s\n' "$toolSince" ; return 0
		fi
	fi
	## No source named: default to this session's own coworking thread and every
	## conversation thread it continues (AgentsToolsWaitDefaultSources), any post but
	## the caller's own. An ad-hoc/solo spawn holding none keeps today's default exactly
	## -- magic-team and human-owner, resolved below by --wait-for-input itself
	## from an empty sources list.
	if [ -z "$toolSources" ] && [ "$toolMode" != "continue" ] && [ "$toolMode" != "close" ] ; then
		type AgentsToolsWaitDefaultSources > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SpawnSandbox.include" 2> /dev/null || :
		local waitDefaultThread=""
		waitDefaultThread="$( AgentsToolsWaitDefaultSources 2>/dev/null )" || waitDefaultThread=""
		[ -z "$waitDefaultThread" ] || toolSources="$waitDefaultThread"
		## A thread source needs a floor. A stateful call leaves it to the operation, which resumes
		## from the floor stored for that thread, so nothing that arrived between two calls is
		## skipped; only the stateless internal call means "from now on".
		[ -z "$waitDefaultThread" ] || [ -n "$toolSince" ] || [ "$waitStateful" = "true" ] || toolSince="$( date +%s )"
	fi
	## slack:session-current and slack:session-parent each name that session's thread as a :conversation source, the values SendMessage to takes.
	for waitName in "$harnessCurrentName" "$harnessParentName" ; do
		case " $toolSources " in
			*" slack:$waitName "*)
				waitThread="$( AgentsHarnessSessionThread "$waitName" "Nothing was waited on." )" || { printf '%s\n' "$waitThread" ; return 0 ; }
				toolSources=" $toolSources "
				## The replacement stays bare: bash 3.2 keeps a quote written inside it as part of the source.
				toolSources="${toolSources/" slack:$waitName "/ slack:${waitThread%% *}:conversation }"
				[ -n "$toolSince" ] || [ "$waitStateful" = "true" ] || toolSince="$( date +%s )"
			;;
		esac
	done
	## unwait's own target was resolved by the same alias loop above (slack:session-
	## current/-parent included), so it reaches --unwait exactly as a plain source
	## would. One call, its own result printed as it comes back, never the rest of
	## this function's wait/mode handling below.
	if [ "$waitUnwaitMode" = "true" ] ; then
		waitSession="$( AgentsHarnessSessionKey )"
		set -- "$BASH" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh" --wait-for-input --team-member "$harnessAgent" --unwait "$toolSources"
		[ -z "$waitSession" ] || set -- "$@" --wait-session-id "$waitSession"
		waitDiag="$( "$@" 2>&1 1>"$harnessScratch/wait.out" )" || waitRc=$?
		if [ "$waitRc" != "0" ] ; then
			printf 'ERROR: the unwait could not be performed (rc=%s). What the operation reported follows:\n' "$waitRc"
			[ -z "$waitDiag" ] || printf '%s\n' "$waitDiag"
			return 0
		fi
		[ -z "$waitDiag" ] || printf '%s\n' "$waitDiag" >&2
		cat "$harnessScratch/wait.out"
		return 0
	fi
	[ -n "$waitOwnSources" ] || waitFloorOnly=1
	## A DISMISSED for this run in its session's chat file comes before the CheckList (AgentsHarnessWaitChatDismissal): the wait reads it.
	if [ "$waitTool" = "true" ] && ! AgentsHarnessWaitChatDismissal ; then
		## An item past its due time comes first of all (S13.9): the floor, before the idle items and before any probe.
		waitIdleReturn="$( AgentsHarnessWaitCheckListDue "$waitTool" )"
		[ -z "$waitIdleReturn" ] || { printf '%s\n' "$waitIdleReturn" ; return 0 ; }
		## Then the idle Wait: a member that has handed back and still holds open items is given them, not made to
		## wait (AgentsHarnessWaitCheckListIdle). Nothing where its list holds none, or has not changed since the last such return.
		waitIdleReturn="$( AgentsHarnessWaitCheckListIdle "$waitOwnSources" "$toolMode" )"
		[ -z "$waitIdleReturn" ] || { printf '%s\n' "$waitIdleReturn" ; return 0 ; }
	fi
	## Built as argv, so a source naming a thread stays one token rather than a
	## quoted fragment, and an empty sources string adds no flag at all.
	set -- "$BASH" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh" --wait-for-input --team-member "$harnessAgent"
	for waitSource in $toolSources ; do
		set -- "$@" --wait-source "$waitSource"
	done
	if [ "$waitStateful" = "true" ] ; then
		waitSession="$( AgentsHarnessSessionKey )"
		set -- "$@" "--wait-$toolMode"
		[ -z "$waitSession" ] || set -- "$@" --wait-session-id "$waitSession"
		[ -z "$toolSeen" ] || set -- "$@" --wait-react-seen "$toolSeen"
		[ -z "$toolNote" ] || set -- "$@" --wait-react-note "$toolNote"
		[ -z "$toolDone" ] || set -- "$@" --wait-react-done "$toolDone"
		[ -z "$toolWaitIds" ] || set -- "$@" --wait-react-wait "$toolWaitIds"
	fi
	[ -z "$toolTimeout" ] || set -- "$@" --wait-timeout "$toolTimeout"
	[ -z "$toolPoll" ] || set -- "$@" --wait-poll-interval "$toolPoll"
	[ -z "$toolSince" ] || set -- "$@" --wait-since-utime "$toolSince"
	[ -z "$toolAddressee" ] || set -- "$@" --wait-addressee "$toolAddressee"
	case "$toolIncludeOwn" in
		true|1|yes) set -- "$@" --wait-include-own ;;
	esac
	## An asking call (the twelfth argument) reacts to the reply it takes itself: the wait leaves the seen reaction to it, for that one
	## source only (MDAT_WAIT_SEEN_OWN_SOURCE: the call's own answer, or the source it named). Every other source of the same wait is a
	## delivery like any, and the wait marks it, so a message for the member shows eyes as it arrives.
	local waitSeenOwnSource="${MDAT_WAIT_SEEN_OWN_SOURCE:-}"
	[ -z "$toolAsking" ] || waitSeenOwnSource="${waitSeenOwnSource:-$toolSources}"
	## Only the result goes to a file: the operation's own stderr is held here and printed
	## where it is read, so a wait leaves one file and not two.
	waitDiag="$( MDAT_WAIT_SEEN_OWN="${toolAsking:+1}${MDAT_WAIT_SEEN_OWN:-}" MDAT_WAIT_SEEN_OWN_SOURCE="$waitSeenOwnSource" "$@" 2>&1 1>"$harnessScratch/wait.out" )" || waitRc=$?
	if [ "$waitRc" != "0" ] ; then
		printf 'ERROR: the wait could not be performed (rc=%s), so NOTHING is known about those sources -- this is not a wait that found nothing, and their silence must not be read as quiet. What the operation reported follows:\n' "$waitRc"
		## The operation names its own flags; the caller holds this tool's arguments, so the report names those.
		[ -z "$waitDiag" ] || printf '%s\n' "$waitDiag" | LC_ALL=C sed -e 's/--wait-since-utime/since_utime/g' -e 's/--wait-source/sources/g' -e 's/--wait-timeout/timeout/g' -e 's/--wait-addressee/addressee/g'
		return 0
	fi
	## What a wait that worked said on its stderr goes to this run's own log, never left in scratch.
	[ -z "$waitDiag" ] || printf '%s\n' "$waitDiag" >&2
	## A dismissal is a Wait outcome of its own: a message whose body is DISMISSED,
	## addressed to this member, and to this run where it names one (S6.40): another run's
	## DISMISSED reaches that run alone (AgentsHarnessWaitDismissed.awk). The spawner sends it when
	## it is satisfied; the waiting session ends with its handback on it. Everything the
	## wait returned still follows, so nothing it saw is hidden behind the outcome.
	local waitDismissedBy=""
	if [ "$( head -1 "$harnessScratch/wait.out" )" = "WAIT-RESULT: RECEIVED" ] \
		&& waitDismissedBy="$( dismissalMember="$harnessAgent" dismissalRun="${MDAT_SPAWN_SESSION_ID:-}" LC_ALL=C awk -f "$harnessHere/questions/AgentsDismissalMatch.awk" -f "$harnessHere/harness/AgentsHarnessWaitDismissed.awk" "$harnessScratch/wait.out" )" ; then
		## An executor is not dismissed while another participant of its session runs (F6.9): its
		## dismissal is kept, given at its first wait once they have ended, and this wait is what it got.
		if [ -n "$waitRecord" ] && waitHeldOthers="$( AgentsHarnessDismissWaits )" ; then
			AgentsToolsSessionDismissHold "$MDAT_SPAWN_SESSION_ID" "$waitDismissedBy"
		else
			printf 'WAIT-RESULT: DISMISSED\nWAIT-DISMISSED-BY: %s\n' "$waitDismissedBy"
			tail -n +2 "$harnessScratch/wait.out"
			AgentsHarnessDismissedKeep "$waitDismissedBy"
			[ "$waitTool" != "true" ] || printf 'NEXT: you are dismissed -- give your handback if you have not, then end your run\n'
			return 0
		fi
	fi
	## A TIMEOUT on the tool's own stateful wait is ONE line: every quiet result stays in the
	## model's context, and that it is normal is said once, in the tool description. Only a
	## source never read adds its WAIT-NEVER-READ line, since its silence means nothing, and
	## the CheckList's own line follows, which is what the member's list costs a quiet round.
	if [ "$waitTool" = "true" ] && [ "$( head -1 "$harnessScratch/wait.out" )" = "WAIT-RESULT: TIMEOUT" ] ; then
		waitCounts="$( AgentsHarnessCheckListCounts )" || waitCounts=""
		waitOpen="" waitActive=""
		[ -z "$waitCounts" ] || read -r waitAll waitOpen waitActive <<< "$waitCounts"
		case "${waitOpen:-0}${waitActive:-0}" in 00) waitBusy="" ;; *) waitBusy=yes ;; esac
		if [ -n "$waitBusy" ] ; then
			printf 'WAIT-RESULT: TIMEOUT (%ss) NEXT: finish your CheckList, then run --idle-wait, if you are waiting for new work or a dismissal\n' "$( LC_ALL=C sed -n 's/^# waited: \([0-9]*\)s of .*/\1/p' "$harnessScratch/wait.out" | head -1 )"
		else
			printf 'WAIT-RESULT: TIMEOUT (%ss) NEXT: run --idle-wait, if you are waiting for new work or a dismissal\n' "$( LC_ALL=C sed -n 's/^# waited: \([0-9]*\)s of .*/\1/p' "$harnessScratch/wait.out" | head -1 )"
		fi
		LC_ALL=C grep '^WAIT-NEVER-READ: ' "$harnessScratch/wait.out" || :
		## A SOURCE DENIED, AND ONE WHOSE PROBE COULD NOT RUN, ARE CARRIED THROUGH TOO (S6.47): neither is counted as
		## never-read, so on a wait whose every source was denied or failed, this line was the whole result and it read
		## exactly like a wait that read everything and found it quiet.
		LC_ALL=C grep -E '^WAIT-SOURCE-ERROR: |^# probes that could not run this wait' "$harnessScratch/wait.out" || :
		AgentsHarnessWaitCheckListLine
		AgentsHarnessWaitBackgroundLine
		return 0
	fi
	cat "$harnessScratch/wait.out"
	[ -z "$waitHeldOthers" ] || printf '# DISMISSED held: runs that need this run still run (%s): the dismissal is given at its first Wait once they have ended\n' "$waitHeldOthers"
	## One extra last line naming the next call, on the tool's own stateful wait only: an internal
	## stateless caller (a tool that asks) embeds this output and has no stored wait to continue.
	[ "$waitTool" = "true" ] || return 0
	## An asked question's wait item that arrived is taken into its record here, as the asking call would.
	[ "$( head -1 "$harnessScratch/wait.out" )" != "WAIT-RESULT: RECEIVED" ] || AgentsHarnessWaitAskResolve "$harnessScratch/wait.out"
	case "$( head -1 "$harnessScratch/wait.out" )" in
		"WAIT-RESULT: RECEIVED")
			## An arrival is the moment a member is about to act on something new: the list's own line comes with it, and the
			## handback mark is cleared, since the arrival answers the handback that was given before it.
			AgentsHarnessWaitCheckListAnswered
			AgentsHarnessWaitCheckListLine
			AgentsHarnessWaitBackgroundLine
			## A message interrupts the wait, and the member decides: go on waiting, or drop the task (S5 item 4).
			printf 'NEXT: this message interrupts your wait. Read it, then either call Wait mode=continue -- it resumes after what is shown here -- or cancel the task with TaskStop if it no longer applies\n'
			[ -n "$waitFloorOnly" ] || return 0
			printf 'NEXT: when this batch is done, run --idle-wait: it means all done, and waits for any message addressed to your run\n'
		;;
	esac
}
