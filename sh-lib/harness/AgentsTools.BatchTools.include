#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.BatchTools.include -- BatchTools (F7.8 of the refactorings epic): one tool call that calls several
## tools and returns their results in call order. Sourced, never run; functions only.
##
## Two servers serve it, each handing in its own way to make one call, by the name of a function that takes the
## tool, the file holding its arguments and the call's number, prints the call's result and returns non-zero where
## the result marks an error: the harness (AgentsUniversalHarness.sh) makes each a served call of its own, and the
## MCP server (AgentsTools.InternMcpRequest.include) a request of its own. So a call is any tool that server serves,
## and runs exactly as it would on its own, through the same code of that server. A batch adds nothing to a call.
##
## A call is a process of its own, the leader of a group of its own, and keeps its own timeout: the batch has none.
## Its entry is its reply as the one reply layer finishes it in a batch (MDAT_REPLY_IN_BATCH,
## AgentsTools.SessionTranscript.include): kept in a file over the F2.4 threshold, with no date of its own, since
## the batch's reply carries the one date.
##

agentsBatchModes="sequence-stop-on-error sequence-all-through parallel-concurrent parallel-all-any-match parallel-all-through"

## One argument of the batch: decoded, or as its own source bytes with raw; empty where it is absent.
AgentsToolsBatchArg(){ ## raw arguments, dot path, raw (optional)
	printf '%s\n' "$1" | LC_ALL=C awk -v path="$2" -v optional=1 ${3:+-v mode=raw} -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsHarnessJsonField.awk" 2> /dev/null
}

## Starts one call, in a group of its own; its result in <n>.out, its status in <n>.rc once it has ended.
AgentsToolsBatchStart(){ ## runner, folder, call number
	local startMonitor="$-" startTool=""
	IFS= read -r startTool < "$2/$3.tool" || :
	set -m
	( "$1" "$startTool" "$2/$3.args" "$3" > "$2/$3.out" 2> /dev/null < /dev/null ; printf '%s\n' "$?" > "$2/$3.rc.part" && mv -f "$2/$3.rc.part" "$2/$3.rc" ) &
	printf '%s\n' "$!" > "$2/$3.pid"
	case "$startMonitor" in *m*) ;; *) set +m ;; esac
}

## A call that has ended: ok, or error where its status is non-zero, a line of its result starts with ERROR, or it
## starts with NOT-HELD.
AgentsToolsBatchStatus(){ ## folder, call number
	local statusRc=1
	IFS= read -r statusRc < "$1/$2.rc" 2> /dev/null || statusRc=1
	[ "$statusRc" = 0 ] || { printf error ; return 0 ; }
	LC_ALL=C awk 'NR == 1 && /^NOT-HELD:/ { bad = 1 } /^ERROR[: ]/ { bad = 1 } END { printf "%s", ( bad ? "error" : "ok" ) }' "$1/$2.out" 2> /dev/null
}

## Ends a call still running, as TaskStop ends a job: TERM at once to it and to every process it started, as the
## process list stands at this moment, each kept with when it began; KILL two seconds later only to those that are
## still the processes they were, by the one reading a process is kept by (AgentsToolsRegistryProcessesBegan). Its
## leader is this shell's own child, not yet waited for, so that number is still that process.
AgentsToolsBatchCancel(){ ## folder, call number
	local cancelPid="" cancelLeft=20 cancelTree cancelKept cancelStill
	IFS= read -r cancelPid < "$1/$2.pid" 2> /dev/null || return 0
	[ ! -f "$1/$2.rc" ] || return 0
	: > "$1/$2.cancelled"
	type AgentsToolsRegistryProcessesBegan > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.Registries.include" 2> /dev/null
	cancelTree="$( ps -A -o pid=,ppid= 2> /dev/null | LC_ALL=C awk -v root="$cancelPid" '
		{ under[$2] = under[$2] " " $1 }
		END { queue = root ; while ( queue != "" ) { count = split( queue, now, " " ) ; queue = "" ; for ( at = 1 ; at <= count ; at++ ) { print now[at] ; queue = queue under[now[at]] } } }' )"
	cancelKept="$( printf '%s\n' $cancelTree | AgentsToolsRegistryProcessesBegan 2> /dev/null )"
	kill -TERM $cancelTree 2> /dev/null
	while [ "$cancelLeft" -gt 0 ] && [ ! -f "$1/$2.rc" ] ; do sleep 0.1 ; cancelLeft=$(( cancelLeft - 1 )) ; done
	[ -n "$cancelKept" ] || return 0
	cancelStill="$( { printf '%s\n' "$cancelKept" ; printf '%s\n' "$cancelKept" | LC_ALL=C awk '{ print $1 }' | AgentsToolsRegistryProcessesBegan 2> /dev/null ; } | LC_ALL=C sort | LC_ALL=C uniq -d | LC_ALL=C awk '{ print $1 }' )"
	[ -z "$cancelStill" ] || kill -KILL $cancelStill 2> /dev/null
	return 0
}

## The batch: refused, with nothing run, for a mode none of the five, a call with no tool, or a tool the server
## does not serve (the served test, by name, as the second function given: rc 0 serves it); else every call by its
## mode, and the result as text or, with format json, as one JSON object.
AgentsToolsBatchRun(){ ## runner, served test, raw arguments
	local batchRunner="$1" batchServes="$2" batchArgs="$3" batchMode batchWorkers batchFormat batchCount batchAt batchTool
	local batchDir batchRunning batchStarted batchNext batchStatus batchOk=0 batchFound="" batchLine
	batchMode="$( AgentsToolsBatchArg "$batchArgs" mode )"
	case " $agentsBatchModes " in
		*" ${batchMode:-none} "*) ;;
		*) printf 'ERROR: BatchTools: mode %s is none of: %s -- nothing was run.\n' "${batchMode:-<none>}" "${agentsBatchModes// /, }" ; return 0 ;;
	esac
	batchWorkers="$( AgentsToolsBatchArg "$batchArgs" workers )"
	case "$batchWorkers" in
		'') batchWorkers=4 ;;
		*[!0123456789]*|0) printf 'ERROR: BatchTools: workers takes a whole number above nought, got: %s -- nothing was run.\n' "$batchWorkers" ; return 0 ;;
	esac
	batchFormat="$( AgentsToolsBatchArg "$batchArgs" format )"
	case "$batchFormat" in
		''|text|json) ;;
		*) printf 'ERROR: BatchTools: format takes text or json, got: %s -- nothing was run.\n' "$batchFormat" ; return 0 ;;
	esac
	batchCount="$( AgentsToolsBatchArg "$batchArgs" calls.__count )"
	case "$batchCount" in
		''|*[!0123456789]*|0) printf 'ERROR: BatchTools: calls takes a list of one call or more, each {"tool": <name>, "arguments": {...}} -- nothing was run.\n' ; return 0 ;;
	esac
	## Every call is checked before any runs.
	batchAt=0
	while [ "$batchAt" -lt "$batchCount" ] ; do
		batchTool="$( AgentsToolsBatchArg "$batchArgs" "calls.$batchAt.tool" )"
		if [ -z "$batchTool" ] || ! "$batchServes" "$batchTool" ; then
			printf 'ERROR: BatchTools: call %s names %s, which is no tool this server serves -- nothing was run.\n' "$(( batchAt + 1 ))" "${batchTool:-no tool}" ; return 0
		fi
		batchAt=$(( batchAt + 1 ))
	done
	mkdir -p "$MMDAPP/.local/agents/scratch" 2> /dev/null && batchDir="$( mktemp -d "$MMDAPP/.local/agents/scratch/AgentsBatchTools.XXXXXX" )" || {
		printf 'ERROR: BatchTools: no folder in the workspace scratch to run the calls in -- nothing was run.\n' ; return 0
	}
	batchAt=1
	while [ "$batchAt" -le "$batchCount" ] ; do
		AgentsToolsBatchArg "$batchArgs" "calls.$(( batchAt - 1 )).tool" > "$batchDir/$batchAt.tool"
		AgentsToolsBatchArg "$batchArgs" "calls.$(( batchAt - 1 )).arguments" raw > "$batchDir/$batchAt.args"
		[ -s "$batchDir/$batchAt.args" ] || printf '{}\n' > "$batchDir/$batchAt.args"
		batchAt=$(( batchAt + 1 ))
	done
	export MDAT_REPLY_IN_BATCH=1
	case "$batchMode" in
		sequence-*)
			batchAt=1
			while [ "$batchAt" -le "$batchCount" ] ; do
				AgentsToolsBatchStart "$batchRunner" "$batchDir" "$batchAt"
				wait "$( cat "$batchDir/$batchAt.pid" )" 2> /dev/null
				[ "$batchMode" = sequence-all-through ] || [ "$( AgentsToolsBatchStatus "$batchDir" "$batchAt" )" = ok ] || break
				batchAt=$(( batchAt + 1 ))
			done
		;;
		*)
			## A pool: parallel-concurrent keeps at most `workers` calls running, the other two start every call at once.
			[ "$batchMode" = parallel-concurrent ] || batchWorkers="$batchCount"
			batchNext=1 batchStarted=""
			while : ; do
				batchRunning=0
				for batchAt in $batchStarted ; do [ -f "$batchDir/$batchAt.rc" ] || batchRunning=$(( batchRunning + 1 )) ; done
				if [ "$batchMode" = parallel-all-any-match ] ; then
					for batchAt in $batchStarted ; do
						[ -f "$batchDir/$batchAt.rc" ] && [ "$( AgentsToolsBatchStatus "$batchDir" "$batchAt" )" = ok ] && { batchFound="$batchAt" ; break ; }
					done
					[ -z "$batchFound" ] || break
				fi
				while [ "$batchNext" -le "$batchCount" ] && [ "$batchRunning" -lt "$batchWorkers" ] ; do
					AgentsToolsBatchStart "$batchRunner" "$batchDir" "$batchNext"
					batchStarted="$batchStarted $batchNext" ; batchNext=$(( batchNext + 1 )) ; batchRunning=$(( batchRunning + 1 ))
				done
				[ "$batchRunning" -gt 0 ] || break
				sleep 0.1
			done
			[ -z "$batchFound" ] || for batchAt in $batchStarted ; do AgentsToolsBatchCancel "$batchDir" "$batchAt" ; done
		;;
	esac
	wait 2> /dev/null
	unset MDAT_REPLY_IN_BATCH
	## The entries, in call order, whatever order the calls ended in.
	[ "$batchFormat" != json ] || printf '{"mode":"%s","entries":[' "$batchMode"
	batchAt=1
	while [ "$batchAt" -le "$batchCount" ] ; do
		IFS= read -r batchTool < "$batchDir/$batchAt.tool" || :
		if [ -e "$batchDir/$batchAt.cancelled" ] ; then batchStatus=cancelled
		elif [ ! -f "$batchDir/$batchAt.rc" ] ; then batchStatus=skipped
		else batchStatus="$( AgentsToolsBatchStatus "$batchDir" "$batchAt" )"
		fi
		[ "$batchStatus" != ok ] || batchOk=$(( batchOk + 1 ))
		if [ "$batchFormat" = json ] ; then
			[ "$batchAt" -eq 1 ] || printf ','
			batchLine=""
			[ "$batchStatus" != ok ] && [ "$batchStatus" != error ] || batchLine="$( cat "$batchDir/$batchAt.out" )"
			printf '{"tool":"%s","status":"%s","result":"%s"}' "$( printf '%s' "$batchTool" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/mcp/AgentsMcpJsonEscape.awk" )" "$batchStatus" \
				"$( printf '%s' "$batchLine" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/mcp/AgentsMcpJsonEscape.awk" )"
		else
			printf 'BATCH-ENTRY: %s %s %s\n' "$batchAt" "$batchTool" "$batchStatus"
			case "$batchStatus" in ok|error) batchLine="$( cat "$batchDir/$batchAt.out" )" ; [ -z "$batchLine" ] || printf '%s\n' "$batchLine" ;; esac
		fi
		batchAt=$(( batchAt + 1 ))
	done
	if [ "$batchFormat" = json ] ; then
		printf ']}\n'
	else
		printf 'BATCH-RESULT: %s %s/%s\n' "$batchMode" "$batchOk" "$batchCount"
	fi
	rm -rf -- "$batchDir"
	return 0
}
