## Whether the call is a new name of this tool file: the name is the first word, or the one after `--mdat-output-format json`. Says nothing.
AgentsToolsFrontKnows(){ ## entry function name, arguments...
	local knowsOp="${2:-}"
	[ "${2:-}" != --mdat-output-format ] || [ "${3:-}" != json ] || knowsOp="${4:-}"
	[ -n "$knowsOp" ] || return 1
	printf '%s\n' "$agentsFrontTable" | LC_ALL=C awk -F'\t' -v key="$1" -v op="$knowsOp" '$1 == key && $2 == op { found = 1 ; exit } END { exit ( found ? 0 : 1 ) }'
}

## The new names of a tool file, one a line.
AgentsToolsFrontOps(){ ## entry function name
	printf '%s\n' "$agentsFrontTable" | LC_ALL=C awk -F'\t' -v key="$1" '$1 == key { print $2 }'
}

## What a bare call of a tool file prints: what it is, and its operations.
AgentsToolsFrontHelp(){ ## entry function name, what the tool is
	printf '%s: %s\noperations:\n' "$1" "$2"
	AgentsToolsFrontOps "$1" | LC_ALL=C sed 's/^/  /'
}

## The call again, as DistroAgentsTools.fn.sh, under the old name. Where a new name stands for two (a member's and the coordinator's), the call says which: the
## coordinator's when it names another session (--session-id of an --append-transcript), a member (--member of --list-permissions) or an origin (a first
## argument before --resolved or --needs-ruling of --send-contact-digest); the member's otherwise.
AgentsToolsFrontForward(){ ## entry function name, arguments...
	local frontKey="$1" frontJson=() frontNew frontOlds frontOld frontArgs=() frontHead=() frontSession="" frontMember="" frontArg
	shift
	if [ "${1:-}" = --mdat-output-format ] && [ "${2:-}" = json ] ; then frontJson=( "$1" "$2" ) ; shift 2 ; fi
	frontNew="${1:-}"
	shift
	frontOlds="$( printf '%s\n' "$agentsFrontTable" | LC_ALL=C awk -F'\t' -v key="$frontKey" -v op="$frontNew" '$1 == key && $2 == op { print $3 ; exit }' )"
	frontOld="${frontOlds%%,*}"
	frontArgs=( "$@" )
	case "$frontOlds" in
		*,*)
			type AgentsToolsTeamMember > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/common/AgentsTools.CommonOptions.include"
			## The common options at the head, set aside.
			while [ $# -ge 2 ] ; do
				case "$agentsCommonOptions" in *" $1 "*) ;; *) break ;; esac
				case "$1" in
					--session-id) frontSession="$2" ;;
					--team-member) frontMember="$2" ; frontHead[${#frontHead[@]}]="$1" ; frontHead[${#frontHead[@]}]="$2" ;;
					*) frontHead[${#frontHead[@]}]="$1" ; frontHead[${#frontHead[@]}]="$2" ;;
				esac
				shift 2
			done
			case "$frontNew" in
				--append-transcript)
					if [ -n "$frontSession" ] && [ "$frontSession" != "${MDAT_SESSION_ID:-}" ] ; then
						frontOld="${frontOlds#*,}"
						[ -n "$frontMember" ] || { frontMember="$( AgentsToolsTeamMember )" ; frontHead[${#frontHead[@]}]=--team-member ; frontHead[${#frontHead[@]}]="$frontMember" ; }
						frontArgs=( ${frontHead[@]+"${frontHead[@]}"} "$frontSession" "$@" )
					else
						frontArgs=( ${frontHead[@]+"${frontHead[@]}"} "$@" )
					fi
				;;
				--list-permissions)
					for frontArg in ${frontArgs[@]+"${frontArgs[@]}"} ; do
						if [ "$frontArg" = --member ] ; then frontOld="${frontOlds#*,}" ; break ; fi
					done
				;;
				--send-contact-digest)
					case "${1:-}" in --resolved|--needs-ruling|'') ;; *) frontOld="${frontOlds#*,}" ;; esac
				;;
			esac
		;;
	esac
	type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
	DistroAgentsTools ${frontJson[@]+"${frontJson[@]}"} "$frontOld" ${frontArgs[@]+"${frontArgs[@]}"}
}
