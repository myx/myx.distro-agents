#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.CliService.include -- what the tooling knows of a CLI service a session runs
## on, where the fact is the service's own whatever the workspace. Sourced, never run.
## Functions only.
##
## THE WAIT ROUND. A wait of a session that brings nothing comes back a little sooner than
## the prompt cache of its CLI service expires, so the turn that goes on waiting reads the
## session's whole history from that cache. Coming back later, it pays for that history
## again, uncached, at every wake. The length of that round is one number a service, in
## seconds, kept here and nowhere in the wait code.
## SAFE IS SHORT: a service whose cache lifetime is not known for sure takes the round of a
## five-minute cache, so a wake is never later than the cache lives.
## One setting overrides it for a whole workspace, whatever the service: WAIT_ROUND_SECONDS
## (AgentsTools.OwnerSetupOptionSpec.include).
## Not built: a round per model or per preset. It would be one more argument of
## AgentsToolsCliServiceWaitRound, looked up ahead of the service's own number.
##

## The round of each service whose cache lifetime is known, `<service>:<seconds>`.
##   claude-native   by the recorded rounds of its sessions in this estate (the audit
##                   transcripts of 2026-10-10 to 12): after 5.5 to 50 minutes idle every
##                   round read its history from the cache, 41 of 41, and the first that
##                   did not came after 54 minutes. So three quarters of an hour.
##   deepseek        its context cache is kept on disk and cleared only after hours to days
##                   unused (the service's own documentation), so the same three quarters of an
##                   hour: a round of 270 s re-sent the whole context every 4.5 minutes idle.
agentsCliServiceWaitRounds="claude-native:2700 deepseek:2700"
## The safe round, of every other service: four and a half minutes, under a five-minute cache.
agentsCliServiceWaitRoundSafe=270

## THE CLI THAT WORKS (F13.4). Of the vendor CLIs this machine may carry, claude-native and copilot-native, in that order, the first that is installed and
## works is the one the setup selects (--owner-setup-cli-auto). It is asked here, of the CLI itself, when a person or the console asks the setup: a
## spawn never asks, it resolves the CLI service of the preset its tier names and scans no PATH (AgentsReviewCliResolved), so this is called from the setup alone.
##   claude-native    `claude` is in PATH and `claude auth status --json` says someone is signed in: the test the setup's own check makes
##                    of it (SPAWN_CLI_AUTHENTICATED).
##   copilot-native   `copilot` is in PATH and `copilot --version` ends well: copilot carries no sign-in to ask of, so this is all there is to ask.
agentsCliServiceAutoOrder="claude-native copilot-native"

## Whether one of those works here: rc 0 and one line saying why, or rc 1 and one line saying what is wrong. Nothing else is printed.
AgentsToolsCliServiceWorks(){ ## cli service
	local worksAnswer=""
	case "$1" in
		claude-native)
			command -v claude > /dev/null 2>&1 || { printf 'the claude binary is not in PATH' ; return 1 ; }
			worksAnswer="$( claude auth status --json < /dev/null 2> /dev/null || : )"
			case "$worksAnswer" in
				*'"loggedIn": true'*) printf 'claude is installed and signed in' ; return 0 ;;
				*'"loggedIn": false'*) printf 'claude is installed and nobody is signed in' ; return 1 ;;
			esac
			printf 'claude did not say whether anybody is signed in' ; return 1
		;;
		copilot-native)
			command -v copilot > /dev/null 2>&1 || { printf 'the copilot binary is not in PATH' ; return 1 ; }
			copilot --version < /dev/null > /dev/null 2>&1 || { printf 'copilot --version did not end well' ; return 1 ; }
			printf 'copilot is installed and answers --version' ; return 0
		;;
	esac
	printf '%s is not a CLI that this chooses between' "$1" ; return 1
}

## The CLI service a session runs on: the name its launcher wrote into the session's own
## store (the launch marker, MDAT_SPAWN_LAUNCH_MARKER). A session the tooling did not launch
## has none: the vendor claude CLI names its own session in its environment
## (CLAUDE_CODE_SESSION_ID), which is that same service, and of any other root session the
## service is not known, so nothing is printed.
AgentsToolsCliServiceOfSession(){ ## session id
	local serviceLine=""
	case "$1" in ''|*/*|.|..) return 0 ;; esac
	if [ ! -s "$MMDAPP/.local/agents/sessions/$1/launch" ] ; then
		[ "${CLAUDE_CODE_SESSION_ID:-}" != "$1" ] || printf 'claude-native'
		return 0
	fi
	IFS= read -r serviceLine < "$MMDAPP/.local/agents/sessions/$1/launch" || :
	case "$serviceLine" in *[!abcdefghijklmnopqrstuvwxyz0123456789-]*) return 0 ;; esac
	printf '%s' "$serviceLine"
}

## The wait round of a service, in whole seconds: the workspace's own setting where it is a
## whole number of one second or more, else the service's, else the safe one.
AgentsToolsCliServiceWaitRound(){ ## cli service (empty: not known)
	local roundSet="" roundOne
	roundSet="$( "$BASH" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh" --agents-config-option magic-team --select WAIT_ROUND_SECONDS 2> /dev/null )" || roundSet=""
	case "$roundSet" in
		''|0|*[!0123456789]*) ;;
		*) printf '%s' "$roundSet" ; return 0 ;;
	esac
	for roundOne in $agentsCliServiceWaitRounds ; do
		[ -n "$1" ] && [ "${roundOne%%:*}" = "$1" ] || continue
		printf '%s' "${roundOne#*:}"
		return 0
	done
	printf '%s' "$agentsCliServiceWaitRoundSafe"
}
