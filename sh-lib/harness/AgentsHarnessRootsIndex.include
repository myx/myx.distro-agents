#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

## AgentsHarnessRootsIndex.include -- the harness's own index of the access roots
## AgentsTools.ClientAccessRoots.include yields, already resolved. Written by the
## installer's --make-harness-indices (install and every upgrade), read by
## AgentsUniversalHarness.sh at every start -- a served --intern-tool call included --
## which otherwise sources the producer, reads the config store and resolves every root
## with its own `cd ... && pwd -P` subshell.
##
## WHAT IT HOLDS is the member- and origin-independent set: the read set and the write
## set the harness asks for with no member named and no MDLT_ORIGIN, each root beside
## what it resolved to at install. ONE index, whichever origin the harness runs from (the
## source tree or the installed .local): the one root the producer derives from
## MDLT_ORIGIN, its skillset, is merged in at run time with a member's own two scratch
## roots, exactly as the producer's `sort -u` places them, and resolved at run time.
## Everything else the harness adds at run time (a spawn's sandbox, child sessions,
## --access-*-root flags) is computed at run time as before.
##
## WHEN IT IS USED: only while its fingerprint is what this run would produce -- the
## workspace, HOME and MDAT_SKILLSET_ROOT and the names under it (the member index's view,
## not newer than the index), and one cksum line each for the producer, this
## file, AgentsTools.TeamRegistry.include, the member index, the shared grant pointers and
## every grant file they name, the two place registries (this workspace's and the shared
## pointers) and the grants index -- our own data only, never a vendor link folder. A harness whose origin
## carries other code than the writer's has another checksum, so it computes. A stored
## resolution is used only while its root is still a directory; any other root is
## resolved at run time. Anything else is computed the slow way, with the same result.
## An index of another format version (an older or newer writer's) is never used.
##
## Format, version 4, free text encoded for `printf '%b'` (backslash doubled, newline as
## \n, TAB as \t):
##   myx.distro harness.roots.index 4
##   print <TAB> <fingerprint>
##   read <TAB> <root> <TAB> <resolved, or empty where it did not resolve>
##   wref <TAB> <root> <TAB> <resolved...>       the write reference roots
##   grant <TAB> <root> <TAB> <resolved...>      the declared grants
##   end

agentsRootsIndexHere="${harnessHere:-$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib}"
type AgentsToolsTeamGrantWorkspaces >/dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.TeamRegistry.include"
agentsRootsIndexHeader="myx.distro harness.roots.index 4"

agentsRootsEnc=""
agentsRootsDec=""
AgentsHarnessRootsEnc(){ ## text
	agentsRootsEnc="${1//\\/\\\\}"
	agentsRootsEnc="${agentsRootsEnc//$'\n'/\\n}"
	agentsRootsEnc="${agentsRootsEnc//$'\t'/\\t}"
}
AgentsHarnessRootsDec(){ ## encoded -- never `printf -v` an empty result: bash 3.2 keeps the last buffer
	agentsRootsDec=""
	[ -z "$1" ] || case "$1" in
		## Text with no backslash is its own decoding, so only an escaped one pays for the conversion.
		*\\*) printf -v agentsRootsDec '%b' "$1" ;;
		*) agentsRootsDec="$1" ;;
	esac
}

## Everything the producer's answer depends on, as one string: names and settings by
## builtins, file contents by one cksum for them all. Non-zero when a file is there but
## cannot be summed -- the caller then computes.
agentsRootsPrint=""
AgentsHarnessRootsFingerprint(){ ## workspace
	local printWorkspace="$1" printEntry printFiles=() printSums printLine printRest printCount=0
	agentsRootsPrint="v4"$'\n'"MMDAPP=$printWorkspace"$'\n'"HOME=${HOME:-}"$'\n'"MDAT_SKILLSET_ROOT=${MDAT_SKILLSET_ROOT:-}"$'\n'
	## The names in the member set root -- the member index's own members/ view.
	if [ -n "${MDAT_SKILLSET_ROOT:-}" ] && [ -d "$MDAT_SKILLSET_ROOT" ] ; then
		for printEntry in "$MDAT_SKILLSET_ROOT"/*/ ; do agentsRootsPrint="${agentsRootsPrint}skillset:$printEntry"$'\n' ; done
	fi
	## Our own data only (AgentsTools.TeamRegistry.include): the member index the members/
	## view is generated from, the shared grant pointers, and each grant file they name --
	## never a vendor link folder. Named by role, not path: the producer and this file are
	## the same code in either origin.
	## Each short list is taken a line at a time by parameter expansion: no here-string, so no file on a call.
	local printGrantRoot printGrantList printGrants=()
	printGrantList="$( AgentsToolsTeamGrantWorkspaces "$printWorkspace" )"
	while [ -n "$printGrantList" ] ; do
		printGrantRoot="${printGrantList%%$'\n'*}"
		case "$printGrantList" in *$'\n'*) printGrantList="${printGrantList#*$'\n'}" ;; *) printGrantList="" ;; esac
		[ -n "$printGrantRoot" ] || continue
		printGrants+=( "grants:$printGrantRoot/.local/agents/permissions.registry" )
	done
	for printEntry in \
		"producer:$agentsRootsIndexHere/client/AgentsTools.ClientAccessRoots.include" \
		"index:$agentsRootsIndexHere/harness/AgentsHarnessRootsIndex.include" \
		"team:$agentsRootsIndexHere/team-data/AgentsTools.TeamRegistry.include" \
		"members:$printWorkspace/.local/agents/members.index" \
		"pointers:${HOME:-}/.agents/magic-team/permissions.registry" \
		"places:$printWorkspace/.local/agents/directories.registry" \
		"places-shared:${HOME:-}/.agents/magic-team/directories.registry" \
		"grants-index:$printWorkspace/.local/agents/grants.index" \
		${printGrants[@]+"${printGrants[@]}"} \
	; do
		if [ -f "${printEntry#*:}" ] ; then
			printFiles+=( "${printEntry#*:}" )
			agentsRootsPrint="${agentsRootsPrint}file:${printEntry%%:*}"$'\n'
		else
			agentsRootsPrint="${agentsRootsPrint}file:${printEntry%%:*}:<absent>"$'\n'
		fi
	done
	[ "${#printFiles[@]}" -gt 0 ] || return 0
	printSums="$( LC_ALL=C cksum ${printFiles[@]+"${printFiles[@]}"} 2>/dev/null )" || return 1
	while [ -n "$printSums" ] ; do
		printLine="${printSums%%$'\n'*}"
		case "$printSums" in *$'\n'*) printSums="${printSums#*$'\n'}" ;; *) printSums="" ;; esac
		printRest="${printLine#* }"
		agentsRootsPrint="${agentsRootsPrint}sum:${printLine%% *} ${printRest%% *}"$'\n'
		printCount=$(( printCount + 1 ))
	done
	[ "$printCount" = "${#printFiles[@]}" ] || return 1
}

## The whole index, on stdout, from the producer sourced here, DistroAgentsTools
## callable. Non-zero, printing nothing, when the producer fails (the harness then meets
## that failure itself, and says so) or anything it depends on changed while this ran.
## The producer runs with MDLT_ORIGIN empty -- DistroAgentsTools keeps the real one -- so
## the set is the one every origin shares; the file is the caller's to write atomically.
AgentsHarnessRootsIndexText(){ ## workspace
	type AgentsToolsClientAccessRoots > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/client/AgentsTools.ClientAccessRoots.include"
	local writeWorkspace="$1" writeRead writeWref writeGrant writePrint writeOut
	AgentsHarnessRootsFingerprint "$writeWorkspace" || return 1
	writePrint="$agentsRootsPrint"
	writeRead="$(
		writeOrigin="${MDLT_ORIGIN:-}"
		if [ -n "$writeOrigin" ] ; then
			if type DistroAgentsTools >/dev/null 2>&1 ; then
				writeTools="$( declare -f DistroAgentsTools )"
				eval "AgentsHarnessRootsOriginTools${writeTools#DistroAgentsTools}"
				DistroAgentsTools(){ MDLT_ORIGIN="$writeOrigin" AgentsHarnessRootsOriginTools "$@" ; }
			fi
			## What the producer loads on demand, loaded while MDLT_ORIGIN still names it: every
			## include is spelled from $MDLT_ORIGIN, so after the blank below it would name no file.
			type AgentsToolsTeamGrantRows > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.TeamRegistry.include"
			type AgentsToolsGrantsIndexEnsure > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.Grants.include"
			type LocalToolsPlacesMergedText > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/places/LocalTools.Places.include"
			type AgentsToolsWorkspaceSwitch > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.MemberWorkspace.include"
			MDLT_ORIGIN=""
		fi
		AgentsToolsClientAccessRoots "$writeWorkspace" "" 2>/dev/null
	)" || return 1
	writeWref="$( AgentsToolsClientAccessReferenceRoots write "$writeWorkspace" "" 2>/dev/null )" || return 1
	writeGrant="$( AgentsToolsClientAccessGrantRoots 2>/dev/null )" || return 1
	## Every root resolved in this one subshell, each from where it started.
	writeOut="$(
		unset CDPATH
		writeStart="$PWD"
		## THE READY ANSWER, for the call path: the roots and resolutions of each kind on one line, joined by the unit separator, and the
		## rows whose answer depends on the disk at call time, u unresolved and l through a link, so a call tests those alone. Written
		## only where every root is absolute plain text; the rows follow it, as every reader of this format reads them.
		writeRows="" writeTests="" writeReady=yes writeSep=$'\037'
		writeList_read="" writeReals_read="" writeAt_read=0 writeList_wref="" writeReals_wref="" writeAt_wref=0 writeList_grant="" writeReals_grant="" writeAt_grant=0
		for writeKind in read wref grant ; do
			## Each pattern opened by its own `(`: bash 3.2 misparses a bare `x)` inside `$( )`.
			case "$writeKind" in
				(read) writeLines="$writeRead" ;;
				(wref) writeLines="$writeWref" ;;
				(grant) writeLines="$writeGrant" ;;
			esac
			[ -n "$writeLines" ] || continue
			while IFS= read -r writeRoot ; do
				## `cd && pwd -P` as the harness resolves, by builtins: PWD after `cd -P .` is what pwd -P prints.
				cd "$writeStart" 2>/dev/null
				cd "$writeRoot" 2>/dev/null && cd -P . 2>/dev/null && writeReal="$PWD" || writeReal=""
				AgentsHarnessRootsEnc "$writeRoot" ; writeRows="$writeRows$writeKind"$'\t'"$agentsRootsEnc"
				AgentsHarnessRootsEnc "$writeReal" ; writeRows="$writeRows"$'\t'"$agentsRootsEnc"$'\n'
				case "$writeRoot" in (/*) ;; (*) writeReady="" ;; esac
				case "$writeRoot$writeReal" in (*"$writeSep"*|*$'\t'*|*\\*) writeReady="" ;; esac
				writeAtName="writeAt_$writeKind" ; writeListName="writeList_$writeKind" ; writeRealsName="writeReals_$writeKind"
				writeAt="${!writeAtName}" ; writeJoin="" ; [ "$writeAt" = 0 ] || writeJoin="$writeSep"
				if [ -z "$writeReal" ] ; then writeTests="$writeTests${writeTests:+$writeSep}${writeKind:0:1}${writeAt}u" ; writeReal="$writeRoot"
				elif [ "$writeReal" != "$writeRoot" ] ; then writeTests="$writeTests${writeTests:+$writeSep}${writeKind:0:1}${writeAt}l"
				fi
				printf -v "$writeListName" '%s' "${!writeListName}$writeJoin$writeRoot"
				printf -v "$writeRealsName" '%s' "${!writeRealsName}$writeJoin$writeReal"
				printf -v "$writeAtName" '%s' "$(( writeAt + 1 ))"
			done <<< "$writeLines"
		done
		AgentsHarnessRootsEnc "$writePrint" ; printf 'print\t%s\n' "$agentsRootsEnc"
		if [ -n "$writeReady" ] ; then
			for writeKind in read wref grant ; do
				writeListName="writeList_$writeKind" ; writeRealsName="writeReals_$writeKind"
				printf 'readyroots\t%s\t%s\nreadyreals\t%s\t%s\n' "$writeKind" "${!writeListName}" "$writeKind" "${!writeRealsName}"
			done
			printf 'readytests\tall\t%s\n' "$writeTests"
		fi
		printf '%send' "$writeRows"
	)" || return 1
	## Whatever changed while this ran makes the index describe a set nobody computed.
	AgentsHarnessRootsFingerprint "$writeWorkspace" && [ "$agentsRootsPrint" = "$writePrint" ] || return 1
	printf '%s\n%s\n' "$agentsRootsIndexHeader" "$writeOut"
}

## Fills, from the index, what the harness otherwise computes: harnessAccessRoots (and its
## resolutions in harnessAccessRootsReal, empty where the harness must resolve), and when
## the caller passes a write count of 0 harnessWriteAccessRoots/harnessWriteAccessRootsReal
## too. Non-zero, with nothing touched, when the index does not vouch for this run.
harnessAccessRootsReal=()
harnessWriteAccessRootsReal=()
AgentsHarnessRootsIndexUse(){ ## workspace, member name, write roots already given
	local useWorkspace="$1" useMember="$2" useWriteGiven="$3" useIndex="$1/.local/agents/harness.roots.index"
	local useRaw="" useBody useLine useTag useRest useRoot useReal useEnded="" useIdx useMerged useMergedLine
	local useReadRoots=() useReadReals=() useWrefRoots=() useWrefReals=() useGrantRoots=() useGrantReals=() useExtra=()
	[ -n "$useWorkspace" ] && [ -f "$useIndex" ] || return 1
	## Member links re-pointed in a second already gone leave their directory newer than the index.
	[ -z "${MDAT_SKILLSET_ROOT:-}" ] || [ ! "$MDAT_SKILLSET_ROOT" -nt "$useIndex" ] || return 1
	## One block read, by the one fork it costs: `read -d ''` reads a file a byte at a time, which costs more than the fork here.
	useRaw="$( < "$useIndex" )" || return 1
	case "$useRaw" in "$agentsRootsIndexHeader"$'\n'"print"$'\t'*) ;; *) return 1 ;; esac
	useBody="${useRaw#*$'\n'}"
	useLine="${useBody%%$'\n'*}"
	AgentsHarnessRootsFingerprint "$useWorkspace" || return 1
	AgentsHarnessRootsDec "${useLine#*$'\t'}"
	[ "$agentsRootsDec" = "$agentsRootsPrint" ] || return 1
	## THE READY ANSWER (the writer's ready lines, first after the print line): split by builtins, the rows the writer named tested
	## against the disk, the member's extras put in their sorted place, so this call does no work per root and starts no process.
	case "$useBody" in *$'\n'"readyroots"$'\t'*)
		case "$useRaw" in *$'\n'end|*$'\n'end$'\n') ;; *) return 1 ;; esac
		local LC_ALL=C IFS useKind useField useTest useLow useHigh useMid useAt useTests=() useMergedRoots=() useMergedReals=()
		## THE ROWS LEFT OPEN, the only ones the harness start resolves: a root made since the index, and the member's extras.
		local useOpenRead=() useOpenWref=() useOpenGrant=() useOpenWrite=() useOpenShifted=() useOpenPlaced="" useOpenAt useOpenBase="${#harnessAccessRoots[@]}${#harnessWriteAccessRoots[@]}"
		harnessRootsReadyRead="" harnessRootsReadyWrite=""
		## The ready lines follow the header and the print line, in the writer's order, each taken whole by `read` from the text read
		## above. A slice off the body rescans the whole line for each one, which is quadratic in bash 3.2 on lines this long.
		{
			read -r useLine && read -r useLine || return 1
			for useKind in read wref grant ; do
				for useField in roots reals ; do
					IFS=$'\t' read -r useTag useRest useLine || return 1
					[ "$useTag $useRest" = "ready$useField $useKind" ] || return 1
					## A row is split by a noglob word split on the unit separator: no here-string, so no file per row.
					IFS=$'\037' ; set -f
					case "$useField:$useKind" in
						roots:read) useReadRoots=( $useLine ) ;;
						reals:read) useReadReals=( $useLine ) ;;
						roots:wref) useWrefRoots=( $useLine ) ;;
						reals:wref) useWrefReals=( $useLine ) ;;
						roots:grant) useGrantRoots=( $useLine ) ;;
						reals:grant) useGrantReals=( $useLine ) ;;
					esac
					set +f ; unset IFS
				done
			done
			IFS=$'\t' read -r useTag useRest useLine || return 1
			[ "$useTag $useRest" = "readytests all" ] || return 1
		} <<< "$useRaw"
		IFS=$'\037' ; set -f ; useTests=( $useLine ) ; set +f ; unset IFS
		[ "${#useReadRoots[@]}" = "${#useReadReals[@]}" ] && [ "${#useWrefRoots[@]}" = "${#useWrefReals[@]}" ] && [ "${#useGrantRoots[@]}" = "${#useGrantReals[@]}" ] || return 1
		## A stored resolution holds only while its root is still a directory; a root that is none resolves to itself.
		for useTest in ${useTests[@]+"${useTests[@]}"} ; do
			useAt="${useTest%?}" ; useAt="${useAt#?}"
			case "$useTest" in r*) useRoot="${useReadRoots[$useAt]}" ;; w*) useRoot="${useWrefRoots[$useAt]}" ;; g*) useRoot="${useGrantRoots[$useAt]}" ;; *) return 1 ;; esac
			if [ ! -d "$useRoot" ] ; then useReal="$useRoot"
			else
				case "$useTest" in *l) continue ;; esac
				useReal=""
				case "$useTest" in r*) useOpenRead+=( "$useAt" ) ;; w*) useOpenWref+=( "$useAt" ) ;; g*) useOpenGrant+=( "$useAt" ) ;; esac
			fi
			case "$useTest" in r*) useReadReals[$useAt]="$useReal" ;; w*) useWrefReals[$useAt]="$useReal" ;; g*) useGrantReals[$useAt]="$useReal" ;; esac
		done
		local useWriteRoots=() useWriteReals=()
		if [ "$useWriteGiven" = 0 ] ; then
			useWriteRoots=( ${useWrefRoots[@]+"${useWrefRoots[@]}"} ) ; useWriteReals=( ${useWrefReals[@]+"${useWrefReals[@]}"} )
			useOpenWrite=( ${useOpenWref[@]+"${useOpenWref[@]}"} )
			if [ -n "$useMember" ] ; then
				useOpenWrite+=( "${#useWriteRoots[@]}" "$(( ${#useWriteRoots[@]} + 1 ))" )
				useWriteRoots+=( "$useWorkspace/.local/temp/member/$useMember" "$useWorkspace/.local/temp/task/$useMember" ) ; useWriteReals+=( "" "" )
			fi
			for useOpenAt in ${useOpenGrant[@]+"${useOpenGrant[@]}"} ; do useOpenWrite+=( "$(( useOpenAt + ${#useWriteRoots[@]} ))" ) ; done
			useWriteRoots+=( ${useGrantRoots[@]+"${useGrantRoots[@]}"} ) ; useWriteReals+=( ${useGrantReals[@]+"${useGrantReals[@]}"} )
			[ "${#useWriteRoots[@]}" -gt 0 ] || return 1
		fi
		## The read set: the stored roots are the producer's C-sorted set, so each extra goes in at its own place, found by halving.
		useMergedRoots=( ${useReadRoots[@]+"${useReadRoots[@]}"} ) ; useMergedReals=( ${useReadReals[@]+"${useReadReals[@]}"} )
		[ -z "${MDLT_ORIGIN:-}" ] || useExtra+=( "$MDLT_ORIGIN/myx/myx.distro-agents/skillset" )
		[ -z "$useMember" ] || useExtra+=( "$useWorkspace/.local/temp/member/$useMember" "$useWorkspace/.local/temp/task/$useMember" )
		for useRoot in ${useExtra[@]+"${useExtra[@]}"} ; do
			case "$useRoot" in /*) ;; *) continue ;; esac
			useLow=0 useHigh="${#useMergedRoots[@]}"
			while [ "$useLow" -lt "$useHigh" ] ; do
				useMid=$(( ( useLow + useHigh ) / 2 ))
				if [[ "${useMergedRoots[$useMid]}" < "$useRoot" ]] ; then useLow=$(( useMid + 1 )) ; else useHigh="$useMid" ; fi
			done
			[ "${useMergedRoots[$useLow]-}" != "$useRoot" ] || continue
			useMergedRoots=( "${useMergedRoots[@]:0:$useLow}" "$useRoot" "${useMergedRoots[@]:$useLow}" )
			useMergedReals=( "${useMergedReals[@]:0:$useLow}" "" "${useMergedReals[@]:$useLow}" )
			## The open rows at or past the place it went in move one on, and the place itself is open, kept in order.
			useOpenShifted=() useOpenPlaced=""
			for useOpenAt in ${useOpenRead[@]+"${useOpenRead[@]}"} ; do
				if [ -z "$useOpenPlaced" ] && [ "$useOpenAt" -ge "$useLow" ] ; then useOpenShifted+=( "$useLow" ) ; useOpenPlaced=1 ; fi
				[ "$useOpenAt" -lt "$useLow" ] || useOpenAt=$(( useOpenAt + 1 ))
				useOpenShifted+=( "$useOpenAt" )
			done
			[ -n "$useOpenPlaced" ] || useOpenShifted+=( "$useLow" )
			useOpenRead=( ${useOpenShifted[@]+"${useOpenShifted[@]}"} )
		done
		harnessAccessRootsReal=()
		harnessAccessRoots+=( ${useMergedRoots[@]+"${useMergedRoots[@]}"} ) ; harnessAccessRootsReal+=( ${useMergedReals[@]+"${useMergedReals[@]}"} )
		## Named only where the harness sets were empty before this call, so a position is the harness's own.
		if [ "$useOpenBase" = 00 ] ; then harnessAccessRootsOpen=( ${useOpenRead[@]+"${useOpenRead[@]}"} ) ; harnessRootsReadyRead=1 ; fi
		if [ "$useWriteGiven" = 0 ] ; then
			harnessWriteAccessRootsReal=()
			case "$useWorkspace" in
				/*)
					harnessWriteAccessRoots+=( "${useWriteRoots[@]}" ) ; harnessWriteAccessRootsReal+=( "${useWriteReals[@]}" )
					if [ "$useOpenBase" = 00 ] ; then harnessWriteAccessRootsOpen=( ${useOpenWrite[@]+"${useOpenWrite[@]}"} ) ; harnessRootsReadyWrite=1 ; fi
				;;
				*)
					useAt=0
					while [ "$useAt" -lt "${#useWriteRoots[@]}" ] ; do
						case "${useWriteRoots[$useAt]}" in /*) harnessWriteAccessRoots+=( "${useWriteRoots[$useAt]}" ) ; harnessWriteAccessRootsReal+=( "${useWriteReals[$useAt]}" ) ;; esac
						useAt=$(( useAt + 1 ))
					done
				;;
			esac
		fi
		return 0
	;; esac
	while IFS= read -r useLine ; do
		useTag="${useLine%%$'\t'*}"
		useRest="${useLine#*$'\t'}"
		case "$useTag" in
			read|wref|grant)
				AgentsHarnessRootsDec "${useRest%%$'\t'*}" ; useRoot="$agentsRootsDec"
				AgentsHarnessRootsDec "${useRest#*$'\t'}" ; useReal="$agentsRootsDec"
				## A stored resolution holds only while its root is still a directory; a root that is none resolves to itself, as AgentsHarnessResolveDir answers it.
				[ -d "$useRoot" ] || useReal="$useRoot"
				case "$useTag" in
					read) useReadRoots+=( "$useRoot" ) ; useReadReals+=( "$useReal" ) ;;
					wref) useWrefRoots+=( "$useRoot" ) ; useWrefReals+=( "$useReal" ) ;;
					grant) useGrantRoots+=( "$useRoot" ) ; useGrantReals+=( "$useReal" ) ;;
				esac
			;;
			end) useEnded=1 ; break ;;
		esac
	done <<< "${useBody#*$'\n'}"
	[ -n "$useEnded" ] || return 1
	## The write set first, since an empty one is the harness's own refusal to make.
	local useWriteRoots=() useWriteReals=()
	if [ "$useWriteGiven" = 0 ] ; then
		useIdx=0
		while [ "$useIdx" -lt "${#useWrefRoots[@]}" ] ; do
			useWriteRoots+=( "${useWrefRoots[$useIdx]}" ) ; useWriteReals+=( "${useWrefReals[$useIdx]}" )
			useIdx=$(( useIdx + 1 ))
		done
		## The member's own two scopes, where the producer prints them: after the team's.
		if [ -n "$useMember" ] ; then
			useWriteRoots+=( "$useWorkspace/.local/temp/member/$useMember" "$useWorkspace/.local/temp/task/$useMember" ) ; useWriteReals+=( "" "" )
		fi
		useIdx=0
		while [ "$useIdx" -lt "${#useGrantRoots[@]}" ] ; do
			useWriteRoots+=( "${useGrantRoots[$useIdx]}" ) ; useWriteReals+=( "${useGrantReals[$useIdx]}" )
			useIdx=$(( useIdx + 1 ))
		done
		[ "${#useWriteRoots[@]}" -gt 0 ] || return 1
	fi
	## The read set: this origin's skillset and, with a member named, its two scopes join
	## the sorted-unique set exactly as the producer's own `sort -u` places them; every
	## other root keeps its stored resolution, found by walking the two sorted lists together.
	[ -z "${MDLT_ORIGIN:-}" ] || useExtra+=( "$MDLT_ORIGIN/myx/myx.distro-agents/skillset" )
	[ -z "$useMember" ] || useExtra+=( "$useWorkspace/.local/temp/member/$useMember" "$useWorkspace/.local/temp/task/$useMember" )
	harnessAccessRootsReal=()
	if [ "${#useExtra[@]}" -eq 0 ] ; then
		useIdx=0
		while [ "$useIdx" -lt "${#useReadRoots[@]}" ] ; do
			case "${useReadRoots[$useIdx]}" in
				/*) harnessAccessRoots+=( "${useReadRoots[$useIdx]}" ) ; harnessAccessRootsReal+=( "${useReadReals[$useIdx]}" ) ;;
			esac
			useIdx=$(( useIdx + 1 ))
		done
	else
		useMerged="$( printf '%s\n' ${useReadRoots[@]+"${useReadRoots[@]}"} ${useExtra[@]+"${useExtra[@]}"} | LC_ALL=C sort -u | LC_ALL=C awk 'NF' )" || return 1
		useIdx=0
		while IFS= read -r useMergedLine ; do
			useReal=""
			if [ "$useIdx" -lt "${#useReadRoots[@]}" ] && [ "${useReadRoots[$useIdx]}" = "$useMergedLine" ] ; then
				useReal="${useReadReals[$useIdx]}"
				useIdx=$(( useIdx + 1 ))
			fi
			case "$useMergedLine" in
				/*) harnessAccessRoots+=( "$useMergedLine" ) ; harnessAccessRootsReal+=( "$useReal" ) ;;
			esac
		done <<< "$useMerged"
	fi
	if [ "$useWriteGiven" = 0 ] ; then
		harnessWriteAccessRootsReal=()
		useIdx=0
		while [ "$useIdx" -lt "${#useWriteRoots[@]}" ] ; do
			case "${useWriteRoots[$useIdx]}" in
				/*) harnessWriteAccessRoots+=( "${useWriteRoots[$useIdx]}" ) ; harnessWriteAccessRootsReal+=( "${useWriteReals[$useIdx]}" ) ;;
			esac
			useIdx=$(( useIdx + 1 ))
		done
	fi
	return 0
}
