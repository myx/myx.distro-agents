#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsHarnessUnserved.include -- the tools one side does not serve, which that side still LISTS, so the harness and the MCP server list the same
## tools (S2.1): the harness floor is the MCP list less Bash and WorkspaceContextExecute, which only the harness serves, and the MCP list is the
## harness floor plus execute and RootSession, which only the MCP server serves. The secondary tools are on neither list: both sides serve them,
## the harness through its own wire and one handler (AgentsHarnessToolSecondary). Each unserved tool carries a description that says where it
## runs, and an input schema that takes the optional intent description only, as every listed tool does. Sourced; declarations and functions only.
##

agentsUnservedSchema='{"type":"object","properties":{"description":{"type":"string","description":"Optional. One short sentence: why this call is made, what you expect from it. Recorded as your stated intent in the transcript and the tracking feed; it does not change what the tool does."}},"required":[]}'

## The tools the MCP server does not serve and the harness does, one name a line.
agentsUnservedOnMcp='Bash
WorkspaceContextExecute'

## The tools the harness does not serve and the MCP server does, one name a line: RootSession, the tool the MCP server holds for the harness's own
## root run. The secondary tools were here once; the harness now serves them itself, so they are on neither side's unserved list.
AgentsToolsUnservedInHarness(){
	printf '%s\n' RootSession
}

## What a tool unserved on a side says: the one sentence of its description. $1 = the side that does not serve it, `mcp` or `harness`; $2 = the tool.
AgentsToolsUnservedSays(){
	case "$1" in
		mcp) printf '%s' "Not served over MCP: $2 runs in the harness only. Over MCP, run a shell script with execute instead. Pass description to give a short description of why." ;;
		*) printf '%s' "Not served in the harness: $2 runs over MCP only, as the tool of the same name of the myx.distro server. From the harness, run its operations through mcp__myx_distro__execute. Pass description to give a short description of why." ;;
	esac
}

## The MCP entries of the tools it does not serve, comma-ended, to stand in the tools/list array: {"name","description","inputSchema"}.
AgentsToolsUnservedMcpEntries(){
	local unservedName
	while IFS= read -r unservedName ; do
		[ -n "$unservedName" ] || continue
		printf '{"name":"%s","description":"%s","inputSchema":%s},' "$unservedName" "$( AgentsToolsUnservedSays mcp "$unservedName" )" "$agentsUnservedSchema"
	done <<< "$agentsUnservedOnMcp"
}
