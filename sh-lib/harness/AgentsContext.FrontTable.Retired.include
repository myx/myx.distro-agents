## The operations the harness and MCP tools run, whose result `--mdat-output-format json` before the name wraps in one JSON object (DistroAgentsTools.fn.sh has the
## internal ones). sh-test/harness/AgentsBatchToolsCheck.test.sh holds the list to the words the harness runs.

## What an old name was replaced by: its refusal line, or nothing for a name that was never one.
AgentsToolsFrontRetired(){ ## name
	local retiredNow
	retiredNow="$( printf '%s\n' "$agentsFrontRetired" | LC_ALL=C awk -F'\t' -v op="$1" '$1 == op { print $2 ; exit }' )"
	[ -n "$retiredNow" ] || return 1
	case "$retiredNow" in
		\(*) printf '%s: ⛔ ERROR: %s is retired: %s\n' "${MDSC_CMD:-DistroAgentsTools}" "$1" "${retiredNow#(}" | LC_ALL=C sed 's/)$//' ;;
		*) printf '%s: ⛔ ERROR: %s was renamed: use %s -- nothing was done\n' "${MDSC_CMD:-DistroAgentsTools}" "$1" "$retiredNow" ;;
	esac
}
