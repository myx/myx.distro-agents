#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsContext.FrontTable.Retired.include -- the names the operations had, before they moved into a tool file (F1.4 of the refactorings epic),
## and the refusal a call of one gets, naming its new place. Sourced, never run. Declarations and functions only.
##
## Split from AgentsContext.FrontTable.include: every call routes through the table, and only a call of a name
## this table does not hold, under a --member-* or --magic-* prefix, reads this one (DistroAgentsTools.fn.sh).
##

agentsFrontRetired='--magic-advance-batch-outcome	DistroAgentsItems.fn.sh --advance-batch-outcome
--magic-advance-close-state-and-unlock	(the spawner gives the routine lock back itself)
--magic-advance-lock-acquire	(the spawner takes the routine lock itself)
--magic-advance-lock-refresh	(the spawner refreshes the lock itself)
--magic-advance-lock-status	(read the lock note with DistroAgentsItems.fn.sh --get-inbox-item)
