#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

## AgentsHarnessToolsBash.include: the Bash tool and its detached processes. Sourced by AgentsUniversalHarness.sh, definitions only.
## A call's two streams are joined as they are written unless the caller asks for `output_mode=prefixed`; then stdout and stderr are kept apart and each
## line is marked `>` for stdout and `!` for stderr, the rendering a detached read already gives (sketch 3.3).

type AgentsToolsSessionPauseWait > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionPause.include"

## A detached process's handle must be unique for the whole SESSION, not for one harness
## process: the counter this used to be kept in a shell variable reset in every served call, so
## two detaches in one session both came back as process-1 and the second one's files overwrote
## the first one's -- its output was gone, silently. The handle is claimed by an exclusive
## create in the session's own processes folder, which no later start can take whatever process
## it runs in, and a handle once claimed is never reused: a Wait on an old handle still reads the
## process it named. Readable in a transcript, and not a pid the system may hand to something else.
AgentsHarnessProcessClaimHandle(){ ## processes dir -- the handle this start owns, nothing where none could be claimed
	local claimDir="$1" claimNumber=1 claimFile
	while [ "$claimNumber" -le 9999 ] ; do
		claimFile="$claimDir/process-$claimNumber.out"
		if ( set -C ; : > "$claimFile" ) 2> /dev/null ; then
			printf 'process-%s' "$claimNumber"
			return 0
		fi
		claimNumber=$(( claimNumber + 1 ))
	done
	return 1
}

## The byte counts a stopped process's output is closed at, as its `.closed` marker keeps them
## (`out <n>` and `err <n>`). A reader delivers at most these bytes, so a child that outlived
## the stop -- one that escaped the process group, or wrote between the signal and its death --
## cannot add a line to a handle its reader closed. Empty where the handle was never stopped, and
## where its marker was written by an older build: there the output is read whole, as it was then.
AgentsHarnessProcessClosedAt(){ ## processes dir, handle -- "outBytes errBytes", nothing where there are none
	local closedLine closedOut=0 closedErr=0 closedSeen=""
	[ -f "$1/$2.closed" ] || return 0
	while IFS= read -r closedLine ; do
		case "$closedLine" in
			'out '*) closedOut="${closedLine#out }" ; closedSeen="yes" ;;
			'err '*) closedErr="${closedLine#err }" ; closedSeen="yes" ;;
		esac
	done < "$1/$2.closed"
	[ -n "$closedSeen" ] || return 0
	case "$closedOut" in ''|*[!0-9]*) closedOut=0 ;; esac
	case "$closedErr" in ''|*[!0-9]*) closedErr=0 ;; esac
	printf '%s %s' "$closedOut" "$closedErr"
}

## The output of a detached process as it is delivered: stdout lines prefixed > and stderr
## lines prefixed !, each stream cut at the byte count the handle was closed at when it has
## one (empty caps read the file whole). One rendering for the Bash read and one for the Wait
## probe, so a closed handle says the same thing to both.
AgentsHarnessProcessRender(){ ## processes dir, handle, out cap, err cap -- the prefixed rendering on stdout
	local renderDir="$1" renderHandle="$2" renderOut="$3" renderErr="$4"
	if [ -n "$renderOut" ] ; then
		[ ! -f "$renderDir/$renderHandle.out" ] || head -c "$renderOut" "$renderDir/$renderHandle.out" 2> /dev/null | LC_ALL=C awk '{ print ">" $0 }'
		[ ! -f "$renderDir/$renderHandle.err" ] || head -c "$renderErr" "$renderDir/$renderHandle.err" 2> /dev/null | LC_ALL=C awk '{ print "!" $0 }'
	else
		[ ! -f "$renderDir/$renderHandle.out" ] || LC_ALL=C awk '{ print ">" $0 }' "$renderDir/$renderHandle.out" 2> /dev/null
		[ ! -f "$renderDir/$renderHandle.err" ] || LC_ALL=C awk '{ print "!" $0 }' "$renderDir/$renderHandle.err" 2> /dev/null
	fi
}

## One report of a detached process, posted as a notice into the event-track thread, else the session thread, which keeps the credential. The
## sentence is the tooling's own words and is what the plain-language floor measures; the output lines after it are the process's.
## Every failure goes to the process's own report log, never to nowhere.
AgentsHarnessProcessPost(){ ## processes dir, handle, thread, address to, sentence, output lines
	local postDir="$1" postHandle="$2" postRc=0 postArgs
	if [ -z "$harnessAgent" ] ; then
		printf 'ERROR: this run has no team identity to post under, so the report was NOT posted: %s\n' "$5" >> "$postDir/$postHandle.report" ; return 1
	fi
	## A process's progress and end are tracking notices of this run. They go into its coworking session's event-track thread,
	## with no addressee, as every tracking post does (AgentsTools.EventTrackThread.include). Its output stays in the process's
	## own files, which the run reads with TaskOutput. Only where no event-track channel is configured does the notice go
	## into the session thread, still with no addressee.
	if [ -n "${MDAT_SPAWN_SESSION_ID:-}" ] ; then
		(
			type AgentsToolsEventTrackThreadPost > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.EventTrackThread.include"
			AgentsToolsEventTrackThreadPost "$harnessAgent" "$( AgentsToolsEventTrackThreadOwnDir )" --kind notice \
				--session-id "$MDAT_SPAWN_SESSION_ID" --field what="$5" < /dev/null
		) >> "$postDir/$postHandle.report" 2>&1 || postRc=$?
		case "$postRc" in
			0) return 0 ;;
			2) postRc=0 ;;
			*) printf 'ERROR: the notice was NOT posted to event-track (rc=%s): %s\n' "$postRc" "$5" >> "$postDir/$postHandle.report" ; return "$postRc" ;;
		esac
	fi
	postArgs=( "$BASH" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh" --slack-send-message --team-member "$harnessAgent" "$3" )
	printf '%s' "$5" > "$postDir/$postHandle.report.prose"
	{ printf '%s\n' "$5" ; [ -z "$6" ] || printf '\n%s\n' "$6" ; } | MDAT_SEND_PROSE_FILE="$postDir/$postHandle.report.prose" ${postArgs[@]+"${postArgs[@]}"} --from-stdin >> "$postDir/$postHandle.report" 2>&1 || postRc=$?
	[ "$postRc" = 0 ] || printf 'ERROR: the report was NOT posted (rc=%s): %s\n' "$postRc" "$5" >> "$postDir/$postHandle.report"
	return "$postRc"
}

## The reporter of a detached process (S3.1): it lives as long as the process does and posts into the session thread, still running at the interval
## MDAT_PROCESS_ALIVE_SECONDS (600; 0 for none), possibly waiting for input once an output that stopped without a newline has been quiet for
## MDAT_PROCESS_INPUT_IDLE_SECONDS (30), and the end with its exit status and last lines. A process the caller stops is not reported as ended.
AgentsHarnessProcessReporter(){ ## processes dir, handle, wrapper pid, thread, address to
	local repDir="$1" repHandle="$2" repPid="$3" repThread="$4" repCaller="$5"
	local repAlive="${MDAT_PROCESS_ALIVE_SECONDS:-600}" repIdle="${MDAT_PROCESS_INPUT_IDLE_SECONDS:-30}" repPoll="${MDAT_PROCESS_POLL_SECONDS:-1}"
	local repNow repStart repGrew repPosted repSize="" repAsked="" repBytes repStatus repLines repEnd="" repFile repLastByte repPrompt
	set +e
	repStart="$( date +%s )" ; repGrew="$repStart" ; repPosted="$repStart"
	while : ; do
		[ ! -f "$repDir/$repHandle.closed" ] || return 0
		if [ -f "$repDir/$repHandle.status" ] ; then repEnd=status ; break ; fi
		if ! kill -0 "$repPid" 2> /dev/null ; then
			sleep "$repPoll"
			[ ! -f "$repDir/$repHandle.closed" ] || return 0
			if [ -f "$repDir/$repHandle.status" ] ; then repEnd=status ; else repEnd=gone ; fi
			break
		fi
		sleep "$repPoll"
		## a stop made during the sleep ends the reporter before it posts
		[ ! -f "$repDir/$repHandle.closed" ] || return 0
		repNow="$( date +%s )"
		repBytes="$( cat "$repDir/$repHandle.out" "$repDir/$repHandle.err" 2> /dev/null | wc -c | tr -d ' ' )"
		if [ "$repBytes" != "$repSize" ] ; then repSize="$repBytes" ; repGrew="$repNow" ; repAsked="" ; fi
		if [ "$repIdle" -gt 0 ] && [ "$repBytes" -gt 0 ] && [ "$repAsked" != "$repBytes" ] && [ $(( repNow - repGrew )) -ge "$repIdle" ] ; then
			repPrompt=""
			for repFile in "$repDir/$repHandle.out" "$repDir/$repHandle.err" ; do
				[ -s "$repFile" ] || continue
				repLastByte="$( tail -c 1 "$repFile" | od -An -c | tr -d ' ' )"
				[ "$repLastByte" = '\n' ] || repPrompt="$( tail -n 1 "$repFile" )"
			done
			repAsked="$repBytes"
			if [ -n "$repPrompt" ] ; then
				AgentsHarnessProcessPost "$repDir" "$repHandle" "$repThread" "$repCaller" "Process $repHandle may be waiting for input. Its output stopped without a newline." "> $repPrompt"
				repPosted="$repNow"
				continue
			fi
		fi
		if [ "$repAlive" -gt 0 ] && [ $(( repNow - repPosted )) -ge "$repAlive" ] ; then
			AgentsHarnessProcessPost "$repDir" "$repHandle" "$repThread" "" "Process $repHandle is still running. It has written $repBytes bytes so far."
			repPosted="$repNow"
		fi
	done
	repLines="$( AgentsHarnessProcessRender "$repDir" "$repHandle" "" "" 2> /dev/null | tail -n 20 )"
	## The output follows the sentence as quoted data in a fence. Every rendered line starts with > or !, so no line the
	## process wrote can close that fence early.
	[ -z "$repLines" ] || repLines="Last lines of its output, > for stdout and ! for stderr:"$'\n'$'```'$'\n'"$repLines"$'\n'$'```'
	if [ "$repEnd" = status ] ; then
		repStatus="$( cat "$repDir/$repHandle.status" 2> /dev/null )"
		AgentsHarnessProcessPost "$repDir" "$repHandle" "$repThread" "$repCaller" "Process $repHandle ended with exit status $repStatus." "$repLines"
	else
		AgentsHarnessProcessPost "$repDir" "$repHandle" "$repThread" "$repCaller" "Process $repHandle is gone and left no exit status." "$repLines"
	fi
	return 0
}

## The call's own streams, set once so the command inherits them: `prefixed` (a mode, so non-empty) keeps stdout and stderr in two files, and
## anything else joins them in the order they were written, as this tool has always delivered them.
AgentsHarnessToolStreams(){ ## stdin file, stdout file, stderr file, output mode
	if [ -n "$4" ] ; then exec < "$1" > "$2" 2> "$3" ; else exec < "$1" > "$2" 2>&1 ; fi
}

## No sandboxing beyond the cwd bound, matching copilot's own --allow-all-tools trust
## model. Output goes to a scratch file rather than $( ): a model-supplied command may
## background a child that holds a capture pipe open forever.
## Whether a command text kills by pattern (epic S10.20): `pkill` or `killall` standing as a command (first on the line, or
## after `;`, `&&`, `||`, `|`, `(`, `$(`, a backtick, `then`, `do`, `exec`, `sudo`, `xargs` or `nohup`); a `kill` whose
## targets come from `pgrep`, `ps` or `xargs`; or a `kill` of every process, `-1`. rc 0 when it does, with the shape found
## in harnessKillPattern. Comments and the text of a single-quoted string are not read: the words there run nothing.
AgentsHarnessBashKillByPattern(){ ## command text
	local killText
	harnessKillPattern=""
	## Comments and single-quoted strings go, line by line, so a word quoted as data is not a command.
	killText="$( printf '%s\n' "$1" | LC_ALL=C sed -e "s/'[^']*'/''/g" -e 's/^[[:space:]]*#.*$//' -e 's/[[:space:]]#.*$//' )"
	## A command stands first on its line or after a separator, with any run of wrapper words (sudo, nohup, exec, ...) before it.
	local killAt='(^|[;&|(`])[[:space:]]*((then|do|else|exec|sudo|xargs|nohup|command|builtin|time)[[:space:]]+)*'
	if printf '%s\n' "$killText" | LC_ALL=C grep -q -E "$killAt"'(pkill|killall)([[:space:]]|$)' ; then
		harnessKillPattern="pkill or killall" ; return 0
	fi
	if printf '%s\n' "$killText" | LC_ALL=C grep -q -E "$killAt"'kill[[:space:]]+[^;&|]*(\$\([[:space:]]*(pgrep|ps)([[:space:]]|\))|`[[:space:]]*(pgrep|ps)([[:space:]]|`))' ; then
		harnessKillPattern="kill of what pgrep or ps lists" ; return 0
	fi
	if printf '%s\n' "$killText" | LC_ALL=C grep -q -E '\|[[:space:]]*xargs([[:space:]]+-[^[:space:]]+)*[[:space:]]+kill([[:space:]]|$)' ; then
		harnessKillPattern="kill through xargs" ; return 0
	fi
	if printf '%s\n' "$killText" | LC_ALL=C grep -q -E "$killAt"'kill[[:space:]]+(-[A-Za-z0-9]+[[:space:]]+)*-1([[:space:]]|$)' ; then
		harnessKillPattern="kill of every process" ; return 0
	fi
	return 1
}

## Whether a command text scans a whole tree (the hot-path rule, the human-owner's): a recursive `grep` (-r, -R, --recursive, alone or
## inside a flag run such as -rln) or a `find`, standing as a command, whose path is a workspace root, a store root or the
## source tree as a whole -- `/`, `~`, `$HOME`, `$MMDAPP`, `.local`, `.local/agents`, one store under it (`spawned`,
## `sessions`, `inboxes`, `team-data-root`, ...), `source` or one namespace under it, `/Users/<u>/Workspaces/<ws>`,
## `/Volumes/<v>/<ws>` and those same places under them, or `.` when the call's cwd is one of them. A workspace has about
## 1300 folders and 900 projects, so such a scan costs every other call its pace for minutes; four of them held this
## machine at a load of 60 to 80 for an afternoon. rc 0 when the text scans wide, with the path in harnessScanWide.
## Comments and single-quoted strings are not read, as in AgentsHarnessBashKillByPattern.
AgentsHarnessBashScanWide(){ ## command text, cwd
	harnessScanWide=""
	case "$1" in *grep*|*find*) ;; *) return 1 ;; esac
	local scanText scanLine scanWord scanIsScan scanCwd="${2:-}"
	scanText="$( printf '%s\n' "$1" | LC_ALL=C sed -e "s/'[^']*'/''/g" -e 's/^[[:space:]]*#.*$//' -e 's/[[:space:]]#.*$//' )"
	scanText="${scanText//[;&|(]/$'\n'}" ; scanText="${scanText//\`/$'\n'}"
	set -f
	while IFS= read -r scanLine ; do
		scanIsScan=""
		set -- $scanLine
		## The wrapper words before the command go.
		while [ $# -gt 0 ] ; do case "$1" in then|do|else|exec|sudo|xargs|nohup|command|builtin|time|env|LC_ALL=*|[A-Z_]*=*) shift ;; *) break ;; esac ; done
		[ $# -gt 0 ] || continue
		case "${1##*/}" in
			find) scanIsScan=find ; shift ;;
			grep|egrep|fgrep|rg)
				scanIsScan="" ; shift
				for scanWord in "$@" ; do
					case "$scanWord" in
						--recursive|--dereference-recursive) scanIsScan=grep ;;
						--*) ;;
						-*) case "${scanWord#-}" in *r*|*R*) scanIsScan=grep ;; esac ;;
					esac
				done
			;;
		esac
		[ -n "$scanIsScan" ] || continue
		## THE PLACE IS JUDGED BY ITS COMPONENTS, since a `*` in a shell pattern crosses slashes: the path is made absolute
		## (`.`, `~`, `$HOME` and `$MMDAPP` by their values), the workspace root found by shape (/Users/<u>/Workspaces/<ws>,
		## /Volumes/<v>/<ws>, or $MMDAPP itself), and the rest counted: the root, `.local`, `.local/agents`, one store under
		## it, `source`, one namespace under it are wide; anything deeper is one folder and runs.
		local scanPath scanBase scanRest scanDepth scanFirst scanSecond scanParts
		for scanWord in "$@" ; do
			case "$scanWord" in -*) continue ;; esac
			scanPath="${scanWord%/}"
			case "$scanPath" in
				.|'') scanPath="${scanCwd%/}" ;;
				\~|\~/*) scanPath="${HOME:-/nonexistent}${scanPath#\~}" ;;
				\$HOME|\$HOME/*) scanPath="${HOME:-/nonexistent}${scanPath#\$HOME}" ;;
				\$MMDAPP|\$MMDAPP/*) scanPath="${MMDAPP:-/nonexistent}${scanPath#\$MMDAPP}" ;;
			esac
			case "$scanPath" in /*) ;; *) continue ;; esac
			case "$scanPath" in /|/Users|/Volumes|"${HOME:-/nonexistent}") harnessScanWide="$scanIsScan over $scanWord" ; set +f ; return 0 ;; esac
			## The workspace root: the configured workspace where the path is under it, else by shape.
			scanBase=""
			if [ -n "${MMDAPP:-}" ] && [ "${scanPath#"${MMDAPP%/}"}" != "$scanPath" ] ; then
				scanBase="${MMDAPP%/}"
			else
				case "$scanPath" in
					/Users/*/Workspaces) harnessScanWide="$scanIsScan over $scanWord" ; set +f ; return 0 ;;
					/Users/*/Workspaces/*) scanBase="${scanPath#/Users/}" ; scanBase="/Users/${scanBase%%/*}/Workspaces/" ; scanRest="${scanPath#"$scanBase"}" ; scanBase="$scanBase${scanRest%%/*}" ;;
					/Volumes/*) scanBase="${scanPath#/Volumes/}" ; scanBase="/Volumes/${scanBase%%/*}" ; scanRest="${scanPath#"$scanBase"}" ; scanRest="${scanRest#/}" ; [ -n "$scanRest" ] || { harnessScanWide="$scanIsScan over $scanWord" ; set +f ; return 0 ; } ; scanBase="$scanBase/${scanRest%%/*}" ;;
				esac
			fi
			[ -n "$scanBase" ] || continue
			scanRest="${scanPath#"$scanBase"}" ; scanRest="${scanRest#/}"
			scanParts="${scanRest//[!\/]/}" ; scanDepth=$(( ${#scanParts} + 1 )) ; [ -n "$scanRest" ] || scanDepth=0
			scanFirst="${scanRest%%/*}" ; scanSecond="${scanRest#*/}" ; scanSecond="${scanSecond%%/*}"
			case "$scanDepth" in
				0) harnessScanWide="$scanIsScan over $scanWord" ; set +f ; return 0 ;;
				1) case "$scanFirst" in .local|source) harnessScanWide="$scanIsScan over $scanWord" ; set +f ; return 0 ;; esac ;;
				2) case "$scanFirst/$scanSecond" in .local/agents|source/*) harnessScanWide="$scanIsScan over $scanWord" ; set +f ; return 0 ;; esac ;;
				3) case "$scanFirst/$scanSecond" in .local/agents) harnessScanWide="$scanIsScan over $scanWord" ; set +f ; return 0 ;; esac ;;
			esac
		done
	done <<< "$scanText"
	set +f
	return 1
}

## Whether a command text signals a pid number this run does not own (epic S10.20, the part a pattern guard leaves): the
## numbers that stand after a `kill` are read against the run's own process set at the call (AgentsHarnessSessionPids with
## `own-word`, and this harness's own pid), and the first not in it is in harnessKillForeign, rc 0. A signal 0 (`-0`, `-s 0`,
## `-n 0`) is a probe and ends nothing, so it is not read; a `-l` lists and signals nothing. A pid that stands in a variable or a
## substitution is no number here and is not read. Comments and single-quoted strings go as in AgentsHarnessBashKillByPattern.
## Only a text that holds the word kill is read, and the own set is read once per call, only where a pid number is found.
AgentsHarnessBashKillForeign(){ ## command text
	harnessKillForeign=""
	case "$1" in *kill*) ;; *) return 1 ;; esac
	local killText killLine killWord killOpts killProbe killPids killPid killOwn="" killOwnRead=""
	killText="$( printf '%s\n' "$1" | LC_ALL=C sed -e "s/'[^']*'/''/g" -e 's/^[[:space:]]*#.*$//' -e 's/[[:space:]]#.*$//' )"
	## One command a line: the separators become line ends, and the words of a line are read without globbing.
	killText="${killText//[;&|(]/$'\n'}" ; killText="${killText//\`/$'\n'}"
	set -f
	while IFS= read -r killLine ; do
		set -- $killLine
		while [ $# -gt 0 ] ; do
			case "$1" in then|do|else|exec|sudo|xargs|nohup|command|builtin|time) shift ; continue ;; esac
			break
		done
		[ "${1:-}" = kill ] || continue
		shift
		killOpts=yes ; killProbe="" ; killPids=""
		while [ $# -gt 0 ] ; do
			killWord="$1" ; shift
			if [ -n "$killOpts" ] ; then
				case "$killWord" in
					--) killOpts="" ; continue ;;
					-0|-s0|-n0|-l|-L) killProbe=yes ; continue ;;
					-s|-n) [ "${1:-}" != 0 ] || killProbe=yes ; shift ; continue ;;
					-*) continue ;;
				esac
				killOpts=""
			fi
			case "$killWord" in -[0-9]*) killWord="${killWord#-}" ;; esac
			case "$killWord" in ''|*[!0-9]*) continue ;; esac
			killPids="$killPids $killWord"
		done
		[ -z "$killProbe" ] && [ -n "$killPids" ] || continue
		if [ -z "$killOwnRead" ] ; then
			killOwnRead=yes
			killOwn=" $$ $( AgentsHarnessSessionPids "${harnessSessionId:-${MDAT_SPAWN_SESSION_ID:-${CLAUDE_CODE_SESSION_ID:-}}}" own-word 2> /dev/null | LC_ALL=C tr '\n' ' ' ) "
		fi
		for killPid in $killPids ; do
			case "$killOwn" in *" $killPid "*) ;; *) harnessKillForeign="$killPid" ; set +f ; return 0 ;; esac
		done
	done <<< "$killText"
	set +f
	return 1
}

AgentsHarnessToolBashRun(){ ## cwd, command, timeout, detach, handle, stop, offset, limit, stdin, output mode
	local toolCwd="$1" toolCommand="$2" toolTimeout="$3" toolDetach="$4" toolHandle="$5" toolStop="$6" toolOffset="$7" toolLimit="$8" toolStdin="$9" toolOutputMode="${10}" toolStatus=0 toolBytes
	case "$toolOutputMode" in
		''|merged) toolOutputMode="" ;;
		prefixed) ;;
		*) printf 'ERROR: output_mode must be merged or prefixed, got: %s. Nothing was run.\n' "$toolOutputMode" ; return 0 ;;
	esac
	local processSession processDir processPid processStatus processTotal processCaps processWaited processOutBytes processErrBytes processCloseTmp processReportThread processReportNote processBegan processMine
	## A handle alone names a process this session started detached: read it, or stop it.
	if [ -n "$toolHandle" ] ; then
		case "$toolHandle" in
			process-*) ;;
			*) printf 'ERROR: handle must be one a detached Bash start returned, such as process-1, and this is not one: %s. Nothing was read or stopped.\n' "$toolHandle" ; return 0 ;;
		esac
		processSession="${harnessSessionId:-${MDAT_SPAWN_SESSION_ID:-${CLAUDE_CODE_SESSION_ID:-}}}"
		if [ -z "$processSession" ] ; then
			printf 'ERROR: this run belongs to no session, so there is no folder a detached process of it lives in. Nothing was read or stopped.\n' ; return 0
		fi
		if ! AgentsHarnessBareName "$processSession" ; then
			printf 'ERROR: the session id is no bare name, so it names no process folder. Nothing was read or stopped.\n' ; return 0
		fi
		processDir="$MMDAPP/.local/agents/sessions/$processSession/processes"
		if [ ! -f "$processDir/$toolHandle.out" ] && [ ! -f "$processDir/$toolHandle.err" ] ; then
			printf 'ERROR: no detached process named %s was started by this session, so there is no output to read. This is a handle naming nothing, never a process that wrote nothing.\n' "$toolHandle" ; return 0
		fi
		if [ -n "$toolOffset" ] && ! AgentsHarnessWholeNumber "$toolOffset" ; then
			printf 'ERROR: offset must be a whole number of bytes, got: %s\n' "$toolOffset" ; return 0
		fi
		if [ -n "$toolLimit" ] && { ! AgentsHarnessWholeNumber "$toolLimit" || [ "$toolLimit" -lt 1 ] ; } ; then
			printf 'ERROR: limit must be a whole number of bytes above zero, got: %s\n' "$toolLimit" ; return 0
		fi
		[ -n "$toolLimit" ] || toolLimit="$harnessReadCap"
		[ "$toolLimit" -le "$harnessReadCap" ] || toolLimit="$harnessReadCap"
		## No offset means the start, not the end: a detached process's output is read
		## from its first byte, and the windowed read names the offset to continue.
		[ -n "$toolOffset" ] || toolOffset=0
		if [ "$toolStop" = "true" ] || [ "$toolStop" = "1" ] || [ "$toolStop" = "yes" ] ; then
			processPid="" ; processBegan="" ; processMine=""
			read -r processPid < "$processDir/$toolHandle.pid" 2>/dev/null || processPid=""
			read -r processBegan < "$processDir/$toolHandle.began" 2>/dev/null || processBegan=""
			type AgentsToolsRegistryProcessesBegan > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.Registries.include" 2> /dev/null || :
			## Signalled only while the pid is still the process that began when the handle was started, read by the one reading a process is kept by: a process that
			## ended, and a number the system has since given to another, are not signalled, and the handle is closed all the same.
			## The whole GROUP is signalled, not the one pid: the command is the leader of a
			## process group of its own, so everything it started is in that group. Signalling
			## the pid alone reached the wrapper shell and left its children running, writing.
			## Every wait below is on the GROUP (`kill -0 -pgid`), never on the leader: TERM
			## takes the wrapper at once while a child that ignores TERM lives on, and a check
			## of the leader alone would then report the stop done with that child still writing.
			if [ -n "$processPid" ] && [ -n "$processBegan" ] && [ "$( printf '%s\n' "$processPid" | AgentsToolsRegistryProcessesBegan 2> /dev/null )" = "$processBegan" ] && processMine=1 && { kill -TERM -"$processPid" 2>/dev/null || kill -TERM "$processPid" 2>/dev/null || : ; } ; then
				processWaited=0
				while [ "$processWaited" -lt 20 ] && kill -0 -"$processPid" 2>/dev/null ; do
					sleep 0.1
					processWaited=$(( processWaited + 1 ))
				done
				## Whatever still stands in the group after the grace is killed outright: a
				## command that ignores TERM, or one of its children that does, dies all the same.
				if kill -0 -"$processPid" 2>/dev/null || kill -0 "$processPid" 2>/dev/null ; then
					kill -KILL -"$processPid" 2>/dev/null || kill -KILL "$processPid" 2>/dev/null || :
					processWaited=0
					while [ "$processWaited" -lt 10 ] && { kill -0 -"$processPid" 2>/dev/null || kill -0 "$processPid" 2>/dev/null ; } ; do
						sleep 0.1
						processWaited=$(( processWaited + 1 ))
					done
				fi
			fi
			## CLOSED WHERE IT STANDS: the byte counts are taken once nothing in the group can
			## write any more, and both readers stop there. A child that outlived the stop
			## therefore cannot add a line to a handle its reader has closed. A second stop
			## leaves the marker of the first alone: a close is taken once, where it stood.
			if [ ! -f "$processDir/$toolHandle.closed" ] ; then
				processOutBytes=0 ; processErrBytes=0
				[ ! -f "$processDir/$toolHandle.out" ] || processOutBytes="$( wc -c < "$processDir/$toolHandle.out" | tr -d ' ' )"
				[ ! -f "$processDir/$toolHandle.err" ] || processErrBytes="$( wc -c < "$processDir/$toolHandle.err" | tr -d ' ' )"
				processCloseTmp="$( mktemp "$processDir/$toolHandle.closed.XXXXXX" 2> /dev/null )" || processCloseTmp=""
				if [ -n "$processCloseTmp" ] && printf 'out %s\nerr %s\n' "$processOutBytes" "$processErrBytes" > "$processCloseTmp" ; then
					mv -f "$processCloseTmp" "$processDir/$toolHandle.closed" || rm -f "$processCloseTmp"
				else
					[ -z "$processCloseTmp" ] || rm -f "$processCloseTmp"
					printf 'out %s\nerr %s\n' "$processOutBytes" "$processErrBytes" > "$processDir/$toolHandle.closed"
				fi
			fi
			printf 'PROCESS-RESULT: CLOSED\nProcess handle: %s\nCommand: %s\nYou stopped it, so its output is closed where it stands: %s and %s\n' \
				"$toolHandle" "$( cat "$processDir/$toolHandle.cmd" 2>/dev/null )" "${processDir#"$MMDAPP"/}/$toolHandle.out" "${processDir#"$MMDAPP"/}/$toolHandle.err"
			[ -n "$processMine" ] || printf 'Nothing was signalled: its pid is no longer the process that was started under this handle, or no start was kept for it.\n'
			return 0
		fi
		processPid=""
		read -r processPid < "$processDir/$toolHandle.pid" 2>/dev/null || processPid=""
		if [ -f "$processDir/$toolHandle.closed" ] ; then
			printf 'PROCESS-RESULT: CLOSED\n'
		elif [ -n "$processPid" ] && kill -0 "$processPid" 2>/dev/null ; then
			printf 'PROCESS-RESULT: RUNNING\n'
		elif [ -f "$processDir/$toolHandle.status" ] ; then
			printf 'PROCESS-RESULT: FINISHED\n'
		else
			printf 'PROCESS-RESULT: UNKNOWN\n'
		fi
		printf 'Process handle: %s\nCommand: %s\n' "$toolHandle" "$( cat "$processDir/$toolHandle.cmd" 2>/dev/null )"
		if [ -f "$processDir/$toolHandle.closed" ] ; then
			printf 'This process was stopped by you, so its output is closed where it stands.\n'
		elif [ -f "$processDir/$toolHandle.status" ] ; then
			read -r processStatus < "$processDir/$toolHandle.status" 2>/dev/null || processStatus=0
			## A STATUS OF 128 OR MORE IS A SIGNAL DEATH, never a result the process chose (S6.47): 128+N is how a
			## shell records being ended by signal N, so the output stops where that signal caught it. Said as ended
			## by a signal, and never as complete, with the reason the handle carries said beside it.
			if [ "$processStatus" -ge 128 ] 2>/dev/null ; then
				printf 'This process was ENDED BY A SIGNAL (exit status %s), so its output stops where that signal caught it and may be incomplete.\n' "$processStatus"
				[ ! -s "$processDir/$toolHandle.ceiling" ] || printf 'The reason its handle carries: %s.\n' "$( cat "$processDir/$toolHandle.ceiling" 2>/dev/null )"
			else
				printf 'This process ENDED with exit status %s, so its output is complete.\n' "$processStatus"
			fi
		elif [ -n "$processPid" ] && kill -0 "$processPid" 2>/dev/null ; then
			printf 'This process is STILL RUNNING, so its output is still being written: what follows is what exists so far. Watch it with Wait sources=process:%s, which returns as its output grows.\n' "$toolHandle"
		else
			printf 'This process is no longer running and recorded NO exit status, so it was killed or died before it could write one.\n'
		fi
		processCaps="$( AgentsHarnessProcessClosedAt "$processDir" "$toolHandle" )"
		AgentsHarnessProcessRender "$processDir" "$toolHandle" "${processCaps%% *}" "${processCaps##* }" > "$harnessScratch/process.read" 2>/dev/null
		processTotal="$( wc -c < "$harnessScratch/process.read" | tr -d ' ' )"
		if [ "$processTotal" -eq 0 ] ; then
			printf 'The output is zero bytes: this process has written NOTHING YET.\n'
			return 0
		fi
		printf '\nEach line is prefixed with > for stdout and ! for stderr.\n'
		AgentsHarnessWindowedRead "$harnessScratch/process.read" "$toolOffset" "$toolLimit"
		return 0
	fi
	## No kill by pattern (epic S10.20): a run owns its own processes alone, and a `pkill`, a `killall`, a `kill` fed by
	## `pgrep`, `ps` or `xargs`, or a `kill` of every process (`-1`) ends whatever matches on the whole workstation,
	## on every rig at once. Refused before anything runs; a `kill <pid>` of a number this run knows is not a pattern.
	## Nor a kill of a pid number this run does not own (the part a pattern guard leaves): the run's own process set is read at
	## this call, only where the text signals a number. A signal 0 probe runs.
	if AgentsHarnessBashKillForeign "$toolCommand" ; then
		printf 'ERROR: the command signals pid %s, which is no process of this run; a run owns only the processes it started, read at this call. Stop a detached process by its handle (stop: true), or signal one pid this run started; a signal 0 probe runs. Nothing was run.\n' "$harnessKillForeign"
		return 0
	fi
	if AgentsHarnessBashKillByPattern "$toolCommand" ; then
		printf 'ERROR: the command kills by pattern (%s), which ends whatever matches on this machine, and this run owns only the processes it started: stop a detached process by its handle (stop: true), or signal one pid this run knows. Nothing was run.\n' "$harnessKillPattern"
		return 0
	fi
	## NO SCAN OF A WHOLE TREE (the hot-path rule): a recursive grep or a find over a workspace root, a store root or the source
	## tree as a whole is refused before anything runs. Name the one folder the task needs, or ask the tooling's own index.
	if AgentsHarnessBashScanWide "$toolCommand" "$toolCwd" ; then
		printf 'ERROR: the command scans a whole tree (%s), which costs every other call on this machine its pace for minutes: a workspace holds about 1300 folders and 900 projects. Name the one folder the task needs (a project folder, one session or store entry), read the registries the tooling keeps (--spawns, --tasks, the member index), or ask the owner of that store for a read operation. Nothing was started.\n' "$harnessScanWide"
		return 0
	fi
	## THE STALE TREE IS NEVER READ OR WRITTEN (AgentsHarnessStaleTree, AgentsHarnessAccess.include), where the workspace does not run
	## from `.local`. An ABSOLUTE path of this workspace's `.local/myx/` is run on the tree the workspace does run from,
	## `$MDLT_ORIGIN/myx/`, the same path below it, and a line says so: the member learnt it from a link of the stale copy, so the
	## tooling sends it where it meant to go rather than refusing it (31 refused calls on 2026-11-10). A path is a path, so the rewrite
	## is the absolute form alone: every text holding `.local/myx/` also holds another workspace's path, a comment, or a spelling that
	## only looks relative, and rewriting those invents paths that exist nowhere. A RELATIVE `.local/myx/` is refused where the call runs
	## from the workspace root, the one folder where it resolves into the stale copy, and is left alone from any other folder, where it
	## names something else entirely.
	if [ -n "${MMDAPP:-}" ] && [ -n "${MDLT_ORIGIN:-}" ] && [ "${MDLT_ORIGIN%/}" != "${MMDAPP%/}/.local" ] ; then
		case "$toolCommand" in
			*"${MMDAPP%/}/.local/myx/"*)
				local staleFrom="${MMDAPP%/}/.local/myx/" staleTo="${MDLT_ORIGIN%/}/myx/"
				toolCommand="${toolCommand//"$staleFrom"/$staleTo}"
				printf '# the command named %s/.local/myx, a stale copy of the tooling: it runs on %s/myx, the tree this workspace runs from.\n' "${MMDAPP%/}" "${MDLT_ORIGIN%/}"
			;;
			*'.local/myx/'*)
				## Both sides are resolved before they are compared, as the gate resolves them: a trailing
				## or doubled slash, or a symlinked spelling of the root, names the same folder.
				local staleCwd="${toolCwd:-.}" staleRoot="${MMDAPP%/}"
				staleCwd="$( cd "$staleCwd" 2> /dev/null && pwd -P )" || staleCwd=""
				staleRoot="$( cd "$staleRoot" 2> /dev/null && pwd -P )" || staleRoot="${MMDAPP%/}"
				case "$staleCwd" in
					"$staleRoot")
						## A word that begins with the path is a relative path; the same text inside a longer
						## word is another folder's absolute path, and is left alone.
						local staleWord
						for staleWord in $toolCommand ; do
							case "$staleWord" in
								\"*|\'*) staleWord="${staleWord#?}" ;;
							esac
							case "$staleWord" in
								.local/myx/*|./.local/myx/*)
									printf 'ERROR: the command names .local/myx relative to the workspace root %s, where it resolves into a stale copy of the tooling this workspace does not run from (MDLT_ORIGIN is %s): name the path in full instead. Nothing was run.\n' "${MMDAPP%/}" "${MDLT_ORIGIN:-unset}"
									return 0
								;;
							esac
						done
					;;
				esac
			;;
		esac
	fi
	## A tooling command resolves by its name here as in the console and in execute (epic S12.25): the one path include, read once per
	## harness process, puts the family's sh-scripts after the path it was handed. Seven folder tests, no subprocess.
	case ":$PATH:" in *":$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts:"*) ;; *) . "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/console-.local-path.include" 2> /dev/null || : ;; esac
	## No command links a sandbox into source (epic S23.11): the guard ln is first on PATH, for the command and for what it starts.
	## And no shell `grep -r` blocks on a request fifo (epic S10.26): the guard grep beside it puts `-D skip` before the arguments.
	case ":$PATH:" in *":$MMDAPP/.local/agents/guard-bin:"*) ;; *) . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SandboxLinks.include" && AgentsToolsLnGuardMake "$MMDAPP/.local/agents/guard-bin" && AgentsToolsGrepGuardMake "$MMDAPP/.local/agents/guard-bin" && PATH="$MMDAPP/.local/agents/guard-bin:$PATH" ;; esac
	if [ "$toolDetach" = "true" ] || [ "$toolDetach" = "1" ] || [ "$toolDetach" = "yes" ] ; then
		if ! AgentsHarnessCwdAllowed "$toolCwd" ; then return 0 ; fi
		toolCwd="$harnessResolvedPath"
		if [ ! -d "$toolCwd" ] ; then
			printf 'ERROR: no such directory: %s. Nothing was started.\n' "$toolCwd" ; return 0
		fi
		processSession="${harnessSessionId:-${MDAT_SPAWN_SESSION_ID:-${CLAUDE_CODE_SESSION_ID:-}}}"
		if [ -z "$processSession" ] ; then
			printf 'ERROR: this run belongs to no session, so it has no folder to own a detached process in. Nothing was started.\n' ; return 0
		fi
		if ! AgentsHarnessBareName "$processSession" ; then
			printf 'ERROR: the session id is no bare name, so it names no process folder. Nothing was started.\n' ; return 0
		fi
		processDir="$MMDAPP/.local/agents/sessions/$processSession/processes"
		if ! mkdir -p "$processDir" ; then
			printf 'ERROR: could not create the process folder under the session folder, so no process could be owned there. Nothing was started.\n' ; return 0
		fi
		if ! toolHandle="$( AgentsHarnessProcessClaimHandle "$processDir" )" || [ -z "$toolHandle" ] ; then
			printf 'ERROR: no free handle could be claimed in the session process folder, so no process could be owned there. Nothing was started.\n' ; return 0
		fi
		printf '%s' "$toolCommand" > "$processDir/$toolHandle.cmd"
		rm -f "$processDir/$toolHandle.in"
		[ -z "$toolStdin" ] || printf '%s' "$toolStdin" > "$processDir/$toolHandle.in"
		: > "$processDir/$toolHandle.out"
		: > "$processDir/$toolHandle.err"
		rm -f "$processDir/$toolHandle.status" "$processDir/$toolHandle.closed"
		## The command runs detached, its stdout and stderr to two files in the session
		## folder, its status written by the wrapper that owns it -- nothing else can read
		## it, and a `wait` here would block for the job's whole life. The wrapper's own
		## streams go to /dev/null so this call's capture pipe closes at once. Its stdin
		## is the caller's when one was given, /dev/null otherwise -- a detached process
		## is never left reading the harness's own stdin.
		## The wrapper is started under job control, `set -m` and then a `disown`, so it is the
		## leader of a PROCESS GROUP OF ITS OWN and the command it runs, with everything that
		## command starts, is in that group: a stop can signal the group, and the children die
		## with it. (Signalling the one pid killed the wrapper and left its children writing.)
		## The wrapper is disowned so bash never reports its going on this call's own streams.
		set -m
		( set +m
		  processStatus=0
		  if [ -n "$toolStdin" ] ; then
			( cd "$toolCwd" && set -e && eval "$toolCommand" ) < "$processDir/$toolHandle.in" > "$processDir/$toolHandle.out" 2> "$processDir/$toolHandle.err" &
		  else
			( cd "$toolCwd" && set -e && eval "$toolCommand" ) < /dev/null > "$processDir/$toolHandle.out" 2> "$processDir/$toolHandle.err" &
		  fi
		  processInner=$!
		  wait "$processInner" || processStatus=$?
		  printf '%s\n' "$processStatus" > "$processDir/$toolHandle.status"
		) > /dev/null 2>&1 < /dev/null &
		processPid=$!
		set +m
		disown "$processPid" 2> /dev/null || :
		## When the process began is kept beside its pid, written first, so a stop signals the pid only while it is still the process that began then.
		type AgentsToolsRegistryProcessesBegan > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.Registries.include" 2> /dev/null || :
		printf '%s\n' "$processPid" | AgentsToolsRegistryProcessesBegan 2> /dev/null > "$processDir/$toolHandle.began" || :
		printf '%s\n' "$processPid" > "$processDir/$toolHandle.pid"
		## The reporter posts this process's progress and end into the session thread (S3.1), or says now that it cannot.
		processReportThread="$( AgentsHarnessSessionThread "$harnessCurrentName" 2> /dev/null )" || processReportThread=""
		processReportThread="${processReportThread%% *}"
		rm -f "$processDir/$toolHandle.report" "$processDir/$toolHandle.report.prose"
		if [ -n "$processReportThread" ] ; then
			( AgentsHarnessProcessReporter "$processDir" "$toolHandle" "$processPid" "$processReportThread" "$( AgentsHarnessCallerMember 2> /dev/null )" ) > /dev/null 2>&1 < /dev/null &
			disown "$!" 2> /dev/null || :
			processReportNote="Its progress and its end are posted as notices into the session's event-track thread."
		else
			processReportNote="This session has no session thread, so no progress will be posted; watch the process with Wait."
		fi
		printf 'PROCESS-RESULT: RUNNING\nProcess handle: %s\nCommand: %s\nIn: %s\nOutput: %s and %s\nThe process is detached and owned by this session: its stdout and stderr are written live to those two files, one line per line of output, prefixed with > for stdout and ! for stderr when read. Watch it with Wait sources=process:%s, which returns as its output grows and once more when the process ends, and call Wait again whenever its result says to. Stop it with Bash stop=true handle=%s. %s\n' \
			"$toolHandle" "$toolCommand" "$toolCwd" "${processDir#"$MMDAPP"/}/$toolHandle.out" "${processDir#"$MMDAPP"/}/$toolHandle.err" "$toolHandle" "$toolHandle" "$processReportNote"
		return 0
	fi
	if ! AgentsHarnessCwdAllowed "$toolCwd" ; then return 0 ; fi
	toolCwd="$harnessResolvedPath"
	if [ ! -d "$toolCwd" ] ; then
		printf 'ERROR: no such directory: %s\n' "$toolCwd" ; return 0
	fi
	## Per-call override of the harness-wide bound, validated the way that bound is.
	if [ -n "$toolTimeout" ] ; then
		if ! AgentsHarnessWholeNumber "$toolTimeout" ; then
			printf 'ERROR: timeout must be a whole number of seconds, got: %s\n' "$toolTimeout" ; return 0
		fi
	else
		toolTimeout="$harnessRunTimeout"
	fi
	## The command always reaches bash as an argument, never spliced into a quoted string.
	## Its stdin is the caller's when one was given, /dev/null otherwise -- the tooling
	## decides it, so a command is never left reading the harness's own stdin.
	rm -f "$harnessScratch/run.timedout"
	: > "$harnessScratch/run.stdin"
	: > "$harnessScratch/run.err"
	[ -z "$toolStdin" ] || printf '%s' "$toolStdin" > "$harnessScratch/run.stdin"
	if [ "$toolTimeout" = 0 ] ; then
		( AgentsHarnessToolStreams "$harnessScratch/run.stdin" "$harnessScratch/run.out" "$harnessScratch/run.err" "$toolOutputMode" ; cd "$toolCwd" && set -e && eval "$toolCommand" ) || toolStatus=$?
	elif [ -n "$harnessTimeoutCmd" ] ; then
		( AgentsHarnessToolStreams "$harnessScratch/run.stdin" "$harnessScratch/run.out" "$harnessScratch/run.err" "$toolOutputMode" ; exec "$harnessTimeoutCmd" "$toolTimeout" bash -c 'cd "$1" && set -e && eval "$2"' _ "$toolCwd" "$toolCommand" ) || toolStatus=$?
		[ "$toolStatus" != 124 ] || : > "$harnessScratch/run.timedout"
	else
		## Watchdog where no `timeout` exists; a group, not a subshell, so $toolStatus survives.
		{
			## The subshell execs the command, so the pid kept below is the command's own and a stop reaches it.
			( AgentsHarnessToolStreams "$harnessScratch/run.stdin" "$harnessScratch/run.out" "$harnessScratch/run.err" "$toolOutputMode" ; exec bash -c 'cd "$1" && set -e && eval "$2"' _ "$toolCwd" "$toolCommand" ) &
			harnessRunPid=$!
			printf '%s\n' "$harnessRunPid" > "$harnessScratch/run.pid"
			## The >/dev/null is load-bearing: without it the orphaned `sleep` holds this
			## function's capture pipe open and every Bash call blocks for the full bound.
			## The watchdog ends the command it was started for and no other process: at the
			## bound the pid alone may name whoever was given that number since. So it keeps
			## when the command began, read as the watchdog starts, and signals only while that
			## pid is still the process that began then (AgentsToolsRegistryProcessesBegan, the
			## one reading a process is kept by, loaded in the watchdog's own shell). Where no
			## start can be read, nothing is signalled by the number alone.
			(
				type AgentsToolsRegistryProcessesBegan > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.Registries.include" 2> /dev/null
				harnessRunBegan="$( printf '%s\n' "$harnessRunPid" | AgentsToolsRegistryProcessesBegan 2> /dev/null )"
				## The sleep is a child of this watchdog: the TERM that ends the watchdog once the call
				## returned must end the sleep too, else one `sleep <timeout>` outlives every call under launchd.
				## The trap ends every background child of this watchdog, by the job list, not by a pid kept in a variable: a TERM that
				## lands between the sleep's fork and the assignment of its pid left one `sleep <timeout>` under launchd a call (the
				## restart check counted three such sleeps after its run).
				watchSleep="" ; trap 'kill $( jobs -p ) 2>/dev/null ; exit 0' TERM
				sleep "$toolTimeout" & watchSleep=$!
				wait "$watchSleep" || exit 0
				watchSleep=""
				[ -n "$harnessRunBegan" ] && [ "$( printf '%s\n' "$harnessRunPid" | AgentsToolsRegistryProcessesBegan 2> /dev/null )" = "$harnessRunBegan" ] && kill -TERM "$harnessRunPid" 2>/dev/null && : > "$harnessScratch/run.timedout"
			) >/dev/null &
			harnessWatchPid=$!
			printf '%s\n' "$harnessWatchPid" > "$harnessScratch/watch.pid"
			## The child's own run is not machinery time (the owner's pace ruling): its span is kept for the call's record (mach_ms).
			harnessRunT0="$( AgentsTranscriptNowMs 2> /dev/null )" || harnessRunT0=""
			wait "$harnessRunPid" || toolStatus=$?
			case "$harnessRunT0" in ''|*[!0-9]*) ;; *) harnessToolRunMs=$(( $( AgentsTranscriptNowMs 2> /dev/null || printf 0 ) - harnessRunT0 )) ; [ "$harnessToolRunMs" -ge 0 ] || harnessToolRunMs=0 ;; esac
			kill -TERM "$harnessWatchPid" 2>/dev/null || :
			wait "$harnessWatchPid" 2>/dev/null || :
			## Reaped normally: the records exist so the cleanup can reach a child the
			## run never got to wait on, not to re-signal one already gone.
			rm -f "$harnessScratch/run.pid" "$harnessScratch/watch.pid"
		} 2>/dev/null
	fi
	## The whole output is returned, however long: the reply layer keeps a long result in
	## the session's results/ folder (F2.4), so nothing a long-running command wrote is
	## lost to a byte cap here. A prefixed call renders its two streams apart, exactly as a
	## detached read does: stdout's lines first, then stderr's, each marked.
	if [ -n "$toolOutputMode" ] ; then
		AgentsHarnessProcessRender "$harnessScratch" run "" ""
	else
		cat "$harnessScratch/run.out"
	fi
	## Expiry is read from the flag the enforcing path wrote, never inferred from the status.
	[ ! -f "$harnessScratch/run.timedout" ] || printf '... TIMED OUT after %s seconds ...\n' "$toolTimeout"
	printf '(exit status %s)\n' "$toolStatus"
}
## A COMMAND THAT ONLY READS: rc 0 where every part of it (after a leading `cd <dir> &&` or `;`) begins with a read -- ls, cat, head,
## tail, sed -n, grep, rg, find, wc, echo, printf, stat, file, pwd -- and every pipe feeds only head, tail, wc, sort, uniq, cut, tr,
## column or nl, with no redirect, no loop, no substitution and no find action that changes anything. Anything else is no pure read.
AgentsHarnessBashReadOnly(){ ## command
	printf '%s' "$1" | LC_ALL=C awk '
		BEGIN { split( "ls cat head tail grep rg find wc echo printf stat file pwd", r, " " ) ; for ( i in r ) reads[r[i]] = 1
		        split( "head tail wc sort uniq cut tr column nl grep", f, " " ) ; for ( i in f ) feeds[f[i]] = 1 }
		{ all = all $0 "\n" }
		END {
			if ( all ~ /[<>]|\$\(|`|(^|[ ;&|])(for|while|until|if|case|function)[ ;]|-delete|-exec|-execdir|sed -i|xargs/ ) exit 1
			n = split( all, parts, /;|&&|\|\||\n/ ) ; seen = 0
			for ( p = 1 ; p <= n ; p++ ) {
				part = parts[p] ; gsub( /^[ \t]+|[ \t]+$/, "", part ) ; if ( part == "" ) continue
				m = split( part, pipes, /\|/ )
				for ( q = 1 ; q <= m ; q++ ) {
					seg = pipes[q] ; gsub( /^[ \t]+/, "", seg ) ; split( seg, w, /[ \t]+/ )
					if ( q == 1 && w[1] == "cd" && m == 1 ) continue
					if ( q == 1 ) { if ( w[1] == "sed" ) { if ( w[2] != "-n" ) exit 1 } else if ( !( w[1] in reads ) ) exit 1 }
					else if ( !( w[1] in feeds ) ) exit 1
					seen = 1
				}
			}
			exit seen ? 0 : 1
		}'
}

AgentsHarnessToolBash(){ ## cwd, command, timeout, detach, handle, stop, offset, limit, stdin, output mode
	## ONE READ IS NO ROUND OF ITS OWN (BatchTools, F7.8): a lone Bash call that only reads re-sends the whole context to learn a few
	## lines. It is answered with the batched form instead of run; inside a BatchTools call it runs, as a batch's reads are the point.
	## A detached, handled or stopped call is never this case.
	if [ -z "${MDAT_REPLY_IN_BATCH:-}" ] && [ -z "${4:-}${5:-}${6:-}" ] && [ -n "${2:-}" ] && AgentsHarnessBashReadOnly "$2" && { type AgentsToolsEmergencyHolds > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/common/AgentsTools.Emergency.include" 2> /dev/null ; } && ! AgentsToolsEmergencyHolds ; then
		printf '%s\n' "NOT RUN: this command only reads, and a read is no round of its own: each round re-sends your whole context. Put every read you need now into ONE BatchTools call -- Read for a file or its lines (offset, limit), Grep for a pattern, Glob for names, or Bash entries for shell reads -- and read the results together. For example: BatchTools calls=[{tool: Read, arguments: {file_path: <a>}}, {tool: Grep, arguments: {pattern: <p>, path: <dir>}}, {tool: Bash, arguments: {command: \"ls <dir>\"}}]. A command that changes something runs here as before."
		return 0
	fi
	## S19.2: a command is held at its EXIT, so it ran and its result waits for the pause to end.
	local pauseRc=0
	AgentsHarnessToolBashRun "$@" || pauseRc=$?
	AgentsToolsSessionPauseWait
	return "$pauseRc"
}

AgentsHarnessToolWorkspaceContextExecuteRun(){ ## command, workspace, timeout
	local toolCommand="$1" toolWorkspace="$2" toolTimeout="$3" toolStatus=0 toolBytes
	local toolTools="$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
	local toolArgs=( "$BASH" "$toolTools" --intern-mcp-execute )
	[ -n "$toolCommand" ] || { printf 'ERROR: command is required: the shell script to run with the myx.distro workspace context already established. Nothing was run.\n' ; return 0 ; }
	if [ ! -x "$toolTools" ] ; then
		printf 'ERROR: the team tooling is not present at the origin this workspace resolves, %s. Nothing was run.\n' "$toolTools" ; return 0
	fi
	if [ -n "$toolWorkspace" ] ; then
		case "$toolWorkspace" in /*) ;; *) printf 'ERROR: workspace must be an absolute path: %s. Nothing was run.\n' "$toolWorkspace" ; return 0 ;; esac
		toolArgs+=( --workspace "$toolWorkspace" )
	fi
	if [ -n "$toolTimeout" ] ; then
		if ! AgentsHarnessWholeNumber "$toolTimeout" ; then
			printf 'ERROR: timeout must be a whole number of seconds, got: %s. Nothing was run.\n' "$toolTimeout" ; return 0
		fi
	else
		toolTimeout="$harnessRunTimeout"
	fi
	rm -f "$harnessScratch/run.timedout"
	## The script runs in a fresh tooling process, as the MCP execute runs it: the process
	## establishes the workspace context (Distro, Require, Action). Output to a file and wait
	## on the pid, never a capture: the script may leave a background child behind.
	if [ "$toolTimeout" = 0 ] ; then
		printf '%s' "$toolCommand" | ${toolArgs[@]+"${toolArgs[@]}"} > "$harnessScratch/run.out" 2>&1 || toolStatus=$?
	else
		{
			set -m
			( printf '%s' "$toolCommand" | ${toolArgs[@]+"${toolArgs[@]}"} ) > "$harnessScratch/run.out" 2>&1 &
			harnessRunPid=$!
			printf '%s\n' "$harnessRunPid" > "$harnessScratch/run.pid"
			## The watchdog ends the group the call leads, as the MCP execute ends its own: the
			## script runs in a subshell of the tooling process, so a bare pid leaves it running.
			(
				type AgentsToolsRegistryProcessesBegan > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.Registries.include" 2> /dev/null
				harnessRunBegan="$( printf '%s\n' "$harnessRunPid" | AgentsToolsRegistryProcessesBegan 2> /dev/null )"
				## The sleep is a child of this watchdog: the TERM that ends the watchdog once the call
				## returned must end the sleep too, else one `sleep <timeout>` outlives every call under launchd.
				## The trap ends every background child by the job list, as above: no sleep outlives the call.
				watchSleep="" ; trap 'kill $( jobs -p ) 2>/dev/null ; exit 0' TERM
				sleep "$toolTimeout" & watchSleep=$!
				wait "$watchSleep" || exit 0
				watchSleep=""
				[ -n "$harnessRunBegan" ] && [ "$( printf '%s\n' "$harnessRunPid" | AgentsToolsRegistryProcessesBegan 2> /dev/null )" = "$harnessRunBegan" ] && kill -TERM -- "-$harnessRunPid" 2>/dev/null && : > "$harnessScratch/run.timedout"
			) >/dev/null &
			harnessWatchPid=$!
			printf '%s\n' "$harnessWatchPid" > "$harnessScratch/watch.pid"
			## The child's own run is not machinery time (the owner's pace ruling): its span is kept for the call's record (mach_ms).
			harnessRunT0="$( AgentsTranscriptNowMs 2> /dev/null )" || harnessRunT0=""
			wait "$harnessRunPid" || toolStatus=$?
			case "$harnessRunT0" in ''|*[!0-9]*) ;; *) harnessToolRunMs=$(( $( AgentsTranscriptNowMs 2> /dev/null || printf 0 ) - harnessRunT0 )) ; [ "$harnessToolRunMs" -ge 0 ] || harnessToolRunMs=0 ;; esac
			kill -TERM "$harnessWatchPid" 2>/dev/null || :
			wait "$harnessWatchPid" 2>/dev/null || :
			rm -f "$harnessScratch/run.pid" "$harnessScratch/watch.pid"
		} 2>/dev/null
		set +m
	fi
	## The whole output is returned, however long: the reply layer keeps a long result in
	## the session's results/ folder (F2.4), so nothing a long-running script wrote is
	## lost to a byte cap here.
	cat "$harnessScratch/run.out"
	[ ! -f "$harnessScratch/run.timedout" ] || printf '... TIMED OUT after %s seconds ...\n' "$toolTimeout"
	printf '(exit status %s)\n' "$toolStatus"
}
AgentsHarnessToolWorkspaceContextExecute(){ ## command, workspace, timeout
	## S19.2: a workspace command is held at its EXIT, so it ran and its result waits for the pause to end. The start-check that
	## refuses instead is `execute`'s own, in the tooling (--intern-mcp-execute), and not this tool's.
	local pauseRc=0
	AgentsHarnessToolWorkspaceContextExecuteRun "$@" || pauseRc=$?
	AgentsToolsSessionPauseWait
	return "$pauseRc"
}
