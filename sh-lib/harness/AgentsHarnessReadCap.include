#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsHarnessReadCap.include -- the byte cap of the harness's Read and Skill, stated
## once. Two values, because the two ways a result is served differ in what they carry:
## a model the harness itself hosts takes the larger, and an MCP client, whose own
## result limit is lower, the smaller. Sourced by the harness, which applies the cap, and
## by every place that renders the tool declarations, which substitute it for the
## {{READ_CAP_BYTES}} placeholder at the render, so the stated number is the applied one.
##

agentsReadCapWire=200000
## The MCP client's own limit is in tokens, MAX_MCP_OUTPUT_TOKENS (25000 by default in the native client). A result
## over it is saved to a file and the client tells the model to Read that file, so the cap stays under it: three bytes
## a token, a margin for text that takes more tokens a byte. Under the cap, Skill and Read cut the result themselves
## and name the offset to call again with.
agentsReadCapMcp=$(( ${MAX_MCP_OUTPUT_TOKENS:-25000} * 3 ))
