#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

## AgentsHarnessBatch.include: BatchTools and the CheckList tool. Sourced by AgentsUniversalHarness.sh, definitions only.

## CheckList: the checklist of session tasks of a member in a session, kept as the native
## TodoWrite keeps its list -- a call with todos replaces the caller's whole list -- and read by a
## call with none: the caller's own list, or with member that participant's, or with `*` every
## participant's. One member, one list in a session, however many runs it has there:
## <member>.checklist.md, Markdown, one line an item, `- [x]` done, `- [~]` in progress, `- [ ]` not
## yet, an open item that carries one ending ` (due: <date-time>)`, and the item in progress followed
## by its activeForm. A `- [ ]` line ending with one is the in-progress shape before the mark, and
## reads as in progress for good. The due mark stands before the in-progress one, so a close that
## drops that suffix keeps the due time. Kept in the session's place (AgentsHarnessCheckListPlace).
## An item's source (S6.27) is `step` for a step of the routine in force, `parent` for an item a
## parent added and `own` for the member's own. It is kept beside the list and never in its line,
## so every reader of a list above reads the list as it always did.
## A participant writes its own list alone. Checked whole first, so a list with one bad item is
## refused and the list kept before stays as it was; written to a temp file mktemp names beside
## it and put in place by one rename, so no reader sees half a list.
## BatchTools: several calls in one, by the one engine (AgentsTools.BatchTools.include). Each call is a served
## call of its own, with this run's root flags, session and member, so it runs as it would alone: through the
## hooks and the reply layer of a served call, and in the model loop through the arm gate first.
AgentsHarnessToolBatchTools(){ ## raw arguments
	. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsTools.BatchTools.include" || { printf 'ERROR: BatchTools: its engine is missing from this package -- nothing was run.\n' ; return 0 ; }
	AgentsToolsBatchRun AgentsHarnessBatchCall AgentsHarnessBatchServes "$1"
}

## A tool this harness serves: one it declares, or an MCP server's own.
AgentsHarnessBatchServes(){ ## tool name
	case "$1" in
		mcp__?*__?*) return 0 ;;
	esac
	LC_ALL=C grep -q -F -- "{\"type\":\"function\",\"function\":{\"name\":\"$1\"," "$harnessWireFile"
}

## One call of a batch, made as the call alone would be: the arm gate first, in the model loop, then a served call.
AgentsHarnessBatchCall(){ ## tool name, arguments file, call number
	local callGate
	callGate="$( AgentsHarnessArmGate "$1" )"
	[ -z "$callGate" ] || { printf '%s\n' "$callGate" ; return 1 ; }
	MDAT_SPAWN_AGENT="${MDAT_SPAWN_AGENT:-$harnessAgent}" "$BASH" "$harnessHere/harness/AgentsUniversalHarness.sh" --intern-tool "$1" \
		${harnessSessionId:+--session-id "$harnessSessionId"} ${harnessRootFlags[@]+"${harnessRootFlags[@]}"} < "$2"
}

AgentsHarnessToolCheckList(){ ## raw arguments
	if [ -n "$harnessPlaceOnly" ] ; then
		## --intern-checklist-place: where the list would go, or why it has no place; the native
		## TodoWrite hook reads it, and CheckList itself stays listed wherever this refuses.
		if AgentsHarnessCheckListPlace ; then
			printf 'CHECKLIST-PLACE: %s\n' "$checkListFolder"
		else
			printf 'ERROR: %s\n' "$checkListWhy"
		fi
		return 0
	fi
	local todoCount todoIndex=0 todoField todoWhere todoPending=0 todoActive=0 todoDone=0 todoFile todoText="" todoLine todoContent todoPathNo=0 todoTmp="" todoAdded=0
	local todoDue="" todoDueEpoch="" todoDueRead="" 
	AgentsHarnessArgParse "$1"
	## No pre-requisites, no tool: a session whose member or place the harness does not know has none.
	if ! AgentsHarnessCheckListPlace ; then
		printf 'ERROR: %s Nothing was written.\n' "$checkListWhy" ; return 0
	fi
	## Items added to a list by another session (S23.2).
	if AgentsHarnessArgFind append.__count ; then
		AgentsHarnessCheckListAppend
		return 0
	fi
	if ! AgentsHarnessArgFind todos.__count ; then
		## A value that is there and is no list is told apart from no value at all, which reads.
		while [ "$todoPathNo" -lt "${#harnessArgPaths[@]}" ] ; do
			case "${harnessArgPaths[$todoPathNo]}" in
				todos|todos.*) printf 'ERROR: todos must be an array of items, each an object with content, status and activeForm. Nothing was written.\n' ; return 0 ;;
			esac
			todoPathNo=$(( todoPathNo + 1 ))
		done
		## Arguments that parsed to nothing are a read only where they are an empty object.
		if [ "${#harnessArgPaths[@]}" -eq 0 ] ; then
			case "$1" in
				*[!{}$' \t\r\n']*) printf 'ERROR: the arguments are no JSON object: give todos to write your own list, or no todos to read a list. Nothing was written.\n' ; return 0 ;;
			esac
		fi
		AgentsHarnessCheckListRead "${harnessArgV_member:-}"
		return 0
	fi
	if [ -n "${harnessArgV_member:-}" ] ; then
		printf 'ERROR: member reads a list and takes no todos, and you write only your own list: give todos, or member, not both. Nothing was written.\n' ; return 0
	fi
	todoCount="$harnessArgFound"
	case "$todoCount" in ''|*[!0123456789]*) printf 'ERROR: todos could not be read as a list. Nothing was written.\n' ; return 0 ;; esac
	while [ "$todoIndex" -lt "$todoCount" ] ; do
		todoWhere="todos item $(( todoIndex + 1 )) of $todoCount"
		for todoField in content status activeForm ; do
			if ! AgentsHarnessArgFind "todos.$todoIndex.$todoField" || [ -z "$harnessArgFound" ] ; then
				printf 'ERROR: %s: %s is required and must not be empty -- each item is an object with content, status and activeForm. Nothing was written.\n' "$todoWhere" "$todoField" ; return 0
			fi
		done
		AgentsHarnessArgFind "todos.$todoIndex.content" || :
		## A CONTENT THAT ECHOES A READ IS THE ITEM IT READ (S6.27): a member writing its own list back repeats
		## the read's ` [step]` or ` [parent]` suffix, and that suffix is the read's, never the item's text.
		todoContent="${harnessArgFound% \[step\]}"
		todoContent="${todoContent% \[parent\]}"
		## A due time (S13.9) is optional, and it is a moment the one reader of a moment reads: anything it
		## cannot read is refused here, so a list never carries a due mark nothing can compare.
		todoDue=""
		todoDueRead=""
		AgentsHarnessArgFind "todos.$todoIndex.due" || :
		todoDueRead="$harnessArgFound"
		if [ -n "$todoDueRead" ] ; then
			todoDueEpoch="$( printf '%s\n' "$todoDueRead" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/output/LocalIsoToEpoch.awk" 2> /dev/null )" || todoDueEpoch=""
			if [ -z "$todoDueEpoch" ] ; then
				printf 'ERROR: %s: due must be a date-time this tooling can read, such as "2026-11-04 18:00 +0200", got: %s. Nothing was written.\n' "$todoWhere" "$( AgentsHarnessTruncateArg "$todoDueRead" )" ; return 0
			fi
			todoDue=" (due: $todoDueRead)"
		fi
		AgentsHarnessArgFind "todos.$todoIndex.status" || :
		case "$harnessArgFound" in
			pending) todoPending=$(( todoPending + 1 )) ; todoLine="- [ ] $todoContent$todoDue" ;;
			in_progress)
				todoActive=$(( todoActive + 1 ))
				AgentsHarnessArgFind "todos.$todoIndex.activeForm" || :
				todoLine="- [~] $todoContent$todoDue (in progress: $harnessArgFound)"
			;;
			completed) todoDone=$(( todoDone + 1 )) ; todoLine="- [x] $todoContent" ;;
			*) printf 'ERROR: %s: status must be pending, in_progress or completed, got: %s. Nothing was written.\n' "$todoWhere" "$( AgentsHarnessTruncateArg "$harnessArgFound" )" ; return 0 ;;
		esac
		## One line an item: a line break or a tab inside a text is a space.
		todoText="$todoText${todoLine//[$'\n\r\t']/ }"$'\n'
		todoIndex=$(( todoIndex + 1 ))
	done
	todoFile="$checkListFolder/$checkListMember.checklist.md"
	## What another session added since this member last read or wrote its list (<member>.checklist.md.added) is kept whatever list is given: a whole-list write never drops an item it was not shown.
	mkdir -p "$checkListFolder" 2>/dev/null || :
	AgentsHarnessCheckListLock "$todoFile" || { printf 'ERROR: the checklist of %s in session %s is being written by another call and could not be taken in five seconds. Nothing was written.\n' "$checkListMember" "$checkListSession" ; return 0 ; }
	if [ -s "$todoFile.added" ] ; then
		while IFS= read -r todoLine || [ -n "$todoLine" ] ; do
			case "$todoText" in
				*"${todoLine#- \[ \] }"*) ;;
				*) todoText="$todoText$todoLine"$'\n' ; todoPending=$(( todoPending + 1 )) ; todoCount=$(( todoCount + 1 )) ; todoAdded=$(( todoAdded + 1 )) ;;
			esac
		done < "$todoFile.added"
	fi
	if ! { todoTmp="$( mktemp "$todoFile.XXXXXX" 2>/dev/null )" \
		&& printf '%s' "$todoText" > "$todoTmp" 2>/dev/null && mv -f "$todoTmp" "$todoFile" 2>/dev/null ; } ; then
		[ -z "$todoTmp" ] || rm -f "$todoTmp" 2>/dev/null || :
		AgentsHarnessCheckListUnlock "$todoFile"
		printf 'ERROR: the checklist of %s in session %s could not be written. Nothing was written.\n' "$checkListMember" "$checkListSession" ; return 0
	fi
	rm -f "$todoFile.added" 2>/dev/null || :
	## THE MEMBER'S OWN WRITE MARKS WHAT IT WROTE (S6.27): an item of its new list that no mark names is `own`. The
	## seed and a parent's add mark their own items, so a step and a parent's item keep what they were given.
	type AgentsToolsCheckListSourcesMark > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.CheckListSources.include" 2>/dev/null || :
	AgentsToolsCheckListSourcesMark "$todoFile" "" "" 2>/dev/null || :
	AgentsHarnessCheckListUnlock "$todoFile"
	## The result names the member and the session it belongs to and gives no path: where the list is kept is the tooling's business, and
	## a path in the result is one a member reads as something it may touch (the checklist is the tool's, written here, never edited there).
	printf 'OK: the checklist of %s in session %s now holds %s item(s): %s pending, %s in progress, %s completed.%s\n' \
		"$checkListMember" "$checkListSession" "$todoCount" "$todoPending" "$todoActive" "$todoDone" "$( [ "$todoAdded" -eq 0 ] || printf ' %s item(s) another session had added to it were kept, as pending.' "$todoAdded" )"
}

AgentsHarnessCheckListPlace(){
	local placeRecord=""
	checkListMember="" checkListSession="" checkListFolder="" checkListWhy=""
	if [ -z "$harnessAgent" ] ; then
		checkListWhy='this session has no team identity, so its checklist has no place to be kept: set MDAT_SKILLSET_ROOT to the team skillset in the server environment so the served member resolves.' ; return 1
	fi
	if [ -z "${MMDAPP:-}" ] ; then
		checkListWhy='MMDAPP is not set in this process, so no checklist has a place: run this call from a set-up myx.distro workspace.' ; return 1
	fi
	checkListSession="${MDAT_SESSION_ID:-}"
	if [ -z "$checkListSession" ] && [ -n "${MDAT_SPAWN_SESSION_ID:-}" ] ; then
		placeRecord="$( AgentsHarnessSpawnRecordPath "$MDAT_SPAWN_SESSION_ID" )"
		[ -z "$placeRecord" ] || checkListSession="$( AgentsHarnessDispatchField "$placeRecord" session-id )"
	fi
	[ -n "$checkListSession" ] || checkListSession="$( AgentsHarnessSessionKey )"
	if [ -z "$checkListSession" ] ; then
		checkListWhy='this call belongs to no session yet, so its checklist has no place to be kept: call RootSession operation=mint to make a session, or operation=adopt to join one that already exists.' ; return 1
	fi
	if ! AgentsHarnessBareName "$checkListSession" || [ "$checkListSession" = "." ] || [ "$checkListSession" = ".." ] ; then
		checkListWhy='the session id of this call is no bare name, so it names no place for a checklist: call RootSession operation=mint to make a session, or operation=adopt with the id and token mint printed.'
		checkListSession="" ; return 1
	fi
	placeRecord="$( AgentsHarnessSpawnRecordPath "$checkListSession" )"
	if [ -n "$placeRecord" ] ; then
		checkListFolder="${placeRecord%/*}"
	else
		checkListFolder="$MMDAPP/.local/agents/sessions/$checkListSession"
	fi
	checkListMember="$harnessAgent"
	return 0
}

## The participants of the session with a known member name, sorted, one a line: the caller; the
## spawn records whose session-id is the session (the rows of the spawned-sessions registry,
## AgentsToolsRegistrySpawnedSessionsRows, read fresh); and the members whose list is kept in its
## place. Never a row with no member name.
AgentsHarnessCheckListMembers(){
	local membersFile membersName
	{
		printf '%s\n' "$checkListMember"
		( . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.Registries.include" && AgentsToolsRegistrySpawnedSessionsRows 2> /dev/null ) \
			| LC_ALL=C awk -v session="$checkListSession" '$2 == session && $5 != "-" { print $5 ; }'
		for membersFile in "$checkListFolder"/*.checklist.md ; do
			[ -f "$membersFile" ] || continue
			membersFile="${membersFile##*/}"
			printf '%s\n' "${membersFile%.checklist.md}"
		done
	} | while IFS= read -r membersName ; do
		! AgentsHarnessBareName "$membersName" || printf '%s\n' "$membersName"
	done | LC_ALL=C sort -u
}

## A read: the caller's own list, one participant's by its member name, or with `*` every
## participant's, each under its member name, an empty one shown as empty. Writes nothing.
AgentsHarnessCheckListRead(){ ## member name, `*`, or empty for the caller's own
	local readWant="${1:-$checkListMember}" readMembers readName readCount=0 readOut=""
	## A read of the caller's own list shows it whole, what another session added included: nothing is left to be kept for it (AgentsHarnessCheckListAppendLines).
	[ "$readWant" != "*" ] && [ "$readWant" != "$checkListMember" ] || rm -f "$checkListFolder/$checkListMember.checklist.md.added" 2>/dev/null || :
	readMembers="$( AgentsHarnessCheckListMembers )"
	if [ "$readWant" = "*" ] ; then
		while IFS= read -r readName ; do
			[ -n "$readName" ] || continue
			readOut="$readOut"$'\n\n'"## $readName"$'\n'"$( AgentsHarnessCheckListShown "$checkListFolder/$readName.checklist.md" )"
			readCount=$(( readCount + 1 ))
		done <<< "$readMembers"
		printf 'CHECKLISTS of session %s: %s participant(s), each under its member name.%s\n' "$checkListSession" "$readCount" "$readOut"
		return 0
	fi
	case $'\n'"$readMembers"$'\n' in
		*$'\n'"$readWant"$'\n'*) ;;
		*)
			printf 'ERROR: %s is not a participant of session %s, so it has no checklist here. Its participants are: %s. Give one of them as member, or * for all. Nothing was written.\n' \
				"$( AgentsHarnessTruncateArg "$readWant" )" "$checkListSession" "$( printf '%s\n' "$readMembers" | LC_ALL=C awk 'NF { printf "%s%s", ( n++ ? ", " : "" ), $0 ; }' )"
			return 0
		;;
	esac
	printf 'CHECKLIST of %s in session %s:\n%s\n' "$readWant" "$checkListSession" "$( AgentsHarnessCheckListShown "$checkListFolder/$readWant.checklist.md" )"
}

## The list as a reader of it sees it: the list's own text, with the source of each item that is not the member's
## own shown beside it, ` [step]` or ` [parent]`, and nothing for `own`, so an item no mark names reads exactly as
## it always did. A list that is not there, and one that holds nothing, read `(empty)`.
AgentsHarnessCheckListShown(){ ## the list file
	local shownStore shownFile="$1"
	[ -s "$shownFile" ] || { printf '(empty)\n' ; return 0 ; }
	type AgentsToolsCheckListSourcesPath > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.CheckListSources.include" 2> /dev/null || :
	shownStore="$( AgentsToolsCheckListSourcesPath "$shownFile" )"
	[ -n "$shownStore" ] && [ -f "$shownStore" ] || shownStore="/dev/null"
	CHECKLIST_STORE="$shownStore" LC_ALL=C awk '
		function itemText( line ) { sub( /^- \[[ x~]\] /, "", line ) ; sub( / \(due: [^)]*\)$/, "", line ) ; sub( / \(in progress: .*$/, "", line ) ; return line }
		FILENAME == ENVIRON["CHECKLIST_STORE"] { at = index( $0, "\t" ) ; if ( at > 1 ) { mark[substr( $0, at + 1 )] = substr( $0, 1, at - 1 ) } ; next }
		{ if ( $0 ~ /^- \[[ x~]\] / ) { text = itemText( $0 ) ; if ( ( text in mark ) && mark[text] != "own" ) { print $0 " [" mark[text] "]" ; next } } ; print }
	' "$shownStore" "$shownFile" 2> /dev/null
}

## The state one line of a list carries: rc 0 pending, 1 in progress, 2 done, 3 no item. A `- [ ]` line whose text ends with its
## activeForm is the in-progress shape before the `[~]` mark, and reads as in progress for good: a list either writer wrote reads the
## same, so a writer reverted alone loses no item.
AgentsHarnessCheckListLineState(){ ## one line of a list
	case "$1" in
		'- [ ] '*)
			case "$1" in *' (in progress: '*')') return 1 ;; esac
			return 0
		;;
		'- [~] '*) return 1 ;;
		'- [x] '*) return 2 ;;
	esac
	return 3
}

## The items of the caller's own list in its session that are pending, one a line as the file keeps them and nothing else read:
## rc 0 printing them where a list is on record (nothing where every item is closed or in progress), rc 1 where the session keeps none,
## rc 2 where the harness gives it no place for one. The list, its place and its marks are this file's, so every reader of a list asks
## here and none spells the format again: the Wait's nudge, the idle Wait and the handback all read the same way.
AgentsHarnessCheckListOpenItems(){
	local openFile="" openLine=""
	AgentsHarnessCheckListPlace || return 2
	openFile="$checkListFolder/$checkListMember.checklist.md"
	[ -f "$openFile" ] || return 1
	while IFS= read -r openLine || [ -n "$openLine" ] ; do
		AgentsHarnessCheckListLineState "$openLine" || continue
		printf '%s\n' "$openLine"
	done < "$openFile"
	return 0
}

## THE ITEMS PAST THEIR DUE TIME (S13.9), exactly as the list keeps them, one a line, and nothing else:
## rc 0 printing them, rc 1 where none is due, rc 2 where the harness gives the session no place for a
## list. An item is due when its own ` (due: <date-time>)` mark holds a moment at or before now; an item
## in progress is due too, since it is work still owed. The mark is read by the one reader of a moment
## (LocalIsoToEpoch.awk), so a due time nothing can read is never silently skipped: it is refused by
## the CheckList tool when it is written.
AgentsHarnessCheckListDue(){
	local dueFile="" dueLine="" dueText="" dueAt="" dueNow=0 dueState=0 dueAny=""
	AgentsHarnessCheckListPlace || return 2
	dueFile="$checkListFolder/$checkListMember.checklist.md"
	[ -f "$dueFile" ] || return 1
	dueNow="$( date +%s )"
	while IFS= read -r dueLine || [ -n "$dueLine" ] ; do
		dueState=0
		AgentsHarnessCheckListLineState "$dueLine" || dueState=$?
		case "$dueState" in 0|1) ;; *) continue ;; esac
		case "$dueLine" in *' (due: '*) ;; *) continue ;; esac
		dueText="${dueLine#* (due: }"
		dueText="${dueText%%)*}"
		[ -n "$dueText" ] || continue
		dueAt="$( printf '%s\n' "$dueText" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/output/LocalIsoToEpoch.awk" 2> /dev/null )" || dueAt=""
		case "$dueAt" in ''|*[!0-9]*) continue ;; esac
		[ "$dueAt" -le "$dueNow" ] || continue
		printf '%s\n' "$dueLine"
		dueAny="yes"
	done < "$dueFile"
	[ -n "$dueAny" ] || return 1
	return 0
}

## How many items the caller's own list holds, how many are pending and how many are in progress, as three numbers on one line: rc
## and the reading as AgentsHarnessCheckListOpenItems says them. Read for a line that says the list's state without its items.
## A PENDING ITEM THAT NAMES THE HANDBACK IS NOT COUNTED AS PENDING: that item is the step the handback itself closes, and the
## handback's own gate counts the rest. The predicate is asked here, once, so the Wait's line, the gate and the nudge cannot disagree.
AgentsHarnessCheckListCounts(){
	local countFile="" countLine="" countAll=0 countOpen=0 countActive=0 countState=0
	AgentsHarnessCheckListPlace || return 2
	countFile="$checkListFolder/$checkListMember.checklist.md"
	[ -f "$countFile" ] || return 1
	while IFS= read -r countLine || [ -n "$countLine" ] ; do
		countState=0
		AgentsHarnessCheckListLineState "$countLine" || countState=$?
		case "$countState" in
			0) countAll=$(( countAll + 1 )) ; AgentsHarnessCheckListNamesHandback "${countLine#'- [ ] '}" || countOpen=$(( countOpen + 1 )) ;;
			1) countAll=$(( countAll + 1 )) ; countActive=$(( countActive + 1 )) ;;
			2) countAll=$(( countAll + 1 )) ;;
		esac
	done < "$countFile"
	printf '%s %s %s\n' "$countAll" "$countOpen" "$countActive"
	return 0
}

## Whether an item's own text names the handback itself: the step a member writes into its list and then does, which the handback
## closes rather than reports as work left over. Case-insensitive, `hand back` and `handback`.
AgentsHarnessCheckListNamesHandback(){ ## the item's text, without its mark
	LC_ALL=C grep -qi -e 'hand back' -e 'handback' <<< "$1"
}

## Marks every open item of the caller's own list whose text names the handback closed, in one rewrite of the list: the handback
## does that step, so a member that wrote it is never told its own handback is work left. An item in progress is often that step itself,
## so either open mark is closed, its ' (in progress: ...)' suffix dropped so a closed item never claims to be in progress. rc 0 where
## the list now says so (or held no such item), rc 1 where there is no list or the write failed.
AgentsHarnessCheckListCloseHandback(){
	local closeFile="" closeLine="" closeOut="" closeTmp="" closeText="" closeClosed=0 closeState=0
	AgentsHarnessCheckListPlace || return 1
	closeFile="$checkListFolder/$checkListMember.checklist.md"
	[ -f "$closeFile" ] || return 1
	while IFS= read -r closeLine || [ -n "$closeLine" ] ; do
		closeState=0
		AgentsHarnessCheckListLineState "$closeLine" || closeState=$?
		if [ "$closeState" -gt 1 ] || ! AgentsHarnessCheckListNamesHandback "${closeLine:6}" ; then
			closeOut="$closeOut$closeLine"$'\n'
			continue
		fi
		closeText="${closeLine:6}"
		[ "$closeState" -ne 1 ] || closeText="${closeText% (in progress: *)}"
		closeOut="$closeOut- [x] $closeText"$'\n'
		closeClosed=$(( closeClosed + 1 ))
	done < "$closeFile"
	[ "$closeClosed" -gt 0 ] || return 0
	closeTmp="$( mktemp "$closeFile.XXXXXX" 2> /dev/null )" || return 1
	{ printf '%s' "$closeOut" > "$closeTmp" && mv -f "$closeTmp" "$closeFile" ; } 2> /dev/null || { rm -f "$closeTmp" ; return 1 ; }
	return 0
}

## THE LIST'S LOCK, a folder beside it, taken by mkdir and given back by rmdir, so an append and a whole-list write never interleave. rc 1 where it stays taken for five seconds.
AgentsHarnessCheckListLock(){ ## the list file
	local lockLeft=50
	until mkdir "$1.lock" 2> /dev/null ; do
		lockLeft=$(( lockLeft - 1 ))
		[ "$lockLeft" -gt 0 ] || return 1
		sleep 0.1
	done
	return 0
}
AgentsHarnessCheckListUnlock(){ ## the list file
	rmdir "$1.lock" 2> /dev/null || :
}

## ITEMS ADDED TO A MEMBER'S LIST BY SOMEONE ELSE (S23.2, and the spawn queue of S23.1): each stdin line becomes a pending item at the end of <member>.checklist.md in the folder, and is
## noted in <member>.checklist.md.added, which the owner's next whole-list write keeps and its next read clears. Prints how many were added; rc 1 where the list could not be locked or written.
AgentsHarnessCheckListAppendLines(){ ## folder, member -- stdin: the item texts, a line each
	local appendFile="$1/$2.checklist.md" appendLine appendCount=0
	mkdir -p "$1" 2> /dev/null || return 1
	AgentsHarnessCheckListLock "$appendFile" || return 1
	while IFS= read -r appendLine || [ -n "$appendLine" ] ; do
		appendLine="${appendLine//[$'\n\r\t']/ }"
		[ -n "$appendLine" ] || continue
		if ! { printf -- '- [ ] %s\n' "$appendLine" >> "$appendFile" && printf -- '- [ ] %s\n' "$appendLine" >> "$appendFile.added" ; } 2> /dev/null ; then
			AgentsHarnessCheckListUnlock "$appendFile"
			return 1
		fi
		appendCount=$(( appendCount + 1 ))
	done
	AgentsHarnessCheckListUnlock "$appendFile"
	printf '%s\n' "$appendCount"
}

## The CheckList tool's append: the items of append go, pending, to the list of the participant named by member in the session named by session -- a session the caller is the PARENT of
## (the target's record names the caller's session as `parent-session-id`) and the participant its executor (the record's owner) -- or, with no session, to the caller's own list. Nothing
## already on a list is changed. The result names the member and the session and gives no path.
AgentsHarnessCheckListAppend(){
	local appendMember="${harnessArgV_member:-}" appendSession="${harnessArgV_session:-}" appendCount appendIndex=0 appendItems="" appendRecord appendFolder appendAdded appendDueText appendDueAt
	if AgentsHarnessArgFind todos.__count ; then
		printf 'ERROR: append adds to a list and takes no todos, which replace your own: give one or the other. Nothing was written.\n' ; return 0
	fi
	[ -n "$appendMember" ] || { printf 'ERROR: append needs member, the participant whose list the items go to. Nothing was written.\n' ; return 0 ; }
	AgentsHarnessArgFind append.__count || :
	appendCount="$harnessArgFound"
	case "$appendCount" in ''|0|*[!0123456789]*) printf 'ERROR: append must be an array of one or more item texts. Nothing was written.\n' ; return 0 ;; esac
	while [ "$appendIndex" -lt "$appendCount" ] ; do
		if ! AgentsHarnessArgFind "append.$appendIndex" || [ -z "$harnessArgFound" ] ; then
			printf 'ERROR: append item %s of %s is empty or no text -- each is a text. Nothing was written.\n' "$(( appendIndex + 1 ))" "$appendCount" ; return 0
		fi
		## A due mark (S13.9) is a moment the one reader of a moment reads, as it is on the member's
		## own write: an appended item carrying one nothing can read is refused here, not written.
		case "$harnessArgFound" in
			*' (due: '*)
				appendDueText="${harnessArgFound#* (due: }"
				appendDueText="${appendDueText%%)*}"
				appendDueAt="$( printf '%s\n' "$appendDueText" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/output/LocalIsoToEpoch.awk" 2> /dev/null )" || appendDueAt=""
				case "$appendDueAt" in
					''|*[!0-9]*)
						printf 'ERROR: append item %s of %s: due must be a date-time this tooling can read, such as "2026-11-04 18:00 +0200", got: %s. Nothing was written.\n' "$(( appendIndex + 1 ))" "$appendCount" "$( AgentsHarnessTruncateArg "$appendDueText" )" ; return 0
					;;
				esac
			;;
		esac
		appendItems="$appendItems$harnessArgFound"$'\n'
		appendIndex=$(( appendIndex + 1 ))
	done
	if [ -z "$appendSession" ] || [ "$appendSession" = "$checkListSession" ] ; then
		if [ "$appendMember" != "$checkListMember" ] ; then
			printf 'ERROR: in your own session you append to your own list only (%s), and %s is another list: give the session of a child you started to add to its executor. Nothing was written.\n' "$checkListMember" "$( AgentsHarnessTruncateArg "$appendMember" )" ; return 0
		fi
		appendFolder="$checkListFolder"
	else
		AgentsHarnessBareName "$appendSession" || { printf 'ERROR: session is no bare session id. Nothing was written.\n' ; return 0 ; }
		appendRecord="$( AgentsHarnessSpawnRecordPath "$appendSession" )"
		if [ -z "$appendRecord" ] ; then
			printf 'ERROR: no session %s is known here. Nothing was written.\n' "$( AgentsHarnessTruncateArg "$appendSession" )" ; return 0
		fi
		if [ "$( AgentsHarnessDispatchField "$appendRecord" parent-session-id )" != "$checkListSession" ] ; then
			printf 'ERROR: only the parent of session %s adds items to its executor'"'"'s list, and this session (%s) is not its parent. Nothing was written.\n' "$appendSession" "$checkListSession" ; return 0
		fi
		if [ "$( AgentsHarnessDispatchField "$appendRecord" owner )" != "$appendMember" ] ; then
			printf 'ERROR: %s is not the executor of session %s, whose list takes the parent'"'"'s items. Nothing was written.\n' "$( AgentsHarnessTruncateArg "$appendMember" )" "$appendSession" ; return 0
		fi
		appendFolder="${appendRecord%/*}"
	fi
	if ! appendAdded="$( printf '%s' "$appendItems" | AgentsHarnessCheckListAppendLines "$appendFolder" "$appendMember" )" ; then
		printf 'ERROR: the checklist of %s could not be written to. Nothing was written.\n' "$appendMember" ; return 0
	fi
	## WHAT A PARENT ADDED IS THE PARENT'S (S6.27): each line just added is marked so, and nothing already marked moves.
	type AgentsToolsCheckListSourcesMark > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.CheckListSources.include" 2>/dev/null || :
	AgentsToolsCheckListSourcesMark "$appendFolder/$appendMember.checklist.md" "" "$appendItems" 2>/dev/null || :
	printf 'OK: %s item(s) added, as pending, to the checklist of %s in session %s.\n' "$appendAdded" "$appendMember" "${appendSession:-$checkListSession}"
}
