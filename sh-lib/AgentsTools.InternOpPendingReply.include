#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.InternOpPendingReply.include -- the pending-reply store.
##
## A question asked of a person is the commonest reason a session is waiting on
## something, and AskUserQuestion -- a Slack send plus a wait -- is where nearly all
## of them come from. Only some of those ever become board items. So the store is its
## own: one record per question asked, written when the question is posted and closed
## when the answer arrives or the wait ends. `pending-replies.registry` is a cache
## over this store and over the board items that did become items.
##
## A record is kept after it closes rather than deleted: a saved reply is what lets a
## session resume, and an unanswered question is what a re-ask is posted from. Purging
## is not this op's business.
##
## THE DISTINCTION THIS STORE EXISTS TO HOLD: a question that was never posted is not
## a question nobody answered. AskUserQuestion says so in its own words, and it is why
## nothing is recorded until the send has succeeded, and why a wait that could not be
## performed leaves the record open rather than closing it as unanswered.
##

## One resolved mark on one message: under the identity the question was posted with
## first, then the bot, since which identity may react differs by conversation.
## `already_reacted` is a success of the react op. A failure is logged and changes nothing.
AgentsToolsPendingReplyReact(){ ## member, <channel>:<ts>, emoji, pending id
	DistroAgentsTools --intern-op-comms-slack-react "$1" "$2" "$3" > /dev/null 2>&1 \
		|| DistroAgentsTools --intern-op-comms-slack-react "$1" "$2" "$3" --identity-bot > /dev/null 2>&1 \
		|| echo "$MDSC_CMD: ⚠️ WARNING: $4 is closed, but :$3: was not added on $2" >&2
	return 0
}

## True while any question in that thread still waits.
AgentsToolsPendingReplyThreadHasOpen(){ ## channel, thread ts
	local openFile
	while IFS= read -r openFile ; do
		LC_ALL=C grep -q -x -F "channel: $1" "$openFile" && LC_ALL=C grep -q -x -F "status: reply-pending" "$openFile" && return 0
	done < <( LC_ALL=C grep -r -l -x -F --include='*.md' "thread-ts: $2" "$MMDAPP/.local/agents/pending" 2>/dev/null )
	return 1
}

case "$1" in

	--intern-op-pending-reply-open)
		shift
		MDSC_CMD="$MDSC_CMD --intern-op-pending-reply-open"
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsContext.UseAgentsTools.include"
		local pendingOwner="$1"
		shift || true
		local pendingTo="" pendingSession="" pendingBlockedOn=""
		local pendingKind="" pendingAddressTo="" pendingChannel="" pendingQuestionTs="" pendingThreadTs="" pendingAddressees="" pendingAsking="" pendingRefusal="" pendingOptions="" pendingTag="" pendingKey="" pendingIdentity="" pendingItem="" pendingTaskRef=""
		while [ $# -gt 0 ] ; do
			case "$1" in
				## A typed question's own facts, kept so an answer can be classified and applied later.
				--kind) pendingKind="${2:-}" ; shift 2 ;;
				--address-to) pendingAddressTo="${2:-}" ; shift 2 ;;
				--channel) pendingChannel="${2:-}" ; shift 2 ;;
				--question-ts) pendingQuestionTs="${2:-}" ; shift 2 ;;
				--thread-ts) pendingThreadTs="${2:-}" ; shift 2 ;;
				--addressees) pendingAddressees="${2:-}" ; shift 2 ;;
				--asking-accounts) pendingAsking="${2:-}" ; shift 2 ;;
				--refusal-id) pendingRefusal="${2:-}" ; shift 2 ;;
				--options) pendingOptions="${2:-}" ; shift 2 ;;
				## Its tag within a thread several questions share, and the key a duplicate is found by.
				--question-tag) pendingTag="${2:-}" ; shift 2 ;;
				--question-key) pendingKey="${2:-}" ; shift 2 ;;
				## The board item the ask belongs to: named directly, or found in AskUserQuestion's task_ref.
				--item) pendingItem="${2:-}" ; shift 2 ;;
				--task-ref) pendingTaskRef="${2:-}" ; shift 2 ;;
				## The identity the question was posted under, so a reminder posts under the same one.
				--ask-identity)
					case "${2:-}" in
						bot|member) pendingIdentity="$2" ;;
						*) echo "$MDSC_CMD: ⛔ ERROR: --ask-identity must be bot|member: ${2:-}" >&2 ; set +e ; return 1 ;;
					esac
					shift 2
				;;
				--to)
					pendingTo="${2:-}"
					[ -n "$pendingTo" ] || { echo "$MDSC_CMD: ⛔ ERROR: --to requires <conversation-id>" >&2 ; set +e ; return 1 ; }
					shift 2
				;;
				--session-id)
					pendingSession="${2:-}"
					shift 2
				;;
				--blocked-on)
					pendingBlockedOn="${2:-}"
					shift 2
				;;
				--context)
					shift 2
				;;
				*)
					echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$pendingOwner" ] || [ -z "$pendingTo" ] ; then
			echo "$MDSC_CMD: ⛔ ERROR: syntax is <team-member> --to <conversation-id> [--session-id <id>] [--blocked-on <what>] -- the question text is read from stdin" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$pendingOwner" "<team-member>" pending-reply-open || { set +e ; return 1 ; }
		local pendingId
		pendingId="$( uuidgen 2>/dev/null | LC_ALL=C tr 'ABCDEF' 'abcdef' )"
		if [ -z "$pendingId" ] ; then
			echo "$MDSC_CMD: ⛔ ERROR: no id could be generated, so nothing was recorded" >&2
			set +e ; return 1
		fi
		local pendingRoot="$MMDAPP/.local/agents/pending"
		mkdir -p "$pendingRoot" || {
			echo "$MDSC_CMD: ⛔ ERROR: can't create the pending-reply store: $pendingRoot" >&2
			set +e ; return 1
		}
		[ -n "$pendingBlockedOn" ] || pendingBlockedOn="reply from $pendingTo"
		## The item its answer is recorded on: --item, else the first item task_ref names, else
		## the session's own `spawns:` dispatch item, else none. Only an item on the board counts.
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.ItemDecisions.include"
		if [ -n "$pendingItem" ] && AgentsToolsDecisionsItemPath "$pendingItem" > /dev/null ; then
			pendingItem="${pendingItem##*/}" ; pendingItem="${pendingItem%.md}"
		else
			pendingItem="$( AgentsToolsDecisionsItemFromRef "$pendingTaskRef" "$pendingSession" 2>/dev/null )" || pendingItem=""
		fi
		{
			printf '%s\n' "---"
			printf 'status: %s\n' "reply-pending"
			printf 'owner: %s\n' "$pendingOwner"
			## The machine this was asked from, for the same reason a spawn record
			## carries one: the tree is synced, so a record found here was not
			## necessarily written here.
			printf 'host: %s\n' "$( hostname -s 2>/dev/null || echo unknown )"
			## Both are the entity model's own fields, with its own shapes -- the
			## channel id is `<service>:<rest>`, and `blocked-on` is what the
			## spawn convention already calls this.
			printf 'communication-channel-id: slack:%s\n' "$pendingTo"
			printf 'blocked-on: %s\n' "$pendingBlockedOn"
			[ -z "$pendingSession" ] || printf 'session-id: %s\n' "$pendingSession"
			[ -z "$pendingKind" ] || printf 'kind: %s\n' "${pendingKind//$'\n'/ }"
			[ -z "$pendingAddressTo" ] || printf 'address-to: %s\n' "${pendingAddressTo//$'\n'/ }"
			[ -z "$pendingChannel" ] || printf 'channel: %s\n' "${pendingChannel//$'\n'/ }"
			[ -z "$pendingQuestionTs" ] || printf 'question-ts: %s\n' "${pendingQuestionTs//$'\n'/ }"
			[ -z "$pendingThreadTs" ] || printf 'thread-ts: %s\n' "${pendingThreadTs//$'\n'/ }"
			[ -z "$pendingAddressees" ] || printf 'addressees: %s\n' "${pendingAddressees//$'\n'/ }"
			[ -z "$pendingAsking" ] || printf 'asking-accounts: %s\n' "${pendingAsking//$'\n'/ }"
			[ -z "$pendingRefusal" ] || printf 'refusal-id: %s\n' "${pendingRefusal//$'\n'/ }"
			[ -z "$pendingTag" ] || printf 'question-tag: %s\n' "${pendingTag//$'\n'/ }"
			[ -z "$pendingKey" ] || printf 'question-key: %s\n' "${pendingKey//$'\n'/ }"
			[ -z "$pendingIdentity" ] || printf 'ask-identity: %s\n' "$pendingIdentity"
			[ -z "$pendingItem" ] || printf 'item: %s\n' "$pendingItem"
			printf 'asked-at: %s\n' "$( date +"%Y-%m-%d %H:%M %z" )"
			printf '%s\n' "---"
			printf '\n# Question asked\n\n'
			cat
		} > "$pendingRoot/.$pendingId.md.$$" || {
			rm -f "$pendingRoot/.$pendingId.md.$$"
			echo "$MDSC_CMD: ⛔ ERROR: can't write the pending-reply record: $pendingRoot/$pendingId.md" >&2
			set +e ; return 1
		}
		## A decision's options beside the record, raw, because a verdict is read against them.
		## Written first, so a record a reader can see already has its options there.
		[ -z "$pendingOptions" ] || printf '%s\n' "$pendingOptions" > "$pendingRoot/$pendingId.options" || :
		## Written aside and moved into place in one rename, so a reader never sees a record
		## half written: status first, with the thread fields still to come.
		mv -f "$pendingRoot/.$pendingId.md.$$" "$pendingRoot/$pendingId.md" || {
			rm -f "$pendingRoot/.$pendingId.md.$$" "$pendingRoot/$pendingId.options"
			echo "$MDSC_CMD: ⛔ ERROR: can't put the pending-reply record in place: $pendingRoot/$pendingId.md" >&2
			set +e ; return 1
		}
		## The id on stdout, because the caller closes this record by it and has no
		## other way to learn it.
		printf '%s\n' "$pendingId"
		return 0
	;;

	--intern-op-pending-reply-close)
		shift
		MDSC_CMD="$MDSC_CMD --intern-op-pending-reply-close"
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsContext.UseAgentsTools.include"
		local pendingId="$1"
		shift || true
		local pendingStatus="" pendingVerdict="" pendingAnsweredBy="" pendingIfOpen="" pendingAnswerTs="" pendingMark=""
		local pendingAmend="" pendingAmendedBy="" pendingAmendReason="" pendingNoDecision=""
		## Closed with no reaction: the main loop's pass closing an ask whose session still runs
		## (--quiet, or MDAT_PENDING_CLOSE_QUIET=1 through the escalation op it calls).
		local pendingQuiet="${MDAT_PENDING_CLOSE_QUIET:-}"
		while [ $# -gt 0 ] ; do
			case "$1" in
				--quiet)
					pendingQuiet=1
					shift
				;;
				## The answer came from the item's own Decisions, so it is not recorded there twice.
				--no-decision)
					pendingNoDecision=1
					shift
				;;
				## The ts of the reply taken as the answer, marked :eyes: once the record is closed.
				--answer-ts)
					pendingAnswerTs="${2:-}"
					shift 2
				;;
				## How the question is marked once closed: `answered` (the default) or `settled`.
				--resolved-as)
					case "${2:-}" in
						answered) pendingMark="white_check_mark" ;;
						settled) pendingMark="ballot_box_with_check" ;;
						*) echo "$MDSC_CMD: ⛔ ERROR: --resolved-as must be answered|settled: ${2:-}" >&2 ; set +e ; return 1 ;;
					esac
					shift 2
				;;
				## Closes only a record still waiting: of two closers racing on one record (a
				## live wait and a collect), the second finds it closed and says so, rc 3.
				--if-open)
					pendingIfOpen=1
					shift
				;;
				## Corrects a record already closed: its verdict and status are rewritten, and
				## who amended it and why are recorded; its close time and reactions stay as they were.
				--amend)
					pendingAmend=1
					shift
				;;
				--amended-by)
					pendingAmendedBy="${2:-}"
					shift 2
				;;
				--amend-reason)
					pendingAmendReason="${2:-}"
					shift 2
				;;
				--status)
					pendingStatus="${2:-}"
					shift 2
				;;
				--verdict)
					pendingVerdict="${2:-}"
					shift 2
				;;
				--answered-by)
					pendingAnsweredBy="${2:-}"
					shift 2
				;;
				--context)
					shift 2
				;;
				*)
					echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$pendingId" ] || [ -z "$pendingStatus" ] ; then
			echo "$MDSC_CMD: ⛔ ERROR: syntax is <pending-reply-id> --status <reply-received|reply-unknown>" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$pendingId" "<pending-reply-id>" pending-reply-close || { set +e ; return 1 ; }
		case "$pendingStatus" in
			reply-received|reply-unknown) ;;
			*)
				## Enumerated rather than free text, because these two direct
				## different next steps: a received reply resumes the work, and an
				## unknown is neither until someone looks. No timeout status: a
				## pending record never expires by age (MAGIC.md). An old record
				## already closed as reply-timeout is still read like any closed one.
				echo "$MDSC_CMD: ⛔ ERROR: --status must be reply-received|reply-unknown: $pendingStatus" >&2
				set +e ; return 1
			;;
		esac
		local pendingFile="$MMDAPP/.local/agents/pending/$pendingId.md"
		if [ ! -f "$pendingFile" ] ; then
			echo "$MDSC_CMD: ⛔ ERROR: no pending-reply record: $pendingFile" >&2
			set +e ; return 1
		fi
		## Every close holds the record's own lock across its read and its write, so two
		## closers never interleave on one record.
		local pendingLock="" pendingNow=""
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.LocalLock.include"
		if ! AgentsToolsLocalLockTake "pending-reply-$pendingId" 30 ; then
			echo "$MDSC_CMD: ⛔ ERROR: the lock on $pendingId could not be taken, so the record was left unchanged" >&2
			set +e ; return 1
		fi
		pendingLock="$agentsLocalLockPath"
		if [ -n "$pendingAmend" ] ; then
			pendingNow="$( LC_ALL=C awk -F': ' 'NR > 1 && $0 == "---" { exit ; } $1 == "status" { print substr($0, 9) ; exit ; }' "$pendingFile" )"
			if [ "$pendingNow" = "reply-pending" ] || [ -z "$pendingAmendedBy" ] || [ -z "$pendingAmendReason" ] || [ -z "$pendingVerdict" ] ; then
				AgentsToolsLocalLockGive "$pendingLock"
				echo "$MDSC_CMD: ⛔ ERROR: --amend corrects a closed record only, and needs --verdict, --amended-by and --amend-reason; $pendingId is ${pendingNow:-unknown}, left as it is" >&2
				set +e ; return 1
			fi
		fi
		if [ -n "$pendingIfOpen" ] ; then
			pendingNow="$( LC_ALL=C awk -F': ' 'NR > 1 && $0 == "---" { exit ; } $1 == "status" { print substr($0, 9) ; exit ; }' "$pendingFile" )"
			if [ "$pendingNow" != "reply-pending" ] ; then
				AgentsToolsLocalLockGive "$pendingLock"
				printf 'ALREADY-CLOSED %s %s\n' "$pendingId" "${pendingNow:-unknown}"
				set +e ; return 3
			fi
		fi
		## Applied by this package's own header writer, so no second frontmatter
		## parser exists and a failure leaves the record exactly as it was -- an open
		## record is recoverable by a rescan, a truncated one is not.
		local pendingOps pendingBody
		pendingOps="$MMDAPP/.local/temp/mdat-pending-reply-ops.$$.$RANDOM"
		mkdir -p "$MMDAPP/.local/temp" || { AgentsToolsLocalLockGive "$pendingLock" ; set +e ; return 1 ; }
		{
			printf 'upsert\tstatus\t%s\n' "$pendingStatus"
			if [ -n "$pendingAmend" ] ; then
				## What the correction corrected stays on the record: the first verdict and its giver.
				LC_ALL=C awk '
					NR > 1 && $0 == "---" { exit ; }
					index($0, "verdict: ") == 1 { printf "upsert\tamended-from\t%s\n", substr($0, 10) ; }
					index($0, "answered-by: ") == 1 { printf "upsert\tamended-from-answered-by\t%s\n", substr($0, 14) ; }
				' "$pendingFile"
				printf 'upsert\tamended-at\t%s\n' "$( date +"%Y-%m-%d %H:%M %z" )"
				printf 'upsert\tamended-by\t%s\n' "${pendingAmendedBy//$'\n'/ }"
				printf 'upsert\tamend-reason\t%s\n' "${pendingAmendReason//$'\n'/ }"
			else
				printf 'upsert\tresolved-at\t%s\n' "$( date +"%Y-%m-%d %H:%M %z" )"
				## The same moment in epoch seconds, which a reply's Slack ts compares with: a
				## plain reply after this question was closed answers nothing (AgentsTools.AskThread.include).
				printf 'upsert\tresolved-epoch\t%s\n' "$( date +%s )"
			fi
			[ -z "$pendingVerdict" ] || printf 'upsert\tverdict\t%s\n' "${pendingVerdict//$'\n'/ }"
			[ -z "$pendingAnsweredBy" ] || printf 'upsert\tanswered-by\t%s\n' "${pendingAnsweredBy//$'\n'/ }"
		} > "$pendingOps" || { rm -f "$pendingOps" ; AgentsToolsLocalLockGive "$pendingLock" ; set +e ; return 1 ; }
		pendingBody="$( LC_ALL=C awk -v opsFile="$pendingOps" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsBoardItemHeaderOpsApply.awk" < "$pendingFile" )" || pendingBody=""
		rm -f "$pendingOps"
		if [ -z "$pendingBody" ] ; then
			AgentsToolsLocalLockGive "$pendingLock"
			echo "$MDSC_CMD: ⚠️ WARNING: the record was left unchanged: $pendingFile" >&2
			set +e ; return 1
		fi
		## Aside, then one rename: the lock orders closers, but a reader takes no lock.
		{ printf '%s\n' "$pendingBody" > "$pendingFile.$$" && mv -f "$pendingFile.$$" "$pendingFile" ; } \
			|| { rm -f "$pendingFile.$$" ; AgentsToolsLocalLockGive "$pendingLock" ; set +e ; return 1 ; }
		AgentsToolsLocalLockGive "$pendingLock"
		## The outcome goes to the ask's item, where a reopened or continued task reads it.
		if [ -z "$pendingNoDecision" ] ; then
			. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.ItemDecisions.include"
			AgentsToolsDecisionsFromPending "$pendingId" "$pendingFile" "$pendingStatus" "$pendingAmend" "$pendingAnswerTs"
		fi
		## A resolved question shows it where people look: :eyes: on the reply taken as its
		## answer, a mark on the question in its thread (:white_check_mark: answered,
		## :ballot_box_with_check: settled), and :white_check_mark: on the thread's opener in
		## the conversation once no question in that thread is open. Best effort, after the
		## record is closed: a reaction that fails is logged and never undoes the close. Never
		## an answer either: only an addressee's reaction answers.
		if [ "$pendingStatus" = "reply-received" ] && [ -z "$pendingAmend" ] && [ "$pendingQuiet" != "1" ] ; then
			local reactOwner="" reactChannel="" reactQuestion="" reactThread="" reactTo="" reactKey reactValue
			while IFS=$'\t' read -r reactKey reactValue ; do
				case "$reactKey" in
					owner) reactOwner="$reactValue" ;;
					channel) reactChannel="$reactValue" ;;
					question-ts) reactQuestion="$reactValue" ;;
					thread-ts) reactThread="$reactValue" ;;
					communication-channel-id) reactTo="${reactValue#slack:}" ;;
				esac
			done < <( LC_ALL=C awk '
				$0 == "---" { dashes++ ; if ( dashes == 2 ) { exit ; } next ; }
				dashes == 1 {
					colon = index($0, ": ") ;
					if ( colon > 1 ) { printf "%s\t%s\n", substr($0, 1, colon - 1), substr($0, colon + 2) ; }
				}
			' "$pendingFile" )
			if [ -n "$reactOwner" ] && [ -n "$reactChannel" ] ; then
				[ -z "$pendingAnswerTs" ] || AgentsToolsPendingReplyReact "$reactOwner" "$reactChannel:$pendingAnswerTs" eyes "$pendingId"
				[ -z "$reactQuestion" ] || AgentsToolsPendingReplyReact "$reactOwner" "$reactChannel:$reactQuestion" "${pendingMark:-white_check_mark}" "$pendingId"
				## The opener is ours only where the question opened its own thread; a question
				## asked inside someone's thread (<channel>:<ts>) leaves that thread's root alone.
				case "$reactTo" in
					*:*) ;;
					*)
						if [ -n "$reactThread" ] && ! AgentsToolsPendingReplyThreadHasOpen "$reactChannel" "$reactThread" ; then
							AgentsToolsPendingReplyReact "$reactOwner" "$reactChannel:$reactThread" white_check_mark "$pendingId"
						fi
					;;
				esac
			fi
		fi
		return 0
	;;

	## Collects answers to open plain questions nobody is waiting on
	## (AgentsTools.PendingReplyCollect.include). --session-id: that session's records,
	## and --mark-ended marks the ones still open for the main loop. --ended: the marked
	## records, each answer found going to its asker's inbox as a note. --id: one record.
	--intern-op-pending-reply-collect)
		shift
		MDSC_CMD="$MDSC_CMD --intern-op-pending-reply-collect"
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsContext.UseAgentsTools.include"
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.PendingReplyCollect.include"
		local collectSession="" collectEnded="" collectId="" collectMark="" collectTyped=""
		while [ $# -gt 0 ] ; do
			case "$1" in
				--session-id)
					[ -n "${2:-}" ] || { echo "$MDSC_CMD: ⛔ ERROR: --session-id requires a value (<id>)" >&2 ; set +e ; return 1 ; }
					collectSession="$2" ; shift 2
				;;
				--id)
					[ -n "${2:-}" ] || { echo "$MDSC_CMD: ⛔ ERROR: --id requires a value (<pending-id>)" >&2 ; set +e ; return 1 ; }
					collectId="$2" ; shift 2
				;;
				--ended) collectEnded=1 ; shift ;;
				--mark-ended) collectMark=1 ; shift ;;
				--context) shift 2 ;;
				*)
					echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$collectSession$collectEnded$collectId" ] || { [ -n "$collectMark" ] && [ -z "$collectSession" ] ; } ; then
			echo "$MDSC_CMD: ⛔ ERROR: syntax is --session-id <id> [--mark-ended] | --ended | --id <pending-id>" >&2
			set +e ; return 1
		fi
		[ -z "$collectId" ] || AgentsToolsAssertBareName "$collectId" "<pending-id>" pending-reply-collect || { set +e ; return 1 ; }
		mkdir -p "$MMDAPP/.local/temp" || { set +e ; return 1 ; }
		local collectStore="$MMDAPP/.local/agents/pending" collectFile collectFiles=() collectAnswered=0 collectUnmatched=0 collectOpen=0 collectUnreadable=0
		## Found by grep over whole header lines, so a pass costs one scan however the store grows.
		if [ -n "$collectId" ] ; then
			[ ! -f "$collectStore/$collectId.md" ] || collectFiles=( "$collectStore/$collectId.md" )
		elif [ -n "$collectSession" ] ; then
			while IFS= read -r collectFile ; do collectFiles+=( "$collectFile" ) ; done \
				< <( LC_ALL=C grep -r -l -x -F --include='*.md' "session-id: $collectSession" "$collectStore" 2>/dev/null )
		else
			while IFS= read -r collectFile ; do collectFiles+=( "$collectFile" ) ; done \
				< <( LC_ALL=C grep -r -l -x -F --include='*.md' "collect: ended" "$collectStore" 2>/dev/null )
			## Only a spawn's own close marks its records ended, so an ask from any other session
			## (a native or console one) was never collected and stayed pending for good. Every
			## open one asked over MDAT_PENDING_COLLECT_STALE_MINUTES ago (default 120) is
			## collected too, at most MDAT_PENDING_COLLECT_STALE_MAX (default 40) a pass, oldest
			## first: a live session's wait finds it closed and says so, which costs nothing.
			local collectStaleMinutes="${MDAT_PENDING_COLLECT_STALE_MINUTES:-120}" collectStaleMax="${MDAT_PENDING_COLLECT_STALE_MAX:-40}"
			case "$collectStaleMinutes" in ''|*[!0-9]*) collectStaleMinutes=120 ;; esac
			case "$collectStaleMax" in ''|*[!0-9]*) collectStaleMax=40 ;; esac
			while IFS= read -r collectFile ; do collectFiles+=( "$collectFile" ) ; done < <(
				LC_ALL=C grep -r -l -x -F --include='*.md' "status: reply-pending" "$collectStore" 2>/dev/null \
					| while IFS= read -r collectFile ; do
						LC_ALL=C grep -q -x -F "collect: ended" "$collectFile" && continue
						LC_ALL=C awk -v file="$collectFile" '$0 == "---" { if ( ++dashes == 2 ) { exit ; } next ; } dashes == 1 && index( $0, "question-ts: " ) == 1 { split( substr( $0, 14 ), part, "." ) ; print part[1] "\t" file ; exit ; }' "$collectFile" 2>/dev/null
					done \
					| LC_ALL=C awk -F '\t' -v cutoff="$(( $( date +%s ) - collectStaleMinutes * 60 ))" '$1 ~ /^[0-9]+$/ && $1 + 0 <= cutoff + 0' \
					| while IFS=$'\t' read -r collectTs collectFile ; do
						## Least recently checked first: a checked record is touched below, so one
						## still unanswered goes to the back and the cap never starves newer asks.
						printf '%s\t%s\n' "$( stat -f %m "$collectFile" 2>/dev/null || stat -c %Y "$collectFile" 2>/dev/null || printf '%s' "$collectTs" )" "$collectFile"
					done \
					| LC_ALL=C sort -n | head -n "$collectStaleMax" | cut -f2- )
			collectTyped=1
		fi
		local collectOutcome collectAnswer collectLine collectOwner collectNoteId collectQuiet="" collectRunning="" collectAskSession
		## In the main loop's pass, an ask whose session is still running -- a stale ask of a
		## live session, or a marked one whose session was joined again -- is closed silently:
		## its answer and Decisions line are recorded and its blocker cleared, and no reaction
		## and no "after your session ended" note go out. Its own wait finds it closed.
		## Read once a pass, and only when there is something to collect.
		[ -z "$collectEnded" ] || [ "${#collectFiles[@]}" -eq 0 ] || collectRunning="$( AgentsToolsPendingReplySessionsRunning )"
		for collectFile in "${collectFiles[@]}" ; do
			[ -f "$collectFile" ] || continue
			collectQuiet=""
			if [ -n "$collectEnded" ] ; then
				collectAskSession="$( AgentsToolsPendingReplyCollectFieldOf "$collectFile" session-id )"
				case "$collectRunning" in *" ${collectAskSession:-<none>} "*) collectQuiet=1 ;; esac
			fi
			collectLine="$( AgentsToolsPendingReplyCollectOne "$collectFile" )"
			collectOutcome="${collectLine%% *}"
			[ -z "$collectTyped" ] || [ ! -f "$collectFile" ] || touch "$collectFile" 2>/dev/null || :
			case "$collectOutcome" in
				''|SKIPPED) continue ;;
			esac
			printf '%s\n' "$collectLine"
			case "$collectOutcome" in
				ANSWERED)
					collectAnswered=$(( collectAnswered + 1 ))
					if [ -n "$collectEnded" ] && [ -z "$collectQuiet" ] ; then
						## Its session is gone, so the answer goes to whoever next runs as the asker.
						collectOwner="$( AgentsToolsPendingReplyCollectFieldOf "$collectFile" owner )"
						collectNoteId="${collectFile##*/}" ; collectNoteId="${collectNoteId%.md}"
						{
							printf -- '---\nmember: %s\ndate: %s\n---\n\n' "$collectOwner" "$( date -u +%Y-%m-%d )"
							printf '# Note: an answer arrived after your session ended\n\n'
							printf 'Pending reply `%s` is answered, and its record is closed. What the tooling collected:\n\n' "$collectNoteId"
							printf -- '- %s\n' "${collectLine#ANSWERED }"
						} | DistroAgentsTools --intern-op-member-inbox-upsert "$collectOwner" "note-$( date -u +%Y%m%dT%H%M%SZ )-answer-${collectNoteId%%-*}.md" \
							--context "$MDSC_CMD" > /dev/null 2>&1 \
							|| echo "⚠️ WARNING: $MDSC_CMD: $collectNoteId is answered and closed, but the note to $collectOwner's inbox was not written" >&2
					fi
				;;
				UNMATCHED) collectUnmatched=$(( collectUnmatched + 1 )) ;;
				UNREADABLE) collectUnreadable=$(( collectUnreadable + 1 )) ;;
				OPEN) collectOpen=$(( collectOpen + 1 )) ;;
			esac
			## A record still open when its session ends is marked, so the main loop collects it.
			if [ -n "$collectMark" ] ; then
				case "$collectOutcome" in
					UNMATCHED|UNREADABLE|OPEN)
						collectNoteId="${collectFile##*/}"
						AgentsToolsPendingReplyMarkEnded "${collectNoteId%.md}" "$collectFile" 2>/dev/null || :
					;;
				esac
			fi
		done
		printf 'COLLECT: answered=%s unmatched=%s open=%s unreadable=%s\n' "$collectAnswered" "$collectUnmatched" "$collectOpen" "$collectUnreadable"
		return 0
	;;

	## Before a question is asked: the answer it already has, so it is not asked again. Read-only.
	## The session's own closed records first -- same addressee and kind, and the same key or the
	## same first line compared loosely -- newest first; then the item's `## Decisions`, then
	## those of the item it `tracks:` (EARLIER-DECISION then names that item). A
	## permission is matched only on the same refusal, or by a deny, since an allow needs a grant
	## of its own; Decisions never answer one. The question text is read from stdin. Prints one of
	##   EARLIER-RECORD <id> | <verdict> | <answered-by> | <resolved-at>
	##   EARLIER-DECISION <item> | <Decisions line>
	## or nothing, rc 0, when no answer is known.
	--intern-op-pending-reply-earlier)
		shift
		MDSC_CMD="$MDSC_CMD --intern-op-pending-reply-earlier"
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsContext.UseAgentsTools.include"
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.ItemDecisions.include"
		local earlyMember="${1:-}" earlySession="" earlyKey="" earlyKind="question" earlyRefusal="" earlyAddress="" earlyTaskRef="" earlyItem="" earlyQuestion
		shift || true
		while [ $# -gt 0 ] ; do
			case "$1" in
				--session-id|--question-key|--kind|--refusal-id|--address-to|--task-ref|--item|--context)
					[ $# -ge 2 ] || { echo "$MDSC_CMD: ⛔ ERROR: $1 requires a value" >&2 ; set +e ; return 1 ; }
					case "$1" in
						--session-id) earlySession="$2" ;;
						--question-key) earlyKey="$2" ;;
						--kind) earlyKind="${2:-question}" ;;
						--refusal-id) earlyRefusal="$2" ;;
						--address-to) earlyAddress="$2" ;;
						--task-ref) earlyTaskRef="$2" ;;
						--item) earlyItem="$2" ;;
					esac
					shift 2
				;;
				*)
					echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		[ -n "$earlyMember" ] || { echo "$MDSC_CMD: ⛔ ERROR: syntax is <team-member> [--session-id <id>] [--question-key <key>] [--kind <kind>] [--refusal-id <id>] [--address-to <party>] [--task-ref <text>|--item <item>] -- the question text is read from stdin" >&2 ; set +e ; return 1 ; }
		earlyQuestion="$( cat )"
		local earlyFirst earlyFile earlyBest="" earlyBestEpoch=-1
		earlyFirst="$( AgentsToolsDecisionsNorm "$( printf '%s\n' "$earlyQuestion" | LC_ALL=C awk '$0 !~ /^#/ && $0 !~ /^[ \t]*$/ { print ; exit ; }' )" )"
		if [ -n "$earlySession" ] && [ -d "$MMDAPP/.local/agents/pending" ] ; then
			while IFS= read -r earlyFile ; do
				[ -f "$earlyFile" ] || continue
				earlyBest="$( LC_ALL=C awk -v wantKey="$earlyKey" -v wantKind="$earlyKind" -v wantRefusal="$earlyRefusal" -v wantTo="$earlyAddress" -v best="$earlyBest" -v bestEpoch="$earlyBestEpoch" -v wantFirst="$earlyFirst" '
					function norm( text ) { text = tolower( text ) ; gsub( /[^a-z0-9]+/, " ", text ) ; sub( /^ /, "", text ) ; sub( / $/, "", text ) ; return text ; }
					$0 == "---" { dashes++ ; next ; }
					dashes == 1 { colon = index( $0, ": " ) ; if ( colon > 1 ) { key = substr( $0, 1, colon - 1 ) ; if ( ! ( key in val ) ) { val[key] = substr( $0, colon + 2 ) ; } } next ; }
					dashes >= 2 && $0 !~ /^#/ && $0 !~ /^[ \t]*$/ { first = $0 ; exit ; }
					END {
						kind = ( val["kind"] == "" ? "question" : val["kind"] ) ;
						same = ( wantKey != "" && val["question-key"] == wantKey ) || ( length( wantFirst ) >= 12 && norm( first ) == wantFirst ) ;
						taken = ( val["status"] == "reply-received" && kind == wantKind && same && ( wantTo == "" || val["address-to"] == wantTo ) ) ;
						if ( taken && kind == "permission" && val["refusal-id"] != wantRefusal && val["verdict"] != "deny" ) { taken = 0 ; }
						epoch = val["resolved-epoch"] + 0 ;
						if ( taken && epoch > bestEpoch + 0 ) {
							id = FILENAME ; sub( /^.*\//, "", id ) ; sub( /\.md$/, "", id ) ;
							printf "%s\tEARLIER-RECORD %s | %s | %s | %s\n", epoch, id, val["verdict"], val["answered-by"], val["resolved-at"] ;
						} else if ( best != "" ) { printf "%s\t%s\n", bestEpoch, best ; }
					}
				' "$earlyFile" 2>/dev/null )" || earlyBest=""
				earlyBestEpoch="${earlyBest%%$'\t'*}" ; earlyBest="${earlyBest#*$'\t'}"
				[ -n "$earlyBest" ] || earlyBestEpoch=-1
			done < <( LC_ALL=C grep -r -l -x -F --include='*.md' "session-id: $earlySession" "$MMDAPP/.local/agents/pending" 2>/dev/null )
		fi
		if [ -n "$earlyBest" ] ; then
			printf '%s\n' "$earlyBest"
			return 0
		fi
		[ "$earlyKind" != "permission" ] || return 0
		if [ -n "$earlyItem" ] ; then
			earlyItem="${earlyItem##*/}" ; earlyItem="${earlyItem%.md}"
		else
			earlyItem="$( AgentsToolsDecisionsItemFromRef "$earlyTaskRef" "$earlySession" 2>/dev/null )" || earlyItem=""
		fi
		local earlyPath earlyLine
		[ -n "$earlyItem" ] && earlyPath="$( AgentsToolsDecisionsItemPath "$earlyItem" )" || return 0
		## The item's own Decisions, then those of the task it `tracks:`, which a new dispatch shares.
		earlyLine="$( AgentsToolsDecisionsEarlierTracked "$earlyPath" "$earlyQuestion" )" || return 0
		printf 'EARLIER-DECISION %s\n' "$earlyLine"
		return 0
	;;

	## Reminds the addressee of every ask still waiting, on the 30m / 2h / daily schedule
	## (AgentsTools.PendingReplyRemind.include). Run by the main loop after its collect.
	## It only stamps the records it reminded about: it never closes, expires or deletes one.
	--intern-op-pending-reply-remind)
		shift
		MDSC_CMD="$MDSC_CMD --intern-op-pending-reply-remind"
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsContext.UseAgentsTools.include"
		while [ $# -gt 0 ] ; do
			case "$1" in
				--context) shift 2 ;;
				*)
					echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1 -- syntax is [--context <op>]" >&2
					set +e ; return 1
				;;
			esac
		done
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.PendingReplyCollect.include"
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.PendingReplyRemind.include"
		AgentsToolsPendingReplyRemindRun || { set +e ; return 1 ; }
		return 0
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid operation: $1" >&2
		set +e ; return 1
	;;

esac
