#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.InternOpBoardUpsertMoveEdit.include -- the
## --intern-op-board-upsert-move-edit op for DistroAgentsTools.fn.sh's
## dispatcher. Sourced lazily from that exact op's own dispatcher arm (not a
## wildcard -- this file holds one op only) via the standard
## $MDLT_ORIGIN-based path. Not standalone: relies on being dot-sourced for
## $1/$@/$MDSC_CMD.
##

case "$1" in

	--intern-op-board-upsert-move-edit)
		shift
		local opContext="<no --context given>"
		local ctxWanted="" ctxArg
		for ctxArg in "$@" ; do
			if [ -n "$ctxWanted" ] ; then
				opContext="$ctxArg" ; ctxWanted="" ; continue
			fi
			if [ "$ctxArg" = "--context" ] ; then ctxWanted="1" ; fi
		done
		local toState="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$toState" ] || [ -z "$itemName" ] ; then
			echo "$MDSC_CMD: board-upsert-move-edit: ⛔ ERROR: syntax is <to-state> <item-filename> (--from-state:<state>|--create) [--header:<upsert|append|remove>:name[:value]]... [--upsert-from-stdin|--edit-script-from-stdin:<py|awk>|--edit-patch-from-stdin]" >&2
			set +e ; return 1
		fi
		case "$toState" in
			backlog|pending|running|blocked|parked|processed|archived|retained)
			;;
			*)
				echo "$MDSC_CMD: board-upsert-move-edit: ⛔ ERROR: invalid to-state: $toState" >&2
				set +e ; return 1
			;;
		esac
		AgentsToolsAssertBareName "$itemName" "<item-filename>" board-upsert-move-edit || { set +e ; return 1 ; }

		[ -n "${MDAT_DATA_ROOT:-}" ] || {
			echo "$MDSC_CMD: board-upsert-move-edit: ⛔ ERROR: MDAT_DATA_ROOT is not set" >&2
			set +e ; return 1
		}
		local boardRoot="$MDAT_DATA_ROOT/board"
		local fromState="" fromInbox="" isCreate="false" sourcePath="" bodyMode="" scriptLang="" bodyModeCount=0 sourceModeCount=0 msgVerb="wrote"
		local headerOpsFile
		headerOpsFile="$MMDAPP/.local/temp/mdat-intern-op-headers.$$"
		mkdir -p "$MMDAPP/.local/temp" && : > "$headerOpsFile" || { set +e ; return 1 ; }
		trap 'rm -f "$headerOpsFile"' EXIT

		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-state:*)
					fromState="${1#--from-state:}"
					case "$fromState" in
						backlog|pending|running|blocked|parked|processed|archived|retained)
						;;
						*)
							echo "$MDSC_CMD: board-upsert-move-edit: ⛔ ERROR: --from-state: invalid state: $fromState" >&2
							set +e ; return 1
						;;
					esac
					sourcePath="$boardRoot/$fromState/$itemName"
					if [ ! -f "$sourcePath" ] ; then
						echo "$MDSC_CMD: board-upsert-move-edit: ⛔ ERROR: item not found: $sourcePath" >&2
						set +e ; return 1
					fi
					sourceModeCount=$(( sourceModeCount + 1 ))
					shift
				;;
				--from-inbox:*)
					fromInbox="${1#--from-inbox:}"
					AgentsToolsAssertBareName "$fromInbox" "--from-inbox: member name" board-upsert-move-edit || { set +e ; return 1 ; }
					case "$itemName" in
						*.md) ;;
						*)
							echo "$MDSC_CMD: board-upsert-move-edit: ⛔ ERROR: --from-inbox: <item-filename> must end in .md -- every inbox item is a markdown document: $itemName" >&2
							set +e ; return 1
						;;
					esac
					local inboxBase="" inboxDirResolved=""
					inboxBase="$( cd "$MDAT_DATA_ROOT/inboxes" 2>/dev/null && pwd -P )" || inboxBase=""
					if [ -z "$inboxBase" ] ; then
						echo "$MDSC_CMD: board-upsert-move-edit: ⛔ ERROR: no such inbox root: $MDAT_DATA_ROOT/inboxes" >&2
						set +e ; return 1
					fi
					inboxDirResolved="$( cd "$MDAT_DATA_ROOT/inboxes/$fromInbox/processed" 2>/dev/null && pwd -P )" || inboxDirResolved=""
					if [ -z "$inboxDirResolved" ] ; then
						echo "$MDSC_CMD: board-upsert-move-edit: ⛔ ERROR: no such inbox processed directory: $MDAT_DATA_ROOT/inboxes/$fromInbox/processed" >&2
						set +e ; return 1
					fi
					case "$inboxDirResolved" in
						"$inboxBase"/*) ;;
						*)
							echo "$MDSC_CMD: board-upsert-move-edit: ⛔ ERROR: resolved inbox directory escapes the inbox root ($inboxBase): $inboxDirResolved" >&2
							set +e ; return 1
						;;
					esac
					sourcePath="$inboxDirResolved/$itemName"
					if [ ! -f "$sourcePath" ] ; then
						echo "$MDSC_CMD: board-upsert-move-edit: ⛔ ERROR: item not found: $sourcePath" >&2
						set +e ; return 1
					fi
					sourceModeCount=$(( sourceModeCount + 1 ))
					shift
				;;
				--create)
					isCreate="true"
					sourceModeCount=$(( sourceModeCount + 1 ))
					shift
				;;
				--header:*)
					local headerSpec="${1#--header:}"
					local headerOp="${headerSpec%%:*}"
					local headerRest="${headerSpec#*:}"
					local headerName headerValue
					case "$headerRest" in
						*:*) headerName="${headerRest%%:*}" ; headerValue="${headerRest#*:}" ;;
						*)   headerName="$headerRest" ; headerValue="" ;;
					esac
					if [ -z "$headerName" ] ; then
						echo "$MDSC_CMD: board-upsert-move-edit: ⛔ ERROR: --header:$headerOp: field name required" >&2
						set +e ; return 1
					fi
					case "$headerOp" in
						upsert|append)
							if [ -z "$headerValue" ] ; then
								echo "$MDSC_CMD: board-upsert-move-edit: ⛔ ERROR: --header:$headerOp:$headerName requires a value" >&2
								set +e ; return 1
							fi
							if [ "$headerName" = "approved-by" ] ; then
								if ! printf '%s' "$headerValue" | grep -Eq '^[A-Za-z][A-Za-z0-9_-]* \([^,()]+, [0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?Z\)$' ; then
									echo "$MDSC_CMD: board-upsert-move-edit: ⛔ ERROR: --header:$headerOp:approved-by: value must match '<team-member> (<session-id>, <date-time>)' (ISO UTC date-time, suffix Z): $headerValue" >&2
									set +e ; return 1
								fi
							fi
						;;
						remove) : ;;
						*)
							echo "$MDSC_CMD: board-upsert-move-edit: ⛔ ERROR: --header: unrecognized operation: $headerOp (upsert/append/remove)" >&2
							set +e ; return 1
						;;
					esac
					printf '%s\t%s\t%s\n' "$headerOp" "$headerName" "$headerValue" >> "$headerOpsFile"
					shift
				;;
				--upsert-from-stdin)
					bodyMode="stdin"
					bodyModeCount=$(( bodyModeCount + 1 ))
					shift
				;;
				--edit-script-from-stdin:*)
					scriptLang="${1#--edit-script-from-stdin:}"
					case "$scriptLang" in
						py|awk) ;;
						*)
							echo "$MDSC_CMD: board-upsert-move-edit: ⛔ ERROR: --edit-script-from-stdin must be :py or :awk: $scriptLang" >&2
							set +e ; return 1
						;;
					esac
					bodyMode="script"
					bodyModeCount=$(( bodyModeCount + 1 ))
					shift
				;;
				--edit-patch-from-stdin)
					bodyMode="patch"
					bodyModeCount=$(( bodyModeCount + 1 ))
					shift
				;;
				--context)
					if [ -z "${2:-}" ] ; then
						echo "$MDSC_CMD: board-upsert-move-edit: ⛔ ERROR: --context: value required" >&2
						set +e ; return 1
					fi
					shift 2
				;;
				--log-verb:*)
					msgVerb="${1#--log-verb:}"
					shift
				;;
				*)
					echo "$MDSC_CMD: board-upsert-move-edit: ⛔ ERROR: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done

		if [ "$sourceModeCount" -eq 0 ] ; then
			echo "$MDSC_CMD: board-upsert-move-edit: ⛔ ERROR: exactly one of --from-state:<state>, --from-inbox:<member>, or --create is required" >&2
			set +e ; return 1
		fi
		if [ "$sourceModeCount" -gt 1 ] ; then
			echo "$MDSC_CMD: board-upsert-move-edit: ⛔ ERROR: --from-state:, --from-inbox:, and --create are mutually exclusive" >&2
			set +e ; return 1
		fi

		if [ "$bodyModeCount" -gt 1 ] ; then
			echo "$MDSC_CMD: board-upsert-move-edit: ⛔ ERROR: --upsert-from-stdin, --edit-script-from-stdin, and --edit-patch-from-stdin are mutually exclusive" >&2
			set +e ; return 1
		fi

		local targetDir="$boardRoot/$toState"
		if [ ! -d "$targetDir" ] ; then
			echo "$MDSC_CMD: board-upsert-move-edit: ⛔ ERROR: no such board state directory: $targetDir" >&2
			set +e ; return 1
		fi
		local targetPath="$targetDir/$itemName"

		local body
		if [ "$bodyMode" = "script" ] ; then
			local scriptContent existingContent scriptFile
			scriptContent="$( cat )"
			if [ "$isCreate" = "true" ] ; then existingContent="" ; else existingContent="$( cat "$sourcePath" )" ; fi
			scriptFile="$MMDAPP/.local/temp/mdat-intern-op-script.$$"
			mkdir -p "$MMDAPP/.local/temp" && : > "$scriptFile" || { set +e ; return 1 ; }
			printf '%s' "$scriptContent" > "$scriptFile"
			case "$scriptLang" in
				py)  body="$( printf '%s\n' "$existingContent" | python3 "$scriptFile" )" ;;
				awk) body="$( printf '%s\n' "$existingContent" | LC_ALL=C awk -f "$scriptFile" )" ;;
			esac
			rm -f "$scriptFile"
		elif [ "$bodyMode" = "stdin" ] ; then
			body="$( cat )"
		elif [ "$bodyMode" = "patch" ] ; then
			local patchJson existingContent contentFile patchFile
			patchJson="$( cat )"
			if [ "$isCreate" = "true" ] ; then existingContent="" ; else existingContent="$( cat "$sourcePath" )" ; fi
			contentFile="$MMDAPP/.local/temp/mdat-intern-op-patch-content.$$"
			mkdir -p "$MMDAPP/.local/temp" && : > "$contentFile" || { set +e ; return 1 ; }
			patchFile="$MMDAPP/.local/temp/mdat-intern-op-patch-spec.$$"
			mkdir -p "$MMDAPP/.local/temp" && : > "$patchFile" || { set +e ; return 1 ; }
			printf '%s' "$existingContent" > "$contentFile"
			printf '%s' "$patchJson" > "$patchFile"
			body="$( python3 "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsBoardItemPatchApply.py" "$contentFile" "$patchFile" )"
			rm -f "$contentFile" "$patchFile"
		else
			if [ "$isCreate" = "true" ] ; then
				body="---"$'\n'"---"
			else
				body="$( cat "$sourcePath" )"
			fi
		fi

		if [ -s "$headerOpsFile" ] ; then
			body="$( printf '%s\n' "$body" | LC_ALL=C awk -v opsFile="$headerOpsFile" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsBoardItemHeaderOpsApply.awk" )" || { rm -f "$headerOpsFile" ; set +e ; return 1 ; }
		fi

		if [ -z "$body" ] ; then
			echo "$MDSC_CMD: board-upsert-move-edit: ⛔ ERROR: empty result -- refusing to write an empty board item" >&2
			set +e ; return 1
		fi

		local tmpFile
		tmpFile="$MMDAPP/.local/temp/mdat-intern-op-result.$$"
		mkdir -p "$MMDAPP/.local/temp" && : > "$tmpFile" || { set +e ; return 1 ; }
		printf '%s\n' "$body" > "$tmpFile"
		mv "$tmpFile" "$targetPath"

		if [ "$isCreate" = "false" ] && [ "$sourcePath" != "$targetPath" ] ; then
			if [ -n "$fromInbox" ] ; then
				## `--` guards a later edit that bypasses validation.
				rm -f -- "$sourcePath"
				echo "# $MDSC_CMD: board-upsert-move-edit: $msgVerb ${targetPath#"$boardRoot"/}, previous ${sourcePath#"$boardRoot"/} deleted" >&2
			else
				mv -- "$sourcePath" "$MDAT_DATA_ROOT/trash/$itemName"
				echo "# $MDSC_CMD: board-upsert-move-edit: $msgVerb ${targetPath#"$boardRoot"/}, previous ${sourcePath#"$boardRoot"/} moved to $MDAT_DATA_ROOT/trash/$itemName" >&2
			fi
		else
			echo "# $MDSC_CMD: board-upsert-move-edit: $msgVerb ${targetPath#"$boardRoot"/}" >&2
		fi

		rm -f "$headerOpsFile"
		trap - EXIT
		return 0
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
