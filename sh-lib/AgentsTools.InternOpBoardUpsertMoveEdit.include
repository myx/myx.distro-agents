#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.InternOpBoardUpsertMoveEdit.include -- the
## --intern-op-board-upsert-move-edit op for DistroAgentsTools.fn.sh's
## dispatcher. Sourced lazily from that exact op's own dispatcher arm (not a
## wildcard -- this file holds one op only) via the standard
## $MDLT_ORIGIN-based path. Not standalone: relies on being dot-sourced for
## $1/$@/$MDSC_CMD.
##
## No --help entry: this is internal plumbing. Real board-write policy
## (mandatory fields per state transition, audit stamps like groomed-at)
## lives in the caller (e.g. AgentsTools.MagicGrooming.include's
## --magic-grooming-* ops), not here. This is the one generic, reusable
## move/edit/upsert mechanism every such caller shares -- "Make all similar
## use it." One deliberate exception: `approved-by`'s own value SHAPE
## (`<team-member> (<session-id>, <date-time>)`) is validated right here,
## in the shared --header:* parsing below, not duplicated per caller --
## it's a fact about the field itself (magic-team.armed.md's own field
## definition), not one caller's transition-specific policy, so every
## current/future header-writing caller gets the same check for free.
##
## Header-ops apply logic (upsert/append/remove against the body's
## frontmatter) is externalized to AgentsBoardItemHeaderOpsApply.awk, per
## this package's own externalize-awk/py convention (see
## AgentsBoardItemFrontmatterPrint.awk's own header comment for that name) --
## unconditional, no size-based exception.
##

case "$1" in

	## <to-state> <item-filename> (--from-state:<state>|--from-inbox:<member>|--create)
	##   [--header:<upsert|append|remove>:name[:value]]...
	##   [--upsert-from-stdin|--edit-script-from-stdin:<py|awk>|--edit-patch-from-stdin]
	##
	## Source selection: exactly one of the three. --from-state:<state> reads
	## board/<state>/<item-filename>; --from-inbox:<member> reads
	## inboxes/<member>/processed/<item-filename>; --create starts fresh.
	## --from-inbox: is colon-style to match its --from-state: sibling, NOT a
	## spaced `--from-inbox <member>` pair: a spaced pair silently swallows a
	## neighbouring option, so `--from-inbox --create` would set the member name
	## to the literal string "--create" and fail far from the real mistake.
	##
	## ONE-WAY DOOR on the inbox source: there is no --to-inbox: counterpart.
	## A board->board move reverses by swapping the two states; an inbox->board
	## move has no inverse. Callers must treat it as final.
	##
	## Body resolution (in order): --edit-script-from-stdin runs the given
	## py/awk script (read from this op's own stdin) against the existing
	## content (empty on --create) and takes its stdout as the new body;
	## --upsert-from-stdin takes this op's stdin verbatim as the new body;
	## --edit-patch-from-stdin reads a JSON array of
	## `{"old": <text>, "new": <text>, "replace_all": <bool, default false>}`
	## patch objects from this op's own stdin and applies each, in order,
	## against the existing content (empty on --create) as an exact literal
	## (non-regex) substring match-and-replace -- each patch's `old` must
	## match exactly once unless `replace_all` is true, in which case every
	## occurrence is replaced; a patch whose `old` is not found, or matches
	## more than once without `replace_all`, fails the whole op loud (no
	## partial write, original file untouched) before anything reaches
	## disk; patch N+1 matches against the result of patch N, same as
	## several `Edit`-tool calls run in sequence. Externalized as
	## AgentsBoardItemPatchApply.py per this package's own externalize-awk/py
	## convention (see AgentsBoardItemFrontmatterPrint.awk). None of the
	## three given means the body is the existing content unchanged
	## (--create with neither starts from an empty `---`/`---` frontmatter
	## skeleton, so --header:upsert has somewhere to land). The three
	## body-input modes are mutually exclusive. --header:* ops apply on top
	## of the resolved body, in the order given (repeat upserts/removes on
	## the same field: last wins; repeat appends on the same field:
	## cumulative, in order) -- then the result is written to a temp file
	## and `mv`'d into place atomically. On an actual move (--from-state !=
	## <to-state>), the OLD file is `mv`'d to trash/ (a standalone sibling
	## of board/, not one of its own states) rather than removed -- not
	## destroyed, just relocated, for now.
	--intern-op-board-upsert-move-edit)
		shift
		## --context <caller-op>: the operation the caller actually invoked,
		## carried as data on the call rather than inferred from re-entry or
		## shell scoping. Pre-scanned here, before any validation, so every
		## message in this arm can name it -- including the ones that fire
		## before the option loop below ever runs. That loop consumes
		## --context again as an ordinary option; this scan only reads it.
		## Absent, it stays the explicit "<no --context given>" literal --
		## never blank, so a caller that did not pass one is visibly missing
		## it rather than silently printing nothing.
		local opContext="<no --context given>"
		local ctxWanted="" ctxArg
		for ctxArg in "$@" ; do
			if [ -n "$ctxWanted" ] ; then
				opContext="$ctxArg" ; ctxWanted="" ; continue
			fi
			if [ "$ctxArg" = "--context" ] ; then ctxWanted="1" ; fi
		done
		local toState="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$toState" ] || [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-op-board-upsert-move-edit (internal operation, invoked via $opContext): syntax is <to-state> <item-filename> (--from-state:<state>|--create) [--header:<upsert|append|remove>:name[:value]]... [--upsert-from-stdin|--edit-script-from-stdin:<py|awk>|--edit-patch-from-stdin]" >&2
			set +e ; return 1
		fi
		case "$toState" in
			backlog|pending|running|blocked|parked|processed|archived|retained)
			;;
			*)
				echo "⛔ ERROR: $MDSC_CMD --intern-op-board-upsert-move-edit (internal operation, invoked via $opContext): invalid to-state: $toState" >&2
				set +e ; return 1
			;;
		esac
		AgentsToolsAssertBareName "$itemName" "<item-filename>" "$MDSC_CMD --intern-op-board-upsert-move-edit (internal operation, invoked via $opContext)" || { set +e ; return 1 ; }

		[ -n "${MDAT_DATA_ROOT:-}" ] || {
			echo "⛔ ERROR: $MDSC_CMD --intern-op-board-upsert-move-edit (internal operation, invoked via $opContext): MDAT_DATA_ROOT is not set" >&2
			set +e ; return 1
		}
		local boardRoot="$MDAT_DATA_ROOT/board"
		local fromState="" fromInbox="" isCreate="false" sourcePath="" bodyMode="" scriptLang="" bodyModeCount=0 sourceModeCount=0
		local headerOpsFile
		headerOpsFile="$( mktemp "${TMPDIR:-/tmp}/mdat-intern-op-headers.XXXXXX" )" || { set +e ; return 1 ; }
		trap 'rm -f "$headerOpsFile"' EXIT

		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-state:*)
					fromState="${1#--from-state:}"
					case "$fromState" in
						backlog|pending|running|blocked|parked|processed|archived|retained)
						;;
						*)
							echo "⛔ ERROR: $MDSC_CMD --intern-op-board-upsert-move-edit (internal operation, invoked via $opContext): --from-state: invalid state: $fromState" >&2
							set +e ; return 1
						;;
					esac
					sourcePath="$boardRoot/$fromState/$itemName"
					if [ ! -f "$sourcePath" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --intern-op-board-upsert-move-edit (internal operation, invoked via $opContext): item not found: $sourcePath" >&2
						set +e ; return 1
					fi
					sourceModeCount=$(( sourceModeCount + 1 ))
					shift
				;;
				--from-inbox:*)
					fromInbox="${1#--from-inbox:}"
					AgentsToolsAssertBareName "$fromInbox" "--from-inbox: member name" "$MDSC_CMD --intern-op-board-upsert-move-edit (internal operation, invoked via $opContext)" || { set +e ; return 1 ; }
					case "$itemName" in
						*.md) ;;
						*)
							echo "⛔ ERROR: $MDSC_CMD --intern-op-board-upsert-move-edit (internal operation, invoked via $opContext): --from-inbox: <item-filename> must end in .md -- every inbox item is a markdown document: $itemName" >&2
							set +e ; return 1
						;;
					esac
					##
					## DELIBERATELY ABSENT: no inbox type-prefix whitelist. The
					## types an inbox is *written* with are note-/inquiry-/
					## reflection-, but the items this source exists to relocate
					## are task-/proposal-/change-/interview-. A prefix
					## whitelist would reject exactly the files the operation
					## was built to move. Do not add one.
					##
					## `processed/` below is a FIXED LITERAL this op appends --
					## deliberately not caller-supplied. Measured: the whole
					## domain of that path segment is one value (6 of the 13
					## inboxes carry a `processed` subdirectory, nothing else,
					## no deeper nesting). The literal can be widened into a
					## parameter later; a parameter could never be narrowed
					## back. Not an oversight.
					##
					## `cd` + `pwd -P` rather than `realpath` (not POSIX) or
					## `readlink -f` (absent on macOS before Monterey).
					##
					local inboxBase="" inboxDirResolved=""
					inboxBase="$( cd "$MDAT_DATA_ROOT/inboxes" 2>/dev/null && pwd -P )" || inboxBase=""
					if [ -z "$inboxBase" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --intern-op-board-upsert-move-edit (internal operation, invoked via $opContext): no such inbox root: $MDAT_DATA_ROOT/inboxes" >&2
						set +e ; return 1
					fi
					inboxDirResolved="$( cd "$MDAT_DATA_ROOT/inboxes/$fromInbox/processed" 2>/dev/null && pwd -P )" || inboxDirResolved=""
					if [ -z "$inboxDirResolved" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --intern-op-board-upsert-move-edit (internal operation, invoked via $opContext): no such inbox processed directory: $MDAT_DATA_ROOT/inboxes/$fromInbox/processed" >&2
						set +e ; return 1
					fi
					## Containment tested WITH the separator -- "$inboxBase"/* ,
					## never a bare "$inboxBase"* prefix: /data/inboxes-evil/x
					## passes the bare prefix test and correctly fails this one.
					case "$inboxDirResolved" in
						"$inboxBase"/*) ;;
						*)
							echo "⛔ ERROR: $MDSC_CMD --intern-op-board-upsert-move-edit (internal operation, invoked via $opContext): resolved inbox directory escapes the inbox root ($inboxBase): $inboxDirResolved" >&2
							set +e ; return 1
						;;
					esac
					sourcePath="$inboxDirResolved/$itemName"
					if [ ! -f "$sourcePath" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --intern-op-board-upsert-move-edit (internal operation, invoked via $opContext): item not found: $sourcePath" >&2
						set +e ; return 1
					fi
					sourceModeCount=$(( sourceModeCount + 1 ))
					shift
				;;
				--create)
					isCreate="true"
					sourceModeCount=$(( sourceModeCount + 1 ))
					shift
				;;
				--header:*)
					local headerSpec="${1#--header:}"
					local headerOp="${headerSpec%%:*}"
					local headerRest="${headerSpec#*:}"
					local headerName headerValue
					case "$headerRest" in
						*:*) headerName="${headerRest%%:*}" ; headerValue="${headerRest#*:}" ;;
						*)   headerName="$headerRest" ; headerValue="" ;;
					esac
					if [ -z "$headerName" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --intern-op-board-upsert-move-edit (internal operation, invoked via $opContext): --header:$headerOp: field name required" >&2
						set +e ; return 1
					fi
					case "$headerOp" in
						upsert|append)
							if [ -z "$headerValue" ] ; then
								echo "⛔ ERROR: $MDSC_CMD --intern-op-board-upsert-move-edit (internal operation, invoked via $opContext): --header:$headerOp:$headerName requires a value" >&2
								set +e ; return 1
							fi
							## approved-by's required shape: `<team-member>
							## (<session-id>, <date-time>)`. <team-member> is a
							## bare name (letters/digits/hyphen, same bare-name
							## family as <item-filename>'s own convention
							## elsewhere in this file). <session-id> is
							## deliberately unconstrained beyond "no comma/
							## parens inside it" -- both a
							## $CLAUDE_CODE_SESSION_ID (interactive harness/IDE
							## chat session) and a --console-start
							## console-channel-id
							## (myx.distro-agent-console.<slug>.<console>, see
							## DistroAgentsTools.fn.sh's own
							## MDAT_CHANNEL_PREFIX) are valid shapes, and
							## hardcoding either one specifically would reject
							## the other. <date-time> reuses the exact
							## ISO-UTC-with-Z-suffix regex already established
							## for --member-append-session-transcript's
							## --timestamp (AgentsTools.Member.include), not a
							## new format invented here.
							if [ "$headerName" = "approved-by" ] ; then
								if ! printf '%s' "$headerValue" | grep -Eq '^[A-Za-z][A-Za-z0-9_-]* \([^,()]+, [0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?Z\)$' ; then
									echo "⛔ ERROR: $MDSC_CMD --intern-op-board-upsert-move-edit (internal operation, invoked via $opContext): --header:$headerOp:approved-by: value must match '<team-member> (<session-id>, <date-time>)' (ISO UTC date-time, suffix Z): $headerValue" >&2
									set +e ; return 1
								fi
							fi
						;;
						remove) : ;;
						*)
							echo "⛔ ERROR: $MDSC_CMD --intern-op-board-upsert-move-edit (internal operation, invoked via $opContext): --header: unrecognized operation: $headerOp (upsert/append/remove)" >&2
							set +e ; return 1
						;;
					esac
					printf '%s\t%s\t%s\n' "$headerOp" "$headerName" "$headerValue" >> "$headerOpsFile"
					shift
				;;
				--upsert-from-stdin)
					bodyMode="stdin"
					bodyModeCount=$(( bodyModeCount + 1 ))
					shift
				;;
				--edit-script-from-stdin:*)
					scriptLang="${1#--edit-script-from-stdin:}"
					case "$scriptLang" in
						py|awk) ;;
						*)
							echo "⛔ ERROR: $MDSC_CMD --intern-op-board-upsert-move-edit (internal operation, invoked via $opContext): --edit-script-from-stdin must be :py or :awk: $scriptLang" >&2
							set +e ; return 1
						;;
					esac
					bodyMode="script"
					bodyModeCount=$(( bodyModeCount + 1 ))
					shift
				;;
				--edit-patch-from-stdin)
					bodyMode="patch"
					bodyModeCount=$(( bodyModeCount + 1 ))
					shift
				;;
				--context)
					if [ -z "${2:-}" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --intern-op-board-upsert-move-edit (internal operation, invoked via $opContext): --context: value required" >&2
						set +e ; return 1
					fi
					shift 2
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --intern-op-board-upsert-move-edit (internal operation, invoked via $opContext): invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done

		## Source-group exclusivity via a counter, the same idiom bodyModeCount
		## below already uses -- not a pairwise comparison. With three members
		## (--from-state:, --from-inbox:, --create) a pairwise check catches
		## only one of the possible orderings, an asymmetric gap that widens
		## with every source added.
		if [ "$sourceModeCount" -eq 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-op-board-upsert-move-edit (internal operation, invoked via $opContext): exactly one of --from-state:<state>, --from-inbox:<member>, or --create is required" >&2
			set +e ; return 1
		fi
		if [ "$sourceModeCount" -gt 1 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-op-board-upsert-move-edit (internal operation, invoked via $opContext): --from-state:, --from-inbox:, and --create are mutually exclusive" >&2
			set +e ; return 1
		fi

		## Pre-flight trash-collision refusal, for the --from-inbox: source only.
		## Hoisted here deliberately: the later check further down runs AFTER the
		## new board item has already been written, so a collision detected there
		## aborts with the item DUPLICATED -- written into <to-state> and still
		## sitting in the inbox. Refusing before any write means the failure
		## leaves the tree exactly as it was found.
		##
		## The predicate depends on nothing the write produces -- both
		## $fromInbox and $itemName are settled by the exclusivity check above --
		## so this costs no restructuring of the option loop.
		##
		## The later check is deliberately KEPT rather than replaced. Two checks
		## around one write is the correct shape, not redundancy: this one makes
		## the common case clean, and the late one still catches a file that
		## appeared in trash/ during the write. Neither subsumes the other.
		##
		## No sourcePath/targetPath equality term is needed here the way the
		## late check needs one: for the inbox source, sourcePath is under
		## inboxes/ and targetPath under board/, so they can never be equal.
		if [ -n "$fromInbox" ] && [ -e "$MDAT_DATA_ROOT/trash/$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-op-board-upsert-move-edit (internal operation, invoked via $opContext): trash target already exists, refusing to overwrite: $MDAT_DATA_ROOT/trash/$itemName (nothing written; source left in place)" >&2
			set +e ; return 1
		fi
		## Three-way check via a counter, not a pairwise scriptLang/bodyMode
		## comparison -- a pairwise check only catches one of the six
		## possible orderings across three flags, an asymmetric gap that
		## widens (not narrows) once --edit-patch-from-stdin joins the set.
		if [ "$bodyModeCount" -gt 1 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-op-board-upsert-move-edit (internal operation, invoked via $opContext): --upsert-from-stdin, --edit-script-from-stdin, and --edit-patch-from-stdin are mutually exclusive" >&2
			set +e ; return 1
		fi

		local targetDir="$boardRoot/$toState"
		if [ ! -d "$targetDir" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-op-board-upsert-move-edit (internal operation, invoked via $opContext): no such board state directory: $targetDir" >&2
			set +e ; return 1
		fi
		local targetPath="$targetDir/$itemName"

		local body
		if [ "$bodyMode" = "script" ] ; then
			local scriptContent existingContent scriptFile
			scriptContent="$( cat )"
			if [ "$isCreate" = "true" ] ; then existingContent="" ; else existingContent="$( cat "$sourcePath" )" ; fi
			scriptFile="$( mktemp "${TMPDIR:-/tmp}/mdat-intern-op-script.XXXXXX" )" || { set +e ; return 1 ; }
			printf '%s' "$scriptContent" > "$scriptFile"
			case "$scriptLang" in
				py)  body="$( printf '%s\n' "$existingContent" | python3 "$scriptFile" )" ;;
				awk) body="$( printf '%s\n' "$existingContent" | LC_ALL=C awk -f "$scriptFile" )" ;;
			esac
			rm -f "$scriptFile"
		elif [ "$bodyMode" = "stdin" ] ; then
			body="$( cat )"
		elif [ "$bodyMode" = "patch" ] ; then
			local patchJson existingContent contentFile patchFile
			patchJson="$( cat )"
			if [ "$isCreate" = "true" ] ; then existingContent="" ; else existingContent="$( cat "$sourcePath" )" ; fi
			contentFile="$( mktemp "${TMPDIR:-/tmp}/mdat-intern-op-patch-content.XXXXXX" )" || { set +e ; return 1 ; }
			patchFile="$( mktemp "${TMPDIR:-/tmp}/mdat-intern-op-patch-spec.XXXXXX" )" || { set +e ; return 1 ; }
			printf '%s' "$existingContent" > "$contentFile"
			printf '%s' "$patchJson" > "$patchFile"
			body="$( python3 "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsBoardItemPatchApply.py" "$contentFile" "$patchFile" )"
			rm -f "$contentFile" "$patchFile"
		else
			if [ "$isCreate" = "true" ] ; then
				body='---
---'
			else
				body="$( cat "$sourcePath" )"
			fi
		fi

		if [ -s "$headerOpsFile" ] ; then
			local bodyTmp
			bodyTmp="$( mktemp "${TMPDIR:-/tmp}/mdat-intern-op-body.XXXXXX" )" || { set +e ; return 1 ; }
			printf '%s\n' "$body" > "$bodyTmp"
			body="$( LC_ALL=C awk -v opsFile="$headerOpsFile" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsBoardItemHeaderOpsApply.awk" "$bodyTmp" )"
			rm -f "$bodyTmp"
		fi

		if [ -z "$body" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-op-board-upsert-move-edit (internal operation, invoked via $opContext): empty result -- refusing to write an empty board item" >&2
			set +e ; return 1
		fi

		local tmpFile
		tmpFile="$( mktemp "${TMPDIR:-/tmp}/mdat-intern-op-result.XXXXXX" )" || { set +e ; return 1 ; }
		printf '%s\n' "$body" > "$tmpFile"
		mv "$tmpFile" "$targetPath"

		if [ "$isCreate" = "false" ] && [ "$sourcePath" != "$targetPath" ] ; then
			##
			## HAZARD: trash/ is FLAT and `mv` has no -n, so a basename
			## collision overwrites silently, exit 0, no diagnostic. Asserted
			## for the inbox source only -- the board-sourced path predates this
			## arm and is deliberately left behaving exactly as it did. `--`
			## before the operands is independent of that: validation guards bad
			## input, `--` guards a later edit that bypasses validation.
			##
			if [ -n "$fromInbox" ] && [ -e "$MDAT_DATA_ROOT/trash/$itemName" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --intern-op-board-upsert-move-edit (internal operation, invoked via $opContext): trash target already exists, refusing to overwrite: $MDAT_DATA_ROOT/trash/$itemName (new item already written to $targetPath; source left in place: $sourcePath)" >&2
				set +e ; return 1
			fi
			mv -- "$sourcePath" "$MDAT_DATA_ROOT/trash/$itemName"
			echo "# $MDSC_CMD --intern-op-board-upsert-move-edit: wrote $targetPath, previous $sourcePath moved to $MDAT_DATA_ROOT/trash/$itemName" >&2
		else
			echo "# $MDSC_CMD --intern-op-board-upsert-move-edit: wrote $targetPath" >&2
		fi

		rm -f "$headerOpsFile"
		trap - EXIT
		return 0
	;;

	*)
		echo "⛔ ERROR: $MDSC_CMD: invalid option: $1 (invoked via $opContext) -- rejected by AgentsTools.InternOpBoardUpsertMoveEdit.include's own default (*) branch, the operation group sourced by the --intern-op-board-upsert-move-edit dispatcher route; no operation of that name is defined in this include" >&2
		set +e ; return 1
	;;
esac
