#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.InternOpBoardUpsertMoveEdit.include -- the
## --intern-op-board-upsert-move-edit op for DistroAgentsTools.fn.sh's
## dispatcher. Sourced lazily from that exact op's own dispatcher arm (not a
## wildcard -- this file holds one op only) via the standard
## $MDLT_ORIGIN-based path. Not standalone: relies on being dot-sourced for
## $1/$@/$MDSC_CMD.
##

. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.OutputStyle.include"
. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.RecheckDate.include"

case "$1" in

	--intern-op-board-upsert-move-edit)
		shift
		local opContext="<no --context given>"
		local ctxWanted="" ctxArg
		for ctxArg in "$@" ; do
			if [ -n "$ctxWanted" ] ; then
				opContext="$ctxArg" ; ctxWanted="" ; continue
			fi
			if [ "$ctxArg" = "--context" ] ; then ctxWanted="1" ; fi
		done
		local toState="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$toState" ] || [ -z "$itemName" ] ; then
			echo "$MDSC_CMD: board-upsert-move-edit: ⛔ ERROR: syntax is <to-state> <item-filename> (--from-state:<state>|--create [--acting-member:<member>]) [--header:<upsert|append|remove>:name[:value]]... [--upsert-from-stdin|--edit-script-from-stdin:<py|awk>|--edit-patch-from-stdin]" >&2
			set +e ; return 1
		fi
		case "$toState" in
			backlog|pending|running|review|blocked|parked|processed|archived|retained)
			;;
			*)
				echo "$MDSC_CMD: board-upsert-move-edit: ⛔ ERROR: invalid to-state: $toState" >&2
				set +e ; return 1
			;;
		esac
		AgentsToolsAssertBareName "$itemName" "<item-filename>" board-upsert-move-edit || { set +e ; return 1 ; }

		[ -n "${MDAT_DATA_ROOT:-}" ] || {
			echo "$MDSC_CMD: board-upsert-move-edit: ⛔ ERROR: MDAT_DATA_ROOT is not set" >&2
			set +e ; return 1
		}
		local boardRoot="$MDAT_DATA_ROOT/board"
		local fromState="" isCreate="false" sourcePath="" bodyMode="" scriptLang="" bodyModeCount=0 sourceModeCount=0 msgVerb="wrote" actingMember=""
		## Space-delimited field names the caller named in --header:, for the move stamp's override check.
		local callerHeaderFields=""
		## Header ops accumulate here and are materialised once, immediately before
		## the .awk that reads them by path -- so no early return can leak a file.
		local headerOps=""
		local recheckIn=""

		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-state:*)
					fromState="${1#--from-state:}"
					case "$fromState" in
						backlog|pending|running|review|blocked|parked|processed|archived|retained)
						;;
						*)
							echo "$MDSC_CMD: board-upsert-move-edit: ⛔ ERROR: --from-state: invalid state: $fromState" >&2
							set +e ; return 1
						;;
					esac
					sourcePath="$boardRoot/$fromState/$itemName"
					if [ ! -f "$sourcePath" ] ; then
						echo "$MDSC_CMD: board-upsert-move-edit: ⛔ ERROR: item not found: $sourcePath" >&2
						set +e ; return 1
					fi
					sourceModeCount=$(( sourceModeCount + 1 ))
					shift
				;;
				--create)
					isCreate="true"
					sourceModeCount=$(( sourceModeCount + 1 ))
					shift
				;;
				--header:*)
					local headerSpec="${1#--header:}"
					local headerOp="${headerSpec%%:*}"
					local headerRest="${headerSpec#*:}"
					local headerName headerValue
					case "$headerRest" in
						*:*) headerName="${headerRest%%:*}" ; headerValue="${headerRest#*:}" ;;
						*)   headerName="$headerRest" ; headerValue="" ;;
					esac
					if [ -z "$headerName" ] ; then
						echo "$MDSC_CMD: board-upsert-move-edit: ⛔ ERROR: --header:$headerOp: field name required" >&2
						set +e ; return 1
					fi
					case "$headerOp" in
						upsert|append)
							if [ -z "$headerValue" ] ; then
								echo "$MDSC_CMD: board-upsert-move-edit: ⛔ ERROR: --header:$headerOp:$headerName requires a value" >&2
								set +e ; return 1
							fi
							if [ "$headerName" = "approved-by" ] ; then
								if ! printf '%s' "$headerValue" | grep -Eq '^[A-Za-z][A-Za-z0-9_-]* \([^,()]+, [0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?Z\)$' ; then
									echo "$MDSC_CMD: board-upsert-move-edit: ⛔ ERROR: --header:$headerOp:approved-by: value must match '<team-member> (<session-id>, <date-time>)' (ISO UTC date-time, suffix Z): $headerValue" >&2
									set +e ; return 1
								fi
							fi
						;;
						remove) : ;;
						*)
							echo "$MDSC_CMD: board-upsert-move-edit: ⛔ ERROR: --header: unrecognized operation: $headerOp (upsert/append/remove)" >&2
							set +e ; return 1
						;;
					esac
					callerHeaderFields="$callerHeaderFields $headerName"
					headerOps="$headerOps$headerOp"$'\t'"$headerName"$'\t'"$headerValue"$'\n'
					shift
				;;
				--upsert-from-stdin)
					bodyMode="stdin"
					bodyModeCount=$(( bodyModeCount + 1 ))
					shift
				;;
				--edit-script-from-stdin:*)
					scriptLang="${1#--edit-script-from-stdin:}"
					case "$scriptLang" in
						py|awk) ;;
						*)
							echo "$MDSC_CMD: board-upsert-move-edit: ⛔ ERROR: --edit-script-from-stdin must be :py or :awk: $scriptLang" >&2
							set +e ; return 1
						;;
					esac
					bodyMode="script"
					bodyModeCount=$(( bodyModeCount + 1 ))
					shift
				;;
				--edit-patch-from-stdin)
					bodyMode="patch"
					bodyModeCount=$(( bodyModeCount + 1 ))
					shift
				;;
				--context)
					if [ -z "${2:-}" ] ; then
						echo "$MDSC_CMD: board-upsert-move-edit: ⛔ ERROR: --context: value required" >&2
						set +e ; return 1
					fi
					shift 2
				;;
				## recheck-date = now + <minutes>, ± up to <jitter> random minutes; an explicit --header: naming recheck-date wins.
				--recheck-in)
					recheckIn="$( AgentsToolsRecheckDate "${2:-}" )" || recheckIn=""
					if [ -z "$recheckIn" ] ; then
						echo "$MDSC_CMD: board-upsert-move-edit: ⛔ ERROR: --recheck-in: value must be <minutes>[±<jitter-minutes>]: ${2:-}" >&2
						set +e ; return 1
					fi
					shift 2
				;;
				--log-verb:*)
					msgVerb="${1#--log-verb:}"
					shift
				;;
				## Who is creating the item: the `from` a --create stamps when the body names none.
				--acting-member:*)
					actingMember="${1#--acting-member:}"
					## Not a bare name: no `from` is stamped, and the write goes on -- the caller's
					## <team-member> was never validated before this stamp existed.
					[ -z "$actingMember" ] || AgentsToolsAssertBareName "$actingMember" "--acting-member:" board-upsert-move-edit 2>/dev/null || actingMember=""
					shift
				;;
				*)
					echo "$MDSC_CMD: board-upsert-move-edit: ⛔ ERROR: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done

		if [ "$sourceModeCount" -eq 0 ] ; then
			echo "$MDSC_CMD: board-upsert-move-edit: ⛔ ERROR: exactly one of --from-state:<state> or --create is required" >&2
			set +e ; return 1
		fi
		if [ "$sourceModeCount" -gt 1 ] ; then
			echo "$MDSC_CMD: board-upsert-move-edit: ⛔ ERROR: --from-state: and --create are mutually exclusive" >&2
			set +e ; return 1
		fi
		## A new item's name is <type>-<YYYYMMDD'T'HHmm'Z' or HHmmSS'Z'>[-<slug>].md. Only creation
		## is checked, and a rename's husk keeps the name it supersedes.
		local shapeRequired="false"
		if [ "$isCreate" = "true" ] && [ "$opContext" != "--intern-op-board-rename" ] ; then
			shapeRequired="true"
			. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.ItemNameShape.include"
			AgentsToolsItemNameShapeCheck "$itemName" board-upsert-move-edit --create
		fi

		if [ "$bodyModeCount" -gt 1 ] ; then
			echo "$MDSC_CMD: board-upsert-move-edit: ⛔ ERROR: --upsert-from-stdin, --edit-script-from-stdin, and --edit-patch-from-stdin are mutually exclusive" >&2
			set +e ; return 1
		fi

		## --recheck-in's date (AgentsToolsRecheckDate), after the caller's ops; a caller's --header: naming recheck-date wins.
		case "$recheckIn: $callerHeaderFields " in
			:*|*" recheck-date "*) ;;
			*) headerOps="${headerOps}upsert"$'\t'"recheck-date"$'\t'"$recheckIn"$'\n' ;;
		esac

		local targetDir="$boardRoot/$toState"
		if [ ! -d "$targetDir" ] ; then
			echo "$MDSC_CMD: board-upsert-move-edit: ⛔ ERROR: no such board state directory: $targetDir" >&2
			set +e ; return 1
		fi
		local targetPath="$targetDir/$itemName"

		local body
		if [ "$bodyMode" = "script" ] ; then
			## Both interpreters take the program as an argument, so the script
			## read from stdin never becomes a file.
			local scriptContent existingContent
			scriptContent="$( cat )"
			if [ "$isCreate" = "true" ] ; then existingContent="" ; else existingContent="$( cat "$sourcePath" )" ; fi
			case "$scriptLang" in
				py)  body="$( printf '%s\n' "$existingContent" | python3 -c "$scriptContent" )" ;;
				awk) body="$( printf '%s\n' "$existingContent" | LC_ALL=C awk "$scriptContent" )" ;;
			esac
		elif [ "$bodyMode" = "stdin" ] ; then
			body="$( cat )"
			## Measured, never refused. Only this branch carries the caller's own
			## new text: script and patch derive a body from content somebody else
			## wrote, and a plain move rewrites the file unchanged. This op is not
			## told who called it, so the acting member is left empty rather than
			## guessed, and the row carries the calling operation instead.
			printf '%s' "$body" | AgentsToolsOutputStyleRefusal "" "" "$itemName via $opContext" "" none || :
		elif [ "$bodyMode" = "patch" ] ; then
			local patchJson existingContent
			patchJson="$( cat )"
			if [ "$isCreate" = "true" ] ; then existingContent="" ; else existingContent="$( cat "$sourcePath" )" ; fi
			body="$( printf '%s%s' "$patchJson" "$existingContent" | python3 "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsBoardItemPatchApply.py" )"
		else
			if [ "$isCreate" = "true" ] ; then
				body="---"$'\n'"---"
			else
				body="$( cat "$sourcePath" )"
			fi
		fi

		## Move stamp: the date field the target state owns. Contract: MAGIC.md.
		local stampField=""
		case "$toState" in
			processed) stampField="processed-at" ;;
			running)   stampField="started-at" ;;
		esac
		## Same state is an edit, not a move. Empty fromState is --create, which arrives.
		if [ "$fromState" = "$toState" ] ; then stampField="" ; fi
		case " $callerHeaderFields " in
			*" $stampField "*) stampField="" ;;
		esac
		if [ -n "$stampField" ] ; then
			local probeState
			probeState="$( printf '%s\n' "$body" | LC_ALL=C awk -v fieldName="$stampField" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsBoardItemFrontmatterFieldProbe.awk" )" || probeState=""
			## `|| ...` because this file runs under `set -e`: a bare capture aborts the op instead of returning through its own error path.
			## HAS keeps a recorded processed-at ("never re-stamped"); started-at is per-run, so a real move restarts it.
			## NONE on a create of a body with no `---` at all: the creation headers below
			## give it a frontmatter, so the move stamp has one to go into as well.
			case "$probeState:$stampField" in
				FRONTMATTER:*|HAS:started-at) ;;
				NONE:*)
					{ [ "$shapeRequired" = "true" ] && [ -n "$body" ] && [ "${body%%$'\n'*}" != "---" ] ; } || stampField=""
				;;
				*) stampField="" ;;
			esac
		fi
		if [ -n "$stampField" ] ; then
			headerOps="${headerOps}upsert"$'\t'"$stampField"$'\t'"$( date +"%Y-%m-%d %H:%M %z" )"$'\n'
		fi

		## Creation headers, stamped only where neither the body nor a --header: names them:
		## type from the name's prefix, date now, from the acting member when one is named.
		## Ahead of the caller's ops, so they lead a new frontmatter and never win over one.
		## A body opening a frontmatter block it never closes gets no defaults: there is
		## nowhere to put them, and a create that wrote before must not start refusing.
		if [ "$shapeRequired" = "true" ] && [ -n "$body" ] \
			&& ! { [ "${body%%$'\n'*}" = "---" ] && [ "$( printf '%s\n' "$body" | LC_ALL=C awk -v fieldName=type -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsBoardItemFrontmatterFieldProbe.awk" )" = "NONE" ] ; } ; then
			local createDefaults="" createType
			createType="$( AgentsToolsItemNameType "$itemName" )"
			[ -z "$createType" ] || createDefaults="default"$'\t'"type"$'\t'"$createType"$'\n'
			[ -z "$actingMember" ] || createDefaults="${createDefaults}default"$'\t'"from"$'\t'"$actingMember"$'\n'
			createDefaults="${createDefaults}default"$'\t'"date"$'\t'"$( date +"%Y-%m-%d %H:%M %z" )"$'\n'
			headerOps="$createDefaults$headerOps"
		fi

		## The ops file has to be a real path -- it is the awk's own `-v opsFile=`
		## input. It is created inside this substitution's own subshell, so its
		## trap is that subshell's and can never disarm the caller's, and the trap
		## is armed before the file exists, so every exit from the block removes
		## it: a failed mkdir or write, a failed awk, or a signal.
		if [ -n "$headerOps" ] ; then
			body="$(
				headerOpsFile="$MMDAPP/.local/temp/mdat-intern-op-headers.$$"
				trap 'rm -f "$headerOpsFile"' EXIT
				mkdir -p "$MMDAPP/.local/temp" || exit 1
				printf '%s' "$headerOps" > "$headerOpsFile" || exit 1
				printf '%s\n' "$body" | LC_ALL=C awk -v opsFile="$headerOpsFile" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsBoardItemHeaderOpsApply.awk"
			)" || { set +e ; return 1 ; }
		fi

		if [ -z "$body" ] ; then
			echo "$MDSC_CMD: board-upsert-move-edit: ⛔ ERROR: empty result -- refusing to write an empty board item" >&2
			set +e ; return 1
		fi

		printf '%s\n' "$body" > "$targetPath"

		## Commit gate: .git presence in the team-data root, presence only and
		## independent of TEAM_DATA_GIT_REMOTE -- this op never pushes or syncs.
		local repoRoot="" sourceTracked="false"
		repoRoot="$( git -C "$MDAT_DATA_ROOT" rev-parse --show-toplevel 2>/dev/null )" || repoRoot=""
		## Asked before the source is removed: `git add` on a vanished untracked
		## path fails the whole op after the move has already happened.
		if [ -n "$repoRoot" ] && [ "$isCreate" = "false" ] && [ "$sourcePath" != "$targetPath" ] ; then
			[ -z "$( git -C "$repoRoot" ls-files -- "$sourcePath" 2>/dev/null )" ] || sourceTracked="true"
		fi

		if [ "$isCreate" = "false" ] && [ "$sourcePath" != "$targetPath" ] ; then
			## trash/ belongs to the trash op and is not a board state, so a move
			## never spools there. `--` guards a later edit that bypasses validation.
			rm -f -- "$sourcePath"
			echo "# $MDSC_CMD: board-upsert-move-edit: $msgVerb ${targetPath#"$boardRoot"/}, previous ${sourcePath#"$boardRoot"/} deleted" >&2
		else
			echo "# $MDSC_CMD: board-upsert-move-edit: $msgVerb ${targetPath#"$boardRoot"/}" >&2
		fi

		## Approval cascade (AgentsTools.ApprovalCascade.include, contract: MAGIC.md): only an
		## approval-* arriving in processed, so a same-state edit (a comment, a clarification, a
		## rejection with a reason) never fires it; a denial carries no approved-by and cascades nothing.
		local approvalCascadePaths=()
		case "$itemName:$toState:$fromState" in
			approval-*:processed:processed) ;;
			approval-*:processed:*)
				. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.ApprovalCascade.include"
				AgentsToolsApprovalCascade "$boardRoot" "$targetPath" "$MDSC_CMD: board-upsert-move-edit" \
					|| echo "$MDSC_CMD: board-upsert-move-edit: approval cascade: ⚠️ did not complete; the approval move stands" >&2
			;;
		esac

		## Both ends of the move in one commit: the destination that now holds the
		## item, and the source whose removal git must record -- plus every path the cascade changed.
		if [ -n "$repoRoot" ] ; then
			local commitPaths=( "$targetPath" )
			[ "$sourceTracked" = "true" ] && commitPaths+=( "$sourcePath" )
			[ "${#approvalCascadePaths[@]}" -eq 0 ] || commitPaths+=( "${approvalCascadePaths[@]}" )
			local gitOut="" gitRc=0
			gitOut="$( git -C "$repoRoot" add -- "${commitPaths[@]}" 2>&1 )" || gitRc=$?
			if [ "$gitRc" -ne 0 ] ; then
				echo "$MDSC_CMD: board-upsert-move-edit: ⛔ ERROR: git add failed for ${commitPaths[*]}: $gitOut" >&2
				set +e ; return 1
			fi
			local moveFrom="$fromState"
			[ "$isCreate" = "true" ] && moveFrom="create"
			gitOut="$( git -C "$repoRoot" commit -m "* board-upsert-move-edit: $itemName $moveFrom -> $toState, $opContext" -- "${commitPaths[@]}" 2>&1 )" || gitRc=$?
			if [ "$gitRc" -ne 0 ] ; then
				echo "$MDSC_CMD: board-upsert-move-edit: ⛔ ERROR: git commit failed for ${commitPaths[*]}: $gitOut" >&2
				set +e ; return 1
			fi
			echo "# $MDSC_CMD: board-upsert-move-edit: committed ${targetPath#"$MDAT_DATA_ROOT"/}" >&2
		fi

		return 0
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
