#!/usr/bin/env bash
## THE COMMS CACHE (owner 2026-10-28): $MMDAPP/.local/cache/comms/<service>/<communication channel id>/, one folder per channel for
## the machine: the service again as a partition, then the whole id as one filename-safe name, its service first
## (slack/slack-<channel>, slack/slack-<channel>-<thread ts>). Any service keeps the same form:
##   .state.txt              rewritten whole by the puller: `<pulled at> <covered from> <newest>`, the read's head line, and how it is
##                           pulled, `<how> <target> <member> <as bot>`
##   .pulling.txt            the one-pull lock, made only where absent (noclobber), its epoch inside (AgentsToolsCommsCachePullTake)
## Every control file is `.<name>.txt`, one writer. Apart from the channels: .local/cache/comms/.interest/<service>-<id>, an empty
## file whose time is the channel's last read (AgentsToolsCommsCacheInterest); one older than a week is deleted.
##   YYYYMM/messages.txt     the messages of that UTC month, one line each, oldest first, continuations joined by \037
##   YYYYMM/<ts>.body.txt    the whole text of a message whose line is over the cap; its line keeps the head and names the file
##   YYYYMM/<file id>.<name>   a file a message of that month carried (its line says `[file: <id> <name> ...]`), fetched once, on demand
## Each reader keeps its own floor. Detail is in MAGIC.md.

agentsCommsCacheLineCap=2000

## Sets agentsCommsCacheDir to the folder of a channel: the service as its partition, then its communication channel id, the
## service first, as one filename-safe name.
AgentsToolsCommsCacheDir(){ ## service, the id within the service
	local cacheService="${1//[!A-Za-z0-9._-]/_}" cacheId="$1-$2"
	agentsCommsCacheDir="$MMDAPP/.local/cache/comms/$cacheService/${cacheId//[!A-Za-z0-9._-]/_}"
}

## THE SLACK CHANNEL ID OF THE CACHE: a channel or thread `slack-<channel>[-<thread ts>]`; a direct conversation is account-bound,
## `slack-<user id>-<dm id>[-<thread ts>]`, the user id the reading account's (`bot` for the team bot), never a member's name. A person
## named as the target (U..., W...: the DM with that person) is the same, `slack-<user id>-<person's user id>`. A read through a client-*
## account, whose ids are its own workspace's only, carries that account first: `slack-<client account>-...` (owner 2026-10-28).
## Sets agentsCommsCacheDir. rc 1 where the account of a direct one cannot be told: that read is not cached.
AgentsToolsCommsCacheSlackDir(){ ## member, as bot (true|false), channel, thread ts (optional)
	local slackId="${3#client:}"
	case "$slackId" in
		D*|U*|W*)
			AgentsToolsCommsCacheSlackAccount "$1" "$2" || return 1
			slackId="$agentsCommsCacheAccount-$slackId"
		;;
	esac
	case "$1:$3" in
		client-*:*|*:client:*) slackId="$1-$slackId" ;;
	esac
	AgentsToolsCommsCacheDir slack "$slackId${4:+-$4}"
}

## The Slack user id a member's reads go under, kept a day in slack/.user-id-<member>.txt (the same file its sends keep): `bot` for
## the team bot. Sets agentsCommsCacheAccount. rc 1 where it cannot be told.
AgentsToolsCommsCacheSlackAccount(){ ## member, as bot (true|false)
	local accountFile="$MMDAPP/.local/cache/comms/slack/.user-id-$1.txt" accountAt="" accountId="" accountNow
	[ "$2" != "true" ] || { agentsCommsCacheAccount="bot" ; return 0 ; }
	case " ${agentsCommsAccountSeen:-} " in *" $1=U"*) accountId="${agentsCommsAccountSeen##* $1=}" ; agentsCommsCacheAccount="${accountId%% *}" ; return 0 ;; esac
	[ ! -f "$accountFile" ] || { read -r accountAt accountId ; } 2> /dev/null < "$accountFile" || accountId=""
	case "$accountId" in
		U[A-Z0-9]*) ;;
		*)
			type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
			accountId="$( DistroAgentsTools --intern-op-slack-call "$1" --api auth.test --context "--comms-cache" 2> /dev/null | LC_ALL=C sed -n 's/.*"user_id":"\(U[A-Z0-9]*\)".*/\1/p' | head -1 )"
			case "$accountId" in U[A-Z0-9]*) ;; *) return 1 ;; esac
			accountNow="$( date +%s )"
			{ mkdir -p "${accountFile%/*}" && accountTmp="$( mktemp "$accountFile.XXXXXX" )" && printf '%s %s\n' "$accountNow" "$accountId" > "$accountTmp" && mv -f "$accountTmp" "$accountFile" ; } 2> /dev/null || :
		;;
	esac
	agentsCommsAccountSeen="${agentsCommsAccountSeen:-} $1=$accountId"
	agentsCommsCacheAccount="$accountId"
}

## The UTC month of an epoch, YYYYMM, by arithmetic: no date process per message.
agentsCommsMonthAwk='function monthOf(t,  z, era, doe, yoe, y, doy, mp, m) { z = int(t / 86400) + 719468 ; era = int(z / 146097) ; doe = z - era * 146097 ; yoe = int((doe - int(doe / 1460) + int(doe / 36524) - int(doe / 146096)) / 365) ; y = yoe + era * 400 ; doy = doe - (365 * yoe + int(yoe / 4) - int(yoe / 100)) ; mp = int((5 * doy + 2) / 153) ; m = mp + (mp < 10 ? 3 : -9) ; if (m <= 2) { y++ } ; return sprintf("%04d%02d", y, m) }'

## A READ MARKS ITS CHANNEL AS OF INTEREST: .local/cache/comms/.interest/<service>-<id> holds `<epoch> <ttl>`, the read that marked it and
## the TTL it reads at. It is rewritten at most once an hour (owner 2026-10-29), and at once for a reader that needs a shorter TTL, by the
## shell alone. The rig's reader pulls only channels read lately, each from its mark's TTL (AgentsToolsCommsCachePullWatched).
AgentsToolsCommsCacheInterest(){ ## cache folder, now, the reader's TTL (optional)
	local interestName="${1##*/}" interestAt="" interestMark interestWas="" interestWasTtl="" interestTtl="${3:-}"
	case "$interestTtl" in ''|*[!0-9]*) interestTtl="" ;; esac
	## The rig's own pull is no reader: it never keeps a channel of interest.
	[ "${MDAT_COMMS_CACHE_PULLER:-}" != "true" ] && [ -n "${MMDAPP:-}" ] || return 0
	case "${agentsCommsInterestSeen:-} " in
		*" $interestName:"*)
			interestAt="${agentsCommsInterestSeen##* $interestName:}" ; interestAt="${interestAt%% *}"
			case "$interestAt" in ''|*[!0-9]*) ;; *) [ $(( $2 - interestAt )) -ge 3600 ] || return 0 ;; esac
		;;
	esac
	agentsCommsInterestSeen="${agentsCommsInterestSeen:-} $interestName:$2"
	interestMark="$MMDAPP/.local/cache/comms/.interest/$interestName"
	{ read -r interestWas interestWasTtl < "$interestMark" ; } 2> /dev/null || interestWas=""
	case "$interestWasTtl" in ''|*[!0-9]*) interestWasTtl="" ;; esac
	case "$interestWas" in
		''|*[!0-9]*) ;;
		*)
			if [ $(( $2 - interestWas )) -lt 3600 ] ; then
				[ -n "$interestTtl" ] && { [ -z "$interestWasTtl" ] || [ "$interestTtl" -lt "$interestWasTtl" ] ; } || return 0
			fi
		;;
	esac
	{ [ -d "${interestMark%/*}" ] || mkdir -p "${interestMark%/*}" ; } 2> /dev/null && printf '%s %s\n' "$2" "${interestTtl:-$interestWasTtl}" > "$interestMark" 2> /dev/null || :
	## ON A TEAM RIG the reader that pulls what is read lately runs whenever anything is read: started here where it is not running
	## (lazy, owner 2026-10-29), its mode read once a process. Elsewhere a read pulls by itself, past its TTL.
	if [ -z "${agentsCommsRigMode+set}" ] ; then
		type AgentsToolsWorkspaceMode > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.TeamDataGate.include" 2> /dev/null
		agentsCommsRigMode="$( AgentsToolsWorkspaceMode 2> /dev/null )" || agentsCommsRigMode=""
	fi
	case "$agentsCommsRigMode" in
		team-rig*)
			type AgentsToolsSessionCommsStart > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionComms.include" 2> /dev/null
			! type AgentsToolsSessionCommsStart > /dev/null 2>&1 || AgentsToolsSessionCommsStart > /dev/null 2>&1 || :
		;;
	esac
	return 0
}

## Whether this process works on a team rig (read once a process). The cache-only reads no longer ask it: a Wait never calls a
## service on any rig (the owner's design), and a rig with no comms thread reads its sources as never read until one pulls them.
AgentsToolsCommsCacheTeamRig(){
	if [ -z "${agentsCommsRigMode+set}" ] ; then
		type AgentsToolsWorkspaceMode > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.TeamDataGate.include" 2> /dev/null
		agentsCommsRigMode="$( AgentsToolsWorkspaceMode 2> /dev/null )" || agentsCommsRigMode=""
	fi
	case "$agentsCommsRigMode" in team-rig*) return 0 ;; esac
	return 1
}

## ONE PULL OF A CHANNEL AT A TIME: the first makes `.pulling.txt` where it is absent (noclobber, so only one can) with its epoch;
## another within 60 s of it does not pull. A pull older than that is taken as dead. rc 1 where another pull holds it.
AgentsToolsCommsCachePullTake(){ ## cache folder, now
	local pullAt=""
	mkdir -p "$1" 2> /dev/null || return 1
	( set -o noclobber ; printf '%s\n' "$2" > "$1/.pulling.txt" ) 2> /dev/null && return 0
	{ read -r pullAt ; } 2> /dev/null < "$1/.pulling.txt" || pullAt=""
	case "$pullAt" in ''|*[!0-9]*) pullAt=0 ;; esac
	[ $(( $2 - pullAt )) -ge 60 ] || return 1
	rm -f "$1/.pulling.txt" 2> /dev/null
	( set -o noclobber ; printf '%s\n' "$2" > "$1/.pulling.txt" ) 2> /dev/null
}
AgentsToolsCommsCachePullGive(){ ## cache folder
	rm -f "$1/.pulling.txt" 2> /dev/null || :
}

## THE PULL ANOTHER HOLDS, waited for: a read that misses where another pull of the same channel runs waits for that one, at most
## its bound (default 30 s), by the shell itself, and is then served from what it brought. rc 0 once no pull holds the channel.
## A pull older than 60 s is dead, as AgentsToolsCommsCachePullTake reads it, so it is not waited for, and no wait lasts longer than its life.
AgentsToolsCommsCachePullAwait(){ ## cache folder, bound in seconds (optional)
	local awaitBound="${2:-30}" awaitAt="" awaitLeft awaitUntil
	{ read -r awaitAt ; } 2> /dev/null < "$1/.pulling.txt" || return 0
	case "$awaitAt" in ''|*[!0-9]*) awaitAt=0 ;; esac
	awaitLeft=$(( 60 - ( $( date +%s ) - awaitAt ) ))
	[ "$awaitLeft" -gt 0 ] || return 0
	[ "$awaitBound" -le "$awaitLeft" ] || awaitBound="$awaitLeft"
	awaitUntil=$(( SECONDS + awaitBound ))
	while [ -f "$1/.pulling.txt" ] && [ "$SECONDS" -lt "$awaitUntil" ] ; do
		sleep 1 2> /dev/null || return 1
	done
	[ ! -f "$1/.pulling.txt" ] || [ $(( $( date +%s ) - awaitAt )) -ge 60 ]
}

## A WHOLE SLACK THREAD THROUGH THE CACHE, slack/slack-<channel>-<thread ts>, rendered into a file: served from it within its TTL,
## else only the replies after its newest are read from Slack and merged. Where another pull holds the channel, what the cache
## holds is served. rc 0 the rendering is written, 1 the cache cannot serve (the caller reads Slack itself), 2 the read failed.
## THE READER'S WAIT ON THE COMMS THREAD (the owner's design, epic S1 item 14): everything is pulled by the one comms thread into the
## cache, and a read that misses the cache either returns unread or waits until the data comes, by its request's budget in seconds
## (MDAT_COMMS_CACHE_WAIT_SECONDS; none or 0 is unread at once). The wait is a fifo in the cache folder, `.ready`, opened read-write by
## both sides so neither blocks on the open; the puller writes one line into it after each pull of that folder while a reader waits
## there (`.waiting`). rc 0 the data came within the budget, rc 1 it did not.
AgentsToolsCommsCacheWaitReady(){ ## cache folder, seconds
	local readyLine="" readyRc=1 readyBudget="${2:-}" readyLeft=""
	case "$readyBudget" in ''|*[!0-9]*|0) return 1 ;; esac
	## ONE BUDGET FOR THE WHOLE PROBE (MDAT_COMMS_CACHE_WAIT_UNTIL, an epoch the Wait sets beside the seconds): a probe that reads several
	## folders -- the ask probe reads every open ask's thread and conversation -- waited the seconds once per folder, and a 300 s Wait
	## stood 500 s and more in one round, its asks unanswered meanwhile. Past the moment, nothing waits.
	case "${MDAT_COMMS_CACHE_WAIT_UNTIL:-}" in
		''|*[!0-9]*) ;;
		*)
			readyLeft=$(( MDAT_COMMS_CACHE_WAIT_UNTIL - $( date +%s ) ))
			[ "$readyLeft" -gt 0 ] || return 1
			[ "$readyBudget" -le "$readyLeft" ] || readyBudget="$readyLeft"
		;;
	esac
	set -- "$1" "$readyBudget"
	mkdir -p "$1" 2> /dev/null || return 1
	[ -p "$1/.ready" ] || mkfifo "$1/.ready" 2> /dev/null || return 1
	: > "$1/.waiting" 2> /dev/null || :
	## The redirection of stderr is braced: on exec itself it would stand for the whole process, and every later error would be lost.
	{ exec 8<> "$1/.ready" ; } 2> /dev/null || { rm -f "$1/.waiting" 2> /dev/null ; return 1 ; }
	read -r -t "$2" -u 8 readyLine && readyRc=0
	exec 8>&-
	rm -f "$1/.waiting" 2> /dev/null
	return "$readyRc"
}

## The puller's word to a reader waiting on a folder it just pulled: one line into the folder's fifo, only while a reader waits there.
AgentsToolsCommsCacheSayReady(){ ## cache folder
	[ -p "$1/.ready" ] && [ -f "$1/.waiting" ] || return 0
	{ exec 9<> "$1/.ready" && printf '.\n' >&9 ; exec 9>&- ; } 2> /dev/null || :
	return 0
}

## A channel the cache does not cover yet, wanted by a reader: its recipe in the folder's `.want`, for the puller, and the rig's one
## flag `.wanted`, read by the comms thread at every pass so the pull comes at once and not at the thread's next watched pull.
AgentsToolsCommsCacheWanted(){ ## cache folder, the recipe line
	{ mkdir -p "$1" && printf '%s\n' "$2" > "$1/.want" && : > "$MMDAPP/.local/cache/comms/.wanted" ; } 2> /dev/null || :
	## THE WANT ASKS THE SERVICE THREAD TO RUN, never pulls: where no comms thread lives for this workspace, one is started on the current
	## code (AgentsToolsSessionCommsStart, which answers `alive` where one lives), and it pulls the want on its pass. So a reader on any
	## rig, a check's included, waits on the thread and not on luck.
	type AgentsToolsSessionCommsStart > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionComms.include" 2> /dev/null || :
	local wantSaid="" wantPid=""
	! type AgentsToolsSessionCommsStart > /dev/null 2>&1 || wantSaid="$( AgentsToolsSessionCommsStart 2> /dev/null )" || wantSaid=""
	## AND WAKES IT: the thread sleeps between passes and wakes on USR1 (its own trap), so the pull comes now and not at its next
	## second. The pid is the one its lock proves live, pid and start together (AgentsToolsSessionCommsLive), read a moment ago.
	## `starting`: another want of this second is starting the reader, which pulls every want first on its first loop; nothing to wake yet.
	case "$wantSaid" in alive\ *|started\ *) wantPid="${wantSaid#* }" ; wantPid="${wantPid%% *}" ;; esac
	case "$wantPid" in ''|*[!0-9]*) ;; *) kill -USR1 "$wantPid" 2> /dev/null || : ;; esac
	return 0
}

AgentsToolsCommsCacheSlackThread(){ ## member, <channel>:<thread ts>, the rendering file, as bot (true|false), now
	local tcChannel="${2%%:*}" tcTs="${2#*:}" tcDir tcNow="$5" tcFetch="" tcTtl="${MDAT_SLACK_THREAD_CACHE_SECONDS:-15}" tcArgs tcRc=0
	case "$tcTtl" in ''|*[!0-9]*) tcTtl=15 ;; esac
	[ "$tcTtl" != 0 ] && [ -n "${MMDAPP:-}" ] || return 1
	case "$tcChannel:$tcTs" in *[!A-Za-z0-9.:]*|:*|*:) return 1 ;; esac
	case "$tcNow" in ''|*[!0-9]*) tcNow="$( date +%s )" ;; esac
	AgentsToolsCommsCacheSlackDir "$1" "${4:-false}" "$tcChannel" "$tcTs" || return 1
	tcDir="$agentsCommsCacheDir"
	## A WAIT'S READ IS CACHE ONLY (MDAT_COMMS_CACHE_ONLY=true) on a team rig: the comms thread pulls what is of interest, so this serves
	## what the cache holds, fresh or stale, and never pulls or refreshes itself. A thread not in the cache yet is marked of interest and
	## left to the thread as its recipe in `.want`, and is read as unread (rc 1).
	if [ "${MDAT_COMMS_CACHE_ONLY:-}" = "true" ] && [ "${MDAT_COMMS_CACHE_PULLER:-}" != "true" ] ; then
		AgentsToolsCommsCacheInterest "$tcDir" "$tcNow" "$tcTtl"
		## FRESH: inside the reader's TTL, served as it stands. STALE OR ABSENT: wanted from the thread, and with a budget waited for by the
		## folder's fifo; what came is served, and a stale folder nothing refreshed in time is served as it stands rather than read as
		## nothing. The request's TTL is what makes a read wait: a reader that asks for the last minute waits for a pull younger than that.
		if AgentsToolsCommsCacheState "$tcDir" && [ $(( tcNow - agentsCommsCacheAt )) -lt "$tcTtl" ] && AgentsToolsCommsCacheServe "$tcDir" 0 nohead > "$3" ; then return 0 ; fi
		AgentsToolsCommsCacheWanted "$tcDir" "slack-thread $2 $1 ${4:-false}"
		AgentsToolsCommsCacheWaitReady "$tcDir" "${MDAT_COMMS_CACHE_WAIT_SECONDS:-0}" || :
		if AgentsToolsCommsCacheState "$tcDir" && AgentsToolsCommsCacheServe "$tcDir" 0 nohead > "$3" ; then return 0 ; fi
		return 1
	fi
	if AgentsToolsCommsCacheState "$tcDir" ; then
		if [ $(( tcNow - agentsCommsCacheAt )) -lt "$tcTtl" ] && AgentsToolsCommsCacheServe "$tcDir" 0 nohead > "$3" ; then
			return 0
		fi
		tcFetch="$agentsCommsCacheNewest"
		## STALE IS ENOUGH for a call that waits no longer than the TTL (MDAT_COMMS_CACHE_STALE_OK): it is served what the cache
		## holds at once, and one pull of its own, detached, brings the channel up to date for the next read.
		if [ "${MDAT_COMMS_CACHE_STALE_OK:-}" = "true" ] && AgentsToolsCommsCacheServe "$tcDir" 0 nohead > "$3" ; then
			if [ ! -f "$tcDir/.pulling.txt" ] ; then
				( MDAT_COMMS_CACHE_STALE_OK="" AgentsToolsCommsCacheSlackThread "$1" "$2" "$tcDir/.swr.rendered" "${4:-false}" "$tcNow" ; rm -f "$tcDir/.swr.rendered" "$tcDir/.swr.rendered.read" "$tcDir/.swr.rendered.err" ) > /dev/null 2>&1 < /dev/null &
			fi
			return 0
		fi
	fi
	if ! AgentsToolsCommsCachePullTake "$tcDir" "$tcNow" ; then
		## One pull at a time: a miss waits for the one that runs, and is served what it brought.
		AgentsToolsCommsCachePullAwait "$tcDir" && AgentsToolsCommsCacheState "$tcDir" && AgentsToolsCommsCacheServe "$tcDir" 0 nohead > "$3" && return 0
		[ -z "$tcFetch" ] || ! AgentsToolsCommsCacheServe "$tcDir" 0 nohead > "$3" || return 0
		return 1
	fi
	tcArgs=( "$1" "$2" --thread )
	[ -z "$tcFetch" ] || tcArgs=( ${tcArgs[@]+"${tcArgs[@]}"} --oldest "$tcFetch" )
	[ "$4" != "true" ] || tcArgs=( ${tcArgs[@]+"${tcArgs[@]}"} --identity-bot )
	type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
	if ! DistroAgentsTools --intern-op-comms-slack-read ${tcArgs[@]+"${tcArgs[@]}"} > "$3.read" 2> "$3.err" ; then
		AgentsToolsCommsCachePullGive "$tcDir" ; return 2
	fi
	## THE ONE RENDERING (epic S11): the read operation, this cache and the Wait render through AgentsToolsSlackFormatPagedConversation,
	## so what a rendering carries -- a voice message's words among it -- is decided in one place and not three.
	type AgentsToolsSlackFormatPagedConversation > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.CommsSlack.include"
	AgentsToolsSlackFormatPagedConversation "$1" "$( cat "$3.read" )" > "$3.fresh" 2>> "$3.err" || tcRc=2
	[ "$tcRc" != 0 ] || AgentsToolsCommsCacheMerge "$tcDir" "$3.fresh" "$tcTs" "$tcNow" "slack-thread $2 $1 ${4:-false}" || tcRc=1
	rm -f "$3.fresh"
	AgentsToolsCommsCachePullGive "$tcDir"
	[ "$tcRc" = 0 ] || return "$tcRc"
	AgentsToolsCommsCacheServe "$tcDir" 0 nohead > "$3" || return 1
	return 0
}

## THE OUTBOX OF A CHANNEL (S21.13): <entry>/outbox.messages.txt, one record a line, appended by a send that returns at once,
## `<session>\t<block>\t<member>\t<identity>\t<method>\t<payload>`, the payload's line ends kept as \037. A caller that gives a reason
## keeps it in front of the payload, inside that last column, as `why=<reason>` and then \037: so the writer prints what really happened to
## the post, a queue for the reader or a real failure (S5.6), and a payload is never split by it, since the column count does not change and
## a record of an older release simply carries no reason. The pusher takes the file
## aside as outbox.pushing.txt and keeps how far it got in .push.txt (`<sent> <retry-at> <attempts>`, its one writer). Once all of it
## is sent that file is gone, so the outbox is cut back to nothing; a send made meanwhile is in the next one. rc 1 not appended.
AgentsToolsCommsCacheOutboxAppend(){ ## cache folder, session, block, member, identity, method, payload, why (may be empty)
	local appendPayload="${7//$'\n'/$'\037'}" appendWhy appendSep=$'\037'
	appendWhy="$( printf '%s' "${8:-}" | LC_ALL=C tr '\r\n\t' '   ' | LC_ALL=C cut -c1-300 )"
	[ -z "$appendWhy" ] || appendPayload="why=$appendWhy$appendSep$appendPayload"
	{ [ -d "$1" ] || mkdir -p "$1" ; } 2> /dev/null || return 1
	printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$2" "$3" "$4" "$5" "$6" "$appendPayload" >> "$1/outbox.messages.txt" 2> /dev/null || return 1
	## THE SESSION IS MARKED, so the reader takes this post up without walking the folders of the sessions (S5.6). The mark is written
	## here, by the shell alone, and not through the reader's own include: a caller that stubs the writer keeps its stub.
	case "$2" in ''|-|.|..|*/*|*[[:space:]]*|*"$'\t'"*) return 0 ;; esac
	[ -n "${MMDAPP:-}" ] || return 0
	{ [ -d "$MMDAPP/.local/agents/comms/work" ] || mkdir -p "$MMDAPP/.local/agents/comms/work" ; } 2> /dev/null || return 0
	: > "$MMDAPP/.local/agents/comms/work/$2" 2> /dev/null || :
	return 0
}

## ONE PUSH OF A CHANNEL'S OUTBOX, by one pusher at a time (.pushlock.txt, stale after 120 s): the records after `sent`, oldest first,
## each posted as the session's writer posts one (AgentsToolsSessionCommsPost), with the record's own reason kept on line 2 so the writer
## says what really happened to it. Posted or given up moves `sent`. One left for later keeps its place, sets `retry-at` and counts the
## attempt, and nothing after it overtakes it. `most` bounds the posts of this call, and nothing of it when 0: a backlog is drained over
## passes, so the pass that drains it still takes the console's messages and reads the threads.
AgentsToolsCommsCachePush(){ ## cache folder, now, most (optional; 0 or none: no bound)
	local pushDir="$1" pushNow="$2" pushMost="${3:-0}" pushLock="" pushSent=0 pushRetry=0 pushTries=0 pushNo pushWork pushRc=0 pushWhy pushSep=$'\037' pushFull=""
	local pushSession pushBlock pushMember pushIdentity pushMethod pushPayload pushPauseDir pushPauseUntil pushMerged
	case "$pushMost" in ''|*[!0123456789]*) pushMost=0 ;; esac
	agentsCommsCachePushMade=0
	[ -f "$pushDir/outbox.pushing.txt" ] || [ -s "$pushDir/outbox.messages.txt" ] || return 0
	if ! ( set -o noclobber ; printf '%s\n' "$pushNow" > "$pushDir/.pushlock.txt" ) 2> /dev/null ; then
		{ read -r pushLock < "$pushDir/.pushlock.txt" ; } 2> /dev/null || pushLock=0
		case "$pushLock" in ''|*[!0-9]*) pushLock=0 ;; esac
		[ $(( pushNow - pushLock )) -ge 120 ] || return 0
		rm -f "$pushDir/.pushlock.txt"
		( set -o noclobber ; printf '%s\n' "$pushNow" > "$pushDir/.pushlock.txt" ) 2> /dev/null || return 0
	fi
	while : ; do
		if [ ! -f "$pushDir/outbox.pushing.txt" ] ; then
			[ -s "$pushDir/outbox.messages.txt" ] || break
			mv -f "$pushDir/outbox.messages.txt" "$pushDir/outbox.pushing.txt" 2> /dev/null || break
			printf '0 0 0\n' > "$pushDir/.push.txt" 2> /dev/null
		fi
		{ read -r pushSent pushRetry pushTries < "$pushDir/.push.txt" ; } 2> /dev/null || :
		case "$pushSent:$pushRetry:$pushTries" in *[!0-9:]*|:*|*::*|*:) pushSent=0 pushRetry=0 pushTries=0 ;; esac
		## THE TRACKING POSTS OF A FILE ARE JOINED, once for the file, under this lock: consecutive posts of one member's activity become one message up to Slack's
		## weight, so a backlog drains at the rate of messages the channel takes and not at one line a message (AgentsCommsOutboxCoalesce.awk). The posts already
		## sent are kept as they are, so `sent` still points at the same record. A merge that fails leaves the file as it was.
		if [ ! -f "$pushDir/.merged.txt" ] ; then
			pushMerged="$( mktemp "$pushDir/.merge.XXXXXX" 2> /dev/null )" || pushMerged=""
			if [ -n "$pushMerged" ] ; then
				LC_ALL=C awk -v sent="$pushSent" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsCommsOutboxCoalesce.awk" "$pushDir/outbox.pushing.txt" > "$pushMerged" 2> /dev/null \
					&& [ -s "$pushMerged" ] && mv -f "$pushMerged" "$pushDir/outbox.pushing.txt" 2> /dev/null || rm -f "$pushMerged"
			fi
			: > "$pushDir/.merged.txt" 2> /dev/null || :
		fi
		[ "$pushNow" -ge "$pushRetry" ] || break
		pushWork="$( mktemp -d "$pushDir/.post.XXXXXX" 2> /dev/null )" || break
		pushNo=0 pushRc=0
		while IFS=$'\t' read -r pushSession pushBlock pushMember pushIdentity pushMethod pushPayload ; do
			pushNo=$(( pushNo + 1 ))
			[ "$pushNo" -gt "$pushSent" ] || continue
			case "$pushBlock" in ''|*[!0-9]*) pushSent="$pushNo" ; continue ;; esac
			## The reason a caller kept in front of the payload, where it kept one. A record of an older release has none.
			pushWhy=""
			case "$pushPayload" in
				why=*"$pushSep"*)
					pushWhy="${pushPayload#why=}" ; pushWhy="${pushWhy%%"$pushSep"*}"
					pushPayload="${pushPayload#*"$pushSep"}"
				;;
			esac
			printf '%s\t%s\t%s\n%s\n%s\n' "$pushMember" "$pushIdentity" "$pushMethod" "${pushWhy:--}" "${pushPayload//$'\037'/$'\n'}" > "$pushWork/$pushBlock.retry"
			## Never bare: AgentsToolsSessionCommsPost returns 1 or 2 on an ordinary, expected outcome (rate-limited,
			## refused, unreached), and a caller under set -e (DistroAgentsTools.fn.sh) is killed outright by that
			## return unless it is the left side of ||, never just followed by `; pushRc=$?`.
			pushRc=0
			AgentsToolsSessionCommsPost "$pushSession" "$pushWork/$pushBlock.retry" || pushRc=$?
			rm -f "$pushWork/$pushBlock".*
			if [ "$pushRc" = 1 ] ; then
				pushTries=$(( pushTries + 1 ))
				pushRetry=$(( pushNow + ( pushTries < 6 ? 5 * pushTries : 30 ) ))
				## Slack's own rate limit already set the writer's pause (AgentsToolsSessionCommsPauseSet): the real
				## Retry-After is waited out there, never guessed at by the generic backoff above.
				pushPauseDir="${MMDAPP:+$MMDAPP/.local/agents/comms}"
				pushPauseUntil=""
				[ -z "$pushPauseDir" ] || { IFS= read -r pushPauseUntil < "$pushPauseDir/pause" ; } 2> /dev/null
				case "$pushPauseUntil" in ''|*[!0-9]*) pushPauseUntil="" ;; esac
				[ -z "$pushPauseUntil" ] || [ "$pushPauseUntil" -le "$pushNow" ] || pushRetry="$pushPauseUntil"
				printf '%s %s %s\n' "$pushSent" "$pushRetry" "$pushTries" > "$pushDir/.push.txt"
				break
			fi
			pushSent="$pushNo" pushRetry=0 pushTries=0
			printf '%s 0 0\n' "$pushSent" > "$pushDir/.push.txt"
			pushMade=$(( agentsCommsCachePushMade + 1 ))
			agentsCommsCachePushMade=$pushMade
			[ "$pushMost" = 0 ] || [ "$pushMade" -lt "$pushMost" ] || { pushFull="yes" ; break ; }
		done < "$pushDir/outbox.pushing.txt"
		rm -rf "$pushWork"
		[ "$pushRc" != 1 ] || break
		[ -z "$pushFull" ] || break
		## All of it sent: the outbox is cut back, and the next one, where a send came meanwhile, is taken.
		rm -f "$pushDir/outbox.pushing.txt" "$pushDir/.push.txt" "$pushDir/.merged.txt"
	done
	rm -f "$pushDir/.pushlock.txt"
	return 0
}

## Every channel's outbox that holds a post, pushed: the shell's own expansion finds them, so a pass with none starts no process. `most`
## is the posts of the whole pass, spent channel by channel in turn: a backlog of one channel never spends it all, and a workspace with
## many channels still makes only that many posts, so the pass that drains them still takes the console's messages and reads the threads.
AgentsToolsCommsCachePushAll(){ ## now, most (optional; 0 or none: no bound)
	local allOut allSeen=" " allMost="${2:-0}" allLeft allMade=0 allDir allCount=0 allShare allRound allBound
	agentsCommsCachePushAllMade=0
	[ -n "${MMDAPP:-}" ] || return 0
	case "$allMost" in ''|*[!0123456789]*) allMost=0 ;; esac
	allLeft="$allMost"
	for allOut in "$MMDAPP/.local/cache/comms"/*/*/outbox.pushing.txt "$MMDAPP/.local/cache/comms"/*/*/outbox.messages.txt ; do
		[ -f "$allOut" ] || continue
		case "$allSeen" in *" ${allOut%/*} "*) continue ;; esac
		allSeen="$allSeen${allOut%/*} "
		allCount=$(( allCount + 1 ))
	done
	[ "$allCount" -gt 0 ] || return 0
	## THE BOUND IS SHARED, NEVER SPENT IN FOLDER ORDER: each outbox first gets its share of the pass (at least one post), then what is left
	## goes round again in order, so a full folder ahead of a small one never starves it.
	allShare=0
	[ "$allMost" = 0 ] || allShare=$(( ( allMost + allCount - 1 ) / allCount ))
	for allRound in share rest ; do
		[ "$allRound" = share ] || [ "$allMost" != 0 ] || break
		for allDir in $allSeen ; do
			[ -f "$allDir/outbox.pushing.txt" ] || [ -f "$allDir/outbox.messages.txt" ] || continue
			[ "$allMost" = 0 ] || [ "$allLeft" -gt 0 ] || break 2
			allBound="$allLeft"
			[ "$allMost" = 0 ] || [ "$allRound" != share ] || [ "$allShare" -ge "$allLeft" ] || allBound="$allShare"
			AgentsToolsCommsCachePush "$allDir" "$1" "$allBound"
			allMade=$(( allMade + agentsCommsCachePushMade ))
			[ "$allMost" = 0 ] || allLeft=$(( allLeft - agentsCommsCachePushMade ))
		done
	done
	## What the pass posted in all, for the thread's own end: a thread that is posting is at work.
	agentsCommsCachePushAllMade="$allMade"
	return 0
}

## A FILE A SLACK MESSAGE CARRIED, kept in its message's month: YYYYMM/<file id>.<name> (the id is the file's own), its real name and extension kept, fetched
## once through --slack-file-fetch and then served from the cache. Prints the path. rc 1 where it cannot be fetched.
AgentsToolsCommsCacheSlackFile(){ ## member, cache folder, message ts, file id, file name, as bot (true|false)
	local fileMonth fileName="${5:-file}" filePath
	case "$4" in F[A-Z0-9]*) ;; *) return 1 ;; esac
	case "$4" in *[!A-Z0-9]*) return 1 ;; esac
	fileMonth="$( LC_ALL=C awk -v t="${3%%.*}" "$agentsCommsMonthAwk"' BEGIN { print monthOf(t + 0) }' )" || return 1
	fileName="${fileName//[!A-Za-z0-9._-]/_}"
	filePath="$2/$fileMonth/$4.$fileName"
	if [ ! -s "$filePath" ] ; then
		mkdir -p "$2/$fileMonth" 2> /dev/null || return 1
		type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
		DistroAgentsTools --slack-file-fetch "$1" "$4" "$filePath" --overwrite $( [ "$6" != "true" ] || printf '%s' --identity-bot ) > /dev/null || { rm -f "$filePath" ; return 1 ; }
	fi
	printf '%s\n' "$filePath"
}

## THE RIG'S PULL (owner 2026-10-28), run by the session comms reader: every channel read in the last 61 minutes whose last pull is
## past its TTL is pulled once, by the way its state names, so a member's read on the rig is served from the cache and never waits on
## the service. Once an hour it deletes the marks older than 48 hours (owner 2026-10-29).
AgentsToolsCommsCachePullWatched(){ ## now, most (optional; the channels one call may pull, none or 0 for no bound)
	local watchMarks="$MMDAPP/.local/cache/comms/.interest" watchService watchEntry watchEntryMark watchMark watchName watchDir watchHow watchTarget watchMember watchBot watchQuiet watchBase watchMarkAt watchMarkTtl watchTtl="${MDAT_SLACK_THREAD_CACHE_SECONDS:-15}"
	local watchMost="${2:-0}" watchDone=0
	case "$watchMost" in ''|*[!0123456789]*) watchMost=0 ;; esac
	case "$watchTtl" in ''|*[!0-9]*) watchTtl=15 ;; esac
	[ -n "${MMDAPP:-}" ] && [ -d "$watchMarks" ] || return 0
	if [ $(( $1 - ${agentsCommsInterestCleanAt:-0} )) -ge 3600 ] ; then
		agentsCommsInterestCleanAt="$1"
		find "$watchMarks" -type f -mmin +2880 -delete 2> /dev/null || :
		## An entry whose mark is gone or as old goes with it (owner 2026-10-29): its folder, named from its fixed parts, and never one
		## whose outbox still holds a post.
		for watchService in $( ls -1 "$MMDAPP/.local/cache/comms" 2> /dev/null ) ; do
			case "$watchService" in ''|.*) continue ;; esac
			[ -d "$MMDAPP/.local/cache/comms/$watchService" ] || continue
			for watchEntry in $( ls -1 "$MMDAPP/.local/cache/comms/$watchService" 2> /dev/null ) ; do
				case "$watchEntry" in ''|.|..|*[!A-Za-z0-9._-]*) continue ;; esac
				[ -d "$MMDAPP/.local/cache/comms/$watchService/$watchEntry" ] || continue
				watchEntryMark="$watchMarks/$watchEntry"
				[ ! -f "$watchEntryMark" ] || [ -n "$( find "$watchEntryMark" -mmin +2880 2> /dev/null )" ] || continue
				[ ! -s "$MMDAPP/.local/cache/comms/$watchService/$watchEntry/outbox.messages.txt" ] || continue
				[ ! -s "$MMDAPP/.local/cache/comms/$watchService/$watchEntry/outbox.pushing.txt" ] || continue
				rm -rf -- "$MMDAPP/.local/cache/comms/$watchService/$watchEntry" 2> /dev/null || :
			done
		done
	fi
	## THE MARKS ARE READ BY A GLOB, one file read each (call-path audit row 22): a mark holds the moment of the read that wrote it
	## and the TTL it reads at, so a mark older than an hour by the pass clock is passed over here, with no find and no sed on
	## the pass. The hourly sweep above removes what is older than two days.
	for watchMark in "$watchMarks"/* ; do
		[ -f "$watchMark" ] || continue
		watchName="${watchMark##*/}"
		case "$watchName" in ''|.*|*[!A-Za-z0-9._-]*) continue ;; esac
		## Each channel from the TTL its readers read it at, kept in its mark; the default where the mark names none.
		watchBase="$watchTtl" watchMarkTtl="" watchMarkAt=""
		{ read -r watchMarkAt watchMarkTtl < "$watchMark" ; } 2> /dev/null || { watchMarkAt="" ; watchMarkTtl="" ; }
		case "$watchMarkAt" in ''|*[!0-9]*) continue ;; esac
		[ $(( $1 - watchMarkAt )) -lt 3660 ] || continue
		watchDir="$MMDAPP/.local/cache/comms/${watchName%%-*}/$watchName"
		## A WANT IS SERVED WHATEVER THE BUDGET: a reader waits by that folder's fifo now. The budget bounds the channels pulled on their own
		## schedule, and once it is spent they wait for the next pass, while a wanted folder later in the order is still reached (a budget of
		## two over a hundred and forty marks left keeper-ae3's mentions, late in the order, unpulled pass after pass).
		[ -f "$watchDir/.want" ] || [ "$watchMost" = 0 ] || [ "$watchDone" -lt "$watchMost" ] || continue
		if ! AgentsToolsCommsCacheState "$watchDir" ; then
			## A channel not in the cache yet that a cache-only reader left (`.want`, its recipe): pulled from nothing, whole.
			[ -f "$watchDir/.want" ] || continue
			IFS= read -r agentsCommsCacheRecipe < "$watchDir/.want" 2> /dev/null || continue
			agentsCommsCacheAt=0 agentsCommsCacheFrom="" agentsCommsCacheNewest=""
		fi
		case "$watchMarkTtl" in ''|*[!0-9]*|0) ;; *) watchBase="$watchMarkTtl" ;; esac
		## The puller's own clock (owner 2026-10-29): a channel quiet since its newest message is pulled ever more rarely, to
		## nineteen times the TTL at two hundred and ten times it, so a reader that needs it sooner pulls it itself.
		watchQuiet="${agentsCommsCacheNewest%%.*}"
		case "$watchQuiet" in ''|*[!0-9]*) watchQuiet="$1" ;; esac
		watchQuiet=$(( $1 - watchQuiet ))
		[ "$watchQuiet" -ge 0 ] || watchQuiet=0
		[ "$watchQuiet" -le $(( watchBase * 210 )) ] || watchQuiet=$(( watchBase * 210 ))
		## A WANT IS A READER'S DEMAND (a reader waiting by the folder's fifo): the folder is pulled now, whatever its own schedule says.
		[ -f "$watchDir/.want" ] || [ $(( $1 - agentsCommsCacheAt )) -ge $(( watchBase + 18 * watchQuiet / 210 )) ] || continue
		read -r watchHow watchTarget watchMember watchBot <<< "$agentsCommsCacheRecipe"
		case "$watchHow" in
			slack-thread)
				## The pull reads at the readers' own TTL (the mark's, watchBase): a thread pulled seconds ago is pulled again where a reader
				## with a one-second TTL wants it, not served from a fifteen-second default the puller alone would hold.
				MDAT_COMMS_CACHE_ONLY="" MDAT_SLACK_THREAD_CACHE_SECONDS="$watchBase" AgentsToolsCommsCacheSlackThread "$watchMember" "$watchTarget" "$watchDir/.pull.rendered" "$watchBot" "$1" > /dev/null 2>&1 || :
				rm -f "$watchDir/.pull.rendered" "$watchDir/.pull.rendered.read" "$watchDir/.pull.rendered.err"
			;;
			slack-mentions)
				## A member's mentions, searched by the thread for the Wait that reads the cache alone (AgentsWaitMentionsPull).
				type AgentsWaitMentionsPull > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.MemberWaitMentions.include" 2> /dev/null || :
				## Its stderr is the thread's log: the one line that says why a member's mentions cannot be searched lands there.
				! type AgentsWaitMentionsPull > /dev/null 2>&1 || MDAT_COMMS_CACHE_ONLY="" MDAT_COMMS_CACHE_PULLER=true AgentsWaitMentionsPull "$watchTarget" "$watchDir" "$1" > /dev/null || :
			;;
			slack-conversation)
				## From what the cache covers, so the read finds it stale and pulls only after its newest.
				type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
				MDAT_COMMS_CACHE_ONLY="" MDAT_COMMS_CACHE_PULLER=true MDAT_SLACK_THREAD_CACHE_SECONDS="$watchBase" DistroAgentsTools --intern-op-comms-slack-read "$watchMember" "$watchTarget" $( [ -z "$agentsCommsCacheFrom" ] || printf '%s\n' --oldest "$agentsCommsCacheFrom" ) \
					$( [ "$watchBot" != "true" ] || printf '%s' --identity-bot ) > /dev/null 2>&1 < /dev/null || :
			;;
		esac
		rm -f "$watchDir/.want" 2> /dev/null
		AgentsToolsCommsCacheSayReady "$watchDir"
		watchDone=$(( watchDone + 1 ))
	done
	return 0
}

## Reads a channel's state into agentsCommsCacheAt, agentsCommsCacheFrom, agentsCommsCacheNewest, agentsCommsCacheHead and
## agentsCommsCacheRecipe (how it is pulled). rc 1 where it holds no pointers.
AgentsToolsCommsCacheState(){ ## cache folder
	agentsCommsCacheAt="" agentsCommsCacheFrom="" agentsCommsCacheNewest="" agentsCommsCacheHead="" agentsCommsCacheRecipe=""
	[ -f "$1/.state.txt" ] && { read -r agentsCommsCacheAt agentsCommsCacheFrom agentsCommsCacheNewest ; IFS= read -r agentsCommsCacheHead ; IFS= read -r agentsCommsCacheRecipe ; } 2> /dev/null < "$1/.state.txt" || :
	case "$agentsCommsCacheAt:${agentsCommsCacheFrom%%.*}:${agentsCommsCacheNewest%%.*}" in
		*[!0-9:]*|:*|*::*|*:) agentsCommsCacheAt="" ; return 1 ;;
	esac
	return 0
}

## The messages of a channel strictly after a floor, as a read prints them: the head line first where `head` is asked, then each
## message whole, its continuation lines and its long body restored. Only the month folders at or after the floor's are opened.
AgentsToolsCommsCacheServe(){ ## cache folder, floor ts, head|nohead
	local serveMonth serveDir serveName serveFiles=()
	AgentsToolsCommsCacheState "$1" || return 1
	serveMonth="$( LC_ALL=C awk -v t="${2%%.*}" "$agentsCommsMonthAwk"' BEGIN { print monthOf(t + 0) }' )" || return 1
	for serveDir in "$1"/[0-9][0-9][0-9][0-9][0-9][0-9] ; do
		[ -f "$serveDir/messages.txt" ] || continue
		serveName="${serveDir##*/}"
		[ "$serveName" -lt "$serveMonth" ] || serveFiles+=( "$serveDir/messages.txt" )
	done
	[ "$3" != "head" ] || [ -z "$agentsCommsCacheHead" ] || printf '%s\n' "$agentsCommsCacheHead"
	[ "${#serveFiles[@]}" = 0 ] && return 0
	LC_ALL=C awk -v floorTs="${2:-0}" '
		function secOf(v) { sub(/\..*$/, "", v) ; return ( v == "" ? 0 : v + 0 ) ; }
		function fracOf(v) { if ( v !~ /\./ ) { return "000000" ; } sub(/^[^.]*\./, "", v) ; return substr(v "000000", 1, 6) ; }
		FNR == 1 { dir = FILENAME ; sub(/\/[^\/]*$/, "", dir) ; }
		{
			if ( !( secOf($1) > secOf(floorTs) || ( secOf($1) == secOf(floorTs) && fracOf($1) > fracOf(floorTs) ) ) ) { next ; }
			body = dir "/" $1 ".body.txt"
			if ( index($0, " [body: " $1 ".body.txt]") ) { while ( ( getline line < body ) > 0 ) { print line ; } close(body) ; next ; }
			line = $0 ; gsub(/\037/, "\n", line) ; print line
		}' ${serveFiles[@]+"${serveFiles[@]}"}
}

## Merges a fresh read (rendered: `<ts> | ...` lines, its first line a `## target=` head or not) into a channel's cache: each
## message once, in its month's folder, oldest first, the fresh copy of an edited one winning. A message newer than the newest
## held is appended; a month an older or edited one falls in is merged whole. The pointers only widen. A read holding no message
## still moves `pulled at`.
AgentsToolsCommsCacheMerge(){ ## cache folder, fresh read, covered from (ts), now, how it is pulled (optional: `<how> <target> <member> <as bot>`)
	local mergeRecs mergeMonth mergeTmp mergeHead="" mergeNewest="" mergeFrom="$3" mergeAppended="" tab
	tab="$( printf '\t' )"
	[ -f "$2" ] || return 1
	mkdir -p "$1" 2> /dev/null || return 1
	IFS= read -r mergeHead < "$2" 2> /dev/null || mergeHead=""
	case "$mergeHead" in '## target='*) ;; *) mergeHead="" ;; esac
	mergeRecs="$( mktemp "$1/merge.XXXXXX" 2> /dev/null )" || return 1
	## One record per message: `<month> <ts> <line>`, continuations joined by \037.
	LC_ALL=C awk "$agentsCommsMonthAwk"'
		NR == 1 && /^## target=/ { next ; }
		/^[0-9]+\.[0-9]+ \| / { if ( rec != "" ) { print rec ; } split($0, f, " ") ; rec = monthOf(f[1] + 0) "\t" f[1] "\t" $0 ; next ; }
		rec != "" { rec = rec "\037" $0 ; }
		END { if ( rec != "" ) { print rec ; } }' "$2" > "$mergeRecs" || { rm -f "$mergeRecs" ; return 1 ; }
	for mergeMonth in $( LC_ALL=C cut -f1 "$mergeRecs" | LC_ALL=C sort -u ) ; do mkdir -p "$1/$mergeMonth" 2> /dev/null || { rm -f "$mergeRecs" ; return 1 ; } ; done
	## THE COMMON CASE APPENDS: where every fresh message is newer than the newest held, each is added to the end of its month's
	## file and nothing is rewritten.
	AgentsToolsCommsCacheState "$1" || :
	if [ -n "$agentsCommsCacheNewest" ] && LC_ALL=C sort -t "$tab" -k2,2n "$mergeRecs" | LC_ALL=C awk -F'\t' -v newest="$agentsCommsCacheNewest" -v dir="$1" -v cap="$agentsCommsCacheLineCap" '
		function secOf(v) { sub(/\..*$/, "", v) ; return ( v == "" ? 0 : v + 0 ) ; }
		function fracOf(v) { if ( v !~ /\./ ) { return "000000" ; } sub(/^[^.]*\./, "", v) ; return substr(v "000000", 1, 6) ; }
		{ n++ ; month[n] = $1 ; ts[n] = $2 ; line[n] = substr($0, length($1) + length($2) + 3) ; if ( !( secOf($2) > secOf(newest) || ( secOf($2) == secOf(newest) && fracOf($2) > fracOf(newest) ) ) ) { older = 1 ; exit ; } }
		END {
			if ( older ) { exit 1 ; }
			for ( i = 1 ; i <= n ; i++ ) {
				if ( i > 1 && ts[i] == ts[i - 1] ) { continue ; }
				out = dir "/" month[i] "/messages.txt" ; l = line[i]
				if ( length(l) > cap ) { body = dir "/" month[i] "/" ts[i] ".body.txt" ; whole = l ; gsub(/\037/, "\n", whole) ; printf "%s\n", whole > body ; close(body) ; l = substr(l, 1, cap) " [body: " ts[i] ".body.txt]" ; }
				print l >> out
			}
		}' ; then
		mergeAppended="yes"
	fi
	for mergeMonth in $( [ -n "$mergeAppended" ] || LC_ALL=C cut -f1 "$mergeRecs" | LC_ALL=C sort -u ) ; do
		mergeTmp="$( mktemp "$1/$mergeMonth/messages.txt.XXXXXX" 2> /dev/null )" || { rm -f "$mergeRecs" ; return 1 ; }
		## The fresh ones first, so a stable sort keeps their copy of a message both hold.
		{
			LC_ALL=C awk -F'\t' -v month="$mergeMonth" '$1 == month { print substr($0, length($1) + 2) ; }' "$mergeRecs"
			[ ! -f "$1/$mergeMonth/messages.txt" ] || LC_ALL=C awk -v dir="$1/$mergeMonth" '{
				line = $0 ; body = dir "/" $1 ".body.txt"
				if ( index(line, " [body: " $1 ".body.txt]") ) { line = "" ; while ( ( getline part < body ) > 0 ) { line = ( line == "" ? part : line "\037" part ) ; } close(body) ; }
				print $1 "\t" line ; }' "$1/$mergeMonth/messages.txt"
		} | LC_ALL=C sort -s -t "$tab" -k1,1n | LC_ALL=C awk -F'\t' -v dir="$1/$mergeMonth" -v cap="$agentsCommsCacheLineCap" '
			## A body that already holds this text is left alone: a re-merge rewrites no long message.
			function putBody(path, whole,   have, one) {
				have = ""
				while ( ( getline one < path ) > 0 ) { have = ( have == "" ? one : have "\n" one ) }
				close(path)
				if ( have == whole ) { return }
				printf "%s\n", whole > path ; close(path)
			}
			$1 == prev { next ; }
			{
				prev = $1 ; line = substr($0, length($1) + 2)
				if ( length(line) > cap ) {
					body = dir "/" $1 ".body.txt" ; whole = line ; gsub(/\037/, "\n", whole) ; putBody(body, whole)
					line = substr(line, 1, cap) " [body: " $1 ".body.txt]"
				}
				print line
			}' > "$mergeTmp" \
			&& mv -f "$mergeTmp" "$1/$mergeMonth/messages.txt" || { rm -f "$mergeTmp" "$mergeRecs" ; return 1 ; }
	done
	mergeNewest="$( LC_ALL=C sort -t "$tab" -k2,2n "$mergeRecs" | LC_ALL=C tail -1 | LC_ALL=C cut -f2 )"
	rm -f "$mergeRecs"
	AgentsToolsCommsCacheState "$1" || :
	case "${agentsCommsCacheFrom%%.*}" in ''|*[!0-9]*) ;; *) [ "${agentsCommsCacheFrom%%.*}" -ge "${mergeFrom%%.*}" ] || mergeFrom="$agentsCommsCacheFrom" ;; esac
	case "${agentsCommsCacheNewest%%.*}" in ''|*[!0-9]*) ;; *) [ -n "$mergeNewest" ] && [ "${mergeNewest%%.*}" -ge "${agentsCommsCacheNewest%%.*}" ] || mergeNewest="$agentsCommsCacheNewest" ;; esac
	[ -n "$mergeNewest" ] || mergeNewest="$mergeFrom"
	[ -n "$mergeHead" ] || mergeHead="$agentsCommsCacheHead"
	mergeStateTmp="$( mktemp "$1/.state.txt.XXXXXX" )" || return 1
	{ printf '%s %s %s\n%s\n%s\n' "$4" "$mergeFrom" "$mergeNewest" "$mergeHead" "${5:-$agentsCommsCacheRecipe}" ; } > "$mergeStateTmp" && mv -f "$mergeStateTmp" "$1/.state.txt"
}

## A SEARCH ANSWER KEPT BY ITS QUERY (owner 2026-11-01, option one): the one entry a query signature names, with its own TTL,
## so a repeated search inside that TTL asks Slack nothing. The signature is the question itself -- target, query, cut-off,
## page bound and shape -- so two callers asking the same thing share one answer, and any difference names another.
AgentsToolsCommsCacheSearchSignature(){ ## target, query, cutoff, max pages, pretty
	printf '%s|%s|%s|%s|%s\n' "$1" "$2" "$3" "$4" "$5" | LC_ALL=C cksum | LC_ALL=C awk '{ printf "%s-%s\n", $1, $2 }'
}

## The answer a signature holds, printed, where its state is younger than the TTL: the caller prints nothing of its own and
## calls nought. rc 1 where it holds none, or holds one past its TTL. A TTL of nought always misses.
AgentsToolsCommsCacheSearchServe(){ ## signature, ttl (optional; the state's own where none is given)
	local serveDir="$MMDAPP/.local/cache/comms/search/search-$1" serveAt="" serveTtl="" serveNow
	[ -f "$serveDir/answer.txt" ] || return 1
	{ read -r serveAt serveTtl < "$serveDir/.state.txt" ; } 2> /dev/null || return 1
	case "$serveAt" in ''|*[!0-9]*) return 1 ;; esac
	[ -n "${2:-}" ] || [ -n "$serveTtl" ] || return 1
	[ -z "${2:-}" ] || serveTtl="$2"
	case "$serveTtl" in ''|*[!0-9]*) return 1 ;; esac
	serveNow="$( date +%s )"
	[ "$serveTtl" -gt 0 ] || return 1
	[ $(( serveNow - serveAt )) -lt "$serveTtl" ] || return 1
	cat "$serveDir/answer.txt"
}

## One search answer filed under its signature, its state rewritten whole: `<cached at> <ttl>`. rc 1 where it cannot be filed.
AgentsToolsCommsCacheSearchFile(){ ## signature, the answer, ttl
	local fileDir="$MMDAPP/.local/cache/comms/search/search-$1" fileTmp
	mkdir -p "$fileDir" 2> /dev/null || return 1
	fileTmp="$( mktemp "$fileDir/answer.txt.XXXXXX" 2> /dev/null )" || return 1
	printf '%s\n' "$2" > "$fileTmp" || { rm -f "$fileTmp" ; return 1 ; }
	mv -f "$fileTmp" "$fileDir/answer.txt" 2> /dev/null || return 1
	printf '%s %s\n' "$( date +%s )" "${3:-0}" > "$fileDir/.state.txt" 2> /dev/null
}
