#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.SeenReaction.include -- the seen reaction (eyes) on a message handed to a member, given by the tooling.
##
## Given where a message is handed over (the member's Wait, the work-duty scan's collect), never by the scheduler's loop. One reaction for each message:
## a claim file in $MMDAPP/.local/agents/schedule/seen/<member>/<ts>, keyed by the Slack ts alone and taken back where the reaction fails.
## The member's own account reacts, the team bot where that account cannot reach the conversation. Dot-sourced; functions only.
##

AgentsToolsSeenReact(){ ## member, <conversation>:<ts> of the message
	local seenMember="$1" seenTarget="$2" seenTs seenDir
	seenTs="${seenTarget##*:}"
	case "$seenTs" in
		''|*[!0123456789.]*|.*|*.) return 1 ;;
	esac
	[ -n "$seenMember" ] && [ "${seenTarget%:*}" != "$seenTarget" ] || return 1
	seenDir="${MMDAPP:-/nonexistent}/.local/agents/schedule/seen/$seenMember"
	mkdir -p "$seenDir" 2> /dev/null || return 1
	( set -C ; : > "$seenDir/$seenTs" ) 2> /dev/null || return 0
	if DistroAgentsTools --intern-op-comms-slack-react "$seenMember" "$seenTarget" eyes > /dev/null 2>&1 \
		|| DistroAgentsTools --intern-op-comms-slack-react "$seenMember" "$seenTarget" eyes --identity-bot > /dev/null 2>&1 ; then
		return 0
	fi
	rm -f "$seenDir/$seenTs"
	return 1
}
