#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.CommsTelegram.include -- the Telegram driver of the channel-id abstraction (F7.1): what reaches a
## `telegram:<chat-id>` channel. It sits behind the registry (AgentsTools.CommsChannel.include) and is reached
## through the channel-id parse. Functions only, sourced, never run.
##
## A channel-id of the `telegram` service is `telegram:<chat-id>`; the chat-id is the destination the team's bot
## writes to. The bot token is read from the team's own settings (TELEGRAM_BOT_TOKEN, magic-team scope) and the
## send is one call of the Telegram Bot API `sendMessage` method through curl.
##

type AgentsToolsCommsChannelParse > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.CommsChannel.include"
type AgentsToolsCommsOwnSettingsApply > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.CommsSide.include"

## The chat id a `telegram:` channel-id names: its <address>, or nothing (rc 1) for a channel-id of another service.
AgentsToolsCommsTelegramChatId(){ ## channel-id
	local telegramParts telegramService telegramChatId
	telegramParts="$( AgentsToolsCommsChannelParse "$1" )" || return 1
	telegramService="$( printf '%s\n' "$telegramParts" | LC_ALL=C sed -n 's/^SERVICE=//p' )" ; telegramChatId="$( printf '%s\n' "$telegramParts" | LC_ALL=C sed -n 's/^ADDRESS=//p' )"
	[ "$telegramService" = telegram ] || return 1
	[ -n "$telegramChatId" ] || return 1
	printf '%s\n' "$telegramChatId"
}

## The bot token: the environment first (TELEGRAM_BOT_TOKEN, the same name the config store holds), then the member's own scope
## where this call reads it, then the team's shared scope (magic-team) unless the call is on the client side. Prints
## `<source> <token>` with the source environment-bot-token, member-bot-token or shared-bot-token; rc 1, nothing printed, for none.
AgentsToolsResolveTelegramBotToken(){ ## member
	local memberName="$1" resolvedToken=""
	if [ -n "${TELEGRAM_BOT_TOKEN:-}" ] ; then
		printf 'environment-bot-token %s\n' "$TELEGRAM_BOT_TOKEN"
		return 0
	fi
	if [ -n "$memberName" ] && [ "$memberName" != "magic-team" ] && AgentsToolsCommsOwnSettingsApply "$memberName" ; then
		resolvedToken="$( DistroAgentsTools --agents-config-option "$memberName" --select TELEGRAM_BOT_TOKEN 2> /dev/null )" || resolvedToken=""
		if [ -n "$resolvedToken" ] ; then
			printf 'member-bot-token %s\n' "$resolvedToken"
			return 0
		fi
	fi
	! AgentsToolsCommsClientSide "$memberName" || return 1
	resolvedToken="$( DistroAgentsTools --agents-config-option magic-team --select TELEGRAM_BOT_TOKEN 2> /dev/null )" || resolvedToken=""
	[ -n "$resolvedToken" ] || return 1
	printf 'shared-bot-token %s\n' "$resolvedToken"
}

## rc 0 where the word is a bare chat id: digits, with a minus at the head for a group.
AgentsToolsCommsTelegramBareChatId(){ ## word
	local chatWord="${1#-}"
	case "$chatWord" in ''|*[!0123456789]*) return 1 ;; esac
	return 0
}

## The chat id a value names: a `telegram:<chat-id>` channel-id (its id), a bare chat id (itself), or a declared name (the id of
## the first telegram channel it declares). rc 1, nothing printed, for a channel-id of another service and a name with none.
AgentsToolsCommsTelegramResolveAddress(){ ## channel-id, bare chat id or declared name
	local resolveValue="$1" resolveId=""
	case "$resolveValue" in
		*:*) AgentsToolsCommsTelegramChatId "$resolveValue" ; return $? ;;
	esac
	if AgentsToolsCommsTelegramBareChatId "$resolveValue" ; then
		printf '%s\n' "$resolveValue"
		return 0
	fi
	resolveId="$( AgentsToolsCommsChannelResolveDeclared "$resolveValue" | LC_ALL=C awk 'index( $0, "telegram:" ) == 1 { print substr( $0, 10 ) ; exit }' )"
	[ -n "$resolveId" ] || return 1
	printf '%s\n' "$resolveId"
}

## Send a text to a Telegram channel, as the member: one call of the Telegram Bot API sendMessage, the text on standard input
## (a urlencoded form field, never argv). Prints the API's own JSON response on stdout. rc 0 sent (`"ok":true`), rc 1 refused
## (nothing sent) or not confirmed.
AgentsToolsCommsTelegramSend(){ ## member, channel-id, bare chat id or declared name; the text on stdin
	local telegramMember="$1" telegramChannel="$2" telegramChatId telegramToken telegramText telegramOut telegramRc=0
	telegramChatId="$( AgentsToolsCommsTelegramResolveAddress "$telegramChannel" )" || {
		echo "⛔ ERROR: $MDSC_CMD: $telegramChannel names no telegram chat id -- the Telegram driver reaches telegram:<chat-id>, a chat id or a name that declares a telegram channel. Nothing was sent." >&2
		return 1
	}
	telegramToken="$( AgentsToolsResolveTelegramBotToken "$telegramMember" )" || telegramToken=""
	telegramToken="${telegramToken#* }"
	if [ -z "$telegramToken" ] ; then
		echo "⛔ ERROR: $MDSC_CMD: no TELEGRAM_BOT_TOKEN is set (environment, $telegramMember's scope or magic-team scope), so the Telegram driver cannot send. Nothing was sent." >&2
		return 1
	fi
	telegramText="$( cat )"
	if [ -z "$telegramText" ] ; then
		echo "⛔ ERROR: $MDSC_CMD: no text on standard input -- the Telegram driver sends the text it is given, and none was. Nothing was sent." >&2
		return 1
	fi
	telegramOut="$( printf '%s' "$telegramText" | curl -sS --data-urlencode "chat_id=$telegramChatId" --data-urlencode "text@-" "https://api.telegram.org/bot$telegramToken/sendMessage" 2>&1 )" || telegramRc=$?
	if [ "$telegramRc" != "0" ] ; then
		echo "⛔ ERROR: $MDSC_CMD: the Telegram send did not complete: $telegramOut" >&2
		return 1
	fi
	case "$telegramOut" in
		*'"ok":true'*) ;;
		*) echo "⛔ ERROR: $MDSC_CMD: Telegram did not confirm the send: $telegramOut" >&2 ; return 1 ;;
	esac
	printf '%s\n' "$telegramOut"
}
