#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.CommsEmail.include -- the email driver of the channel-id abstraction (F7.1): what reaches an
## `email:<address>` channel. It sits behind the registry (AgentsTools.CommsChannel.include) and is reached
## through the channel-id parse, never as a member's own surface -- a member's own email is
## AgentsTools.MemberCommsEmail.include. Functions only, sourced, never run.
##
## A channel-id of the `email` service is `email:<address>`; the address is the destination the team's own
## send writes to. The send itself is the one real email send the tooling already has
## (`--intern-op-comms-email-send`), reached here with the address the channel-id names.
##

type AgentsToolsCommsChannelParse > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.CommsChannel.include"

## The address an `email:` channel-id names: its <address>, or nothing (rc 1) for a channel-id of another service.
AgentsToolsCommsEmailAddress(){ ## channel-id
	local emailParts emailService emailAddress
	emailParts="$( AgentsToolsCommsChannelParse "$1" )" || return 1
	emailService="$( printf '%s\n' "$emailParts" | LC_ALL=C sed -n 's/^SERVICE=//p' )" ; emailAddress="$( printf '%s\n' "$emailParts" | LC_ALL=C sed -n 's/^ADDRESS=//p' )"
	[ "$emailService" = email ] || return 1
	[ -n "$emailAddress" ] || return 1
	printf '%s\n' "$emailAddress"
}

## The address a value names: an `email:<address>` channel-id (its address), a bare address (itself), or a declared name
## (the address of the first email channel it declares, AgentsToolsCommsChannelResolveDeclared). rc 1, nothing printed,
## for a channel-id of another service, an empty one, and a name that declares no email channel.
AgentsToolsCommsEmailResolveAddress(){ ## channel-id, bare address or declared name
	local resolveValue="$1" resolveAddress=""
	case "$resolveValue" in
		*:*) AgentsToolsCommsEmailAddress "$resolveValue" ; return $? ;;
		*@*) printf '%s\n' "$resolveValue" ; return 0 ;;
	esac
	resolveAddress="$( AgentsToolsCommsChannelResolveDeclared "$resolveValue" | LC_ALL=C awk 'index( $0, "email:" ) == 1 { print substr( $0, 7 ) ; exit }' )"
	[ -n "$resolveAddress" ] || return 1
	printf '%s\n' "$resolveAddress"
}

## Send a text to an email channel, as the member: the team's own email send, to the address the value names (a channel-id,
## an address or a declared name). The subject is the trailing argument, the body is on standard input.
## Prints the send's own output; rc 0 sent, rc 1 refused (nothing sent).
AgentsToolsCommsEmailSend(){ ## member, channel-id or declared name, subject, then the body on stdin
	local emailMember="$1" emailChannel="$2" emailSubject="${3:-}" emailAddress
	emailAddress="$( AgentsToolsCommsEmailResolveAddress "$emailChannel" )" || {
		echo "⛔ ERROR: $MDSC_CMD: $emailChannel names no email address -- the email driver reaches email:<address>, an address or a name that declares an email channel. Nothing was sent." >&2
		return 1
	}
	[ -n "$emailSubject" ] || {
		echo "⛔ ERROR: $MDSC_CMD: an email needs a subject. Nothing was sent." >&2
		return 1
	}
	type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
	DistroAgentsTools --intern-op-comms-email-send "$emailMember" "$emailAddress" -- "$emailSubject" -- --from-stdin
}

## THE MESSAGE CACHE, the form every service keeps (epic S21.13, owner 2026-10-28): `<service>/<service>-<id>/YYYYMM/messages.txt`,
## one line a message, the whole body in `YYYYMM/<uid>.body.txt` where a line would pass the cap, and `.state.txt` for the
## pointers. Email keys on its account and mailbox, a message on its UID, and a message's month on its own date: a mailbox's
## UIDs say nothing of when a mail came. Nothing of a body is ever cut away, a 25 MB mail included.
AgentsToolsCommsEmailCacheDir(){ ## account, mailbox
	type AgentsToolsCommsCacheDir > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.CommsCache.include"
	AgentsToolsCommsCacheDir email "$1-${2:-INBOX}"
}

## One fetched mail into the cache: its line, its whole body beside it, its UID the pointer that widens. A UID the folder already
## holds is left as it is, so a second pass rewrites no body. Sets nothing. rc 1 where the folder cannot hold it.
AgentsToolsCommsEmailCacheFile(){ ## cache folder, uid, month (YYYYMM), from, subject, the body file
	local mailFolder="$1" mailUid="$2" mailMonth="$3" mailFrom="$4" mailSubject="$5" mailBody="$6"
	local mailLine mailBodyName mailStateAt mailStateFrom mailStateNewest mailStateTmp mailCap="${agentsCommsCacheLineCap:-2000}"
	case "$mailUid$mailMonth" in ''|*[!0-9]*) return 1 ;; esac
	mkdir -p "$mailFolder/$mailMonth" 2> /dev/null || return 1
	mailLine="$mailUid | $mailFrom | $mailSubject"
	mailBodyName="$mailMonth/$mailUid.body.txt"
	if [ -s "$mailBody" ] ; then
		cp -f "$mailBody" "$mailFolder/$mailBodyName" 2> /dev/null || return 1
		[ "${#mailLine}" -le "$mailCap" ] || mailLine="${mailLine:0:$mailCap}"
		mailLine="$mailLine [body: $mailUid.body.txt]"
	fi
	LC_ALL=C grep -q "^$mailUid | " "$mailFolder/$mailMonth/messages.txt" 2> /dev/null || printf '%s\n' "$mailLine" >> "$mailFolder/$mailMonth/messages.txt" || return 1
	mailStateAt="$( date +%s )"
	mailStateFrom="" mailStateNewest=""
	[ ! -f "$mailFolder/.state.txt" ] || { read -r mailStateAt mailStateFrom mailStateNewest < "$mailFolder/.state.txt" ; } 2> /dev/null || :
	mailStateTmp="$( mktemp "$mailFolder/.state.txt.XXXXXX" 2> /dev/null )" || return 1
	printf '%s %s %s\n' "$( date +%s )" "${mailStateFrom:-$mailUid}" "$mailUid" > "$mailStateTmp" && mv -f "$mailStateTmp" "$mailFolder/.state.txt" || return 1
}

## The mails of a folder strictly after a floor UID, as a read prints them: each line whole, a body the line names restored under
## it. Nothing above the floor, nothing twice. rc 1 where the folder holds no state.
AgentsToolsCommsEmailCacheServe(){ ## cache folder, floor uid
	local serveFolder="$1" serveFloor="$2" serveDir
	[ -f "$serveFolder/.state.txt" ] || return 1
	for serveDir in "$serveFolder"/[0-9][0-9][0-9][0-9][0-9][0-9] ; do
		[ -f "$serveDir/messages.txt" ] || continue
		LC_ALL=C awk -v floorUid="${serveFloor:-0}" -v dir="$serveDir" '
			$1 + 0 <= floorUid + 0 { next }
			{
				print
				if ( index($0, " [body: " $1 ".body.txt]") ) { body = dir "/" $1 ".body.txt" ; while ( ( getline line < body ) > 0 ) { print line } ; close(body) }
			}' "$serveDir/messages.txt"
	done
}

## One mail the cache already holds, by its UID: the whole message this read would fetch, printed as the fetch prints it. rc 1
## where the folder holds no such UID, which is the caller's cue to fetch it and file it.
AgentsToolsCommsEmailCacheMessage(){ ## cache folder, uid
	local heldFolder="$1" heldUid="$2" heldMonth heldFile
	case "$heldUid" in ''|*[!0-9]*) return 1 ;; esac
	for heldMonth in "$heldFolder"/[0-9][0-9][0-9][0-9][0-9][0-9] ; do
		heldFile="$heldMonth/$heldUid.body.txt"
		[ -f "$heldFile" ] || continue
		cat "$heldFile"
		return 0
	done
	return 1
}
