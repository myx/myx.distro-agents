#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.CommsEmail.include -- the email driver of the channel-id abstraction (F7.1): what reaches an
## `email:<address>` channel. It sits behind the registry (AgentsTools.CommsChannel.include) and is reached
## through the channel-id parse, never as a member's own surface -- a member's own email is
## AgentsTools.MemberCommsEmail.include. Functions only, sourced, never run.
##
## A channel-id of the `email` service is `email:<address>`; the address is the destination the team's own
## send writes to. The send itself is the one real email send the tooling already has
## (`--intern-op-comms-email-send`), reached here with the address the channel-id names.
##

type AgentsToolsCommsChannelParse > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.CommsChannel.include"

## The address an `email:` channel-id names: its <address>, or nothing (rc 1) for a channel-id of another service.
AgentsToolsCommsEmailAddress(){ ## channel-id
	local emailParts emailService emailAddress
	emailParts="$( AgentsToolsCommsChannelParse "$1" )" || return 1
	emailService="$( printf '%s\n' "$emailParts" | LC_ALL=C sed -n 's/^SERVICE=//p' )" ; emailAddress="$( printf '%s\n' "$emailParts" | LC_ALL=C sed -n 's/^ADDRESS=//p' )"
	[ "$emailService" = email ] || return 1
	[ -n "$emailAddress" ] || return 1
	printf '%s\n' "$emailAddress"
}

## The address a value names: an `email:<address>` channel-id (its address), a bare address (itself), or a declared name
## (the address of the first email channel it declares, AgentsToolsCommsChannelResolveDeclared). rc 1, nothing printed,
## for a channel-id of another service, an empty one, and a name that declares no email channel.
AgentsToolsCommsEmailResolveAddress(){ ## channel-id, bare address or declared name
	local resolveValue="$1" resolveAddress=""
	case "$resolveValue" in
		*:*) AgentsToolsCommsEmailAddress "$resolveValue" ; return $? ;;
		*@*) printf '%s\n' "$resolveValue" ; return 0 ;;
	esac
	resolveAddress="$( AgentsToolsCommsChannelResolveDeclared "$resolveValue" | LC_ALL=C awk 'index( $0, "email:" ) == 1 { print substr( $0, 7 ) ; exit }' )"
	[ -n "$resolveAddress" ] || return 1
	printf '%s\n' "$resolveAddress"
}

## Send a text to an email channel, as the member: the team's own email send, to the address the value names (a channel-id,
## an address or a declared name). The subject is the trailing argument, the body is on standard input.
## Prints the send's own output; rc 0 sent, rc 1 refused (nothing sent).
AgentsToolsCommsEmailSend(){ ## member, channel-id or declared name, subject, then the body on stdin
	local emailMember="$1" emailChannel="$2" emailSubject="${3:-}" emailAddress
	emailAddress="$( AgentsToolsCommsEmailResolveAddress "$emailChannel" )" || {
		echo "⛔ ERROR: $MDSC_CMD: $emailChannel names no email address -- the email driver reaches email:<address>, an address or a name that declares an email channel. Nothing was sent." >&2
		return 1
	}
	[ -n "$emailSubject" ] || {
		echo "⛔ ERROR: $MDSC_CMD: an email needs a subject. Nothing was sent." >&2
		return 1
	}
	DistroAgentsTools --intern-op-comms-email-send "$emailMember" "$emailAddress" -- "$emailSubject" -- --from-stdin
}
