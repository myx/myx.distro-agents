#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.ManagerHelp.include -- the --manager-help-* operations: the console's own read
## of the help of this tool, as it is written. Sourced from the `--manager-help-*)` arm of
## AgentsTools.Manager.include; who may call was asked where the family is dispatched.
##
## IT WRITES NO HELP. It prints on stdout what the tool prints elsewhere on stderr, and only
## that: what a user calls, the syntax lines of the help but those of the families it leaves
## out, named in one line below; then every operation of the manual, by the two awk files
## --member-help prints a member's operations by (AgentsTools.MemberHelp.include), with every
## operation on their list; then the chapters of the help file but its options, a row a line.
##

case "$1" in

	--manager-help-read)
		shift
		if [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --manager-help-read: takes no arguments" >&2
			set +e ; return 1
		fi
		## What a user calls, which the root `Manuals (Help)` shows of itself: every syntax line of
		## the help, each once in its order, but those of the families named here, the internal
		## ones and those the agents call (a member's, the librarian's, the coordinator's, a
		## client's, a routine's, a console channel's). The rule is this one line.
		local helpReadOut='--intern- --member- --librarian- --magic- --client- --routine- --console-'
		LC_ALL=C awk -v out="$helpReadOut" '
			BEGIN { count = split(out, outs, " ") }
			/^echo "📘 syntax: DistroAgentsTools\.fn\.sh \[?--/ {
				msg = $0 ; sub(/^echo "/, "", msg) ; sub(/" >&2$/, "", msg)
				name = msg ; sub(/^📘 syntax: DistroAgentsTools\.fn\.sh \[?/, "", name)
				for (i = 1; i <= count; i++) { if (index(name, outs[i]) == 1) { next } }
				if (!(msg in seen)) { seen[msg] = 1 ; print msg }
			}' "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/help/Help.DistroAgentsTools.include" || { set +e ; return 1 ; }
		echo
		## Every operation, as --member-help prints those of a member: `--*` puts each on the list.
		local -x MDAT_MEMBER_HELP_NAMES='--*'
		LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsMemberHelpToolingLinesFilter.awk" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/help/Help.DistroAgentsTools.include" || { set +e ; return 1 ; }
		LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsMemberHelpEntriesRender.awk" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/help/Help.DistroAgentsTools.help.md" || { set +e ; return 1 ; }
		## The chapters of the help file but its options, which a member's `Member Help` shows around
		## the member's syntax lines: each line a row, `chapter`, then `head` for one before the first
		## option, the heading of the options the last of them, or `foot` for one after the options,
		## then the line as it is written. The syntax lines that open the file are not among them; the
		## options are where the entries above are read from (AgentsMemberHelpEntriesRender.awk).
		LC_ALL=C awk '
			/^## / { inOptions = ( $0 ~ /^##  Options:/ ) ; if ( inOptions ) { print "chapter\thead\t" $0 ; past = 1 ; next } }
			inOptions || ( !past && /^📘 syntax:/ ) { next }
			{ print "chapter\t" ( past ? "foot" : "head" ) "\t" $0 }' "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/help/Help.DistroAgentsTools.help.md" || { set +e ; return 1 ; }
		return 0
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
