#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.SpawnSandbox.include -- what a spawn sandbox's input/ holds, and when it
## is emptied. Sourced, never run. Functions only. Contract: MAGIC.md, "Spawn sandbox input/".
##

## Path-like words of a text that name something on disk, one resolved path per line.
AgentsToolsSpawnSandboxNamedPaths(){ ## text
	local namedWord namedPath
	printf '%s\n' "$1" | LC_ALL=C grep -oE '[A-Za-z0-9_.~/-]*[A-Za-z0-9_.-]/[A-Za-z0-9_./-]+' | LC_ALL=C sort -u | while IFS= read -r namedWord ; do
		namedWord="${namedWord%%:*}"
		for namedPath in "$MMDAPP/source/$namedWord" "$MMDAPP/source"/*/"$namedWord" "$MMDAPP/$namedWord" "$namedWord" ; do
			[ -e "$namedPath" ] || continue
			printf '%s\n' "$namedPath"
			break
		done
	done
}

## The nearest MAGIC.md above a path, never above $MMDAPP/source.
AgentsToolsSpawnSandboxNearestMagic(){ ## path
	local magicDir="$1"
	[ -d "$magicDir" ] || magicDir="${magicDir%/*}"
	magicDir="$( cd "$magicDir" 2>/dev/null && pwd -P )" || return 0
	local sourceRoot
	sourceRoot="$( cd "$MMDAPP/source" 2>/dev/null && pwd -P )" || return 0
	while [ -n "$magicDir" ] ; do
		case "$magicDir/" in "$sourceRoot"/*) ;; *) return 0 ;; esac
		[ ! -f "$magicDir/MAGIC.md" ] || { printf '%s\n' "$magicDir/MAGIC.md" ; return 0 ; }
		[ "$magicDir" != "$sourceRoot" ] || return 0
		magicDir="${magicDir%/*}"
	done
}

## Fills input/: the brief, the board item behind it, the MAGIC.md copies, a named
## routine, and pointers.md. Copies, never links, and never secret material: the
## credentials line in pointers.md names the identity the tooling acts as, not a value.
AgentsToolsSpawnSandboxFillInput(){ ## sandbox root, brief text, board item path (may be empty), member
	local fillInput="$1/input" fillBrief="$2" fillItem="$3" fillMember="$4"
	local fillText fillPath fillMagic fillName fillCount=0 fillSkillsRoot fillMemberDir
	[ -d "$fillInput" ] || return 0
	## A joined sandbox may hold a run's read-only input/ still: opened and emptied first.
	AgentsToolsSpawnSandboxCleanInput "$1"
	printf '%s\n' "$fillBrief" > "$fillInput/dispatch.md" || {
		echo "⚠️ WARNING: $MDSC_CMD: could not write $fillInput/dispatch.md, so this spawn's input/ holds no brief" >&2
		return 0
	}
	fillText="$fillBrief"
	if [ -n "$fillItem" ] && [ -f "$fillItem" ] ; then
		cp -p "$fillItem" "$fillInput/${fillItem##*/}" 2>/dev/null
		fillText="$fillText"$'\n'"$( cat "$fillItem" 2>/dev/null )"
	fi
	## MAGIC.md of every repo or package the brief or its item names, else the workspace's.
	while IFS= read -r fillPath ; do
		fillMagic="$( AgentsToolsSpawnSandboxNearestMagic "$fillPath" )"
		[ -n "$fillMagic" ] || continue
		fillName="${fillMagic#"$( cd "$MMDAPP/source" && pwd -P )"/}"
		fillName="MAGIC.${fillName%/MAGIC.md}.md"
		fillName="${fillName//\//--}"
		[ -e "$fillInput/$fillName" ] || { cp -p "$fillMagic" "$fillInput/$fillName" 2>/dev/null && fillCount=$(( fillCount + 1 )) ; }
	done < <( AgentsToolsSpawnSandboxNamedPaths "$fillText" )
	if [ "$fillCount" -eq 0 ] && [ -f "$MMDAPP/MAGIC.md" ] ; then
		cp -p "$MMDAPP/MAGIC.md" "$fillInput/MAGIC.workspace.md" 2>/dev/null
	fi
	## Routines and skillset files: a named routine is copied; every skillset file is a pointer.
	fillSkillsRoot="${MDAT_SKILLSET_ROOT:-$HOME/.claude/skills}"
	{
		printf '%s\n' "# Pointers for this spawn" ""
		printf '%s\n' "Credentials: none are copied here. The team tooling acts as \`$fillMember\` for this spawn and resolves that member's credentials itself."
		printf '%s\n' ""
		printf '%s\n' "$fillText" | LC_ALL=C grep -oE '[a-z0-9][a-z0-9-]*(\.[a-z0-9-]+)+\.md' | LC_ALL=C sort -u | while IFS= read -r fillName ; do
			for fillMemberDir in "$fillSkillsRoot"/*/ ; do
				[ -f "$fillMemberDir$fillName" ] || continue
				case "$fillName" in
					*.routine.md)
						cp -p "$fillMemberDir$fillName" "$fillInput/$fillName" 2>/dev/null && printf '%s\n' "- \`$fillName\`: copied here; also readable with Skill, name \`$( basename "${fillMemberDir%/}" )\`, file \`$fillName\`"
					;;
					*)
						printf '%s\n' "- \`$fillName\`: read with Skill, name \`$( basename "${fillMemberDir%/}" )\`, file \`$fillName\`"
					;;
				esac
				break
			done
		done
	} > "$fillInput/pointers.md" 2>/dev/null
	## Read-only by mode, whatever the client's access flag can say: a flag with no verb
	## grants input/ for writing too, so the files and the folder carry no write bit.
	chmod -R a-w "$fillInput" 2>/dev/null || :
	return 0
}

## Empties input/ and keeps input/ itself, output/ and the root record.
AgentsToolsSpawnSandboxCleanInput(){ ## sandbox root
	[ -d "$1/input" ] || return 0
	chmod -R u+w "$1/input" 2>/dev/null || :
	find "$1/input" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} + 2>/dev/null
	return 0
}

## This caller's own coworking-session thread, from the one-line pointer file the
## spawn proxy writes beside event-track.thread in the sandbox root -- prints
## "channel:ts" and returns 0 when it exists and holds a value, prints nothing and
## returns 1 otherwise (no coworking session, or the file is not written yet).
## Falls back to a key on $MDAT_SPAWN_SESSION_ID, the sandbox root's own name, only
## once $MDAT_SESSION_THREAD is unset -- a caller spawned with an explicit --tracking-name
## can diverge from that, and settling which id the sandbox folder is actually named for
## is keeper-myx's own open item, not decided here.
AgentsToolsSessionThreadFind(){
	## MDAT_SESSION_THREAD is exported directly by spawn-proxy at launch, correct
	## for every participant alike -- founding or joining a coworking session.
	## Preferred over the file lookup below, which keys off MDAT_SPAWN_SESSION_ID,
	## a value that is this spawn's own spawn-id, not the shared session folder,
	## for every participant after the session's first.
	[ -z "${MDAT_SESSION_THREAD:-}" ] || { printf '%s\n' "$MDAT_SESSION_THREAD" ; return 0 ; }
	[ -n "${MDAT_SPAWN_SESSION_ID:-}" ] || return 1
	local threadFile="$MMDAPP/.local/agents/spawned/$MDAT_SPAWN_SESSION_ID/session.thread"
	local threadLine=""
	[ -f "$threadFile" ] && IFS= read -r threadLine < "$threadFile" || return 1
	[ -n "$threadLine" ] || return 1
	printf '%s\n' "$threadLine"
	return 0
}

## Empties input/ of every sandbox on this host with no live session, and says which.
## A sandbox recorded on another host, or with any session still running, is never touched.
AgentsToolsSpawnSandboxSweep(){ ## where
	local sweepRoot="$MMDAPP/.local/agents/spawned" sweepDir sweepRecord sweepSession sweepHost sweepLive thisHost psText
	[ -d "$sweepRoot" ] || return 0
	thisHost="$( hostname -s 2>/dev/null )" || thisHost="unknown"
	psText="$( ps -A -ww -o args= 2>/dev/null )" || return 0
	for sweepDir in "$sweepRoot"/*/ ; do
		sweepDir="${sweepDir%/}"
		[ -d "$sweepDir/input" ] || continue
		[ -n "$( find "$sweepDir/input" -mindepth 1 -maxdepth 1 2>/dev/null | head -1 )" ] || continue
		## A sandbox with no record, or with a record under 10 minutes old, may still be launching.
		sweepLive="no-record"
		for sweepRecord in "$sweepDir"/*.md ; do
			[ -f "$sweepRecord" ] || continue
			sweepLive=""
			if [ -n "$( find "$sweepRecord" -mmin -10 2>/dev/null )" ] ; then sweepLive="launching" ; break ; fi
			## spawn-id, not session-id: session-id is now the coworking session's own
			## shared identifier, which a joined spawn's own process never carries in
			## its argv, where spawn-id (this process's own identity) always does.
			sweepSession="$( LC_ALL=C awk '/^spawn-id: /{ print substr($0, 11) ; exit ; }' "$sweepRecord" )"
			sweepHost="$( LC_ALL=C awk '/^host: /{ print substr($0, 7) ; exit ; }' "$sweepRecord" )"
			if [ "$sweepHost" != "$thisHost" ] ; then sweepLive="other-host" ; break ; fi
			[ -n "$sweepSession" ] || continue
			case "$psText" in *"$sweepSession"*) sweepLive="running" ; break ;; esac
		done
		[ -z "$sweepLive" ] || continue
		AgentsToolsSpawnSandboxCleanInput "$sweepDir"
		echo "# $MDSC_CMD: $1: emptied input/ of ${sweepDir##*/}, whose session is no longer running" >&2
	done
	return 0
}

## Which board state folder actually holds an item, or empty when none does.
## --intern-op-data-read searches several lookup folders and does not report which
## one matched, and the board upsert has to be told the state -- so it is
## established here rather than assumed to be `running`, which is true only of a
## document this op created itself. A reused tracking document belongs to a caller
## and may sit in any state; moving it would relocate that caller's own work item
## as a side effect of spawning.
AgentsToolsSpawnProxyBoardStateOf(){ ## item-filename
	local stateName
	for stateName in running pending review backlog blocked parked processed archived retained ; do
		if [ -f "$MDAT_DATA_ROOT/board/$stateName/$1" ] ; then
			printf '%s' "$stateName"
			return 0
		fi
	done
	return 0
}

AgentsToolsSpawnProxyCloseDispatch(){
	local itemName="$1" briefBody="$2" childExit="$3" childOutputFile="$4" outcome="$5"
	## Defaulted rather than required, so the create path calls this exactly as it
	## always has and only the reuse path names a state of its own.
	local itemState="${6:-running}"
	## Where the closed item rests, named by the caller rather than derived here.
	## Defaults to no move, so a caller naming no target keeps what it had: a
	## REUSED document belongs to a caller and is never relocated by a spawn
	## closing. One this op created itself moves to `review`, so `running` holds
	## only sessions that are actually running. It stops at `review` and not at
	## `processed` because grooming owns entry to that state -- human-owner ruling,
	## 2026-09-23: "grooming owns the state - but spawn moves to pending - ok? so
	## grooming sees" -- board-review now sits between them, entered here and left
	## only by a reviewer's own reject/accept. This op marks and parks; it never adjudicates the close.
	local itemTargetState="${7:-$itemState}"
	local currentBody resultBody
	currentBody="$( DistroAgentsTools --intern-op-data-read "$itemName" \
		--lookup-folder "$MDAT_DATA_ROOT/board/$itemState" \
		--context --intern-op-agent-spawn-proxy )" || currentBody="$briefBody"
	resultBody="$( printf '%s\n' \
		"$currentBody" \
		"" \
		"## Result" \
		"" \
		"status: $outcome" \
		"exit-code: $childExit" \
		"output-file: $childOutputFile" \
		"completed-at: $( date -u +%Y-%m-%dT%H:%M:%SZ )" )"
	mkdir -p "$MDAT_DATA_ROOT/board/$itemTargetState" || {
		echo "⚠️ WARNING: --intern-op-agent-spawn-proxy: can't create board state directory $MDAT_DATA_ROOT/board/$itemTargetState, so dispatch item $itemName was not closed" >&2
		return 0
	}
	printf '%s\n' "$resultBody" | DistroAgentsTools --intern-op-board-upsert-move-edit "$itemTargetState" "$itemName" \
		--from-state:"$itemState" \
		--header:upsert:status:dispatch-"$outcome" \
		--header:upsert:resolved-at:"$( date +"%Y-%m-%d %H:%M %z" )" \
		--upsert-from-stdin \
		--context --intern-op-agent-spawn-proxy \
		--log-verb:updated \
		|| echo "⚠️ WARNING: --intern-op-agent-spawn-proxy: could not close dispatch item $itemName" >&2
	return 0
}

## Closes the session tracking file by updating its frontmatter, through this
## package's own header writer -- nothing here parses or re-emits frontmatter of its
## own. The headers ARE the state, so a close is a header update and never a rewrite
## of the file. A failure leaves the file exactly as it was: a tracking record that
## still says started is recoverable by a rescan, where a truncated one is not.
AgentsToolsSpawnProxyCloseSandbox(){ ## tracking file, outcome, exit code
	local sandboxFile="$1" sandboxOutcome="$2" sandboxExit="$3" sandboxOps sandboxBody
	[ -f "$sandboxFile" ] || return 0
	sandboxOps="$MMDAPP/.local/temp/mdat-session-header-ops.$$"
	mkdir -p "$MMDAPP/.local/temp" || return 0
	{
		## `status` carries the outcome, and `outcome` itself is deliberately absent:
		## the entity model defines that name with a closed set of values for what an
		## advance pass did to a running board item, so a spawn's exit result written
		## there would be an undefined value in a defined set. `resolved-at` is the
		## model's own conclusion stamp, and is used rather than a second spelling of
		## it. `exit-code` has no counterpart in the model at all, which is not a
		## re-mint: this file is the session's own record, not team data, so nothing
		## defines that concept for it.
		printf 'upsert\tstatus\tspawn-%s\n' "$sandboxOutcome"
		printf 'upsert\texit-code\t%s\n' "$sandboxExit"
		printf 'upsert\tresolved-at\t%s\n' "$( date +"%Y-%m-%d %H:%M %z" )"
		## Whether the session read its own duty file, as the harness recorded it beside this file.
		## "no" only where the harness loop ran and could see it; a native CLI's session is unknown.
		if [ -s "${sandboxFile%.md}.armed" ] ; then
			printf 'upsert\tarmed\tyes\n'
			printf 'upsert\tarmed-at\t%s\n' "$( head -1 "${sandboxFile%.md}.armed" )"
		elif [ -e "${sandboxFile%.md}.harness" ] ; then
			printf 'upsert\tarmed\tno\n'
		else
			printf 'upsert\tarmed\tunknown\n'
		fi
	} > "$sandboxOps" || return 0
	sandboxBody="$( LC_ALL=C awk -v opsFile="$sandboxOps" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsBoardItemHeaderOpsApply.awk" < "$sandboxFile" )" || sandboxBody=""
	rm -f "$sandboxOps"
	[ -n "$sandboxBody" ] || return 0
	printf '%s\n' "$sandboxBody" > "$sandboxFile"
	return 0
}

## One line to the daemon output, never stdout: fd 4 where execute opened it (the request's own stderr, not the result), else stderr, which is the log in a console or harness run.
AgentsToolsDaemonLine(){ ## text...
	if { : >&4 ; } 2> /dev/null ; then
		printf '%s\n' "$*" >&4
	else
		printf '%s\n' "$*" >&2
	fi
	return 0
}

## Reports housekeeping lines to the daemon output and as one message into this spawn's own event-track thread; nothing goes to stdout or stderr. No thread, no post.
AgentsToolsHousekeepingReport(){ ## member, lines
	local reportThread="" reportRoot="${MDAT_SPAWN_SANDBOX_ROOT:-}" reportLine
	[ -n "$2" ] || return 0
	while IFS= read -r reportLine ; do
		AgentsToolsDaemonLine "$reportLine"
	done <<< "$2"
	[ -n "$reportRoot" ] || [ -z "${MDAT_SPAWN_SESSION_ID:-}" ] || reportRoot="$MMDAPP/.local/agents/spawned/$MDAT_SPAWN_SESSION_ID"
	[ -s "$reportRoot/event-track.thread" ] || return 0
	IFS= read -r reportThread < "$reportRoot/event-track.thread" || :
	[ -n "$reportThread" ] || return 0
	printf '%s\n' "$2" | DistroAgentsTools --member-comms-slack-send-message "$1" "$reportThread" --identity-bot --from-stdin > /dev/null 2>&1 || :
	return 0
}

## First value of one frontmatter header of a file, empty when absent. Bounded to the frontmatter block, so a body line cannot spoof it.
AgentsToolsSpawnSandboxRecordHeader(){ ## file, header
	LC_ALL=C awk -v wantHeader="$2" '
		$0 == "---" { fmCount++ ; if ( fmCount > 1 ) { exit ; } next ; }
		fmCount == 1 && index( $0, wantHeader ": " ) == 1 { print substr( $0, length( wantHeader ) + 3 ) ; exit ; }
	' "$1" 2> /dev/null || :
}

## Sandbox folder names linked to one board item, one per line, sorted, empty when none. Two links, either one is enough:
## the item's own spawn-id naming a record, and a record's spawns/spawned-by naming the item. An empty or `-` spawn-id matches nothing.
AgentsToolsSpawnSandboxFoldersOfItem(){ ## item path
	local itemStem="${1##*/}" itemSpawn
	itemStem="${itemStem%.md}"
	itemSpawn="$( AgentsToolsSpawnSandboxRecordHeader "$1" spawn-id )"
	[ -d "$MMDAPP/.local/agents/spawned" ] || return 0
	LC_ALL=C awk -v wantStem="$itemStem" -v wantSpawn="$itemSpawn" '
		FNR == 1 {
			fmCount = 0 ;
			folderName = FILENAME ; sub( /\/[^\/]*$/, "", folderName ) ; sub( /^.*\//, "", folderName ) ;
			recordName = FILENAME ; sub( /^.*\//, "", recordName ) ;
			if ( wantSpawn != "" && wantSpawn != "-" && recordName == wantSpawn ".md" ) { print folderName ; }
		}
		$0 == "---" { fmCount++ ; next ; }
		fmCount == 1 && ( index( $0, "spawns: " ) == 1 || index( $0, "spawned-by: " ) == 1 ) {
			linkText = $0 ; sub( /^[^:]*: /, "", linkText ) ;
			partCount = split( linkText, linkParts, / *, */ ) ;
			for ( partIndex = 1 ; partIndex <= partCount ; partIndex++ ) {
				linkStem = linkParts[partIndex] ; sub( /\.md$/, "", linkStem ) ;
				if ( linkStem == wantStem ) { print folderName ; break ; }
			}
		}
	' "$MMDAPP/.local/agents/spawned"/*/*.md 2> /dev/null | LC_ALL=C sort -u || :
}

## Whether a sandbox folder may be removed for one item that is going: `open` (a record still started or without a status),
## `shared` (another board item still links to it, or the folder is not a plain directory under the spawned root), else `removable`.
AgentsToolsSpawnSandboxFolderState(){ ## folder name, item stem going away
	local folderName="$1" skipStem="$2" spawnRoot="$MMDAPP/.local/agents/spawned"
	local recordPath recordStatus recordSpawn linkField linkText linkStem boardPath spawnIds=""
	case "$folderName" in ''|.|..|*/*) echo shared ; return 0 ;; esac
	[ -d "$spawnRoot/$folderName" ] && [ ! -L "$spawnRoot/$folderName" ] || { echo shared ; return 0 ; }
	for recordPath in "$spawnRoot/$folderName"/*.md ; do
		[ -f "$recordPath" ] || continue
		recordStatus="$( AgentsToolsSpawnSandboxRecordHeader "$recordPath" status )"
		case "$recordStatus" in ''|spawn-started) echo open ; return 0 ;; esac
	done
	for recordPath in "$spawnRoot/$folderName"/*.md ; do
		[ -f "$recordPath" ] || continue
		recordSpawn="${recordPath##*/}"
		spawnIds="$spawnIds ${recordSpawn%.md}"
		for linkField in spawns spawned-by ; do
			linkText="$( AgentsToolsSpawnSandboxRecordHeader "$recordPath" "$linkField" )"
			for linkStem in ${linkText//,/ } ; do
				linkStem="${linkStem%.md}"
				[ "$linkStem" != "$skipStem" ] || continue
				for boardPath in "$MDAT_DATA_ROOT"/board/*/"$linkStem.md" ; do
					[ ! -f "$boardPath" ] || { echo shared ; return 0 ; }
				done
			done
		done
	done
	if LC_ALL=C awk -v wantIds="$spawnIds" -v skipStem="$skipStem" '
		BEGIN { idCount = split( wantIds, idParts, " " ) ; for ( idIndex = 1 ; idIndex <= idCount ; idIndex++ ) { idSet[idParts[idIndex]] = 1 ; } }
		FNR == 1 { fmCount = 0 ; fileBase = FILENAME ; sub( /^.*\//, "", fileBase ) ; skipFile = ( fileBase == skipStem ".md" ) ; }
		skipFile { next ; }
		$0 == "---" { fmCount++ ; next ; }
		fmCount == 1 && index( $0, "spawn-id: " ) == 1 && ( substr( $0, 11 ) in idSet ) { found = 1 ; exit ; }
		END { exit ( found ? 0 : 1 ) ; }
	' "$MDAT_DATA_ROOT"/board/*/*.md 2> /dev/null ; then
		echo shared ; return 0
	fi
	echo removable
	return 0
}
