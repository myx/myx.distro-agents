#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.SpawnSandbox.include -- what a spawn sandbox's input/ holds, and when it
## is emptied. Sourced, never run. Functions only. Contract: MAGIC.md, "Spawn sandbox input/".
##

## Path-like words of a text that name something on disk, one resolved path per line.
AgentsToolsSpawnSandboxNamedPaths(){ ## text
	local namedWord namedPath
	printf '%s\n' "$1" | LC_ALL=C grep -oE '[A-Za-z0-9_.~/-]*[A-Za-z0-9_.-]/[A-Za-z0-9_./-]+' | LC_ALL=C sort -u | while IFS= read -r namedWord ; do
		namedWord="${namedWord%%:*}"
		for namedPath in "$MMDAPP/source/$namedWord" "$MMDAPP/source"/*/"$namedWord" "$MMDAPP/$namedWord" "$namedWord" ; do
			[ -e "$namedPath" ] || continue
			printf '%s\n' "$namedPath"
			break
		done
	done
}

## The nearest MAGIC.md above a path, never above $MMDAPP/source.
AgentsToolsSpawnSandboxNearestMagic(){ ## path
	local magicDir="$1"
	[ -d "$magicDir" ] || magicDir="${magicDir%/*}"
	magicDir="$( cd "$magicDir" 2>/dev/null && pwd -P )" || return 0
	local sourceRoot
	sourceRoot="$( cd "$MMDAPP/source" 2>/dev/null && pwd -P )" || return 0
	while [ -n "$magicDir" ] ; do
		case "$magicDir/" in "$sourceRoot"/*) ;; *) return 0 ;; esac
		[ ! -f "$magicDir/MAGIC.md" ] || { printf '%s\n' "$magicDir/MAGIC.md" ; return 0 ; }
		[ "$magicDir" != "$sourceRoot" ] || return 0
		magicDir="${magicDir%/*}"
	done
}

## Fills input/: the brief, the board item behind it, the MAGIC.md copies,
## pointers.md, and conversation.md when the spawn continues a conversation.
## Copies, never links, and never secret material: the
## credentials line in pointers.md names the identity the tooling acts as, not a value.
AgentsToolsSpawnSandboxFillInput(){ ## sandbox root, brief text, board item path (may be empty), member, conversation threads (may be empty)
	local fillInput="$1/input" fillBrief="$2" fillItem="$3" fillMember="$4" fillConversations="${5:-}"
	local fillText fillPath fillMagic fillName fillCount=0 fillMembers fillMemberName fillMemberDir
	[ -d "$fillInput" ] || return 0
	## A joined sandbox may hold a run's read-only input/ still: opened and emptied first.
	AgentsToolsSpawnSandboxCleanInput "$1"
	printf '%s\n' "$fillBrief" > "$fillInput/dispatch.md" || {
		echo "⚠️ WARNING: $MDSC_CMD: could not write $fillInput/dispatch.md, so this spawn's input/ holds no brief" >&2
		return 0
	}
	fillText="$fillBrief"
	if [ -n "$fillItem" ] && [ -f "$fillItem" ] ; then
		cp -p "$fillItem" "$fillInput/${fillItem##*/}" 2>/dev/null
		fillText="$fillText"$'\n'"$( cat "$fillItem" 2>/dev/null )"
	fi
	## MAGIC.md of every repo or package the brief or its item names, else the workspace's.
	while IFS= read -r fillPath ; do
		fillMagic="$( AgentsToolsSpawnSandboxNearestMagic "$fillPath" )"
		[ -n "$fillMagic" ] || continue
		fillName="${fillMagic#"$( cd "$MMDAPP/source" && pwd -P )"/}"
		fillName="MAGIC.${fillName%/MAGIC.md}.md"
		fillName="${fillName//\//--}"
		[ -e "$fillInput/$fillName" ] || { cp -p "$fillMagic" "$fillInput/$fillName" 2>/dev/null && fillCount=$(( fillCount + 1 )) ; }
	done < <( AgentsToolsSpawnSandboxNamedPaths "$fillText" )
	if [ "$fillCount" -eq 0 ] && [ -f "$MMDAPP/MAGIC.md" ] ; then
		cp -p "$MMDAPP/MAGIC.md" "$fillInput/MAGIC.workspace.md" 2>/dev/null
	fi
	## Routines and skillset files: every one is a pointer, routines included. A copy is a
	## snapshot of whatever tree the root resolved to at spawn time, and the brief has the
	## spawn read its routine through the skillset reader anyway, which serves the live file.
	## Every member's folder, a member of another workspace included (AgentsTools.TeamRegistry.include).
	type AgentsToolsTeamMemberDirectoryText > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.TeamRegistry.include"
	fillMembers="$( AgentsToolsTeamMemberDirectoryText )"
	{
		printf '%s\n' "# Pointers for this spawn" ""
		printf '%s\n' "Credentials: none are copied here. The team tooling acts as \`$fillMember\` for this spawn and resolves that member's credentials itself."
		printf '%s\n' ""
		printf '%s\n' "$fillText" | LC_ALL=C grep -oE '[a-z0-9][a-z0-9-]*(\.[a-z0-9-]+)+\.md' | LC_ALL=C sort -u | while IFS= read -r fillName ; do
			while IFS=$'\t' read -r fillMemberName fillMemberDir ; do
				[ -n "$fillMemberDir" ] && [ -f "$fillMemberDir/$fillName" ] || continue
				printf '%s\n' "- \`$fillName\`: read with Skill, name \`$fillMemberName\`, file \`$fillName\`"
				break
			done <<< "$fillMembers"
		done
	} > "$fillInput/pointers.md" 2>/dev/null
	[ -z "$fillConversations" ] || AgentsToolsSpawnConversationHistory "$fillInput/conversation.md" "$fillMember" "$fillConversations" "$fillItem"
	## Read-only by mode, whatever the client's access flag can say: a flag with no verb
	## grants input/ for writing too, so the files and the folder carry no write bit.
	chmod -R a-w "$fillInput" 2>/dev/null || :
	return 0
}

## Empties input/ and keeps input/ itself, output/ and the root record.
AgentsToolsSpawnSandboxCleanInput(){ ## sandbox root
	[ -d "$1/input" ] || return 0
	chmod -R u+w "$1/input" 2>/dev/null || :
	find "$1/input" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} + 2>/dev/null
	return 0
}

## This caller's own coworking-session thread, from the one-line pointer file the
## spawn proxy writes in the sandbox root (session.thread) -- prints
## "channel:ts" and returns 0 when it exists and holds a value, prints nothing and
## returns 1 otherwise (no coworking session, or the file is not written yet).
## Falls back to a key on $MDAT_SPAWN_SESSION_ID, the sandbox root's own name, only
## once $MDAT_SESSION_THREAD is unset -- a caller spawned with an explicit --tracking-name
## can diverge from that, and settling which id the sandbox folder is actually named for
## is keeper-myx's own open item, not decided here.
AgentsToolsSessionThreadFind(){
	## MDAT_SESSION_THREAD is exported directly by spawn-proxy at launch, correct
	## for every participant alike -- founding or joining a coworking session.
	## Preferred over the file lookup below, which keys off MDAT_SPAWN_SESSION_ID,
	## a value that is this spawn's own spawn-id, not the shared session folder,
	## for every participant after the session's first.
	[ -z "${MDAT_SESSION_THREAD:-}" ] || { printf '%s\n' "$MDAT_SESSION_THREAD" ; return 0 ; }
	[ -n "${MDAT_SPAWN_SESSION_ID:-}" ] || return 1
	local threadFile="$MMDAPP/.local/agents/spawned/$MDAT_SPAWN_SESSION_ID/session.thread"
	local threadLine=""
	[ -f "$threadFile" ] && IFS= read -r threadLine < "$threadFile" || return 1
	[ -n "$threadLine" ] || return 1
	printf '%s\n' "$threadLine"
	return 0
}

## The thread session-current names, and a send or an ask with no target goes to: this
## caller's own coworking-session thread (AgentsToolsSessionThreadFind), else the thread
## recorded for a session that is itself the coworking session -- a native client session,
## never spawned through the proxy, whose thread the first member it brings in opens. That
## record is one line, sessions/<session-id>/session.thread, written by the spawn proxy,
## and the session is found as the proxy finds it: the one this caller joined, else this
## caller's own. Prints "channel:ts" and returns 0; prints nothing and returns 1 for none.
## A bare Wait takes a spawn's thread by AgentsToolsSessionThreadFind alone
## (AgentsToolsWaitDefaultSources). With none it watches magic-team and human-owner, as it
## always has, and beside them the thread recorded here (--member-wait-for-input).
AgentsToolsSessionCurrentThreadFind(){
	AgentsToolsSessionThreadFind && return 0
	local currentSession="${MDAT_SESSION_ID:-${MDAT_SPAWN_SESSION_ID:-${CLAUDE_CODE_SESSION_ID:-}}}" currentLine=""
	case "$currentSession" in ''|*/*|.|..) return 1 ;; esac
	[ -n "${MMDAPP:-}" ] || return 1
	[ -f "$MMDAPP/.local/agents/sessions/$currentSession/session.thread" ] && IFS= read -r currentLine < "$MMDAPP/.local/agents/sessions/$currentSession/session.thread" || return 1
	[ -n "$currentLine" ] || return 1
	printf '%s\n' "$currentLine"
	return 0
}

## The thread of the session that started this one, from this session's own spawn record:
## prints "<channel>:<ts> <parent id>" and returns 0. Returns 1, nothing printed, when no
## parent session is recorded, and 2, the parent id printed, when that parent has no
## recorded thread. The sandbox folder is named by tracking name or session id, so records
## are found by file name.
AgentsToolsSessionParentThreadFind(){
	local parentRecord parentId="" parentThread=""
	for parentRecord in "${MMDAPP:-/nonexistent}"/.local/agents/spawned/*/"${MDAT_SPAWN_SESSION_ID:-none}.md" ; do
		[ ! -f "$parentRecord" ] || parentId="$( LC_ALL=C awk '/^parent-session-id: /{ sub( /^parent-session-id: /, "" ) ; print ; exit ; }' "$parentRecord" )"
		## The thread the spawn settled for its parent, magic-coordinator's when the parent had none.
		[ ! -f "$parentRecord" ] || parentThread="$( LC_ALL=C awk '/^---$/ { if ( ++fm == 2 ) exit ; next ; } fm == 1 && /^parent-thread: / { sub( /^parent-thread: /, "" ) ; print ; exit ; }' "$parentRecord" )"
	done
	if [ -z "$parentId" ] || [ "$parentId" = "none" ] ; then
		return 1
	fi
	[ -z "$parentThread" ] || { printf '%s %s\n' "$parentThread" "$parentId" ; return 0 ; }
	for parentRecord in "$MMDAPP"/.local/agents/spawned/*/"$parentId.md" ; do
		[ ! -f "$parentRecord" ] || parentThread="$( LC_ALL=C awk '/^session-thread: /{ sub( /^session-thread: /, "" ) ; print ; exit ; }' "$parentRecord" )"
	done
	if [ -z "$parentThread" ] ; then
		printf '%s\n' "$parentId" ; return 2
	fi
	printf '%s %s\n' "$parentThread" "$parentId"
}

## The member that made the spawn call this session was started by: as this session's own
## spawn record names it (`parent-member:`, written at the spawn), else, for a record written
## before that line was, the `owner:` of the spawn record of the session that started it.
## Prints the name and returns 0. Returns 1, nothing printed, when neither names one: such a
## record, and a parent that is a native client session, never spawned through the proxy.
AgentsToolsSessionParentMember(){
	local memberRecord memberParent="" memberOwner=""
	for memberRecord in "${MMDAPP:-/nonexistent}"/.local/agents/spawned/*/"${MDAT_SPAWN_SESSION_ID:-none}.md" ; do
		[ -f "$memberRecord" ] || continue
		memberOwner="$( AgentsToolsSpawnSandboxRecordHeader "$memberRecord" parent-member )"
		memberParent="$( AgentsToolsSpawnSandboxRecordHeader "$memberRecord" parent-session-id )"
	done
	[ -z "$memberOwner" ] || { printf '%s\n' "$memberOwner" ; return 0 ; }
	case "$memberParent" in ''|none|*/*|.|..) return 1 ;; esac
	for memberRecord in "$MMDAPP"/.local/agents/spawned/*/"$memberParent.md" ; do
		[ ! -f "$memberRecord" ] || memberOwner="$( AgentsToolsSpawnSandboxRecordHeader "$memberRecord" owner )"
	done
	[ -n "$memberOwner" ] || return 1
	printf '%s\n' "$memberOwner"
}

## A conversation thread is `<channel>:<ts>`: an upper-case Slack id and a message ts.
AgentsToolsSpawnConversationThreadValid(){ ## channel:ts
	printf '%s\n' "$1" | LC_ALL=C grep -qxE '[A-Z0-9]+:[0-9]+\.[0-9]+'
}

## The conversation threads a brief relays messages from, one `<channel>:<ts>` per line:
## a relayed Wait result's own "# arrived on: slack:<channel>:<ts>[:conversation]" line,
## and a Slack permalink carrying thread_ts. Nothing else in a brief is read as one.
AgentsToolsSpawnConversationDerive(){ ## brief text
	printf '%s\n' "$1" | LC_ALL=C awk '
		match( $0, /^# arrived on: slack:[A-Z0-9]+:[0-9]+\.[0-9]+/ ) {
			v = substr( $0, 21, RLENGTH - 20 ) ; if ( ! ( v in seen ) ) { seen[v] = 1 ; print v ; }
		}
		{
			rest = $0
			while ( match( rest, /\/archives\/[A-Z0-9]+\/p[0-9]+\?[^ >)]*thread_ts=[0-9]+\.[0-9]+/ ) ) {
				link = substr( rest, RSTART, RLENGTH ) ; rest = substr( rest, RSTART + RLENGTH )
				ch = link ; sub( /^\/archives\//, "", ch ) ; sub( /\/.*/, "", ch )
				ts = link ; sub( /.*thread_ts=/, "", ts )
				v = ch ":" ts ; if ( ! ( v in seen ) ) { seen[v] = 1 ; print v ; }
			}
		}'
}

## input/conversation.md: the recent history of each conversation thread this spawn continues,
## read as the member, newest MDAT_CONVERSATION_HISTORY_MAX messages (default 50), oldest first.
## A post tagged [sender: <member>] is marked (own); one by another member (team: <name>).
## A thread that cannot be read says so in the file, never reads as an empty one.
## The board item behind the spawn, when there is one, has its `## Decisions` shown ahead of
## the threads: they are binding, and a thread's older messages may be cut.
AgentsToolsSpawnConversationHistory(){ ## output file, member, threads (space-separated), board item path (may be empty)
	local historyFile="$1" historyMember="$2" historyThreads="$3" historyItem="${4:-}" historyThread historyMax historyRead historyDecisions=""
	historyMax="${MDAT_CONVERSATION_HISTORY_MAX:-50}"
	case "$historyMax" in ''|*[!0123456789]*|0) historyMax=50 ;; esac
	[ -n "$historyThreads" ] || return 0
	historyRead="${historyFile%/*}/.conversation.read.$$"
	## Its own item, the one that tracks, and the items its earlier sessions in this sandbox asked under.
	type AgentsToolsDecisionsBlock > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.ItemDecisions.include"
	historyDecisions="$( AgentsToolsDecisionsRelatedPaths "$historyItem" "${historyFile%/input/*}" | while IFS= read -r historyThread ; do
		AgentsToolsDecisionsBlock "$historyThread" 30 && printf '\n'
	done )" || historyDecisions=""
	{
		printf '%s\n' "# Conversation history" ""
		[ -z "$historyDecisions" ] || printf '%s\n\n' "$historyDecisions"
		printf '%s\n' "The conversation this session continues: read it before acting. Newest $historyMax messages per thread, oldest first, one \`<ts> | <user> | <text>\` head per message. (own) marks a post by $historyMember, (team: <name>) one by another team member."
		for historyThread in $historyThreads ; do
			printf '\n## Thread %s\n\n' "$historyThread"
			if DistroAgentsTools --intern-op-comms-slack-read "$historyMember" "$historyThread" --thread > "$historyRead" 2>/dev/null \
				&& LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsSlackMessagesFormat.awk" < "$historyRead" > "$historyRead.fmt" 2>/dev/null ; then
				LC_ALL=C awk -v max="$historyMax" -v member="$historyMember" '
					{ line[NR] = $0 ; if ( $0 ~ /^[0-9]+\.[0-9]+ \| / ) { head[++heads] = NR ; } }
					END {
						if ( heads == 0 ) { print "(no messages)" ; exit ; }
						from = ( heads > max ) ? head[heads - max + 1] : head[1]
						if ( heads > max ) { printf( "(%d older messages not shown)\n", heads - max ) ; }
						for ( i = from ; i <= NR ; i++ ) {
							l = line[i]
							if ( l ~ /^[0-9]+\.[0-9]+ \| / && match( l, /\[sender: [A-Za-z0-9_.-]+\]/ ) ) {
								who = substr( l, RSTART + 9, RLENGTH - 10 )
								l = ( who == member ? "(own) " : "(team: " who ") " ) l
							}
							print l
						}
					}' "$historyRead.fmt"
			else
				printf '%s\n' "(could not be read -- unknown, not empty; read it with the slack read tool)"
				echo "⚠️ WARNING: $MDSC_CMD: conversation history of $historyThread could not be read for $historyMember" >&2
			fi
		done
	} > "$historyFile" 2>/dev/null
	rm -f "$historyRead" "$historyRead.fmt"
	return 0
}

## The conversation threads this spawn continues, space-separated: MDAT_CONVERSATION_THREADS,
## which the spawn proxy passes to the console, else the `conversation-threads:` field of this
## spawn's own record in its sandbox root. Prints nothing and returns 1 when there are none.
AgentsToolsConversationThreadsFind(){
	[ -z "${MDAT_CONVERSATION_THREADS:-}" ] || { printf '%s\n' "$MDAT_CONVERSATION_THREADS" ; return 0 ; }
	[ -n "${MDAT_SPAWN_SESSION_ID:-}" ] || return 1
	local recordFile="${MDAT_SPAWN_SANDBOX_ROOT:-$MMDAPP/.local/agents/spawned/$MDAT_SPAWN_SESSION_ID}/$MDAT_SPAWN_SESSION_ID.md" recordThreads=""
	[ -f "$recordFile" ] || return 1
	recordThreads="$( LC_ALL=C awk '/^---$/ { if ( ++fm == 2 ) exit ; next ; } fm == 1 && /^conversation-threads: / { print substr( $0, 23 ) ; exit ; }' "$recordFile" )"
	[ -n "$recordThreads" ] || return 1
	printf '%s\n' "$recordThreads"
	return 0
}

## A bare Wait's default sources, space-separated: this session's own thread and every
## conversation thread it continues, each as slack:<channel>:<ts>:conversation, no repeats.
## Prints nothing and returns 1 when there is neither (the solo default then applies).
AgentsToolsWaitDefaultSources(){
	local defaultThread defaultList="" defaultSeen=" "
	for defaultThread in $( AgentsToolsSessionThreadFind 2>/dev/null ) $( AgentsToolsConversationThreadsFind 2>/dev/null ) ; do
		case "$defaultSeen" in *" $defaultThread "*) continue ;; esac
		defaultSeen="$defaultSeen$defaultThread "
		defaultList="$defaultList${defaultList:+ }slack:$defaultThread:conversation"
	done
	[ -n "$defaultList" ] || return 1
	printf '%s\n' "$defaultList"
	return 0
}

## Empties input/ of every sandbox on this host with no live session, and says which; and
## clears the harness scratch a run left in its tmp/ when it ended before its own cleanup.
## A sandbox recorded on another host, or with any session still running, is never touched.
## Running is asked for each record of the one rule a run is recognised by, and of no match
## of this sweep's own (AgentsToolsRegistrySpawnRuns, AgentsTools.Registries.include): a
## process runs as the spawn by its own word, or the process its record names still lives. A
## command line that only carries a spawn's id holds no sandbox: a process of the tooling
## that waits on its session, or another run whose line holds this sandbox's path.
AgentsToolsSpawnSandboxSweep(){ ## where
	local sweepRoot="$MMDAPP/.local/agents/spawned" sweepDir sweepRecord sweepSession sweepHost sweepLive thisHost
	[ -d "$sweepRoot" ] || return 0
	thisHost="$( hostname -s 2>/dev/null )" || thisHost="unknown"
	## A process list that cannot be read says nothing of any run: nothing is touched then.
	ps -A -ww -o args= > /dev/null 2>&1 || return 0
	type AgentsToolsRegistrySpawnRuns > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.Registries.include" 2> /dev/null || return 0
	for sweepDir in "$sweepRoot"/*/ ; do
		sweepDir="${sweepDir%/}"
		[ -d "$sweepDir/input" ] || continue
		[ -n "$( find "$sweepDir/input" "$sweepDir/tmp" -mindepth 1 -maxdepth 1 2>/dev/null | head -1 )" ] || continue
		## A sandbox with no record, or with a record under 10 minutes old, may still be launching.
		sweepLive="no-record"
		for sweepRecord in "$sweepDir"/*.md ; do
			[ -f "$sweepRecord" ] || continue
			sweepLive=""
			if [ -n "$( find "$sweepRecord" -mmin -10 2>/dev/null )" ] ; then sweepLive="launching" ; break ; fi
			## spawn-id, not session-id: session-id is now the coworking session's own
			## shared identifier, which a joined spawn's own process never carries in
			## its argv, where spawn-id (this process's own identity) always does.
			sweepSession="$( LC_ALL=C awk '/^spawn-id: /{ print substr($0, 11) ; exit ; }' "$sweepRecord" )"
			sweepHost="$( LC_ALL=C awk '/^host: /{ print substr($0, 7) ; exit ; }' "$sweepRecord" )"
			if [ "$sweepHost" != "$thisHost" ] ; then sweepLive="other-host" ; break ; fi
			[ -n "$sweepSession" ] || continue
			if AgentsToolsRegistrySpawnRuns "$sweepSession" "$sweepRecord" ; then sweepLive="running" ; break ; fi
		done
		[ -z "$sweepLive" ] || continue
		if [ -n "$( find "$sweepDir/input" -mindepth 1 -maxdepth 1 2>/dev/null | head -1 )" ] ; then
			AgentsToolsSpawnSandboxCleanInput "$sweepDir"
			echo "# $MDSC_CMD: $1: emptied input/ of ${sweepDir##*/}, whose session is no longer running" >&2
		fi
		## Scratch stays scratch: what a harness run left in tmp/ (a run killed before its
		## own cleanup) goes; whatever mattered was already written to its session log.
		if [ -n "$( find "$sweepDir/tmp" -mindepth 1 -maxdepth 1 2>/dev/null | head -1 )" ] ; then
			find "$sweepDir/tmp" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} + 2>/dev/null
			echo "# $MDSC_CMD: $1: cleared the scratch left in tmp/ of ${sweepDir##*/}, whose session is no longer running" >&2
		fi
	done
	return 0
}

## Which board state folder actually holds an item, or empty when none does.
## AgentsToolsDataRead searches several lookup folders and does not report which
## one matched, and the board upsert has to be told the state -- so it is
## established here rather than assumed to be `running`, which is true only of a
## document this op created itself. A reused tracking document belongs to a caller
## and may sit in any state; moving it would relocate that caller's own work item
## as a side effect of spawning.
AgentsToolsSpawnProxyBoardStateOf(){ ## item-filename
	local stateName
	for stateName in running pending review backlog blocked parked processed archived retained ; do
		if [ -f "$MDAT_DATA_ROOT/board/$stateName/$1" ] ; then
			printf '%s' "$stateName"
			return 0
		fi
	done
	return 0
}

AgentsToolsSpawnProxyCloseDispatch(){
	local itemName="$1" briefBody="$2" childExit="$3" childOutputFile="$4" outcome="$5"
	## Defaulted rather than required, so the create path calls this exactly as it
	## always has and only the reuse path names a state of its own.
	local itemState="${6:-running}"
	## Where the closed item rests, named by the caller rather than derived here.
	## Defaults to no move, so a caller naming no target keeps what it had: a
	## REUSED document belongs to a caller and is never relocated by a spawn
	## closing. One this op created itself moves to `review`, so `running` holds
	## only sessions that are actually running. It stops at `review` and not at
	## `processed` because grooming owns entry to that state -- human-owner ruling,
	## 2026-09-23: "grooming owns the state - but spawn moves to pending - ok? so
	## grooming sees" -- board-review now sits between them, entered here and left
	## only by a reviewer's own reject/accept. This op marks and parks; it never adjudicates the close.
	local itemTargetState="${7:-$itemState}"
	## Why a running item enters review here: a child that ended with no handback, by default.
	local reviewReason="${8:-ended-without-handback}"
	local currentBody resultBody actualState reviewHeaders=()
	## The close moves only an item still where the caller left it, and the one move it makes
	## is running -> review. An item a handback, a verdict or an ending already moved is never
	## moved out of review, processed or pending by a close: one in review gets its Result in
	## place, any other is left as it is (AgentsTools.ReviewFlow.include).
	actualState="$( AgentsToolsSpawnProxyBoardStateOf "$itemName" )"
	if [ "$actualState" != "$itemState" ] ; then
		if [ "$actualState" != review ] ; then
			echo "# --intern-op-agent-spawn-proxy: $itemName is in ${actualState:-no board state}, not $itemState, so the close leaves it as it is" >&2
			return 0
		fi
		itemState=review ; itemTargetState=review
	fi
	[ "$itemState" != running ] || [ "$itemTargetState" != review ] \
		|| reviewHeaders=( --header:upsert:review-since-epoch:"$( date +%s )" --header:upsert:review-reason:"$reviewReason" )
	type AgentsToolsDataRead > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.InternOpDataRead.include"
	currentBody="$( AgentsToolsDataRead "$itemName" \
		--lookup-folder "$MDAT_DATA_ROOT/board/$itemState" \
		--context --intern-op-agent-spawn-proxy )" || currentBody="$briefBody"
	resultBody="$( printf '%s\n' \
		"$currentBody" \
		"" \
		"## Result" \
		"" \
		"status: $outcome" \
		"exit-code: $childExit" \
		"output-file: $childOutputFile" \
		"completed-at: $( date -u +%Y-%m-%dT%H:%M:%SZ )" )"
	mkdir -p "$MDAT_DATA_ROOT/board/$itemTargetState" || {
		echo "⚠️ WARNING: --intern-op-agent-spawn-proxy: can't create board state directory $MDAT_DATA_ROOT/board/$itemTargetState, so dispatch item $itemName was not closed" >&2
		return 0
	}
	printf '%s\n' "$resultBody" | DistroAgentsTools --intern-op-board-upsert-move-edit "$itemTargetState" "$itemName" \
		--from-state:"$itemState" \
		--header:upsert:status:dispatch-"$outcome" \
		--header:upsert:resolved-at:"$( date +"%Y-%m-%d %H:%M %z" )" \
		"${reviewHeaders[@]+"${reviewHeaders[@]}"}" \
		--upsert-from-stdin \
		--context --intern-op-agent-spawn-proxy \
		--log-verb:updated \
		|| { echo "⚠️ WARNING: --intern-op-agent-spawn-proxy: could not close dispatch item $itemName" >&2 ; return 0 ; }
	## The entry into review recorded, in Decisions and the transcript.
	if [ "${#reviewHeaders[@]}" -gt 0 ] ; then
		type AgentsReviewRecord > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.ReviewFlow.include"
		AgentsReviewRecord tooling "$itemName" review "$reviewReason: the child ended ($outcome, exit $childExit)" REVIEW "" || :
	fi
	return 0
}

## An accept releases the child: a board item moved to processed has its own spawned
## session dismissed, through the same send an explicit spawn-dismiss uses -- a DISMISSED
## body addressed to the child member in the child's session thread, which its Wait turns
## into WAIT-RESULT: DISMISSED. The child is the spawn record the item's spawn-id names,
## or, with none, the one live record whose spawns/spawned-by links the item. Never fails
## the move it follows: prints one ACCEPT-DISMISS line, saying what was sent or why nothing was.
AgentsToolsBoardAcceptDismissChild(){ ## sending member, item path
	local sendBy="$1" itemPath="$2" itemSpawn recordPath="" recordCandidate folderName
	local childStatus childMember childThread="" childHost thisHost sendOut
	itemSpawn="$( AgentsToolsSpawnSandboxRecordHeader "$itemPath" spawn-id )"
	if [ -n "$itemSpawn" ] && [ "$itemSpawn" != "-" ] ; then
		for recordCandidate in "$MMDAPP/.local/agents/spawned"/*/"$itemSpawn.md" ; do
			[ ! -f "$recordCandidate" ] || { recordPath="$recordCandidate" ; break ; }
		done
	else
		for folderName in $( AgentsToolsSpawnSandboxFoldersOfItem "$itemPath" ) ; do
			for recordCandidate in "$MMDAPP/.local/agents/spawned/$folderName"/*.md ; do
				[ -f "$recordCandidate" ] || continue
				[ "$( AgentsToolsSpawnSandboxRecordHeader "$recordCandidate" status )" = spawn-started ] || continue
				[ -z "$recordPath" ] || { printf 'ACCEPT-DISMISS: not sent: more than one live spawn links %s, so which child to dismiss is not decided here\n' "${itemPath##*/}" ; return 0 ; }
				recordPath="$recordCandidate"
			done
		done
	fi
	[ -n "$recordPath" ] || { printf 'ACCEPT-DISMISS: not sent: no spawn record found for %s (spawn-id %s)\n' "${itemPath##*/}" "${itemSpawn:--}" ; return 0 ; }
	itemSpawn="${recordPath##*/}" ; itemSpawn="${itemSpawn%.md}"
	childStatus="$( AgentsToolsSpawnSandboxRecordHeader "$recordPath" status )"
	[ "$childStatus" = spawn-started ] || { printf 'ACCEPT-DISMISS: not sent: spawn %s has already ended (status %s)\n' "$itemSpawn" "${childStatus:--}" ; return 0 ; }
	childHost="$( AgentsToolsSpawnSandboxRecordHeader "$recordPath" host )"
	thisHost="$( hostname -s 2>/dev/null )" || thisHost="unknown"
	if [ "$childHost" = "$thisHost" ] ; then
		## Running is a process that runs as the spawn, by the one rule of the spawned-sessions render.
		type AgentsToolsRegistrySpawnRuns > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.Registries.include"
		AgentsToolsRegistrySpawnRuns "$itemSpawn" "$recordPath" || { printf 'ACCEPT-DISMISS: not sent: spawn %s is not running on this host, so its session has ended\n' "$itemSpawn" ; return 0 ; }
	fi
	childMember="$( AgentsToolsSpawnSandboxRecordHeader "$recordPath" owner )"
	[ -n "$childMember" ] || { printf 'ACCEPT-DISMISS: not sent: spawn %s names no owner member to address\n' "$itemSpawn" ; return 0 ; }
	[ "$childMember" != "$sendBy" ] || { printf 'ACCEPT-DISMISS: not sent: the accepting member %s is the child member itself, and its own Wait ignores a DISMISSED it authored\n' "$sendBy" ; return 0 ; }
	childThread="$( AgentsToolsSpawnSandboxRecordHeader "$recordPath" session-thread )"
	if [ -z "$childThread" ] || [ "$childThread" = "-" ] ; then
		childThread=""
		[ ! -f "${recordPath%/*}/session.thread" ] || IFS= read -r childThread < "${recordPath%/*}/session.thread" || :
	fi
	AgentsToolsSpawnConversationThreadValid "$childThread" || { printf 'ACCEPT-DISMISS: not sent: spawn %s has no session thread to post in\n' "$itemSpawn" ; return 0 ; }
	if sendOut="$( printf 'DISMISSED' | DistroAgentsTools --intern-op-comms-slack-send-message "$sendBy" "$childThread" --identity-bot --address-to "$childMember" --from-stdin 2>&1 )" ; then
		printf 'ACCEPT-DISMISS: sent DISMISSED to %s in %s (spawn %s)\n' "$childMember" "$childThread" "$itemSpawn"
	else
		printf 'ACCEPT-DISMISS: not sent: the send to %s in %s failed: %s\n' "$childMember" "$childThread" "$( printf '%s\n' "$sendOut" | LC_ALL=C grep -m1 'ERROR' )"
	fi
	return 0
}

## THE PROCESS A LAUNCH STARTED, kept on the spawn's own record: its pid and when it began,
## `run-process: <pid> <start>`, written by the launcher the moment it has started the console.
## The console becomes the CLI, or waits for it, so that process lives as long as the run
## does. It is how a run is seen alive where its CLI is given no session word of its own on
## its command line (AgentsToolsRegistryRecordedRunAlive, AgentsTools.Registries.include):
## for every CLI alike, and the same pid begun at another time is another process. A later
## launch of the same spawn -- a resume, the handback retry -- replaces the one before it.
## AND THE SHELL THAT SUPERVISES THE RUN, beside it and in the same form:
## `supervisor-process: <pid> <start>`. That is the shell this is called in, the one that
## started the console: it waits on the run and, once the run has ended, resumes it once for
## a missing handback, posts the end and closes this record. It is the process the proxy
## starts for a run that is not waited for (PID= of its receipt), and the process the call
## itself runs in for a run its caller waits on. A later launch of the same spawn is made by
## that same shell, and leaves the line as it was. It is how a run whose process is gone and
## whose record is still open is told from one that nobody will close
## (AgentsToolsRegistryRecordedSupervisor, AgentsTools.Registries.include). Kept also where
## the console had ended before its own start could be read: `run-process` is then not written.
## Through this package's own header writer, aside and then one rename. Never fails the launch.
## A record is read, changed and put back whole, and what another writer changes between those
## two is lost. So the time a launch holds it is kept as short, and as soon after the launch,
## as it was before the shell was named: which shell this is, is read before the launch
## (AgentsToolsSpawnProxyShellNote) and only looked up here.
AgentsToolsSpawnProxyShellNote(){ ## -- keeps `<pid> <start>` of the shell it is called in, for that shell (agentsSpawnProxyShellIs)
	local noteShell noteStart
	## Kept already, by this very shell: nothing is started to find that out. What a subshell
	## has of the shell it came from was kept one level up (BASH_SUBSHELL), and names that one:
	## read again. A process started anew has none of it.
	case "${agentsSpawnProxyShellOf:-}" in "level-$BASH_SUBSHELL") return 0 ;; esac
	agentsSpawnProxyShellIs="" ; agentsSpawnProxyShellOf="level-$BASH_SUBSHELL"
	type AgentsToolsRegistryProcessStart > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.Registries.include" 2> /dev/null || return 0
	## This shell's own process, which `$$` does not name in a subshell: what a command it starts has as its parent.
	noteShell="$( exec sh -c 'echo "$PPID"' 2> /dev/null )" || noteShell=""
	case "$noteShell" in ''|*[!0123456789]*) return 0 ;; esac
	noteStart="$( AgentsToolsRegistryProcessStart "$noteShell" )" || noteStart=""
	agentsSpawnProxyShellIs="${noteStart:+$noteShell $noteStart}"
	return 0
}
AgentsToolsSpawnProxyRunRecord(){ ## pid of the console process just started
	local runFile="${MDAT_SPAWN_SANDBOX_ROOT:-}/${MDAT_SPAWN_SESSION_ID:-}.md" runStart runOps runBody
	[ -n "${MDAT_SPAWN_SANDBOX_ROOT:-}" ] && [ -n "${MDAT_SPAWN_SESSION_ID:-}" ] && [ -f "$runFile" ] || return 0
	case "${1:-}" in ''|*[!0123456789]*) return 0 ;; esac
	type AgentsToolsRegistryProcessStart > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.Registries.include" 2> /dev/null || return 0
	runStart="$( AgentsToolsRegistryProcessStart "$1" )" || runStart=""
	AgentsToolsSpawnProxyShellNote
	[ -n "$runStart${agentsSpawnProxyShellIs:-}" ] || return 0
	runOps="$MMDAPP/.local/temp/mdat-session-run-ops.$$.$1"
	mkdir -p "$MMDAPP/.local/temp" 2> /dev/null || return 0
	{
		[ -z "$runStart" ] || printf 'upsert\trun-process\t%s %s\n' "$1" "$runStart"
		[ -z "${agentsSpawnProxyShellIs:-}" ] || printf 'upsert\tsupervisor-process\t%s\n' "$agentsSpawnProxyShellIs"
	} > "$runOps" 2> /dev/null || return 0
	runBody="$( LC_ALL=C awk -v opsFile="$runOps" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsBoardItemHeaderOpsApply.awk" < "$runFile" 2> /dev/null )" || runBody=""
	rm -f "$runOps"
	[ -n "$runBody" ] || return 0
	{ printf '%s\n' "$runBody" > "$runFile.run.$$" && mv -f "$runFile.run.$$" "$runFile" ; } 2> /dev/null || rm -f "$runFile.run.$$"
	return 0
}

## Closes the session tracking file by updating its frontmatter, through this
## package's own header writer -- nothing here parses or re-emits frontmatter of its
## own. The headers ARE the state, so a close is a header update and never a rewrite
## of the file. A failure leaves the file exactly as it was: a tracking record that
## still says started is recoverable by a rescan, where a truncated one is not.
## So the changed record is written aside and put in place by one rename, as a launch writes
## it (AgentsToolsSpawnProxyRunRecord): a reader finds the record as it was or as it is, and so
## does whoever comes after a closer that was ended half way; never a record cut short.
## rc 0 closed; rc 1 where this try could not close it, the record as it was.
AgentsToolsSpawnProxyCloseSandboxOnce(){ ## tracking file, outcome, exit code
	local sandboxFile="$1" sandboxOutcome="$2" sandboxExit="$3" sandboxOps sandboxBody sandboxAside
	[ -f "$sandboxFile" ] || return 1
	mkdir -p "$MMDAPP/.local/temp" || return 1
	## A temp file of this close's own, by mktemp and never by $$: the members one call
	## started (--magic-spawn-session) close in subshells of that one shell, which have its
	## $$, so two closing at once met on one name, and one read no changes and stayed started.
	sandboxOps="$( mktemp "$MMDAPP/.local/temp/mdat-session-header-ops.XXXXXX" )" || return 1
	{
		## `status` carries the outcome, and `outcome` itself is deliberately absent:
		## the entity model defines that name with a closed set of values for what an
		## advance pass did to a running board item, so a spawn's exit result written
		## there would be an undefined value in a defined set. `resolved-at` is the
		## model's own conclusion stamp, and is used rather than a second spelling of
		## it. `exit-code` has no counterpart in the model at all, which is not a
		## re-mint: this file is the session's own record, not team data, so nothing
		## defines that concept for it.
		printf 'upsert\tstatus\tspawn-%s\n' "$sandboxOutcome"
		printf 'upsert\texit-code\t%s\n' "$sandboxExit"
		printf 'upsert\tresolved-at\t%s\n' "$( date +"%Y-%m-%d %H:%M %z" )"
		## Whether the session read its own duty file, as the harness recorded it beside this file.
		## "no" only where the harness loop ran and could see it; a native CLI's session is unknown.
		if [ -s "${sandboxFile%.md}.armed" ] ; then
			printf 'upsert\tarmed\tyes\n'
			printf 'upsert\tarmed-at\t%s\n' "$( head -1 "${sandboxFile%.md}.armed" )"
		elif [ -e "${sandboxFile%.md}.harness" ] ; then
			printf 'upsert\tarmed\tno\n'
		else
			printf 'upsert\tarmed\tunknown\n'
		fi
	} > "$sandboxOps" || { rm -f "$sandboxOps" ; return 1 ; }
	sandboxBody="$( LC_ALL=C awk -v opsFile="$sandboxOps" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsBoardItemHeaderOpsApply.awk" < "$sandboxFile" )" || sandboxBody=""
	rm -f "$sandboxOps"
	[ -n "$sandboxBody" ] || return 1
	## Aside and then one rename, with the mode the record has: the name by mktemp, since its
	## supervising shell and an advance pass may close one record at the same moment.
	sandboxAside="$( mktemp "$sandboxFile.close.XXXXXX" 2> /dev/null )" || return 1
	{ cp -p "$sandboxFile" "$sandboxAside" && printf '%s\n' "$sandboxBody" > "$sandboxAside" && mv -f "$sandboxAside" "$sandboxFile" ; } 2> /dev/null \
		|| { rm -f "$sandboxAside" ; return 1 ; }
	return 0
}

## The close as its callers ask for it. Where the first try could not close the record it is
## tried once more, a moment later: what stopped it may have been of that moment, a signal to
## the run's group that took the header writer with it, a temp folder that was full. Where
## the second cannot either, that is said, on stderr: the record then still says what it
## said, and a later advance pass closes it. Never fails its caller.
AgentsToolsSpawnProxyCloseSandbox(){ ## tracking file, outcome, exit code
	[ -f "$1" ] || return 0
	AgentsToolsSpawnProxyCloseSandboxOnce "$@" && return 0
	sleep 1 || :
	AgentsToolsSpawnProxyCloseSandboxOnce "$@" && return 0
	echo "⚠️ WARNING: ${MDSC_CMD:-DistroAgentsTools}: the spawn record $1 could not be closed as spawn-$2 (exit $3), tried twice: it still says what it said" >&2 || :
	return 0
}

## What the tooling itself tells the participants of a session, in a thread, about the run of
## one of them: one message, its text the note template's
## (sh-lib/templates/tooling-note.post.format.md, `# Session`), sent through the member send
## as the team bot in the name of the member it is about, and addressed to whoever it is
## told, where that is known: the member that brought that one in, or the human-owner in his
## own conversation. Never a tracking post: the box that tracks the same fact goes to the
## tracking thread, by its caller. Silent with no thread. Never fails its caller: one stderr
## warning at most; whether it posted is left in agentsSpawnProxyNoticePosted.
## It stands here, with what closes a run, and not with the spawn proxy's own functions: a
## closer that is no spawn proxy tells the end of a run too (AgentsToolsSpawnProxyEndNotice).
AgentsToolsSpawnProxySessionNotice(){ ## thread or conversation, the member it is about, whom it is told (may be empty), line (a heading under `# Session`), count (may be empty), the run it is about (this spawn's own where not given), then the further slots of the line, a name and its value each
	local noticeThread="$1" noticeMember="$2" noticeTell="" noticeName="$4" noticeCount="${5:-}" noticeRun="${6:-${MDAT_SPAWN_SESSION_ID:-}}" noticeText="" noticeArgs
	agentsSpawnProxyNoticePosted=""
	[ -n "$noticeThread" ] || return 0
	noticeArgs=( "$noticeMember" "$noticeThread" --identity-bot )
	## Addressed to whom it is told, where the send can address it, and to nobody where there
	## is none: never to the member it is about, whose run has ended.
	type AgentsToolsTeamMemberDirectory > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.TeamRegistry.include"
	if [ -n "${3:-}" ] && [ "$3" != "$noticeMember" ] && AgentsToolsAssertBareName "$3" "the spawning member" agent-spawn-proxy 2> /dev/null \
		&& AgentsToolsTeamMemberDirectory "$3" > /dev/null 2>&1 ; then
		noticeTell="$3"
		noticeArgs=( "${noticeArgs[@]}" --address-to "$noticeTell" )
	fi
	type AgentsToolsAskPostFill > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.AskPost.include"
	shift 6 2> /dev/null || shift $#
	noticeText="$(
		export ASKP_BLOCK="Session/$noticeName" ASKP_F_member="$noticeMember" ASKP_F_run="${noticeRun:0:8}" ASKP_F_count="$noticeCount" ASKP_F_address_to="$noticeTell"
		## A further slot travels as every slot does, under its own name: lower-case letters.
		while [ $# -ge 2 ] ; do
			[ -z "$1" ] || [ -n "${1//[abcdefghijklmnopqrstuvwxyz_]/}" ] || export "ASKP_F_$1=$2"
			shift 2
		done
		AgentsToolsAskPostFill block tooling-note.post.format.md "" 2> /dev/null
	)" || noticeText=""
	if [ -z "$noticeText" ] ; then
		echo "⚠️ WARNING: --intern-op-agent-spawn-proxy: the $noticeName line could not be filled from sh-lib/templates/tooling-note.post.format.md, so $noticeThread was not told" >&2
		return 0
	fi
	if printf '%s\n' "$noticeText" | DistroAgentsTools --intern-op-comms-slack-send-message "${noticeArgs[@]}" --from-stdin > /dev/null 2>&1 ; then
		agentsSpawnProxyNoticePosted="yes"
	else
		echo "⚠️ WARNING: --intern-op-agent-spawn-proxy: the $noticeName line was not posted in $noticeThread, so it was not told there that the run ${noticeRun:0:8} of $noticeMember ended" >&2
	fi
	return 0
}

## WHETHER A RUN HANDED BACK, AND WHERE EACH HANDBACK WENT: the one reading of it, for the
## close of a run, which resumes it once for a handback it has not given
## (AgentsToolsSpawnProxyHandbackWarn, --intern-op-agent-spawn-proxy), and for the note of
## its end (AgentsToolsSpawnProxyEndNotice). THE TRANSCRIPT OF THE RUN IS BELIEVED FIRST: it
## holds a HANDBACK event for each handback that was delivered, with where it went
## (AgentsTranscriptToolDone), whichever CLI ran and however its log shows a call. The
## output of the run is read only where the transcript holds none, or the run has no
## transcript: there the announce line of the call is all there is, and it says that the
## call was made, not where it went. By the output alone the handbacks of a native CLI were
## never seen: its log holds what a call is for first and the name of the tool on the next
## line, which the pattern does not read.
## Prints a line for each handback the transcript holds, `to:<target>` as its event names it,
## `to:` where the call named none; and where the transcript gives none, the one line `seen`
## where the output shows the call. Nothing where neither does. rc 0 always.
AgentsToolsSpawnProxyHandbacks(){ ## the run, by its own spawn id; its output file (may be empty)
	local handRun="${1:-}" handLog="${2:-}" handParts="" handPart handGave=""
	type AgentsTranscriptParts > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.SessionTranscript.include" 2> /dev/null || :
	[ -z "$handRun" ] || handParts="$( AgentsTranscriptParts "$handRun" 2> /dev/null )" || handParts=""
	if [ -n "$handParts" ] ; then
		handGave="$( while IFS= read -r handPart ; do
			[ -n "$handPart" ] && [ -f "$handPart" ] || continue
			LC_ALL=C grep -E '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]+Z HANDBACK( |$)' "$handPart" 2> /dev/null \
				| LC_ALL=C awk '{ wentTo = "" ; if ( match( $0, / to=[^ ]+/ ) ) { wentTo = substr( $0, RSTART + 4, RLENGTH - 4 ) ; } gsub( /"/, "", wentTo ) ; print "to:" wentTo ; }'
		done <<< "$handParts" )" || handGave=""
	fi
	if [ -n "$handGave" ] ; then
		printf '%s\n' "$handGave"
		return 0
	fi
	[ -z "$handLog" ] || [ ! -f "$handLog" ] || ! LC_ALL=C grep -qE '📦 SubagentHandback|^  -> tool: (mcp__myx_distro__)?SubagentHandback' "$handLog" 2> /dev/null || printf 'seen\n'
	return 0
}

## THE END OF A RUN IS TOLD TO WHOEVER REQUESTED IT, by whoever closes its record: its
## supervising shell, at the end of its close (--intern-op-agent-spawn-proxy), and, where
## that shell is gone, the advance pass for a dead run that it closes as ended without close
## (AgentsToolsAdvanceSpawnHousekeeping). One message for an end, a fact and no question:
## that the run has ended, and how. Its caller calls it once the record and the item of the
## run are closed, so a post that cannot be made holds neither open. An end is told once:
## by the shell while it lives, and else by the one pass that closes the record.
## WHERE. In the thread of the session that requested the run, addressed to the member that
## brought it in: the thread a handback to its parent goes to, kept on its record as
## `parent-thread` (AgentsToolsSpawnParentThread, AgentsTools.ReviewFlow.include), which is
## the run's own session thread where it joined the session of its parent, and another one
## where it opened a session of its own. Its own session thread where its record keeps none.
## A run that no session requested, and whose item names no reviewer, is told to the
## human-owner, in the bot's direct conversation, as a plain message: no question, and no
## record of one. Three runs that no session requested stay where their note stood, in their
## own session thread: a start its caller waits on, which that caller reads itself; a run
## whose item names a reviewer; and any such run in a workspace that has no conversation
## with the human-owner (SLACK_CHANNEL_HUMAN_OWNER).
## HOW IT ENDED, each a line of its own under `# Session` of the note template:
##   run-killed        its record says that the console killed it, by whom and when
##                     (`killed-by`, `killed-at`, AgentsToolsManagerKillMark).
##   run-stopped       its transcript holds the ordered ending of a member's TaskStop, which
##                     is recorded before the run is signalled: by which member, and when.
##   run-bound         the wait of its caller reached the bound of the tooling, which then
##                     ended it (SPAWN_WAIT_TIMEOUT_SECONDS): the bound its closer gives.
##   handback-missing  it ended by itself, and no handback of it was seen, after its one retry.
##   run-ended         it ended by itself and handed back, and none of its handbacks went to
##                     where its end is told.
## A run that was killed, stopped or bounded is told as that, whatever it had handed back,
## and never as a run that posted no handback. A run that ended by itself and whose handback
## stands where its end would be told gets no message: the handback said it. Nor does one
## whose handback was seen while nothing records where it went.
## Where a handback went is read from the run's transcript, the `to` of its HANDBACK events
## (AgentsTranscriptToolDone): none, and `session-parent`, are the thread kept as
## `parent-thread`; `session-current` is the run's own session thread; a `<channel>:<ts>` is
## itself; `human-owner` is his conversation; any other target is another place.
## A DEATH is told by the control thread of the run's session, in a call of its own, with
## `died` as what its closer saw (AgentsTools.SessionControlDeath.include): the line is then
##   run-died          its process is gone, and nothing closed its record,
## whatever else is recorded of its ending, and nothing where a handback of it stands where
## its end would be told. That thread then keeps `death-told` on the record, and AN END THAT
## WAS TOLD AS A DEATH IS TOLD BY NO OTHER CLOSER: for a record that carries it, a later
## call says nothing. agentsSpawnProxyEndNoticeSaid is left for the caller that asks:
## `posted`, `none` where nothing was due, `failed` where the line could not be posted.
## Posted by the one function a note of a session is posted by
## (AgentsToolsSpawnProxySessionNotice), which bounds it as every Slack call is bounded.
## Never fails its caller: a post that cannot be made is that function's one warning on
## stderr, which is the run's log for a run that is not waited for.
AgentsToolsSpawnProxyEndNotice(){ ## the run's record, what its closer saw of a handback (`missing` or `seen`; read from the run's log where not given; `died` for a death, which the control thread of its session tells), the bound in seconds where the tooling's bound ended it (may be empty), `caller-waits` for a start its caller waits on (may be empty)
	local endRecord="${1:-}" endSeen="${2:-}" endBound="${3:-}" endWaits="${4:-}"
	local endRun endMember endParent endOwn endKept endTo="" endTell="" endLine="" endBy="" endAt="" endUnrequested="" endSession=""
	local endField endItem endState endReviewer="" endParts endPart endEvents="" endStop endWent endHeld="" endGave=""
	agentsSpawnProxyEndNoticeSaid="none"
	[ -n "$endRecord" ] && [ -f "$endRecord" ] || return 0
	[ "$endSeen" = "died" ] || [ -z "$( AgentsToolsSpawnSandboxRecordHeader "$endRecord" death-told )" ] || return 0
	endRun="${endRecord##*/}" ; endRun="${endRun%.md}"
	endMember="$( AgentsToolsSpawnSandboxRecordHeader "$endRecord" owner )"
	[ -n "$endMember" ] || return 0
	endOwn="$( AgentsToolsSpawnSandboxRecordHeader "$endRecord" session-thread )"
	AgentsToolsSpawnConversationThreadValid "$endOwn" || endOwn=""
	endKept="$( AgentsToolsSpawnSandboxRecordHeader "$endRecord" parent-thread )"
	AgentsToolsSpawnConversationThreadValid "$endKept" || endKept=""
	## Where it is told, and to whom.
	endParent="$( AgentsToolsSpawnSandboxRecordHeader "$endRecord" parent-session-id )"
	case "$endParent" in
		''|none)
			endTo="$endOwn"
			if [ "$endWaits" != "caller-waits" ] ; then
				for endField in spawns spawned-by ; do
					endItem="$( AgentsToolsSpawnSandboxRecordHeader "$endRecord" "$endField" )"
					endItem="${endItem%%,*}" ; endItem="${endItem%% *}" ; endItem="${endItem%.md}"
					[ -n "$endItem" ] && [ -n "${MDAT_DATA_ROOT:-}" ] || continue
					endState="$( AgentsToolsSpawnProxyBoardStateOf "$endItem.md" )"
					[ -n "$endState" ] || continue
					endReviewer="$( AgentsToolsSpawnSandboxRecordHeader "$MDAT_DATA_ROOT/board/$endState/$endItem.md" review-by )"
					break
				done
				if [ -z "$endReviewer" ] && [ -n "$( DistroAgentsTools --agents-config-option magic-team --select SLACK_CHANNEL_HUMAN_OWNER 2> /dev/null )" ] ; then
					endTo="human-owner" ; endTell="human-owner"
					endSession="$( AgentsToolsSpawnSandboxRecordHeader "$endRecord" session-comment )"
					type AgentsToolsAskPostFill > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.AskPost.include"
					endUnrequested="$( ASKP_BLOCK="Session/unrequested" ASKP_F_session="$endSession" AgentsToolsAskPostFill block tooling-note.post.format.md "" 2> /dev/null )" || endUnrequested=""
				fi
			fi
		;;
		*)
			endTo="${endKept:-$endOwn}"
			endTell="$( MDAT_SPAWN_SESSION_ID="$endRun" ; AgentsToolsSessionParentMember 2> /dev/null )" || endTell=""
		;;
	esac
	[ -n "$endTo" ] || return 0
	## What its transcript records of its ending and of its handbacks.
	type AgentsTranscriptParts > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.SessionTranscript.include" 2> /dev/null || :
	endParts="$( AgentsTranscriptParts "$endRun" 2> /dev/null )" || endParts=""
	while IFS= read -r endPart ; do
		[ -n "$endPart" ] && [ -f "$endPart" ] || continue
		endEvents="$endEvents$( LC_ALL=C grep -E '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]+Z (ENDING|HANDBACK)( |$)' "$endPart" 2> /dev/null )"$'\n'
	done <<< "$endParts"
	## How it ended.
	endAt="$( AgentsToolsSpawnSandboxRecordHeader "$endRecord" killed-at )"
	endStop="$( printf '%s' "$endEvents" | LC_ALL=C awk '
		$2 == "ENDING" && index( $0, " text=\"taskstop: " ) > 0 { stopBy = "" ; if ( match( $0, / by=[^ ]+/ ) ) { stopBy = substr( $0, RSTART + 4, RLENGTH - 4 ) ; } stopLine = $1 " " stopBy ; }
		END { if ( stopLine != "" ) { print stopLine ; } }
	' )" || endStop=""
	if [ "$endSeen" = "died" ] ; then
		endAt=""
	elif [ -n "$endAt" ] ; then
		endLine="run-killed"
		endBy="$( AgentsToolsSpawnSandboxRecordHeader "$endRecord" killed-by )"
	elif [ -n "$endStop" ] ; then
		endLine="run-stopped"
		endAt="${endStop%% *}" ; endBy="${endStop#* }"
	else
		case "$endBound" in ''|0|*[!0123456789]*) endBound="" ;; *) endLine="run-bound" ;; esac
	fi
	if [ -z "$endLine" ] ; then
		## It ended by itself: whether a handback of it stands where its end would be told, by
		## the one reading of what a run handed back (AgentsToolsSpawnProxyHandbacks).
		endGave="$( AgentsToolsSpawnProxyHandbacks "$endRun" "$( AgentsToolsSpawnSandboxRecordHeader "$endRecord" output-file )" )" || endGave=""
		while IFS= read -r endWent ; do
			case "$endWent" in to:*) endWent="${endWent#to:}" ;; *) continue ;; esac
			case "$endWent" in
				''|session-parent)
					endWent="$endKept"
					[ -n "$endWent" ] || endWent="$( MDAT_SPAWN_SESSION_ID="$endRun" ; AgentsToolsSessionParentThreadFind 2> /dev/null )" || endWent=""
					endWent="${endWent%% *}"
				;;
				session-current) endWent="$endOwn" ;;
				human-owner) ;;
				*) AgentsToolsSpawnConversationThreadValid "$endWent" || endWent="" ;;
			esac
			[ "$endWent" != "$endTo" ] || { endHeld="there" ; break ; }
			endHeld="elsewhere"
		done <<< "$endGave"
		if [ -z "$endSeen" ] ; then
			endSeen="missing"
			[ -z "$endGave" ] || endSeen="seen"
		fi
		case "$endHeld:$endSeen" in
			there:*) return 0 ;;
			*:died) endLine="run-died" ;;
			elsewhere:*) endLine="run-ended" ;;
			:missing) endLine="handback-missing" ;;
			*) return 0 ;;
		esac
	fi
	## When, as each reader's own time; a moment that cannot be read stays as it is kept.
	if [ -n "$endAt" ] ; then
		type AgentsToolsSlackDateToken > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.SlackDate.include" 2> /dev/null || :
		endAt="$( AgentsToolsSlackDateToken "$endAt" date-time 2> /dev/null || printf '%s' "$endAt" )"
	fi
	AgentsToolsSpawnProxySessionNotice "$endTo" "$endMember" "$endTell" "$endLine" "" "$endRun" by "$endBy" at "$endAt" seconds "$endBound" unrequested "$endUnrequested"
	agentsSpawnProxyEndNoticeSaid="failed" ; [ -z "$agentsSpawnProxyNoticePosted" ] || agentsSpawnProxyEndNoticeSaid="posted"
	return 0
}

## One line to the daemon output, never stdout: fd 4 where execute opened it (the request's own stderr, not the result), else stderr, which is the log in a console or harness run.
## The write that can fail is a redirection on a subshell, stderr silenced first, since a failed redirection on a special builtin ends a POSIX shell.
## fd 4 closed or not writable falls back to stderr.
AgentsToolsDaemonLine(){ ## text...
	( printf '%s\n' "$*" ) 2> /dev/null >&4 || printf '%s\n' "$*" >&2
}

## Reports housekeeping lines to the daemon output and as one message into the event-track thread of this spawn's coworking session; nothing goes to stdout or stderr. No thread, no post.
## The thread is found through the session's one record, by this spawn's own id (AgentsTools.EventTrackThread.include), never through a file of the sandbox, which spawns may share.
AgentsToolsHousekeepingReport(){ ## member, lines
	local reportThread="" reportLine
	[ -n "$2" ] || return 0
	while IFS= read -r reportLine ; do
		AgentsToolsDaemonLine "$reportLine"
	done <<< "$2"
	type AgentsToolsEventTrackThreadRead > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.EventTrackThread.include" 2> /dev/null || return 0
	reportThread="$( AgentsToolsEventTrackThreadRead "$( AgentsToolsEventTrackThreadOwnDir )" )"
	[ -n "$reportThread" ] || return 0
	printf '%s\n' "$2" | DistroAgentsTools --intern-op-event-track-post "$1" "$reportThread" --kind activity --session-id "${MDAT_SPAWN_SESSION_ID:-}" \
		--field what="board housekeeping" --from-stdin > /dev/null 2>&1 || :
	return 0
}

## First value of one frontmatter header of a file, empty when absent. Bounded to the frontmatter block, so a body line cannot spoof it.
AgentsToolsSpawnSandboxRecordHeader(){ ## file, header
	LC_ALL=C awk -v wantHeader="$2" '
		$0 == "---" { fmCount++ ; if ( fmCount > 1 ) { exit ; } next ; }
		fmCount == 1 && index( $0, wantHeader ": " ) == 1 { print substr( $0, length( wantHeader ) + 3 ) ; exit ; }
	' "$1" 2> /dev/null || :
}

## Sandbox folder names linked to one board item, one per line, sorted, empty when none. Two links, either one is enough:
## the item's own spawn-id naming a record, and a record's spawns/spawned-by naming the item. An empty or `-` spawn-id matches nothing.
AgentsToolsSpawnSandboxFoldersOfItem(){ ## item path
	local itemStem="${1##*/}" itemSpawn
	itemStem="${itemStem%.md}"
	itemSpawn="$( AgentsToolsSpawnSandboxRecordHeader "$1" spawn-id )"
	[ -d "$MMDAPP/.local/agents/spawned" ] || return 0
	LC_ALL=C awk -v wantStem="$itemStem" -v wantSpawn="$itemSpawn" '
		FNR == 1 {
			fmCount = 0 ;
			folderName = FILENAME ; sub( /\/[^\/]*$/, "", folderName ) ; sub( /^.*\//, "", folderName ) ;
			recordName = FILENAME ; sub( /^.*\//, "", recordName ) ;
			if ( wantSpawn != "" && wantSpawn != "-" && recordName == wantSpawn ".md" ) { print folderName ; }
		}
		$0 == "---" { fmCount++ ; next ; }
		fmCount == 1 && ( index( $0, "spawns: " ) == 1 || index( $0, "spawned-by: " ) == 1 ) {
			linkText = $0 ; sub( /^[^:]*: /, "", linkText ) ;
			partCount = split( linkText, linkParts, / *, */ ) ;
			for ( partIndex = 1 ; partIndex <= partCount ; partIndex++ ) {
				linkStem = linkParts[partIndex] ; sub( /\.md$/, "", linkStem ) ;
				if ( linkStem == wantStem ) { print folderName ; break ; }
			}
		}
	' "$MMDAPP/.local/agents/spawned"/*/*.md 2> /dev/null | LC_ALL=C sort -u || :
}

## Whether a sandbox folder may be removed for one item that is going: `open` (a record still started or without a status),
## `shared` (another board item still links to it, or the folder is not a plain directory under the spawned root), else `removable`.
AgentsToolsSpawnSandboxFolderState(){ ## folder name, item stem going away
	local folderName="$1" skipStem="$2" spawnRoot="$MMDAPP/.local/agents/spawned"
	local recordPath recordStatus recordSpawn linkField linkText linkStem boardPath spawnIds=""
	case "$folderName" in ''|.|..|*/*) echo shared ; return 0 ;; esac
	[ -d "$spawnRoot/$folderName" ] && [ ! -L "$spawnRoot/$folderName" ] || { echo shared ; return 0 ; }
	for recordPath in "$spawnRoot/$folderName"/*.md ; do
		[ -f "$recordPath" ] || continue
		recordStatus="$( AgentsToolsSpawnSandboxRecordHeader "$recordPath" status )"
		case "$recordStatus" in ''|spawn-started) echo open ; return 0 ;; esac
	done
	for recordPath in "$spawnRoot/$folderName"/*.md ; do
		[ -f "$recordPath" ] || continue
		recordSpawn="${recordPath##*/}"
		spawnIds="$spawnIds ${recordSpawn%.md}"
		for linkField in spawns spawned-by ; do
			linkText="$( AgentsToolsSpawnSandboxRecordHeader "$recordPath" "$linkField" )"
			for linkStem in ${linkText//,/ } ; do
				linkStem="${linkStem%.md}"
				[ "$linkStem" != "$skipStem" ] || continue
				for boardPath in "$MDAT_DATA_ROOT"/board/*/"$linkStem.md" ; do
					[ ! -f "$boardPath" ] || { echo shared ; return 0 ; }
				done
			done
		done
	done
	if LC_ALL=C awk -v wantIds="$spawnIds" -v skipStem="$skipStem" '
		BEGIN { idCount = split( wantIds, idParts, " " ) ; for ( idIndex = 1 ; idIndex <= idCount ; idIndex++ ) { idSet[idParts[idIndex]] = 1 ; } }
		FNR == 1 { fmCount = 0 ; fileBase = FILENAME ; sub( /^.*\//, "", fileBase ) ; skipFile = ( fileBase == skipStem ".md" ) ; }
		skipFile { next ; }
		$0 == "---" { fmCount++ ; next ; }
		fmCount == 1 && index( $0, "spawn-id: " ) == 1 && ( substr( $0, 11 ) in idSet ) { found = 1 ; exit ; }
		END { exit ( found ? 0 : 1 ) ; }
	' "$MDAT_DATA_ROOT"/board/*/*.md 2> /dev/null ; then
		echo shared ; return 0
	fi
	echo removable
	return 0
}
