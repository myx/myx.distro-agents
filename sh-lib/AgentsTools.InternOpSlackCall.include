#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.InternOpSlackCall.include -- --intern-op-slack-call.
## Sourced lazily via the standard $MDLT_ORIGIN path; relies on being
## dot-sourced for $1/$@/$MDSC_CMD. No --help entry: internal plumbing.
##
## THE one place Slack is called. Identity selection, token handling and
## per-identity DM resolution live here and nowhere else -- per the ruling that
## all Slack operations share one universal --intern-op-* with per-instruction
## stubs over it. A stub that re-implements any of this is a defect, not a
## variation: this package spent a whole session deleting sixteen inline copies
## of one rule and will not grow a seventeenth.
##
## Syntax:
##   --intern-op-slack-call <team-member> --api <method>
##     [--identity bot|user]
##     [--target-kind channel|dm]
##     [--form <name>=<value>]...
##     [--json-body <json>]
##     [--resolve-dm <user-id>]
##     [--resolve-target <user-id|conversation-id>]
##     [--expect-counterparty <user-id>]
##     [--context <caller-op>]
##
##   --intern-op-slack-call <team-member> --fetch-url <url> --fetch-to <path>
##     [--identity bot|user]
##     [--context <caller-op>]
##
## IDENTITY (constraint: one rule, every op):
##   --identity wins outright when given; `user` fails loud if the member has no
##   SLACK_USER_TOKEN rather than quietly using the bot. Otherwise a routine-*
##   caller is bot-authored by name, else the member's own user token if it has
##   one, else bot. Byte-identical to the selection --member-comms-slack-send-message
##   already performed; relocated, not redesigned.
##
## DM RESOLUTION IS PER IDENTITY, AND THIS IS THE WHOLE BUG THIS OP EXISTS FOR.
## A DM channel id belongs to one identity pair. The bot's DM with a person is a
## DIFFERENT channel from that person's DM with a member's user identity, and
## neither can read the other. So a DM channel is never carried in shared
## config -- the caller passes a USER id and, when it needs a DM, asks for it to
## be opened under whichever identity is about to make the call.
##
##   --resolve-dm <user-id>  opens the DM under THIS call's identity and injects
##                           channel=<that dm> into the parameters.
##
## SENDS DO NOT NEED THIS. chat.postMessage accepts a user id directly as
## `channel` and resolves it to the calling identity's own DM -- measured, both
## sides. Reads and reactions do NOT accept a user id and must open the DM
## first. That asymmetry is declared by each stub; it is never assumed uniform.
##
## TARGET CLASSIFICATION LIVES HERE, ONE COPY, because this op owns the routing
## decision -- a stub that classified for itself would be the seventeenth copy
## this file's opening paragraph refuses to grow.
##
##   --resolve-target <id>   the id whose KIND is not known to the caller: a
##                           config value, a resolver result, an operator
##                           argument. Slack's own id scheme declares the kind
##                           in the first character, so this is ENFORCEMENT of a
##                           declared field type, not sniffing:
##                             U / W    -- a party      -> DM opened under THIS
##                                         call's identity, exactly as
##                                         --resolve-dm does, reusing that one
##                                         path rather than a second copy of it
##                             C / D / G -- a conversation -> passed through as
##                                         channel=<id>, untouched
##                             anything else, empty included -> hard error
##                           There is deliberately NO fallback that guesses.
##                           Guessing is precisely how a user id reached
##                           conversations.history and produced
##                           channel_not_found while sends kept working:
##                           chat.postMessage accepts a party id, the read
##                           endpoints do not.
##
## CLASSIFICATION ALSO SUPPLIES --target-kind when the caller did not declare
## one, so no call site has to hardcode an identity to get the right
## conversation. A party target is a DM target, which leaves the identity
## selection below untouched (the member's own, native identity -- the same
## identity the send path uses, therefore the same DM). A channel/group target
## takes the DM-only downgrade below and reads under the bot, which is what a
## channel read requires. An explicitly passed --target-kind still wins: this
## fills a gap, it never overrides a declaration.
##
## --expect-counterparty <user-id> IS AN OPT-IN CONTROL, off unless asked for.
## It answers one question about --resolve-target's own value -- "is this really
## a conversation with the party I expect?" -- in three distinguishable
## outcomes, and the expected party is always CALLER-SUPPLIED so the negative
## branch can be demonstrated on demand rather than argued about:
##
##   1. not-a-conversation -- a party id (U/W) was supplied where a conversation
##      is required. Decided LEXICALLY, from the prefix, before any
##      conversations.info round trip: no network call can tell you anything
##      about this that the first character did not already say. This is the
##      case that actually reached production.
##   2. wrong party -- conversations.info reports a counterparty that is not the
##      expected one. The failure names BOTH the expected and the actual party;
##      naming only one of them is what makes such a report unusable.
##   3. match -- reported on stderr as COUNTERPARTY_MATCH= and the call proceeds.
##
## Outcomes 1 and 2 are failures and go through the single failure branch below
## like every other failure here; there is no third rc.
##
## ONE FAILURE BRANCH. Every failure sets failMsg and breaks to the single exit
## path below, which cleans up once and returns 1. There is deliberately no
## branch anywhere that substitutes a different target and returns success --
## the defect this replaces did exactly that, silently reverting to a static
## bot-pair channel and reporting a send as delivered.
##
## rc IS DRIVEN BY "ok":true. Slack answers HTTP 200 with {"ok":false,...} for
## most real failures, so curl's own exit status is not the outcome. An
## ok:false NEVER surfaces as rc=0.
##
## STRUCTURED STDERR FIELDS ARE THIS OP'S CALLER INTERFACE. THE PROSE IS NOT.
##
## Everything a caller is entitled to read back from this op is emitted as a
## line-anchored `KEY=value` on stderr, and is read back with
##   sed -n 's/^KEY=//p'
## which is anchored at the start of a line, matches once, and has no greedy
## `.*` in it at all. The human-readable sentences on stderr are for humans:
## they are free to be reworded, retitled, split or extended at any time, and
## NOTHING may parse them. Three call sites in AgentsTools.MemberCommsSlack.include used to
## re-extract the acting identity out of the phrase "under <x> identity", and a
## fourth used to recover the raw API body out of "identity: {...}". That made
## the wording of a sentence WE OURSELVES EMIT load-bearing: reword it and a
## caller silently starts naming the wrong identity, or prints nothing where it
## used to print a response body. It also carried the same last-match hazard as
## the JSON reads this package has spent a session removing -- `.*under \(...\)
## identity.*` is greedy, and a diagnostic that names the identity twice hands
## back the second one. Emitting the field is the fix; a better pattern is not.
##
## The fields, emitted on EVERY exit path of this op, success and failure alike,
## because the failure path is exactly where the callers read them and a caller
## must never have to infer a value from a MISSING line:
##
##   ACTING_IDENTITY=bot|user|not-yet-selected
##                   Which identity this call actually ran under.
##                   `not-yet-selected` is a real, positive state, NOT a filler
##                   for "unknown": the op failed before identity selection ran
##                   (bad arguments, an unclassifiable target, the counterparty
##                   not-a-conversation outcome, or --identity user refused for
##                   a member with no user token). A caller that says "this call
##                   acted as the bot" when no identity was ever chosen is
##                   reporting a fact that did not happen.
##
##   RESPONSE_BODY_STATE=on-stdout|in-diagnostic|none
##                   Where the API response body for the requested method is,
##                   as its own always-present field so a caller tests it
##                   POSITIVELY instead of testing RESPONSE_BODY for emptiness.
##                     on-stdout     -- the call succeeded; the body is this
##                                      op's stdout, as it always has been.
##                     in-diagnostic -- the method answered ok:false; the body
##                                      is the RESPONSE_BODY= line below. This
##                                      is the state --member-comms-slack-react's
##                                      already-present outcome needs.
##                     none          -- there is no body for the requested
##                                      method: the op failed before calling it,
##                                      or the call never returned one (a
##                                      transport failure, where what curl left
##                                      behind is its own diagnostics and not an
##                                      API response).
##
##   RESPONSE_BODY=<raw body>
##                   Emitted ONLY in the `in-diagnostic` state. Slack sends this
##                   body on one line; a caller reads the first match and no
##                   more.
##
## COUNTERPARTY_MATCH= is the older field of the same kind and is unchanged.
## Adding fields does not add an exit path: the single failure branch, the three
## counterparty outcomes and the rc contract are all exactly as described above.
##
## THERE IS DELIBERATELY NO DM_CHANNEL= FIELD, AND ITS ABSENCE IS NOT AN
## OVERSIGHT. One existed, emitted on the success path whenever --resolve-dm had
## opened a DM, and it was removed on purpose. --resolve-dm injects the opened
## DM as this very call's own `channel=` argument, so the method's own response
## body -- the body this op puts on stdout, and that RESPONSE_BODY_STATE=on-stdout
## announces -- already carries that same id as `channel.id`. Its only consumer
## discarded that body to /dev/null and then recovered the id from the stderr
## echo instead: a wire field whose entire job was re-carrying a value its own
## reader had just thrown away. Two copies of one fact are two things that can
## later disagree, and the copy travelling as a stderr line was the weaker of the
## two. A consumer needing the opened DM's id reads `channel.id` out of the
## response through sh-lib/AgentsSlackJsonField.awk -- the reader every other
## field read in this package now goes through -- and gets that reader's own
## three-state contract with it (rc 0 found, rc 3 that path is absent from this
## payload, rc 1 the body was not a parseable API response), which a
## present-or-missing stderr line could never express: a missing line cannot say
## whether the field was absent or the body was garbage.
##
## FETCH MODE -- A RAW AUTHENTICATED GET, AND WHY IT IS HERE.
##
##   --intern-op-slack-call <team-member> --fetch-url <url> --fetch-to <path>
##
## Named to match its one caller, --member-comms-slack-file-fetch, whose name is the
## human-owner's own ratified choice of `fetch` over `download`: `download`
## implies a downloads location, and nothing on this path picks a location at
## all -- the destination is caller-supplied, here and there alike.
##
## A Slack file's bytes do not live behind an API method. `url_private` and
## `url_private_download` are ordinary HTTPS URLs on files.slack.com, and they
## need the SAME `Authorization: Bearer` header an API call needs -- an
## unauthenticated GET answers HTTP 200 with an HTML sign-in page, which is a
## false success that looks exactly like a file. So this is genuinely a Slack
## call with a Slack credential on it, and the opening paragraph of this file --
## THE one place Slack is called, token handling lives here and nowhere else --
## applies to it in full. The alternative was a `curl` with a token in the
## calling arm, which is the seventeenth copy this file refuses to grow, and
## would additionally have put a credential somewhere other than the one private
## header file this op already writes.
##
## It is a MODE, not a second op, for the same reason --print-acting-identity is:
## it needs the identity selection below, and a sibling op would have to restate
## that rule. Exactly one of --api / --fetch-url is given; naming both, or
## neither, is a hard error.
##
## WHAT THE API PATH DOES THAT THIS PATH MUST NOT DO, and why the two cannot be
## one code path:
##   - The URL. The API path builds https://slack.com/api/<method>. This path is
##     handed a whole URL, so it is VALIDATED instead of built -- see the host
##     check at its call site. A Bearer token must never be sent to a host we did
##     not positively confirm is Slack's.
##   - The body. The API path captures the response into a shell variable and
##     prints it on stdout. Bytes of a PNG do not survive that (command
##     substitution strips trailing newlines and a NUL cannot be held in a shell
##     variable at all), so this path writes to --fetch-to with `curl -o` and
##     puts NOTHING on stdout.
##   - The verdict. rc on the API path is driven by a `"ok":true` search. A PNG
##     contains no such string, so reusing that test would report every
##     successful download as a failure. This path's transport-level verdict is
##     the HTTP status instead: 200 passes, anything else takes the one failure
##     branch.
##
## THIS PATH DELIBERATELY DOES NOT JUDGE THE CONTENT. HTTP 200 with an HTML
## sign-in page, or 200 with a truncated body, are BOTH successes here. Telling
## those apart needs the file's expected size and type, which is knowledge the
## calling arm holds (from files.info) and this op does not. Reporting the facts
## and leaving the verdict to the caller is the same split every other arm in
## this package already uses; a content check invented here would be a second,
## weaker copy of the caller's own.
##
## The facts are reported as three more line-anchored fields on stderr, read back
## exactly like the ones above, and emitted whether the fetch passed or failed:
##
##   FETCH_HTTP_STATUS=<code>        the HTTP status curl actually saw.
##   FETCH_BYTES=<n>                 bytes curl actually wrote to --fetch-to.
##   FETCH_CONTENT_TYPE=<type>       the Content-Type the server sent, verbatim.
##
## Redirects are followed (-L), and curl does NOT forward the Authorization
## header across a host change on redirect -- so a files.slack.com URL that
## redirects to a pre-signed CDN URL works, and a redirect to anywhere else
## cannot carry the credential with it.
##
## RESPONSE_BODY_STATE is `none` on this path, and that is the field's own
## already-defined meaning rather than a special case: there is no API-method
## response body here, because no API method was called.
##

## The emitter for the fields documented above. A function rather than a line
## copied to each of the two dozen `return` sites: a copy missed at one site is
## indistinguishable, to a caller, from a call that never happened, and a
## `return` added later would silently be that missed site. Writes to stderr
## only and never touches rc.
##
##   $1  acting identity  -- `bot`, `user`, or `not-yet-selected`
##   $2  response-body state -- `on-stdout`, `in-diagnostic`, or `none`
##   $3  the raw response body -- read only in the `in-diagnostic` state
##
## The RESPONSE_BODY= line is gated on a POSITIVE test of the state it belongs
## to, not on whether $3 looks non-empty: an API response that is genuinely the
## empty string is still a response, and the state field is what says so.
AgentsToolsInternOpSlackCallEmitFields(){
	printf 'ACTING_IDENTITY=%s\n' "$1" >&2
	printf 'RESPONSE_BODY_STATE=%s\n' "$2" >&2
	if [ "$2" = "in-diagnostic" ] ; then
		printf 'RESPONSE_BODY=%s\n' "$3" >&2
	fi
}

case "$1" in

	--intern-op-slack-call)
		shift
		local opContext="<no --context given>"
		local ctxWanted="" ctxArg
		for ctxArg in "$@" ; do
			if [ -n "$ctxWanted" ] ; then
				opContext="$ctxArg" ; ctxWanted="" ; continue
			fi
			if [ "$ctxArg" = "--context" ] ; then ctxWanted="1" ; fi
		done

		local callerMember="$1"
		shift || true
		if [ -z "$callerMember" ] ; then
			echo "$MDSC_CMD: slack-call: ⛔ ERROR: syntax is <team-member> --api <method> [--identity bot|user] [--form <name>=<value>]... [--json-body <json>] [--resolve-dm <user-id>]" >&2
			AgentsToolsInternOpSlackCallEmitFields not-yet-selected none
			set +e ; return 1
		fi

		local apiMethod="" identityOverride="" jsonBody="" resolveDmUser="" targetKind=""
		local resolveTarget="" expectCounterparty="" targetClass=""
		## RAW AUTHENTICATED GET mode -- see this file's own FETCH MODE header
		## block for why it lives in this op rather than in the calling arm.
		local fetchUrl="" fetchTo=""
		## Introspection-only mode: answer "which token would this call use"
		## and make no call at all. See the arm below for why it lives inside
		## this op rather than beside it.
		local printActingIdentity="false"
		local formArgs=()
		while [ $# -gt 0 ] ; do
			case "$1" in
				--api)
					if [ -z "${2:-}" ] ; then
						echo "$MDSC_CMD: slack-call: ⛔ ERROR: --api: value required" >&2
						AgentsToolsInternOpSlackCallEmitFields not-yet-selected none
						set +e ; return 1
					fi
					apiMethod="$2" ; shift 2
				;;
				## FETCH MODE, see this file's own header block. Two flags, both
				## required together: a URL with no destination has nowhere to put
				## the bytes, and a destination with no URL has nothing to put in
				## it. Neither is defaulted -- picking a location is exactly what
				## this op does not do.
				--fetch-url)
					if [ -z "${2:-}" ] ; then
						echo "$MDSC_CMD: slack-call: ⛔ ERROR: --fetch-url: value required (a full https URL)" >&2
						AgentsToolsInternOpSlackCallEmitFields not-yet-selected none
						set +e ; return 1
					fi
					fetchUrl="$2" ; shift 2
				;;
				--fetch-to)
					if [ -z "${2:-}" ] ; then
						echo "$MDSC_CMD: slack-call: ⛔ ERROR: --fetch-to: value required (a destination file path)" >&2
						AgentsToolsInternOpSlackCallEmitFields not-yet-selected none
						set +e ; return 1
					fi
					fetchTo="$2" ; shift 2
				;;
				--identity)
					case "${2:-}" in
						bot|user) identityOverride="$2" ;;
						*)
							echo "$MDSC_CMD: slack-call: ⛔ ERROR: --identity must be 'bot' or 'user', got: ${2:-}" >&2
							AgentsToolsInternOpSlackCallEmitFields not-yet-selected none
							set +e ; return 1
						;;
					esac
					shift 2
				;;
				## INTROSPECTION, NOT A CALL. Reports which identity this op
				## would select for <team-member> under the flags given, then
				## returns without touching the network.
				##
				## It lives INSIDE this arm, sharing the one selection below,
				## rather than as a sibling op: the whole point is to report
				## what the real selection resolves to, and a sibling op would
				## have to restate the rule to answer -- a second copy of
				## identity selection, which is exactly what the ruling on this
				## forbids. Sharing the code path means the answer cannot drift
				## from the behaviour, including after the package-wide
				## --identity retirement lands, because this reads the
				## resolved variable and never the flags that fed it.
				--print-acting-identity)
					printActingIdentity="true" ; shift
				;;
				--form)
					if [ -z "${2:-}" ] ; then
						echo "$MDSC_CMD: slack-call: ⛔ ERROR: --form: value required (<name>=<value>)" >&2
						AgentsToolsInternOpSlackCallEmitFields not-yet-selected none
						set +e ; return 1
					fi
					formArgs+=( "$2" ) ; shift 2
				;;
				--json-body)
					if [ -z "${2:-}" ] ; then
						echo "$MDSC_CMD: slack-call: ⛔ ERROR: --json-body: value required" >&2
						AgentsToolsInternOpSlackCallEmitFields not-yet-selected none
						set +e ; return 1
					fi
					jsonBody="$2" ; shift 2
				;;
				--resolve-dm)
					if [ -z "${2:-}" ] ; then
						echo "$MDSC_CMD: slack-call: ⛔ ERROR: --resolve-dm: value required (<user-id>)" >&2
						AgentsToolsInternOpSlackCallEmitFields not-yet-selected none
						set +e ; return 1
					fi
					resolveDmUser="$2" ; shift 2
				;;
				--resolve-target)
					if [ -z "${2:-}" ] ; then
						echo "$MDSC_CMD: slack-call: ⛔ ERROR: --resolve-target: value required (<user-id>|<conversation-id>)" >&2
						AgentsToolsInternOpSlackCallEmitFields not-yet-selected none
						set +e ; return 1
					fi
					resolveTarget="$2" ; shift 2
				;;
				--expect-counterparty)
					if [ -z "${2:-}" ] ; then
						echo "$MDSC_CMD: slack-call: ⛔ ERROR: --expect-counterparty: value required (<user-id>)" >&2
						AgentsToolsInternOpSlackCallEmitFields not-yet-selected none
						set +e ; return 1
					fi
					expectCounterparty="$2" ; shift 2
				;;
				--target-kind)
					case "${2:-}" in
						channel|dm) targetKind="$2" ;;
						*)
							echo "$MDSC_CMD: slack-call: ⛔ ERROR: --target-kind must be 'channel' or 'dm', got: ${2:-}" >&2
							AgentsToolsInternOpSlackCallEmitFields not-yet-selected none
							set +e ; return 1
						;;
					esac
					shift 2
				;;
				--context)
					if [ -z "${2:-}" ] ; then
						echo "$MDSC_CMD: slack-call: ⛔ ERROR: --context: value required" >&2
						AgentsToolsInternOpSlackCallEmitFields not-yet-selected none
						set +e ; return 1
					fi
					shift 2
				;;
				*)
					echo "$MDSC_CMD: slack-call: ⛔ ERROR: invalid option: $1" >&2
					AgentsToolsInternOpSlackCallEmitFields not-yet-selected none
					set +e ; return 1
				;;
			esac
		done

		## WHAT THIS CALL FETCHES IS NAMED EXACTLY ONCE. --api names an API
		## method, --fetch-url names a raw authenticated GET, and the
		## introspection mode names neither because by construction it makes no
		## call at all. Both tests are POSITIVE tests on presence, and BOTH are
		## written out rather than collapsed into one: "you named both" and "you
		## named neither" are different caller mistakes and a single message
		## covering them would tell neither caller what to do.
		if [ "$printActingIdentity" != "true" ] ; then
			if [ -n "$apiMethod" ] && [ -n "$fetchUrl" ] ; then
				echo "$MDSC_CMD: slack-call: ⛔ ERROR: --api and --fetch-url cannot be combined -- they name two different things to call ('$apiMethod' and '$fetchUrl') and there is no rule for which one wins. An API method and a raw authenticated GET are separate modes; pass exactly one." >&2
				AgentsToolsInternOpSlackCallEmitFields not-yet-selected none
				set +e ; return 1
			fi
			if [ -z "$apiMethod" ] && [ -z "$fetchUrl" ] ; then
				echo "$MDSC_CMD: slack-call: ⛔ ERROR: one of --api <method> or --fetch-url <url> is required -- this call names nothing to fetch." >&2
				AgentsToolsInternOpSlackCallEmitFields not-yet-selected none
				set +e ; return 1
			fi
		fi

		## FETCH-MODE PARAMETER GUARDS, at parse time, before any token is read
		## and before anything leaves the host.
		if [ -n "$fetchUrl" ] ; then
			## The destination is required and never defaulted. See the header:
			## this op picks no location, ever.
			if [ -z "$fetchTo" ] ; then
				echo "$MDSC_CMD: slack-call: ⛔ ERROR: --fetch-url requires --fetch-to <path> -- there is no default destination and none will be invented; the caller names where the bytes go." >&2
				AgentsToolsInternOpSlackCallEmitFields not-yet-selected none
				set +e ; return 1
			fi

			## THE HOST IS CONFIRMED BEFORE A BEARER TOKEN IS EVER ATTACHED TO
			## IT. The API path builds its own URL and so cannot be pointed
			## anywhere; this path is handed one, which makes "is this really
			## Slack?" a question that must be answered here and cannot be
			## answered anywhere else. A token sent to an attacker-named host is
			## a credential disclosure, not a failed download.
			##
			## POSITIVE match on the whole scheme-and-host prefix, anchored at
			## both ends of the authority: `^https://([a-z0-9-]+\.)*slack\.com/`
			## requires the authority to END at slack.com and be followed by the
			## path separator. That rejects the two shapes a substring test would
			## wave through -- `https://slack.com.evil.example/...`, where
			## slack.com is only a label prefix of a different domain, and
			## `https://evilslack.com/...`, where it is only a suffix of a
			## different label. Plain `http://` is rejected with everything else:
			## the scheme is part of the anchored match, so a credential cannot
			## leave this host in the clear.
			##
			## `grep -qE` and POSIX ERE, not a shell `case` glob and not BRE: a
			## glob cannot express "one or more characters FROM this set", and
			## the BRE alternation `\|` is a GNU extension BSD grep does not
			## honour -- the trap already documented on the conversations.open
			## ok-test below, and still live for Darwin/FreeBSD/Linux parity.
			if ! printf '%s\n' "$fetchUrl" | LC_ALL=C grep -qE '^https://([a-z0-9-]+\.)*slack\.com/' ; then
				echo "$MDSC_CMD: slack-call: ⛔ ERROR: --fetch-url refused: '$fetchUrl' is not an https URL on a slack.com host. Nothing was called and NO CREDENTIAL WAS SENT ANYWHERE. This op attaches the acting identity's Slack token to the request, so it will only ever address a host it has positively confirmed is Slack's; the URL to pass is the one --member-comms-slack-file-info reports as URL_PRIVATE_DOWNLOAD or URL_PRIVATE." >&2
				AgentsToolsInternOpSlackCallEmitFields not-yet-selected none
				set +e ; return 1
			fi

			## Everything below is a CONVERSATION concern -- a form field, a JSON
			## body, a DM to open, a target to classify. A raw GET has no
			## conversation and no parameters: each of these would be accepted,
			## then silently ignored, which is the exact silent-degrade shape this
			## file exists to prevent. Refused individually so the message names
			## the one that was actually passed.
			local fetchConflict=""
			if [ "${#formArgs[@]}" -gt 0 ] ; then fetchConflict="--form" ; fi
			if [ -n "$jsonBody" ]           ; then fetchConflict="--json-body" ; fi
			if [ -n "$resolveDmUser" ]      ; then fetchConflict="--resolve-dm" ; fi
			if [ -n "$resolveTarget" ]      ; then fetchConflict="--resolve-target" ; fi
			if [ -n "$expectCounterparty" ] ; then fetchConflict="--expect-counterparty" ; fi
			if [ -n "$targetKind" ]         ; then fetchConflict="--target-kind" ; fi
			if [ -n "$fetchConflict" ] ; then
				echo "$MDSC_CMD: slack-call: ⛔ ERROR: $fetchConflict cannot be combined with --fetch-url -- it addresses a conversation or supplies call parameters, and a raw authenticated GET has neither. It would be accepted and then silently ignored, so it is refused instead." >&2
				AgentsToolsInternOpSlackCallEmitFields not-yet-selected none
				set +e ; return 1
			fi
		fi

		## PARAMETER-INTERACTION GUARD, enforced at parse time -- before any token
		## is read and before any network call.
		##
		## --json-body sends the body verbatim; it does not and must not merge
		## anything into it, because this layer has no JSON writer. So every
		## parameter that works by contributing a form field is INCOMPATIBLE with
		## it, and silently so:
		##
		##   --resolve-dm + --json-body would open the DM under the calling
		##   identity, resolve the correct channel, append it to the form list --
		##   and then POST a body naming a DIFFERENT channel. Slack answers
		##   ok:true. rc=0. Wrong conversation. That is this op's entire purpose
		##   defeated, and no failure branch is involved: the inputs disagree with
		##   each other while each is individually valid.
		##
		##   --form + --json-body drops the form fields the same way.
		##
		## Today's sends happen to use channel passthrough and never pass
		## --resolve-dm, so this is probably unreachable right now -- but that is
		## CONVENTION, not construction. A files-read op, or any future
		## POST-with-body caller, reaches for both naturally. Rejecting the
		## combination costs nothing and makes the wrong-conversation outcome
		## unreachable by construction rather than by habit.
		if [ -n "$jsonBody" ] ; then
			if [ -n "$resolveDmUser" ] ; then
				echo "$MDSC_CMD: slack-call: ⛔ ERROR: --resolve-dm cannot be combined with --json-body -- the resolved DM channel is delivered as a form field and would be silently ignored, sending to whatever channel the JSON body names. Put the channel in the body yourself, or use --form instead of --json-body." >&2
				AgentsToolsInternOpSlackCallEmitFields not-yet-selected none
				set +e ; return 1
			fi
			if [ ${#formArgs[@]} -gt 0 ] ; then
				echo "$MDSC_CMD: slack-call: ⛔ ERROR: --form cannot be combined with --json-body -- form fields are not merged into a JSON body and would be silently dropped. Use one or the other." >&2
				AgentsToolsInternOpSlackCallEmitFields not-yet-selected none
				set +e ; return 1
			fi
			## --resolve-target resolves to a channel form field on BOTH of its
			## branches -- a DM opened for a party id, a passthrough for a
			## conversation id -- so it fails against --json-body for exactly the
			## reason --resolve-dm does, and is rejected here rather than being
			## left to disagree silently with whatever channel the body names.
			if [ -n "$resolveTarget" ] ; then
				echo "$MDSC_CMD: slack-call: ⛔ ERROR: --resolve-target cannot be combined with --json-body -- the classified target is delivered as a form field and would be silently ignored, sending to whatever channel the JSON body names. Put the channel in the body yourself, or use --form instead of --json-body." >&2
				AgentsToolsInternOpSlackCallEmitFields not-yet-selected none
				set +e ; return 1
			fi
		fi

		## TARGET CLASSIFICATION -- see this file's own header for why it lives
		## here and nowhere else. Shell `case` pattern matching only: no sed, no
		## grep, therefore zero BSD/GNU dialect surface on a decision this cheap,
		## and no subprocess to get the answer wrong on one platform. The same
		## prefix-matching idiom is already used against Slack's id scheme by the
		## `[CDG]` extraction further down this file and by
		## AgentsTools.MagicComms.include's own conversations.open reader.
		if [ -n "$resolveTarget" ] ; then
			## Two ways to ask for a DM would be two answers to the same
			## question. --resolve-dm states "this IS a party id" by contract;
			## --resolve-target states "classify this for me". Passing both means
			## the caller does not know which of its own values is the target.
			if [ -n "$resolveDmUser" ] ; then
				echo "$MDSC_CMD: slack-call: ⛔ ERROR: --resolve-target cannot be combined with --resolve-dm -- both name the target of this call, and there is no rule for which one wins. Pass exactly one." >&2
				AgentsToolsInternOpSlackCallEmitFields not-yet-selected none
				set +e ; return 1
			fi
			case "$resolveTarget" in
				U*|W*)
					## A party id. Hand it to the ONE DM-resolution path below,
					## rather than opening a second one here.
					resolveDmUser="$resolveTarget"
					targetClass="party"
				;;
				D*)
					## Already the DM conversation itself -- nothing to open.
					## Kept as its own arm rather than folded into C/G because
					## its target kind differs: a DM is read under the member's
					## own identity, a channel is not.
					formArgs+=( "channel=$resolveTarget" )
					targetClass="conversation-dm"
				;;
				C*|G*)
					formArgs+=( "channel=$resolveTarget" )
					targetClass="conversation-channel"
				;;
				*)
					echo "$MDSC_CMD: slack-call: ⛔ ERROR: --resolve-target: '$resolveTarget' is neither a party identifier (U/W) nor a conversation identifier (C/D/G). This op does not guess -- an id whose kind cannot be read off its own first character is a configuration defect to fix at its source, not something to fall back from." >&2
					AgentsToolsInternOpSlackCallEmitFields not-yet-selected none
					set +e ; return 1
				;;
			esac

			## Classification supplies the target kind the caller did not
			## declare. Positive test on presence, never a negation against the
			## empty string -- an explicitly declared --target-kind is honoured
			## as given, and only a kind that was never declared at all gets
			## filled in from the classification above. The three states stay
			## distinguishable: declared-and-used, undeclared-and-derived, and
			## (unreachable here, since every surviving class maps to a kind)
			## genuinely none.
			local classifiedKind=""
			case "$targetClass" in
				party|conversation-dm) classifiedKind="dm" ;;
				conversation-channel) classifiedKind="channel" ;;
			esac
			if [ -n "$targetKind" ] ; then
				classifiedKind="$targetKind"
			fi
			targetKind="$classifiedKind"
		fi

		## COUNTERPARTY CONTROL, outcome 1 of 3: not-a-conversation.
		##
		## Decided here, lexically, and deliberately BEFORE the token is read and
		## before any request leaves this host: the first character of the id
		## already answers the question, so a conversations.info round trip could
		## only make the same answer slower and add a network failure mode to a
		## question that has none. Ordering is load-bearing -- this sits after
		## classification so an id that is not a Slack id at all has already been
		## rejected above with its own message, and this arm only ever reports
		## the one thing it is about.
		##
		## `case ... in ?*)` is the positive presence test for the option itself:
		## "at least one character", never a negation against empty.
		if [ -n "$expectCounterparty" ] ; then
			case "$resolveTarget" in
				?*)
					case "$resolveTarget" in
						U*|W*)
							echo "$MDSC_CMD: slack-call: ⛔ ERROR: counterparty control: NOT A CONVERSATION -- '$resolveTarget' is a party identifier, and a conversation identifier (C/D/G) is required here. A party id names a person, not a channel: the send endpoint resolves one to the caller's own DM, the read endpoints do not and answer channel_not_found. Resolve the DM for this party first (--resolve-target with no control, or --resolve-dm), then run the control against the conversation id that comes back." >&2
							AgentsToolsInternOpSlackCallEmitFields not-yet-selected none
							set +e ; return 1
						;;
					esac
				;;
				*)
					echo "$MDSC_CMD: slack-call: ⛔ ERROR: --expect-counterparty requires --resolve-target -- the control is defined against the target this call classifies, and has nothing to check without one." >&2
					AgentsToolsInternOpSlackCallEmitFields not-yet-selected none
					set +e ; return 1
				;;
			esac
		fi

		## Identity selection -- one rule, applied here for every Slack op.
		local memberUserToken="" sendIdentity="bot"
		memberUserToken="$( DistroAgentsTools --member-config-option "$callerMember" --select SLACK_USER_TOKEN )" || memberUserToken=""
		local routineAuthored="false"
		case "$callerMember" in
			routine-*) routineAuthored="true" ;;
		esac
		if [ -n "$identityOverride" ] ; then
			if [ "$identityOverride" = "user" ] && [ -z "$memberUserToken" ] ; then
				echo "$MDSC_CMD: slack-call: ⛔ ERROR: --identity user requested for $callerMember but no SLACK_USER_TOKEN is configured for it" >&2
				AgentsToolsInternOpSlackCallEmitFields not-yet-selected none
				set +e ; return 1
			fi
			sendIdentity="$identityOverride"
		elif [ "$routineAuthored" = "true" ] ; then
			sendIdentity="bot"
		elif [ -n "$memberUserToken" ] ; then
			sendIdentity="user"
		fi

		## Introspection short-circuit, placed HERE and nowhere earlier: it
		## reports $sendIdentity, the value the selection above just produced,
		## so the answer is the behaviour rather than a prediction of it. One
		## bare word on stdout (`bot` or `user`) for a caller to consume; the
		## usual ACTING_IDENTITY= diagnostic still goes to stderr, so this mode
		## looks like every other path to anything already reading those.
		if [ "$printActingIdentity" = "true" ] ; then
			printf '%s\n' "$sendIdentity"
			AgentsToolsInternOpSlackCallEmitFields "$sendIdentity" none
			return 0
		fi

		## TARGET KIND AND IDENTITY ARE SEPARATE CONCERNS. Nothing downgrades the
		## identity here, and nothing may be added that does.
		##
		## The identity rule is uniform and has exactly one shape, applied in full
		## by the selection above and by nothing after it: USER when the member
		## has its own user token, BOT when it does not, BOT when the bot modifier
		## is passed. There is no opposite modifier, because user is already the
		## default and nothing ever needs to ask for it. The bot modifier exists
		## for exactly one purpose -- keeping mechanical, debug and tracing
		## traffic off the human's own credentials.
		##
		## RECORDED ON PURPOSE, so the removed behaviour cannot be re-derived from
		## a gap: a "DM-only downgrade" used to sit right here and force bot
		## identity for every channel target. Its stated rationale was that a
		## channel read under a member's user identity hard-fails when the bot is
		## the one that was added to that channel. That rationale is overridden by
		## the human-owner's ruling on identity, and it is also contradicted by
		## measurement -- a member user identity that has posted into a channel is
		## a member of that channel and its token carries the history scope.
		## Identity selection was never the downgrade's decision to make: its
		## legitimate job is DM resolution, and it was quietly overriding the
		## default for an entire class of targets. It is gone. A channel target
		## takes the standard rule like every other target. Do not reinstate it.
		##
		## $targetKind therefore no longer feeds identity at all -- it stays the
		## declared-or-derived classification fact the caller asked for. Any test
		## on it, here or anywhere later, is written as a POSITIVE test on the
		## kind it means -- deliberately NOT as a not-equal test against the other
		## kind. (That anti-pattern is described rather than quoted here on
		## purpose: a verifier grepping for the forbidden form must not get a
		## permanent false positive off this comment.) A not-equal test is true
		## for the empty string, so an unset or not-yet-assigned targetKind would
		## match EVERY target -- precisely how a member's user identity gets
		## quietly replaced, reaches the wrong DM, and reports success. The
		## positive form cannot misfire on empty. The selection above keeps the
		## same discipline: it tests presence of the override and presence of the
		## member's own token, never a negation against empty.

		local token=""
		if [ "$sendIdentity" = "user" ] ; then
			token="$memberUserToken"
		else
			## THE BOT TOKEN IS THE TEAM'S, AND IT IS READ FROM THE TEAM'S OWN
			## SCOPE. It is not any member's credential -- it is the shared
			## fallback every member without a USER_TOKEN of its own acts under --
			## so keeping it in one member's settings made the whole team's
			## identity a property of that member's config. That is the same
			## category error as naming a member literally at a call site, one
			## level down: this op already resolves the USER token from the acting
			## member, and now the pair reads exactly as the rule states it --
			## the member's own token when it has one, the team's when it does not.
			token="$( DistroAgentsTools --agents-config-option magic-team --select SLACK_BOT_TOKEN )" || token=""
		fi
		if [ -z "$token" ] ; then
			echo "$MDSC_CMD: slack-call: ⛔ ERROR: no usable Slack token for identity '$sendIdentity' (member SLACK_USER_TOKEN, or the team's own SLACK_BOT_TOKEN in magic-team scope)" >&2
			## Selection HAS run by this point, so the identity is a real fact
			## even though the call never left the host -- reported as itself,
			## not as `not-yet-selected`. No response body exists for the
			## requested method here, and `none` says exactly that.
			AgentsToolsInternOpSlackCallEmitFields "$sendIdentity" none
			set +e ; return 1
		fi

		## Token to a private header file read via `-H @file`, never argv --
		## keeps it out of ps/proc for the call's lifetime. ONE trap, cleared at
		## the single exit path; no arm returns without passing through it.
		local headerFile=""
		headerFile="$( mktemp )" || { AgentsToolsInternOpSlackCallEmitFields "$sendIdentity" none ; set +e ; return 1 ; }
		chmod 600 "$headerFile"
		trap 'rm -f "$headerFile"' EXIT
		printf 'Authorization: Bearer %s\n' "$token" > "$headerFile"

		## `responseBodyState` starts at the state that is true right now and is
		## only ever moved forward by the arm that actually makes it true: no
		## body for the requested method exists yet, and most failure arms below
		## (transport, DM resolution, the counterparty control) never produce
		## one, so `none` is their correct answer and not a default standing in
		## for an unknown.
		local failMsg="" response="" dmChannel="" responseBodyState="none"
		while true ; do
			## DM resolution under THIS identity, when the caller asked for it.
			if [ -n "$resolveDmUser" ] ; then
				local openResp
				openResp="$( curl -sS --connect-timeout 10 --max-time 120 -X POST https://slack.com/api/conversations.open \
					-H @"$headerFile" \
					-H "Content-type: application/x-www-form-urlencoded" \
					--data-urlencode "users=$resolveDmUser" 2>&1 )" || {
					failMsg="conversations.open transport failure for user $resolveDmUser under $sendIdentity identity: $openResp"
					break
				}
				## Same literal `"ok":true` test the main call below uses -- a
				## fixed-string search for a fixed string, deliberately not an
				## extraction. It was once written as
				##   sed 's/.*"ok":\(true\|false\).*/\1/'
				## and `\|` is a GNU basic-regex extension BSD sed does not
				## honour, so on Darwin that form matched nothing, yielded an
				## empty string, and reported a perfectly good ok:true response as
				## a refusal. Caught live here against a real ok:true,no_op:true
				## reply. That lesson has not expired -- it is why nothing in this
				## file reaches for regex cleverness on a JSON body. The `\|`
				## workaround is unavailable, `sed` has no non-greedy quantifier in
				## BRE, and the two failure modes point the same way: a JSON field
				## is read by PARSING the payload (see the field reader used just
				## below), and a fixed marker is matched as a fixed string. Neither
				## job is a regex problem. Cross-platform correctness on
				## Darwin/FreeBSD/Linux is a hard requirement in this family, not
				## an aspiration.
				if ! printf '%s' "$openResp" | grep -q '"ok":true' ; then
					failMsg="conversations.open refused for user $resolveDmUser under $sendIdentity identity -- this identity cannot open that DM: $openResp"
					break
				fi
				## The opened conversation's OWN id, read by full key path through
				## sh-lib/AgentsSlackJsonField.awk. This line used to be
				##   sed -n 's/.*"id":"\([CDG][^"]*\)".*/\1/p' | head -1
				## and it was wrong twice over. Greedy BRE `.*` makes the capture
				## land on the LAST C/D/G-prefixed `"id"` anywhere in the body, at
				## any depth; the `[CDG]` class never selected the right field,
				## it only hid how arbitrary the choice was. Then `head -1` took
				## the first match on the first LINE, which is right today only
				## because Slack sends this body on one line -- pretty-print it
				## once and that tiebreak silently starts answering a different
				## question. Neither accident is preserved: the reader slurps the
				## whole body, single-line or not, and `channel.id` matches the
				## channel object's own id by path equality.
				##
				## Presence is decided by the reader's EXIT STATUS, never by
				## testing the string for emptiness -- rc 0 found, rc 3 that path
				## is not in this payload, rc 1 the body was not a parseable API
				## response. This id is required: it becomes the `channel=` form
				## argument of the call about to be made, and an absent id reaching
				## a channel argument is precisely the failure this whole file
				## exists to make impossible. Every non-zero rc therefore takes the
				## one failure branch, unchanged: set failMsg, break.
				local dmChannelRc=0
				dmChannel="$( printf '%s\n' "$openResp" | LC_ALL=C awk -v path=channel.id -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsSlackJsonField.awk" )" || dmChannelRc=$?
				if [ "$dmChannelRc" != "0" ] || [ -z "$dmChannel" ] ; then
					failMsg="conversations.open returned ok:true but no usable channel.id for user $resolveDmUser (field reader rc=$dmChannelRc -- 3: that path is absent from the response, 1: the body was not a parseable API response) -- refusing to send with an empty channel id: $openResp"
					break
				fi
				formArgs+=( "channel=$dmChannel" )
			fi

			## COUNTERPARTY CONTROL, outcomes 2 and 3: wrong party / match.
			##
			## Reached only when outcome 1 above did not fire, so $resolveTarget
			## is a conversation id by construction and is the thing to inspect.
			## Runs under THIS call's identity, using the header file already
			## written above -- a DM id belongs to one identity pair, so asking
			## the other identity about it would answer a different question than
			## the one the caller asked.
			if [ -n "$expectCounterparty" ] ; then
				local infoResp="" actualCounterparty=""
				infoResp="$( curl -sS --connect-timeout 10 --max-time 120 -G https://slack.com/api/conversations.info \
					-H @"$headerFile" \
					--data-urlencode "channel=$resolveTarget" 2>&1 )" || {
					failMsg="counterparty control: conversations.info transport failure for conversation $resolveTarget under $sendIdentity identity: $infoResp"
					break
				}
				if ! printf '%s' "$infoResp" | grep -q '"ok":true' ; then
					failMsg="counterparty control: conversations.info could not inspect conversation $resolveTarget under $sendIdentity identity -- the control reached no verdict, which is not a pass: $infoResp"
					break
				fi
				## THE COUNTERPARTY IS PARSED, NOT PATTERN-MATCHED, AND THAT IS
				## NOT A STYLE PREFERENCE. This line was once
				##   sed -n 's/.*"user":"\([UW][^"]*\)".*/\1/p' | head -1
				## which is wrong by construction: BRE `.*` is greedy, so the
				## leading `.*` eats as far as it can and the capture lands on
				## the LAST "user":"..." in the payload. A conversations.info
				## body for a DM carries several -- the channel's own `user`
				## (the counterparty), the `latest` message's `user` (whoever
				## spoke most recently), and `latest.bot_profile.user_id` --
				## so the control was reporting the most recent speaker, or an
				## app's own user, in place of the party.
				##
				## It passed verification anyway, BY COINCIDENCE: when the
				## control was first checked, the newest message in that DM
				## happened to be from the expected party, so the last "user"
				## incidentally equalled the expected one. The check was real;
				## the mechanism had never once read the counterparty. Measured
				## again later against the same two DMs, both legs reported the
				## wrong party. That one site was the first of a whole class --
				## every `s/.*"KEY":"\([^"]*\)".*/\1/p` read of a Slack body in
				## this package was written as if the key occurred exactly once,
				## and all of them have since been converted the same way.
				##
				## The fix is not a better regex, and there is no cleverer one to
				## reach for. `sed` has no non-greedy quantifier in BRE, and the
				## GNU-only forms that could fake one (`\|`, PCRE `.*?`) are
				## precisely what this file refuses for Darwin/FreeBSD/Linux
				## parity -- the `\|` trap is documented in full on the
				## conversations.open ok-test above, and it still holds. Both
				## lessons converge on one conclusion: reading a field out of a
				## JSON body is not a regex problem at all. The payload goes
				## through this package's in-house recursive-descent JSON parser
				## instead, so `channel.user` matches the channel object's own
				## field by path equality and can never be confused with
				## `channel.latest.user` or any other nested author.
				##
				## The script used here is the counterparty-specific
				## sh-lib/AgentsSlackConversationCounterparty.awk, NOT the general
				## sh-lib/AgentsSlackJsonField.awk used for plain field reads
				## elsewhere in this file. Deliberate: this control's verdict is a
				## conjunction, not a field read -- a DM must positively say
				## `channel.is_im` is true AND carry `channel.user` -- and that
				## conjunction belongs in one place with the payload, not
				## reassembled from two separate reads in shell. Do not turn
				## either of them back into a one-liner.
				##
				## It prints exactly one line for a DM and nothing at all for a
				## conversation with no single counterparty -- a channel, a
				## group, an mpim -- which is what the wrong-party branch below
				## renders as "<none: this conversation has no single
				## counterparty>", unchanged.
				actualCounterparty="$( printf '%s\n' "$infoResp" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsSlackConversationCounterparty.awk" )"
				if [ "$actualCounterparty" = "$expectCounterparty" ] ; then
					## Outcome 3, match. Reported, not silent: a control that
					## passes invisibly cannot be told apart from one that never
					## ran.
					echo "COUNTERPARTY_MATCH=$actualCounterparty" >&2
				else
					## Outcome 2, wrong party. Both parties are named -- a report
					## carrying only the expected one, or only the actual one,
					## cannot be acted on without a second investigation. A
					## conversation with no single counterparty (a channel or
					## group) lands here too, and says so in place of the actual
					## party.
					failMsg="counterparty control: WRONG PARTY for conversation $resolveTarget under $sendIdentity identity -- expected party $expectCounterparty, actual party ${actualCounterparty:-<none: this conversation has no single counterparty>}"
					break
				fi
			fi

			## FETCH MODE. Reached only when the guards above passed, so the URL
			## is confirmed-Slack and the destination is caller-named. Uses the
			## same private header file every API call above uses -- the token is
			## never on a command line, here or anywhere else in this op.
			##
			## `-o` writes the body straight to the destination and NOT into a
			## shell variable: see the header for why a PNG cannot survive command
			## substitution. Nothing goes to this op's stdout on this path.
			##
			## `-o` writes whatever came back, INCLUDING an error page or a
			## sign-in page. That is deliberate and is not a leak of a bad result:
			## the caller fetches to its own temporary file and promotes it only
			## after its own content checks pass. Writing the body is what makes
			## those checks possible at all.
			##
			## `-w` reports the three facts the caller needs, on ONE line, in a
			## fixed order, from curl's own variables -- never re-derived from the
			## file afterwards. `--max-redirs 5` bounds the redirect chain, and
			## curl drops the Authorization header on a cross-host redirect, so
			## the credential cannot follow a URL off Slack.
			## --max-time 900, not the 120 every API call here gets: this one moves a file.
			if [ -n "$fetchUrl" ] ; then
				local fetchOut="" fetchLine=""
				fetchOut="$( curl -sS --connect-timeout 10 --max-time 900 -L --max-redirs 5 \
					-H @"$headerFile" \
					-o "$fetchTo" \
					-w '%{http_code} %{size_download} %{content_type}' \
					"$fetchUrl" 2>&1 )" || {
					failMsg="raw authenticated GET transport failure under $sendIdentity identity for $fetchUrl: $fetchOut"
					break
				}

				## The -w line is the LAST line of what was captured: curl's own
				## warnings, if any, precede it on the merged stream. Taking the
				## last line rather than the whole capture keeps the parse right
				## in both cases. `tail -1` is safe here for the same reason it is
				## not elsewhere in this package -- this is curl's own fixed
				## single-line format, not a JSON body whose layout can change.
				fetchLine="$( printf '%s\n' "$fetchOut" | tail -1 )"
				local fetchStatus="" fetchBytes="" fetchType=""
				## Content-Type last, and read with the trailing-field catch-all,
				## because it is the only one of the three that can contain a
				## space (`text/html; charset=utf-8`). Status and byte count
				## cannot, so splitting on whitespace is exact for them.
				read -r fetchStatus fetchBytes fetchType <<< "$fetchLine"

				## Emitted BEFORE the verdict below, so they are present on the
				## failure path too -- the path where the caller most needs them.
				## Same always-present discipline as ACTING_IDENTITY=.
				printf 'FETCH_HTTP_STATUS=%s\n' "$fetchStatus" >&2
				printf 'FETCH_BYTES=%s\n' "$fetchBytes" >&2
				printf 'FETCH_CONTENT_TYPE=%s\n' "$fetchType" >&2

				## THE TRANSPORT-LEVEL VERDICT, AND ONLY THAT. A POSITIVE test for
				## the one status that means "the server handed over the thing you
				## asked for". Everything else -- 401, 403, 404, a 5xx -- is a
				## failed fetch, and the caller is told the code rather than left
				## to infer it.
				##
				## HTTP 200 IS NOT A GUARANTEE THE BYTES ARE THE FILE, and this op
				## deliberately does not pretend otherwise: an unauthenticated or
				## under-scoped request for a url_private answers 200 with an HTML
				## sign-in page. Catching that needs the file's expected size and
				## type, which this op does not have and the caller does. See the
				## header block.
				if [ "$fetchStatus" != "200" ] ; then
					failMsg="raw authenticated GET returned HTTP $fetchStatus (not 200) under $sendIdentity identity for $fetchUrl -- the server did not hand over the file. Whatever it did send has been written to $fetchTo and must not be treated as file content."
					break
				fi
				break
			fi

			if [ -n "$jsonBody" ] ; then
				response="$( curl -sS --connect-timeout 10 --max-time 120 -X POST "https://slack.com/api/$apiMethod" \
					-H @"$headerFile" \
					-H "Content-type: application/json" \
					-d "$jsonBody" 2>&1 )" || {
					failMsg="$apiMethod transport failure under $sendIdentity identity: $response"
					break
				}
			else
				local curlArgs=( -sS --connect-timeout 10 --max-time 120 -G "https://slack.com/api/$apiMethod" -H @"$headerFile" ) formPair
				for formPair in "${formArgs[@]}" ; do
					curlArgs+=( --data-urlencode "$formPair" )
				done
				response="$( curl "${curlArgs[@]}" 2>&1 )" || {
					failMsg="$apiMethod transport failure under $sendIdentity identity: $response"
					break
				}
			fi

			## Slack answers HTTP 200 with ok:false for most real failures, so the
			## body decides the outcome, not curl's exit status.
			if ! printf '%s' "$response" | grep -q '"ok":true' ; then
				## The method answered, and what it answered with is a real API
				## body -- just a failing one. That body is a caller-visible
				## fact (--member-comms-slack-react's already-present outcome replays
				## it on stdout), so it is handed over as its own structured
				## field rather than being left to be cut back out of the
				## sentence below. The sentence stays, for humans; it is not the
				## interface and must not be parsed.
				responseBodyState="in-diagnostic"
				failMsg="$apiMethod returned ok:false under $sendIdentity identity: $response"
				break
			fi
			break
		done

		## THE single exit path -- one cleanup, one failure branch, no degrade.
		rm -f "$headerFile"
		trap - EXIT
		if [ -n "$failMsg" ] ; then
			echo "$MDSC_CMD: slack-call: ⛔ ERROR: $failMsg" >&2
			## Fields after the prose, on the same failure branch -- still ONE
			## failure branch, one cleanup, one rc. This adds emitted facts, not
			## an exit path and not a degrade.
			AgentsToolsInternOpSlackCallEmitFields "$sendIdentity" "$responseBodyState" "$response"
			set +e ; return 1
		fi
		## No DM_CHANNEL= line here -- see this file's own STRUCTURED STDERR
		## FIELDS header for why the field was removed rather than kept: the
		## opened DM's id is already `channel.id` of the response printed on
		## stdout two lines below, and re-emitting it here was one fact carried
		## twice.
		## FETCH MODE's own success exit. `none` is not a special case here: it is
		## RESPONSE_BODY_STATE's own already-defined meaning, "there is no body
		## for the requested method", and there is not one, because no API method
		## was called. Nothing is printed on stdout either -- the bytes are in
		## --fetch-to, and an empty line on stdout would be a body-shaped thing a
		## caller could mistake for a response.
		if [ -n "$fetchUrl" ] ; then
			AgentsToolsInternOpSlackCallEmitFields "$sendIdentity" none
			return 0
		fi
		## The success path emits the same two fields as every failure path, so
		## a caller reads them the same way whichever way the call went. The body
		## itself is not repeated on stderr here: it is on stdout, and
		## `on-stdout` is the field that says so.
		AgentsToolsInternOpSlackCallEmitFields "$sendIdentity" on-stdout
		printf '%s\n' "$response"
		return 0
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
