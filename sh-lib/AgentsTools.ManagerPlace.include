#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.ManagerPlace.include -- the --manager-place-* operations: the places of this
## machine as the console shows them. Sourced from the `--manager-place-*)` arm of
## AgentsTools.Manager.include; who may call was asked where the family is dispatched.
##
## A PLACE is a folder the tooling knows by a name, a workspace or a directory
## (AgentsTools.Places.include). THE PLACES ARE READ BY THEIR OWN READER, the merged list
## (AgentsToolsPlacesMergedText), which is what --owner-workspace-list and
## --member-directory-list print: nothing here opens a registry of places, and nothing here
## writes one. What a row gets beyond that list is measured at the call or made of the row
## itself: whether its path is there, whether it is the workspace the call runs in, a label,
## and how many sessions of this workspace's registry of sessions name it, as that registry
## lies.
##
## FOR VIEWING. Nothing here writes: no registry, no file. NOTHING REACHES ANOTHER HOST: a
## path is tested by the shell's own tests, on this host, and nothing is started. A registry
## of places holds no host: a row of it is a path as it was resolved for the host that wrote
## it. So no host is printed, and a place is shown by what stands at its path here, now.
##

type AgentsToolsPlacesMergedText > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.Places.include"
type AgentsToolsRegistryFile > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.Registries.include"
type AgentsToolsMemberHomesFile > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.MemberHomes.include"

## The merged list of the places, each row with the state of its path as it is here, now:
## name, kind, ceiling, path, declaring root, declared-by, state, a TAB between them.
## `present` where the path is a folder the user who runs the call can enter and read,
## `unreadable` where something is there that is not, `absent` where nothing is, `unknown`
## where the list knows no path. By the shell's own tests alone.
AgentsToolsManagerPlaceSource(){
	local sourceName sourceKind sourceCeiling sourcePath sourceRoot sourceBy sourceState
	AgentsToolsPlacesMergedText "${MMDAPP%/}" quiet | while IFS=$'\t' read -r sourceName sourceKind sourceCeiling sourcePath sourceRoot sourceBy ; do
		[ -n "$sourceName" ] || continue
		if [ -z "$sourcePath" ] || [ "$sourcePath" = "-" ] ; then
			sourceState=unknown
		elif [ -d "$sourcePath" ] && [ -r "$sourcePath" ] && [ -x "$sourcePath" ] ; then
			sourceState=present
		elif [ -e "$sourcePath" ] ; then
			sourceState=unreadable
		else
			sourceState=absent
		fi
		printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$sourceName" "${sourceKind:--}" "${sourceCeiling:--}" "${sourcePath:--}" "${sourceRoot:--}" "${sourceBy:--}" "$sourceState"
	done
	return 0
}

## The `place` rows of the source rows on stdin (AgentsManagerPlaceRows.awk): with a key, the
## row of that place alone. The registry of the sessions of this workspace is read as it
## lies, where it is there, and is never rebuilt here.
AgentsToolsManagerPlaceRows(){ ## key (may be empty)
	MDAT_MANAGER_PLACE_HERE="${MMDAPP%/}" MDAT_MANAGER_PLACE_SESSIONS="$( AgentsToolsRegistryFile spawned-sessions )" \
		LC_ALL=C awk -v wanted="${1:-}" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsManagerPlaceRows.awk"
}

## One field of a row: its whitespace reads `_`, and an empty one `-`, as in a registry.
AgentsToolsManagerPlaceField(){ ## text
	local fieldText="${1//[[:space:]]/_}"
	printf '%s' "${fieldText:--}"
}

case "$1" in

	## The places of this machine, one row each: TAB-separated rows a screen reads. Their form
	## is the help entry's.
	--manager-place-list)
		local listOp="$1"
		shift
		if [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD $listOp: syntax is $listOp, got $# argument(s) -- nothing is shown" >&2
			set +e ; return 1
		fi
		AgentsToolsManagerPlaceSource | AgentsToolsManagerPlaceRows ""
		return 0
	;;

	## One place by its key: its row as the list has it, what the registry holds of it beyond
	## that row, and what stands at its path that the tooling knows. Its form is the help entry's.
	--manager-place-read)
		local readOp="$1" readKey readName readKind readCeiling readPath readRoot readBy readState readFound="" readFile readMember readHome readRest
		shift
		if [ $# -ne 1 ] ; then
			echo "⛔ ERROR: $MDSC_CMD $readOp: syntax is $readOp <place>, got $# argument(s) -- nothing is shown" >&2
			set +e ; return 1
		fi
		readKey="$1"
		## A word that is no name of a place may be anything: it is not repeated.
		if ! AgentsToolsPlacesNameValid "${readKey%%@*}" || { [ "$readKey" != "${readKey%%@*}" ] && ! AgentsToolsPlacesNameValid "${readKey#*@}" ; } ; then
			echo "⛔ ERROR: $MDSC_CMD $readOp: syntax is $readOp <place>, and the word given is no name of a place -- nothing is shown" >&2
			set +e ; return 1
		fi
		while IFS=$'\t' read -r readName readKind readCeiling readPath readRoot readBy readState ; do
			[ "$readName" = "$readKey" ] || continue
			readFound="true"
			break
		done <<< "$( AgentsToolsManagerPlaceSource )"
		if [ -z "$readFound" ] ; then
			echo "⛔ ERROR: $MDSC_CMD $readOp: no place is named '$readKey' -- nothing is shown. The places are those ${readOp%-read}-list prints" >&2
			set +e ; return 1
		fi
		printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$readName" "$readKind" "$readCeiling" "$readPath" "$readRoot" "$readBy" "$readState" | AgentsToolsManagerPlaceRows "$readKey"

		## What the registry holds of it beyond its row: who declared it, the workspace that
		## declares it, and the file that holds its row, which a built-in place has none of.
		printf 'info\tdeclared-by\t%s\n' "$( AgentsToolsManagerPlaceField "${readBy#-}" )"
		printf 'info\tworkspace\t%s\n' "$( AgentsToolsManagerPlaceField "${readRoot#-}" )"
		if [ "$readBy" = "built-in" ] || [ "$readRoot" = "-" ] ; then
			printf 'info\tregistry\t-\n'
		else
			printf 'info\tregistry\t%s\n' "$( AgentsToolsManagerPlaceField "$( AgentsToolsPlacesLocalFile "$readRoot" )" )"
		fi

		## What stands there that the tooling knows, for a place that is there: nothing is
		## looked for at a path that is not, and of a file nothing is read but its name.
		[ "$readState" = "present" ] || return 0
		##   the consoles at its root, as a workspace has them
		for readFile in "${readPath%/}"/Distro*Console.sh ; do
			[ -f "$readFile" ] || continue
			printf 'stands\tconsole\t%s\t%s\n' "$( AgentsToolsManagerPlaceField "${readFile##*/}" )" "$( AgentsToolsManagerPlaceField "$readFile" )"
		done
		##   the members whose home the machine keeps there (AgentsTools.MemberHomes.include)
		readFile="$( AgentsToolsMemberHomesFile )"
		if [ -r "$readFile" ] ; then
			while IFS=$'\t' read -r readMember readHome readRest ; do
				[ -n "$readMember" ] && [ "${readHome%/}" = "${readPath%/}" ] || continue
				printf 'stands\tmember-home\t%s\t%s\n' "$( AgentsToolsManagerPlaceField "$readMember" )" "$( AgentsToolsManagerPlaceField "${readHome%/}" )"
			done < "$readFile"
		fi
		##   the team data root of this workspace, where it lies in the place
		if [ -n "${MDAT_DATA_ROOT:-}" ] && [ -d "$MDAT_DATA_ROOT" ] ; then
			case "${MDAT_DATA_ROOT%/}/" in
				"${readPath%/}"/*) printf 'stands\tteam-data-root\t-\t%s\n' "$( AgentsToolsManagerPlaceField "${MDAT_DATA_ROOT%/}" )" ;;
			esac
		fi
		return 0
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
