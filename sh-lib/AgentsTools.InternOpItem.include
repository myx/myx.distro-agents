#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.InternOpItem.include -- AgentsToolsItemRead and AgentsToolsItemUpsert, the
## team-data item read/lock and write/commit pair: in-context helpers with no operation of
## their own (MAGIC.md, section 1). Sourced for its functions only:
##   type AgentsToolsItemUpsert > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.InternOpItem.include"
## Their caller holds the context they act in: a member is the caller's own, never switched to.
##

. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.OutputStyle.include"

AgentsToolsItemContextScan(){
	opContext="<no --context given>"
	local ctxWanted="" ctxArg
	for ctxArg in "$@" ; do
		if [ -n "$ctxWanted" ] ; then opContext="$ctxArg" ; ctxWanted="" ; continue ; fi
		[ "$ctxArg" != "--context" ] || ctxWanted="1"
	done
}

AgentsToolsItemResolvePaths(){
	local category="$1" boardState="$2" inboxMember="$3" name="$4"
	itemLookupFolders=()
	case "$category" in
		board)
			itemWriteDir="$MDAT_DATA_ROOT/board/$boardState"
			itemLookupFolders=( "$itemWriteDir" )
			itemLockable="true"
		;;
		vault)
			itemWriteDir="$MDAT_DATA_ROOT/vault"
			itemLookupFolders=( "$itemWriteDir" )
			itemLockable="false"
		;;
		audit)
			local auditYearMonth=""
			case "$name" in
				transcript-[0-9][0-9][0-9][0-9]-[0-9][0-9]-*)
					auditYearMonth="$( printf '%s' "$name" | sed -E 's/^transcript-([0-9]{4})-([0-9]{2})-.*/\1-\2/' )"
				;;
			esac
			[ -z "$auditYearMonth" ] && auditYearMonth="$( date -u +%Y-%m )"
			itemWriteDir="$MDAT_DATA_ROOT/audit/$auditYearMonth"
			itemLookupFolders=( "$itemWriteDir" "$MDAT_DATA_ROOT/audit" )
			itemLockable="false"
		;;
		inbox)
			itemWriteDir="$MDAT_DATA_ROOT/inboxes/$inboxMember"
			itemLookupFolders=( "$itemWriteDir" )
			itemLockable="true"
		;;
	esac
}

AgentsToolsItemStaleCheck(){
	local path="$1"
	itemState="" itemRecheck="" itemSession="" itemHeld="false" itemRecheckEpoch=""
	[ -f "$path" ] || return 0
	itemState="$( LC_ALL=C awk '/^state: /{ print substr($0, 8) ; exit ; }' "$path" )"
	case "$itemState" in
		*-finished|'') itemState="" ; return 0 ;;
	esac
	itemRecheck="$( LC_ALL=C awk '/^recheck-date: /{ print substr($0, 15) ; exit ; }' "$path" )"
	itemSession="$( LC_ALL=C awk '/^session-id: /{ print substr($0, 13) ; exit ; }' "$path" )"
	set +e
	itemRecheckEpoch="$( printf '%s\n' "$itemRecheck" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsIsoToEpoch.awk" 2>/dev/null )"
	set -e
	if [ -n "$itemRecheckEpoch" ] && [ "$(( $( date +%s ) - itemRecheckEpoch ))" -lt 60 ] ; then
		itemHeld="true"
	fi
}

## --unlock-lock's proof that the close is on disk: every upsert header op holds
## its value in the note's frontmatter, every remove op is gone. Silent rc 0
## when all hold; otherwise prints what does not, rc 1. append/default ops are
## not checked (their value is merged, not given).
AgentsToolsItemUnlockVerify(){ ## note path, header ops (op<TAB>name<TAB>value lines)
	[ -f "$1" ] || { printf 'the note is missing: %s' "$1" ; return 1 ; }
	[ -n "$2" ] || return 0
	printf '%s' "$2" | LC_ALL=C awk -F '\t' '
		FNR == 1 { fileNo++ ; }
		fileNo == 1 {
			if (!($2 in act)) { n++ ; order[n] = $2 ; } ;
			if ($1 == "upsert") { act[$2] = "set" ; want[$2] = $3 ; }
			else if ($1 == "remove") { act[$2] = "remove" ; }
			else { act[$2] = "skip" ; } ;
			next ;
		}
		$0 == "---" { d++ ; if (d >= 2) exit ; next ; }
		d == 1 { p = index($0, ": ") ; if (p > 0) { nm = substr($0, 1, p - 1) ; if (!(nm in have)) { have[nm] = substr($0, p + 2) ; } ; } ; next ; }
		END {
			if (d < 2) { printf("the note has no complete frontmatter") ; exit 1 ; } ;
			bad = 0 ;
			for (k = 1 ; k <= n ; k++) {
				nm = order[k] ;
				if (act[nm] == "set" && !(nm in have)) { printf("%s%s: missing, want \"%s\"", (bad ? "; " : ""), nm, want[nm]) ; bad = 1 ; }
				else if (act[nm] == "set" && have[nm] != want[nm]) { printf("%s%s: is \"%s\", want \"%s\"", (bad ? "; " : ""), nm, have[nm], want[nm]) ; bad = 1 ; }
				else if (act[nm] == "remove" && (nm in have)) { printf("%s%s: still present", (bad ? "; " : ""), nm) ; bad = 1 ; } ;
			} ;
			exit bad ;
		}
	' - "$1"
}

## --unlock-lock could not record its close: never RELEASED. `restore` puts the
## note back as this call found it (and drops this call's own commit when
## unlockCommitted), so the lock stays held; `as-is` leaves the note alone,
## when it already is the remote's copy and not this call's write. Reads the
## caller's target, repoRoot, priorExisted, priorContent, unlockCommitted.
## Returns 0 so it is safe under set -e; the caller then returns 1 itself.
AgentsToolsItemUnlockKeep(){ ## restore|as-is, what failed
	if [ "$1" = "restore" ] ; then
		local relPath="${target#"$repoRoot"/}"
		if [ -n "$repoRoot" ] && [ "$unlockCommitted" = "true" ] ; then
			git -C "$repoRoot" reset -q --soft HEAD~1 >/dev/null 2>&1 || :
		fi
		[ -z "$repoRoot" ] || git -C "$repoRoot" reset -q -- "$relPath" >/dev/null 2>&1 || :
		unlockCommitted="false"
		if [ "$priorExisted" = "true" ] ; then
			printf '%s' "$priorContent" > "$target" || :
		fi
	fi
	echo "$MDSC_CMD: item-upsert: ⛔ ERROR: CLOSE_NOT_RECORDED -- $2; the lock is KEPT, NOT released (the note is not marked finished); fix the cause and re-run the close" >&2
	return 0
}

AgentsToolsItemRead(){ ## <team-member> [<selector>|<item-filename>] [--acquire-lock <owner-label> [--commit-message <text>] [--header:...]...] --context <caller-op>
	local MDSC_CMD='DistroAgentsTools'
	local opContext ; AgentsToolsItemContextScan "$@"
	local callingMember="$1" ; shift || true
	if [ -z "$callingMember" ] ; then
		echo "$MDSC_CMD: item-read: ⛔ ERROR: syntax is <team-member> [--from-board <state> <item-filename>|--from-vault <item-filename>|--from-audit <item-filename>|--from-inbox <team-member> <item-filename>|<item-filename>] [--acquire-lock <owner-label> [--commit-message <text>] [--header:...]...] --context <caller-op>" >&2
		set +e ; return 1
	fi
	local category="" boardState="" inboxMember="" itemName=""
	local acquireLock="false" ownerLabel="" headerArgs=() commitMessageOverride=""
	while [ $# -gt 0 ] ; do
		case "$1" in
			--from-board|--from-vault|--from-audit|--from-inbox)
				if [ -n "$category" ] ; then
					echo "$MDSC_CMD: item-read: ⛔ ERROR: only one item-category selector is allowed" >&2
					set +e ; return 1
				fi
				case "$1" in
					--from-board)
						category="board" ; boardState="$2" ; itemName="$3"
						if [ -z "$boardState" ] || [ -z "$itemName" ] ; then
							echo "$MDSC_CMD: item-read: ⛔ ERROR: --from-board: <state> <item-filename> required" >&2
							set +e ; return 1
						fi
						shift 3
					;;
					--from-vault)
						category="vault" ; itemName="$2"
						[ -z "$itemName" ] && { echo "$MDSC_CMD: item-read: ⛔ ERROR: --from-vault: <item-filename> required" >&2 ; set +e ; return 1 ; }
						shift 2
					;;
					--from-audit)
						category="audit" ; itemName="$2"
						[ -z "$itemName" ] && { echo "$MDSC_CMD: item-read: ⛔ ERROR: --from-audit: <item-filename> required" >&2 ; set +e ; return 1 ; }
						shift 2
					;;
					--from-inbox)
						category="inbox" ; inboxMember="$2" ; itemName="$3"
						if [ -z "$inboxMember" ] || [ -z "$itemName" ] ; then
							echo "$MDSC_CMD: item-read: ⛔ ERROR: --from-inbox: <team-member> <item-filename> required" >&2
							set +e ; return 1
						fi
						shift 3
					;;
				esac
			;;
			--acquire-lock)
				acquireLock="true" ; ownerLabel="$2"
				[ -z "$ownerLabel" ] && { echo "$MDSC_CMD: item-read: ⛔ ERROR: --acquire-lock: <owner-label> required" >&2 ; set +e ; return 1 ; }
				shift 2
			;;
			--commit-message)
				commitMessageOverride="$2"
				[ -z "$commitMessageOverride" ] && { echo "$MDSC_CMD: item-read: ⛔ ERROR: --commit-message: value required" >&2 ; set +e ; return 1 ; }
				shift 2
			;;
			--header:*)
				headerArgs+=( "$1" ) ; shift
			;;
			--context)
				shift 2
			;;
			*)
				if [ -z "$category" ] && [ -z "$itemName" ] ; then
					category="inbox" ; inboxMember="magic-coordinator" ; itemName="$1" ; shift
				else
					echo "$MDSC_CMD: item-read: ⛔ ERROR: invalid option: $1" >&2
					set +e ; return 1
				fi
			;;
		esac
	done
	if [ -z "$itemName" ] ; then
		echo "$MDSC_CMD: item-read: ⛔ ERROR: an item-category selector or a bare <item-filename> is required" >&2
		set +e ; return 1
	fi
	if [ "${#headerArgs[@]}" -gt 0 ] && [ "$acquireLock" != "true" ] ; then
		echo "$MDSC_CMD: item-read: ⛔ ERROR: --header:* is only valid together with --acquire-lock" >&2
		set +e ; return 1
	fi
	if [ -n "$commitMessageOverride" ] && [ "$acquireLock" != "true" ] ; then
		echo "$MDSC_CMD: item-read: ⛔ ERROR: --commit-message is only valid together with --acquire-lock" >&2
		set +e ; return 1
	fi
	AgentsToolsAssertBareName "$itemName" "<item-filename>" item-read || { set +e ; return 1 ; }
	[ -n "${MDAT_DATA_ROOT:-}" ] || {
		echo "$MDSC_CMD: item-read: ⛔ ERROR: MDAT_DATA_ROOT is not set" >&2
		set +e ; return 1
	}

	local itemWriteDir itemLookupFolders itemLockable
	AgentsToolsItemResolvePaths "$category" "$boardState" "$inboxMember" "$itemName"

	if [ "$acquireLock" = "true" ] && [ "$itemLockable" != "true" ] ; then
		echo "$MDSC_CMD: item-read: ⛔ ERROR: LOCK_UNSUPPORTED -- --acquire-lock does not apply to the $category item category" >&2
		set +e ; return 1
	fi

	local itemPath="" folder
	for folder in "${itemLookupFolders[@]}" ; do
		if [ -f "$folder/$itemName" ] ; then itemPath="$folder/$itemName" ; break ; fi
	done
	[ -z "$itemPath" ] && itemPath="${itemLookupFolders[0]}/$itemName"

	local itemState itemRecheck itemSession itemHeld itemRecheckEpoch
	AgentsToolsItemStaleCheck "$itemPath"

	if [ "$acquireLock" != "true" ] ; then
		if [ "$itemHeld" = "true" ] ; then
			echo "ACTIVE:owner=$itemSession:state=$itemState:recheck_date=$itemRecheck"
		else
			echo "NO_LOCK"
		fi
		return 0
	fi

	## --acquire-lock path.
	if [ "$itemHeld" = "true" ] ; then
		echo "ACTIVE:owner=$itemSession:state=$itemState:recheck_date=$itemRecheck"
		set +e ; return 1
	fi
	if [ -n "$itemState" ] ; then
		local reclaimAge=""
		[ -n "$itemRecheckEpoch" ] && reclaimAge=$(( $( date +%s ) - itemRecheckEpoch ))
		echo "RECLAIMED_STALE:prev_owner=$itemSession:age=${reclaimAge}s"
	fi

	local upsertSelectorArgs=()
	case "$category" in
		board) upsertSelectorArgs=( --from-board "$boardState" "$itemName" ) ;;
		vault) upsertSelectorArgs=( --from-vault "$itemName" ) ;;
		audit) upsertSelectorArgs=( --from-audit "$itemName" ) ;;
		inbox) upsertSelectorArgs=( --from-inbox "$inboxMember" "$itemName" ) ;;
	esac
	local commitMsgArgs=()
	[ -n "$commitMessageOverride" ] && commitMsgArgs=( --commit-message "$commitMessageOverride" )
	AgentsToolsItemUpsert "$callingMember" "${upsertSelectorArgs[@]}" \
		--header:upsert:session-id:"$ownerLabel" \
		"${headerArgs[@]}" \
		"${commitMsgArgs[@]}" \
		--context "$opContext"
	local acquireRc=$?
	if [ "$acquireRc" -ne 0 ] ; then
		set +e ; return 1
	fi
	echo "ACQUIRED"
	return 0
}

AgentsToolsItemUpsert(){ ## <team-member> [<selector>|<item-filename>] [--header:...]... [--from-file <path>|--upsert-from-stdin|--edit-patch-from-stdin] [--update-lock|--unlock-lock] [--commit-message <text>] [--no-push] --context <caller-op>
	local MDSC_CMD='DistroAgentsTools'
	local opContext ; AgentsToolsItemContextScan "$@"
	local callingMember="$1"
	shift || true
	if [ -z "$callingMember" ] ; then
		echo "$MDSC_CMD: item-upsert: ⛔ ERROR: syntax is <team-member> [--from-board <state> <item-filename>|--from-vault <item-filename>|--from-audit <item-filename>|--from-inbox <team-member> <item-filename>|<item-filename>] [--header:<upsert|append|remove>:name[:value]]... [--from-file <path>|--upsert-from-stdin|--edit-patch-from-stdin] [--update-lock|--unlock-lock] [--commit-message <text>] [--no-push]" >&2
		set +e ; return 1
	fi
	AgentsToolsAssertBareName "$callingMember" "<team-member>" item-upsert || { set +e ; return 1 ; }
	[ -n "${MDAT_DATA_ROOT:-}" ] || {
		echo "$MDSC_CMD: item-upsert: ⛔ ERROR: MDAT_DATA_ROOT is not set" >&2
		set +e ; return 1
	}

	local category="" boardState="" inboxMember="" itemName=""
	local updateLock="false" unlockLock="false"
	local commitMessageOverride="" noPush="false"
	## Header ops accumulate here and are materialised once, immediately before
	## the .awk that reads them by path -- so no early return can leak a file.
	local headerOps=""
	local content contentFromFile="false" bodyMode="" bodyModeCount=0
	local headerOp headerSpec headerRest headerName headerValue
	while [ $# -gt 0 ] ; do
		case "$1" in
			--from-board|--from-vault|--from-audit|--from-inbox)
				if [ -n "$category" ] ; then
					echo "$MDSC_CMD: item-upsert: ⛔ ERROR: only one item-category selector is allowed" >&2
					set +e ; return 1
				fi
				case "$1" in
					--from-board)
						category="board" ; boardState="$2" ; itemName="$3"
						if [ -z "$boardState" ] || [ -z "$itemName" ] ; then
							echo "$MDSC_CMD: item-upsert: ⛔ ERROR: --from-board: <state> <item-filename> required" >&2
							set +e ; return 1
						fi
						shift 3
					;;
					--from-vault)
						category="vault" ; itemName="$2"
						[ -z "$itemName" ] && { echo "$MDSC_CMD: item-upsert: ⛔ ERROR: --from-vault: <item-filename> required" >&2 ; set +e ; return 1 ; }
						shift 2
					;;
					--from-audit)
						category="audit" ; itemName="$2"
						[ -z "$itemName" ] && { echo "$MDSC_CMD: item-upsert: ⛔ ERROR: --from-audit: <item-filename> required" >&2 ; set +e ; return 1 ; }
						shift 2
					;;
					--from-inbox)
						category="inbox" ; inboxMember="$2" ; itemName="$3"
						if [ -z "$inboxMember" ] || [ -z "$itemName" ] ; then
							echo "$MDSC_CMD: item-upsert: ⛔ ERROR: --from-inbox: <team-member> <item-filename> required" >&2
							set +e ; return 1
						fi
						shift 3
					;;
				esac
			;;
			--update-lock)
				updateLock="true" ; shift
			;;
			--unlock-lock)
				unlockLock="true" ; shift
			;;
			--commit-message)
				if [ -z "${2:-}" ] ; then
					echo "$MDSC_CMD: item-upsert: ⛔ ERROR: --commit-message: value required" >&2
					set +e ; return 1
				fi
				commitMessageOverride="$2"
				shift 2
			;;
			--no-push)
				noPush="true" ; shift
			;;
			--header:*)
				headerSpec="${1#--header:}"
				headerOp="${headerSpec%%:*}"
				headerRest="${headerSpec#*:}"
				case "$headerRest" in
					*:*) headerName="${headerRest%%:*}" ; headerValue="${headerRest#*:}" ;;
					*)   headerName="$headerRest" ; headerValue="" ;;
				esac
				if [ -z "$headerName" ] ; then
					echo "$MDSC_CMD: item-upsert: ⛔ ERROR: --header:$headerOp: field name required" >&2
					set +e ; return 1
				fi
				case "$headerOp" in
					upsert|append)
						if [ -z "$headerValue" ] ; then
							echo "$MDSC_CMD: item-upsert: ⛔ ERROR: --header:$headerOp:$headerName requires a value" >&2
							set +e ; return 1
						fi
					;;
					remove)
						;;
					*)
						echo "$MDSC_CMD: item-upsert: ⛔ ERROR: --header: unrecognized operation: $headerOp (upsert/append/remove)" >&2
						set +e ; return 1
					;;
				esac
				headerOps="$headerOps$headerOp"$'\t'"$headerName"$'\t'"$headerValue"$'\n'
				shift
			;;
			--from-file)
				if [ -z "${2:-}" ] || [ ! -f "$2" ] ; then
					echo "$MDSC_CMD: item-upsert: ⛔ ERROR: --from-file: file not found: ${2:-}" >&2
					set +e ; return 1
				fi
				content="$( cat "$2" )"
				contentFromFile="true"
				bodyMode="file"
				bodyModeCount=$(( bodyModeCount + 1 ))
				shift 2
			;;
			--upsert-from-stdin)
				bodyMode="stdin"
				bodyModeCount=$(( bodyModeCount + 1 ))
				shift
			;;
			--edit-patch-from-stdin)
				bodyMode="patch"
				bodyModeCount=$(( bodyModeCount + 1 ))
				shift
			;;
			--context)
				if [ -z "${2:-}" ] ; then
					echo "$MDSC_CMD: item-upsert: ⛔ ERROR: --context: value required" >&2
					set +e ; return 1
				fi
				shift 2
			;;
			*)
				## Legacy bare positional: <item-filename>, no selector.
				if [ -z "$category" ] && [ -z "$itemName" ] ; then
					category="inbox" ; inboxMember="magic-coordinator" ; itemName="$1" ; shift
				else
					echo "$MDSC_CMD: item-upsert: ⛔ ERROR: unrecognized argument: $1" >&2
					set +e ; return 1
				fi
			;;
		esac
	done
	if [ -z "$itemName" ] ; then
		echo "$MDSC_CMD: item-upsert: ⛔ ERROR: an item-category selector or a bare <item-filename> is required" >&2
		set +e ; return 1
	fi
	if [ "$bodyModeCount" -gt 1 ] ; then
		echo "$MDSC_CMD: item-upsert: ⛔ ERROR: --from-file, --upsert-from-stdin and --edit-patch-from-stdin are mutually exclusive" >&2
		set +e ; return 1
	fi
	if [ "$updateLock" = "true" ] && [ "$unlockLock" = "true" ] ; then
		echo "$MDSC_CMD: item-upsert: ⛔ ERROR: --update-lock and --unlock-lock are mutually exclusive" >&2
		set +e ; return 1
	fi
	AgentsToolsAssertBareName "$itemName" "<item-filename>" item-upsert || { set +e ; return 1 ; }

	local itemWriteDir itemLookupFolders itemLockable
	AgentsToolsItemResolvePaths "$category" "$boardState" "$inboxMember" "$itemName"

	if { [ "$updateLock" = "true" ] || [ "$unlockLock" = "true" ] ; } && [ "$itemLockable" != "true" ] ; then
		echo "$MDSC_CMD: item-upsert: ⛔ ERROR: LOCK_UNSUPPORTED -- --update-lock/--unlock-lock do not apply to the $category item category" >&2
		set +e ; return 1
	fi

	mkdir -p "$itemWriteDir" || {
		echo "$MDSC_CMD: item-upsert: ⛔ ERROR: can't create item directory: $itemWriteDir" >&2
		set +e ; return 1
	}
	local target="$itemWriteDir/$itemName"
	local itemStoreRoot="$MDAT_DATA_ROOT/$category"
	[ "$category" = "inbox" ] && itemStoreRoot="$MDAT_DATA_ROOT/inboxes"

	if [ "$updateLock" = "true" ] && [ ! -f "$target" ] ; then
		echo "NO_LOCK_HELD"
		set +e ; return 1
	fi

	## No note: nothing holds a lock, and nothing to record the close into.
	if [ "$unlockLock" = "true" ] && [ ! -f "$target" ] ; then
		echo "$MDSC_CMD: item-upsert: ⛔ ERROR: CLOSE_NOT_RECORDED -- no state note at $target to record the close into; NOT released" >&2
		set +e ; return 1
	fi

	if [ "$bodyMode" = "patch" ] ; then
		local patchJson existingContent
		patchJson="$( cat )"
		if [ -f "$target" ] ; then existingContent="$( cat "$target" )" ; else existingContent="" ; fi
		content="$( printf '%s%s' "$patchJson" "$existingContent" | python3 "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsBoardItemPatchApply.py" )" || { set +e ; return 1 ; }
	elif [ "$bodyMode" = "stdin" ] ; then
		content="$( cat )"
		## Measured, never refused. Only this branch carries the caller's own
		## new text: a patch merges into content somebody else wrote.
		printf '%s' "$content" | AgentsToolsOutputStyleRefusal "$callingMember" "" "${itemPath##*/}" "" none || :
	elif [ "$contentFromFile" = "true" ] ; then
		:
	elif [ -f "$target" ] ; then
		content="$( cat "$target" )"
	else
		content="$( printf '%s\n' \
			'---' \
			'type: note' \
			"from: $callingMember" \
			"date: $( date +"%Y-%m-%d %H:%M %z" )" \
			'owner: magic-coordinator' \
			'---' \
			'' \
			'# State and lock' \
			'' \
			'(no session content recorded yet)' )"
	fi
	if [ -z "$content" ] ; then
		echo "$MDSC_CMD: item-upsert: ⛔ ERROR: empty content -- refusing to write an empty item" >&2
		set +e ; return 1
	fi

	local carriedSessionId=""
	if [ "$itemLockable" = "true" ] && [ -f "$target" ] && { [ "$bodyMode" = "file" ] || [ "$bodyMode" = "stdin" ] ; } ; then
		case $'\n'"$content" in
			*$'\n''session-id: '*) ;;
			*)
				carriedSessionId="$( LC_ALL=C awk '/^session-id: /{ sub(/\r$/, "") ; print substr($0, 13) ; exit ; }' "$target" )"
				[ -z "$carriedSessionId" ] || headerOps="upsert"$'\t'"session-id"$'\t'"$carriedSessionId"$'\n'"$headerOps"
			;;
		esac
	fi

	## The ops file has to be a real path -- it is the awk's own `-v opsFile=`
	## input. It is created inside this substitution's own subshell, so its
	## trap is that subshell's and can never disarm the caller's, and the trap
	## is armed before the file exists, so every exit from the block removes
	## it: a failed mkdir or write, a failed awk, or a signal.
	if [ -n "$headerOps" ] ; then
		content="$(
			headerOpsFile="$MMDAPP/.local/temp/mdat-item-upsert-headers.$$"
			trap 'rm -f "$headerOpsFile"' EXIT
			mkdir -p "$MMDAPP/.local/temp" || exit 1
			printf '%s' "$headerOps" > "$headerOpsFile" || exit 1
			printf '%s\n' "$content" | LC_ALL=C awk -v opsFile="$headerOpsFile" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsBoardItemHeaderOpsApply.awk"
		)" || { set +e ; return 1 ; }
	fi

	## --unlock-lock prints RELEASED only once its own close is proven on disk
	## (AgentsToolsItemUnlockVerify) and landed as far as this configuration
	## goes; every other way out goes through AgentsToolsItemUnlockKeep, rc 1.
	## priorContent is the note as found, for putting the lock back.
	local repoRoot="" originUrl="" unlockVerifyOut=""
	local priorExisted="false" priorContent="" unlockCommitted="false"
	if [ "$unlockLock" = "true" ] && [ -f "$target" ] ; then
		priorExisted="true"
		priorContent="$( cat "$target" ; printf x )" ; priorContent="${priorContent%x}"
	fi

	if ! printf '%s\n' "$content" > "$target" ; then
		if [ "$unlockLock" = "true" ] ; then AgentsToolsItemUnlockKeep restore "could not write $target" ; set +e ; return 1 ; fi
		echo "$MDSC_CMD: item-upsert: ⛔ ERROR: could not write $target" >&2
		set +e ; return 1
	fi
	if [ "$unlockLock" = "true" ] && ! unlockVerifyOut="$( AgentsToolsItemUnlockVerify "$target" "$headerOps" )" ; then
		AgentsToolsItemUnlockKeep restore "the written note does not read back the close: $unlockVerifyOut" ; set +e ; return 1
	fi

	## Two independent conditions, never one: the repository is what makes a
	## commit possible, the remote is what makes a push possible.
	set +e
	originUrl="$( DistroAgentsTools --agents-config-option magic-team --select TEAM_DATA_GIT_REMOTE 2>/dev/null )"
	repoRoot="$( git -C "$MDAT_DATA_ROOT" rev-parse --show-toplevel 2>/dev/null )"
	set -e
	if [ -z "$repoRoot" ] ; then
		## Team-data is not a repository: there is nothing to commit into.
		echo "# $MDSC_CMD: item-upsert: wrote ${target#"$itemStoreRoot"/} ($( printf '%s\n' "$content" | wc -l | tr -d '[:space:]' ) lines)" >&2
		if [ "$unlockLock" = "true" ] ; then echo "RELEASED" ; return 0 ; fi
		if [ "$updateLock" = "true" ] ; then echo "REFRESHED" ; return 0 ; fi
		return 0
	fi

	local isClosing="false"
	case "$( LC_ALL=C awk '/^state: /{ print substr($0, 8) ; exit ; }' "$target" )" in
		*-finished) isClosing="true" ;;
	esac
	[ "$unlockLock" = "true" ] && isClosing="true"

	local gitOut="" gitRc=0
	set +e
	gitOut="$( git -C "$repoRoot" add -- "$target" 2>&1 )"
	gitRc=$?
	set -e
	if [ "$gitRc" -ne 0 ] ; then
		echo "$MDSC_CMD: item-upsert: ⛔ ERROR: git add failed for $target: $gitOut" >&2
		if [ "$unlockLock" = "true" ] ; then AgentsToolsItemUnlockKeep restore "git add failed" ; fi
		set +e ; return 1
	fi

	local commitMessage="$MDSC_CMD: item-upsert: $itemName"
	[ -n "$commitMessageOverride" ] && commitMessage="$commitMessageOverride"
	set +e
	gitOut="$( git -C "$repoRoot" commit --allow-empty -m "$commitMessage" -- "$target" 2>&1 )"
	gitRc=$?
	set -e
	if [ "$gitRc" -ne 0 ] ; then
		echo "$MDSC_CMD: item-upsert: ⛔ ERROR: git commit failed for $target: $gitOut" >&2
		if [ "$unlockLock" = "true" ] ; then AgentsToolsItemUnlockKeep restore "git commit failed" ; fi
		set +e ; return 1
	fi
	unlockCommitted="true"

	## No remote to push to, and no remote copy to read the lock back from:
	## the commit above is the whole of what this configuration can do.
	if [ -z "$originUrl" ] ; then
		echo "# $MDSC_CMD: item-upsert: committed (no remote configured) ${target#"$itemStoreRoot"/}" >&2
		if [ "$unlockLock" = "true" ] ; then echo "RELEASED" ; return 0 ; fi
		if [ "$updateLock" = "true" ] ; then echo "REFRESHED" ; return 0 ; fi
		return 0
	fi

	if [ "$noPush" = "true" ] ; then
		echo "# $MDSC_CMD: item-upsert: committed (no-push) ${target#"$itemStoreRoot"/}" >&2
		if [ "$unlockLock" = "true" ] ; then echo "RELEASED" ; return 0 ; fi
		if [ "$updateLock" = "true" ] ; then echo "REFRESHED" ; return 0 ; fi
		return 0
	fi

	local pushAttempt=1 pushOut="" pushRc=0
	while : ; do
		set +e
		pushOut="$( git -C "$repoRoot" push origin HEAD 2>&1 )"
		pushRc=$?
		set -e
		[ "$pushRc" -eq 0 ] && break
		case "$pushOut" in
			*"Could not resolve host"*|*"could not resolve host"*|*"unable to access"*|*"Could not read from remote repository"*|*"Connection timed out"*|*"Connection refused"*|*"Operation timed out"*|*"Network is unreachable"*|*"connection reset"*)
				if [ "$pushAttempt" -eq 1 ] ; then
					echo "# $MDSC_CMD: item-upsert: push network failure, retrying once in 15s" >&2
					sleep 15
					pushAttempt=2
					continue
				fi
				echo "$MDSC_CMD: item-upsert: ⛔ ERROR: LOCK_UNCHECKABLE -- the remote was unreachable after one 15s retry, so whether this routine holds the lock is UNKNOWN, not lost; the local note is written but this routine must not continue: $pushOut" >&2
				if [ "$unlockLock" = "true" ] ; then AgentsToolsItemUnlockKeep restore "the close could not be pushed (remote unreachable after one retry); this close's own commit is dropped" ; fi
				set +e ; return 1
			;;
		esac
		break
	done

	## Session-id readback below exists only to answer "does this routine
	## still hold the lock", a question that has no meaning for a category
	## declared non-lockable above (audit, vault): there is no owner to
	## lose the lock to, and no caller of --from-audit/--from-vault has
	## ever been expected to carry a --header:upsert:session-id:<id>. A
	## successful push already is this write's whole confirmation.
	if [ "$itemLockable" != "true" ] ; then
		echo "# $MDSC_CMD: item-upsert: committed and pushed ${target#"$itemStoreRoot"/} -- the $category category carries no lock, so no session-id readback applies" >&2
		return 0
	fi

	local localSessionId="" remoteSessionId="" syncOut="" syncRc=0 lockBranch=""
	set +e
	lockBranch="$( git -C "$repoRoot" rev-parse --abbrev-ref HEAD 2>/dev/null )"
	set -e
	localSessionId="$( LC_ALL=C awk '/^session-id: /{ print substr($0, 13) ; exit ; }' "$target" )"
	set +e
	syncOut="$( "$MYXROOT/bin/git/cloneSync.Common" --no-push "$repoRoot" "$originUrl" "$lockBranch" 2>&1 )"
	syncRc=$?
	set -e
	if [ "$syncRc" -ne 0 ] ; then
		local relPath="${target#"$repoRoot"/}"
		set +e
		git -C "$repoRoot" reset --soft HEAD~1 >/dev/null 2>&1
		git -C "$repoRoot" reset -- "$relPath" >/dev/null 2>&1
		if git -C "$repoRoot" cat-file -e "HEAD:$relPath" 2>/dev/null ; then
			git -C "$repoRoot" checkout -- "$relPath" >/dev/null 2>&1
		else
			rm -f "$target"
		fi
		syncOut="$( "$MYXROOT/bin/git/cloneSync.Common" --no-push "$repoRoot" "$originUrl" "$lockBranch" 2>&1 )"
		syncRc=$?
		set -e
		if [ "$syncRc" -ne 0 ] ; then
			echo "$MDSC_CMD: item-upsert: ⛔ ERROR: LOCK_UNCHECKABLE -- the board could not be synced even after discarding this session's own commit, so ownership is UNKNOWN, not lost; this routine must not continue: $syncOut" >&2
			if [ "$unlockLock" = "true" ] ; then AgentsToolsItemUnlockKeep as-is "the board could not be synced, and this close's own commit was discarded" ; fi
			set +e ; return 1
		fi
		## The sync above discarded this call's own commit: what is on disk now
		## is the remote's note, which never carried this close.
		if [ "$unlockLock" = "true" ] ; then
			AgentsToolsItemUnlockKeep as-is "the push was rejected and the board could not be synced over this close's commit, so the commit was discarded: $pushOut"
			set +e ; return 1
		fi
	fi

	## Unlock: the close must be on the remote, not only in this checkout -- a
	## rejected push whose sync then rebased this commit on top is pushed once
	## more; still not pushed, the commit is dropped and the lock kept.
	if [ "$unlockLock" = "true" ] && [ "$pushRc" -ne 0 ] ; then
		set +e
		pushOut="$( git -C "$repoRoot" push origin HEAD 2>&1 )"
		pushRc=$?
		set -e
		if [ "$pushRc" -ne 0 ] ; then
			local relPath="${target#"$repoRoot"/}" headSubject=""
			set +e
			headSubject="$( git -C "$repoRoot" log -1 --format=%s HEAD 2>/dev/null )"
			if [ "$headSubject" = "$commitMessage" ] ; then
				git -C "$repoRoot" reset -q --soft HEAD~1 >/dev/null 2>&1
				git -C "$repoRoot" reset -q -- "$relPath" >/dev/null 2>&1
				git -C "$repoRoot" checkout -- "$relPath" >/dev/null 2>&1
			fi
			set -e
			AgentsToolsItemUnlockKeep as-is "the close could not be pushed: $pushOut"
			set +e ; return 1
		fi
	fi

	remoteSessionId="$( LC_ALL=C awk '/^session-id: /{ print substr($0, 13) ; exit ; }' "$target" 2>/dev/null )"
	if [ "$unlockLock" = "true" ] ; then
		if [ -n "$localSessionId" ] && [ "$remoteSessionId" != "$localSessionId" ] ; then
			AgentsToolsItemUnlockKeep as-is "LOCK_LOST -- the board's note belongs to session-id '$remoteSessionId', not '$localSessionId'"
			set +e ; return 1
		fi
		if ! unlockVerifyOut="$( AgentsToolsItemUnlockVerify "$target" "$headerOps" )" ; then
			AgentsToolsItemUnlockKeep as-is "the board's note does not read back the close after push and sync: $unlockVerifyOut"
			set +e ; return 1
		fi
		[ -n "$localSessionId" ] || echo "$MDSC_CMD: item-upsert: ⚠️ WARNING: no session-id on the note, so ownership was not read back; the close itself is pushed and read back" >&2
		echo "# $MDSC_CMD: item-upsert: wrote, pushed and read back the close of ${target#"$itemStoreRoot"/}" >&2
		echo "RELEASED"
		return 0
	fi
	if [ -z "$localSessionId" ] ; then
		echo "$MDSC_CMD: item-upsert: ⛔ ERROR: LOCK_UNCHECKABLE -- no session-id on the note, so ownership cannot be read back and is UNKNOWN; pass --header:upsert:session-id:<id>; routine must not continue" >&2
		set +e ; return 1
	fi
	if [ "$remoteSessionId" = "$localSessionId" ] ; then
		echo "# $MDSC_CMD: item-upsert: wrote, pushed and read back ${target#"$itemStoreRoot"/} -- lock held by session-id $localSessionId" >&2
		if [ "$updateLock" = "true" ] ; then echo "REFRESHED" ; return 0 ; fi
		return 0
	fi

	if [ "$isClosing" = "true" ] ; then
		echo "$MDSC_CMD: item-upsert: ⚠️ WARNING: closing update did not land -- closing anyway, local note is written: $pushOut" >&2
		return 0
	fi

	echo "$MDSC_CMD: item-upsert: ⛔ ERROR: LOCK_LOST -- the board's item note belongs to session-id '$remoteSessionId', not '$localSessionId'; another holder has the lock; this routine must not continue: $pushOut" >&2
	set +e ; return 1
}

## The retired operation names, still routed by a process that loaded the dispatcher before
## the change, are refused rather than run as a silent no-op. Sourced for the functions: nothing.
case "${1:-}" in
	--intern-op-item-read|--intern-op-item-upsert)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1 -- no longer an operation: in-context code calls AgentsToolsItemRead or AgentsToolsItemUpsert" >&2
		set +e ; return 1
	;;
esac
