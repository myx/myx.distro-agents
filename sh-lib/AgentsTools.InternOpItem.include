#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.InternOpItem.include -- the --intern-op-item-read /
## --intern-op-item-upsert operation pair for DistroAgentsTools.fn.sh's
## dispatcher. Sourced lazily from the `--intern-op-item-*)` wildcard arm via
## the standard $MDLT_ORIGIN-based path. Not standalone: relies on being
## dot-sourced for $1/$@/$MDSC_CMD.
##

AgentsToolsItemContextScan(){
	opContext="<no --context given>"
	local ctxWanted="" ctxArg
	for ctxArg in "$@" ; do
		if [ -n "$ctxWanted" ] ; then opContext="$ctxArg" ; ctxWanted="" ; continue ; fi
		[ "$ctxArg" = "--context" ] && ctxWanted="1"
	done
}

AgentsToolsItemResolvePaths(){
	local category="$1" boardState="$2" inboxMember="$3" name="$4"
	itemLookupFolders=()
	case "$category" in
		board)
			itemWriteDir="$MDAT_DATA_ROOT/board/$boardState"
			itemLookupFolders=( "$itemWriteDir" )
			itemLockable="true"
		;;
		vault)
			itemWriteDir="$MDAT_DATA_ROOT/vault"
			itemLookupFolders=( "$itemWriteDir" )
			itemLockable="false"
		;;
		audit)
			local auditYearMonth=""
			case "$name" in
				transcript-[0-9][0-9][0-9][0-9]-[0-9][0-9]-*)
					auditYearMonth="$( printf '%s' "$name" | sed -E 's/^transcript-([0-9]{4})-([0-9]{2})-.*/\1-\2/' )"
				;;
			esac
			[ -z "$auditYearMonth" ] && auditYearMonth="$( date -u +%Y-%m )"
			itemWriteDir="$MDAT_DATA_ROOT/audit/$auditYearMonth"
			itemLookupFolders=( "$itemWriteDir" "$MDAT_DATA_ROOT/audit" )
			itemLockable="false"
		;;
		inbox)
			itemWriteDir="$MDAT_DATA_ROOT/inboxes/$inboxMember"
			itemLookupFolders=( "$itemWriteDir" )
			itemLockable="true"
		;;
	esac
}

AgentsToolsItemStaleCheck(){
	local path="$1"
	itemState="" itemRecheck="" itemSession="" itemHeld="false" itemRecheckEpoch=""
	[ -f "$path" ] || return 0
	itemState="$( LC_ALL=C awk '/^state: /{ print substr($0, 8) ; exit ; }' "$path" )"
	case "$itemState" in
		*-finished|'') itemState="" ; return 0 ;;
	esac
	itemRecheck="$( LC_ALL=C awk '/^recheck-date: /{ print substr($0, 15) ; exit ; }' "$path" )"
	itemSession="$( LC_ALL=C awk '/^session-id: /{ print substr($0, 13) ; exit ; }' "$path" )"
	set +e
	itemRecheckEpoch="$( printf '%s\n' "$itemRecheck" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsIsoToEpoch.awk" 2>/dev/null )"
	set -e
	if [ -n "$itemRecheckEpoch" ] && [ "$(( $( date +%s ) - itemRecheckEpoch ))" -lt 60 ] ; then
		itemHeld="true"
	fi
}

case "$1" in

	--intern-op-item-read)
		shift
		local opContext ; AgentsToolsItemContextScan "$@"
		local callingMember="$1" ; shift || true
		if [ -z "$callingMember" ] ; then
			echo "$MDSC_CMD: item-read: ⛔ ERROR: syntax is <team-member> [--from-board <state> <item-filename>|--from-vault <item-filename>|--from-audit <item-filename>|--from-inbox <team-member> <item-filename>|<item-filename>] [--acquire-lock <owner-label> [--commit-message <text>] [--header:...]...] --context <caller-op>" >&2
			set +e ; return 1
		fi
		local category="" boardState="" inboxMember="" itemName=""
		local acquireLock="false" ownerLabel="" headerArgs=() commitMessageOverride=""
		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-board|--from-vault|--from-audit|--from-inbox)
					if [ -n "$category" ] ; then
						echo "$MDSC_CMD: item-read: ⛔ ERROR: only one item-category selector is allowed" >&2
						set +e ; return 1
					fi
					case "$1" in
						--from-board)
							category="board" ; boardState="$2" ; itemName="$3"
							if [ -z "$boardState" ] || [ -z "$itemName" ] ; then
								echo "$MDSC_CMD: item-read: ⛔ ERROR: --from-board: <state> <item-filename> required" >&2
								set +e ; return 1
							fi
							shift 3
						;;
						--from-vault)
							category="vault" ; itemName="$2"
							[ -z "$itemName" ] && { echo "$MDSC_CMD: item-read: ⛔ ERROR: --from-vault: <item-filename> required" >&2 ; set +e ; return 1 ; }
							shift 2
						;;
						--from-audit)
							category="audit" ; itemName="$2"
							[ -z "$itemName" ] && { echo "$MDSC_CMD: item-read: ⛔ ERROR: --from-audit: <item-filename> required" >&2 ; set +e ; return 1 ; }
							shift 2
						;;
						--from-inbox)
							category="inbox" ; inboxMember="$2" ; itemName="$3"
							if [ -z "$inboxMember" ] || [ -z "$itemName" ] ; then
								echo "$MDSC_CMD: item-read: ⛔ ERROR: --from-inbox: <team-member> <item-filename> required" >&2
								set +e ; return 1
							fi
							shift 3
						;;
					esac
				;;
				--acquire-lock)
					acquireLock="true" ; ownerLabel="$2"
					[ -z "$ownerLabel" ] && { echo "$MDSC_CMD: item-read: ⛔ ERROR: --acquire-lock: <owner-label> required" >&2 ; set +e ; return 1 ; }
					shift 2
				;;
				--commit-message)
					commitMessageOverride="$2"
					[ -z "$commitMessageOverride" ] && { echo "$MDSC_CMD: item-read: ⛔ ERROR: --commit-message: value required" >&2 ; set +e ; return 1 ; }
					shift 2
				;;
				--header:*)
					headerArgs+=( "$1" ) ; shift
				;;
				--context)
					shift 2
				;;
				*)
					if [ -z "$category" ] && [ -z "$itemName" ] ; then
						category="inbox" ; inboxMember="magic-coordinator" ; itemName="$1" ; shift
					else
						echo "$MDSC_CMD: item-read: ⛔ ERROR: invalid option: $1" >&2
						set +e ; return 1
					fi
				;;
			esac
		done
		if [ -z "$itemName" ] ; then
			echo "$MDSC_CMD: item-read: ⛔ ERROR: an item-category selector or a bare <item-filename> is required" >&2
			set +e ; return 1
		fi
		if [ "${#headerArgs[@]}" -gt 0 ] && [ "$acquireLock" != "true" ] ; then
			echo "$MDSC_CMD: item-read: ⛔ ERROR: --header:* is only valid together with --acquire-lock" >&2
			set +e ; return 1
		fi
		if [ -n "$commitMessageOverride" ] && [ "$acquireLock" != "true" ] ; then
			echo "$MDSC_CMD: item-read: ⛔ ERROR: --commit-message is only valid together with --acquire-lock" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$itemName" "<item-filename>" item-read || { set +e ; return 1 ; }
		[ -n "${MDAT_DATA_ROOT:-}" ] || {
			echo "$MDSC_CMD: item-read: ⛔ ERROR: MDAT_DATA_ROOT is not set" >&2
			set +e ; return 1
		}

		local itemWriteDir itemLookupFolders itemLockable
		AgentsToolsItemResolvePaths "$category" "$boardState" "$inboxMember" "$itemName"

		if [ "$acquireLock" = "true" ] && [ "$itemLockable" != "true" ] ; then
			echo "$MDSC_CMD: item-read: ⛔ ERROR: LOCK_UNSUPPORTED -- --acquire-lock does not apply to the $category item category" >&2
			set +e ; return 1
		fi

		local itemPath="" folder
		for folder in "${itemLookupFolders[@]}" ; do
			if [ -f "$folder/$itemName" ] ; then itemPath="$folder/$itemName" ; break ; fi
		done
		[ -z "$itemPath" ] && itemPath="${itemLookupFolders[0]}/$itemName"

		local itemState itemRecheck itemSession itemHeld itemRecheckEpoch
		AgentsToolsItemStaleCheck "$itemPath"

		if [ "$acquireLock" != "true" ] ; then
			if [ "$itemHeld" = "true" ] ; then
				echo "ACTIVE:owner=$itemSession:state=$itemState:recheck_date=$itemRecheck"
			else
				echo "NO_LOCK"
			fi
			return 0
		fi

		## --acquire-lock path.
		if [ "$itemHeld" = "true" ] ; then
			echo "ACTIVE:owner=$itemSession:state=$itemState:recheck_date=$itemRecheck"
			set +e ; return 1
		fi
		if [ -n "$itemState" ] ; then
			local reclaimAge=""
			[ -n "$itemRecheckEpoch" ] && reclaimAge=$(( $( date +%s ) - itemRecheckEpoch ))
			echo "RECLAIMED_STALE:prev_owner=$itemSession:age=${reclaimAge}s"
		fi

		local upsertSelectorArgs=()
		case "$category" in
			board) upsertSelectorArgs=( --from-board "$boardState" "$itemName" ) ;;
			vault) upsertSelectorArgs=( --from-vault "$itemName" ) ;;
			audit) upsertSelectorArgs=( --from-audit "$itemName" ) ;;
			inbox) upsertSelectorArgs=( --from-inbox "$inboxMember" "$itemName" ) ;;
		esac
		local commitMsgArgs=()
		[ -n "$commitMessageOverride" ] && commitMsgArgs=( --commit-message "$commitMessageOverride" )
		DistroAgentsTools --intern-op-item-upsert "$callingMember" "${upsertSelectorArgs[@]}" \
			--header:upsert:session-id:"$ownerLabel" \
			"${headerArgs[@]}" \
			"${commitMsgArgs[@]}" \
			--context "$opContext"
		local acquireRc=$?
		if [ "$acquireRc" -ne 0 ] ; then
			set +e ; return 1
		fi
		echo "ACQUIRED"
		return 0
	;;

	--intern-op-item-upsert)
		shift
		local opContext ; AgentsToolsItemContextScan "$@"
		local callingMember="$1"
		shift || true
		if [ -z "$callingMember" ] ; then
			echo "$MDSC_CMD: item-upsert: ⛔ ERROR: syntax is <team-member> [--from-board <state> <item-filename>|--from-vault <item-filename>|--from-audit <item-filename>|--from-inbox <team-member> <item-filename>|<item-filename>] [--header:<upsert|append|remove>:name[:value]]... [--from-file <path>|--upsert-from-stdin|--edit-patch-from-stdin] [--update-lock|--unlock-lock] [--commit-message <text>] [--no-push]" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$callingMember" "<team-member>" item-upsert || { set +e ; return 1 ; }
		[ -n "${MDAT_DATA_ROOT:-}" ] || {
			echo "$MDSC_CMD: item-upsert: ⛔ ERROR: MDAT_DATA_ROOT is not set" >&2
			set +e ; return 1
		}

		local category="" boardState="" inboxMember="" itemName=""
		local updateLock="false" unlockLock="false"
		local commitMessageOverride="" noPush="false"
		local headerOpsFile
		headerOpsFile="$MMDAPP/.local/temp/mdat-item-upsert-headers.$$"
		mkdir -p "$MMDAPP/.local/temp" && : > "$headerOpsFile" || { set +e ; return 1 ; }
		local content contentFromFile="false" bodyMode="" bodyModeCount=0
		local headerOp headerSpec headerRest headerName headerValue
		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-board|--from-vault|--from-audit|--from-inbox)
					if [ -n "$category" ] ; then
						echo "$MDSC_CMD: item-upsert: ⛔ ERROR: only one item-category selector is allowed" >&2
						rm -f "$headerOpsFile" ; set +e ; return 1
					fi
					case "$1" in
						--from-board)
							category="board" ; boardState="$2" ; itemName="$3"
							if [ -z "$boardState" ] || [ -z "$itemName" ] ; then
								echo "$MDSC_CMD: item-upsert: ⛔ ERROR: --from-board: <state> <item-filename> required" >&2
								rm -f "$headerOpsFile" ; set +e ; return 1
							fi
							shift 3
						;;
						--from-vault)
							category="vault" ; itemName="$2"
							[ -z "$itemName" ] && { echo "$MDSC_CMD: item-upsert: ⛔ ERROR: --from-vault: <item-filename> required" >&2 ; rm -f "$headerOpsFile" ; set +e ; return 1 ; }
							shift 2
						;;
						--from-audit)
							category="audit" ; itemName="$2"
							[ -z "$itemName" ] && { echo "$MDSC_CMD: item-upsert: ⛔ ERROR: --from-audit: <item-filename> required" >&2 ; rm -f "$headerOpsFile" ; set +e ; return 1 ; }
							shift 2
						;;
						--from-inbox)
							category="inbox" ; inboxMember="$2" ; itemName="$3"
							if [ -z "$inboxMember" ] || [ -z "$itemName" ] ; then
								echo "$MDSC_CMD: item-upsert: ⛔ ERROR: --from-inbox: <team-member> <item-filename> required" >&2
								rm -f "$headerOpsFile" ; set +e ; return 1
							fi
							shift 3
						;;
					esac
				;;
				--update-lock)
					updateLock="true" ; shift
				;;
				--unlock-lock)
					unlockLock="true" ; shift
				;;
				--commit-message)
					if [ -z "${2:-}" ] ; then
						echo "$MDSC_CMD: item-upsert: ⛔ ERROR: --commit-message: value required" >&2
						rm -f "$headerOpsFile" ; set +e ; return 1
					fi
					commitMessageOverride="$2"
					shift 2
				;;
				--no-push)
					noPush="true" ; shift
				;;
				--header:*)
					headerSpec="${1#--header:}"
					headerOp="${headerSpec%%:*}"
					headerRest="${headerSpec#*:}"
					case "$headerRest" in
						*:*) headerName="${headerRest%%:*}" ; headerValue="${headerRest#*:}" ;;
						*)   headerName="$headerRest" ; headerValue="" ;;
					esac
					if [ -z "$headerName" ] ; then
						echo "$MDSC_CMD: item-upsert: ⛔ ERROR: --header:$headerOp: field name required" >&2
						rm -f "$headerOpsFile" ; set +e ; return 1
					fi
					case "$headerOp" in
						upsert|append)
							if [ -z "$headerValue" ] ; then
								echo "$MDSC_CMD: item-upsert: ⛔ ERROR: --header:$headerOp:$headerName requires a value" >&2
								rm -f "$headerOpsFile" ; set +e ; return 1
							fi
						;;
						remove)
							;;
						*)
							echo "$MDSC_CMD: item-upsert: ⛔ ERROR: --header: unrecognized operation: $headerOp (upsert/append/remove)" >&2
							rm -f "$headerOpsFile" ; set +e ; return 1
						;;
					esac
					printf '%s\t%s\t%s\n' "$headerOp" "$headerName" "$headerValue" >> "$headerOpsFile"
					shift
				;;
				--from-file)
					if [ -z "${2:-}" ] || [ ! -f "$2" ] ; then
						echo "$MDSC_CMD: item-upsert: ⛔ ERROR: --from-file: file not found: ${2:-}" >&2
						rm -f "$headerOpsFile" ; set +e ; return 1
					fi
					content="$( cat "$2" )"
					contentFromFile="true"
					bodyMode="file"
					bodyModeCount=$(( bodyModeCount + 1 ))
					shift 2
				;;
				--upsert-from-stdin)
					bodyMode="stdin"
					bodyModeCount=$(( bodyModeCount + 1 ))
					shift
				;;
				--edit-patch-from-stdin)
					bodyMode="patch"
					bodyModeCount=$(( bodyModeCount + 1 ))
					shift
				;;
				--context)
					if [ -z "${2:-}" ] ; then
						echo "$MDSC_CMD: item-upsert: ⛔ ERROR: --context: value required" >&2
						rm -f "$headerOpsFile" ; set +e ; return 1
					fi
					shift 2
				;;
				*)
					## Legacy bare positional: <item-filename>, no selector.
					if [ -z "$category" ] && [ -z "$itemName" ] ; then
						category="inbox" ; inboxMember="magic-coordinator" ; itemName="$1" ; shift
					else
						echo "$MDSC_CMD: item-upsert: ⛔ ERROR: unrecognized argument: $1" >&2
						rm -f "$headerOpsFile" ; set +e ; return 1
					fi
				;;
			esac
		done
		if [ -z "$itemName" ] ; then
			echo "$MDSC_CMD: item-upsert: ⛔ ERROR: an item-category selector or a bare <item-filename> is required" >&2
			rm -f "$headerOpsFile" ; set +e ; return 1
		fi
		if [ "$bodyModeCount" -gt 1 ] ; then
			echo "$MDSC_CMD: item-upsert: ⛔ ERROR: --from-file, --upsert-from-stdin and --edit-patch-from-stdin are mutually exclusive" >&2
			rm -f "$headerOpsFile" ; set +e ; return 1
		fi
		if [ "$updateLock" = "true" ] && [ "$unlockLock" = "true" ] ; then
			echo "$MDSC_CMD: item-upsert: ⛔ ERROR: --update-lock and --unlock-lock are mutually exclusive" >&2
			rm -f "$headerOpsFile" ; set +e ; return 1
		fi
		AgentsToolsAssertBareName "$itemName" "<item-filename>" item-upsert || { rm -f "$headerOpsFile" ; set +e ; return 1 ; }

		local itemWriteDir itemLookupFolders itemLockable
		AgentsToolsItemResolvePaths "$category" "$boardState" "$inboxMember" "$itemName"

		if { [ "$updateLock" = "true" ] || [ "$unlockLock" = "true" ] ; } && [ "$itemLockable" != "true" ] ; then
			echo "$MDSC_CMD: item-upsert: ⛔ ERROR: LOCK_UNSUPPORTED -- --update-lock/--unlock-lock do not apply to the $category item category" >&2
			rm -f "$headerOpsFile" ; set +e ; return 1
		fi

		mkdir -p "$itemWriteDir" || {
			echo "$MDSC_CMD: item-upsert: ⛔ ERROR: can't create item directory: $itemWriteDir" >&2
			rm -f "$headerOpsFile" ; set +e ; return 1
		}
		local target="$itemWriteDir/$itemName"
		local itemStoreRoot="$MDAT_DATA_ROOT/$category"
		[ "$category" = "inbox" ] && itemStoreRoot="$MDAT_DATA_ROOT/inboxes"

		if [ "$updateLock" = "true" ] && [ ! -f "$target" ] ; then
			echo "NO_LOCK_HELD"
			rm -f "$headerOpsFile" ; set +e ; return 1
		fi

		if [ "$unlockLock" = "true" ] && [ ! -f "$target" ] ; then
			rm -f "$headerOpsFile"
			echo "RELEASED"
			return 0
		fi

		if [ "$bodyMode" = "patch" ] ; then
			local patchJson existingContent contentFile patchFile
			patchJson="$( cat )"
			if [ -f "$target" ] ; then existingContent="$( cat "$target" )" ; else existingContent="" ; fi
			contentFile="$MMDAPP/.local/temp/mdat-item-upsert-patch-content.$$"
			mkdir -p "$MMDAPP/.local/temp" && : > "$contentFile" || { rm -f "$headerOpsFile" ; set +e ; return 1 ; }
			patchFile="$MMDAPP/.local/temp/mdat-item-upsert-patch-spec.$$"
			mkdir -p "$MMDAPP/.local/temp" && : > "$patchFile" || { rm -f "$headerOpsFile" "$contentFile" ; set +e ; return 1 ; }
			printf '%s' "$existingContent" > "$contentFile"
			printf '%s' "$patchJson" > "$patchFile"
			content="$( python3 "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsBoardItemPatchApply.py" "$contentFile" "$patchFile" )" || { rm -f "$headerOpsFile" "$contentFile" "$patchFile" ; set +e ; return 1 ; }
			rm -f "$contentFile" "$patchFile"
		elif [ "$bodyMode" = "stdin" ] ; then
			content="$( cat )"
		elif [ "$contentFromFile" = "true" ] ; then
			:
		elif [ -f "$target" ] ; then
			content="$( cat "$target" )"
		else
			content="$( printf '%s\n' \
				'---' \
				'type: note' \
				"from: $callingMember" \
				"date: $( date +"%Y-%m-%d %H:%M %z" )" \
				'owner: magic-coordinator' \
				'---' \
				'' \
				'# State and lock' \
				'' \
				'(no session content recorded yet)' )"
		fi
		if [ -z "$content" ] ; then
			echo "$MDSC_CMD: item-upsert: ⛔ ERROR: empty content -- refusing to write an empty item" >&2
			rm -f "$headerOpsFile" ; set +e ; return 1
		fi

		if [ -s "$headerOpsFile" ] ; then
			content="$( printf '%s\n' "$content" | LC_ALL=C awk -v opsFile="$headerOpsFile" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsBoardItemHeaderOpsApply.awk" )" || { rm -f "$headerOpsFile" ; set +e ; return 1 ; }
		fi
		rm -f "$headerOpsFile"

		printf '%s\n' "$content" > "$target"

		local repoRoot="" originUrl=""
		set +e
		originUrl="$( DistroAgentsTools --agents-config-option magic-team --select TEAM_DATA_GIT_REMOTE 2>/dev/null )"
		if [ -n "$originUrl" ] ; then
			repoRoot="$( git -C "$MDAT_DATA_ROOT" rev-parse --show-toplevel 2>/dev/null )"
		fi
		set -e
		if [ -z "$originUrl" ] || [ -z "$repoRoot" ] ; then
			## No git remote configured for the board: local-only, silently.
			echo "# $MDSC_CMD: item-upsert: wrote ${target#"$itemStoreRoot"/} ($( printf '%s\n' "$content" | wc -l | tr -d '[:space:]' ) lines)" >&2
			if [ "$unlockLock" = "true" ] ; then echo "RELEASED" ; return 0 ; fi
			if [ "$updateLock" = "true" ] ; then echo "REFRESHED" ; return 0 ; fi
			return 0
		fi

		local isClosing="false"
		case "$( LC_ALL=C awk '/^state: /{ print substr($0, 8) ; exit ; }' "$target" )" in
			*-finished) isClosing="true" ;;
		esac
		[ "$unlockLock" = "true" ] && isClosing="true"

		local gitOut="" gitRc=0
		set +e
		gitOut="$( git -C "$repoRoot" add -- "$target" 2>&1 )"
		gitRc=$?
		set -e
		if [ "$gitRc" -ne 0 ] ; then
			echo "$MDSC_CMD: item-upsert: ⛔ ERROR: git add failed for $target: $gitOut" >&2
			if [ "$unlockLock" = "true" ] ; then echo "RELEASED" ; return 0 ; fi
			set +e ; return 1
		fi

		local commitMessage="$MDSC_CMD: item-upsert: $itemName"
		[ -n "$commitMessageOverride" ] && commitMessage="$commitMessageOverride"
		set +e
		gitOut="$( git -C "$repoRoot" commit --allow-empty -m "$commitMessage" -- "$target" 2>&1 )"
		gitRc=$?
		set -e
		if [ "$gitRc" -ne 0 ] ; then
			echo "$MDSC_CMD: item-upsert: ⛔ ERROR: git commit failed for $target: $gitOut" >&2
			if [ "$unlockLock" = "true" ] ; then echo "RELEASED" ; return 0 ; fi
			set +e ; return 1
		fi

		if [ "$noPush" = "true" ] ; then
			echo "# $MDSC_CMD: item-upsert: committed (no-push) ${target#"$itemStoreRoot"/}" >&2
			if [ "$unlockLock" = "true" ] ; then echo "RELEASED" ; return 0 ; fi
			if [ "$updateLock" = "true" ] ; then echo "REFRESHED" ; return 0 ; fi
			return 0
		fi

		local pushAttempt=1 pushOut="" pushRc=0
		while : ; do
			set +e
			pushOut="$( git -C "$repoRoot" push origin HEAD 2>&1 )"
			pushRc=$?
			set -e
			[ "$pushRc" -eq 0 ] && break
			case "$pushOut" in
				*"Could not resolve host"*|*"could not resolve host"*|*"unable to access"*|*"Could not read from remote repository"*|*"Connection timed out"*|*"Connection refused"*|*"Operation timed out"*|*"Network is unreachable"*|*"connection reset"*)
					if [ "$pushAttempt" -eq 1 ] ; then
						echo "# $MDSC_CMD: item-upsert: push network failure, retrying once in 15s" >&2
						sleep 15
						pushAttempt=2
						continue
					fi
					echo "$MDSC_CMD: item-upsert: ⛔ ERROR: LOCK_UNCHECKABLE -- the remote was unreachable after one 15s retry, so whether this routine holds the lock is UNKNOWN, not lost; the local note is written but this routine must not continue: $pushOut" >&2
					if [ "$unlockLock" = "true" ] ; then echo "RELEASED" ; return 0 ; fi
					set +e ; return 1
				;;
			esac
			break
		done

		local localSessionId="" remoteSessionId="" syncOut="" syncRc=0 lockBranch=""
		set +e
		lockBranch="$( git -C "$repoRoot" rev-parse --abbrev-ref HEAD 2>/dev/null )"
		set -e
		localSessionId="$( LC_ALL=C awk '/^session-id: /{ print substr($0, 13) ; exit ; }' "$target" )"
		set +e
		syncOut="$( "$MYXROOT/bin/git/cloneSync.Common" --no-push "$repoRoot" "$originUrl" "$lockBranch" 2>&1 )"
		syncRc=$?
		set -e
		if [ "$syncRc" -ne 0 ] ; then
			local relPath="${target#"$repoRoot"/}"
			set +e
			git -C "$repoRoot" reset --soft HEAD~1 >/dev/null 2>&1
			git -C "$repoRoot" reset -- "$relPath" >/dev/null 2>&1
			if git -C "$repoRoot" cat-file -e "HEAD:$relPath" 2>/dev/null ; then
				git -C "$repoRoot" checkout -- "$relPath" >/dev/null 2>&1
			else
				rm -f "$target"
			fi
			syncOut="$( "$MYXROOT/bin/git/cloneSync.Common" --no-push "$repoRoot" "$originUrl" "$lockBranch" 2>&1 )"
			syncRc=$?
			set -e
			if [ "$syncRc" -ne 0 ] ; then
				echo "$MDSC_CMD: item-upsert: ⛔ ERROR: LOCK_UNCHECKABLE -- the board could not be synced even after discarding this session's own commit, so ownership is UNKNOWN, not lost; this routine must not continue: $syncOut" >&2
				if [ "$unlockLock" = "true" ] ; then echo "RELEASED" ; return 0 ; fi
				set +e ; return 1
			fi
		fi

		remoteSessionId="$( LC_ALL=C awk '/^session-id: /{ print substr($0, 13) ; exit ; }' "$target" 2>/dev/null )"
		if [ -z "$localSessionId" ] ; then
			echo "$MDSC_CMD: item-upsert: ⛔ ERROR: LOCK_UNCHECKABLE -- no session-id on the note, so ownership cannot be read back and is UNKNOWN; pass --header:upsert:session-id:<id>; routine must not continue" >&2
			if [ "$unlockLock" = "true" ] ; then echo "RELEASED" ; return 0 ; fi
			set +e ; return 1
		fi
		if [ "$remoteSessionId" = "$localSessionId" ] ; then
			echo "# $MDSC_CMD: item-upsert: wrote, pushed and read back ${target#"$itemStoreRoot"/} -- lock held by session-id $localSessionId" >&2
			if [ "$unlockLock" = "true" ] ; then echo "RELEASED" ; return 0 ; fi
			if [ "$updateLock" = "true" ] ; then echo "REFRESHED" ; return 0 ; fi
			return 0
		fi

		if [ "$isClosing" = "true" ] ; then
			echo "$MDSC_CMD: item-upsert: ⚠️ WARNING: closing update did not land -- closing anyway, local note is written: $pushOut" >&2
			if [ "$unlockLock" = "true" ] ; then echo "RELEASED" ; return 0 ; fi
			return 0
		fi

		echo "$MDSC_CMD: item-upsert: ⛔ ERROR: LOCK_LOST -- the board's item note belongs to session-id '$remoteSessionId', not '$localSessionId'; another holder has the lock; this routine must not continue: $pushOut" >&2
		set +e ; return 1
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
