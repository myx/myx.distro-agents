#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

case "$1" in

	--client-comms-jira-board-list)
		shift
		local actingMember="${1:-}"
		shift || { printf '%s\n' "⛔ ERROR: $MDSC_CMD --client-comms-jira-board-list: <team-member> missing" >&2 ; set +e ; return 1 ; }
		[ -n "$actingMember" ] || { printf '%s\n' "⛔ ERROR: $MDSC_CMD --client-comms-jira-board-list: <team-member> missing" >&2 ; set +e ; return 1 ; }
		case "$#:${1:-}" in
			0:|2:--start-at) ;;
			*) printf '%s\n' "⛔ ERROR: $MDSC_CMD --client-comms-jira-board-list: not accepted: $actingMember $*" >&2 ; set +e ; return 1 ;;
		esac
		AgentsToolsAssertBareName "$actingMember" "<team-member>" client-comms-jira-board-list || { set +e ; return 1 ; }
		case "$actingMember" in
			client-*) ;;
			*)
				printf '%s\n' "⛔ ERROR: $MDSC_CMD --client-comms-jira-board-list: runs only as a client-* member, and $actingMember is not one -- this family reads an external organisation's own Jira under that member's own credential" >&2
				set +e ; return 1
			;;
		esac
		local opRc=0
		DistroAgentsTools --intern-op-atlassian-jira-board-list --member "$actingMember" --context client-comms-jira-board-list "$@" || opRc=$?
		if [ "$opRc" -ne 0 ] ; then set +e ; return "$opRc" ; fi
		return 0
	;;

