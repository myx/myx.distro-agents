				set +e ; return 1
			;;
		esac
		local stubArg stubTakesValue=""
		for stubArg in "$@" ; do
			if [ -n "$stubTakesValue" ] ; then
				stubTakesValue=""
				continue
			fi
			case "$stubArg" in
