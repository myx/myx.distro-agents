#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.MagicHeartbeat.include -- routine-heartbeat's own
## --magic-heartbeat-* operation group for DistroAgentsTools.fn.sh's
## dispatcher. Sourced lazily from the `--magic-heartbeat-*)` wildcard arm
## via the standard $MDLT_ORIGIN-based path. Not standalone: relies on being
## dot-sourced for $1/$@/$MDSC_CMD.
##

case "$1" in

	--magic-heartbeat-input-scan)
		shift
		## <team-member> captured for future logging/validation, unused today
		local callingMember="$1"
		shift || true
		if [ -z "$callingMember" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-input-scan: syntax is <team-member>" >&2
			set +e ; return 1
		fi
		if [ $# -gt 0 ] ; then
			case "$1" in
				--*)
					echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-input-scan: invalid option: $1 -- syntax is <team-member>, no other arguments -- an input-scan reads all baseline-relevant items itself. SEE $MDAT_SKILLSET_ROOT/magic-coordinator/magic-coordinator.heartbeat.routine.md" >&2
					set +e ; return 1
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-input-scan: syntax is <team-member>, no other arguments -- an input-scan reads all baseline-relevant items itself, an item name is not a parameter. SEE $MDAT_SKILLSET_ROOT/magic-coordinator/magic-coordinator.heartbeat.routine.md" >&2
					set +e ; return 1
				;;
			esac
		fi
		[ -n "${MDAT_DATA_ROOT:-}" ] || {
			echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-input-scan: MDAT_DATA_ROOT is not set" >&2
			set +e ; return 1
		}
		## THIS IS THE LOCK NOTE, NOT THE `heartbeat-state-note`.
		printf '%s\n\n' "## state-and-lock (routine-heartbeat)"
		local lockNote="$MDAT_DATA_ROOT/inboxes/magic-coordinator/note-20260809T155000Z-heartbeat-state-and-lock.md"
		if [ -f "$lockNote" ] ; then cat "$lockNote" ; else echo "(no state-and-lock note recorded yet)" ; fi
		printf '\n%s\n\n' "## board digest"
		DistroAgentsTools --intern-op-session-context-scan "$callingMember" \
			--all-types \
			--header status \
			--do-inbox-reflections \
			--context --magic-heartbeat-input-scan
		return $?
	;;

	--magic-heartbeat-spawn-proxy)
		shift
		local callingMember="$1"
		shift || true
		if [ -z "$callingMember" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-spawn-proxy: syntax is <team-member> [--from-board <board-item-name> [--board-state <state>]...] [--from-vault <audit-item-name>] [--from-audit <vault-item-name>] [--wait]" >&2
			set +e ; return 1
		fi
		case "$callingMember" in
			magic-coordinator|routine-heartbeat)
				;;
			*)
				echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-spawn-proxy: unsupported caller: $callingMember (allowed: magic-coordinator | routine-heartbeat)" >&2
				set +e ; return 1
			;;
		esac
		## Craft the dispatch-doc mode this relay needs -- not an agent-facing flag.
		## Main-loop's stdin/--from-file relay wants NO dispatch document (this was
		## the board-running dispatch-*-spawn-proxy pile-up); advance's --from-board/
		## --from-vault/--from-audit relay reuses the named board item as its own
		## tracking document.
		local spawnDispatchDoc="none" spawnProxyArg
		for spawnProxyArg in "$@" ; do
			case "$spawnProxyArg" in
				--from-board|--from-vault|--from-audit) spawnDispatchDoc="reuse" ; break ;;
			esac
		done
		DistroAgentsTools --intern-op-agent-spawn-proxy "$callingMember" "$@" --dispatch-doc:"$spawnDispatchDoc" --context --magic-heartbeat-spawn-proxy
		return $?
	;;

	--magic-heartbeat-config-check)
		shift
		if [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-config-check: takes no arguments" >&2
			set +e ; return 1
		fi
		DistroAgentsTools --intern-op-check-configs magic-coordinator \
			--required "TEAM_DATA_DIRECTORY:<path>" \
			--required "SLACK_CHANNEL_MAGIC_TEAM:<channel-id>" \
			--required "SLACK_CHANNEL_HUMAN_OWNER:<user-id>" \
			--optional "SLACK_CHANNEL_EVENT_TRACK:<channel-id>" \
			--optional "SLACK_CHANNEL_EVENT_ALERT:<channel-id>" \
			--optional "EMAIL_IMAP_HOST:<host>" \
			--optional "EMAIL_USER:<email-address>" \
			--optional "EMAIL_APP_PASSWORD:<app-password>" \
			--optional "TRELLO_KEY:<key>" \
			--optional "TRELLO_TOKEN:<token>" \
			--expect-id-kind SLACK_CHANNEL_EVENT_TRACK:channel \
			--expect-id-kind SLACK_CHANNEL_EVENT_ALERT:channel \
			--expect-id-kind SLACK_CHANNEL_MAGIC_TEAM:channel \
			--expect-id-kind SLACK_CHANNEL_HUMAN_OWNER:user \
			--expect-path-exists "TEAM_DATA_DIRECTORY:${MDAT_DATA_ROOT:-}" \
			--expect-secret EMAIL_APP_PASSWORD \
			--expect-secret TRELLO_KEY \
			--expect-secret TRELLO_TOKEN \
			--context --magic-heartbeat-config-check
		local configRc=$?
		DistroAgentsTools --intern-op-check-configs magic-team \
			--optional "SLACK_BOT_TOKEN:<token>" \
			--optional "TEAM_DATA_GIT_REMOTE:<git-remote-url>" \
			--expect-secret SLACK_BOT_TOKEN \
			--resolve-slack-workspace-into SLACK_WORKSPACE_DOMAIN \
			--context --magic-heartbeat-config-check || true
		DistroAgentsTools --intern-op-slack-check-scopes magic-coordinator \
			--scope-source --member-comms-slack-send-message \
			--scope-source --intern-op-slack-check \
			--scope-source --member-comms-slack-read \
			--scope-source --member-comms-slack-react \
			--scope-source --magic-comms-slack-resolve-ids \
			--context --magic-heartbeat-config-check || true
		return "$configRc"
		return $?
	;;

	## Explicit board-item->trash relocation for this routine's own GC step.
	--magic-heartbeat-board-item-trash)
		shift
		local callingMember="$1"
		shift || true
		local boardState="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$callingMember" ] || [ -z "$boardState" ] || [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-board-item-trash: syntax is <team-member> <board-state> <item-name>" >&2
			set +e ; return 1
		fi
		if [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-board-item-trash: invalid option: $1" >&2
			set +e ; return 1
		fi
		DistroAgentsTools --intern-op-board-trash "$callingMember" "$boardState" "$itemName" --context --magic-heartbeat-board-item-trash
		return $?
	;;


	--magic-heartbeat-lock-acquire)
		shift
		local callingMember="$1" ; shift || true
		local ownerLabel="$1" ; shift || true
		if [ -z "$callingMember" ] || [ -z "$ownerLabel" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-lock-acquire: <team-member> <owner-label> required" >&2
			set +e ; return 1
		fi
		if [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-lock-acquire: invalid option: $1" >&2
			set +e ; return 1
		fi
		local nowEpoch targetEpoch recheckDay recheckRem recheckDate
		nowEpoch="$( date +%s )" ; targetEpoch=$(( nowEpoch + 15 * 60 ))
		recheckDay="$( printf '%s\n' "$targetEpoch" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsEpochToIsoDate.awk" )"
		recheckRem=$(( targetEpoch % 86400 ))
		recheckDate="$( printf '%s %02d:%02d +0000' "$recheckDay" "$(( recheckRem / 3600 ))" "$(( recheckRem % 3600 / 60 ))" )"
		DistroAgentsTools --intern-op-item-read "$callingMember" \
			note-20260809T155000Z-heartbeat-state-and-lock.md \
			--acquire-lock "$ownerLabel" \
			--header:upsert:state:heartbeat-running \
			--header:upsert:recheck-date:"$recheckDate" \
			--context --magic-heartbeat-lock-acquire
		return $?
	;;

	--magic-heartbeat-lock-refresh)
		shift
		local callingMember="$1" ; shift || true
		if [ -z "$callingMember" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-lock-refresh: <team-member> required" >&2
			set +e ; return 1
		fi
		if [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-lock-refresh: invalid option: $1" >&2
			set +e ; return 1
		fi
		local nowEpoch targetEpoch recheckDay recheckRem recheckDate
		nowEpoch="$( date +%s )" ; targetEpoch=$(( nowEpoch + 15 * 60 ))
		recheckDay="$( printf '%s\n' "$targetEpoch" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsEpochToIsoDate.awk" )"
		recheckRem=$(( targetEpoch % 86400 ))
		recheckDate="$( printf '%s %02d:%02d +0000' "$recheckDay" "$(( recheckRem / 3600 ))" "$(( recheckRem % 3600 / 60 ))" )"
		DistroAgentsTools --intern-op-item-upsert "$callingMember" \
			note-20260809T155000Z-heartbeat-state-and-lock.md \
			--update-lock \
			--header:upsert:state:heartbeat-running \
			--header:upsert:recheck-date:"$recheckDate" \
			--context --magic-heartbeat-lock-refresh
		return $?
	;;

	--magic-heartbeat-close-state-and-unlock)
		shift
		local callingMember="$1" ; shift || true
		if [ -z "$callingMember" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-close-state-and-unlock: <team-member> required" >&2
			set +e ; return 1
		fi
		if [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-close-state-and-unlock: invalid option: $1" >&2
			set +e ; return 1
		fi
		DistroAgentsTools --intern-op-item-upsert "$callingMember" \
			note-20260809T155000Z-heartbeat-state-and-lock.md \
			--unlock-lock \
			--header:upsert:state:heartbeat-finished \
			--commit-message "* main-loop, heartbeat, $( date -u +%Y-%m-%dT%H:%M:%SZ )" \
			--context --magic-heartbeat-close-state-and-unlock
		return $?
	;;

	--magic-heartbeat-lock-status)
		shift
		local callingMember="$1" ; shift || true
		if [ -z "$callingMember" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-lock-status: <team-member> required" >&2
			set +e ; return 1
		fi
		if [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-lock-status: invalid option: $1" >&2
			set +e ; return 1
		fi
		DistroAgentsTools --intern-op-item-read "$callingMember" \
			note-20260809T155000Z-heartbeat-state-and-lock.md \
			--context --magic-heartbeat-lock-status
		return $?
	;;


	--magic-heartbeat-state-upsert)
		shift
		local callingMember="$1"
		shift || true
		if [ -z "$callingMember" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-state-upsert: syntax is <team-member> -- content via stdin, --from-file <path>, or --edit-patch-from-stdin" >&2
			set +e ; return 1
		fi
		## This document is always magic-coordinator's own -- the target path
		## below is a fixed literal, never derived from $callingMember. A
		## caller passing any other name would otherwise silently write into
		## magic-coordinator's own state note under a different member's
		## belief that it wrote its own; fail loud instead of ignoring the
		## argument silently.
		if [ "$callingMember" != "magic-coordinator" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-state-upsert: <team-member> must be magic-coordinator -- this document has no other owner (got: $callingMember)" >&2
			set +e ; return 1
		fi
		[ -n "${MDAT_DATA_ROOT:-}" ] || {
			echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-state-upsert: MDAT_DATA_ROOT is not set" >&2
			set +e ; return 1
		}
		local stateDir="$MDAT_DATA_ROOT/inboxes/magic-coordinator"
		mkdir -p "$stateDir" || {
			echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-state-upsert: can't create inbox directory: $stateDir" >&2
			set +e ; return 1
		}
		## Same document --magic-heartbeat-lock-acquire/-refresh/-close-unlock
		## write, not a separate file -- state and lock used to be two
		## documents, and the state one never carried a session-id, so
		## nothing here could ever detect a stolen/expired lock. Merged
		## 2026-09-09; see MAGIC.md.
		local target="$stateDir/note-20260809T155000Z-heartbeat-state-and-lock.md"
		if [ ! -f "$target" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-state-upsert: $target does not exist -- acquire the lock first (--magic-heartbeat-lock-acquire)" >&2
			set +e ; return 1
		fi
		local content contentFromFile="false" bodyMode="" bodyModeCount=0
		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-file)
					if [ -z "$2" ] || [ ! -f "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-state-upsert: --from-file: file not found: $2" >&2
						set +e ; return 1
					fi
					content="$( cat "$2" )"
					contentFromFile="true"
					bodyMode="file"
					bodyModeCount=$(( bodyModeCount + 1 ))
					shift 2
				;;
				--edit-patch-from-stdin)
					bodyMode="patch"
					bodyModeCount=$(( bodyModeCount + 1 ))
					shift
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-state-upsert: unrecognized argument: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ "$bodyModeCount" -gt 1 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-state-upsert: --from-file and --edit-patch-from-stdin are mutually exclusive" >&2
			set +e ; return 1
		fi
		if [ "$bodyMode" = "patch" ] ; then
			local patchJson existingContent
			patchJson="$( cat )"
			if [ -f "$target" ] ; then existingContent="$( cat "$target" )" ; else existingContent="" ; fi
			content="$( printf '%s%s' "$patchJson" "$existingContent" | python3 "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsBoardItemPatchApply.py" )" || { set +e ; return 1 ; }
		else
			[ "$contentFromFile" = "true" ] || content="$( cat )"
		fi
		## An empty write erases the day-rhythm state, which then reads back
		## as "first next-iteration today" -- re-running a day's grooming.
		if [ -z "$content" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-state-upsert: empty content -- refusing to erase the stored heartbeat state" >&2
			set +e ; return 1
		fi
		## Normalize CRLF before any frontmatter/body split below -- a caller
		## supplying Windows line endings otherwise defeats every literal
		## "---" match ($0=="---" never matches "---\r"), and both extraction
		## passes below then silently produce nothing rather than erroring,
		## which would wipe the document on write with no error at all
		## (measured; see MAGIC.md). $target itself is never touched here --
		## it is always written by this same tooling and is always LF.
		content="$( printf '%s\n' "$content" | LC_ALL=C awk '{ sub(/\r$/, "") ; print }' )"
		## Preserve the lock-owned frontmatter fields (type/from/date/owner/
		## state/recheck-date/session-id) exactly as they currently stand --
		## never hand-named, so a lock-side field added later survives too.
		## $content carries its own state-only frontmatter (last-iteration-
		## date etc.) plus body; splice the two frontmatter blocks together
		## and keep $content's own body verbatim. A body-input mode replaces
		## the WHOLE document (see reflection-20260908T1023Z), which is
		## exactly why the lock fields have to be re-spliced in here rather
		## than trusted to survive on their own.
		## Filtered to an explicit allowlist, not "every field currently on
		## the document" -- the document also carries state fields from the
		## LAST state-upsert call (last-iteration-date, today-stage, etc.),
		## and those must be REPLACED by this call's own callerFields, never
		## unioned alongside them. A duplicate key also breaks every reader
		## here that takes the first match and stops (see session-id's own
		## awk above), so the stale copy would silently win forever.
		local lockFields callerFields callerBody
		lockFields="$( LC_ALL=C awk '
			NR==1 { if ($0=="---") { inFM=1 } ; next }
			inFM {
				if ($0=="---") exit
				if ($0 ~ /^(type|from|date|owner|state|recheck-date|session-id): /) print
			}
		' "$target" )"
		if [ -z "$lockFields" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-state-upsert: $target has no readable frontmatter -- refusing to overwrite a document in an unexpected shape" >&2
			set +e ; return 1
		fi
		## Excludes the same lock-owned allowlist $lockFields already carries,
		## not just "print everything" -- --edit-patch-from-stdin's own body
		## source reconstructs $content from $target's OWN existing content
		## (AgentsBoardItemPatchApply.py patches and returns the whole
		## document, frontmatter included), so $content's frontmatter would
		## otherwise still carry the lock fields verbatim and duplicate every
		## one of them alongside $lockFields below (measured). No live caller
		## uses --edit-patch-from-stdin on this op today, but the op accepts
		## it, so this excludes rather than trusts the caller never to.
		callerFields="$( printf '%s\n' "$content" | LC_ALL=C awk '
			NR==1 { if ($0=="---") { inFM=1 } ; next }
			inFM {
				if ($0=="---") exit
				if ($0 !~ /^(type|from|date|owner|state|recheck-date|session-id): /) print
			}
		' )"
		## A caller supplying no frontmatter at all (just body) is a valid
		## input -- callerFields alone empty is fine. This is NOT the same
		## check as the "both empty" guard below.
		callerBody="$( printf '%s\n' "$content" | LC_ALL=C awk '
			NR==1 { if ($0=="---") { hasFm=1 } }
			hasFm {
				if ($0=="---") { delims++ ; next }
				if (delims >= 2) print
				next
			}
			{ print }
		' )"
		## Strip callerBody's own leading blank line(s) before splicing --
		## $mergedContent below always adds exactly one separating blank line
		## of its own. Without this strip, feeding a full previously-read
		## record back in (state-read piped straight into state-upsert,
		## documented as this op's own normal write-back shape) carries that
		## record's OWN already-separated body, whose leading blank line(s)
		## then stack with the template's, growing by one blank line every
		## round-trip (measured live: 2 blank lines after one such cycle,
		## 3 after two). Normalizing to zero leading blanks here, then always
		## adding exactly one, makes the separator idempotent regardless of
		## how many blank lines the input happened to carry.
		callerBody="$( printf '%s\n' "$callerBody" | LC_ALL=C awk '
			BEGIN { started = 0 }
			{ if (!started && $0 == "") next ; started = 1 ; print }
		' )"
		## Defense in depth: whatever the cause (a future edge case, not only
		## the two fixed above), extraction producing nothing at all from a
		## non-empty $content must never fall through to a silent lock-only
		## write -- fail loud instead, same as the empty-content guard above.
		if [ -z "$callerFields" ] && [ -z "$callerBody" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-state-upsert: content parsed to empty fields and empty body -- refusing to overwrite the stored heartbeat state with a lock-only document" >&2
			set +e ; return 1
		fi
		local mergedContent
		mergedContent="$( printf -- '---\n%s\n%s\n---\n\n%s' "$lockFields" "$callerFields" "$callerBody" )"
		## Delegates to the same git-backed, session-id-checked primitive the
		## lock note already uses -- the target now genuinely carries a
		## session-id (it is the same document), so the stale/stolen-lock
		## check this primitive already does applies to this write too,
		## which it never could when this was a separate, lock-blind file.
		printf '%s\n' "$mergedContent" | DistroAgentsTools --intern-op-item-upsert magic-coordinator \
			note-20260809T155000Z-heartbeat-state-and-lock.md \
			--upsert-from-stdin \
			--commit-message "* main-loop, heartbeat-state, $( date -u +%Y-%m-%dT%H:%M:%SZ )" \
			--context --magic-heartbeat-state-upsert
		return $?
	;;

	## Read-only. Prints the record on stdout, or NO_STATE when nothing is
	## stored yet.
	--magic-heartbeat-state-read)
		shift
		local callingMember="$1"
		shift || true
		if [ -z "$callingMember" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-state-read: <team-member> required" >&2
			set +e ; return 1
		fi
		if [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-state-read: takes no arguments" >&2
			set +e ; return 1
		fi
		## This document is always magic-coordinator's own -- the target path
		## below is a fixed literal, never derived from $callingMember. A
		## caller passing any other name would otherwise silently read
		## magic-coordinator's own state note under a different member's
		## belief that it read its own; fail loud instead of ignoring the
		## argument silently.
		if [ "$callingMember" != "magic-coordinator" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-state-read: <team-member> must be magic-coordinator -- this document has no other owner (got: $callingMember)" >&2
			set +e ; return 1
		fi
		[ -n "${MDAT_DATA_ROOT:-}" ] || {
			echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-state-read: MDAT_DATA_ROOT is not set" >&2
			set +e ; return 1
		}
		## Same document --magic-heartbeat-lock-acquire/-refresh/-close-unlock
		## and --magic-heartbeat-state-upsert all write -- must match exactly.
		local target="$MDAT_DATA_ROOT/inboxes/magic-coordinator/note-20260809T155000Z-heartbeat-state-and-lock.md"
		if [ -f "$target" ] ; then
			cat "$target"
		else
			echo "NO_STATE"
		fi
		return 0
	;;

	## Fixed 19-loop countdown-then-continue signal. No options.
	--magic-heartbeat-sleep-run)
		shift
		if [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-sleep-run: takes no arguments" >&2
			set +e ; return 1
		fi
		local remaining=59
		while [ "$remaining" -gt 0 ] ; do
			echo "$remaining"
			sleep 1
			remaining=$(( remaining - 1 ))
		done
		printf 'All Done.\nPLEASE CONTINUE!\n'
		return 0
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
