#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.MagicHeartbeat.include -- routine-heartbeat's own
## --magic-heartbeat-* operation group for DistroAgentsTools.fn.sh's
## dispatcher. Sourced lazily from the `--magic-heartbeat-*)` wildcard arm
## via the standard $MDLT_ORIGIN-based path. Not standalone: relies on being
## dot-sourced for $1/$@/$MDSC_CMD. Name deliberately does NOT echo the
## owning routine's own name (routine-heartbeat) -- confirmed
## intentional, not a defect.
##
## Three op families share this one file/namespace: --magic-heartbeat-input-
## scan (board-scan, documented right below), --magic-heartbeat-lock-*
## (the single-instance lock, documented near its own case arms further
## down), and --magic-heartbeat-state-* (the day-rhythm state record,
## documented near its own case arms at the end). Op names carry a "-lock-"
## / "-state-" infix precisely so --magic-heartbeat-* stays available as the
## bare namespace for un-infixed ops too. This is the
## only namespace these lock ops exist under -- no --main-loop-lock-*
## compatibility names remain (AgentsTools.MainLoop.include is gone).
##
## State-list/header-list, investigated directly against
## routine-heartbeat.routine.md's own real text (its full "One
## process-flow iteration" step list, read end to end) rather than guessed:
## unlike --magic-sweep-input-scan/--member-work-session-input-scan/
## --routine-coworking-session-input-scan, that routine's own text has NO
## step that names a board-scan-shaped need the way routine-communication-
## sweep's "Enumeration mechanism" text or routine-daily's "Roll call" step
## do -- every place that routine touches board content today already
## delegates to a sub-routine with its own scan (Comms -> sweep's own
## --magic-sweep-input-scan; First-today-only grooming ->
## --magic-grooming-input-scan; Later-today -> routine-daily's
## --member-work-session-input-scan per member) or uses a different, simpler
## mechanism entirely (the Test-email-report step's own live find/wc
## board-statistics counts, not a document-shaped scan). This is a real
## finding to report, not a resolved spec: this op's own fixed state-list
## below (the same "active work" backlog/pending/running/blocked/parked
## five-state list already established for --magic-grooming-input-scan/
## --member-work-session-input-scan, all-headers) is this file's own
## best-effort interim choice -- a broad "pulse of the whole active board"
## reading, consistent with this op's own "heartbeat" name -- pending
## confirmation/reshaping once a concrete consuming step actually needs
## something narrower. Always --all-types (no board-item-type restriction
## has any textual basis here either).
##
## Fixed, hardcoded state-list/header-list -- no caller-facing --state/
## --header override flags: dedicated wrappers are fixed, not flexible; a
## caller wanting a different scan shape calls --intern-op-board-scan
## directly instead.
##

case "$1" in

	## Takes no arguments -- read-only discovery, same document shape as
	## --magic-grooming-input-scan (thin wrapper over
	## --intern-op-board-scan). See this file's own header comment for the
	## state-list/header-list's actual status (interim, not a verified
	## routine-text requirement the way sibling ops' defaults are).
	--magic-heartbeat-input-scan)
		shift
		## <team-member> captured for future logging/validation, unused today --
		## tooling operation discipline convention, this session's own new
		## ops.
		local callingMember="$1"
		shift || true
		if [ -z "$callingMember" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-input-scan: syntax is <team-member>" >&2
			set +e ; return 1
		fi
		if [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-input-scan: takes no arguments" >&2
			set +e ; return 1
		fi
		DistroAgentsTools --intern-op-board-scan \
			--state backlog --state pending --state running --state blocked --state parked \
			--all-types
		return $?
	;;

	## Explicit board-item->trash relocation for this routine's own GC step
	## (routine-heartbeat.routine.md's GC sub-step).
	--magic-heartbeat-board-item-trash)
		shift
		local callingMember="$1"
		shift || true
		local boardState="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$callingMember" ] || [ -z "$boardState" ] || [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-board-item-trash: syntax is <team-member> <board-state> <item-name>" >&2
			set +e ; return 1
		fi
		if [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-board-item-trash: invalid option: $1" >&2
			set +e ; return 1
		fi
		DistroAgentsTools --intern-op-board-trash "$boardState" "$itemName"
		return $?
	;;

	##
	## --magic-heartbeat-lock-* -- magic-coordinator's main-loop-mode
	## single-instance lock: mkdir-based mutex, 900s stale threshold, stdout
	## contract ACQUIRED / RECLAIMED_STALE:... / ACTIVE:... / HEARTBEAT_OK /
	## NO_LOCK_HELD / RELEASED / NO_LOCK / raw meta-file dump. Lock
	## directory: $HOME/.claude/skills/magic-coordinator/.runtime/
	## main-loop.lock. routine-heartbeat.routine.md's "Single-
	## instance lock" section documents the calling contract.
	##
	## "pid=" in the meta file is the calling shell's own $$ -- informational
	## only, never read back programmatically.
	##
	## Every closing `}` in the AWK below is preceded by a `;` even where a
	## single statement precedes it on the same line (magic-developer's
	## reference/shell.md axiom: some AWK implementations reject the
	## missing-semicolon form as a hard parse error).
	##
	## `|| true` guards `rm -rf`/`mkdir` in the stale-reclaim path and in
	## --magic-heartbeat-lock-release, since this file inherits the caller's
	## `set -e`.
	##

	## `mkdir` is the atomic primitive (creates the directory or fails if it
	## already exists, nothing in between) backing this lock. <owner-label>
	## should identify the actual running agent/process by a fixed,
	## discoverable name (e.g. "main-loop"), not an ephemeral
	## chat/conversation-session id.
	--magic-heartbeat-lock-acquire)
		shift
		## <team-member> captured for future logging/validation, unused today --
		## tooling operation discipline convention. Distinct from
		## <owner-label> below: <team-member> is the calling team-member's own
		## identity, <owner-label> is this specific process/instance's own
		## label (e.g. "main-loop", "next-iteration-cycle3") -- not the same
		## concept, both kept.
		local callingMember="$1"
		shift || true
		local ownerLabel="$1"
		shift || true
		if [ -z "$callingMember" ] || [ -z "$ownerLabel" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-lock-acquire: <team-member> <owner-label> required" >&2
			set +e ; return 1
		fi
		local lockDir="$HOME/.claude/skills/magic-coordinator/.runtime/main-loop.lock"
		local meta="$lockDir/meta"
		local staleSeconds=900
		if mkdir "$lockDir" 2>/dev/null ; then
			printf 'owner=%s\npid=%s\nstart=%s\nheartbeat=%s\n' "$ownerLabel" "$$" "$( date +%s )" "$( date +%s )" > "$meta"
			echo "ACQUIRED"
			return 0
		fi
		if [ -f "$meta" ] ; then
			local hb curOwner since age
			hb="$( awk -F= '/^heartbeat=/{print $2;}' "$meta" )"
			curOwner="$( awk -F= '/^owner=/{print $2;}' "$meta" )"
			since="$( awk -F= '/^start=/{print $2;}' "$meta" )"
			age=$(( $( date +%s ) - ${hb:-0} ))
			if [ "$age" -gt "$staleSeconds" ] ; then
				rm -rf "$lockDir" || true
				mkdir "$lockDir" 2>/dev/null || true
				printf 'owner=%s\npid=%s\nstart=%s\nheartbeat=%s\n' "$ownerLabel" "$$" "$( date +%s )" "$( date +%s )" > "$meta"
				echo "RECLAIMED_STALE:prev_owner=$curOwner:age=${age}s"
				return 0
			else
				echo "ACTIVE:owner=$curOwner:since=$since:heartbeat_age=${age}s"
				set +e ; return 1
			fi
		else
			echo "ACTIVE:owner=unknown:no_meta"
			set +e ; return 1
		fi
	;;

	## Refreshes the heartbeat timestamp so a long-running holder doesn't
	## get mistaken for a stale/crashed one by a concurrent
	## --magic-heartbeat-lock-acquire.
	--magic-heartbeat-lock-heartbeat)
		shift
		## <team-member> captured for future logging/validation, unused today --
		## tooling operation discipline convention.
		local callingMember="$1"
		shift || true
		if [ -z "$callingMember" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-lock-heartbeat: <team-member> required" >&2
			set +e ; return 1
		fi
		local lockDir="$HOME/.claude/skills/magic-coordinator/.runtime/main-loop.lock"
		local meta="$lockDir/meta"
		if [ -d "$lockDir" ] && [ -f "$meta" ] ; then
			local tmp="$meta.tmp.$$"
			awk -v t="$( date +%s )" -F= 'BEGIN{OFS="=";} /^heartbeat=/{$2=t;} {print;}' "$meta" > "$tmp" && mv "$tmp" "$meta"
			echo "HEARTBEAT_OK"
			return 0
		fi
		echo "NO_LOCK_HELD"
		set +e ; return 1
	;;

	## `rm -rf`, not `rmdir` -- this lock's directory holds a real `meta`
	## file, not just an empty marker.
	--magic-heartbeat-lock-release)
		shift
		## <team-member> captured for future logging/validation, unused today --
		## tooling operation discipline convention.
		local callingMember="$1"
		shift || true
		if [ -z "$callingMember" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-lock-release: <team-member> required" >&2
			set +e ; return 1
		fi
		local lockDir="$HOME/.claude/skills/magic-coordinator/.runtime/main-loop.lock"
		rm -rf "$lockDir" || true
		echo "RELEASED"
		return 0
	;;

	## Read-only, always returns 0.
	--magic-heartbeat-lock-status)
		shift
		## <team-member> captured for future logging/validation, unused today --
		## tooling operation discipline convention.
		local callingMember="$1"
		shift || true
		if [ -z "$callingMember" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-lock-status: <team-member> required" >&2
			set +e ; return 1
		fi
		local lockDir="$HOME/.claude/skills/magic-coordinator/.runtime/main-loop.lock"
		local meta="$lockDir/meta"
		if [ -f "$meta" ] ; then
			cat "$meta"
		else
			echo "NO_LOCK"
		fi
		return 0
	;;

	##
	## --magic-heartbeat-state-* -- routine-heartbeat's own day-rhythm state
	## record (that routine's `heartbeat-state-note`). Storage is tool-owned
	## and tool-resolved (via
	## --intern-config-board-location), deliberately outside
	## ~/.claude/skills/: a skillset file must never be rewritten by ordinary
	## routine iteration, and this record is rewritten every next-iteration.
	## Callers name the operation, never a path -- hence no filename argument.
	##
	## Singleton, not member-keyed: <team-member> is captured for future
	## logging/validation, unused today, exactly as the sibling
	## --magic-heartbeat-lock-* ops treat it. One shared record, the same way
	## the lock is one shared mutex -- a per-member path would hand a
	## non-magic-coordinator executor of this routine a fresh empty state.
	##

	## Content via stdin, or --from-file <path>.
	--magic-heartbeat-state-upsert)
		shift
		local callingMember="$1"
		shift || true
		if [ -z "$callingMember" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-state-upsert: syntax is <team-member> -- content via stdin or --from-file <path>" >&2
			set +e ; return 1
		fi
		local teamDataDir
		teamDataDir="$( DistroAgentsTools --intern-config-board-location )" || { set +e ; return 1 ; }
		local stateDir="$teamDataDir/runtime"
		mkdir -p "$stateDir" || {
			echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-state-upsert: can't create runtime directory: $stateDir" >&2
			set +e ; return 1
		}
		local target="$stateDir/main-loop-state.md"
		local content contentFromFile="false"
		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-file)
					if [ -z "$2" ] || [ ! -f "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-state-upsert: --from-file: file not found: $2" >&2
						set +e ; return 1
					fi
					content="$( cat "$2" )"
					contentFromFile="true"
					shift 2
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-state-upsert: unrecognized argument: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		[ "$contentFromFile" = "true" ] || content="$( cat )"
		## An empty write erases the day-rhythm state, which then reads back
		## as "first next-iteration today" -- re-running a day's grooming.
		if [ -z "$content" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-state-upsert: empty content -- refusing to erase the stored heartbeat state" >&2
			set +e ; return 1
		fi
		printf '%s\n' "$content" > "$target"
		echo "# $MDSC_CMD --magic-heartbeat-state-upsert: wrote $target ($( printf '%s\n' "$content" | wc -l | tr -d '[:space:]' ) lines)" >&2
		return 0
	;;

	## Read-only. Prints the record on stdout, or NO_STATE when nothing is
	## stored yet -- same "absent is not an error" contract as
	## --magic-heartbeat-lock-status's own NO_LOCK.
	--magic-heartbeat-state-read)
		shift
		local callingMember="$1"
		shift || true
		if [ -z "$callingMember" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-state-read: <team-member> required" >&2
			set +e ; return 1
		fi
		if [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-heartbeat-state-read: takes no arguments" >&2
			set +e ; return 1
		fi
		local teamDataDir
		teamDataDir="$( DistroAgentsTools --intern-config-board-location )" || { set +e ; return 1 ; }
		local target="$teamDataDir/runtime/main-loop-state.md"
		if [ -f "$target" ] ; then
			cat "$target"
		else
			echo "NO_STATE"
		fi
		return 0
	;;

	*)
		echo "⛔ ERROR: $MDSC_CMD: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
