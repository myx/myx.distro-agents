#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.InternOpBoardScan.include -- the --intern-op-board-scan op for
## DistroAgentsTools.fn.sh's dispatcher. Sourced lazily from that exact op's
## own dispatcher arm (not a wildcard -- this file holds one op only) via the
## standard $MDLT_ORIGIN-based path. Not standalone: relies on being
## dot-sourced for $1/$@/$MDSC_CMD.
##
## No --help entry: this is internal plumbing, the shared generic primitive
## underlying every --*-input-scan wrapper (--magic-grooming-input-scan,
## --magic-sweep-input-scan, --member-work-session-input-scan,
## --routine-coworking-session-input-scan, --magic-heartbeat-input-scan) --
## same relationship as AgentsTools.InternOpBoardUpsertMoveEdit.include has to
## --magic-grooming-to-*. Real scan policy (which states, which headers, by
## default) lives in each calling wrapper, never here -- this file only knows
## the generic scan/filter/format mechanics.
##
## CANONICAL NOTE -- identical wrappers are deliberate; do not collapse them.
## --magic-advance-input-scan, --magic-grooming-input-scan and
## --magic-heartbeat-input-scan pass byte-identical arguments to this primitive
## (the same five active states backlog/pending/running/blocked/parked, plus
## --all-types) and therefore produce byte-identical output on any successful
## run. That is the designed state, ruled so by the human-owner, not an
## oversight and not triplication to be refactored away.
##
## The reason is that these ops exist PER CONSUMER, not per scan scope. Each
## one is its own routine's own named input: routine-advance's,
## routine-grooming's, routine-heartbeat's. The op name is the stable interface
## a routine calls and that its own skillset file declares; the argument list
## behind it is an implementation detail that each routine is free to change
## on its own, for its own reasons, without negotiating with the other two.
## Collapsing them into one shared op -- or "deduplicating" two of them into
## calls to the third -- would couple three independent routines to a single
## argument list and make any later divergence a breaking change for consumers
## that never asked for it. Identical arguments today are a coincidence of
## three routines currently needing the same view, not evidence of one op
## wearing three names.
##
## Same "dedicated wrappers are fixed, not flexible" convention every other
## wrapper over this primitive follows: a caller wanting a different scan shape
## calls --intern-op-board-scan directly rather than adding override flags to,
## or merging, the fixed wrappers. Each of the three wrappers' own case-arm
## comments points back at this note.
##
## Note for anyone reconciling this against the board: the addendum on
## board/running/interview-2026-07-21-distroagentstools-board-scan-command.md
## asserting per-routine scan SCOPING is not accurate to this code -- the
## scopes are identical. Flagged, not edited here: board items are
## magic-coordinator's own to write.
##
## Output shape: one `## <state>/<item-filename>` line per matching item,
## then that item's frontmatter (either every field, or just the named
## --header values, in the order given), then a blank line -- grep/awk-
## parseable by design (same shape --magic-grooming-input-scan already had
## before this file existed; this file is that same logic, generalized).
##
## Three structurally independent filters -- deliberately not conflated into
## one mechanism despite all three living on this one primitive:
##   - board-item TYPE via --type-prefix:/--all-types, mandatory-explicit
##     (refuses to run with neither given -- no sensible universal default
##     exists the way one does for state/header below). Board-item type is a
##     FILENAME-prefix convention team-wide (task-*/note-*/inquiry-*/etc.,
##     see magic-team.armed.md's board-items entity model) -- --type-prefix:
##     is literally just a glob against the bare filename ("${prefix}*"),
##     nothing more; it never opens/reads the file or touches any frontmatter
##     field. Cheap enough to check before even stat-ing the file's content.
##   - OWNER (the `owner:` frontmatter field -- who's assigned) via the
##     optional --owner <value>, exact match. A plain inline sed extraction +
##     bash string comparison -- too trivial (one exact-match line check) to
##     need a script of its own.
##   - --item <name> (optional, repeatable): restricts matched files to just
##     these bare basenames. Not part of this primitive's original spec --
##     added to make --routine-coworking-session-input-scan's "scan these
##     specific named items, wherever they live" need implementable as a thin
##     wrapper over this same primitive rather than reimplementing scan/
##     format logic independently; also used by --magic-sweep-input-scan's
##     own phase-2 (display exactly the phase-1-discovered survivors) call.
##     Harmless/inert for every other caller, which simply never passes it.
## These were separate requirements when this primitive was specified, never
## one combined concept -- kept structurally separate here for that reason.
## Checked cheapest-first: --item (bare string compare) -> type (glob, no
## file open) -> owner (the only one that needs to read the file).
##
## State/header defaults, at THIS primitive's own level (a caller going
## through a wrapper never actually hits these -- every current wrapper
## always resolves and passes its own explicit list first):
##   - no --state given -> every real board state (backlog/pending/running/
##     blocked/parked/processed/archived/retained) -- a sensible,
##     always-correct universal default ("no restriction" = "everything"),
##     unlike type.
##   - no --header given -> every frontmatter field, verbatim (via the
##     external AgentBoardItemFrontmatterPrint.awk, shared with
##     --member-work-session-input-scan's own inbox-listing half) -- same
##     "no restriction = everything" logic, also always safe (more headers
##     shown than needed is never wrong, just possibly more verbose).
## Each wrapper supplies its OWN default state-list/header-list suited to its
## own routine's first-stage needs by always passing an explicit list rather
## than ever relying on this primitive's own bottom-level default -- "never
## one shared default for all" is enforced by convention at the call sites,
## not by this primitive refusing to have any default of its own.
##
## SESSION-INPUT SURFACE (--since-date-time/--since-utime, --list-open-inquiries)
##
## Growing this primitive toward "one operation that returns everything a
## session needs to start". Strictly additive: a caller that passes none of
## these options gets exactly the document it got before, byte for byte --
## verified by diffing every existing wrapper's output across the change.
##
## - --since-date-time <YYYY-MM-DD...> | --since-utime <epoch-seconds>:
##   at most one, mutually exclusive, not repeatable. The comms cut-off.
##   NEITHER IS CONVERTED HERE. The value is validated for shape and then
##   recorded and reported verbatim, in the spelling the caller used. Turning
##   an ISO date-time into epoch seconds needs date(1), whose flags differ
##   between Darwin/FreeBSD (-j -f) and Linux (-d) -- cross-platform
##   correctness is a hard requirement in this tree, so the conversion belongs
##   wherever a comms reader actually needs one, not in a scan primitive that
##   never uses the number itself.
##
## - Absent cut-off means NO comms are scanned at all -- not "scan whatever is
##   unread". Any read-not-seen / new-notifications semantics a channel offers
##   are deliberately not used, whatever the communication type, protocol or
##   service.
##
## - The `## comms-scan` block states this outright, in both directions, so a
##   caller can always tell "nothing new" from "nothing was looked at". That
##   distinction is the whole point of the block: an empty comms result and an
##   unperformed comms scan are indistinguishable without it.
##
## - The block is emitted only when a caller engaged this surface at all
##   (passed --since-* or --list-open-inquiries). A pure board-scan caller's
##   document is unchanged -- adding an unconditional preamble would rewrite
##   the input document of all six existing wrappers for no benefit to any of
##   them.
##
## - This op performs no external comms read of its own yet. A declared
##   cut-off is reported as declared, never as scanned; `performed:` stays
##   false in both branches until a comms reader is actually wired in.
##
## - --list-open-inquiries appends an `## open-inquiries` section. "Open" is
##   defined structurally by board state, and the field list is fixed -- see
##   that section's own comment for both, and for why the free-form `status:`
##   field is deliberately not used as the open/closed test.
##

case "$1" in

	## [--state <state>]... [--header <name>]...
	##   (--type-prefix:<value> [--type-prefix:<value>]... | --all-types)
	##   [--owner <value>] [--item <name>]...
	--intern-op-board-scan)
		shift
		## --context <caller-op>: see AgentsTools.InternOpBoardUpsertMoveEdit.include's
		## own copy of this block for the full reasoning. Pre-scanned before any
		## validation so every message here can name the invoking operation;
		## the option loop below consumes it again as an ordinary option.
		local opContext="<no --context given>"
		local ctxWanted="" ctxArg
		for ctxArg in "$@" ; do
			if [ -n "$ctxWanted" ] ; then
				opContext="$ctxArg" ; ctxWanted="" ; continue
			fi
			if [ "$ctxArg" = "--context" ] ; then ctxWanted="1" ; fi
		done
		local states=() headers=() typePrefixes=() items=()
		local allTypes="false" owner=""
		## Session-input composition surface (see this file's own header note).
		## commsCutoffKind stays empty when neither --since-* was given, which
		## is what makes "no comms were scanned" a stated fact rather than an
		## empty result indistinguishable from a healthy one.
		local commsCutoffKind="" commsCutoffValue="" listOpenInquiries="false"
		while [ $# -gt 0 ] ; do
			case "$1" in
				--state)
					if [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --intern-op-board-scan (internal operation, invoked via $opContext): --state: value required" >&2
						set +e ; return 1
					fi
					case "$2" in
						backlog|pending|running|blocked|parked|processed|archived|retained)
						;;
						*)
							echo "⛔ ERROR: $MDSC_CMD --intern-op-board-scan (internal operation, invoked via $opContext): --state: invalid state: $2" >&2
							set +e ; return 1
						;;
					esac
					states+=( "$2" )
					shift 2
				;;
				--header)
					if [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --intern-op-board-scan (internal operation, invoked via $opContext): --header: value required" >&2
						set +e ; return 1
					fi
					headers+=( "$2" )
					shift 2
				;;
				--type-prefix:*)
					local prefixVal="${1#--type-prefix:}"
					if [ -z "$prefixVal" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --intern-op-board-scan (internal operation, invoked via $opContext): --type-prefix: value required" >&2
						set +e ; return 1
					fi
					typePrefixes+=( "$prefixVal" )
					shift
				;;
				--all-types)
					allTypes="true"
					shift
				;;
				--owner)
					if [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --intern-op-board-scan (internal operation, invoked via $opContext): --owner: value required" >&2
						set +e ; return 1
					fi
					owner="$2"
					shift 2
				;;
				--item)
					if [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --intern-op-board-scan (internal operation, invoked via $opContext): --item: value required" >&2
						set +e ; return 1
					fi
					items+=( "$2" )
					shift 2
				;;
				--since-date-time|--since-utime)
					if [ -z "${2:-}" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --intern-op-board-scan (internal operation, invoked via $opContext): $1: value required" >&2
						set +e ; return 1
					fi
					if [ -n "$commsCutoffKind" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --intern-op-board-scan (internal operation, invoked via $opContext): --since-date-time and --since-utime are mutually exclusive, and neither is repeatable -- one cut-off, one spelling" >&2
						set +e ; return 1
					fi
					case "$1" in
						--since-utime)
							## Epoch seconds: digits only. Rejected here rather
							## than passed through, so a malformed cut-off can
							## never silently become "scan everything".
							case "$2" in
								''|*[!0-9]*)
									echo "⛔ ERROR: $MDSC_CMD --intern-op-board-scan (internal operation, invoked via $opContext): --since-utime: must be epoch seconds, digits only: $2" >&2
									set +e ; return 1
								;;
							esac
						;;
						--since-date-time)
							## Leading YYYY-MM-DD is all that is checked here:
							## enough to catch a transposed/garbage value, while
							## staying free of any date(1) parsing, whose flags
							## differ between Darwin/FreeBSD and Linux. This
							## op never converts the value -- see the header note.
							case "$2" in
								[0-9][0-9][0-9][0-9]-[0-1][0-9]-[0-3][0-9]*) ;;
								*)
									echo "⛔ ERROR: $MDSC_CMD --intern-op-board-scan (internal operation, invoked via $opContext): --since-date-time: must start with YYYY-MM-DD: $2" >&2
									set +e ; return 1
								;;
							esac
						;;
					esac
					commsCutoffKind="$1"
					commsCutoffValue="$2"
					shift 2
				;;
				--list-open-inquiries)
					listOpenInquiries="true"
					shift
				;;
				--context)
					if [ -z "${2:-}" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --intern-op-board-scan (internal operation, invoked via $opContext): --context: value required" >&2
						set +e ; return 1
					fi
					shift 2
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --intern-op-board-scan (internal operation, invoked via $opContext): invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done

		if [ "$allTypes" = "true" ] && [ ${#typePrefixes[@]} -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-op-board-scan (internal operation, invoked via $opContext): --all-types and --type-prefix: are mutually exclusive" >&2
			set +e ; return 1
		fi
		if [ "$allTypes" = "false" ] && [ ${#typePrefixes[@]} -eq 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-op-board-scan (internal operation, invoked via $opContext): exactly one of --all-types or --type-prefix:<value>... is required -- no implicit type default" >&2
			set +e ; return 1
		fi

		if [ ${#states[@]} -eq 0 ] ; then
			states=( backlog pending running blocked parked processed archived retained )
		fi

		[ -n "${MDAT_DATA_ROOT:-}" ] || {
			echo "⛔ ERROR: $MDSC_CMD --intern-op-board-scan (internal operation, invoked via $opContext): MDAT_DATA_ROOT is not set" >&2
			set +e ; return 1
		}
		local boardRoot="$MDAT_DATA_ROOT/board"
		local frontmatterPrintAwk="$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentBoardItemFrontmatterPrint.awk"
		local headersJoined="" sep=""
		if [ ${#headers[@]} -gt 0 ] ; then
			for h in "${headers[@]}" ; do
				headersJoined+="$sep$h"
				sep=$'\034'
			done
		fi

		## Comms-scan declaration. Emitted only when the caller engaged the
		## session-input surface at all (--since-* or --list-open-inquiries) --
		## a caller that asked for nothing but a board scan gets exactly the
		## document it got before this surface existed, byte for byte.
		##
		## Printed BEFORE any board item, and printed in both directions:
		## a stated "not-performed" is the whole point, so that an empty comms
		## result can never be mistaken for a healthy one that found nothing.
		## Its `## comms-scan` header carries no `/`, so a consumer matching
		## this document's item headers (`^## <state>/<item>`) never picks it
		## up, while the key: value + blank-line body keeps the same shape
		## every other block here uses.
		if [ -n "$commsCutoffKind" ] || [ "$listOpenInquiries" = "true" ] ; then
			printf '## comms-scan\n'
			if [ -z "$commsCutoffKind" ] ; then
				printf 'performed: false\n'
				printf 'reason: no --since-date-time/--since-utime cut-off was given\n'
				printf 'scanned-sources: none\n'
				printf 'not-used-semantics: read-not-seen, new-notifications\n'
				printf 'note: NO EXTERNAL COMMS SCAN WAS MADE by this operation, for any communication type, protocol or service. An empty comms result here means nothing was looked at, not that nothing was found.\n'
			else
				printf 'performed: false\n'
				printf 'cut-off-kind: %s\n' "$commsCutoffKind"
				printf 'cut-off-value: %s\n' "$commsCutoffValue"
				printf 'scanned-sources: none\n'
				printf 'note: a cut-off was accepted and is recorded above, but this operation performs no external comms read of its own -- it reports board data only. Do not read a declared cut-off as evidence that comms were scanned.\n'
			fi
			printf '\n'
		fi

		local state f base h val it tp matched ownerVal
		for state in "${states[@]}" ; do
			for f in "$boardRoot/$state"/*.md ; do
				[ -f "$f" ] || continue
				base="${f##*/}"

				## Cheapest check first: bare basename compare, no file I/O.
				if [ ${#items[@]} -gt 0 ] ; then
					matched="false"
					for it in "${items[@]}" ; do
						if [ "$it" = "$base" ] ; then matched="true" ; break ; fi
					done
					[ "$matched" = "true" ] || continue
				fi

				## Type-prefix: a plain glob against the filename -- never
				## opens the file, never touches frontmatter.
				if [ "$allTypes" != "true" ] ; then
					matched="false"
					for tp in "${typePrefixes[@]}" ; do
						case "$base" in
							"$tp"*) matched="true" ; break ;;
						esac
					done
					[ "$matched" = "true" ] || continue
				fi

				## Owner: the one filter that actually needs to read the
				## file -- plain exact-match line extraction, same sed idiom
				## the named-header display case below already uses.
				if [ -n "$owner" ] ; then
					ownerVal="$( LC_ALL=C sed -n 's/^owner: //p;q' "$f" )"
					[ "$ownerVal" = "$owner" ] || continue
				fi

				printf '## %s/%s\n' "$state" "$base"
				if [ ${#headers[@]} -eq 0 ] ; then
					LC_ALL=C awk -f "$frontmatterPrintAwk" "$f"
				else
					LC_ALL=C awk -v headers="$headersJoined" '
						BEGIN {
							n = split(headers, order, "\034")
							for (i = 1; i <= n; i++) {
								vals[order[i]] = ""
							}
						}
						NR == 1 {
							if ($0 == "---") {
								in_fm = 1
								next
							}
						}
						in_fm {
							if ($0 == "---") {
								exit
							}
							pos = index($0, ": ")
							if (pos > 0) {
								key = substr($0, 1, pos - 1)
								if ((key in vals) && vals[key] == "") {
									vals[key] = substr($0, pos + 2)
								}
							}
						}
						END {
							for (i = 1; i <= n; i++) {
								printf "%s: %s\n", order[i], vals[order[i]]
							}
						}
					' "$f"
				fi
				printf '\n'
			done
		done

		## Open own inquiry-* items, as their own labelled section.
		##
		## "Open/non-closed" is defined structurally, by board state: an
		## inquiry-* item is open while it sits in a non-terminal state
		## (backlog/pending/running/blocked/parked) and closed once it reaches
		## a terminal one (processed/archived/retained). That is the board's
		## own active/terminal split, already the five-state list every
		## --*-input-scan wrapper uses -- not a new concept invented here.
		## Deliberately NOT keyed on the `status:` frontmatter field: that
		## field is free-form prose on real items ("backlog -- not yet assessed
		## by magic-devops, no external blocker"), so it cannot carry a
		## machine-checkable open/closed answer, and pretending otherwise would
		## reintroduce exactly the silent-wrong-read failure this section's
		## own declaration above exists to prevent.
		##
		## Fixed field list, not caller-selectable: the fields that decide
		## whether an open inquiry needs action -- who must answer it, who
		## asked, when, its own free-text status note, what it references, and
		## the recheck-date/condition pair a blocked or parked one carries.
		## Verified present on real inquiry items rather than assumed.
		## Independent of --header, which stays the board-item section's own
		## selector.
		##
		## Honours --owner when given ("own" items), and ignores --state/
		## --type-prefix:/--all-types entirely: this section's states and type
		## are what define it, so letting the board section's filters narrow it
		## would make "open inquiries" mean something different per caller.
		if [ "$listOpenInquiries" = "true" ] ; then
			printf '## open-inquiries\n'
			printf 'open-states: backlog pending running blocked parked\n'
			printf 'closed-states-excluded: processed archived retained\n'
			printf 'owner-filter: %s\n' "${owner:-<none>}"
			printf '\n'
			## Same \034 field separator the --header path above joins with.
			local inqFS=$'\034'
			local inqHeaders="type${inqFS}from${inqFS}date${inqFS}owner${inqFS}status${inqFS}references${inqFS}recheck-date${inqFS}condition"
			local inqState inqFile inqBase
			for inqState in backlog pending running blocked parked ; do
				for inqFile in "$boardRoot/$inqState"/inquiry-*.md ; do
					[ -f "$inqFile" ] || continue
					inqBase="${inqFile##*/}"
					if [ -n "$owner" ] ; then
						ownerVal="$( LC_ALL=C sed -n 's/^owner: //p;q' "$inqFile" )"
						[ "$ownerVal" = "$owner" ] || continue
					fi
					printf '## open-inquiry %s/%s\n' "$inqState" "$inqBase"
					LC_ALL=C awk -v headers="$inqHeaders" '
						BEGIN {
							n = split(headers, order, "\034")
							for (i = 1; i <= n; i++) {
								vals[order[i]] = ""
							}
						}
						NR == 1 {
							if ($0 == "---") {
								in_fm = 1
								next
							}
						}
						in_fm {
							if ($0 == "---") {
								exit
							}
							pos = index($0, ": ")
							if (pos > 0) {
								key = substr($0, 1, pos - 1)
								if ((key in vals) && vals[key] == "") {
									vals[key] = substr($0, pos + 2)
								}
							}
						}
						END {
							for (i = 1; i <= n; i++) {
								printf "%s: %s\n", order[i], vals[order[i]]
							}
						}
					' "$inqFile"
					printf '\n'
				done
			done
		fi
		return 0
	;;

	*)
		echo "⛔ ERROR: $MDSC_CMD: invalid option: $1 (invoked via $opContext) -- rejected by AgentsTools.InternOpBoardScan.include's own default (*) branch, the operation group sourced by the --intern-op-board-scan dispatcher route; no operation of that name is defined in this include" >&2
		set +e ; return 1
	;;
esac
