				*)
					echo "⛔ ERROR: $MDSC_CMD $createOp: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$owner" ] ; then
			echo "⛔ ERROR: $MDSC_CMD $createOp: --owner-header-value <value> is required" >&2
			set +e ; return 1
		fi
		if [ -z "$bodyMode" ] ; then
			echo "⛔ ERROR: $MDSC_CMD $createOp: one body-input mode is required on create (--upsert-from-stdin|--edit-script-from-stdin:<py|awk>|--edit-patch-from-stdin) -- a created board-item has no existing body to carry forward, and filing an empty one is never intended" >&2
			set +e ; return 1
		fi
		local groomedAt ; groomedAt="$( date +"%Y-%m-%d %H:%M %z" )"
		DistroAgentsTools --intern-op-board-upsert-move-edit "$createState" "$itemName" \
			--create \
			--header:upsert:owner:"$owner" \
			--header:upsert:groomed-at:"$groomedAt" \
			--header:upsert:track:true \
			--context "$createOp" \
			"${passthrough[@]}"
		return $?
	;;

	## Takes no arguments -- read-only discovery, shaped as a real
	## structured text document meant to be one of routine-grooming's own
	## actual inputs (not a diagnostic dump). Thin wrapper over
	## --intern-op-session-context-scan with a fixed, hardcoded state-list/header-list
	## -- no caller-facing --state/--header override flags: dedicated
	## wrappers are fixed, not flexible; a caller wanting a different scan
	## shape calls --intern-op-session-context-scan directly instead. Always
	## backlog/pending (not yet dispatched) plus running/blocked/parked
	## (routine-grooming.routine.md's own step 1 "Gather the backlog"
	## wording) -- processed/archived/retained are settled/
	## terminal, never scanned here. Always every frontmatter field -- safe
	## interim choice until a separate investigation narrows it to just
	## what grooming Stage 1 actually needs. Always --all-types -- grooming
	## has never filtered by board-item type prefix. Default scan output
	## unchanged from this op's own pre-primitive implementation; the
	## override-flag capability that implementation had is not (removed
	## once this fixed-wrapper convention was established, applied here
	## retroactively).
	##
	## This op's arguments are byte-identical to --magic-advance-input-scan's
	## and --magic-heartbeat-input-scan's, so all three return identical output.
	## Deliberate, ruled so by the human-owner -- these ops exist per consuming
	## routine, not per scan scope. DO NOT collapse or deduplicate them. Full
	## reasoning: the CANONICAL NOTE in AgentsTools.InternOpSessionContextScan.include's
	## own header.
	--magic-grooming-input-scan)
		shift
		## <team-member> captured for future logging/validation, unused today --
		## see --magic-grooming-to-backlog's own comment above. The op's own
		## "no arguments" nature now means exactly one: the calling member.
		local callingMember="$1"
		shift || true
		if [ -z "$callingMember" ] || [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-input-scan: syntax is <team-member>, no other arguments" >&2
			set +e ; return 1
		fi
		[ -n "${MDAT_DATA_ROOT:-}" ] || {
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-input-scan: MDAT_DATA_ROOT is not set" >&2
			set +e ; return 1
		}
		## This routine's own state-and-lock note comes back as part of the
		## digest, because a scan returns the routine's COMPLETE prepared
		## input and this note is where the previous pass recorded what the
		## next one needs to continue from. Without it there is no read path
		## for that content at all: --magic-grooming-lock-status reports lock
		## METADATA, not the note's body.
		##
		## CONTENT ONLY -- this is deliberately NOT the lock gate returning in
		## another form. Nothing here evaluates state or recheck-date, decides
		## contention, or fails. The lock check is its own operation
		## (--magic-grooming-lock-acquire), called BEFORE this scan; a scan
		## reporting a lock verdict would put the two concerns back in one
		## call, which is exactly what the -lock- / -state- split exists to
		## prevent.
		##
		## A note that does not exist yet is ordinary, not special: it reports
		## as a source with nothing to report, the same as any other, and the
		## scan still succeeds. The first-ever pass is not a distinct outcome.
		printf '%s\n\n' "## state-and-lock (routine-grooming)"
		local lockNote="$MDAT_DATA_ROOT/inboxes/magic-coordinator/note-20260809T154332Z-grooming-state-and-lock.md"
		if [ -f "$lockNote" ] ; then cat "$lockNote" ; else echo "(no state-and-lock note recorded yet)" ; fi
		## The team roster cache comes back as its own section, for the same
		## reason the state-and-lock note above does: a scan returns this
		## routine's COMPLETE prepared input, and this routine's own
		## roster/tooling-recheck sub-step works from that cache -- it
		## re-derives the roster from the members' own live skill files and
		## refreshes the cache when the two have drifted, which needs the
		## stored cache in hand to compare against.
		##
		## THIS ROUTINE ONLY. routine-communication-sweep also touches the
		## same record, but on the write side (folding identity/routing data
		## in), and its own scan is about open comms threads -- so the record
		## is NOT added there. What each routine's own input-scan sweeps stays
		## split so the stubs do not intersect; content with no step of that
		## routine asking for it is the defect that split exists to prevent.
		##
		## CONTENT ONLY, same as the section above -- delegated to
		## --magic-team-roster-read so the record's filename stays stated in
		## exactly one place in this tool. An absent record reports as a
		## source with nothing to report (NO_RECORD) and the scan still
		## succeeds.
		printf '\n%s\n\n' "## team-roster (cache)"
		DistroAgentsTools --magic-team-roster-read "$callingMember"
		printf '\n%s\n\n' "## board digest"
		DistroAgentsTools --intern-op-session-context-scan "$callingMember" \
			--state backlog --state pending --state running --state blocked --state parked \
			--all-types \
			--context --magic-grooming-input-scan
		return $?
	;;

	## <team-member> [--header:<upsert|append|remove>:name[:value]]...
	##   [--from-file <path>|--upsert-from-stdin|--edit-patch-from-stdin]
	## routine-grooming's own state-and-lock note: state and lock in one
	## document, and this routine's session tracking document between
	## iterations (tactical status needed to continue the next iterative call
	## -- explicitly NOT a transcript). Prefers REFERENCING TEAM-DATA over
	## copying it, to stay compact.
	##
	## One of four stubs over --intern-op-item-upsert's default (no-flag)
	## behavior, the others being --magic-advance-state-and-lock-upsert/
	## --magic-daily-state-and-lock-upsert/--magic-retro-state-and-lock-upsert:
	## same "own dedicated stub per
	## calling routine, each carrying its own validation even where identical
	## today" convention this file's own --magic-grooming-to-* arms already
	## follow. The note filename is fixed and hardcoded here -- it is this
	## routine's own identity, never a caller argument, so no caller can point
	## this routine's lock at another routine's note.
	##
	## Introduces no option of its own. The state values and the +30-minute
	## recheck offset are properties of THIS ROUTINE, so they are hardcoded
	## here and expressed through the ordinary --header:upsert vocabulary.
	## There is deliberately no "closing" flag: a closing call is this stub
	## being handed --header:upsert:state:grooming-finished by its caller.
	##
	## HEADER ORDER IS LOAD-BEARING.
	## AgentsBoardItemHeaderOpsApply.awk resolves repeat upserts on one field
	## as last-wins, so position decides overridability, and these two fields
	## want opposite answers:
	##   - `state` goes BEFORE the caller's headers, so a closing call can
	##     override it to grooming-finished. Closure has no other way to say so.
	##   - `recheck-date` goes AFTER them, so it always wins. The spec re-sets
	##     it on EVERY update, and a caller able to override it could pin the
	##     lock open indefinitely -- turning the one bound on a crashed or
	##     wedged holder into a caller-supplied suggestion.
	## That asymmetry is a lock-correctness property, not a style choice.
	## Measured, not assumed: the awk's own header documents the last-wins
	## rule, and --header:'s parser takes headerValue as everything after the
	## first colon following the name, so a date-time value keeps its own
	## colons intact. Don't normalize these two back to one order.
	--magic-grooming-state-and-lock-upsert)
		shift
		local callingMember="$1"
		shift || true
		if [ -z "$callingMember" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-state-and-lock-upsert: syntax is <team-member> [--header:<upsert|append|remove>:name[:value]]... [--from-file <path>|--upsert-from-stdin|--edit-patch-from-stdin]" >&2
			set +e ; return 1
		fi
		local passthrough=()
		while [ $# -gt 0 ] ; do
			case "$1" in
				--header:*|--upsert-from-stdin|--edit-patch-from-stdin) passthrough+=( "$1" ) ; shift ;;
				--from-file)
					if [ -z "${2:-}" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --magic-grooming-state-and-lock-upsert: --from-file: value required" >&2
						set +e ; return 1
					fi
					passthrough+=( "$1" "$2" ) ; shift 2
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --magic-grooming-state-and-lock-upsert: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		## +30 minutes, UTC, in the team's own `date-time` shape
		## (`YYYY-MM-DD HH:MM ±HHMM`). Composed from AgentsEpochToIsoDate.awk
		## plus integer arithmetic rather than date(1) arithmetic: BSD spells
		## the offset `date -v+30M`, GNU spells it `date -d '+30 min'`, and
		## POSIX specifies neither -- date(1) is standardised only as a reader
		## of the CURRENT time. `date +%s` is the one portable primitive here,
		## already relied on by --magic-heartbeat-lock-*. Cross-platform
		## correctness is a hard requirement in this tree, so there is one code
		## path exercised on Darwin, FreeBSD and Linux alike.
		local nowEpoch targetEpoch recheckDay recheckRem recheckDate
		nowEpoch="$( date +%s )"
		targetEpoch=$(( nowEpoch + 30 * 60 ))
		recheckDay="$( printf '%s\n' "$targetEpoch" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsEpochToIsoDate.awk" )"
		recheckRem=$(( targetEpoch % 86400 ))
		recheckDate="$( printf '%s %02d:%02d +0000' "$recheckDay" "$(( recheckRem / 3600 ))" "$(( recheckRem % 3600 / 60 ))" )"
		DistroAgentsTools --intern-op-item-upsert "$callingMember" \
			note-20260809T154332Z-grooming-state-and-lock.md \
			--header:upsert:state:grooming-running \
			"${passthrough[@]}" \
			--header:upsert:recheck-date:"$recheckDate" \
			--context --magic-grooming-state-and-lock-upsert
		return $?
	;;

	##
	## --magic-grooming-lock-* -- routine-grooming's own lock: four thin stubs
	## over the shared --intern-op-item-read/--intern-op-item-upsert
	## primitives (AgentsTools.InternOpItem.include), same unified mechanism
	## every routine now uses -- frontmatter + git when TEAM_DATA_GIT_REMOTE
	## is configured, local-only when it is not.
	##
	## Position in the routine is fixed: lock before all, unlock in closure.
	## Not inside --magic-grooming-input-scan -- that op's contract is "return
	## this routine's prepared input", and a lock is not input. The `-lock-` /
	## `-state-` infix split says the same thing about the two namespaces.
	##
	## The +30-minute recheck offset is this routine's own, matching its own
	## state-and-lock cadence.
	##

	--magic-grooming-lock-acquire)
		shift
		local callingMember="$1" ; shift || true
		local ownerLabel="$1" ; shift || true
		if [ -z "$callingMember" ] || [ -z "$ownerLabel" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-lock-acquire: <team-member> <owner-label> required" >&2
			set +e ; return 1
		fi
		## Rejects any argument beyond this op's own positionals --
		## an unknown flag AND an unexpected extra positional alike.
		## Silently ignoring them let a typo through as a successful
		## call: `--magic-heartbeat-lock-status <member> owner-x
		## --bogus` returned 0 and acted as if nothing were wrong.
		if [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-lock-acquire: invalid option: $1" >&2
			set +e ; return 1
		fi
		local nowEpoch targetEpoch recheckDay recheckRem recheckDate
		nowEpoch="$( date +%s )" ; targetEpoch=$(( nowEpoch + 30 * 60 ))
		recheckDay="$( printf '%s\n' "$targetEpoch" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsEpochToIsoDate.awk" )"
		recheckRem=$(( targetEpoch % 86400 ))
		recheckDate="$( printf '%s %02d:%02d +0000' "$recheckDay" "$(( recheckRem / 3600 ))" "$(( recheckRem % 3600 / 60 ))" )"
		DistroAgentsTools --intern-op-item-read "$callingMember" \
			note-20260809T154332Z-grooming-state-and-lock.md \
			--acquire-lock "$ownerLabel" \
			--header:upsert:state:grooming-running \
			--header:upsert:recheck-date:"$recheckDate" \
			--context --magic-grooming-lock-acquire
		return $?
	;;

	--magic-grooming-lock-refresh)
		shift
		local callingMember="$1" ; shift || true
		if [ -z "$callingMember" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-lock-refresh: <team-member> required" >&2
			set +e ; return 1
		fi
		## Rejects any argument beyond this op's own positionals --
		## an unknown flag AND an unexpected extra positional alike.
		## Silently ignoring them let a typo through as a successful
		## call: `--magic-heartbeat-lock-status <member> owner-x
		## --bogus` returned 0 and acted as if nothing were wrong.
		if [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-lock-refresh: invalid option: $1" >&2
			set +e ; return 1
		fi
		local nowEpoch targetEpoch recheckDay recheckRem recheckDate
		nowEpoch="$( date +%s )" ; targetEpoch=$(( nowEpoch + 30 * 60 ))
		recheckDay="$( printf '%s\n' "$targetEpoch" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsEpochToIsoDate.awk" )"
		recheckRem=$(( targetEpoch % 86400 ))
		recheckDate="$( printf '%s %02d:%02d +0000' "$recheckDay" "$(( recheckRem / 3600 ))" "$(( recheckRem % 3600 / 60 ))" )"
		DistroAgentsTools --intern-op-item-upsert "$callingMember" \
			note-20260809T154332Z-grooming-state-and-lock.md \
			--update-lock \
			--header:upsert:state:grooming-running \
			--header:upsert:recheck-date:"$recheckDate" \
			--context --magic-grooming-lock-refresh
		return $?
	;;

	--magic-grooming-close-state-and-unlock)
		shift
		local callingMember="$1" ; shift || true
		if [ -z "$callingMember" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-close-state-and-unlock: <team-member> required" >&2
			set +e ; return 1
		fi
		## Rejects any argument beyond this op's own positionals --
		## an unknown flag AND an unexpected extra positional alike.
		## Silently ignoring them let a typo through as a successful
		## call: `--magic-heartbeat-lock-status <member> owner-x
		## --bogus` returned 0 and acted as if nothing were wrong.
		if [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-close-state-and-unlock: invalid option: $1" >&2
			set +e ; return 1
		fi
		DistroAgentsTools --intern-op-item-upsert "$callingMember" \
			note-20260809T154332Z-grooming-state-and-lock.md \
			--unlock-lock \
			--header:upsert:state:grooming-finished \
			--context --magic-grooming-close-state-and-unlock
		return $?
	;;

	--magic-grooming-lock-status)
		shift
		local callingMember="$1" ; shift || true
		if [ -z "$callingMember" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-lock-status: <team-member> required" >&2
			set +e ; return 1
		fi
		## Rejects any argument beyond this op's own positionals --
		## an unknown flag AND an unexpected extra positional alike.
		## Silently ignoring them let a typo through as a successful
		## call: `--magic-heartbeat-lock-status <member> owner-x
		## --bogus` returned 0 and acted as if nothing were wrong.
		if [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-lock-status: invalid option: $1" >&2
			set +e ; return 1
		fi
		DistroAgentsTools --intern-op-item-read "$callingMember" \
			note-20260809T154332Z-grooming-state-and-lock.md \
			--context --magic-grooming-lock-status
		return $?
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
