#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.MagicGrooming.include -- routine-grooming's own --magic-
## grooming-* operation group for DistroAgentsTools.fn.sh's dispatcher.
## Sourced lazily from the `--magic-grooming-*)` wildcard arm via the
## standard $MDLT_ORIGIN-based path. Not standalone: relies on being
## dot-sourced for $1/$@/$MDSC_CMD.
##
## Each --magic-grooming-to-<state> op is its OWN separate, explicit case
## arm -- deliberately NOT a wildcard match and NOT a shared/parameterized
## helper deriving <state> from an argument, even though today they're
## near-identical. Same reasoning already established in this package for
## --member-upsert-member-inquiry/--member-upsert-inbox-reflection (see
## AgentsTools.Member.include): each op is expected to grow its own
## state-specific validation later, which only works cleanly if each
## already has its own independent code path now. Thin logic over
## --intern-op-board-upsert-move-edit -- this file owns routine-grooming's
## own policy (mandatory owner, auto groomed-at/groomed-from/track), the
## intern-op owns the generic mechanics.
##

case "$1" in

	## <item-filename> --from-state:<state> --owner <value>
	##   [--header:<upsert|append|remove>:name[:value]]...
	##   [--upsert-from-stdin|--edit-script-from-stdin:<py|awk>|--edit-patch-from-stdin]
	## Target state is backlog (fixed by this op's own name). --owner and
	## --from-state:<state> are both required; groomed-at (today, UTC),
	## groomed-from (the --from-state value), and track (true) are always
	## auto-stamped, never caller-supplied. --header:*/--upsert-from-stdin/
	## --edit-script-from-stdin:*/--edit-patch-from-stdin pass straight
	## through to the intern-op.
	--magic-grooming-to-backlog)
		shift
		## <team-member> is every calling routine's own name/identity, captured
		## even though unused here today -- reserved for logging/validation
		## (tooling operation discipline convention), not this op's own logic.
		local callingMember="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$callingMember" ] || [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-backlog: syntax is <team-member> <item-filename> --from-state:<state> --owner <value> [--header:<upsert|append|remove>:name[:value]]... [--upsert-from-stdin|--edit-script-from-stdin:<py|awk>|--edit-patch-from-stdin]" >&2
			set +e ; return 1
		fi
		local fromStateArg="" owner=""
		local passthrough=()
		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-state:*) fromStateArg="$1" ; shift ;;
				--owner)
					if [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-backlog: --owner: value required" >&2
						set +e ; return 1
					fi
					owner="$2" ; shift 2
				;;
				--header:*|--upsert-from-stdin|--edit-script-from-stdin:*|--edit-patch-from-stdin)
					passthrough+=( "$1" ) ; shift
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-backlog: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$fromStateArg" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-backlog: --from-state:<state> is required" >&2
			set +e ; return 1
		fi
		if [ -z "$owner" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-backlog: --owner <value> is required" >&2
			set +e ; return 1
		fi
		local fromStateVal="${fromStateArg#--from-state:}"
		local groomedAt ; groomedAt="$( date +"%Y-%m-%d %H:%M %z" )"
		DistroAgentsTools --intern-op-board-upsert-move-edit backlog "$itemName" \
			"$fromStateArg" \
			--header:upsert:owner:"$owner" \
			--header:upsert:groomed-at:"$groomedAt" \
			--header:upsert:groomed-from:"$fromStateVal" \
			--header:upsert:track:true \
			--context --magic-grooming-to-backlog \
			"${passthrough[@]}"
		return $?
	;;

	## Same shape as --magic-grooming-to-backlog, target state fixed to
	## pending. Deliberately its own full copy, not a shared helper -- see
	## this file's own header note.
	--magic-grooming-to-pending)
		shift
		## <team-member> captured for future logging/validation, unused today --
		## see --magic-grooming-to-backlog's own comment above.
		local callingMember="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$callingMember" ] || [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-pending: syntax is <team-member> <item-filename> --from-state:<state> --owner <value> [--header:<upsert|append|remove>:name[:value]]... [--upsert-from-stdin|--edit-script-from-stdin:<py|awk>|--edit-patch-from-stdin]" >&2
			set +e ; return 1
		fi
		local fromStateArg="" owner=""
		local passthrough=()
		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-state:*) fromStateArg="$1" ; shift ;;
				--owner)
					if [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-pending: --owner: value required" >&2
						set +e ; return 1
					fi
					owner="$2" ; shift 2
				;;
				--header:*|--upsert-from-stdin|--edit-script-from-stdin:*|--edit-patch-from-stdin)
					passthrough+=( "$1" ) ; shift
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-pending: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$fromStateArg" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-pending: --from-state:<state> is required" >&2
			set +e ; return 1
		fi
		if [ -z "$owner" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-pending: --owner <value> is required" >&2
			set +e ; return 1
		fi
		local fromStateVal="${fromStateArg#--from-state:}"
		local groomedAt ; groomedAt="$( date +"%Y-%m-%d %H:%M %z" )"
		DistroAgentsTools --intern-op-board-upsert-move-edit pending "$itemName" \
			"$fromStateArg" \
			--header:upsert:owner:"$owner" \
			--header:upsert:groomed-at:"$groomedAt" \
			--header:upsert:groomed-from:"$fromStateVal" \
			--header:upsert:track:true \
			--context --magic-grooming-to-pending \
			"${passthrough[@]}"
		return $?
	;;

	## Same shape as --magic-grooming-to-backlog, target state fixed to
	## processed. Deliberately its own full copy, not a shared helper -- see
	## this file's own header note.
	--magic-grooming-to-processed)
		shift
		## <team-member> captured for future logging/validation, unused today --
		## see --magic-grooming-to-backlog's own comment above.
		local callingMember="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$callingMember" ] || [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-processed: syntax is <team-member> <item-filename> --from-state:<state> --owner <value> [--header:<upsert|append|remove>:name[:value]]... [--upsert-from-stdin|--edit-script-from-stdin:<py|awk>|--edit-patch-from-stdin]" >&2
			set +e ; return 1
		fi
		local fromStateArg="" owner=""
		local passthrough=()
		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-state:*) fromStateArg="$1" ; shift ;;
				--owner)
					if [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-processed: --owner: value required" >&2
						set +e ; return 1
					fi
					owner="$2" ; shift 2
				;;
				--header:*|--upsert-from-stdin|--edit-script-from-stdin:*|--edit-patch-from-stdin)
					passthrough+=( "$1" ) ; shift
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-processed: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$fromStateArg" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-processed: --from-state:<state> is required" >&2
			set +e ; return 1
		fi
		if [ -z "$owner" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-processed: --owner <value> is required" >&2
			set +e ; return 1
		fi
		local fromStateVal="${fromStateArg#--from-state:}"
		local groomedAt ; groomedAt="$( date +"%Y-%m-%d %H:%M %z" )"
		DistroAgentsTools --intern-op-board-upsert-move-edit processed "$itemName" \
			"$fromStateArg" \
			--header:upsert:owner:"$owner" \
			--header:upsert:groomed-at:"$groomedAt" \
			--header:upsert:groomed-from:"$fromStateVal" \
			--header:upsert:track:true \
			--context --magic-grooming-to-processed \
			"${passthrough[@]}"
		return $?
	;;

	## Same shape as --magic-grooming-to-backlog, target state fixed to
	## parked. Deliberately its own full copy, not a shared helper -- see
	## this file's own header note. routine-grooming's own Defer outcome
	## (deliberate deferral by the team's own choice, distinct from blocked/'s
	## external stall), which until now had no dedicated op and fell back to
	## --write-board-item's own two-call move recipe.
	##
	## One of three separate --*-to-parked stubs, deliberately: this one is
	## routine-grooming's, --magic-advance-to-parked is routine-advance's, and
	## --magic-board-to-parked is check-process-board's. Each lives in its own
	## routine's namespace/.include, each carries its own independent
	## validation even where identical today, and all three share the one
	## --intern-op-board-upsert-move-edit implementation.
	##
	## Carries this file's full grooming policy (mandatory --owner, auto
	## groomed-at/groomed-from/track) exactly as its three siblings do --
	## parked being a deferred state is not a reason to withhold it: the
	## -to-processed sibling stamps the same set onto a terminal state, and
	## track is a grooming provenance marker, not a scheduler input, so it
	## creates none of the periodic action board-parked's own "pure passivity"
	## definition forbids. recheck-date/condition, the fields a parked item
	## actually needs, stay caller-supplied via --header:* -- they are triage
	## judgments this op cannot compute.
	--magic-grooming-to-parked)
		shift
		## <team-member> captured for future logging/validation, unused today --
		## see --magic-grooming-to-backlog's own comment above.
		local callingMember="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$callingMember" ] || [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-parked: syntax is <team-member> <item-filename> --from-state:<state> --owner <value> [--header:<upsert|append|remove>:name[:value]]... [--upsert-from-stdin|--edit-script-from-stdin:<py|awk>|--edit-patch-from-stdin]" >&2
			set +e ; return 1
		fi
		local fromStateArg="" owner=""
		local passthrough=()
		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-state:*) fromStateArg="$1" ; shift ;;
				--owner)
					if [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-parked: --owner: value required" >&2
						set +e ; return 1
					fi
					owner="$2" ; shift 2
				;;
				--header:*|--upsert-from-stdin|--edit-script-from-stdin:*|--edit-patch-from-stdin)
					passthrough+=( "$1" ) ; shift
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-parked: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$fromStateArg" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-parked: --from-state:<state> is required" >&2
			set +e ; return 1
		fi
		if [ -z "$owner" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-parked: --owner <value> is required" >&2
			set +e ; return 1
		fi
		local fromStateVal="${fromStateArg#--from-state:}"
		local groomedAt ; groomedAt="$( date +"%Y-%m-%d %H:%M %z" )"
		DistroAgentsTools --intern-op-board-upsert-move-edit parked "$itemName" \
			"$fromStateArg" \
			--header:upsert:owner:"$owner" \
			--header:upsert:groomed-at:"$groomedAt" \
			--header:upsert:groomed-from:"$fromStateVal" \
			--header:upsert:track:true \
			--context --magic-grooming-to-parked \
			"${passthrough[@]}"
		return $?
	;;

	## Same shape as --magic-grooming-to-backlog, target state fixed to
	## blocked. Deliberately its own full copy, not a shared helper -- see
	## this file's own header note. routine-grooming's own stalled-on-
	## something-external outcome, distinct from parked/ (which is the team
	## deliberately choosing to stop pushing). Retires the two-call
	## --write-board-item recipe that routine-grooming prescribed for this
	## move at four separate sites -- the same non-atomic half-write pattern
	## every other --*-to-* op in this family was built to replace.
	##
	## Deliberately its own grooming-family op rather than a caller of the
	## already-existing --magic-board-to-blocked: routine-grooming calls its
	## own family throughout, so every grooming-driven move carries grooming's
	## own policy stamps by construction rather than by the caller
	## remembering to pass them. Consistency of family over reuse of an
	## existing op -- the human-owner's own call.
	##
	## Carries this file's full grooming policy (mandatory --owner, auto
	## groomed-at/groomed-from/track) exactly as its four siblings do. That
	## stamping is precisely what distinguishes this op from
	## --magic-board-to-blocked, which stamps nothing: same target state,
	## different owning routine, different recorded provenance.
	## recheck-date/condition, the fields a blocked item needs, stay
	## caller-supplied via --header:* -- they are triage judgments this op
	## cannot compute.
	--magic-grooming-to-blocked)
		shift
		## <team-member> captured for future logging/validation, unused today --
		## see --magic-grooming-to-backlog's own comment above.
		local callingMember="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$callingMember" ] || [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-blocked: syntax is <team-member> <item-filename> --from-state:<state> --owner <value> [--header:<upsert|append|remove>:name[:value]]... [--upsert-from-stdin|--edit-script-from-stdin:<py|awk>|--edit-patch-from-stdin]" >&2
			set +e ; return 1
		fi
		local fromStateArg="" owner=""
		local passthrough=()
		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-state:*) fromStateArg="$1" ; shift ;;
				--owner)
					if [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-blocked: --owner: value required" >&2
						set +e ; return 1
					fi
					owner="$2" ; shift 2
				;;
				--header:*|--upsert-from-stdin|--edit-script-from-stdin:*|--edit-patch-from-stdin)
					passthrough+=( "$1" ) ; shift
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-blocked: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$fromStateArg" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-blocked: --from-state:<state> is required" >&2
			set +e ; return 1
		fi
		if [ -z "$owner" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-blocked: --owner <value> is required" >&2
			set +e ; return 1
		fi
		local fromStateVal="${fromStateArg#--from-state:}"
		local groomedAt ; groomedAt="$( date +"%Y-%m-%d %H:%M %z" )"
		DistroAgentsTools --intern-op-board-upsert-move-edit blocked "$itemName" \
			"$fromStateArg" \
			--header:upsert:owner:"$owner" \
			--header:upsert:groomed-at:"$groomedAt" \
			--header:upsert:groomed-from:"$fromStateVal" \
			--header:upsert:track:true \
			--context --magic-grooming-to-blocked \
			"${passthrough[@]}"
		return $?
	;;

	## Same shape as --magic-grooming-to-backlog, target state fixed to
	## running. Deliberately its own full copy, not a shared helper -- see
	## this file's own header note. routine-grooming's own check-backlog-promote
	## dispatch: "once the thread is genuinely active, move the item to
	## board-running", which that step still described as a two-call
	## --write-board-item move (write the new state, remove the old file) --
	## the non-atomic half-write every op in this family exists to retire.
	##
	## Distinct from --magic-advance-to-running, which targets the same state:
	## that one is routine-advance's/check-execute-board's own dispatch and
	## owns the started-at auto-stamp; this one is routine-grooming's, and
	## carries grooming's own provenance stamps instead. Same target state,
	## different owning routine, different recorded provenance -- the same
	## split already established between --magic-grooming-to-blocked and
	## --magic-board-to-blocked. routine-grooming calls its own family
	## throughout, so a grooming-driven move carries grooming's stamps by
	## construction rather than by the caller remembering to pass them.
	##
	## Carries this file's full grooming policy (mandatory --owner, auto
	## groomed-at/groomed-from/track) exactly as its siblings do. Anything
	## this op does not own -- started-at included -- stays caller-supplied
	## via --header:*.
	--magic-grooming-to-running)
		shift
		## <team-member> captured for future logging/validation, unused today --
		## see --magic-grooming-to-backlog's own comment above.
		local callingMember="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$callingMember" ] || [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-running: syntax is <team-member> <item-filename> --from-state:<state> --owner <value> [--header:<upsert|append|remove>:name[:value]]... [--upsert-from-stdin|--edit-script-from-stdin:<py|awk>|--edit-patch-from-stdin]" >&2
			set +e ; return 1
		fi
		local fromStateArg="" owner=""
		local passthrough=()
		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-state:*) fromStateArg="$1" ; shift ;;
				--owner)
					if [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-running: --owner: value required" >&2
						set +e ; return 1
					fi
					owner="$2" ; shift 2
				;;
				--header:*|--upsert-from-stdin|--edit-script-from-stdin:*|--edit-patch-from-stdin)
					passthrough+=( "$1" ) ; shift
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-running: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$fromStateArg" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-running: --from-state:<state> is required" >&2
			set +e ; return 1
		fi
		if [ -z "$owner" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-running: --owner <value> is required" >&2
			set +e ; return 1
		fi
		local fromStateVal="${fromStateArg#--from-state:}"
		local groomedAt ; groomedAt="$( date +"%Y-%m-%d %H:%M %z" )"
		DistroAgentsTools --intern-op-board-upsert-move-edit running "$itemName" \
			"$fromStateArg" \
			--header:upsert:owner:"$owner" \
			--header:upsert:groomed-at:"$groomedAt" \
			--header:upsert:groomed-from:"$fromStateVal" \
			--header:upsert:track:true \
			--context --magic-grooming-to-running \
			"${passthrough[@]}"
		return $?
	;;

	## Same shape as --magic-grooming-to-backlog, target state fixed to
	## archived. Deliberately its own full copy, not a shared helper -- see
	## this file's own header note. routine-grooming's own Drop outcome
	## (dropped with no future intent), plus the two archived exits from its
	## re-check steps: a parked item whose trigger the group concludes is
	## never coming, and a blocked item the group decides is not worth even
	## waiting on. That routine named this move as having no stub and staying
	## the two-call --write-board-item recipe -- this op is what retires it.
	##
	## board-archived is terminal, which is not a reason to withhold the
	## grooming stamps: --magic-grooming-to-processed already stamps the same
	## set onto a terminal state, and the provenance of who archived an item
	## and out of which state is exactly what a later reader of an archived
	## item needs. archive:/the archived item's own reason text stay
	## caller-supplied via --header:*/the body-input modes -- judgments this
	## op cannot compute.
	--magic-grooming-to-archived)
		shift
		## <team-member> captured for future logging/validation, unused today --
		## see --magic-grooming-to-backlog's own comment above.
		local callingMember="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$callingMember" ] || [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-archived: syntax is <team-member> <item-filename> --from-state:<state> --owner <value> [--header:<upsert|append|remove>:name[:value]]... [--upsert-from-stdin|--edit-script-from-stdin:<py|awk>|--edit-patch-from-stdin]" >&2
			set +e ; return 1
		fi
		local fromStateArg="" owner=""
		local passthrough=()
		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-state:*) fromStateArg="$1" ; shift ;;
				--owner)
					if [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-archived: --owner: value required" >&2
						set +e ; return 1
					fi
					owner="$2" ; shift 2
				;;
				--header:*|--upsert-from-stdin|--edit-script-from-stdin:*|--edit-patch-from-stdin)
					passthrough+=( "$1" ) ; shift
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-archived: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$fromStateArg" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-archived: --from-state:<state> is required" >&2
			set +e ; return 1
		fi
		if [ -z "$owner" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-archived: --owner <value> is required" >&2
			set +e ; return 1
		fi
		local fromStateVal="${fromStateArg#--from-state:}"
		local groomedAt ; groomedAt="$( date +"%Y-%m-%d %H:%M %z" )"
		DistroAgentsTools --intern-op-board-upsert-move-edit archived "$itemName" \
			"$fromStateArg" \
			--header:upsert:owner:"$owner" \
			--header:upsert:groomed-at:"$groomedAt" \
			--header:upsert:groomed-from:"$fromStateVal" \
			--header:upsert:track:true \
			--context --magic-grooming-to-archived \
			"${passthrough[@]}"
		return $?
	;;

	## Same shape as --magic-grooming-to-backlog, target state fixed to
	## retained. Deliberately its own full copy, not a shared helper -- see
	## this file's own header note.
	##
	## READ THIS BEFORE INFERRING ANYTHING FROM THIS OP'S EXISTENCE:
	## routine-grooming does NOT move items into board-retained, and this op
	## is not evidence that it does. Moving an item into board-retained is
	## routine-heartbeat's own GC diversion (magic-team.board.md's GC
	## sub-step: a board-processed item still referenced by another live
	## board-item diverts to board-retained instead of being removed).
	## Grooming's only involvement with board-retained is its
	## recheck-and-exit step, and this op serves exactly one case from it.
	##
	## That case is a SAME-STATE PATCH, not a move: routine-grooming's
	## board-retained recheck-and-exit, "still referenced -> stays,
	## recheck-date renewed", which that step described as a --write-board-item
	## single call in the same state. Called as --from-state:retained, so
	## source and target match --
	## --intern-op-board-upsert-move-edit reads-and-preserves the existing body
	## whenever --from-state equals the target state, so nothing relocates and
	## the item's content survives untouched. Same same-state mechanism
	## --magic-advance-to-running already uses with --from-state:running.
	## The renewed recheck-date itself is caller-supplied via --header:* -- it
	## is a scheduling judgment this op cannot compute.
	##
	## Carries this file's full grooming policy (mandatory --owner, auto
	## groomed-at/groomed-from/track) exactly as its siblings do. On a
	## same-state call groomed-from records retained, which is correct and
	## intended: it says this item was groomed while sitting in retained, not
	## that it arrived from somewhere else.
	--magic-grooming-to-retained)
		shift
		## <team-member> captured for future logging/validation, unused today --
		## see --magic-grooming-to-backlog's own comment above.
		local callingMember="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$callingMember" ] || [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-retained: syntax is <team-member> <item-filename> --from-state:<state> --owner <value> [--header:<upsert|append|remove>:name[:value]]... [--upsert-from-stdin|--edit-script-from-stdin:<py|awk>|--edit-patch-from-stdin]" >&2
			set +e ; return 1
		fi
		local fromStateArg="" owner=""
		local passthrough=()
		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-state:*) fromStateArg="$1" ; shift ;;
				--owner)
					if [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-retained: --owner: value required" >&2
						set +e ; return 1
					fi
					owner="$2" ; shift 2
				;;
				--header:*|--upsert-from-stdin|--edit-script-from-stdin:*|--edit-patch-from-stdin)
					passthrough+=( "$1" ) ; shift
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-retained: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$fromStateArg" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-retained: --from-state:<state> is required" >&2
			set +e ; return 1
		fi
		if [ -z "$owner" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-retained: --owner <value> is required" >&2
			set +e ; return 1
		fi
		local fromStateVal="${fromStateArg#--from-state:}"
		local groomedAt ; groomedAt="$( date +"%Y-%m-%d %H:%M %z" )"
		DistroAgentsTools --intern-op-board-upsert-move-edit retained "$itemName" \
			"$fromStateArg" \
			--header:upsert:owner:"$owner" \
			--header:upsert:groomed-at:"$groomedAt" \
			--header:upsert:groomed-from:"$fromStateVal" \
			--header:upsert:track:true \
			--context --magic-grooming-to-retained \
			"${passthrough[@]}"
		return $?
	;;

	## Takes no arguments -- read-only discovery, shaped as a real
	## structured text document meant to be one of routine-grooming's own
	## actual inputs (not a diagnostic dump). Thin wrapper over
	## --intern-op-board-scan with a fixed, hardcoded state-list/header-list
	## -- no caller-facing --state/--header override flags: dedicated
	## wrappers are fixed, not flexible; a caller wanting a different scan
	## shape calls --intern-op-board-scan directly instead. Always
	## backlog/pending (not yet dispatched) plus running/blocked/parked
	## (routine-grooming.routine.md's own step 1 "Gather the backlog"
	## wording) -- processed/archived/retained are settled/
	## terminal, never scanned here. Always every frontmatter field -- safe
	## interim choice until a separate investigation narrows it to just
	## what grooming Stage 1 actually needs. Always --all-types -- grooming
	## has never filtered by board-item type prefix. Default scan output
	## unchanged from this op's own pre-primitive implementation; the
	## override-flag capability that implementation had is not (removed
	## once this fixed-wrapper convention was established, applied here
	## retroactively).
	##
	## This op's arguments are byte-identical to --magic-advance-input-scan's
	## and --magic-heartbeat-input-scan's, so all three return identical output.
	## Deliberate, ruled so by the human-owner -- these ops exist per consuming
	## routine, not per scan scope. DO NOT collapse or deduplicate them. Full
	## reasoning: the CANONICAL NOTE in AgentsTools.InternOpBoardScan.include's
	## own header.
	--magic-grooming-input-scan)
		shift
		## <team-member> captured for future logging/validation, unused today --
		## see --magic-grooming-to-backlog's own comment above. The op's own
		## "no arguments" nature now means exactly one: the calling member.
		local callingMember="$1"
		shift || true
		if [ -z "$callingMember" ] || [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-input-scan: syntax is <team-member>, no other arguments" >&2
			set +e ; return 1
		fi
		DistroAgentsTools --intern-op-board-scan \
			--state backlog --state pending --state running --state blocked --state parked \
			--all-types \
			--context --magic-grooming-input-scan
		return $?
	;;

	*)
		echo "⛔ ERROR: $MDSC_CMD: invalid option: $1 -- rejected by AgentsTools.MagicGrooming.include's own default (*) branch, the operation group sourced by the --magic-grooming-* dispatcher route; no operation of that name is defined in this include" >&2
		set +e ; return 1
	;;
esac
