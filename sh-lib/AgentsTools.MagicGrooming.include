#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.MagicGrooming.include -- routine-grooming's own --magic-
## grooming-* operation group for DistroAgentsTools.fn.sh's dispatcher.
## Sourced lazily from the `--magic-grooming-*)` wildcard arm via the
## standard $MDLT_ORIGIN-based path. Not standalone: relies on being
## dot-sourced for $1/$@/$MDSC_CMD.
##
## Each --magic-grooming-to-<state> op is its OWN separate, explicit case
## arm -- deliberately NOT a wildcard match and NOT a shared/parameterized
## helper deriving <state> from an argument, even though today they're
## near-identical. Same reasoning already established in this package for
## --member-upsert-member-inquiry/--member-upsert-inbox-reflection (see
## AgentsTools.Member.include): each op is expected to grow its own
## state-specific validation later, which only works cleanly if each
## already has its own independent code path now. Thin logic over
## --intern-op-board-upsert-move-edit -- this file owns routine-grooming's
## own policy (mandatory owner, auto groomed-at/groomed-from/track), the
## intern-op owns the generic mechanics.
##

case "$1" in

	## <item-filename> --from-state:<state> --owner-header-value <value>
	##   [--header:<upsert|append|remove>:name[:value]]...
	##   [--upsert-from-stdin|--edit-script-from-stdin:<py|awk>|--edit-patch-from-stdin]
	## Target state is backlog (fixed by this op's own name). --owner-header-value and
	## --from-state:<state> are both required; groomed-at (today, UTC),
	## groomed-from (the --from-state value), and track (true) are always
	## auto-stamped, never caller-supplied. --header:*/--upsert-from-stdin/
	## --edit-script-from-stdin:*/--edit-patch-from-stdin pass straight
	## through to the intern-op.
	--magic-grooming-to-backlog)
		shift
		## <team-member> is every calling routine's own name/identity, captured
		## even though unused here today -- reserved for logging/validation
		## (tooling operation discipline convention), not this op's own logic.
		local callingMember="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$callingMember" ] || [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-backlog: syntax is <team-member> <item-filename> --from-state:<state> --owner-header-value <value> [--header:<upsert|append|remove>:name[:value]]... [--upsert-from-stdin|--edit-script-from-stdin:<py|awk>|--edit-patch-from-stdin]" >&2
			set +e ; return 1
		fi
		local fromStateArg="" owner=""
		local passthrough=()
		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-state:*) fromStateArg="$1" ; shift ;;
				--owner-header-value)
					if [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-backlog: --owner-header-value: value required" >&2
						set +e ; return 1
					fi
					owner="$2" ; shift 2
				;;
				--header:*|--upsert-from-stdin|--edit-script-from-stdin:*|--edit-patch-from-stdin)
					passthrough+=( "$1" ) ; shift
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-backlog: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$fromStateArg" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-backlog: --from-state:<state> is required" >&2
			set +e ; return 1
		fi
		if [ -z "$owner" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-backlog: --owner-header-value <value> is required" >&2
			set +e ; return 1
		fi
		local fromStateVal="${fromStateArg#--from-state:}"
		local groomedAt ; groomedAt="$( date +"%Y-%m-%d %H:%M %z" )"
		DistroAgentsTools --intern-op-board-upsert-move-edit backlog "$itemName" \
			"$fromStateArg" \
			--header:upsert:owner:"$owner" \
			--header:upsert:groomed-at:"$groomedAt" \
			--header:upsert:groomed-from:"$fromStateVal" \
			--header:upsert:track:true \
			--context --magic-grooming-to-backlog \
			"${passthrough[@]}"
		return $?
	;;

	## Same shape as --magic-grooming-to-backlog, target state fixed to
	## pending. Deliberately its own full copy, not a shared helper -- see
	## this file's own header note.
	--magic-grooming-to-pending)
		shift
		## <team-member> captured for future logging/validation, unused today --
		## see --magic-grooming-to-backlog's own comment above.
		local callingMember="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$callingMember" ] || [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-pending: syntax is <team-member> <item-filename> --from-state:<state> --owner-header-value <value> [--header:<upsert|append|remove>:name[:value]]... [--upsert-from-stdin|--edit-script-from-stdin:<py|awk>|--edit-patch-from-stdin]" >&2
			set +e ; return 1
		fi
		local fromStateArg="" owner=""
		local passthrough=()
		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-state:*) fromStateArg="$1" ; shift ;;
				--owner-header-value)
					if [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-pending: --owner-header-value: value required" >&2
						set +e ; return 1
					fi
					owner="$2" ; shift 2
				;;
				--header:*|--upsert-from-stdin|--edit-script-from-stdin:*|--edit-patch-from-stdin)
					passthrough+=( "$1" ) ; shift
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-pending: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$fromStateArg" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-pending: --from-state:<state> is required" >&2
			set +e ; return 1
		fi
		if [ -z "$owner" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-pending: --owner-header-value <value> is required" >&2
			set +e ; return 1
		fi
		local fromStateVal="${fromStateArg#--from-state:}"
		local groomedAt ; groomedAt="$( date +"%Y-%m-%d %H:%M %z" )"
		DistroAgentsTools --intern-op-board-upsert-move-edit pending "$itemName" \
			"$fromStateArg" \
			--header:upsert:owner:"$owner" \
			--header:upsert:groomed-at:"$groomedAt" \
			--header:upsert:groomed-from:"$fromStateVal" \
			--header:upsert:track:true \
			--context --magic-grooming-to-pending \
			"${passthrough[@]}"
		return $?
	;;

	## Same shape as --magic-grooming-to-backlog, target state fixed to
	## processed. Deliberately its own full copy, not a shared helper -- see
	## this file's own header note.
	--magic-grooming-to-processed)
		shift
		## <team-member> captured for future logging/validation, unused today --
		## see --magic-grooming-to-backlog's own comment above.
		local callingMember="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$callingMember" ] || [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-processed: syntax is <team-member> <item-filename> --from-state:<state> --owner-header-value <value> [--header:<upsert|append|remove>:name[:value]]... [--upsert-from-stdin|--edit-script-from-stdin:<py|awk>|--edit-patch-from-stdin]" >&2
			set +e ; return 1
		fi
		local fromStateArg="" owner=""
		local passthrough=()
		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-state:*) fromStateArg="$1" ; shift ;;
				--owner-header-value)
					if [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-processed: --owner-header-value: value required" >&2
						set +e ; return 1
					fi
					owner="$2" ; shift 2
				;;
				--header:*|--upsert-from-stdin|--edit-script-from-stdin:*|--edit-patch-from-stdin)
					passthrough+=( "$1" ) ; shift
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-processed: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$fromStateArg" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-processed: --from-state:<state> is required" >&2
			set +e ; return 1
		fi
		if [ -z "$owner" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-processed: --owner-header-value <value> is required" >&2
			set +e ; return 1
		fi
		local fromStateVal="${fromStateArg#--from-state:}"
		local groomedAt ; groomedAt="$( date +"%Y-%m-%d %H:%M %z" )"
		## processed-at records when the item ENTERED board-processed, which is
		## the one fact age-based cleanup needs and which nothing else carries.
		## Not the same as groomed-at: a same-state patch re-stamps groomed-at
		## every time it touches the item, so groomed-at drifts forward and
		## cannot answer "how long has this been processed". Deliberately
		## auto-stamped and never caller-supplied, same rule as its siblings.
		##
		## Measured 2026-08-10, which is why this exists: of 115 board-processed
		## items, groomed-at covered 3 and resolved-at covered 9. Filesystem
		## mtime was no help either -- a reference sweep had rewritten 726 files
		## that day, so every mtime recorded the sweep rather than the work. A
		## cleanup pass therefore had to fall back to the date in the filename,
		## which is the item's own date and not when it was processed at all.
		local processedAt ; processedAt="$( date +"%Y-%m-%d %H:%M %z" )"
		DistroAgentsTools --intern-op-board-upsert-move-edit processed "$itemName" \
			"$fromStateArg" \
			--header:upsert:owner:"$owner" \
			--header:upsert:groomed-at:"$groomedAt" \
			--header:upsert:groomed-from:"$fromStateVal" \
			--header:upsert:processed-at:"$processedAt" \
			--header:upsert:track:true \
			--context --magic-grooming-to-processed \
			"${passthrough[@]}"
		return $?
	;;

	## Same shape as --magic-grooming-to-backlog, target state fixed to
	## parked. Deliberately its own full copy, not a shared helper -- see
	## this file's own header note. routine-grooming's own Defer outcome
	## (deliberate deferral by the team's own choice, distinct from blocked/'s
	## external stall), which until now had no dedicated op and fell back to
	## --write-board-item's own two-call move recipe.
	##
	## One of three separate --*-to-parked stubs, deliberately: this one is
	## routine-grooming's, --magic-advance-to-parked is routine-advance's, and
	## --magic-board-to-parked is check-process-board's. Each lives in its own
	## routine's namespace/.include, each carries its own independent
	## validation even where identical today, and all three share the one
	## --intern-op-board-upsert-move-edit implementation.
	##
	## Carries this file's full grooming policy (mandatory --owner-header-value, auto
	## groomed-at/groomed-from/track) exactly as its three siblings do --
	## parked being a deferred state is not a reason to withhold it: the
	## -to-processed sibling stamps the same set onto a terminal state, and
	## track is a grooming provenance marker, not a scheduler input, so it
	## creates none of the periodic action board-parked's own "pure passivity"
	## definition forbids. recheck-date/condition, the fields a parked item
	## actually needs, stay caller-supplied via --header:* -- they are triage
	## judgments this op cannot compute.
	--magic-grooming-to-parked)
		shift
		## <team-member> captured for future logging/validation, unused today --
		## see --magic-grooming-to-backlog's own comment above.
		local callingMember="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$callingMember" ] || [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-parked: syntax is <team-member> <item-filename> --from-state:<state> --owner-header-value <value> [--header:<upsert|append|remove>:name[:value]]... [--upsert-from-stdin|--edit-script-from-stdin:<py|awk>|--edit-patch-from-stdin]" >&2
			set +e ; return 1
		fi
		local fromStateArg="" owner=""
		local passthrough=()
		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-state:*) fromStateArg="$1" ; shift ;;
				--owner-header-value)
					if [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-parked: --owner-header-value: value required" >&2
						set +e ; return 1
					fi
					owner="$2" ; shift 2
				;;
				--header:*|--upsert-from-stdin|--edit-script-from-stdin:*|--edit-patch-from-stdin)
					passthrough+=( "$1" ) ; shift
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-parked: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$fromStateArg" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-parked: --from-state:<state> is required" >&2
			set +e ; return 1
		fi
		if [ -z "$owner" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-parked: --owner-header-value <value> is required" >&2
			set +e ; return 1
		fi
		local fromStateVal="${fromStateArg#--from-state:}"
		local groomedAt ; groomedAt="$( date +"%Y-%m-%d %H:%M %z" )"
		DistroAgentsTools --intern-op-board-upsert-move-edit parked "$itemName" \
			"$fromStateArg" \
			--header:upsert:owner:"$owner" \
			--header:upsert:groomed-at:"$groomedAt" \
			--header:upsert:groomed-from:"$fromStateVal" \
			--header:upsert:track:true \
			--context --magic-grooming-to-parked \
			"${passthrough[@]}"
		return $?
	;;

	## Same shape as --magic-grooming-to-backlog, target state fixed to
	## blocked. Deliberately its own full copy, not a shared helper -- see
	## this file's own header note. routine-grooming's own stalled-on-
	## something-external outcome, distinct from parked/ (which is the team
	## deliberately choosing to stop pushing). Retires the two-call
	## --write-board-item recipe that routine-grooming prescribed for this
	## move at four separate sites -- the same non-atomic half-write pattern
	## every other --*-to-* op in this family was built to replace.
	##
	## Deliberately its own grooming-family op rather than a caller of the
	## already-existing --magic-board-to-blocked: routine-grooming calls its
	## own family throughout, so every grooming-driven move carries grooming's
	## own policy stamps by construction rather than by the caller
	## remembering to pass them. Consistency of family over reuse of an
	## existing op -- the human-owner's own call.
	##
	## Carries this file's full grooming policy (mandatory --owner-header-value, auto
	## groomed-at/groomed-from/track) exactly as its four siblings do. That
	## stamping is precisely what distinguishes this op from
	## --magic-board-to-blocked, which stamps nothing: same target state,
	## different owning routine, different recorded provenance.
	## recheck-date/condition, the fields a blocked item needs, stay
	## caller-supplied via --header:* -- they are triage judgments this op
	## cannot compute.
	##
	## EXECUTION-RECEIPT AUTO-STAMP, same rule as --magic-board-to-blocked's
	## own copy in AgentsTools.MagicBoard.include -- board-running->
	## board-blocked always carries an execution-receipt now, auto-stamped
	## blocked:<timestamp> here UNLESS the caller already supplied one via
	## --header:upsert:execution-receipt:*/--header:append:execution-receipt:*,
	## in which case the caller's value stands. Independent case arm, own
	## copy of the check, per this file's own standing "each op owns its own
	## validation" rule.
	--magic-grooming-to-blocked)
		shift
		## <team-member> captured for future logging/validation, unused today --
		## see --magic-grooming-to-backlog's own comment above.
		local callingMember="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$callingMember" ] || [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-blocked: syntax is <team-member> <item-filename> --from-state:<state> --owner-header-value <value> [--header:<upsert|append|remove>:name[:value]]... [--upsert-from-stdin|--edit-script-from-stdin:<py|awk>|--edit-patch-from-stdin]" >&2
			set +e ; return 1
		fi
		local fromStateArg="" owner=""
		local passthrough=()
		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-state:*) fromStateArg="$1" ; shift ;;
				--owner-header-value)
					if [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-blocked: --owner-header-value: value required" >&2
						set +e ; return 1
					fi
					owner="$2" ; shift 2
				;;
				--header:*|--upsert-from-stdin|--edit-script-from-stdin:*|--edit-patch-from-stdin)
					passthrough+=( "$1" ) ; shift
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-blocked: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$fromStateArg" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-blocked: --from-state:<state> is required" >&2
			set +e ; return 1
		fi
		if [ -z "$owner" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-blocked: --owner-header-value <value> is required" >&2
			set +e ; return 1
		fi
		local fromStateVal="${fromStateArg#--from-state:}"
		local groomedAt ; groomedAt="$( date +"%Y-%m-%d %H:%M %z" )"
		local hasExecutionReceipt="false" passthroughEntry
		for passthroughEntry in "${passthrough[@]}" ; do
			case "$passthroughEntry" in
				--header:upsert:execution-receipt:*|--header:append:execution-receipt:*)
					hasExecutionReceipt="true"
				;;
			esac
		done
		if [ "$hasExecutionReceipt" = "false" ] ; then
			local blockedAt ; blockedAt="$( date +"%Y-%m-%d %H:%M %z" )"
			passthrough+=( "--header:upsert:execution-receipt:blocked:$blockedAt" )
		fi
		DistroAgentsTools --intern-op-board-upsert-move-edit blocked "$itemName" \
			"$fromStateArg" \
			--header:upsert:owner:"$owner" \
			--header:upsert:groomed-at:"$groomedAt" \
			--header:upsert:groomed-from:"$fromStateVal" \
			--header:upsert:track:true \
			--context --magic-grooming-to-blocked \
			"${passthrough[@]}"
		return $?
	;;

	## Same shape as --magic-grooming-to-backlog, target state fixed to
	## running. Deliberately its own full copy, not a shared helper -- see
	## this file's own header note. routine-grooming's own check-backlog-promote
	## dispatch: "once the thread is genuinely active, move the item to
	## board-running", which that step once described as a two-call move
	## (write the new state, remove the old file) -- the non-atomic
	## half-write every op in this family exists to retire.
	##
	## Distinct from --magic-advance-to-running, which targets the same state:
	## that one is routine-advance's/check-execute-board's own dispatch and
	## owns the started-at auto-stamp; this one is routine-grooming's, and
	## carries grooming's own provenance stamps instead. Same target state,
	## different owning routine, different recorded provenance -- the same
	## split already established between --magic-grooming-to-blocked and
	## --magic-board-to-blocked. routine-grooming calls its own family
	## throughout, so a grooming-driven move carries grooming's stamps by
	## construction rather than by the caller remembering to pass them.
	##
	## Carries this file's full grooming policy (mandatory --owner-header-value, auto
	## groomed-at/groomed-from/track) exactly as its siblings do. Anything
	## this op does not own -- started-at included -- stays caller-supplied
	## via --header:*.
	--magic-grooming-to-running)
		shift
		## <team-member> captured for future logging/validation, unused today --
		## see --magic-grooming-to-backlog's own comment above.
		local callingMember="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$callingMember" ] || [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-running: syntax is <team-member> <item-filename> --from-state:<state> --owner-header-value <value> [--header:<upsert|append|remove>:name[:value]]... [--upsert-from-stdin|--edit-script-from-stdin:<py|awk>|--edit-patch-from-stdin]" >&2
			set +e ; return 1
		fi
		local fromStateArg="" owner=""
		local passthrough=()
		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-state:*) fromStateArg="$1" ; shift ;;
				--owner-header-value)
					if [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-running: --owner-header-value: value required" >&2
						set +e ; return 1
					fi
					owner="$2" ; shift 2
				;;
				--header:*|--upsert-from-stdin|--edit-script-from-stdin:*|--edit-patch-from-stdin)
					passthrough+=( "$1" ) ; shift
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-running: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$fromStateArg" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-running: --from-state:<state> is required" >&2
			set +e ; return 1
		fi
		if [ -z "$owner" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-running: --owner-header-value <value> is required" >&2
			set +e ; return 1
		fi
		local fromStateVal="${fromStateArg#--from-state:}"
		local groomedAt ; groomedAt="$( date +"%Y-%m-%d %H:%M %z" )"
		DistroAgentsTools --intern-op-board-upsert-move-edit running "$itemName" \
			"$fromStateArg" \
			--header:upsert:owner:"$owner" \
			--header:upsert:groomed-at:"$groomedAt" \
			--header:upsert:groomed-from:"$fromStateVal" \
			--header:upsert:track:true \
			--context --magic-grooming-to-running \
			"${passthrough[@]}"
		return $?
	;;

	## Same shape as --magic-grooming-to-backlog, target state fixed to
	## archived. Deliberately its own full copy, not a shared helper -- see
	## this file's own header note. routine-grooming's own Drop outcome
	## (dropped with no future intent), plus the two archived exits from its
	## re-check steps: a parked item whose trigger the group concludes is
	## never coming, and a blocked item the group decides is not worth even
	## waiting on. That routine once named this move as having no stub and
	## staying a two-call recipe -- this op is what retired it.
	##
	## board-archived is terminal, which is not a reason to withhold the
	## grooming stamps: --magic-grooming-to-processed already stamps the same
	## set onto a terminal state, and the provenance of who archived an item
	## and out of which state is exactly what a later reader of an archived
	## item needs. archive:/the archived item's own reason text stay
	## caller-supplied via --header:*/the body-input modes -- judgments this
	## op cannot compute.
	--magic-grooming-to-archived)
		shift
		## <team-member> captured for future logging/validation, unused today --
		## see --magic-grooming-to-backlog's own comment above.
		local callingMember="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$callingMember" ] || [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-archived: syntax is <team-member> <item-filename> --from-state:<state> --owner-header-value <value> [--header:<upsert|append|remove>:name[:value]]... [--upsert-from-stdin|--edit-script-from-stdin:<py|awk>|--edit-patch-from-stdin]" >&2
			set +e ; return 1
		fi
		local fromStateArg="" owner=""
		local passthrough=()
		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-state:*) fromStateArg="$1" ; shift ;;
				--owner-header-value)
					if [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-archived: --owner-header-value: value required" >&2
						set +e ; return 1
					fi
					owner="$2" ; shift 2
				;;
				--header:*|--upsert-from-stdin|--edit-script-from-stdin:*|--edit-patch-from-stdin)
					passthrough+=( "$1" ) ; shift
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-archived: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$fromStateArg" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-archived: --from-state:<state> is required" >&2
			set +e ; return 1
		fi
		if [ -z "$owner" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-archived: --owner-header-value <value> is required" >&2
			set +e ; return 1
		fi
		local fromStateVal="${fromStateArg#--from-state:}"
		local groomedAt ; groomedAt="$( date +"%Y-%m-%d %H:%M %z" )"
		DistroAgentsTools --intern-op-board-upsert-move-edit archived "$itemName" \
			"$fromStateArg" \
			--header:upsert:owner:"$owner" \
			--header:upsert:groomed-at:"$groomedAt" \
			--header:upsert:groomed-from:"$fromStateVal" \
			--header:upsert:track:true \
			--context --magic-grooming-to-archived \
			"${passthrough[@]}"
		return $?
	;;

	## Same shape as --magic-grooming-to-backlog, target state fixed to
	## retained. Deliberately its own full copy, not a shared helper -- see
	## this file's own header note.
	##
	## READ THIS BEFORE INFERRING ANYTHING FROM THIS OP'S EXISTENCE:
	## routine-grooming does NOT move items into board-retained, and this op
	## is not evidence that it does. Moving an item into board-retained is
	## routine-heartbeat's own GC diversion (magic-team.board.md's GC
	## sub-step: a board-processed item still referenced by another live
	## board-item diverts to board-retained instead of being removed).
	## Grooming's only involvement with board-retained is its
	## recheck-and-exit step, and this op serves exactly one case from it.
	##
	## That case is a SAME-STATE PATCH, not a move: routine-grooming's
	## board-retained recheck-and-exit, "still referenced -> stays,
	## recheck-date renewed", which that step described as a --write-board-item
	## single call in the same state. Called as --from-state:retained, so
	## source and target match --
	## --intern-op-board-upsert-move-edit reads-and-preserves the existing body
	## whenever --from-state equals the target state, so nothing relocates and
	## the item's content survives untouched. Same same-state mechanism
	## --magic-advance-to-running already uses with --from-state:running.
	## The renewed recheck-date itself is caller-supplied via --header:* -- it
	## is a scheduling judgment this op cannot compute.
	##
	## Carries this file's full grooming policy (mandatory --owner-header-value, auto
	## groomed-at/groomed-from/track) exactly as its siblings do. On a
	## same-state call groomed-from records retained, which is correct and
	## intended: it says this item was groomed while sitting in retained, not
	## that it arrived from somewhere else.
	--magic-grooming-to-retained)
		shift
		## <team-member> captured for future logging/validation, unused today --
		## see --magic-grooming-to-backlog's own comment above.
		local callingMember="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$callingMember" ] || [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-retained: syntax is <team-member> <item-filename> --from-state:<state> --owner-header-value <value> [--header:<upsert|append|remove>:name[:value]]... [--upsert-from-stdin|--edit-script-from-stdin:<py|awk>|--edit-patch-from-stdin]" >&2
			set +e ; return 1
		fi
		local fromStateArg="" owner=""
		local passthrough=()
		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-state:*) fromStateArg="$1" ; shift ;;
				--owner-header-value)
					if [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-retained: --owner-header-value: value required" >&2
						set +e ; return 1
					fi
					owner="$2" ; shift 2
				;;
				--header:*|--upsert-from-stdin|--edit-script-from-stdin:*|--edit-patch-from-stdin)
					passthrough+=( "$1" ) ; shift
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-retained: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$fromStateArg" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-retained: --from-state:<state> is required" >&2
			set +e ; return 1
		fi
		if [ -z "$owner" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-retained: --owner-header-value <value> is required" >&2
			set +e ; return 1
		fi
		local fromStateVal="${fromStateArg#--from-state:}"
		local groomedAt ; groomedAt="$( date +"%Y-%m-%d %H:%M %z" )"
		DistroAgentsTools --intern-op-board-upsert-move-edit retained "$itemName" \
			"$fromStateArg" \
			--header:upsert:owner:"$owner" \
			--header:upsert:groomed-at:"$groomedAt" \
			--header:upsert:groomed-from:"$fromStateVal" \
			--header:upsert:track:true \
			--context --magic-grooming-to-retained \
			"${passthrough[@]}"
		return $?
	;;

	## --magic-grooming-create-<state>: routine-grooming's own FIRST WRITE of a
	## board-item, as against the --magic-grooming-to-<state> family above,
	## which moves an item that already exists. Separate ops because they are
	## separate steps, not because the intern-op needs it: a create has no
	## source state, so --from-state: is meaningless here and every one of
	## these arms rejects it outright rather than quietly ignoring it.
	##
	## Five arms because routine-grooming has five creating landings, derived
	## from the routine itself:
	##   backlog   -- Promoted, the default landing for an inbox item the
	##                authority group promotes ("a fresh file, one write")
	##   processed -- a promoted-or-denied item landing with its resolution
	##                text attached
	##   pending   -- the same promotion when the group's own context already
	##                warrants approved-by/approved-at at creation
	##   blocked   -- the same promotion when it instead needs human-owner
	##                approval, so the promoted item lands blocked
	##   running   -- the approval-* item that negotiation runs in
	## check-process-board's own approval-* creation is NOT one of these: it is
	## that procedure's step, so it gets its own --magic-board-create-running
	## in AgentsTools.MagicBoard.include.
	##
	## groomed-from is deliberately NOT stamped by any create arm. It records
	## the state an item moved FROM, and a created item moved from nowhere;
	## a sentinel value there would be a false record of a transition that
	## never happened, which is exactly the class of silent-wrong-value defect
	## this family exists to avoid. owner/groomed-at/track are stamped as
	## everywhere else in this file.
	##
	## A body-input mode is REQUIRED on create, unlike on a move. A move
	## carries the existing body forward when none is given; a create has no
	## existing body, so omitting one would file an empty board-item. Each arm
	## enforces that itself.
	##
	## communication-channel-id, blocks/blocked-by, approved-by/
	## approved-at and references all ride the ordinary --header:* passthrough
	## at creation time -- the routine requires them set in the same single
	## write, and this shape is what makes that one call rather than two.
	## Target fixed to backlog -- the Promoted default landing. Its own full
	## copy, not shared with its four create siblings: same standing rule as
	## the --magic-grooming-to-* family, each op owning its own validation so
	## it can grow state-specific checks without disturbing the others.
	--magic-grooming-create-backlog)
		local createOp="$1"
		local createState="backlog"
		shift
		## <team-member> captured for future logging/validation, unused today --
		## see --magic-grooming-to-backlog's own comment above.
		local callingMember="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$callingMember" ] || [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD $createOp: syntax is <team-member> <item-filename> --owner-header-value <value> (--upsert-from-stdin|--edit-script-from-stdin:<py|awk>|--edit-patch-from-stdin) [--header:<upsert|append|remove>:name[:value]]..." >&2
			set +e ; return 1
		fi
		local owner="" bodyMode=""
		local passthrough=()
		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-state:*)
					echo "⛔ ERROR: $MDSC_CMD $createOp: --from-state: is not valid here -- this op creates a board-item, and a created item has no source state. Use --magic-grooming-to-${createState} to move an item that already exists." >&2
					set +e ; return 1
				;;
				--owner-header-value)
					if [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD $createOp: --owner-header-value: value required" >&2
						set +e ; return 1
					fi
					owner="$2" ; shift 2
				;;
				--upsert-from-stdin|--edit-script-from-stdin:*|--edit-patch-from-stdin)
					bodyMode="$1"
					passthrough+=( "$1" ) ; shift
				;;
				--header:*)
					passthrough+=( "$1" ) ; shift
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD $createOp: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$owner" ] ; then
			echo "⛔ ERROR: $MDSC_CMD $createOp: --owner-header-value <value> is required" >&2
			set +e ; return 1
		fi
		if [ -z "$bodyMode" ] ; then
			echo "⛔ ERROR: $MDSC_CMD $createOp: one body-input mode is required on create (--upsert-from-stdin|--edit-script-from-stdin:<py|awk>|--edit-patch-from-stdin) -- a created board-item has no existing body to carry forward, and filing an empty one is never intended" >&2
			set +e ; return 1
		fi
		local groomedAt ; groomedAt="$( date +"%Y-%m-%d %H:%M %z" )"
		DistroAgentsTools --intern-op-board-upsert-move-edit "$createState" "$itemName" \
			--create \
			--header:upsert:owner:"$owner" \
			--header:upsert:groomed-at:"$groomedAt" \
			--header:upsert:track:true \
			--context "$createOp" \
			"${passthrough[@]}"
		return $?
	;;

	## Target fixed to processed -- a promoted-or-denied item landing with its
	## resolution text attached at the same single write. Its own full copy, same standing rule as every
	## sibling in this file: each op owns its own validation.
	--magic-grooming-create-processed)
		local createOp="$1"
		local createState="processed"
		shift
		## <team-member> captured for future logging/validation, unused today --
		## see --magic-grooming-to-backlog's own comment above.
		local callingMember="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$callingMember" ] || [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD $createOp: syntax is <team-member> <item-filename> --owner-header-value <value> (--upsert-from-stdin|--edit-script-from-stdin:<py|awk>|--edit-patch-from-stdin) [--header:<upsert|append|remove>:name[:value]]..." >&2
			set +e ; return 1
		fi
		local owner="" bodyMode=""
		local passthrough=()
		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-state:*)
					echo "⛔ ERROR: $MDSC_CMD $createOp: --from-state: is not valid here -- this op creates a board-item, and a created item has no source state. Use --magic-grooming-to-${createState} to move an item that already exists." >&2
					set +e ; return 1
				;;
				--owner-header-value)
					if [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD $createOp: --owner-header-value: value required" >&2
						set +e ; return 1
					fi
					owner="$2" ; shift 2
				;;
				--upsert-from-stdin|--edit-script-from-stdin:*|--edit-patch-from-stdin)
					bodyMode="$1"
					passthrough+=( "$1" ) ; shift
				;;
				--header:*)
					passthrough+=( "$1" ) ; shift
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD $createOp: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$owner" ] ; then
			echo "⛔ ERROR: $MDSC_CMD $createOp: --owner-header-value <value> is required" >&2
			set +e ; return 1
		fi
		if [ -z "$bodyMode" ] ; then
			echo "⛔ ERROR: $MDSC_CMD $createOp: one body-input mode is required on create (--upsert-from-stdin|--edit-script-from-stdin:<py|awk>|--edit-patch-from-stdin) -- a created board-item has no existing body to carry forward, and filing an empty one is never intended" >&2
			set +e ; return 1
		fi
		local groomedAt ; groomedAt="$( date +"%Y-%m-%d %H:%M %z" )"
		## processed-at: same contract as the --magic-grooming-to-processed
		## arm above -- when the item entered board-processed, auto-stamped,
		## never caller-supplied. A created item enters processed at the
		## moment it is written, so creation time is its entry time.
		local processedAt ; processedAt="$( date +"%Y-%m-%d %H:%M %z" )"
		DistroAgentsTools --intern-op-board-upsert-move-edit "$createState" "$itemName" \
			--create \
			--header:upsert:owner:"$owner" \
			--header:upsert:groomed-at:"$groomedAt" \
			--header:upsert:processed-at:"$processedAt" \
			--header:upsert:track:true \
			--context "$createOp" \
			"${passthrough[@]}"
		return $?
	;;

	## Target fixed to pending -- promotion where the authority group's own
