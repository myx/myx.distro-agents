#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.MagicGrooming.include -- routine-grooming's own --magic-
## grooming-* operation group for DistroAgentsTools.fn.sh's dispatcher.
## Sourced lazily from the `--magic-grooming-*)` wildcard arm via the
## standard $MDLT_ORIGIN-based path. Not standalone: relies on being
## dot-sourced for $1/$@/$MDSC_CMD.
##

case "$1" in

	--magic-grooming-to-backlog)
		shift
		local callingMember="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$callingMember" ] || [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-backlog: syntax is <team-member> <item-filename> --from-state:<state> --owner-header-value <value> [--header:<upsert|append|remove>:name[:value]]... [--upsert-from-stdin|--edit-script-from-stdin:<py|awk>|--edit-patch-from-stdin]" >&2
			set +e ; return 1
		fi
		local fromStateArg="" owner=""
		local passthrough=()
		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-state:*) fromStateArg="$1" ; shift ;;
				--owner-header-value)
					if [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-backlog: --owner-header-value: value required" >&2
						set +e ; return 1
					fi
					owner="$2" ; shift 2
				;;
				--header:*|--upsert-from-stdin|--edit-script-from-stdin:*|--edit-patch-from-stdin)
					passthrough+=( "$1" ) ; shift
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-backlog: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$fromStateArg" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-backlog: --from-state:<state> is required" >&2
			set +e ; return 1
		fi
		if [ -z "$owner" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-backlog: --owner-header-value <value> is required" >&2
			set +e ; return 1
		fi
		local fromStateVal="${fromStateArg#--from-state:}"
		local groomedAt ; groomedAt="$( date +"%Y-%m-%d %H:%M %z" )"
		DistroAgentsTools --intern-op-board-upsert-move-edit backlog "$itemName" \
			"$fromStateArg" \
			--header:upsert:owner:"$owner" \
			--header:upsert:groomed-at:"$groomedAt" \
			--header:upsert:groomed-from:"$fromStateVal" \
			--header:upsert:track:true \
			--context --magic-grooming-to-backlog \
			"${passthrough[@]}"
		return $?
	;;

	--magic-grooming-to-pending)
		shift
		## <team-member> captured for future logging/validation, unused today
		local callingMember="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$callingMember" ] || [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-pending: syntax is <team-member> <item-filename> --from-state:<state> --owner-header-value <value> [--header:<upsert|append|remove>:name[:value]]... [--upsert-from-stdin|--edit-script-from-stdin:<py|awk>|--edit-patch-from-stdin]" >&2
			set +e ; return 1
		fi
		local fromStateArg="" owner=""
		local passthrough=()
		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-state:*) fromStateArg="$1" ; shift ;;
				--owner-header-value)
					if [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-pending: --owner-header-value: value required" >&2
						set +e ; return 1
					fi
					owner="$2" ; shift 2
				;;
				--header:*|--upsert-from-stdin|--edit-script-from-stdin:*|--edit-patch-from-stdin)
					passthrough+=( "$1" ) ; shift
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-pending: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$fromStateArg" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-pending: --from-state:<state> is required" >&2
			set +e ; return 1
		fi
		if [ -z "$owner" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-pending: --owner-header-value <value> is required" >&2
			set +e ; return 1
		fi
		local fromStateVal="${fromStateArg#--from-state:}"
		local groomedAt ; groomedAt="$( date +"%Y-%m-%d %H:%M %z" )"
		DistroAgentsTools --intern-op-board-upsert-move-edit pending "$itemName" \
			"$fromStateArg" \
			--header:upsert:owner:"$owner" \
			--header:upsert:groomed-at:"$groomedAt" \
			--header:upsert:groomed-from:"$fromStateVal" \
			--header:upsert:track:true \
			--context --magic-grooming-to-pending \
			"${passthrough[@]}"
		return $?
	;;

	--magic-grooming-to-processed)
		shift
		## <team-member> captured for future logging/validation, unused today
		local callingMember="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$callingMember" ] || [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-processed: syntax is <team-member> <item-filename> --from-state:<state> --owner-header-value <value> [--header:<upsert|append|remove>:name[:value]]... [--upsert-from-stdin|--edit-script-from-stdin:<py|awk>|--edit-patch-from-stdin]" >&2
			set +e ; return 1
		fi
		local fromStateArg="" owner=""
		local passthrough=()
		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-state:*) fromStateArg="$1" ; shift ;;
				--owner-header-value)
					if [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-processed: --owner-header-value: value required" >&2
						set +e ; return 1
					fi
					owner="$2" ; shift 2
				;;
				--header:*|--upsert-from-stdin|--edit-script-from-stdin:*|--edit-patch-from-stdin)
					passthrough+=( "$1" ) ; shift
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-processed: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$fromStateArg" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-processed: --from-state:<state> is required" >&2
			set +e ; return 1
		fi
		if [ -z "$owner" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-grooming-to-processed: --owner-header-value <value> is required" >&2
			set +e ; return 1
		fi
		local fromStateVal="${fromStateArg#--from-state:}"
		local groomedAt ; groomedAt="$( date +"%Y-%m-%d %H:%M %z" )"
		local processedAt ; processedAt="$( date +"%Y-%m-%d %H:%M %z" )"
		DistroAgentsTools --intern-op-board-upsert-move-edit processed "$itemName" \
			"$fromStateArg" \
			--header:upsert:owner:"$owner" \
			--header:upsert:groomed-at:"$groomedAt" \
			--header:upsert:groomed-from:"$fromStateVal" \
			--header:upsert:processed-at:"$processedAt" \
			--header:upsert:track:true \
			--context --magic-grooming-to-processed \
			"${passthrough[@]}"
		return $?
	;;

	--magic-grooming-to-parked)
		shift
		## <team-member> captured for future logging/validation, unused today
		local callingMember="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$callingMember" ] || [ -z "$itemName" ] ; then
