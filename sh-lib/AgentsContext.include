#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

## Origin-detection context for myx.distro-agents.
##
## Structurally aligned with sibling contexts (RemoteContext.include /
## SystemContext.include): this file now defines an interactive `Require`/
## `Agents` dispatcher pair used by `console-agents-bashrc.rc` fallback
## sessions. DistroAgentsConsole.sh still execs `claude`/`copilot` directly
## when `--cli` is given (see AgentsTools.Make.include's --make-console-script);
## when no CLI is available, the bash fallback uses the dispatcher surface
## defined here.
##
## As with sibling contexts, origin-detection callers may also use this file's
## stable path as an origin marker. `DistroAgentsContext` remains the context
## initializer entrypoint for that role.

: "${MMDAPP:?⛔ ERROR: MMDAPP is not set}"

: "${MDLT_ORIGIN:=$MMDAPP/.local}"

if ! type DistroAgentsContext >/dev/null 2>&1 ; then
	if ! type Require >/dev/null 2>&1 ; then
		Require(){
			local distroCommand="$1" ; shift
			if [ -z "$distroCommand" ] || [ "--help" = "$distroCommand" ] ; then
				( . "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/help/Help.Require.include" )
				set +e ; return 1
			fi
			if type "${distroCommand%.fn.sh}" >/dev/null 2>&1 ; then
				return 0
			fi

			local ITEM
			for ITEM in agents .local system source deploy remote ; do
				if [ -f "$MDLT_ORIGIN/myx/myx.distro-$ITEM/sh-scripts/${distroCommand%.fn.sh}.fn.sh" ] ; then
					. "$MDLT_ORIGIN/myx/myx.distro-$ITEM/sh-scripts/${distroCommand%.fn.sh}.fn.sh"
					return 0
				fi
			done
			source "${distroCommand%.fn.sh}.fn.sh"
		}
	fi

	if ! type Agents >/dev/null 2>&1 ; then
		Agents(){
			if [[ -n "$COMP_LINE" || -n "$COMP_WORDS" ]] && [ "${1#--completion}" = "$1" ]; then
				. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsConsole.CompletionFunction.include"
				return 0
			fi
			case "$1" in
				''|--*)
					( set -e ; . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsConsole.include" "$@" )
					return 0
				;;
			esac
			local distroCommand="$1" ; shift
			if ! type "${distroCommand%.fn.sh}" >/dev/null 2>&1 ; then
				if ! command -v "${distroCommand%.fn.sh}.fn.sh" >/dev/null 2>&1; then
					echo "⛔ ERROR: unknown command: ${distroCommand%.fn.sh}" >&2
					set +e ; return 1
				fi
				. "${distroCommand%.fn.sh}.fn.sh"
			fi

			set +e ; "${distroCommand%.fn.sh}" "$@" || {
				EXITCODE=$?
				echo "⛔ ERROR: exited with error status ($EXITCODE)" >&2
				set +e ; return $EXITCODE
			}
			return 0
		}
	fi

	DistroAgentsContext(){
		case "$1" in
			--is-spec-option)
				case "$2" in
					--run-from-source|--run-from-.local|--run-from-detect|--init-variables|--run-from-path)
						return 0
					;;
				esac
				set +e ; return 1
			;;
			--init-variables|--run-from-detect)
				if [ -n "$MDLT_ORIGIN" ] && [ -n "$MDLT_OPTION" ] ; then
					return 0
				fi
				[ -z "$MDSC_DETAIL" ] || echo "DistroAgentsContext: input spec: $1" >&2
				. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsContext.SetInputSpec.include"
				return 0
			;;
			--run-from-*|--init-*)
				if DistroAgentsContext --is-spec-option "$1" ; then
					[ -z "$MDSC_DETAIL" ] || echo "DistroAgentsContext: input spec: $1" >&2
					. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsContext.SetInputSpec.include"
					return 0
				fi
			;;
		esac
	}
fi

while true ; do
	case "$1" in
		'')
			return 0
		;;
		--verbose)
			export MDSC_DETAIL=true ; shift
			continue
		;;
		--distro-*|--run-from-*|--init-*)
			if DistroAgentsContext --is-spec-option "$1" ; then
				[ -n "$MDSC_DETAIL" ] && echo "DistroAgentsContext: input spec: $1" >&2
				. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsContext.SetInputSpec.include"
				shift
				continue
			fi
			break
		;;
	esac
	return 0
done