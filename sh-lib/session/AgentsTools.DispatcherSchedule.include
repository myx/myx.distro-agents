#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.DispatcherSchedule.include -- the schedule's operations of TeamDispatcher (F7.5, DistroAgentsDispatcher.fn.sh):
## the flags, their setters and the interpreter of a routine's autorun. Sourced by that file, for its functions only.
##
## SCHEDULING IS A CONVENTION WITH AN INTERPRETER, not a subsystem: it is frontmatter a routine declares (`runs-at: <days> <HH:MM>`,
## `runs-after: <routine>`) plus a few configured values, and Dispatcher, which owns the runs and the policy deciding when a run
## starts, reads both. WHERE THE STEPS RUN (S12.12): `AgentsToolsScheduleLoop` is run by a process of its own, the schedule's service thread
## (AgentsTools.ScheduleThread.include, `--intern-schedule`), started on demand by the places that already look at a workspace; the main loop asks
## for that thread rather than running the steps, and runs them itself only where MDAT_SCHEDULE_THREAD is `off`, as every check has it. The flags are derived, never stored: worktime falls out of the timezone, the hours, the days and the clock;
## weekend out of the timezone, its days and the clock. What persists is settings, in the magic-team scope: MDAT_SCHEDULE_COUNTRY,
## _TIMEZONE, _WORKTIME (`<start> <until> <days>`) and _WEEKEND (`<days>`), and the overrides, MDAT_SCHEDULE_EMERGENCY, _OVERTIME and
## _HOLIDAYS (`until <epoch>`, or `on` for one with no end), MDAT_SCHEDULE_LEARNING (`on`) and MDAT_SCHEDULE_SUPERVISED (`on`, S13.1).
## `supervised` is a flag of the run rather than of the hours: while it holds, the loop keeps one supervision run of this rig alive
## (AgentsToolsScheduleSupervision), and the flag going off is what ends it. `holidays` is an override set by hand, as emergency
## and overtime are (`--override-flag holidays [<ttl>]`): while it holds, worktime reads `no (holiday)` whatever the hours say; it overrides
## worktime and nothing else -- emergency and overtime stand. `holding` (MDAT_SCHEDULE_HOLDING), set the same way, makes the loop start nothing. The days are F5.4's: workdays,
## weekend, daily or a list such as mon,thu; workdays and weekend are read against the weekend setting, which is itself a list.
## The zone's offset is that of now, used for the days around now. Every instant here is an epoch (date +%s) and the arithmetic is
## integer arithmetic, never date(1) arithmetic (MAGIC.md).
##

agentsScheduleWeekdays="sun mon tue wed thu fri sat"
agentsScheduleDayList='(mon|tue|wed|thu|fri|sat|sun)(,(mon|tue|wed|thu|fri|sat|sun))*'

type AgentsToolsSpawnRoutineResolve > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SpawnRoutine.include"
type AgentsToolsRoutineKeyOwn > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.RoutineRequirements.include"
type AgentsToolsDispatcherHistory > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.Dispatcher.include"

## The tooling's own function, for the settings and the posts: the loader of ThisSession finds the common library and sources it.
AgentsToolsScheduleTools(){
	type DistroAgentsTools > /dev/null 2>&1 && return 0
	type DistroAgentsSessionTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsSession.fn.sh"
	DistroAgentsSessionTools
}

## A setting of the magic-team scope; nothing printed where none is stored.
AgentsToolsScheduleSetting(){ ## key
	local settingValue
	type AgentsToolsConfigOption > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/config/AgentsTools.ConfigOption.include"
	settingValue="$( AgentsToolsConfigOption magic-team --select-default "$1" "-" 2> /dev/null )" || settingValue="-"
	case "$settingValue" in ''|-) return 0 ;; esac
	printf '%s\n' "$settingValue"
}

## THE DEFAULTS (the owner, 2026-10-21): the computer knows its time, so an unset setting stops nothing. The timezone is the host's (the clock
## reads date(1) with no TZ), the weekend sat,sun, the worktime 09:00 18:00 mon-fri. A setting only overrides its default.
agentsScheduleDefaultWeekend="sat,sun"
agentsScheduleDefaultWorktime="09:00 18:00 mon,tue,wed,thu,fri"
## A setting of the magic-team scope, or its default where none is stored: rc 0 for a stored one, rc 1 where the default stands.
AgentsToolsScheduleValue(){ ## key
	local valueStored
	valueStored="$( AgentsToolsScheduleSetting "$1" )"
	[ -z "$valueStored" ] || { printf '%s\n' "$valueStored" ; return 0 ; }
	case "$1" in
		MDAT_SCHEDULE_WEEKEND) printf '%s\n' "$agentsScheduleDefaultWeekend" ;;
		MDAT_SCHEDULE_WORKTIME) printf '%s\n' "$agentsScheduleDefaultWorktime" ;;
	esac
	return 1
}

## The instant and the zone, as "<epoch> <offset seconds> <weekday 0-6, sunday first> <seconds into the local day>".
AgentsToolsScheduleClock(){
	local clockZone clockEpoch clockOffset clockSeconds clockLocal
	clockZone="$( AgentsToolsScheduleSetting MDAT_SCHEDULE_TIMEZONE )"
	clockEpoch="$( date +%s )"
	if [ -n "$clockZone" ] ; then clockOffset="$( TZ="$clockZone" date +%z )" ; else clockOffset="$( date +%z )" ; fi
	case "$clockOffset" in
		[+-][0-9][0-9][0-9][0-9]) clockSeconds=$(( 10#${clockOffset:1:2} * 3600 + 10#${clockOffset:3:2} * 60 )) ; [ "${clockOffset:0:1}" = "+" ] || clockSeconds=$(( 0 - clockSeconds )) ;;
		*) clockSeconds=0 ;;
	esac
	clockLocal=$(( clockEpoch + clockSeconds ))
	printf '%s %s %s %s\n' "$clockEpoch" "$clockSeconds" "$(( ( clockLocal / 86400 + 4 ) % 7 ))" "$(( clockLocal % 86400 ))"
}

## The name of a weekday number, 0 (sunday) to 6.
AgentsToolsScheduleDayName(){ ## number
	local dayNumber="$1"
	set -- $agentsScheduleWeekdays
	shift "$dayNumber"
	printf '%s\n' "$1"
}

## Whether a weekday (sun..sat) is one of a days value: rc 0 where it is, 1 where it is not, 2 where it cannot be decided (workdays
## or weekend, with no weekend set).
AgentsToolsScheduleDayIn(){ ## days value, weekday name
	local inDays="$1" inDay="$2" inWeekend
	case "$inDays" in
		daily) return 0 ;;
		workdays|weekend)
			inWeekend="$( AgentsToolsScheduleValue MDAT_SCHEDULE_WEEKEND )"
			[ -n "$inWeekend" ] || return 2
			case ",$inWeekend," in *",$inDay,"*) [ "$inDays" = weekend ] ; return $? ;; esac
			[ "$inDays" = workdays ] ; return $?
		;;
		*) case ",$inDays," in *",$inDay,"*) return 0 ;; esac ; return 1 ;;
	esac
}

## Seconds into the day of a time HH:MM; rc 1, nothing printed, for any other form.
## Sets the variable named to the seconds of a HH:MM time and prints nothing, no process: the form a pass takes (call-path audit row 50). rc 1 for a time that is not HH:MM.
AgentsToolsScheduleTimeSecondsInto(){ ## variable name, time
	case "$2" in [01][0-9]:[0-5][0-9]|2[0-3]:[0-5][0-9]) ;; *) return 1 ;; esac
	printf -v "$1" '%s' "$(( 10#${2:0:2} * 3600 + 10#${2:3:2} * 60 ))"
}
## The same printed, for a one-off reader.
AgentsToolsScheduleTimeSeconds(){ ## time
	local timeSec
	AgentsToolsScheduleTimeSecondsInto timeSec "$1" || return 1
	printf '%s\n' "$timeSec"
}

## Worktime now: the words "yes" or "no" and, in brackets, why not where it cannot be told. Needs the clock's words. Given the epoch too, a
## holidays override that holds (MDAT_SCHEDULE_HOLIDAYS) makes it `no (holiday)` whatever the hours say.
AgentsToolsScheduleWorktime(){ ## weekday name, seconds into the day, epoch now (may be empty)
	local workValue workStart workUntil workDays workStartSec workUntilSec workIn
	if [ -n "${3:-}" ] && [ -n "$( AgentsToolsScheduleOverrideLeft MDAT_SCHEDULE_HOLIDAYS "$3" )" ] ; then
		printf 'no (holiday)\n' ; return 0
	fi
	workValue="$( AgentsToolsScheduleValue MDAT_SCHEDULE_WORKTIME )"
	[ -n "$workValue" ] || { printf 'no (not set)\n' ; return 0 ; }
	read -r workStart workUntil workDays <<< "$workValue"
	AgentsToolsScheduleTimeSecondsInto workStartSec "$workStart" || { printf 'no (not set)\n' ; return 0 ; }
	AgentsToolsScheduleTimeSecondsInto workUntilSec "$workUntil" || { printf 'no (not set)\n' ; return 0 ; }
	workIn=0
	AgentsToolsScheduleDayIn "$workDays" "$1" || workIn=$?
	case "$workIn" in
		2) printf 'no (weekend not set)\n' ;;
		0) if [ "$2" -ge "$workStartSec" ] && [ "$2" -lt "$workUntilSec" ] ; then printf 'yes\n' ; else printf 'no\n' ; fi ;;
		*) printf 'no\n' ;;
	esac
}

## Worktime now as one word: yes, or no with the reason in brackets. The collection reads this for the mail TTL stretch T2 asks
## (AgentsTools.Collect.include, AgentsToolsCollectTtlOf), without the whole flags table.
AgentsToolsScheduleWorktimeNow(){
	local nowEpoch nowOffset nowDay nowSeconds
	read -r nowEpoch nowOffset nowDay nowSeconds <<< "$( AgentsToolsScheduleClock )"
	AgentsToolsScheduleWorktime "$( AgentsToolsScheduleDayName "$nowDay" )" "$nowSeconds" "$nowEpoch"
}

## The next start of worktime after an instant, as an epoch; nothing where worktime is not set or cannot be decided.
AgentsToolsScheduleNextWorkStart(){ ## epoch, offset seconds
	local nextValue nextStart nextUntil nextDays nextStartSec nextDay nextCount=0 nextName nextAt
	nextValue="$( AgentsToolsScheduleValue MDAT_SCHEDULE_WORKTIME )"
	[ -n "$nextValue" ] || return 0
	read -r nextStart nextUntil nextDays <<< "$nextValue"
	AgentsToolsScheduleTimeSecondsInto nextStartSec "$nextStart" || return 0
	nextDay=$(( ( $1 + $2 ) / 86400 ))
	while [ "$nextCount" -le 8 ] ; do
		nextName="$( AgentsToolsScheduleDayName "$(( ( nextDay + nextCount + 4 ) % 7 ))" )"
		AgentsToolsScheduleDayIn "$nextDays" "$nextName"
		case $? in 2) return 0 ;; 0)
			nextAt=$(( ( nextDay + nextCount ) * 86400 + nextStartSec - $2 ))
			[ "$nextAt" -le "$1" ] || { printf '%s\n' "$nextAt" ; return 0 ; }
		;; esac
		nextCount=$(( nextCount + 1 ))
	done
}

## What an override says now: "on" for one with no end, the seconds left for one that has not ended, nothing for none or an ended one.
AgentsToolsScheduleOverrideLeft(){ ## setting key, epoch now
	local leftValue leftEnd
	leftValue="$( AgentsToolsScheduleSetting "$1" )"
	case "$leftValue" in
		on) printf 'on\n' ;;
		"until "[0-9]*)
			leftEnd="${leftValue#until }"
			[ "$leftEnd" -le "$2" ] || printf '%s\n' "$(( leftEnd - $2 ))"
		;;
	esac
}

## The seven flags, a line each, in the order of the epic.
AgentsToolsScheduleFlagLine(){ ## flag, weekday name, seconds into the day, epoch now
	local lineLeft lineValue lineTag
	case "$1" in
		worktime)
			lineTag= ; [ -n "$( AgentsToolsScheduleSetting MDAT_SCHEDULE_WORKTIME )" ] || lineTag=" (default)"
			printf 'worktime: %s%s\n' "$( AgentsToolsScheduleWorktime "$2" "$3" "$4" )" "$lineTag"
		;;
		weekend)
			lineTag= ; lineValue="$( AgentsToolsScheduleValue MDAT_SCHEDULE_WEEKEND )" || lineTag=" (default)"
			case ",$lineValue," in *",$2,"*) printf 'weekend: yes%s\n' "$lineTag" ;; *) printf 'weekend: no%s\n' "$lineTag" ;; esac
		;;
		emergency|overtime|holidays|holding)
			lineLeft="$( AgentsToolsScheduleOverrideLeft "MDAT_SCHEDULE_$( printf '%s' "$1" | LC_ALL=C tr 'a-z-' 'A-Z_' )" "$4" )"
			case "$lineLeft" in
				'') printf '%s: no\n' "$1" ;;
				on) printf '%s: yes\n' "$1" ;;
				*) printf '%s: yes (%s seconds left)\n' "$1" "$lineLeft" ;;
			esac
		;;
		learning|supervised)
			[ -n "$( AgentsToolsScheduleOverrideLeft "MDAT_SCHEDULE_$( printf '%s' "$1" | LC_ALL=C tr 'a-z' 'A-Z' )" "$4" )" ] && printf '%s: yes\n' "$1" || printf '%s: no\n' "$1"
		;;
	esac
}

## A member's own flag, `vacation` or `overtime`, set with `--override-flag <flag> --member <member>`: the setting key is the flag and the member, as
## MDAT_SCHEDULE_<FLAG>_<MEMBER>, the member upper-cased and its hyphens as underscores. A member on vacation holds no duty and the schedule starts
## nothing for it; a member on overtime holds a duty out of worktime. Both end at their TTL, or stand until cleared.
## Upper-cases a name in the shell alone, a hyphen to an underscore where asked: a pass makes a key for every member of the roster, and `tr` was
## two processes a key (call-path audit row 50). Bash 3.2 on the fleet has no ${x^^}, so the letters go through one case.
AgentsToolsScheduleUpperInto(){ ## variable name, text, hyphen (keep|underscore)
	local upIn="$2" upOut="" upCh
	while [ -n "$upIn" ] ; do
		upCh="${upIn:0:1}" ; upIn="${upIn:1}"
		case "$upCh" in
			a) upCh=A ;; b) upCh=B ;; c) upCh=C ;; d) upCh=D ;; e) upCh=E ;; f) upCh=F ;; g) upCh=G ;; h) upCh=H ;; i) upCh=I ;; j) upCh=J ;; k) upCh=K ;; l) upCh=L ;; m) upCh=M ;;
			n) upCh=N ;; o) upCh=O ;; p) upCh=P ;; q) upCh=Q ;; r) upCh=R ;; s) upCh=S ;; t) upCh=T ;; u) upCh=U ;; v) upCh=V ;; w) upCh=W ;; x) upCh=X ;; y) upCh=Y ;; z) upCh=Z ;;
			-) [ "${3:-keep}" != underscore ] || upCh=_ ;;
		esac
		upOut="$upOut$upCh"
	done
	printf -v "$1" '%s' "$upOut"
}
## Sets the variable named to the member's flag key and prints nothing: the form a pass takes.
AgentsToolsScheduleMemberKeyInto(){ ## variable name, flag, member
	local keyFlag keyMember
	AgentsToolsScheduleUpperInto keyFlag "$2" keep
	AgentsToolsScheduleUpperInto keyMember "$3" underscore
	printf -v "$1" 'MDAT_SCHEDULE_%s_%s' "$keyFlag" "$keyMember"
}
## The same printed, for a one-off reader.
AgentsToolsScheduleMemberKey(){ ## flag, member
	local memberKey
	AgentsToolsScheduleMemberKeyInto memberKey "$1" "$2"
	printf '%s\n' "$memberKey"
}

## What a member's flag says now, as AgentsToolsScheduleOverrideLeft does: `on`, the seconds left, or nothing.
## A pass asks this for every member of the roster, and each ask is a name made with `tr` and a read of the settings, a dozen processes: so the settings file is
## looked at once for the second of the pass, with one `grep`, and where no member has a vacation or overtime stored the answer is nothing, at no cost.
AgentsToolsScheduleMemberFlag(){ ## flag, member, epoch now
	if [ "${agentsScheduleMemberFlagsAt:-}" != "$MMDAPP:$3" ] ; then
		agentsScheduleMemberFlagsAt="$MMDAPP:$3"
		if LC_ALL=C grep -q -e '^MDAT_SCHEDULE_VACATION_' -e '^MDAT_SCHEDULE_OVERTIME_' "$MMDAPP/.local/.agents/magic-team.agent.env" 2> /dev/null ; then
			agentsScheduleMemberFlagsAny=yes
		else
			agentsScheduleMemberFlagsAny=no
		fi
	fi
	[ "$agentsScheduleMemberFlagsAny" = yes ] || return 0
	local memberFlagKey
	AgentsToolsScheduleMemberKeyInto memberFlagKey "$1" "$2"
	AgentsToolsScheduleOverrideLeft "$memberFlagKey" "$3"
}

## --current-flags: worktime, weekend, holidays, holding, emergency, overtime, learning and supervised, a line each, `<flag>: yes|no`. Read-only.
AgentsToolsScheduleCurrentFlags(){ ## the operation as it was called, its arguments...
	local flagsOp="$1" flagsEpoch flagsOffset flagsDay flagsSeconds flagsFlag
	if [ $# -gt 1 ] ; then
		echo "⛔ ERROR: $MDSC_CMD $flagsOp: takes no argument, got: $2" >&2
		return 1
	fi
	AgentsToolsScheduleTools || return 1
	read -r flagsEpoch flagsOffset flagsDay flagsSeconds <<< "$( AgentsToolsScheduleClock )"
	for flagsFlag in worktime weekend holidays holding emergency overtime learning supervised planned-maintenance ; do
		AgentsToolsScheduleFlagLine "$flagsFlag" "$( AgentsToolsScheduleDayName "$flagsDay" )" "$flagsSeconds" "$flagsEpoch"
	done
	## The pace a start is gated on, and the members' own flags: one picture, whichever door reads it (--current-flags here, --flags at
	## the coordinator's surface, which relays this output and keeps no loop of its own).
	AgentsToolsSchedulePaceText 2> /dev/null || :
	AgentsToolsScheduleMemberFlagLines "$flagsEpoch"
	return 0
}

## The members' own flags that hold now, a line each as `<flag>: <member> (<seconds left>)`, or `member flags: none` where there is none.
AgentsToolsScheduleMemberFlagLines(){ ## epoch
	local memberName memberDir memberFlag memberLeft memberShown=""
	type AgentsToolsTeamMemberDirectoryText > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.TeamRegistry.include" > /dev/null 2>&1 || { printf 'member flags: none\n' ; return 0 ; }
	while IFS=$'\t' read -r memberName memberDir ; do
		[ -n "$memberDir" ] || continue
		case "$memberName" in human-owner|magic-team) continue ;; esac
		for memberFlag in vacation overtime ; do
			memberLeft="$( AgentsToolsScheduleMemberFlag "$memberFlag" "$memberName" "$1" 2> /dev/null )"
			case "$memberLeft" in
				'') ;;
				on) printf '%s: %s\n' "$memberFlag" "$memberName" ; memberShown=yes ;;
				*) printf '%s: %s (%s seconds left)\n' "$memberFlag" "$memberName" "$memberLeft" ; memberShown=yes ;;
			esac
		done
	done <<< "$( AgentsToolsTeamMemberDirectoryText 2> /dev/null )"
	[ -n "$memberShown" ] || printf 'member flags: none\n'
	return 0
}

## The setters: --set-country, --set-timezone, --set-worktime and --set-weekend, each one setting of the magic-team scope, printed back
## as `<setting>: <value>`. A value of another form is refused, rc 1, and nothing is stored.
AgentsToolsScheduleSet(){ ## the operation as it was called, its arguments...
	local setOp="$1" setKey setValue setStart setUntil setDays
	shift
	case "$setOp" in
		--set-country)
			setKey="MDAT_SCHEDULE_COUNTRY"
			if [ $# -ne 1 ] || ! printf '%s\n' "${1:-}" | LC_ALL=C grep -q -E '^[A-Za-z]{2,3}$' ; then
				echo "⛔ ERROR: $MDSC_CMD $setOp: syntax is <iso-code-2-or-3-letters>, got: ${*:-nothing}" >&2 ; return 1
			fi
			setValue="$( printf '%s' "$1" | LC_ALL=C tr 'a-z' 'A-Z' )"
		;;
		--set-timezone)
			setKey="MDAT_SCHEDULE_TIMEZONE"
			if [ $# -ne 1 ] || ! printf '%s\n' "${1:-}" | LC_ALL=C grep -q -E '^[A-Za-z][A-Za-z0-9_+-]*(/[A-Za-z0-9_+-]+)*$' || [ ! -f "/usr/share/zoneinfo/$1" ] ; then
				echo "⛔ ERROR: $MDSC_CMD $setOp: syntax is <tz-spec>, a zone name of this system such as Pacific/Auckland, got: ${*:-nothing}" >&2 ; return 1
			fi
			setValue="$1"
		;;
		--set-worktime)
			setKey="MDAT_SCHEDULE_WORKTIME"
			setStart="${1:-}" setUntil="${2:-}" setDays="${3:-}"
			if [ $# -ne 3 ] ; then
				echo "⛔ ERROR: $MDSC_CMD $setOp: syntax is <start HH:MM> <until HH:MM> <days-of-week>, got: ${*:-nothing}" >&2 ; return 1
			fi
			AgentsToolsScheduleTimeSeconds "$setStart" > /dev/null && AgentsToolsScheduleTimeSeconds "$setUntil" > /dev/null \
				&& [ "$( AgentsToolsScheduleTimeSeconds "$setStart" )" -lt "$( AgentsToolsScheduleTimeSeconds "$setUntil" )" ] || {
				echo "⛔ ERROR: $MDSC_CMD $setOp: the times are HH:MM, the start before the until, got: $setStart $setUntil" >&2 ; return 1
			}
			case "$setDays" in
				daily|workdays|weekend) ;;
				*) printf '%s\n' "$setDays" | LC_ALL=C grep -q -E "^$agentsScheduleDayList\$" || {
					echo "⛔ ERROR: $MDSC_CMD $setOp: the days are workdays, weekend, daily or a list such as mon,thu, got: $setDays" >&2 ; return 1
				} ;;
			esac
			setValue="$setStart $setUntil $setDays"
		;;
		--set-weekend)
			setKey="MDAT_SCHEDULE_WEEKEND"
			if [ $# -ne 1 ] || ! printf '%s\n' "${1:-}" | LC_ALL=C grep -q -E "^$agentsScheduleDayList\$" ; then
				echo "⛔ ERROR: $MDSC_CMD $setOp: the weekend is a list of days such as sat,sun, got: ${*:-nothing}" >&2 ; return 1
			fi
			setValue="$1"
		;;
	esac
	AgentsToolsScheduleTools || return 1
	type AgentsToolsConfigOption > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/config/AgentsTools.ConfigOption.include"
	AgentsToolsConfigOption magic-team --upsert "$setKey" "$setValue" > /dev/null || {
		echo "⛔ ERROR: $MDSC_CMD $setOp: $setKey could not be stored" >&2 ; return 1
	}
	printf '%s: %s\n' "$setKey" "$setValue"
}

## --override-flag [--no] <flag> [<ttl>] [--days <n>]: emergency, overtime, holidays, learning and supervised are overridable, as settings;
## worktime and weekend are derived.
## emergency is set with a TTL in whole seconds, and a second call prolongs it (its end is the TTL from then); overtime is for outside
## worktime and ends at its TTL or, if that is later or there is none, when normal worktime starts, and `--days <n>`, overtime's alone, ends it
## n worktime starts ahead instead, the earlier end winning; holidays is set with a TTL or, with none, until
## it is cleared, at any hour, and makes worktime read `no (holiday)` while it holds; learning and supervised are on or off and take no
## TTL. --no clears the override. Prints the flag's line as --current-flags would.
AgentsToolsScheduleOverride(){ ## the operation as it was called, its arguments...
	local overOp="$1" overNo="" overFlag="" overTtl="" overDays="" overCount overEpoch overOffset overDay overSeconds overName overNext overEnd overKey overMember="" overLeft
	shift
	[ "${1:-}" != "--no" ] || { overNo="no" ; shift ; }
	overFlag="${1:-}"
	[ $# -eq 0 ] || shift
	while [ $# -gt 0 ] ; do
		case "$1" in
			--member)
				overMember="${2:-}"
				if [ -z "$overMember" ] ; then
					echo "⛔ ERROR: $MDSC_CMD $overOp: --member is a member name, got: nothing" >&2 ; return 1
				fi
				shift 2
			;;
			--days)
				overDays="${2:-}"
				if [ -z "$overDays" ] ; then
					echo "⛔ ERROR: $MDSC_CMD $overOp: --days is a whole number of days, 1 or more, got: nothing" >&2 ; return 1
				fi
				shift 2
			;;
			*)
				[ -z "$overTtl" ] || break
				overTtl="$1" ; shift
			;;
		esac
	done
	if [ -z "$overFlag" ] || [ $# -gt 0 ] ; then
		echo "⛔ ERROR: $MDSC_CMD $overOp: syntax is [--no] <flag> [<ttl>] [--days <n>], the flag emergency, overtime, holidays, holding, learning or supervised, or vacation or overtime with --member <member>" >&2 ; return 1
	fi
	case "$overFlag" in
		emergency|overtime|holidays|holding|vacation|learning|supervised|planned-maintenance) ;;
		worktime|weekend)
			echo "⛔ ERROR: $MDSC_CMD $overOp: $overFlag is derived from the settings and the clock and has no override -- set it with --set-$overFlag" >&2 ; return 1
		;;
		*)
			echo "⛔ ERROR: $MDSC_CMD $overOp: no flag $overFlag -- the flags are worktime, weekend, holidays, holding, emergency, overtime, learning and supervised, and all but worktime and weekend are overridable" >&2 ; return 1
		;;
	esac
	case "$overFlag:$overMember" in
		vacation:) echo "⛔ ERROR: $MDSC_CMD $overOp: vacation is the flag of one member -- syntax is vacation --member <member> [<ttl>]" >&2 ; return 1 ;;
		?*:?*)
			case "$overFlag" in
				vacation|overtime) [ -z "$overDays" ] || { echo "⛔ ERROR: $MDSC_CMD $overOp: --days belongs to the team overtime, and a member's flag takes none" >&2 ; return 1 ; } ;;
				*) echo "⛔ ERROR: $MDSC_CMD $overOp: --member belongs to vacation and overtime alone, and $overFlag is a team flag" >&2 ; return 1 ;;
			esac
		;;
	esac
	if [ -n "$overDays" ] && [ "$overFlag" != overtime ] ; then
		echo "⛔ ERROR: $MDSC_CMD $overOp: --days belongs to overtime alone, and $overFlag takes none -- overtime ends at the worktime that many starts ahead" >&2 ; return 1
	fi
	if [ -n "$overTtl" ] && ! printf '%s\n' "$overTtl" | LC_ALL=C grep -q -E '^[1-9][0-9]*$' ; then
		echo "⛔ ERROR: $MDSC_CMD $overOp: a TTL is whole seconds, 1 or more, got: $overTtl" >&2 ; return 1
	fi
	if [ -n "$overDays" ] && ! printf '%s\n' "$overDays" | LC_ALL=C grep -q -E '^[1-9][0-9]*$' ; then
		echo "⛔ ERROR: $MDSC_CMD $overOp: --days is a whole number of days, 1 or more, got: $overDays" >&2 ; return 1
	fi
	if [ -n "$overNo" ] && [ -n "$overTtl$overDays" ] ; then
		echo "⛔ ERROR: $MDSC_CMD $overOp: --no clears the override and takes no TTL and no --days" >&2 ; return 1
	fi
	## A flag written with a hyphen (planned-maintenance) keeps a setting key of letters and underscores.
	overKey="MDAT_SCHEDULE_$( printf '%s' "$overFlag" | LC_ALL=C tr 'a-z-' 'A-Z_' )"
	[ -z "$overMember" ] || AgentsToolsScheduleMemberKeyInto overKey "$overFlag" "$overMember"
	AgentsToolsScheduleTools || return 1
	read -r overEpoch overOffset overDay overSeconds <<< "$( AgentsToolsScheduleClock )"
	overName="$( AgentsToolsScheduleDayName "$overDay" )"
	if [ -n "$overNo" ] ; then
		type AgentsToolsConfigOption > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/config/AgentsTools.ConfigOption.include"
		AgentsToolsConfigOption magic-team --delete "$overKey" > /dev/null 2>&1 || :
	else
		case "${overMember:+member-}$overFlag" in
			member-vacation|member-overtime)
				if [ -n "$overTtl" ] ; then overEnd="until $(( overEpoch + overTtl ))" ; else overEnd="on" ; fi
			;;
			emergency)
				[ -n "$overTtl" ] || { echo "⛔ ERROR: $MDSC_CMD $overOp: emergency is set with a TTL in seconds -- syntax is emergency <ttl>" >&2 ; return 1 ; }
				overEnd="until $(( overEpoch + overTtl ))"
			;;
			holidays|holding)
				if [ -n "$overTtl" ] ; then overEnd="until $(( overEpoch + overTtl ))" ; else overEnd="on" ; fi
			;;
			planned-maintenance)
				## PLANNED MAINTENANCE (epic S14): magic-devops does planned work without an alarm spawning anyone, for a TTL; setting it is never
				## silent. The monitoring reads it (AgentsTools.Monitoring.include) and prints its alarms as muted while it holds.
				[ -n "$overTtl" ] || { echo "⛔ ERROR: $MDSC_CMD $overOp: planned-maintenance is set with a TTL in seconds -- syntax is planned-maintenance <ttl>" >&2 ; return 1 ; }
				overEnd="until $(( overEpoch + overTtl ))"
			;;
			learning|supervised)
				[ -z "$overTtl" ] || { echo "⛔ ERROR: $MDSC_CMD $overOp: $overFlag is on or off and takes no TTL" >&2 ; return 1 ; }
				overEnd="on"
			;;
			overtime)
				if [ "$( AgentsToolsScheduleWorktime "$overName" "$overSeconds" "$overEpoch" )" = "yes" ] ; then
					echo "⛔ ERROR: $MDSC_CMD $overOp: overtime is for outside worktime, and worktime is on now" >&2 ; return 1
				fi
				overNext="$( AgentsToolsScheduleNextWorkStart "$overEpoch" "$overOffset" )"
				if [ -n "$overDays" ] ; then
					overCount=1
					while [ -n "$overNext" ] && [ "$overCount" -lt "$overDays" ] ; do
						overNext="$( AgentsToolsScheduleNextWorkStart "$overNext" "$overOffset" )"
						overCount=$(( overCount + 1 ))
					done
					[ -n "$overNext" ] || { echo "⛔ ERROR: $MDSC_CMD $overOp: --days $overDays names a worktime start that far ahead, and the worktime setting gives none that far" >&2 ; return 1 ; }
				fi
				if [ -n "$overTtl" ] ; then
					overEnd=$(( overEpoch + overTtl ))
					[ -z "$overNext" ] || [ "$overEnd" -le "$overNext" ] || overEnd="$overNext"
					overEnd="until $overEnd"
				elif [ -n "$overNext" ] ; then
					overEnd="until $overNext"
				else
					overEnd="on"
				fi
			;;
		esac
		type AgentsToolsConfigOption > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/config/AgentsTools.ConfigOption.include"
		AgentsToolsConfigOption magic-team --upsert "$overKey" "$overEnd" > /dev/null || {
			echo "⛔ ERROR: $MDSC_CMD $overOp: $overKey could not be stored" >&2 ; return 1
		}
	fi
	## PLANNED MAINTENANCE IS NEVER SILENT (epic S14): its setting and its clearing go to event-track, as a note of magic-devops, queued
	## and never waited for. A post that cannot be made changes nothing of the flag.
	if [ "$overFlag" = planned-maintenance ] && type DistroAgentsTools > /dev/null 2>&1 ; then
		if [ -n "$overNo" ] ; then
			printf 'planned-maintenance cleared by %s\n' "${MDAT_SPAWN_AGENT:-${USER:-the console}}"
		else
			printf 'planned-maintenance set %s by %s: alarms of the monitoring print as muted until then\n' "$overEnd" "${MDAT_SPAWN_AGENT:-${USER:-the console}}"
		fi | MDAT_EVENT_TRACK_POST_NOWAIT=1 DistroAgentsTools --intern-op-event-track-post magic-devops event-track --kind maintenance --from-stdin > /dev/null 2>&1 || :
	fi
	if [ -n "$overMember" ] ; then
		overLeft="$( AgentsToolsScheduleMemberFlag "$overFlag" "$overMember" "$overEpoch" )"
		case "$overLeft" in
			'') printf '%s %s: no\n' "$overFlag" "$overMember" ;;
			on) printf '%s %s: yes\n' "$overFlag" "$overMember" ;;
			*) printf '%s %s: yes (%s seconds left)\n' "$overFlag" "$overMember" "$overLeft" ;;
		esac
		return 0
	fi
	AgentsToolsScheduleFlagLine "$overFlag" "$overName" "$overSeconds" "$overEpoch"
}

## THE AUTORUN. A routine declares `runs-at: <days> <HH:MM>` (or `none`) and, apart from it, `runs-after: <routine>`. The day is the
## period, in the team's zone: it runs once on each of its days, from its time on. The time is the earliest start. Where a predecessor
## is named it is the trigger, and the routine is due when the predecessor completed (spawn-succeeded) that day, so the chain needs no
## waiting state; the time is then a not-before. The run history that decides it is Dispatcher's (AgentsToolsDispatcherHistory).

## The line of a chain that stopped, posted once: the last day the routine was to run has passed, the predecessor did not complete on it
## and the routine did not run on it. Posted to the event-alert channel from the tooling-note template (Schedule/chain-broken), recorded
## in $MMDAPP/.local/agents/schedule/escalated/<routine>.<day> so it is posted once. A day that ended before the evaluator first looked
## at the routine (schedule/seen/<routine>, the instant, kept by the first call) is not escalated: a chain just declared did not break.
## Prints the ESCALATE line, and only for the call that posts.
AgentsToolsScheduleChainCheck(){ ## routine name, predecessor selector, days value, epoch now, offset seconds
	local chainName="$1" chainDays="$3" chainEpoch="$4" chainOffset="$5" chainPredFile chainPredName chainStore chainSeen chainDayNo chainBack=1 chainFound="" chainIn chainStart chainEnd chainDate chainMark chainText
	chainPredFile="$( AgentsToolsSpawnRoutineResolve "$2" 2> /dev/null )" || return 0
	chainPredName="${chainPredFile##*/}"
	chainStore="$MMDAPP/.local/agents/schedule"
	mkdir -p "$chainStore/seen" "$chainStore/escalated" 2> /dev/null || return 0
	( set -C ; printf '%s\n' "$chainEpoch" > "$chainStore/seen/$chainName" ) 2> /dev/null || :
	chainSeen="$( cat "$chainStore/seen/$chainName" 2> /dev/null )"
	case "$chainSeen" in ''|*[!0123456789]*) return 0 ;; esac
	while [ "$chainBack" -le 7 ] ; do
		chainDayNo=$(( ( chainEpoch + chainOffset ) / 86400 - chainBack ))
		chainIn=0
		AgentsToolsScheduleDayIn "$chainDays" "$( AgentsToolsScheduleDayName "$(( ( chainDayNo + 4 ) % 7 ))" )" || chainIn=$?
		[ "$chainIn" != 2 ] || return 0
		if [ "$chainIn" = 0 ] ; then chainFound="$chainDayNo" ; break ; fi
		chainBack=$(( chainBack + 1 ))
	done
	[ -n "$chainFound" ] || return 0
	chainStart=$(( chainFound * 86400 - chainOffset )) ; chainEnd=$(( chainStart + 86400 ))
	[ "$chainEnd" -gt "$chainSeen" ] || return 0
	chainDate="$( printf '%s\n' "$(( chainFound * 86400 ))" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/output/LocalEpochToIsoDate.awk" )"
	chainMark="$chainStore/escalated/$chainName.$chainDate"
	[ ! -e "$chainMark" ] || return 0
	DISPATCH_MODE=started DISPATCH_ROUTINE="$chainName" DISPATCH_SINCE_MINUTES="$(( chainStart / 60 ))" DISPATCH_UNTIL_MINUTES="$(( chainEnd / 60 ))" AgentsToolsDispatcherHistory > /dev/null && return 0
	DISPATCH_ROUTINE="$chainPredName" DISPATCH_SINCE_MINUTES="$(( chainStart / 60 ))" DISPATCH_UNTIL_MINUTES="$(( chainEnd / 60 ))" AgentsToolsDispatcherHistory > /dev/null && return 0
	( set -C ; : > "$chainMark" ) 2> /dev/null || return 0
	type AgentsToolsEscalationNote > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.MemberEscalation.include" --definitions-only > /dev/null 2>&1 || :
	chainText="$( ASKP_F_routine="$chainName" ASKP_F_predecessor="$chainPredName" ASKP_F_day="$chainDate" AgentsToolsEscalationNote "Schedule/chain-broken" )" || chainText=""
	if [ -z "$chainText" ] ; then
		echo "⚠️ WARNING: $MDSC_CMD: the broken chain of $chainName could not be posted: its line could not be filled from its template (tooling-note.post.format.md, Schedule/chain-broken)" >&2
		rm -f "$chainMark"
	type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
	elif ! printf '%s\n' "$chainText" | DistroAgentsTools --intern-op-comms-slack-send-message magic-coordinator event-alert --identity-bot --from-stdin > /dev/null 2>&1 ; then
		echo "⚠️ WARNING: $MDSC_CMD: the broken chain of $chainName could not be posted to the event-alert channel, and is tried again at the next call" >&2
		rm -f "$chainMark"
	fi
	printf 'ESCALATE: %s: %s did not run on %s, so the chain is broken\n' "$chainName" "$chainPredName" "$chainDate"
	return 0
}

## --routine-due [--read-only] <routine>: whether the routine is due to start now by its own autorun declaration. rc 0, `DUE: <routine file>` (and,
## after a predecessor, `AFTER: <predecessor file> <spawn id of its run>`); rc 1, `NOT-DUE: <routine file>: <why>`; rc 2, `REFUSED:
## <routine file>: <the predecessor that has not completed today>`; rc 3, a call that could not be understood, or a routine whose `runs-at:` is
## malformed. A routine with no `runs-at:` runs on demand, and is not due. A chain that stopped adds an
## ESCALATE line (AgentsToolsScheduleChainCheck), ahead of the answer. With --read-only the question is asked and answered and nothing else is done: no chain check, so no
## post, no mark and no ESCALATE line. It is what a console that only looks asks with (the routines it lists, F11.11).
AgentsToolsScheduleDue(){ ## the operation as it was called, its arguments...
	local dueOp="$1" dueFile dueName dueRunsAt dueRunsAfter dueDays dueAt dueAtSec dueEpoch dueOffset dueDay dueSeconds dueDayName dueDayStart dueIn dueRow duePredFile duePredName dueReadOnly=""
	shift
	if [ "${1:-}" = "--read-only" ] ; then dueReadOnly="yes" ; shift ; fi
	if [ $# -ne 1 ] || [ -z "$1" ] ; then
		echo "⛔ ERROR: $MDSC_CMD $dueOp: syntax is [--read-only] <routine>, a routine file name or part of one, exactly one file" >&2
		return 3
	fi
	AgentsToolsScheduleTools || return 3
	dueFile="$( AgentsToolsSpawnRoutineResolve "$1" )" || return 3
	dueName="${dueFile##*/}"
	dueRunsAt="$( AgentsToolsRoutineKeyOwn "$dueFile" runs-at )"
	dueRunsAfter="$( AgentsToolsRoutineKeyOwn "$dueFile" runs-after )"
	case "$dueRunsAt" in
		'') printf 'NOT-DUE: %s: it declares no autorun (no runs-at: it runs on demand)\n' "$dueName" ; return 1 ;;
		none) printf 'NOT-DUE: %s: it declares no autorun (runs-at: none)\n' "$dueName" ; return 1 ;;
	esac
	dueDays="${dueRunsAt%% *}" ; dueAt="${dueRunsAt#* }"
	AgentsToolsScheduleTimeSecondsInto dueAtSec "$dueAt" || {
		echo "⛔ ERROR: $MDSC_CMD $dueOp: $dueName: runs-at: $dueRunsAt is not <days> <HH:MM>" >&2
		return 3
	}
	read -r dueEpoch dueOffset dueDay dueSeconds <<< "$( AgentsToolsScheduleClock )"
	dueDayName="$( AgentsToolsScheduleDayName "$dueDay" )"
	dueDayStart=$(( dueEpoch - dueSeconds ))
	[ -z "$dueRunsAfter" ] || [ -n "$dueReadOnly" ] || AgentsToolsScheduleChainCheck "$dueName" "$dueRunsAfter" "$dueDays" "$dueEpoch" "$dueOffset"
	dueIn=0
	AgentsToolsScheduleDayIn "$dueDays" "$dueDayName" || dueIn=$?
	case "$dueIn" in
		2) printf 'NOT-DUE: %s: the weekend is not set, and %s needs it\n' "$dueName" "$dueDays" ; return 1 ;;
		1) printf 'NOT-DUE: %s: today is not one of its days (%s)\n' "$dueName" "$dueDays" ; return 1 ;;
	esac
	if [ "$dueSeconds" -lt "$dueAtSec" ] ; then
		printf 'NOT-DUE: %s: before its earliest start, %s\n' "$dueName" "$dueAt"
		return 1
	fi
	if dueRow="$( DISPATCH_MODE=started DISPATCH_ROUTINE="$dueName" DISPATCH_SINCE_MINUTES="$(( dueDayStart / 60 ))" AgentsToolsDispatcherHistory )" ; then
		printf 'NOT-DUE: %s: it ran today (%s)\n' "$dueName" "$( printf '%s\n' "$dueRow" | LC_ALL=C cut -f3 )"
		return 1
	fi
	if [ -n "$dueRunsAfter" ] ; then
		if ! duePredFile="$( AgentsToolsSpawnRoutineResolve "$dueRunsAfter" 2> /dev/null )" ; then
			printf 'REFUSED: %s: runs-after %s names no routine\n' "$dueName" "$dueRunsAfter"
			return 2
		fi
		duePredName="${duePredFile##*/}"
		if ! dueRow="$( DISPATCH_ROUTINE="$duePredName" DISPATCH_SINCE_MINUTES="$(( dueDayStart / 60 ))" AgentsToolsDispatcherHistory )" ; then
			printf 'REFUSED: %s: %s has not completed today\n' "$dueName" "$duePredName"
			return 2
		fi
		printf 'DUE: %s\nAFTER: %s %s\n' "$dueName" "$duePredName" "$( printf '%s\n' "$dueRow" | LC_ALL=C cut -f3 )"
		return 0
	fi
	printf 'DUE: %s\n' "$dueName"
	return 0
}

## THE STEPS OF THE SCHEDULE: what the main loop does at each iteration, the autorun of the routines that
## declare one, the work-duty sessions the flags allow, and the learning inquiry for each session that ended.
## They sit beside the decisions they ask (AgentsToolsScheduleDue and its family), under this one name.
## Each step prints a line for each thing it did or could not do, and is never fatal. The chain of routines
## propels itself: a successor is due in the first iteration after its predecessor closed.
##
## The tool is loaded at its first call, not when this include is sourced: a load prints the system context's init line, and a
## caller that only sources the include for its functions must not get it. The stub loads the tool, then makes the same call.
if ! type DistroAgentsTools > /dev/null 2>&1 ; then
	DistroAgentsTools(){ unset -f DistroAgentsTools ; . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh" || return 1 ; DistroAgentsTools "$@" ; }
fi
type AgentsToolsScheduleDue > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.DispatcherSchedule.include"
type AgentsToolsSourceTtlOf > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.SourceTtl.include"
type AgentsToolsInboxDir > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/inbox/AgentsTools.InboxPlace.include"
type AgentsToolsSessionChatMemberId > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionChat.include"
type AgentsToolsSpawnSandboxRecordHeader > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SpawnSandbox.include"

agentsScheduleWorkDutyRoutine="magic-team.work-duty.routine.md"

## The work-duty routine of a member: its own `<member>.work-duty.routine.md` where its skill folder holds one (the coordinator's takes the advance rules), else the team's.
AgentsToolsScheduleDutyRoutine(){ ## member, its skill folder
	if [ -n "${2:-}" ] && [ -f "$2/$1.work-duty.routine.md" ] ; then
		printf '%s.work-duty.routine.md\n' "$1"
	else
		printf '%s\n' "$agentsScheduleWorkDutyRoutine"
	fi
}

## --- the starts ---

## A start through the spawner, in the background. The spawner runs the input scans of the routine before its member begins, and the work-duty
## scan collects over a window: a start made in the loop's own time would hold the iteration for it, one member after another. So it is made
## apart, its result kept in schedule/starting/<key>.rc and .out and said by the next iteration (AgentsToolsScheduleSpawnReport) if it
## failed. A start made in the last ten minutes that has not ended is not made again (schedule/starting/<key>). rc 1 for a start not made.
## A FAILED START IS HELD FOR THOSE SAME TEN MINUTES (schedule/starting/<key>.hold), so a start that cannot succeed is not tried at every pass: the
## first live pass of 2026-11-04 made nine duty starts, every one failed at `refusing to join`, and the next pass made the same nine. A start that
## succeeded leaves no hold, so a duty that ended is restarted on its own rule.
## A WORK-DUTY IS ONE SESSION WITH ONE THREAD. The start of a key `work-duty.<member>` brings the member into the session its previous
## start made (schedule/duty-session/<member>, the SESSION_ID that start printed), under --join-session, so the duty that starts
## again after a cache-keep, a demand or a tag posts into its thread and opens no new header in the team channel. The first start,
## and one after the proxy refused the join, starts a session and keeps its id: THE REFUSED JOIN IS FOLLOWED BY A START WITH NO --join-session, in the
## same attempt, and the stale id is dropped.
## A START THAT FAILS AGAIN AND AGAIN IS ESCALATED, NEVER RETRIED FOREVER (S12.12). The key's failures in a row are counted in
## starting/<key>.fails. At MDAT_SCHEDULE_START_FAILS_ESCALATE of them (3) one inquiry goes to magic-coordinator's inbox and the key
## is held, starting/<key>.escalated, for MDAT_SCHEDULE_START_FAILS_HOLD_MINUTES (360). A start the routine's own lock refused is a
## wait, not a failure, and counts for nothing. A success clears the count and the hold. The pass report names every held key.
AgentsToolsScheduleStartFailed(){ ## key, the start's output
	local failStore="$MMDAPP/.local/agents/schedule/starting" failCount=0 failLimit="${MDAT_SCHEDULE_START_FAILS_ESCALATE:-3}" failWhy
	case "$failLimit" in ''|*[!0123456789]*|0) failLimit=3 ;; esac
	! printf '%s\n' "$2" | LC_ALL=C grep -q -F 'the routine is already running: its locking document' || return 0
	[ ! -s "$failStore/$1.fails" ] || IFS= read -r failCount < "$failStore/$1.fails" || failCount=0
	case "$failCount" in ''|*[!0123456789]*) failCount=0 ;; esac
	failCount=$(( failCount + 1 ))
	printf '%s\n' "$failCount" > "$failStore/$1.fails" 2> /dev/null || :
	[ "$failCount" -ge "$failLimit" ] || return 0
	[ ! -f "$failStore/$1.escalated" ] || return 0
	failWhy="$( printf '%s\n' "$2" | LC_ALL=C grep -m 1 -A 4 'ERROR' 2> /dev/null | LC_ALL=C tr -s '\n' ' ' | LC_ALL=C cut -c1-600 )"
	[ -n "$failWhy" ] || failWhy="$( printf '%s\n' "$2" | LC_ALL=C grep -v '^[[:space:]]*$' | LC_ALL=C tail -n 1 | LC_ALL=C cut -c1-200 )"
	[ -n "$failWhy" ] || failWhy="it printed nothing"
	: > "$failStore/$1.escalated" 2> /dev/null || :
	AgentsToolsScheduleStartEscalate "$1" "$failCount" "$failWhy" || :
	return 0
}

## The inquiry, in magic-coordinator's inbox, as --supervise-fault files one: written for the coordinator who reads it cold.
AgentsToolsScheduleStartEscalate(){ ## key, failures in a row, the last failure's words
	local escName escHold="${MDAT_SCHEDULE_START_FAILS_HOLD_MINUTES:-360}" escSaid
	case "$escHold" in ''|*[!0123456789]*|0) escHold=360 ;; esac
	escName="inquiry-$( date -u +%Y%m%dT%H%M%SZ )-schedule-cannot-start-$( printf '%s' "$1" | LC_ALL=C tr 'A-Z' 'a-z' | LC_ALL=C tr -c 'a-z0-9' '-' | LC_ALL=C sed -e 's/--*/-/g' -e 's/^-//' -e 's/-$//' | cut -c1-50 ).md"
	escSaid="$( printf '# Inquiry: the schedule cannot start %s\n\nThe start of `%s` failed %s times in a row on %s. The schedule holds it for %s minutes, then tries again. While it is held, what it starts stays down.\n\n## The last failure\n\n%s\n\n## Next step\n\nFind the cause and fix it. A start that succeeds clears the hold. Until the hold ends, nothing starts this key.\n' \
		"$1" "$1" "$2" "${MMDAPP##*/}" "$escHold" "$3" \
		| bash "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsItems.fn.sh" --upsert-inbox-inquiry magic-coordinator "$escName" 2>&1 )" || :
	case "$escSaid" in *ERROR*) echo "schedule: the inquiry on the failing start of $1 could not be filed: $( printf '%s' "$escSaid" | LC_ALL=C grep -m1 'ERROR' | cut -c1-300 )" ;; esac
	return 0
}

## rc 0 while the key is held after repeated failures; a hold past its minutes is lifted, with the count, so the next start is a fresh streak.
AgentsToolsScheduleStartHeld(){ ## key
	local heldStore="$MMDAPP/.local/agents/schedule/starting" heldHold="${MDAT_SCHEDULE_START_FAILS_HOLD_MINUTES:-360}"
	case "$heldHold" in ''|*[!0123456789]*|0) heldHold=360 ;; esac
	[ -f "$heldStore/$1.escalated" ] || return 1
	[ -z "$( find "$heldStore/$1.escalated" -mmin +"$heldHold" 2> /dev/null )" ] || { rm -f "$heldStore/$1.escalated" "$heldStore/$1.fails" 2> /dev/null ; return 1 ; }
	return 0
}

AgentsToolsScheduleSpawn(){ ## key, the arguments of --spawn-session...
	local spawnKey="$1" spawnStore="$MMDAPP/.local/agents/schedule/starting" spawnDutySession="" spawnDutyFile="" spawnDayFirst="" spawnKeptRoot=""
	shift
	case "$spawnKey" in
		work-duty.?*)
			spawnDutyFile="$MMDAPP/.local/agents/schedule/duty-session/${spawnKey#work-duty.}"
			[ ! -s "$spawnDutyFile" ] || IFS= read -r spawnDutySession < "$spawnDutyFile" || spawnDutySession=""
			case "$spawnDutySession" in ''|*[!A-Za-z0-9._-]*) spawnDutySession="" ;; esac
			## A kept session on another team data is no duty of this rig: its id is dropped, and the start makes a session of its own (S12.19).
			spawnKeptRoot=""
			[ -z "$spawnDutySession" ] || [ ! -s "$MMDAPP/.local/agents/sessions/$spawnDutySession/data-root" ] \
				|| IFS= read -r spawnKeptRoot < "$MMDAPP/.local/agents/sessions/$spawnDutySession/data-root" || spawnKeptRoot=""
			if [ -n "$spawnKeptRoot" ] && [ "$spawnKeptRoot" != "${MDAT_DATA_ROOT:-}" ] ; then
				rm -f "$spawnDutyFile" ; spawnDutySession=""
			fi
			## A kept session of an earlier day ends with that day: dropped, and the start opens today's session (AgentsToolsDutyKeptStale).
			## Its read pointer into the tagged source is kept first (AgentsToolsDutyKeptTagFold).
			type AgentsToolsDutyKeptStale > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.StartedRecords.include" 2> /dev/null || :
			if [ -n "$spawnDutySession" ] && type AgentsToolsDutyKeptStale > /dev/null 2>&1 && AgentsToolsDutyKeptStale "$spawnDutySession" ; then
				AgentsToolsDutyKeptTagFold "${spawnKey#work-duty.}" "$spawnDutySession"
				rm -f "$spawnDutyFile" ; spawnDutySession=""
			fi
			spawnDayFirst="$( AgentsToolsScheduleDayFirst ask )"
		;;
		supervision.?*)
			spawnDutyFile="$MMDAPP/.local/agents/schedule/supervision-session/${spawnKey#supervision.}"
			[ ! -s "$spawnDutyFile" ] || IFS= read -r spawnDutySession < "$spawnDutyFile" || spawnDutySession=""
			case "$spawnDutySession" in ''|*[!A-Za-z0-9._-]*) spawnDutySession="" ;; esac
		;;
	esac
	## A THREAD TOLD TO END STARTS NOTHING MORE: the serve loop says so (AgentsToolsOnDemandThreadEnding), and the pass in hand stops starting.
	type AgentsToolsOnDemandThreadEnding > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/common/AgentsTools.OnDemandThread.include" 2> /dev/null || :
	! { type AgentsToolsOnDemandThreadEnding > /dev/null 2>&1 && AgentsToolsOnDemandThreadEnding ; } || return 1
	mkdir -p "$spawnStore" 2> /dev/null || return 1
	## A KEY HELD AFTER REPEATED FAILURES IS NOT STARTED (S12.12): the inquiry on it is in the coordinator's inbox, and the report names it.
	! AgentsToolsScheduleStartHeld "$spawnKey" || return 1
	## THE TWO KEY FILES ARE READ BY THEIR PATHS (call-path audit row 10): the start mark and the hold both lie directly in the store, so no
	## find walks it; a file younger than ten minutes holds the key. One stat per file that is there, against the pass clock.
	local spawnHeldFile spawnHeldAt spawnHeldNow="${agentsSchedulePassNow:-}"
	for spawnHeldFile in "$spawnStore/$spawnKey" "$spawnStore/$spawnKey.hold" ; do
		[ -e "$spawnHeldFile" ] || continue
		[ -n "$spawnHeldNow" ] || spawnHeldNow="$( date +%s )"
		spawnHeldAt="$( stat -f %m "$spawnHeldFile" 2> /dev/null || stat -c %Y "$spawnHeldFile" 2> /dev/null )" || spawnHeldAt=0
		case "$spawnHeldAt" in ''|*[!0-9]*) spawnHeldAt=0 ;; esac
		[ $(( spawnHeldNow - spawnHeldAt )) -ge 600 ] || return 1
	done
	( set -C ; : > "$spawnStore/$spawnKey" ) 2> /dev/null || return 1
	(
		type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
		## The schedule names itself and the start's origin, so no session it starts reads as started by the account at the console.
		## THE PARENT IS THE COORDINATOR (epic S6 item 28: the duty of magic-coordinator reviews, and a handback goes to the run's
		## parent-member): the thread that starts a duty is a console process, so without this every duty read `parent-member:
		## user-myx` and handed its work back to the human-owner.
		spawnOut="$( MDAT_SPAWN_STARTED_BY="the schedule, $spawnKey" MDAT_SPAWN_DAY_FIRST="$spawnDayFirst" DistroAgentsTools --spawn-session ${spawnDutySession:+--join-session "$spawnDutySession"} --parent-member magic-coordinator "$@" 2>&1 < /dev/null )" ; spawnRc=$?
		## A KEPT ID THAT NAMES NOTHING IS REPLACED IN THE SAME ATTEMPT: the spawner refused to join, so the id is dropped and the start is made again
		## with no --join-session, which is a session of its own. That is the one failure a start answers itself; any other is held below.
		if [ "$spawnRc" != 0 ] && [ -n "$spawnDutySession" ] && printf '%s\n' "$spawnOut" | LC_ALL=C grep -q -F 'refusing to join' ; then
			rm -f "$spawnDutyFile"
			spawnDutySession=""
			spawnOut="$( MDAT_SPAWN_STARTED_BY="the schedule, $spawnKey" MDAT_SPAWN_DAY_FIRST="$spawnDayFirst" DistroAgentsTools --spawn-session --parent-member magic-coordinator "$@" 2>&1 < /dev/null )" ; spawnRc=$?
		fi
		if [ -n "$spawnDutyFile" ] && [ "$spawnRc" = 0 ] ; then
			spawnDutySession="$( printf '%s\n' "$spawnOut" | LC_ALL=C awk -F= '$1 == "SESSION_ID" { print $2 ; exit ; }' )"
			## The day is open from this start on, so no other duty start that day posts the greeting.
			AgentsToolsScheduleDayFirst record
			if [ -n "$spawnDutySession" ] ; then mkdir -p "${spawnDutyFile%/*}" 2> /dev/null && printf '%s\n' "$spawnDutySession" > "$spawnDutyFile" ; fi
		fi
		## The session a start made, for the caller that records it (the start-pending receipt): the spawner's SESSION_ID line.
		agentsScheduleSpawnSession=""
		[ "$spawnRc" != 0 ] || agentsScheduleSpawnSession="$( printf '%s\n' "$spawnOut" | LC_ALL=C awk -F= '$1 == "SESSION_ID" { print $2 ; exit ; }' )"
		## THE HOLD: one that ends with a failure keeps its key quiet for the same ten minutes, and one that succeeds clears it.
		if [ "$spawnRc" != 0 ] ; then
			{ mkdir -p "$spawnStore" && : > "$spawnStore/$spawnKey.hold" ; } 2> /dev/null || :
			AgentsToolsScheduleStartFailed "$spawnKey" "$spawnOut" || :
		else
			rm -f "$spawnStore/$spawnKey.hold" "$spawnStore/$spawnKey.fails" "$spawnStore/$spawnKey.escalated" 2> /dev/null || :
		fi
		printf '%s\n' "$spawnOut" > "$spawnStore/$spawnKey.out"
		printf '%s\n' "$spawnRc" > "$spawnStore/$spawnKey.rc"
		rm -f "$spawnStore/$spawnKey"
	) > /dev/null 2>&1 < /dev/null &
	disown "$!" 2> /dev/null || :
	return 0
}

## What the starts that ended since the last look came to: a line for each that failed, the first error it gave. Their files go.
AgentsToolsScheduleSpawnReport(){
	local reportStore="$MMDAPP/.local/agents/schedule/starting" reportFile reportKey reportRc reportWhy reportHeld
	## A CAP CUTS WHOLE CHARACTERS AND SAYS WHEN IT CUT, where `cut -c` splits a UTF-8 character and drops the tail silently: it counts bytes under LC_ALL=C, and a line within its cap passes through unchanged.
	local reportCapAwk='
		BEGIN { contFirst = sprintf( "%c", 128 ) ; contLast = sprintf( "%c", 191 ) ; }
		{
			totalBytes = length( $0 )
			if ( totalBytes <= capBytes ) { print ; next ; }
			keptBytes = capBytes
			afterByte = substr( $0, keptBytes + 1, 1 )
			while ( keptBytes > 0 && afterByte >= contFirst && afterByte <= contLast ) { keptBytes-- ; afterByte = substr( $0, keptBytes + 1, 1 ) ; }
			printf "%s[truncated: %d of %d bytes]\n", substr( $0, 1, keptBytes ), keptBytes, totalBytes
		}
	'
	## THE KEYS HELD AFTER REPEATED FAILURES (S12.12), each pass, so a reader of the thread log sees why nothing starts them.
	for reportHeld in "$reportStore"/*.escalated ; do
		[ -f "$reportHeld" ] || continue
		reportKey="${reportHeld##*/}" ; reportKey="${reportKey%.escalated}"
		! AgentsToolsScheduleStartHeld "$reportKey" || printf 'schedule: the start of %s is held after %s failures in a row; magic-coordinator has the inquiry\n' "$reportKey" "$( cat "$reportStore/$reportKey.fails" 2> /dev/null || printf '?' )"
	done
	for reportFile in "$reportStore"/*.rc ; do
		[ -f "$reportFile" ] || continue
		reportKey="${reportFile##*/}" ; reportKey="${reportKey%.rc}"
		IFS= read -r reportRc < "$reportFile" || reportRc=1
		## A start the routine's lock refused, because the routine is running already (on this host or another), is no failure: it is said as a wait, with the lock it names.
		if [ "$reportRc" != 0 ] && LC_ALL=C grep -q -F 'the routine is already running: its locking document' "$reportStore/$reportKey.out" 2> /dev/null ; then
			printf 'schedule: the start of %s waits: %s\n' "$reportKey" "$( LC_ALL=C grep -m 1 -F 'the routine is already running' "$reportStore/$reportKey.out" | LC_ALL=C awk -v capBytes=300 "$reportCapAwk" )"
		elif [ "$reportRc" != 0 ] ; then
			## A FAILURE ALWAYS SAYS WHY: the first error line with the 4 lines that continue it, else the start's last line, else that it printed nothing.
			## THE ERROR LINE IS ANCHORED at the head of the line, behind the names a command prefixes it with, so a marker inside another line's text is no failure of this start.
			reportWhy="$( LC_ALL=C grep -m 1 -A 4 -E '^([A-Za-z0-9_.-]+: )*(⛔ )?ERROR:' "$reportStore/$reportKey.out" 2> /dev/null | LC_ALL=C tr -s '\n' ' ' | LC_ALL=C awk -v capBytes=600 "$reportCapAwk" )"
			[ -n "$reportWhy" ] || reportWhy="$( LC_ALL=C grep -v '^[[:space:]]*$' "$reportStore/$reportKey.out" 2> /dev/null | LC_ALL=C tail -n 1 | LC_ALL=C awk -v capBytes=200 "$reportCapAwk" )"
			[ -n "$reportWhy" ] || reportWhy="it printed nothing, exit $reportRc"
			printf 'schedule: the start of %s failed: %s\n' "$reportKey" "$reportWhy"
		fi
		rm -f "$reportFile" "$reportStore/$reportKey.out"
	done
	return 0
}

## --- the autorun ---

## Every routine file with a runs-at is asked whether it is due (AgentsToolsScheduleDue); a routine that is due is started through the
## spawner, `--spawn-session --routine <file>`, which takes the routine's lock as it declares (F6.2) and starts its own executors. A
## routine whose executors are any member is not started here: the spawner starts it only with members named. A chain that stopped says
## ESCALATE; a predecessor that names no routine says so; a chain that merely waits for its predecessor is quiet. A routine with no
## runs-at is reported as an error and started nothing: an absent key is invalid, never a quiet skip.
AgentsToolsScheduleAutorun(){
	local autoMember autoDir autoFile autoName autoRunsAt autoOut autoRc autoExecutors autoLine
	while IFS=$'\t' read -r autoMember autoDir ; do
		[ -n "$autoDir" ] || continue
		for autoFile in "$autoDir"/*.routine.md ; do
			[ -f "$autoFile" ] || continue
			autoRunsAt="$( AgentsToolsRoutineKeyOwn "$autoFile" runs-at )"
			case "$autoRunsAt" in
				## No runs-at is a routine run on demand only, as none says.
				''|none) continue ;;
			esac
			autoName="${autoFile##*/}"
			autoRc=0
			autoOut="$( AgentsToolsScheduleDue --routine-due "$autoName" 2> /dev/null )" || autoRc=$?
			while IFS= read -r autoLine ; do
				case "$autoLine" in
					ESCALATE:*) printf 'autorun: %s\n' "$autoLine" ;;
					"REFUSED: "*"names no routine") printf 'autorun: %s\n' "$autoLine" ;;
				esac
			done <<< "$autoOut"
			[ "$autoRc" = 0 ] || continue
			autoExecutors="$( AgentsToolsSpawnRoutineFrontmatter "$autoFile" "$( AgentsToolsSpawnRoutineKindPath "$autoFile" )" | LC_ALL=C sed -n 's/^executors: //p' | head -1 )"
			case "$autoExecutors" in ''|"magic-team"|"*") continue ;; esac
			if AgentsToolsScheduleSpawn "$autoName" --routine "$autoName" ; then
				printf 'autorun: started %s\n' "$autoName"
			fi
		done
	done <<< "$( AgentsToolsTeamMemberDirectoryText )"
	return 0
}

## --- the work duty ---

## THE PACE OF A TOOL CALL ON THIS RIG (S12.13, the owner's ruling of 9 November): the median MACHINERY time of the calls the LIVE runs
## wrote into their `context.jsonl` in the last MDAT_TOOL_PACE_WINDOW_SECONDS (300): `mach_ms`, what the tooling spent around a call and
## not what the call itself ran (a Bash child, a Wait's waiting), by the record's own clock. A duty start waits while that median is 4 s
## (MDAT_TOOL_PACE_MS, 4000) or more, because a start on a machine this slow is what the owner's throttle forbids. A rig with no live run
## says so and allows one start a pass (AgentsToolsScheduleWorkDuty): no measure is never a fast pace. Machinery time gates a start, never load.
## THE MEASURE IS A WALK OF THE WHOLE `spawned/` TREE, which on a workspace with thousands of run folders is the most expensive thing on the call path (a schedule pass,
## a start-pending pass and each duty of a pass ask for it), so it is taken at most once in MDAT_TOOL_PACE_CACHE_SECONDS (60) and kept in
## `.local/agents/schedule/pace.measure` as `<epoch> <window> <median> <count>`. A caller reads that file, one read and no walk; the verdict is worked out
## from the measure on each call, so a threshold of the caller's own (MDAT_TOOL_PACE_MS) still applies. 0 takes the measure on every call, as the checks do.
AgentsToolsSchedulePaceText(){ ## -- one line: what was read, and what it decides
	local paceLimit="${MDAT_TOOL_PACE_MS:-4000}" paceWindow="${MDAT_TOOL_PACE_WINDOW_SECONDS:-300}" paceTtl="${MDAT_TOOL_PACE_CACHE_SECONDS:-60}" paceFile paceCount paceMedian paceRecord paceLive
	local paceCache="$MMDAPP/.local/agents/schedule/pace.measure" paceNow="" paceAt="" paceWin="" paceHeld="" paceTemp
	case "$paceLimit" in ''|*[!0123456789]*|0) paceLimit=4000 ;; esac
	case "$paceWindow" in ''|*[!0123456789]*|0) paceWindow=300 ;; esac
	case "$paceTtl" in ''|*[!0123456789]*) paceTtl=60 ;; esac
	paceMedian=""
	if [ "$paceTtl" -gt 0 ] ; then
		{ read -r paceAt paceWin paceMedian paceHeld < "$paceCache" ; } 2> /dev/null || paceAt=""
		paceNow="${agentsSchedulePassNow:-$( date +%s )}" || paceNow=""
		case "$paceAt$paceNow" in ''|*[!0123456789]*) paceMedian="" ;; *)
			if [ "$paceWin" = "$paceWindow" ] && [ "$(( paceNow - paceAt ))" -ge 0 ] && [ "$(( paceNow - paceAt ))" -lt "$paceTtl" ] && [ -n "$paceMedian" ] && [ -n "$paceHeld" ] ; then
				paceMedian="$paceMedian $paceHeld"
			else
				paceMedian=""
			fi
		;; esac
	fi
	if [ -z "$paceMedian" ] ; then
	case "$paceNow" in ''|*[!0123456789]*) paceNow="$( date +%s )" ;; esac
	## THE MEASURE (the owner's ruling): the MACHINERY time of each call, mach_ms, what the tooling spent around the call and not what the
	## call itself ran (a Bash child's run, a Wait's waiting); dur_ms only where a record predates it. Of the LIVE runs alone, those whose
	## spawn record says spawn-started: a stopped rig reads "no live run", never a fast pace. Within the window by the record's own
	## clock (ms), so no call older than the window counts. One awk a file, no grep and no sed.
	paceMedian="$( LC_ALL=C find "$MMDAPP/.local/agents/spawned" -mindepth 2 -maxdepth 2 -name context.jsonl -mmin "-$(( ( paceWindow + 59 ) / 60 ))" 2> /dev/null \
		| while IFS= read -r paceFile ; do
			paceLive=""
			for paceRecord in "${paceFile%/*}"/*.spawn.md ; do
				[ -f "$paceRecord" ] || continue
				LC_ALL=C grep -q -x -F 'status: spawn-started' "$paceRecord" 2> /dev/null && { paceLive=yes ; break ; }
			done
			[ -n "$paceLive" ] || continue
			LC_ALL=C awk -v floor="$(( ( paceNow - paceWindow ) * 1000 ))" '
				{
					if ( ! match( $0, /"ms":[0-9]+/ ) ) { next } ; ms = substr( $0, RSTART + 5, RLENGTH - 5 ) + 0 ; if ( ms < floor ) { next }
					## A WAIT WAITS BY DESIGN: its minutes are the pause it was asked for, not the machinery around a call (MDV read 907 s a call on one
					## Wait of 15 minutes). Its record is left out of the pace, as execute is.
					if ( index( $0, "\"tool\":\"Wait\"" ) ) { next }
					if ( match( $0, /"mach_ms":[0-9]+/ ) ) { print substr( $0, RSTART + 10, RLENGTH - 10 ) ; next }
					if ( match( $0, /"dur_ms":[0-9]+/ ) ) { print substr( $0, RSTART + 9, RLENGTH - 9 ) }
				}' "$paceFile" 2> /dev/null
		done | { cat ; [ ! -f "$MMDAPP/.local/agents/schedule/pace.mcp" ] || LC_ALL=C awk -v floor="$(( paceNow - paceWindow ))" '$1 >= floor && $3 != "Wait" { print $2 }' "$MMDAPP/.local/agents/schedule/pace.mcp" 2> /dev/null ; } | LC_ALL=C sort -n | LC_ALL=C awk '{ call[NR] = $1 } END { if ( NR == 0 ) { printf "- 0\n" ; exit } ; printf "%s %s\n", call[int( (NR + 1) / 2 )], NR }' )"
	## Kept for the next callers: written beside, then moved in, so a reader never sees half of it.
	case "$paceMedian" in
		''|*[!0123456789\ -]*) ;;
		*)
			if [ "$paceTtl" -gt 0 ] && mkdir -p "${paceCache%/*}" 2> /dev/null && paceTemp="$( mktemp "$paceCache.XXXXXX" 2> /dev/null )" ; then
				printf '%s %s %s\n' "${paceNow:-$( date +%s )}" "$paceWindow" "$paceMedian" > "$paceTemp" 2> /dev/null && mv -f "$paceTemp" "$paceCache" 2> /dev/null || rm -f "$paceTemp" 2> /dev/null
			fi
		;;
	esac
	fi
	## THE PROVIDER'S REFUSAL FOR MONEY HOLDS EVERY START (the harness leaves the mark, AgentsHarnessRefusalKeep): while the mark
	## is younger than MDAT_SCHEDULE_PROVIDER_HOLD_MINUTES (30), no duty is started, and the line says why, so --flags and the
	## thread's log carry the reason the owner must act on. A run that reaches a round clears the mark.
	local paceRefused="$MMDAPP/.local/agents/schedule/provider-refused" paceRefusedHold="${MDAT_SCHEDULE_PROVIDER_HOLD_MINUTES:-30}" paceRefusedWhy=""
	case "$paceRefusedHold" in ''|*[!0123456789]*|0) paceRefusedHold=30 ;; esac
	if [ -f "$paceRefused" ] && [ -z "$( find "$paceRefused" -mmin +"$paceRefusedHold" 2> /dev/null )" ] ; then
		{ IFS= read -r paceRefusedWhy < "$paceRefused" ; } 2> /dev/null || paceRefusedWhy=""
		printf 'pace: the provider refused for balance -- %s -- a duty start is held for %s minutes from the refusal\n' "${paceRefusedWhy:-no reason kept}" "$paceRefusedHold"
		return 0
	fi
	case "$paceMedian" in
		''|*[!0123456789\ -]*) printf 'pace: not read -- a duty start is allowed\n' ; return 0 ;;
	esac
	paceMedian="${paceMedian#- }"
	paceCount="${paceMedian#* }"
	paceMedian="${paceMedian%% *}"
	## Said in seconds, one decimal, as the owner reads it; the limit in whole seconds.
	if [ "$paceCount" = 0 ] ; then
		printf 'pace: no live run made a call in %s minutes -- a duty start is allowed, one a pass\n' "$(( paceWindow / 60 ))"
		return 0
	fi
	if [ "$paceCount" -lt 3 ] ; then
		printf 'pace: %s.%ss machinery a call, %s calls in %s minutes -- too few to judge, a duty start is allowed\n' "$(( paceMedian / 1000 ))" "$(( paceMedian % 1000 / 100 ))" "$paceCount" "$(( paceWindow / 60 ))"
		return 0
	fi
	if [ "$paceMedian" -lt "$paceLimit" ] ; then
		printf 'pace: %s.%ss machinery a call, %s calls in %s minutes -- under %ss, a duty start is allowed\n' "$(( paceMedian / 1000 ))" "$(( paceMedian % 1000 / 100 ))" "$paceCount" "$(( paceWindow / 60 ))" "$(( paceLimit / 1000 ))"
	else
		printf 'pace: %s.%ss machinery a call, %s calls in %s minutes -- over %ss, a duty start is held\n' "$(( paceMedian / 1000 ))" "$(( paceMedian % 1000 / 100 ))" "$paceCount" "$(( paceWindow / 60 ))" "$(( paceLimit / 1000 ))"
	fi
	return 0
}
## Whether the pace allows a duty start now. rc 0 it does, and rc 1 it does not: the one line AgentsToolsSchedulePaceText gives ends with the word.
AgentsToolsSchedulePaceAllows(){
	AgentsToolsSchedulePaceText | LC_ALL=C grep -q -e 'a duty start is allowed' -e 'a duty start is allowed$'
}

## The live work-duty run of a member: the record of a run of a work-duty routine (the team's or its own) that the member owns, started and still a process.
## Prints the record path; rc 1 for none.
AgentsToolsScheduleWorkDutyRecord(){ ## member
	local dutyRecord dutySpawn
	## Only a started record can be a live duty, so the kept list of started records is read (AgentsTools.StartedRecords.include), not every duty record there ever was.
	while IFS= read -r dutyRecord ; do
		[ -f "$dutyRecord" ] || continue
		case "$( AgentsToolsSpawnSandboxRecordHeader "$dutyRecord" routine )" in *.work-duty.routine.md) ;; *) continue ;; esac
		[ "$( AgentsToolsSpawnSandboxRecordHeader "$dutyRecord" owner )" = "$1" ] && [ "$( AgentsToolsSpawnSandboxRecordHeader "$dutyRecord" status )" = "spawn-started" ] || continue
		dutySpawn="${dutyRecord##*/}" ; dutySpawn="${dutySpawn%.spawn.md}"
		type AgentsToolsLivenessOf > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.Registries.include"
		[ "$( AgentsToolsLivenessOf "$dutySpawn" "$dutyRecord" )" = alive ] || continue
		printf '%s\n' "$dutyRecord"
		return 0
	done <<< "$( type AgentsToolsSpawnedStartedRecords > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.StartedRecords.include" 2> /dev/null ; AgentsToolsSpawnedStartedRecords )"
	return 1
}

## Whether any member other than the coordinator holds a live work-duty now: rc 0 one does, rc 1 none. The off-duty end reads it
## for the coordinator, whose duty goes last.
AgentsToolsScheduleOtherDutyLive(){
	local otherRow otherMember
	while IFS= read -r otherRow ; do
		otherMember="${otherRow%%	*}"
		[ -n "$otherMember" ] && [ "$otherMember" != magic-coordinator ] || continue
		AgentsToolsScheduleWorkDutyRecord "$otherMember" > /dev/null && return 0
	done <<< "$( AgentsToolsTeamMemberDirectoryText )"
	return 1
}

## WHETHER A DUTY'S LAST RUN ENDED AND IS DUE A RESTART: the newest work-duty record of the member that
## is closed, with no dismissal marker (`AgentsToolsScheduleDismiss` writes one, and only where the tooling
## told the run to go), and ended at least DUTY_RESTART_SECONDS ago. A run that ended for any reason is
## restarted on that one rule, so a killed process, a provider refusal and a context-limit end all come back.
## rc 0 when a restart is due, and the ended record printed.
AgentsToolsScheduleDutyRestartDue(){ ## member
	local dueRecord dueSpawn dueMtime dueNow dueWait dueStat dueBest dueBestAt
	dueWait="${DUTY_RESTART_SECONDS:-300}"
	case "$dueWait" in ''|*[!0123456789]*) dueWait=300 ;; esac
	dueNow="${agentsSchedulePassNow:-$( date +%s 2> /dev/null )}" || dueNow=0
	[ "$dueNow" -gt 0 ] || return 1
	if stat -f '%m' / > /dev/null 2>&1 ; then dueStat="bsd" ; else dueStat="gnu" ; fi
	## The newest closed duty of the member, by the record's own mtime: the close writes it, so its mtime
	## is when the run ended. The first closed record that is dismissed is the member's last word on the
	## matter, and no older one is looked at.
	dueBest="" dueBestAt=0
	## ONE `awk` AND ONE `stat` FOR ALL THE DUTY RECORDS, NOT THREE PROCESSES FOR EACH: the roster asks this for each member of it in each pass, and a
	## workspace holds hundreds of closed duty records. The awk prints `<path> <owner> <status>` for every record of the kept list
	## (AgentsTools.StartedRecords.include), the member's closed ones are taken from that, and one `stat` gives their mtimes.
	local dueRows dueMine dueLine
	type AgentsToolsSpawnedDutyRecords > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.StartedRecords.include" 2> /dev/null
	dueRows="$( AgentsToolsSpawnedDutyRecords | LC_ALL=C tr '\n' '\0' | LC_ALL=C xargs -0 awk '
		FNR == 1 { if ( NR > 1 && name != "" ) print name "\t" owner "\t" status ; name = FILENAME ; owner = "" ; status = "" ; fence = 0 }
		$0 == "---" { fence++ ; next }
		fence == 1 && index( $0, "owner: " ) == 1 && owner == "" { owner = substr( $0, 8 ) }
		fence == 1 && index( $0, "status: " ) == 1 && status == "" { status = substr( $0, 9 ) }
		END { if ( name != "" ) print name "\t" owner "\t" status }
	' 2> /dev/null )" || dueRows=""
	dueMine="$( printf '%s\n' "$dueRows" | LC_ALL=C awk -F'\t' -v member="$1" '$2 == member && $3 != "" && $3 != "spawn-started" { print $1 }' )"
	if [ -n "$dueMine" ] ; then
		case "$dueStat" in
			bsd) dueLine="$( printf '%s\n' "$dueMine" | LC_ALL=C tr '\n' '\0' | LC_ALL=C xargs -0 stat -f '%m %N' 2> /dev/null | LC_ALL=C sort -rn | LC_ALL=C sed -n '1p' )" ;;
			*) dueLine="$( printf '%s\n' "$dueMine" | LC_ALL=C tr '\n' '\0' | LC_ALL=C xargs -0 stat -c '%Y %n' 2> /dev/null | LC_ALL=C sort -rn | LC_ALL=C sed -n '1p' )" ;;
		esac
		dueMtime="${dueLine%% *}"
		case "$dueMtime" in ''|*[!0123456789]*) ;; *) dueBest="${dueLine#* }" ; dueBestAt="$dueMtime" ;; esac
	fi
	[ -n "$dueBest" ] || return 1
	dueSpawn="${dueBest##*/}" ; dueSpawn="${dueSpawn%.spawn.md}"
	[ ! -e "$MMDAPP/.local/agents/schedule/dismissed/$dueSpawn" ] || return 1
	[ "$(( dueNow - dueBestAt ))" -ge "$dueWait" ] || return 1
	printf '%s\n' "$dueBest"
	return 0
}

## THE STALE OPEN RECORD, RULED BY TWO AXES AND NEVER ONE WORD: a record is open or closed, and its
## process is alive, gone or unknown. Process gone with the supervisor still alive is the supervisor's
## own close, so nothing is done. Process gone with the supervisor gone is a run that ended without
## reporting: this closes it spawn-failed, with a reason that states what was seen and guesses nothing
## about why. Process unknown waits, and says so once, because unknown is never gone.
## Prints one line when it acts or is held, and nothing when it has no record of its own to judge.
AgentsToolsScheduleDutyStaleClose(){ ## work-duty or spawn record
	local staleRecord="$1" staleSpawn staleStatus staleLive staleSuper staleAt
	[ -f "$staleRecord" ] || return 0
	staleSpawn="${staleRecord##*/}" ; staleSpawn="${staleSpawn%.spawn.md}"
	staleStatus="$( AgentsToolsSpawnSandboxRecordHeader "$staleRecord" status )"
	[ "$staleStatus" = spawn-started ] || return 0
	type AgentsToolsLivenessOf > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.Registries.include"
	staleLive="$( AgentsToolsLivenessOf "$staleSpawn" "$staleRecord" )"
	case "$staleLive" in
		alive) return 0 ;;
		unknown) printf 'work-duty: %s is open and its process cannot be read; it is waited for, never closed\n' "$staleSpawn" ; return 0 ;;
	esac
	## The supervisor is judged by the one rule that answers for another host: alive, gone or unknown.
	## A record of a foreign host is unknown here, and unknown never closes a record.
	staleSuper="$( AgentsToolsRegistryRecordedSupervisor "$staleRecord" )"
	case "$staleSuper" in
		alive) return 0 ;;
		unknown) printf 'work-duty: %s is open with no process, and its supervisor cannot be read from here; it is waited for, never closed\n' "$staleSpawn" ; return 0 ;;
	esac
	staleAt="$( date '+%Y-%m-%d %H:%M %z' 2> /dev/null )" || staleAt="an unknown time"
	type AgentsToolsSpawnProxyCloseSandbox > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SpawnSandbox.include"
	printf 'work-duty: %s is open with no process and no supervisor at %s; closing it spawn-failed\n' "$staleSpawn" "$staleAt"
	AgentsToolsSpawnProxyCloseSandbox "$staleRecord" failed unknown "no process and no supervisor at $staleAt"
	return 0
}

## The team channel, read once for every member there is to look for: the messages after the last read, and for each member the newest that
## mentions it (`<@its Slack id>` or `@its name`), kept in tags/<member>. No read at all inside the TTL of the source, and none made for nobody.
## The first look reads from now: what stood there before is not news. A read that fails is tried again after the TTL. <force> yes is the
## per-member sync's (AgentsTools.Incoming.include): the tags are read now, whatever the TTL, for the members given.
AgentsToolsScheduleTeamTags(){ ## the members to look for, spaced; force (yes|no)
	type AgentsToolsTrackingDrop > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.TrackingDrop.include"
	local teamStore="$MMDAPP/.local/agents/schedule" teamNow teamTtl teamAt="" teamFloor="" teamOut teamTemp teamMember teamId teamNewest teamHit teamIdList=""
	[ -n "${1// /}" ] || return 0
	teamNow="${agentsSchedulePassNow:-$( date +%s )}"
	## The cache TTL of the tags and mentions (T2): one minute, the low end of the 1-5 minute band. It is the schedule's own cadence,
	## not the live Wait floor (AgentsToolsSourceTtlOf tagged:* stays 15): the team channel that feeds the tags is re-read at most once
	## a minute for all the members, whatever the number of them.
	teamTtl=60
	[ "${2:-no}" != "yes" ] || teamTtl=0
	[ ! -f "$teamStore/team-channel" ] || read -r teamAt teamFloor < "$teamStore/team-channel" || :
	case "$teamAt" in ''|*[!0123456789]*) teamAt="" ;; esac
	[ -z "$teamAt" ] || [ $(( teamNow - teamAt )) -ge "$teamTtl" ] || return 0
	mkdir -p "$teamStore/tags" 2> /dev/null || return 0
	[ -n "$teamFloor" ] || teamFloor="$teamNow.000000"
	## The accounts of the members, before the read: a read that names a person rewrites the cache they come from.
	for teamMember in $1 ; do teamIdList="$teamIdList $teamMember=$( AgentsToolsSessionChatMemberId "$teamMember" )" ; done
	type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
	teamOut="$( DistroAgentsTools --intern-op-comms-slack-read magic-coordinator magic-team --oldest "$teamFloor" 2> /dev/null < /dev/null )" || teamOut=""
	teamNewest="$( printf '%s\n' "$teamOut" | LC_ALL=C awk -v floor="$teamFloor" '/^[0-9]+\.[0-9]+ \| / { if ( $1 + 0 > floor + 0 ) { newest = $1 } } END { print newest }' )"
	for teamMember in $1 ; do
		teamId="${teamIdList#* $teamMember=}" ; teamId="${teamId%% *}"
		## WHAT THE TOOLING POSTED ITSELF IS NO MENTION (AgentsToolsTrackingDrop). The member's own post is no
		## filter here: a message carries only `[sender: <member>]`, so the root run and its duty are one word in
		## this read, and a tag from the other must wake it. A duty's own round posts go to its tooling thread,
		## so it cannot wake itself through the team channel.
		teamHit="$( printf '%s\n' "$teamOut" | AgentsToolsTrackingDrop "$teamMember" | MEMBER="$teamMember" MEMBER_ID="$teamId" FLOOR="$teamFloor" LC_ALL=C awk '
			/^[0-9]+\.[0-9]+ \| / {
				if ( $1 + 0 <= ENVIRON["FLOOR"] + 0 ) next
				if ( ENVIRON["MEMBER_ID"] != "" && index( $0, "<@" ENVIRON["MEMBER_ID"] ">" ) > 0 ) { hit = $1 ; if ( index( $0, "[sender: " ) == 0 && $0 !~ /:[a-z0-9_+-]+: \*_[a-z0-9-]+_\*/ ) human = $1 }
				else if ( index( $0, "@" ENVIRON["MEMBER"] ) > 0 ) { hit = $1 ; if ( index( $0, "[sender: " ) == 0 && $0 !~ /:[a-z0-9_+-]+: \*_[a-z0-9-]+_\*/ ) human = $1 }
			}
			END { print hit "\t" human }' )"
		AgentsToolsScheduleTagNote "$teamMember" "${teamHit%%$'\t'*}" "${teamHit#*$'\t'}"
	done
	if teamTemp="$( mktemp "$teamStore/team-channel.XXXXXX" 2> /dev/null )" ; then
		printf '%s %s\n' "$teamNow" "${teamNewest:-$teamFloor}" > "$teamTemp" && mv -f "$teamTemp" "$teamStore/team-channel" || rm -f "$teamTemp"
	fi
	return 0
}

## Whether the inbox of a member holds work: an item in incoming/ that is no standing state-and-lock note (the notes of the routines that lock stand
## in the coordinator's incoming/ and are no work).
AgentsToolsScheduleHasWork(){ ## member
	local workFile
	for workFile in "$( AgentsToolsInboxDir "$1" )"/* ; do
		[ -e "$workFile" ] || continue
		case "${workFile##*/}" in note-*-state-and-lock.md) continue ;; esac
		return 0
	done
	return 1
}

## Whether the board has something new for the coordinator's duty (F7.12): an item of the active states (the spawner's own dispatch-* tracking items aside,
## which are written at every start and end and are no news) written since the last duty ended, or an item whose recheck-date fell due since. The
## baseline is the modification time of the duty's lock note, written at the close of a duty; with no note, any such item is news. rc 0 where there is.
AgentsToolsScheduleBoardDemand(){
	local boardNote boardBase=0 boardNow boardState boardFile boardFiles=() boardRows boardEpoch
	boardNote="$( AgentsToolsInboxNotePath magic-coordinator note-20261020T000000Z-work-duty-state-and-lock.md )"
	boardNow="${agentsSchedulePassNow:-$( date +%s )}"
	if [ -f "$boardNote" ] ; then
		boardBase="$( stat -f '%m' "$boardNote" 2> /dev/null )" || boardBase=""
		case "$boardBase" in ''|*[!0123456789]*) boardBase="$( stat -c '%Y' "$boardNote" 2> /dev/null )" || boardBase="" ;; esac
		case "$boardBase" in ''|*[!0123456789]*) boardBase=0 ;; esac
	fi
	for boardState in pending running review blocked parked ; do
		for boardFile in "$MDAT_DATA_ROOT/board/$boardState"/*.md ; do
			[ -f "$boardFile" ] || continue
			case "${boardFile##*/}" in dispatch-*) continue ;; esac
			boardFiles+=( "$boardFile" )
		done
	done
	[ "${#boardFiles[@]}" -gt 0 ] || return 1
	[ -f "$boardNote" ] || return 0
	## Newer than the note: the shell's own test, one stat a file, and no process for the pass.
	for boardFile in ${boardFiles[@]+"${boardFiles[@]}"} ; do
		[ ! "$boardFile" -nt "$boardNote" ] || return 0
	done
	boardRows="$( LC_ALL=C awk 'FNR == 1 { fm = ( $0 == "---" ) ; next } fm && $0 == "---" { fm = 0 ; next } fm && index( $0, "recheck-date: " ) == 1 { print substr( $0, 15 ) }' ${boardFiles[@]+"${boardFiles[@]}"} 2> /dev/null | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/output/LocalIsoToEpoch.awk" 2> /dev/null )"
	while IFS= read -r boardEpoch ; do
		case "$boardEpoch" in ''|*[!0123456789]*) continue ;; esac
		[ "$boardEpoch" -gt "$boardBase" ] && [ "$boardEpoch" -le "$boardNow" ] && return 0
	done <<< "$boardRows"
	return 1
}

## THE TAGGED SOURCE OF A MEMBER, as the scheduler holds it: the newest message that calls the member (a mention in the team channel, or a DM to it --
## the two are one source, `tagged:<member>`, and the untagged team channel is another) in tags/<member>, a Slack ts; and the member's own pointer into it,
## handed/<member>, the ts of the newest one its duty was given -- set when a duty is started for it, and moved by the pointer the duty's own session keeps
## (collect:<member>:tagged:<member> in its session.chat.pointers). A tag is news when it is newer than that pointer. The channel is read once for every
## member (AgentsToolsScheduleTeamTags), the DMs once for each (AgentsToolsScheduleDmTags): a cache that feeds each member's own pointer, never one for all.
## THE TAG OF A PERSON, kept apart (tags-person/<member>; the folder was tags-human, whose files a first classifier wrote from agents' posts, so it is not read): a message that carries no `[sender: <member>]` was typed by a person. Out of its flags a member
## is started by a person's tag alone, never by another member's message, so the team's own talk at night starts no duty and spends no budget.
AgentsToolsScheduleTagNote(){ ## member, ts found (may be empty), the newest of them a person typed (may be empty)
	local noteOld="" noteHuman=""
	if [ -n "${3:-}" ] ; then
		[ ! -f "$MMDAPP/.local/agents/schedule/tags-person/$1" ] || read -r noteHuman < "$MMDAPP/.local/agents/schedule/tags-person/$1" || :
		case "${noteHuman%%.*}" in ''|*[!0123456789]*) noteHuman=0 ;; esac
		[ "${3%%.*}" -le "${noteHuman%%.*}" ] || { mkdir -p "$MMDAPP/.local/agents/schedule/tags-person" 2> /dev/null && printf '%s\n' "$3" > "$MMDAPP/.local/agents/schedule/tags-person/$1" ; }
	fi
	[ -n "$2" ] || return 0
	[ ! -f "$MMDAPP/.local/agents/schedule/tags/$1" ] || read -r noteOld < "$MMDAPP/.local/agents/schedule/tags/$1" || :
	case "${noteOld%%.*}" in ''|*[!0123456789]*) noteOld=0 ;; esac
	[ "${2%%.*}" -gt "${noteOld%%.*}" ] || return 0
	mkdir -p "$MMDAPP/.local/agents/schedule/tags" 2> /dev/null && printf '%s\n' "$2" > "$MMDAPP/.local/agents/schedule/tags/$1"
}

## The seconds of a member's pointer into its tagged source: the scheduler's (handed/<member>), and the member's own read pointer
## (member-pointers/<member>, which every session of the member moves), whichever is later. A member not kept there yet is read from the
## session given, else from its kept duty session (duty-session/<member>), where the pointer was kept before.
AgentsToolsScheduleTagPointer(){ ## member, the duty's session id (may be empty)
	local pointerOwn="" pointerSession=""
	if [ -z "${2:-}" ] && [ -s "$MMDAPP/.local/agents/schedule/duty-session/$1" ] ; then
		local pointerKept=""
		read -r pointerKept < "$MMDAPP/.local/agents/schedule/duty-session/$1" || :
		case "$pointerKept" in ''|*/*|.|..) ;; *) set -- "$1" "$pointerKept" ;; esac
	fi
	[ ! -f "$MMDAPP/.local/agents/schedule/handed/$1" ] || read -r pointerOwn < "$MMDAPP/.local/agents/schedule/handed/$1" || :
	case "${pointerOwn%%.*}" in ''|*[!0123456789]*) pointerOwn=0 ;; esac
	pointerOwn="${pointerOwn%%.*}"
	type AgentsToolsSessionChatPointer > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionChat.include" 2> /dev/null || :
	pointerSession="$( AgentsToolsSessionChatPointer "${2:-}" "collect:$1:tagged:$1" 2> /dev/null )" || pointerSession=""
	case "${pointerSession%%.*}" in ''|*[!0123456789]*) pointerSession=0 ;; esac
	pointerSession="${pointerSession%%.*}"
	[ "$pointerSession" -le "$pointerOwn" ] || pointerOwn="$pointerSession"
	printf '%s\n' "$pointerOwn"
}

## The duty is given what stands in the tagged source: the member's pointer moves to the newest tag.
AgentsToolsScheduleTagGive(){ ## member
	local giveTag=""
	[ ! -f "$MMDAPP/.local/agents/schedule/tags/$1" ] || read -r giveTag < "$MMDAPP/.local/agents/schedule/tags/$1" || :
	[ -n "$giveTag" ] || return 0
	mkdir -p "$MMDAPP/.local/agents/schedule/handed" 2> /dev/null && printf '%s\n' "$giveTag" > "$MMDAPP/.local/agents/schedule/handed/$1"
}

## The pointer the new duty resumes from, kept for the duty's own scan (AgentsTools.InternOpWorkDuty.include) before the give moves the member's
## pointer (handed/<member>) to the newest tag: the member's previous pointer, so a mention that arrived between the previous duty and this start is
## read by the new duty rather than skipped as "before now". Run at each start, whatever the give then does.
AgentsToolsScheduleTagCarry(){ ## member
	local carryFrom=""
	[ ! -f "$MMDAPP/.local/agents/schedule/handed/$1" ] || read -r carryFrom < "$MMDAPP/.local/agents/schedule/handed/$1" || :
	case "${carryFrom%%.*}" in ''|*[!0123456789]*) return 0 ;; esac
	mkdir -p "$MMDAPP/.local/agents/schedule/handed-from" 2> /dev/null && printf '%s\n' "$carryFrom" > "$MMDAPP/.local/agents/schedule/handed-from/$1"
}

## Whether the tagged source of a member holds a tag newer than its pointer (AgentsToolsScheduleTagPointer) and than an instant (epoch seconds, optional): a
## tag is how the member is called, at any hour. An untagged message of the channel is read by the work-duty scan in worktime, and by nothing else.
AgentsToolsScheduleTagNews(){ ## member, since (epoch seconds, may be empty), the duty's session id (may be empty)
	local newsTag="" newsFloor
	[ ! -f "$MMDAPP/.local/agents/schedule/${agentsScheduleTagsSub:-tags}/$1" ] || read -r newsTag < "$MMDAPP/.local/agents/schedule/${agentsScheduleTagsSub:-tags}/$1" || :
	case "${newsTag%%.*}" in ''|*[!0123456789]*) return 1 ;; esac
	newsFloor="$( AgentsToolsScheduleTagPointer "$1" "${3:-}" )"
	case "${2:-0}" in *[!0123456789]*) ;; *) [ "${2:-0}" -le "$newsFloor" ] || newsFloor="${2:-0}" ;; esac
	[ "${newsTag%%.*}" -gt "$newsFloor" ]
}

## The DMs of the members, looked at for each member on its own (a DM is a call by name, as a mention is): the conversations of the member's accounts
## (the roster of its direct ones), each read from the member's DM floor, dms/<member>, the ts up to which they were read -- a member's first look reads
## from now, as the channel's does. At most once in a minute for a member within its flags, once in five minutes out of them (the Slack read budget: every
## standing member is looked at then). What the tooling posted itself and the member's own posts are none. The newest DM message goes into the member's
## tagged source (AgentsToolsScheduleTagNote). <force> yes is the per-member sync's (AgentsTools.Incoming.include): the DMs are read now, whatever the
## TTL, for the members given.
## THE LOOK IS BOUNDED BY THE CLOCK: every roster and every read is a Slack call, and a pass under load spent 35 minutes here before it reached its
## start (MEL, 16:39 to 17:14, one member's 19 conversations most of it). Once MDAT_SCHEDULE_DM_BUDGET_SECONDS (60, 0 for no bound) of this call
## have gone, the members not yet looked at wait for the next pass, unstamped, so they are the first looked at then. A forced look has no bound.
AgentsToolsScheduleDmTags(){ ## the members within their flags to look for, spaced; the members out of them, spaced; force (yes|no)
	local dmStore="$MMDAPP/.local/agents/schedule" dmMember dmNow dmChecked dmFloor dmRoster dmLine dmConv dmKind dmIdentity dmAuth dmArg dmSeen dmRead dmNewest dmHuman dmId dmTtl dmBudget dmBegan dmLeft dmCut dmStamp
	## agentsScheduleDmNewest is the newest DM this call found, empty for none: the per-member sync's line (AgentsTools.Incoming.include).
	agentsScheduleDmNewest=""
	[ -n "$1$2" ] || return 0
	type AgentsToolsTrackingDrop > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.TrackingDrop.include"
	dmNow="${agentsSchedulePassNow:-$( date +%s )}"
	mkdir -p "$dmStore/dms" "$dmStore/dm-looked" 2> /dev/null || return 0
	## THE STAMP IS THE LOOK'S OWN MOMENT, not the pass clock: a pass that ran into minutes stamped every member with its start, so the TTL
	## read a look as fresh that was long past. One clock read a call, before the first member.
	dmStamp="$( date +%s )" || dmStamp="$dmNow"
	dmBudget="${MDAT_SCHEDULE_DM_BUDGET_SECONDS:-60}" dmBegan="$SECONDS" dmLeft=""
	case "$dmBudget" in ''|*[!0123456789]*) dmBudget=60 ;; esac
	[ "${3:-no}" != "yes" ] || dmBudget=0
	for dmMember in $1 $2 ; do
		if [ "$dmBudget" -gt 0 ] && [ $(( SECONDS - dmBegan )) -ge "$dmBudget" ] ; then dmLeft="$dmLeft $dmMember" ; continue ; fi
		dmTtl=60
		case " $2 " in *" $dmMember "*) dmTtl=300 ;; esac
		[ "${3:-no}" != "yes" ] || dmTtl=0
		dmChecked=""
		[ ! -f "$dmStore/dm-looked/$dmMember" ] || read -r dmChecked < "$dmStore/dm-looked/$dmMember" || :
		case "$dmChecked" in ''|*[!0123456789]*) dmChecked="" ;; esac
		[ -z "$dmChecked" ] || [ $(( dmNow - dmChecked )) -ge "$dmTtl" ] || continue
		printf '%s\n' "$dmStamp" > "$dmStore/dm-looked/$dmMember"
		dmFloor=""
		[ ! -f "$dmStore/dms/$dmMember" ] || read -r dmFloor < "$dmStore/dms/$dmMember" || :
		[ -n "$dmFloor" ] || dmFloor="$dmNow.000000"
		dmId="$( AgentsToolsSessionChatMemberId "$dmMember" )"
		type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
		## The member is the operation's --team-member: the front names the acting member, and a bare name after the operation is refused as an option.
		dmRoster="$( DistroAgentsTools --slack-conversations-roster --team-member "$dmMember" --types im 2> /dev/null < /dev/null )" || dmRoster=""
		dmSeen="" dmNewest="" dmHuman="" dmCut="" dmPassed="" dmPassedOne=""
		while IFS= read -r dmLine ; do
			case "$dmLine" in "CONV|"*) ;; *) continue ;; esac
			## A member cut mid-roster keeps its floor and loses its stamp: the next pass reads all of it again from the same floor, so no DM is passed over.
			if [ "$dmBudget" -gt 0 ] && [ $(( SECONDS - dmBegan )) -ge "$dmBudget" ] ; then dmCut=yes ; break ; fi
			dmConv="" dmKind="" dmIdentity="" dmAuth=""
			for dmArg in $( printf '%s\n' "$dmLine" | LC_ALL=C tr '|' ' ' ) ; do
				case "$dmArg" in
					id=*) dmConv="${dmArg#id=}" ;;
					kind=*) dmKind="${dmArg#kind=}" ;;
					identity=*) dmIdentity="${dmArg#identity=}" ;;
					auth=*) dmAuth="${dmArg#auth=}" ;;
				esac
			done
			[ -n "$dmConv" ] && [ "$dmKind" = "im" ] || continue
			case " $dmSeen " in *" $dmConv "*) continue ;; esac
			dmSeen="$dmSeen $dmConv"
			type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
			dmRead="$( DistroAgentsTools --intern-op-comms-slack-read "$dmMember" "$dmConv" $( [ "$dmIdentity" != "bot" ] || printf '%s' --identity-bot ) --oldest "$dmFloor" 2> /dev/null < /dev/null )" || continue
			## THE TEAM BOT'S DM IS THE COORDINATOR'S (the human-owner's rule): every member's roster lists it under the bot identity, so for
			## another member a message there counts only where it tags that member (<@id>, or a team post addressed to it).
			dmRead="$( printf '%s\n' "$dmRead" | AgentsToolsTrackingDrop "$dmMember" | DM_FLOOR="$dmFloor" DM_MEMBER="$dmMember" DM_ID="$dmId" DM_AUTH="$dmAuth" \
				DM_TAGGED_ONLY="$( [ "$dmIdentity" = bot ] && [ "$dmMember" != magic-coordinator ] \
					&& ! printf '%s\n' "$dmRoster" | LC_ALL=C grep -q -E "^CONV\|identity=user\|.*\|id=$dmConv\|" && printf yes )" LC_ALL=C awk '
				/^[0-9]+\.[0-9]+ \| / {
					if ( $1 + 0 <= ENVIRON["DM_FLOOR"] + 0 ) next
					if ( $1 + 0 > passed + 0 ) passed = $1
					if ( ENVIRON["DM_TAGGED_ONLY"] == "yes" && ! ( ( ENVIRON["DM_ID"] != "" && index( $0, "<@" ENVIRON["DM_ID"] ">" ) > 0 ) || ( index( $0, " → " ) > 0 && index( $0, "*_" ENVIRON["DM_MEMBER"] "_*" ) > 0 ) ) ) next
					if ( index( $0, "[sender: " ENVIRON["DM_MEMBER"] "]" ) > 0 ) next
					if ( ENVIRON["DM_ID"] != "" && index( $0, $1 " | " ENVIRON["DM_ID"] " |" ) == 1 ) next
					if ( $1 + 0 > newest + 0 ) newest = $1
					if ( index( $0, "[sender: " ) == 0 && $3 != ENVIRON["DM_AUTH"] && $3 != ENVIRON["DM_ID"] && $0 !~ /:[a-z0-9_+-]+: \*_[a-z0-9-]+_\*/ && $1 + 0 > human + 0 ) human = $1
				}
				END { print newest "\t" human "\t" passed }' )"
			## The third field is the newest message read past the floor, counted or not: the floor moves past it, so no pass reads it again.
			dmPassedOne="${dmRead##*$'\t'}" ; dmRead="${dmRead%$'\t'*}"
			if [ -n "$dmPassedOne" ] ; then
				if [ -z "$dmPassed" ] || [ "${dmPassedOne%%.*}" -gt "${dmPassed%%.*}" ] ; then dmPassed="$dmPassedOne" ; fi
			fi
			if [ -n "${dmRead%%$'\t'*}" ] ; then
				if [ -z "$dmNewest" ] || [ "${dmRead%%.*}" -gt "${dmNewest%%.*}" ] ; then dmNewest="${dmRead%%$'\t'*}" ; fi
			fi
			if [ -n "${dmRead#*$'\t'}" ] ; then
				if [ -z "$dmHuman" ] || [ "${dmRead#*$'\t'}" \> "$dmHuman" ] ; then dmHuman="${dmRead#*$'\t'}" ; fi
			fi
		done <<< "$dmRoster"
		if [ -n "$dmCut" ] ; then
			rm -f "$dmStore/dm-looked/$dmMember" 2> /dev/null
			dmLeft="$dmLeft $dmMember"
			continue
		fi
		if [ -n "$dmNewest" ] ; then
			agentsScheduleDmNewest="$dmNewest"
			printf '%s\n' "$dmNewest" > "$dmStore/dms/$dmMember"
			AgentsToolsScheduleTagNote "$dmMember" "$dmNewest" "$dmHuman"
		fi
		if [ -n "$dmPassed" ] && { [ -z "$dmNewest" ] || [ "$dmPassed" \> "$dmNewest" ] ; } ; then
			printf '%s\n' "$dmPassed" > "$dmStore/dms/$dmMember"
		elif [ -z "$dmNewest" ] && [ ! -f "$dmStore/dms/$dmMember" ] ; then
			printf '%s\n' "$dmFloor" > "$dmStore/dms/$dmMember"
		fi
	done
	[ -z "$dmLeft" ] || printf 'dms: the look took %ss, over its %ss bound: the DMs of%s wait for the next pass\n' "$(( SECONDS - dmBegan ))" "$dmBudget" "$dmLeft"
	return 0
}

## Whether a member has something to work on: an item in its inbox not yet processed (incoming/), for the coordinator also the board's news, or a
## mention in the team channel newer than the last start of its duty (tags/<member> against duty/<member>, both in epoch seconds).
AgentsToolsScheduleDemand(){ ## member
	! AgentsToolsScheduleHasWork "$1" || return 0
	[ "$1" != magic-coordinator ] || ! AgentsToolsScheduleBoardDemand || return 0
	AgentsToolsScheduleTagNews "$1"
}

## Tells a work-duty run to go, with DISMISSED in its session thread (a duty has its tooling thread only, S23.4, so the post goes there, addressed to it), as a dismissal is given to a run: at its idle point only (the run
## sits in a Wait, AgentsToolsManagerRunActivity), never while it works, never twice, and not while runs that need it still run. The
## sender is a member other than the one dismissed, whose own Wait ignores a DISMISSED it authored.
AgentsToolsScheduleDismiss(){ ## spawn record, why (a clause of the line printed), [now: given to a run that works too]
	local dismissRecord="$1" dismissWhy="${2:-it has no more duty}" dismissSpawn dismissMember dismissThread="" dismissBy dismissStore="$MMDAPP/.local/agents/schedule/dismissed" dismissStat=""
	dismissSpawn="${dismissRecord##*/}" ; dismissSpawn="${dismissSpawn%.spawn.md}"
	[ ! -e "$dismissStore/$dismissSpawn" ] || return 0
	type AgentsToolsManagerRunActivity > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/manager/AgentsTools.ManagerSession.include" --definitions-only > /dev/null 2>&1 || :
	if stat -f '%m' / > /dev/null 2>&1 ; then dismissStat="bsd" ; elif stat -c '%Y' / > /dev/null 2>&1 ; then dismissStat="gnu" ; fi
	## AT ITS IDLE POINT ONLY, unless the caller says now: the night and vacation rules tell a run that never goes idle, because it feeds itself work,
	## and the post waits in its thread until its next Wait, so it finishes the item it works on and then ends.
	[ "${3:-}" = now ] || [ "$( AgentsToolsManagerRunActivity "$dismissSpawn" "$dismissStat" )" = "waiting" ] || return 0
	AgentsToolsSessionDismissHeld "$dismissRecord" > /dev/null && return 0
	dismissMember="$( AgentsToolsSpawnSandboxRecordHeader "$dismissRecord" owner )"
	dismissThread="$( AgentsToolsSpawnSandboxRecordHeader "$dismissRecord" session-thread )"
	if [ -z "$dismissThread" ] || [ "$dismissThread" = "-" ] ; then
		dismissThread=""
		[ ! -f "${dismissRecord%/*}/session.thread" ] || IFS= read -r dismissThread < "${dismissRecord%/*}/session.thread" || :
	fi
	## A duty's record names no session thread (S23.4): its tooling thread is where it is told, by a post addressed to it, which its next Wait reads as a message to it.
	[ -n "$dismissThread" ] || dismissThread="$( AgentsToolsSpawnSandboxRecordHeader "$dismissRecord" agent-log-thread )"
	AgentsToolsSpawnConversationThreadValid "$dismissThread" || { printf 'work-duty: %s of %s is not told to go: it has neither a session thread nor a tooling thread to post in\n' "$dismissSpawn" "$dismissMember" ; return 0 ; }
	dismissBy=magic-coordinator
	[ "$dismissMember" != magic-coordinator ] || dismissBy=magic-librarian
	mkdir -p "$dismissStore" 2> /dev/null || return 0
	( set -C ; : > "$dismissStore/$dismissSpawn" ) 2> /dev/null || return 0
	type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
	if printf 'DISMISSED' | DistroAgentsTools --intern-op-comms-slack-send-message "$dismissBy" "$dismissThread" --identity-bot --address-to "$dismissMember" --from-stdin > /dev/null 2>&1 ; then
		printf 'work-duty: %s of %s is told to go (DISMISSED, at its idle point): %s\n' "$dismissSpawn" "$dismissMember" "$dismissWhy"
	else
		rm -f "$dismissStore/$dismissSpawn"
		printf 'work-duty: %s of %s could not be told to go: the post failed, tried again at the next iteration\n' "$dismissSpawn" "$dismissMember"
	fi
	return 0
}

## Whether a member of the roster is a standing member, one that holds a work-duty: a magic or keeper member that is not the team itself and not a
## reference-only record. A partner, warden or client member holds no duty: it is tasked or invited when needed, and its run ends with its task.
## A member whose directory holds no armed skill, `<member>.armed.md`, holds none either: the grants make a directory for a member name
## nobody set up (AgentsTools.Install.include, "Auto-created access-grant directory"), and the spawn refuses a member with no armed skill,
## so a duty start for it would fail at every pass.
AgentsToolsScheduleStanding(){ ## member, its directory
	case "$1" in
		magic-team) return 1 ;;
		magic-*|keeper-*) ;;
		*) return 1 ;;
	esac
	[ -f "$2/$1.armed.md" ] || return 1
	! AgentsToolsTeamMemberReferenceOnly "$2"
}

## The cache of a run, from its own log: what the harness said of the shared prefix on its last wake or rewind (round 1 of its leg, F10.7). `read`
## where the prefix was read from the cache; `nothing` where it was written or cached nothing, so that the wake read nothing from the cache;
## `unknown` where no such line is known (a native CLI prints none, a run just begun has none).
AgentsToolsScheduleDutyCache(){ ## spawn record
	local cacheFile cacheLine
	cacheFile="$( AgentsToolsSpawnSandboxRecordHeader "$1" output-file )"
	[ -n "$cacheFile" ] && [ -f "$cacheFile" ] || { printf 'unknown\n' ; return 0 ; }
	cacheLine="$( LC_ALL=C grep -a -F 'shared prefix -- round 1 ' "$cacheFile" 2> /dev/null | tail -n 1 )"
	case "$cacheLine" in
		*'round 1 read '*) printf 'read\n' ;;
		*'round 1 wrote '*|*'round 1 cached nothing'*) printf 'nothing\n' ;;
		*) printf 'unknown\n' ;;
	esac
}

## Whether a member takes part in a session besides its duty: a live run needs its duty (AgentsToolsSessionDismissHeld: its session's executor with others
## running, a run reporting to it) or another run of the member is live, any routine but its work-duty. rc 0 where it does.
AgentsToolsScheduleInSession(){ ## the duty's spawn record, member
	local sessionOther
	! AgentsToolsSessionDismissHeld "$1" > /dev/null || return 0
	while IFS= read -r sessionOther ; do
		[ -f "$sessionOther" ] && [ "$sessionOther" != "$1" ] || continue
		[ "$( AgentsToolsSpawnSandboxRecordHeader "$sessionOther" owner )" = "$2" ] || continue
		[ "$( AgentsToolsSpawnSandboxRecordHeader "$sessionOther" status )" = "spawn-started" ] || continue
		case "$( AgentsToolsSpawnSandboxRecordHeader "$sessionOther" routine )" in *.work-duty.routine.md) continue ;; esac
		AgentsToolsSessionRecordLive "$sessionOther" && return 0
	done <<< "$( type AgentsToolsSpawnedStartedRecords > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.StartedRecords.include" 2> /dev/null ; AgentsToolsSpawnedStartedRecords )"
	return 1
}

## How long a duty lives, decided at each iteration for a duty that is in its Wait (never one that works; a dismissal is given at an idle point only).
## It stays while the flags allow it (worktime; for the coordinator also emergency and overtime). Out of them it stays while it has input -- an item for
## it, for the coordinator the board's news -- or takes part in a session, and ends after an hour idle (3600). Whatever the flags, a duty whose last
## wake read nothing from the cache (AgentsToolsScheduleDutyCache) ends after 20 minutes idle (1200): each of its wakes would be paid whole. Where no
## cache figure is known the flags decide alone. Idle: since the first `wait going idle` line of the stretch that ends its milestones.
AgentsToolsScheduleDutyLifetime(){ ## the duty's spawn record, member, whether the flags allow (yes|no), whether the member is on vacation (yes|no)
	local lifeRecord="$1" lifeMember="$2" lifeAllowed="$3" lifeVacation="${4:-no}" lifeSpawn lifeStat="" lifeSince lifeIdle lifeLimit="" lifeWhy
	lifeSpawn="${lifeRecord##*/}" ; lifeSpawn="${lifeSpawn%.spawn.md}"
	## A MEMBER ON VACATION HOLDS NO DUTY: the duty that stands is told to go now, and takes it at its next Wait, as every dismissal is taken.
	if [ "$lifeVacation" = yes ] ; then
		AgentsToolsScheduleDismiss "$lifeRecord" "the member is on vacation" now
		return 0
	fi
	## OUT OF WORKTIME ONLY THE COORDINATOR RUNS (the team's plan): another member's duty is told to go now, whatever input it still finds, unless
	## a person called it by name since (tags-person), or it takes part in a session the coordinator opened. Overtime and emergency are the flags
	## (lifeAllowed), and the coordinator's own duty is the last to go, as below. Members come back when the coordinator decides, by a dispatch.
	if [ "$lifeAllowed" != yes ] && [ "$lifeMember" != magic-coordinator ] \
		&& ! AgentsToolsScheduleInSession "$lifeRecord" "$lifeMember" \
		&& ! agentsScheduleTagsSub=tags-person AgentsToolsScheduleTagNews "$lifeMember" "" "$( AgentsToolsSpawnSandboxRecordHeader "$lifeRecord" session-id )" ; then
		AgentsToolsScheduleDismiss "$lifeRecord" "out of worktime only the coordinator runs, and no person called this member" now
		return 0
	fi
	type AgentsToolsManagerRunIdleSince > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/manager/AgentsTools.ManagerSession.include" --definitions-only > /dev/null 2>&1 || :
	type AgentsToolsManagerRunIdleSince > /dev/null 2>&1 || return 0
	if stat -f '%m' / > /dev/null 2>&1 ; then lifeStat="bsd" ; elif stat -c '%Y' / > /dev/null 2>&1 ; then lifeStat="gnu" ; fi
	lifeSince="$( AgentsToolsManagerRunIdleSince "$lifeSpawn" "$lifeStat" )" || return 0
	lifeIdle=$(( ${agentsSchedulePassNow:-$( date +%s )} - lifeSince ))
	if [ "$( AgentsToolsScheduleDutyCache "$lifeRecord" )" = nothing ] ; then
		lifeLimit=1200 ; lifeWhy="its last wake read nothing from the cache, and it was idle $(( lifeIdle / 60 )) minutes"
	elif [ "$lifeAllowed" != yes ] ; then
		! AgentsToolsScheduleHasWork "$lifeMember" || return 0
		[ "$lifeMember" != magic-coordinator ] || ! AgentsToolsScheduleBoardDemand || return 0
		## OFF-DUTY ENDS WITH THE COORDINATOR: its duty is the last to go, as it was the first to start (AgentsToolsScheduleDutyOrder). While
		## another member's duty is still live, the coordinator's stays, whatever its own idle time.
		[ "$lifeMember" != magic-coordinator ] || ! AgentsToolsScheduleOtherDutyLive || return 0
		! AgentsToolsScheduleInSession "$lifeRecord" "$lifeMember" || return 0
		! AgentsToolsScheduleTagNews "$lifeMember" "$lifeSince" "$( AgentsToolsSpawnSandboxRecordHeader "$lifeRecord" session-id )" || return 0
		lifeLimit=3600 ; lifeWhy="out of worktime with no input, and it was idle $(( lifeIdle / 60 )) minutes"
	fi
	[ -n "$lifeLimit" ] && [ "$lifeIdle" -ge "$lifeLimit" ] || return 0
	AgentsToolsScheduleDismiss "$lifeRecord" "$lifeWhy"
}

## The day a duty's greeting is owed on, in the clock worktime reads (MDAT_SCHEDULE_TIMEZONE, host-local where none is set).
## `ask` prints `yes` where no duty start has opened that day yet and `no` where one has; `record` opens it.
AgentsToolsScheduleDayFirst(){ ## ask|record
	local dayVerb="$1" dayClock dayNow dayInto dayStart dayStore="$MMDAPP/.local/agents/schedule/day-first"
	dayClock="$( AgentsToolsScheduleClock )"
	dayNow="${dayClock%% *}" ; dayInto="${dayClock##* }"
	case "$dayNow:$dayInto" in *[!0123456789:]*) return 0 ;; esac
	dayStart=$(( dayNow - dayInto ))
	if [ "$dayVerb" = "record" ] ; then
		mkdir -p "${dayStore%/*}" 2> /dev/null && printf '%s\n' "$dayStart" > "$dayStore" 2> /dev/null
		return 0
	fi
	[ "$( cat "$dayStore" 2> /dev/null )" = "$dayStart" ] && printf 'no\n' || printf 'yes\n'
	return 0
}

## The work-duty sessions by the flags (epic 1758-1763): a standing member holds one during worktime, magic-coordinator during worktime,
## emergency and overtime. A standing member is every member of the roster but an identity record (human-owner) and the oncall and expert
## ones, who are no standing members. One is started when its member has something to work on (AgentsToolsScheduleDemand), the work-duty
## routine, `--spawn-session --routine <work-duty> <member>`; not while the member holds one already. Out of its flags a member is called by name only:
## a mention of it in the team channel (AgentsToolsScheduleTagNews) starts its duty at any hour, and an untagged message, an inbox item or the board's news do
## not; the team channel is read once in a TTL for all of them. What the flags do to a run that stands is not a dismissal at once:
## AgentsToolsScheduleDutyLifetime decides, at each iteration, how long it lives (a mention newer than its idle start keeps it, out of its flags too).
## The started records of work-duty runs, a path a line: the kept list of started records (AgentsTools.StartedRecords.include) cut to those whose routine is a work-duty one,
## so a pass looks at the few runs that stand and never at every duty record there ever was.
AgentsToolsScheduleStartedDutyRecords(){
	local startedAll
	type AgentsToolsSpawnedStartedRecords > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.StartedRecords.include" 2> /dev/null || return 0
	startedAll="$( AgentsToolsSpawnedStartedRecords )"
	[ -n "$startedAll" ] || return 0
	printf '%s\n' "$startedAll" | LC_ALL=C tr '\n' '\0' | LC_ALL=C xargs -0 grep -l -E '^routine: [A-Za-z0-9-]+\.work-duty\.routine\.md$' 2> /dev/null
	return 0
}

## THE ORDER DUTIES ARE STARTED IN (S12.24): the coordinator first, then the magic-* members, then every other member, each group in
## the directory's own order. Directory rows (`<member><TAB><dir>`) on stdin, the same rows out, so a pass that starts several
## duties starts the coordinator's before a keeper's. One awk, no sort: the rows are few.
AgentsToolsScheduleDutyOrder(){
	LC_ALL=C awk -F'\t' '
		{ if ( $1 == "magic-coordinator" ) first[++f] = $0 ; else if ( index( $1, "magic-" ) == 1 ) second[++s] = $0 ; else rest[++r] = $0 }
		END { for ( i = 1 ; i <= f ; i++ ) print first[i] ; for ( i = 1 ; i <= s ; i++ ) print second[i] ; for ( i = 1 ; i <= r ; i++ ) print rest[i] }
	'
}

AgentsToolsScheduleWorkDuty(){
	local dutyFlags dutyWork=no dutyCoordinator=no dutyMember dutyDir dutyAllowed dutyRecord dutyLook="" dutyLookOut="" dutyWhy="" dutyWarmAt="" dutyStale dutyPace="" dutyOwners dutyUrgent="" dutyMagic="" dutyNow dutyVacation
	## THE PACE IS READ ONCE A PASS (S12.13), before any start is decided, and said in one line: a person can then tell a slow machine from a
	## stopped schedule. It gates a start; it is never a load average and never a count of what runs.
	dutyPace="$( AgentsToolsSchedulePaceText )"
	printf '%s\n' "$dutyPace"
	## The pass's one start begins here: the duties are the pass's first starter, and the pending items read the marker after them.
	agentsSchedulePassStarted=""
	## A duty record that says started while its run is gone is closed here, from the liveness reading, so the restart rule below reads an end and not a status (S23.6).
	while IFS= read -r dutyStale ; do
		[ -n "$dutyStale" ] || continue
		AgentsToolsScheduleDutyStaleClose "$dutyStale"
	done <<< "$( AgentsToolsScheduleStartedDutyRecords )"
	## A live work-duty of a member that holds none (partner, warden, client, AgentsToolsScheduleStanding) is told to go at its idle point.
	while IFS= read -r dutyStale ; do
		[ -n "$dutyStale" ] && [ -f "$dutyStale" ] || continue
		[ "$( AgentsToolsSpawnSandboxRecordHeader "$dutyStale" status )" = "spawn-started" ] || continue
		case "$( AgentsToolsSpawnSandboxRecordHeader "$dutyStale" owner )" in
			magic-team|'') ;;
			magic-*|keeper-*) continue ;;
		esac
		AgentsToolsScheduleDismiss "$dutyStale" "its member holds no work-duty: partner, warden and client members are tasked or invited when needed"
	done <<< "$( AgentsToolsScheduleStartedDutyRecords )"
	dutyFlags="$( AgentsToolsScheduleCurrentFlags --current-flags 2> /dev/null )" || dutyFlags=""
	## Team overtime is a duty out of hours for the magic members alone; emergency is the coordinator, and a member only for its own urgent-tier pending task.
	case "$dutyFlags" in *"worktime: yes"*) dutyWork=yes ; dutyCoordinator=yes ;; esac
	case "$dutyFlags" in *"overtime: yes"*) dutyMagic=yes ; dutyCoordinator=yes ;; esac
	case "$dutyFlags" in *"emergency: yes"*) dutyCoordinator=yes ; [ "$dutyWork" = yes ] || dutyUrgent=yes ;; esac
	## The owners of the pending board items, dispatch-* aside, read once a pass; in emergency out of hours, of the urgent tier alone.
	dutyOwners=$'\n'"$( set -- "$MDAT_DATA_ROOT/board/pending"/*.md ; [ -f "$1" ] || exit 0 ; LC_ALL=C awk -v marks=" ${dutyUrgent:+emergency urgent} " '
		FNR == 1 { owner = "" ; mark = "" ; if ( $0 != "---" || FILENAME ~ /\/dispatch-[^\/]*$/ ) nextfile ; next ; }
		$0 == "---" { if ( owner != "" && ( marks == "  " || index( marks, " " mark " " ) ) ) print owner ; nextfile ; }
		index( $0, "owner: " ) == 1 { owner = substr( $0, 8 ) ; }
		index( $0, "mark: " ) == 1 { mark = substr( $0, 7 ) ; }
	' "$@" 2> /dev/null )"$'\n'
	dutyNow="${agentsSchedulePassNow:-$( date +%s )}"
	## The members whose mentions are looked for: those within their flags that have no duty running -- a member with inbox work is looked at too, so a
	## mention that arrives while its work waits is kept for its duty -- and every standing member out of its flags, for a mention starts or keeps its
	## duty. The team channel is read once for all.
	while IFS=$'\t' read -r dutyMember dutyDir ; do
		[ -n "$dutyDir" ] || continue
		AgentsToolsScheduleStanding "$dutyMember" "$dutyDir" || continue
		dutyAllowed="$dutyWork"
		[ "$dutyAllowed" = yes ] || [ -z "$dutyMagic" ] || case "$dutyMember" in magic-*) dutyAllowed=yes ;; esac
		[ "$dutyMember" != magic-coordinator ] || dutyAllowed="$dutyCoordinator"
		[ "$dutyAllowed" = yes ] || [ -z "$dutyUrgent" ] || case "$dutyOwners" in *$'\n'"$dutyMember"$'\n'*) dutyAllowed=yes ;; esac
		[ "$dutyAllowed" = yes ] || [ -z "$dutyUrgent" ] || ! LC_ALL=C grep -q -x -F 'from: magic-coordinator' "$( AgentsToolsInboxDir "$dutyMember" )"/*.md 2> /dev/null || dutyAllowed=yes
		[ "$dutyAllowed" = yes ] || [ -z "$( AgentsToolsScheduleMemberFlag overtime "$dutyMember" "$dutyNow" )" ] || dutyAllowed=yes
		## A member on vacation is looked at for nothing: no tag, no mention, no duty.
		[ -z "$( AgentsToolsScheduleMemberFlag vacation "$dutyMember" "$dutyNow" )" ] || continue
		if [ "$dutyAllowed" = yes ] ; then
			! AgentsToolsScheduleWorkDutyRecord "$dutyMember" > /dev/null || continue
			dutyLook="$dutyLook $dutyMember"
		else
			dutyLookOut="$dutyLookOut $dutyMember"
		fi
	done <<< "$( AgentsToolsTeamMemberDirectoryText )"
	AgentsToolsScheduleTeamTags "${dutyLook# } ${dutyLookOut# }"
	AgentsToolsScheduleDmTags "${dutyLook# }" "${dutyLookOut# }"
	while IFS=$'\t' read -r dutyMember dutyDir ; do
		[ -n "$dutyDir" ] || continue
		AgentsToolsScheduleStanding "$dutyMember" "$dutyDir" || continue
		dutyAllowed="$dutyWork"
		[ "$dutyAllowed" = yes ] || [ -z "$dutyMagic" ] || case "$dutyMember" in magic-*) dutyAllowed=yes ;; esac
		[ "$dutyMember" != magic-coordinator ] || dutyAllowed="$dutyCoordinator"
		[ "$dutyAllowed" = yes ] || [ -z "$dutyUrgent" ] || case "$dutyOwners" in *$'\n'"$dutyMember"$'\n'*) dutyAllowed=yes ;; esac
		[ "$dutyAllowed" = yes ] || [ -z "$dutyUrgent" ] || ! LC_ALL=C grep -q -x -F 'from: magic-coordinator' "$( AgentsToolsInboxDir "$dutyMember" )"/*.md 2> /dev/null || dutyAllowed=yes
		[ "$dutyAllowed" = yes ] || [ -z "$( AgentsToolsScheduleMemberFlag overtime "$dutyMember" "$dutyNow" )" ] || dutyAllowed=yes
		dutyVacation=""
		[ -z "$( AgentsToolsScheduleMemberFlag vacation "$dutyMember" "$dutyNow" )" ] || { dutyAllowed=no ; dutyVacation=yes ; }
		dutyRecord="$( AgentsToolsScheduleWorkDutyRecord "$dutyMember" )" || dutyRecord=""
		if [ -n "$dutyRecord" ] ; then
			AgentsToolsScheduleDutyLifetime "$dutyRecord" "$dutyMember" "$dutyAllowed" "${dutyVacation:-no}"
			continue
		fi
		## A member on vacation is started by nothing the schedule holds, a mention in the team channel included: it is invited or tasked by hand.
		[ -z "$dutyVacation" ] || continue
		dutyWhy=""
		## A WORK-DUTY STARTS ON FIRST DEMAND AND IS NEVER STARTED TO KEEP A CACHE WARM (sketch 10.4, 7.3): it is a loop in one session, and
		## its cache is kept inside that session by the keepalive round of its --idle-wait, never by ending the run and starting another.
		## The session a duty keeps for its restarts (AgentsToolsScheduleSpawn) ends with worktime: out of its flags, with no duty running,
		## the member's kept id goes, and its next worktime opens a session of its own.
		## THE PACE GATES THE START (S12.13): while the median tool call is 7 s or more, no duty is started. The pass's own pace line already says
		## why, once, so this says nothing per member. A duty already running is not touched here: its lifetime is
		## AgentsToolsScheduleDutyLifetime's, and the pace governs starts alone.
		AgentsToolsSchedulePaceAllows || continue
		## THE COORDINATOR'S OFF-DUTY: out of worktime the other members' duties are told to go (AgentsToolsScheduleDutyLifetime), and the coordinator
		## alone is started on demand at any hour, to decide what comes next and to dispatch the members it wants. Its duty is not kept by the flags
		## out of worktime: it ends after an hour idle with no input, the last to go (AgentsToolsScheduleDutyLifetime).
		if [ "$dutyAllowed" = yes ] || [ "$dutyMember" = magic-coordinator ] ; then
			## A DUTY THAT ENDED IS STARTED AGAIN, on the one rule AgentsToolsScheduleDutyRestartDue states, and
			## the dismissal marker is what keeps it down. Demand is still the ordinary start.
			if AgentsToolsScheduleDutyRestartDue "$dutyMember" > /dev/null ; then
				dutyWhy=" (restarted after its last run ended)"
			else
				case "$dutyOwners" in
					*$'\n'"$dutyMember"$'\n'*) dutyWhy=" (it owns a pending board task)" ;;
					*) AgentsToolsScheduleDemand "$dutyMember" || continue ;;
				esac
			fi
		else
			## The kept session's read pointer into the tagged source is folded into the schedule's own (handed/<member>) before the kept id
			## goes: otherwise a tag that duty already read looks new against the older pointer, and starts a duty out of hours for nothing.
			local dutyKept=""
			[ ! -f "$MMDAPP/.local/agents/schedule/duty-session/$dutyMember" ] || read -r dutyKept < "$MMDAPP/.local/agents/schedule/duty-session/$dutyMember" || :
			type AgentsToolsDutyKeptTagFold > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.StartedRecords.include" 2> /dev/null || :
			[ -z "$dutyKept" ] || AgentsToolsDutyKeptTagFold "$dutyMember" "$dutyKept"
			rm -f "$MMDAPP/.local/agents/schedule/duty-session/$dutyMember" 2> /dev/null || :
			## Out of its flags: a tag (a mention, a DM) newer than its pointer into the tagged source, and nothing else.
			agentsScheduleTagsSub=tags-person AgentsToolsScheduleTagNews "$dutyMember" || continue
		fi
		if AgentsToolsScheduleSpawn "work-duty.$dutyMember" --session-thread:event-track --routine "$( AgentsToolsScheduleDutyRoutine "$dutyMember" "$dutyDir" )" "$dutyMember" ; then
			mkdir -p "$MMDAPP/.local/agents/schedule/duty" 2> /dev/null && date +%s > "$MMDAPP/.local/agents/schedule/duty/$dutyMember"
			AgentsToolsScheduleTagCarry "$dutyMember"
			AgentsToolsScheduleTagGive "$dutyMember"
			printf 'work-duty: started the duty of %s%s\n' "$dutyMember" "$dutyWhy"
			## ONE DUTY START PER PASS. The pace is a median over the last half hour, cached for a minute: within one pass it cannot show
			## what the start just made of the machine, and after a restart it reads "too few to judge" and would permit every member at once.
			## The next pass, minutes on, reads the pace with this run's calls in it, and starts the next duty or holds. The members behind
			## this one keep their place in the duty order.
			printf 'work-duty: one start a pass; the duties still due wait for the next pass\n'
			agentsSchedulePassStarted="work-duty.$dutyMember"
			break
		fi
	done <<< "$( AgentsToolsTeamMemberDirectoryText | AgentsToolsScheduleDutyOrder )"
	return 0
}

## --- important and emergency inputs (T3) ---

## The coordinator's incoming checked for items marked important or emergency (T3 of the 20261021 refactorings epic): an item of
## magic-coordinator's incoming/ whose frontmatter carries `mark: important`, `mark: urgent` or `mark: emergency`. An important or urgent item is spawned for; an
## emergency item is confirmed with the owner and sets the emergency flag. In worktime the work-duty step already starts the coordinator on its
## inbox work; out of it the advance routine, the one-shot handling block, is started instead. Never fatal; one line for each thing done.
AgentsToolsScheduleImportantEmergency(){
	local markFlags markWork=no markFile markMark markImportant="" markEmergency="" markEmergencyItem=""
	markFlags="$( AgentsToolsScheduleCurrentFlags --current-flags 2> /dev/null )" || markFlags=""
	case "$markFlags" in *"worktime: yes"*) markWork=yes ;; esac
	for markFile in "$( AgentsToolsInboxDir magic-coordinator )"/*.md ; do
		[ -e "$markFile" ] || continue
		case "${markFile##*/}" in note-*-state-and-lock.md) continue ;; esac
		markMark="$( LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsBoardItemFrontmatterPrint.awk" "$markFile" 2> /dev/null | LC_ALL=C sed -n 's/^mark: //p' | LC_ALL=C tail -n 1 )"
		case "$markMark" in
			important|urgent) markImportant="yes" ;;
			emergency) markEmergency="yes" ; markEmergencyItem="${markFile##*/}" ;;
		esac
	done
	[ -n "$markImportant$markEmergency" ] || return 0
	[ -z "$markEmergency" ] || AgentsToolsScheduleEmergencyConfirm "$markEmergencyItem"
	if [ "$markWork" = no ] ; then
		if AgentsToolsScheduleSpawn "advance.magic-coordinator" --routine "magic-team.advance.routine.md" magic-coordinator ; then
			printf 'important-emergency: started the advance routine of magic-coordinator\n'
		fi
	fi
	return 0
}

## The emergency confirmation (T3): an emergency item is confirmed with the owner and the flag set in the same loop (notify-and-set, the
## settled reading). The tooling posts the confirmation to the owner (once per item, in the owner's direct channel) and sets the flag
## through the schedule's own override (AgentsToolsScheduleOverride), the one path to the MDAT_SCHEDULE_EMERGENCY setting; the emergency
## TTL is a fixed 3600s.
AgentsToolsScheduleEmergencyConfirm(){ ## the emergency item's file name
	local confirmItem="$1" confirmStore="$MMDAPP/.local/agents/schedule/emergency-confirm" confirmTtl=3600
	[ -n "$confirmItem" ] || return 0
	mkdir -p "$confirmStore" 2> /dev/null || return 0
	[ ! -e "$confirmStore/$confirmItem" ] || return 0
	( set -C ; : > "$confirmStore/$confirmItem" ) 2> /dev/null || return 0
	if ! printf 'An emergency item arrived in the coordinator%s incoming (%s). Confirm the emergency to set the emergency flag.\n' "'s" "$confirmItem" \
		| DistroAgentsTools --intern-op-comms-slack-send-message magic-coordinator human-owner --identity-bot --from-stdin > /dev/null 2>&1 ; then
		rm -f "$confirmStore/$confirmItem"
		printf 'important-emergency: the emergency confirmation for %s could not be posted, tried again at the next iteration\n' "$confirmItem"
		return 0
	fi
	AgentsToolsScheduleOverride --override-flag emergency "$confirmTtl" > /dev/null 2>&1 || :
	printf 'important-emergency: emergency %s confirmed with the owner, the flag set for %ss\n' "$confirmItem" "$confirmTtl"
	return 0
}

## THE SUPERVISION RUN OF THIS RIG (S13.1, S13.12): while the `supervised` flag is on, one run of
## `magic-coordinator.supervision-session.routine` is kept alive here, and the flag going off is what ends it.
## The run is started through the spawner as the coordinator itself, on the preset its own tier names, and never
## on a service this start asks for (`--spawn-cli-service` is given nothing). Its session is one session, kept as
## the duty's is (`schedule/supervision-session/magic-coordinator`), so a start after a crash posts into the same
## thread instead of opening another. A run the owner dismissed is the owner's word and is never restarted by this
## rule, and a run that ended a moment ago waits the same sleep the resume waits before another is started.
## One line for each thing done, never fatal.
agentsScheduleSupervisionRoutine="magic-coordinator.supervision-session.routine.md"
AgentsToolsScheduleSupervision(){ ## --
	local supFlags supOn=no supLive supRecord supSpawn supNewest supNewestAt supStat="" supWait supNow supDismissed
	type AgentsToolsSpawnedRecordsOfRoutine > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.StartedRecords.include" 2> /dev/null
	supFlags="$( AgentsToolsScheduleCurrentFlags --current-flags 2> /dev/null )" || supFlags=""
	case "$supFlags" in *"supervised: yes"*) supOn=yes ;; esac
	supLive=""
	while IFS= read -r supRecord ; do
		[ -f "$supRecord" ] || continue
		[ "$( AgentsToolsSpawnSandboxRecordHeader "$supRecord" owner )" = magic-coordinator ] || continue
		[ "$( AgentsToolsSpawnSandboxRecordHeader "$supRecord" status )" = spawn-started ] || continue
		supSpawn="${supRecord##*/}" ; supSpawn="${supSpawn%.spawn.md}"
		type AgentsToolsLivenessOf > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.Registries.include"
		[ "$( AgentsToolsLivenessOf "$supSpawn" "$supRecord" )" = alive ] || continue
		supLive="$supRecord" ; break
	done <<< "$( type AgentsToolsSpawnedRecordsOfRoutine > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.StartedRecords.include" 2> /dev/null ; AgentsToolsSpawnedRecordsOfRoutine "$agentsScheduleSupervisionRoutine" supervision )"
	if [ -n "$supLive" ] ; then
		if [ "$supOn" != yes ] ; then
			supSpawn="${supLive##*/}" ; supSpawn="${supSpawn%.spawn.md}"
			supDismissed=no
			[ ! -e "$MMDAPP/.local/agents/schedule/dismissed/$supSpawn" ] || supDismissed=yes
			AgentsToolsScheduleDismiss "$supLive" "the supervised flag is off"
			## THE LINE NAMES A DISMISSAL THAT LANDED, AND NOTHING ELSE (S13.1): the call above returns 0 without posting when the run is
			## not at its idle point, and when its post failed and its mark was taken back. Its mark, new in this iteration, is what tells
			## a landing from those, and from a mark an earlier iteration already made.
			[ "$supDismissed" = no ] || return 0
			[ -e "$MMDAPP/.local/agents/schedule/dismissed/$supSpawn" ] || return 0
			printf 'supervision: %s of magic-coordinator is told to go, the supervised flag being off\n' "$supSpawn"
		fi
		return 0
	fi
	[ "$supOn" = yes ] || return 0
	## The newest record of the routine, by its own mtime: the close writes it. A dismissed one is the owner's
	## word and is left where it lies; one that ended inside the sleep is not replaced yet.
	supNewest="" supNewestAt=0
	if stat -f '%m' / > /dev/null 2>&1 ; then supStat="bsd" ; elif stat -c '%Y' / > /dev/null 2>&1 ; then supStat="gnu" ; fi
	while IFS= read -r supRecord ; do
		[ -f "$supRecord" ] || continue
		case "$supStat" in
			bsd) supNow="$( stat -f '%m' "$supRecord" 2> /dev/null )" || supNow="" ;;
			*) supNow="$( stat -c '%Y' "$supRecord" 2> /dev/null )" || supNow="" ;;
		esac
		case "$supNow" in ''|*[!0123456789]*) continue ;; esac
		[ "$supNow" -gt "$supNewestAt" ] || continue
		supNewest="$supRecord" ; supNewestAt="$supNow"
	done <<< "$( AgentsToolsSpawnedRecordsOfRoutine "$agentsScheduleSupervisionRoutine" supervision )"
	if [ -n "$supNewest" ] ; then
		supSpawn="${supNewest##*/}" ; supSpawn="${supSpawn%.spawn.md}"
		if [ -e "$MMDAPP/.local/agents/schedule/dismissed/$supSpawn" ] ; then
			printf 'supervision: %s of magic-coordinator was dismissed, so the flag starts no other: the flag is on, and one run is what it governs\n' "$supSpawn"
			return 0
		fi
		supWait="${SUPERVISE_RESUME_SECONDS:-${DUTY_RESTART_SECONDS:-300}}"
		case "$supWait" in ''|*[!0123456789]*) supWait=300 ;; esac
		supNow="${agentsSchedulePassNow:-$( date +%s 2> /dev/null )}" || supNow=0
		[ "$(( supNow - supNewestAt ))" -ge "$supWait" ] || return 0
	fi
	if AgentsToolsScheduleSpawn "supervision.magic-coordinator" --session-thread:event-track --routine "$agentsScheduleSupervisionRoutine" magic-coordinator ; then
		printf 'supervision: started %s for magic-coordinator, the supervised flag being on\n' "$agentsScheduleSupervisionRoutine"
	fi
	return 0
}

## --- the learning inquiry ---

## When learning is on, each session that has ended since the last look gets one inquiry into magic-librarian's inbox, to analyse its transcript
## and its reflections and to process the proposals for retro; when it is off nothing is sent, and a session that ended meanwhile is never sent
## later. Every session is looked at once (a mark in learned/), the first look of a workspace marking the sessions already ended without
## sending: a history is no news. A session whose only member is magic-librarian is not sent (its own inquiry would call for another). The
## text is the learning-inquiry block of the tooling-note template.
AgentsToolsScheduleLearning(){
	local learnStore="$MMDAPP/.local/agents/schedule/learned" learnFirst="" learnOn=no learnRows learnKind learnId learnName learnState learnRest learnMembers learnMember learnOnly learnText learnFile learnStamp
	[ -d "$learnStore" ] || learnFirst="yes"
	mkdir -p "$learnStore" 2> /dev/null || return 0
	[ "$( AgentsToolsScheduleCurrentFlags --current-flags 2> /dev/null | LC_ALL=C sed -n 's/^learning: //p' )" != yes ] || learnOn=yes
	type AgentsToolsDispatcherManager > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.Dispatcher.include"
	AgentsToolsDispatcherManager 2> /dev/null || return 0
	learnRows="$( AgentsToolsManagerSessionRows --schedule-learning "" 2> /dev/null )" || return 0
	while IFS=$'\t' read -r learnKind learnId learnName learnState learnRest ; do
		[ "$learnKind" = session ] && [ "$learnState" = finished ] || continue
		case "$learnId" in ''|*/*|.|..) continue ;; esac
		[ ! -e "$learnStore/$learnId" ] || continue
		( set -C ; : > "$learnStore/$learnId" ) 2> /dev/null || continue
		[ -z "$learnFirst" ] || continue
		[ "$learnOn" = yes ] || continue
		## A session ended by order (control/closed), a start that died or a run closed from the console, holds nothing to learn from.
		[ ! -f "$MMDAPP/.local/agents/sessions/$learnId/control/closed" ] || continue
		learnMembers="$( printf '%s\n' "$learnRows" | LC_ALL=C awk -F'\t' -v want="$learnId" '$1 == "run" && $2 == want { print $4 }' | LC_ALL=C sort -u )"
		learnOnly=yes
		for learnMember in $learnMembers ; do
			[ "$learnMember" = magic-librarian ] || learnOnly=no
		done
		[ "$learnOnly" = no ] || continue
		## ONLY A SESSION WITH SOMETHING TO LEARN FROM (the human-owner's rule, with the learning flag above): a reflection filed from it
		## (its `from-session:`), or a `learn` mark put on it (sessions/<id>/learn) -- the place a reaction signal lands. A refusal is routine
		## and is no signal. A session with neither is analysed by nobody: its work is on the board, and the retro reads that.
		if [ ! -e "$MMDAPP/.local/agents/sessions/$learnId/learn" ] \
			&& ! LC_ALL=C grep -r -l -x -F -- "from-session: $learnId" "${MDAT_DATA_ROOT:-/nonexistent}/inboxes" --include='reflection-*.md' > /dev/null 2>&1 ; then
			printf 'learning: session %s ended with no reflection and no learn mark: nothing to analyse, no inquiry\n' "$learnId"
			continue
		fi
		type AgentsToolsEscalationNote > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.MemberEscalation.include" --definitions-only > /dev/null 2>&1 || :
		learnText="$( ASKP_F_session="$learnId" ASKP_F_members="$( printf '%s' "$learnMembers" | LC_ALL=C tr '\n' ' ' | LC_ALL=C sed 's/ $//' )" AgentsToolsEscalationNote "Schedule/learning-inquiry" )" || learnText=""
		if [ -z "$learnText" ] ; then
			echo "⚠️ WARNING: $MDSC_CMD: the learning inquiry for session $learnId could not be filled from its template (tooling-note.post.format.md, Schedule/learning-inquiry)" >&2
			continue
		fi
		learnStamp="$( date -u +%Y%m%dT%H%MZ )"
		mkdir -p "$MMDAPP/.local/temp" 2> /dev/null
		learnFile="$( mktemp "$MMDAPP/.local/temp/schedule-learning.XXXXXX" )" || continue
		printf '%s\n' "$learnText" > "$learnFile" || { rm -f "$learnFile" ; continue ; }
		type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
		if DistroAgentsTools --upsert-inbox-inquiry magic-librarian "inquiry-$learnStamp-learning-$learnId.md" --from-member magic-coordinator --from-file "$learnFile" > /dev/null 2>&1 ; then
			printf 'learning: session %s ended: one inquiry to magic-librarian\n' "$learnId"
		else
			rm -f "$learnStore/$learnId"
			printf 'learning: session %s ended and its inquiry to magic-librarian could not be filed, tried again at the next iteration\n' "$learnId"
		fi
		rm -f "$learnFile"
	done <<< "$learnRows"
	return 0
}

## The steps, in order. One line for each thing done.
## Whether a member runs a session now: a record it owns that is started and still a process.
AgentsToolsScheduleMemberRuns(){ ## member
	local runsRecord
	## The started records come from the kept list (AgentsTools.StartedRecords.include), never a read of the whole spawned/ tree for each call.
	while IFS= read -r runsRecord ; do
		[ -f "$runsRecord" ] || continue
		[ "$( AgentsToolsSpawnSandboxRecordHeader "$runsRecord" owner )" = "$1" ] || continue
		[ "$( AgentsToolsSpawnSandboxRecordHeader "$runsRecord" status )" = "spawn-started" ] || continue
		AgentsToolsSessionRecordLive "$runsRecord" && return 0
	done <<< "$( type AgentsToolsSpawnedStartedRecords > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.StartedRecords.include" 2> /dev/null ; AgentsToolsSpawnedStartedRecords )"
	return 1
}

## A VERIFY ONLY AFTER NEW WORK (the human-owner's rule): rc 0 where the newest run recorded on a board item (its spawn record names
## `Board item <name>`) ran a verify routine, so nothing was worked on the item since that verdict and another verify would only
## repeat it. rc 1 where the newest run was any other routine, or none is recorded: the verify has work to check.
AgentsToolsScheduleVerifyStale(){ ## item file name
	local staleNewest=""
	staleNewest="$( LC_ALL=C grep -l -F "Board item $1" "${MMDAPP:-/nonexistent}/.local/agents/spawned"/*/*.spawn.md 2> /dev/null \
		| while IFS= read -r staleRecord ; do
			LC_ALL=C awk 'NR > 1 && $0 == "---" { exit } index( $0, "started-at: " ) == 1 { at = substr( $0, 13 ) } index( $0, "routine: " ) == 1 { r = substr( $0, 10 ) } END { if ( at != "" ) printf "%s\t%s\n", at, r }' "$staleRecord" 2> /dev/null
		done | LC_ALL=C sort | tail -1 )"
	case "${staleNewest#*$'\t'}" in *.verify.routine.md*) return 0 ;; esac
	return 1
}

## THE START OF APPROVED PENDING WORK, with no agent: at most one item a pass, the oldest by file name. A candidate is a `board-pending` item that
## carries `approved-by:`, whose `recheck-date:` is absent or due, and whose next-iteration routine resolves (AgentsToolsBoardItemHandler rc 0,
## naming a routine). The start is `magic-coordinator.work-duty.routine`'s **start-pending** done by the thread: the item moves to `board-running`
## first, then its `restart-session` group, else its `owner`, is spawned on that routine. A move refused starts nothing, and says why.
AgentsToolsScheduleStartPending(){
	local pendFile pendName pendNow pendRecheck pendEpoch pendRoutine pendRc pendMembers pendOut pendMark pendOne pendFast="" pendFlags pendOpen=no
	type AgentsToolsBoardItemHandler > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.BoardItemHandler.include" || return 0
	## The pace gate holds this start as it holds a duty start: a slow machine gets no new session.
	case "$( AgentsToolsSchedulePaceText 2> /dev/null )" in *' is held'*) printf 'start-pending: held by the pace gate, nothing started\n' ; return 0 ;; esac
	## ONE START PER PASS: a duty started in this pass is the pass's one start; the pending items wait for the next pass, when the pace shows it.
	[ -z "${agentsSchedulePassStarted:-}" ] || { printf 'start-pending: %s started this pass, nothing more is started until the next\n' "$agentsSchedulePassStarted" ; return 0 ; }
	pendNow="${agentsSchedulePassNow:-$( date +%s )}"
	## OUT OF WORKTIME ONLY THE COORDINATOR RUNS (the team's plan): with worktime, overtime and emergency all off, an approved pending item starts a session
	## only when it is marked urgent or emergency. Without this, ending the night duties (AgentsToolsScheduleDutyLifetime) took away the duty each
	## item was batched into, and the thread started a verify session for the next approved item every pass, all night. The others wait for worktime
	## or for the coordinator's own dispatch.
	pendFlags="$( AgentsToolsScheduleCurrentFlags --current-flags 2> /dev/null )" || pendFlags=""
	case "$pendFlags" in *"worktime: yes"*|*"overtime: yes"*|*"emergency: yes"*) pendOpen=yes ;; esac
	for pendFile in "$MDAT_DATA_ROOT/board/pending"/*.md ; do
		[ -f "$pendFile" ] || continue
		pendName="${pendFile##*/}"
		case "$pendName" in dispatch-*) continue ;; esac
		[ -n "$( AgentsToolsBoardItemKey "$pendFile" approved-by )" ] || continue
		pendRecheck="$( AgentsToolsBoardItemKey "$pendFile" recheck-date )"
		if [ -n "$pendRecheck" ] ; then
			pendEpoch="$( printf '%s\n' "$pendRecheck" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/output/LocalIsoToEpoch.awk" 2> /dev/null )"
			case "$pendEpoch" in ''|*[!0123456789]*) continue ;; esac
			[ "$pendEpoch" -le "$pendNow" ] || continue
		fi
		pendRc=0
		pendRoutine="$( AgentsToolsBoardItemHandler "$pendFile" 2> /dev/null )" || pendRc=$?
		[ "$pendRc" = 0 ] || continue
		pendRoutine="$( printf '%s\n' "$pendRoutine" | LC_ALL=C awk -F '\t' '$1 == "routine" { print $2 ; exit ; }' )"
		case "$pendRoutine" in ''|-) continue ;; esac
		## A verify of an item with nothing worked since its last verdict is not started; the item waits for work, and the pass says so.
		case "$pendRoutine" in
			*.verify.routine.md*)
				if AgentsToolsScheduleVerifyStale "$pendName" ; then
					printf 'start-pending: %s not started: its newest run was a verify, and nothing was worked on it since; a verify waits for new work\n' "$pendName"
					continue
				fi
			;;
		esac
		pendMembers="$( AgentsToolsBoardItemKey "$pendFile" restart-session )"
		[ -n "$pendMembers" ] || pendMembers="$( AgentsToolsBoardItemKey "$pendFile" owner )"
		pendMembers="$( printf '%s\n' "$pendMembers" | LC_ALL=C tr ',' ' ' )"
		[ -n "${pendMembers// /}" ] || continue
		## ONE SESSION PER MEMBER UNLESS THE MACHINE IS FAST: a member that runs a session already gets another only while the median tool call is 5 s or
		## less, or for an urgent or emergency item, or while the emergency flag is on. Otherwise the item waits in pending.
		pendMark="$( AgentsToolsBoardItemKey "$pendFile" mark )"
		[ "$pendOpen" = yes ] || case "$pendMark" in urgent|emergency) ;; *) continue ;; esac
		case "$pendMark" in
			urgent|emergency) ;;
			*)
				[ -z "$( AgentsToolsScheduleOverrideLeft MDAT_SCHEDULE_EMERGENCY "$pendNow" )" ] || pendMark=emergency
				## BATCH INTO THE DUTY: an item whose start is its owner alone, and whose owner holds a live work-duty, is not started. The duty's input
				## scan carries the board items its member owns, pending and running, and its idle Wait rereads that scan, so the duty works the item in its loop.
				[ "$pendMark" = emergency ] || [ -n "$( AgentsToolsBoardItemKey "$pendFile" restart-session )" ] || ! AgentsToolsScheduleWorkDutyRecord "$( AgentsToolsBoardItemKey "$pendFile" owner )" > /dev/null || continue
				[ "$pendMark" = emergency ] || for pendOne in $pendMembers ; do
					AgentsToolsScheduleMemberRuns "$pendOne" || continue
					if [ -z "$pendFast" ] ; then
						if MDAT_TOOL_PACE_MS=5000 AgentsToolsSchedulePaceText 2> /dev/null | LC_ALL=C grep -q 'a duty start is allowed' ; then pendFast=yes ; else pendFast=no ; fi
					fi
					[ "$pendFast" = yes ] || continue 2
				done
			;;
		esac
		pendOut="$( "$BASH" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsItems.fn.sh" --advance-to-running --team-member magic-coordinator "$pendName" --from-state:pending 2>&1 < /dev/null )" || {
			printf 'start-pending: %s not moved to running, nothing started: %s\n' "$pendName" "$( printf '%s\n' "$pendOut" | LC_ALL=C grep -m 1 -E 'ERROR|REFUS' | LC_ALL=C cut -c1-300 )"
			return 0
		}
		## The members are split on purpose: each is one argument of the spawner.
		# shellcheck disable=SC2086
		if AgentsToolsScheduleSpawn "pending.${pendName%.md}" --routine "$pendRoutine" \
			--description "Board item $pendName, approved, started from board-pending by the schedule: run its next iteration by $pendRoutine. The item is in board-running, its start recorded by the schedule." \
			$pendMembers ; then
			printf 'start-pending: started %s by %s for %s\n' "$pendName" "$pendRoutine" "$pendMembers"
			## THE RECEIPT IS THE TOOLING'S: the member the start goes to cannot write it (the advance operations are the coordinator's), so the
			## schedule records the start it made on the item it moved to running, as `execution-receipt: spawn:<session>:<utc>`.
			"$BASH" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsItems.fn.sh" --advance-to-running --team-member magic-coordinator "$pendName" --from-state:running \
				--header:upsert:execution-receipt:"spawn:${agentsScheduleSpawnSession:-unknown}:$( date -u +%Y-%m-%dT%H:%M:%SZ )" > /dev/null 2>&1 < /dev/null \
				|| printf 'start-pending: the receipt of %s could not be written on the running item\n' "$pendName"
		else
			printf 'start-pending: %s moved to running, its start is held: the spawner will retry it from running\n' "$pendName"
		fi
		return 0
	done
	return 0
}

AgentsToolsScheduleLoop(){
	## ONE CLOCK A PASS (call-path audit row 9): the steps below read agentsSchedulePassNow where it is set, and fork a date of
	## their own only when called alone. A pass is seconds long; one second of drift inside it changes no decision.
	agentsSchedulePassNow="$( date +%s )"
	## ONE START PER PASS, across the duties and the pending items: set by the start that happens, read by the starts after it in this pass.
	agentsSchedulePassStarted=""
	AgentsToolsScheduleSpawnReport
	## HOLDING STARTS NOTHING: no routine, no duty, no supervision; what ended is still reported and learned from.
	if [ -n "$( AgentsToolsScheduleOverrideLeft MDAT_SCHEDULE_HOLDING "$agentsSchedulePassNow" )" ] ; then
		printf 'holding: the schedule starts nothing while holding is set\n'
		AgentsToolsScheduleLearning
		return 0
	fi
	AgentsToolsScheduleAutorun
	AgentsToolsScheduleWorkDuty
	AgentsToolsScheduleStartPending
	AgentsToolsScheduleSupervision
	AgentsToolsScheduleImportantEmergency
	AgentsToolsScheduleLearning
	return 0
}
