#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.UndoRecord.include -- the four beats of the undo protocol (S13.19): record, plan,
## run and purge. Sourced by the dispatcher for `--undo-*`. Needs $1/$@/$MDSC_CMD from dot-sourcing.
##
## A record lives in the store of the session whose identity performed the act:
##   <workspace>/.local/agents/sessions/<session>/undo/<record-id>/
##       record   `<key>: <value>` lines: record-id, session-id, actor, kind, state, at, target, why
##       steps    one step made: `made` TAB `<step number>`, written BEFORE the step is taken
##       result   a file act's file as the act leaves it, so `plan` can see the act still stands
##       base     a file act's file as it stood, which `run` puts back
## The marker `undo.hold` in the acting run's own sandbox root is written by `record` and read by
## every cleaner: it carries one `<session-id>/<record-id>` line per open record, and nothing
## else. A record whose promise ends -- run, purged, refused -- takes its line out again.
##
## THE INVERSE LIST IS CLOSED, and it is AgentsToolsUndoKinds in AgentsTools.UndoHold.include.
## An act outside the list is refused when recorded and the kinds are named. An act inside it
## whose inverse no operation of this tree carries is recorded `refused` with why, and holds
## nothing: a record that says "this inverse is refused, and why" never promises what no tool
## can do.
##

if ! type AgentsToolsUndoKinds >/dev/null 2>&1 ; then

	type AgentsToolsUndoHoldState > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.UndoHold.include"
	type AgentsToolsAssertBareName > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.BareName.include"

	## Every kind of act this lane answers for: `<kind>` TAB `<runnable|refused>` TAB `<why>`.
	## One list, and the only one.
	AgentsToolsUndoKinds(){
		printf '%s\n' \
			$'file-write\trunnable\t' \
			$'item-move\trunnable\t' \
			$'grant\trunnable\t' \
			$'config\trunnable\t' \
			$'file-create\trefused\tthe inverse removes a file, and no operation of this tree removes one' \
			$'item-trash\trefused\ta git store keeps a trashed item only in its history, and --untrash refuses it' \
			$'inbox-mark\trefused\tnothing removes processed-at from an inbox item, so the item cannot move back' \
			$'inbox-trash\trefused\tthe restore reaches board-trash, which a git store refuses' \
			$'copy\trefused\tthe inverse removes a file, and no operation of this tree removes one'
	}

	AgentsToolsUndoKindRow(){ ## kind
		AgentsToolsUndoKinds | LC_ALL=C awk -F'\t' -v want="$1" '$1 == want { print ; found = 1 ; exit } END { exit ( found ? 0 : 1 ) }'
	}

	## One value of a record's own `record` file, or empty.
	AgentsToolsUndoField(){ ## record folder, key
		local undoFieldLine
		[ -f "$1/record" ] || return 0
		while IFS= read -r undoFieldLine ; do
			case "$undoFieldLine" in "$2: "*) printf '%s' "${undoFieldLine#"$2: "}" ; return 0 ;; esac
		done < "$1/record"
	}

	## One value of a record's `record` file set, keeping every other line. Written beside and renamed on.
	AgentsToolsUndoSet(){ ## record folder, key, value
		local undoSetFile="$1/record" undoSetTmp
		[ -f "$undoSetFile" ] || : > "$undoSetFile" || return 1
		undoSetTmp="$( mktemp "$undoSetFile.XXXXXX" 2> /dev/null )" || return 1
		LC_ALL=C awk -v key="$2" -v value="$3" '
			{ if ( index( $0, key ": " ) == 1 ) { if ( !wrote ) { print key ": " value ; wrote = 1 } ; next } print }
			END { if ( !wrote ) print key ": " value }
		' "$undoSetFile" > "$undoSetTmp" || { rm -f "$undoSetTmp" ; return 1 ; }
		mv -f "$undoSetTmp" "$undoSetFile"
	}

	## The folder of a record this workspace holds; rc 1 with the reason where it holds none.
	AgentsToolsUndoFind(){ ## record id, session id (may be empty)
		local undoFindSession="$2" undoFindDir=""
		case "$1" in ''|.|..|*/*) printf 'the record is a bare name, got: %s\n' "$1" >&2 ; return 1 ;; esac
		if [ -n "$undoFindSession" ] ; then
			undoFindDir="${MMDAPP%/}/.local/agents/sessions/$undoFindSession/undo/$1"
			[ -f "$undoFindDir/record" ] || { printf 'no record of session %s is named %s\n' "$undoFindSession" "$1" >&2 ; return 1 ; }
			printf '%s' "$undoFindDir"
			return 0
		fi
		for undoFindDir in "${MMDAPP%/}/.local/agents/sessions"/*/undo/"$1" ; do
			[ -f "$undoFindDir/record" ] || continue
			printf '%s' "$undoFindDir"
			return 0
		done
		printf 'no record of this workspace is named %s\n' "$1" >&2
		return 1
	}

	## The board state folder holding an item, or empty where none does.
	AgentsToolsUndoItemState(){ ## item filename
		local undoStateName
		for undoStateName in running pending review backlog blocked parked processed archived retained ; do
			[ ! -f "${MDAT_DATA_ROOT:-/nonexistent}/board/$undoStateName/$1" ] || { printf '%s' "$undoStateName" ; return 0 ; }
		done
		return 0
	}

	## Why a record's inverse cannot be taken now, or empty where it can. A file act is taken only
	## over the file as the act left it, and a board move only over the state the act left it in.
	AgentsToolsUndoBlockedBy(){ ## record folder
		local undoBlockKind undoBlockTarget undoBlockShown
		undoBlockKind="$( AgentsToolsUndoField "$1" kind )"
		undoBlockTarget="$( AgentsToolsUndoField "$1" target )"
		case "$undoBlockKind" in
			file-write)
				[ -f "$1/result" ] || { printf 'the record keeps no copy of the file as the act left it' ; return 0 ; }
				[ -f "$undoBlockTarget" ] || { printf 'the file the act wrote is no longer there: %s' "$undoBlockTarget" ; return 0 ; }
				cmp -s "$undoBlockTarget" "$1/result" \
					|| printf 'the file has changed since the act, so putting its base back would undo more than the act: %s' "$undoBlockTarget"
			;;
			item-move)
				undoBlockShown="$( AgentsToolsUndoItemState "$undoBlockTarget" )"
				[ "$undoBlockShown" = "$( AgentsToolsUndoField "$1" to-state )" ] \
					|| printf 'the item is in %s, and the act left it in %s' "${undoBlockShown:-no board state}" "$( AgentsToolsUndoField "$1" to-state )"
			;;
		esac
	}

	## The steps a record's inverse takes, one a line, TAB separated: `<tool>` `<operation>` `<argument>`.
	## Nothing here runs and nothing is written.
	AgentsToolsUndoSteps(){ ## record folder
		local undoStepTarget
		undoStepTarget="$( AgentsToolsUndoField "$1" target )"
		case "$( AgentsToolsUndoField "$1" kind )" in
			file-write)
				printf '%s\t%s\t%s\n' AgentsUniversalHarness --intern-tool "$undoStepTarget"
			;;
			item-move)
				printf '%s\t%s\t%s\n' DistroAgentsItems "--move-to-$( AgentsToolsUndoField "$1" from-state )" "$undoStepTarget"
			;;
			grant)
				printf '%s\t%s\t%s\n' DistroAgentsGrants --revoke-permission "$undoStepTarget"
			;;
			config)
				printf '%s\t%s\t%s --delete %s\n' DistroAgentsTools --agents-config-option "$( AgentsToolsUndoField "$1" entity )" "$undoStepTarget"
			;;
		esac
	}

	## One step taken: the tool of the step, given its operation and its arguments. A file inverse
	## goes through the harness's own Write, as the member's tool, exactly as an approved change does.
	AgentsToolsUndoStepRun(){ ## record folder, tool, operation, argument
		local undoRunRecord="$1" undoRunTool="$2" undoRunOp="$3" undoRunArg="$4"
		case "$undoRunTool:$undoRunOp" in
			AgentsUniversalHarness:--intern-tool)
				[ -f "$undoRunRecord/base" ] || { printf 'the record keeps no base to put back\n' >&2 ; return 1 ; }
				printf '{"path":"%s","content":"%s"}' "$undoRunArg" \
					"$( LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/mcp/AgentsMcpJsonEscape.awk" < "$undoRunRecord/base" )" \
					| "$BASH" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsUniversalHarness.sh" --intern-tool Write
			;;
			*:--agents-config-option)
				"$BASH" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh" "$undoRunOp" $undoRunArg
			;;
			*)
				"$BASH" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/$undoRunTool.fn.sh" "$undoRunOp" "$undoRunArg"
			;;
		esac
	}

	## One value of a pending reply's own record, or empty.
	AgentsToolsUndoAskField(){ ## pending file, key
		local undoAskLine
		[ -f "$1" ] || return 0
		while IFS= read -r undoAskLine ; do
			case "$undoAskLine" in "$2: "*) printf '%s' "${undoAskLine#"$2": }" ; return 0 ;; esac
		done < "$1"
	}

	## The pending reply a record's ask is, live first and then among the closed.
	AgentsToolsUndoAskPath(){ ## pending id
		local undoAskId="$1" undoAskRoot="${MMDAPP%/}/.local/agents/pending"
		case "$undoAskId" in ''|.|..|*/*) return 1 ;; esac
		[ ! -f "$undoAskRoot/$undoAskId.md" ] || { printf '%s' "$undoAskRoot/$undoAskId.md" ; return 0 ; }
		[ ! -f "$undoAskRoot/closed/$undoAskId.md" ] || { printf '%s' "$undoAskRoot/closed/$undoAskId.md" ; return 0 ; }
		return 1
	}

	## The record one ask names, by the ask's id, or empty: the lane keeps the ask's id on the
	## record, and this is the one walk back from an answer to the act it is about.
	AgentsToolsUndoRecordOfAsk(){ ## pending id
		local undoOfAskDir
		case "${1:-}" in ''|.|..|*/*) return 0 ;; esac
		for undoOfAskDir in "${MMDAPP%/}/.local/agents/sessions"/*/undo/* ; do
			[ -f "$undoOfAskDir/record" ] || continue
			[ "$( AgentsToolsUndoField "$undoOfAskDir" ask )" = "$1" ] || continue
			printf '%s' "$undoOfAskDir"
			return 0
		done
		return 0
	}

	## HIS WORD, AND NO OTHER. The verdict the record's ask was answered with, where it is the
	## human-owner's and one of the words given; rc 1 with the reason where the record names no
	## ask, the ask has no answer, the answer is another's, or it is another verdict. This is what
	## keeps `--undo-run` and `--undo-purge` out of a member's own reach.
	AgentsToolsUndoOwnerWord(){ ## record folder, the words that carry out, space-separated
		local undoWordFile undoWordStatus undoWordVerdict undoWordBy undoWordAsk
		undoWordAsk="$( AgentsToolsUndoField "$1" ask )"
		undoWordFile="$( AgentsToolsUndoAskPath "$undoWordAsk" )" || {
			printf 'the record names no ask of this workspace, so no answer of the human-owner reaches it\n' >&2 ; return 1 ; }
		undoWordStatus="$( AgentsToolsUndoAskField "$undoWordFile" status )"
		undoWordVerdict="$( AgentsToolsUndoAskField "$undoWordFile" verdict )"
		undoWordBy="$( AgentsToolsUndoAskField "$undoWordFile" answered-by )"
		[ "$undoWordStatus" = "reply-received" ] || {
			printf '%s has no answer yet, so nothing is done on a member own word\n' "$( AgentsToolsUndoField "$1" ask )" >&2 ; return 1 ; }
		case " $2 " in
			*" ${undoWordVerdict%% *} "*) ;;
			*) printf '%s was answered %s, and the words that carry this out are: %s\n' "$( AgentsToolsUndoField "$1" ask )" "${undoWordVerdict:-nothing}" "$2" >&2 ; return 1 ;;
		esac
		type AgentsToolsPermissionIsHumanOwner > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.PermissionHolds.include"
		AgentsToolsPermissionIsHumanOwner "$undoWordBy" || {
			printf '%s was answered by %s, and only the answer of the human-owner is carried out\n' "$( AgentsToolsUndoField "$1" ask )" "${undoWordBy:-nobody}" >&2 ; return 1 ; }
		printf '%s' "$undoWordVerdict"
	}

	## One part of the undo prompt, filled from its template by the filler the ask posts use: the
	## template and the answer form the table of the asks names for `undo`. Its slots travel in the
	## caller's environment as ASKP_F_<slot>, as they do for every ask.
	AgentsToolsUndoAskFill(){ ## want (post|closed|reactions|block), template, answer form
		ASKP_WANT="$1" ASKP_FORM="$3" \
			LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsToolingTemplateFill.awk" \
				-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsAskPostFill.awk" "$2" 2> /dev/null
	}

	## The prompt of one record: posted to the human-owner's own conversation by the team bot, as
	## the change prompt is, and recorded as that run's ask, so his answer arrives on its Wait and
	## is carried out in one place. Prints the pending id; rc 1, the reason on stderr, where it
	## could not be posted or recorded, so the act is not promised.
	AgentsToolsUndoAskOpen(){ ## record folder, acting member, session id
		local undoAskDir="$1" undoAskBy="$2" undoAskSession="$3" undoAskBody="" undoAskOut="" undoAskChannel="" undoAskTs="" undoAskAddressees="" undoAskAsking="" undoAskFields="" undoAskPending="" undoAskTemplate
		type AgentsToolsAskKindRow > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.AskPost.include"
		AgentsToolsAskKindRow undo || { printf 'the prompt cannot be filled: undo is not a kind the table of asks names\n' >&2 ; return 1 ; }
		undoAskTemplate="$( AgentsToolsToolingTemplate "$agentsAskRowTemplate" )" || undoAskTemplate="$agentsAskRowTemplate"
		undoAskBody="$( ASKP_F_member="$undoAskBy" \
			ASKP_F_act="$( printf '`%s` on `%s`' "$( AgentsToolsUndoField "$undoAskDir" kind )" "$( AgentsToolsUndoField "$undoAskDir" target )" )" \
			ASKP_F_inverse="$( AgentsToolsUndoSteps "$undoAskDir" | LC_ALL=C awk -F'\t' '{ printf "  step %s %s %s\n", $1, $2, $3 ; }' )" \
			ASKP_F_hold="$( AgentsToolsUndoField "$undoAskDir" hold-dir )" \
			AgentsToolsUndoAskFill post "$undoAskTemplate" "$agentsAskRowForm" )" || undoAskBody=""
		[ -n "$undoAskBody" ] || { printf 'the prompt could not be filled from its template, so nothing is promised\n' >&2 ; return 1 ; }
		undoAskOut="$( printf '%s\n' "$undoAskBody" | "$BASH" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh" --intern-op-comms-slack-send-message "$undoAskBy" human-owner --identity-bot --address-to human-owner --from-stdin 2>&1 )" || {
			printf 'the prompt could not be posted, so nothing is promised: %s\n' "$( printf '%s\n' "$undoAskOut" | LC_ALL=C grep -m1 'ERROR' )" >&2 ; return 1 ; }
		undoAskChannel="$( printf '%s\n' "$undoAskOut" | LC_ALL=C sed -n 's/^SENT_MESSAGE_CHANNEL=//p' | head -1 )"
		undoAskTs="$( printf '%s\n' "$undoAskOut" | LC_ALL=C sed -n 's/^SENT_MESSAGE_TS=//p' | head -1 )"
		undoAskAddressees="$( printf '%s\n' "$undoAskOut" | LC_ALL=C sed -n 's/^SENT_MESSAGE_ADDRESSEES=//p' | head -1 )"
		undoAskAsking="$( printf '%s\n' "$undoAskOut" | LC_ALL=C grep '^{' | LC_ALL=C awk -v path=message.user -v optional=1 -v dialect=slack -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsHarnessJsonField.awk" 2> /dev/null | LC_ALL=C sort -u | LC_ALL=C tr '\n' ' ' )" || undoAskAsking=""
		[ -n "$undoAskChannel" ] && [ -n "$undoAskTs" ] && [ -n "$undoAskAddressees" ] || {
			printf 'the prompt was posted but its thread could not be named, so its answer could not be read\n' >&2 ; return 1 ; }
		undoAskFields="$( AgentsToolsAskPostFieldsPack member "$undoAskBy" act "$undoAskBody" )"
		undoAskPending="$( printf '%s\n' "$undoAskBody" | "$BASH" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh" --intern-op-pending-reply-open "$undoAskBy" --to "$undoAskChannel" --session-id "$undoAskSession" \
			--kind undo --address-to human-owner --blocked-on "reply from human-owner" --channel "$undoAskChannel" --question-ts "$undoAskTs" --thread-ts "$undoAskTs" \
			--addressees "$undoAskAddressees" ${undoAskAsking:+--asking-accounts " $undoAskAsking"} --ask-identity bot --fields "$undoAskFields" --context undo-record 2> /dev/null )" || undoAskPending=""
		[ -n "$undoAskPending" ] || { printf 'the prompt was posted, but its ask could not be recorded, so its answer could not be read\n' >&2 ; return 1 ; }
		## Its click answers, the names its template gives, placed as the identity that posted it.
		type AgentsToolsAskPostReact > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.AskPost.include"
		AgentsToolsAskPostReact "$undoAskBy" "$undoAskChannel:$undoAskTs" bot add $( AgentsToolsUndoAskFill reactions "$undoAskTemplate" "$agentsAskRowForm" )
		printf '%s' "$undoAskPending"
	}

fi

case "$1" in

	## --undo-record <kind> <target> [--from-state <state>] [--to-state <state>] [--entity <id>]
	##               [--base <file>] [--result <file>] [--session-id <id>] [--actor <member>]
	## Keeps the inverse of one act, and holds the acting run's sandbox material until the owner
	## answers. Prints `RECORDED <record-id> <state>`; rc 1 where the kind is not on the list.
	--undo-record)
		shift
		local undoRecKind="" undoRecTarget="" undoRecFrom="" undoRecTo="" undoRecEntity="" undoRecBase="" undoRecResult="" undoRecSession="${MDAT_SPAWN_SESSION_ID:-}" undoRecActor="${MDAT_SPAWN_AGENT:-}" undoHoldDir=""
		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-state) undoRecFrom="${2:-}" ; shift 2 ;;
				--to-state) undoRecTo="${2:-}" ; shift 2 ;;
				--entity) undoRecEntity="${2:-}" ; shift 2 ;;
				--base) undoRecBase="${2:-}" ; shift 2 ;;
				--result) undoRecResult="${2:-}" ; shift 2 ;;
				--session-id) undoRecSession="${2:-}" ; shift 2 ;;
				--actor) undoRecActor="${2:-}" ; shift 2 ;;
				--*|-) echo "⛔ ERROR: $MDSC_CMD --undo-record: invalid option: $1" >&2 ; set +e ; return 1 ;;
				*)
					if [ -z "$undoRecKind" ] ; then undoRecKind="$1"
					elif [ -z "$undoRecTarget" ] ; then undoRecTarget="$1"
					else echo "⛔ ERROR: $MDSC_CMD --undo-record: takes a kind and a target, and got a third word: $1" >&2 ; set +e ; return 1
					fi
					shift
				;;
			esac
		done
		if [ -z "$undoRecKind" ] || [ -z "$undoRecTarget" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --undo-record: syntax is <kind> <target> [--from-state <state>] [--to-state <state>] [--entity <id>] [--base <file>] [--result <file>]" >&2
			echo "  kinds: $( AgentsToolsUndoKinds | LC_ALL=C cut -f1 | LC_ALL=C tr '\n' ' ' )" >&2
			set +e ; return 1
		fi
		undoRecRow="$( AgentsToolsUndoKindRow "$undoRecKind" )" || undoRecRow=""
		if [ -z "$undoRecRow" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --undo-record: $undoRecKind is no inverse of this lane, so no promise of undo is made for it. The kinds are: $( AgentsToolsUndoKinds | LC_ALL=C cut -f1 | LC_ALL=C tr '\n' ' ' )" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$undoRecSession" "--session-id" undo-record || { set +e ; return 1 ; }
		undoRecId="undo-$( uuidgen 2> /dev/null | LC_ALL=C tr 'ABCDEF' 'abcdef' )"
		[ "${undoRecId#undo-}" != "" ] && [ "${undoRecId#undo-}" != "$undoRecId" ] || {
			echo "⛔ ERROR: $MDSC_CMD --undo-record: no id could be generated, so nothing is promised" >&2 ; set +e ; return 1 ; }
		undoRecDir="${MMDAPP%/}/.local/agents/sessions/$undoRecSession/undo/$undoRecId"
		mkdir -p "$undoRecDir" || { echo "⛔ ERROR: $MDSC_CMD --undo-record: could not keep the record" >&2 ; set +e ; return 1 ; }
		undoHoldDir=""
		undoRecState="$( printf '%s' "$undoRecRow" | LC_ALL=C cut -f2 )"
		undoRecWhy="$( printf '%s' "$undoRecRow" | LC_ALL=C cut -f3 )"
		case "$undoRecState" in
			runnable) undoRecState=open ; undoRecWhy="" ;;
			*) undoRecState=refused ;;
		esac
		## The hold is the record's own, written where a cleaner would delete: the acting run's sandbox root.
		if [ "$undoRecState" = open ] && [ -n "${MDAT_SPAWN_SANDBOX_ROOT:-}" ] ; then
			undoHoldDir="$MDAT_SPAWN_SANDBOX_ROOT"
			AgentsToolsUndoHoldAdd "$undoHoldDir" "$undoRecSession" "$undoRecId" \
				|| echo "⚠️ WARNING: $MDSC_CMD --undo-record: the record is kept, but its hold could not be written in $undoHoldDir" >&2
		fi
		{
			printf 'record-id: %s\n' "$undoRecId"
			printf 'session-id: %s\n' "$undoRecSession"
			printf 'actor: %s\n' "${undoRecActor:-none}"
			printf 'kind: %s\n' "$undoRecKind"
			printf 'state: %s\n' "$undoRecState"
			printf 'at: %s\n' "$( date -u +%Y-%m-%dT%H:%M:%SZ )"
			printf 'target: %s\n' "$undoRecTarget"
			[ -z "$undoRecFrom" ] || printf 'from-state: %s\n' "$undoRecFrom"
			[ -z "$undoRecTo" ] || printf 'to-state: %s\n' "$undoRecTo"
			[ -z "$undoRecEntity" ] || printf 'entity: %s\n' "$undoRecEntity"
			[ -z "$undoHoldDir" ] || printf 'hold-dir: %s\n' "$undoHoldDir"
			[ -z "$undoRecWhy" ] || printf 'why: %s\n' "$undoRecWhy"
		} > "$undoRecDir/record" || { rm -rf "$undoRecDir" ; echo "⛔ ERROR: $MDSC_CMD --undo-record: could not write the record" >&2 ; set +e ; return 1 ; }
		[ -z "$undoRecBase" ] || cp -p "$undoRecBase" "$undoRecDir/base" || :
		[ -z "$undoRecResult" ] || cp -p "$undoRecResult" "$undoRecDir/result" || :
		## An open record is a promise, and a promise nobody was asked about is none: the prompt is
		## posted and recorded as this run's ask, and a prompt that cannot be posted takes the
		## record and its hold away again.
		if [ "$undoRecState" = open ] ; then
			undoRecAsk="$( AgentsToolsUndoAskOpen "$undoRecDir" "${undoRecActor:-none}" "$undoRecSession" 2> "$undoRecDir/ask.failed" )" || undoRecAsk=""
			if [ -z "$undoRecAsk" ] ; then
				cat "$undoRecDir/ask.failed" >&2 2> /dev/null || :
				[ -z "$undoHoldDir" ] || AgentsToolsUndoHoldDrop "$undoHoldDir" "$undoRecSession" "$undoRecId"
				rm -rf "$undoRecDir"
				echo "⛔ ERROR: $MDSC_CMD --undo-record: the act is kept and nothing is promised for it" >&2
				set +e ; return 1
			fi
			rm -f "$undoRecDir/ask.failed" 2> /dev/null || :
			AgentsToolsUndoSet "$undoRecDir" ask "$undoRecAsk" || :
		fi
		printf 'RECORDED %s %s\n' "$undoRecId" "$undoRecState"
		[ "$undoRecState" != refused ] || printf '  refused: %s\n' "$undoRecWhy" >&2
		return 0
	;;

	## --undo-plan <record-id> [--session-id <id>]: the dry run, read-only. Says what the inverse
	## would take, or `not ready` and why the operands have moved since the act.
	--undo-plan)
		shift
		local undoPlanId="" undoPlanSession="" undoPlanDir="" undoPlanWhy="" undoPlanStep
		while [ $# -gt 0 ] ; do
			case "$1" in
				--session-id) undoPlanSession="${2:-}" ; shift 2 ;;
				--*) echo "⛔ ERROR: $MDSC_CMD --undo-plan: invalid option: $1" >&2 ; set +e ; return 1 ;;
				*) undoPlanId="$1" ; shift ;;
			esac
		done
		undoPlanDir="$( AgentsToolsUndoFind "$undoPlanId" "$undoPlanSession" )" || { set +e ; return 1 ; }
		case "$( AgentsToolsUndoField "$undoPlanDir" state )" in
			open|rework-asked) ;;
			*) printf 'not ready: the record is %s, so it promises nothing to run\n' "$( AgentsToolsUndoField "$undoPlanDir" state )" ; return 1 ;;
		esac
		undoPlanWhy="$( AgentsToolsUndoBlockedBy "$undoPlanDir" )"
		if [ -n "$undoPlanWhy" ] ; then
			printf 'not ready: %s\n' "$undoPlanWhy"
			return 1
		fi
		printf 'ready %s\n' "$undoPlanId"
		AgentsToolsUndoSteps "$undoPlanDir" | while IFS=$'\t' read -r undoPlanStep undoPlanOp undoPlanArg ; do
			printf '  step %s %s %s\n' "$undoPlanStep" "$undoPlanOp" "$undoPlanArg"
		done
		return 0
	;;

	## --undo-run <record-id> [--session-id <id>]: takes the inverse, one step at a time, each step
	## recorded before it is made so a stopped run resumes. Closes the record and drops the hold.
	--undo-run)
		shift
		local undoRunId="" undoRunSession="" undoRunDir="" undoRunWhy="" undoRunLock="${MMDAPP%/}/.local/temp/undo-run.lock" undoRunTries=0
		local undoRunNo=0 undoRunTool undoRunOp undoRunArg undoRunRc=0 undoRunWord=""
		while [ $# -gt 0 ] ; do
			case "$1" in
				--session-id) undoRunSession="${2:-}" ; shift 2 ;;
				--*) echo "⛔ ERROR: $MDSC_CMD --undo-run: invalid option: $1" >&2 ; set +e ; return 1 ;;
				*) undoRunId="$1" ; shift ;;
			esac
		done
		undoRunDir="$( AgentsToolsUndoFind "$undoRunId" "$undoRunSession" )" || { set +e ; return 1 ; }
		undoRunWord="$( AgentsToolsUndoOwnerWord "$undoRunDir" "reject" )" || { set +e ; return 1 ; }
		case "$( AgentsToolsUndoField "$undoRunDir" state )" in
			open) ;;
			done|accepted) printf 'nothing to do: the record is already %s\n' "$( AgentsToolsUndoField "$undoRunDir" state )" ; return 0 ;;
			*) printf 'not run: the record is %s, so it promises nothing to run\n' "$( AgentsToolsUndoField "$undoRunDir" state )" ; set +e ; return 1 ;;
		esac
		undoRunWhy="$( AgentsToolsUndoBlockedBy "$undoRunDir" )"
		[ -z "$undoRunWhy" ] || { printf 'not run: %s\n' "$undoRunWhy" ; set +e ; return 1 ; }
		mkdir -p "${undoRunLock%/*}" 2> /dev/null || :
		until mkdir "$undoRunLock" 2> /dev/null ; do
			undoRunTries=$(( undoRunTries + 1 ))
			[ "$undoRunTries" -le 120 ] || { echo "⛔ ERROR: $MDSC_CMD --undo-run: the lock stays taken: $undoRunLock" >&2 ; set +e ; return 1 ; }
			sleep 5
		done
		trap 'rm -rf -- "$undoRunLock"' EXIT
		while IFS=$'\t' read -r undoRunTool undoRunOp undoRunArg ; do
			[ -n "$undoRunTool" ] || continue
			undoRunNo=$(( undoRunNo + 1 ))
			if LC_ALL=C grep -Fxq -- "made"$'\t'"$undoRunNo" "$undoRunDir/steps" 2> /dev/null ; then
				printf '  step %s already made\n' "$undoRunNo"
				continue
			fi
			printf 'made\t%s\n' "$undoRunNo" >> "$undoRunDir/steps"
			AgentsToolsUndoStepRun "$undoRunDir" "$undoRunTool" "$undoRunOp" "$undoRunArg" || { undoRunRc=1 ; break ; }
			printf '  step %s %s %s\n' "$undoRunNo" "$undoRunTool" "$undoRunOp"
		done <<< "$( AgentsToolsUndoSteps "$undoRunDir" )"
		rm -rf -- "$undoRunLock"
		if [ "$undoRunRc" -ne 0 ] ; then
			printf 'stopped: a step failed, and the record stays open at step %s\n' "$undoRunNo" >&2
			set +e ; return 1
		fi
		AgentsToolsUndoSet "$undoRunDir" state done || :
		undoHoldDir="$( AgentsToolsUndoField "$undoRunDir" hold-dir )"
		[ -z "$undoHoldDir" ] || AgentsToolsUndoHoldDrop "$undoHoldDir" "$( AgentsToolsUndoField "$undoRunDir" session-id )" "$undoRunId"
		printf 'RAN %s\n' "$undoRunId"
		return 0
	;;

	## --undo-purge <record-id> [--session-id <id>]: the owner accepted the act, so the promise is
	## purged: the record closes and the hold it made is released. Only his own answer carries it.
	--undo-purge)
		shift
		local undoPurgeId="" undoPurgeSession="" undoPurgeDir="" undoPurgeHold="" undoPurgeWord=""
		while [ $# -gt 0 ] ; do
			case "$1" in
				--session-id) undoPurgeSession="${2:-}" ; shift 2 ;;
				--*) echo "⛔ ERROR: $MDSC_CMD --undo-purge: invalid option: $1" >&2 ; set +e ; return 1 ;;
				*) undoPurgeId="$1" ; shift ;;
			esac
		done
		undoPurgeDir="$( AgentsToolsUndoFind "$undoPurgeId" "$undoPurgeSession" )" || { set +e ; return 1 ; }
		undoPurgeWord="$( AgentsToolsUndoOwnerWord "$undoPurgeDir" "accept" )" || { set +e ; return 1 ; }
		AgentsToolsUndoSet "$undoPurgeDir" state accepted || { echo "⛔ ERROR: $MDSC_CMD --undo-purge: could not close the record" >&2 ; set +e ; return 1 ; }
		undoPurgeHold="$( AgentsToolsUndoField "$undoPurgeDir" hold-dir )"
		[ -z "$undoPurgeHold" ] || AgentsToolsUndoHoldDrop "$undoPurgeHold" "$( AgentsToolsUndoField "$undoPurgeDir" session-id )" "$undoPurgeId"
		printf 'PURGED %s\n' "$undoPurgeId"
		return 0
	;;

	## --undo-rework <record-id> [--session-id <id>]: the owner asked for the act to be done
	## differently. The promise stands and so does the hold, and his words are kept on the record
	## as he wrote them. A rework with no words is no verdict and nothing is written: the words
	## are the whole of the instruction.
	--undo-rework)
		shift
		local undoReworkId="" undoReworkSession="" undoReworkDir="" undoReworkWord="" undoReworkText=""
		while [ $# -gt 0 ] ; do
			case "$1" in
				--session-id) undoReworkSession="${2:-}" ; shift 2 ;;
				--*) echo "⛔ ERROR: $MDSC_CMD --undo-rework: invalid option: $1" >&2 ; set +e ; return 1 ;;
				*) undoReworkId="$1" ; shift ;;
			esac
		done
		undoReworkDir="$( AgentsToolsUndoFind "$undoReworkId" "$undoReworkSession" )" || { set +e ; return 1 ; }
		undoReworkWord="$( AgentsToolsUndoOwnerWord "$undoReworkDir" "rework" )" || { set +e ; return 1 ; }
		undoReworkText="${undoReworkWord#* -- }"
		[ "$undoReworkText" != "$undoReworkWord" ] && [ -n "$undoReworkText" ] || {
			printf 'not reworked: %s names a rework with no words, and a rework with no words is no verdict. The promise stands and the record stays %s\n' \
				"$( AgentsToolsUndoField "$undoReworkDir" ask )" "$( AgentsToolsUndoField "$undoReworkDir" state )"
			set +e ; return 1 ; }
		## The state first, then his words: a reader that sees the one sees the other.
		AgentsToolsUndoSet "$undoReworkDir" state rework-asked || { echo "⛔ ERROR: $MDSC_CMD --undo-rework: could not move the record" >&2 ; set +e ; return 1 ; }
		AgentsToolsUndoSet "$undoReworkDir" rework-text "$undoReworkText" || {
			echo "⛔ ERROR: $MDSC_CMD --undo-rework: the record moved and his words were not kept" >&2 ; set +e ; return 1 ; }
		printf 'REWORK %s %s\n' "$undoReworkId" "$( AgentsToolsUndoField "$undoReworkDir" hold-dir )"
		return 0
	;;

	--undo-*)
		echo "⛔ ERROR: $MDSC_CMD: invalid operation: $1" >&2
		set +e ; return 1
	;;

	## DEFINITIONS-ONLY SOURCE: a caller sourcing this file for its functions. Nothing to dispatch.
	*)
		:
	;;

esac
