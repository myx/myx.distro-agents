#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only
## AgentsTools.ContextScanComms.include -- the comms block of the --intern-op-session-context-scan op, moved unchanged into one function and loaded only when comms are asked for.

AgentsToolsContextScanComms(){
			local commsItemsAwk="$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsSessionContextCommsItems.awk"

			local sessionContextCapIm=128 sessionContextCapEmail=128 sessionContextCapTrello=64
			local sessionContextThreadContextBefore=3

			local wantSlack="false" wantEmail="false" wantTrello="false"
			if [ "$commsDoAll" = "true" ] || [ "$commsDoSlack" = "true" ] ; then wantSlack="true" ; fi
			if [ "$commsDoAll" = "true" ] || [ "$commsDoEmail" = "true" ] ; then wantEmail="true" ; fi
			if [ "$commsDoAll" = "true" ] || [ "$commsDoTrello" = "true" ] ; then wantTrello="true" ; fi

			local imIdentity="<unresolved>" emailIdentity="<not configured>" trelloIdentity="<unresolved>"

			local cutoffEpoch=""
			if [ "$commsCutoffKind" = "--comms-since-utime" ] ; then
				cutoffEpoch="$commsCutoffValue"
			elif [ "$commsCutoffKind" = "--comms-since-date-time" ] ; then
				cutoffEpoch="$( printf '%s\n' "$commsCutoffValue" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/output/LocalIsoToEpoch.awk" )" || {
					echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --comms-since-date-time: could not convert to epoch seconds: $commsCutoffValue" >&2
					set +e ; contextScanCommsFailed=1 ; return 1
				}
			fi
			local sessionContextDefaultCutoffDays=3
			local commsCutoffDefaulted="false"
			if [ "$wantSlack" = "true" ] && [ -z "$cutoffEpoch" ] ; then
				local nowEpoch=""
				nowEpoch="$( date +%s )" || nowEpoch=""
				case "$nowEpoch" in
					''|*[!0123456789]*)
						echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: no cut-off was given and date +%s did not return epoch seconds ($nowEpoch) -- refusing to fall back to an unbounded scan" >&2
						set +e ; contextScanCommsFailed=1 ; return 1
					;;
				esac
				cutoffEpoch=$(( nowEpoch - sessionContextDefaultCutoffDays * 86400 ))
				commsCutoffDefaulted="true"
			fi

			local imBlocks="" imInstrument="" imSourcesTotal=0 imSourcesScanned=0 imPartial="" imCapped=""
			local imFailed="false" imAnySourceFailed="false"
			local imNotReached=0 imNotReachedList="" imDropped="" imDroppedTotal=0 imDroppedSources=0
			## Set inside the Slack branch below, and read by the renderer outside every branch.
			local threadOwnFloors=0
			## THE FLOOR ONE SOURCE READS FROM: its own where the caller stated one,
			## the pass-wide cut-off otherwise. A caller holding a stored position per
			## source states one per source; a caller holding only a pass position
			## states none and gets today's behaviour exactly. Resolved here, once, so
			## the paging bound, the item trim and the thread floors cannot disagree.
			AgentsSessionContextSourceFloor(){ ## source-key
				local floorKey="$1" floorIndex=0
				while [ "$floorIndex" -lt ${#commsSourceFloorKeys[@]} ] ; do
					if [ "${commsSourceFloorKeys[$floorIndex]}" = "$floorKey" ] ; then
						printf '%s\n' "${commsSourceFloorValues[$floorIndex]}"
						return 0
					fi
					floorIndex=$(( floorIndex + 1 ))
				done
				printf '%s\n' "$cutoffEpoch"
			}
			## THE SLACK LEG HAS ITS OWN BOUND, inside the caller's window. Measured 2026-11-04:
			## a 60-day cut-off read 20 conversations in 130 s and a stored one 215 s.
			local slackLegSeconds="${ENV_MAGIC_SWEEP_SLACK_LEG_SECONDS:-240}"
			case "$slackLegSeconds" in
				*[!0123456789]*|''|0) slackLegSeconds=240 ;;
			esac
			local slackLegDeadline=$(( SECONDS + slackLegSeconds ))
			## THE EMAIL AND TRELLO LEGS HAVE ONE EACH, on the same terms: the bound stops
			## the leg being LAUNCHED once the pass is past it, and the section then says
			## so instead of reporting an empty source. It is checked before the call, so
			## it bounds a leg that would have queued behind the Slack reads -- it does not
			## interrupt a call already in flight. What bounds one call is that source's own
			## transport bound, and the two are stated apart in the section.
			local emailLegSeconds="${ENV_MAGIC_SWEEP_EMAIL_LEG_SECONDS:-240}"
			case "$emailLegSeconds" in
				*[!0123456789]*|''|0) emailLegSeconds=240 ;;
			esac
			local trelloLegSeconds="${ENV_MAGIC_SWEEP_TRELLO_LEG_SECONDS:-120}"
			case "$trelloLegSeconds" in
				*[!0123456789]*|''|0) trelloLegSeconds=120 ;;
			esac
			local emailLegDeadline=$(( SECONDS + emailLegSeconds )) trelloLegDeadline=$(( SECONDS + trelloLegSeconds ))
			local emailOutOfTime="false" trelloOutOfTime="false"
			if [ "$wantSlack" = "true" ] ; then
				if [ "$commsCutoffDefaulted" = "true" ] ; then
					imInstrument="cut-off defaulted to the last $sessionContextDefaultCutoffDays days -- no --comms-since-date-time or --comms-since-utime was given (applied client-side; Slack oldest= is deliberately NOT used, so thread discovery can still see parents older than the cut-off)"
				else
					imInstrument="cut-off $commsCutoffKind $commsCutoffValue (applied client-side; Slack oldest= is deliberately NOT used, so thread discovery can still see parents older than the cut-off)"
				fi

				## THE SOURCE SET, TWO SCOPES CHOSEN BY WHICH TOKEN IS IN PLAY. Not one
				## set with an identity fan-out bolted onto it:
				##
				##   BOT_TOKEN  -- the `magic-team` channel, the `human-owner` DM, and
				##                 the bot's OWN DMs. The first two were this list's
				##                 entire content and are still exactly right for the
				##                 scope; the bot's own DMs were the missing third.
				##   USER_TOKEN -- for a persona holding one: ALL of its DMs, and all
				##                 of its mentions.
				##
				## Each spec is `identity|target|label|source-key`:
				##   identity   which token reads it -- `bot` or `user`.
				##   target     what AgentsToolsSlackCheck is given.
				##   label      the document's `source:` value, and therefore the key
				##              the renderer groups by. It carries the persona, so one
				##              correspondent writing to two personas stays two groups.
				##   source-key `<auth-id>-<conversation-id>`, this source's stable
				##              name for a caller that wants to speak about one source
				##              in its own records, and the name a per-source floor is
				##              stated under. The roster composes it from the token's own
				##              auth id; a source named by config rather than enumerated
				##              from Slack carries `<identity>-<target>` instead, because
				##              nothing here asks Slack who the token is before the read.
				## The X-Request-Detail workspace domain every Slack call below writes
				## on stderr, resolved once for the whole scan rather than by two
				## config lookups per call -- see AgentsToolsResolveSlackWorkspaceDomain.
				local AgentsToolsSlackDomainCacheFor="" AgentsToolsSlackDomainCacheValue=""
				AgentsToolsSlackDomainCacheValue="$( AgentsToolsResolveSlackWorkspaceDomain "$actingMember" )" || AgentsToolsSlackDomainCacheValue=""
				AgentsToolsSlackDomainCacheFor="$actingMember"
				local slackSourceSpecs=()
				local slackOwnCredentials="true"
				local slackRosterIdentityArg="--identity both"
				local slackRosterTypesArg=()
				## Declared here, not only inside the branch below, so the CONV-loop's
				## own de-dup check further down always has a defined (if empty) value
				## to compare against, team-scope included.
				local configuredSources=""
				if [ "$commsMemberScopeOnly" = "true" ] ; then
					## Presence only -- reduced to a boolean on the next lines and
					## dropped. No credential is compared, stored or printed.
					local ownTokenPresent=""
					type AgentsToolsConfigOption > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/settings/AgentsTools.ConfigOption.include"
					ownTokenPresent="$( AgentsToolsConfigOption "$actingMember" --select SLACK_USER_TOKEN )" || ownTokenPresent=""
					slackOwnCredentials="false"
					[ -z "$ownTokenPresent" ] || slackOwnCredentials="true"
					ownTokenPresent=""

					## A client-* member reads under its OWN user token and nothing
					## else, so its roster is enumerated for that identity alone. Asking
					## for the bot leg here would resolve to the TEAM's shared bot token
					## -- a different workspace entirely -- which is exactly what the
					## partial note below has always refused to do.
					slackRosterIdentityArg="--identity user"
					## Channels get the same live-enumeration DMs already have below --
					## a client-* member added to a new channel in Slack must not stay
					## invisible to this scan until SLACK_CONVERSATIONS is hand-edited to
					## name it too. This widens the roster call's own --types alongside
					## the existing im,mpim; the CONV loop below skips whatever
					## SLACK_CONVERSATIONS already names, so one conversation is never
					## read twice.
					slackRosterTypesArg=( --types im,mpim,public_channel,private_channel )

					local configuredSource
					type AgentsToolsConfigOption > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/settings/AgentsTools.ConfigOption.include"
					configuredSources="$( AgentsToolsConfigOption "$actingMember" --select SLACK_CONVERSATIONS )" || configuredSources=""
					for configuredSource in ${configuredSources//,/ } ; do
						slackSourceSpecs+=( "user|$configuredSource|$configuredSource|user-$configuredSource" )
					done

					if [ "$slackOwnCredentials" != "true" ] ; then
						slackSourceSpecs=()
						imSourcesTotal=$(( imSourcesTotal + 1 ))
						imAnySourceFailed="true"
						imPartial="$imPartial**NOTE:** partial -- Slack not scanned, $actingMember holds no Slack credentials of its own; this scan never reads Slack under the team's shared credentials"$'\n'
					fi
				else
					slackSourceSpecs=( "bot|magic-team|magic-team|bot-magic-team" "bot|human-owner|human-owner|bot-human-owner" )
				fi
				local ownSlackId="" ownResolveOutput=""
				if [ "$slackOwnCredentials" = "true" ] ; then
					type AgentsToolsCommsSlackResolveIds > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.CoordinatorCommsSlack.include"
					ownResolveOutput="$( AgentsToolsCommsSlackResolveIds "$actingMember" )" || true
				fi
				ownSlackId="$( printf '%s\n' "$ownResolveOutput" | LC_ALL=C sed -n 's/^AUTH_USER_ID=//p' | head -1 )" || ownSlackId=""
				if [ -z "$ownSlackId" ] && [ "$slackOwnCredentials" = "true" ] ; then
					imPartial="$imPartial**NOTE:** partial -- identity-widening skipped, own Slack user id could not be resolved; watched-channel and open-thread reads unaffected"$'\n'
				fi
				## Reused for the section's `identity:` line -- no second lookup.
				[ -z "$ownSlackId" ] || imIdentity="$ownSlackId"

				local threadTargets=() dt discovered

				## EVERY DM OF EVERY PERSONA, ENUMERATED FROM SLACK, THIS PASS.
				## Not a configured list and not a remembered one: a correspondent who
				## writes for the first time -- or for the first time in a year -- is
				## invisible to both, and that invisibility is the whole defect. The
				## roster op re-fetches conversations.list every call for exactly that
				## reason; see its own header.
				##
				## A DM IS ADDRESSED BY PRESENCE. Nobody @-mentions anyone in a direct
				## conversation, they just write, so no mention or addressing test
				## gates a DM's top-level messages -- they are read because the
				## conversation is ours. (The `vaneId` test in
				## AgentsSlackHistoryThreadTargets.awk is a WIDENER, not a filter: it
				## reads `if (!fresh && !vaneHit) continue`, so it only ever ADDS a
				## thread that is ours but not shown to be fresh -- and only one whose
				## parent states no latest reply, since a stated one at or before the
				## cut-off proves the read would keep nothing. A fresh thread is
				## discovered with or without it, in a DM as in a channel, and nothing
				## there may be turned into a DM scope test.)
				local dmRosterOutput="" dmRosterRc=0
				if [ "$slackOwnCredentials" = "true" ] ; then
					type AgentsToolsCommsSlackConversationsRoster > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.CoordinatorCommsSlack.include"
					dmRosterOutput="$( export ENV_MAGIC_SWEEP_SLACK_LEG_DEADLINE="$slackLegDeadline" ; AgentsToolsCommsSlackConversationsRoster "$actingMember" $slackRosterIdentityArg \
						"${slackRosterTypesArg[@]+"${slackRosterTypesArg[@]}"}" )" || dmRosterRc=$?
				else
					dmRosterRc=4
				fi
				## Only rc 0 is a roster that can be trusted to be complete. A partial
				## one is USED -- what it did enumerate is real -- and said out loud,
				## because the alternative is silently sweeping a subset.
				case "$dmRosterRc" in
					0)	;;
					3)
						imPartial="$imPartial**NOTE:** partial -- the DM roster came back INCOMPLETE (one identity could not be enumerated); the conversations below are real but are not known to be all of them"$'\n'
						imAnySourceFailed="true"
					;;
					*)
						dmRosterOutput=""
						if [ "$slackOwnCredentials" = "true" ] ; then
							imSourcesTotal=$(( imSourcesTotal + 1 ))
							imAnySourceFailed="true"
							imPartial="$imPartial**NOTE:** partial -- NO DM was enumerated: conversations.list could not be read for any identity, so nothing here says how many direct conversations exist or whether any carries unread traffic. This is an UNKNOWN inventory, never an empty one"$'\n'
						fi
					;;
				esac

				## The human-owner DM is already read, under BOTH identities, by the
				## `human-owner` alias above -- its fan-out resolves one DM per identity
				## and asserts each against the counterparty. Its conversations appear
				## in both rosters too, so they are skipped HERE rather than the alias
				## being dropped: the alias path carries a counterparty control this
				## one does not, and removing a working control to remove a duplicate
				## is a bad trade.
				local humanOwnerParty=""
				if [ "$commsMemberScopeOnly" != "true" ] ; then
					type DistroAgentsToolsResolveTarget > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.CommsResolveTarget.include"
					humanOwnerParty="$( DistroAgentsToolsResolveTarget human-owner | LC_ALL=C sed -n 's/^CHANNEL=//p' )" || humanOwnerParty=""
					case "$humanOwnerParty" in
						U*|W*)	;;
						*)	humanOwnerParty="" ;;
					esac
				fi

				local rosterLine rosterIdentity rosterAuth rosterConv rosterKind rosterParty rosterHandle
				local rosterPersona="" rosterDmCount=0 rosterFields=() rosterField rosterUserId rosterUserName rosterRest
				## Handles for the `user:` lines, from the roster's OWN users.list fetch
				## -- no second call. Exported rather than passed, because the same map
				## has to reach the thread-fetch jobs this scan backgrounds, and a
				## tenth positional argument to reach them would be worse than a name.
				COMMS_USER_HANDLES=""
				## Fields are split in the shell, not by a sed per field: a roster
				## line is one fork-free read, where six seds a line were most of
				## this loop's time on a roster of hundreds. Same reading as those
				## seds -- a name=value field, the last one of a name winning, and a
				## field the line does not carry left empty.
				while IFS= read -r rosterLine ; do
					case "$rosterLine" in
						"IDENTITY|"*|"CONV|"*)
							IFS='|' read -r -a rosterFields <<< "$rosterLine"
							rosterIdentity="" rosterAuth="" rosterConv="" rosterKind="" rosterParty="" rosterHandle=""
							## The last field closes the line, so it is never a value the
							## seds read: each of theirs had to be followed by a "|".
							unset "rosterFields[$(( ${#rosterFields[@]} - 1 ))]"
							for rosterField in ${rosterFields[@]+"${rosterFields[@]}"} ; do
								case "$rosterField" in
									identity=*)	rosterIdentity="${rosterField#identity=}" ;;
									auth=*)		rosterAuth="${rosterField#auth=}" ;;
									id=*)		rosterConv="${rosterField#id=}" ;;
									kind=*)		rosterKind="${rosterField#kind=}" ;;
									counterparty=*)	rosterParty="${rosterField#counterparty=}" ;;
									handle=*)	rosterHandle="${rosterField#handle=}" ;;
								esac
							done
						;;
					esac
					case "$rosterLine" in
						"IDENTITY|"*)
							## The persona's own handle, for the label a reader sees.
							rosterPersona="$rosterHandle"
							continue
						;;
						"USER|"*)
							IFS='|' read -r rosterField rosterUserId rosterUserName rosterRest <<< "$rosterLine"
							COMMS_USER_HANDLES="$COMMS_USER_HANDLES$rosterUserId"$'\t'"$rosterUserName"$'\n'
							continue
						;;
						"CONV|"*)	;;
						*)	continue ;;
					esac
					[ -n "$rosterConv" ] && [ -n "$rosterAuth" ] || continue
					if [ -n "$humanOwnerParty" ] && [ "$rosterParty" = "$humanOwnerParty" ] ; then continue ; fi
					## A channel already named in SLACK_CONVERSATIONS is read once, not
					## twice -- the static list above and this live roster can now name
					## the same channel, and a duplicate source would double its read,
					## its count and its blocks in the document.
					case ",$configuredSources," in
						*",$rosterConv,"*) continue ;;
					esac
					## An unresolved handle keeps the party id rather than an empty
					## name: a group heading has to identify SOMEONE.
					[ "$rosterHandle" != "-" ] && [ -n "$rosterHandle" ] || rosterHandle="$rosterParty"
					slackSourceSpecs+=( "$rosterIdentity|$rosterConv|$rosterKind:$rosterHandle@${rosterPersona:-$rosterAuth}|$rosterAuth-$rosterConv" )
					rosterDmCount=$(( rosterDmCount + 1 ))
				done <<< "$dmRosterOutput"
				export COMMS_USER_HANDLES

				## ALL MENTIONS FOR EVERY USER_TOKEN PERSONA -- the channel-side half of
				## the same rule. In a channel a mention is HOW a message becomes ours,
				## where in a DM presence already is.
				##
				## The hits are turned into thread targets rather than rendered
				## separately, so a mention is read, trimmed, grouped and capped by the
				## one pipeline every other message goes through -- no second rendering
				## path, and no mention-specific handling rule.
				##
				## THIS IS A USER_TOKEN CAPABILITY AND CANNOT BE MADE A BOT ONE. Slack's
				## search.messages refuses a bot token outright, at any scope; so the
				## bot persona's mentions are only ever the ones sitting in the
				## conversations it is already read above. That is Slack's limit, not a
				## gap in this scan, and it is stated rather than left to be inferred.
				if [ "$commsDoSlackTags" = "true" ] ; then
					imSourcesTotal=$(( imSourcesTotal + 1 ))
					local mentionUserToken=""
					type AgentsToolsConfigOption > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/settings/AgentsTools.ConfigOption.include"
					mentionUserToken="$( AgentsToolsCommsOwnSettingsApply "$actingMember" && AgentsToolsConfigOption "$actingMember" --select SLACK_USER_TOKEN )" || mentionUserToken=""
					local mentionHasToken="false"
					[ -z "$mentionUserToken" ] || mentionHasToken="true"
					mentionUserToken=""

					if [ "$mentionHasToken" != "true" ] ; then
						imPartial="$imPartial**NOTE:** partial -- mention search not run for $actingMember: it holds no SLACK_USER_TOKEN, and Slack's search.messages is refused to a bot token at any scope. Mentions of the bot identity are covered only where they sit in a conversation read above; no conclusion about mentions elsewhere is supported by this document"$'\n'
						imAnySourceFailed="true"
					elif [ -z "$ownSlackId" ] ; then
						imPartial="$imPartial**NOTE:** partial -- mention search not run, this persona's own Slack user id could not be resolved, so there was no term to search for"$'\n'
						imAnySourceFailed="true"
					else
						local mentionAfter="" mentionRc=0 mentionResponse="" mentionHits=""
						mentionAfter="$( printf '%s\n' "$(( ${cutoffEpoch%%.*} - 86400 ))" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/output/LocalEpochToIsoDate.awk" )" || mentionAfter=""
						if [ -z "$mentionAfter" ] ; then
							imPartial="$imPartial**NOTE:** partial -- mention search not run, the search window's start date could not be derived from cut-off $cutoffEpoch"$'\n'
							imAnySourceFailed="true"
						else
							## One day early on purpose: Slack's own `after:` is
							## day-granular and exclusive, and the real sub-second
							## cut-off is applied by the trim every source already goes
							## through. Same over-fetch --slack-search-messages
							## documents at its own call site.
							type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
							mentionResponse="$( DistroAgentsTools --intern-op-slack-call "$actingMember" \
								--api search.messages --identity user \
								--form "query=<@$ownSlackId> after:$mentionAfter" \
								--form sort=timestamp --form sort_dir=desc --form count=100 --form page=1 \
								--context "--intern-op-session-context-scan (mentions of $ownSlackId)" )" || mentionRc=$?
							if [ "$mentionRc" != "0" ] ; then
								imPartial="$imPartial**NOTE:** partial -- mention search FAILED for <@$ownSlackId>; nothing here says whether this persona was mentioned anywhere outside the conversations read above"$'\n'
								imAnySourceFailed="true"
							else
								## Reuses the generic list reader rather than a second
								## copy of a matches parser: search nests its array at
								## `messages.matches`, which is just another array path.
								mentionHits="$( printf '%s\n' "$mentionResponse" | LC_ALL=C awk \
									-v array=messages.matches -v want=channel.id,ts \
									-v mode=records -v dialect=slack -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsHarnessJsonField.awk" )" || mentionHits=""
								local mentionChannel mentionTs mentionCount=0
								while IFS="$( printf '\t' )" read -r mentionChannel mentionTs ; do
									[ -n "$mentionChannel" ] && [ -n "$mentionTs" ] || continue
									threadTargets+=( "$mentionChannel:$mentionTs" )
									mentionCount=$(( mentionCount + 1 ))
								done <<< "$mentionHits"
								## ONE page is read on purpose -- the query carries `in:`
								## and `after:`, so exceeding 100 matches should be rare.
								## Slack's own `messages.paging.pages` says how many pages
								## the query really has (0 when it matched nothing), and a
								## query that DOES exceed one page says so on the line
								## below rather than passing a page size off as a match
								## count. A count that cannot be shown complete is not
								## reported as complete.
								local mentionPages="" mentionPagesRc=0 mentionMore=""
								mentionPages="$( printf '%s\n' "$mentionResponse" | LC_ALL=C awk \
									-v path=messages.paging.pages \
									-v dialect=slack -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsHarnessJsonField.awk" 2>/dev/null )" || mentionPagesRc=$?
								case "$mentionPagesRc:$mentionPages" in
									0:0|0:1)	;;
									0:[2-9]|0:[1-9][0-9]*)
										mentionMore=" -- TRUNCATED, THIS IS PAGE 1 OF $mentionPages: that is page 1's hits, NOT the number of mentions; the later pages were not read and nothing here says what is on them"
									;;
									*)
										mentionMore=" -- COUNT NOT KNOWN COMPLETE: Slack's own messages.paging.pages could not be read from this response (rc=$mentionPagesRc, value '$mentionPages'), so whether mentions exist past the one page read is unknown"
									;;
								esac
								imSourcesScanned=$(( imSourcesScanned + 1 ))
								imInstrument="$imInstrument; mentions of <@$ownSlackId> searched since $mentionAfter ($mentionCount hit(s)$mentionMore, read through the same per-conversation pipeline as everything else)"
							fi
						fi
					fi
				fi

				## Said once, after both scopes have contributed: a member with nothing
				## configured AND nothing enumerated really has no source, and that is
				## the only case in which this scan reads no Slack at all.
				if [ "$slackOwnCredentials" = "true" ] && [ ${#slackSourceSpecs[@]} -eq 0 ] ; then
					imSourcesTotal=$(( imSourcesTotal + 1 ))
					imAnySourceFailed="true"
					imPartial="$imPartial**NOTE:** partial -- Slack not scanned, no conversation is configured for $actingMember and none was enumerated for any identity it holds"$'\n'
				fi

				local commsCutoffTrimAwkProgram='
					## Float-free ordering key: zero-padded seconds then exactly six
					## fractional digits, compared as a STRING, never + 0 -- awk converts
					## through strtod, whose decimal point is locale-dependent. Returns ""
					## for anything unparseable, the EMPTY value an unparsed `ts:` line
					## carries included; read that as "cannot be dated", never as 0, and
					## KEEP the block. This is the single place that decides it.
					function tskey(v,   d, sec, frac) {
						gsub(/^[ \t]+|[ \t\r]+$/, "", v)
						d = index(v, ".")
						if (d == 0) { sec = v ; frac = "" ; }
						else { sec = substr(v, 1, d - 1) ; frac = substr(v, d + 1) ; }
						if (sec !~ /^[0-9]+$/ || length(sec) > 16) return ""
						frac = substr(frac "000000", 1, 6)
						if (frac !~ /^[0-9]+$/) return ""
						while (length(sec) < 16) sec = "0" sec
						return sec frac
					}
					function flush(   i, t) {
						if (nb == 0) return
						t = ""
						for (i = 1; i <= nb; i++) t = t blk[i] "\n"
						body[++nblk] = t
						bkey[nblk] = curKey
						nb = 0 ; curKey = "" ;
					}
					BEGIN {
						cutKey = tskey(cut)
						## An unparseable cut-off must never widen the scan to everything:
						## an empty key makes every real key compare greater.
						if (cutKey == "") {
							printf("⛔ ERROR: AgentsTools.InternOpSessionContextScan.include: cut-off is not a parseable timestamp: %s -- treat as NOT SCANNED, never as empty\n", cut) > "/dev/stderr"
							bad = 1
							exit 1
						}
					}
					## Must precede the buffering rule, so a heading closes the PREVIOUS
					## block and then lands in the new one. Never `next` here.
					/^## / { flush() ; }
					{ if ($0 != "") blk[++nb] = $0 ; }
					## Offset derived from the colon, never a second hardcoded count
					## that has to keep agreeing with the pattern.
					/^ts:/ { if (curKey == "") curKey = tskey(substr($0, index($0, ":") + 1)) ; }
					END {
						if (bad) exit 1
						flush()
						## Oldest-first over a plain index array -- POSIX awk has no asort.
						## Collected back-to-front: Slack pages back newest-first.
						m = 0
						for (i = nblk; i >= 1; i--) ord[++m] = i
						for (x = 2; x <= m; x++) {
							v = ord[x] ; j = x - 1
							while (j >= 1 && bkey[ord[j]] > bkey[v]) { ord[j + 1] = ord[j] ; j-- ; }
							ord[j + 1] = v
						}
						## Dated and undatable separated, so the context window counts real
						## messages rather than blocks with no position in the ordering.
						nd = 0 ; nu = 0
						for (x = 1; x <= m; x++) {
							if (bkey[ord[x]] == "") { und[++nu] = ord[x] ; }
							else { dat[++nd] = ord[x] ; }
						}
						first = 0
						for (x = 1; x <= nd; x++) {
							if (bkey[dat[x]] > cutKey) { first = x ; break ; }
						}
						## Nothing newer than the cut-off emits NOTHING, undatable blocks
						## included: a conversation with no new content is not new.
						if (first == 0) exit 0
						for (x = 1; x <= nu; x++) printf("%s\n", body[und[x]])
						start = first - ctx
						if (start < 1) start = 1
						for (x = start; x <= nd; x++) printf("%s\n", body[dat[x]])
					}
				'

				## Every work path here is unique by mktemp, never by $$: scans of several
				## accounts run concurrently in one process tree and share its $$.
				## The DM-to-identity map is no work path: a variable, complete before any thread worker forks.
				local dmIdentityMap="" dmIdentityRows

				## Per-conversation resume points, `label<TAB>channel<TAB>identity<TAB>ts<TAB>origin`,
				## collected as the loop resolves each source and handed to the
				## renderer so the document can state, per correspondent, where this
				## pass actually started. That is what makes it auditable; today a
				## reader cannot tell one source's starting point from another's.
				local imSourceResume=""

				## THE WATCHED SOURCES ARE READ CONCURRENTLY. Each read is a network round
				## trip, paged, and one after another they were most of this scan's time.
				## One worker per source resolves it and reads it into its own files; the
				## loop below then works through those files in the original order, so
				## what it concludes, and the order it says it in, is unchanged. Parallel
				## runs in its own subshell: it installs an EXIT trap, which must not
				## replace the caller's.
				local sourcePrefetchDir
				sourcePrefetchDir="$( mkdir -p "$MMDAPP/.local/temp" && mktemp -d "$MMDAPP/.local/temp/mdat-sweep-sources.XXXXXX" )" \
					|| { set +e ; contextScanCommsFailed=1 ; return 1 ; }
				## EACH WORKER ALSO PARSES WHAT IT READ. The item blocks, the cut-off
				## trim, the DM identity rows and the thread targets of one source
				## depend on that source alone, so they are made beside its read, in
				## parallel, rather than one source after another in the loop below.
				## The loop below only collects the results, in the sources' own order,
				## and says exactly what it said when it did this work itself. A
				## parse failure is a file the loop reads (`fail.<i>`: items or trim;
				## `disc.<i>`: thread discovery), never a missing result.
				AgentsSessionContextSourceFetchOne(){ ## index into slackSourceSpecs
					## Past the leg's bound a worker reads nothing and reports the source unreached.
					if [ "$SECONDS" -ge "$slackLegDeadline" ] ; then
						printf 'not-reached\n' > "$sourcePrefetchDir/state.$1"
						return 0
					fi
					local fetchSpec="${slackSourceSpecs[$1]}" fetchIdentity fetchTarget fetchLabel fetchResolved fetchChannel fetchRc=0
					local fetchKey fetchFloor="" fetchOrigin="pass cut-off"
					fetchIdentity="${fetchSpec%%|*}"
					fetchTarget="${fetchSpec#*|}"
					fetchLabel="${fetchTarget#*|}"
					fetchLabel="${fetchLabel%%|*}"
					fetchTarget="${fetchTarget%%|*}"
					fetchKey="${fetchSpec##*|}"
					fetchFloor="$( AgentsSessionContextSourceFloor "$fetchKey" )"
					[ -z "$fetchKey" ] || [ "$fetchFloor" = "$cutoffEpoch" ] || fetchOrigin="this source's own floor"
					printf '%s\n' "$fetchKey" > "$sourcePrefetchDir/key.$1"
					type DistroAgentsToolsResolveTarget > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.CommsResolveTarget.include"
					fetchResolved="$( DistroAgentsToolsResolveTarget "$fetchTarget" )" || {
						printf 'unresolved\n' > "$sourcePrefetchDir/state.$1"
						return 0
					}
					## CHANNEL= is the resolver's first line, always.
					fetchChannel="${fetchResolved#CHANNEL=}"
					fetchChannel="${fetchChannel%%$'\n'*}"
					printf '%s\n' "$fetchChannel" > "$sourcePrefetchDir/channel.$1"
					local fetchCheckTarget="$fetchChannel:"
					if [ "$commsMemberScopeOnly" != "true" ] && [ "$fetchTarget" = "human-owner" ] ; then
						fetchCheckTarget="$fetchTarget"
					fi
					## --page-until, NOT --oldest. The read below is now paged to
					## the end of a conversation instead of stopping after one
					## page, and with nothing bounding the walk that means every
					## watched source is re-read from its first message on every
					## pass. This bounds how far back the PAGING goes -- to the
					## same cut-off this scan already applies client-side -- while
					## leaving Slack's own `oldest=` unsent, so the page that
					## straddles the cut-off still arrives whole and thread
					## discovery keeps seeing parents older than it.
					local fetchPageUntilArgs=()
					if [ -n "$fetchFloor" ] ; then
						fetchPageUntilArgs=( --page-until "$fetchFloor" )
					fi
					## The spec names which token reads this source. `bot` keeps the
					## identity every team-side source has always been read under; `user`
					## is the persona's own token, which is what a USER_TOKEN persona's
					## own DMs and the whole client-* path have always needed.
					if [ "$fetchIdentity" = "bot" ] ; then
						AgentsToolsSlackCheck "$actingMember" "$fetchCheckTarget" "${fetchPageUntilArgs[@]+"${fetchPageUntilArgs[@]}"}" --identity-bot --raw > "$sourcePrefetchDir/raw.$1" || fetchRc=$?
					else
						AgentsToolsSlackCheck "$actingMember" "$fetchCheckTarget" "${fetchPageUntilArgs[@]+"${fetchPageUntilArgs[@]}"}" --raw > "$sourcePrefetchDir/raw.$1" || fetchRc=$?
					fi
					if [ "$fetchRc" = "0" ] || [ "$fetchRc" = "3" ] ; then
						local parseRaw="" parseJson="" parseRows="" parseBlocks="" parseFound="" parseFail="" parseKept=-1 parseAll=-1
						parseRaw="$( cat "$sourcePrefetchDir/raw.$1" 2>/dev/null )" || parseRaw=""
						parseJson="$( printf '%s\n' "$parseRaw" | sed '1d' )"
						parseRaw=""
						parseRows="$( printf '%s\n' "$parseJson" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsSessionContextDmIdentityMap.awk" | sort -u )"
						[ -z "$parseRows" ] || printf '%s\n' "$parseRows" > "$sourcePrefetchDir/idmap.$1"
						parseBlocks="$( printf '%s\n' "$parseJson" | LC_ALL=C awk -v kind=slack -v source="$fetchLabel" -v channel="$fetchChannel" -f "$commsItemsAwk" )" || parseFail="items"
						## Trimmed against THIS source's resume point, the same value the
						## paging was bounded by -- two different cut-offs over one read is
						## how a message ends up fetched and then silently dropped.
						if [ -z "$parseFail" ] && [ -n "$fetchFloor" ] && [ -n "$parseBlocks" ] ; then
							parseAll="$( printf '%s\n' "$parseBlocks" | LC_ALL=C awk '/^## / { n++ } END { print n + 0 }' )" || parseAll=-1
							parseBlocks="$( printf '%s\n' "$parseBlocks" | LC_ALL=C awk -v cut="$fetchFloor" -v ctx=0 "$commsCutoffTrimAwkProgram" )" || parseFail="trim"
							parseKept="$( printf '%s\n' "$parseBlocks" | LC_ALL=C awk '/^## / { n++ } END { print n + 0 }' )" || parseKept=-1
						fi
						if [ -n "$parseFail" ] ; then
							printf '%s\n' "$parseFail" > "$sourcePrefetchDir/fail.$1"
						else
							[ -z "$parseBlocks" ] || printf '%s' "$parseBlocks" > "$sourcePrefetchDir/blocks.$1"
							## WHAT THE TRIM DROPPED, counted where it dropped it: the read
							## beside this source is the only place both numbers exist. A
							## trim that kept everything writes 0, so an absent count file
							## is a source never trimmed and never a drop of unknown size.
							if [ "$parseAll" -ge 0 ] && [ "$parseKept" -ge 0 ] && [ "$parseAll" -gt "$parseKept" ] ; then
								printf '%s %s %s\n' "$parseAll" "$parseKept" "$(( parseAll - parseKept ))" > "$sourcePrefetchDir/dropped.$1"
							fi
							## Fresh targets carry their latest reply, for the display cap
							## below; known-stale ones are kept apart -- see that awk.
							if parseFound="$( printf '%s\n' "$parseJson" | LC_ALL=C awk -v channel="$fetchChannel" -v oldest="$fetchFloor" -v vaneId="$ownSlackId" -v stale=1 -v latest=1 -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsHarnessJsonField.awk" \
							-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/slack/AgentsSlackHistoryThreadTargets.awk" )" ; then
								if [ -n "$parseFound" ] ; then
									## THE DISCOVERING SOURCE IS KEPT BESIDE EACH TARGET, not thrown
									## away by a de-duplication later. Two sources finding one thread
									## hold two floors for it, and the read that follows has to choose
									## between them instead of being handed one and told nothing.
									printf '%s\n' "$parseFound" | LC_ALL=C awk -v stalePath="$sourcePrefetchDir/stale.$1" -v srcIndex="$1" '$1 == "stale" { print $2 > stalePath ; next } NF >= 2 { print srcIndex "\t" $1 "\t" $2 ; next } NF { print srcIndex "\t" $1 }' | sort -u > "$sourcePrefetchDir/threads.$1"
								fi
							else
								printf 'discovery\n' > "$sourcePrefetchDir/disc.$1"
							fi
						fi
					fi
					printf '%s\n' "$fetchRc" > "$sourcePrefetchDir/rc.$1"
					printf 'read\n' > "$sourcePrefetchDir/state.$1"
					return 0
				}
				## Default 8, overridable -- the roster now enumerates every channel a
				## client-* member belongs to (not DMs alone), so a member with many
				## channel memberships has far more than a handful of sources here.
				## `Parallel`'s own bare default is 4 (parallel.Common), which was sized
				## for the DM-only roster this loop used to read; left unset against a
				## source count in the hundreds, a full pass takes long enough that a
				## caller with any real timeout never sees it finish. Same overridable
				## shape as `ENV_MAGIC_SWEEP_THREAD_WORKERS` below, one dial per fan-out.
				local sourceFetchWorkers="${ENV_MAGIC_SWEEP_SOURCE_WORKERS:-8}"
				case "$sourceFetchWorkers" in
					*[!0123456789]*|''|0)
						sourceFetchWorkers=8
					;;
				esac
				if [ ${#slackSourceSpecs[@]} -gt 0 ] ; then
					type AgentsToolsMyRoot > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/common/AgentsTools.MyRoot.include"
					( type Parallel > /dev/null 2>&1 || . "$MYXROOT/bin/lib/parallel.Common" || exit 1
						Parallel --workers "$sourceFetchWorkers" AgentsSessionContextSourceFetchOne ) < <( seq 0 $(( ${#slackSourceSpecs[@]} - 1 )) ) \
						|| echo "$MDSC_CMD: session-context-scan: ⚠️ WARNING: the concurrent source reads did not all report; each one missing is stated below" >&2
				fi

				## Thread targets found in a source, with the latest reply where the
				## parent states one (`<channel>:<ts> <latest>`), and the known-stale
				## ones the thread fetch below counts as assessed without reading.
				local threadLatest="" staleTargets=() threadSources=() dtLatest sourceFail sourceBlockCount=0
				local slackSpec slackName slackChannel slackBlocks
				local specIdentity specTarget specKey specFloor specOrigin sourceIndex=-1 sourceState
				for slackSpec in ${slackSourceSpecs[@]+"${slackSourceSpecs[@]}"} ; do
					sourceIndex=$(( sourceIndex + 1 ))
					local specRest=""
					specIdentity="${slackSpec%%|*}"
					specRest="${slackSpec#*|}"
					specTarget="${specRest%%|*}"
					specRest="${specRest#*|}"
					slackName="${specRest%%|*}"
					case "$specRest" in
						*"|"*) specKey="${specRest#*|}" ;;
						*) specKey="" ;;
					esac
					specFloor="$( AgentsSessionContextSourceFloor "$specKey" )"
					specOrigin="pass cut-off"
					[ -z "$specKey" ] || [ "$specFloor" = "$cutoffEpoch" ] || specOrigin="this source's own floor"

					imSourcesTotal=$(( imSourcesTotal + 1 ))
					sourceState=""
					[ ! -f "$sourcePrefetchDir/state.$sourceIndex" ] || read -r sourceState < "$sourcePrefetchDir/state.$sourceIndex" || sourceState=""
					case "$sourceState" in
						read) ;;
						not-reached)
							imNotReached=$(( imNotReached + 1 ))
							imNotReachedList="$imNotReachedList  - $slackName"$'\n'
							imAnySourceFailed="true"
							continue
						;;
						unresolved)
							imPartial="$imPartial**NOTE:** partial -- $slackName not scanned, no channel id configured"$'\n'
							imAnySourceFailed="true"
							continue
						;;
						*)
							imPartial="$imPartial**NOTE:** partial -- $slackName not scanned, its concurrent read never reported"$'\n'
							imAnySourceFailed="true"
							continue
						;;
					esac
					slackChannel=""
					[ ! -f "$sourcePrefetchDir/channel.$sourceIndex" ] || read -r slackChannel < "$sourcePrefetchDir/channel.$sourceIndex" || slackChannel=""

					## WHERE THIS SOURCE RESUMES FROM: its own floor where the caller
					## stated one for its key, the pass cut-off otherwise. This scan still
					## holds no position of its own and writes none -- a per-source floor
					## is stated by the caller that keeps them, and a caller that keeps
					## only a pass position states none and reads what it always read.
					imSourceResume="$imSourceResume$slackName	$slackChannel	$specIdentity	$specFloor	$specOrigin"$'\n'

					## Read by this source's worker above, under the identity its spec names.
					local slackCheckRc=1
					[ ! -f "$sourcePrefetchDir/rc.$sourceIndex" ] || read -r slackCheckRc < "$sourcePrefetchDir/rc.$sourceIndex" || slackCheckRc=""
					if [ "$slackCheckRc" != "0" ] && [ "$slackCheckRc" != "3" ] ; then
						imPartial="$imPartial**NOTE:** partial -- $slackName not scanned, AgentsToolsSlackCheck failed"$'\n'
						imAnySourceFailed="true"
						continue
					fi
					if [ "$slackCheckRc" = "3" ] ; then
						imPartial="$imPartial**NOTE:** partial -- $slackName partially scanned, one of the human-owner's two DMs could not be read (AgentsToolsSlackCheck rc=3); the other DM's content below is real, not the missing half"$'\n'
						imAnySourceFailed="true"
					fi
					[ ! -s "$sourcePrefetchDir/idmap.$sourceIndex" ] || dmIdentityMap="$dmIdentityMap$( cat "$sourcePrefetchDir/idmap.$sourceIndex" )"$'\n'
					sourceFail=""
					[ ! -f "$sourcePrefetchDir/fail.$sourceIndex" ] || read -r sourceFail < "$sourcePrefetchDir/fail.$sourceIndex" || sourceFail=""
					case "$sourceFail" in
						items)
							imPartial="$imPartial**NOTE:** partial -- $slackName not scanned, response was an API failure, not an empty channel"$'\n'
							imAnySourceFailed="true"
							continue
						;;
						trim)
							imPartial="$imPartial**NOTE:** partial -- $slackName not scanned, cut-off filter over the channel page failed"$'\n'
							imAnySourceFailed="true"
							continue
						;;
					esac
					imSourcesScanned=$(( imSourcesScanned + 1 ))
					slackBlocks=""
					[ ! -f "$sourcePrefetchDir/blocks.$sourceIndex" ] || slackBlocks="$( cat "$sourcePrefetchDir/blocks.$sourceIndex" )"
					if [ -n "$slackBlocks" ] ; then
						imBlocks="$imBlocks$slackBlocks"$'\n\n'
						sourceBlockCount=$(( sourceBlockCount + 1 ))
					fi
					## WHAT THIS SOURCE'S FLOOR DROPPED, before the blocks were thrown away.
					if [ -f "$sourcePrefetchDir/dropped.$sourceIndex" ] ; then
						local dropAll="" dropKept="" dropCount=""
						read -r dropAll dropKept dropCount < "$sourcePrefetchDir/dropped.$sourceIndex" || :
						case "$dropCount" in
							''|*[!0123456789]*) : ;;
							0) : ;;
							*)
								imDroppedTotal=$(( imDroppedTotal + dropCount ))
								imDroppedSources=$(( imDroppedSources + 1 ))
								imDropped="$imDropped  - $slackName: $dropCount of $dropAll dropped by the $specOrigin"$'\n'
							;;
						esac
					fi

					if [ -f "$sourcePrefetchDir/disc.$sourceIndex" ] ; then
						imPartial="$imPartial**NOTE:** partial -- thread discovery failed for $slackName, watched-channel read above unaffected"$'\n'
					fi
					if [ -f "$sourcePrefetchDir/threads.$sourceIndex" ] ; then
						local dtSource=""
						while IFS="$( printf '\t' )" read -r dtSource dt dtLatest ; do
							[ -n "$dt" ] || continue
							threadTargets+=( "$dt" )
							## The floor this discovering source reads from travels WITH
							## the target. Two sources finding one thread hold two floors,
							## and the read below has to choose between them.
							threadSources+=( "$dt"$'\034'"$specKey"$'\034'"$specFloor"$'\034'"$specOrigin" )
							[ -z "$dtLatest" ] || threadLatest="$threadLatest$dt $dtLatest"$'\n'
						done < "$sourcePrefetchDir/threads.$sourceIndex"
					fi
					if [ -f "$sourcePrefetchDir/stale.$sourceIndex" ] ; then
						while read -r dt ; do
							[ -n "$dt" ] || continue
							staleTargets+=( "$dt" )
						done < "$sourcePrefetchDir/stale.$sourceIndex"
					fi
				done
				rm -rf "$sourcePrefetchDir"
				unset -f AgentsSessionContextSourceFetchOne

				if [ "$commsMemberScopeOnly" != "true" ] && [ ${#matchedFiles[@]} -gt 0 ] ; then
					local boardThreads
					boardThreads="$( LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsSessionContextBoardThreadIds.awk" ${matchedFiles[@]+"${matchedFiles[@]}"} )" || boardThreads=""
					[ -z "$boardThreads" ] || boardThreads="$( printf '%s\n' "$boardThreads" | sort -u )"
					while IFS= read -r dt ; do
						[ -n "$dt" ] || continue
						threadTargets+=( "$dt" )
					done <<< "$boardThreads"
				fi

				local threadFetchWorkDir
				threadFetchWorkDir="$( mktemp -d "$MMDAPP/.local/temp/mdat-sweep-threads.XXXXXX" )" \
					|| { set +e ; contextScanCommsFailed=1 ; return 1 ; }

				local threadTrimAwkFile="$threadFetchWorkDir/trim.awk"
				printf '%s\n' "$commsCutoffTrimAwkProgram" > "$threadTrimAwkFile"

				## Default 6, overridable -- unbounded fan-out risks Slack 429s
				## this scan never had to handle serially.
				local threadFetchWorkers="${ENV_MAGIC_SWEEP_THREAD_WORKERS:-6}"
				case "$threadFetchWorkers" in
					*[!0123456789]*|''|0)
						threadFetchWorkers=6
					;;
				esac

				## Real function, not inline, only because a backgrounded job
				## needs a callable unit -- single-consumer otherwise.
				AgentsSessionContextThreadFetchOne(){
					local memberName="$1" dt="$2" threadFloor="$3" ctxBefore="$4" commsItemsAwkFile="$5" trimAwkFile="$6" workDir="$7" memberScopeOnly="$8" identityMap="$9" outBase="${10}"
					local dtChannel="${dt%%:*}"
					local blocksFile="$workDir/blocks.$outBase" statusFile="$workDir/status.$outBase"
					local fetchRaw fetchJson fetchBlocks
					local dtIdentity=""
					if [ -n "$identityMap" ] ; then
						dtIdentity="$( LC_ALL=C awk -v ch="$dtChannel" '$1 == ch { print $2 ; exit }' <<< "$identityMap" )"
					fi
					## Same paging bound as the watched-source read above: a long
					## thread is paged to its end, but only back as far as the floor
					## this thread actually reads from needs.
					local dtPageUntilArgs=()
					if [ -n "$threadFloor" ] ; then
						dtPageUntilArgs=( --page-until "$threadFloor" )
					fi
					fetchRaw="$( if [ "$memberScopeOnly" = "true" ] ; then
						AgentsToolsSlackCheck "$memberName" "$dt" "${dtPageUntilArgs[@]+"${dtPageUntilArgs[@]}"}" --raw
					elif [ "$dtIdentity" = "bot" ] ; then
						AgentsToolsSlackCheck "$memberName" "$dt" "${dtPageUntilArgs[@]+"${dtPageUntilArgs[@]}"}" --identity-bot --raw
					elif [ "$dtIdentity" != "" ] ; then
						## A non-bot, non-empty mapped identity ("user"): omitting
						## --identity-bot resolves to the token memberName holds.
						AgentsToolsSlackCheck "$memberName" "$dt" "${dtPageUntilArgs[@]+"${dtPageUntilArgs[@]}"}" --raw
					else
						AgentsToolsSlackCheck "$memberName" "$dt" "${dtPageUntilArgs[@]+"${dtPageUntilArgs[@]}"}" --identity-bot --raw
					fi )" || {
						printf 'FAIL:AgentsToolsSlackCheck failed\n' > "$statusFile"
						return 0
					}
					fetchJson="$( printf '%s\n' "$fetchRaw" | sed '1d' )"
					fetchBlocks="$( printf '%s\n' "$fetchJson" | LC_ALL=C awk -v kind=slack -v source="thread:$dt" -v channel="$dtChannel" -f "$commsItemsAwkFile" )" || {
						printf 'FAIL:response was an API failure, not an empty thread\n' > "$statusFile"
						return 0
					}
					if [ -n "$threadFloor" ] && [ -n "$fetchBlocks" ] ; then
						fetchBlocks="$( printf '%s\n' "$fetchBlocks" | LC_ALL=C awk -v cut="$threadFloor" -v ctx="$ctxBefore" -f "$trimAwkFile" )" || {
							printf 'FAIL:cut-off filter over the reply set failed\n' > "$statusFile"
							return 0
						}
					fi
					[ -z "$fetchBlocks" ] || printf '%s\n' "$fetchBlocks" > "$blocksFile"
					printf 'OK\n' > "$statusFile"
					return 0
				}

				## How many conversations already read rank strictly above a thread
				## whose latest reply is $1 -- the rendering's own grouping, recency
				## key and de-duplication, over the watched sources and every thread
				## whose read has finished. A finished read is one with its status
				## file; its blocks file is written before that.
				AgentsSessionContextImGroupsAbove(){ ## latest-reply ts
					local aboveStatus aboveFiles=()
					for aboveStatus in "$threadFetchWorkDir"/status.* ; do
						[ -f "$aboveStatus" ] || continue
						[ ! -f "$threadFetchWorkDir/blocks.${aboveStatus##*.}" ] || aboveFiles+=( "$threadFetchWorkDir/blocks.${aboveStatus##*.}" )
					done
					{ printf '%s' "$imBlocks" ; [ ${#aboveFiles[@]} -eq 0 ] || cat ${aboveFiles[@]+"${aboveFiles[@]}"} ; } | LC_ALL=C awk -v est="$1" '
						function tskey(v,   d, sec, frac) {
							gsub(/^[ \t]+|[ \t\r]+$/, "", v)
							d = index(v, ".")
							if (d == 0) { sec = v ; frac = "" ; }
							else { sec = substr(v, 1, d - 1) ; frac = substr(v, d + 1) ; }
							if (sec !~ /^[0-9]+$/ || length(sec) > 16) return ""
							frac = substr(frac "000000", 1, 6)
							if (frac !~ /^[0-9]+$/) return ""
							while (length(sec) < 16) sec = "0" sec
							return sec frac
						}
						function trim(v) { gsub(/^[ \t]+|[ \t\r]+$/, "", v) ; return v ; }
						function flush(   g) {
							if (!inblk) return
							g = (curSource == "" ? "(source unstated)" : curSource)
							if (curKey == "") gmax[g] = "~"
							else if (gmax[g] != "~" && curKey > gmax[g]) gmax[g] = curKey
							inblk = 0
						}
						/^## / { flush() ; dropping = ($0 in hseen) ; hseen[$0] = 1 ; inblk = !dropping ; curKey = "" ; curSource = "" ; next ; }
						dropping { next ; }
						/^ts:/     { if (inblk && curKey == "")    curKey    = tskey(substr($0, index($0, ":") + 1)) ; }
						/^source:/ { if (inblk && curSource == "") curSource = trim(substr($0, index($0, ":") + 1)) ; }
						END {
							flush()
							ek = tskey(est)
							n = 0
							if (ek != "") for (g in gmax) if (gmax[g] > ek) n++
							print n
						}
					'
				}

				## Each target is named by its line number in the sorted list, not by
				## a checksum of its name: one counter, no fork per target.
				local uniqueThreads dt dtIndex threadFloors=""
				uniqueThreads="$( printf '%s\n' "${threadTargets[@]+"${threadTargets[@]}"}" | LC_ALL=C sort -u )" || uniqueThreads=""
				## ONE FLOOR PER DERIVED READ, CHOSEN FROM THE SOURCES THAT FOUND IT.
				## A thread two sources discover is one read and two floors. The older
				## floor wins: it reads more and trims less, so the choice never loses a
				## reply either source would have shown. A target with no discovering
				## source -- a mention hit, a board item -- takes the pass cut-off, which
				## is what it always took. Comparison is the trim's own string key, never
				## `+ 0`: at this magnitude a double resolves about 2e-7 apart.
				threadFloors="$( printf '%s\n' "${threadSources[@]+"${threadSources[@]}"}" | LC_ALL=C awk -F '\034' '
					function tskey(v,   d, sec, frac) {
						gsub(/^[ \t]+|[ \t\r]+$/, "", v)
						d = index(v, ".")
						if (d == 0) { sec = v ; frac = "" ; }
						else { sec = substr(v, 1, d - 1) ; frac = substr(v, d + 1) ; }
						if (sec !~ /^[0-9]+$/ || length(sec) > 16) return ""
						frac = substr(frac "000000", 1, 6)
						if (frac !~ /^[0-9]+$/) return ""
						while (length(sec) < 16) sec = "0" sec
						return sec frac
					}
					NF >= 4 && $1 != "" {
						t = $1 ; f = $3 ; o = $4
						k = tskey(f)
						if (k == "") next
						if (!(t in seen)) { seen[t] = 1 ; order[++n] = t ; kfloor[t] = k ; floor[t] = f ; origin[t] = o ; next }
						if (k < kfloor[t]) { kfloor[t] = k ; floor[t] = f ; origin[t] = o }
					}
					END { for (i = 1 ; i <= n ; i++) printf "%s\t%s\t%s\n", order[i], floor[order[i]], origin[order[i]] }
				' | LC_ALL=C sort )" || threadFloors=""
				[ -z "$threadFloors" ] || threadOwnFloors="$( printf '%s\n' "$threadFloors" | LC_ALL=C awk -F '\t' '$3 != "pass cut-off" { n++ } END { print n + 0 }' )" || threadOwnFloors=0

				## KNOWN-STALE THREADS ARE ASSESSED, NOT READ. A thread the history
				## shows with its latest reply at or before the cut-off holds nothing
				## the trim would keep, so reading it was a conversations.replies call
				## returning nothing. It still counts as one scanned source, exactly as
				## its empty read did -- unless the same thread is a target anyway
				## (a mention, a board item, another source), and then it is read.
				local staleOnlyCount=0
				if [ ${#staleTargets[@]} -gt 0 ] ; then
					staleOnlyCount="$( { printf '%s\n' "$uniqueThreads" | LC_ALL=C sed 's/^/T /' ; printf '%s\n' ${staleTargets[@]+"${staleTargets[@]}"} | LC_ALL=C sort -u | LC_ALL=C sed 's/^/S /' ; } \
						| LC_ALL=C awk '$1 == "T" { t[$2] = 1 ; next } $1 == "S" && $2 != "" && !($2 in t) { n++ } END { print n + 0 }' )" || staleOnlyCount=0
				fi

				## THE DISPLAY CAP BOUNDS THE READS TOO. The rendering below shows at
				## most $sessionContextCapIm conversations, the most recently active.
				## A thread whose latest reply (stated by its parent in the history)
				## is older than the newest $sessionContextCapIm conversations already
				## READ could never be shown, so it is not read: threads are read
				## newest first, those of unknown recency (mentions, board items)
				## before any, and reading stops at the first thread the cap already
				## excludes. Exact, not estimated: a conversation counts against the
				## cap only once read, with its rendered recency, deduplicated the way
				## the rendering deduplicates. Engaged only when the conversations
				## could exceed the cap at all; below it every target is read.
				local threadOrder="" threadCapEngaged="false" threadCapped=0 threadCappedSet=$'\n'
				local threadUniqueCount=0
				[ -z "$uniqueThreads" ] || threadUniqueCount="$( printf '%s\n' "$uniqueThreads" | LC_ALL=C awk 'NF { n++ } END { print n + 0 }' )"
				if [ $(( sourceBlockCount + threadUniqueCount )) -gt "$sessionContextCapIm" ] ; then
					threadCapEngaged="true"
				fi
				## `<index> <target> <latest-or-empty> <floor> <floor-origin>`, in launch
				## order. The floor comes from the discovering sources, and from the pass
				## cut-off for a target no source discovered.
				threadOrder="$( printf '%s\n' "$uniqueThreads" | THREAD_LATEST="$threadLatest" THREAD_FLOORS="$threadFloors" PASS_CUTOFF="$cutoffEpoch" LC_ALL=C awk -F '\t' '
					function tskey(v,   d, sec, frac) {
						d = index(v, ".")
						if (d == 0) { sec = v ; frac = "" ; }
						else { sec = substr(v, 1, d - 1) ; frac = substr(v, d + 1) ; }
						if (sec !~ /^[0-9]+$/ || length(sec) > 16) return ""
						frac = substr(frac "000000", 1, 6)
						if (frac !~ /^[0-9]+$/) return ""
						while (length(sec) < 16) sec = "0" sec
						return sec frac
					}
					BEGIN {
						n = split(ENVIRON["THREAD_LATEST"], tl, "\n")
						for (i = 1; i <= n; i++) {
							if (tl[i] == "") continue
							split(tl[i], f, " ")
							## An unparseable latest reply is no recency at all: read, never capped.
							if (tskey(f[2]) == "") continue
							if (!(f[1] in late) || tskey(f[2]) > tskey(late[f[1]])) late[f[1]] = f[2]
						}
						n = split(ENVIRON["THREAD_FLOORS"], fr, "\n")
						for (i = 1; i <= n; i++) {
							if (fr[i] == "") continue
							split(fr[i], tf, "\t")
							if (tf[1] == "") continue
							floorOf[tf[1]] = tf[2] ; originOf[tf[1]] = tf[3]
						}
						passCut = ENVIRON["PASS_CUTOFF"]
					}
					NF { idx++ ; if ($1 in late) { kn++ ; kt[kn] = $1 ; ki[kn] = idx ; } else { printf "%s\t%s\t-\t%s\t%s\n", idx, $1, (($1 in floorOf) ? floorOf[$1] : passCut), (($1 in originOf) ? originOf[$1] : "pass cut-off") ; } }
					END {
						for (x = 2; x <= kn; x++) {
							v = kt[x] ; w = ki[x] ; j = x - 1
							while (j >= 1 && tskey(late[kt[j]]) < tskey(late[v])) { kt[j + 1] = kt[j] ; ki[j + 1] = ki[j] ; j-- ; }
							kt[j + 1] = v ; ki[j + 1] = w
						}
						for (x = 1; x <= kn; x++) printf "%s\t%s\t%s\t%s\t%s\n", ki[x], kt[x], late[kt[x]], ((kt[x] in floorOf) ? floorOf[kt[x]] : passCut), ((kt[x] in originOf) ? originOf[kt[x]] : "pass cut-off")
					}
				' )" || threadOrder=""

				local threadEst threadCheckedDone=-1 threadCheckedEst="" threadDone threadAbove threadInFlight
				local threadNotReachedSet=$'\n'
				local dtFloor dtFloorOrigin
				## A TAB IS WHITESPACE TO read: an empty field between two tabs vanishes and the fields after it shift. A thread with no latest
				## reply is written `-` there, and read back as empty, so its floor stays its floor.
				while IFS="$( printf '\t' )" read -r dtIndex dt threadEst dtFloor dtFloorOrigin ; do
					[ "$threadEst" != "-" ] || threadEst=""
					[ -n "$dt" ] || continue
					if [ "$SECONDS" -ge "$slackLegDeadline" ] ; then
						imNotReached=$(( imNotReached + 1 ))
						imNotReachedList="$imNotReachedList  - $dt"$'\n'
						threadNotReachedSet="$threadNotReachedSet$dt"$'\n'
						imAnySourceFailed="true"
						continue
					fi
					if [ "$threadCapEngaged" = "true" ] && [ -n "$threadEst" ] ; then
						if [ "$threadCapped" -gt 0 ] ; then
							threadCapped=$(( threadCapped + 1 ))
							threadCappedSet="$threadCappedSet$dt"$'\n'
							continue
						fi
						threadDone="$( ls -1 "$threadFetchWorkDir" | LC_ALL=C grep -c '^status\.' || : )"
						## The count depends on both: the reads finished and this thread's own recency.
						if [ "$threadDone" != "$threadCheckedDone" ] || [ "$threadEst" != "$threadCheckedEst" ] ; then
							threadCheckedDone="$threadDone"
							threadCheckedEst="$threadEst"
							threadAbove="$( AgentsSessionContextImGroupsAbove "$threadEst" )" || threadAbove=0
						fi
						## Reads still in flight could tip it: wait for them, only then.
						threadInFlight="$( jobs -pr | wc -l | tr -d '[:space:]' )"
						if [ "${threadAbove:-0}" -lt "$sessionContextCapIm" ] && [ "${threadInFlight:-0}" -gt 0 ] \
							&& [ $(( ${threadAbove:-0} + threadInFlight )) -ge "$sessionContextCapIm" ] ; then
							wait
							threadCheckedDone="$( ls -1 "$threadFetchWorkDir" | LC_ALL=C grep -c '^status\.' || : )"
							threadCheckedEst="$threadEst"
							threadAbove="$( AgentsSessionContextImGroupsAbove "$threadEst" )" || threadAbove=0
						fi
						if [ "${threadAbove:-0}" -ge "$sessionContextCapIm" ] ; then
							threadCapped=1
							threadCappedSet="$threadCappedSet$dt"$'\n'
							continue
						fi
					fi
					while [ "$( jobs -pr | wc -l | tr -d '[:space:]' )" -ge "$threadFetchWorkers" ] ; do
						sleep 0.2
					done
					AgentsSessionContextThreadFetchOne "$actingMember" "$dt" "$dtFloor" "$sessionContextThreadContextBefore" "$commsItemsAwk" "$threadTrimAwkFile" "$threadFetchWorkDir" "$commsMemberScopeOnly" "$dmIdentityMap" "$dtIndex" &
				done <<< "$threadOrder"
				wait

				## Merge after `wait`, same sorted order as before -- no
				## concurrent writer here, so no lock is needed.
				dtIndex=0
				while IFS= read -r dt ; do
					[ -n "$dt" ] || continue
					dtIndex=$(( dtIndex + 1 ))
					case "$threadCappedSet" in *$'\n'"$dt"$'\n'*) continue ;; esac
					case "$threadNotReachedSet" in *$'\n'"$dt"$'\n'*) imSourcesTotal=$(( imSourcesTotal + 1 )) ; continue ;; esac
					imSourcesTotal=$(( imSourcesTotal + 1 ))
					local statusLine blocksFile statusFile
					blocksFile="$threadFetchWorkDir/blocks.$dtIndex"
					statusFile="$threadFetchWorkDir/status.$dtIndex"
					if [ -f "$statusFile" ] ; then statusLine="$( cat "$statusFile" )" ; else statusLine="FAIL:no status file -- job never ran or was lost" ; fi
					case "$statusLine" in
						OK)
							imSourcesScanned=$(( imSourcesScanned + 1 ))
							[ -f "$blocksFile" ] && imBlocks="$imBlocks$( cat "$blocksFile" )"$'\n\n'
						;;
						*)
							imPartial="$imPartial**NOTE:** partial -- thread $dt not scanned, ${statusLine#FAIL:}"$'\n'
							imAnySourceFailed="true"
						;;
					esac
				done <<< "$uniqueThreads"
				imSourcesTotal=$(( imSourcesTotal + staleOnlyCount ))
				imSourcesScanned=$(( imSourcesScanned + staleOnlyCount ))
				if [ "$threadCapped" -gt 0 ] ; then
					imCapped="**NOTE:** capped -- $threadCapped thread(s) not read: the latest reply of each is older than the newest $sessionContextCapIm conversations already read, so the $sessionContextCapIm-conversation cap below could never show it. Not a partial read, and not counted in sources-scanned"$'\n'
				fi

				rm -rf "$threadFetchWorkDir"
				unset -f AgentsSessionContextThreadFetchOne AgentsSessionContextImGroupsAbove
				unset COMMS_USER_HANDLES

				[ "$imSourcesScanned" -gt 0 ] || imFailed="true"

				## THREAD ROOTS ARRIVE TWICE: conversations.history emits a thread's
				## root, and that thread's conversations.replies read emits it again.
				## The first copy is the one kept -- the history one, so the grouping
				## filter below keeps the channel's own recency rank.
				if [ -n "$imBlocks" ] ; then
					local imDeduped=""
					imDeduped="$( printf '%s' "$imBlocks" | LC_ALL=C awk '
						/^## / { dropping = ($0 in seen) ; seen[$0] = 1 ; }
						!dropping { print ; }
					' )" || imDeduped=""
					[ -z "$imDeduped" ] || imBlocks="$imDeduped"$'\n\n'
				fi
			fi

			local emailBlocks="" emailInstrument="" emailFailed="false"
			local emailUidsTotal=0 emailNotConfigured="false" emailSince="" emailSinceIso=""
			if [ "$wantEmail" = "true" ] ; then
				emailInstrument="unread-semantics (IMAP UID SEARCH UNSEEN)"
				## THE MAILBOX IS COLLECTED, NOT POLLED (F4.2): the tooling brings it into the member's inbox, TTL by TTL and read-only
				## (AgentsTools.Collect.include), and this scan reads what it brought. No scan holds the password, and no source is
				## asked by every scan that wants it.
				## The mailbox this scan reads as, from the acting member's own scope. A member with no EMAIL_USER keeps the stated default.
				local emailUser=""
				type AgentsToolsConfigOption > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/settings/AgentsTools.ConfigOption.include"
				emailUser="$( AgentsToolsCommsOwnSettingsApply "$actingMember" && AgentsToolsConfigOption "$actingMember" --select EMAIL_USER )" || emailUser=""
				[ -z "$emailUser" ] || emailIdentity="$emailUser"
				type AgentsToolsCollectConfigured > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.Collect.include"
				## Mirrors the collection's own gate: an optional source nothing is configured for must not read as one that failed.
				AgentsToolsCollectConfigured mail "$actingMember" || emailNotConfigured="true"
				if [ "$emailNotConfigured" = "false" ] && [ -n "$cutoffEpoch" ] ; then
					emailSinceIso="$( printf '%s\n' "$(( ${cutoffEpoch%%.*} - 86400 ))" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/output/LocalEpochToIsoDate.awk" )" || emailSinceIso=""
					case "$emailSinceIso" in
						????-??-??)
							## IMAP spells the month in English whatever the locale.
							case "${emailSinceIso:5:2}" in
								01) emailSince="Jan" ;; 02) emailSince="Feb" ;; 03) emailSince="Mar" ;;
								04) emailSince="Apr" ;; 05) emailSince="May" ;; 06) emailSince="Jun" ;;
								07) emailSince="Jul" ;; 08) emailSince="Aug" ;; 09) emailSince="Sep" ;;
								10) emailSince="Oct" ;; 11) emailSince="Nov" ;; 12) emailSince="Dec" ;;
							esac
							[ -z "$emailSince" ] || emailSince="${emailSinceIso:8:2}-$emailSince-${emailSinceIso:0:4}"
						;;
					esac
					case "$emailSince" in
						??-???-????)	;;
						*)
							echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: the email search date could not be derived from cut-off $cutoffEpoch -- the mailbox is reported as not scanned rather than searched without its bound" >&2
							emailFailed="true"
						;;
					esac
					[ -z "$emailSince" ] || emailInstrument="unread-semantics (IMAP UID SEARCH UNSEEN SINCE $emailSince)"
				fi
				if [ "$emailNotConfigured" = "false" ] && [ "$emailFailed" = "false" ] ; then
					## THE EMAIL LEG'S OWN BOUND, checked before the call for the same
					## reason as the Slack leg's: past it the call is not launched, so a
					## mailbox that would have queued behind a long Slack pass is reported
					## unreached rather than left to hold the whole pass open.
					if [ "$SECONDS" -ge "$emailLegDeadline" ] ; then
						emailOutOfTime="true"
						emailFailed="true"
					## Collected now if its TTL has passed; the cut-off narrows the search and what is shown.
					elif AgentsToolsCollectEnsure "$actingMember" mail "$emailSince" ; then
						AgentsToolsCollectBlocks mail "$actingMember" "${emailSinceIso//-/}" "$sessionContextCapEmail" emailBlocks emailUidsTotal
					else
						emailFailed="true"
						echo "$MDSC_CMD: session-context-scan: $agentsCollectLine" >&2
					fi
				fi
			fi

			local trelloBlocks="" trelloInstrument="" trelloFailed="false"
			local trelloNotConfigured="false" trelloTotal=0
			if [ "$wantTrello" = "true" ] ; then
				trelloInstrument="unread-semantics (Trello read_filter=unread)"
				## Collected, not polled, as the mailbox is (F4.2): the unread notifications are notes of the member's inbox.
				type AgentsToolsCollectEnsure > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.Collect.include"
				## Mirrors the collection's own gate, same reason as the email gate above.
				AgentsToolsCollectConfigured trello "$actingMember" || trelloNotConfigured="true"
				local trelloWhoami="" trelloUser="" trelloId=""
				if [ "$trelloNotConfigured" = "false" ] ; then
					type AgentsToolsCommsTrelloWhoami > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/trello/AgentsTools.MemberCommsTrello.include"
					trelloWhoami="$( AgentsToolsCommsTrelloWhoami "$actingMember" )" || trelloWhoami=""
					trelloUser="$( printf '%s\n' "$trelloWhoami" | LC_ALL=C sed -n 's/^TRELLO_USERNAME=//p' | head -1 )" || trelloUser=""
					trelloId="$( printf '%s\n' "$trelloWhoami" | LC_ALL=C sed -n 's/^TRELLO_USER_ID=//p' | head -1 )" || trelloId=""
				fi
				if [ -n "$trelloUser" ] && [ -n "$trelloId" ] ; then
					trelloIdentity="@$trelloUser / $trelloId"
				fi
				if [ "$trelloNotConfigured" = "false" ] ; then
					## The Trello leg carries the same launch bound as the mailbox.
					if [ "$SECONDS" -ge "$trelloLegDeadline" ] ; then
						trelloOutOfTime="true"
						trelloFailed="true"
					elif AgentsToolsCollectEnsure "$actingMember" trello "" ; then
						AgentsToolsCollectBlocks trello "$actingMember" "" "$sessionContextCapTrello" trelloBlocks trelloTotal
					else
						trelloFailed="true"
						echo "$MDSC_CMD: session-context-scan: $agentsCollectLine" >&2
					fi
				fi
			fi

			local imCount emailCount trelloCount
			imCount="$( printf '%s' "$imBlocks" | LC_ALL=C awk 'BEGIN { c = 0; } /^## / { c++; } END { print c; }' )"
			emailCount="$( printf '%s' "$emailBlocks" | LC_ALL=C awk 'BEGIN { c = 0; } /^## / { c++; } END { print c; }' )"
			trelloCount="$( printf '%s' "$trelloBlocks" | LC_ALL=C awk 'BEGIN { c = 0; } /^## / { c++; } END { print c; }' )"

			local anyCommsRequested="false" anyCommsConfigured="false" allCommsEmptyAndScanned="true"
			if [ "$wantSlack" = "true" ] || [ "$wantEmail" = "true" ] || [ "$wantTrello" = "true" ] ; then
				anyCommsRequested="true"
			fi
			## A source nothing is configured for was never looked at: it cannot
			## be empty and it cannot have failed, so it decides nothing here.
			if [ "$wantSlack" = "true" ] ; then anyCommsConfigured="true" ; fi
			if [ "$wantEmail" = "true" ]  && [ "$emailNotConfigured" = "false" ]  ; then anyCommsConfigured="true" ; fi
			if [ "$wantTrello" = "true" ] && [ "$trelloNotConfigured" = "false" ] ; then anyCommsConfigured="true" ; fi
			if [ "$wantSlack" = "true" ]  && { [ "$imCount" != "0" ]     || [ "$imAnySourceFailed" = "true" ] ; } ; then allCommsEmptyAndScanned="false" ; fi
			if [ "$wantEmail" = "true" ]  && [ "$emailNotConfigured" = "false" ]  && { [ "$emailCount" != "0" ]  || [ "$emailFailed" = "true" ] ; }  ; then allCommsEmptyAndScanned="false" ; fi
			if [ "$wantTrello" = "true" ] && [ "$trelloNotConfigured" = "false" ] && { [ "$trelloCount" != "0" ] || [ "$trelloFailed" = "true" ] ; } ; then allCommsEmptyAndScanned="false" ; fi

			if [ "$wantSlack" = "true" ] ; then
				sessionContextSourcesTotal=$(( sessionContextSourcesTotal + imSourcesTotal ))
				sessionContextSourcesScanned=$(( sessionContextSourcesScanned + imSourcesScanned ))
			fi
			## An unconfigured optional source enters neither counter: un-scanned would
			## report partial for ever, scanned would assert a read that never happened.
			if [ "$wantEmail" = "true" ] && [ "$emailNotConfigured" = "false" ] ; then
				sessionContextSourcesTotal=$(( sessionContextSourcesTotal + 1 ))
				[ "$emailFailed" = "true" ] || sessionContextSourcesScanned=$(( sessionContextSourcesScanned + 1 ))
			fi
			if [ "$wantTrello" = "true" ] && [ "$trelloNotConfigured" = "false" ] ; then
				sessionContextSourcesTotal=$(( sessionContextSourcesTotal + 1 ))
				[ "$trelloFailed" = "true" ] || sessionContextSourcesScanned=$(( sessionContextSourcesScanned + 1 ))
			fi

			## The container goes with its three children when every one of them
			## was declined: a declined section is not emitted at all.
			local commsAllDeclined="false"
			if [ "$noSlack" = "true" ] && [ "$noEmail" = "true" ] && [ "$noTrello" = "true" ] ; then
				commsAllDeclined="true"
			fi
			[ "$commsAllDeclined" = "true" ] || printf '# New Incoming Communications\n\n'
			if [ "$anyCommsRequested" = "false" ] ; then
				[ "$commsAllDeclined" = "true" ] || printf '**NOTE:** not requested\n\n'
			elif [ "$anyCommsConfigured" = "false" ] ; then
				printf '**NOTE:** no scan was made -- no requested comms source is configured in this member'"'"'s own scope\n\n'
			elif [ "$allCommsEmptyAndScanned" = "true" ] ; then
				printf '**NOTE:** no new incoming communications\n\n'
			fi

			local imNotReachedText=""
			[ "$imNotReached" -eq 0 ] || imNotReachedText="$( printf 'leg-bound: %s s (ENV_MAGIC_SWEEP_SLACK_LEG_SECONDS) -- launching stopped there, and the reads already in flight were allowed to finish\nnot-reached: %s source(s), which the next pass reads\n%s' "$slackLegSeconds" "$imNotReached" "$imNotReachedList" )"
			## WHAT THE TRIM DROPPED, said whenever it dropped anything: a message
			## fetched and then filtered out is the one loss a reader cannot see, and
			## the count per source is what sizes it. A pass that dropped nothing says
			## nothing at all, so this line never reads as a standing warning.
			## Each of these is printed with its own trailing newline rather than
			## carrying one: a command substitution strips every trailing newline,
			## which would run the next field onto this one's last line.
			local imDroppedText=""
			[ "$imDroppedTotal" -eq 0 ] || imDroppedText="$( printf 'trim-dropped: %s message(s) across %s source(s) -- fetched and then filtered out by that source'"'"'s own floor, newest first\n%s' "$imDroppedTotal" "$imDroppedSources" "$imDropped" )"
			local imFloorText=""
			[ "$threadOwnFloors" -eq 0 ] || imFloorText="$( printf 'thread-floor: %s derived thread read(s) took a discovering source'"'"'s own floor, the rest took the pass cut-off' "$threadOwnFloors" )"
			[ "$noSlack" = "true" ] || printf '## Incoming IM Updates\n\n'
			if [ "$wantSlack" != "true" ] ; then
				[ "$noSlack" = "true" ] || printf '**NOTE:** not requested\n\n'
			elif [ "$imFailed" = "true" ] ; then
				printf 'identity: slack %s (config: %s)\n' "$imIdentity" "$actingMember"
				printf 'instrument: %s\n' "$imInstrument"
				printf 'sources-scanned: %s of %s\n' "$imSourcesScanned" "$imSourcesTotal"
				[ "$imNotReached" -eq 0 ] || printf '%s' "$imNotReachedText"
				printf '**NOTE:** no scan was made -- no watched Slack source could be read\n'
				[ -z "$imPartial" ] || printf '%s' "$imPartial"
				printf '\n'
			else
				printf 'identity: slack %s (config: %s)\n' "$imIdentity" "$actingMember"
				printf 'instrument: %s\n' "$imInstrument"
				printf 'sources-scanned: %s of %s\n' "$imSourcesScanned" "$imSourcesTotal"
				printf 'sort: oldest first -- conversations ordered by their own newest message, messages oldest first within each conversation (no message-level merge across conversations)\n'
				printf 'cap: %s conversations -- a thread, channel or DM is ONE unit however many messages it carries\n' "$sessionContextCapIm"
				printf 'messages-read: %s\n' "$imCount"
				[ -z "$imFloorText" ] || printf '%s\n' "$imFloorText"
				[ -z "$imDroppedText" ] || printf '%s\n' "$imDroppedText"
				[ "$imNotReached" -eq 0 ] || printf '%s' "$imNotReachedText"
				[ -z "$imPartial" ] || printf '%s' "$imPartial"
				[ -z "$imCapped" ] || printf '%s' "$imCapped"
				if [ "$imCount" = "0" ] ; then
					printf '**NOTE:** no new incoming IM updates -- scanned %s of %s sources, 0 messages matched %s\n\n' \
						"$imSourcesScanned" "$imSourcesTotal" "$imInstrument"
				else
					local imRendered=""
					imRendered="$( printf '%s' "$imBlocks" | IM_SOURCE_RESUME="$imSourceResume" LC_ALL=C awk -v cap="$sessionContextCapIm" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsSessionContextImRender.awk" )" || {
						imRendered=""
						printf 'conversations: unknown -- the grouping/cap filter failed\n'
						printf '**NOTE:** partial -- the conversation grouping/cap filter failed; IM item blocks are omitted from this document, though their sources WERE read and are counted in sources-scanned above\n\n'
					}
					## Guarded, so the failure path above does not also emit the
					## stray blank-line pair an empty render would produce here.
					[ -z "$imRendered" ] || printf '%s\n\n' "$imRendered"
				fi
			fi

			[ "$noEmail" = "true" ] || printf '## Incoming Email Updates\n\n'
			if [ "$wantEmail" != "true" ] ; then
				[ "$noEmail" = "true" ] || printf '**NOTE:** not requested\n\n'
			elif [ "$emailNotConfigured" = "true" ] ; then
				## No sources-scanned: line -- an unconfigured optional source has no
				## denominator to be a fraction of.
				printf 'identity: email %s (config: %s)\n' "$emailIdentity" "$actingMember"
				printf 'instrument: %s\n' "$emailInstrument"
				## A client-* member on our own side holds none: what it holds is the other
				## organisation's, read by its own sweep.
				if AgentsToolsCommsOwnSettingsApply "$actingMember" ; then
					printf '**NOTE:** no scan was made -- EMAIL_IMAP_HOST/EMAIL_USER/EMAIL_APP_PASSWORD are not all set in this member'"'"'s own scope; this source is optional, is counted in no source total, and does not make the scan partial\n\n'
				else
					printf '**NOTE:** no scan was made -- %s This source is optional, is counted in no source total, and does not make the scan partial\n\n' "$( AgentsToolsCommsOwnSideLine "$actingMember" mail --intern-op-client-sweep-input-scan )"
				fi
			elif [ "$emailFailed" = "true" ] ; then
				printf 'identity: email %s (config: %s)\n' "$emailIdentity" "$actingMember"
				printf 'instrument: %s\n' "$emailInstrument"
				printf 'sources-scanned: 0 of 1\n'
				if [ "$emailOutOfTime" = "true" ] ; then
					printf 'leg-bound: %s s (ENV_MAGIC_SWEEP_EMAIL_LEG_SECONDS) -- the pass was past it, so this leg was not launched; the next pass reads the mailbox\n' "$emailLegSeconds"
					printf '**NOTE:** no scan was made -- the pass reached this leg after its own bound, not a mailbox fault\n\n'
				else
					printf '**NOTE:** no scan was made -- the IMAP session (login, EXAMINE or UID SEARCH) failed\n\n'
				fi
			else
				printf 'identity: email %s (config: %s)\n' "$emailIdentity" "$actingMember"
				printf 'instrument: %s\n' "$emailInstrument"
				printf 'sources-scanned: 1 of 1\n'
				printf 'cap: %s\n' "$sessionContextCapEmail"
				if [ -n "$emailSince" ] ; then
					printf 'cut-off-applied: by date -- IMAP SINCE %s, the day before the cut-off (IMAP compares dates, not times), on top of unread semantics\n' "$emailSince"
				else
					[ -z "$commsCutoffKind" ] || printf 'cut-off-applied: no -- this service accepts no cut-off; unread semantics used instead\n'
				fi
				if [ "$emailCount" = "0" ] ; then
					printf '**NOTE:** no new incoming email updates -- scanned 1 of 1 sources, 0 messages matched %s\n\n' "$emailInstrument"
				else
					## The UID count, not the block count: the fetch loop stops at the cap,
					## so a block count could never exceed it and would disclose no cut.
					[ "$emailUidsTotal" -le "$emailCount" ] || printf '**NOTE:** truncated -- %s items found, capped at %s\n' "$emailUidsTotal" "$emailCount"
					printf '\n'
					printf '%s' "$emailBlocks" | LC_ALL=C awk -v cap="$sessionContextCapEmail" '/^## / { c++; } c <= cap'
				fi
			fi

			[ "$noTrello" = "true" ] || printf '## Incoming Trello Updates\n\n'
			if [ "$wantTrello" != "true" ] ; then
				[ "$noTrello" = "true" ] || printf '**NOTE:** not requested\n\n'
			elif [ "$trelloNotConfigured" = "true" ] ; then
				## No sources-scanned: line, same reason as the email section.
				printf 'identity: trello %s (config: %s)\n' "$trelloIdentity" "$actingMember"
				printf 'instrument: %s\n' "$trelloInstrument"
				## A client-* member on our own side holds none: what it holds is the other
				## organisation's, read by its own sweep.
				if AgentsToolsCommsOwnSettingsApply "$actingMember" ; then
					printf '**NOTE:** no scan was made -- TRELLO_KEY/TRELLO_TOKEN are not both set in this member'"'"'s own scope; this source is optional, is counted in no source total, and does not make the scan partial\n\n'
				else
					printf '**NOTE:** no scan was made -- %s This source is optional, is counted in no source total, and does not make the scan partial\n\n' "$( AgentsToolsCommsOwnSideLine "$actingMember" Trello --intern-op-client-sweep-input-scan )"
				fi
			elif [ "$trelloFailed" = "true" ] ; then
				printf 'identity: trello %s (config: %s)\n' "$trelloIdentity" "$actingMember"
				printf 'instrument: %s\n' "$trelloInstrument"
				printf 'sources-scanned: 0 of 1\n'
				if [ "$trelloOutOfTime" = "true" ] ; then
					printf 'leg-bound: %s s (ENV_MAGIC_SWEEP_TRELLO_LEG_SECONDS) -- the pass was past it, so this leg was not launched; the next pass reads the notifications\n' "$trelloLegSeconds"
					printf '**NOTE:** no scan was made -- the pass reached this leg after its own bound, not a Trello fault\n\n'
				else
					printf '**NOTE:** no scan was made -- --trello-check failed or did not answer with JSON\n\n'
				fi
			else
				printf 'identity: trello %s (config: %s)\n' "$trelloIdentity" "$actingMember"
				printf 'instrument: %s\n' "$trelloInstrument"
				printf 'sources-scanned: 1 of 1\n'
				printf 'cap: %s\n' "$sessionContextCapTrello"
				[ -z "$commsCutoffKind" ] || printf 'cut-off-applied: no -- this service accepts no cut-off; unread semantics used instead\n'
				if [ "$trelloCount" = "0" ] ; then
					printf '**NOTE:** no new incoming Trello updates -- scanned 1 of 1 sources, 0 notifications matched %s\n\n' "$trelloInstrument"
				else
					[ "$trelloTotal" -le "$trelloCount" ] || printf '**NOTE:** truncated -- %s items found, capped at %s\n' "$trelloTotal" "$trelloCount"
					printf '\n'
					printf '%s' "$trelloBlocks" | LC_ALL=C awk -v cap="$sessionContextCapTrello" '/^## / { c++; } c <= cap'
				fi
			fi

			local sessionContextCapInbox=64
			## A section shows its NEWEST items in full and says the rest in one line each
			## (a count only for reflections, which are a pile by nature): the item that
			## matters to a session is the one just filed, never the one filed first.
			local sessionContextCapInboxReflections=5
			local sessionContextCapInboxReflectionBytes=1024
			local sessionContextCapInboxOlderListed=64
			local inboxSectionCap inboxSectionBytes inboxOlderCount inboxOlderListed
			local inboxFolder
			local inboxScanned inboxMatched=() inboxOrdered inboxScopeLine inboxFilterText inboxHeading inboxPrefix
			local inboxSpec inboxWanted inboxWithProcessed inboxDeclined ii
			local inboxFilterDesc inboxCandidates=() ci inboxEmit=()

			## The acting member's own inbox first -- byte-for-byte the same sections as
			## before this option existed -- and then one labelled group per widened
			## inbox. A widened inbox is READ and shown, never acted as and never
			## written to; the banner below states that in the document as well, so a
			## reader of the scan cannot mistake a client's inbox for the coordinator's.
			local inboxMembers=( "$actingMember" ) inboxMember inboxHeadingText
			for alsoSeen in "${inboxAlsoMembers[@]+"${inboxAlsoMembers[@]}"}" ; do
				inboxMembers+=( "$alsoSeen" )
			done

			for inboxMember in ${inboxMembers[@]+"${inboxMembers[@]}"} ; do
				if [ "$inboxMember" != "$actingMember" ] ; then
					printf '## Additional Inbox -- %s\n\n' "$inboxMember"
					printf 'scope: inboxes/%s/ -- read-only widening. The acting identity stays %s: this scan does not act as %s, reads none of its credentials or comms sources, and writes nothing into its inbox.\n\n' \
						"$inboxMember" "$actingMember" "$inboxMember"
				fi

				for inboxSpec in \
					"Active Inbox Inquiry Items inquiry- $doInboxInquiryActive$doInboxInquiryAll $doInboxInquiryAll $noInboxInquiry" \
					"Current Inbox Reflections reflection- $doInboxReflections false $noInboxReflections" \
					"Current Inbox Notes note- $doInboxNotes false $noInboxNotes" \
					"Other Inbox Items -other- $doInboxOther false $noInboxOther" \
				; do
					inboxDeclined="${inboxSpec##* }"
					inboxSpec="${inboxSpec% *}"
					inboxWithProcessed="${inboxSpec##* }"
					inboxSpec="${inboxSpec% *}"
					inboxWanted="${inboxSpec##* }"
					inboxSpec="${inboxSpec% *}"
					inboxPrefix="${inboxSpec##* }"
					inboxHeading="${inboxSpec% *}"
					if [ "$inboxMember" = "$actingMember" ] ; then
						inboxHeadingText="$inboxHeading"
					else
						inboxHeadingText="$inboxHeading -- $inboxMember"
					fi

					## Before the first printf: a declined section emits nothing at all.
					if [ "true" = "$inboxDeclined" ] ; then continue ; fi

					case "$inboxWanted" in
						*true*)
							printf '## %s\n' "$inboxHeadingText"
						;;
						*)
							printf '## %s\n\n' "$inboxHeadingText"
							printf '**NOTE:** not requested\n\n'
							continue
						;;
					esac

					if [ "$inboxWithProcessed" = "true" ] ; then
						inboxScopeLine="inboxes/$inboxMember/ -- its incoming items and its processed items"
						inboxFilterText="including processed"
					else
						inboxScopeLine="inboxes/$inboxMember/ -- its incoming items, none processed"
						inboxFilterText="excluding processed"
					fi
					if [ "$inboxPrefix" = "-other-" ] ; then
						inboxFilterDesc="a prefix other than inquiry-*/reflection-*/note-*"
					else
						inboxFilterDesc="$inboxPrefix*"
					fi
					inboxSectionCap="$sessionContextCapInbox"
					inboxSectionBytes="$sessionContextCapInboxItemBytes"
					if [ "$inboxPrefix" = "reflection-" ] ; then
						inboxSectionCap="$sessionContextCapInboxReflections"
						inboxSectionBytes="$sessionContextCapInboxReflectionBytes"
					fi
					printf 'scope: %s\n' "$inboxScopeLine"
					printf 'cap: %s\n' "$inboxSectionCap"

					inboxScanned=0
					inboxCandidates=()
					## incoming/ holds what is not processed, processed/ the rest. Both folders come from the inbox's owner,
					## resolved here so a section that reads processed/ leaves the next one its own incoming/.
					type AgentsToolsInboxFolderInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/inbox/AgentsTools.InboxPlace.include"
					AgentsToolsInboxFolderInto inboxFolder "$inboxMember" incoming || inboxFolder=""
					for f in "$inboxFolder"/*.md ; do
						[ -f "$f" ] && inboxCandidates+=( "$f" )
					done
					if [ "$inboxWithProcessed" = "true" ] ; then
						AgentsToolsInboxFolderInto inboxFolder "$inboxMember" processed || inboxFolder=""
						for f in "$inboxFolder"/*.md ; do
							[ -f "$f" ] && inboxCandidates+=( "$f" )
						done
					fi
					inboxScanned=${#inboxCandidates[@]}
					inboxMatched=()
					ci=0
					while [ "$ci" -lt "$inboxScanned" ] ; do
						f="${inboxCandidates[$ci]}"
						ci=$(( ci + 1 ))
						## The collected mail and Trello notes of the acting member are shown in the section of their source when this scan
						## reads that source (F4.2), and not twice; a scan that does not read it lists them as the inbox items they are.
						if [ "$inboxMember" = "$actingMember" ] ; then
							case "${f##*/}" in
								note-*-email-u*.md) [ "$wantEmail" != "true" ] || continue ;;
								note-*-trello-*.md) [ "$wantTrello" != "true" ] || continue ;;
							esac
						fi
						case "$inboxPrefix" in
							-other-)
								case "${f##*/}" in
									inquiry-*|reflection-*|note-*) ;;
									*) inboxMatched+=( "$f" ) ;;
								esac
							;;
							*)
								case "${f##*/}" in "$inboxPrefix"*) inboxMatched+=( "$f" ) ;; esac
							;;
						esac
					done

					if [ ${#inboxMatched[@]} -eq 0 ] ; then
						printf '**NOTE:** no new %s -- scanned %s items, 0 matched %s in inboxes/%s/ (%s)\n\n' \
							"$inboxHeading" "$inboxScanned" "$inboxFilterDesc" "$inboxMember" "$inboxFilterText"
						continue
					fi

					inboxOlderCount=$(( ${#inboxMatched[@]} - inboxSectionCap ))
					[ "$inboxOlderCount" -le 0 ] || printf '**NOTE:** truncated -- %s items found, capped at %s -- NEWEST kept in full, %s older not shown in full\n' "${#inboxMatched[@]}" "$inboxSectionCap" "$inboxOlderCount"
					printf '\n'
					inboxOrdered="$( LC_ALL=C ls -tr ${inboxMatched[@]+"${inboxMatched[@]}"} )" || inboxOrdered=""
					inboxEmit=()
					inboxOlderListed=0
					ii=0
					while IFS= read -r f ; do
						[ -n "$f" ] || continue
						ii=$(( ii + 1 ))
						if [ "$ii" -le "$inboxOlderCount" ] ; then
							## Older than the newest cap: a header line, the name only, from the listing
							## already in hand. Reflections get the count above and no names.
							if [ "$inboxPrefix" != "reflection-" ] && [ "$inboxOlderListed" -lt "$sessionContextCapInboxOlderListed" ] ; then
								inboxOlderListed=$(( inboxOlderListed + 1 ))
								printf 'older: inbox/%s\n' "${f##*/}"
							fi
							continue
						fi
						inboxEmit+=( "$f" )
					done <<< "$inboxOrdered"
					if [ "$inboxOlderCount" -gt "$inboxOlderListed" ] && [ "$inboxPrefix" != "reflection-" ] ; then
						printf 'older: (+%s more, not listed)\n' "$(( inboxOlderCount - inboxOlderListed ))"
					fi
					[ "$inboxOlderListed" -eq 0 ] || printf '\n'
					[ ${#inboxEmit[@]} -eq 0 ] || LC_ALL=C awk \
						-v bodyByteCap="$inboxSectionBytes" \
						-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/inbox/AgentsInboxItemBlockPrint.awk" \
						${inboxEmit[@]+"${inboxEmit[@]}"}
					## THE SECTION'S CLOSING INSTRUCTION (S18.3): the acting member's own unprocessed items, never a widened read-only inbox,
					## whose items are not that member's to mark. A section is one block, so the line stands once in it.
					if [ "$inboxMember" = "$actingMember" ] ; then
						printf '%s\n\n' "$( AgentsToolsInboxInstruction )"
					fi
					## Named-item lookup below is the ACTING member's own inbox only, so
					## only its paths belong in the already-emitted set.
					if [ "$inboxMember" = "$actingMember" ] ; then
						[ ${#inboxEmit[@]} -eq 0 ] || inboxEmittedPaths+=( ${inboxEmit[@]+"${inboxEmit[@]}"} )
					fi
				done
			done

}
