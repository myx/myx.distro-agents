#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.SuperviseScan.include -- the supervisor's scan (next epic S13): what needs a coordinator's hand on the rigs,
## read only, one line a finding. Sourced, never run; functions only.
##

## --supervise-scan [--workspace <path>]...: one line a finding, `<kind> <workspace> <id> <detail>`, for each workspace named, else this one.
## Kinds: `ask` an open question to magic-coordinator or the human-owner; `unposted` an open question whose post never landed;
## `orphan-ask` an open question to another member that has no live run to answer it; `msg` a post addressed to magic-coordinator in
## any session chat since --since <epoch>; `dead` a record still started whose run has no process, and is neither parked nor dismissed;
## `run` where each live run stands, `<ws> <id> <member> <active|waiting|stuck> tool=<name> age=<n>m paused=<yes|no> asks=<n> msg <who>: <text> plan: <text>`;
## `idle-done` a live run that handed back and has nothing pending; `no-plan` a live run older than ten minutes with no CheckList of its own;
## `stale-plan` a run active in the last ten minutes whose CheckList is unchanged for an hour; `control-stuck` a control thread
## whose session has no record left open at all and whose log has not been written for SESSION_CONTROL_NO_RUN_END_SECONDS plus five
## minutes, which is a thread that should have ended itself and did not (S5.6); `rig-orphan` a control thread inside a run's output folder,
## a test rig, alive after that run's record closed (S5.2); `track` an event of a run's
## event-track thread since --since: a failed or refused tool call, an ask, an answer, a handback, a final answer, a model change.
## Last, `checklist`, `checklist-doing` and `checklist-open`: the calling supervisor's own CheckList as a digest, once a scan.
## A `run` line reads no file's date: its age is the run's own activity mark, else the stamp of its own transcript. The transcript is
## read for a name alone between tools, since a long call leaves no line there until it returns, and every part of it is read.
## Liveness is the process and the record's own `run-process`, never the status word, which answers one question only: whether the
## record is open. A record closed while its run lives still gets its line, and a closed record with no process gets none.
type AgentsToolsSessionPauseHeld > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionPause.include"
##
## STALLS (S13.2), the readings a waiting run never answers by itself, since `stuck` leaves every run in a Wait alone:
##   `stall` a live run silent past the stall bound, still counting as not working, with items pending on its own CheckList:
##           `<ws> <id> <member> age=<n>m pending=<n> plan: <text>`;
##   `parent-ask` an open question to the human-owner whose asking run's parent session is a live magic-coordinator's, so the
##           parent can settle it: `<ws> <id> <to> by <member> parent <id> <member>`. The plain `ask` line stays beside it,
##           since the question is open either way.
## The bound is MDAT_SUPERVISE_STALL_SECONDS (600 where unset, and the same one the `stuck` verdict reads).
## THE WALK FOR A RIG'S CONTROL PID FILES RUNS ONCE IN FIFTEEN MINUTES (call-path audit): a find over spawned/ to depth 14 ran for
## minutes under load, twice a supervision tick, from the scan and from the close. Its result is kept in schedule/supervise.rig-pids and
## reread within MDAT_SUPERVISE_RIG_WALK_SECONDS (900, 0 for every call). Every path it returns is still tested by its caller (the pid
## is alive, the record is closed), so a kept list delays a new rig orphan's detection by at most the TTL and never names a wrong one.
AgentsToolsSuperviseRigPidFiles(){ ## the agents folder
	local walkCache="$1/schedule/supervise.rig-pids" walkTtl="${MDAT_SUPERVISE_RIG_WALK_SECONDS:-900}" walkAt walkNow
	case "$walkTtl" in ''|*[!0123456789]*) walkTtl=900 ;; esac
	walkNow="$( date +%s )"
	if [ "$walkTtl" -gt 0 ] && [ -f "$walkCache" ] ; then
		walkAt="$( stat -f %m "$walkCache" 2> /dev/null || stat -c %Y "$walkCache" 2> /dev/null )" || walkAt=0
		case "$walkAt" in ''|*[!0123456789]*) walkAt=0 ;; esac
		if [ $(( walkNow - walkAt )) -lt "$walkTtl" ] ; then cat "$walkCache" 2> /dev/null ; return 0 ; fi
	fi
	mkdir -p "$1/schedule" 2> /dev/null
	find "$1/spawned" -mindepth 6 -maxdepth 14 \( -name .git -o -name node_modules \) -prune -o -path '*/output/*' -path '*/control/pid' -type f -print 2> /dev/null > "$walkCache.tmp" && mv -f "$walkCache.tmp" "$walkCache" 2> /dev/null
	cat "$walkCache" 2> /dev/null
	return 0
}

AgentsToolsSuperviseScan(){
	local scanWorkspaces=() scanWs scanAgents scanFile scanSpid scanSid scanMember scanLog scanDir scanPs scanSince="" scanTo scanTs scanChat
	local scanCtlFile scanCtlPid scanCtlSid scanCtlRest scanNoRunMin scanOpen scanSinceIso scanChatDir scanChatSess scanRosterFile scanDirName
	local scanNow scanRunDir scanMark scanMarkFile scanMarkEpoch scanMarkWord scanAgeSec scanAgeText scanTool scanStamp scanName scanEpoch
	local scanBase scanLine scanParts scanOpen scanRuns scanAsk scanAskSid scanAsks scanMsg scanPlan scanWord scanVerdict scanPaused scanSetAside
	local scanRow scanTable scanStatus scanRunNamed scanBegan scanLive scanAskSet scanTab
	local scanStallSec scanPending scanAskParent scanAskFound scanAskParentMember scanAskParentRecord
	while [ $# -gt 0 ] ; do
		case "$1" in
			--since) [ $# -ge 2 ] || { echo "$MDSC_CMD: ⛔ ERROR: --since requires an epoch" >&2 ; return 1 ; } ; scanSince="$2" ; shift 2 ;;
			--workspace) [ $# -ge 2 ] || { echo "$MDSC_CMD: ⛔ ERROR: --workspace requires a path" >&2 ; return 1 ; } ; scanWorkspaces+=( "${2%/}" ) ; shift 2 ;;
			*) echo "$MDSC_CMD: ⛔ ERROR: --supervise-scan: invalid option: $1" >&2 ; return 1 ;;
		esac
	done
	[ ${#scanWorkspaces[@]} -gt 0 ] || scanWorkspaces=( "${MMDAPP%/}" )
	scanStallSec="${MDAT_SUPERVISE_STALL_SECONDS:-600}"
	case "$scanStallSec" in ''|*[!0123456789]*|0) scanStallSec=600 ;; esac
	scanNow="$( date -u +%s )"
	scanTab=$'\t'
	## A CONTROL THREAD IS NO RUN, and it is left out here rather than trusted to the run-word reader alone: a thread started through a
	## wrapper carries the wrapper's words before the tooling script's, and the reader then answers that session id as a live run.
	scanPs="$( ps -A -ww -o pid=,args= 2> /dev/null | LC_ALL=C grep -v -- '--intern-session-control' )"
	## The one reading of liveness the tooling keeps (AgentsToolsLivenessOf, S23.6): a process of this host runs as the spawn, or the
	## process its record names as its launch still lives. Neither reading is the record's status.
	type AgentsToolsRegistryRunWords > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.Registries.include"
	## THE PROCESS LIST IS ANSWERED FOR EVERY RECORD AT ONCE, never once a record: `scanLive` the ids a process answers for, and
	## `scanBegan` every process with the moment it began, the form a record's `run-process:` is kept in.
	scanLive="$( printf '%s\n' "$scanPs" | AgentsToolsRegistryRunWords )" || scanLive=""
	scanBegan="$( printf '%s\n' "$scanPs" | LC_ALL=C awk 'NF { print $1 }' | AgentsToolsRegistryProcessesBegan )" || scanBegan=""
	for scanWs in "${scanWorkspaces[@]}" ; do
		scanAgents="$scanWs/.local/agents"
		[ -d "$scanAgents" ] || { printf 'error %s - no .local/agents here\n' "${scanWs##*/}" ; continue ; }
		## EVERY RECORD'S SEVEN FIELDS IN ONE READ OF THEM ALL, before any question is read, since the asks below answer from it: a record
		## flushed at the next file's first line or at END, since the fleet's awk has no ENDFILE.
		scanTable="$( LC_ALL=C awk '
			function flush( ) { if ( spid != "" ) { print spid "\t" sid "\t" owner "\t" status "\t" named "\t" psid "\t" record } ; spid = "" ; sid = "" ; owner = "" ; status = "" ; named = "" ; psid = "" ; fence = 0 }
			FNR == 1 { flush() ; record = FILENAME }
			$0 == "---" { if ( ++fence > 1 ) next ; next }
			fence != 1 { next }
			index( $0, "spawn-id: " ) == 1 && spid == "" { spid = substr( $0, 11 ) ; next }
			index( $0, "session-id: " ) == 1 && sid == "" { sid = substr( $0, 13 ) ; next }
			index( $0, "owner: " ) == 1 && owner == "" { owner = substr( $0, 8 ) ; next }
			index( $0, "status: " ) == 1 && status == "" { status = substr( $0, 9 ) ; next }
			index( $0, "run-process: " ) == 1 && named == "" { named = substr( $0, 14 ) ; next }
			index( $0, "parent-session-id: " ) == 1 && psid == "" { psid = substr( $0, 20 ) ; next }
			END { flush() }
		' "$scanAgents"/spawned/*/*.spawn.md 2> /dev/null )" || scanTable=""
		for scanFile in "$scanAgents"/pending/*.md ; do
			[ -f "$scanFile" ] || continue
			LC_ALL=C grep -q -x 'status: reply-pending' "$scanFile" || continue
			scanTo="$( LC_ALL=C sed -n 's/^address-to: //p' "$scanFile" | head -1 )"
			scanTs="$( LC_ALL=C sed -n 's/^question-ts: //p' "$scanFile" | head -1 )"
			if [ -z "$scanTs" ] ; then
				printf 'unposted %s %s %s by %s to %s\n' "${scanWs##*/}" "$( basename "$scanFile" .md | cut -c1-8 )" \
					"$( LC_ALL=C sed -n 's/^kind: //p' "$scanFile" | head -1 )" "$( LC_ALL=C sed -n 's/^owner: //p' "$scanFile" | head -1 )" "$scanTo"
				continue
			fi
			case "$scanTo" in
				*magic-coordinator*|*human-owner*|U0*|'') ;;
				*)
					printf '%s\n' "$scanPs" | LC_ALL=C grep -q -- "--team-member $scanTo " && continue
					printf 'orphan-ask %s %s to %s by %s\n' "${scanWs##*/}" "$( basename "$scanFile" .md | cut -c1-8 )" "$scanTo" "$( LC_ALL=C sed -n 's/^owner: //p' "$scanFile" | head -1 )"
					continue
				;;
			esac
			printf 'ask %s %s %s by %s at %s\n' "${scanWs##*/}" "$( basename "$scanFile" .md | cut -c1-8 )" \
				"$( LC_ALL=C sed -n 's/^kind: //p' "$scanFile" | head -1 )" "$( LC_ALL=C sed -n 's/^owner: //p' "$scanFile" | head -1 )" \
				"$( LC_ALL=C sed -n 's/^asked-at: //p' "$scanFile" | head -1 )"
			## AN ASK TO THE OWNER THAT ITS OWN PARENT CAN SETTLE (S13.2). The asking run's record names the session that
			## started it; where that parent is a live magic-coordinator's, the question never needed the owner. Every other
			## ask keeps its one line. Liveness is the tooling's one reading of it, so an unknown parent is never a live one.
			case "$scanTo" in
				*human-owner*|U0*) ;;
				*) continue ;;
			esac
			## BOTH ANSWERS COME FROM THE RECORD TABLE READ ONCE ABOVE (S13.18): the asking run's parent, that parent's member and its
			## record, in one lookup. A scan's cost is then the records' own, however many questions the owner holds.
			scanAskSid="$( LC_ALL=C sed -n 's/^session-id: //p' "$scanFile" | head -1 )"
			scanAskFound="$( printf '%s\n' "$scanTable" | LC_ALL=C awk -F'\t' -v one="$scanAskSid" '
				{ parentOf[ $1 ] = $6 ; ownerOf[ $1 ] = $3 ; recordOf[ $1 ] = $7 }
				END {
					parentSid = parentOf[ one ]
					if ( parentSid == "" ) exit
					print parentSid "\t" ownerOf[ parentSid ] "\t" recordOf[ parentSid ]
				}' )" || scanAskFound=""
			[ -n "$scanAskFound" ] || continue
			scanAskParent="${scanAskFound%%"$scanTab"*}" ; scanAskFound="${scanAskFound#*"$scanTab"}"
			scanAskParentMember="${scanAskFound%%"$scanTab"*}" ; scanAskParentRecord="${scanAskFound#*"$scanTab"}"
			case "$scanAskParent" in ''|-|*/*|.|..) continue ;; esac
			[ "$scanAskParentMember" = magic-coordinator ] || continue
			[ -n "$scanAskParentRecord" ] || continue
			[ "$( AgentsToolsLivenessOf "$scanAskParent" "$scanAskParentRecord" 2> /dev/null )" = alive ] || continue
			printf 'parent-ask %s %s %s by %s parent %s %s\n' "${scanWs##*/}" "$( basename "$scanFile" .md | cut -c1-8 )" "$scanTo" \
				"$( LC_ALL=C sed -n 's/^owner: //p' "$scanFile" | head -1 )" "$( printf '%s' "$scanAskParent" | cut -c1-8 )" "$scanAskParentMember"
		done
		if [ -n "$scanSince" ] ; then
			## The since moment is rendered once per scan, the session names by parameter expansion: no date, basename, dirname or cut
			## process per session (call-path audit row 50).
			scanSinceIso="$( date -u -r "$scanSince" +%Y-%m-%dT%H:%M:%SZ 2> /dev/null )"
			## One post shows once: each participant's chat holds its own copy of it.
			{
				for scanChat in "$scanAgents"/sessions/*/session.chat ; do
					[ -f "$scanChat" ] || continue
					[ "$( stat -f %m "$scanChat" 2> /dev/null || echo 0 )" -ge "$scanSince" ] || continue
					scanChatDir="${scanChat%/*}" ; scanChatSess="${scanChatDir##*/}"
					LC_ALL=C awk -v since="$scanSinceIso" -v ws="${scanWs##*/}" -v sess="${scanChatSess:0:8}" '
						/^20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9:]+Z [a-z-]+ -> [^:]*magic-coordinator[^:]*:/ {
							if ($2 != "magic-coordinator" && $1 >= since) { getline body ; if (body ~ /^Process process-[0-9]+ ended with exit status/) next ; print "msg " ws " " sess " from " $2 ": " substr(body, 1, 160) ; fflush() }
						}' "$scanChat"
				done
			} | LC_ALL=C awk '{ key = $0 ; sub(/^msg [^ ]+ [^ ]+ /, "", key) } !seen[key]++'
			## The event-track thread of each run, from its local copy: what needs a look, never the routine rounds, waits or good tool calls.
			{
				## One event shows once: the same post lands in several runs' copies, and repeats within one.
				for scanChat in "$scanAgents"/sessions/*/feed.posting ; do
					[ -f "$scanChat" ] || continue
					[ "$( stat -f %m "$scanChat" 2> /dev/null || echo 0 )" -ge "$scanSince" ] || continue
					scanDir="${scanChat%/*}"
					scanMember=""
					for scanRosterFile in "$scanDir"/dms-roster.* ; do [ ! -e "$scanRosterFile" ] || { scanMember="${scanRosterFile##*/dms-roster.}" ; break ; } ; done
					scanDirName="${scanDir##*/}"
					LC_ALL=C awk -v since="$scanSinceIso" -v ws="${scanWs##*/}" -v sess="${scanDirName:0:8}" -v member="${scanMember:--}" '
						/^20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9:]+Z / && $1 >= since {
							if ($2 == "TOOL" && $0 !~ / -> (error|refused)/) next
							if ($2 != "TOOL" && $2 != "ASK" && $2 != "ANSWER" && $2 != "HANDBACK" && $2 != "FINAL" && $2 != "MODEL") next
							print "track " ws " " sess " " member ": " substr($0, 1, 220) ; fflush()
						}' "$scanChat"
				done
			} | LC_ALL=C awk '{ key = $0 ; sub(/^track [^ ]+ [^ ]+ [^ ]+ /, "", key) } !seen[key]++'
		fi
		## EVERY OPEN QUESTION READ ONCE, with the session it asks for, so a run's ask count is one pass over that list.
		scanAskSet=""
		for scanAsk in "$scanAgents"/pending/*.md ; do
			[ -f "$scanAsk" ] || continue
			LC_ALL=C grep -q -x 'status: reply-pending' "$scanAsk" || continue
			scanAskSid="$( LC_ALL=C sed -n 's/^session-id: //p' "$scanAsk" | head -1 )"
			[ -n "$scanAskSid" ] || continue
			scanAskSet="$scanAskSet$scanAskSid"$'\n'
		done
		while IFS= read -r scanRow ; do
			[ -n "$scanRow" ] || continue
			scanSpid="${scanRow%%"$scanTab"*}" ; scanRow="${scanRow#*"$scanTab"}"
			scanSid="${scanRow%%"$scanTab"*}" ; scanRow="${scanRow#*"$scanTab"}"
			scanMember="${scanRow%%"$scanTab"*}" ; scanRow="${scanRow#*"$scanTab"}"
			scanStatus="${scanRow%%"$scanTab"*}" ; scanRow="${scanRow#*"$scanTab"}"
			scanRunNamed="${scanRow%%"$scanTab"*}" ; scanRow="${scanRow#*"$scanTab"}"
			scanFile="${scanRow#*"$scanTab"}"
			[ -n "$scanSpid" ] || continue
			scanOpen=no
			[ "$scanStatus" != spawn-started ] || scanOpen=yes
			## A run parked or dismissed on its handback waits for its verdict: no dead line, and no verdict of its own.
			scanRunDir="$scanAgents/sessions/$scanSpid"
			[ -d "$scanRunDir" ] || scanRunDir="$scanAgents/sessions/${scanSid:-$scanSpid}"
			scanSetAside=no
			for scanMarkFile in parked dismissed ; do
				[ ! -f "$scanRunDir/$scanMarkFile" ] || scanSetAside=yes
			done
			[ "$scanSetAside" = no ] || continue
			## LIVENESS NEXT, from the two tables already read: an id a process of this host answers for, or the pid and start
			## its record names, still that same process. A run neither answers for is finished and costs no more than this.
			scanRuns=""
			case $'\n'"$scanLive"$'\n' in *$'\n'"$scanSpid"$'\n'*) scanRuns=yes ;; esac
			if [ -z "$scanRuns" ] && [ -n "$scanRunNamed" ] ; then
				case $'\n'"$scanBegan"$'\n' in *$'\n'"$scanRunNamed"$'\n'*) scanRuns=yes ;; esac
			fi
			if [ -z "$scanRuns" ] ; then
				## Only an open record is a run that should have started: a closed one with no process is a finished run.
				[ "$scanOpen" = yes ] || continue
				[ -n "$( find "$scanFile" -mmin +5 2> /dev/null )" ] || continue
				[ "$( LC_ALL=C sed -n 's/^agent-less: //p' "$scanFile" | head -1 )" = true ] || printf 'dead %s %s %s\n' "${scanWs##*/}" "${scanSpid:0:8}" "$scanMember"
				continue
			fi
			scanPaused=no
			## What a run held on a pause obeys: the flag the pause operation writes (AgentsTools.SessionPause.include), under the
			## run's own id or under its session's, the same two the park mark is looked for at.
			AgentsToolsSessionPauseHeld "$scanSpid" "${scanSid:-$scanSpid}" && scanPaused=yes
			## The run's own mark: `<round> <epoch> <word>`, written by the run as it works, never a file's date.
			scanMarkEpoch=0 ; scanMarkWord=""
			scanMark="$scanRunDir/activity"
			[ -f "$scanMark" ] || scanMark="$scanAgents/sessions/${scanSid:-$scanSpid}/activity"
			if [ -f "$scanMark" ] ; then
				read -r _ scanMarkEpoch scanMarkWord < "$scanMark" || :
				case "$scanMarkEpoch" in ''|*[!0123456789]*) scanMarkEpoch=0 ; scanMarkWord="" ;; esac
			fi
			scanAgeSec=""
			if [ "$scanMarkEpoch" != 0 ] ; then
				scanAgeSec=$(( scanNow - scanMarkEpoch ))
				[ "$scanAgeSec" -ge 0 ] || scanAgeSec=0
			fi
			case "$scanMarkWord" in
				tool\ *) scanTool="${scanMarkWord#tool }" ;;
				*) scanTool="" ;;
			esac
			## The mark names a tool only while the run is inside one. Between tools the transcript's last tool line names it,
			## and its stamp is the age for a run that left no mark at all: a native client writes none.
			if [ -z "$scanTool" ] || [ -z "$scanAgeSec" ] ; then
				scanLine=""
				if [ -f "$scanRunDir/transcript" ] ; then
					IFS= read -r scanBase < "$scanRunDir/transcript" || scanBase=""
					if [ -n "$scanBase" ] && [ -f "$scanBase" ] ; then
						## A transcript rolls at its size into `-part2`, `-part3` and on, so every part is read in order.
						scanParts=( "$scanBase" )
						while [ -f "${scanBase%.log}-part$(( ${#scanParts[@]} + 1 )).log" ] ; do
							scanParts+=( "${scanBase%.log}-part$(( ${#scanParts[@]} + 1 )).log" )
						done
						scanLine="$( LC_ALL=C awk '$2 == "TOOL" { at = $1 ; name = $3 } END { if (at != "") print at " " name }' "${scanParts[@]}" )" || scanLine=""
					fi
				fi
				scanStamp="${scanLine%% *}" ; scanName="${scanLine#* }"
				[ -n "$scanTool" ] || scanTool="$scanName"
				if [ -z "$scanAgeSec" ] && [ -n "$scanStamp" ] ; then
					scanEpoch="$( printf '%s\n' "$scanStamp" | LC_ALL=C awk -f "${MDLT_ORIGIN:-$MMDAPP/.local}/myx/myx.distro-.local/sh-lib/output/LocalIsoToEpoch.awk" 2> /dev/null )" || scanEpoch=""
					case "$scanEpoch" in ''|*[!0123456789]*) ;; *) scanAgeSec=$(( scanNow - scanEpoch )) ; [ "$scanAgeSec" -ge 0 ] || scanAgeSec=0 ;; esac
				fi
			fi
			scanLog="$scanAgents/sessions/$scanSpid/session.log"
			[ -f "$scanLog" ] || scanLog="$scanAgents/sessions/$scanSid/session.log"
			scanDir="${scanFile%/*}"
			## The three findings of before read a run whose record is open, as they always did.
			if [ "$scanOpen" = yes ] ; then
				## Idle after its handback: no tool but Wait since the last one, so a run that took new work is not idle.
				if LC_ALL=C grep -q '📦 SubagentHandback' "$scanLog" 2> /dev/null && ! cat "$scanDir"/*.checklist.md 2> /dev/null | LC_ALL=C grep -q '^- \[ \]' \
					&& awk '/📦 SubagentHandback/ { busy = 0 ; next } /^   [^ ]+ +[A-Za-z]/ && !/ Wait / && !/prompt cache/ { busy = 1 } END { exit busy }' "$scanLog" ; then
					printf 'idle-done %s %s %s\n' "${scanWs##*/}" "${scanSpid:0:8}" "$scanMember"
				elif [ ! -f "$scanDir/$scanMember.checklist.md" ] && [ -n "$( find "$scanFile" -mmin +10 2> /dev/null )" ] ; then
					printf 'no-plan %s %s %s\n' "${scanWs##*/}" "${scanSpid:0:8}" "$scanMember"
				## A run working for the last ten minutes whose own CheckList has not changed for an hour.
				elif [ -n "$( find "$scanDir/$scanMember.checklist.md" -mmin +60 2> /dev/null )" ] && [ -n "$( find "$scanLog" -mmin -10 2> /dev/null )" ] ; then
					printf 'stale-plan %s %s %s\n' "${scanWs##*/}" "${scanSpid:0:8}" "$scanMember"
				fi
			fi
			## Where the run stands (S13.18): its tool and its age, its latest message, its item in progress, its pause, its open asks.
			scanAsks=0
			if [ -n "$scanAskSet" ] ; then
				scanAsks="$( printf '%s' "$scanAskSet" | LC_ALL=C awk -v one="$scanSpid" -v two="$scanSid" '$0 == one || ( two != "" && $0 == two ) { n++ } END { print n + 0 }' )" || scanAsks=0
			fi
			scanMsg="none"
			if [ -f "$scanRunDir/session.chat" ] ; then
				## A chat holds every message in full, so its tail is read and never the file.
				scanMsg="$( tail -n 40 "$scanRunDir/session.chat" 2> /dev/null | LC_ALL=C awk '
					/^20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9:]+Z / { who = $2 ; text = $0 ; sub(/^.*-> [^ ]*: */, "", text) ; seen = 1 ; next }
					seen && text == "" && $0 != "" { text = $0 }
					END { if (seen) print who ": " text }
				' )" || scanMsg=""
			fi
			scanMsg="$( printf '%s' "${scanMsg:-none}" | cut -c1-140 )"
			scanPlan="none"
			if [ -f "$scanDir/$scanMember.checklist.md" ] ; then
				scanPlan="$( LC_ALL=C awk '/^- \[~\] / { sub(/^- \[~\] /, "") ; sub(/ \(in progress: .*/, "") ; print ; exit }' "$scanDir/$scanMember.checklist.md" 2> /dev/null )"
				scanPlan="${scanPlan:-none}"
			fi
			## The word the verdict reads: the mark's own where the run left one, else its transcript's last tool, since a native
			## client writes no mark and a Wait of its own would otherwise read as ten minutes of silence.
			scanWord="$scanMarkWord"
			if [ ! -f "$scanMark" ] && [ -n "$scanTool" ] ; then scanWord="tool $scanTool" ; fi
			## Waiting is where the run's own word holds it: a Wait, an ask it is inside, an idle wait, or a pause on its session.
			## An open ask is counted and never a verdict of its own, since a run works on with a question standing.
			## Stuck is the stall bound without a tool call and no other reading. A run that left no mark and no transcript
			## has shown no evidence either way, and is taken as starting, never as stuck.
			scanVerdict=active
			case "$scanWord" in
				"tool Wait"|"tool AskQuestion"|"tool ConfirmReadback"|"tool EscalateDecision"|"tool RequestPermission"|"tool ProposeApprove"|idle) scanVerdict=waiting ;;
			esac
			[ "$scanPaused" = no ] || scanVerdict=waiting
			[ "$scanVerdict" = waiting ] || [ -z "$scanAgeSec" ] || [ "$scanAgeSec" -lt "$scanStallSec" ] || scanVerdict=stuck
			scanAgeText="-"
			[ -z "$scanAgeSec" ] || scanAgeText="$(( scanAgeSec / 60 ))m"
			printf 'run %s %s %s %s tool=%s age=%s paused=%s asks=%s msg %s plan: %s\n' "${scanWs##*/}" \
				"${scanSpid:0:8}" "$scanMember" "$scanVerdict" "${scanTool:-none}" "$scanAgeText" \
				"$scanPaused" "$scanAsks" "$scanMsg" "$scanPlan"
			## A STALL: NOTHING IS COMING TO A RUN THAT STILL HAS WORK (S13.2). It is not working, it has been silent past the
			## bound, and its own list still holds items, so it is neither a run resting on a wait it asked for nor a run that
			## finished. A pause is the owner's own hold and never a stall, and a run with no list is never one either.
			[ "$scanVerdict" != waiting ] && [ "$scanVerdict" != stuck ] && continue
			[ "$scanPaused" = no ] || continue
			[ -n "$scanAgeSec" ] && [ "$scanAgeSec" -ge "$scanStallSec" ] || continue
			scanPending=0
			if [ -f "$scanDir/$scanMember.checklist.md" ] ; then
				scanPending="$( LC_ALL=C awk '/^- \[ \] / { n++ } END { print n + 0 }' "$scanDir/$scanMember.checklist.md" 2> /dev/null )" || scanPending=0
			fi
			[ "$scanPending" -gt 0 ] || continue
			printf 'stall %s %s %s age=%s pending=%s plan: %s\n' "${scanWs##*/}" "${scanSpid:0:8}" \
				"$scanMember" "$scanAgeText" "$scanPending" "$scanPlan"
		done <<< "$scanTable"
		## A CONTROL THREAD THAT SHOULD HAVE ENDED ITSELF (S5.6, item 6). It ends by itself when no run of its session has been alive
		## for SESSION_CONTROL_NO_RUN_END_SECONDS; one that has not ended has kept a process for hours. Read over the sessions of this
		## workspace, which is what a scan is for: a thread whose pid still lives, whose log has said nothing for that limit and five
		## minutes more, and whose session has no record left open at all, so nothing it watches can come back.
		scanNoRunMin=$(( ( ${SESSION_CONTROL_NO_RUN_END_SECONDS:-3600} + 300 ) / 60 ))
		for scanCtlFile in "$scanAgents"/sessions/*/control/pid ; do
			[ -f "$scanCtlFile" ] || continue
			scanCtlPid=""
			{ read -r scanCtlPid scanCtlRest < "$scanCtlFile" ; } 2> /dev/null || continue
			case "${scanCtlPid:-}" in ''|*[!0123456789]*) continue ;; esac
			scanCtlSid="${scanCtlFile%/control/pid}" ; scanCtlSid="${scanCtlSid##*/}"
			## Alive as the list of sessions reads it (AgentsToolsSessionControlLive): the pid the file names, begun when the file says.
			## A bare pid test took a later process that reused the number for a thread that died days before.
			type AgentsToolsSessionControlLive > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionControlStart.include" 2> /dev/null || continue
			[ -n "$( printf '%s\n' "$scanCtlSid" | MMDAPP="$scanWs" AgentsToolsSessionControlLive 2> /dev/null )" ] || continue
			[ -n "$( find "${scanCtlFile%/*}/log" -mmin +"$scanNoRunMin" 2> /dev/null )" ] || continue
			scanOpen=""
			## The session's own records come from the kept per-session list, never a grep over every record (call-path audit row 50).
			type AgentsToolsSpawnedSessionRecords > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.StartedRecords.include" 2> /dev/null || :
			for scanFile in $( MMDAPP="$scanWs" AgentsToolsSpawnedSessionRecords "$scanCtlSid" own 2> /dev/null ) ; do
				[ -f "$scanFile" ] || continue
				LC_ALL=C grep -q -x 'status: spawn-started' "$scanFile" 2> /dev/null || continue
				scanOpen="yes" ; break
			done
			[ -z "$scanOpen" ] || continue
			printf 'control-stuck %s %s %s pid=%s quiet-over=%sm no-record-open\n' "${scanWs##*/}" \
				"$( printf '%s' "$scanCtlSid" | cut -c1-8 )" "$scanCtlSid" "$scanCtlPid" "$scanNoRunMin"
		done
		## A TEST RIG LEFT RUNNING (S5.2): a control thread started inside a run's own output folder, alive after that run's record closed.
		while IFS= read -r scanCtlFile ; do
			[ -n "$scanCtlFile" ] || continue
			scanCtlPid=""
			{ read -r scanCtlPid scanCtlRest < "$scanCtlFile" ; } 2> /dev/null || continue
			case "${scanCtlPid:-}" in ''|*[!0123456789]*) continue ;; esac
			kill -0 "$scanCtlPid" 2> /dev/null || continue
			scanSpid="${scanCtlFile#"$scanAgents"/spawned/}" ; scanSpid="${scanSpid%%/*}"
			! LC_ALL=C grep -q -x 'status: spawn-started' "$scanAgents/spawned/$scanSpid/$scanSpid.spawn.md" 2> /dev/null || continue
			printf 'rig-orphan %s %s pid=%s %s\n' "${scanWs##*/}" "${scanSpid:0:8}" "$scanCtlPid" "${scanCtlFile#"$scanAgents"/spawned/"$scanSpid"/}"
		done <<< "$( AgentsToolsSuperviseRigPidFiles "$scanAgents" )"
	done
	## The calling supervisor's own CheckList, as a digest, so every supervisor loop reports it beside its findings:
	## `checklist <member> done=<n> in-progress=<n> open=<n>`, then one `checklist-doing` or `checklist-open` line an item.
	local scanOwnHome="${MDAT_CALLER_WORKSPACE:-$MMDAPP}" scanOwnList
	for scanOwnList in "${scanOwnHome%/}/.local/agents/sessions/${CLAUDE_CODE_SESSION_ID:-none}"/*.checklist.md "${scanOwnHome%/}/.local/agents/spawned/${MDAT_SPAWN_SESSION_ID:-none}"/*.checklist.md ; do
		[ -f "$scanOwnList" ] || continue
		LC_ALL=C awk -v who="$( basename "$scanOwnList" .checklist.md )" '
			/^- \[x\] / { done++ ; next ; }
			/^- \[~\] / { item = substr( $0, 7 ) ; sub( / \(in progress: .*\)$/, "", item ) ; doing[++doingN] = substr( item, 1, 140 ) ; next ; }
			/^- \[ \] / { open[++openN] = substr( $0, 7, 140 ) ; next ; }
			END {
				printf "checklist %s done=%d in-progress=%d open=%d\n", who, done, doingN, openN
				for ( i = 1 ; i <= doingN ; i++ ) printf "checklist-doing %s\n", doing[i]
				for ( i = 1 ; i <= openN ; i++ ) printf "checklist-open %s\n", open[i]
			}
		' "$scanOwnList"
		break
	done
	return 0
}
