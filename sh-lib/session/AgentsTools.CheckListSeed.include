#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

## AgentsTools.CheckListSeed.include: the executor's CheckList, seeded by the spawner before its first turn (S22 item 4). Definitions only.
## A source states its steps as `- ` items under its `## Formal task` heading, an epic states a feature's open work as its numbered items, a routine states its
## duties as its steps, and a spawn argument adds one item each. The seed adds pending items and nothing else: a line the list already holds is never closed,
## reworded or moved, and an item whose text the list holds is not added again.

## The `- ` items under the `## Formal task` heading of the text on standard input, one a line, in order. Any heading ends the section.
AgentsToolsCheckListSectionItems(){
	LC_ALL=C awk '
		$0 == "## Formal task" { inSection = 1 ; next ; }
		inSection && /^#+ / { exit ; }
		inSection && /^- / { itemText = substr( $0, 3 ) ; sub( /^\[ \] /, "", itemText ) ; sub( /[ \t\r]+$/, "", itemText ) ; if ( itemText != "" ) print itemText ; }
	'
}

## The open work of one feature of an epic file, one line an item, in order: the text of each numbered `N. <text>` line of
## its `## <feature> - <title>` section, which any heading ends. Nothing where the feature stands not once in that file.
AgentsToolsCheckListEpicFeatureItems(){ ## epic file, feature id
	[ -f "$1" ] || return 0
	[ "$( LC_ALL=C awk -v want="## $2 " 'index( $0, want ) == 1 { n++ } END { print n + 0 }' "$1" )" -eq 1 ] || return 0
	LC_ALL=C awk -v feat="$2" '
		index( $0, "## " feat " " ) == 1 { inFeature = 1 ; next }
		inFeature && /^#+/ { exit }
		inFeature && /^[0-9]+\. / {
			itemText = $0 ; sub( /^[0-9]+\. +/, "", itemText ) ; sub( /[ \t\r]+$/, "", itemText )
			if ( itemText != "" ) print itemText
		}
	' "$1"
}

## The items a dispatch's text gives the seed through an epic: the epic file that text names, and the single feature id it
## names after the word `feature`, as a builder's brief states it. No file, or no single feature, seeds nothing.
AgentsToolsCheckListEpicItems(){ ## the workspace the text may name the epic file under
	local epicText epicToken epicPath epicIds epicPlace epicRest
	epicText="$( cat )"
	epicToken="$( printf '%s\n' "$epicText" | LC_ALL=C awk 'match( $0, /[-A-Za-z0-9_.\/]+\.epic\.md/ ) { print substr( $0, RSTART, RLENGTH ) ; exit }' )"
	[ -n "$epicToken" ] || return 0
	epicPath=""
	case "$epicToken" in
		/*) [ ! -f "$epicToken" ] || epicPath="$epicToken" ;;
		*/*)
			epicPlace="${epicToken%%/*}" ; epicRest="${epicToken#*/}"
			type LocalToolsPlacesResolve > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/places/LocalTools.Places.include" 2> /dev/null || :
			epicPath="$( LocalToolsPlacesResolve "${MMDAPP%/}" "$epicPlace" 2> /dev/null )" || epicPath=""
			[ -z "$epicPath" ] || epicPath="$epicPath/$epicRest"
			[ -n "$epicPath" ] && [ -f "$epicPath" ] || epicPath="$1/$epicToken"
		;;
		*) epicPath="$1/$epicToken" ;;
	esac
	[ -n "$epicPath" ] && [ -f "$epicPath" ] || {
		echo "agent-spawn-proxy: ⚠️ WARNING: the epic file $epicToken this dispatch names is no file here, so its open work seeds nothing" >&2
		return 0
	}
	epicIds="$( printf '%s\n' "$epicText" | LC_ALL=C awk '
		{
			rest = tolower( $0 )
			while ( match( rest, /(^|[^a-z0-9_])feature +s[0-9]+(\.[0-9]+)?/ ) ) {
				epicId = substr( rest, RSTART, RLENGTH ) ; sub( /^.*feature +/, "", epicId )
				if ( ! seen[epicId]++ ) print toupper( epicId )
				rest = substr( rest, RSTART + RLENGTH )
			}
		}
	' )"
	if [ "$( printf '%s\n' "$epicIds" | LC_ALL=C awk 'NF { n++ } END { print n + 0 }' )" -ne 1 ] ; then
		[ -z "$epicIds" ] || echo "agent-spawn-proxy: ⚠️ WARNING: this dispatch names more than one epic feature, so its open work seeds nothing" >&2
		return 0
	fi
	[ "$( LC_ALL=C awk -v want="## $epicIds " 'index( $0, want ) == 1 { n++ } END { print n + 0 }' "$epicPath" )" -eq 1 ] || epicIds="${epicIds%.*}"
	AgentsToolsCheckListEpicFeatureItems "$epicPath" "$epicIds"
}

## The duties of a routine, from its text as the run reads it (AgentsToolsSpawnRoutineMixText) on standard input, one name a line, in reading order: the steps of its
## Opening steps, Steps and Closure steps. A step is a numbered `N. **name**` line, or the deepest heading of a group of headings. The mixed text puts a kind routine's
## sections under `# Opening steps of <file>` and a heading of the section's own name, which is no step. A run that joins a session (session id other than its own spawn id,
## the two arguments) lists only the steps whose text begins `All participants`.
## A NESTED CONTRIBUTOR LINE IS ONE MORE ITEM (S6.27 stage 6, design lines 198 to 209): a line under a step whose own word before
## its colon names a member (`  - magic-tester: confirm the check can fail`) is a contribution the step waits for, and it prints
## `awaited: <step> from <member>` after the step it belongs to. The member names come from the third argument, one a line, which
## the seeding site reads from the member registry: a nested line naming no member (`- rule:`, `- goal:`, `- all participants:`) is
## no contribution, and with no names given every nested line is left as the routine's own prose.
AgentsToolsCheckListRoutineSteps(){ ## session id, spawn id, the member names (a line each, may be empty)
	CHECKLIST_MEMBERS="${3:-}" LC_ALL=C awk -v sessionId="$1" -v spawnId="$2" '
		function level( headLine,   levelNo ) { levelNo = 0 ; while ( substr( headLine, levelNo + 1, 1 ) == "#" ) levelNo++ ; return levelNo ; }
		BEGIN { memberCount = split( ENVIRON["CHECKLIST_MEMBERS"], memberOne, "\n" ) ; for ( i = 1 ; i <= memberCount ; i++ ) { gsub( /^[ \t]+|[ \t]+$/, "", memberOne[i] ) ; if ( memberOne[i] != "" ) member[memberOne[i]] = 1 } }
		/^#+ / {
			headLevel = level( $0 ) ; headText = substr( $0, headLevel + 2 ) ;
			if ( headLevel == 1 ) {
				if ( pending != "" && ( sessionId == spawnId || pendingAll ) ) print pending ;
				pending = "" ; inSteps = ( headText ~ /^(Opening steps|Steps|Closure steps)( of .*)?$/ ) ; stepsName = headText ; sub( / of .*$/, "", stepsName ) ;
				stepName = "" ;
				next ;
			}
			if ( ! inSteps || headText == stepsName ) next ;
			if ( pending != "" && headLevel <= pendingLevel && ( sessionId == spawnId || pendingAll ) ) print pending ;
			pending = headText ; pendingLevel = headLevel ; pendingAll = 0 ; pendingBody = 0 ; stepName = headText ;
			next ;
		}
		inSteps && /^[0-9]+\. \*\*/ {
			pending = "" ; stepText = $0 ; sub( /^[0-9]+\. \*\*/, "", stepText ) ; sub( /\*\*.*$/, "", stepText ) ;
			stepName = stepText ;
			if ( stepText != "" && ( sessionId == spawnId || $0 ~ /^[0-9]+\. \*\*[^*]*\*\*:? *All participants/ ) ) print stepText ;
		}
		inSteps && stepName != "" && /^[ \t]+- / {
			contributor = $0 ; sub( /^[ \t]+- /, "", contributor ) ; sub( /[ \t]*:.*$/, "", contributor ) ;
			if ( ( contributor in member ) && ( sessionId == spawnId || pendingAll ) ) print "awaited: " stepName " from " contributor ;
		}
		inSteps && pending != "" && ! pendingBody && NF { pendingBody = 1 ; pendingAll = ( $0 ~ /^All participants/ ) ; }
		END { if ( pending != "" && ( sessionId == spawnId || pendingAll ) ) print pending ; }
	'
}

## Writes the items on standard input, a line each, as pending items of one member's list in one session, in the place the harness keeps it
## (AgentsHarnessCheckListPlace): beside the record of the session's own spawn, else in the session's store. Each item's source (S6.27) is kept
## with it: `step` for an item named in the third argument, a step of the routine in force, and `parent` for every other, since whoever asked
## for the spawn named it. An item the list already holds keeps the source it has. Prints how many it added.
AgentsToolsCheckListSeed(){ ## session id, member name, the routine's step names (a line each, may be empty)
	local seedFolder seedTemp seedLine seedAdded=0 seedSteps="${3:-}" seedFile="" seedAddedText=""
	type AgentsSessionRunRecordInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.include"
	AgentsSessionRunRecordInto seedFolder "$1" || :
	seedFolder="${seedFolder%/*}"
	[ -n "$seedFolder" ] || seedFolder="$MMDAPP/.local/agents/sessions/$1"
	seedFile="$seedFolder/$2.checklist.md"
	mkdir -p "$seedFolder" && seedTemp="$( mktemp "$seedFolder/$2.checklist.md.XXXXXX" )" || return 1
	[ ! -f "$seedFile" ] || cat "$seedFile" > "$seedTemp"
	[ -z "$( tail -c 1 "$seedTemp" )" ] || printf '\n' >> "$seedTemp"
	while IFS= read -r seedLine || [ -n "$seedLine" ] ; do
		[ -n "$seedLine" ] || continue
		! LC_ALL=C grep -q -F -e "] $seedLine" "$seedTemp" || continue
		printf -- '- [ ] %s\n' "$seedLine" >> "$seedTemp"
		seedAddedText="$seedAddedText$seedLine"$'\n'
		seedAdded=$(( seedAdded + 1 ))
	done
	if [ "$seedAdded" -gt 0 ] ; then
		mv -f "$seedTemp" "$seedFile" || { rm -f "$seedTemp" ; return 1 ; }
	else
		rm -f "$seedTemp"
	fi
	## The source of each item, marked from the list as it now stands: a step of the routine in force is `step`, and
	## every item of the brief, the epic and the arguments is `parent`, since whoever asked for the spawn gave them.
	type AgentsToolsCheckListSourcesMark > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.CheckListSources.include"
		AgentsToolsCheckListSourcesMark "$seedFile" "$seedSteps" "$seedAddedText" 2> /dev/null || :
	printf '%s\n' "$seedAdded"
}

## A member's CheckList of a run, into the named variable: the file the CheckList tool keeps it in (AgentsHarnessCheckListPlace).
## The list belongs to the run's session, the session-id of the run's record, else the run itself, and is kept in the folder of
## that session's own record, else in that session's store. A Wait probe that watched the run's own record folder instead missed
## the list of a run whose record names another session. rc 1 for a run or member that is no bare name. No process.
AgentsSessionChecklistFileInto(){ ## variable, run, member
	local listRecord="" listSession="" listLine listStore=""
	type AgentsSessionRunRecordInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.include"
	printf -v "$1" '%s' ""
	case "${2:-}:${3:-}" in :*|*:|*/*|-:*|*:-|.:*|..:*|*:.|*:..|*[[:space:]]*) return 1 ;; esac
	if AgentsSessionRunRecordInto listRecord "$2" ; then
		while IFS= read -r listLine ; do
			case "$listLine" in 'session-id: '*) listSession="${listLine#session-id: }" ; break ;; '# '*) break ;; esac
		done < "$listRecord"
	fi
	[ -n "$listSession" ] || listSession="$2"
	[ "$listSession" = "$2" ] || AgentsSessionRunRecordInto listRecord "$listSession" || :
	if [ -n "$listRecord" ] ; then
		printf -v "$1" '%s/%s.checklist.md' "${listRecord%/*}" "$3"
	else
		AgentsSessionStoreDirInto listStore "${MMDAPP:-}" || listStore="/nonexistent/.local/agents/sessions"
		printf -v "$1" '%s/%s/%s.checklist.md' "$listStore" "$listSession" "$3"
	fi
	return 0
}

## The open work on a run's own CheckList, into the named variable: each open or in-progress item, a line each, empty where
## none is open. The list is kept where the CheckList tool keeps it: the folder of the record of the run's session, else
## that session's store. The item that means the idle wait itself is no open work, and it is known by its text alone. Four
## forms are in use: the duty's own item, `wait for more: run --idle-wait`; a seeded routine step, kept as the bare
## `wait-for-more`; the operation in a run's own words, with a capital and no dashes ("Wait for more: idle-wait"); and
## "Wait for the next arrival", measured on two live duties. Taken for open work, that item turned every idle wait back, so
## the run never returned to its checkpoint. The list is found by AgentsSessionChecklistFileInto. No process: a Wait round asks it.
AgentsSessionChecklistOpenInto(){ ## variable, run, member
	local openList="" openLine openBusy=""
	printf -v "$1" '%s' ""
	AgentsSessionChecklistFileInto openList "${2:-}" "${3:-}" || return 0
	[ -f "$openList" ] || return 0
	while IFS= read -r openLine || [ -n "$openLine" ] ; do
		case "$openLine" in '- [ ] '*|'- [~] '*) ;; *) continue ;; esac
		case "$openLine" in *--idle-wait*|*[Ww]ait-for-more*|*[Ww]ait\ for\ more*|*[Ww]ait\ for\ the\ next\ arrival*) continue ;; esac
		openBusy="$openBusy$openLine"$'\n'
	done < "$openList"
	printf -v "$1" '%s' "${openBusy%$'\n'}"
	return 0
}

## A member's CheckList in a session, its lines as they stand: the list the CheckList tool keeps in the folder of the
## record of the session's founding run, else in the session's store. Nothing where the member kept none.
AgentsSessionChecklistText(){ ## session id, member
	local textFolder="" textFile textStore=""
	type AgentsSessionRunRecordInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.include"
	type AgentsSessionStoreDirInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.include"
	AgentsSessionRunRecordInto textFile "${1:-}" && textFolder="${textFile%/*}"
	AgentsSessionStoreDirInto textStore "${MMDAPP:-}" || textStore="/nonexistent/.local/agents/sessions"
	[ -n "$textFolder" ] || textFolder="$textStore/$1"
	[ -f "$textFolder/$2.checklist.md" ] || textFolder="$textStore/$1"
	[ -f "$textFolder/$2.checklist.md" ] || return 0
	cat "$textFolder/$2.checklist.md" 2> /dev/null || :
}

## The one member whose CheckList a session's folder keeps, into the named variable: rc 0 with the member set where exactly one
## is there, rc 1 with it empty where none is, rc 2 where several are. A one-folder glob is no walk and no process.
AgentsSessionSoleChecklistMemberInto(){ ## variable, workspace, session
	local soleFolder="" soleFile="" soleName="" soleCount=0
	type AgentsSessionFolderInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.include"
	printf -v "$1" '%s' ""
	AgentsSessionFolderInto soleFolder "${2:-}" "${3:-}" || return 1
	for soleFile in "$soleFolder"/*.checklist.md ; do
		[ -f "$soleFile" ] || continue
		soleCount=$(( soleCount + 1 ))
		soleName="${soleFile##*/}" ; soleName="${soleName%.checklist.md}"
	done
	case "$soleCount" in
		1) printf -v "$1" '%s' "$soleName" ; return 0 ;;
		0) return 1 ;;
		*) return 2 ;;
	esac
}
