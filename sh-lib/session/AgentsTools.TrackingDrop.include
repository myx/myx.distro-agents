#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.TrackingDrop.include -- what the tooling posted itself is no input to the member it concerns. The reads that decide whether something is
## input (the tags and the DMs the main loop looks at, the sources a Wait reads, AgentsTools.MemberWait.include, AgentsTools.DispatcherSchedule.include)
## pass a rendering of Slack through AgentsToolsTrackingDrop, which takes out the tracking posts by their own mark (`[tracking: <kind>]` and
## `[session: <spawn id>]`, from the metadata the tooling gives what it posts, AgentsSlackMessagesFormat.awk), and the hand-back of a run the member
## launched that reports to nobody else's duty. The tooling's own sends are marked `tracking: tooling` (AgentsTools.MemberCommsSlack.include) and
## dropped too -- but what is ADDRESSED to the member is never dropped: DISMISSED, and whatever the tooling sends a run, always reaches its Wait. Nothing here reads the words of a post, and nothing of it is in an agent's memory: the spawn record
## names who launched a run (`parent-member:`, the member whose call started it) and where it reports to (`reports-to:`, or the address it has by
## default, AgentsToolsRunRoute), so a duty that was rewound since it launched a session is told the same as one that was not.
## Sourced, never run. Functions only.
##

type AgentsToolsSpawnSandboxRecordHeader > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SpawnSandbox.include"

## A rendering on stdin for a member, its tooling's own posts taken out, on stdout.
## ONLY THE RUNS THE RENDERING NAMES ARE LOOKED UP: the `[session: <spawn id>]` marks in it, each one's own record read, never every
## record the member ever launched (251 on MDV: 261 s for one 9-line rendering, on every read of every Wait round).
AgentsToolsTrackingDrop(){ ## member
	local dropText="" dropId dropRecord dropRoute dropMember dropAway="" dropSeen=" "
	IFS= read -r -d '' dropText || :
	for dropId in $( printf '%s' "$dropText" | LC_ALL=C grep -o '\[session: [A-Za-z0-9-]*\]' | LC_ALL=C sed 's/^\[session: //;s/\]$//' ) ; do
		case "$dropSeen" in *" $dropId "*) continue ;; esac
		dropSeen="$dropSeen$dropId "
		for dropRecord in "${MMDAPP:-/nonexistent}"/.local/agents/spawned/*/"$dropId.spawn.md" ; do
			[ -f "$dropRecord" ] || continue
			[ "$( AgentsToolsSpawnSandboxRecordHeader "$dropRecord" parent-member 2> /dev/null )" = "$1" ] || continue
			dropRoute="$( AgentsToolsRunRoute "$dropRecord" 2> /dev/null )" || dropRoute=""
			dropMember="$( AgentsToolsRunRouteMember "$dropRoute" 2> /dev/null )" || dropMember=""
			[ "$dropMember" = "$1" ] || dropAway="$dropAway $dropId"
		done
	done
	printf '%s' "$dropText" | LC_ALL=C awk -v member="$1" -v away="${dropAway# }" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTrackingDrop.awk"
}
