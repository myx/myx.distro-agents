#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

AgentsOwnPostsHas(){ ## session
	[ -n "${1:-}" ] || return 1
	[ -f "${MMDAPP:-/nonexistent}/.local/agents/sessions/$1/last-own-post" ]
}
AgentsOwnPostsLast(){ ## session
	local lastLine=""
	AgentsOwnPostsHas "$1" || return 0
	IFS= read -r lastLine < "${MMDAPP:-/nonexistent}/.local/agents/sessions/$1/last-own-post" || :
	printf '%s' "$lastLine"
}
AgentsOwnPostsLines(){ ## session
	AgentsOwnPostsHas "$1" || return 0
	cat "${MMDAPP:-/nonexistent}/.local/agents/sessions/$1/last-own-post" 2> /dev/null
}
agentsOwnPostsLockTake(){ ## session -- sets agentsOwnPostsLock where the lock was taken
	agentsOwnPostsLock=""
	type AgentsToolsLocalLockTake > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/common/AgentsTools.LocalLock.include"
	! AgentsToolsLocalLockTake "own-posts-$1" 5 "the record of the run's own posts" 2> /dev/null || agentsOwnPostsLock="$agentsLocalLockPath"
}
AgentsOwnPostsAdd(){ ## session, line
	local addFile="${MMDAPP:-/nonexistent}/.local/agents/sessions/$1/last-own-post" addTmp
	mkdir -p "${addFile%/*}" 2> /dev/null || return 0
	agentsOwnPostsLockTake "$1"
	addTmp="$( mktemp "$addFile.XXXXXX" 2> /dev/null )" || addTmp=""
	if [ -n "$addTmp" ] ; then
		{ printf '%s\n' "$2" ; [ ! -f "$addFile" ] || cat "$addFile" ; } >| "$addTmp" 2> /dev/null \
			&& mv -f "$addTmp" "$addFile" 2> /dev/null || rm -f "$addTmp"
	fi
	type AgentsToolsLocalLockGive > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/common/AgentsTools.LocalLock.include"
	[ -z "$agentsOwnPostsLock" ] || AgentsToolsLocalLockGive "$agentsOwnPostsLock"
	return 0
}
AgentsOwnPostsReplace(){ ## session, a file of lines
	local replaceTmp
	[ -s "$2" ] && [ -f "${MMDAPP:-/nonexistent}/.local/agents/sessions/$1/last-own-post" ] || return 0
	agentsOwnPostsLockTake "$1"
	replaceTmp="$( mktemp "${MMDAPP:-/nonexistent}/.local/agents/sessions/$1/last-own-post.XXXXXX" 2> /dev/null )" || replaceTmp=""
	if [ -n "$replaceTmp" ] ; then
		LC_ALL=C awk -v advance="$2" '
			BEGIN {
				while ( ( getline line < advance ) > 0 ) {
					split(line, word, " ")
					replaced[word[1] " " word[2]] = line
				}
			}
			{
				split($0, word, " ")
				key = word[1] " " word[2]
				print ( key in replaced ? replaced[key] : $0 )
			}' "${MMDAPP:-/nonexistent}/.local/agents/sessions/$1/last-own-post" >| "$replaceTmp" 2> /dev/null \
			&& mv -f "$replaceTmp" "${MMDAPP:-/nonexistent}/.local/agents/sessions/$1/last-own-post" 2> /dev/null || rm -f "$replaceTmp"
	fi
	type AgentsToolsLocalLockGive > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/common/AgentsTools.LocalLock.include"
	[ -z "$agentsOwnPostsLock" ] || AgentsToolsLocalLockGive "$agentsOwnPostsLock"
	return 0
}
AgentsOwnPostsClear(){ ## session
	rm -f "${MMDAPP:-/nonexistent}/.local/agents/sessions/$1/last-own-post" 2> /dev/null || :
}
