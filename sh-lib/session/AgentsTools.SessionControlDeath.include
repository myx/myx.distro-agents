#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.SessionControlDeath.include -- the death of a run of a coworking session: what
## the control thread of the session keeps of it, how it is told and how it is asked about
## (--intern-session-control, AgentsTools.InternSessionControl.include). Sourced, never run.
## Functions only: the thread's own include is the arm of its operation and cannot be sourced
## for a function, and the advance pass asks one of these too.
##
## WHAT A DEATH IS is judged by the thread at its tick (AgentsToolsSessionControlDeaths, in
## its own include): the process of a run gone, its supervising shell gone, its record still
## open, and no word on the record that it was killed.
##
## WHAT IS KEPT OF IT, in control/ of the session's folder:
##   dead   a line a death, written by the tick alone, whole, by one rename:
##            <run id> member=<member> role=<executor|participant> found=<moment>
##          and after it the marks of what was done about it, each added once:
##            told=<moment>   it was told: the note of its death was posted, or the question,
##                            where the question is the message too. told=none: no note was
##                            due.
##            asked=<id>      the question about it was asked: the id of its pending-reply
##                            record. asked=none: no reviewer is set, so nothing is asked.
##            answer=<option> answered=<moment>   the answer to its question, as its record
##                            gave it; carried out, it settles the death, how=<option>.
##            not=<answer>,<moment>,<item put back in review, or ->,<why>   an answer that
##                            could not be carried out: the death stays unsettled and its
##                            reviewer is asked again, so `asked=` and `answer=` may stand
##                            more than once, each read as it stands last. How many `not=`
##                            a line keeps is how many tries failed.
##            settled=<moment> how=<word>   nothing more is done about it. how=told: it was
##                            told, nothing was to ask, and its record is closed.
##                            how=closed-elsewhere: another closer closed its record before
##                            it was told here, and told its end by its own rule.
##          A death is settled where its line says so. What becomes of an answer is written
##          on the same line, by the tasks that read it and carry it out.
##   gone   `<run id> <seconds since 1970>` a line: when the process of a run whose record
##          names no supervising shell was first seen gone. It outlives the thread.
##   post.<run id>          `<pid> <start>`: the one post about that death that is in flight.
##   post.<run id>.result   what that post left, `<key>: <value>` a line, for the next tick.
##   post.<run id>.sent     what the send of the question answered, kept from the moment it
##                          was posted until its record is written and its emoji are placed.
## AND ON THE RECORD of the dead run, so that no other closer and no thread started again
## says it a second time: `death-told: <moment>` once it was told, or once it was settled
## that no note is due, and `death-asked: <id>`, the pending-reply record of its question.
##
## ONE DEATH IS TOLD ONCE AND ASKED ONCE, AND ONE RULE SAYS WHO SPEAKS. While the thread of
## the session lives, a death it keeps and has not settled is its own: the advance pass
## neither closes nor tells that run (AgentsToolsSessionControlDeathHeld). With no thread
## alive that pass closes a dead run as before, and tells its end, but never the end of a run
## whose record carries `death-told`: the one function that tells an end says nothing of it
## (AgentsToolsSpawnProxyEndNotice, AgentsTools.SpawnSandbox.include). And the thread tells
## nothing of a run whose record another closer closed first.
##
## WHO IS TOLD AND WHO IS ASKED (AgentsToolsSessionControlDeathWork). The message is the note
## of an end, by the one function that tells every end, in the words of a death (`## run-died`
## of the note template): in the thread of the session that requested the run, or to the
## human-owner where no session did. The question is asked only where the dispatch item of
## the run names a reviewer (`review-by`): a decision as every decision is posted, as the
## team bot in the name of the dead member, with a pending-reply record of the kind decision
## that carries the id of the session, and its number emoji placed. Its words are blocks of
## the note template (`# Death`), never a text written here.
##

type AgentsToolsSpawnSandboxRecordHeader > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SpawnSandbox.include"
type AgentsToolsRegistrySpawnRecord > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.Registries.include"

## The outcome word a record is closed with here: the advance pass's own, for a run that
## ended and that no supervising shell closed (AgentsToolsAdvanceSpawnHousekeeping).
agentsSessionControlDeathOutcome="ended-without-close"

## The line of one run in control/dead of its session; rc 1 where it has none.
## The record of a question, open or closed (retention, T9): AgentsToolsPendingRecordPath, the one reader of both stores.
type AgentsToolsPendingRecordPath > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.Authority.include"

AgentsToolsSessionControlDeathLine(){ ## session id, run id
	local lineFile lineOne
	case "${1:-}" in ''|-|.|..|*/*) return 1 ;; esac
	lineFile="$MMDAPP/.local/agents/sessions/$1/control/dead"
	[ -n "${2:-}" ] && [ -f "$lineFile" ] || return 1
	{
		while IFS= read -r lineOne || [ -n "$lineOne" ] ; do
			case "$lineOne" in "$2 "*) printf '%s\n' "$lineOne" ; return 0 ;; esac
		done < "$lineFile"
	} 2> /dev/null
	return 1
}

## One mark of such a line, what stands after `<name>=`; rc 1 where the line has none. A line
## is a history: a mark that stands more than once, the question that was asked again after
## an answer could not be carried out, the answer to it, is read as it stands last.
AgentsToolsSessionControlDeathMark(){ ## line, name of the mark
	local markWords markWord markFound="" markAny=""
	read -r -a markWords <<< "${1:-}"
	for markWord in ${markWords[@]+"${markWords[@]}"} ; do
		case "$markWord" in "$2="*) markFound="${markWord#*=}" ; markAny="yes" ;; esac
	done
	[ -n "$markAny" ] || return 1
	printf '%s\n' "$markFound"
	return 0
}

## How many marks of one name a line keeps, a mark that says `none` not counted: how many
## questions were asked (`asked`), how many answers were taken (`answer`), how many of them
## could not be carried out (`not`). The three counts say where a death stands: as many
## questions as failed answers, a question is due; one question more and no answer more, its
## answer is awaited; one answer more, it is to be carried out.
AgentsToolsSessionControlDeathCount(){ ## line, name of the mark
	local countWords countWord countFound=0
	read -r -a countWords <<< "${1:-}"
	for countWord in ${countWords[@]+"${countWords[@]}"} ; do
		case "$countWord" in "$2=none") ;; "$2="*) countFound=$(( countFound + 1 )) ;; esac
	done
	printf '%s\n' "$countFound"
}

## WHO SPEAKS. rc 0: the control thread of that session lives, and keeps that run as a death
## it has not settled. Such a run is the thread's: it tells it and asks about it, and the
## advance pass leaves it as it is. rc 1 for every other run: one the thread does not keep,
## one whose death is settled, and any run of a session with no thread alive.
AgentsToolsSessionControlDeathHeld(){ ## session id, run id
	local heldLine
	heldLine="$( AgentsToolsSessionControlDeathLine "${1:-}" "${2:-}" )" || return 1
	case " $heldLine " in *" settled="*) return 1 ;; esac
	type AgentsToolsSessionControlLive > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionControlStart.include" 2> /dev/null || return 1
	[ -n "$( printf '%s\n' "$1" | AgentsToolsSessionControlLive 2> /dev/null )" ]
}

## One header kept on the record of a dead run, through the package's own header writer,
## aside and then one rename, as a launch keeps one (AgentsToolsSpawnProxyRunRecord). rc 1
## where it could not be kept: the record is then as it was.
AgentsToolsSessionControlDeathRecordMark(){ ## record file, header, value
	local markFile="$1" markOps markBody markAside
	[ -f "$markFile" ] || return 1
	mkdir -p "$MMDAPP/.local/temp" 2> /dev/null || return 1
	markOps="$( mktemp "$MMDAPP/.local/temp/mdat-session-death-ops.XXXXXX" 2> /dev/null )" || return 1
	printf 'upsert\t%s\t%s\n' "$2" "$3" > "$markOps" 2> /dev/null || { rm -f "$markOps" ; return 1 ; }
	markBody="$( LC_ALL=C awk -v opsFile="$markOps" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsBoardItemHeaderOpsApply.awk" < "$markFile" 2> /dev/null )" || markBody=""
	rm -f "$markOps"
	[ -n "$markBody" ] || return 1
	markAside="$( mktemp "$markFile.death.XXXXXX" 2> /dev/null )" || return 1
	{ cp -p "$markFile" "$markAside" && printf '%s\n' "$markBody" > "$markAside" && mv -f "$markAside" "$markFile" ; } 2> /dev/null \
		|| { rm -f "$markAside" ; return 1 ; }
	return 0
}

## The record of a dead run closed as ended without close, and the dispatch item it links
## with it, as the advance pass closes a dead run (AgentsToolsAdvanceSpawnHousekeeping): by
## the same two closers and under the same conditions, so the record and the item read as
## that pass would have left them, and no later closer finds an end to tell. rc 0: the record
## is closed so.
AgentsToolsSessionControlDeathClose(){ ## record file
	local closeRecord="$1" closeRun closeOutput closeField closeStem closeItem closeState closePath closeSpawn closeTarget
	[ -f "$closeRecord" ] || return 1
	closeRun="${closeRecord##*/}" ; closeRun="${closeRun%.spawn.md}"
	[ "$( AgentsToolsSpawnSandboxRecordHeader "$closeRecord" status )" = "spawn-started" ] || return 1
	AgentsToolsSpawnProxyCloseSandbox "$closeRecord" "$agentsSessionControlDeathOutcome" unknown
	[ "$( AgentsToolsSpawnSandboxRecordHeader "$closeRecord" status )" = "spawn-$agentsSessionControlDeathOutcome" ] || return 1
	[ -n "${MDAT_DATA_ROOT:-}" ] || return 0
	closeOutput="$( AgentsToolsSpawnSandboxRecordHeader "$closeRecord" output-file )"
	[ -n "$closeOutput" ] || closeOutput="-"
	for closeField in spawns spawned-by ; do
		closeStem="$( AgentsToolsSpawnSandboxRecordHeader "$closeRecord" "$closeField" )"
		[ -n "$closeStem" ] || continue
		closeItem="${closeStem%.md}.md"
		closeState="$( AgentsToolsSpawnProxyBoardStateOf "$closeItem" )"
		[ -n "$closeState" ] || continue
		closePath="$MDAT_DATA_ROOT/board/$closeState/$closeItem"
		[ "$( AgentsToolsSpawnSandboxRecordHeader "$closePath" status )" = dispatch-started ] || continue
		## An item that names a newer spawn belongs to that one, not to this dead record.
		closeSpawn="$( AgentsToolsSpawnSandboxRecordHeader "$closePath" spawn-id )"
		[ -z "$closeSpawn" ] || [ "$closeSpawn" = "-" ] || [ "$closeSpawn" = "$closeRun" ] || continue
		closeTarget="$closeState"
		[ "$closeField" != spawns ] || [ "$closeState" != running ] || closeTarget=review
		AgentsToolsSpawnProxyCloseDispatch "$closeItem" "" unknown "$closeOutput" "$agentsSessionControlDeathOutcome" "$closeState" "$closeTarget" > /dev/null 2>&1 || :
	done
	return 0
}

## One block of the note template filled (sh-lib/templates/tooling-note.post.format.md,
## `# Death`). The slots travel in the caller's environment, as ASKP_F_<slot>.
AgentsToolsSessionControlDeathText(){ ## heading under `# Death`
	type AgentsToolsAskPostFill > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.AskPost.include"
	ASKP_BLOCK="Death/$1" AgentsToolsAskPostFill block tooling-note.post.format.md "" 2> /dev/null
}

## Whether a word is one of the answers the question about a death offers: the first word of
## a line of its `options` block, which is where those words stand. rc 0 it is.
AgentsToolsSessionControlDeathOption(){ ## word
	local optionLine
	[ -n "${1:-}" ] || return 1
	while IFS= read -r optionLine ; do
		[ "${optionLine%%:*}" != "$1" ] || return 0
	done <<< "$( AgentsToolsSessionControlDeathText options )"
	return 1
}

## WHETHER A QUESTION ABOUT A DEATH STANDS OPEN IN A SESSION, for the review wait limit
## (AgentsReviewWaitLeft, AgentsTools.ReviewFlow.include): while one does, no run of that
## session that waits for its review is dismissed by the limit, whoever the question was put
## to and whichever run died. Prints `open` where a line of control/dead names a question
## whose pending-reply record is still open. Else, where it names questions that are closed,
## the moment the last of them was closed, as seconds since 1970 (`resolved-epoch` of the
## record): the limit counts from there. Nothing where it names none: a death that is not
## asked yet holds nothing, and neither does a question of another session.
AgentsToolsSessionControlDeathQuestion(){ ## session id
	local questionFile questionLine questionWords questionWord questionId questionRecord questionAt questionLast=""
	case "${1:-}" in ''|-|.|..|*/*) return 0 ;; esac
	questionFile="$MMDAPP/.local/agents/sessions/$1/control/dead"
	[ -f "$questionFile" ] || return 0
	while IFS= read -r questionLine || [ -n "$questionLine" ] ; do
		## Every question the line names: one that was asked again stands beside the one before it.
		read -r -a questionWords <<< "$questionLine"
		for questionWord in ${questionWords[@]+"${questionWords[@]}"} ; do
			case "$questionWord" in asked=*) questionId="${questionWord#asked=}" ;; *) continue ;; esac
			case "$questionId" in ''|none|*/*|.|..) continue ;; esac
			questionRecord="$( AgentsToolsPendingRecordPath "$questionId" || printf '%s' "$MMDAPP/.local/agents/pending/$questionId.md" )"
			[ -f "$questionRecord" ] || continue
			if [ "$( AgentsToolsSpawnSandboxRecordHeader "$questionRecord" status )" = "reply-pending" ] ; then
				printf 'open\n'
				return 0
			fi
			questionAt="$( AgentsToolsSpawnSandboxRecordHeader "$questionRecord" resolved-epoch )"
			case "$questionAt" in ''|*[!0123456789]*|????????????*) continue ;; esac
			[ -n "$questionLast" ] && [ "$questionLast" -ge "$questionAt" ] || questionLast="$questionAt"
		done
	done < "$questionFile" 2> /dev/null
	[ -z "$questionLast" ] || printf '%s\n' "$questionLast"
	return 0
}

## THE QUESTION ABOUT A DEAD RUN, asked as the review prompt of a handback is asked
## (AgentsReviewPromptPost, AgentsTools.ReviewFlow.include), with no agent: one post, as the
## team bot in the name of the dead member, addressed to who is asked; its pending-reply
## record, of the kind decision, which carries the id of the session, so the session reads
## `waiting` while it is open and its answer is read where every typed answer is; and its
## number emoji under it. The post is the template of a decision, filled as the tool of that
## kind fills it (AgentsTools.AskPost.include). What it asks, its four options and its
## context are blocks of the note template: `question`, with `executor` or `participant`,
## `options` and `context`. Prints `asked <pending id>`, rc 0; else `failed <why>`, rc 1.
## ASKED ONCE, WHATEVER ENDS THIS CALL HALF WAY. Each step leaves what the next try finds, so
## a try that follows one that was ended at its bound, or that failed after the post, posts
## nothing again: the record of the question carries the run in its `question-key`,
## `death:<run id>`, and a record that carries it, open or closed, is the question of that
## death; and what the send answered is kept in control/post.<run id>.sent the moment the
## post is made, so a post whose record could not be written yet gets its record, and no
## second post. Only the emoji are placed again, which Slack takes as placed.
## ASKED AGAIN, after an answer that could not be carried out: the same call with the number
## of the question, 2 for the second, and it is a question of its own, with a key of its own,
## `death:<run id>:<number>`. What it asks is the block `question-again`: which answer was
## not carried out and why, the item where that was put back in review, and, where the same
## answer has failed three times or more in a row for the same reason, that, in its first
## line. Its options and its context are those of the first question.
AgentsToolsSessionControlDeathAsk(){ ## session id, record file, where it is asked (a thread `<channel>:<ts>`, or human-owner), whom it is asked, the item of the run (may be empty); then, for a question asked again: its number, the answer that was not carried out, why, how many times in a row where that is three or more (else empty), the item that was put back in review (may be empty)
	local askSession="$1" askRecord="$2" askWhere="$3" askWhom="$4" askItem="${5:-}" askTry="${6:-1}" askFailed="${7:-}" askWhy="${8:-}" askRepeat="${9:-}" askBack="${10:-}" askKey
	local askRun askMember askRole askName askShort="" askQuestion askOptions askContext askBody askOut askChannel askTs askThread askAddressees askAsking askId askSent askFound
	type AgentsToolsAskPostReact > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.AskPost.include"
	askRun="${askRecord##*/}" ; askRun="${askRun%.spawn.md}"
	askMember="$( AgentsToolsSpawnSandboxRecordHeader "$askRecord" owner )"
	[ -n "$askMember" ] || { printf 'failed %s\n' "its record names no member" ; return 1 ; }
	AgentsToolsAskKindRow decision || { printf 'failed %s\n' "the table of the asks names no decision" ; return 1 ; }
	## The founder of a session is its executor: its own id is the id of the session.
	askRole="participant" ; [ "$askRun" != "$askSession" ] || askRole="executor"
	askRole="$( AgentsToolsSessionControlDeathText "$askRole" )" || askRole=""
	## The session by the name its spawn gave it, else by its short id.
	askName="$( AgentsToolsSpawnSandboxRecordHeader "$askRecord" session-comment )"
	[ -n "$askName" ] || askShort="${askSession:0:8}"
	askKey="death:$askRun"
	case "$askTry" in
		''|1|*[!0123456789]*)
			askQuestion="$( ASKP_F_member="$askMember" ASKP_F_role="$askRole" ASKP_F_session="$askName" ASKP_F_session_id="$askShort" ASKP_F_run="${askRun:0:8}" AgentsToolsSessionControlDeathText question )" || askQuestion=""
		;;
		*)
			askKey="death:$askRun:$askTry"
			askQuestion="$( ASKP_F_member="$askMember" ASKP_F_run="${askRun:0:8}" ASKP_F_option="$askFailed" ASKP_F_reason="$askWhy" ASKP_F_count="$askRepeat" ASKP_F_item="$askBack" AgentsToolsSessionControlDeathText question-again )" || askQuestion=""
		;;
	esac
	askOptions="$( AgentsToolsSessionControlDeathText options )" || askOptions=""
	askContext="$( ASKP_F_item="$askItem" AgentsToolsSessionControlDeathText context )" || askContext=""
	askSent="$MMDAPP/.local/agents/sessions/$askSession/control/post.$askRun.sent"
	## The question of this death is recorded already: nothing is posted, its emoji are placed again.
	askFound="$( LC_ALL=C grep -r -l -x -F --include='*.md' -- "question-key: $askKey" "$MMDAPP/.local/agents/pending" 2> /dev/null | LC_ALL=C sed -n '1p' )" || askFound=""
	if [ -n "$askFound" ] ; then
		askId="${askFound##*/}" ; askId="${askId%.md}"
		askChannel="$( AgentsToolsAskPostField "$askFound" channel )" ; askTs="$( AgentsToolsAskPostField "$askFound" question-ts )"
		[ -z "$askChannel" ] || [ -z "$askTs" ] || [ -z "$askOptions" ] || [ "$( AgentsToolsAskPostField "$askFound" status )" != "reply-pending" ] \
			|| AgentsToolsAskPostReact "$askMember" "$askChannel:$askTs" bot add $( ASKP_OPTIONS="$askOptions" AgentsToolsAskPostFill reactions "$agentsAskRowTemplate" "$agentsAskRowForm" 2> /dev/null )
		rm -f "$askSent" 2> /dev/null
		printf 'asked %s\n' "$askId"
		return 0
	fi
	askBody=""
	[ -z "$askQuestion" ] || [ -z "$askOptions" ] || askBody="$( ASKP_OPTIONS="$askOptions" ASKP_F_question="$askQuestion" ASKP_F_context="$askContext" AgentsToolsAskPostFill post "$agentsAskRowTemplate" "$agentsAskRowForm" 2> /dev/null )" || askBody=""
	[ -n "$askBody" ] || { printf 'failed %s\n' "the question could not be filled from its templates" ; return 1 ; }
	if [ -s "$askSent" ] ; then
		## It was posted by an earlier try, which did not come to record it: what the send answered then.
		askOut="$( cat "$askSent" 2> /dev/null )" || askOut=""
	else
		askOut="$( printf '%s\n' "$askBody" | DistroAgentsTools --intern-op-comms-slack-send-message "$askMember" "$askWhere" --identity-bot --address-to "$askWhom" --from-stdin 2>&1 )" || {
			printf 'failed %s\n' "the question could not be posted to $askWhere: $( printf '%s\n' "$askOut" | LC_ALL=C grep -m1 'ERROR' | LC_ALL=C tr -s '\t ' ' ' | LC_ALL=C cut -c1-300 )"
			return 1
		}
		## Kept at once, before anything else is done with it.
		{ printf '%s\n' "$askOut" > "$askSent" ; } 2> /dev/null || :
	fi
	askChannel="$( printf '%s\n' "$askOut" | LC_ALL=C sed -n 's/^SENT_MESSAGE_CHANNEL=//p' | head -1 )"
	askTs="$( printf '%s\n' "$askOut" | LC_ALL=C sed -n 's/^SENT_MESSAGE_TS=//p' | head -1 )"
	askThread="$( printf '%s\n' "$askOut" | LC_ALL=C sed -n 's/^SENT_MESSAGE_THREAD_TS=//p' | head -1 )"
	[ -n "$askThread" ] || askThread="$askTs"
	## A member with no account of its own answers under the team's account: its name stands
	## among the accounts that answer, as the tools that ask keep it (AgentsHarnessAsk).
	askAddressees="$( printf '%s\n' "$askOut" | LC_ALL=C sed -n 's/^SENT_MESSAGE_ADDRESSEES=//p' | head -1 ) $( printf '%s\n' "$askOut" | LC_ALL=C sed -n 's/^SENT_MESSAGE_ADDRESSEE_MEMBERS=//p' | head -1 )"
	askAddressees="${askAddressees# }" ; askAddressees="${askAddressees% }"
	askAsking="$( printf '%s\n' "$askOut" | LC_ALL=C grep '^{' | LC_ALL=C awk -v path=message.user -v optional=1 -v dialect=slack -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsHarnessJsonField.awk" 2> /dev/null | LC_ALL=C sort -u | LC_ALL=C tr '\n' ' ' )" || askAsking=""
	if [ -z "$askChannel" ] || [ -z "$askTs" ] || [ -z "$askAddressees" ] ; then
		printf 'failed %s\n' "the question was posted, but its thread or its addressee could not be named, so its answer could not be read"
		return 1
	fi
	## What the post was filled with is kept beside its record, so it is filled again once it takes no answer.
	askId="$( printf '%s\n' "$askBody" | DistroAgentsTools --intern-op-pending-reply-open "$askMember" --to "$askWhere" --session-id "$askSession" \
		--kind decision --address-to "$askWhom" --blocked-on "reply from $askWhom" --channel "$askChannel" --question-ts "$askTs" --thread-ts "$askThread" \
		--addressees "$askAddressees" ${askAsking:+--asking-accounts " $askAsking"} ${askItem:+--item "$askItem"} --options "$askOptions" --ask-identity bot --question-key "$askKey" \
		--fields "$( AgentsToolsAskPostFieldsPack asked-as "$agentsAskRowName" question "$askQuestion" context "$askContext" )" --context "${MDSC_CMD:-session-control}" 2> /dev/null )" || askId=""
	[ -n "$askId" ] || { printf 'failed %s\n' "the question was posted at $askChannel:$askTs but could not be recorded, so its answer could not be read" ; return 1 ; }
	## Its click answers, the names its template gives, placed as the identity that posted it.
	AgentsToolsAskPostReact "$askMember" "$askChannel:$askTs" bot add $( ASKP_OPTIONS="$askOptions" AgentsToolsAskPostFill reactions "$agentsAskRowTemplate" "$agentsAskRowForm" 2> /dev/null )
	rm -f "$askSent" 2> /dev/null
	printf 'asked %s\n' "$askId"
	return 0
}

## WHAT IS TOLD AND ASKED ABOUT ONE DEATH, in order, each step once: a step that the line of
## the death or the record of the run says is done is not made again. It leaves what it did
## in its result file, a line a step, for the next tick of the thread to keep on the line of
## the death: `told: <moment>|none|failed`, `asked: <id>|none|failed`, `closed: yes|elsewhere`,
## `error: <why>`.
## THE MESSAGE: the note of the end of the run, in the words of a death, by the one function
## that tells an end (AgentsToolsSpawnProxyEndNotice): where it goes and to whom is that
## function's rule, and so is that a run whose handback stands there gets none. No note is
## posted where the question stands in that very thread, and is the message too; nor where
## the question goes to a person while no member of the session that requested the run runs.
## THE QUESTION, only where the run works an item, and of where it reports to
## (AgentsToolsRunRoute), which decides what follows a death. To its member, in the thread of
## the session it reports to, where the run that brought it in still runs there. To the
## human-owner, in the bot's direct conversation, where it reports to a person or a member, or
## to a session that has ended or cannot be measured.
## NO ITEM: the death is settled with the message, and the record of the run is closed as
## ended without close, so that no later closer finds an end to tell.
## Whoever closed the record before this was reached told its end: nothing is posted then.
## ONCE IT IS ASKED the same call does what is due next, one thing a call: while the record
## of the question is open, the thread of the question is read (AgentsToolsSessionControlDeathRead);
## once the line of the death holds the answer, it is carried out
## (AgentsToolsSessionControlDeathAct).
AgentsToolsSessionControlDeathWork(){ ## session id, run id, the file its result goes to
	local workSession="$1" workRun="$2" workResult="$3"
	local workRecord workLine workTold workAsked workField workItem="" workState workReviewer="" workParent workThread workWhere="" workWhom="" workLives="" workSaid workOut workStamp
	## The team data and the members, as every operation of the tooling finds them.
	. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsContext.UseAgentsTools.include"
	set +e +u
	workStamp="$( date -u +%Y-%m-%dT%H:%M:%SZ )"
	workRecord="$( AgentsToolsRegistrySpawnRecord "$workRun" )"
	if [ -z "$workRecord" ] ; then
		printf 'error: %s\n' "no record of run $workRun is found" >> "$workResult"
		return 0
	fi
	workLine="$( AgentsToolsSessionControlDeathLine "$workSession" "$workRun" )" || workLine=""
	workTold="$( AgentsToolsSessionControlDeathMark "$workLine" told )" || workTold="$( AgentsToolsSpawnSandboxRecordHeader "$workRecord" death-told )"
	workAsked="$( AgentsToolsSessionControlDeathMark "$workLine" asked )" || workAsked="$( AgentsToolsSpawnSandboxRecordHeader "$workRecord" death-asked )"
	## Where the death stands, by what its line counts: an answer more than failed answers is
	## carried out; as many questions as failed answers, the reviewer is asked again.
	local workTries
	workTries="$( AgentsToolsSessionControlDeathCount "$workLine" not )"
	if [ "$( AgentsToolsSessionControlDeathCount "$workLine" answer )" -gt "$workTries" ] ; then
		AgentsToolsSessionControlDeathAct "$workSession" "$workRecord" "$workLine" "$workResult"
		return 0
	fi
	case "$workAsked" in
		''|none|*/*|.|..) ;;
		*)
			if [ "$( AgentsToolsSessionControlDeathCount "$workLine" asked )" -le "$workTries" ] ; then
				AgentsToolsSessionControlDeathAgain "$workSession" "$workRecord" "$workLine" "$( AgentsToolsPendingRecordPath "$workAsked" || printf '%s' "$MMDAPP/.local/agents/pending/$workAsked.md" )" "$workResult"
				return 0
			fi
			if [ "$( AgentsToolsSpawnSandboxRecordHeader "$( AgentsToolsPendingRecordPath "$workAsked" || printf '%s' "$MMDAPP/.local/agents/pending/$workAsked.md" )" status )" = "reply-pending" ] ; then
				AgentsToolsSessionControlDeathRead "$workAsked" "$workResult"
				return 0
			fi
		;;
	esac
	if [ "$( AgentsToolsSpawnSandboxRecordHeader "$workRecord" status )" != "spawn-started" ] ; then
		printf 'closed: elsewhere\n' >> "$workResult"
		return 0
	fi
	## The item of the run, and where the run reports to (AgentsToolsRunRoute), which decides what
	## follows a death: the question is asked only where the run works an item.
	for workField in spawns spawned-by ; do
		workItem="$( AgentsToolsSpawnSandboxRecordHeader "$workRecord" "$workField" )"
		workItem="${workItem%%,*}" ; workItem="${workItem%% *}" ; workItem="${workItem%.md}"
		workState=""
		[ -z "$workItem" ] || [ -z "${MDAT_DATA_ROOT:-}" ] || workState="$( AgentsToolsSpawnProxyBoardStateOf "$workItem.md" )"
		[ -n "$workState" ] || { workItem="" ; continue ; }
		break
	done
	local workRoute
	workRoute="$( AgentsToolsRunRoute "$workRecord" )"
	[ -z "$workItem" ] || workReviewer="$workRoute"
	## Whether the member that brought the run in still runs in the session that requested it.
	workParent="$( AgentsToolsSpawnSandboxRecordHeader "$workRecord" parent-spawn-id )"
	case "$workParent" in ''|none|*/*|.|..) workParent="" ;; esac
	workThread=""
	if [ "$( AgentsToolsRunRouteKind "$workRoute" )" = session ] ; then
		workThread="$( MDAT_SPAWN_SESSION_ID="$workRun" ; AgentsToolsSessionParentThreadFind 2> /dev/null )" || workThread=""
		workThread="${workThread%% *}"
	fi
	AgentsToolsSpawnConversationThreadValid "$workThread" || workThread=""
	[ -z "$workParent" ] || ! AgentsToolsRegistrySpawnRuns "$workParent" "" || workLives="yes"
	## Where the question goes, and to whom: in the thread of the session it reports to, to its
	## member, where that member still runs there; else the human-owner, for a person, for a member
	## (whose own conversation the bot cannot read an answer in), and for a session that has ended.
	if [ -n "$workReviewer" ] ; then
		workWhere="human-owner" ; workWhom="human-owner"
		if [ -n "$workLives" ] && [ -n "$workThread" ] ; then
			workWhom="$( AgentsToolsRunRouteMember "$workRoute" 2> /dev/null )" || workWhom=""
			if [ -n "$workWhom" ] ; then workWhere="$workThread" ; else workWhom="human-owner" ; fi
		fi
	fi
	## 1. The message.
	if [ -z "$workTold" ] ; then
		if [ -n "$workWhere" ] && [ "$workWhere" != "human-owner" ] ; then
			## The question stands in that thread, and is the message too.
			:
		elif [ -n "$workWhere" ] && [ -z "$workLives" ] ; then
			workTold="none"
		else
			workSaid="$( AgentsToolsSpawnProxyEndNotice "$workRecord" died > /dev/null ; printf '%s' "${agentsSpawnProxyEndNoticeSaid:-failed}" )" || workSaid="failed"
			case "$workSaid" in
				## Kept at once: a try that is ended after this posts no second note.
				posted) workTold="$workStamp" ; printf 'told: %s\n' "$workTold" >> "$workResult" ;;
				none) workTold="none" ;;
				*)
					printf 'told: failed\nerror: %s\n' "the note that the run died could not be posted" >> "$workResult"
					return 0
				;;
			esac
		fi
		[ -z "$workTold" ] || AgentsToolsSessionControlDeathRecordMark "$workRecord" death-told "$workStamp" || :
	fi
	[ -z "$workTold" ] || printf 'told: %s\n' "$workTold" >> "$workResult"
	## 2. The question.
	if [ -n "$workWhere" ] ; then
		if [ -z "$workAsked" ] ; then
			workOut="$( AgentsToolsSessionControlDeathAsk "$workSession" "$workRecord" "$workWhere" "$workWhom" "$workItem" )" || {
				workOut="$( printf '%s\n' "$workOut" | LC_ALL=C grep -m1 '^failed ' )"
				printf 'asked: failed\nerror: %s\n' "${workOut#failed }" >> "$workResult"
				return 0
			}
			workAsked="$( printf '%s\n' "$workOut" | LC_ALL=C sed -n 's/^asked //p' | tail -1 )"
			[ -n "$workAsked" ] || { printf 'asked: failed\nerror: %s\n' "the question left no id" >> "$workResult" ; return 0 ; }
			AgentsToolsSessionControlDeathRecordMark "$workRecord" death-asked "$workAsked" || :
			if [ -z "$workTold" ] ; then
				AgentsToolsSessionControlDeathRecordMark "$workRecord" death-told "$workStamp" || :
				printf 'told: %s\n' "$workStamp" >> "$workResult"
			fi
		fi
		printf 'asked: %s\n' "$workAsked" >> "$workResult"
		return 0
	fi
	## 3. No reviewer: settled with the message.
	printf 'asked: none\n' >> "$workResult"
	if AgentsToolsSessionControlDeathClose "$workRecord" ; then
		printf 'closed: yes\n' >> "$workResult"
	else
		printf 'error: %s\n' "its record could not be closed as $agentsSessionControlDeathOutcome" >> "$workResult"
	fi
	return 0
}

## AN ANSWER THAT COULD NOT BE CARRIED OUT LEAVES THE DEATH WITH ITS REVIEWER. The line of the
## death keeps each such answer, `not=<answer>,<moment>,<item put back, or ->,<why>`, in
## order, and for each of them the same reviewer is asked again, once: where the question
## before was asked and whom, read from its record. The tooling tries no answer a second
## time by itself: only a new answer starts a new try. The last failed answer and its reason
## are what the new question tells; where the last three or more are the same answer for the
## same reason, it says so first, and still asks.
AgentsToolsSessionControlDeathAgain(){ ## session id, record file, the line of the death, the record of the question before, the file its result goes to
	local againSession="$1" againRecord="$2" againLine="$3" againBefore="$4" againResult="$5"
	local againWhere againWhom againItem againWords againWord againRest againTries=0 againSame=0 againLast="" againOption="" againBack="" againReason="" againOut againId
	againWhere="$( AgentsToolsSpawnSandboxRecordHeader "$againBefore" communication-channel-id )" ; againWhere="${againWhere#slack:}"
	againWhom="$( AgentsToolsSpawnSandboxRecordHeader "$againBefore" address-to )"
	againItem="$( AgentsToolsSpawnSandboxRecordHeader "$againBefore" item )"
	if [ -z "$againWhere" ] || [ -z "$againWhom" ] ; then
		againWhere="human-owner" ; againWhom="human-owner"
	fi
	read -r -a againWords <<< "$againLine"
	for againWord in ${againWords[@]+"${againWords[@]}"} ; do
		case "$againWord" in not=*) againWord="${againWord#not=}" ;; *) continue ;; esac
		againTries=$(( againTries + 1 ))
		againOption="${againWord%%,*}" ; againRest="${againWord#*,}" ; againRest="${againRest#*,}"
		againBack="${againRest%%,*}" ; againReason="${againRest#*,}"
		if [ "$againOption|$againReason" = "$againLast" ] ; then againSame=$(( againSame + 1 )) ; else againSame=1 ; againLast="$againOption|$againReason" ; fi
	done
	[ "$againSame" -ge 3 ] || againSame=""
	[ "$againBack" != "-" ] || againBack=""
	againOut="$( AgentsToolsSessionControlDeathAsk "$againSession" "$againRecord" "$againWhere" "$againWhom" "$againItem" "$(( againTries + 1 ))" "$againOption" "${againReason//_/ }" "$againSame" "$againBack" )" || {
		againOut="$( printf '%s\n' "$againOut" | LC_ALL=C grep -m1 '^failed ' )"
		printf 'asked: failed\nerror: %s\n' "${againOut#failed }" >> "$againResult"
		return 0
	}
	againId="$( printf '%s\n' "$againOut" | LC_ALL=C sed -n 's/^asked //p' | tail -1 )"
	[ -n "$againId" ] || { printf 'asked: failed\nerror: %s\n' "the question left no id" >> "$againResult" ; return 0 ; }
	AgentsToolsSessionControlDeathRecordMark "$againRecord" death-asked "$againId" || :
	printf 'asked: %s\n' "$againId" >> "$againResult"
	return 0
}

## THE ANSWER IS READ where every typed answer is read and applied, and by nothing else:
## `--intern-op-escalation-read`, in the name of the member the question was asked for. For a
## decision that read takes a reply of the one who was asked, by the number of an option or
## by its first word, or a person's click on its number; closes the record with the option
## taken; and says so in the thread of the question. Nothing of that read is changed here.
## What it left is read from the record, a file, by the next tick of the thread.
AgentsToolsSessionControlDeathRead(){ ## pending id, the file its result goes to
	local readOwner
	readOwner="$( AgentsToolsSpawnSandboxRecordHeader "$( AgentsToolsPendingRecordPath "$1" || printf '%s' "$MMDAPP/.local/agents/pending/$1.md" )" owner )"
	[ -z "$readOwner" ] || ( DistroAgentsTools --intern-op-escalation-read "$readOwner" "$1" ) > /dev/null 2>&1 || :
	printf 'read: done\n' >> "$2"
	return 0
}

## One line of the note template about what became of an answer (`# Session`), posted by the
## one poster of a note of a session, in a shell of its own: in the thread given, in the name
## of the dead member, addressed to whom it is told.
AgentsToolsSessionControlDeathSay(){ ## thread, member, whom it is told, line, run, who answered, option, reason (may be empty), item (may be empty)
	( AgentsToolsSpawnProxySessionNotice "$1" "$2" "$3" "$4" "" "$5" by "$6" option "$7" reason "${8:-}" item "${9:-}" ) || :
	return 0
}

## THE ANSWER TO THE QUESTION ABOUT A DEATH IS CARRIED OUT, in the name of the one who was
## asked (`address-to` of the question's record), by what the tooling has for it and by no
## second way:
##   resume, fresh   the record of the dead run is closed as ended without close, and its
##                   item, in review by then, is returned as its reviewer returns one
##                   (--intern-op-review-return): the return starts the member again in the
##                   same session, sandbox and item (AgentsReviewRestart), from the context it
##                   kept where that can be resumed, or, for `fresh` and where it cannot, as a
##                   new process on its brief.
##                   NEVER TWICE AT ONCE: nothing is started while a process still runs as the
##                   run it would replace, by the one rule a run is told by or under the
##                   process its record names; and where the item already names a newer run
##                   that lives, the answer was carried out by a try that could not say so,
##                   and nothing is started again.
##   close           the record is closed as ended without close, and its item is accepted, as
##                   the accept of a review closes one (--intern-op-review-accept): processed.
##   kill            every live run of the session is ended by the console's kill
##                   (--manager-session-kill), and the record of the dead run is closed.
## What was done is told once, in the thread of the question to the one who answered, and in
## the thread of the session that requested the run, to the member that brought it in, where
## that is another thread: one line of the note template each (`death-resumed`, `death-fresh`,
## `death-new-process`, `death-closed`, `death-killed`), or, where it could not be done,
## `death-failed` with why. The result: `done: <answer>`, which settles the death, or
## `failed: <why>`, after which the death stays unsettled, its reviewer is asked again
## (AgentsToolsSessionControlDeathAgain), and the tooling tries nothing by itself.
## A RESTART THAT FAILED AFTER ITS ITEM WAS RETURNED would leave the item in running with no
## run. The item is put back in review, by a review request in the name of the one who
## answered: there a return, an accept and the kill all work on it, so every option of the
## next question does. The result says `back: <item>`, and the note and the next question
## name it.
AgentsToolsSessionControlDeathAct(){ ## session id, record file, the line of the death, the file its result goes to
	local actSession="$1" actRecord="$2" actLine="$3" actResult="$4"
	local actRun actAnswer actId actPending actBy actMember actField actItem="" actState="" actNow actOut="" actWhy="" actSaid="" actReason="" actThread actParent actParentMember actBack="" actShown
	actRun="${actRecord##*/}" ; actRun="${actRun%.spawn.md}"
	actAnswer="$( AgentsToolsSessionControlDeathMark "$actLine" answer )" || actAnswer=""
	actId="$( AgentsToolsSessionControlDeathMark "$actLine" asked )" || actId=""
	actPending="$( AgentsToolsPendingRecordPath "$actId" || printf '%s' "$MMDAPP/.local/agents/pending/$actId.md" )"
	actBy="$( AgentsToolsSpawnSandboxRecordHeader "$actPending" address-to )"
	[ -n "$actBy" ] || actBy="human-owner"
	actMember="$( AgentsToolsSpawnSandboxRecordHeader "$actRecord" owner )"
	for actField in spawns spawned-by ; do
		actItem="$( AgentsToolsSpawnSandboxRecordHeader "$actRecord" "$actField" )"
		actItem="${actItem%%,*}" ; actItem="${actItem%% *}" ; actItem="${actItem%.md}"
		actState=""
		[ -z "$actItem" ] || [ -z "${MDAT_DATA_ROOT:-}" ] || actState="$( AgentsToolsSpawnProxyBoardStateOf "$actItem.md" )"
		[ -z "$actState" ] || break
		actItem=""
	done
	case "$actAnswer" in
		resume|fresh)
			actNow="$( [ -z "$actItem" ] || AgentsToolsSpawnSandboxRecordHeader "$MDAT_DATA_ROOT/board/$actState/$actItem.md" spawn-id )"
			if AgentsToolsRegistrySpawnRuns "$actRun" "$actRecord" || [ -n "$( AgentsToolsRegistryRunProcesses "$actRun" "$actRecord" - 2> /dev/null )" ] ; then
				actWhy="a process still runs as the run it would replace, so nothing was started"
			elif [ -z "$actItem" ] ; then
				actWhy="its record links no dispatch item of the board to start it again on"
			elif [ -n "$actNow" ] && [ "$actNow" != "-" ] && [ "$actNow" != "$actRun" ] && AgentsToolsRegistrySpawnRuns "$actNow" "" ; then
				actSaid="death-$actAnswer"
			else
				[ "$( AgentsToolsSpawnSandboxRecordHeader "$actRecord" status )" != "spawn-started" ] || AgentsToolsSessionControlDeathClose "$actRecord" \
					|| actWhy="its record could not be closed as $agentsSessionControlDeathOutcome"
				actState="$( AgentsToolsSpawnProxyBoardStateOf "$actItem.md" )"
				[ -n "$actWhy" ] || [ "$actState" = "review" ] || actWhy="its item is in ${actState:-no board state}, not in review, so it could not be returned"
				if [ -z "$actWhy" ] ; then
					actOut="$(
						[ "$actAnswer" != "fresh" ] || export MDAT_REVIEW_RESTART_FRESH=yes
						ASKP_F_by="$actBy" ASKP_F_option="$actAnswer" AgentsToolsSessionControlDeathText again \
							| DistroAgentsTools --intern-op-review-return "$actBy" "$actItem" --from-stdin --context "${MDSC_CMD:-session-control}" 2>&1
					)" || actWhy="the return of its item did not start it again"
					actOut="$( printf '%s\n' "$actOut" | LC_ALL=C grep -m1 -e '^RETURN: ' -e 'ERROR' )"
					case "$actOut" in
						'RETURN: restarted '*', resuming '*) actSaid="death-resumed" ;;
						'RETURN: restarted '*', new process ('*)
							actSaid="death-fresh"
							if [ "$actAnswer" != "fresh" ] ; then
								actSaid="death-new-process" ; actReason="${actOut##*, new process (}" ; actReason="${actReason%)}"
							fi
						;;
						*) actWhy="${actWhy:-the return of its item did not start it again}${actOut:+: ${actOut#RETURN: not restarted: }}" ;;
					esac
					if [ -n "$actWhy" ] && [ "$( AgentsToolsSpawnProxyBoardStateOf "$actItem.md" )" = "running" ] ; then
						( DistroAgentsTools --intern-op-review-request "$actBy" "$actItem" --reason "its run died and the start that was to replace it failed" --context "${MDSC_CMD:-session-control}" ) > /dev/null 2>&1 || :
						[ "$( AgentsToolsSpawnProxyBoardStateOf "$actItem.md" )" != "review" ] || actBack="$actItem"
					fi
				fi
			fi
		;;
		close)
			[ "$( AgentsToolsSpawnSandboxRecordHeader "$actRecord" status )" != "spawn-started" ] || AgentsToolsSessionControlDeathClose "$actRecord" \
				|| actWhy="its record could not be closed as $agentsSessionControlDeathOutcome"
			[ -z "$actItem" ] || actState="$( AgentsToolsSpawnProxyBoardStateOf "$actItem.md" )"
			case "$actWhy:$actItem:$actState" in
				:?*:review|:?*:running)
					actOut="$( DistroAgentsTools --intern-op-review-accept "$actBy" "$actItem" --context "${MDSC_CMD:-session-control}" 2>&1 )" \
						|| actWhy="its item could not be accepted: $( printf '%s\n' "$actOut" | LC_ALL=C grep -m1 'ERROR' | LC_ALL=C cut -c1-200 )"
				;;
				:?*:processed) ;;
				*) actItem="" ;;
			esac
			[ -n "$actWhy" ] || actSaid="death-closed"
		;;
		kill)
			( DistroAgentsTools --manager-session-kill --session-id "$actSession" ) > /dev/null 2>&1 || :
			[ "$( AgentsToolsSpawnSandboxRecordHeader "$actRecord" status )" != "spawn-started" ] || AgentsToolsSessionControlDeathClose "$actRecord" \
				|| actWhy="its record could not be closed as $agentsSessionControlDeathOutcome"
			[ -n "$actWhy" ] || actSaid="death-killed"
		;;
		*) actWhy="\`$actAnswer\` is none of the answers of the question" ;;
	esac
	actShown="$actItem"
	if [ -n "$actWhy" ] ; then
		actSaid="death-failed" ; actReason="$actWhy" ; actShown="$actBack"
	fi
	## Told where it was answered, and to the session that requested the run where that is another thread.
	actThread="$( AgentsToolsSpawnSandboxRecordHeader "$actPending" channel ):$( AgentsToolsSpawnSandboxRecordHeader "$actPending" thread-ts )"
	AgentsToolsSpawnConversationThreadValid "$actThread" || actThread=""
	[ -z "$actThread" ] || AgentsToolsSessionControlDeathSay "$actThread" "$actMember" "$actBy" "$actSaid" "$actRun" "$actBy" "$actAnswer" "$actReason" "$actShown"
	## And in the thread of the session the run reports to (AgentsToolsRunRoute), to its member.
	actParent="$( MDAT_SPAWN_SESSION_ID="$actRun" ; AgentsToolsSessionParentThreadFind 2> /dev/null )" || actParent=""
	actParent="${actParent%% *}"
	AgentsToolsSpawnConversationThreadValid "$actParent" || actParent=""
	if [ -n "$actParent" ] && [ "${actParent#*:}" != "${actThread#*:}" ] ; then
		actParentMember="$( MDAT_SPAWN_SESSION_ID="$actRun" ; AgentsToolsSessionParentMember 2> /dev/null )" || actParentMember=""
		AgentsToolsSessionControlDeathSay "$actParent" "$actMember" "$actParentMember" "$actSaid" "$actRun" "$actBy" "$actAnswer" "$actReason" "$actShown"
	fi
	if [ -n "$actWhy" ] ; then
		[ -z "$actBack" ] || printf 'back: %s\n' "$actBack" >> "$actResult"
		printf 'failed: %s\n' "$actWhy" >> "$actResult"
	else
		printf 'done: %s\n' "$actAnswer" >> "$actResult"
	fi
	return 0
}

## ONE BOUNDED CALL: what is told and asked about one death, made in a process group of its
## own and ended at its bound, so a call to Slack that hangs holds nothing: not the tick,
## which never waits for this, and not the next try, which a later tick starts. Run by the
## thread's own operation as a process apart (`--intern-session-control --death`), never
## inside the thread, which sends no signal: this process ends its own job, which it
## started, probes at each turn of its wait and has not collected. At the bound the group
## is asked to end, given five seconds, and ended; what it had done till then stands in its
## result, and the result says that the bound was reached.
AgentsToolsSessionControlDeathPost(){ ## session id, run id, the bound in seconds
	local postSession="$1" postRun="$2" postBound="$3" postResult postPid postFrom postGrace postMonitor
	postResult="$MMDAPP/.local/agents/sessions/$postSession/control/post.$postRun.result"
	{ : > "$postResult" ; } 2> /dev/null || return 1
	## Its own process group, so the end at the bound reaches every process of the post.
	postMonitor="$BASH_SUBSHELL:$-"
	set -m
	( AgentsToolsSessionControlDeathWork "$postSession" "$postRun" "$postResult" ) < /dev/null &
	postPid=$!
	case "$postMonitor" in 0:*m*) ;; *) set +m ;; esac
	postFrom="$SECONDS"
	while kill -0 "$postPid" 2> /dev/null ; do
		if [ "$(( SECONDS - postFrom ))" -ge "$postBound" ] ; then
			{
				kill -TERM -- "-$postPid" || :
				postGrace=5
				while [ "$postGrace" -gt 0 ] && kill -0 "$postPid" ; do sleep 1 ; postGrace=$(( postGrace - 1 )) ; done
				kill -KILL -- "-$postPid" || :
			} 2> /dev/null
			printf 'error: %s\n' "it did not end within its bound of $postBound seconds, and was ended" >> "$postResult"
			break
		fi
		sleep 1
	done
	{ wait "$postPid" ; } 2> /dev/null
	return 0
}
