#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.SessionTranscript.include -- the tooling-written session transcript
## (the session token totals are AgentsTools.SessionTokens.include's). Sourced, never run; functions only, and every one
## returns 0 on its own failure, so a hook can never fail the call it observes.
##
## One transcript per spawned session, in the team data:
##   audit/YYYY-MM/session-<startUTC>-<member>-<sid8>.log  (then -part2.log, ... at 8 MB)

## found from the session id alone through $MMDAPP/.local/agents/sessions/<sid>/transcript,
## and named by a `transcript:` header on the spawn tracking file and the dispatch item.
## A line: `<ISO UTC> <KIND> key=val ... [-> outcome] [| "comment"]`, a body as `> ` lines.

## The tool line comes from the one formatter, AgentsSessionTranscriptFormat.awk, which the
## stream-json formatter of a native spawn and the MCP daemon log use too.
##
## Committed at milestones only -- start, a message out or handback, a Wait going idle,
## DISMISSED, a restart, the end -- never per line. A failed commit only warns.
##

agentsTranscriptT0=""
agentsTranscriptRoundText=""
## Set by the harness (AgentsHarnessContext.include) when its rounds are rendered from its kept context.
agentsTranscriptFromLog=""

## THE CLOCK OF A PROCESS: date is read once a minute, the epoch and the local zone in one reading, with the shell's SECONDS beside it,
## and every reading between is arithmetic, so a call starts no process for its time. SECONDS counts wall-clock seconds, so a reading
## never drifts from date's; bash 3.2 has no EPOCHSECONDS. The zone is at most a minute old, so a change of daylight saving shows within
## a minute. A load of this file keeps the clock. A caller that read the clock already hands it over in agentsTranscriptClockEpoch,
## agentsTranscriptClockSeconds and agentsTranscriptClockZone. Taken in a subshell, the clock is that subshell's alone: a caller whose
## reading is inside a $( ) takes it outside first.
AgentsTranscriptNowInto(){ ## variable: epoch seconds, now
	local intoClock=""
	case "${agentsTranscriptClockEpoch:-}${agentsTranscriptClockSeconds:-x}" in
		*[!0-9]*) intoClock=read ;;
		*) [ "$(( SECONDS - agentsTranscriptClockSeconds ))" -lt 60 ] || intoClock=read ;;
	esac
	if [ -n "$intoClock" ] ; then
		intoClock="$( date '+%s %z' )"
		agentsTranscriptClockEpoch="${intoClock%% *}" ; agentsTranscriptClockZone="${intoClock#* }" ; agentsTranscriptClockSeconds="$SECONDS"
	fi
	printf -v "$1" '%s' "$(( agentsTranscriptClockEpoch + SECONDS - agentsTranscriptClockSeconds ))"
}

## An epoch as UTC, `YYYY-MM-DDTHH:MM:SSZ`, or `YYYYMMDDTHHMMSSZ` with compact, by the civil-from-days rule that
## AgentsCommsEventIdStamp writes by: arithmetic only, so it starts no process.
AgentsTranscriptUtcInto(){ ## variable, epoch seconds, compact (optional)
	case "${2:-}" in ''|*[!0-9]*) return 1 ;; esac
	local utcDay=$(( $2 / 86400 + 719468 )) utcSec=$(( $2 % 86400 )) utcEra utcDoe utcYoe utcDoy utcMp utcYear utcMonth utcDate
	utcEra=$(( utcDay / 146097 )) ; utcDoe=$(( utcDay - utcEra * 146097 ))
	utcYoe=$(( ( utcDoe - utcDoe / 1460 + utcDoe / 36524 - utcDoe / 146096 ) / 365 ))
	utcYear=$(( utcYoe + utcEra * 400 )) ; utcDoy=$(( utcDoe - ( 365 * utcYoe + utcYoe / 4 - utcYoe / 100 ) ))
	utcMp=$(( ( 5 * utcDoy + 2 ) / 153 )) ; utcDate=$(( utcDoy - ( 153 * utcMp + 2 ) / 5 + 1 ))
	utcMonth=$(( utcMp < 10 ? utcMp + 3 : utcMp - 9 )) ; [ "$utcMonth" -gt 2 ] || utcYear=$(( utcYear + 1 ))
	if [ -n "${3:-}" ] ; then
		printf -v "$1" '%04d%02d%02dT%02d%02d%02dZ' "$utcYear" "$utcMonth" "$utcDate" "$(( utcSec / 3600 ))" "$(( utcSec % 3600 / 60 ))" "$(( utcSec % 60 ))"
	else
		printf -v "$1" '%04d-%02d-%02dT%02d:%02d:%02dZ' "$utcYear" "$utcMonth" "$utcDate" "$(( utcSec / 3600 ))" "$(( utcSec % 3600 / 60 ))" "$(( utcSec % 60 ))"
	fi
}

## THE HELPERS A CALL TAKES ARE `...Into` FORMS, each setting the variable it is given by printf -v: every tool call takes them, and one
## through $( ) was a subshell each, eight a call. The printing forms stand for the callers outside the call path, and print what the
## `...Into` form sets. A variable given is never one of the form's own locals, which all begin with `into`.

## The session a call belongs to, by the same rule as AgentsHarnessSessionKey.
AgentsTranscriptSessionKeyInto(){ ## variable
	printf -v "$1" '%s' "${harnessSessionId:-${MDAT_SPAWN_SESSION_ID:-${CLAUDE_CODE_SESSION_ID:-}}}"
}
AgentsTranscriptSessionKey(){
	local intoKey ; AgentsTranscriptSessionKeyInto intoKey ; printf '%s' "$intoKey"
}

AgentsTranscriptSessionDirInto(){ ## variable, session id
	case "${2:-}" in
		''|*/*|.|..|*' '*) return 1 ;;
	esac
	[ -n "${MMDAPP:-}" ] || return 1
	printf -v "$1" '%s' "$MMDAPP/.local/agents/sessions/$2"
}
AgentsTranscriptSessionDir(){ ## session id
	local intoDir ; AgentsTranscriptSessionDirInto intoDir "${1:-}" || return 1 ; printf '%s' "$intoDir"
}

AgentsTranscriptBaseToolInto(){ ## variable, tool name -- mcp__<server>__Read is Read
	local intoRest="${2:-}"
	case "$intoRest" in mcp__*__*) intoRest="${intoRest#mcp__}" ; intoRest="${intoRest#*__}" ;; esac
	printf -v "$1" '%s' "$intoRest"
}
AgentsTranscriptBaseTool(){ ## tool name -- mcp__<server>__Read is Read
	local intoTool ; AgentsTranscriptBaseToolInto intoTool "${1:-}" ; printf '%s' "$intoTool"
}

## The base file of a session's transcript, from its pointer; rc 1 when it has none.
AgentsTranscriptBaseInto(){ ## variable, session id
	local intoSessionDir intoBase=""
	AgentsTranscriptSessionDirInto intoSessionDir "${2:-}" || return 1
	[ -s "$intoSessionDir/transcript" ] || return 1
	IFS= read -r intoBase < "$intoSessionDir/transcript" || :
	[ -n "$intoBase" ] && [ -f "$intoBase" ] || return 1
	printf -v "$1" '%s' "$intoBase"
}
AgentsTranscriptBase(){ ## session id
	local intoBasePath ; AgentsTranscriptBaseInto intoBasePath "${1:-}" || return 1 ; printf '%s' "$intoBasePath"
}

## Every part, base first, one per line.
AgentsTranscriptParts(){ ## session id
	local basePath partNumber=2
	AgentsTranscriptBaseInto basePath "$1" || return 1
	printf '%s\n' "$basePath"
	while [ -f "${basePath%.log}-part$partNumber.log" ] ; do
		printf '%s\n' "${basePath%.log}-part$partNumber.log"
		partNumber=$(( partNumber + 1 ))
	done
}

## The part to append to now. A part at or over the roll size starts the next one,
## created exclusively, so of two writers rolling at once only one writes its header.
AgentsTranscriptPathInto(){ ## variable, session id
	local intoBasePath intoCurrent intoNext intoPart=1 intoBytes intoRoll intoStamp intoSizeDir intoNow intoKeptAt intoKeptBytes intoKept
	AgentsTranscriptBaseInto intoBasePath "${2:-}" || return 1
	intoCurrent="$intoBasePath"
	while : ; do
		intoNext="${intoBasePath%.log}-part$(( intoPart + 1 )).log"
		[ -f "$intoNext" ] || break
		intoCurrent="$intoNext"
		intoPart=$(( intoPart + 1 ))
	done
	## THE PART'S SIZE IS KEPT A MINUTE, in the process (agentsTranscriptSized*) and beside the session (`transcript.size`, `<epoch> <bytes>
	## <part>`), by the process clock: every tool call measured it with wc and tr, two processes a call, and a served call is a process of its
	## own. A part measured within the minute, by this process or another, is taken at that size; past it the file is measured again and the
	## size written back. The other writers of the part are counted at the next measure, so a part overshoots the roll size by a minute.
	if [ "$intoCurrent" = "${agentsTranscriptSizedPath:-}" ] && [ "$(( SECONDS - ${agentsTranscriptSizedAt:--100} ))" -lt 60 ] ; then
		intoBytes="${agentsTranscriptSizedBytes:-0}"
	else
		AgentsTranscriptNowInto intoNow
		intoKeptAt="" ; intoKeptBytes="" ; intoKept="" ; intoSizeDir=""
		AgentsTranscriptSessionDirInto intoSizeDir "${2:-}" || intoSizeDir=""
		[ -z "$intoSizeDir" ] || { read -r intoKeptAt intoKeptBytes intoKept < "$intoSizeDir/transcript.size" ; } 2> /dev/null || :
		case "$intoKeptAt:$intoKeptBytes" in *[!0123456789:]*|:*|*:) intoKept="" ;; esac
		if [ -n "$intoKept" ] && [ "$intoKept" = "$intoCurrent" ] && [ "$(( intoNow - intoKeptAt ))" -ge 0 ] && [ "$(( intoNow - intoKeptAt ))" -lt 60 ] ; then
			intoBytes="$intoKeptBytes"
			agentsTranscriptSizedAt="$(( SECONDS - ( intoNow - intoKeptAt ) ))"
		else
			intoBytes="$( wc -c < "$intoCurrent" 2>/dev/null | tr -d ' ' )"
			case "$intoBytes" in ''|*[!0123456789]*) intoBytes=0 ;; esac
			agentsTranscriptSizedAt="$SECONDS"
			[ -z "$intoSizeDir" ] || printf '%s %s %s\n' "$intoNow" "$intoBytes" "$intoCurrent" > "$intoSizeDir/transcript.size" 2> /dev/null || :
		fi
		agentsTranscriptSizedPath="$intoCurrent" ; agentsTranscriptSizedBytes="$intoBytes"
	fi
	intoRoll="${MDAT_TRANSCRIPT_ROLL_BYTES:-8388608}"
	case "$intoRoll" in ''|*[!0123456789]*) intoRoll=8388608 ;; esac
	if [ "$intoBytes" -ge "$intoRoll" ] ; then
		if ( set -C ; : > "$intoNext" ) 2>/dev/null ; then
			AgentsTranscriptNowInto intoStamp ; AgentsTranscriptUtcInto intoStamp "$intoStamp"
			printf '%s ROLL -> %s\n' "$intoStamp" "${intoNext##*/}" >> "$intoCurrent" 2>/dev/null
			printf '%s CONTINUED from %s\n' "$intoStamp" "${intoCurrent##*/}" >> "$intoNext" 2>/dev/null
		fi
		intoCurrent="$intoNext"
	fi
	printf -v "$1" '%s' "$intoCurrent"
}
AgentsTranscriptPath(){ ## session id
	local intoPathOut ; AgentsTranscriptPathInto intoPathOut "${1:-}" || return 1 ; printf '%s' "$intoPathOut"
}

## One block. 4 KB or less is a single O_APPEND write and takes no lock; a bigger
## block takes the local lock, so two big blocks never interleave.
## THE LINE REACHES A COMMIT ON A BOUND, never on every line: an entry is left for the one team-data thread at most once per
## MDAT_TRANSCRIPT_COMMIT_SECONDS, so the path every tool call takes gains two arithmetic tests and no fork. A milestone
## (AgentsTranscriptMilestone) commits at the points a reader waits on, and this carries what falls between them.
AgentsTranscriptAppend(){ ## file, text
	local LC_ALL=C appendLock=""
	if [ "${#2}" -le 4096 ] ; then
		printf '%s\n' "$2" >> "$1" 2>/dev/null || :
	else
		type AgentsToolsLocalLockTake > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/common/AgentsTools.LocalLock.include"
		if AgentsToolsLocalLockTake "transcript.${1##*/}" 10 "transcript ${1##*/}" 2>/dev/null ; then
			appendLock="$agentsLocalLockPath"
		fi
		printf '%s\n' "$2" >> "$1" 2>/dev/null || :
		[ -z "$appendLock" ] || AgentsToolsLocalLockGive "$appendLock" 2>/dev/null || :
	fi
	agentsTranscriptBoundAt="${agentsTranscriptBoundAt:-$SECONDS}"
	[ "$(( SECONDS - agentsTranscriptBoundAt ))" -ge "${MDAT_TRANSCRIPT_COMMIT_SECONDS:-120}" ] || return 0
	agentsTranscriptBoundAt="$SECONDS"
	## The store is the transcript's own, taken from its path: a run may write a store other than its workspace's.
	case "$1" in */audit/*) : ;; *) return 0 ;; esac
	type AgentsToolsTeamDataCommitPaths > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.TeamDataCommit.include"
	MDAT_DATA_ROOT="${1%%/audit/*}" AgentsToolsTeamDataCommitPaths "transcript ${1##*/}: the lines the bound carried" "$1" > /dev/null 2>&1 || :
	return 0
}

## `<ts> KIND key=val ...` through the formatter; an empty value drops its key.

## A value's newline, tab and carriage return become one space each by parameter expansion:
## the fork and pipe a `tr` per key set cost were the largest single block of the spawn's externals
## (8 of 95) and of every transcript line's. Proved equal to the `tr` on bash 3.2 for a
## control with none, one with all three, and the empty value.
AgentsTranscriptEventLine(){ ## kind, then key value pairs
	local eventKind="$1" eventValue eventStamp
	shift
	AgentsTranscriptNowInto eventStamp ; AgentsTranscriptUtcInto eventStamp "$eventStamp"
	{
		while [ $# -ge 2 ] ; do
			eventValue="$2"
			eventValue="${eventValue//$'\n'/ }"
			eventValue="${eventValue//$'\t'/ }"
			eventValue="${eventValue//$'\r'/ }"
			printf '%s\t%s\n' "$1" "$eventValue"
			shift 2
		done
	} | STL_TS="$eventStamp" STL_KIND="$eventKind" LC_ALL=C awk -v stlStandalone=event -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/transcript/AgentsSessionTranscriptFormat.awk"
}

## A text as `> ` lines, cut at cap bytes (0: whole): the whole body in one pipe.
## One string field of a JSON object, unescaped: the one field in one pipe.
## One event, with an optional body, to the session's transcript; nothing when it has none.
AgentsTranscriptEvent(){ ## session id, kind, body ('' for none), body cap, then key value pairs
	local eventSession="$1" eventKind="$2" eventBody="$3" eventCap="$4" eventPath eventBlock eventNow
	shift 4
	## The clock is taken here, outside the substitution below, so the process keeps it.
	AgentsTranscriptNowInto eventNow
	AgentsTranscriptPathInto eventPath "$eventSession" || return 0
	eventBlock="$( AgentsTranscriptEventLine "$eventKind" "$@" )" || return 0
	[ -n "$eventBlock" ] || return 0
	[ -z "$eventBody" ] || eventBlock="$eventBlock"$'\n'"$( printf '%s' "$eventBody" | STL_CAP="${eventCap:-0}" LC_ALL=C awk -v stlStandalone=body -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/transcript/AgentsSessionTranscriptFormat.awk" )"
	AgentsTranscriptAppend "$eventPath" "$eventBlock"
	AgentsTranscriptFeed "$eventSession" "$eventBlock"
	return 0
}

## The event-track feed: the same lines, kept for this session's poster while its feed is
## switched on (AgentsEventTrackFeedOn). Where the feed is, and whether it is on, is
## event-track's own (AgentsTools.EventTrackFeed.include). Never team data.
AgentsTranscriptFeed(){ ## session id, block
	[ -n "${2:-}" ] || return 0
	type AgentsEventTrackFeedAppend > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/event-track/AgentsTools.EventTrackFeed.include"
	printf '%s\n' "$2" | AgentsEventTrackFeedAppend "$1"
	return 0
}

## How a call came out: ok, error, or refused (a hook, the arm gate, an access root, a
## REFUSAL-ID). A preset outcome wins. The first line defaults to the result's own.
AgentsTranscriptOutcomeOfInto(){ ## variable, result, preset outcome (optional), first line (optional)
	[ -z "${3:-}" ] || { printf -v "$1" '%s' "$3" ; return 0 ; }
	case "${2:-}" in
		ERROR:*)
			case "$2" in *REFUSAL-ID:*) printf -v "$1" 'refused' ; return 0 ;; esac
			case "${4:-${2%%$'\n'*}}" in
				*'read your duty file first'*|*REFUSAL-ID*|*'PreToolUse'*|*' hook '*|*'refused'*|*'denied'*|*'not allowed'*|*'access-root'*) printf -v "$1" 'refused' ;;
				*) printf -v "$1" 'error' ;;
			esac
		;;
		## A change held for approval: neither refused nor applied.
		HELD:*) printf -v "$1" 'held' ;;
		*) printf -v "$1" 'ok' ;;
	esac
}
AgentsTranscriptOutcomeOf(){ ## result, preset outcome (optional), first line (optional)
	local intoOutcome ; AgentsTranscriptOutcomeOfInto intoOutcome "${1:-}" "${2:-}" "${3:-}" ; printf '%s' "$intoOutcome"
}

## A milestone: the line the console reads, written whatever the run keeps of a transcript, then the tokens header brought up to date
## and every transcript part committed. Nothing changed is no commit; a failure warns and goes on.
AgentsTranscriptMilestone(){ ## session id, reason
	local milestoneSession="$1" milestoneReason="$2" milestoneDir milestoneRoot="" milestonePart milestoneParts=() milestoneStamp
	## The commit helper names its caller by this; a harness process has none of its own.
	local MDSC_CMD="${MDSC_CMD:-DistroAgentsTools}"
	AgentsTranscriptSessionDirInto milestoneDir "$milestoneSession" || return 0
	## THE LINE IS WRITTEN BEFORE ANY TRANSCRIPT IS ASKED FOR (): a run idle in a Wait or an ask is read

	## from these lines alone, and a run whose harness keeps no transcript has no other record that it waits.
	mkdir -p "$milestoneDir" 2>/dev/null || :
	AgentsTranscriptNowInto milestoneStamp ; AgentsTranscriptUtcInto milestoneStamp "$milestoneStamp"
	printf '%s %s\n' "$milestoneStamp" "$milestoneReason" >> "$milestoneDir/milestones" 2>/dev/null || return 0
	[ -s "$milestoneDir/transcript" ] || return 0
	[ ! -s "$milestoneDir/data-root" ] || IFS= read -r milestoneRoot < "$milestoneDir/data-root" || :
	[ -n "$milestoneRoot" ] || milestoneRoot="${MDAT_DATA_ROOT:-}"
	[ -n "$milestoneRoot" ] || return 0
	type AgentsSessionTokensHeaderUpdate > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionTokens.include"
	MDAT_DATA_ROOT="$milestoneRoot" AgentsSessionTokensHeaderUpdate "$milestoneSession" || :
	while IFS= read -r milestonePart ; do
		[ -z "$milestonePart" ] || milestoneParts+=( "$milestonePart" )
	done <<< "$( AgentsTranscriptParts "$milestoneSession" )"
	[ "${#milestoneParts[@]}" -gt 0 ] || return 0
	type AgentsToolsTeamDataCommitPaths > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.TeamDataCommit.include"
	MDAT_DATA_ROOT="$milestoneRoot" AgentsToolsTeamDataCommitPaths "session transcript ${milestoneSession:0:8}: $milestoneReason" ${milestoneParts[@]+"${milestoneParts[@]}"} >&2 || :
	return 0
}

## Called before a tool runs: starts its clock, and a tool about to block on a person is a milestone.
AgentsTranscriptToolStart(){ ## tool name
	local startBase startKey
	## Milliseconds since the epoch, whole seconds: bash 3.2 has no EPOCHREALTIME, so the '000' is a literal.
	AgentsTranscriptNowInto agentsTranscriptT0 ; agentsTranscriptT0="${agentsTranscriptT0}000"
	AgentsTranscriptBaseToolInto startBase "$1" ; AgentsTranscriptSessionKeyInto startKey
	case "$startBase" in
		Wait) AgentsTranscriptMilestone "$startKey" "wait going idle" ;;
		AskUserQuestion|AskQuestion|ConfirmReadback|EscalateDecision|RequestPermission|ProposeApprove) AgentsTranscriptMilestone "$startKey" "ask going idle" ;;
	esac
	return 0
}

## Called after a tool ran: its one tool line, then whatever message it carried.
## source is loop (this harness's model loop) or mcp (a served call: the line also goes
## to the daemon log, prefixed by the session's first 8 characters). A native spawn's own
## stream formatter writes its tool lines (sessions/<sid>/transcript.stream), so a served
## call of that session writes only the message lines.
AgentsTranscriptToolDone(){ ## tool name, arguments JSON, result, source, outcome (optional), comment (optional), first line (optional)
	local LC_ALL=C
	local doneTool="$1" doneArgs="${2:-}" doneResult="$3" doneSource="${4:-loop}" doneOutcome="${5:-}" doneComment="${6:-}"
	local doneSession doneDur="" doneFirst doneLine doneBlock donePath doneBase doneDir doneCap=0 doneBody doneNow doneStamp
	AgentsTranscriptSessionKeyInto doneSession
	AgentsTranscriptNowInto doneNow
	[ -z "$agentsTranscriptT0" ] || doneDur=$(( doneNow * 1000 - agentsTranscriptT0 ))
	agentsTranscriptT0=""
	AgentsTranscriptBaseToolInto doneBase "$doneTool"
	doneFirst="${7:-${doneResult%%$'\n'*}}"
	[ -n "$doneOutcome" ] || AgentsTranscriptOutcomeOfInto doneOutcome "$doneResult" "" "$doneFirst"
	## A harness loop whose context is kept (AgentsHarnessContext.include): its tool lines and
	## message events are written from that log as it gains records (AgentsHarnessContextFeed), so only the milestone is here.
	## THE MILESTONE WAITS FOR THE FEED: taken here it committed before the feed wrote this tool's lines, with nothing new (the ask's
	## ASK and ANSWER landed in a later commit). It is left for the context sync, which commits it right after the feed.
	if [ "$doneSource" = "loop" ] && [ -n "${agentsTranscriptFromLog:-}" ] ; then
		case "$doneBase:$doneOutcome" in
			SendMessage:ok|ReportFindings:ok|PushNotification:ok|Artifact:ok|AskUserQuestion:ok|AskQuestion:ok|ConfirmReadback:ok|EscalateDecision:ok|RequestPermission:ok|ProposeApprove:ok) agentsTranscriptMilestoneAfterFeed="message out" ;;
			AskUserQuestion:*|AskQuestion:*|ConfirmReadback:*|EscalateDecision:*|RequestPermission:*|ProposeApprove:*) agentsTranscriptMilestoneAfterFeed="ask ended" ;;
			SubagentHandback:ok) agentsTranscriptMilestoneAfterFeed="handback" ;;
			Wait:*) case "$doneFirst" in 'WAIT-RESULT: DISMISSED'*) agentsTranscriptMilestoneAfterFeed="dismissed" ;; esac ;;
		esac
		return 0
	fi
	## Counted by awk, not by a pattern substitution: bash 3.2 takes quadratic time on a big result.
	[ -n "$doneComment" ] || doneComment="${agentsTranscriptRoundText:0:400}"
	AgentsTranscriptUtcInto doneStamp "$doneNow"
	doneLine="$( printf '%s' "$doneArgs" | STL_TS="$doneStamp" STL_TOOL="$doneTool" STL_OUTCOME="$doneOutcome" \
		STL_FIRST="${doneFirst:0:400}" STL_BYTES="${#doneResult}" STL_LINES="$( printf '%s' "$doneResult" | awk 'END { print NR + 0 ; }' )" STL_DUR_MS="$doneDur" STL_COMMENT="$doneComment" \
		awk -v stlStandalone=tool -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/transcript/AgentsSessionTranscriptFormat.awk" 2>/dev/null )" || doneLine=""
	[ -n "$doneLine" ] || return 0
	if [ "$doneSource" = "mcp" ] ; then
		printf '%s%s\n' "${doneSession:+${doneSession:0:8} }" "$doneLine" >&2
	fi
	AgentsTranscriptPathInto donePath "$doneSession" || return 0
	AgentsTranscriptSessionDirInto doneDir "$doneSession" || return 0
	if [ "$doneSource" != "mcp" ] || [ ! -e "$doneDir/transcript.stream" ] ; then
		doneBlock="$doneLine"
		## Errors and refusals in full; a failed command's own output is held to 16 KB.
		[ "$doneBase" != "execute" ] || doneCap=16384
		[ "$doneOutcome" = "ok" ] || [ -z "$doneResult" ] || doneBlock="$doneBlock"$'\n'"$( printf '%s' "$doneResult" | STL_CAP="${doneCap:-0}" LC_ALL=C awk -v stlStandalone=body -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/transcript/AgentsSessionTranscriptFormat.awk" )"
		AgentsTranscriptAppend "$donePath" "$doneBlock"
		AgentsTranscriptFeed "$doneSession" "$doneBlock"
	fi
	## Messages in and out, each body capped at 4 KB.
	case "$doneBase" in
		SendMessage)
			[ "$doneOutcome" = "ok" ] || return 0
			AgentsTranscriptEvent "$doneSession" MSG-OUT "$( printf '%s' "$doneArgs" | STL_KEY="message" LC_ALL=C awk -v stlStandalone=field -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/transcript/AgentsSessionTranscriptFormat.awk" )" 4096 to "$( printf '%s' "$doneArgs" | STL_KEY="to" LC_ALL=C awk -v stlStandalone=field -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/transcript/AgentsSessionTranscriptFormat.awk" )"
			AgentsTranscriptMilestone "$doneSession" "message out"
		;;
		SubagentHandback)
			[ "$doneOutcome" = "ok" ] || return 0
			doneBody="$( printf 'task: %s\noutcome: %s\nfindings: %s\nunfinished: %s' \
				"$( printf '%s' "$doneArgs" | STL_KEY="task" LC_ALL=C awk -v stlStandalone=field -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/transcript/AgentsSessionTranscriptFormat.awk" )" "$( printf '%s' "$doneArgs" | STL_KEY="outcome" LC_ALL=C awk -v stlStandalone=field -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/transcript/AgentsSessionTranscriptFormat.awk" )" \
				"$( printf '%s' "$doneArgs" | STL_KEY="findings" LC_ALL=C awk -v stlStandalone=field -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/transcript/AgentsSessionTranscriptFormat.awk" )" "$( printf '%s' "$doneArgs" | STL_KEY="unfinished" LC_ALL=C awk -v stlStandalone=field -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/transcript/AgentsSessionTranscriptFormat.awk" )" )"
			AgentsTranscriptEvent "$doneSession" HANDBACK "$doneBody" 4096 to "$( printf '%s' "$doneArgs" | STL_KEY="to" LC_ALL=C awk -v stlStandalone=field -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/transcript/AgentsSessionTranscriptFormat.awk" )"
			AgentsTranscriptMilestone "$doneSession" "handback"
		;;
		ReportFindings|PushNotification|Artifact)
			[ "$doneOutcome" = "ok" ] || return 0
			AgentsTranscriptEvent "$doneSession" MSG-OUT "$doneArgs" 4096 tool "$doneBase" to "$( printf '%s' "$doneArgs" | STL_KEY="to" LC_ALL=C awk -v stlStandalone=field -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/transcript/AgentsSessionTranscriptFormat.awk" )"
			AgentsTranscriptMilestone "$doneSession" "message out"
		;;
		Wait)
			case "$doneFirst" in
				'WAIT-RESULT: DISMISSED'*)
					AgentsTranscriptEvent "$doneSession" DISMISSED "$doneResult" 4096
					AgentsTranscriptMilestone "$doneSession" "dismissed"
				;;
				*) AgentsTranscriptEvent "$doneSession" WAIT-RESULT "$doneResult" 4096 ;;
			esac
		;;
		## The tools that ask, and their second name. The kind is the tool's own; only the
		## second name carries one as an argument.
		AskUserQuestion|AskQuestion|ConfirmReadback|EscalateDecision|RequestPermission|ProposeApprove)
			local doneKind=""
			case "$doneBase" in
				ConfirmReadback) doneKind="readback" ;;
				EscalateDecision) doneKind="decision" ;;
				RequestPermission) doneKind="permission" ;;
				ProposeApprove) doneKind="proposal" ;;
				*) doneKind="$( printf '%s' "$doneArgs" | STL_KEY="kind" LC_ALL=C awk -v stlStandalone=field -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/transcript/AgentsSessionTranscriptFormat.awk" )" ;;
			esac
			AgentsTranscriptEvent "$doneSession" ASK "$( printf '%s' "$doneArgs" | STL_KEY="question" LC_ALL=C awk -v stlStandalone=field -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/transcript/AgentsSessionTranscriptFormat.awk" )" 4096 \
				to "$( printf '%s' "$doneArgs" | STL_KEY="to" LC_ALL=C awk -v stlStandalone=field -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/transcript/AgentsSessionTranscriptFormat.awk" )" kind "$doneKind"
			AgentsTranscriptEvent "$doneSession" ANSWER "$doneResult" 4096
			## The end of the block, whatever came of it: nothing waits on an ask that is over.
			if [ "$doneOutcome" != "ok" ] ; then AgentsTranscriptMilestone "$doneSession" "ask ended" ; else AgentsTranscriptMilestone "$doneSession" "message out" ; fi
		;;
		Agent)
			AgentsTranscriptEvent "$doneSession" SPAWN "$doneResult" 1024 agent "$( printf '%s' "$doneArgs" | STL_KEY="agent" LC_ALL=C awk -v stlStandalone=field -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/transcript/AgentsSessionTranscriptFormat.awk" )"
		;;
	esac
	return 0
}

## The MCP request handler's own tools (execute, a refused call): their tool line,
## from the raw request. A harness tool's line comes from the served harness itself.
AgentsTranscriptMcpCallDone(){ ## tool name, raw request line, output, is error (true|false), error text
	local mcpDoneArgs mcpDoneOutcome=""
	mcpDoneArgs="$( printf '%s\n' "$2" | LC_ALL=C awk -v path="params.arguments" -v mode=raw -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsHarnessJsonField.awk" 2>/dev/null )" || mcpDoneArgs=""
	[ "$4" != "true" ] || mcpDoneOutcome=error
	if [ -n "$5" ] ; then
		AgentsTranscriptToolDone "$1" "$mcpDoneArgs" "ERROR: $5" mcp error
	else
		AgentsTranscriptToolDone "$1" "$mcpDoneArgs" "$3" mcp "$mcpDoneOutcome" "" "$( [ "$4" != "true" ] || printf '%s' "${3##*$'\n'}" )"
	fi
	return 0
}

## The reply layer (F2.3 and F2.4 of the refactorings epic). Every tool result passes through
## AgentsTranscriptReplyFinish on its way to its caller: the harness's served exit and its model
## loop (AgentsUniversalHarness.sh, AgentsHarnessReply), and the MCP server's own tools
## (AgentsTools.InternMcpRequest.include, AgentsMcpReplyText), so no tool carries either part
## itself. A result over agentsReplyLongBytes is kept whole in its session's results/ folder and
## the reply names it. The host's local time is every reply's too, as a content part of its own
## beside the result (AgentsTranscriptReplyDate), added where the reply is encoded: a second text
## item of an MCP result's content, a separate part of the model loop's tool message. It is never
## inside a tool's output, so every tool's own output stays exactly as printed. A kept file is a
## printed value as a reply is: whatever is done to the one is done to the other.
## Halved from 8192 by : a result stays in a run's context and is re-read on every later turn, which

## made half of a day's DeepSeek tokens; the rest of a kept result is read by line range when it is needed.
agentsReplyLongBytes=4096

## The reference to a result kept in a file. The preview comes first, so the reply opens as the
## result does (WAIT-RESULT:, ERROR:, OK: ...), then the file, its size and how to read the rest.

## The preview is the whole lines that fit in 1 KB, or the first 10, whichever is more, and never
## over 3.5 KB, so the reply stays under the threshold. Writes nothing: a caller with a file of its
## own, such as a kept report, names it here as it is. For a Read's result, the file the Read read
## is the second argument: the hint to read the rest names that file and the next line of it to read,
## and not the kept copy.
AgentsTranscriptReplyRef(){ ## file, the file a Read read (optional)
	[ -f "$1" ] || return 1
	LC_ALL=C awk -v refPath="$1" -v refOrigin="${2:-}" -v refBytes="$( LC_ALL=C wc -c < "$1" | tr -d ' ' )" -v refLines="$( LC_ALL=C wc -l < "$1" | tr -d ' ' )" '
		{ total += length( $0 ) + 1 ; if ( NR > 10 && total > 3584 ) { exit ; } ; if ( total <= 1024 ) { fit = NR ; } ; if ( total <= 3584 ) { cap = NR ; } ; kept[ NR ] = $0 ; seen = NR ; }
		END {
			shown = ( fit > 10 ) ? fit : 10 ; if ( shown > seen ) { shown = seen ; } ; if ( shown > cap ) { shown = cap ; } ;
			for ( n = 1 ; n <= shown ; n++ ) { print kept[ n ] ; }
			if ( shown == 0 && seen > 0 ) {
				print substr( kept[ 1 ], 1, 1024 )
				printf "... KEPT: the whole result, %d bytes in %d lines, is in %s -- its line 1 is too long to show, and its first 1024 bytes are shown above ...\n", refBytes, refLines, refPath
				if ( refOrigin != "" ) { printf "... read it by line range: Read file_path=%s offset=1 limit=1 ...\n", refOrigin ; }
				else { printf "... read it by line range: Read file_path=%s offset=1 limit=%d ...\n", refPath, refLines ; }
			} else if ( shown >= refLines ) {
				printf "... KEPT: the whole result, %d bytes in %d lines, is in %s -- all of it is shown above ...\n", refBytes, refLines, refPath
			} else {
				printf "... KEPT: the whole result, %d bytes in %d lines, is in %s -- lines 1 to %d are shown above ...\n", refBytes, refLines, refPath, shown
				nextAt = shown + 1 ; if ( match( kept[ shown ], /^ *[0-9]+\t/ ) ) { nextAt = substr( kept[ shown ], 1, RLENGTH - 1 ) + 1 ; }
				if ( refOrigin != "" ) { printf "... read the rest from the file itself, by line range: Read file_path=%s offset=%d ...\n", refOrigin, nextAt ; }
				else { printf "... read the rest, lines %d to %d, by line range: Read file_path=%s offset=%d limit=%d ...\n", shown + 1, refLines, refPath, shown + 1, refLines - shown ; }
			}
		}' "$1"
}

## The lines a result closes with: its NEXT: lines, the exact call a tool that asks names last,
## `<tool> pending_id=<id>`, and the summing line of a batch (BatchTools). They stay a reply's last lines.
agentsReplyClosing='^NEXT: |^[A-Za-z_]+ pending_id=[^ ]+$|^BATCH-RESULT: '

## A result over agentsReplyLongBytes is kept whole in the session's results/ folder, and the
## reference to it is printed in its place. Any other result is printed as it is. The result's
## closing lines close the reply too, or else its own last line where that is short: that is
## where a result says how it ended (a job's status, Read's footer). With no session to keep it
## in, or a file that cannot be written, the result is printed whole: no result is lost to its reply.
AgentsTranscriptReplyLong(){ ## tool name, result text, the file a Read read (optional)
	local LC_ALL=C longDir longTool longFile="" longStamp longKey
	[ "${#2}" -gt "$agentsReplyLongBytes" ] || { printf '%s\n' "$2" ; return 0 ; }
	AgentsTranscriptSessionKeyInto longKey
	if ! AgentsTranscriptSessionDirInto longDir "$longKey" || ! mkdir -p "$longDir/results" 2>/dev/null ; then
		## A run with no session still has somewhere to put a long result: its own
		## sandbox, which its tools may already read. Without one, the result stays inline.
		longDir=""
		if [ -n "${MDAT_SPAWN_SANDBOX_ROOT:-}" ] && [ -d "${MDAT_SPAWN_SANDBOX_ROOT%/}" ] ; then
			longDir="${MDAT_SPAWN_SANDBOX_ROOT%/}"
		fi
		if [ -z "$longDir" ] || ! mkdir -p "$longDir/results" 2>/dev/null ; then
			printf '%s\n' "$2" ; return 0
		fi
	fi
	AgentsTranscriptBaseToolInto longTool "$1" ; longTool="${longTool//[!A-Za-z0-9_.-]/_}"
	AgentsTranscriptNowInto longStamp ; AgentsTranscriptUtcInto longStamp "$longStamp" compact
	longFile="$( mktemp "$longDir/results/$longStamp-${longTool:-tool}.XXXXXX" 2>/dev/null )" || longFile=""
	if [ -z "$longFile" ] || ! printf '%s\n' "$2" > "$longFile" 2>/dev/null || ! AgentsTranscriptReplyRef "$longFile" "${3:-}" ; then
		[ -z "$longFile" ] || rm -f "$longFile"
		printf '%s\n' "$2" ; return 0
	fi
	case "$2" in
		*$'\n'*)
			tail -n 5 "$longFile" | LC_ALL=C awk -v closing="$agentsReplyClosing" '{ line[ NR ] = $0 ; } END {
				from = NR + 1 ; while ( from > 1 && line[ from - 1 ] ~ closing ) { from-- ; }
				if ( from > NR && length( line[ NR ] ) <= 512 ) { from = NR ; }
				for ( n = from ; n <= NR ; n++ ) { print line[ n ] ; }
			}'
		;;
	esac
	return 0
}

## The host's local time as one `current-date:` line, in the form of every spawn record's
## started-at, `YYYY-MM-DD HH:MM +ZZZZ`: the content of the part a reply carries beside its
## result. The caller makes it a part of its own and puts it after the result; it is never
## written into the result, so the result's closing lines (agentsReplyClosing) stay last in it.
## The local time is the process clock's epoch moved by its zone (AgentsTranscriptNowInto), written by the civil-from-days rule
## (AgentsTranscriptUtcInto): no process. A zone not in date's own +ZZZZ form is left to date.
AgentsTranscriptReplyDate(){
	local dateNow dateZone dateLocal=""
	AgentsTranscriptNowInto dateNow
	dateZone="${agentsTranscriptClockZone:-}"
	case "$dateZone" in
		[+-][0-9][0-9][0-9][0-9]) ;;
		*) printf 'current-date: %s' "$( date '+%Y-%m-%d %H:%M %z' )" ; return 0 ;;
	esac
	AgentsTranscriptUtcInto dateLocal "$(( dateNow + ( 10#${dateZone:1:2} * 3600 + 10#${dateZone:3:2} * 60 ) * ${dateZone:0:1}1 ))"
	dateLocal="${dateLocal%:*}"
	printf 'current-date: %s %s' "${dateLocal/T/ }" "$dateZone"
}

## THE FLOOR ON A TOOL RETURN (F3.3, F9.1): every tool that returns delivers the floor's new messages with its result, and only
## the floor: a tool return never watches any other source. They are read from the session chat file, in the session's folder,
## from the run's pointer forward, with no network call (AgentsToolsSessionChatFloor, AgentsTools.SessionChat.include): the
## executor of the session is given every message of its thread, a participant the ones that tag or mention it, every run the
## replies to its own posts. Printed in full, each run of messages from one source behind a `# via <source>` line, and the
## pointer moves as they are printed, so the next return carries only what came after. Nothing is printed where the run has no
## session, no member, no file, or nothing new. Like the date it goes beside the result and never inside it.
AgentsTranscriptReplyFloor(){
	local floorKey floorMember floorText
	## The member of the run, as the served harness takes it: a native root caller is magic-coordinator's.
	floorMember="${harnessAgent:-${MDAT_SPAWN_AGENT:-magic-coordinator}}"
	[ -n "${MMDAPP:-}" ] || return 0
	type AgentsToolsSessionChatFloor > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionChat.include"
	floorKey="${MDAT_SESSION_ID:-${harnessSessionId:-${MDAT_SPAWN_SESSION_ID:-${CLAUDE_CODE_SESSION_ID:-}}}}"
	[ -n "$floorKey" ] || return 0
	## A workspace that is selected -- the tooling stands in its .local -- and a run with a session id: the session's folder is made

	## here, where it can be, before the run is served from it (F9.2). Without it those sessions lose their reads.
	[ ! -d "$MMDAPP/.local/agents" ] || [ -d "$MMDAPP/.local/agents/sessions/$floorKey" ] || { AgentsToolsSessionChatDir "$floorKey" > /dev/null && mkdir -p "$MMDAPP/.local/agents/sessions/$floorKey" 2> /dev/null ; } || :
	## THE THREAD IS KEPT OF INTEREST, AND FILLS THE FLOOR BETWEEN WAITS (S21.23). The session's own thread is marked of interest, so
	## the rig's own pull (AgentsToolsCommsCachePullWatched) keeps it fresh. A session the communications reader is not serving has
	## the messages the thread's cache holds, past what its chat file imported, brought into the file here (AgentsToolsSessionChatImport),
	## and no pull of its own: a reader never starts a refresh, so this return reaches no network.
	( local floorThread="" floorNow="" floorLooked="" floorSeen="" floorRender=""
	  ## The communications reader's own rule: where it is off, no read of a thread is made and none is started.
	  [ "${MDAT_COMMS_READER:-}" != "off" ] || exit 0
	  floorThread="$( AgentsToolsSessionChatThread "$floorKey" 2> /dev/null )" || floorThread=""
	  case "$floorThread" in *:*:*|'') exit 0 ;; esac
	  AgentsTranscriptNowInto floorNow
	  ## The member's pointer first, as the Wait's own chat source does: what the file holds before this fill is not new to it.
	  AgentsToolsSessionChatReaderInit "$floorKey" "$floorMember"
	  type AgentsToolsCommsCacheInterest > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.CommsCache.include"
	  AgentsToolsCommsCacheSlackDir "$floorMember" false "${floorThread%%:*}" "${floorThread#*:}" 2> /dev/null || exit 0
	  AgentsToolsCommsCacheInterest "$agentsCommsCacheDir" "$floorNow"
	  ## A reader that looked at this session lately fills its chat file itself: nothing is done here then.
	  floorLooked="$( AgentsToolsSessionChatReaderLooked "$floorKey" )"
	  case "$floorLooked" in ''|*[!0-9]*) floorLooked=0 ;; esac
	  [ $(( floorNow - floorLooked )) -ge 15 ] || exit 0
	  if AgentsToolsCommsCacheState "$agentsCommsCacheDir" ; then
		floorSeen="$( LC_ALL=C awk -F'\t' -v where="$floorThread" '
			function secOf(v) { sub(/\..*$/, "", v) ; return ( v == "" ? 0 : v + 0 ) ; }
			function fracOf(v) { if ( v !~ /\./ ) { return "000000" ; } ; sub(/^[^.]*\./, "", v) ; return substr(v "000000", 1, 6) ; }
			$3 == where && ( secOf($2) > secOf(best) || ( secOf($2) == secOf(best) && fracOf($2) > fracOf(best) ) ) { best = $2 ; }
			END { print best ; }' <<< "$( AgentsToolsSessionChatResolvedStream "$floorKey" 2> /dev/null )" 2> /dev/null )" || floorSeen=""
		## What the session holds is where its cache is served from: its newest block, else the moment of its first import, which is
		## the line the importer draws between history and what is new to it. Nothing older is brought in.
		if [ -z "$floorSeen" ] ; then floorSeen="$( AgentsToolsSessionChatPointer "$floorKey" "import:$floorThread" )" || floorSeen=0 ; fi
		if [ "$floorSeen" != "$agentsCommsCacheNewest" ] ; then
			floorRender="$( mktemp "$MMDAPP/.local/agents/sessions/$floorKey/fill.XXXXXX" 2> /dev/null )" || exit 0
			AgentsToolsCommsCacheServe "$agentsCommsCacheDir" "$floorSeen" nohead > "$floorRender" || { rm -f "$floorRender" ; exit 0 ; }
			AgentsToolsSessionChatImport "$floorKey" "$floorThread" "$floorRender" slack -
			rm -f "$floorRender"
			exit 0
		fi
	  fi
	  ## A STALE OR MISSING CACHE IS FILLED BY THE COMMS THREAD (the standing ruling): its interest is registered above, and no pull starts here.
	  exit 0
	) > /dev/null 2>&1 || :
	floorText="$( AgentsToolsSessionChatFloor "$floorKey" "$floorMember" "" deliver 2> /dev/null )" || floorText=""
	[ -z "$floorText" ] || printf '# new for you in your session (its floor), from its chat file:\n%s' "$floorText"
}

## What a reply carries beside its result: the host's time, and the floor's new messages where there are any.
AgentsTranscriptReplyBeside(){
	local besideFloor
	AgentsTranscriptReplyDate
	besideFloor="$( AgentsTranscriptReplyFloor )" || besideFloor=""
	[ -z "$besideFloor" ] || printf '\n%s' "$besideFloor"
}

## The reply to one tool result: kept when long. Skill and ToolSearch are never
## kept: an armed file, and the schema of a tool to be called, must reach the model whole.
## Neither is a Read of a kept result, which would only be kept again, so Read names the path
## it read. Nor is a Read given a range, `offset` or `limit` (the fourth argument, `ranged`): it
## returns its lines whole, within Read's own byte cap, which cuts at a whole line and names the
## offset to continue. A Read given neither is kept as any result is, and its hint reads the file
## it read (AgentsTranscriptReplyRef). Every other tool keeps the rule. An empty result stays
## empty, for its caller to report as the broken contract it is.
AgentsTranscriptReplyFinish(){ ## tool name, result text, path a Read read (optional), `ranged` for a Read given offset or limit (optional)
	local finishText="$2" finishBase
	[ -n "$2" ] || return 0
	AgentsTranscriptBaseToolInto finishBase "$1"
	case "$finishBase:${3:-}:${4:-}" in
		Skill:*|ToolSearch:*|Read:*/.local/agents/sessions/*/results/*) ;;
		Read:*:ranged) ;;
		*) finishText="$( AgentsTranscriptReplyLong "$1" "$2" "${3:-}" )" ;;
	esac
	printf '%s\n' "$finishText"
}

