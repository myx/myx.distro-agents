#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.DispatcherLoop.include -- the steps of the schedule the main loop takes at each iteration (F7.5): the autorun of the routines
## that declare one, the work-duty sessions the flags allow, and the learning inquiry for each session that ended. Sourced by
## AgentsTools.InternMainLoop.include, for its functions only; each step prints a line for each thing it did or could not do, and is never
## fatal. The decisions are Dispatcher's (AgentsTools.DispatcherSchedule.include): the loop only asks, and starts through the spawner. The chain of routines propels itself: a successor is due in the first iteration after its predecessor closed.
##
## THE FILES of the steps are $MMDAPP/.local/agents/schedule/: team-channel (when the team channel was last read and how far), tags/<member>
## (the newest message of the team channel that mentions that member), handed/<member> (the newest tag its duty was given) and handed-from/<member>
## (the pointer its new duty resumes from, kept before the give moves handed/<member>), duty/<member> (when its duty was last started), starting/<key>
## (a start made apart), dismissed/<spawn id> (a work-duty run already told to go) and learned/<session id> (a session already looked at for
## the learning inquiry). A SOURCE IS READ ONCE FOR ALL: a mention of a member lands in a shared source, the team channel, so it is read once
## in each TTL of the one table (AgentsToolsSourceTtlOf), with the newest of it kept, and every member's demand is derived from that one read;
## whatever the number of members, a TTL costs one Slack read of the source (F4.2: no source is polled by many members), and an iteration inside
## the TTL none.
##

type AgentsToolsScheduleDue > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.DispatcherSchedule.include"
type AgentsToolsSourceTtlOf > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.SourceTtl.include"
type AgentsToolsInboxDir > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/inbox/AgentsTools.InboxPlace.include"
type AgentsToolsSessionChatMemberId > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionChat.include"
type AgentsToolsSpawnSandboxRecordHeader > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SpawnSandbox.include"

agentsScheduleWorkDutyRoutine="magic-team.work-duty.routine.md"

## The work-duty routine of a member: its own `<member>.work-duty.routine.md` where its skill folder holds one (the coordinator's takes the advance rules), else the team's.
AgentsToolsScheduleDutyRoutine(){ ## member, its skill folder
	if [ -n "${2:-}" ] && [ -f "$2/$1.work-duty.routine.md" ] ; then
		printf '%s.work-duty.routine.md\n' "$1"
	else
		printf '%s\n' "$agentsScheduleWorkDutyRoutine"
	fi
}

## --- the starts ---

## A start through the spawner, in the background. The spawner runs the input scans of the routine before its member begins, and the work-duty
## scan collects over a window: a start made in the loop's own time would hold the iteration for it, one member after another. So it is made
## apart, its result kept in schedule/starting/<key>.rc and .out and said by the next iteration (AgentsToolsScheduleSpawnReport) if it
## failed. A start made in the last ten minutes that has not ended is not made again (schedule/starting/<key>). rc 1 for a start not made.
## A WORK-DUTY IS ONE SESSION WITH ONE THREAD. The start of a key `work-duty.<member>` brings the member into the session its previous
## start made (schedule/duty-session/<member>, the SESSION_ID that start printed), under --join-session, so the duty that starts
## again after a cache-keep, a demand or a tag posts into its thread and opens no new header in the team channel. The first start,
## and one after the proxy refused the join (the session is no longer known), starts a session and keeps its id.
AgentsToolsScheduleSpawn(){ ## key, the arguments of --spawn-session...
	local spawnKey="$1" spawnStore="$MMDAPP/.local/agents/schedule/starting" spawnDutySession="" spawnDutyFile=""
	shift
	case "$spawnKey" in
		work-duty.?*)
			spawnDutyFile="$MMDAPP/.local/agents/schedule/duty-session/${spawnKey#work-duty.}"
			[ ! -s "$spawnDutyFile" ] || IFS= read -r spawnDutySession < "$spawnDutyFile" || spawnDutySession=""
			case "$spawnDutySession" in ''|*[!A-Za-z0-9._-]*) spawnDutySession="" ;; esac
		;;
	esac
	mkdir -p "$spawnStore" 2> /dev/null || return 1
	[ -z "$( find "$spawnStore" -name "$spawnKey" -mmin -10 2> /dev/null )" ] || return 1
	( set -C ; : > "$spawnStore/$spawnKey" ) 2> /dev/null || return 1
	(
		spawnOut="$( DistroAgentsTools --spawn-session ${spawnDutySession:+--join-session "$spawnDutySession"} "$@" 2>&1 < /dev/null )" ; spawnRc=$?
		if [ -n "$spawnDutyFile" ] ; then
			if [ "$spawnRc" = 0 ] ; then
				spawnDutySession="$( printf '%s\n' "$spawnOut" | LC_ALL=C awk -F= '$1 == "SESSION_ID" { print $2 ; exit ; }' )"
				if [ -n "$spawnDutySession" ] ; then mkdir -p "${spawnDutyFile%/*}" 2> /dev/null && printf '%s\n' "$spawnDutySession" > "$spawnDutyFile" ; fi
			elif printf '%s\n' "$spawnOut" | LC_ALL=C grep -q -F 'refusing to join' ; then
				rm -f "$spawnDutyFile"
			fi
		fi
		printf '%s\n' "$spawnOut" > "$spawnStore/$spawnKey.out"
		printf '%s\n' "$spawnRc" > "$spawnStore/$spawnKey.rc"
		rm -f "$spawnStore/$spawnKey"
	) > /dev/null 2>&1 < /dev/null &
	disown "$!" 2> /dev/null || :
	return 0
}

## What the starts that ended since the last look came to: a line for each that failed, the first error it gave. Their files go.
AgentsToolsScheduleSpawnReport(){
	local reportStore="$MMDAPP/.local/agents/schedule/starting" reportFile reportKey reportRc
	for reportFile in "$reportStore"/*.rc ; do
		[ -f "$reportFile" ] || continue
		reportKey="${reportFile##*/}" ; reportKey="${reportKey%.rc}"
		IFS= read -r reportRc < "$reportFile" || reportRc=1
		## A start the routine's lock refused, because the routine is running already (on this host or another), is no failure: it is said nothing of.
		if [ "$reportRc" != 0 ] && ! LC_ALL=C grep -q -F 'the routine is already running: its locking document' "$reportStore/$reportKey.out" 2> /dev/null ; then
			printf 'schedule: the start of %s failed: %s\n' "$reportKey" "$( LC_ALL=C grep -m 1 'ERROR' "$reportStore/$reportKey.out" 2> /dev/null | LC_ALL=C cut -c1-200 )"
		fi
		rm -f "$reportFile" "$reportStore/$reportKey.out"
	done
	return 0
}

## --- the autorun ---

## Every routine file with a runs-at is asked whether it is due (AgentsToolsScheduleDue); a routine that is due is started through the
## spawner, `--spawn-session --routine <file>`, which takes the routine's lock as it declares (F6.2) and starts its own executors. A
## routine whose executors are any member is not started here: the spawner starts it only with members named. A chain that stopped says
## ESCALATE; a predecessor that names no routine says so; a chain that merely waits for its predecessor is quiet.
AgentsToolsScheduleAutorun(){
	local autoMember autoDir autoFile autoName autoRunsAt autoOut autoRc autoExecutors autoLine
	while IFS=$'\t' read -r autoMember autoDir ; do
		[ -n "$autoDir" ] || continue
		for autoFile in "$autoDir"/*.routine.md ; do
			[ -f "$autoFile" ] || continue
			autoRunsAt="$( AgentsToolsRoutineKeyOwn "$autoFile" runs-at )"
			case "$autoRunsAt" in ''|none) continue ;; esac
			autoName="${autoFile##*/}"
			autoRc=0
			autoOut="$( AgentsToolsScheduleDue --routine-due "$autoName" 2> /dev/null )" || autoRc=$?
			while IFS= read -r autoLine ; do
				case "$autoLine" in
					ESCALATE:*) printf 'autorun: %s\n' "$autoLine" ;;
					"REFUSED: "*"names no routine") printf 'autorun: %s\n' "$autoLine" ;;
				esac
			done <<< "$autoOut"
			[ "$autoRc" = 0 ] || continue
			autoExecutors="$( AgentsToolsSpawnRoutineFrontmatter "$autoFile" "$( AgentsToolsSpawnRoutineKindPath "$autoFile" )" | LC_ALL=C sed -n 's/^executors: //p' | head -1 )"
			case "$autoExecutors" in ''|"magic-team"|"*") continue ;; esac
			if AgentsToolsScheduleSpawn "$autoName" --routine "$autoName" ; then
				printf 'autorun: started %s\n' "$autoName"
			fi
		done
	done <<< "$( AgentsToolsTeamMemberDirectoryText )"
	return 0
}

## --- the work duty ---

## The live work-duty run of a member: the record of a run of a work-duty routine (the team's or its own) that the member owns, started and still a process.
## Prints the record path; rc 1 for none.
AgentsToolsScheduleWorkDutyRecord(){ ## member
	local dutyRecord dutySpawn
	while IFS= read -r dutyRecord ; do
		[ -f "$dutyRecord" ] || continue
		[ "$( AgentsToolsSpawnSandboxRecordHeader "$dutyRecord" owner )" = "$1" ] && [ "$( AgentsToolsSpawnSandboxRecordHeader "$dutyRecord" status )" = "spawn-started" ] || continue
		dutySpawn="${dutyRecord##*/}" ; dutySpawn="${dutySpawn%.spawn.md}"
		type AgentsToolsRegistrySpawnRuns > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.Registries.include"
		AgentsToolsRegistrySpawnRuns "$dutySpawn" "$dutyRecord" || continue
		printf '%s\n' "$dutyRecord"
		return 0
	done <<< "$( LC_ALL=C grep -l -E '^routine: [A-Za-z0-9-]+\.work-duty\.routine\.md$' "$MMDAPP/.local/agents/spawned"/*/*.spawn.md 2> /dev/null )"
	return 1
}

## The team channel, read once for every member there is to look for: the messages after the last read, and for each member the newest that
## mentions it (`<@its Slack id>` or `@its name`), kept in tags/<member>. No read at all inside the TTL of the source, and none made for nobody.
## The first look reads from now: what stood there before is not news. A read that fails is tried again after the TTL. <force> yes is the
## per-member sync's (AgentsTools.Incoming.include): the tags are read now, whatever the TTL, for the members given.
AgentsToolsScheduleTeamTags(){ ## the members to look for, spaced; force (yes|no)
	type AgentsToolsSeenReact > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.SeenReaction.include"
	type AgentsToolsTrackingDrop > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.TrackingDrop.include"
	local teamStore="$MMDAPP/.local/agents/schedule" teamNow teamTtl teamAt="" teamFloor="" teamOut teamTemp teamMember teamId teamNewest teamHit teamOne teamIdList=""
	[ -n "${1// /}" ] || return 0
	teamNow="$( date +%s )"
	## The cache TTL of the tags and mentions (T2): one minute, the low end of the 1-5 minute band. It is the schedule's own cadence,
	## not the live Wait floor (AgentsToolsSourceTtlOf tagged:* stays 15): the team channel that feeds the tags is re-read at most once
	## a minute for all the members, whatever the number of them.
	teamTtl=60
	[ "${2:-no}" != "yes" ] || teamTtl=0
	[ ! -f "$teamStore/team-channel" ] || read -r teamAt teamFloor < "$teamStore/team-channel" || :
	case "$teamAt" in ''|*[!0123456789]*) teamAt="" ;; esac
	[ -z "$teamAt" ] || [ $(( teamNow - teamAt )) -ge "$teamTtl" ] || return 0
	mkdir -p "$teamStore/tags" 2> /dev/null || return 0
	[ -n "$teamFloor" ] || teamFloor="$teamNow.000000"
	## The accounts of the members, before the read: a read that names a person rewrites the cache they come from.
	for teamMember in $1 ; do teamIdList="$teamIdList $teamMember=$( AgentsToolsSessionChatMemberId "$teamMember" )" ; done
	teamOut="$( DistroAgentsTools --intern-op-comms-slack-read magic-coordinator magic-team --oldest "$teamFloor" 2> /dev/null < /dev/null )" || teamOut=""
	teamNewest="$( printf '%s\n' "$teamOut" | LC_ALL=C awk -v floor="$teamFloor" '/^[0-9]+\.[0-9]+ \| / { if ( $1 + 0 > floor + 0 ) { newest = $1 } } END { print newest }' )"
	for teamMember in $1 ; do
		teamId="${teamIdList#* $teamMember=}" ; teamId="${teamId%% *}"
		## What the tooling posted itself is no mention (AgentsToolsTrackingDrop), nor is the member's own post.
		teamHit="$( printf '%s\n' "$teamOut" | AgentsToolsTrackingDrop "$teamMember" | MEMBER="$teamMember" MEMBER_ID="$teamId" FLOOR="$teamFloor" LC_ALL=C awk '
			/^[0-9]+\.[0-9]+ \| / {
				own = ( index( $0, "[sender: " ENVIRON["MEMBER"] "]" ) > 0 )
				if ( $1 + 0 <= ENVIRON["FLOOR"] + 0 || own ) next
				if ( ENVIRON["MEMBER_ID"] != "" && index( $0, "<@" ENVIRON["MEMBER_ID"] ">" ) > 0 ) { hit = $1 ; all = all " " $1 }
				else if ( index( $0, "@" ENVIRON["MEMBER"] ) > 0 ) { hit = $1 ; all = all " " $1 }
			}
			END { print hit "|" all }' )"
		## Every mention found is read the moment it is noticed: the seen reaction is the tooling's (AgentsTools.SeenReaction.include).
		for teamOne in ${teamHit#*|} ; do AgentsToolsSeenReact "$teamMember" "magic-team:$teamOne" || : ; done
		teamHit="${teamHit%%|*}"
		AgentsToolsScheduleTagNote "$teamMember" "$teamHit"
	done
	if teamTemp="$( mktemp "$teamStore/team-channel.XXXXXX" 2> /dev/null )" ; then
		printf '%s %s\n' "$teamNow" "${teamNewest:-$teamFloor}" > "$teamTemp" && mv -f "$teamTemp" "$teamStore/team-channel" || rm -f "$teamTemp"
	fi
	return 0
}

## Whether the inbox of a member holds work: an item in incoming/ that is no standing state-and-lock note (the notes of the routines that lock stand
## in the coordinator's incoming/ and are no work).
AgentsToolsScheduleHasWork(){ ## member
	local workFile
	for workFile in "$( AgentsToolsInboxDir "$1" )"/* ; do
		[ -e "$workFile" ] || continue
		case "${workFile##*/}" in note-*-state-and-lock.md) continue ;; esac
		return 0
	done
	return 1
}

## Whether the board has something new for the coordinator's duty (F7.12): an item of the active states (the spawner's own dispatch-* tracking items aside,
## which are written at every start and end and are no news) written since the last duty ended, or an item whose recheck-date fell due since. The
## baseline is the modification time of the duty's lock note, written at the close of a duty; with no note, any such item is news. rc 0 where there is.
AgentsToolsScheduleBoardDemand(){
	local boardNote boardBase=0 boardNow boardState boardFile boardFiles=() boardRows boardEpoch
	boardNote="$( AgentsToolsInboxNotePath magic-coordinator note-20261020T000000Z-work-duty-state-and-lock.md )"
	boardNow="$( date +%s )"
	if [ -f "$boardNote" ] ; then
		boardBase="$( stat -f '%m' "$boardNote" 2> /dev/null )" || boardBase=""
		case "$boardBase" in ''|*[!0123456789]*) boardBase="$( stat -c '%Y' "$boardNote" 2> /dev/null )" || boardBase="" ;; esac
		case "$boardBase" in ''|*[!0123456789]*) boardBase=0 ;; esac
	fi
	for boardState in pending running review blocked parked ; do
		for boardFile in "$MDAT_DATA_ROOT/board/$boardState"/*.md ; do
			[ -f "$boardFile" ] || continue
			case "${boardFile##*/}" in dispatch-*) continue ;; esac
			boardFiles+=( "$boardFile" )
		done
	done
	[ "${#boardFiles[@]}" -gt 0 ] || return 1
	if [ -f "$boardNote" ] ; then
		[ -z "$( find "${boardFiles[@]}" -newer "$boardNote" 2> /dev/null | head -n 1 )" ] || return 0
	else
		return 0
	fi
	boardRows="$( LC_ALL=C awk 'FNR == 1 { fm = ( $0 == "---" ) ; next } fm && $0 == "---" { fm = 0 ; next } fm && index( $0, "recheck-date: " ) == 1 { print substr( $0, 15 ) }' "${boardFiles[@]}" 2> /dev/null | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/output/LocalIsoToEpoch.awk" 2> /dev/null )"
	while IFS= read -r boardEpoch ; do
		case "$boardEpoch" in ''|*[!0123456789]*) continue ;; esac
		[ "$boardEpoch" -gt "$boardBase" ] && [ "$boardEpoch" -le "$boardNow" ] && return 0
	done <<< "$boardRows"
	return 1
}

## THE TAGGED SOURCE OF A MEMBER, as the scheduler holds it: the newest message that calls the member (a mention in the team channel, or a DM to it --
## the two are one source, `tagged:<member>`, and the untagged team channel is another) in tags/<member>, a Slack ts; and the member's own pointer into it,
## handed/<member>, the ts of the newest one its duty was given -- set when a duty is started for it, and moved by the pointer the duty's own session keeps
## (collect:<member>:tagged:<member> in its session.chat.pointers). A tag is news when it is newer than that pointer. The channel is read once for every
## member (AgentsToolsScheduleTeamTags), the DMs once for each (AgentsToolsScheduleDmTags): a cache that feeds each member's own pointer, never one for all.
AgentsToolsScheduleTagNote(){ ## member, ts found (may be empty)
	local noteOld=""
	[ -n "$2" ] || return 0
	[ ! -f "$MMDAPP/.local/agents/schedule/tags/$1" ] || read -r noteOld < "$MMDAPP/.local/agents/schedule/tags/$1" || :
	case "${noteOld%%.*}" in ''|*[!0123456789]*) noteOld=0 ;; esac
	[ "${2%%.*}" -gt "${noteOld%%.*}" ] || return 0
	mkdir -p "$MMDAPP/.local/agents/schedule/tags" 2> /dev/null && printf '%s\n' "$2" > "$MMDAPP/.local/agents/schedule/tags/$1"
}

## The seconds of a member's pointer into its tagged source: the scheduler's (handed/<member>), and the one the live duty's session keeps, whichever is later.
AgentsToolsScheduleTagPointer(){ ## member, the duty's session id (may be empty)
	local pointerOwn="" pointerSession=""
	[ ! -f "$MMDAPP/.local/agents/schedule/handed/$1" ] || read -r pointerOwn < "$MMDAPP/.local/agents/schedule/handed/$1" || :
	case "${pointerOwn%%.*}" in ''|*[!0123456789]*) pointerOwn=0 ;; esac
	pointerOwn="${pointerOwn%%.*}"
	if [ -n "${2:-}" ] ; then
		type AgentsToolsSessionChatPointer > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionChat.include" 2> /dev/null || :
		pointerSession="$( AgentsToolsSessionChatPointer "$2" "collect:$1:tagged:$1" 2> /dev/null )" || pointerSession=""
		case "${pointerSession%%.*}" in ''|*[!0123456789]*) pointerSession=0 ;; esac
		pointerSession="${pointerSession%%.*}"
		[ "$pointerSession" -le "$pointerOwn" ] || pointerOwn="$pointerSession"
	fi
	printf '%s\n' "$pointerOwn"
}

## The duty is given what stands in the tagged source: the member's pointer moves to the newest tag.
AgentsToolsScheduleTagGive(){ ## member
	local giveTag=""
	[ ! -f "$MMDAPP/.local/agents/schedule/tags/$1" ] || read -r giveTag < "$MMDAPP/.local/agents/schedule/tags/$1" || :
	[ -n "$giveTag" ] || return 0
	mkdir -p "$MMDAPP/.local/agents/schedule/handed" 2> /dev/null && printf '%s\n' "$giveTag" > "$MMDAPP/.local/agents/schedule/handed/$1"
}

## The pointer the new duty resumes from, kept for the duty's own scan (AgentsTools.InternOpWorkDuty.include) before the give moves the member's
## pointer (handed/<member>) to the newest tag: the member's previous pointer, so a mention that arrived between the previous duty and this start is
## read by the new duty rather than skipped as "before now". Run at each start, whatever the give then does.
AgentsToolsScheduleTagCarry(){ ## member
	local carryFrom=""
	[ ! -f "$MMDAPP/.local/agents/schedule/handed/$1" ] || read -r carryFrom < "$MMDAPP/.local/agents/schedule/handed/$1" || :
	case "${carryFrom%%.*}" in ''|*[!0123456789]*) return 0 ;; esac
	mkdir -p "$MMDAPP/.local/agents/schedule/handed-from" 2> /dev/null && printf '%s\n' "$carryFrom" > "$MMDAPP/.local/agents/schedule/handed-from/$1"
}

## Whether the tagged source of a member holds a tag newer than its pointer (AgentsToolsScheduleTagPointer) and than an instant (epoch seconds, optional): a
## tag is how the member is called, at any hour. An untagged message of the channel is read by the work-duty scan in worktime, and by nothing else.
AgentsToolsScheduleTagNews(){ ## member, since (epoch seconds, may be empty), the duty's session id (may be empty)
	local newsTag="" newsFloor
	[ ! -f "$MMDAPP/.local/agents/schedule/tags/$1" ] || read -r newsTag < "$MMDAPP/.local/agents/schedule/tags/$1" || :
	case "${newsTag%%.*}" in ''|*[!0123456789]*) return 1 ;; esac
	newsFloor="$( AgentsToolsScheduleTagPointer "$1" "${3:-}" )"
	case "${2:-0}" in *[!0123456789]*) ;; *) [ "${2:-0}" -le "$newsFloor" ] || newsFloor="${2:-0}" ;; esac
	[ "${newsTag%%.*}" -gt "$newsFloor" ]
}

## The DMs of the members, looked at for each member on its own (a DM is a call by name, as a mention is): the conversations of the member's accounts
## (the roster of its direct ones), each read from the member's DM floor, dms/<member>, the ts up to which they were read -- a member's first look reads
## from now, as the channel's does. At most once in a minute for a member within its flags, once in five minutes out of them (the Slack read budget: every
## standing member is looked at then). What the tooling posted itself and the member's own posts are none. The newest DM message goes into the member's
## tagged source (AgentsToolsScheduleTagNote). <force> yes is the per-member sync's (AgentsTools.Incoming.include): the DMs are read now, whatever the
## TTL, for the members given.
AgentsToolsScheduleDmTags(){ ## the members within their flags to look for, spaced; the members out of them, spaced; force (yes|no)
	local dmStore="$MMDAPP/.local/agents/schedule" dmMember dmNow dmChecked dmFloor dmRoster dmLine dmConv dmKind dmIdentity dmArg dmSeen dmRead dmNewest dmId dmTtl dmOne
	## agentsScheduleDmNewest is the newest DM this call found, empty for none: the per-member sync's line (AgentsTools.Incoming.include).
	agentsScheduleDmNewest=""
	[ -n "$1$2" ] || return 0
	type AgentsToolsTrackingDrop > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.TrackingDrop.include"
	type AgentsToolsSeenReact > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.SeenReaction.include"
	dmNow="$( date +%s )"
	mkdir -p "$dmStore/dms" "$dmStore/dm-looked" 2> /dev/null || return 0
	for dmMember in $1 $2 ; do
		dmTtl=60
		case " $2 " in *" $dmMember "*) dmTtl=300 ;; esac
		[ "${3:-no}" != "yes" ] || dmTtl=0
		dmChecked=""
		[ ! -f "$dmStore/dm-looked/$dmMember" ] || read -r dmChecked < "$dmStore/dm-looked/$dmMember" || :
		case "$dmChecked" in ''|*[!0123456789]*) dmChecked="" ;; esac
		[ -z "$dmChecked" ] || [ $(( dmNow - dmChecked )) -ge "$dmTtl" ] || continue
		printf '%s\n' "$dmNow" > "$dmStore/dm-looked/$dmMember"
		dmFloor=""
		[ ! -f "$dmStore/dms/$dmMember" ] || read -r dmFloor < "$dmStore/dms/$dmMember" || :
		[ -n "$dmFloor" ] || dmFloor="$dmNow.000000"
		dmId="$( AgentsToolsSessionChatMemberId "$dmMember" )"
		dmRoster="$( DistroAgentsTools --slack-conversations-roster "$dmMember" --types im 2> /dev/null < /dev/null )" || dmRoster=""
		dmSeen="" dmNewest=""
		while IFS= read -r dmLine ; do
			case "$dmLine" in "CONV|"*) ;; *) continue ;; esac
			dmConv="" dmKind="" dmIdentity=""
			for dmArg in $( printf '%s\n' "$dmLine" | LC_ALL=C tr '|' ' ' ) ; do
				case "$dmArg" in
					id=*) dmConv="${dmArg#id=}" ;;
					kind=*) dmKind="${dmArg#kind=}" ;;
					identity=*) dmIdentity="${dmArg#identity=}" ;;
				esac
			done
			[ -n "$dmConv" ] && [ "$dmKind" = "im" ] || continue
			case " $dmSeen " in *" $dmConv "*) continue ;; esac
			dmSeen="$dmSeen $dmConv"
			dmRead="$( DistroAgentsTools --intern-op-comms-slack-read "$dmMember" "$dmConv" $( [ "$dmIdentity" != "bot" ] || printf '%s' --identity-bot ) --oldest "$dmFloor" 2> /dev/null < /dev/null )" || continue
			dmRead="$( printf '%s\n' "$dmRead" | AgentsToolsTrackingDrop "$dmMember" | DM_FLOOR="$dmFloor" DM_MEMBER="$dmMember" DM_ID="$dmId" LC_ALL=C awk '
				/^[0-9]+\.[0-9]+ \| / {
					if ( $1 + 0 <= ENVIRON["DM_FLOOR"] + 0 ) next
					if ( index( $0, "[sender: " ENVIRON["DM_MEMBER"] "]" ) > 0 ) next
					if ( ENVIRON["DM_ID"] != "" && index( $0, $1 " | " ENVIRON["DM_ID"] " |" ) == 1 ) next
					if ( $1 + 0 > newest + 0 ) newest = $1
					all = all " " $1
				}
				END { print newest "|" all }' )"
			## Every DM found is read the moment it is noticed: the seen reaction is the tooling's (AgentsTools.SeenReaction.include).
			for dmOne in ${dmRead#*|} ; do AgentsToolsSeenReact "$dmMember" "$dmConv:$dmOne" || : ; done
			dmRead="${dmRead%%|*}"
			if [ -n "$dmRead" ] ; then
				if [ -z "$dmNewest" ] || [ "${dmRead%%.*}" -gt "${dmNewest%%.*}" ] ; then dmNewest="$dmRead" ; fi
			fi
		done <<< "$dmRoster"
		if [ -n "$dmNewest" ] ; then
			agentsScheduleDmNewest="$dmNewest"
			printf '%s\n' "$dmNewest" > "$dmStore/dms/$dmMember"
			AgentsToolsScheduleTagNote "$dmMember" "$dmNewest"
		elif [ ! -f "$dmStore/dms/$dmMember" ] ; then
			printf '%s\n' "$dmFloor" > "$dmStore/dms/$dmMember"
		fi
	done
	return 0
}

## Whether a member has something to work on: an item in its inbox not yet processed (incoming/), for the coordinator also the board's news, or a
## mention in the team channel newer than the last start of its duty (tags/<member> against duty/<member>, both in epoch seconds).
AgentsToolsScheduleDemand(){ ## member
	! AgentsToolsScheduleHasWork "$1" || return 0
	[ "$1" != magic-coordinator ] || ! AgentsToolsScheduleBoardDemand || return 0
	AgentsToolsScheduleTagNews "$1"
}

## Tells a work-duty run to go, with DISMISSED in its session thread, as a dismissal is given to a run: at its idle point only (the run
## sits in a Wait, AgentsToolsManagerRunActivity), never while it works, never twice, and not while runs that need it still run. The
## sender is a member other than the one dismissed, whose own Wait ignores a DISMISSED it authored.
AgentsToolsScheduleDismiss(){ ## spawn record, why (a clause of the line printed)
	local dismissRecord="$1" dismissWhy="${2:-it has no more duty}" dismissSpawn dismissMember dismissThread="" dismissBy dismissStore="$MMDAPP/.local/agents/schedule/dismissed" dismissStat=""
	dismissSpawn="${dismissRecord##*/}" ; dismissSpawn="${dismissSpawn%.spawn.md}"
	[ ! -e "$dismissStore/$dismissSpawn" ] || return 0
	type AgentsToolsManagerRunActivity > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/manager/AgentsTools.ManagerSession.include" --definitions-only > /dev/null 2>&1 || :
	if stat -f '%m' / > /dev/null 2>&1 ; then dismissStat="bsd" ; elif stat -c '%Y' / > /dev/null 2>&1 ; then dismissStat="gnu" ; fi
	[ "$( AgentsToolsManagerRunActivity "$dismissSpawn" "$dismissStat" )" = "waiting" ] || return 0
	AgentsToolsSessionDismissHeld "$dismissRecord" > /dev/null && return 0
	dismissMember="$( AgentsToolsSpawnSandboxRecordHeader "$dismissRecord" owner )"
	dismissThread="$( AgentsToolsSpawnSandboxRecordHeader "$dismissRecord" session-thread )"
	if [ -z "$dismissThread" ] || [ "$dismissThread" = "-" ] ; then
		dismissThread=""
		[ ! -f "${dismissRecord%/*}/session.thread" ] || IFS= read -r dismissThread < "${dismissRecord%/*}/session.thread" || :
	fi
	AgentsToolsSpawnConversationThreadValid "$dismissThread" || { printf 'work-duty: %s of %s is not told to go: it has no session thread to post in\n' "$dismissSpawn" "$dismissMember" ; return 0 ; }
	dismissBy=magic-coordinator
	[ "$dismissMember" != magic-coordinator ] || dismissBy=magic-librarian
	mkdir -p "$dismissStore" 2> /dev/null || return 0
	( set -C ; : > "$dismissStore/$dismissSpawn" ) 2> /dev/null || return 0
	if printf 'DISMISSED' | DistroAgentsTools --intern-op-comms-slack-send-message "$dismissBy" "$dismissThread" --identity-bot --address-to "$dismissMember" --from-stdin > /dev/null 2>&1 ; then
		printf 'work-duty: %s of %s is told to go (DISMISSED, at its idle point): %s\n' "$dismissSpawn" "$dismissMember" "$dismissWhy"
	else
		rm -f "$dismissStore/$dismissSpawn"
		printf 'work-duty: %s of %s could not be told to go: the post failed, tried again at the next iteration\n' "$dismissSpawn" "$dismissMember"
	fi
	return 0
}

## Whether a member of the roster is a standing member: a member of the team (magic, keeper, warden, partner or client) that is not an identity
## record (human-owner) and not the team itself; the oncall and expert ones are no standing members.
AgentsToolsScheduleStanding(){ ## member, its directory
	case "$1" in
		magic-team) return 1 ;;
		magic-*|keeper-*|warden-*|partner-*|client-*) ;;
		*) return 1 ;;
	esac
	! AgentsToolsTeamMemberReferenceOnly "$2"
}

## The cache of a run, from its own log: what the harness said of the shared prefix on its last wake or rewind (round 1 of its leg, F10.7). `read`
## where the prefix was read from the cache; `nothing` where it was written or cached nothing, so that the wake read nothing from the cache;
## `unknown` where no such line is known (a native CLI prints none, a run just begun has none).
AgentsToolsScheduleDutyCache(){ ## spawn record
	local cacheFile cacheLine
	cacheFile="$( AgentsToolsSpawnSandboxRecordHeader "$1" output-file )"
	[ -n "$cacheFile" ] && [ -f "$cacheFile" ] || { printf 'unknown\n' ; return 0 ; }
	cacheLine="$( LC_ALL=C grep -a -F 'shared prefix -- round 1 ' "$cacheFile" 2> /dev/null | tail -n 1 )"
	case "$cacheLine" in
		*'round 1 read '*) printf 'read\n' ;;
		*'round 1 wrote '*|*'round 1 cached nothing'*) printf 'nothing\n' ;;
		*) printf 'unknown\n' ;;
	esac
}

## Whether a member takes part in a session besides its duty: a live run needs its duty (AgentsToolsSessionDismissHeld: its session's executor with others
## running, a run reporting to it) or another run of the member is live, any routine but its work-duty. rc 0 where it does.
AgentsToolsScheduleInSession(){ ## the duty's spawn record, member
	local sessionOther
	! AgentsToolsSessionDismissHeld "$1" > /dev/null || return 0
	while IFS= read -r sessionOther ; do
		[ -f "$sessionOther" ] && [ "$sessionOther" != "$1" ] || continue
		[ "$( AgentsToolsSpawnSandboxRecordHeader "$sessionOther" status )" = "spawn-started" ] || continue
		case "$( AgentsToolsSpawnSandboxRecordHeader "$sessionOther" routine )" in *.work-duty.routine.md) continue ;; esac
		AgentsToolsSessionRecordLive "$sessionOther" && return 0
	done <<< "$( LC_ALL=C grep -l -x -F "owner: $2" "$MMDAPP/.local/agents/spawned"/*/*.spawn.md 2> /dev/null )"
	return 1
}

## How long a duty lives, decided at each iteration for a duty that is in its Wait (never one that works; a dismissal is given at an idle point only).
## It stays while the flags allow it (worktime; for the coordinator also emergency and overtime). Out of them it stays while it has input -- an item for
## it, for the coordinator the board's news -- or takes part in a session, and ends after an hour idle (3600). Whatever the flags, a duty whose last
## wake read nothing from the cache (AgentsToolsScheduleDutyCache) ends after 20 minutes idle (1200): each of its wakes would be paid whole. Where no
## cache figure is known the flags decide alone. Idle: since the first `wait going idle` line of the stretch that ends its milestones.
AgentsToolsScheduleDutyLifetime(){ ## the duty's spawn record, member, whether the flags allow (yes|no)
	local lifeRecord="$1" lifeMember="$2" lifeAllowed="$3" lifeSpawn lifeStat="" lifeSince lifeIdle lifeLimit="" lifeWhy
	lifeSpawn="${lifeRecord##*/}" ; lifeSpawn="${lifeSpawn%.spawn.md}"
	type AgentsToolsManagerRunIdleSince > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/manager/AgentsTools.ManagerSession.include" --definitions-only > /dev/null 2>&1 || :
	type AgentsToolsManagerRunIdleSince > /dev/null 2>&1 || return 0
	if stat -f '%m' / > /dev/null 2>&1 ; then lifeStat="bsd" ; elif stat -c '%Y' / > /dev/null 2>&1 ; then lifeStat="gnu" ; fi
	lifeSince="$( AgentsToolsManagerRunIdleSince "$lifeSpawn" "$lifeStat" )" || return 0
	lifeIdle=$(( $( date +%s ) - lifeSince ))
	if [ "$( AgentsToolsScheduleDutyCache "$lifeRecord" )" = nothing ] ; then
		lifeLimit=1200 ; lifeWhy="its last wake read nothing from the cache, and it was idle $(( lifeIdle / 60 )) minutes"
	elif [ "$lifeAllowed" != yes ] ; then
		! AgentsToolsScheduleHasWork "$lifeMember" || return 0
		[ "$lifeMember" != magic-coordinator ] || ! AgentsToolsScheduleBoardDemand || return 0
		! AgentsToolsScheduleInSession "$lifeRecord" "$lifeMember" || return 0
		! AgentsToolsScheduleTagNews "$lifeMember" "$lifeSince" "$( AgentsToolsSpawnSandboxRecordHeader "$lifeRecord" session-id )" || return 0
		lifeLimit=3600 ; lifeWhy="out of worktime with no input, and it was idle $(( lifeIdle / 60 )) minutes"
	fi
	[ -n "$lifeLimit" ] && [ "$lifeIdle" -ge "$lifeLimit" ] || return 0
	AgentsToolsScheduleDismiss "$lifeRecord" "$lifeWhy"
}

## The work-duty sessions by the flags (epic 1758-1763): a standing member holds one during worktime, magic-coordinator during worktime,
## emergency and overtime. A standing member is every member of the roster but an identity record (human-owner) and the oncall and expert
## ones, who are no standing members. One is started when its member has something to work on (AgentsToolsScheduleDemand), the work-duty
## routine, `--spawn-session --routine <work-duty> <member>`; not while the member holds one already. Out of its flags a member is called by name only:
## a mention of it in the team channel (AgentsToolsScheduleTagNews) starts its duty at any hour, and an untagged message, an inbox item or the board's news do
## not; the team channel is read once in a TTL for all of them. What the flags do to a run that stands is not a dismissal at once:
## AgentsToolsScheduleDutyLifetime decides, at each iteration, how long it lives (a mention newer than its idle start keeps it, out of its flags too).
AgentsToolsScheduleWorkDuty(){
	local dutyFlags dutyWork=no dutyCoordinator=no dutyMember dutyDir dutyAllowed dutyRecord dutyLook="" dutyLookOut="" dutyWhy="" dutyWarmAt=""
	dutyFlags="$( AgentsToolsScheduleCurrentFlags --current-flags 2> /dev/null )" || dutyFlags=""
	case "$dutyFlags" in *"worktime: yes"*) dutyWork=yes ; dutyCoordinator=yes ;; esac
	case "$dutyFlags" in *"emergency: yes"*|*"overtime: yes"*) dutyCoordinator=yes ;; esac
	## The members whose mentions are looked for: those within their flags that have no duty running -- a member with inbox work is looked at too, so a
	## mention that arrives while its work waits is kept for its duty -- and every standing member out of its flags, for a mention starts or keeps its
	## duty. The team channel is read once for all.
	while IFS=$'\t' read -r dutyMember dutyDir ; do
		[ -n "$dutyDir" ] || continue
		AgentsToolsScheduleStanding "$dutyMember" "$dutyDir" || continue
		dutyAllowed="$dutyWork"
		[ "$dutyMember" != magic-coordinator ] || dutyAllowed="$dutyCoordinator"
		if [ "$dutyAllowed" = yes ] ; then
			! AgentsToolsScheduleWorkDutyRecord "$dutyMember" > /dev/null || continue
			dutyLook="$dutyLook $dutyMember"
		else
			dutyLookOut="$dutyLookOut $dutyMember"
		fi
	done <<< "$( AgentsToolsTeamMemberDirectoryText )"
	AgentsToolsScheduleTeamTags "${dutyLook# } ${dutyLookOut# }"
	AgentsToolsScheduleDmTags "${dutyLook# }" "${dutyLookOut# }"
	while IFS=$'\t' read -r dutyMember dutyDir ; do
		[ -n "$dutyDir" ] || continue
		AgentsToolsScheduleStanding "$dutyMember" "$dutyDir" || continue
		dutyAllowed="$dutyWork"
		[ "$dutyMember" != magic-coordinator ] || dutyAllowed="$dutyCoordinator"
		dutyRecord="$( AgentsToolsScheduleWorkDutyRecord "$dutyMember" )" || dutyRecord=""
		if [ -n "$dutyRecord" ] ; then
			AgentsToolsScheduleDutyLifetime "$dutyRecord" "$dutyMember" "$dutyAllowed"
			continue
		fi
		dutyWhy=""
		## A WORK-DUTY STARTS ON FIRST DEMAND AND IS NEVER STARTED TO KEEP A CACHE WARM (sketch 10.4, 7.3): it is a loop in one session, and
		## its cache is kept inside that session by the keepalive round of its --idle-wait, never by ending the run and starting another.
		## The session a duty keeps for its restarts (AgentsToolsScheduleSpawn) ends with worktime: out of its flags, with no duty running,
		## the member's kept id goes, and its next worktime opens a session of its own.
		if [ "$dutyAllowed" = yes ] ; then
			AgentsToolsScheduleDemand "$dutyMember" || continue
		else
			rm -f "$MMDAPP/.local/agents/schedule/duty-session/$dutyMember" 2> /dev/null || :
			## Out of its flags: a tag (a mention, a DM) newer than its pointer into the tagged source, and nothing else.
			AgentsToolsScheduleTagNews "$dutyMember" || continue
		fi
		if AgentsToolsScheduleSpawn "work-duty.$dutyMember" --routine "$( AgentsToolsScheduleDutyRoutine "$dutyMember" "$dutyDir" )" "$dutyMember" ; then
			mkdir -p "$MMDAPP/.local/agents/schedule/duty" 2> /dev/null && date +%s > "$MMDAPP/.local/agents/schedule/duty/$dutyMember"
			AgentsToolsScheduleTagCarry "$dutyMember"
			AgentsToolsScheduleTagGive "$dutyMember"
			printf 'work-duty: started the duty of %s%s\n' "$dutyMember" "$dutyWhy"
		fi
	done <<< "$( AgentsToolsTeamMemberDirectoryText )"
	return 0
}

## --- important and emergency inputs (T3) ---

## The coordinator's incoming checked for items marked important or emergency (T3 of the 20261021 refactorings epic): an item of
## magic-coordinator's incoming/ whose frontmatter carries `mark: important` or `mark: emergency`. An important item is spawned for; an
## emergency item is confirmed with the owner and sets the emergency flag. In worktime the work-duty step already starts the coordinator on its
## inbox work; out of it the advance routine, the one-shot handling block, is started instead. Never fatal; one line for each thing done.
AgentsToolsScheduleImportantEmergency(){
	local markFlags markWork=no markFile markMark markImportant="" markEmergency="" markEmergencyItem=""
	markFlags="$( AgentsToolsScheduleCurrentFlags --current-flags 2> /dev/null )" || markFlags=""
	case "$markFlags" in *"worktime: yes"*) markWork=yes ;; esac
	for markFile in "$( AgentsToolsInboxDir magic-coordinator )"/*.md ; do
		[ -e "$markFile" ] || continue
		case "${markFile##*/}" in note-*-state-and-lock.md) continue ;; esac
		markMark="$( LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsBoardItemFrontmatterPrint.awk" "$markFile" 2> /dev/null | LC_ALL=C sed -n 's/^mark: //p' | LC_ALL=C tail -n 1 )"
		case "$markMark" in
			important) markImportant="yes" ;;
			emergency) markEmergency="yes" ; markEmergencyItem="${markFile##*/}" ;;
		esac
	done
	[ -n "$markImportant$markEmergency" ] || return 0
	[ -z "$markEmergency" ] || AgentsToolsScheduleEmergencyConfirm "$markEmergencyItem"
	if [ "$markWork" = no ] ; then
		if AgentsToolsScheduleSpawn "advance.magic-coordinator" --routine "magic-coordinator.advance.routine.md" magic-coordinator ; then
			printf 'important-emergency: started the advance routine of magic-coordinator\n'
		fi
	fi
	return 0
}

## The emergency confirmation (T3): an emergency item is confirmed with the owner and the flag set in the same loop (notify-and-set, the
## settled reading). The tooling posts the confirmation to the owner (once per item, in the owner's direct channel) and sets the flag
## through the schedule's own override (AgentsToolsScheduleOverride), the one path to the MDAT_SCHEDULE_EMERGENCY setting; the emergency
## TTL is a fixed 3600s.
AgentsToolsScheduleEmergencyConfirm(){ ## the emergency item's file name
	local confirmItem="$1" confirmStore="$MMDAPP/.local/agents/schedule/emergency-confirm" confirmTtl=3600
	[ -n "$confirmItem" ] || return 0
	mkdir -p "$confirmStore" 2> /dev/null || return 0
	[ ! -e "$confirmStore/$confirmItem" ] || return 0
	( set -C ; : > "$confirmStore/$confirmItem" ) 2> /dev/null || return 0
	if ! printf 'An emergency item arrived in the coordinator%s incoming (%s). Confirm the emergency to set the emergency flag.\n' "'s" "$confirmItem" \
		| DistroAgentsTools --intern-op-comms-slack-send-message magic-coordinator human-owner --identity-bot --from-stdin > /dev/null 2>&1 ; then
		rm -f "$confirmStore/$confirmItem"
		printf 'important-emergency: the emergency confirmation for %s could not be posted, tried again at the next iteration\n' "$confirmItem"
		return 0
	fi
	AgentsToolsScheduleOverride --override-flag emergency "$confirmTtl" > /dev/null 2>&1 || :
	printf 'important-emergency: emergency %s confirmed with the owner, the flag set for %ss\n' "$confirmItem" "$confirmTtl"
	return 0
}

## --- the learning inquiry ---

## When learning is on, each session that has ended since the last look gets one inquiry into magic-librarian's inbox, to analyse its transcript
## and its reflections and to process the proposals for retro; when it is off nothing is sent, and a session that ended meanwhile is never sent
## later. Every session is looked at once (a mark in learned/), the first look of a workspace marking the sessions already ended without
## sending: a history is no news. A session whose only member is magic-librarian is not sent (its own inquiry would call for another). The
## text is the learning-inquiry block of the tooling-note template.
AgentsToolsScheduleLearning(){
	local learnStore="$MMDAPP/.local/agents/schedule/learned" learnFirst="" learnOn=no learnRows learnKind learnId learnName learnState learnRest learnMembers learnMember learnOnly learnText learnFile learnStamp
	[ -d "$learnStore" ] || learnFirst="yes"
	mkdir -p "$learnStore" 2> /dev/null || return 0
	[ "$( AgentsToolsScheduleCurrentFlags --current-flags 2> /dev/null | LC_ALL=C sed -n 's/^learning: //p' )" != yes ] || learnOn=yes
	type AgentsToolsDispatcherManager > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.Dispatcher.include"
	AgentsToolsDispatcherManager 2> /dev/null || return 0
	learnRows="$( AgentsToolsManagerSessionRows --schedule-learning "" 2> /dev/null )" || return 0
	while IFS=$'\t' read -r learnKind learnId learnName learnState learnRest ; do
		[ "$learnKind" = session ] && [ "$learnState" = finished ] || continue
		case "$learnId" in ''|*/*|.|..) continue ;; esac
		[ ! -e "$learnStore/$learnId" ] || continue
		( set -C ; : > "$learnStore/$learnId" ) 2> /dev/null || continue
		[ -z "$learnFirst" ] || continue
		[ "$learnOn" = yes ] || continue
		learnMembers="$( printf '%s\n' "$learnRows" | LC_ALL=C awk -F'\t' -v want="$learnId" '$1 == "run" && $2 == want { print $4 }' | LC_ALL=C sort -u )"
		learnOnly=yes
		for learnMember in $learnMembers ; do
			[ "$learnMember" = magic-librarian ] || learnOnly=no
		done
		[ "$learnOnly" = no ] || continue
		type AgentsToolsEscalationNote > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.MemberEscalation.include" --definitions-only > /dev/null 2>&1 || :
		learnText="$( ASKP_F_session="$learnId" ASKP_F_members="$( printf '%s' "$learnMembers" | LC_ALL=C tr '\n' ' ' | LC_ALL=C sed 's/ $//' )" AgentsToolsEscalationNote "Schedule/learning-inquiry" )" || learnText=""
		if [ -z "$learnText" ] ; then
			echo "⚠️ WARNING: $MDSC_CMD: the learning inquiry for session $learnId could not be filled from its template (tooling-note.post.format.md, Schedule/learning-inquiry)" >&2
			continue
		fi
		learnStamp="$( date -u +%Y%m%dT%H%MZ )"
		mkdir -p "$MMDAPP/.local/temp" 2> /dev/null
		learnFile="$( mktemp "$MMDAPP/.local/temp/schedule-learning.XXXXXX" )" || continue
		printf '%s\n' "$learnText" > "$learnFile" || { rm -f "$learnFile" ; continue ; }
		if DistroAgentsTools --upsert-inbox-inquiry magic-librarian "inquiry-$learnStamp-learning-$learnId.md" --from-member magic-coordinator --from-file "$learnFile" > /dev/null 2>&1 ; then
			printf 'learning: session %s ended: one inquiry to magic-librarian\n' "$learnId"
		else
			rm -f "$learnStore/$learnId"
			printf 'learning: session %s ended and its inquiry to magic-librarian could not be filed, tried again at the next iteration\n' "$learnId"
		fi
		rm -f "$learnFile"
	done <<< "$learnRows"
	return 0
}

## The steps, in order. One line for each thing done.
AgentsToolsScheduleLoop(){
	AgentsToolsScheduleSpawnReport
	AgentsToolsScheduleAutorun
	AgentsToolsScheduleWorkDuty
	AgentsToolsScheduleImportantEmergency
	AgentsToolsScheduleLearning
	return 0
}
