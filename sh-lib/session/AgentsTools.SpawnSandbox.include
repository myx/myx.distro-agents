#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.SpawnSandbox.include -- what a spawn sandbox's input/ holds, and when it
## is emptied. Sourced, never run. Functions only. Contract: MAGIC.md, "Spawn sandbox input/".
##

## THE CLOCK OF A START: the whole seconds each step of a start took, kept in $agentsStartSteps as `<step>=<n>s` words and said
## by the start milestone of the session (AgentsToolsStartStepsSay). Begin starts the clock; Mark closes the step that ran since
## the last mark under its name. Plain variables of the one process that runs the start, so a mark inside `$( )` is lost: a mark
## stands in the start's own body. A step that does not run is not marked, and is not in the line.
AgentsToolsStartStepBegin(){
	agentsStartStepFirst="$( date +%s )" ; agentsStartStepAt="$agentsStartStepFirst" ; agentsStartSteps=""
}
AgentsToolsStartStepMark(){ ## step name
	local markNow
	markNow="$( date +%s )"
	[ -n "${agentsStartStepAt:-}" ] || return 0
	agentsStartSteps="${agentsStartSteps:+$agentsStartSteps }$1=$(( markNow - agentsStartStepAt ))s"
	agentsStartStepAt="$markNow"
}
## The words of the start milestone: `start steps: <step>=<n>s ... total=<n>s`, or plain `start` where the clock never began.
## The file of the scan's own sections (MDAT_SCAN_TRACE_FILE, one `<section>=<n>s` word a line) is set in brackets after the
## step `input-scan`, so a slow scan names its slow section in the same line.
AgentsToolsStartStepsSay(){ ## scan sections file (may be empty)
	local sayNow saySections="" sayLine
	[ -n "${agentsStartStepFirst:-}" ] || { printf 'start' ; return 0 ; }
	sayNow="$( date +%s )"
	if [ -n "${1:-}" ] && [ -s "$1" ] ; then
		while IFS= read -r sayLine ; do saySections="${saySections:+$saySections }$sayLine" ; done < "$1"
		agentsStartSteps="${agentsStartSteps/input-scan=/input-scan[$saySections]=}"
	fi
	printf 'start steps: %s total=%ss' "$agentsStartSteps" "$(( sayNow - agentsStartStepFirst ))"
}

## Path-like words of a text that name something on disk, one resolved path per line.
AgentsToolsSpawnSandboxNamedPaths(){ ## text
	local namedWord namedPath
	printf '%s\n' "$1" | LC_ALL=C grep -oE '[A-Za-z0-9_.~/-]*[A-Za-z0-9_.-]/[A-Za-z0-9_./-]+' | LC_ALL=C sort -u | while IFS= read -r namedWord ; do
		namedWord="${namedWord%%:*}"
		for namedPath in "$MMDAPP/source/$namedWord" "$MMDAPP/source"/*/"$namedWord" "$MMDAPP/$namedWord" "$namedWord" ; do
			[ -e "$namedPath" ] || continue
			printf '%s\n' "$namedPath"
			break
		done
	done
}

## The nearest MAGIC.md above a path, never above $MMDAPP/source.
AgentsToolsSpawnSandboxNearestMagic(){ ## path
	local magicDir="$1"
	[ -d "$magicDir" ] || magicDir="${magicDir%/*}"
	magicDir="$( cd "$magicDir" 2>/dev/null && pwd -P )" || return 0
	local sourceRoot
	sourceRoot="$( cd "$MMDAPP/source" 2>/dev/null && pwd -P )" || return 0
	while [ -n "$magicDir" ] ; do
		case "$magicDir/" in "$sourceRoot"/*) ;; *) return 0 ;; esac
		[ ! -f "$magicDir/MAGIC.md" ] || { printf '%s\n' "$magicDir/MAGIC.md" ; return 0 ; }
		[ "$magicDir" != "$sourceRoot" ] || return 0
		magicDir="${magicDir%/*}"
	done
}

## Fills input/: the brief, the board item behind it, the MAGIC.md copies,
## pointers.md, and conversation.md when the spawn continues a conversation.
## Copies, never links, and never secret material: the
## credentials line in pointers.md names the identity the tooling acts as, not a value.
AgentsToolsSpawnSandboxFillInput(){ ## sandbox root, brief text, board item path (may be empty), member, conversation threads (may be empty), input scan result file (may be empty)
	local fillInput="$1/input" fillBrief="$2" fillItem="$3" fillMember="$4" fillConversations="${5:-}"
	local fillText fillPath fillMagic fillName fillCount=0 fillMembers fillMemberName fillMemberDir fillScanKept=""
	[ -d "$fillInput" ] || return 0
	## The scan result this sandbox already holds is the session's, not one start's: read before the clean below wipes it.
	[ ! -f "$fillInput/input-scan.md" ] || fillScanKept="$( cat "$fillInput/input-scan.md" 2>/dev/null )"
	## A joined sandbox may hold a run's read-only input/ still: opened and emptied first.
	AgentsToolsSpawnSandboxCleanInput "$1"
	printf '%s\n' "$fillBrief" > "$fillInput/dispatch.md" || {
		echo "⚠️ WARNING: $MDSC_CMD: could not write $fillInput/dispatch.md, so this spawn's input/ holds no brief" >&2
		return 0
	}
	fillText="$fillBrief"
	if [ -n "$fillItem" ] && [ -f "$fillItem" ] ; then
		cp -p "$fillItem" "$fillInput/${fillItem##*/}" 2>/dev/null
		fillText="$fillText"$'\n'"$( cat "$fillItem" 2>/dev/null )"
	fi
	## MAGIC.md of every repo or package the brief or its item names, else the workspace's.
	while IFS= read -r fillPath ; do
		fillMagic="$( AgentsToolsSpawnSandboxNearestMagic "$fillPath" )"
		[ -n "$fillMagic" ] || continue
		fillName="${fillMagic#"$( cd "$MMDAPP/source" && pwd -P )"/}"
		fillName="MAGIC.${fillName%/MAGIC.md}.md"
		fillName="${fillName//\//--}"
		[ -e "$fillInput/$fillName" ] || { cp -p "$fillMagic" "$fillInput/$fillName" 2>/dev/null && fillCount=$(( fillCount + 1 )) ; }
	done < <( AgentsToolsSpawnSandboxNamedPaths "$fillText" )
	if [ "$fillCount" -eq 0 ] && [ -f "$MMDAPP/MAGIC.md" ] ; then
		cp -p "$MMDAPP/MAGIC.md" "$fillInput/MAGIC.workspace.md" 2>/dev/null
	fi
	## Routines and skillset files: every one is a pointer, routines included. A copy is a
	## snapshot of whatever tree the root resolved to at spawn time, and the brief has the
	## spawn read its routine through the skillset reader anyway, which serves the live file.
	## Every member's folder, a member of another workspace included (AgentsTools.TeamRegistry.include).
	type AgentsToolsTeamMemberDirectoryText > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.TeamRegistry.include"
	fillMembers="$( AgentsToolsTeamMemberDirectoryText )"
	{
		printf '%s\n' "# Pointers for this spawn" ""
		printf '%s\n' "Credentials: none are copied here. The team tooling acts as \`$fillMember\` for this spawn and resolves that member's credentials itself."
		printf '%s\n' ""
		printf '%s\n' "$fillText" | LC_ALL=C grep -oE '[a-z0-9][a-z0-9-]*(\.[a-z0-9-]+)+\.md' | LC_ALL=C sort -u | while IFS= read -r fillName ; do
			while IFS=$'\t' read -r fillMemberName fillMemberDir ; do
				[ -n "$fillMemberDir" ] && [ -f "$fillMemberDir/$fillName" ] || continue
				printf '%s\n' "- \`$fillName\`: read with Skill, name \`$fillMemberName\`, file \`$fillName\`"
				break
			done <<< "$fillMembers"
		done
	} > "$fillInput/pointers.md" 2>/dev/null
	[ -z "$fillConversations" ] || AgentsToolsSpawnConversationHistory "$fillInput/conversation.md" "$fillMember" "$fillConversations" "$fillItem"
	## The result of the routine's own input scan, which the spawner ran (F6.3), beside the brief and the pointers. A start
	## that ran no scan keeps the one the session already had: no brief names a file this fill does not leave there.
	if [ -n "${6:-}" ] && [ -f "$6" ] ; then
		mv -f "$6" "$fillInput/input-scan.md" 2>/dev/null || :
	elif [ -n "$fillScanKept" ] ; then
		printf '%s\n' "$fillScanKept" > "$fillInput/input-scan.md" 2>/dev/null || :
	fi
	## Read-only by mode, whatever the client's access flag can say: a flag with no verb
	## grants input/ for writing too, so the files and the folder carry no write bit.
	chmod -R a-w "$fillInput" 2>/dev/null || :
	return 0
}

## Empties input/ and keeps input/ itself, output/ and the root record.
AgentsToolsSpawnSandboxCleanInput(){ ## sandbox root
	[ -d "$1/input" ] || return 0
	chmod -R u+w "$1/input" 2>/dev/null || :
	find "$1/input" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} + 2>/dev/null
	return 0
}

## This caller's own coworking-session thread, from the one-line pointer file the
## spawn proxy writes in the sandbox root (session.thread) -- prints
## "channel:ts" and returns 0 when it exists and holds a value, prints nothing and
## returns 1 otherwise (no coworking session, or the file is not written yet).
## Falls back to a key on $MDAT_SPAWN_SESSION_ID, the sandbox root's own name, only
## once $MDAT_SESSION_THREAD is unset -- a caller spawned with an explicit --tracking-name
## can diverge from that, and settling which id the sandbox folder is actually named for
## is keeper-myx's own open item, not decided here.
AgentsToolsSessionThreadFind(){
	## MDAT_SESSION_THREAD is exported directly by spawn-proxy at launch, correct
	## for every participant alike -- founding or joining a coworking session.
	## Preferred over the file lookup below, which keys off MDAT_SPAWN_SESSION_ID,
	## a value that is this spawn's own spawn-id, not the shared session folder,
	## for every participant after the session's first.
	[ -z "${MDAT_SESSION_THREAD:-}" ] || { printf '%s\n' "$MDAT_SESSION_THREAD" ; return 0 ; }
	[ -n "${MDAT_SPAWN_SESSION_ID:-}" ] || return 1
	local threadFile="$MMDAPP/.local/agents/spawned/$MDAT_SPAWN_SESSION_ID/session.thread"
	local threadLine=""
	[ -f "$threadFile" ] && IFS= read -r threadLine < "$threadFile" || return 1
	[ -n "$threadLine" ] || return 1
	printf '%s\n' "$threadLine"
	return 0
}

## The thread session-current names, and a send or an ask with no target goes to: this
## caller's own coworking-session thread (AgentsToolsSessionThreadFind), else the thread
## recorded for a session that is itself the coworking session -- a native client session,
## never spawned through the proxy, whose thread the first member it brings in opens. That
## record is one line, sessions/<session-id>/session.thread, written by the spawn proxy,
## and the session is found as the proxy finds it: the one this caller joined, else this
## caller's own. Prints "channel:ts" and returns 0; prints nothing and returns 1 for none.
## A bare Wait takes a spawn's thread by AgentsToolsSessionThreadFind alone
## (AgentsToolsWaitDefaultSources). With none it watches magic-team and human-owner, as it
## always has, and beside them the thread recorded here (--wait-for-input).
AgentsToolsSessionCurrentThreadFind(){
	AgentsToolsSessionThreadFind && return 0
	local currentSession="" currentLine=""
	currentSession="$( AgentsToolsSessionCurrentId )"
	case "$currentSession" in ''|*/*|.|..) return 1 ;; esac
	[ -n "${MMDAPP:-}" ] || return 1
	[ -f "$MMDAPP/.local/agents/sessions/$currentSession/session.thread" ] && IFS= read -r currentLine < "$MMDAPP/.local/agents/sessions/$currentSession/session.thread" || return 1
	[ -n "$currentLine" ] || return 1
	printf '%s\n' "$currentLine"
	return 0
}

## The session this call belongs to, by the chain every session reader keeps: the coworking session of a
## run, else the run's own, else the client's (AgentsToolsSessionChatKey's own chain). Empty for none.
AgentsToolsSessionCurrentId(){
	printf '%s' "${MDAT_SESSION_ID:-${MDAT_SPAWN_SESSION_ID:-${CLAUDE_CODE_SESSION_ID:-}}}"
}

## WHERE A RUN REPORTS TO: the one address its handback goes to, its questions and
## escalations that name no target are asked at, its end and its death are told at, and
## that decides what follows its work. Kept on its spawn record under the one name below,
## where the spawn wrote one: `<session>[:<member>]` (a session alone means its executor), a
## member, `user-<account>` for a person who started it at a console, `human-owner`, or `none`
## for a run that reports to no one: it ends when its work is done, its handback, if it gives
## one, is its report and moves nothing to review, and nobody is told of its end. The
## reviewers of its item are its item's `review-by`, another field for another thing: neither
## ever stands in for the other. Beside it, `parent-session-id:` is the session that started the
## run, where one did: what a run reports to where it names nothing itself. The run that made
## the spawn call is `parent-spawn-id:`, the run tree's own: a native caller's client session id
## stands there as its spawn id.
agentsRunRouteField="reports-to"
## Who of a parent session a run reports to where it names nobody itself: `parent-member`, the
## member that made the spawn call there, before that session's executor; or `executor` first.
agentsRunRouteMemberFirst="parent-member"

## Whether a value is an address of that form: one bare name, or two joined by one `:`. Each
## name is asked of the bare-name gate (AgentsTools.BareName.include, loaded where it is not
## yet, as in a served harness tool), quietly: a value that is no address is an answer here.
AgentsToolsRunRouteValid(){ ## value
	type AgentsToolsAssertBareName > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.BareName.include"
	case "$1" in
		''|*:*:*|:*|*:) return 1 ;;
		*:*) AgentsToolsAssertBareName "${1%%:*}" "an address's session" AgentsToolsRunRouteValid 2> /dev/null && AgentsToolsAssertBareName "${1#*:}" "an address's member" AgentsToolsRunRouteValid 2> /dev/null ;;
		*) AgentsToolsAssertBareName "$1" "an address" AgentsToolsRunRouteValid 2> /dev/null ;;
	esac
}

## What an address is, by its form: `none`, `person` (human-owner, user-<account>, or empty),
## `member` (a member of this team), or `session` (`<session>:<member>`, or a bare id that is no member).
AgentsToolsRunRouteKind(){ ## address
	case "$1" in
		none) printf 'none\n' ;;
		''|human-owner|user-?*) printf 'person\n' ;;
		*:*) printf 'session\n' ;;
		magic-*|keeper-*|warden-*|partner-*|client-*|oncall-*|expert-*) printf 'member\n' ;;
		*)
			type AgentsToolsTeamMemberDirectory > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.TeamRegistry.include" 2> /dev/null || :
			if AgentsToolsTeamMemberDirectory "$1" > /dev/null 2>&1 ; then printf 'member\n' ; else printf 'session\n' ; fi
		;;
	esac
}

## The member an address names: the member of `<session>:<member>`, a member itself, and for a
## bare session the executor of that session, the owner of its founding record (the record
## named by the session's own id). rc 1, nothing printed, for a person, and for a session
## whose executor no record here names.
AgentsToolsRunRouteMember(){ ## address
	local memberRecord memberOwner=""
	type AgentsToolsAssertBareName > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.BareName.include"
	case "$( AgentsToolsRunRouteKind "$1" )" in
		member) printf '%s\n' "$1" ; return 0 ;;
		person|none) return 1 ;;
	esac
	case "$1" in *:*) printf '%s\n' "${1#*:}" ; return 0 ;; esac
	for memberRecord in "${MMDAPP:-/nonexistent}"/.local/agents/spawned/*/"$1.spawn.md" ; do
		[ ! -f "$memberRecord" ] || memberOwner="$( AgentsToolsSpawnSandboxRecordHeader "$memberRecord" owner )"
	done
	AgentsToolsAssertBareName "$memberOwner" "the owner of a session's founding record" AgentsToolsRunRouteMember 2> /dev/null || return 1
	printf '%s\n' "$memberOwner"
}

## Whether a member is there to take a matter in a session: a live run of it there, by the one
## rule a run is alive by, that is not the asking run itself. In a native session, which has no
## founding record here, the asking run's initiator is that session itself: only its client can
## tell whether it lives, so it is taken as there.
AgentsToolsRunRouteAvailable(){ ## session, member, the asking run's spawn record
	local availRecord="$3" availOwn availCandidate availId
	type AgentsToolsAssertBareName > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.BareName.include"
	AgentsToolsAssertBareName "$1" "the session" AgentsToolsRunRouteAvailable 2> /dev/null && AgentsToolsAssertBareName "$2" "the member" AgentsToolsRunRouteAvailable 2> /dev/null || return 1
	availOwn="${availRecord##*/}" ; availOwn="${availOwn%.spawn.md}"
	type AgentsToolsRegistrySpawnRuns > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.Registries.include" 2> /dev/null || :
	for availCandidate in $( LC_ALL=C grep -l -x -F "session-id: $1" "${MMDAPP:-/nonexistent}"/.local/agents/spawned/*/*.spawn.md 2> /dev/null ) ; do
		availId="${availCandidate##*/}" ; availId="${availId%.spawn.md}"
		[ "$availId" != "$availOwn" ] || continue
		[ "$( AgentsToolsSpawnSandboxRecordHeader "$availCandidate" owner )" = "$2" ] || continue
		## An agent-less parent runs no member: it stands for its caller, and takes no matter itself.
		[ "$( AgentsToolsSpawnSandboxRecordHeader "$availCandidate" agent-less )" != true ] || continue
		[ "$( AgentsToolsSpawnSandboxRecordHeader "$availCandidate" status )" = spawn-started ] || continue
		type AgentsToolsRegistrySpawnRuns > /dev/null 2>&1 && AgentsToolsRegistrySpawnRuns "$availId" "$availCandidate" > /dev/null 2>&1 || continue
		return 0
	done
	[ -z "$( ls "${MMDAPP:-/nonexistent}"/.local/agents/spawned/*/"$1.spawn.md" 2> /dev/null )" ] || return 1
	[ "$( AgentsToolsSpawnSandboxRecordHeader "$availRecord" parent-member )" = "$2" ] || return 1
	return 0
}

## The address the run of a spawn record reports to, printed, in this order:
## 1. its `reports-to:`, where the spawn wrote one (`none` too) -- unless `default` is asked; a
##    `<session>:<member>` there whose member no longer runs in that session falls through to 2-4;
## 2. else, in its `parent-session-id:`, the session that started it, as `<session>:<member>`:
##    the member that made the call there (`parent-member:`), the initiator, where it is there
##    (AgentsToolsRunRouteAvailable), else that session's executor, the owner of its founding
##    record (AgentsToolsRunRouteMember), where it is there; or the executor first, as
##    agentsRunRouteMemberFirst says;
## 3. else magic-coordinator, where a run of it is there, in that session, else in the session
##    of this run, as `<session>:magic-coordinator`: never this run itself, so a coordinator is
##    never handed its own matter back;
## 4. else the human-owner.
## The member is named, never a run: whichever run of it is there takes the matter.
## AN AGENT-LESS PARENT takes no matter itself: a run whose address in 1 or 2 is such a parent's
## session reports where that parent does, its own route read the same way, one hop and no more.
AgentsToolsRunRoute(){ ## spawn record path, `default` for the address it has where it names none itself (may be empty)
	local routeRecord="${1:-}" routeValue="" routeSession="" routeInitiator="" routeExecutor="" routeOne routeHop
	type AgentsToolsAssertBareName > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.BareName.include"
	[ -n "$routeRecord" ] && [ -f "$routeRecord" ] || { printf 'human-owner\n' ; return 0 ; }
	## The hop: the session named by its reports-to, else its parent session; never from a parent itself, so no cycle.
	if [ -z "${agentsRunRouteHopped:-}" ] && [ "$( AgentsToolsSpawnSandboxRecordHeader "$routeRecord" agent-less )" != true ] ; then
		routeHop=""
		[ "${2:-}" = default ] || routeHop="$( AgentsToolsSpawnSandboxRecordHeader "$routeRecord" "$agentsRunRouteField" )"
		AgentsToolsRunRouteValid "$routeHop" || routeHop=""
		[ -n "$routeHop" ] || routeHop="$( AgentsToolsSpawnSandboxRecordHeader "$routeRecord" parent-session-id )"
		routeHop="${routeHop%%:*}"
		if AgentsToolsAssertBareName "$routeHop" "the agent-less parent" AgentsToolsRunRoute 2> /dev/null \
			&& [ "$( AgentsToolsSpawnSandboxRecordHeader "${MMDAPP:-/nonexistent}/.local/agents/spawned/$routeHop/$routeHop.spawn.md" agent-less )" = true ] ; then
			routeOne="$( agentsRunRouteHopped=1 AgentsToolsRunRoute "${MMDAPP:-/nonexistent}/.local/agents/spawned/$routeHop/$routeHop.spawn.md" )"
			if [ "$( AgentsToolsSpawnSandboxRecordHeader "${MMDAPP:-/nonexistent}/.local/agents/spawned/${routeOne%%:*}/${routeOne%%:*}.spawn.md" agent-less )" != true ] ; then
				printf '%s\n' "$routeOne" ; return 0
			fi
			## The cycle guard: a parent whose own route names an agent-less session again ends in steps 3-4, of this run's session.
			routeOne="$( AgentsToolsSpawnSandboxRecordHeader "$routeRecord" session-id )"
			! AgentsToolsRunRouteAvailable "$routeOne" magic-coordinator "$routeRecord" || { printf '%s:magic-coordinator\n' "$routeOne" ; return 0 ; }
			printf 'human-owner\n' ; return 0
		fi
	fi
	if [ "${2:-}" != default ] ; then
		routeValue="$( AgentsToolsSpawnSandboxRecordHeader "$routeRecord" "$agentsRunRouteField" )"
		if AgentsToolsRunRouteValid "$routeValue" ; then
			case "$routeValue" in
				*:*) ! AgentsToolsRunRouteAvailable "${routeValue%%:*}" "${routeValue#*:}" "$routeRecord" || { printf '%s\n' "$routeValue" ; return 0 ; } ;;
				*) printf '%s\n' "$routeValue" ; return 0 ;;
			esac
		fi
	fi
	routeSession="$( AgentsToolsSpawnSandboxRecordHeader "$routeRecord" parent-session-id )"
	if AgentsToolsAssertBareName "$routeSession" "the parent session" AgentsToolsRunRoute 2> /dev/null ; then
		routeInitiator="$( AgentsToolsSpawnSandboxRecordHeader "$routeRecord" parent-member )"
		routeExecutor="$( AgentsToolsRunRouteMember "$routeSession" )" || routeExecutor=""
		for routeOne in $( [ "$agentsRunRouteMemberFirst" = executor ] && printf '%s %s' "$routeExecutor" "$routeInitiator" || printf '%s %s' "$routeInitiator" "$routeExecutor" ) ; do
			AgentsToolsRunRouteAvailable "$routeSession" "$routeOne" "$routeRecord" || continue
			printf '%s:%s\n' "$routeSession" "$routeOne"
			return 0
		done
	fi
	for routeOne in "$routeSession" "$( AgentsToolsSpawnSandboxRecordHeader "$routeRecord" session-id )" ; do
		AgentsToolsRunRouteAvailable "$routeOne" magic-coordinator "$routeRecord" || continue
		printf '%s:magic-coordinator\n' "$routeOne"
		return 0
	done
	printf 'human-owner\n'
}

## THE CLOSE OF AN AGENT-LESS PARENT (AgentsToolsSpawnSessionParent, below), once every child
## its record names has closed and none is queued (`pending:`): its status summed from theirs -- all succeeded reads succeeded,
## any other close, a child record gone, a start that failed (`start-failed:`), or no child at all reads failed -- its
## resolved-at stamped, and its handback in its thread naming each child and its outcome.
## rc 1, nothing changed, while a child is open or queued or the record is closed already. Its watcher calls it, and
## housekeeping does for a parent whose watcher is gone.
AgentsToolsSpawnSessionParentClose(){ ## parent record
	local closeRecord="$1" closeChild closeChildRecord closeStatus closeOutcome="succeeded" closeList="" closeTemp closeThread closeFailed
	[ "$( AgentsToolsSpawnSandboxRecordHeader "$closeRecord" status )" = spawn-started ] || return 1
	[ -z "$( AgentsToolsSpawnSandboxRecordHeader "$closeRecord" pending )" ] || return 1
	for closeChild in $( AgentsToolsSpawnSandboxRecordHeader "$closeRecord" children ) ; do
		closeChildRecord="$MMDAPP/.local/agents/spawned/$closeChild/$closeChild.spawn.md" closeStatus="spawn-gone"
		[ ! -f "$closeChildRecord" ] || closeStatus="$( AgentsToolsSpawnSandboxRecordHeader "$closeChildRecord" status )"
		case "$closeStatus" in
			''|spawn-started) return 1 ;;
			spawn-succeeded) ;;
			*) closeOutcome="failed" ;;
		esac
		closeList="$closeList${closeList:+, }$closeChild $( AgentsToolsSpawnSandboxRecordHeader "$closeChildRecord" owner 2> /dev/null ) ${closeStatus#spawn-}"
	done
	for closeFailed in $( AgentsToolsSpawnSandboxRecordHeader "$closeRecord" start-failed ) ; do
		closeOutcome="failed" ; closeList="$closeList${closeList:+, }$closeFailed start-failed"
	done
	[ -n "$closeList" ] || { closeOutcome="failed" ; closeList="no child was started" ; }
	closeTemp="$( mktemp "$closeRecord.tmp.XXXXXX" )" || return 1
	LC_ALL=C awk -v outcome="$closeOutcome" -v stamp="$( date +"%Y-%m-%d %H:%M %z" )" '
		NR == 1 { print ; next ; }
		$0 == "---" && !closed { print "resolved-at: " stamp ; print ; closed = 1 ; next ; }
		$0 == "status: spawn-started" { print "status: spawn-" outcome ; next ; }
		{ print ; }
	' "$closeRecord" > "$closeTemp" && chmod 644 "$closeTemp" && mv -f "$closeTemp" "$closeRecord" || { rm -f -- "$closeTemp" ; return 1 ; }
	## Its handback, in the caller's thread, where the parent has one. Best-effort, never the parent's outcome.
	closeThread="$( AgentsToolsSpawnSandboxRecordHeader "$closeRecord" session-thread )"
	[ -n "$closeThread" ] || return 0
	DistroAgentsTools --intern-op-event-track-post "$( AgentsToolsSpawnSandboxRecordHeader "$closeRecord" owner )" "$closeThread" --kind handback \
		--session-id "$( AgentsToolsSpawnSandboxRecordHeader "$closeRecord" session-id )" \
		--field handback="agent-less parent: all spawned sessions are done ($closeOutcome): $closeList" < /dev/null 2>&1 > /dev/null || :
	return 0
}

## Header lines set on a spawn record another process may be writing too: read, changed, and moved in only where
## the file is still what was read (three tries), as AgentsToolsSpawnProxyRunRecord does. Lines on stdin: `<header><TAB><value>`.
AgentsToolsSpawnSessionRecordNote(){ ## record file
	local noteFile="$1" noteOps noteSeen noteBody noteNow noteTries=0 noteTmp=""
	[ -f "$noteFile" ] || return 1
	noteOps="$( mktemp "$noteFile.ops.XXXXXX" )" || return 1
	LC_ALL=C awk -F'\t' 'NF >= 2 { printf "upsert\t%s\t%s\n", $1, $2 }' > "$noteOps"
	while [ "$noteTries" -lt 3 ] ; do
		noteTries=$(( noteTries + 1 ))
		noteSeen="" ; IFS= read -r -d '' noteSeen < "$noteFile" 2> /dev/null || :
		[ -n "$noteSeen" ] || break
		noteBody="$( printf '%s' "$noteSeen" | LC_ALL=C awk -v opsFile="$noteOps" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsBoardItemHeaderOpsApply.awk" 2> /dev/null )" || noteBody=""
		[ -n "$noteBody" ] || break
		[ -n "$noteTmp" ] || noteTmp="$( mktemp "$noteFile.note.XXXXXX" 2> /dev/null )" || break
		printf '%s\n' "$noteBody" 2> /dev/null > "$noteTmp" || break
		noteNow="" ; IFS= read -r -d '' noteNow < "$noteFile" 2> /dev/null || :
		[ "$noteNow" = "$noteSeen" ] || continue
		chmod 644 "$noteTmp" 2> /dev/null ; mv -f "$noteTmp" "$noteFile" 2> /dev/null && { rm -f "$noteOps" ; return 0 ; }
		break
	done
	rm -f "$noteOps" ${noteTmp:+"$noteTmp"}
	return 1
}
## The founding record of a session this call started, given the lines; a warning, never a stop, where it cannot be.
AgentsToolsSpawnSessionNoteSession(){ ## session id, the lines (`<header><TAB><value>` a line)
	local noteRecord
	for noteRecord in "$MMDAPP"/.local/agents/spawned/*/"$1.spawn.md" ; do
		[ -f "$noteRecord" ] && printf '%s' "$2" | AgentsToolsSpawnSessionRecordNote "$noteRecord" && return 0
	done
	echo "$MDSC_CMD: spawn-session: ⚠️ WARNING: the participants and the likely needs could not be written on the record of session $1" >&2
	return 0
}

## THE AGENT-LESS PARENT of a partitioned spawn (--spawn-session, AgentsTools.MagicSpawnSession.include): it runs no agent of its
## own -- no CLI is launched. Its children report to it (`reports-to: <its session>`), and the route takes each matter one hop on,
## to where the parent reports (AgentsToolsRunRoute), so their handbacks, escalations and the answers to them pass by the route.
## Its record holds the queue as lib/parallel holds its stdin: `pending:` the members not started yet, at most `workers:` children
## open at once (default 4), `start-failed:` the starts that failed, the rest going on. Its call writes the record, starts the first
## children and launches the watcher; from then the watcher alone writes it. The files beside the record keep what each start is
## given: partition.args (the spawn proxy's arguments, NUL-separated), partition.task (its stdin), partition.notes (record lines).
agentsSpawnSessionParentWorkers=4

## One start of the queue: the member spawned as a child of the parent; an entry `<member>@<n>` is of the n-th line of
## partition.scopes (--partition-scope), named first in its brief and as `scope:` on its record. Prints the child's
## session id; rc 1 where it failed.
AgentsToolsSpawnSessionParentStart(){ ## parent session id, queue entry
	local startDir="$MMDAPP/.local/agents/spawned/$1" startArgs=() startArg startOut startChild startMember="${2%@*}" startScope="" startNotes=""
	while IFS= read -r -d '' startArg ; do startArgs+=( "$startArg" ) ; done < "$startDir/partition.args"
	case "$2" in
		*@*)
			startScope="$( LC_ALL=C sed -n "${2##*@}p" "$startDir/partition.scopes" 2> /dev/null )"
			[ -n "$startScope" ] || return 1
		;;
	esac
	startOut="$( { [ -z "$startScope" ] || printf 'scope: %s\n' "$startScope" ; cat "$startDir/partition.task" ; } \
		| DistroAgentsTools --intern-op-agent-spawn-proxy "$startMember" ${startArgs[@]+"${startArgs[@]}"} --reports-to "$1" --session-new --parent-session "$1" --context --spawn-session )" || return 1
	startChild="$( printf '%s\n' "$startOut" | LC_ALL=C awk -F= '$1 == "SESSION_ID" { print $2 ; exit ; }' )"
	[ -n "$startChild" ] || return 1
	[ ! -s "$startDir/partition.notes" ] || startNotes="$( cat "$startDir/partition.notes" )"$'\n'
	[ -z "$startScope" ] || startNotes="${startNotes}scope"$'\t'"$startScope"$'\n'
	[ -z "$startNotes" ] || AgentsToolsSpawnSessionNoteSession "$startChild" "$startNotes"
	printf '%s\n' "$startChild"
}

## One post of the parent into its own tracking thread, made once: its mark goes on the record's `posted:`, so a watcher
## started again never posts it twice. Best-effort, never the parent's outcome.
AgentsToolsSpawnSessionParentPost(){ ## parent record, mark, --intern-op-event-track-post arguments...
	local postRecord="$1" postMark="$2" postDone postId
	shift 2
	postDone="$( AgentsToolsSpawnSandboxRecordHeader "$postRecord" posted )"
	case " $postDone " in *" $postMark "*) return 0 ;; esac
	postId="${postRecord##*/}" ; postId="${postId%.spawn.md}"
	type AgentsToolsEventTrackThreadPost > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.EventTrackThread.include" 2> /dev/null || :
	AgentsToolsEventTrackThreadPost "$( AgentsToolsSpawnSandboxRecordHeader "$postRecord" owner )" "$MMDAPP/.local/agents/sessions/$postId" \
		--session-id "$postId" "$@" < /dev/null > /dev/null 2>&1 || :
	printf 'posted\t%s\n' "$postDone${postDone:+ }$postMark" | AgentsToolsSpawnSessionRecordNote "$postRecord" || :
}

## Whether a child's run is dead and the death path leaves it to the parent: open, of this host, no process runs as it, no
## question of its session waits, no control thread holds its death (AgentsToolsSessionControlDeathHeld), and nothing of it
## changed for 15 minutes -- the advance pass's own conditions (AgentsToolsAdvanceSpawnHousekeeping). rc 0 dead.
AgentsToolsSpawnSessionParentChildDead(){ ## child record
	local deadId deadSession deadHost
	deadId="${1##*/}" ; deadId="${deadId%.spawn.md}"
	deadSession="$( AgentsToolsSpawnSandboxRecordHeader "$1" session-id )"
	deadHost="$( AgentsToolsSpawnSandboxRecordHeader "$1" host )"
	[ "$( AgentsToolsSpawnSandboxRecordHeader "$1" status )" = spawn-started ] || return 1
	[ -z "$deadHost" ] || [ "$deadHost" = "$( hostname -s 2> /dev/null || echo unknown )" ] || return 1
	type AgentsToolsRegistrySpawnRuns > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.Registries.include" 2> /dev/null || return 1
	! AgentsToolsRegistrySpawnRuns "$deadId" "$1" || return 1
	! AgentsToolsRegistryPendingSessionOpen "$deadSession" || return 1
	type AgentsToolsSessionControlDeathHeld > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionControlDeath.include" 2> /dev/null || return 1
	! AgentsToolsSessionControlDeathHeld "$deadSession" "$deadId" 2> /dev/null || return 1
	[ -z "$( find "${1%/*}" "$MMDAPP/.local/agents/sessions/$deadId" "$MMDAPP/.local/agents/sessions/$deadSession" -type f -mmin -15 2> /dev/null | head -1 )" ] || return 1
	return 0
}

## One pass of the watcher. Its children are rebuilt from the records that name the parent as their parent session; a dead one
## is closed by the death path; queued members start while fewer than `workers:` are open and the caller is there (gone, the
## queue holds and says so once); then the close (AgentsToolsSpawnSessionParentClose). rc 0: the parent is closed or gone, and
## its watcher ends; rc 1: it goes on.
AgentsToolsSpawnSessionParentTick(){ ## parent record
	local tickRecord="$1" tickId tickChildren="" tickOpen="" tickFile tickChild tickStatus tickPending tickWorkers tickEntry tickRest
	local tickStarted tickFailed tickRoute tickCount tickKnown
	[ -f "$tickRecord" ] && [ "$( AgentsToolsSpawnSandboxRecordHeader "$tickRecord" status )" = spawn-started ] || return 0
	type AgentsToolsAssertBareName > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.BareName.include"
	tickId="${tickRecord##*/}" ; tickId="${tickId%.spawn.md}"
	AgentsToolsSpawnSessionParentPost "$tickRecord" start --kind notice --field what="agent-less parent of $( AgentsToolsSpawnSandboxRecordHeader "$tickRecord" routine ): children $( AgentsToolsSpawnSandboxRecordHeader "$tickRecord" children ), queued ${tickPending:-$( AgentsToolsSpawnSandboxRecordHeader "$tickRecord" pending )}, at most $( AgentsToolsSpawnSandboxRecordHeader "$tickRecord" workers ) at once"
	## The children it names keep their order; a record found that it does not name yet is added after them.
	tickKnown="$( AgentsToolsSpawnSandboxRecordHeader "$tickRecord" children )"
	tickChildren="$tickKnown"
	for tickFile in $( LC_ALL=C grep -l -x -F "parent-session-id: $tickId" "$MMDAPP"/.local/agents/spawned/*/*.spawn.md 2> /dev/null ) ; do
		tickChild="$( AgentsToolsSpawnSandboxRecordHeader "$tickFile" session-id )"
		AgentsToolsAssertBareName "$tickChild" "a child's session" AgentsToolsSpawnSessionParentTick 2> /dev/null || continue
		case " $tickChildren " in *" $tickChild "*) ;; *) tickChildren="$tickChildren${tickChildren:+ }$tickChild" ;; esac
		if AgentsToolsSpawnSessionParentChildDead "$tickFile" ; then
			AgentsToolsSessionControlDeathClose "$tickFile" > /dev/null 2>&1 || :
			AgentsToolsSpawnSessionParentPost "$tickRecord" "dead:${tickFile##*/}" --kind error \
				--field what="agent-less parent: the run of child $tickChild ($( AgentsToolsSpawnSandboxRecordHeader "$tickFile" owner )) is dead, closed as $( AgentsToolsSpawnSandboxRecordHeader "$tickFile" status )"
		fi
		[ "$( AgentsToolsSpawnSandboxRecordHeader "$tickFile" status )" != spawn-started ] || case " $tickOpen " in *" $tickChild "*) ;; *) tickOpen="$tickOpen $tickChild" ;; esac
	done
	for tickChild in $tickChildren ; do
		case " $tickOpen " in *" $tickChild "*) continue ;; esac
		tickStatus="$( AgentsToolsSpawnSandboxRecordHeader "$MMDAPP/.local/agents/spawned/$tickChild/$tickChild.spawn.md" status )"
		AgentsToolsSpawnSessionParentPost "$tickRecord" "closed:$tickChild" --kind notice --field what="agent-less parent: child $tickChild closed: ${tickStatus#spawn-}"
	done
	[ "$tickChildren" = "$tickKnown" ] \
		|| printf 'children\t%s\n' "$tickChildren" | AgentsToolsSpawnSessionRecordNote "$tickRecord" || :
	## The queue: started while there is room and the caller is there.
	tickPending="$( AgentsToolsSpawnSandboxRecordHeader "$tickRecord" pending )"
	if [ -n "$tickPending" ] ; then
		tickRoute="$( AgentsToolsSpawnSandboxRecordHeader "$tickRecord" "$agentsRunRouteField" )"
		case "$tickRoute" in
			*:*) AgentsToolsRunRouteAvailable "${tickRoute%%:*}" "${tickRoute#*:}" "$tickRecord" || tickRoute="" ;;
		esac
		if [ -z "$tickRoute" ] ; then
			AgentsToolsSpawnSessionParentPost "$tickRecord" caller-gone --kind error \
				--field what="agent-less parent: its caller is gone, so the queue holds: $tickPending; the children running go on"
		else
			tickWorkers="$( AgentsToolsSpawnSandboxRecordHeader "$tickRecord" workers )"
			case "$tickWorkers" in ''|*[!0123456789]*|0) tickWorkers="$agentsSpawnSessionParentWorkers" ;; esac
			tickCount="$( printf '%s\n' $tickOpen | LC_ALL=C grep -c . )"
			while [ -n "$tickPending" ] && [ "$tickCount" -lt "$tickWorkers" ] ; do
				read -r tickEntry tickRest <<< "$tickPending"
				if tickStarted="$( AgentsToolsSpawnSessionParentStart "$tickId" "$tickEntry" )" ; then
					tickChildren="$tickChildren${tickChildren:+ }$tickStarted" ; tickCount=$(( tickCount + 1 ))
					printf 'pending\t%s\nchildren\t%s\n' "$tickRest" "$tickChildren" | AgentsToolsSpawnSessionRecordNote "$tickRecord" || :
					AgentsToolsSpawnSessionParentPost "$tickRecord" "started:$tickStarted" --kind notice --field what="agent-less parent: child $tickStarted ($tickEntry) started"
				else
					tickFailed="$( AgentsToolsSpawnSandboxRecordHeader "$tickRecord" start-failed )"
					printf 'pending\t%s\nstart-failed\t%s\n' "$tickRest" "$tickFailed${tickFailed:+ }$tickEntry" | AgentsToolsSpawnSessionRecordNote "$tickRecord" || :
					AgentsToolsSpawnSessionParentPost "$tickRecord" "start-failed:$tickEntry" --kind error --field what="agent-less parent: the start of $tickEntry failed; the rest go on"
				fi
				tickPending="$tickRest"
			done
		fi
	fi
	AgentsToolsSpawnSessionParentClose "$tickRecord" || return 1
	AgentsToolsSpawnSessionParentPost "$tickRecord" end --kind notice --field what="agent-less parent: done, $( AgentsToolsSpawnSandboxRecordHeader "$tickRecord" status )"
	return 0
}

## The watcher: its own process and start on the record as its first act, then a pass every 2 seconds until the parent is
## closed. Started by AgentsToolsSpawnSessionParentLaunch, never in a caller's own process.
AgentsToolsSpawnSessionParent(){ ## parent session id
	local watchRecord="$MMDAPP/.local/agents/spawned/$1/$1.spawn.md" watchPid
	[ -f "$watchRecord" ] || return 0
	## This process's own pid, which bash 3.2 has no BASHPID for: the parent of a child it starts.
	watchPid="$( exec sh -c 'echo "$PPID"' )"
	type AgentsToolsAssertBareName > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.BareName.include"
	type AgentsToolsRegistryProcessStart > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.Registries.include"
	printf 'host\t%s\nrun-process\t%s\n' "$( hostname -s 2> /dev/null || echo unknown )" "$watchPid $( AgentsToolsRegistryProcessStart "$watchPid" )" | AgentsToolsSpawnSessionRecordNote "$watchRecord" || return 1
	until AgentsToolsSpawnSessionParentTick "$watchRecord" ; do sleep 2 ; done
}

## The watcher started fully detached: a process group of its own, no terminal, stdin from /dev/null, disowned, so it outlives its
## caller and no signal to the caller's group reaches it. Waits up to 10 seconds for the watcher to name itself on the record.
## rc 1 where it did not. Used by --spawn-session and by housekeeping, for a parent whose watcher is gone.
AgentsToolsSpawnSessionParentLaunch(){ ## parent session id
	local launchRecord="$MMDAPP/.local/agents/spawned/$1/$1.spawn.md" launchPid launchLeft=10
	[ -f "$launchRecord" ] || return 1
	mkdir -p "$MMDAPP/.local/agents/sessions" 2> /dev/null || :
	set -m
	( trap '' HUP
	  exec "$BASH" -c '. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh" ; . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SpawnSandbox.include" ; AgentsToolsSpawnSessionParent "$1"' agent-less-parent "$1"
	) < /dev/null >> "$MMDAPP/.local/agents/sessions/$1.log" 2>&1 &
	launchPid=$!
	set +m
	disown "$launchPid" 2> /dev/null || :
	while [ "$launchLeft" -gt 0 ] ; do
		LC_ALL=C grep -q -E "^run-process: $launchPid( |\$)" "$launchRecord" 2> /dev/null && return 0
		sleep 1 ; launchLeft=$(( launchLeft - 1 ))
	done
	return 1
}

## A parent whose watcher is gone, its record still open: its watcher started again, where its record is of this host. rc 0
## started; rc 1 not (another host's, closed, or its watcher still runs). Housekeeping calls it.
AgentsToolsSpawnSessionParentRevive(){ ## parent record
	local reviveId reviveHost
	reviveId="${1##*/}" ; reviveId="${reviveId%.spawn.md}"
	[ "$( AgentsToolsSpawnSandboxRecordHeader "$1" agent-less )" = true ] && [ "$( AgentsToolsSpawnSandboxRecordHeader "$1" status )" = spawn-started ] || return 1
	reviveHost="$( AgentsToolsSpawnSandboxRecordHeader "$1" host )"
	[ -z "$reviveHost" ] || [ "$reviveHost" = "$( hostname -s 2> /dev/null || echo unknown )" ] || return 1
	type AgentsToolsRegistryRecordedRunAlive > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.Registries.include" 2> /dev/null || return 1
	! AgentsToolsRegistryRecordedRunAlive "$1" || return 1
	AgentsToolsSpawnSessionParentLaunch "$reviveId"
}

## Who reviews an item: its `review-by`, where it names one (`none`: nobody), else whoever the
## run of its spawn-id reports to (AgentsToolsRunRoute), `none` included. Empty for an item with
## no review-by and no run of its own here, which magic-coordinator reviews, as it always did.
AgentsToolsItemReviewer(){ ## item path
	local reviewerBy reviewerSpawn reviewerRecord
	type AgentsToolsAssertBareName > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.BareName.include"
	reviewerBy="$( AgentsToolsSpawnSandboxRecordHeader "$1" review-by )"
	[ -z "$reviewerBy" ] || { printf '%s\n' "$reviewerBy" ; return 0 ; }
	reviewerSpawn="$( AgentsToolsSpawnSandboxRecordHeader "$1" spawn-id )"
	AgentsToolsAssertBareName "$reviewerSpawn" "the item's spawn-id" AgentsToolsItemReviewer 2> /dev/null || return 0
	for reviewerRecord in "${MMDAPP:-/nonexistent}"/.local/agents/spawned/*/"$reviewerSpawn.spawn.md" ; do
		[ -f "$reviewerRecord" ] || continue
		AgentsToolsRunRoute "$reviewerRecord"
		return 0
	done
	return 0
}

## ---- THE SEAT, AND WHEN A RUN IS DISMISSED (F6.9) ----
## THE SEAT. A member is active once in a session: of its runs there, the one that holds its
## seat reads the session and posts in it, and there is no seatless run. The seat is a
## file of the session's own folder, sessions/<session>/seats/<member>, holding the spawn id of
## the run that holds it. A run takes it at its first read of the session or post to it (the
## served Wait and SendMessage of the harness), and a start by the spawn proxy takes it at once,
## which refuses to start a second run of a member whose seat a live run holds. A run that finds
## the seat held by a live run at its first read or post is refused outright, naming the holder
## and <session>:<member>, and ends (AgentsHarnessSeatRefuse). The first run to
## take it holds it, and start times play no part. A holder that no longer runs holds nothing:
## the next live run of its member takes the seat at its next read or post. A restart, known by
## `restarted-from: <spawn-id>` on its record, takes it over from the run it replaces while that
## one lives. The close of a run gives up the seat it holds.

## The seat's file, printed. rc 1 for a session or member that is no bare name.
AgentsToolsSessionSeatFile(){ ## session, member
	type AgentsToolsAssertBareName > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.BareName.include"
	AgentsToolsAssertBareName "$1" "the session" AgentsToolsSessionSeatFile 2> /dev/null && AgentsToolsAssertBareName "$2" "the member" AgentsToolsSessionSeatFile 2> /dev/null || return 1
	printf '%s' "${MMDAPP:-/nonexistent}/.local/agents/sessions/$1/seats/$2"
}

## The spawn record of a run, by its spawn id: printed, rc 0; rc 1 where none is found here.
## THE RECORD FILE OF A SPAWN, found the one way: a file named <spawn-id>.spawn.md in whatever
## folder of spawned/ holds it -- the folder's own name is NOT the id (a relocated or renamed
## sandbox keeps its record's name). Nothing where no such file is there, or where the record's
## own spawn-id says otherwise. Both readers use it: the harness that writes a run's files, and
## the manager that reads them, so the two cannot look in different places.
AgentsToolsSpawnRecordPath(){ ## spawn id
	local recordPath
	case "$1" in
		''|*/*|*..*) return 0 ;;
	esac
	[ -n "${MMDAPP:-}" ] || return 0
	for recordPath in "$MMDAPP/.local/agents/spawned"/*/"$1.spawn.md" ; do
		[ -f "$recordPath" ] || continue
		case "$( LC_ALL=C sed -n 's/^spawn-id: //p' "$recordPath" 2> /dev/null | head -1 )" in
			''|"$1") ;;
			*) continue ;;
		esac
		printf '%s' "$recordPath"
		return 0
	done
	return 0
}

AgentsToolsSessionRunRecord(){ ## spawn id
	local runRecord
	type AgentsToolsAssertBareName > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.BareName.include"
	AgentsToolsAssertBareName "$1" "the run" AgentsToolsSessionRunRecord 2> /dev/null || return 1
	for runRecord in "${MMDAPP:-/nonexistent}"/.local/agents/spawned/*/"$1.spawn.md" ; do
		[ ! -f "$runRecord" ] || { printf '%s' "$runRecord" ; return 0 ; }
	done
	return 1
}

## Whether the run of a spawn record still runs, by the one rule a run is alive by
## (AgentsReviewChildLive, AgentsTools.ReviewFlow.include): rc 0 it does.
AgentsToolsSessionRecordLive(){ ## spawn record
	type AgentsReviewChildLive > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.ReviewFlow.include" 2> /dev/null || return 1
	AgentsReviewChildLive "$1" > /dev/null 2>&1
}

## Who holds a member's seat in a session: the spawn id, printed, rc 0, where the seat names a run
## that still runs; rc 1, nothing printed, where nobody holds it.
AgentsToolsSessionSeatHolder(){ ## session, member
	local holderFile holderId="" holderRecord
	holderFile="$( AgentsToolsSessionSeatFile "$1" "$2" )" || return 1
	[ -f "$holderFile" ] || return 1
	IFS= read -r holderId < "$holderFile" || :
	holderRecord="$( AgentsToolsSessionRunRecord "$holderId" )" || return 1
	AgentsToolsSessionRecordLive "$holderRecord" || return 1
	printf '%s\n' "$holderId"
}

## Whether a member's instance is present in a session: a spawn record of that session is the member's and still says
## `spawn-started`, which is the one rule the tooling tells a run that is over by -- a closed record no longer says it. The
## process is not asked for: a start's record is written and its seat taken before the run's own process exists, so a scan that
## start runs would otherwise not see the instance it is starting. A record of a run that ended is no presence, and a message of
## that session's thread is work again. One grep over the records, then the owners of the few the session has. rc 0 it is present;
## rc 1 it is not, and nothing is printed.
AgentsToolsSessionMemberPresent(){ ## session, member
	local presentRecord presentRecords
	presentRecords="$( LC_ALL=C grep -l -x -F "session-id: $1" "${MMDAPP:-/nonexistent}"/.local/agents/spawned/*/*.spawn.md 2> /dev/null )" || return 1
	[ -n "$presentRecords" ] || return 1
	while IFS= read -r presentRecord ; do
		[ -n "$presentRecord" ] && [ -f "$presentRecord" ] || continue
		[ "$( AgentsToolsSpawnSandboxRecordHeader "$presentRecord" owner )" = "$2" ] || continue
		[ "$( AgentsToolsSpawnSandboxRecordHeader "$presentRecord" status )" = spawn-started ] || continue
		return 0
	done <<< "$presentRecords"
	return 1
}

## Whether a member has been in a session before, whatever became of its run: a spawn record of that session is the member's, started or
## closed. A member that comes back into its own session (a work-duty that starts again) is no one brought in: the thread says it once, the
## first time. rc 0 it has a record there; rc 1 it has none.
AgentsToolsSessionMemberHasRecord(){ ## session, member
	local hadRecord hadRecords
	hadRecords="$( LC_ALL=C grep -l -x -F "session-id: $1" "${MMDAPP:-/nonexistent}"/.local/agents/spawned/*/*.spawn.md 2> /dev/null )" || return 1
	while IFS= read -r hadRecord ; do
		[ -n "$hadRecord" ] && [ -f "$hadRecord" ] || continue
		[ "$( AgentsToolsSpawnSandboxRecordHeader "$hadRecord" owner )" = "$2" ] && return 0
	done <<< "$hadRecords"
	return 1
}

## The follow of a run's output, as tail -f gives it: what the file gets, on stdout, from its start. It ends once the shell
## that started it is gone (its parent is no longer that shell), so a follow its proxy could not end, a proxy ended by KILL,
## never outlives it.
AgentsToolsSpawnProxyFollow(){ ## file
	local followSelf followStarter followAt=0 followSize
	followSelf="$( exec sh -c 'echo "$PPID"' )"
	followStarter="$( ps -o ppid= -p "$followSelf" 2> /dev/null | tr -d ' ' )"
	while [ "${followStarter:-1}" != 1 ] && [ "$( ps -o ppid= -p "$followSelf" 2> /dev/null | tr -d ' ' )" = "$followStarter" ] ; do
		followSize="$( wc -c < "$1" 2> /dev/null | tr -d ' ' )"
		if [ "${followSize:-0}" -gt "$followAt" ] ; then
			tail -c +"$(( followAt + 1 ))" "$1" | head -c "$(( followSize - followAt ))"
			followAt="$followSize"
		fi
		sleep 1
	done
}

## The seat's lock, a folder beside it (mkdir is the lock primitive), for one read and write:
## rc 0 taken, rc 1 not within about five seconds. One older than a minute was left by a call
## that died holding it, and is cleared.
AgentsToolsSessionSeatLock(){ ## seat file
	local lockTries=0
	mkdir -p "${1%/*}" 2> /dev/null || return 1
	while ! mkdir "$1.lock" 2> /dev/null ; do
		lockTries=$(( lockTries + 1 ))
		[ "$lockTries" -lt 50 ] || return 1
		[ -z "$( find "$1.lock" -maxdepth 0 -mmin +1 2> /dev/null )" ] || rmdir "$1.lock" 2> /dev/null || :
		sleep 0.1 2> /dev/null || sleep 1
	done
	return 0
}

## The seat taken for a run where nobody holds it, where its holder no longer runs, or where the
## run restarts its holder: rc 0, nothing printed, the run holds it (already, or now). rc 1, the
## holder's spawn id printed, where another live run holds it. rc 2 where the seat could not be
## read or written now: nothing is taken, and the next read or post asks again.
AgentsToolsSessionSeatTake(){ ## session, member, the run's spawn record
	local takeFile takeRun takeHolder="" takeHolderRecord takeTemp="" takeRc=0
	takeFile="$( AgentsToolsSessionSeatFile "$1" "$2" )" || return 2
	takeRun="${3##*/}" ; takeRun="${takeRun%.spawn.md}"
	AgentsToolsSessionSeatLock "$takeFile" || return 2
	[ ! -f "$takeFile" ] || IFS= read -r takeHolder < "$takeFile" || :
	if [ -n "$takeHolder" ] && [ "$takeHolder" != "$takeRun" ] && takeHolderRecord="$( AgentsToolsSessionRunRecord "$takeHolder" )" \
		&& AgentsToolsSessionRecordLive "$takeHolderRecord" ; then
		[ "$( AgentsToolsSpawnSandboxRecordHeader "$3" restarted-from )" = "$takeHolder" ] || takeRc=1
	fi
	if [ "$takeRc" = 0 ] && [ "$takeHolder" != "$takeRun" ] ; then
		takeTemp="$( mktemp "$takeFile.XXXXXX" 2> /dev/null )" && printf '%s\n' "$takeRun" > "$takeTemp" && mv -f "$takeTemp" "$takeFile" \
			|| { [ -z "$takeTemp" ] || rm -f "$takeTemp" ; takeRc=2 ; }
	fi
	rmdir "$takeFile.lock" 2> /dev/null || :
	[ "$takeRc" != 1 ] || printf '%s\n' "$takeHolder"
	return "$takeRc"
}

## The seat a run holds, given up as it closes: only where the seat still names that run.
AgentsToolsSessionSeatRelease(){ ## session, member, spawn id
	local releaseFile releaseHolder=""
	releaseFile="$( AgentsToolsSessionSeatFile "$1" "$2" )" || return 0
	[ -f "$releaseFile" ] || return 0
	AgentsToolsSessionSeatLock "$releaseFile" || return 0
	IFS= read -r releaseHolder < "$releaseFile" || :
	[ "$releaseHolder" != "$3" ] || rm -f "$releaseFile"
	rmdir "$releaseFile.lock" 2> /dev/null || :
	return 0
}

## Whether a run is without its seat: another run of its member that still runs holds it. rc 0 it is.
AgentsToolsSessionRunSeatless(){ ## spawn record
	local lessRun lessHolder
	lessRun="${1##*/}" ; lessRun="${lessRun%.spawn.md}"
	lessHolder="$( AgentsToolsSessionSeatHolder "$( AgentsToolsSpawnSandboxRecordHeader "$1" session-id )" "$( AgentsToolsSpawnSandboxRecordHeader "$1" owner )" )" || return 1
	[ "$lessHolder" != "$lessRun" ]
}

## WHEN A RUN IS DISMISSED. The participants of a session are the runs its spawn records name
## (`session-id`); one runs while its own process does (AgentsToolsSessionRecordLive), and a run
## without its seat is no running participant. The executor of a session is the run that founded
## it (`start-context: spawned`; on a record older than that field, the one whose spawn id is the
## session's). An executor is not dismissed while another participant of its session runs,
## whatever dismisses it, and the tooling's review-wait limit dismisses no run while another
## participant of its session runs. A dismissal held so is kept beside the run
## (sessions/<spawn-id>/dismiss-held) and given at its first Wait once the others have ended.

## The participants of a run's session that still run, other than it: their spawn ids, one a
## line, rc 0; rc 1, nothing printed, where none does.
AgentsToolsSessionOthersRunning(){ ## spawn record
	local othersSession othersOwn othersCandidate othersId othersFound=1
	othersSession="$( AgentsToolsSpawnSandboxRecordHeader "$1" session-id )"
	type AgentsToolsAssertBareName > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.BareName.include"
	AgentsToolsAssertBareName "$othersSession" "the session" AgentsToolsSessionOthersRunning 2> /dev/null || return 1
	othersOwn="${1##*/}" ; othersOwn="${othersOwn%.spawn.md}"
	for othersCandidate in $( LC_ALL=C grep -l -x -F "session-id: $othersSession" "${MMDAPP:-/nonexistent}"/.local/agents/spawned/*/*.spawn.md 2> /dev/null ) ; do
		othersId="${othersCandidate##*/}" ; othersId="${othersId%.spawn.md}"
		[ "$othersId" != "$othersOwn" ] || continue
		AgentsToolsSessionRecordLive "$othersCandidate" || continue
		! AgentsToolsSessionRunSeatless "$othersCandidate" || continue
		printf '%s\n' "$othersId"
		othersFound=0
	done
	return "$othersFound"
}

## Whether a run founded its session, its executor: rc 0 it did.
AgentsToolsSessionRunExecutor(){ ## spawn record
	local execContext execRun
	execContext="$( AgentsToolsSpawnSandboxRecordHeader "$1" start-context )"
	if [ -n "$execContext" ] ; then
		[ "$execContext" = spawned ]
		return
	fi
	execRun="${1##*/}" ; execRun="${execRun%.spawn.md}"
	[ "$execRun" = "$( AgentsToolsSpawnSandboxRecordHeader "$1" session-id )" ]
}

## Whether an address names a run of member M in session S: M itself, `S:M`, or `S` alone where the
## run is the executor of S, as a session named without a member means its executor (F6.8).
AgentsToolsSessionAddressNames(){ ## address, session, member, `executor` where the run is S's executor
	case "$1" in
		''|'-') return 1 ;;
		"$3"|"$2:$3") return 0 ;;
		"$2") [ "${4:-}" = executor ] ;;
		*) return 1 ;;
	esac
}

## The live runs that need a run: in its own session, or in a session it is the parent of
## (`parent-session-id:`), a run that names it in its own `reports-to:`, or in the `review-by:` of
## the item it works (its `spawns:`). Their spawn ids, one a line, rc 0; rc 1 where none does.
AgentsToolsSessionRunNamedBy(){ ## spawn record
	local namedSession namedMember namedOwn namedExecutor="" namedCandidate namedId namedFound=1 namedItem namedItemPath
	namedSession="$( AgentsToolsSpawnSandboxRecordHeader "$1" session-id )"
	namedMember="$( AgentsToolsSpawnSandboxRecordHeader "$1" owner )"
	type AgentsToolsAssertBareName > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.BareName.include"
	AgentsToolsAssertBareName "$namedSession" "the session" AgentsToolsSessionRunNamedBy 2> /dev/null && AgentsToolsAssertBareName "$namedMember" "the member" AgentsToolsSessionRunNamedBy 2> /dev/null || return 1
	namedOwn="${1##*/}" ; namedOwn="${namedOwn%.spawn.md}"
	! AgentsToolsSessionRunExecutor "$1" || namedExecutor="executor"
	type AgentsToolsDecisionsItemPath > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.ItemDecisions.include" 2> /dev/null || :
	for namedCandidate in $( LC_ALL=C grep -l -x -F -e "session-id: $namedSession" -e "parent-session-id: $namedSession" "${MMDAPP:-/nonexistent}"/.local/agents/spawned/*/*.spawn.md 2> /dev/null ) ; do
		namedId="${namedCandidate##*/}" ; namedId="${namedId%.spawn.md}"
		[ "$namedId" != "$namedOwn" ] || continue
		AgentsToolsSessionRecordLive "$namedCandidate" || continue
		if ! AgentsToolsSessionAddressNames "$( AgentsToolsSpawnSandboxRecordHeader "$namedCandidate" "$agentsRunRouteField" )" "$namedSession" "$namedMember" "$namedExecutor" ; then
			namedItem="$( AgentsToolsSpawnSandboxRecordHeader "$namedCandidate" spawns )"
			[ -n "$namedItem" ] && namedItemPath="$( AgentsToolsDecisionsItemPath "$namedItem" 2> /dev/null )" || continue
			AgentsToolsSessionAddressNames "$( AgentsToolsSpawnSandboxRecordHeader "$namedItemPath" review-by )" "$namedSession" "$namedMember" "$namedExecutor" || continue
		fi
		printf '%s\n' "$namedId"
		namedFound=0
	done
	return "$namedFound"
}

## Whether a dismissal of a run waits: it is its session's executor, or a run of magic-coordinator however
## it came in, and another participant of that session still runs, or a live run needs it
## (AgentsToolsSessionRunNamedBy). rc 0 it waits, those runs printed, one a line; rc 1 it does not.
AgentsToolsSessionDismissHeld(){ ## spawn record
	local heldOthers="" heldNamed=""
	if AgentsToolsSessionRunExecutor "$1" || [ "$( AgentsToolsSpawnSandboxRecordHeader "$1" owner )" = magic-coordinator ] ; then
		heldOthers="$( AgentsToolsSessionOthersRunning "$1" )" || heldOthers=""
	fi
	heldNamed="$( AgentsToolsSessionRunNamedBy "$1" )" || heldNamed=""
	[ -n "$heldOthers$heldNamed" ] || return 1
	printf '%s\n%s\n' "$heldOthers" "$heldNamed" | LC_ALL=C awk 'NF && !seen[$0]++'
}

## Whether the review-wait limit waits for a run: another participant of its session still runs,
## or a live run needs it. rc 0 it waits, those runs printed, one a line; rc 1 it does not.
AgentsToolsSessionLimitHeld(){ ## spawn record
	local limitOthers="" limitNamed=""
	limitOthers="$( AgentsToolsSessionOthersRunning "$1" )" || limitOthers=""
	limitNamed="$( AgentsToolsSessionRunNamedBy "$1" )" || limitNamed=""
	[ -n "$limitOthers$limitNamed" ] || return 1
	printf '%s\n%s\n' "$limitOthers" "$limitNamed" | LC_ALL=C awk 'NF && !seen[$0]++'
}

## A dismissal kept for a run until it may be given: who dismissed it, then `handback-given`
## where its handback is given already. Kept once: the first one held is the one given.
AgentsToolsSessionDismissHold(){ ## spawn id, who dismissed it, handback-given (may be empty)
	local holdFile holdTemp=""
	type AgentsToolsAssertBareName > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.BareName.include"
	AgentsToolsAssertBareName "$1" "the run" AgentsToolsSessionDismissHold 2> /dev/null || return 0
	holdFile="${MMDAPP:-/nonexistent}/.local/agents/sessions/$1/dismiss-held"
	[ ! -f "$holdFile" ] || return 0
	mkdir -p "${holdFile%/*}" 2> /dev/null || return 0
	holdTemp="$( mktemp "$holdFile.XXXXXX" 2> /dev/null )" || return 0
	printf '%s\n%s\n' "${2:-unknown}" "${3:-}" > "$holdTemp" && mv -f "$holdTemp" "$holdFile" || rm -f "$holdTemp"
	return 0
}

## The thread of the session this run reports to (AgentsToolsRunRoute), from this run's own
## spawn record, the one MDAT_SPAWN_SESSION_ID names: prints "<channel>:<ts> <session>" and
## returns 0. Returns 1, nothing printed, when it reports to no session (a member, a person,
## or no record), and 2, the session printed, when that session has no thread to find
## (AgentsToolsSpawnParentThread, which finds magic-coordinator's where the session has none).
## The sandbox folder is named by tracking name or session id, so records are found by file name.
AgentsToolsSessionParentThreadFind(){
	local parentRecord="" parentCandidate parentRoute parentSession parentThread=""
	for parentCandidate in "${MMDAPP:-/nonexistent}"/.local/agents/spawned/*/"${MDAT_SPAWN_SESSION_ID:-none}.spawn.md" ; do
		[ ! -f "$parentCandidate" ] || { parentRecord="$parentCandidate" ; break ; }
	done
	[ -n "$parentRecord" ] || return 1
	## A run that reports to a session names that session's thread whether or not the member it reports to still runs there:
	## naming the thread is no routing, and only a handback's route skips a member that is gone (AgentsToolsRunRoute).
	parentRoute="$( AgentsToolsSpawnSandboxRecordHeader "$parentRecord" "$agentsRunRouteField" )"
	case "$parentRoute" in
		*:*) AgentsToolsRunRouteValid "$parentRoute" || parentRoute="" ;;
		*) parentRoute="" ;;
	esac
	[ -n "$parentRoute" ] || parentRoute="$( AgentsToolsRunRoute "$parentRecord" )"
	[ "$( AgentsToolsRunRouteKind "$parentRoute" )" = session ] || return 1
	parentSession="${parentRoute%%:*}"
	type AgentsToolsSpawnParentThread > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.ReviewFlow.include" 2> /dev/null || :
	parentThread="$( AgentsToolsSpawnParentThread "$parentSession" "$MDAT_SPAWN_SESSION_ID" 2> /dev/null )" || parentThread=""
	if [ -z "$parentThread" ] ; then
		printf '%s\n' "$parentSession" ; return 2
	fi
	printf '%s %s\n' "$parentThread" "$parentSession"
}

## The member this run reports to (AgentsToolsRunRoute, AgentsToolsRunRouteMember), from its own
## spawn record, the one MDAT_SPAWN_SESSION_ID names: who its handback and the notes of its end
## are addressed to. Prints the name and returns 0. Returns 1, nothing printed, where it reports
## to a person, or to a session whose executor no record names, or has no record.
AgentsToolsSessionParentMember(){
	local memberRecord="" memberCandidate
	for memberCandidate in "${MMDAPP:-/nonexistent}"/.local/agents/spawned/*/"${MDAT_SPAWN_SESSION_ID:-none}.spawn.md" ; do
		[ ! -f "$memberCandidate" ] || { memberRecord="$memberCandidate" ; break ; }
	done
	[ -n "$memberRecord" ] || return 1
	AgentsToolsRunRouteMember "$( AgentsToolsRunRoute "$memberRecord" )"
}

## A conversation thread is `<channel>:<ts>`: an upper-case Slack id and a message ts.
AgentsToolsSpawnConversationThreadValid(){ ## channel:ts
	printf '%s\n' "$1" | LC_ALL=C grep -qxE '[A-Z0-9]+:[0-9]+\.[0-9]+'
}

## The conversation threads a brief relays messages from, one `<channel>:<ts>` per line:
## a relayed Wait result's own "# arrived on: slack:<channel>:<ts>[:conversation]" line,
## and a Slack permalink carrying thread_ts. Nothing else in a brief is read as one.
AgentsToolsSpawnConversationDerive(){ ## brief text
	printf '%s\n' "$1" | LC_ALL=C awk '
		match( $0, /^# arrived on: slack:[A-Z0-9]+:[0-9]+\.[0-9]+/ ) {
			v = substr( $0, 21, RLENGTH - 20 ) ; if ( ! ( v in seen ) ) { seen[v] = 1 ; print v ; }
		}
		{
			rest = $0
			while ( match( rest, /\/archives\/[A-Z0-9]+\/p[0-9]+\?[^ >)]*thread_ts=[0-9]+\.[0-9]+/ ) ) {
				link = substr( rest, RSTART, RLENGTH ) ; rest = substr( rest, RSTART + RLENGTH )
				ch = link ; sub( /^\/archives\//, "", ch ) ; sub( /\/.*/, "", ch )
				ts = link ; sub( /.*thread_ts=/, "", ts )
				v = ch ":" ts ; if ( ! ( v in seen ) ) { seen[v] = 1 ; print v ; }
			}
		}'
}

## input/conversation.md: the recent history of each conversation thread this spawn continues,
## read as the member, newest MDAT_CONVERSATION_HISTORY_MAX messages (default 50), oldest first.
## A post tagged [sender: <member>] is marked (own); one by another member (team: <name>).
## A thread that cannot be read says so in the file, never reads as an empty one.
## The board item behind the spawn, when there is one, has its `## Decisions` shown ahead of
## the threads: they are binding, and a thread's older messages may be cut.
AgentsToolsSpawnConversationHistory(){ ## output file, member, threads (space-separated), board item path (may be empty)
	local historyFile="$1" historyMember="$2" historyThreads="$3" historyItem="${4:-}" historyThread historyMax historyRead historyDecisions=""
	historyMax="${MDAT_CONVERSATION_HISTORY_MAX:-50}"
	case "$historyMax" in ''|*[!0123456789]*|0) historyMax=50 ;; esac
	[ -n "$historyThreads" ] || return 0
	historyRead="${historyFile%/*}/.conversation.read.$$"
	## Its own item, the one that tracks, and the items its earlier sessions in this sandbox asked under.
	type AgentsToolsDecisionsBlock > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.ItemDecisions.include"
	historyDecisions="$( AgentsToolsDecisionsRelatedPaths "$historyItem" "${historyFile%/input/*}" | while IFS= read -r historyThread ; do
		AgentsToolsDecisionsBlock "$historyThread" 30 && printf '\n'
	done )" || historyDecisions=""
	{
		printf '%s\n' "# Conversation history" ""
		[ -z "$historyDecisions" ] || printf '%s\n\n' "$historyDecisions"
		printf '%s\n' "The conversation this session continues: read it before acting. Newest $historyMax messages per thread, oldest first, one \`<ts> | <user> | <text>\` head per message. (own) marks a post by $historyMember, (team: <name>) one by another team member."
		for historyThread in $historyThreads ; do
			printf '\n## Thread %s\n\n' "$historyThread"
			if DistroAgentsTools --intern-op-comms-slack-read "$historyMember" "$historyThread" --thread > "$historyRead" 2>/dev/null \
				&& LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsSlackMessagesFormat.awk" < "$historyRead" > "$historyRead.fmt" 2>/dev/null ; then
				LC_ALL=C awk -v max="$historyMax" -v member="$historyMember" '
					{ line[NR] = $0 ; if ( $0 ~ /^[0-9]+\.[0-9]+ \| / ) { head[++heads] = NR ; } }
					END {
						if ( heads == 0 ) { print "(no messages)" ; exit ; }
						from = ( heads > max ) ? head[heads - max + 1] : head[1]
						if ( heads > max ) { printf( "(%d older messages not shown)\n", heads - max ) ; }
						for ( i = from ; i <= NR ; i++ ) {
							l = line[i]
							if ( l ~ /^[0-9]+\.[0-9]+ \| / && match( l, /\[sender: [A-Za-z0-9_.-]+\]/ ) ) {
								who = substr( l, RSTART + 9, RLENGTH - 10 )
								l = ( who == member ? "(own) " : "(team: " who ") " ) l
							}
							print l
						}
					}' "$historyRead.fmt"
			else
				printf '%s\n' "(could not be read -- unknown, not empty; read it with the slack read tool)"
				echo "⚠️ WARNING: $MDSC_CMD: conversation history of $historyThread could not be read for $historyMember" >&2
			fi
		done
	} > "$historyFile" 2>/dev/null
	rm -f "$historyRead" "$historyRead.fmt"
	return 0
}

## The conversation threads this spawn continues, space-separated: MDAT_CONVERSATION_THREADS,
## which the spawn proxy passes to the console, else the `conversation-threads:` field of this
## spawn's own record in its sandbox root. Prints nothing and returns 1 when there are none.
AgentsToolsConversationThreadsFind(){
	[ -z "${MDAT_CONVERSATION_THREADS:-}" ] || { printf '%s\n' "$MDAT_CONVERSATION_THREADS" ; return 0 ; }
	[ -n "${MDAT_SPAWN_SESSION_ID:-}" ] || return 1
	local recordFile="${MDAT_SPAWN_SANDBOX_ROOT:-$MMDAPP/.local/agents/spawned/$MDAT_SPAWN_SESSION_ID}/$MDAT_SPAWN_SESSION_ID.spawn.md" recordThreads=""
	[ -f "$recordFile" ] || return 1
	recordThreads="$( LC_ALL=C awk '/^---$/ { if ( ++fm == 2 ) exit ; next ; } fm == 1 && /^conversation-threads: / { print substr( $0, 23 ) ; exit ; }' "$recordFile" )"
	[ -n "$recordThreads" ] || return 1
	printf '%s\n' "$recordThreads"
	return 0
}

## A bare Wait's default sources, space-separated: this session's own thread and every
## conversation thread it continues, each as slack:<channel>:<ts>:conversation, no repeats.
## Prints nothing and returns 1 when there is neither (the solo default then applies).
## THE CHANNEL KIND IS DECIDED FIRST (F2.3, F3.1): a session whose external side is the root-native printback
## channel, or the tooling thread -- `none` or `track` on the session's own record -- has one default source,
## that session's `chat:<session>` read, and it is answered before a thread or a conversation is looked for.
## A conversation thread is a Slack source, and such a session is on no Slack channel of its own, so a Wait of
## it must not watch one even where the spawn handed some down: what the tooling thread received is recorded in
## the one chat file, and the chat file is what is read back. Only a session on another kind -- `full`, a
## session on a recorded thread, one with no kind recorded -- reaches the Slack sources, exactly as it always
## did.
AgentsToolsWaitDefaultSources(){
	local defaultThread defaultList="" defaultSeen=" " defaultChat="" defaultKind=""
	type AgentsToolsCommsPrintbackSessionInUse > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.CommsPrintback.include" 2> /dev/null || :
	type AgentsToolsSessionChatKey > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionChat.include" 2> /dev/null || :
	type AgentsToolsRootHarnessKindRead > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.RootHarnessKind.include" 2> /dev/null || :
	defaultChat="$( AgentsToolsSessionChatKey 2> /dev/null )" || defaultChat=""
	if [ -n "$defaultChat" ] ; then
		## THE KIND THE SESSION RECORDED (F3.1), before any thread or conversation: `none` and `track` are read
		## from the one chat file, and only another kind reaches the Slack sources.
		defaultKind="$( AgentsToolsRootHarnessKindRead "$defaultChat" 2> /dev/null )" || defaultKind=""
		case "$defaultKind" in
			none|track)
				printf 'chat:%s\n' "$defaultChat"
				return 0
			;;
		esac
		## A session with no kind recorded keeps the F2.3 mark's decision: the printback channel is read from the
		## chat file, and one on a thread (or on no channel) reaches the Slack sources as it always did.
		if AgentsToolsCommsPrintbackSessionInUse "$defaultChat" ; then
			printf 'chat:%s\n' "$defaultChat"
			return 0
		fi
	fi
	for defaultThread in $( AgentsToolsSessionThreadFind 2>/dev/null ) $( AgentsToolsConversationThreadsFind 2>/dev/null ) $( AgentsToolsWaitChildThreadSources 2>/dev/null ) ; do
		case "$defaultSeen" in *" $defaultThread "*) continue ;; esac
		defaultSeen="$defaultSeen$defaultThread "
		defaultList="$defaultList${defaultList:+ }slack:$defaultThread:conversation"
	done
	[ -n "$defaultList" ] || return 1
	printf '%s\n' "$defaultList"
	return 0
}

## The session thread of every child this session started (S21.6), live ones only: one still
## running or waiting, by AgentsToolsSessionOthersRunning's own test, deduped by session id --
## a respawned child lists more than once in .local/agents/children/<this spawn-id> (the children
## index, AgentsTools.ChildrenIndex.include), and the file itself says a reader de-duplicates.
## Printed bare, each `<channel>:<ts>`, space-separated, for the caller above to prefix as a
## slack: conversation source same as any other thread. Prints nothing and returns 1 for none.
AgentsToolsWaitChildThreadSources(){
	## The same key a spawn is filed under as a child, by the parent's own run at the moment
	## it spawned (AgentsTools.InternOpAgentSpawnProxy.include): this run's own spawn id, or
	## the native CLI's session id where this run was never itself spawned, the coordinator's
	## own root console included.
	local childKey="${MDAT_SPAWN_SESSION_ID:-${CLAUDE_CODE_SESSION_ID:-}}" childIndexed childRecords childLine childRecord
	local childSeen=" " childSession childThread childList=""
	[ -n "$childKey" ] || return 1
	case "$childKey" in */*|.|..) return 1 ;; esac
	childIndexed="$MMDAPP/.local/agents/children/.indexed"
	if [ -f "$childIndexed" ] ; then
		childRecords=""
		if [ -f "$MMDAPP/.local/agents/children/$childKey" ] ; then
			while IFS= read -r childLine ; do
				[ -n "$childLine" ] || continue
				childRecords="$childRecords$MMDAPP/.local/agents/spawned/$childLine"$'\n'
			done < "$MMDAPP/.local/agents/children/$childKey"
		fi
	else
		childRecords="$( LC_ALL=C grep -l -x -F "parent-spawn-id: $childKey" "$MMDAPP"/.local/agents/spawned/*/*.spawn.md 2> /dev/null )"$'\n' || childRecords=""
	fi
	type AgentsToolsAssertBareName > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.BareName.include" 2> /dev/null || :
	while IFS= read -r childRecord ; do
		[ -n "$childRecord" ] && [ -f "$childRecord" ] || continue
		childSession="$( AgentsToolsSpawnSandboxRecordHeader "$childRecord" session-id )"
		AgentsToolsAssertBareName "$childSession" "the child session" AgentsToolsWaitChildThreadSources 2> /dev/null || continue
		case "$childSeen" in *" $childSession "*) continue ;; esac
		AgentsToolsSessionRecordLive "$childRecord" || continue
		! AgentsToolsSessionRunSeatless "$childRecord" || continue
		childSeen="$childSeen$childSession "
		childThread="$( AgentsToolsSpawnSandboxRecordHeader "$childRecord" session-thread )"
		[ -n "$childThread" ] || continue
		AgentsToolsSpawnConversationThreadValid "$childThread" || continue
		childList="$childList${childList:+ }$childThread"
	done <<< "$childRecords"
	[ -n "$childList" ] || return 1
	printf '%s\n' "$childList"
	return 0
}

## Empties input/ of every sandbox on this host with no live session, and says which; and
## clears the harness scratch a run left in its tmp/ when it ended before its own cleanup.
## A sandbox recorded on another host, or with any session still running, is never touched.
## Running is asked for each record of the one rule a run is recognised by, and of no match
## of this sweep's own (AgentsToolsRegistrySpawnRuns, AgentsTools.Registries.include): a
## process runs as the spawn by its own word, or the process its record names still lives. A
## command line that only carries a spawn's id holds no sandbox: a process of the tooling
## that waits on its session, or another run whose line holds this sandbox's path.
AgentsToolsSpawnSandboxSweep(){ ## where
	local sweepRoot="$MMDAPP/.local/agents/spawned" sweepDir sweepRecord sweepSession sweepHost sweepLive thisHost
	[ -d "$sweepRoot" ] || return 0
	thisHost="$( hostname -s 2>/dev/null )" || thisHost="unknown"
	## A process list that cannot be read says nothing of any run: nothing is touched then.
	ps -A -ww -o args= > /dev/null 2>&1 || return 0
	type AgentsToolsRegistrySpawnRuns > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.Registries.include" 2> /dev/null || return 0
	for sweepDir in "$sweepRoot"/*/ ; do
		sweepDir="${sweepDir%/}"
		[ -d "$sweepDir/input" ] || continue
		[ -n "$( find "$sweepDir/input" "$sweepDir/tmp" -mindepth 1 -maxdepth 1 2>/dev/null | head -1 )" ] || continue
		## A sandbox with no record, or with a record under 10 minutes old, may still be launching.
		sweepLive="no-record"
		for sweepRecord in "$sweepDir"/*.spawn.md ; do
			[ -f "$sweepRecord" ] || continue
			sweepLive=""
			if [ -n "$( find "$sweepRecord" -mmin -10 2>/dev/null )" ] ; then sweepLive="launching" ; break ; fi
			## spawn-id, not session-id: session-id is now the coworking session's own
			## shared identifier, which a joined spawn's own process never carries in
			## its argv, where spawn-id (this process's own identity) always does.
			sweepSession="$( LC_ALL=C awk '/^spawn-id: /{ print substr($0, 11) ; exit ; }' "$sweepRecord" )"
			sweepHost="$( LC_ALL=C awk '/^host: /{ print substr($0, 7) ; exit ; }' "$sweepRecord" )"
			if [ "$sweepHost" != "$thisHost" ] ; then sweepLive="other-host" ; break ; fi
			[ -n "$sweepSession" ] || continue
			if AgentsToolsRegistrySpawnRuns "$sweepSession" "$sweepRecord" ; then sweepLive="running" ; break ; fi
		done
		[ -z "$sweepLive" ] || continue
		if [ -n "$( find "$sweepDir/input" -mindepth 1 -maxdepth 1 2>/dev/null | head -1 )" ] ; then
			AgentsToolsSpawnSandboxCleanInput "$sweepDir"
			echo "# $MDSC_CMD: $1: emptied input/ of ${sweepDir##*/}, whose session is no longer running" >&2
		fi
		## Scratch stays scratch: what a harness run left in tmp/ (a run killed before its
		## own cleanup) goes; whatever mattered was already written to its session log.
		if [ -n "$( find "$sweepDir/tmp" -mindepth 1 -maxdepth 1 2>/dev/null | head -1 )" ] ; then
			find "$sweepDir/tmp" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} + 2>/dev/null
			echo "# $MDSC_CMD: $1: cleared the scratch left in tmp/ of ${sweepDir##*/}, whose session is no longer running" >&2
		fi
	done
	return 0
}

## Which board state folder actually holds an item, or empty when none does.
## AgentsToolsDataRead searches several lookup folders and does not report which
## one matched, and the board upsert has to be told the state -- so it is
## established here rather than assumed to be `running`, which is true only of a
## document this op created itself. A reused tracking document belongs to a caller
## and may sit in any state; moving it would relocate that caller's own work item
## as a side effect of spawning.
AgentsToolsSpawnProxyBoardStateOf(){ ## item-filename
	local stateName
	for stateName in running pending review backlog blocked parked processed archived retained ; do
		if [ -f "$MDAT_DATA_ROOT/board/$stateName/$1" ] ; then
			printf '%s' "$stateName"
			return 0
		fi
	done
	return 0
}

AgentsToolsSpawnProxyCloseDispatch(){
	local itemName="$1" briefBody="$2" childExit="$3" childOutputFile="$4" outcome="$5"
	## Defaulted rather than required, so the create path calls this exactly as it
	## always has and only the reuse path names a state of its own.
	local itemState="${6:-running}"
	## Where the closed item rests, named by the caller rather than derived here.
	## Defaults to no move, so a caller naming no target keeps what it had: a
	## REUSED document belongs to a caller and is never relocated by a spawn
	## closing. One this op created itself moves to `review`, so `running` holds
	## only sessions that are actually running. It stops at `review` and not at
	## `processed` because grooming owns entry to that state -- human-owner ruling,
	## 2026-09-23: "grooming owns the state - but spawn moves to pending - ok? so
	## grooming sees" -- board-review now sits between them, entered here and left
	## only by a reviewer's own reject/accept. This op marks and parks; it never adjudicates the close.
	local itemTargetState="${7:-$itemState}"
	## Why a running item enters review here: a child that ended with no handback, by default.
	local reviewReason="${8:-ended-without-handback}"
	## Why the child ended, where its harness recorded one (a refused request): shown on the
	## Result the reviewer reads, never left to the log alone.
	local childEndReason="${9:-}"
	local currentBody resultBody actualState reviewHeaders=()
	## The close moves only an item still where the caller left it, and the one move it makes
	## is running -> review. An item a handback, a verdict or an ending already moved is never
	## moved out of review, processed or pending by a close: one in review gets its Result in
	## place, any other is left as it is (AgentsTools.ReviewFlow.include).
	actualState="$( AgentsToolsSpawnProxyBoardStateOf "$itemName" )"
	if [ "$actualState" != "$itemState" ] ; then
		if [ "$actualState" != review ] ; then
			echo "# --intern-op-agent-spawn-proxy: $itemName is in ${actualState:-no board state}, not $itemState, so the close leaves it as it is" >&2
			return 0
		fi
		itemState=review ; itemTargetState=review
	fi
	## An item nobody reviews (AgentsToolsItemReviewer says `none`: its review-by, else where its run
	## reports to) does not enter review: it closes straight to processed, and says so in its Decisions.
	local reviewNone=""
	if [ "$itemState" = running ] && [ "$itemTargetState" = review ] && [ "$( AgentsToolsItemReviewer "$MDAT_DATA_ROOT/board/$itemState/$itemName" )" = none ] ; then
		reviewNone="$( date +"%Y-%m-%d %H:%M %z" )" ; itemTargetState="processed"
		reviewHeaders=( --header:upsert:processed-at:"$reviewNone" --header:upsert:execution-receipt:processed:"$reviewNone" )
	fi
	[ "$itemState" != running ] || [ "$itemTargetState" != review ] \
		|| reviewHeaders=( --header:upsert:review-since-epoch:"$( date +%s )" --header:upsert:review-reason:"$reviewReason" )
	type AgentsToolsDataRead > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.InternOpDataRead.include"
	currentBody="$( AgentsToolsDataRead "$itemName" \
		--lookup-folder "$MDAT_DATA_ROOT/board/$itemState" \
		--context --intern-op-agent-spawn-proxy )" || currentBody="$briefBody"
	resultBody="$( printf '%s\n' \
		"$currentBody" \
		"" \
		"## Result" \
		"" \
		"status: $outcome" \
		"exit-code: $childExit" \
		"output-file: $childOutputFile" \
		${childEndReason:+"reason: $childEndReason"} \
		"completed-at: $( date -u +%Y-%m-%dT%H:%M:%SZ )" )"
	mkdir -p "$MDAT_DATA_ROOT/board/$itemTargetState" || {
		echo "⚠️ WARNING: --intern-op-agent-spawn-proxy: can't create board state directory $MDAT_DATA_ROOT/board/$itemTargetState, so dispatch item $itemName was not closed" >&2
		return 0
	}
	printf '%s\n' "$resultBody" | DistroAgentsTools --intern-op-board-upsert-move-edit "$itemTargetState" "$itemName" \
		--from-state:"$itemState" \
		--header:upsert:status:dispatch-"$outcome" \
		--header:upsert:resolved-at:"$( date +"%Y-%m-%d %H:%M %z" )" \
		"${reviewHeaders[@]+"${reviewHeaders[@]}"}" \
		--upsert-from-stdin \
		--context --intern-op-agent-spawn-proxy \
		--log-verb:updated \
		|| { echo "⚠️ WARNING: --intern-op-agent-spawn-proxy: could not close dispatch item $itemName" >&2 ; return 0 ; }
	## The entry into review recorded, in Decisions and the transcript; and an item with no review, as that.
	if [ -n "$reviewNone" ] ; then
		type AgentsReviewRecord > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.ReviewFlow.include"
		AgentsReviewRecord tooling "$itemName" review "none: the child ended ($outcome, exit $childExit), and nobody reviews this item" REVIEW "" || :
	elif [ "${#reviewHeaders[@]}" -gt 0 ] ; then
		type AgentsReviewRecord > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.ReviewFlow.include"
		AgentsReviewRecord tooling "$itemName" review "$reviewReason: the child ended ($outcome, exit $childExit)" REVIEW "" || :
	fi
	return 0
}

## An accept releases the child: a board item moved to processed has its own spawned
## session dismissed, through the same send an explicit spawn-dismiss uses -- a DISMISSED
## body addressed to the child member in the child's session thread, which its Wait turns
## into WAIT-RESULT: DISMISSED. The child is the spawn record the item's spawn-id names,
## or, with none, the one live record whose spawns/spawned-by links the item. Never fails
## the move it follows: prints one ACCEPT-DISMISS line, saying what was sent or why nothing was.
AgentsToolsBoardAcceptDismissChild(){ ## sending member, item path
	local sendBy="$1" itemPath="$2" itemSpawn recordPath="" recordCandidate folderName
	local childStatus childMember childThread="" childHost thisHost sendOut
	itemSpawn="$( AgentsToolsSpawnSandboxRecordHeader "$itemPath" spawn-id )"
	if [ -n "$itemSpawn" ] && [ "$itemSpawn" != "-" ] ; then
		for recordCandidate in "$MMDAPP/.local/agents/spawned"/*/"$itemSpawn.spawn.md" ; do
			[ ! -f "$recordCandidate" ] || { recordPath="$recordCandidate" ; break ; }
		done
	else
		for folderName in $( AgentsToolsSpawnSandboxFoldersOfItem "$itemPath" ) ; do
			for recordCandidate in "$MMDAPP/.local/agents/spawned/$folderName"/*.spawn.md ; do
				[ -f "$recordCandidate" ] || continue
				[ "$( AgentsToolsSpawnSandboxRecordHeader "$recordCandidate" status )" = spawn-started ] || continue
				[ -z "$recordPath" ] || { printf 'ACCEPT-DISMISS: not sent: more than one live spawn links %s, so which child to dismiss is not decided here\n' "${itemPath##*/}" ; return 0 ; }
				recordPath="$recordCandidate"
			done
		done
	fi
	[ -n "$recordPath" ] || { printf 'ACCEPT-DISMISS: not sent: no spawn record found for %s (spawn-id %s)\n' "${itemPath##*/}" "${itemSpawn:--}" ; return 0 ; }
	itemSpawn="${recordPath##*/}" ; itemSpawn="${itemSpawn%.spawn.md}"
	childStatus="$( AgentsToolsSpawnSandboxRecordHeader "$recordPath" status )"
	[ "$childStatus" = spawn-started ] || { printf 'ACCEPT-DISMISS: not sent: spawn %s has already ended (status %s)\n' "$itemSpawn" "${childStatus:--}" ; return 0 ; }
	childHost="$( AgentsToolsSpawnSandboxRecordHeader "$recordPath" host )"
	thisHost="$( hostname -s 2>/dev/null )" || thisHost="unknown"
	if [ "$childHost" = "$thisHost" ] ; then
		## Running is a process that runs as the spawn, by the one rule of the spawned-sessions render.
		type AgentsToolsRegistrySpawnRuns > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.Registries.include"
		AgentsToolsRegistrySpawnRuns "$itemSpawn" "$recordPath" || { printf 'ACCEPT-DISMISS: not sent: spawn %s is not running on this host, so its session has ended\n' "$itemSpawn" ; return 0 ; }
	fi
	childMember="$( AgentsToolsSpawnSandboxRecordHeader "$recordPath" owner )"
	[ -n "$childMember" ] || { printf 'ACCEPT-DISMISS: not sent: spawn %s names no owner member to address\n' "$itemSpawn" ; return 0 ; }
	[ "$childMember" != "$sendBy" ] || { printf 'ACCEPT-DISMISS: not sent: the accepting member %s is the child member itself, and its own Wait ignores a DISMISSED it authored\n' "$sendBy" ; return 0 ; }
	## A run is not dismissed while runs that need it still run (F6.9, AgentsToolsSessionDismissHeld):
	## its dismissal is kept, and given at its first Wait once they have ended.
	local childOthers=""
	if childOthers="$( AgentsToolsSessionDismissHeld "$recordPath" )" ; then
		AgentsToolsSessionDismissHold "$itemSpawn" "$sendBy (the accept of ${itemPath##*/})"
		printf 'ACCEPT-DISMISS: held: runs that need spawn %s still run (%s): its DISMISSED is given at its first Wait once they have ended\n' \
			"$itemSpawn" "$( printf '%s' "$childOthers" | LC_ALL=C tr '\n' ' ' | LC_ALL=C sed 's/ $//' )"
		return 0
	fi
	childThread="$( AgentsToolsSpawnSandboxRecordHeader "$recordPath" session-thread )"
	if [ -z "$childThread" ] || [ "$childThread" = "-" ] ; then
		childThread=""
		[ ! -f "${recordPath%/*}/session.thread" ] || IFS= read -r childThread < "${recordPath%/*}/session.thread" || :
	fi
	AgentsToolsSpawnConversationThreadValid "$childThread" || { printf 'ACCEPT-DISMISS: not sent: spawn %s has no session thread to post in\n' "$itemSpawn" ; return 0 ; }
	if sendOut="$( printf 'DISMISSED' | DistroAgentsTools --intern-op-comms-slack-send-message "$sendBy" "$childThread" --identity-bot --address-to "$childMember" --from-stdin 2>&1 )" ; then
		printf 'ACCEPT-DISMISS: sent DISMISSED to %s in %s (spawn %s)\n' "$childMember" "$childThread" "$itemSpawn"
	else
		printf 'ACCEPT-DISMISS: not sent: the send to %s in %s failed: %s\n' "$childMember" "$childThread" "$( printf '%s\n' "$sendOut" | LC_ALL=C grep -m1 'ERROR' )"
	fi
	return 0
}

## THE PROCESS A LAUNCH STARTED, kept on the spawn's own record: its pid and when it began,
## `run-process: <pid> <start>`, written by the launcher the moment it has started the console.
## The console becomes the CLI, or waits for it, so that process lives as long as the run
## does. It is how a run is seen alive where its CLI is given no session word of its own on
## its command line (AgentsToolsRegistryRecordedRunAlive, AgentsTools.Registries.include):
## for every CLI alike, and the same pid begun at another time is another process. A later
## launch of the same spawn -- a resume, the handback retry -- replaces the one before it.
## AND THE SHELL THAT SUPERVISES THE RUN, beside it and in the same form:
## `supervisor-process: <pid> <start>`. That is the shell this is called in, the one that
## started the console: it waits on the run and, once the run has ended, resumes it once for
## a missing handback, posts the end and closes this record. It is the process the proxy
## starts for a run that is not waited for (PID= of its receipt), and the process the call
## itself runs in for a run its caller waits on. A later launch of the same spawn is made by
## that same shell, and leaves the line as it was. It is how a run whose process is gone and
## whose record is still open is told from one that nobody will close
## (AgentsToolsRegistryRecordedSupervisor, AgentsTools.Registries.include). Kept also where
## the console had ended before its own start could be read: `run-process` is then not written.
## Through this package's own header writer, aside and then one rename. Never fails the launch.
## A record is read, changed and put back whole, and put back only while it is still what was
## read: what another writer -- a closer, the mark of a kill -- put in place meanwhile is kept,
## and the same lines are written again on the record as it then stands, three times at most.
## The record is read and compared by the shell itself, so no process is started between the
## compare and the rename; only a change made in that moment is lost. And the time a launch
## holds it is kept as short, and as soon after the launch, as it was before the shell was
## named: which shell this is, is read before the launch (AgentsToolsSpawnProxyShellNote) and
## only looked up here.
AgentsToolsSpawnProxyShellNote(){ ## -- keeps `<pid> <start>` of the shell it is called in, for that shell (agentsSpawnProxyShellIs)
	local noteShell noteStart
	## Kept already, by this very shell: nothing is started to find that out. What a subshell
	## has of the shell it came from was kept one level up (BASH_SUBSHELL), and names that one:
	## read again. A process started anew has none of it.
	case "${agentsSpawnProxyShellOf:-}" in "level-$BASH_SUBSHELL") return 0 ;; esac
	agentsSpawnProxyShellIs="" ; agentsSpawnProxyShellOf="level-$BASH_SUBSHELL"
	type AgentsToolsRegistryProcessStart > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.Registries.include" 2> /dev/null || return 0
	## This shell's own process, which `$$` does not name in a subshell: what a command it starts has as its parent.
	noteShell="$( exec sh -c 'echo "$PPID"' 2> /dev/null )" || noteShell=""
	case "$noteShell" in ''|*[!0123456789]*) return 0 ;; esac
	noteStart="$( AgentsToolsRegistryProcessStart "$noteShell" )" || noteStart=""
	agentsSpawnProxyShellIs="${noteStart:+$noteShell $noteStart}"
	return 0
}
AgentsToolsSpawnProxyRunRecord(){ ## pid of the console process just started
	local runFile="${MDAT_SPAWN_SANDBOX_ROOT:-}/${MDAT_SPAWN_SESSION_ID:-}.spawn.md" runStart runOps runBody runSeen runNow runTries=0
	[ -n "${MDAT_SPAWN_SANDBOX_ROOT:-}" ] && [ -n "${MDAT_SPAWN_SESSION_ID:-}" ] && [ -f "$runFile" ] || return 0
	case "${1:-}" in ''|*[!0123456789]*) return 0 ;; esac
	type AgentsToolsRegistryProcessStart > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.Registries.include" 2> /dev/null || return 0
	runStart="$( AgentsToolsRegistryProcessStart "$1" )" || runStart=""
	AgentsToolsSpawnProxyShellNote
	[ -n "$runStart${agentsSpawnProxyShellIs:-}" ] || return 0
	runOps="$MMDAPP/.local/temp/mdat-session-run-ops.$$.$1"
	mkdir -p "$MMDAPP/.local/temp" 2> /dev/null || return 0
	{
		[ -z "$runStart" ] || printf 'upsert\trun-process\t%s %s\n' "$1" "$runStart"
		[ -z "${agentsSpawnProxyShellIs:-}" ] || printf 'upsert\tsupervisor-process\t%s\n' "$agentsSpawnProxyShellIs"
	} > "$runOps" 2> /dev/null || return 0
	while [ "$runTries" -lt 3 ] ; do
		runTries=$(( runTries + 1 ))
		runSeen="" ; IFS= read -r -d '' runSeen < "$runFile" 2> /dev/null || :
		[ -n "$runSeen" ] || break
		runBody="$( printf '%s' "$runSeen" | LC_ALL=C awk -v opsFile="$runOps" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsBoardItemHeaderOpsApply.awk" 2> /dev/null )" || runBody=""
		[ -n "$runBody" ] || break
		printf '%s\n' "$runBody" 2> /dev/null > "$runFile.run.$$" || break
		runNow="" ; IFS= read -r -d '' runNow < "$runFile" 2> /dev/null || :
		[ "$runNow" = "$runSeen" ] || continue
		mv -f "$runFile.run.$$" "$runFile" 2> /dev/null
		break
	done
	rm -f "$runOps" "$runFile.run.$$"
	return 0
}

## Closes the session tracking file by updating its frontmatter, through this
## package's own header writer -- nothing here parses or re-emits frontmatter of its
## own. The headers ARE the state, so a close is a header update and never a rewrite
## of the file. A failure leaves the file exactly as it was: a tracking record that
## still says started is recoverable by a rescan, where a truncated one is not.
## So the changed record is written aside and put in place by one rename, as a launch writes
## it (AgentsToolsSpawnProxyRunRecord): a reader finds the record as it was or as it is, and so
## does whoever comes after a closer that was ended half way; never a record cut short.
## rc 0 closed; rc 1 where this try could not close it, the record as it was.
AgentsToolsSpawnProxyCloseSandboxOnce(){ ## tracking file, outcome, exit code
	local sandboxFile="$1" sandboxOutcome="$2" sandboxExit="$3" sandboxOps sandboxBody sandboxAside sandboxReason="" sandboxRestarts="" sandboxRefused=""
	[ -f "$sandboxFile" ] || return 1
	mkdir -p "$MMDAPP/.local/temp" || return 1
	## A temp file of this close's own, by mktemp and never by $$: the members one call
	## started (--spawn-session) close in subshells of that one shell, which have its
	## $$, so two closing at once met on one name, and one read no changes and stayed started.
	sandboxOps="$( mktemp "$MMDAPP/.local/temp/mdat-session-header-ops.XXXXXX" )" || return 1
	{
		## `status` carries the outcome, and `outcome` itself is deliberately absent:
		## the entity model defines that name with a closed set of values for what an
		## advance pass did to a running board item, so a spawn's exit result written
		## there would be an undefined value in a defined set. `resolved-at` is the
		## model's own conclusion stamp, and is used rather than a second spelling of
		## it. `exit-code` has no counterpart in the model at all, which is not a
		## re-mint: this file is the session's own record, not team data, so nothing
		## defines that concept for it.
		printf 'upsert\tstatus\tspawn-%s\n' "$sandboxOutcome"
		printf 'upsert\texit-code\t%s\n' "$sandboxExit"
		printf 'upsert\tresolved-at\t%s\n' "$( date +"%Y-%m-%d %H:%M %z" )"
		## Whether the session read its own duty file, as the harness recorded it beside this file.
		## "no" only where the harness loop ran and could see it; a native CLI's session is unknown.
		if [ -s "${sandboxFile%.spawn.md}.armed" ] ; then
			printf 'upsert\tarmed\tyes\n'
			printf 'upsert\tarmed-at\t%s\n' "$( head -1 "${sandboxFile%.spawn.md}.armed" )"
		elif [ -e "${sandboxFile%.spawn.md}.harness" ] ; then
			printf 'upsert\tarmed\tno\n'
		else
			printf 'upsert\tarmed\tunknown\n'
		fi
		## Why a run that refused to run went no further, as the harness kept it beside this
		## file when it ended on a refused request (an API usage cap and the like). One line,
		## newlines and tabs already collapsed by the writer; kept so the session's own record
		## carries the reason, never only the log. Absent for a run that ended for another
		## reason, or one the harness could not name.
		if [ -s "${sandboxFile%.spawn.md}.refused" ] ; then
			sandboxReason="$( head -1 "${sandboxFile%.spawn.md}.refused" | LC_ALL=C tr '\t' ' ' )"
			printf 'upsert\tend-reason\t%s\n' "$sandboxReason"
		fi
		## How many summarise-and-restarts this run made, from the marker the harness appends
		## beside this file, one line per restart (AgentsHarnessRestartKeep). A run that never
		## restarted, or one no harness ran, carries no such header. The count is a header, so
		## the session read prints it with the record's other headers; each restart's own time
		## and threshold stay in the marker, and the transcript keeps its RESTART line.
		if [ -s "${sandboxFile%.spawn.md}.restarts" ] ; then
			sandboxRestarts="$( LC_ALL=C awk 'NF { counted++ } END { print counted + 0 }' "${sandboxFile%.spawn.md}.restarts" 2> /dev/null )"
			case "$sandboxRestarts" in ''|0|*[!0123456789]*) ;; *) printf 'upsert\trestarts\t%s\n' "$sandboxRestarts" ;; esac
		fi
		## Every refusal this run hit, not only the one that ended it (sketch 3.6): the count
		## of the marker the harness appends beside this file, one line per refusal
		## (AgentsHarnessRefusalKeep). A run the harness never flagged, or one no harness ran,
		## carries no such header, the same shape `restarts` already has.
		if [ -s "${sandboxFile%.spawn.md}.refused-log" ] ; then
			sandboxRefused="$( LC_ALL=C awk 'NF { counted++ } END { print counted + 0 }' "${sandboxFile%.spawn.md}.refused-log" 2> /dev/null )"
			case "$sandboxRefused" in ''|0|*[!0123456789]*) ;; *) printf 'upsert\trefused\t%s\n' "$sandboxRefused" ;; esac
		fi
	} > "$sandboxOps" || { rm -f "$sandboxOps" ; return 1 ; }
	sandboxBody="$( LC_ALL=C awk -v opsFile="$sandboxOps" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsBoardItemHeaderOpsApply.awk" < "$sandboxFile" )" || sandboxBody=""
	rm -f "$sandboxOps"
	[ -n "$sandboxBody" ] || return 1
	## Aside and then one rename, with the mode the record has: the name by mktemp, since its
	## supervising shell and an advance pass may close one record at the same moment.
	sandboxAside="$( mktemp "$sandboxFile.close.XXXXXX" 2> /dev/null )" || return 1
	{ cp -p "$sandboxFile" "$sandboxAside" && printf '%s\n' "$sandboxBody" > "$sandboxAside" && mv -f "$sandboxAside" "$sandboxFile" ; } 2> /dev/null \
		|| { rm -f "$sandboxAside" ; return 1 ; }
	## A RUN STOPPED ON THE PROVIDER'S USAGE LIMIT is flagged in its own store, from the same
	## reason the record keeps: the one wording the session list, the Dashboard and the end
	## notice show, with the date the provider said it reopens. Never fails the close.
	if [ -n "$sandboxReason" ] ; then
		type AgentsToolsUsageLimitMark > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.UsageLimit.include" 2> /dev/null || :
		AgentsToolsUsageLimitMark "$( AgentsToolsSpawnSandboxRecordHeader "$sandboxFile" spawn-id )" "$sandboxReason" 2> /dev/null || :
	fi
	return 0
}

## THE QUESTIONS A RUN ASKED ARE ITS OWN TO SETTLE, AND IT SETTLES THEM WHEN IT ENDS: nobody is left
## to hear an answer once its record closes, so the close withdraws every question that run still has
## open, through the one withdraw an asker has (--settle-pending-reply --withdraw): the record closes
## as withdrawn, with the reason, and the person who was asked is told in the question's own thread by
## that same operation. THE ASKER IS READ FROM THE ASK: an ask carries the id of the run that asked it
## in `session-id`, which is that run's own spawn id (a run that founded its session has the two equal),
## and its `owner` is the member that asked. A question the TOOLING asked ABOUT a run is not the run's
## and is left as it is: a review prompt carries that run's id as its asking session and must still be
## answered, so `kind: review` is not withdrawn here. The live store alone is read, since a record that
## already closed is no question of anybody's. Never fails the close: one warning at most, and the
## record is closed whatever came of its questions.
AgentsToolsSpawnProxyWithdrawAsks(){ ## tracking file
	local askRun askFile askList askId askOwner askReason="" askRc=0 askWarned=""
	[ -f "${1:-}" ] || return 0
	[ "$( AgentsToolsSpawnSandboxRecordHeader "$1" status )" = "spawn-started" ] || return 0
	## The run's own id: its spawn-id, and for a record written without one the session it names,
	## which is the same id for a run that founded its session.
	askRun="$( AgentsToolsSpawnSandboxRecordHeader "$1" spawn-id )"
	case "$askRun" in ''|'-') askRun="$( AgentsToolsSpawnSandboxRecordHeader "$1" session-id )" ;; esac
	case "$askRun" in ''|-|.|..|*/*) return 0 ;; esac
	local askFiles=()
	while IFS= read -r askFile ; do
		[ -z "$askFile" ] || [ ! -f "$askFile" ] || askFiles[${#askFiles[@]}]="$askFile"
	done <<< "$( LC_ALL=C grep -l -x -F "session-id: $askRun" "$MMDAPP/.local/agents/pending"/*.md 2> /dev/null )"
	[ "${#askFiles[@]}" -gt 0 ] || return 0
	## The open ones, with the member that asked each: its record read once, its header fields only.
	askList="$( LC_ALL=C awk '
		FNR == 1 { dashes = 0 ; status = "" ; kind = "" ; owner = "" ; name = FILENAME ; sub( /^.*\//, "", name ) ; sub( /\.md$/, "", name ) }
		$0 == "---" {
			if ( ++dashes == 2 ) {
				sub( /[[:space:]]+$/, "", owner ) ;
				sub( /[[:space:]]+$/, "", status ) ;
				sub( /[[:space:]]+$/, "", kind ) ;
				if ( status == "reply-pending" && kind != "review" ) printf "%s\t%s\n", name, owner ;
			}
			next ;
		}
		dashes == 1 && index( $0, "status: " ) == 1 { status = substr( $0, 9 ) }
		dashes == 1 && index( $0, "kind: " ) == 1 { kind = substr( $0, 7 ) }
		dashes == 1 && index( $0, "owner: " ) == 1 { owner = substr( $0, 8 ) }
	' "${askFiles[@]}" 2> /dev/null )" || askList=""
	[ -n "$askList" ] || return 0
	## Why a question is withdrawn: a line of the note template's `# Reasons`, never a text written here.
	type AgentsToolsAskPostFill > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.AskPost.include"
	askReason="$( ASKP_BLOCK="Reasons/asker-ended" AgentsToolsAskPostFill block tooling-note.post.format.md "" 2> /dev/null )" || askReason=""
	[ -n "$askReason" ] || echo "⚠️ WARNING: ${MDSC_CMD:-DistroAgentsTools}: the reason of a withdrawal could not be filled from its template (tooling-note.post.format.md, Reasons), so the questions of run $askRun are withdrawn with none" >&2
	while IFS=$'\t' read -r askId askOwner ; do
		[ -n "$askId" ] && [ -n "$askOwner" ] && [ "$askOwner" != "-" ] || continue
		askRc=0
		## The asker's own withdraw, done in the asker's name: the member that asked is what this
		## call acts as, so the one gate every withdraw has sees the run that asked it and nobody else.
		if type DistroAgentsTools > /dev/null 2>&1 ; then
			( export MDAT_SPAWN_AGENT="$askOwner" ; DistroAgentsTools --settle-pending-reply "$askOwner" "$askId" --reason "$askReason" --withdraw ) > /dev/null 2>&1 || askRc=$?
		else
			( export MDAT_SPAWN_AGENT="$askOwner" ; "$BASH" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh" --settle-pending-reply "$askOwner" "$askId" --reason "$askReason" --withdraw ) > /dev/null 2>&1 || askRc=$?
		fi
		[ "$askRc" = 0 ] || [ -n "$askWarned" ] || { askWarned="yes" ; echo "⚠️ WARNING: ${MDSC_CMD:-DistroAgentsTools}: the question $askId that run $askRun asked was not withdrawn (rc $askRc), so it stays as it was" >&2 ; }
	done <<< "$askList"
	return 0
}

## The close as its callers ask for it. Where the first try could not close the record it is
## tried once more, a moment later: what stopped it may have been of that moment, a signal to
## the run's group that took the header writer with it, a temp folder that was full. Where
## the second cannot either, that is said, on stderr: the record then still says what it
## said, and a later advance pass closes it. Never fails its caller.
AgentsToolsSpawnProxyCloseSandbox(){ ## tracking file, outcome, exit code
	[ -f "$1" ] || return 0
	## The run's own questions are settled first, while its record still says it was started: a question
	## of a run that has ended is withdrawn by it, and never left waiting for an answer nobody hears.
	AgentsToolsSpawnProxyWithdrawAsks "$1" || :
	## A run whose session holds a routine's lock gives it back when it is the last of its session (F6.2).
	if [ -n "$( AgentsToolsSpawnSandboxRecordHeader "$1" routine-lock )" ] ; then
		type AgentsToolsRoutineLockRelease > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/magic/AgentsTools.RoutineLock.include"
		AgentsToolsRoutineLockRelease "$1" "$2" "$3" || :
	fi
	## A run that closes holds no seat (F6.9).
	AgentsToolsSessionSeatRelease "$( AgentsToolsSpawnSandboxRecordHeader "$1" session-id )" "$( AgentsToolsSpawnSandboxRecordHeader "$1" owner )" "$( AgentsToolsSpawnSandboxRecordHeader "$1" spawn-id )" || :
	AgentsToolsSpawnProxyCloseSandboxOnce "$@" && return 0
	sleep 1 || :
	AgentsToolsSpawnProxyCloseSandboxOnce "$@" && return 0
	echo "⚠️ WARNING: ${MDSC_CMD:-DistroAgentsTools}: the spawn record $1 could not be closed as spawn-$2 (exit $3), tried twice: it still says what it said" >&2 || :
	return 0
}

## What the tooling itself tells the participants of a session, in a thread, about the run of
## one of them: one message, its text the note template's
## (sh-lib/templates/tooling-note.post.format.md, `# Session`), sent through the member send
## as the team bot in the name of the member it is about, and addressed to whoever it is
## told, where that is known: the member that brought that one in, or the human-owner in his
## own conversation. Never a tracking post: the box that tracks the same fact goes to the
## tracking thread, by its caller. Silent with no thread. Never fails its caller: one stderr
## warning at most; whether it posted is left in agentsSpawnProxyNoticePosted.
## It stands here, with what closes a run, and not with the spawn proxy's own functions: a
## closer that is no spawn proxy tells the end of a run too (AgentsToolsSpawnProxyEndNotice).
AgentsToolsSpawnProxySessionNotice(){ ## thread or conversation, the member it is about, whom it is told (may be empty), line (a heading under `# Session`), count (may be empty), the run it is about (this spawn's own where not given), then the further slots of the line, a name and its value each
	local noticeThread="$1" noticeMember="$2" noticeTell="" noticeName="$4" noticeCount="${5:-}" noticeRun="${6:-${MDAT_SPAWN_SESSION_ID:-}}" noticeText="" noticeArgs
	agentsSpawnProxyNoticePosted=""
	[ -n "$noticeThread" ] || return 0
	noticeArgs=( "$noticeMember" "$noticeThread" --identity-bot )
	## Addressed to whom it is told, where the send can address it, and to nobody where there
	## is none: never to the member it is about, whose run has ended.
	type AgentsToolsTeamMemberDirectory > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.TeamRegistry.include"
	if [ -n "${3:-}" ] && [ "$3" != "$noticeMember" ] && AgentsToolsAssertBareName "$3" "the spawning member" agent-spawn-proxy 2> /dev/null \
		&& AgentsToolsTeamMemberDirectory "$3" > /dev/null 2>&1 ; then
		noticeTell="$3"
		noticeArgs=( "${noticeArgs[@]}" --address-to "$noticeTell" )
	fi
	type AgentsToolsAskPostFill > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.AskPost.include"
	shift 6 2> /dev/null || shift $#
	noticeText="$(
		export ASKP_BLOCK="Session/$noticeName" ASKP_F_member="$noticeMember" ASKP_F_run="${noticeRun:0:8}" ASKP_F_count="$noticeCount" ASKP_F_address_to="$noticeTell"
		## A further slot travels as every slot does, under its own name: lower-case letters.
		while [ $# -ge 2 ] ; do
			[ -z "$1" ] || [ -n "${1//[abcdefghijklmnopqrstuvwxyz_]/}" ] || export "ASKP_F_$1=$2"
			shift 2
		done
		AgentsToolsAskPostFill block tooling-note.post.format.md "" 2> /dev/null
	)" || noticeText=""
	if [ -z "$noticeText" ] ; then
		echo "⚠️ WARNING: --intern-op-agent-spawn-proxy: the $noticeName line could not be filled from sh-lib/templates/tooling-note.post.format.md, so $noticeThread was not told" >&2
		return 0
	fi
	## A SESSION ON THE PRINTBACK CHANNEL HAS NO THREAD (F3.3): its notice is RECORDED there, never printed,
	## and the next foreground call of that session surfaces it as one line of its digest. Nothing is sent
	## through the member send, and the printback channel's own rule -- a message prints -- does not apply:
	## a notice is not a message and has no caller to print to. The record is the session's one chat file.
	case "$noticeThread" in
		printback:*)
			type AgentsToolsCommsPrintbackNoticeRecord > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.CommsPrintback.include" 2> /dev/null || :
			if printf '%s\n' "$noticeText" | AgentsToolsCommsPrintbackNoticeRecord "$noticeThread" "$noticeMember" "$noticeTell" ; then
				agentsSpawnProxyNoticePosted="yes"
			else
				echo "⚠️ WARNING: --intern-op-agent-spawn-proxy: the $noticeName line was not recorded on $noticeThread, so the run ${noticeRun:0:8} of $noticeMember was not told of it" >&2
			fi
			return 0
		;;
	esac
	local noticeOut="" noticeInbox
	mkdir -p "${MMDAPP:-/nonexistent}/.local/temp" 2> /dev/null && noticeOut="$( mktemp "${MMDAPP:-/nonexistent}/.local/temp/mdat-session-notice.XXXXXX" 2> /dev/null )" || noticeOut=""
	[ -n "$noticeOut" ] || noticeOut="/dev/null"
	## NO SEND FLOOR HERE: a notice is the tooling's own fixed line, never a member's own text, and
	## the plain-language floor holds back only a member's own Slack send (MDAT_SEND_FLOOR=hold, set
	## by the member stub): the tooling's own sends pass gating predicates of `none`, measured and
	## recorded but never held (MAGIC.md). A line of tooling-note.post.format.md cannot be rewritten
	## to answer a CORRECTION, so a held notice would never be posted at all -- `## run-closed` is 30
	## words against a cap of 25, and the run it is about would go untold.
	if printf '%s\n' "$noticeText" | DistroAgentsTools --intern-op-comms-slack-send-message "${noticeArgs[@]}" --from-stdin > "$noticeOut" 2>&1 ; then
		agentsSpawnProxyNoticePosted="yes"
	## The send refuses with rc 1 for every fault, so its words are all there is: the one exact line
	## it prints for a member with no Slack DM, that member named, anchored at both ends.
	elif noticeNoDm="--slack-send-message: NO-SLACK-DM: team member '$noticeThread' has no Slack DM channel of its own" \
			LC_ALL=C awk 'index( $0, "⛔ ERROR: " ) == 1 && length( $0 ) > length( ENVIRON["noticeNoDm"] ) && substr( $0, length( $0 ) - length( ENVIRON["noticeNoDm"] ) + 1 ) == ENVIRON["noticeNoDm"] { found = 1 } END { exit found ? 0 : 1 }' "$noticeOut" 2> /dev/null \
		&& AgentsToolsTeamMemberDirectory "$noticeThread" > /dev/null 2>&1 ; then
		## Told to a member with no Slack DM of its own: in its inbox, a hand-off it reads later, as
		## a member's own send to it is (AgentsHarnessToolSendMessage).
		noticeInbox="inquiry-$( date -u +%Y%m%dT%H%MZ )-note-$( printf '%s' "$noticeText" | cksum | LC_ALL=C cut -d' ' -f1 ).md"
		if { printf -- '---\ntype: inquiry\nfrom: %s\ndate: %s\nowner: %s\n---\n\n%s\n' "$noticeMember" "$( date +'%Y-%m-%d %H:%M %z' )" "$noticeThread" "$noticeText" ; } \
			| DistroAgentsTools --intern-op-member-inbox-upsert "$noticeThread" "$noticeInbox" --context --intern-op-agent-spawn-proxy > /dev/null 2>&1 ; then
			agentsSpawnProxyNoticePosted="yes"
		else
			echo "⚠️ WARNING: --intern-op-agent-spawn-proxy: the $noticeName line was not left in the inbox of $noticeThread, which has no Slack DM, so it was not told that the run ${noticeRun:0:8} of $noticeMember ended" >&2
		fi
	else
		echo "⚠️ WARNING: --intern-op-agent-spawn-proxy: the $noticeName line was not posted in $noticeThread, so it was not told there that the run ${noticeRun:0:8} of $noticeMember ended" >&2
	fi
	[ "$noticeOut" = /dev/null ] || rm -f "$noticeOut"
	return 0
}

## WHETHER A RUN HANDED BACK, AND WHERE EACH HANDBACK WENT: the one reading of it, for the
## close of a run, which resumes it once for a handback it has not given
## (AgentsToolsSpawnProxyHandbackWarn, --intern-op-agent-spawn-proxy), and for the note of
## its end (AgentsToolsSpawnProxyEndNotice). THE TRANSCRIPT OF THE RUN IS BELIEVED FIRST: it
## holds a HANDBACK event for each handback that was delivered, with where it went
## (AgentsTranscriptToolDone), whichever CLI ran and however its log shows a call. The
## output of the run is read only where the transcript holds none, or the run has no
## transcript: there the announce line of the call is all there is, and it says that the
## call was made, not where it went. By the output alone the handbacks of a native CLI were
## never seen: its log holds what a call is for first and the name of the tool on the next
## line, which the pattern does not read.
## Prints a line for each handback the transcript holds, `to:<target>` as its event names it,
## `to:` where the call named none; and where the transcript gives none, the one line `seen`
## where the output shows the call. Nothing where neither does. rc 0 always.
AgentsToolsSpawnProxyHandbacks(){ ## the run, by its own spawn id; its output file (may be empty)
	local handRun="${1:-}" handLog="${2:-}" handParts="" handPart handGave=""
	type AgentsTranscriptParts > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionTranscript.include" 2> /dev/null || :
	[ -z "$handRun" ] || handParts="$( AgentsTranscriptParts "$handRun" 2> /dev/null )" || handParts=""
	if [ -n "$handParts" ] ; then
		handGave="$( while IFS= read -r handPart ; do
			[ -n "$handPart" ] && [ -f "$handPart" ] || continue
			LC_ALL=C grep -E '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]+Z HANDBACK( |$)' "$handPart" 2> /dev/null \
				| LC_ALL=C awk '{ wentTo = "" ; if ( match( $0, / to=[^ ]+/ ) ) { wentTo = substr( $0, RSTART + 4, RLENGTH - 4 ) ; } gsub( /"/, "", wentTo ) ; print "to:" wentTo ; }'
		done <<< "$handParts" )" || handGave=""
	fi
	if [ -n "$handGave" ] ; then
		printf '%s\n' "$handGave"
		return 0
	fi
	[ -z "$handLog" ] || [ ! -f "$handLog" ] || ! LC_ALL=C grep -qE '📦 SubagentHandback|^  -> tool: (mcp__myx_distro__)?SubagentHandback' "$handLog" 2> /dev/null || printf 'seen\n'
	return 0
}

## THE END OF A RUN IS TOLD TO WHOEVER REQUESTED IT, by whoever closes its record: its
## supervising shell, at the end of its close (--intern-op-agent-spawn-proxy), and, where
## that shell is gone, the advance pass for a dead run that it closes as ended without close
## (AgentsToolsAdvanceSpawnHousekeeping). One message for an end, a fact and no question:
## that the run has ended, and how. Its caller calls it once the record and the item of the
## run are closed, so a post that cannot be made holds neither open. An end is told once:
## by the shell while it lives, and else by the one pass that closes the record.
## WHERE. Where the run reports to (AgentsToolsRunRoute), as its handback does, and nowhere for
## a run that reports to no one (`none`): a session in
## its thread, addressed to its member (AgentsToolsRunRouteMember), its own session thread
## where that session has none to find; a member in its own conversation; a person, the
## human-owner, in the bot's direct conversation, as a plain message: no question, and no
## record of one. Two runs reporting to a person stay where their note stood, in their own
## session thread: a start its caller waits on, which that caller reads itself, and any such
## run in a workspace that has no conversation with the human-owner (SLACK_CHANNEL_HUMAN_OWNER).
## HOW IT ENDED, each a line of its own under `# Session` of the note template:
##   run-killed        its record says that the console killed it, by whom and when
##                     (`killed-by`, `killed-at`, AgentsToolsManagerKillMark).
##   run-closed        the same marks, on a record the kill of its session closed with no
##                     process behind it: its run had ended before, so it was not killed. Its
##                     closer says so, with `closed` as what it saw (AgentsToolsManagerSessionFinish).
##   run-stopped       its transcript holds the ordered ending of a member's TaskStop, which
##                     is recorded before the run is signalled: by which member, and when.
##   run-bound         the wait of its caller reached the bound of the tooling, which then
##                     ended it (SPAWN_WAIT_TIMEOUT_SECONDS): the bound its closer gives.
##   handback-missing  it ended by itself, and no handback of it was seen, after its one retry.
##   run-ended         it ended by itself and handed back, and none of its handbacks went to
##                     where its end is told.
##   run-usage-limited it stopped on the provider's API usage limit: the notice says so, and
##                     the date the provider gave for it reopening, as the run's own store
##                     keeps it (AgentsTools.UsageLimit.include). This is told whatever else
##                     is recorded of its ending: the refusal is why it stopped.
## A run that was killed, stopped or bounded is told as that, whatever it had handed back,
## and never as a run that posted no handback. A run that ended by itself and whose handback
## stands where its end would be told gets no message: the handback said it. Nor does one
## whose handback was seen while nothing records where it went.
## Where a handback went is read from the run's transcript, the `to` of its HANDBACK events
## (AgentsTranscriptToolDone): none, and `session-parent`, are where the run reports to;
## `session-current` is the run's own session thread; a `<channel>:<ts>` is itself;
## `human-owner` is his conversation, and a member's name its own; any other target is
## another place.
## A DEATH is told by the control thread of the run's session, in a call of its own, with
## `died` as what its closer saw (AgentsTools.SessionControlDeath.include): the line is then
##   run-died          its process is gone, and nothing closed its record,
## whatever else is recorded of its ending, and nothing where a handback of it stands where
## its end would be told. That thread then keeps `death-told` on the record, and AN END THAT
## WAS TOLD AS A DEATH IS TOLD BY NO OTHER CLOSER: for a record that carries it, a later
## call says nothing. agentsSpawnProxyEndNoticeSaid is left for the caller that asks:
## `posted`, `none` where nothing was due, `failed` where the line could not be posted.
## Posted by the one function a note of a session is posted by
## (AgentsToolsSpawnProxySessionNotice), which bounds it as every Slack call is bounded.
## Never fails its caller: a post that cannot be made is that function's one warning on
## stderr, which is the run's log for a run that is not waited for.
AgentsToolsSpawnProxyEndNotice(){ ## the run's record, what its closer saw of a handback (`missing` or `seen`; read from the run's log where not given; `died` for a death, which the control thread of its session tells), the bound in seconds where the tooling's bound ended it (may be empty), `caller-waits` for a start its caller waits on (may be empty)
	local endRecord="${1:-}" endSeen="${2:-}" endBound="${3:-}" endWaits="${4:-}"
	local endRun endMember endOwn endRoute endRouted="" endTo="" endTell="" endLine="" endBy="" endAt="" endUnrequested="" endSession="" endLimit=""
	local endParts endPart endEvents="" endStop endWent endHeld="" endGave=""
	agentsSpawnProxyEndNoticeSaid="none"
	[ -n "$endRecord" ] && [ -f "$endRecord" ] || return 0
	[ "$endSeen" = "died" ] || [ -z "$( AgentsToolsSpawnSandboxRecordHeader "$endRecord" death-told )" ] || return 0
	endRun="${endRecord##*/}" ; endRun="${endRun%.spawn.md}"
	endMember="$( AgentsToolsSpawnSandboxRecordHeader "$endRecord" owner )"
	[ -n "$endMember" ] || return 0
	## Whether it stopped on the provider's usage limit, and the one wording of it with the
	## date it reopens: the run's own store first, then the reason the record keeps, for a run
	## closed before the store held one. A run that was refused for another reason has none.
	type AgentsToolsUsageLimitRun > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.UsageLimit.include" 2> /dev/null || :
	endLimit="$( AgentsToolsUsageLimitRun "$endRun" 2> /dev/null )" || endLimit=""
	[ -n "$endLimit" ] || endLimit="$( AgentsToolsUsageLimitText "$( AgentsToolsSpawnSandboxRecordHeader "$endRecord" end-reason )" 2> /dev/null )" || endLimit=""
	endOwn="$( AgentsToolsSpawnSandboxRecordHeader "$endRecord" session-thread )"
	AgentsToolsSpawnConversationThreadValid "$endOwn" || endOwn=""
	## Where it is told, and to whom: where it reports to, and where its handback went is held against that.
	endRoute="$( AgentsToolsRunRoute "$endRecord" )"
	case "$( AgentsToolsRunRouteKind "$endRoute" )" in
		## A run that reports to no one is told to no one: its report, if any, said what it did.
		none) return 0 ;;
		session)
			endRouted="$( MDAT_SPAWN_SESSION_ID="$endRun" ; AgentsToolsSessionParentThreadFind 2> /dev/null )" || endRouted=""
			endRouted="${endRouted%% *}"
			AgentsToolsSpawnConversationThreadValid "$endRouted" || endRouted=""
			endTo="${endRouted:-$endOwn}"
			endTell="$( AgentsToolsRunRouteMember "$endRoute" 2> /dev/null )" || endTell=""
			## A SESSION ON THE PRINTBACK CHANNEL HAS NO THREAD (F3.3): its notice is recorded there and the
			## next foreground call of it surfaces the line. Where a thread was found above -- a session
			## that keeps one -- the Slack route is what it was, and nothing changes.
			if [ -z "$endTo" ] ; then
				type AgentsToolsCommsPrintbackSessionInUse > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.CommsPrintback.include" 2> /dev/null || :
				if AgentsToolsCommsPrintbackSessionInUse "${endRoute%%:*}" ; then
					endTo="$( AgentsToolsCommsPrintbackChannelId "${endRoute%%:*}" 2> /dev/null )" || endTo=""
				fi
			fi
		;;
		member)
			endRouted="$endRoute" ; endTo="$endRoute" ; endTell="$endRoute"
		;;
		*)
			endRouted="human-owner" ; endTo="$endOwn"
			if [ "$endWaits" != "caller-waits" ] && [ -n "$( DistroAgentsTools --agents-config-option magic-team --select SLACK_CHANNEL_HUMAN_OWNER 2> /dev/null )" ] ; then
				endTo="human-owner" ; endTell="human-owner"
				endSession="$( AgentsToolsSpawnSandboxRecordHeader "$endRecord" session-comment )"
				type AgentsToolsAskPostFill > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.AskPost.include"
				endUnrequested="$( ASKP_BLOCK="Session/unrequested" ASKP_F_session="$endSession" AgentsToolsAskPostFill block tooling-note.post.format.md "" 2> /dev/null )" || endUnrequested=""
			fi
		;;
	esac
	[ -n "$endTo" ] || return 0
	## What its transcript records of its ending and of its handbacks.
	type AgentsTranscriptParts > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionTranscript.include" 2> /dev/null || :
	endParts="$( AgentsTranscriptParts "$endRun" 2> /dev/null )" || endParts=""
	while IFS= read -r endPart ; do
		[ -n "$endPart" ] && [ -f "$endPart" ] || continue
		endEvents="$endEvents$( LC_ALL=C grep -E '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]+Z (ENDING|HANDBACK)( |$)' "$endPart" 2> /dev/null )"$'\n'
	done <<< "$endParts"
	## How it ended.
	endAt="$( AgentsToolsSpawnSandboxRecordHeader "$endRecord" killed-at )"
	endStop="$( printf '%s' "$endEvents" | LC_ALL=C awk '
		$2 == "ENDING" && index( $0, " text=\"taskstop: " ) > 0 { stopBy = "" ; if ( match( $0, / by=[^ ]+/ ) ) { stopBy = substr( $0, RSTART + 4, RLENGTH - 4 ) ; } stopLine = $1 " " stopBy ; }
		END { if ( stopLine != "" ) { print stopLine ; } }
	' )" || endStop=""
	if [ -n "$endLimit" ] ; then
		## A refusal is why it stopped, whatever else its record or transcript holds.
		endLine="run-usage-limited" ; endAt="" ; endBy=""
	elif [ "$endSeen" = "died" ] ; then
		endAt=""
	elif [ -n "$endAt" ] ; then
		endLine="run-killed"
		[ "$endSeen" != "closed" ] || endLine="run-closed"
		endBy="$( AgentsToolsSpawnSandboxRecordHeader "$endRecord" killed-by )"
	elif [ -n "$endStop" ] ; then
		endLine="run-stopped"
		endAt="${endStop%% *}" ; endBy="${endStop#* }"
	else
		case "$endBound" in ''|0|*[!0123456789]*) endBound="" ;; *) endLine="run-bound" ;; esac
	fi
	if [ -z "$endLine" ] ; then
		## It ended by itself: whether a handback of it stands where its end would be told, by
		## the one reading of what a run handed back (AgentsToolsSpawnProxyHandbacks).
		endGave="$( AgentsToolsSpawnProxyHandbacks "$endRun" "$( AgentsToolsSpawnSandboxRecordHeader "$endRecord" output-file )" )" || endGave=""
		while IFS= read -r endWent ; do
			case "$endWent" in to:*) endWent="${endWent#to:}" ;; *) continue ;; esac
			case "$endWent" in
				''|session-parent) endWent="$endRouted" ;;
				session-current) endWent="$endOwn" ;;
				human-owner) ;;
				*) [ "$endWent" = "$endRouted" ] || AgentsToolsSpawnConversationThreadValid "$endWent" || endWent="" ;;
			esac
			[ "$endWent" != "$endTo" ] || { endHeld="there" ; break ; }
			endHeld="elsewhere"
		done <<< "$endGave"
		if [ -z "$endSeen" ] ; then
			endSeen="missing"
			[ -z "$endGave" ] || endSeen="seen"
		fi
		case "$endHeld:$endSeen" in
			there:*) return 0 ;;
			*:died) endLine="run-died" ;;
			elsewhere:*) endLine="run-ended" ;;
			:missing) endLine="handback-missing" ;;
			*) return 0 ;;
		esac
	fi
	## When, as each reader's own time; a moment that cannot be read stays as it is kept.
	if [ -n "$endAt" ] ; then
		type AgentsToolsSlackDateToken > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.SlackDate.include" 2> /dev/null || :
		endAt="$( AgentsToolsSlackDateToken "$endAt" date-time 2> /dev/null || printf '%s' "$endAt" )"
	fi
	AgentsToolsSpawnProxySessionNotice "$endTo" "$endMember" "$endTell" "$endLine" "" "$endRun" by "$endBy" at "$endAt" seconds "$endBound" unrequested "$endUnrequested" usage_limit "$endLimit"
	agentsSpawnProxyEndNoticeSaid="failed" ; [ -z "$agentsSpawnProxyNoticePosted" ] || agentsSpawnProxyEndNoticeSaid="posted"
	return 0
}

## One line to the daemon output, never stdout: fd 4 where execute opened it (the request's own stderr, not the result), else stderr, which is the log in a console or harness run.
## The write that can fail is a redirection on a subshell, stderr silenced first, since a failed redirection on a special builtin ends a POSIX shell.
## fd 4 closed or not writable falls back to stderr.
AgentsToolsDaemonLine(){ ## text...
	( printf '%s\n' "$*" ) 2> /dev/null >&4 || printf '%s\n' "$*" >&2
}

## Reports housekeeping lines to the daemon output and as one message into the event-track thread of this spawn's coworking session; nothing goes to stdout or stderr.
## The thread is found through the session's one record, by this spawn's own id (AgentsTools.EventTrackThread.include), never through a file of the sandbox, which spawns may share.
AgentsToolsHousekeepingReport(){ ## member, lines
	local reportThread="" reportLine
	[ -n "$2" ] || return 0
	while IFS= read -r reportLine ; do
		AgentsToolsDaemonLine "$reportLine"
	done <<< "$2"
	type AgentsToolsEventTrackThreadRead > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.EventTrackThread.include" 2> /dev/null || return 0
	reportThread="$( AgentsToolsEventTrackThreadRead "$( AgentsToolsEventTrackThreadOwnDir )" )"
	[ -n "$reportThread" ] || return 0
	printf '%s\n' "$2" | DistroAgentsTools --intern-op-event-track-post "$1" "$reportThread" --kind activity --session-id "${MDAT_SPAWN_SESSION_ID:-}" \
		--field what="board housekeeping" --from-stdin > /dev/null 2>&1 || :
	return 0
}

## First value of one frontmatter header of a file, empty when absent. Bounded to the frontmatter block, so a body line cannot spoof it.
AgentsToolsSpawnSandboxRecordHeader(){ ## file, header
	LC_ALL=C awk -v wantHeader="$2" '
		$0 == "---" { fmCount++ ; if ( fmCount > 1 ) { exit ; } next ; }
		fmCount == 1 && index( $0, wantHeader ": " ) == 1 { print substr( $0, length( wantHeader ) + 3 ) ; exit ; }
	' "$1" 2> /dev/null || :
}

## The participants a session's founding record names (its `participants:` line, --spawn-session) that have no run in it
## yet, one a line, in the record's order. A member has a run there when a spawn record of the session, not an agent-less
## parent's, names it its owner. rc 1, nothing printed, where the session's record names no participants line at all.
AgentsToolsSessionParticipantsUninvited(){ ## session id
	local uninvitedRecord="" uninvitedLine="" uninvitedOne uninvitedRun uninvitedHas
	for uninvitedRecord in "${MMDAPP:-/nonexistent}"/.local/agents/spawned/*/"$1.spawn.md" ; do
		[ -f "$uninvitedRecord" ] && break
		uninvitedRecord=""
	done
	[ -n "$uninvitedRecord" ] || return 1
	LC_ALL=C awk '$0 == "---" { n++ ; if ( n > 1 ) exit ; next } n == 1 && /^participants: / { found = 1 } END { exit !found }' "$uninvitedRecord" 2> /dev/null || return 1
	uninvitedLine="$( AgentsToolsSpawnSandboxRecordHeader "$uninvitedRecord" participants )"
	for uninvitedOne in $uninvitedLine ; do
		[ "$uninvitedOne" != none ] || continue
		uninvitedHas=""
		for uninvitedRun in $( LC_ALL=C grep -l -x -F "session-id: $1" "$MMDAPP"/.local/agents/spawned/*/*.spawn.md 2> /dev/null ) ; do
			[ "$( AgentsToolsSpawnSandboxRecordHeader "$uninvitedRun" agent-less )" != true ] || continue
			[ "$( AgentsToolsSpawnSandboxRecordHeader "$uninvitedRun" owner )" = "$uninvitedOne" ] || continue
			uninvitedHas="yes" ; break
		done
		[ -n "$uninvitedHas" ] || printf '%s\n' "$uninvitedOne"
	done
	return 0
}

## Sandbox folder names linked to one board item, one per line, sorted, empty when none. Two links, either one is enough:
## the item's own spawn-id naming a record, and a record's spawns/spawned-by naming the item. An empty or `-` spawn-id matches nothing.
AgentsToolsSpawnSandboxFoldersOfItem(){ ## item path
	local itemStem="${1##*/}" itemSpawn
	itemStem="${itemStem%.md}"
	itemSpawn="$( AgentsToolsSpawnSandboxRecordHeader "$1" spawn-id )"
	[ -d "$MMDAPP/.local/agents/spawned" ] || return 0
	LC_ALL=C awk -v wantStem="$itemStem" -v wantSpawn="$itemSpawn" '
		FNR == 1 {
			fmCount = 0 ;
			folderName = FILENAME ; sub( /\/[^\/]*$/, "", folderName ) ; sub( /^.*\//, "", folderName ) ;
			recordName = FILENAME ; sub( /^.*\//, "", recordName ) ;
			if ( wantSpawn != "" && wantSpawn != "-" && recordName == wantSpawn ".spawn.md" ) { print folderName ; }
		}
		$0 == "---" { fmCount++ ; next ; }
		fmCount == 1 && ( index( $0, "spawns: " ) == 1 || index( $0, "spawned-by: " ) == 1 ) {
			linkText = $0 ; sub( /^[^:]*: /, "", linkText ) ;
			partCount = split( linkText, linkParts, / *, */ ) ;
			for ( partIndex = 1 ; partIndex <= partCount ; partIndex++ ) {
				linkStem = linkParts[partIndex] ; sub( /\.md$/, "", linkStem ) ;
				if ( linkStem == wantStem ) { print folderName ; break ; }
			}
		}
	' "$MMDAPP/.local/agents/spawned"/*/*.spawn.md 2> /dev/null | LC_ALL=C sort -u || :
}

## Whether a sandbox folder may be removed for one item that is going: `open` (a record still started or without a status),
## `shared` (another board item still links to it, or the folder is not a plain directory under the spawned root), else `removable`.
AgentsToolsSpawnSandboxFolderState(){ ## folder name, item stem going away
	local folderName="$1" skipStem="$2" spawnRoot="$MMDAPP/.local/agents/spawned"
	local recordPath recordStatus recordSpawn linkField linkText linkStem boardPath spawnIds=""
	case "$folderName" in ''|.|..|*/*) echo shared ; return 0 ;; esac
	[ -d "$spawnRoot/$folderName" ] && [ ! -L "$spawnRoot/$folderName" ] || { echo shared ; return 0 ; }
	for recordPath in "$spawnRoot/$folderName"/*.spawn.md ; do
		[ -f "$recordPath" ] || continue
		recordStatus="$( AgentsToolsSpawnSandboxRecordHeader "$recordPath" status )"
		case "$recordStatus" in ''|spawn-started) echo open ; return 0 ;; esac
	done
	for recordPath in "$spawnRoot/$folderName"/*.spawn.md ; do
		[ -f "$recordPath" ] || continue
		recordSpawn="${recordPath##*/}"
		spawnIds="$spawnIds ${recordSpawn%.spawn.md}"
		for linkField in spawns spawned-by ; do
			linkText="$( AgentsToolsSpawnSandboxRecordHeader "$recordPath" "$linkField" )"
			for linkStem in ${linkText//,/ } ; do
				linkStem="${linkStem%.md}"
				[ "$linkStem" != "$skipStem" ] || continue
				for boardPath in "$MDAT_DATA_ROOT"/board/*/"$linkStem.md" ; do
					[ ! -f "$boardPath" ] || { echo shared ; return 0 ; }
				done
			done
		done
	done
	if LC_ALL=C awk -v wantIds="$spawnIds" -v skipStem="$skipStem" '
		BEGIN { idCount = split( wantIds, idParts, " " ) ; for ( idIndex = 1 ; idIndex <= idCount ; idIndex++ ) { idSet[idParts[idIndex]] = 1 ; } }
		FNR == 1 { fmCount = 0 ; fileBase = FILENAME ; sub( /^.*\//, "", fileBase ) ; skipFile = ( fileBase == skipStem ".md" ) ; }
		skipFile { next ; }
		$0 == "---" { fmCount++ ; next ; }
		fmCount == 1 && index( $0, "spawn-id: " ) == 1 && ( substr( $0, 11 ) in idSet ) { found = 1 ; exit ; }
		END { exit ( found ? 0 : 1 ) ; }
	' "$MDAT_DATA_ROOT"/board/*/*.md 2> /dev/null ; then
		echo shared ; return 0
	fi
	echo removable
	return 0
}
