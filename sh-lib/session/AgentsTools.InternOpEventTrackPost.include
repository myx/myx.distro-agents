#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.InternOpEventTrackPost.include -- --intern-op-event-track-post, the one path of
## the tooling's own tracking posts: the posts in a coworking session's event-track thread,
## which every participant of it posts into, and nowhere else: never a post in a session
## thread, where what a participant must be told is a message addressed to it
## (sh-lib/templates/tooling-note.post.format.md, `# Session`). Never a member's message.
## --session-id names the run a post is about, the participant's own id; which thread it
## goes to is the caller's (AgentsTools.EventTrackThread.include).
##
## The text is the tooling template sh-lib/templates/event-track.post.format.md, read
## from this package's own sh-lib, so the template and the code that fills it are always
## the same version. This op fills its slots (AgentsEventTrackPostFill.awk): blocks, each a
## subject then its lines, every line given becoming one operation's line by its own
## template, never posted as it came and never as a code block. A post goes as Slack
## blocks, each block one box (a `container` block: a title, a subtitle with the time of
## its first line, its lines, its secondary details small and grey), with a short text
## beside them for a notification. The limits are Slack's, fixed in code
## (AgentsEventTrackPostFill.awk): 3000 characters to a section, 10 children to a box, 50
## blocks to a post with a box's children counted too; what is beyond goes in the next
## post. A post whose blocks Slack refuses goes once more as plain text, each block under
## its header line, in posts of at most 4000 characters, Slack's limit for a message's
## `text`, with a warning, so nothing is lost. It posts each once and never
## edits a post: what is learned later is a new post, a reply in the thread. Nothing of
## the member send's addressing runs: no addressee, no author line, no conversation lookup.
##
## WHEN IT GOES is not this op's to decide, and never was the caller's either: every post is
## queued in the outbox of its channel and drained from there with everything else bound for
## that channel, so posts go in the order they were made, one message at most every 7
## seconds, and what queued meanwhile is collected into one post up to Slack's own limits
## (AgentsTools.EventTrackSend.include). A start post, a refusal, a grant, a notice and the
## feed's collected lines all wait in that one queue: none jumps it, none overtakes another.
## This is why nothing here posts directly: the sender, AgentsEventTrackPostSend, is called
## by the drain, and waits and notes the same window around each of its own parts.
##
## Transport: --intern-op-slack-call, so its bot-token resolution and Retry-After handling
## apply unchanged, under the bot identity every tracking post has used (the member's own
## bot token where it has one, else the team's). One line per post in the monthly
## comms-slack-send.YYYY-MM.log, in the member send's own columns. Reports the first post
## as SENT_MESSAGE_CHANNEL/SENT_MESSAGE_TS/SENT_MESSAGE_THREAD_TS on stderr, as the member
## send does. No --help entry (internal primitive).
##
## Dual use: sourced with any other first argument it only defines its functions.
##

agentsEventTrackPostLib="$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib"

. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.ToolingTemplate.include"

## The template, from this package's own sh-lib/templates/ (AgentsToolsToolingTemplate).
AgentsEventTrackPostTemplate(){
	AgentsToolsToolingTemplate event-track.post.format.md
}

## Renders the posts into a directory, each as its files (000001.blocks, its boxes;
## 000001.text, its short text; 000001.plain.001, ..., the same post as plain text); rc 3 for
## a kind the template has no block for, 1 when nothing could be rendered.
AgentsEventTrackPostRender(){ ## kind, member, session id, out dir, lines file, name=value...
	local renderKind="$1" renderMember="$2" renderSession="$3" renderDir="$4" renderLines="$5" renderFields="" renderField
	shift 5
	[ -f "$( AgentsEventTrackPostTemplate )" ] || return 1
	## One field per line: a newline or CR in a value is sent as %0A or %0D, so it can never open another field.
	for renderField in "$@" ; do
		renderField="${renderField//$'\n'/%0A}"
		renderFields="$renderFields${renderField//$'\r'/%0D}"$'\n'
	done
	## Values travel through the environment, not -v, which would decode backslashes in them.
	## The team's members, so a line's by= opens a block regarding that member only when it names one:
	## every workspace's, from the member directory (AgentsTools.TeamRegistry.include).
	type AgentsToolsTeamMemberDirectoryText > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.TeamRegistry.include"
	## Who a message's Slack account is: the team's own account cache, read only, `<id>=<name>` each.
	local renderUsers=""
	[ ! -s "${MMDAPP:-}/.local/.agents/slack-mention-ids.cache" ] \
		|| renderUsers="$( LC_ALL=C awk -F= 'NR > 1 && $1 ~ /^[A-Za-z0-9_.-]+$/ && $2 ~ /^[A-Z0-9]+$/ { printf " %s=%s", $2, $1 }' "$MMDAPP/.local/.agents/slack-mention-ids.cache" 2>/dev/null )"
	## A feed post's session keeps its previous Wait set beside its feed, so a Wait shows what it
	## waited on only where that changed (AgentsTools.EventTrackFeed.include); only for a session
	## whose directory is already there.
	local renderWaitState=""
	case "$renderSession" in ''|*/*|.|..|*' '*) ;; *)
		[ "$renderKind" != "feed" ] || [ ! -d "${MMDAPP:-}/.local/agents/sessions/$renderSession" ] \
			|| renderWaitState="$MMDAPP/.local/agents/sessions/$renderSession/event-track.wait-on"
	;; esac
	## The transcript formatter first, for its redaction and tool names, then the Slack date
	## helper, for every time a post shows. ETP_NOW is the moment the post is made: the time
	## of a kind's own lines, which its box's subtitle shows.
	ETP_KIND="$renderKind" ETP_MEMBER="$renderMember" ETP_SESSION="$renderSession" ETP_FIELDS="$renderFields" \
		ETP_DIR="$renderDir" ETP_MEMBERS=" $( [ -z "${MDAT_SKILLSET_ROOT:-}" ] || AgentsToolsTeamMemberDirectoryText 2>/dev/null | LC_ALL=C cut -f1 | tr '\n' ' ' )" \
		ETP_USERS="$renderUsers" ETP_WAIT_STATE="$renderWaitState" ETP_NOW="$( date +%s )" \
		LC_ALL=C awk -f "$agentsEventTrackPostLib/session/AgentsSessionTranscriptFormat.awk" -f "$agentsEventTrackPostLib/comms/AgentsSlackDate.awk" \
		-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsToolingTemplateFill.awk" -f "$agentsEventTrackPostLib/session/AgentsEventTrackPostFill.awk" \
		"$( AgentsEventTrackPostTemplate )" "$renderLines"
}

## One line in the monthly send log, in the member send's columns: time, member, target,
## channel, identity, ok|failed, reason, session id ('-' when none).
AgentsEventTrackPostLog(){ ## member, target, channel, ok|failed, reason
	local logDir="$MMDAPP/.local/agents" logStamp logReason logSession
	logStamp="$( date -u +%Y%m%dT%H%M%SZ )"
	logReason="$( printf '%s' "$5" | LC_ALL=C tr -c 'A-Za-z0-9_.:=/ -' '_' )"
	logSession="$( printf '%s' "${harnessSessionId:-${MDAT_SPAWN_SESSION_ID:-${CLAUDE_CODE_SESSION_ID:-}}}" | LC_ALL=C tr '\t\n\r' '___' )"
	{ mkdir -p "$logDir" && printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$logStamp" "$1" "$2" "$3" bot "$4" "$logReason" "${logSession:--}" \
		>> "$logDir/comms-slack-send.${logStamp:0:4}-${logStamp:4:2}.log" ; } 2>/dev/null \
		|| echo "⚠️ WARNING: $MDSC_CMD --intern-op-event-track-post: could not append this post's outcome to the send log" >&2
	return 0
}

## The weight of a rendered part, Slack's way of counting a post: every block, a box's children counted too (the renderer's own blockCap, 50 to a message).
AgentsEventTrackPostWeight(){ ## a .blocks file
	LC_ALL=C awk '{ n += gsub( /\{"type":"(container|section|context|divider|header|actions|image|rich_text)"/, "&" ) } END { print n + 0 }' "$1"
}

## The parts of several records packed into messages, in order: a message takes the next part while its weight stays within 50 blocks.
## Writes <out dir>/NNNNNN.blocks, .text and .plain.NNN; a part that does not fit starts the next message.
AgentsEventTrackPostPack(){ ## out dir, .blocks files...
	local packOut="$1" packNo=0 packWeight=0 packBlocks="" packText="" packPlain=() packPart packBody packWeightOne packTextOne packPlainOne packPlainNo packName
	shift
	mkdir -p "$packOut" || return 1
	AgentsEventTrackPostPackFlush(){
		[ -n "$packBlocks" ] || return 0
		packNo=$(( packNo + 1 ))
		packName="$packOut/$( printf '%06d' "$packNo" )"
		printf '[%s]\n' "$packBlocks" > "$packName.blocks"
		printf '%s' "$packText" > "$packName.text"
		packPlainNo=0
		for packPlainOne in ${packPlain[@]+"${packPlain[@]}"} ; do
			packPlainNo=$(( packPlainNo + 1 ))
			cp "$packPlainOne" "$packName.plain.$( printf '%03d' "$packPlainNo" )"
		done
		packBlocks="" ; packText="" ; packWeight=0 ; packPlain=()
	}
	for packPart in "$@" ; do
		packBody="$( cat "$packPart" )"
		packBody="${packBody#[}" ; packBody="${packBody%]}"
		packWeightOne="$( AgentsEventTrackPostWeight "$packPart" )"
		packTextOne="$( cat "${packPart%.blocks}.text" 2> /dev/null )"
		if [ -n "$packBlocks" ] && [ $(( packWeight + packWeightOne )) -gt 50 ] ; then AgentsEventTrackPostPackFlush ; fi
		packBlocks="$packBlocks${packBlocks:+,}$packBody"
		packWeight=$(( packWeight + packWeightOne ))
		[ -z "$packTextOne" ] || packText="$packText${packText:+, }$packTextOne"
		for packPlainOne in "${packPart%.blocks}".plain.* ; do
			[ ! -f "$packPlainOne" ] || packPlain+=( "$packPlainOne" )
		done
	done
	AgentsEventTrackPostPackFlush
	unset -f AgentsEventTrackPostPackFlush
	return 0
}

## The sender of the outbox: one queued record, rendered and posted, its output on stdout and
## stderr and its rc the post op's own. Called by the drain
## (AgentsToolsEventTrackSendDrain), never by a caller directly, so every post of a channel
## goes the same way: the drain chose its group and waited its window, and each post here --
## a long one's parts included -- waits and notes that same window, so no two messages into
## the channel are closer than the pacing. The member a post is about, and the bot identity
## it goes under, are exactly the ones the template and the send log have always had.
AgentsEventTrackPostSend(){ ## record dir
	local postRec="$1" postMember="" postKind="" postSession="" postTarget="" postChannel="" postThread=""
	local postDir="" postRc=0 postLineCount postLine postFields=() postFieldsFile=""
	[ -n "$postRec" ] && [ -f "$postRec/meta" ] || {
		echo "⛔ ERROR: $MDSC_CMD --intern-op-event-track-post: no such queued post: ${postRec:-none}" >&2
		return 1
	}
	IFS=$'\t' read -r postMember postKind postSession postTarget postChannel postThread < "$postRec/meta" || :
	## One field per name=value, ended by a NUL and never by a line break, so a value that
	## holds one -- a reason, a text -- is the same value here as it was given.
	postFieldsFile="$postRec/fields"
	if [ -s "$postFieldsFile" ] ; then
		while IFS= read -r -d '' postLine ; do
			[ -z "$postLine" ] || postFields+=( "$postLine" )
		done < "$postFieldsFile"
	fi
	postDir="$( mkdir -p "$MMDAPP/.local/temp" && mktemp -d "$MMDAPP/.local/temp/mdat-event-track-post.XXXXXX" )" || {
		echo "⛔ ERROR: $MDSC_CMD --intern-op-event-track-post: could not create a scratch directory under $MMDAPP/.local/temp -- nothing was posted" >&2
		return 1
	}
	mkdir -p "$postDir/posts"
	local postDirPosts="$postDir/posts"
	## What the log row says of the window: how many lines it held and how many parts it was cut into, so a window that passes Slack's size limit shows.
	postLineCount="$( LC_ALL=C awk 'END { print NR + 0 }' "$postRec/lines" )"
	AgentsEventTrackPostRender "$postKind" "$postMember" "$postSession" "$postDir/posts" "$postRec/lines" ${postFields[@]+"${postFields[@]}"} || postRc=$?
	## The records the drain collected behind this one, in arrival order: each rendered as itself, the parts of all packed into messages up to Slack's block limit.
	local postAlsoDir postAlsoMember postAlsoKind postAlsoSession postAlsoLines postAlsoFields postAlsoAt=0 postAlsoParts=() postAlsoFile
	if [ -d "$postRec/also" ] && [ "$postRc" = "0" ] ; then
		for postAlsoFile in "$postDir/posts"/*.blocks ; do
			[ ! -f "$postAlsoFile" ] || postAlsoParts+=( "$postAlsoFile" )
		done
		for postAlsoDir in "$postRec"/also/[0-9]* ; do
			[ -f "$postAlsoDir/meta" ] || continue
			postAlsoAt=$(( postAlsoAt + 1 ))
			IFS=$'\t' read -r postAlsoMember postAlsoKind postAlsoSession _ < "$postAlsoDir/meta" || :
			postAlsoFields=()
			if [ -s "$postAlsoDir/fields" ] ; then
				while IFS= read -r -d '' postLine ; do
					[ -z "$postLine" ] || postAlsoFields+=( "$postLine" )
				done < "$postAlsoDir/fields"
			fi
			mkdir -p "$postDir/also.$postAlsoAt"
			postLineCount=$(( postLineCount + $( LC_ALL=C awk 'END { print NR + 0 }' "$postAlsoDir/lines" ) ))
			AgentsEventTrackPostRender "$postAlsoKind" "$postAlsoMember" "$postAlsoSession" "$postDir/also.$postAlsoAt" "$postAlsoDir/lines" ${postAlsoFields[@]+"${postAlsoFields[@]}"} || postRc=$?
			for postAlsoFile in "$postDir/also.$postAlsoAt"/*.blocks ; do
				[ ! -f "$postAlsoFile" ] || postAlsoParts+=( "$postAlsoFile" )
			done
		done
		if [ "$postRc" = "0" ] ; then
			AgentsEventTrackPostPack "$postDir/packed" "${postAlsoParts[@]}" || postRc=1
			[ "$postRc" != "0" ] || postDirPosts="$postDir/packed"
		fi
	fi
	local postPosts=()
	local postFile
	for postFile in "$postDirPosts"/*.blocks ; do
		[ ! -f "$postFile" ] || postPosts+=( "$postFile" )
	done
	if [ "$postRc" != "0" ] || [ "${#postPosts[@]}" -eq 0 ] ; then
		rm -rf "$postDir"
		if [ "$postRc" = "3" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-op-event-track-post: the template has no block for kind '$postKind': $( AgentsEventTrackPostTemplate )" >&2
		else
			echo "⛔ ERROR: $MDSC_CMD --intern-op-event-track-post: the post could not be rendered from $( AgentsEventTrackPostTemplate ) (rc $postRc)" >&2
		fi
		return 1
	fi

	## One post per part, as Slack blocks: its boxes, beside the short text a notification
	## shows. A post whose blocks Slack refuses (invalid_blocks, or any error that names
	## them) goes once more as plain text, in the text rendering cut to Slack's `text` limit,
	## with a warning: nothing is lost. A post to a conversation opens a thread; what
	## follows it goes there.
	## The session the post belongs to, as `--session-id` gave it, else the run's own (the one the send log keeps): `[session: <id>]` on a read, which says whose launch a post is.
	local postMetaSession="${postSession:-${harnessSessionId:-${MDAT_SPAWN_SESSION_ID:-}}}"
	local postMetadata="{\"event_type\":\"magic_sender\",\"event_payload\":{\"sender\":\"$postMember\",\"tracking\":\"$postKind\"${postMetaSession:+,\"session\":\"$postMetaSession\"}}}"
	local postIndex=0 postText postPayload postResponse postCallRc postJoined="false" postTs postError postErrorName
	local postSends=() postSendAt postSendFile postAsText postBlocksRefused postSentAny="false"
	for postFile in "${postPosts[@]}" ; do
		postIndex=$(( postIndex + 1 ))
		## What goes for this post: its blocks; refused, its plain text parts in their place.
		postSends=( "$postFile" ) ; postSendAt=0 ; postAsText=""
		while [ "$postSendAt" -lt "${#postSends[@]}" ] ; do
			postSendFile="${postSends[$postSendAt]}"
			case "$postSendFile" in
				*.blocks)
					postText="$( LC_ALL=C awk -f "$agentsEventTrackPostLib/mcp/AgentsMcpJsonEscape.awk" < "${postSendFile%.blocks}.text" )"
					postPayload="{\"channel\":\"$postChannel\",\"text\":\"$postText\",\"blocks\":$( cat "$postSendFile" )${postThread:+,\"thread_ts\":\"$postThread\"},\"metadata\":$postMetadata}"
				;;
				*)
					postText="$( LC_ALL=C awk -f "$agentsEventTrackPostLib/mcp/AgentsMcpJsonEscape.awk" < "$postSendFile" )"
					postPayload="{\"channel\":\"$postChannel\",\"text\":\"$postText\"${postThread:+,\"thread_ts\":\"$postThread\"},\"metadata\":$postMetadata}"
				;;
			esac
			## The channel's window: no message here before it is over, and the moment noted
			## after it, so the next post -- this one's next part, or another's -- waits its
			## own window from here.
			AgentsToolsEventTrackSendPace "${agentsEventTrackSendQueue:-}"
			while : ; do
				postCallRc=0
				postResponse="$( DistroAgentsTools --intern-op-slack-call "$postMember" --api chat.postMessage --identity bot --json-body "$postPayload" \
					--context --intern-op-event-track-post 2> "$postDir/call.err" )" || postCallRc=$?
				## The shared call's own warnings (a rate limit waited out) are said here too.
				LC_ALL=C grep -F '⚠️ WARNING' "$postDir/call.err" >&2 || :
				[ "$postCallRc" != "0" ] || break
				## The bot not yet in the conversation joins it once, as the member send does for a top-level post.
				if [ "$postJoined" = "false" ] && [ -z "$postThread" ] && LC_ALL=C grep -q '"error":"not_in_channel"' "$postDir/call.err" ; then
					postJoined="true"
					if DistroAgentsTools --intern-op-slack-call "$postMember" --api conversations.join --identity bot --form "channel=$postChannel" \
						--context --intern-op-event-track-post > /dev/null 2>&1 ; then
						continue
					fi
				fi
				break
			done
			if [ "$postCallRc" != "0" ] ; then
				postError="$( LC_ALL=C grep -m1 'ERROR' "$postDir/call.err" 2>/dev/null )" || postError=""
				postErrorName="$( printf '%s' "$postError" | LC_ALL=C sed -n 's/.*"error":"\([a-z_]*\)".*/\1/p' | head -n 1 )"
				## Slack refused the blocks: its error names them, or points into them.
				postBlocksRefused=""
				case "$postErrorName" in *block*) postBlocksRefused="yes" ;; esac
				case "$postError" in *json-pointer:/blocks*) postBlocksRefused="yes" ;; esac
				if [ -z "$postAsText" ] && [ -n "$postBlocksRefused" ] ; then
					postAsText="yes"
					postSends=( "${postFile%.blocks}".plain.* ) ; postSendAt=0
					echo "⚠️ WARNING: $MDSC_CMD --intern-op-event-track-post: Slack refused the blocks of the $postKind post, part $postIndex of ${#postPosts[@]} (${postErrorName:-a block error}), so it goes as plain text instead" >&2
					continue
				fi
				AgentsEventTrackPostLog "$postMember" "$postTarget" "$postChannel" failed "not posted: event-track $postKind part $postIndex of ${#postPosts[@]} error=$postErrorName"
				rm -rf "$postDir"
				echo "⛔ ERROR: $MDSC_CMD --intern-op-event-track-post: the $postKind post, part $postIndex of ${#postPosts[@]}, was not posted to $postTarget: ${postError:-the Slack call failed}" >&2
				return 1
			fi
			AgentsToolsEventTrackSendNote "${agentsEventTrackSendQueue:-}"
			postTs="$( printf '%s\n' "$postResponse" | LC_ALL=C awk -v path=ts -v optional=1 -v dialect=slack -f "$agentsEventTrackPostLib/harness/AgentsHarnessJsonField.awk" 2>/dev/null )" || postTs=""
			[ -n "$postTs" ] || postTs="$( printf '%s\n' "$postResponse" | LC_ALL=C awk -v path=message.ts -v optional=1 -v dialect=slack -f "$agentsEventTrackPostLib/harness/AgentsHarnessJsonField.awk" 2>/dev/null )" || postTs=""
			AgentsEventTrackPostLog "$postMember" "$postTarget" "$postChannel" ok "event-track $postKind posted${postAsText:+ as text, its blocks refused} part $postIndex of ${#postPosts[@]} lines=$postLineCount ts=$postTs"
			if [ "$postSentAny" = "false" ] ; then
				postSentAny="true"
				echo "SENT_MESSAGE_CHANNEL=$postChannel" >&2
				echo "SENT_MESSAGE_TS=$postTs" >&2
				echo "SENT_MESSAGE_THREAD_TS=${postThread:-$postTs}" >&2
			fi
			printf 'EVENT_TRACK_POST=%s:%s\n' "$postChannel" "$postTs"
			## What follows a post that opened a thread goes into it.
			[ -n "$postThread" ] || [ -z "$postTs" ] || postThread="$postTs"
			postSendAt=$(( postSendAt + 1 ))
		done
	done
	rm -rf "$postDir"
	return 0
}

case "$1" in

	--intern-op-event-track-post)
		shift
		local etpMember="${1:-}" etpTarget="${2:-}"
		[ $# -lt 2 ] || shift 2
		local etpKind="" etpSession="" etpStdin="false" etpFields=()
		while [ $# -gt 0 ] ; do
			case "$1" in
				--kind|--session-id|--field|--context)
					if [ $# -lt 2 ] ; then
						echo "⛔ ERROR: $MDSC_CMD --intern-op-event-track-post: $1 needs a value" >&2
						set +e ; return 1
					fi
					case "$1" in
						--kind) etpKind="$2" ;;
						--session-id) etpSession="$2" ;;
						--field)
							case "$2" in
								?*=*) etpFields+=( "$2" ) ;;
								*)
									echo "⛔ ERROR: $MDSC_CMD --intern-op-event-track-post: --field takes <name>=<value>, got: $2" >&2
									set +e ; return 1
								;;
							esac
						;;
					esac
					shift 2
				;;
				--from-stdin) etpStdin="true" ; shift ;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --intern-op-event-track-post: invalid option: $1 -- syntax is <member> <target> --kind <kind> [--session-id <id>] [--field <name>=<value>]... [--from-stdin]" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$etpMember" ] || [ -z "$etpTarget" ] || [ -z "$etpKind" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-op-event-track-post: syntax is <member> <target> --kind <kind> [--session-id <id>] [--field <name>=<value>]... [--from-stdin]" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$etpMember" "<member>" event-track-post || { set +e ; return 1 ; }
		AgentsToolsAssertBareName "$etpKind" "--kind" event-track-post || { set +e ; return 1 ; }
		case "$etpMember" in
			routine-*) ;;
			*)
				if [ ! -d "$MDAT_SKILLSET_ROOT/$etpMember" ] ; then
					echo "⛔ ERROR: $MDSC_CMD --intern-op-event-track-post: no such member skill directory: $MDAT_SKILLSET_ROOT/$etpMember" >&2
					set +e ; return 1
				fi
			;;
		esac

		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.CommsSlack.include"
		local etpResolved="" etpResolveRc=0 etpChannel="" etpThread=""
		etpResolved="$( DistroAgentsToolsResolveTarget "$etpTarget" )" || etpResolveRc=$?
		if [ "$etpResolveRc" != "0" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-op-event-track-post: could not resolve a channel for target '$etpTarget'" >&2
			set +e ; return 1
		fi
		etpChannel="$( printf '%s\n' "$etpResolved" | sed -n 's/^CHANNEL=//p' )"
		etpThread="$( printf '%s\n' "$etpResolved" | sed -n 's/^THREAD_TS=//p' )"

		local etpDir=""
		etpDir="$( mkdir -p "$MMDAPP/.local/temp" && mktemp -d "$MMDAPP/.local/temp/mdat-event-track-post.XXXXXX" )" || {
			echo "⛔ ERROR: $MDSC_CMD --intern-op-event-track-post: could not create a scratch directory under $MMDAPP/.local/temp -- nothing was posted" >&2
			set +e ; return 1
		}
		if [ "$etpStdin" = "true" ] ; then cat > "$etpDir/lines" ; else : > "$etpDir/lines" ; fi
		## One field per name=value, ended by a NUL and never by a line break: a value that holds
		## one is queued, and rendered, as the very value it was given.
		: > "$etpDir/fields"
		local etpField
		for etpField in ${etpFields[@]+"${etpFields[@]}"} ; do printf '%s\0' "$etpField" >> "$etpDir/fields" ; done

		## THE OUTBOX: queued behind everything else bound for this channel, then drained --
		## by this call, or by the sender already draining, which posts it in its turn. Either
		## way it goes in the order it was made, at most one message every 7 seconds, and what
		## queued meanwhile is collected with it where the two may go as one post
		## (AgentsTools.EventTrackSend.include).
		type AgentsToolsEventTrackSendAppend > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.EventTrackSend.include"
		local etpQueue="" etpRecord="" etpSeq="" etpPostRc=0
		etpQueue="$( AgentsToolsEventTrackSendDir "$etpChannel" )" || etpQueue=""
		if [ -z "$etpQueue" ] ; then
			rm -rf "$etpDir"
			echo "⛔ ERROR: $MDSC_CMD --intern-op-event-track-post: the channel '$etpChannel' has no outbox in this workspace -- nothing was posted" >&2
			set +e ; return 1
		fi
		AgentsToolsEventTrackSendReap "$etpQueue"
		etpRecord="$( AgentsToolsEventTrackSendAppend "$etpQueue" "$etpMember" "$etpKind" "$etpSession" "$etpTarget" "$etpChannel" "$etpThread" "$etpDir/fields" "$etpDir/lines" )" || etpRecord=""
		if [ -z "$etpRecord" ] ; then
			rm -rf "$etpDir"
			echo "⛔ ERROR: $MDSC_CMD --intern-op-event-track-post: the $etpKind post could not be queued for $etpTarget -- nothing was posted" >&2
			set +e ; return 1
		fi
		etpSeq="${etpRecord##*/}"
		AgentsToolsEventTrackSendDrain "$etpQueue" AgentsEventTrackPostSend || :
		## Long enough for a sender that is already working through a backlog: seven seconds a
		## message, and a channel's backlog is small; nothing here gives up while it is going.
		AgentsToolsEventTrackSendWait "$etpQueue" "$etpSeq" 300 || :
		if [ -s "$etpQueue/done/$etpSeq/rc" ] ; then
			cat "$etpQueue/done/$etpSeq/out" 2>/dev/null || :
			cat "$etpQueue/done/$etpSeq/err" >&2 2>/dev/null || :
			etpPostRc="$( cat "$etpQueue/done/$etpSeq/rc" 2>/dev/null )" || etpPostRc=1
			case "$etpPostRc" in ''|*[!0-9]*) etpPostRc=1 ;; esac
			rm -rf "$etpQueue/done/$etpSeq" 2>/dev/null || :
		else
			etpPostRc=1
			echo "⛔ ERROR: $MDSC_CMD --intern-op-event-track-post: the $etpKind post was queued for $etpTarget but no sender posted it in time" >&2
		fi
		rm -rf "$etpDir"
		[ "$etpPostRc" = "0" ] || { set +e ; return "$etpPostRc" ; }
		return 0
	;;

esac
