#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.RootHarnessKind.include -- the old path of two files, kept as a forwarder only: the harness kind now lives in
## sh-lib/chat/AgentsTools.RootHarnessKind.include and the root-harness routine record in
## sh-lib/routine/AgentsTools.RoutineRootHarness.include. A process that loaded a caller before the move still sources this
## path lazily, so it stays until those processes end; it then goes (MEL task-20261116T1125Z-remove-old-paths-after-runs-restart).
## Defines nothing of its own.
##

. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/chat/AgentsTools.RootHarnessKind.include"
. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/routine/AgentsTools.RoutineRootHarness.include"
