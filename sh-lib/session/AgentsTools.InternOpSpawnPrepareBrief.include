#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.InternOpSpawnPrepareBrief.include -- --intern-op-spawn-prepare-brief.
## Read-only. Emits the MECHANICAL parts of a spawn-prepare-brief that a
## dispatch brief currently hand-carries, so agent-carried config moves into
## tooling ("handle most by tooling, simpler life for the agent"):
## The text is the tooling template sh-lib/templates/spawn-brief.document.format.md;
## this op fills its slots: the member, the resolved routine's own filename/executors/
## invitees, and the open warning-* set read from the board.
## The spawning agent still supplies the JUDGEMENT parts (which warnings are
## relevant, held-context, checked). No writes, no side effects.
## Sourced lazily via the standard $MDLT_ORIGIN path; relies on being
## dot-sourced for $1/$@/$MDSC_CMD. No --help entry (internal primitive).
##

case "$1" in

	--intern-op-spawn-prepare-brief)
		shift
		local targetMember="$1"
		shift || true
		if [ -z "$targetMember" ] ; then
			echo "$MDSC_CMD: spawn-prepare-brief: ⛔ ERROR: syntax is <target-member> (--routine <selector>|--routine-default) [--context <ctx>]" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$targetMember" "<target-member>" spawn-prepare-brief || { set +e ; return 1 ; }

		## Exactly one of --routine/--routine-default is required; --context is the
		## only other option. Anything else is a malformed call and fails cleanly
		## rather than being absorbed silently.
		local routineSelector="" routineDefault="false" briefCliService="" briefSettingsWorkspace=""
		while [ $# -gt 0 ] ; do
			case "$1" in
				## The workspace named to pay for the one spawn this brief is for, as its spawn is given it.
				--settings-workspace)
					if [ -z "${2:-}" ] ; then
						echo "$MDSC_CMD: spawn-prepare-brief: ⛔ ERROR: --settings-workspace requires <workspace-name>" >&2
						set +e ; return 1
					fi
					briefSettingsWorkspace="$2"
					shift 2
				;;
				--cli-service)
					if [ -z "${2:-}" ] ; then
						echo "$MDSC_CMD: spawn-prepare-brief: ⛔ ERROR: --cli-service requires <service>" >&2
						set +e ; return 1
					fi
					briefCliService="$2"
					shift 2
				;;
				--routine)
					if [ -z "${2:-}" ] ; then
						echo "$MDSC_CMD: spawn-prepare-brief: ⛔ ERROR: --routine requires <selector>" >&2
						set +e ; return 1
					fi
					routineSelector="$2"
					shift 2
				;;
				--routine-default)
					routineDefault="true"
					shift
				;;
				--context)
					if [ -z "${2:-}" ] ; then
						echo "$MDSC_CMD: spawn-prepare-brief: ⛔ ERROR: --context: value required" >&2
						set +e ; return 1
					fi
					shift 2
				;;
				*)
					echo "$MDSC_CMD: spawn-prepare-brief: ⛔ ERROR: invalid option: $1 -- syntax is <target-member> (--routine <selector>|--routine-default) [--context <ctx>]" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -n "$routineSelector" ] && [ "$routineDefault" = "true" ] ; then
			echo "$MDSC_CMD: spawn-prepare-brief: ⛔ ERROR: use only one of --routine <selector> | --routine-default" >&2
			set +e ; return 1
		fi
		if [ -z "$routineSelector" ] && [ "$routineDefault" != "true" ] ; then
			echo "$MDSC_CMD: spawn-prepare-brief: ⛔ ERROR: exactly one of --routine <selector> | --routine-default is required" >&2
			set +e ; return 1
		fi

		[ -n "${MDAT_DATA_ROOT:-}" ] || {
			echo "$MDSC_CMD: spawn-prepare-brief: ⛔ ERROR: MDAT_DATA_ROOT is not set" >&2
			set +e ; return 1
		}

		local armedFile="$MDAT_SKILLSET_ROOT/$targetMember/$targetMember.armed.md"
		if [ ! -f "$armedFile" ] ; then
			echo "$MDSC_CMD: spawn-prepare-brief: ⛔ ERROR: no such member .armed.md: $armedFile" >&2
			set +e ; return 1
		fi

		## The brief's text is the tooling's own template (AgentsToolsToolingTemplate); this op only fills its slots.
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.ToolingTemplate.include"
		local briefTemplate
		briefTemplate="$( AgentsToolsToolingTemplate spawn-brief.document.format.md )"
		if [ ! -f "$briefTemplate" ] ; then
			echo "$MDSC_CMD: spawn-prepare-brief: ⛔ ERROR: the brief template is missing: $briefTemplate" >&2
			set +e ; return 1
		fi

		## Resolve the routine, by selector or by the standing default, then run its
		## contract check -- a routine file that fails either is refused rather than
		## printing a brief with unfilled or untrustworthy routine slots.
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SpawnRoutine.include"
		if [ "$routineDefault" = "true" ] ; then
			routineSelector="$( AgentsToolsSpawnRoutineDefaultName )" || { set +e ; return 1 ; }
		fi
		local routineFile
		routineFile="$( AgentsToolsSpawnRoutineResolve "$routineSelector" )" || { set +e ; return 1 ; }
		local routineContract
		routineContract="$( AgentsToolsSpawnRoutineContractCheck "$routineFile" )" || { set +e ; return 1 ; }
		local routineExecutors routineInvitees
		{
			IFS= read -r routineExecutors
			IFS= read -r routineInvitees
		} <<< "$( AgentsToolsSpawnRoutineContractExecutorsInvitees "$routineContract" )"
		local routineName="${routineFile##*/}"
		## The kind the routine names (the contract check above has settled that it is one of the list), and the
		## bundled routine that defines it: the one the brief tells the member to read beside the routine.
		local routineKind routineKindFile routineLockDoc routineScanDef
		type AgentsToolsRoutineKey > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.RoutineRequirements.include"
		routineLockDoc="$( AgentsToolsRoutineKey "$routineFile" routine-lock-document )"
		## The lock is named per member (F4.2): the brief names the document of the member it is for.
		if [ -n "$routineLockDoc" ] ; then
			type AgentsToolsRoutineLockFill > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/magic/AgentsTools.RoutineLock.include"
			routineLockDoc="$( AgentsToolsRoutineLockFill "$routineLockDoc" "$targetMember" )"
		fi
		type AgentsToolsInputScanDefNames > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.InputScanDef.include"
		routineScanDef="$( AgentsToolsInputScanDefNames "$( AgentsToolsRoutineKeyLines "$routineFile" input-scan-def )" )"
		routineKind="$( AgentsToolsSpawnRoutineKindOwn "$routineFile" )"
		routineKindFile="$( AgentsToolsSpawnRoutineKindRoutine "$routineKind" )" || { set +e ; return 1 ; }

		## open warning-* set: the currently-open board warnings only (active
		## states, never processed/archived/retained). The agent filters these
		## for relevance itself -- this emits the raw open set to filter from.
		local warnState warnFile warnLines=""
		for warnState in backlog pending running review blocked parked ; do
			for warnFile in "$MDAT_DATA_ROOT/board/$warnState"/warning-*.md ; do
				[ -e "$warnFile" ] || continue
				warnLines="$warnLines- ${warnFile##*/} [$warnState]"$'\n'
			done
		done
		[ -n "$warnLines" ] || warnLines="(none open)"$'\n'

		## The harness the spawn runs in: the service it names, else the configured one of the
		## workspace that pays for it, settled here as the spawn itself settles it
		## (AgentsToolsSpawnSettingsSettle), never as the calling session's own spawn did. A
		## *-native client is native; everything else runs in the universal harness.
		if [ -z "$briefCliService" ] ; then
			local -x MDAT_SPAWN_SETTINGS_WORKSPACE=""
			MDAT_SPAWN_SETTINGS_WORKSPACE="$( AgentsToolsSpawnSettingsSettle "$targetMember" "$briefSettingsWorkspace" spawn-prepare-brief )" || { set +e ; return 1 ; }
			## and the preset chosen for the member it is for, as the spawn chooses it (F10.2), so the brief and the spawn read one CLI
			local -x MDAT_SPAWN_PRESET=""
			type AgentsToolsPresetChosen > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/config/AgentsTools.Preset.include"
			MDAT_SPAWN_PRESET="$( AgentsToolsPresetChosen "$targetMember" )" || MDAT_SPAWN_PRESET=""
			briefCliService="$( DistroAgentsTools --agents-config-option magic-team --select SPAWN_CLI_SERVICE 2>/dev/null )" || briefCliService=""
		fi
		local briefHarness="own"
		case "$briefCliService" in *-native) briefHarness="native" ;; esac

		## The Skeleton block, verbatim, with each slot filled; a template without one is refused.
		local briefText
		## Values travel through the environment, not -v, which would decode backslashes in them.
		briefText="$( BRIEF_MEMBER="$targetMember" BRIEF_WARNINGS="${warnLines%$'\n'}" BRIEF_ROUTINE="$routineName" BRIEF_KIND="$routineKind" BRIEF_KIND_ROUTINE="$routineKindFile" BRIEF_LOCK="$routineLockDoc" BRIEF_SCAN="$routineScanDef" BRIEF_EXECUTORS="$routineExecutors" BRIEF_INVITEES="$routineInvitees" BRIEF_HARNESS="$briefHarness" AgentsToolsToolingTemplateFill spawn-brief.document.format.md session/AgentsSpawnPrepareBriefFill.awk )" || {
			echo "$MDSC_CMD: spawn-prepare-brief: ⛔ ERROR: the brief template has no complete Skeleton block: $briefTemplate" >&2
			set +e ; return 1
		}
		printf '%s\n' "$briefText"
		return 0
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
