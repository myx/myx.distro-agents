#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.InputScanDef.include -- a routine's own input scans (F6.3), declared in its frontmatter, one repeatable
## line for each scan: `input-scan-def: <scan> [--option value ...]`, or `input-scan-def: none` alone for no scan.
## <scan> is a scan of the tooling (AgentsToolsInputScanNames), run as its `--intern-op-<scan>-input-scan`
## operation with the team member of the start as its first argument, then the options as given. A value that exists
## only at session time is a macro, `{{<option-name>}}` over the five names of the common option set (team-member,
## session-id, spawn-id, select-workspace, tooling-origin), written in a static document. The spawner runs each scan
## itself, with no instruction to an agent, and saves the results to `input/input-scan.md` of the session sandbox.
## Sourced, never run. Functions only.
##
## AgentsToolsInputScanDefWords is THE ONE PARSER of the line form: the validator and the spawner both call it, so
## the form changes in this place alone.
##

## The scans of the tooling a definition may name, one a line: one for each `--intern-op-<scan>-input-scan` the
## dispatcher routes (F6.4).
AgentsToolsInputScanNames(){
	printf '%s\n' client-sweep grooming member-work-session morning-review permission-escalation routine-coworking-session sweep work-duty
}

## The call one definition line stands for, split into its words, one a line: the scan's operation, the team member,
## then each option and its value with the macros filled from the spawn's context. rc 1, the reason on stderr, for a
## line that names no scan, an option with no value, a word that is no option, or a macro that is none of the five.
## One option is the spawner's and not the scan's, `--wait <seconds>` (whole seconds, 1 or more, once): it is not among the words, and
## AgentsToolsInputScanDefWait reads it. With input present the start is at once; with an empty scan the spawner waits up to that long
## for some to come (AgentsToolsInputScanDefAwait), and a start that nothing came to is none.
AgentsToolsInputScanDefWords(){ ## definition line, team member, session id, spawn id
	local defWords defScan defAt defWord defFilled defOption="" defWaitSeen=""
	read -r -a defWords <<< "$1"
	defScan="${defWords[0]:-}"
	if [ -z "$defScan" ] || ! AgentsToolsInputScanNames | LC_ALL=C grep -q -x -- "$defScan" ; then
		echo "⛔ ERROR: ${MDSC_CMD:-DistroAgentsTools}: input-scan-def: '$1' does not start with a scan of the tooling ($( AgentsToolsInputScanNames | LC_ALL=C tr '\n' ' ' | LC_ALL=C sed 's/ $//' )) -- the form is <scan> [--option value ...], or none alone" >&2
		return 1
	fi
	printf '%s\n' "--intern-op-$defScan-input-scan" "$2"
	for (( defAt = 1 ; defAt < ${#defWords[@]} ; defAt++ )) ; do
		defWord="${defWords[$defAt]}"
		if [ -z "$defOption" ] ; then
			case "$defWord" in
				--*) defOption="$defWord" ; continue ;;
			esac
			echo "⛔ ERROR: ${MDSC_CMD:-DistroAgentsTools}: input-scan-def: '$1': '$defWord' is no --option -- the form is <scan> [--option value ...]" >&2
			return 1
		fi
		case "$defWord" in
			--*)
				echo "⛔ ERROR: ${MDSC_CMD:-DistroAgentsTools}: input-scan-def: '$1': the option $defOption has no value -- the form is <scan> [--option value ...]" >&2
				return 1
			;;
		esac
		defFilled="$( printf '%s' "$defWord" | SCAN_TEAM_MEMBER="$2" SCAN_SESSION_ID="$3" SCAN_SPAWN_ID="$4" SCAN_SELECT_WORKSPACE="${MMDAPP:-}" SCAN_TOOLING_ORIGIN="${MDLT_ORIGIN:-}" \
			LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsToolingTemplateFill.awk" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsInputScanDefFill.awk" )"
		case "$defFilled" in
			*"{{"*)
				echo "⛔ ERROR: ${MDSC_CMD:-DistroAgentsTools}: input-scan-def: '$defWord' names a macro that is none of team-member, session-id, spawn-id, select-workspace and tooling-origin" >&2
				return 1
			;;
		esac
		if [ "$defOption" = "--wait" ] ; then
			case "$defFilled" in
				''|*[!0123456789]*|0|0[0123456789]*)
					echo "⛔ ERROR: ${MDSC_CMD:-DistroAgentsTools}: input-scan-def: '$1': --wait takes whole seconds, 1 or more, got: $defFilled" >&2
					return 1
				;;
			esac
			if [ -n "$defWaitSeen" ] ; then
				echo "⛔ ERROR: ${MDSC_CMD:-DistroAgentsTools}: input-scan-def: '$1': --wait is given twice" >&2
				return 1
			fi
			defWaitSeen="yes" ; defOption=""
			continue
		fi
		printf '%s\n' "$defOption" "$defFilled"
		defOption=""
	done
	if [ -n "$defOption" ] ; then
		echo "⛔ ERROR: ${MDSC_CMD:-DistroAgentsTools}: input-scan-def: '$1': the option $defOption has no value -- the form is <scan> [--option value ...]" >&2
		return 1
	fi
}

## The seconds of the `--wait <seconds>` option of a definition line, nothing printed for a line with none.
AgentsToolsInputScanDefWait(){ ## definition line
	local waitWords waitAt
	read -r -a waitWords <<< "$1"
	for (( waitAt = 1 ; waitAt < ${#waitWords[@]} ; waitAt++ )) ; do
		[ "${waitWords[$waitAt]}" != "--wait" ] || { printf '%s\n' "${waitWords[$(( waitAt + 1 ))]:-}" ; return 0 ; }
	done
	return 0
}

## Whether a scan's report holds nothing to work: rc 0 where every line of it is blank, a heading (`#`), a section's `scope:` or `cap:` line, `(none)`, a
## `**NOTE:** no new ...` line or `Nothing new ...`. Any other line is input, so a scan that words its emptiness in another way starts the run, and a report is
## never taken for empty on a guess: the mistake can only be a start.
AgentsToolsInputScanReportEmpty(){ ## the report file
	LC_ALL=C awk '
		/^[[:space:]]*$/ { next }
		/^#/ { next }
		/^\(none\)$/ { next }
		/^scope: / { next }
		/^cap: / { next }
		/^\*\*NOTE:\*\* no new / { next }
		/^Nothing new/ { next }
		{ found = 1 ; exit }
		END { exit ( found ? 1 : 0 ) }' "$1" 2> /dev/null
}

## One scan of a definition line run, its report into a file; a scan that fails leaves its failure in the report, which is input to whoever starts on it.
AgentsToolsInputScanDefOne(){ ## definition line, team member, session id, spawn id, the report file
	local oneWords oneWord oneArgs=() oneRc=0
	oneWords="$( AgentsToolsInputScanDefWords "$1" "$2" "$3" "$4" )" || return 1
	while IFS= read -r oneWord ; do oneArgs+=( "$oneWord" ) ; done <<< "$oneWords"
	DistroAgentsTools "${oneArgs[@]}" > "$5" 2> "$5.err" || oneRc=$?
	if [ "$oneRc" -ne 0 ] ; then
		{ printf 'The input scan failed (exit %s):\n' "$oneRc" ; cat "$5.err" 2> /dev/null ; } >> "$5"
	fi
	rm -f "$5.err"
	return 0
}

## THE WAIT OF A SCAN (`--wait <seconds>` on a definition line), before anything is made for the start: with input present the start goes on at once, after the
## scan's own collect window, which gathers what arrives together into one report. With an empty scan (AgentsToolsInputScanReportEmpty) the spawner waits up to that
## long for some to come, on the Wait layer's sources (--wait-for-input): the sources the routine declares (`wait-sources:`, `{{team-member}}` the member
## of the start), else the member's own inbox, read at every pass. At each wake, and once more when the time is out, the scan is run again. Each report is kept in
## the folder given, line.<n>, for the start to use as its own, so that no scan runs twice for a start that goes on. The sources are read from the instant the wait of
## the line began, not from their first pass of the Wait: what arrived between the scan's reading and the Wait's first pass is an arrival too.
## rc 0 the start goes on; rc 3 nothing came
## (one line says so, on stdout); rc 1 the wait could not be made.
AgentsToolsInputScanDefAwait(){ ## definition lines (one a line), team member, session id, spawn id, the routine file, the folder for the reports
	local awaitLine awaitIndex=0 awaitSeconds awaitScan awaitFile awaitDeadline awaitLeft awaitSources awaitWord awaitArgs awaitOut awaitHead awaitFrom
	type AgentsToolsRoutineKeyLines > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.RoutineRequirements.include"
	while IFS= read -r awaitLine ; do
		[ -n "$awaitLine" ] && [ "$awaitLine" != "none" ] || continue
		awaitIndex=$(( awaitIndex + 1 ))
		awaitSeconds="$( AgentsToolsInputScanDefWait "$awaitLine" )"
		[ -n "$awaitSeconds" ] || continue
		awaitScan="${awaitLine%% *}"
		awaitFile="$6/line.$awaitIndex"
		awaitFrom="$( date +%s )"
		awaitDeadline=$(( awaitFrom + awaitSeconds ))
		AgentsToolsInputScanDefOne "$awaitLine" "$2" "$3" "$4" "$awaitFile" || return 1
		while AgentsToolsInputScanReportEmpty "$awaitFile" ; do
			awaitLeft=$(( awaitDeadline - $( date +%s ) ))
			if [ "$awaitLeft" -le 0 ] ; then
				printf '%s: agent-spawn-proxy: nothing came on the %s scan of %s within %s seconds: no agent was started\n' "${MDSC_CMD:-DistroAgentsTools}" "$awaitScan" "${5##*/}" "$awaitSeconds"
				return 3
			fi
			awaitSources=""
			while IFS= read -r awaitWord ; do
				for awaitWord in $awaitWord ; do
					awaitWord="${awaitWord//\{\{team-member\}\}/$2}"
					awaitSources="$awaitSources --wait-source $awaitWord"
				done
			done <<< "$( AgentsToolsRoutineKeyLines "$5" wait-sources )"
			[ -n "$awaitSources" ] || awaitSources="--wait-source inbox:$2"
			## The Wait of the start has no session of its own: not the caller's floor, and not a pointer of the new session.
			awaitOut="$( unset MDAT_SESSION_ID MDAT_SPAWN_SESSION_ID ; DistroAgentsTools --wait-for-input "$2" $awaitSources --wait-since-utime "$awaitFrom" --wait-timeout "$awaitLeft" 2> /dev/null < /dev/null )" || :
			awaitHead="$( printf '%s\n' "$awaitOut" | head -n 1 )"
			case "$awaitHead" in
				"WAIT-RESULT: RECEIVED"*|"WAIT-RESULT: TIMEOUT"*) ;;
				*)
					echo "⛔ ERROR: ${MDSC_CMD:-DistroAgentsTools}: agent-spawn-proxy: the wait of the $awaitScan scan ($awaitSources) could not be made: ${awaitHead:-no answer}" >&2
					return 1
				;;
			esac
			AgentsToolsInputScanDefOne "$awaitLine" "$2" "$3" "$4" "$awaitFile" || return 1
		done
	done <<< "$1"
	return 0
}

## THE POINTER OF A SCAN, KEPT FOR THE RUN (F10.5 gate B). The spawner runs a routine's scans and gives the run their reports (input/input-scan.md). A
## scan as a source of Wait (`scan:<scan>`, F3.3) wakes when its report differs from the one the session was last given, and the first time with the
## report it has, so a run's first `--idle-wait` on its declared scans would wake at once on the report it was just handed, and cost a model round to
## see it again. The spawner therefore keeps the pointer of the session, `scan:<scan>:<member>`, at the report it gave: the sum the wait keeps of a
## report (<cksum>-<size>), so the first wait has only what is new beyond it. The wait reads a scan by its name, so a definition with options is
## read by its name here too (the run waits on that view, not on the one the options made). A scan that failed has none.
AgentsToolsInputScanDefSeed(){ ## definition line, scan, team member, session id, the file the spawner's run of the scan printed
	local seedFile="$5" seedKept seedSum
	[ -n "$4" ] || return 0
	type AgentsToolsSessionChatPointerSet > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionChat.include" 2> /dev/null || return 0
	if [ "$1" != "$2" ] ; then
		seedFile="$5.seed"
		DistroAgentsTools "--intern-op-$2-input-scan" "$3" > "$seedFile" 2> /dev/null || { rm -f "$seedFile" ; return 0 ; }
	fi
	## A scan called in a team session prints the reference to its kept report, and the report is that file (AgentsWaitProbeScan reads it so).
	seedKept="$( LC_ALL=C sed -n 's/^\.\.\. KEPT: .* is in \(.*\) -- .*\.\.\.$/\1/p' "$seedFile" | head -1 )"
	[ -z "$seedKept" ] || [ ! -f "$seedKept" ] || seedFile="$seedKept"
	seedSum="$( LC_ALL=C cksum < "$seedFile" | LC_ALL=C awk '{ print $1 "-" $2 ; }' )"
	[ "$1" = "$2" ] || rm -f "$5.seed"
	[ -n "$seedSum" ] && AgentsToolsSessionChatPointerSet "$4" "scan:$2:$3" "$seedSum" || :
	return 0
}

## The scans a set of definition lines names, joined by `, `: what the brief says ran.
AgentsToolsInputScanDefNames(){ ## definition lines (one a line)
	printf '%s\n' "$1" | LC_ALL=C awk 'NF > 0 && $1 != "none" { printf "%s%s", sep, $1 ; sep = ", " } END { if ( sep != "" ) printf "\n" }'
}

## The scans run for a start, their results in one file: each line of the definition in order, then the member, session
## and spawn it is run for, then the file. One scan: its report as it is. Several: each under `## input scan: <scan>`.
## A scan's own failure is not the start's: the file then says it failed, and what it said, and the agent reads that.
## rc 1 only for a definition that cannot be run at all, before any scan has run.
AgentsToolsInputScanDefRun(){ ## definition lines (one a line), team member, session id, spawn id, result file
	local runLines="" runLine runCount=0 runScan runWords runWord runArgs runRc runOut runErr runAt=0
	while IFS= read -r runLine ; do
		[ -n "$runLine" ] && [ "$runLine" != "none" ] || continue
		AgentsToolsInputScanDefWords "$runLine" "$2" "$3" "$4" > /dev/null || return 1
		runLines="$runLines$runLine"$'\n'
		runCount=$(( runCount + 1 ))
	done <<< "$1"
	: > "$5" || return 1
	runOut="$5.one" ; runErr="$5.err"
	while IFS= read -r runLine ; do
		[ -n "$runLine" ] || continue
		runAt=$(( runAt + 1 ))
		runScan="${runLine%% *}"
		runWords="$( AgentsToolsInputScanDefWords "$runLine" "$2" "$3" "$4" )"
		runArgs=()
		while IFS= read -r runWord ; do runArgs+=( "$runWord" ) ; done <<< "$runWords"
		runRc=0
		## The report the wait of this line made last (AgentsToolsInputScanDefAwait) is the one this start goes on with; the scan is not run a second time.
		if [ -n "${agentsInputScanGiven:-}" ] && [ -f "$agentsInputScanGiven/line.$runAt" ] ; then
			cp "$agentsInputScanGiven/line.$runAt" "$runOut" && : > "$runErr" || runRc=1
		else
			DistroAgentsTools "${runArgs[@]}" > "$runOut" 2> "$runErr" || runRc=$?
		fi
		[ "$runCount" -le 1 ] || printf '## input scan: %s\n\n' "$runScan" >> "$5"
		if [ "$runRc" -ne 0 ] ; then
			{
				printf '%s\n\n' "## input scan failed"
				printf 'The spawner ran `%s` for this start and it failed (exit %s). What it said:\n\n' "${runArgs[*]}" "$runRc"
				cat "$runOut" "$runErr" 2> /dev/null
			} >> "$5"
			echo "⚠️ WARNING: ${MDSC_CMD:-DistroAgentsTools}: the input scan $runScan of this routine failed (exit $runRc), and input/input-scan.md says so" >&2 || :
		else
			cat "$runOut" >> "$5"
			AgentsToolsInputScanDefSeed "$runLine" "$runScan" "$2" "$3" "$runOut"
		fi
		[ "$runCount" -le 1 ] || printf '\n' >> "$5"
	done <<< "$runLines"
	rm -f "$runOut" "$runErr"
	[ -z "${agentsInputScanGiven:-}" ] || { rm -rf "$agentsInputScanGiven" ; agentsInputScanGiven="" ; }
	return 0
}
