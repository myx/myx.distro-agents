#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.StartedRecords.include -- the spawn store's records, read through the store: one session's records, the one walk of
## every record, those records' headers in one read, a spawn's children, and the spawned-sessions registry as it stands.
## Sourced, never run. Functions only. The schedule's kept copies of these lists are `sh-lib/schedule/AgentsTools.StartedRecords.include`.
##

## A KEPT DUTY SESSION ENDS WITH ITS DAY. The session a member's work-duty keeps for its restarts (schedule/duty-session/<member>) is the
## session of one worktime: its thread is the one the human-owner reads in the team bot's conversation that day, and the day's first run
## opens a session of its own. A session begun on an earlier day is stale: joined, a new day's run posts into yesterday's thread, where
## nobody sees it. The day is the session's own, the `started-at:` of the record that founded it (spawned/<id>/<id>.spawn.md), never the
## kept file's time, which a join rewrites. rc 0 for a session begun before today, by the host's local date; rc 1 for one of today, or
## one with no founding record to tell.
## Before a member's kept duty session id is dropped, for any reason, that session's read pointer into the member's tagged source is
## folded into the schedule's own (schedule/handed/<member>) where it is later. Otherwise a tag that duty already read looks new against the
## older pointer: it starts a duty out of hours, makes demand in hours, and the next duty is seeded to read it again. Quiet; rc 0 always.
AgentsToolsDutyKeptTagFold(){ ## member, the kept session id
	local foldRead="" foldOwn=""
	case "${1:-}:${2:-}" in :*|*:|*/*) return 0 ;; esac
	type AgentsToolsSessionChatPointer > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionChat.include"
	foldRead="$( AgentsToolsSessionChatPointer "$2" "collect:$1:tagged:$1" 2> /dev/null )" || foldRead=""
	foldRead="${foldRead%%.*}"
	case "$foldRead" in ''|*[!0123456789]*) return 0 ;; esac
	[ ! -f "$MMDAPP/.local/agents/schedule/handed/$1" ] || read -r foldOwn < "$MMDAPP/.local/agents/schedule/handed/$1" || :
	foldOwn="${foldOwn%%.*}"
	case "$foldOwn" in ''|*[!0123456789]*) foldOwn=0 ;; esac
	[ "$foldRead" -gt "$foldOwn" ] || return 0
	mkdir -p "$MMDAPP/.local/agents/schedule/handed" 2> /dev/null && printf '%s\n' "$foldRead" > "$MMDAPP/.local/agents/schedule/handed/$1"
	return 0
}

AgentsToolsDutyKeptStale(){ ## the kept session id
	local staleRecord="" staleDay=""
	case "${1:-}" in ''|*/*|.|..) return 1 ;; esac
	staleRecord="${MMDAPP:-}/.local/agents/spawned/$1/$1.spawn.md"
	[ -f "$staleRecord" ] || return 1
	staleDay="$( LC_ALL=C awk 'NR > 1 && $0 == "---" { exit ; } index( $0, "started-at: " ) == 1 { print substr( $0, 13, 10 ) ; exit ; }' "$staleRecord" 2> /dev/null )"
	case "$staleDay" in [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;; *) return 1 ;; esac
	[ "$staleDay" != "$( date '+%Y-%m-%d' )" ]
}

## THE STORE'S STAMP, one stat of spawned/ itself and of no folder under it, into the variable: the store's own writer and its removal
## move it after every record they create, rewrite, close or remove (AgentsSpawnRecordWrite, AgentsSpawnRecordRemove). A reader compares
## it by inequality alone, never keeps one of the current second, and walks where it is empty. Empty where the store cannot be read.
AgentsSpawnedStoreStampInto(){ ## variable, workspace (default MMDAPP)
	local stampStore="${2:-${MMDAPP:-}}"
	printf -v "$1" '%s' ""
	case "${stampStore%/}" in ''|/) return 1 ;; esac
	printf -v "$1" '%s' "$( LC_ALL=C stat -f '%m' "${stampStore%/}/.local/agents/spawned" 2> /dev/null || LC_ALL=C stat -c '%Y' "${stampStore%/}/.local/agents/spawned" 2> /dev/null )"
	return 0
}

## THE RECORDS OF ONE SESSION, kept exact: `AgentsToolsSpawnedSessionRecords <session> own|parent|any` prints the paths of the records whose `session-id:` is the
## session (own), whose `parent-session-id:` is (parent), or either (any), a line each. Six readers of a Wait round and a spawn tick asked this with a `grep` over
## every record (AgentsTools.SpawnSandbox.include). The list is kept in `.local/agents/sessions/<session>/records.kept`, `stamp:<the store's stamp>` on its first
## line (AgentsSpawnedStoreStampInto), and read while the stamp is that one: one `stat` a call, and a walk of the records only after the store changed.
## No TTL takes part. The lines are `<kind><TAB><path>`.
AgentsToolsSpawnedSessionRecords(){ ## session, kind (own|parent|any)
	local sessionId="${1:-}" sessionKind="${2:-any}" sessionRoot="${MMDAPP:-}/.local/agents/spawned" sessionCache sessionStamp="" sessionNow="" sessionKept="" sessionLine sessionList sessionTemp
	case "$sessionId" in ''|-|*/*|.|..|*[[:space:]]*) return 0 ;; esac
	[ -n "${MMDAPP:-}" ] && [ -d "$sessionRoot" ] || return 0
	sessionCache="$MMDAPP/.local/agents/sessions/$sessionId/records.kept"
	AgentsSpawnedStoreStampInto sessionStamp "$MMDAPP"
	case "$sessionStamp" in ''|*[!0123456789]*) sessionStamp="" ;; esac
	{ IFS= read -r sessionKept < "$sessionCache" ; } 2> /dev/null || sessionKept=""
	## A KEPT LIST IS TRUSTED, not re-walked when the store moves: its writer appends a record and removes one, so every record of a session
	## stands in it. The walk is the first read of a session and nothing after it.
	if [ ! -f "$sessionCache" ] || [ -z "$sessionKept" ] ; then
		## The walk's own key: the clock first, then the stamp, so a stamp older than the clock was read in a second already gone.
		sessionNow="$( date +%s )" || sessionNow=""
		AgentsSpawnedStoreStampInto sessionStamp "$MMDAPP"
		case "$sessionStamp:$sessionNow" in *[!0123456789:]*|:*|*:) sessionStamp="" ;; esac
		sessionList="$( LC_ALL=C awk -v want="$sessionId" '
			FNR == 1 { fence = 0 ; own = "" ; parent = "" ; }
			$0 == "---" { fence++ ; if ( fence > 1 ) { if ( own == want ) print "own\t" FILENAME ; else if ( parent == want ) print "parent\t" FILENAME ; nextfile ; } ; next ; }
			fence == 1 && index( $0, "session-id: " ) == 1 && own == "" { own = substr( $0, 13 ) ; }
			fence == 1 && index( $0, "parent-session-id: " ) == 1 && parent == "" { parent = substr( $0, 20 ) ; }
		' "$sessionRoot"/*/*.spawn.md 2> /dev/null )" || sessionList=""
		## Kept only in a session folder that exists: a folder made here for an id that names nothing would be taken for a session.
		if [ -n "$sessionStamp" ] && [ "$sessionStamp" -lt "$sessionNow" ] && [ -d "${sessionCache%/*}" ] && sessionTemp="$( mktemp "$sessionCache.XXXXXX" 2> /dev/null )" ; then
			{ printf 'stamp:%s\n' "$sessionStamp" ; [ -z "$sessionList" ] || printf '%s\n' "$sessionList" ; } > "$sessionTemp" 2> /dev/null \
				&& mv -f "$sessionTemp" "$sessionCache" 2> /dev/null || rm -f "$sessionTemp" 2> /dev/null
		fi
		printf '%s\n' "$sessionList"
	else
		LC_ALL=C sed 1d "$sessionCache" 2> /dev/null
	fi | while IFS= read -r sessionLine ; do
		[ -n "$sessionLine" ] || continue
		case "$sessionKind:${sessionLine%%	*}" in any:*|own:own|parent:parent) printf '%s\n' "${sessionLine#*	}" ;; esac
	done
	return 0
}

## EVERY RUN RECORD OF THE WORKSPACE, into the named array, as the store keeps them: the one walk of spawned/ every reader
## of all the records takes, so no other part names the folders. A reader that hands the array to grep or awk adds
## /dev/null as a last file, so an empty store gives it nothing to read rather than its stdin. No process is started.
AgentsToolsSpawnedAllRecordsInto(){ ## array variable, workspace (default MMDAPP)
	## THE REGISTRY IS THE INDEX, and the list is one string until it is handed over: a `set --` a path, or an eval a path, copies the whole
	## list each time -- 14,343 ms on a rig of 1,857 records, and what the machine swapped on. A path here holds no space or quote (the store's
	## own names are ids), which is what makes the single expansion sound.
	local allName="$1" allWs="${2:-${MMDAPP:-/nonexistent}}" allOne allList="" allRegistry allTracking allSession allSpawn allPath
	case "$allName" in ''|*[!A-Za-z0-9_]*) return 1 ;; esac
	allRegistry="${allWs%/}/.local/agents/spawned-sessions.registry"
	if [ -s "$allRegistry" ] ; then
		## A ROW'S RECORD IS NAMED BY ITS EIGHTH COLUMN, the run's own spawn id. The second column is the session, which names the record of
		## the session's first run alone: read as the record, it points every resumed run at that first record and leaves the run unread.
		while IFS=' ' read -r allTracking allSession _ _ _ _ _ allSpawn allRest ; do
			[ -n "$allTracking" ] || continue
			case "$allTracking" in -*|*[!A-Za-z0-9._-]*) continue ;; esac
			case "$allSpawn" in ''|-) allSpawn="${allSession:-$allTracking}" ;; esac
			case "$allSpawn" in -*|*[!A-Za-z0-9._-]*) continue ;; esac
			allPath="${allWs%/}/.local/agents/spawned/$allTracking/$allSpawn.spawn.md"
			[ -f "$allPath" ] || continue
			allList="$allList $allPath"
		done < "$allRegistry"
	else
		for allOne in "${allWs%/}/.local/agents/spawned"/*/*.spawn.md ; do
			[ -f "$allOne" ] || continue
			allList="$allList $allOne"
		done
	fi
	eval "$allName=( $allList )"
	return 0
}

## THE STARTED RECORDS, read from the index the store's writers keep (`<spawned>/.started-records`), never from a walk of the store: a
## line whose record no longer says `spawn-started` is dropped here. Where no index exists yet, one walk writes it.
AgentsSpawnedStartedRecords(){ ## workspace (default MMDAPP) -- the paths of the started records, a line each
	local startedWs="${1:-${MMDAPP:-/nonexistent}}" startedIndex startedPaths=() startedList="" startedTtl
	startedIndex="${startedWs%/}/.local/agents/spawned/.started-records"
	## THE REGISTRY SAYS WHICH RECORDS STARTED, so a store that keeps one is read as one file: the walk and the grep over every record are
	## the fallback of a store without it.
	if [ -s "${startedWs%/}/.local/agents/spawned-sessions.registry" ] ; then
		MDAT_STARTED_WS="${startedWs%/}" LC_ALL=C awk '
			$6 == "spawn-started" {
				path = ENVIRON["MDAT_STARTED_WS"] "/.local/agents/spawned/" $1 "/" ( $8 == "" ? $1 : $8 ) ".spawn.md"
				print path
			}' "${startedWs%/}/.local/agents/spawned-sessions.registry" 2> /dev/null | while IFS= read -r startedLine ; do
			[ -f "$startedLine" ] || continue
			printf '%s\n' "$startedLine"
		done
		return 0
	fi
	## THE INDEX IS READ FOR AS LONG AS A RECORD CANNOT APPEAR: a start written after it would never be seen, so it is rebuilt on its own TTL.
	startedTtl="${MDAT_STARTED_RECORDS_SECONDS:-30}"
	case "$startedTtl" in ''|*[!0123456789]*) startedTtl=30 ;; esac
	if [ ! -f "$startedIndex" ] || [ "$startedTtl" -eq 0 ] || [ -n "$( find "$startedIndex" -mmin +$(( (startedTtl + 59) / 60 )) 2> /dev/null )" ] ; then
		AgentsToolsSpawnedAllRecordsInto startedPaths "$startedWs" || startedPaths=()
		startedList="$( LC_ALL=C grep -l -x -F 'status: spawn-started' ${startedPaths[@]+"${startedPaths[@]}"} /dev/null 2> /dev/null )" || startedList=""
		[ -z "$startedList" ] || printf '%s\n' "$startedList" > "$startedIndex" 2> /dev/null
	fi
	[ ! -s "$startedIndex" ] || LC_ALL=C awk '
		FNR == 1 { fence = 0 ; }
		$0 == "---" { if ( ++fence > 1 ) nextfile ; next ; }
		fence == 1 && index( $0, "status: " ) == 1 { if ( substr( $0, 9 ) == "spawn-started" ) print FILENAME ; nextfile ; }
	' $( cat "$startedIndex" ) 2> /dev/null || :
	return 0
}

## EVERY RUN RECORD'S HEADERS IN ONE READ OF THEM ALL, `<sandbox><TAB><record name><TAB><last write, epoch><TAB><value>...` a record: the
## values of the keys asked, in order, each the first line of its key in the record's first frontmatter block, empty where it has none.
## One stat and one awk over the records the walk above hands, never a process a record.
AgentsToolsSpawnedRecordRows(){ ## workspace (empty: MMDAPP), key...
	local rowsRecords=()
	AgentsToolsSpawnedAllRecordsInto rowsRecords "${1:-}" || return 1
	shift
	[ ${#rowsRecords[@]} -gt 0 ] || return 0
	{ LC_ALL=C stat -f '%m %N' "${rowsRecords[@]}" 2> /dev/null || LC_ALL=C stat -c '%Y %n' "${rowsRecords[@]}" 2> /dev/null ; printf '=\n' ; } | LC_ALL=C awk -v keys="$*" '
		function flush( ) {
			if ( record == "" ) return
			recordName = record ; sub( /.*\//, "", recordName ) ; sub( /\.spawn\.md$/, "", recordName )
			sandboxName = record ; sub( /\/[^\/]*$/, "", sandboxName ) ; sub( /.*\//, "", sandboxName )
			line = sandboxName "\t" recordName "\t" ( record in writtenAt ? writtenAt[record] : "" )
			for ( at = 1 ; at <= keyCount ; at++ ) line = line "\t" ( at in keyValue ? keyValue[at] : "" )
			print line
			split( "", keyValue ) ; record = ""
		}
		BEGIN { keyCount = split( keys, keyName, " " ) ; }
		! statRead { if ( $0 == "=" ) statRead = 1 ; else { at = index( $0, " " ) ; writtenAt[ substr( $0, at + 1 ) ] = substr( $0, 1, at - 1 ) ; } ; next ; }
		FNR == 1 { flush() ; record = FILENAME ; fence = 0 ; }
		$0 == "---" { if ( ++fence > 1 ) { flush() ; nextfile ; } ; next ; }
		fence != 1 { next ; }
		{ for ( at = 1 ; at <= keyCount ; at++ ) if ( !( at in keyValue ) && index( $0, keyName[at] ": " ) == 1 ) keyValue[at] = substr( $0, length( keyName[at] ) + 3 ) ; }
		END { flush() ; }
	' - "${rowsRecords[@]}"
}

## THE RECORDS OF THE RUNS A SPAWN STARTED, a path each: from the parent's list in
## `.local/agents/children/<parent-spawn-id>`, which the spawn proxy appends to as it spawns and
## the main loop rebuilds from the records and marks complete with `children/.indexed`
## (AgentsTools.ChildrenIndex.include); with no mark, from one grep over every record, as the
## harness does. A line of the list whose record is gone is skipped. Nothing, rc 0, for a parent
## with no list.
AgentsToolsSpawnedChildRecords(){ ## parent spawn id, workspace (default MMDAPP)
	local childParent="${1:-}" childWs="${2:-${MMDAPP:-}}" childLine
	childWs="${childWs%/}"
	case "$childParent" in ''|-|.|..|*/*) return 0 ;; esac
	[ -n "$childWs" ] || return 0
	if [ -f "$childWs/.local/agents/children/.indexed" ] ; then
		[ -f "$childWs/.local/agents/children/$childParent" ] || return 0
		while IFS= read -r childLine ; do
			case "$childLine" in ''|/*|../*|*/../*) continue ;; esac
			[ ! -f "$childWs/.local/agents/spawned/$childLine" ] || printf '%s\n' "$childWs/.local/agents/spawned/$childLine"
		done < "$childWs/.local/agents/children/$childParent"
		return 0
	fi
	LC_ALL=C grep -l -x -F -- "parent-spawn-id: $childParent" "$childWs/.local/agents/spawned"/*/*.spawn.md 2> /dev/null || :
	return 0
}

## THE SPAWNED-SESSIONS REGISTRY AS IT STANDS, its path on stdout: for a reader on a call path, which
## takes the registry (AgentsTools.Registries.include) and never a rebuild of its own. Its mtime is the
## store's stamp it was built against (AgentsToolsRegistrySpawnedSessionsRebuild), so a registry whose
## mtime is not the stamp now, or a store with no stamp, is rebuilt here once, with no housekeeping
## (that is the renders' own 5-minute duty). Nothing, rc 0, where the workspace has no store or the rebuild failed.
AgentsToolsSpawnedRegistryFile(){ ## workspace (default MMDAPP)
	local registryWs="${1:-${MMDAPP:-}}" registryFile registryStamp="" registryOwn
	registryWs="${registryWs%/}"
	[ -n "$registryWs" ] && [ -d "$registryWs/.local/agents/spawned" ] || return 0
	registryFile="$registryWs/.local/agents/spawned-sessions.registry"
	AgentsSpawnedStoreStampInto registryStamp "$registryWs"
	registryOwn="$( LC_ALL=C stat -f '%m' "$registryFile" 2> /dev/null || LC_ALL=C stat -c '%Y' "$registryFile" 2> /dev/null )" || registryOwn=""
	if [ -z "$registryStamp" ] || [ "$registryOwn" != "$registryStamp" ] ; then
		type AgentsToolsRegistrySpawnedSessionsRebuild > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.RegistrySpawnedSessions.include"
		( MMDAPP="$registryWs" AGENTS_REGISTRY_HOUSEKEEPING=1 ; export MMDAPP AGENTS_REGISTRY_HOUSEKEEPING ; AgentsToolsRegistrySpawnedSessionsRebuild ) > /dev/null 2>&1 || return 0
	fi
	[ ! -f "$registryFile" ] || printf '%s\n' "$registryFile"
	return 0
}
