#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsSessionParts.include -- the sessions store's leaf and its builders, for a caller that must not load the store include: a
## client hook on the tool-call path. GENERATED by sh-scripts/AgentsSessionPartsMake.sh, whose text these blocks are; the store
## include holds their one source. Never edit this file: a fix belongs there, and a run of the generator after it.
##

agentsSessionPartsLeaf=".local/agents/sessions"

AgentsSessionPartsStoreDirInto(){ ## variable, workspace
	printf -v "$1" '%s' ""
	case "${2:-}" in ''|/) return 1 ;; esac
	printf -v "$1" '%s/%s' "${2%/}" "$agentsSessionPartsLeaf"
}

AgentsSessionPartsFolderInto(){ ## variable, workspace, session
	local folderStore=""
	printf -v "$1" '%s' ""
	case "${3:-}" in ''|-|.|..|*/*|*[[:space:]]*) return 1 ;; esac
	AgentsSessionPartsStoreDirInto folderStore "${2:-}" || return 1
	printf -v "$1" '%s/%s' "$folderStore" "$3"
}

AgentsSessionPartsPartInto(){ ## variable, workspace, session, part name
	local partFolder=""
	printf -v "$1" '%s' ""
	AgentsSessionPartsFolderInto partFolder "${2:-}" "${3:-}" || return 1
	case "${4:-}" in ''|-|.|..|*/*|*[[:space:]]*) return 1 ;; esac
	printf -v "$1" '%s/%s' "$partFolder" "$4"
}
