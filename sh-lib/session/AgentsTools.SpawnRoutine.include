#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.SpawnRoutine.include -- the routine a spawn brief names: resolving a
## --routine selector to one routine file, reading that file's own executors/maintainers/
## invitees frontmatter, and the contract check a resolved file must pass before those
## values are trusted. Sourced, never run. Functions only. Contract: MAGIC.md, "Routine
## resolution for a spawn brief".
##

type AgentsToolsTeamMemberDirectoryText > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.TeamRegistry.include"

## THE SESSION KINDS: the one list the tooling owns, a row for each, `<kind><TAB><the file of its
## bundled routine>`. A kind is defined by the routine that ships with the tooling and holds its
## rules, its steps and its default settings; a kind nobody ships is a kind nothing can run, so
## the list is closed to bundled routines. A routine names one entry of it in
## `requires-session-kind:`. `ad-hoc` is a start with a handback and no session documents, never
## a routine's kind.
AgentsToolsSpawnRoutineKinds(){
	printf 'coworking\tmagic-team.coworking.routine.md\n'
	printf 'standalone\tmagic-team.standalone.routine.md\n'
}

## The file of a kind's bundled routine. rc 1, and nothing printed, for a word that is no kind.
AgentsToolsSpawnRoutineKindRoutine(){ ## kind
	AgentsToolsSpawnRoutineKinds | LC_ALL=C awk -F'\t' -v kind="$1" '$1 == kind { print $2 ; found = 1 ; exit } END { exit found ? 0 : 1 ; }'
}

## --routine-default's own resolution: the routine of the coworking kind, by the list above. Prints
## its file's own basename on success, the same shape AgentsToolsSpawnRoutineResolve expects as a
## --routine selector. A kind routine the skillset does not hold, or holds more than once, is
## refused by the resolver, naming the file.
AgentsToolsSpawnRoutineDefaultName(){
	local routineDefaultFile
	routineDefaultFile="$( AgentsToolsSpawnRoutineKindRoutine coworking )" || return 1
	AgentsToolsSpawnRoutineResolve "$routineDefaultFile" > /dev/null || return 1
	printf '%s\n' "$routineDefaultFile"
}

## Resolves a --routine selector (a full routine filename or part of one) to exactly one
## *.routine.md file under the skillset root's member folders. Prints that file's own
## absolute path on success. Zero or more than one match is refused, with the candidates
## named for a reader to narrow the selector by.
AgentsToolsSpawnRoutineResolve(){ ## selector
	local routineSelector="$1" routineRoot routineFile routineMatches=() routineMember routineDir
	routineRoot="${MDAT_SKILLSET_ROOT:-$MMDAPP/.local/agents/members}"
	## Every member's folder, a member of another workspace included (AgentsToolsTeamMemberDirectoryText).
	while IFS=$'\t' read -r routineMember routineDir ; do
		[ -n "$routineDir" ] || continue
		for routineFile in "$routineDir"/*.routine.md ; do
			[ -f "$routineFile" ] || continue
			case "${routineFile##*/}" in
				*"$routineSelector"*) routineMatches+=( "$routineFile" ) ;;
			esac
		done
	done <<< "$( AgentsToolsTeamMemberDirectoryText )"
	case "${#routineMatches[@]}" in
		0)
			echo "⛔ ERROR: --routine $routineSelector: matches no routine file under $routineRoot" >&2
			return 1
		;;
		1)
			printf '%s\n' "${routineMatches[0]}"
			return 0
		;;
		*)
			echo "⛔ ERROR: --routine $routineSelector: matches more than one routine file:" >&2
			local routineMatch
			for routineMatch in "${routineMatches[@]}" ; do
				echo "  ${routineMatch##*/}" >&2
			done
			return 1
		;;
	esac
}

## The kind a routine file names: the value of its own `requires-session-kind:`, the one
## mandatory key of a routine. Empty where the file names none. Nothing is guessed from silence.
AgentsToolsSpawnRoutineKindOwn(){ ## routine file path
	local routineKindLine
	routineKindLine="$( LC_ALL=C awk -v headers="requires-session-kind" \
		-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsBoardItemFrontmatterPrintSelected.awk" "$1" )"
	printf '%s\n' "${routineKindLine#requires-session-kind: }"
}

## rc 0 when a routine file is coworking-like: it names the coworking kind. rc 1 otherwise.
## No routine name is hardcoded here.
AgentsToolsSpawnRoutineIsCoworking(){ ## routine file path
	[ "$( AgentsToolsSpawnRoutineKindOwn "$1" )" = "coworking" ]
}

## The routine a routine file inherits from: the bundled routine of the kind it names, found as
## any routine is (AgentsToolsSpawnRoutineResolve). Its path; nothing for a file that names no
## kind of the list, for a kind routine itself (it inherits from nobody), and for a kind routine
## the skillset does not hold. One level, never a chain: no routine names another as its parent.
AgentsToolsSpawnRoutineKindPath(){ ## routine file path
	local kindFile
	kindFile="$( AgentsToolsSpawnRoutineKindRoutine "$( AgentsToolsSpawnRoutineKindOwn "$1" )" )" || return 0
	[ "${1##*/}" != "$kindFile" ] || return 0
	AgentsToolsSpawnRoutineResolve "$kindFile" 2> /dev/null || :
}

## THE MIX-IN: a routine file's text with the routine of its kind mixed in, by the tooling, so no
## agent has to perform the ordering. Opening steps: the kind routine's, then the routine's own.
## Steps: the routine's own. Closure steps: the routine's own, then the kind routine's. Its local
## rules and its tooling block are the kind routine's too, the routine's own after them. A step
## the routine lists in `skips-inherited:` is left out of what the kind routine contributes, and
## a mix-in never re-adds it. A routine that names no kind routine is printed as it is.
AgentsToolsSpawnRoutineMixText(){ ## routine file path
	local mixKindPath mixSkips
	mixKindPath="$( AgentsToolsSpawnRoutineKindPath "$1" )"
	if [ -z "$mixKindPath" ] ; then
		cat "$1"
		return 0
	fi
	mixSkips="$( LC_ALL=C awk -v headers="skips-inherited" \
		-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsBoardItemFrontmatterPrintSelected.awk" "$1" )"
	mixSkips="${mixSkips#skips-inherited: }"
	ROUTINE_SKIPS="$mixSkips" LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsRoutineMix.awk" "$mixKindPath" "$1"
}

## Reads executors/maintainers/invitees out of a routine file's own frontmatter, through
## AgentsBoardItemFrontmatterPrintSelected.awk, unchanged. One "key: value" line per key,
## in that fixed order; an absent or empty value reads as an empty string after the colon.
## With a kind routine's path (AgentsToolsSpawnRoutineKindPath) a key the file does not set
## takes the value that routine sets: its default settings are inherited.
AgentsToolsSpawnRoutineFrontmatter(){ ## routine file path, [kind routine path]
	local frontmatterOwn frontmatterKind=""
	frontmatterOwn="$( LC_ALL=C awk -v headers="executors"$'\034'"maintainers"$'\034'"invitees" \
		-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsBoardItemFrontmatterPrintSelected.awk" "$1" )"
	[ -z "${2:-}" ] || frontmatterKind="$( LC_ALL=C awk -v headers="executors"$'\034'"maintainers"$'\034'"invitees" \
		-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsBoardItemFrontmatterPrintSelected.awk" "$2" )"
	## The kind routine's lines travel through the environment, not -v, which would not take a newline.
	printf '%s\n' "$frontmatterOwn" | FRONTMATTER_KIND="$frontmatterKind" LC_ALL=C awk '
		BEGIN { kindCount = split( ENVIRON["FRONTMATTER_KIND"], kindLines, "\n" ) ; }
		{
			valueAt = index( $0, ": " ) ; key = substr( $0, 1, valueAt - 1 ) ; value = substr( $0, valueAt + 2 ) ;
			if ( value == "" && NR <= kindCount ) { value = substr( kindLines[NR], index( kindLines[NR], ": " ) + 2 ) ; }
			printf "%s: %s\n", key, value ;
		}'
}

## The contract a resolved routine file must satisfy before its brief slots are trusted:
## opens with a frontmatter block, names a session kind of the list, and executors/maintainers
## are both non-empty (a kind routine's defaults counted). Prints
## three lines on success -- executors, maintainers, invitees -- with invitees reading the
## literal "none" where that field is absent or empty. Prints nothing and returns 1 on
## failure, with the reason on stderr.
AgentsToolsSpawnRoutineContractCheck(){ ## routine file path
	local routineFile="$1" routineFirstLine=""
	IFS= read -r routineFirstLine < "$routineFile" 2>/dev/null || :
	if [ "$routineFirstLine" != "---" ] ; then
		echo "⛔ ERROR: $routineFile: does not open with a frontmatter block" >&2
		return 1
	fi
	local routineKind
	routineKind="$( AgentsToolsSpawnRoutineKindOwn "$routineFile" )"
	if ! AgentsToolsSpawnRoutineKindRoutine "$routineKind" > /dev/null ; then
		echo "⛔ ERROR: $routineFile: requires-session-kind: ${routineKind:-<absent>} is not a session kind of the tooling (coworking or standalone); the key is mandatory and a routine is never started without it" >&2
		return 1
	fi
	local routineFm routineExecutorsLine routineMaintainersLine routineInviteesLine
	routineFm="$( AgentsToolsSpawnRoutineFrontmatter "$routineFile" "$( AgentsToolsSpawnRoutineKindPath "$routineFile" )" )"
	{
		IFS= read -r routineExecutorsLine
		IFS= read -r routineMaintainersLine
		IFS= read -r routineInviteesLine
	} <<< "$routineFm"
	local routineExecutors="${routineExecutorsLine#executors: }"
	local routineMaintainers="${routineMaintainersLine#maintainers: }"
	local routineInvitees="${routineInviteesLine#invitees: }"
	if [ -z "$routineExecutors" ] || [ -z "$routineMaintainers" ] ; then
		echo "⛔ ERROR: $routineFile: executors and maintainers must both be non-empty" >&2
		return 1
	fi
	printf 'executors: %s\n' "$routineExecutors"
	printf 'maintainers: %s\n' "$routineMaintainers"
	printf 'invitees: %s\n' "${routineInvitees:-none}"
	return 0
}

## Pulls the executors/invitees values back out of AgentsToolsSpawnRoutineContractCheck's
## own fixed-order 3-line output -- executors, maintainers, invitees -- by plain parameter
## expansion, the same "read into fixed positions, strip the key: prefix" shape
## AgentsToolsSpawnRoutineContractCheck itself uses on the frontmatter just above, never a
## forked printf/awk pipeline. Both call sites that need these two values share this one
## function instead of each re-deriving the extraction. Prints two lines on success:
## executors then invitees.
AgentsToolsSpawnRoutineContractExecutorsInvitees(){ ## contract-check output (its 3 lines)
	local routineContractOut="$1"
	local ceExecutorsLine ceMaintainersLine ceInviteesLine
	{
		IFS= read -r ceExecutorsLine
		IFS= read -r ceMaintainersLine
		IFS= read -r ceInviteesLine
	} <<< "$routineContractOut"
	printf '%s\n' "${ceExecutorsLine#executors: }"
	printf '%s\n' "${ceInviteesLine#invitees: }"
}

## The roster a routine's own executors value names, for a start with no member named: one
## member on a line, where the value is a plain comma-separated list of existing members,
## each name trimmed. Anything else names no spawnable roster: rc 1, and one line that says
## why -- `any-member` for an empty value and for the "any member" shorthand (`magic-team`,
## `*`, per magic-team/reference/skill-folder-model.md), `empty-name` for a list with an empty place, and
## `no-member<TAB><name>` for the first name no workspace of this machine holds a member of
## (AgentsToolsTeamMemberDirectory), prose among them. THE ONE RULE of what a routine starts
## by itself: --magic-spawn-session starts by it, and --manager-routine-list prints it.
AgentsToolsSpawnRoutineExecutorsRoster(){ ## executors value
	local rosterValue rosterList rosterName rosterNames=""
	rosterValue="$( printf '%s' "$1" | LC_ALL=C awk '{ gsub(/^[ \t]+|[ \t]+$/, "") ; print ; }' )"
	case "$rosterValue" in
		''|'*'|'magic-team')
			printf 'any-member\n'
			return 1
		;;
	esac
	IFS=',' read -r -a rosterList <<< "$rosterValue"
	for rosterName in "${rosterList[@]}" ; do
		rosterName="${rosterName#"${rosterName%%[![:space:]]*}"}"
		rosterName="${rosterName%"${rosterName##*[![:space:]]}"}"
		if [ -z "$rosterName" ] ; then
			printf 'empty-name\n'
			return 1
		fi
		if ! AgentsToolsTeamMemberDirectory "$rosterName" > /dev/null ; then
			printf 'no-member\t%s\n' "$rosterName"
			return 1
		fi
		rosterNames="$rosterNames$rosterName"$'\n'
	done
	printf '%s' "$rosterNames"
	return 0
}
