#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.SpawnRoutine.include -- the routine a spawn brief names: resolving a
## --routine selector to one routine file, reading that file's own executors/maintainers/
## invitees frontmatter, and the contract check a resolved file must pass before those
## values are trusted. Sourced, never run. Functions only. Contract: MAGIC.md, "Routine
## resolution for a spawn brief".
##

type AgentsToolsTeamMemberDirectoryText > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.TeamRegistry.include"

## THE SESSION KINDS: the one list the tooling owns, a row for each, `<kind><TAB><the file of its
## bundled routine>`. A kind is defined by the routine that ships with the tooling and holds its
## rules, its steps and its default settings; a kind nobody ships is a kind nothing can run, so
## the list is closed to bundled routines. A routine names one entry of it in
## `requires-session-kind:`. `ad-hoc` is a start with a handback and no session documents, never
## a routine's kind.
AgentsToolsSpawnRoutineKinds(){
	printf 'coworking\tmagic-team.coworking.routine.md\n'
	printf 'standalone\tmagic-team.standalone.routine.md\n'
}

## The file of a kind's bundled routine. rc 1, and nothing printed, for a word that is no kind.
AgentsToolsSpawnRoutineKindRoutine(){ ## kind
	AgentsToolsSpawnRoutineKinds | LC_ALL=C awk -F'\t' -v kind="$1" '$1 == kind { print $2 ; found = 1 ; exit } END { exit found ? 0 : 1 ; }'
}

## --routine-default's own resolution: the routine of the coworking kind, by the list above. Prints
## its file's own basename on success, the same shape AgentsToolsSpawnRoutineResolve expects as a
## --routine selector. A kind routine the skillset does not hold, or holds more than once, is
## refused by the resolver, naming the file.
AgentsToolsSpawnRoutineDefaultName(){
	local routineDefaultFile
	routineDefaultFile="$( AgentsToolsSpawnRoutineKindRoutine coworking )" || return 1
	AgentsToolsSpawnRoutineResolve "$routineDefaultFile" > /dev/null || return 1
	printf '%s\n' "$routineDefaultFile"
}

## Resolves a --routine selector (a full routine filename or part of one) to exactly one
## *.routine.md file under the skillset root's member folders. Prints that file's own
## absolute path on success. Zero or more than one match is refused, with the candidates
## named for a reader to narrow the selector by.
AgentsToolsSpawnRoutineResolve(){ ## selector
	local routineSelector="$1" routineRoot routineFile routineMatches=() routineMember routineDir
	routineRoot="${MDAT_SKILLSET_ROOT:-$MMDAPP/.local/agents/members}"
	## Every member's folder, a member of another workspace included (AgentsToolsTeamMemberDirectoryText).
	while IFS=$'\t' read -r routineMember routineDir ; do
		[ -n "$routineDir" ] || continue
		for routineFile in "$routineDir"/*.routine.md ; do
			[ -f "$routineFile" ] || continue
			case "${routineFile##*/}" in
				*"$routineSelector"*) routineMatches+=( "$routineFile" ) ;;
			esac
		done
	done <<< "$( AgentsToolsTeamMemberDirectoryText )"
	case "${#routineMatches[@]}" in
		0)
			echo "⛔ ERROR: --routine $routineSelector: matches no routine file under $routineRoot" >&2
			return 1
		;;
		1)
			printf '%s\n' "${routineMatches[0]}"
			return 0
		;;
		*)
			echo "⛔ ERROR: --routine $routineSelector: matches more than one routine file:" >&2
			local routineMatch
			for routineMatch in "${routineMatches[@]}" ; do
				echo "  ${routineMatch##*/}" >&2
			done
			return 1
		;;
	esac
}

## The kind a routine file names: the value of its own `requires-session-kind:`, the one
## mandatory key of a routine. Empty where the file names none. Nothing is guessed from silence.
AgentsToolsSpawnRoutineKindOwn(){ ## routine file path
	local routineKindLine
	routineKindLine="$( LC_ALL=C awk -v headers="requires-session-kind" \
		-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsBoardItemFrontmatterPrintSelected.awk" "$1" )"
	printf '%s\n' "${routineKindLine#requires-session-kind: }"
}

## rc 0 when a routine file is coworking-like: it names the coworking kind. rc 1 otherwise.
## No routine name is hardcoded here.
AgentsToolsSpawnRoutineIsCoworking(){ ## routine file path
	[ "$( AgentsToolsSpawnRoutineKindOwn "$1" )" = "coworking" ]
}

## The routine a routine file inherits from: the bundled routine of the kind it names, found as
## any routine is (AgentsToolsSpawnRoutineResolve). Its path; nothing for a file that names no
## kind of the list, for a kind routine itself (it inherits from nobody), and for a kind routine
## the skillset does not hold. One level, never a chain: no routine names another as its parent.
AgentsToolsSpawnRoutineKindPath(){ ## routine file path
	local kindFile
	kindFile="$( AgentsToolsSpawnRoutineKindRoutine "$( AgentsToolsSpawnRoutineKindOwn "$1" )" )" || return 0
	[ "${1##*/}" != "$kindFile" ] || return 0
	AgentsToolsSpawnRoutineResolve "$kindFile" 2> /dev/null || :
}

## THE MIX-IN: a routine file's text with the routine of its kind mixed in, by the tooling, so no
## agent has to perform the ordering. Opening steps: the kind routine's, then the routine's own.
## Steps: the routine's own. Closure steps: the routine's own, then the kind routine's. Its local
## rules and its tooling block are the kind routine's too, the routine's own after them. A step
## the routine lists in `skips-inherited:` is left out of what the kind routine contributes, and
## a mix-in never re-adds it. A routine that names no kind routine is printed as it is.
## The text is the merged document of the one nesting engine (--intern-merge-md-files): see
## AgentsToolsSpawnRoutineMixSections. The same inputs give the same bytes.
AgentsToolsSpawnRoutineMixText(){ ## routine file path
	local mixKindPath mixSkips
	mixKindPath="$( AgentsToolsSpawnRoutineKindPath "$1" )"
	if [ -z "$mixKindPath" ] ; then
		cat "$1"
		return 0
	fi
	mixSkips="$( LC_ALL=C awk -v headers="skips-inherited" \
		-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsBoardItemFrontmatterPrintSelected.awk" "$1" )"
	mixSkips="${mixSkips#skips-inherited: }"
	AgentsToolsSpawnRoutineMixSections "$mixKindPath" "$1" "$mixSkips" notes
}

## The routines whose sections a routine takes in whole, from its `includes:` lines (one a line: `<routine file name>: <section>, <section>`): one
## `<routine file name><TAB><section>` row for each section named. The sections that can be taken are the Steps, the local procedures, the
## local rules and the tooling block. Nothing is copied: the text is the included routine's own, mixed in where the routine is read (--get-routine-text, the brief,
## the cached prefix).
AgentsToolsSpawnRoutineIncludes(){ ## routine file path
	LC_ALL=C awk '
		FNR == 1 { fm = ( $0 == "---" ) ; next }
		fm && $0 == "---" { exit }
		fm && index( $0, "includes: " ) == 1 {
			line = substr( $0, 11 ) ; colon = index( line, ": " )
			if ( colon == 0 ) next
			name = substr( line, 1, colon - 1 ) ; rest = substr( line, colon + 2 )
			n = split( rest, parts, "," )
			for ( i = 1 ; i <= n ; i++ ) { sub( /^[ \t]+/, "", parts[i] ) ; sub( /[ \t]+$/, "", parts[i] ) ; if ( parts[i] != "" ) print name "\t" parts[i] }
		}
	' "$1" 2> /dev/null
}

## The files of the routines a routine includes, resolved, one a line (for the checksum of what a cached text was made of).
AgentsToolsSpawnRoutineIncludePaths(){ ## routine file path
	local pathsName pathsSection pathsFile
	while IFS=$'\t' read -r pathsName pathsSection ; do
		[ -n "$pathsName" ] || continue
		pathsFile="$( AgentsToolsSpawnRoutineResolve "$pathsName" 2> /dev/null )" || continue
		printf '%s\n' "$pathsFile"
	done <<< "$( AgentsToolsSpawnRoutineIncludes "$1" | LC_ALL=C awk -F'\t' '!seen[$1]++' )"
}

## One section name of the included routines, added to the caller's mixArgs after the routine's own: AgentsToolsSpawnRoutineMixAdd for each include.
AgentsToolsSpawnRoutineMixIncluded(){ ## routine file path, section
	local incName incSection incFile
	while IFS=$'\t' read -r incName incSection ; do
		[ "$incSection" = "$2" ] || continue
		incFile="$( AgentsToolsSpawnRoutineResolve "$incName" 2> /dev/null )" || continue
		AgentsToolsSpawnRoutineMixAdd "$incFile" "$2"
	done <<< "$( AgentsToolsSpawnRoutineIncludes "$1" )"
}

## One section of a file as a mixin, if the file has it: `--mixin [filters] <file> "<section> of <file stem>"`, added to the caller's mixArgs. The filters
## (--section-exclude <step>) follow the section the mixin includes.
AgentsToolsSpawnRoutineMixAdd(){ ## file, section, filter words...
	local addFile="$1" addSection="$2" addStem
	shift 2
	LC_ALL=C grep -q -x -F -- "# $addSection" "$addFile" || return 0
	addStem="${addFile##*/}" ; addStem="${addStem%.md}"
	mixArgs+=( --mixin --section-include "$addSection" "$@" "$addFile" "$addSection of $addStem" )
}

## The routine's text from its sections and those of its kind routine, merged by --intern-merge-md-files, one mixin for each file and section, in the order of
## the F5.6 mix-in: the routine's Summary; the kind's Opening steps, then its own; its own Steps; its own Closure steps, then the kind's; its local
## procedures; the kind's local rules, then its own; the kind's tooling block, then its own; its Maintainer Notes (notes, not no-notes). A step of the
## kind routine is a section under its Opening steps or Closure steps, named as the step, so a step the routine skips is a `--section-exclude` of that
## name on the kind's mixin. The engine's form: each mixin is a section named for its section and file, and the front matter is not carried.
AgentsToolsSpawnRoutineMixSections(){ ## kind routine file, routine file, skips-inherited value, notes|no-notes
	local mixKind="$1" mixOwn="$2" mixSkipText="$3" mixNotes="$4" mixArgs=() mixSkipArgs=() mixSkip
	while IFS= read -r mixSkip ; do
		mixSkip="${mixSkip#"${mixSkip%%[![:space:]]*}"}" ; mixSkip="${mixSkip%"${mixSkip##*[![:space:]]}"}"
		[ -z "$mixSkip" ] || mixSkipArgs+=( --section-exclude "$mixSkip" )
	done <<< "$( printf '%s' "$mixSkipText" | LC_ALL=C tr ',' '\n' )"
	AgentsToolsSpawnRoutineMixAdd "$mixOwn" "Summary"
	AgentsToolsSpawnRoutineMixAdd "$mixKind" "Opening steps" ${mixSkipArgs[@]+"${mixSkipArgs[@]}"}
	AgentsToolsSpawnRoutineMixAdd "$mixOwn" "Opening steps"
	AgentsToolsSpawnRoutineMixAdd "$mixOwn" "Steps"
	AgentsToolsSpawnRoutineMixIncluded "$mixOwn" "Steps"
	AgentsToolsSpawnRoutineMixAdd "$mixOwn" "Closure steps"
	AgentsToolsSpawnRoutineMixAdd "$mixKind" "Closure steps" ${mixSkipArgs[@]+"${mixSkipArgs[@]}"}
	AgentsToolsSpawnRoutineMixAdd "$mixOwn" "Routine's local procedures"
	AgentsToolsSpawnRoutineMixIncluded "$mixOwn" "Routine's local procedures"
	AgentsToolsSpawnRoutineMixAdd "$mixKind" "Routine's local rules"
	AgentsToolsSpawnRoutineMixAdd "$mixOwn" "Routine's local rules"
	AgentsToolsSpawnRoutineMixIncluded "$mixOwn" "Routine's local rules"
	AgentsToolsSpawnRoutineMixAdd "$mixKind" "Routine-specific tooling"
	AgentsToolsSpawnRoutineMixAdd "$mixOwn" "Routine-specific tooling"
	AgentsToolsSpawnRoutineMixIncluded "$mixOwn" "Routine-specific tooling"
	[ "$mixNotes" != notes ] || AgentsToolsSpawnRoutineMixAdd "$mixOwn" "Maintainer Notes"
	type AgentsToolsMergeMdFiles > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsTools.InternMergeMdFiles.include"
	AgentsToolsMergeMdFiles --section-limit 6 ${mixArgs[@]+"${mixArgs[@]}"}
}

## Reads executors/maintainers/invitees out of a routine file's own frontmatter, through
## AgentsBoardItemFrontmatterPrintSelected.awk, unchanged. One "key: value" line per key,
## in that fixed order; an absent or empty value reads as an empty string after the colon.
## With a kind routine's path (AgentsToolsSpawnRoutineKindPath) a key the file does not set
## takes the value that routine sets: its default settings are inherited.
AgentsToolsSpawnRoutineFrontmatter(){ ## routine file path, [kind routine path]
	local frontmatterOwn frontmatterKind=""
	frontmatterOwn="$( LC_ALL=C awk -v headers="executors"$'\034'"maintainers"$'\034'"invitees" \
		-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsBoardItemFrontmatterPrintSelected.awk" "$1" )"
	[ -z "${2:-}" ] || frontmatterKind="$( LC_ALL=C awk -v headers="executors"$'\034'"maintainers"$'\034'"invitees" \
		-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsBoardItemFrontmatterPrintSelected.awk" "$2" )"
	## The kind routine's lines travel through the environment, not -v, which would not take a newline.
	printf '%s\n' "$frontmatterOwn" | FRONTMATTER_KIND="$frontmatterKind" LC_ALL=C awk '
		BEGIN { kindCount = split( ENVIRON["FRONTMATTER_KIND"], kindLines, "\n" ) ; }
		{
			valueAt = index( $0, ": " ) ; key = substr( $0, 1, valueAt - 1 ) ; value = substr( $0, valueAt + 2 ) ;
			if ( value == "" && NR <= kindCount ) { value = substr( kindLines[NR], index( kindLines[NR], ": " ) + 2 ) ; }
			printf "%s: %s\n", key, value ;
		}'
}

## The contract a resolved routine file must satisfy before its brief slots are trusted:
## opens with a frontmatter block, names a session kind of the list, and executors/maintainers
## are both non-empty (a kind routine's defaults counted). Prints
## three lines on success -- executors, maintainers, invitees -- with invitees reading the
## literal "none" where that field is absent or empty. Prints nothing and returns 1 on
## failure, with the reason on stderr.
AgentsToolsSpawnRoutineContractCheck(){ ## routine file path
	local routineFile="$1" routineFirstLine=""
	IFS= read -r routineFirstLine < "$routineFile" 2>/dev/null || :
	if [ "$routineFirstLine" != "---" ] ; then
		echo "⛔ ERROR: $routineFile: does not open with a frontmatter block" >&2
		return 1
	fi
	local routineKind
	routineKind="$( AgentsToolsSpawnRoutineKindOwn "$routineFile" )"
	if ! AgentsToolsSpawnRoutineKindRoutine "$routineKind" > /dev/null ; then
		echo "⛔ ERROR: $routineFile: requires-session-kind: ${routineKind:-<absent>} is not a session kind of the tooling (coworking or standalone); the key is mandatory and a routine is never started without it" >&2
		return 1
	fi
	local routineFm routineExecutorsLine routineMaintainersLine routineInviteesLine
	routineFm="$( AgentsToolsSpawnRoutineFrontmatter "$routineFile" "$( AgentsToolsSpawnRoutineKindPath "$routineFile" )" )"
	{
		IFS= read -r routineExecutorsLine
		IFS= read -r routineMaintainersLine
		IFS= read -r routineInviteesLine
	} <<< "$routineFm"
	local routineExecutors="${routineExecutorsLine#executors: }"
	local routineMaintainers="${routineMaintainersLine#maintainers: }"
	local routineInvitees="${routineInviteesLine#invitees: }"
	if [ -z "$routineExecutors" ] || [ -z "$routineMaintainers" ] ; then
		echo "⛔ ERROR: $routineFile: executors and maintainers must both be non-empty" >&2
		return 1
	fi
	printf 'executors: %s\n' "$routineExecutors"
	printf 'maintainers: %s\n' "$routineMaintainers"
	printf 'invitees: %s\n' "${routineInvitees:-none}"
	return 0
}

## Pulls the executors/invitees values back out of AgentsToolsSpawnRoutineContractCheck's
## own fixed-order 3-line output -- executors, maintainers, invitees -- by plain parameter
## expansion, the same "read into fixed positions, strip the key: prefix" shape
## AgentsToolsSpawnRoutineContractCheck itself uses on the frontmatter just above, never a
## forked printf/awk pipeline. Both call sites that need these two values share this one
## function instead of each re-deriving the extraction. Prints two lines on success:
## executors then invitees.
AgentsToolsSpawnRoutineContractExecutorsInvitees(){ ## contract-check output (its 3 lines)
	local routineContractOut="$1"
	local ceExecutorsLine ceMaintainersLine ceInviteesLine
	{
		IFS= read -r ceExecutorsLine
		IFS= read -r ceMaintainersLine
		IFS= read -r ceInviteesLine
	} <<< "$routineContractOut"
	printf '%s\n' "${ceExecutorsLine#executors: }"
	printf '%s\n' "${ceInviteesLine#invitees: }"
}

## The members a `<type>-*` or `<type>-?` token names: every member of the team whose name
## begins with `<type>-`, the team itself (magic-team) excepted -- it is no member of a roster.
## One a line, in the directory order of AgentsToolsTeamMemberDirectoryText, across every
## workspace of the machine. Nothing for a type no member carries. `<type>` is the member prefix
## group (client, partner, keeper, warden, magic, oncall, expert, human), the same rule
## AgentsToolsTeamMemberKindIcon groups by.
AgentsToolsSpawnRoutineTypeMembers(){ ## the `<type>-*`/`<type>-?` token
	local typePrefix="${1%%-*}"
	AgentsToolsTeamMemberDirectoryText | LC_ALL=C awk -F'\t' -v prefix="$typePrefix-" \
		'$1 != "magic-team" && index( $1, prefix ) == 1 { print $1 }'
}

## Whether a member is among `all-present-members`: a default work-duty doer, and one who
## attends retro and daily not by special invitation. Its own `.basic.md` says so in its
## `attendance:` frontmatter (`present`|`invited`); where it says nothing, the standing rule is
## that every `magic-*` member is present and every other member attends by invitation only.
## rc 0 present, rc 1 invited. The team itself is never a member of the roster.
AgentsToolsTeamMemberPresent(){ ## member
	case "$1" in ''|magic-team) return 1 ;; esac
	local presentDir presentValue=""
	if presentDir="$( AgentsToolsTeamMemberDirectory "$1" )" ; then
		presentValue="$( LC_ALL=C awk -v headers="attendance" \
			-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsBoardItemFrontmatterPrintSelected.awk" "$presentDir/$1.basic.md" 2> /dev/null )"
		presentValue="${presentValue#attendance: }"
		presentValue="$( printf '%s' "$presentValue" | LC_ALL=C awk '{ gsub(/^[ \t]+|[ \t]+$/, "") ; print ; }' )"
	fi
	case "$presentValue" in present) return 0 ;; invited) return 1 ;; esac
	case "$1" in magic-*) return 0 ;; *) return 1 ;; esac
}

## The members `all-present-members` names, one a line, in directory order.
AgentsToolsSpawnRoutinePresentMembers(){
	while IFS=$'\t' read -r presentName presentDir ; do
		[ -n "$presentDir" ] || continue
		AgentsToolsTeamMemberPresent "$presentName" && printf '%s\n' "$presentName"
	done <<< "$( AgentsToolsTeamMemberDirectoryText )"
	return 0
}

## One roster entry expanded to the members it names, one a line. `<type>-*` names all members of
## that type (rc 1, reason `none-of-type<TAB><type>`, where it names none -- fail on NONE);
## `<type>-?` names a choice, not a roster, THE ONE RULE of the caller's and the routine's side alike:
## never made by the tooling, even where exactly one member is available (rc 1, reason
## `choice-required<TAB><type>` and then the candidate members, one a line, as the hint); any other
## entry names the one member it is (rc 1, reason `no-member<TAB><name>`, where no workspace holds it).
AgentsToolsSpawnRoutineEntryMembers(){ ## entry
	local entryName="$1" entryMembers=""
	case "$entryName" in
		*-\*)
			entryMembers="$( AgentsToolsSpawnRoutineTypeMembers "$entryName" )"
			[ -n "$entryMembers" ] || { printf 'none-of-type\t%s\n' "${entryName%??}" ; return 1 ; }
			;;
		*-\?)
			entryMembers="$( AgentsToolsSpawnRoutineTypeMembers "$entryName" )"
			[ -n "$entryMembers" ] || { printf 'none-of-type\t%s\n' "${entryName%??}" ; return 1 ; }
			printf 'choice-required\t%s\n%s\n' "${entryName%??}" "$entryMembers" ; return 1
			;;
		*)
			AgentsToolsTeamMemberDirectory "$entryName" > /dev/null || { printf 'no-member\t%s\n' "$entryName" ; return 1 ; }
			entryMembers="$entryName"
			;;
	esac
	printf '%s\n' "$entryMembers"
	return 0
}

## The registered member whose name is nearest to a word (the least edits, the first in directory order on a tie): printed, rc 0; nothing, rc 1, where no
## member is registered. For a refusal that names a word no member answers to.
AgentsToolsSpawnRoutineNearestMember(){ ## word
	AgentsToolsTeamMemberDirectoryText | LC_ALL=C awk -F'\t' -v word="$1" '
		function edits( a, b,    la, lb, i, j, cost, prev, cur ) {
			la = length( a ) ; lb = length( b )
			for ( j = 0 ; j <= lb ; j++ ) prev[j] = j
			for ( i = 1 ; i <= la ; i++ ) {
				cur[0] = i
				for ( j = 1 ; j <= lb ; j++ ) {
					cost = ( substr( a, i, 1 ) == substr( b, j, 1 ) ) ? 0 : 1
					cur[j] = prev[j] + 1
					if ( cur[j - 1] + 1 < cur[j] ) cur[j] = cur[j - 1] + 1
					if ( prev[j - 1] + cost < cur[j] ) cur[j] = prev[j - 1] + cost
				}
				for ( j = 0 ; j <= lb ; j++ ) prev[j] = cur[j]
			}
			return prev[lb]
		}
		$1 != "" { d = edits( word, $1 ) ; if ( best == "" || d < bestD ) { best = $1 ; bestD = d } }
		END { if ( best == "" ) exit 1 ; print best }'
}

## The roster a routine's own executors value names, for a start with no member named: one
## member on a line, where the value is a comma-separated list of existing members, each name
## trimmed, with `<type>-*` expanded to all members of that type (fail on NONE). Anything else
## names no spawnable roster: rc 1, and one line that says why -- `any-member` for an empty value
## and for the "any member" shorthand (`magic-team`, `*`, per
## magic-team/reference/skill-folder-model.md), `empty-name` for a list with an empty place,
## `no-member<TAB><name>` for the first name no workspace of this machine holds a member of
## (AgentsToolsTeamMemberDirectory), `none-of-type<TAB><type>` for a `<type>-*` that names none,
## `choice-required<TAB><type>` and the candidates, one a line, for a `<type>-?` (a choice, never made here), and
## `all-present-members` for the participants-only keyword that names the present members. THE ONE RULE of
## what a routine starts by itself: --spawn-session starts by it, and --manager-routine-list prints it.
AgentsToolsSpawnRoutineExecutorsRoster(){ ## executors value
	local rosterValue rosterList rosterName rosterNames="" rosterEntry rosterOut=""
	rosterValue="$( printf '%s' "$1" | LC_ALL=C awk '{ gsub(/^[ \t]+|[ \t]+$/, "") ; print ; }' )"
	case "$rosterValue" in
		''|'*'|'magic-team')
			printf 'any-member\n'
			return 1
		;;
	esac
	IFS=',' read -r -a rosterList <<< "$rosterValue"
	for rosterName in "${rosterList[@]}" ; do
		rosterName="${rosterName#"${rosterName%%[![:space:]]*}"}"
		rosterName="${rosterName%"${rosterName##*[![:space:]]}"}"
		if [ -z "$rosterName" ] ; then
			printf 'empty-name\n'
			return 1
		fi
		if [ "$rosterName" = "all-present-members" ] ; then
			printf 'all-present-members\n'
			return 1
		fi
		rosterOut="$( AgentsToolsSpawnRoutineEntryMembers "$rosterName" )" || { printf '%s\n' "$rosterOut" ; return 1 ; }
		while IFS= read -r rosterEntry ; do
			[ -z "$rosterEntry" ] || rosterNames="$rosterNames$rosterEntry"$'\n'
		done <<< "$rosterOut"
	done
	printf '%s' "$rosterNames"
	return 0
}

## The roster a routine's own invitees (its participants) value names, the same expansion the
## executors roster makes, plus the `all-present-members` keyword: every member
## AgentsToolsTeamMemberPresent holds (rc 1, reason `none-present`, where none is). `none`, the
## word a routine writes for "no invitees", and an empty value both name no roster and are no
## fault. Otherwise the reasons are the executors roster's own.
AgentsToolsSpawnRoutineInviteesRoster(){ ## invitees value
	local rosterValue rosterList rosterName rosterNames="" rosterEntry rosterOut=""
	rosterValue="$( printf '%s' "$1" | LC_ALL=C awk '{ gsub(/^[ \t]+|[ \t]+$/, "") ; print ; }' )"
	case "$rosterValue" in ''|none) return 0 ;; esac
	case "$rosterValue" in '*'|'magic-team') printf 'any-member\n' ; return 1 ;; esac
	IFS=',' read -r -a rosterList <<< "$rosterValue"
	for rosterName in "${rosterList[@]}" ; do
		rosterName="${rosterName#"${rosterName%%[![:space:]]*}"}"
		rosterName="${rosterName%"${rosterName##*[![:space:]]}"}"
		if [ -z "$rosterName" ] ; then
			printf 'empty-name\n'
			return 1
		fi
		if [ "$rosterName" = "all-present-members" ] ; then
			rosterOut="$( AgentsToolsSpawnRoutinePresentMembers )"
			[ -n "$rosterOut" ] || { printf 'none-present\n' ; return 1 ; }
		else
			rosterOut="$( AgentsToolsSpawnRoutineEntryMembers "$rosterName" )" || { printf '%s\n' "$rosterOut" ; return 1 ; }
		fi
		while IFS= read -r rosterEntry ; do
			[ -z "$rosterEntry" ] || rosterNames="$rosterNames$rosterEntry"$'\n'
		done <<< "$rosterOut"
	done
	printf '%s' "$rosterNames"
	return 0
}
