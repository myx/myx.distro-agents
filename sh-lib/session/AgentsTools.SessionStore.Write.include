#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.SessionStore.Write.include -- the writes of the session and spawn stores, split from AgentsTools.SessionStore.include: a
## Wait reads those stores and never writes one, so it parses the readers alone; the spawns and the close paths, which write, ask here.
##

type AgentsSessionThread > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.include"
type AgentsToolsTempClaim > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/common/AgentsTools.TempFiles.include"

AgentsSessionThreadSet(){ ## session, channel:ts
	local setHere
	printf -v setHere '%s/%s/%s' "${MMDAPP%/}" "$agentsSessionStoreLeaf" "$1"
	mkdir -p "$setHere" && printf '%s\n' "$2" > "$setHere/session.thread"
}

AgentsSessionCloseRun(){ ## session, run (`-`: the session itself), who, when
	local closeFile closeRun="${2:-}"
	case "$closeRun" in ''|-) closeRun="$1" ;; esac
	AgentsSessionRunClosed "$1" "$closeRun" && return 0
	AgentsSessionMarkerFileInto closeFile "$1" control/closed || return 1
	{ mkdir -p "${closeFile%/*}" && printf '%s %s %s\n' "$closeRun" "$3" "$4" >> "$closeFile" ; } 2> /dev/null
}


## Appends one line to a session's log. Nothing where the session is no bare name.

## Appends one line to a session's log. Nothing where the session is no bare name.
AgentsSessionLogAppend(){ ## session, line
	case "${1:-}" in ''|-|.|..|*/*|*[[:space:]]*) return 0 ;; esac
	printf '%s\n' "$2" >> "${MMDAPP:-/nonexistent}/$agentsSessionStoreLeaf/$1/session.log" 2> /dev/null || :
	return 0
}

## The launch word of a session, into the named variable: the cli service it runs on. Nothing for none.

## Writes the activity word of a run: one line, overwritten, what the run is doing and never what it achieved.
## Nothing where the run is no bare name or no workspace is set. A failed write is no error: the word is a hint.
AgentsSessionActivityWrite(){ ## run id, line
	local activityDir
	case "${1:-}" in ''|-|.|..|*/*|*[[:space:]]*) return 0 ;; esac
	[ -n "${MMDAPP:-}" ] || return 0
	printf -v activityDir '%s/%s/%s' "$MMDAPP" "$agentsSessionStoreLeaf" "$1"
	mkdir -p "$activityDir" 2> /dev/null || return 0
	printf '%s\n' "$2" > "$activityDir/activity" 2> /dev/null || :
	return 0
}

## Whether a path names a change kept for that session to apply: rc 0 where it is the session's own kept change.

## Removes a session's folder from the store, for a session whose making could not be finished. Only a bare id, and only a
## folder of this workspace's store: nothing else is ever removed. rc 1 for a name that is no session.
AgentsSessionDiscard(){ ## session
	case "${1:-}" in ''|-|.|..|*/*|*[[:space:]]*) return 1 ;; esac
	[ -n "${MMDAPP:-}" ] || return 1
	[ ! -d "$MMDAPP/$agentsSessionStoreLeaf/$1" ] || rm -rf -- "$MMDAPP/$agentsSessionStoreLeaf/$1" 2> /dev/null || :
	return 0
}

## THE STORE'S STAMP: spawned/ itself, its own clock moved by the two functions below after every record they create, rewrite, close
## or remove, and by nothing else. A reader keeps the clock it read before its walk and walks again when the clock differs; a clock read
## in its own second is not kept, since a write later in that second leaves it as it was (AgentsSpawnedStoreStampInto).

AgentsSpawnRecordWrite(){ ## run or record path, folder (empty: the run's own), the record as it must still stand (optional)
	local writeRecord="${1:-}" writeTemp writeIndex writeNow="" writeWhy="" writeSession writeKept writeKeptTemp writeStamp writeBlockSeq="" writeTracking=""

	case "$writeRecord" in
		*/../*|*/./*) writeWhy="its path holds a . or .. part" ;;
		*/*.spawn.md) ;;
		''|-|.|..|*/*|*[[:space:]]*) writeWhy="it names no run and no record" ;;
		*)
			case "${2:-$writeRecord}" in -|.|..|*/*|*[[:space:]]*) writeWhy="its folder is no folder name" ;; esac
			[ -n "${MMDAPP:-}" ] || writeWhy="${writeWhy:-no workspace (MMDAPP) to write it in}"
			printf -v writeRecord '%s/%s/%s/%s.spawn.md' "${MMDAPP:-}" "$agentsSpawnedStoreLeaf" "${2:-$writeRecord}" "$writeRecord"
		;;
	esac
	case "${writeRecord%/*/*}" in */.local/agents/spawned) ;; *) writeWhy="${writeWhy:-it lies in no spawned/ store, where its readers look}" ;; esac
	if [ -n "$writeWhy" ] ; then
		echo "⛔ ERROR: ${MDSC_CMD:-DistroAgentsTools}: the spawn record $writeRecord was not written: $writeWhy" >&2
		return 1
	fi
	mkdir -p "${writeRecord%/*}" 2> /dev/null || return 1
	writeTemp="$( mktemp "$writeRecord.XXXXXX" 2> /dev/null )" || return 1
	AgentsToolsTempClaim "$writeTemp"
	if cat > "$writeTemp" 2> /dev/null && chmod 644 "$writeTemp" 2> /dev/null ; then
		[ $# -lt 3 ] || { IFS= read -r -d '' writeNow < "$writeRecord" 2> /dev/null || : ; }
		if [ $# -lt 3 ] || [ "$writeNow" = "$3" ] ; then
			if mv -f "$writeTemp" "$writeRecord" 2> /dev/null ; then
				touch "${writeRecord%/*/*}" 2> /dev/null || :
				writeIndex="${writeRecord%/*/*}/.started-records"
				type AgentsToolsFrontmatterKey > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/common/AgentsTools.FrontmatterKey.include"
				if writeTemp="$( mktemp "$writeIndex.XXXXXX" 2> /dev/null )" ; then
					AgentsToolsTempClaim "$writeTemp"
					if { [ ! -f "$writeIndex" ] || LC_ALL=C grep -v -x -F -- "$writeRecord" "$writeIndex" 2> /dev/null || : ; } > "$writeTemp" 2> /dev/null ; then
						[ "$( AgentsToolsFrontmatterKey "$writeRecord" status )" != "spawn-started" ] || printf '%s\n' "$writeRecord" >> "$writeTemp" 2> /dev/null
						mv -f "$writeTemp" "$writeIndex" 2> /dev/null || rm -f "$writeTemp" 2> /dev/null
					else
						rm -f "$writeTemp" 2> /dev/null
					fi
				fi
				## THE FOLDER'S ROWS BLOCK IS REWRITTEN HERE, for this one folder and no other: a reader takes the block as it
				## stands, and no reader walks a store of thousands of runs for the eleven that are live. The block's own
				## `src:` token is three headers of this record, so a block a failed write left behind reads stale, never as fact.
				type AgentsToolsSpawnRowsBlockWrite > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStores.include"
				writeTracking="${writeRecord%/*}" ; writeTracking="${writeTracking##*/}"
				AgentsToolsSpawnRowsBlockWrite "$writeTracking" || :
				## THE SESSION'S OWN LIST GROWS WITH ITS RECORD: the control thread of a session reads that list at every tick, and a walk of
				## the store there was the whole load of a machine with eleven sessions on it. The stamp is taken after this write, so the
				## list reads as current until the next record of any run changes the store.
				writeSession="$( LC_ALL=C awk 'FNR == 1 { fence = 0 ; } $0 == "---" { if ( ++fence > 1 ) exit ; next ; } fence == 1 && index( $0, "session-id: " ) == 1 { print substr( $0, 13 ) ; exit ; }' "$writeRecord" 2> /dev/null )" || writeSession=""
				case "$writeSession" in ''|*/*|'.'|'..'|*[[:space:]]*) writeSession="" ;; esac
				if [ -n "$writeSession" ] && [ -d "${MMDAPP:-}/.local/agents/sessions/$writeSession" ] ; then
					writeKept="${MMDAPP:-}/.local/agents/sessions/$writeSession/records.kept"
					type AgentsSpawnedStoreStampInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.StartedRecords.include"
					AgentsSpawnedStoreStampInto writeStamp "$MMDAPP"
					if [ ! -f "$writeKept" ] || ! LC_ALL=C grep -q -x -F -- "own	$writeRecord" "$writeKept" 2> /dev/null ; then
						writeKeptTemp="$( mktemp "$writeKept.XXXXXX" 2> /dev/null )" || writeKeptTemp=""
						AgentsToolsTempClaim "$writeKeptTemp"
						if [ -n "$writeKeptTemp" ] ; then
							{
								case "$writeStamp" in ''|*[!0123456789]*) ;; *) printf 'stamp:%s\n' "$writeStamp" ;; esac
								[ ! -f "$writeKept" ] || LC_ALL=C awk 'NR > 1' "$writeKept" 2> /dev/null
								printf 'own\t%s\n' "$writeRecord"
							} > "$writeKeptTemp" 2> /dev/null && mv -f "$writeKeptTemp" "$writeKept" 2> /dev/null || rm -f "$writeKeptTemp" 2> /dev/null
						fi
					fi
				fi
				## AND THE SESSION'S LIVE BLOCK, where its thread keeps one: a run that opened, closed or handed back is what
				## the block says, and its `seq:` token is the one that thread's state write last put there. A session with no
				## block yet gets none here: its own thread writes the first one at its next state write.
				if [ -n "$writeSession" ] ; then
					writeBlockSeq="$( LC_ALL=C awk '/^seq: / { print substr( $0, 6 ) ; exit ; }' "${MMDAPP:-}/.local/agents/sessions/$writeSession/control/state" 2> /dev/null )" || writeBlockSeq=""
					[ -f "${MMDAPP:-}/.local/agents/live/$writeSession.rows" ] || writeBlockSeq=""
					[ -z "$writeBlockSeq" ] || AgentsToolsSessionLiveBlockWrite "$writeSession" "$writeBlockSeq" || :
				fi
				return 0
			fi
		fi
	fi
	rm -f "$writeTemp" 2> /dev/null
	return 1
}

## Removes one folder of spawned/ with every record in it, the write permission a record may have lost given back first, then moves the
## store's stamp. rc 1 where the folder stayed.

## Removes one folder of spawned/ with every record in it, the write permission a record may have lost given back first, then moves the
## store's stamp. rc 1 where the folder stayed.
## THE STORE'S RETENTION, here where the store is owned: the rows of dead runs past the given days are removed, a bounded few a call, and
## the count is printed. A run still started is never a candidate, whatever its age.
## THE SESSIONS STORE PRUNED, its dead folders going after the same days the runs keep: a session whose folder nothing has written for that
## long, and whose thread is not live, is history -- its prepared rows, its control files and its kept lists with it. Twenty a pass, so no
## pass is long. Prints the number removed, nothing where none was.
AgentsToolsSessionStorePrune(){ ## days, at most
	local storeDays="${1:-14}" storeMost="${2:-20}" storeDir storeId storePath storeLive storePid storeGone=0
	case "$storeDays" in ''|*[!0123456789]*) return 0 ;; esac
	case "$storeMost" in ''|*[!0123456789]*|0) storeMost=20 ;; esac
	storeDir="${MMDAPP:-/nonexistent}/.local/agents/sessions"
	[ -d "$storeDir" ] || return 0
	storeLive=" $( AgentsToolsSessionLiveIds 2> /dev/null | tr '\n' ' ' ) "
	## THE OLDEST FEW, never the whole store: a pass over twenty-five thousand folders is the cost this retention exists to avoid. One listing
	## sorted by age, the oldest first, and the bound is the candidates rather than a count after a full walk.
	for storePath in $( LC_ALL=C ls -1tr "$storeDir" 2> /dev/null | LC_ALL=C head -n "$storeMost" ) ; do
		[ "$storeGone" -lt "$storeMost" ] || break
		[ -d "$storeDir/$storePath" ] || continue
		storePath="$storeDir/$storePath"
		storeId="${storePath##*/}"
		case "$storeId" in ''|-|.|..|-*|*[!A-Za-z0-9._-]*) continue ;; esac
		case "$storeLive" in *" $storeId "*) continue ;; esac
		storePid=""
		{ IFS=' ' read -r storePid _ < "$storePath/control/pid" ; } 2> /dev/null || :
		case "$storePid" in ''|*[!0123456789]*) ;; *) kill -0 "$storePid" 2> /dev/null && continue ;; esac
		[ -n "$( find "$storePath" -maxdepth 1 -mtime +"$storeDays" 2> /dev/null )" ] || continue
		chmod -R u+w "$storePath" 2> /dev/null || :
		rm -rf -- "$storePath" 2> /dev/null || continue
		[ ! -e "$storePath" ] || continue
		storeGone=$(( storeGone + 1 ))
	done
	[ "$storeGone" -eq 0 ] || printf '%s\n' "$storeGone"
	return 0
}

## THE LIVE LIST PRUNED, by the pass that can afford it: a line whose thread is gone, or whose pid is another process now (pids come round),
## leaves the list, and the count goes back. A reader still drops a line whose pid is dead by itself; this is what removes the line, and what
## catches a pid begun at another time, which no cheap read can tell. Prints the number removed, nothing where none was.
## ITS LIVE BLOCK GOES WITH THE LINE, and nothing else does: the block is what a session list reads, so a block left behind would be a
## session listed for ever. A block whose session's control state was written in the last ten minutes is kept, which is the linger the
## session list shows an ended session for.
AgentsToolsSessionLivePrune(){
	local pruneFile pruneId prunePid pruneStart pruneNow pruneTemp pruneGone=0 pruneBlock pruneAt pruneCut
	pruneFile="${MMDAPP:-/nonexistent}/.local/agents/live-sessions"
	pruneCut="$(( $( date +%s ) - 600 ))"
	## ONE PASS OVER THE BLOCKS: a block whose session's state was written in the last ten minutes stays, which is the linger a list
	## shows an ended session for. Every other block is kept only while its thread is that process still, by the pid file's own test.
	while IFS= read -r pruneId ; do
		case "$pruneId" in ''|*/*|-|.|..|*[[:space:]]*) continue ;; esac
		pruneBlock="${MMDAPP:-/nonexistent}/.local/agents/live/$pruneId.rows"
		[ -e "$pruneBlock" ] || continue
		pruneAt="$( LC_ALL=C date -r "${MMDAPP:-/nonexistent}/.local/agents/sessions/$pruneId/control/state" +%s 2> /dev/null )" || pruneAt=""
		case "$pruneAt" in ''|*[!0123456789]*) pruneAt=0 ;; esac
		[ "$pruneAt" -eq 0 ] || [ "$pruneAt" -lt "$pruneCut" ] || continue
		prunePid="" pruneStart=""
		{ IFS=' ' read -r prunePid pruneStart < "${MMDAPP:-/nonexistent}/.local/agents/sessions/$pruneId/control/pid" ; } 2> /dev/null || :
		case "$prunePid" in ''|*[!0123456789]*) ;; *)
			kill -0 "$prunePid" 2> /dev/null || prunePid=""
			[ -z "$prunePid" ] || [ -z "$pruneStart" ] || {
				pruneNow="$( LC_ALL=C ps -o lstart= -p "$prunePid" 2> /dev/null | LC_ALL=C awk 'NF { gsub( / /, "_" ) ; print ; exit ; }' )" || pruneNow=""
				[ -n "$pruneNow" ] && [ "$pruneNow" != "$pruneStart" ] || continue
			}
		;; esac
		rm -f -- "$pruneBlock" 2> /dev/null && pruneGone=$(( pruneGone + 1 ))
	done <<< "$( LC_ALL=C ls -1 "${MMDAPP:-/nonexistent}/.local/agents/live" 2> /dev/null | LC_ALL=C sed -n 's/\.rows$//p' )"
	[ -s "$pruneFile" ] || { [ "$pruneGone" -eq 0 ] || printf '%s\n' "$pruneGone" ; return 0 ; }
	pruneTemp="$( mktemp "$pruneFile.XXXXXX" 2> /dev/null )" || return 0
	AgentsToolsTempClaim "$pruneTemp"
	while IFS= read -r pruneId ; do
		case "$pruneId" in ''|*/*|*[[:space:]]*) continue ;; esac
		prunePid="" pruneStart=""
		{ IFS=' ' read -r prunePid pruneStart < "${MMDAPP:-/nonexistent}/.local/agents/sessions/$pruneId/control/pid" ; } 2> /dev/null || :
		case "$prunePid" in ''|*[!0123456789]*) pruneGone=$(( pruneGone + 1 )) ; continue ;; esac
		kill -0 "$prunePid" 2> /dev/null || { pruneGone=$(( pruneGone + 1 )) ; continue ; }
		pruneNow="$( LC_ALL=C ps -o lstart= -p "$prunePid" 2> /dev/null | LC_ALL=C awk 'NF { gsub( / /, "_" ) ; print ; exit ; }' )" || pruneNow=""
		[ -z "$pruneNow" ] || [ "$pruneNow" = "$pruneStart" ] || { pruneGone=$(( pruneGone + 1 )) ; continue ; }
		printf '%s\n' "$pruneId"
	done < "$pruneFile" > "$pruneTemp" 2> /dev/null
	mv -f "$pruneTemp" "$pruneFile" 2> /dev/null || rm -f "$pruneTemp" 2> /dev/null
	[ "$pruneGone" -eq 0 ] || printf '%s\n' "$pruneGone"
	return 0
}

AgentsSpawnedRetentionPrune(){ ## days, at most -- stdin: the rows of the spawned-sessions registry
	local pruneDays="${1:-30}" pruneMost="${2:-20}" pruneRun pruneFolder pruneFresh pruneHold pruneDone=0
	local pruneRecord pruneField pruneItem pruneResolved pruneOpen
	case "$pruneDays" in ''|*[!0123456789]*) return 0 ;; esac
	case "$pruneMost" in ''|*[!0123456789]*|0) pruneMost=20 ;; esac
	[ "$pruneDays" -gt 0 ] || return 0
	[ -d "${MMDAPP:-/nonexistent}/.local/agents/spawned" ] || return 0
	type AgentsToolsFrontmatterKey > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/common/AgentsTools.FrontmatterKey.include"
	while IFS= read -r pruneRun ; do
		[ "$pruneDone" -lt "$pruneMost" ] || break
		case "$pruneRun" in ''|*/*|'.'|'..') continue ;; esac
		pruneFolder="${MMDAPP:-/nonexistent}/.local/agents/spawned/$pruneRun"
		[ -d "$pruneFolder" ] || continue
		## THE LAST WRITE IS THE NEWEST ONE AT OR BENEATH THE FOLDER, never the folder's own time: that time moves only when an
		## entry is added to or removed from its top level, so a folder whose output is still written reads as untouched.
		pruneFresh="$( find "$pruneFolder" -mtime -"$pruneDays" -print -quit 2> /dev/null )" || pruneFresh=""
		[ -z "$pruneFresh" ] || continue
		## A FOLDER A PROMISE OF UNDO HOLDS IS NEVER PRUNED (S13.19), whatever its age: the marker is the cleaner's own, and
		## what it protects is the record it names. A marker naming no open record keeps the folder too, and says which it wanted.
		type AgentsToolsUndoHoldState > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/undo/AgentsTools.UndoHold.include"
		pruneHold="$( AgentsToolsUndoHoldState "$pruneFolder/undo.hold" )"
		case "$pruneHold" in
			absent) ;;
			missing)
				echo "# ${MDSC_CMD:-DistroAgentsTools}: kept the run folder $pruneRun, whose undo.hold names no open record: $( AgentsToolsUndoHoldUnresolved "$pruneFolder/undo.hold" | LC_ALL=C tr '\n' ' ' )" >&2
				continue
			;;
			*)
				echo "# ${MDSC_CMD:-DistroAgentsTools}: kept the run folder $pruneRun, whose undo.hold reads $pruneHold" >&2
				continue
			;;
		esac
		## A RUN'S FOLDER IS THE RECORD OF ITS WORK: a board item its record links to, still open, keeps it. An item the board no
		## longer holds stands open nowhere, so it keeps nothing: a dispatch trashed or archived out of every state is a decision
		## already taken. Only a held item with no resolved-at is one somebody is still working.
		pruneOpen=""
		for pruneRecord in "$pruneFolder"/*.spawn.md ; do
			[ -f "$pruneRecord" ] || continue
			for pruneField in spawns spawned-by ; do
				pruneItem="$( AgentsToolsFrontmatterKey "$pruneRecord" "$pruneField" )" || pruneItem=""
				[ -n "$pruneItem" ] || continue
				type AgentsToolsBoardItemHeadersInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.ItemDecisions.include"
				pruneResolved="-"
				AgentsToolsBoardItemHeadersInto "${pruneItem%.md}.md" pruneState pruneResolved=resolved-at || continue
				[ -n "$pruneResolved" ] || { pruneOpen=1 ; break ; }
			done
			[ -z "$pruneOpen" ] || break
		done
		[ -z "$pruneOpen" ] || continue
		AgentsSpawnRecordRemove "$pruneRun" 2> /dev/null || continue
		pruneDone=$(( pruneDone + 1 ))
	done <<< "$( LC_ALL=C awk '
		## A FOLDER GOES ONLY WHERE EVERY ROW NAMING IT SETTLES: the render carries the folder in its first word and the derived
		## state in its thirteenth. One unsettled row anywhere keeps the folder.
		NF >= 13 && $1 != "" {
			if ( $13 == "finished" || $13 == "failed" ) settled[$1] = 1 ;
			else unsettled[$1] = 1 ;
		}
		END { for ( gone in settled ) if ( ! ( gone in unsettled ) ) print gone ; }
	' | LC_ALL=C sort -u )"
	[ "$pruneDone" -eq 0 ] || printf '%s\n' "$pruneDone"
	return 0
}

## THE STORE'S OWN DAY: both prunes, once a day at most, by a stamp written before the pass, so a pass that fails is tried again
## tomorrow and never on every pass. The cut-off is the sweep's own record retention, this class being the same records.
## Prints one line a prune that removed something; rc 0 always.
AgentsToolsSpawnedRetentionRun(){
	local retainStamp="${MMDAPP:-.}/.local/agents/spawned-retention.stamp" retainLast="" retainNow retainDays retainOut
	retainNow="$( date +%s )" || return 0
	{ IFS= read -r retainLast < "$retainStamp" ; } 2> /dev/null || retainLast=""
	case "$retainLast" in ''|*[!0123456789]*) retainLast=0 ;; esac
	[ $(( retainNow - retainLast )) -ge 86400 ] || return 0
	retainDays="${MDAT_CLEANUP_RETENTION_DAYS:-30}"
	case "$retainDays" in ''|*[!0123456789]*) retainDays=30 ;; esac
	mkdir -p "${retainStamp%/*}" 2> /dev/null && printf '%s\n' "$retainNow" > "$retainStamp" 2> /dev/null || :
	retainOut="$( AgentsToolsSessionStorePrune "$retainDays" 20 2> /dev/null )" || retainOut=""
	[ -z "$retainOut" ] || printf 'spawned-retention: removed %s dead session folder(s)\n' "$retainOut"
	type AgentsToolsRegistryRenderSpawnedSessionsKept > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.RegistrySpawnedSessions.include"
	retainOut="$( AgentsToolsRegistryRenderSpawnedSessionsKept agents "" "" "" live 2> /dev/null | AgentsSpawnedRetentionPrune "$retainDays" 20 2> /dev/null )" || retainOut=""
	[ -z "$retainOut" ] || printf 'spawned-retention: removed %s dead run folder(s)\n' "$retainOut"
	return 0
}

## The same pass in a process of its own, asked for at most once an hour: it reads the store's record folders, so the pass that asks
## for it never pays for that read. The day's own bound is the pass's stamp, so a run that finds nothing due ends at once.
AgentsToolsSpawnedRetentionRunDetached(){
	local detachAsked="${MMDAPP:-.}/.local/agents/spawned-retention.asked" detachNow detachWas=""
	detachNow="$( date +%s )" || return 0
	{ IFS= read -r detachWas < "$detachAsked" ; } 2> /dev/null || detachWas=""
	case "$detachWas" in ''|*[!0123456789]*) detachWas=0 ;; esac
	[ $(( detachNow - detachWas )) -ge 3600 ] || return 0
	mkdir -p "${detachAsked%/*}" 2> /dev/null && printf '%s\n' "$detachNow" > "$detachAsked" 2> /dev/null || return 0
	(
		trap '' HUP
		set +e
		AgentsToolsSpawnedRetentionRun
	) < /dev/null > /dev/null 2>&1 &
	disown "$!" 2> /dev/null || :
	return 0
}

AgentsSpawnRecordRemove(){ ## folder
	local removeFolder removeIndex removeTemp
	case "${1:-}" in ''|-|.|..|-*|*/*|*[[:space:]]*) return 1 ;; esac
	[ -n "${MMDAPP:-}" ] || return 1
	printf -v removeFolder '%s/%s/%s' "$MMDAPP" "$agentsSpawnedStoreLeaf" "$1"
	[ -e "$removeFolder" ] || return 0
	chmod -R u+w "$removeFolder" 2> /dev/null || :
	rm -rf -- "$removeFolder" 2> /dev/null || :
	[ ! -e "$removeFolder" ] || return 1
	touch "${removeFolder%/*}" 2> /dev/null || :
	## THE FOLDER'S ROWS BLOCK GOES WITH THE FOLDER, or a reader would list a sandbox the store no longer has.
	type AgentsToolsSpawnRowsBlockRemove > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStores.include"
	AgentsToolsSpawnRowsBlockRemove "$1" || :
	removeIndex="${removeFolder%/*}/.started-records"
	if [ -f "$removeIndex" ] && removeTemp="$( mktemp "$removeIndex.XXXXXX" 2> /dev/null )" ; then
		AgentsToolsTempClaim "$removeTemp"
		if LC_ALL=C awk -v gone="${removeFolder}/" 'index( $0, gone ) != 1' "$removeIndex" > "$removeTemp" 2> /dev/null ; then
			mv -f "$removeTemp" "$removeIndex" 2> /dev/null || rm -f "$removeTemp" 2> /dev/null
		else
			rm -f "$removeTemp" 2> /dev/null
		fi
	fi
	return 0
}

## The started run records of one folder of spawned/, a record a line, as the store's walks hand a record. One read of the folder.

## Saves the effort a run or a session asks of its model, for the harness to read at its next round, and prints the file
## it wrote. rc 1 where that id has no store in this workspace; rc 2 where the write failed.
AgentsSessionEffortSet(){ ## run or session id, effort word
	local effortFile effortAside
	AgentsSessionKnown "${1:-}" || return 1
	printf -v effortFile '%s/%s/%s/effort' "${MMDAPP:-/nonexistent}" "$agentsSessionStoreLeaf" "$1"
	effortAside="$( mktemp "$effortFile.XXXXXX" 2> /dev/null )" || return 2
	AgentsToolsTempClaim "$effortAside"
	{ printf '%s\n' "$2" > "$effortAside" && mv -f "$effortAside" "$effortFile" ; } 2> /dev/null || { rm -f "$effortAside" 2> /dev/null ; return 2 ; }
	printf '%s\n' "$effortFile"
}

## The name of one folder of a workspace's spawned store, from its path, into the named variable: rc 1, the variable empty,
## where that path is not a folder of that store. No process.
