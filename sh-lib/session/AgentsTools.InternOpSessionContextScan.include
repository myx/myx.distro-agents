#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.InternOpSessionContextScan.include -- the --intern-op-session-context-scan op for
## DistroAgentsTools.fn.sh's dispatcher. Sourced lazily from that exact op's
## own dispatcher arm (not a wildcard -- this file holds one op only) via the
## standard $MDLT_ORIGIN-based path. Not standalone: relies on being
## dot-sourced for $1/$@/$MDSC_CMD.
## Its whole argument contract is documented in MAGIC.md, "The internal session-context scan".
## An inbox is listed where its items live (AgentsTools.InboxPlace.include): its incoming/, and
## its processed/ too where the processed are asked for.
##

type AgentsToolsBoardReady > /dev/null 2>&1 || { . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.BoardStates.include" ; }
. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/slack/AgentsTools.CommsSlack.include"
type AgentsToolsInboxInstruction > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/inbox/AgentsTools.InboxPlace.include"

case "$1" in

	--intern-op-session-context-scan)
		shift
		local opContext="<no --context given>"
		local ctxWanted="" ctxArg
		for ctxArg in "$@" ; do
			if [ -n "$ctxWanted" ] ; then
				opContext="$ctxArg" ; ctxWanted="" ; continue
			fi
			if [ "$ctxArg" = "--context" ] ; then ctxWanted="1" ; fi
		done
		local actingMember="$1"
		shift || true
		if [ -z "$actingMember" ] ; then
			echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: syntax is <team-member> [options...] -- the acting member is required, since it is the identity every comms read in this scan acts as" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$actingMember" "<team-member>" session-context-scan || { set +e ; return 1 ; }

		local states=() headers=() typePrefixes=() items=()
		local allTypes="false" owner=""
		local commsCutoffKind="" commsCutoffValue=""
		## A FLOOR FOR ONE NAMED SOURCE, beside the pass-wide cut-off. Two parallel
		## arrays rather than an associative one: this family runs on bash 3.2,
		## which has no `declare -A`.
		local commsSourceFloorKeys=() commsSourceFloorValues=()
		local commsDoAll="false" commsDoSlack="false" commsDoEmail="false" commsDoTrello="false"
		local commsDoSlackTags="false"
		local commsMemberScopeOnly="false"
		local doInboxInquiryActive="false" doInboxInquiryAll="false"
		local doInboxReflections="false" doInboxNotes="false"
		local doInboxOther="false"
		local noSlack="false" noEmail="false" noTrello="false"
		local noInboxInquiry="false" noInboxReflections="false"
		local noInboxNotes="false" noInboxOther="false"
		local noBoardRelated="false"
		## Read-only widening of the INBOX section only. Never touches actingMember:
		## the acting identity, the credentials every comms read uses, the board's
		## owner scoping and the named-item lookup all stay with actingMember, and
		## nothing here writes into another member's inbox.
		local inboxAlsoMembers=() alsoSeen
		local doBoardRelatedActive="false" doBoardRelatedAll="false" doBoardRelatedStartable="false"
		local itemIncludeInbox="false" itemIncludeProcessed="no"
		while [ $# -gt 0 ] ; do
			case "$1" in
				--state)
					if [ -z "$2" ] ; then
						echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --state: value required" >&2
						set +e ; return 1
					fi
					case " $agentsBoardStates " in
						*" $2 "*)
						;;
						*)
							echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --state: invalid state: $2" >&2
							set +e ; return 1
						;;
					esac
					states+=( "$2" )
					shift 2
				;;
				--header)
					if [ -z "$2" ] ; then
						echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --header: value required" >&2
						set +e ; return 1
					fi
					headers+=( "$2" )
					shift 2
				;;
				--type-prefix:*)
					local prefixVal="${1#--type-prefix:}"
					if [ -z "$prefixVal" ] ; then
						echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --type-prefix: value required" >&2
						set +e ; return 1
					fi
					typePrefixes+=( "$prefixVal" )
					shift
				;;
				--all-types)
					allTypes="true"
					shift
				;;
				--filter-owner)
					if [ -z "$2" ] ; then
						echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --filter-owner: value required" >&2
						set +e ; return 1
					fi
					owner="$2"
					shift 2
				;;
				--item)
					if [ -z "$2" ] ; then
						echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --item: value required" >&2
						set +e ; return 1
					fi
					items+=( "$2" )
					shift 2
				;;
				--do-all)    commsDoAll="true" ; shift ;;
				--do-slack)  commsDoSlack="true" ; shift ;;
				--do-email)  commsDoEmail="true" ; shift ;;
				--do-trello) commsDoTrello="true" ; shift ;;
				--do-slack-tags) commsDoSlackTags="true" ; shift ;;
				--member-scope-only) commsMemberScopeOnly="true" ; shift ;;
				--no-slack)  noSlack="true" ; shift ;;
				--no-email)  noEmail="true" ; shift ;;
				--no-trello) noTrello="true" ; shift ;;
				--do-inbox-inquiry-active) doInboxInquiryActive="true" ; shift ;;
				--do-inbox-inquiry-all)    doInboxInquiryAll="true" ; shift ;;
				--do-inbox-reflections)    doInboxReflections="true" ; shift ;;
				--do-inbox-notes)          doInboxNotes="true" ; shift ;;
				--do-inbox-other)          doInboxOther="true" ; shift ;;
				--do-inbox-also-member)
					if [ -z "${2:-}" ] ; then
						echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --do-inbox-also-member: value required" >&2
						set +e ; return 1
					fi
					AgentsToolsAssertBareName "$2" "<team-member>" session-context-scan || { set +e ; return 1 ; }
					if [ "$2" = "$actingMember" ] ; then
						echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --do-inbox-also-member: $2 is already the acting <team-member>, whose own inbox this scan reads anyway -- naming it again would print the same inbox twice" >&2
						set +e ; return 1
					fi
					for alsoSeen in "${inboxAlsoMembers[@]+"${inboxAlsoMembers[@]}"}" ; do
						if [ "$alsoSeen" = "$2" ] ; then
							echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --do-inbox-also-member: $2 given more than once -- one inbox, one set of sections" >&2
							set +e ; return 1
						fi
					done
					inboxAlsoMembers+=( "$2" )
					shift 2
				;;
				--do-board-related-active) doBoardRelatedActive="true" ; shift ;;
				## THE STARTABLE SET, a duty's: the items it may take or already holds, pending and running, of the active path.
				--do-board-related-startable) doBoardRelatedActive="true" ; doBoardRelatedStartable="true" ; shift ;;
				--do-board-related-all)    doBoardRelatedAll="true" ; shift ;;
				--no-inbox-inquiry)        noInboxInquiry="true" ; shift ;;
				--no-inbox-reflections)    noInboxReflections="true" ; shift ;;
				--no-inbox-notes)          noInboxNotes="true" ; shift ;;
				--no-inbox-other)          noInboxOther="true" ; shift ;;
				--no-board-related)        noBoardRelated="true" ; shift ;;
				--item-include-inbox)      itemIncludeInbox="true" ; shift ;;
				--include-processed)       itemIncludeProcessed="yes" ; shift ;;
				--comms-since-date-time|--comms-since-utime)
					if [ -z "${2:-}" ] ; then
						echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: $1: value required" >&2
						set +e ; return 1
					fi
					if [ -n "$commsCutoffKind" ] ; then
						echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --comms-since-date-time and --comms-since-utime are mutually exclusive, and neither is repeatable -- one cut-off, one spelling" >&2
						set +e ; return 1
					fi
					case "$1" in
						--comms-since-utime)
							case "$2" in
								''|*[!0123456789.]*|*.*.*|.*|*.)
									echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --comms-since-utime: must be epoch seconds, optionally with a fractional part (e.g. 1786140114 or 1786140114.450349): $2" >&2
									set +e ; return 1
								;;
							esac
						;;
						--comms-since-date-time)
							case "$2" in
								[0-9][0-9][0-9][0-9]-[0-1][0-9]-[0-3][0-9]*) ;;
								*)
									echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --comms-since-date-time: must start with YYYY-MM-DD: $2" >&2
									set +e ; return 1
								;;
							esac
						;;
					esac
					commsCutoffKind="$1"
					commsCutoffValue="$2"
					shift 2
				;;
				--comms-source-floor)
					if [ -z "${2:-}" ] || [ -z "${3:-}" ] ; then
						echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --comms-source-floor: needs <source-key> <epoch-seconds>" >&2
						set +e ; return 1
					fi
					case "$2" in
						*[!A-Za-z0-9._-]*)
							echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --comms-source-floor: <source-key> must be the scan's own source key, letters, digits, dot, underscore and hyphen only: $2" >&2
							set +e ; return 1
						;;
					esac
					case "$3" in
						''|*[!0123456789.]*|*.*.*|.*|*.)
							echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --comms-source-floor: the floor must be epoch seconds, optionally with a fractional part (e.g. 1786140114): $3" >&2
							set +e ; return 1
						;;
					esac
					commsSourceFloorKeys+=( "$2" )
					commsSourceFloorValues+=( "$3" )
					shift 3
				;;
				--context)
					if [ -z "${2:-}" ] ; then
						echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --context: value required" >&2
						set +e ; return 1
					fi
					shift 2
				;;
				*)
					echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done

		if [ "$allTypes" = "true" ] && [ ${#typePrefixes[@]} -gt 0 ] ; then
			echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --all-types and --type-prefix: are mutually exclusive" >&2
			set +e ; return 1
		fi
		if [ "$allTypes" = "false" ] && [ ${#typePrefixes[@]} -eq 0 ] ; then
			echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: exactly one of --all-types or --type-prefix:<value>... is required -- no implicit type default" >&2
			set +e ; return 1
		fi

		## A cut-off with nothing to apply it to is a caller mistake, not a
		## no-op: it reads like comms were requested when none were.
		if [ -n "$commsCutoffKind" ] && [ "$commsDoAll" != "true" ] && [ "$commsDoSlack" != "true" ] \
			&& [ "$commsDoEmail" != "true" ] && [ "$commsDoTrello" != "true" ] ; then
			echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: $commsCutoffKind given with no comms selector (--do-all, --do-slack, --do-email, --do-trello) -- a cut-off applies to a requested comms scan, and requesting none is never implied to mean all" >&2
			set +e ; return 1
		fi
		if [ "$commsDoSlackTags" = "true" ] && [ "$commsDoAll" != "true" ] && [ "$commsDoSlack" != "true" ] ; then
			echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --do-slack-tags is an additional Slack/IM source and needs the IM scan itself -- pass it alongside --do-slack or --do-all" >&2
			set +e ; return 1
		fi
		if [ "$commsMemberScopeOnly" = "true" ] && [ "$commsDoAll" != "true" ] && [ "$commsDoSlack" != "true" ] \
			&& [ "$commsDoEmail" != "true" ] && [ "$commsDoTrello" != "true" ] ; then
			echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --member-scope-only restricts a requested comms scan and needs one -- pass it alongside --do-all, --do-slack, --do-email or --do-trello" >&2
			set +e ; return 1
		fi
		## A member-scope scan reads the acting member's own sources. For a client-* member those
		## are the other organisation's, so the whole scan is on the client side, whoever started
		## it (MDAT_COMMS_SIDE, AgentsTools.CommsSide.include): its Slack, its mail and its Trello.
		if [ "$commsMemberScopeOnly" = "true" ] ; then
			case "$actingMember" in
				client-*) local -x MDAT_COMMS_SIDE=client ;;
			esac
		fi
		## --do-all is the whole set, not a shorthand to combine with
		## part of it -- same fixed-wrapper discipline as --all-types.
		if [ "$commsDoAll" = "true" ] && { [ "$commsDoSlack" = "true" ] || [ "$commsDoEmail" = "true" ] || [ "$commsDoTrello" = "true" ] ; } ; then
			echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --do-all and the individual --do-slack/--do-email/--do-trello selectors are mutually exclusive" >&2
			set +e ; return 1
		fi
		if [ "$commsDoAll" = "true" ] && { [ "$noSlack" = "true" ] || [ "$noEmail" = "true" ] || [ "$noTrello" = "true" ] ; } ; then
			echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --do-all requests the whole comms set and --no-slack/--no-email/--no-trello decline part of it -- disagreeing values are an error, not an intersection" >&2
			set +e ; return 1
		fi
		if [ "$commsDoSlack" = "true" ] && [ "$noSlack" = "true" ] ; then
			echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --do-slack and --no-slack name the same section -- disagreeing values are an error, not an intersection" >&2
			set +e ; return 1
		fi
		if [ "$commsDoEmail" = "true" ] && [ "$noEmail" = "true" ] ; then
			echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --do-email and --no-email name the same section -- disagreeing values are an error, not an intersection" >&2
			set +e ; return 1
		fi
		if [ "$commsDoTrello" = "true" ] && [ "$noTrello" = "true" ] ; then
			echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --do-trello and --no-trello name the same section -- disagreeing values are an error, not an intersection" >&2
			set +e ; return 1
		fi

		if [ "$doInboxInquiryActive" = "true" ] && [ "$doInboxInquiryAll" = "true" ] ; then
			echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --do-inbox-inquiry-active and --do-inbox-inquiry-all are mutually exclusive -- both fill the same section, and a section carrying two scopes states neither" >&2
			set +e ; return 1
		fi
		## A widening with nothing to widen is a caller mistake, not an empty result:
		## the extra inboxes would silently print four "not requested" sections and
		## read as "that member's inbox holds nothing".
		if [ ${#inboxAlsoMembers[@]} -gt 0 ] \
			&& [ "$doInboxInquiryActive" != "true" ] && [ "$doInboxInquiryAll" != "true" ] \
			&& [ "$doInboxReflections" != "true" ] && [ "$doInboxNotes" != "true" ] \
			&& [ "$doInboxOther" != "true" ] ; then
			echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --do-inbox-also-member widens the inbox sections, and no --do-inbox-* section was requested -- there is nothing to widen" >&2
			set +e ; return 1
		fi
		if [ "$doBoardRelatedActive" = "true" ] && [ "$doBoardRelatedAll" = "true" ] ; then
			echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --do-board-related-active and --do-board-related-all are mutually exclusive -- both fill the same section, and a section carrying two scopes states neither" >&2
			set +e ; return 1
		fi
		## Declining is per section and requesting is per breadth, so a decline
		## disagrees with either breadth of the section it names.
		if [ "$noInboxInquiry" = "true" ] && { [ "$doInboxInquiryActive" = "true" ] || [ "$doInboxInquiryAll" = "true" ] ; } ; then
			echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --no-inbox-inquiry declines the section --do-inbox-inquiry-active/--do-inbox-inquiry-all request -- disagreeing values are an error, not an intersection" >&2
			set +e ; return 1
		fi
		if [ "$noInboxReflections" = "true" ] && [ "$doInboxReflections" = "true" ] ; then
			echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --do-inbox-reflections and --no-inbox-reflections name the same section -- disagreeing values are an error, not an intersection" >&2
			set +e ; return 1
		fi
		if [ "$noInboxNotes" = "true" ] && [ "$doInboxNotes" = "true" ] ; then
			echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --do-inbox-notes and --no-inbox-notes name the same section -- disagreeing values are an error, not an intersection" >&2
			set +e ; return 1
		fi
		if [ "$noInboxOther" = "true" ] && [ "$doInboxOther" = "true" ] ; then
			echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --do-inbox-other and --no-inbox-other name the same section -- disagreeing values are an error, not an intersection" >&2
			set +e ; return 1
		fi
		if [ "$noBoardRelated" = "true" ] && { [ "$doBoardRelatedActive" = "true" ] || [ "$doBoardRelatedAll" = "true" ] ; } ; then
			echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --no-board-related declines the section --do-board-related-active/--do-board-related-all request -- disagreeing values are an error, not an intersection" >&2
			set +e ; return 1
		fi

		local boardRelatedStatesText=""
		if [ "$doBoardRelatedActive" = "true" ] || [ "$doBoardRelatedAll" = "true" ] ; then
			if [ -n "$owner" ] && [ "$owner" != "$actingMember" ] ; then
				echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --do-board-related-* scopes the board to the acting <team-member> ($actingMember) while --filter-owner names $owner -- disagreeing values are an error, not an intersection" >&2
				set +e ; return 1
			fi
			owner="$actingMember"
			local boardRelatedStates=()
			if [ "$doBoardRelatedAll" = "true" ] ; then
				boardRelatedStates=( $agentsBoardStates )
				boardRelatedStatesText="${agentsBoardStates// /|}"
			elif [ "$doBoardRelatedStartable" = "true" ] ; then
				boardRelatedStates=( $agentsBoardQueuedStates )
				boardRelatedStatesText="${agentsBoardQueuedStates// /|}"
			else
				boardRelatedStates=( $agentsBoardOpenStates )
				boardRelatedStatesText="${agentsBoardOpenStates// /|}"
			fi
			if [ ${#states[@]} -gt 0 ] ; then
				local statesGiven="" statesWanted="" sg
				for sg in ${states[@]+"${states[@]}"} ; do statesGiven+="|$sg" ; done
				for sg in ${boardRelatedStates[@]+"${boardRelatedStates[@]}"} ; do statesWanted+="|$sg" ; done
				if [ "$statesGiven" != "$statesWanted" ] ; then
					echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: --do-board-related-* supplies its own state set ($boardRelatedStatesText) and the --state values given do not match it -- disagreeing values are an error, not an intersection" >&2
					set +e ; return 1
				fi
			fi
			states=( ${boardRelatedStates[@]+"${boardRelatedStates[@]}"} )
		fi

		if [ ${#states[@]} -eq 0 ] ; then
			states=( none )
		fi

		[ -n "${MDAT_DATA_ROOT:-}" ] || {
			echo "$MDSC_CMD: session-context-scan: ⛔ ERROR: MDAT_DATA_ROOT is not set" >&2
			set +e ; return 1
		}
		local headersJoined="" sep=""
		if [ ${#headers[@]} -gt 0 ] ; then
			for h in ${headers[@]+"${headers[@]}"} ; do
				headersJoined+="$sep$h"
				sep=$'\034'
			done
		fi

		local matchedFiles=() matchedStates=()
		local inboxEmittedPaths=()
		local boardScanned=0
		local state f base it tp matched ownerVal stateItems=()
		type AgentsToolsBoardItemsInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.ItemDecisions.include"
		for state in ${states[@]+"${states[@]}"} ; do
			AgentsToolsBoardItemsInto stateItems "" "$state"
			for f in ${stateItems[@]+"${stateItems[@]}"} ; do
				[ -f "$f" ] || continue
				boardScanned=$(( boardScanned + 1 ))
				base="${f##*/}"

				if [ ${#items[@]} -gt 0 ] ; then
					matched="false"
					for it in ${items[@]+"${items[@]}"} ; do
						if [ "$it" = "$base" ] ; then matched="true" ; break ; fi
					done
					[ "$matched" = "true" ] || continue
				fi

				if [ "$allTypes" != "true" ] ; then
					matched="false"
					for tp in ${typePrefixes[@]+"${typePrefixes[@]}"} ; do
						case "$base" in
							"$tp"*) matched="true" ; break ;;
						esac
					done
					[ "$matched" = "true" ] || continue
				fi

				if [ -n "$owner" ] ; then
					## A file that has left its state folder since it was listed is skipped, exactly as the
					## per-item read below skips it: housekeeping moves a running item to review on every handback.
					[ -f "$f" ] || continue
					ownerVal="$( LC_ALL=C awk '/^owner: / { sub(/^owner: /, "") ; print ; exit ; }' "$f" )"
					[ "$ownerVal" = "$owner" ] || continue
				fi

				matchedFiles+=( "$f" )
				matchedStates+=( "$state" )
			done
		done

		## OLDEST FIRST, ACROSS EVERY STATE. The two loops above walk state by state
		## and glob each one, so the list arrived ordered by state and then
		## LEXICALLY BY FILENAME -- which sorts on the item TYPE first, because a
		## name is `<type>-<YYYYMMDDTHHMMZ>-<slug>.md`. Every `dispatch-*` therefore
		## preceded every `note-*` regardless of age, and a state's items never
		## interleaved with another's at all. That is not a chronological order and
		## it is not this scan's to impose: every list an input-scan returns is
		## ordered oldest to newest.
		##
		## The key is the timestamp embedded in the name, which is fixed-width UTC
		## and therefore sorts lexically in chronological order. The two arrays are
		## PARALLEL -- matchedStates[i] describes matchedFiles[i] -- so they are
		## sorted together through one keyed record and split back apart; sorting
		## either alone would silently re-label every item.
		## A name carrying no timestamp keeps its arrival position at the END rather
		## than being given an invented date: unknown is not oldest.
		if [ ${#matchedFiles[@]} -gt 1 ] ; then
			local boardSorted="" boardIndex=0 boardState="" boardFile=""
			## The key is derived in awk, not in a shell `case`: a bracket range in a
			## shell pattern is collation-dependent and this family does not use one.
			## A name carrying no timestamp gets "~" (0x7E, above every digit under
			## LC_ALL=C) and lands at the END -- unknown is not oldest -- with the
			## original arrival index breaking ties so the sort is stable.
			boardSorted="$( for (( boardIndex = 0 ; boardIndex < ${#matchedFiles[@]} ; boardIndex++ )) ; do
					printf '%s\t%s\t%s\n' "$boardIndex" "${matchedStates[$boardIndex]}" "${matchedFiles[$boardIndex]}"
				done | LC_ALL=C awk -F '\t' '
					{
						base = $3
						sub(/^.*\//, "", base)
						key = base
						sub(/^[^-]*-/, "", key)
						sub(/-.*$/, "", key)
						if ( key !~ /^[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T/ ) { key = "~" ; }
						printf("%s\t%s\t%s\t%s\n", key, $1, $2, $3)
					}
				' | LC_ALL=C sort -t "$( printf '\t' )" -k1,1 -k2,2n )"
			matchedFiles=()
			matchedStates=()
			while IFS=$'\t' read -r boardIndex boardIndex boardState boardFile ; do
				[ -n "$boardFile" ] || continue
				matchedFiles+=( "$boardFile" )
				matchedStates+=( "$boardState" )
			done <<< "$boardSorted"
		fi

		local sessionContextEngaged="false"
		if [ -n "$commsCutoffKind" ] || [ "$commsDoAll" = "true" ] || [ "$commsDoSlack" = "true" ] \
			|| [ "$commsDoEmail" = "true" ] || [ "$commsDoTrello" = "true" ] \
			|| [ "$doInboxInquiryActive" = "true" ] || [ "$doInboxInquiryAll" = "true" ] \
			|| [ "$doInboxReflections" = "true" ] || [ "$doInboxNotes" = "true" ] \
			|| [ "$doInboxOther" = "true" ] \
			|| [ "$doBoardRelatedActive" = "true" ] || [ "$doBoardRelatedAll" = "true" ] ; then
			sessionContextEngaged="true"
		fi

		local sessionContextSourcesTotal=0 sessionContextSourcesScanned=0
		local sessionContextCapInboxItemBytes=8192

		if [ "$sessionContextEngaged" = "true" ] ; then
			type AgentsToolsContextScanComms > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.ContextScanComms.include"
			local contextScanCommsFailed=""
			AgentsToolsContextScanComms "$@"
			[ -z "$contextScanCommsFailed" ] || { set +e ; return 1 ; }

		fi
		local boardStatesText="" boardTypeText="" boardOwnerText="" boardScopeLine bs
		for bs in ${states[@]+"${states[@]}"} ; do
			boardStatesText="${boardStatesText:+$boardStatesText|}$bs"
		done
		if [ "$allTypes" = "true" ] ; then
			boardTypeText="all types"
		else
			for bs in ${typePrefixes[@]+"${typePrefixes[@]}"} ; do
				boardTypeText="${boardTypeText:+$boardTypeText|}$bs"
			done
			boardTypeText="types: $boardTypeText"
		fi
		if [ -n "$owner" ] ; then
			boardOwnerText="owner: $owner"
		else
			boardOwnerText="any owner"
		fi
		local boardTree=""
		boardTree="$MDAT_DATA_ROOT/board"
		boardScopeLine="board/<state>/*.md -- $boardStatesText, $boardTypeText, $boardOwnerText, tree: $boardTree"

		## The item blocks are emitted below, outside this block: a decline may
		## drop the heading only when there are none for it to head.
		if [ "$noBoardRelated" != "true" ] || [ ${#matchedFiles[@]} -gt 0 ] ; then
			printf '## Board Items\n'
			if [ ${#matchedFiles[@]} -gt 0 ] \
				|| [ "$doBoardRelatedActive" = "true" ] || [ "$doBoardRelatedAll" = "true" ] ; then
				printf 'scope: %s\n' "$boardScopeLine"
			fi
			if [ ${#matchedFiles[@]} -eq 0 ] \
				&& { [ "$doBoardRelatedActive" = "true" ] || [ "$doBoardRelatedAll" = "true" ] ; } ; then
				printf '**NOTE:** no new Board Items -- scanned %s items, 0 matched owner: %s across %s\n\n' \
					"$boardScanned" "$actingMember" "$boardRelatedStatesText"
			else
				printf '\n'
			fi
		fi

		local h val mi handlerRc handlerOut boardHeldRows
		## Each item's token totals, summed now over what sits under it, never stored
		## (AgentsTools.SessionTokens.include); one read of the board for all of them.
		local boardTokenRows=""
		type AgentsSessionTokensRollupRows > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionTokens.include"
		if [ ${#matchedFiles[@]} -gt 0 ] ; then
			boardTokenRows="$( AgentsSessionTokensRollupRows "${matchedFiles[@]##*/}" 2>/dev/null )"
		fi
		## ONE READING OF THE TYPE TABLE AND OF THE SPAWN TREE FOR THE WHOLE SCAN. Each item below asks the handler
		## twice, and without these every one of them re-derives the table and re-walks .local/agents/spawned: over a
		## 266-item board that was 28 seconds of the scan's own work. The snapshot is taken here, once, so every item
		## of one scan answers against the same reading. Both are the opt-in overrides of AgentsTools.BoardItemHandler.
		local boardTypeTable boardLiveHolders
		if [ ${#matchedFiles[@]} -gt 0 ] ; then
			type AgentsToolsBoardTypeTable > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.BoardItemHandler.include"
			boardTypeTable="$( AgentsToolsBoardTypeTable )" || boardTypeTable=""
			boardLiveHolders="$( AgentsToolsBoardLiveHolders )" || boardLiveHolders=""
		fi
		local AGENTS_BOARD_TYPE_TABLE_CACHE="$boardTypeTable" AGENTS_BOARD_LIVE_HOLDERS_CACHE="$boardLiveHolders"
		export AGENTS_BOARD_TYPE_TABLE_CACHE AGENTS_BOARD_LIVE_HOLDERS_CACHE
		mi=0
		while [ "$mi" -lt "${#matchedFiles[@]}" ] ; do
			f="${matchedFiles[$mi]}"
			state="${matchedStates[$mi]}"
			mi=$(( mi + 1 ))
			base="${f##*/}"
			## AN ITEM THAT MOVED OR CANNOT BE READ IS NAMED AND SKIPPED, never a dead scan. A handback moves a running
			## item to review, and housekeeping does it while a scan is walking the states, so the file listed here is
			## gone from here. Every read below would then fail, and under the dispatcher's `set -e` the first of them
			## ends the whole scan -- which is how one ordinary move cost the coordinator its entire sweep.
			if [ ! -r "$f" ] ; then
				printf '**NOTE:** item not read -- %s/%s is no longer a readable file in that state folder, so this item is skipped and every other section of this scan stands\n\n' "$state" "$base"
				continue
			fi

			printf '## %s/%s\n' "$state" "$base"
			## An item the scan was named for (one task's own input) shows its Decisions first: they bind it.
			if [ ${#items[@]} -gt 0 ] ; then
				type AgentsToolsDecisionsBlock > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.ItemDecisions.include"
				AgentsToolsDecisionsBlock "$f" 30 | LC_ALL=C sed 's/^## /### /' || :
			fi
			if [ ${#headers[@]} -eq 0 ] ; then
				LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsBoardItemFrontmatterPrint.awk" "$f"
			else
				LC_ALL=C awk -v title=1 -v cap="${MDAT_SCAN_HEADER_CAP:-0}" -v headers="$headersJoined" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsBoardItemFrontmatterPrintSelected.awk" "$f"
			fi
			## The routine that runs the item's next iteration (AgentsTools.BoardItemHandler.include): its handler-routine, else the default of its type in the
			## table of magic-team.advance.routine. A flagged item runs nothing. Printed only where the table can be read and the item has a type.
			type AgentsToolsBoardItemHandler > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.BoardItemHandler.include"
			handlerRc=0 ; handlerOut="$( AgentsToolsBoardItemHandler "$f" 2> /dev/null )" || handlerRc=$?
			case "$handlerRc" in
				0) printf 'handler-routine (resolved): %s (%s)\n' "$( printf '%s' "$handlerOut" | LC_ALL=C awk -F'\t' '{ print $2 ; exit ; }' )" "$( printf '%s' "$handlerOut" | LC_ALL=C awk -F'\t' '{ print $3 ; exit ; }' )" ;;
				3) printf 'handler-routine (resolved): FLAGGED %s -- nothing runs\n' "$( printf '%s' "$handlerOut" | LC_ALL=C awk -F'\t' '$1 == "flag" { printf "%s%s", sep, $2 ; sep = "," ; }' )" ;;
			esac
			## WHO HOLDS THE ITEM, as the DOCUMENT says it and never as the asker does: one view field, a
			## function of the item and its live runs alone, so the holder, another member and the
			## coordinator are answered alike. One writer is a separate rule, and it is the round
			## check's own (AgentsToolsBoardItemRoundMay).
			type AgentsToolsBoardItemHolders > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.BoardItemHandler.include"
			boardHeldRows="$( AgentsToolsBoardItemHolders "$f" 2> /dev/null )" || :
			if [ -n "$boardHeldRows" ] ; then
				printf 'held (by %s)\n' "$( printf '%s' "$boardHeldRows" | LC_ALL=C awk -F'\t' '{ printf "%s%s (%s)", sep, $1, $2 ; sep = ", " ; }' )"
			fi
			[ -z "$boardTokenRows" ] || AgentsSessionTokensRollupText "$( AgentsSessionTokensRollupRowOf "$boardTokenRows" "$base" )" tokens-total
			printf '\n'
		done

		if [ "$itemIncludeInbox" = "true" ] && [ ${#items[@]} -gt 0 ] ; then
			local namedInboxDir="" namedFolders=()
			type AgentsToolsInboxFolderInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/inbox/AgentsTools.InboxPlace.include"
			AgentsToolsInboxFolderInto namedInboxDir "$actingMember" incoming || namedInboxDir=""
			local namedEmit=() namedMissing=() namedFound namedPath ni namedFolder
			## Where a read finds it (AgentsToolsInboxFolders): incoming/, and processed/ with
			## --include-processed.
			while IFS= read -r namedFolder ; do
				namedFolders+=( "$namedFolder" )
			done < <( AgentsToolsInboxFolders "$actingMember" "$itemIncludeProcessed" )
			for it in ${items[@]+"${items[@]}"} ; do
				namedFound="false"
				## Already rendered by the board walk above -- named, found,
				## nothing further to do for it here.
				for f in "${matchedFiles[@]+"${matchedFiles[@]}"}" ; do
					if [ "${f##*/}" = "$it" ] ; then namedFound="true" ; break ; fi
				done
				if [ "$namedFound" = "false" ] ; then
					for namedFolder in ${namedFolders[@]+"${namedFolders[@]}"} ; do
						namedPath="$namedFolder/$it"
						if [ -f "$namedPath" ] ; then
							namedFound="true"
							local namedSeen="false" namedPrev
							for namedPrev in "${inboxEmittedPaths[@]+"${inboxEmittedPaths[@]}"}" ; do
								if [ "$namedPrev" = "$namedPath" ] ; then namedSeen="true" ; break ; fi
							done
							[ "$namedSeen" = "true" ] || namedEmit+=( "$namedPath" )
							break
						fi
					done
				fi
				[ "$namedFound" = "true" ] || namedMissing+=( "$it" )
			done

			## Same one-process-per-batch rule as the sweep sections, and the
			## same framing -- a named item is not a different kind of block.
			if [ ${#namedEmit[@]} -gt 0 ] ; then
				LC_ALL=C awk \
					-v bodyByteCap="$sessionContextCapInboxItemBytes" \
					-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/inbox/AgentsInboxItemBlockPrint.awk" \
					${namedEmit[@]+"${namedEmit[@]}"}
				## THE NAMED BLOCK CLOSES WITH THE SECTION'S OWN INSTRUCTION (S18.3) where it delivered an item out of incoming/:
				## that is an unprocessed item handed to its member. An already-processed item is not one, and carries none.
				for namedPath in ${namedEmit[@]+"${namedEmit[@]}"} ; do
					if [ -f "$namedInboxDir/${namedPath##*/}" ] ; then
						printf '%s\n\n' "$( AgentsToolsInboxInstruction )"
						break
					fi
				done
			fi

			ni=0
			while [ "$ni" -lt "${#namedMissing[@]}" ] ; do
				if [ "$itemIncludeProcessed" = "yes" ] ; then
					printf '**NOTE:** named item not found -- %s, searched every board state and inboxes/%s/, its incoming and its processed items\n\n' \
						"${namedMissing[$ni]}" "$actingMember"
				else
					printf '**NOTE:** named item not found -- %s, searched every board state and inboxes/%s/, its incoming items (not its processed ones: --include-processed)\n\n' \
						"${namedMissing[$ni]}" "$actingMember"
				fi
				ni=$(( ni + 1 ))
			done
		fi

		if [ "$sessionContextSourcesTotal" -eq 0 ] || [ "$sessionContextSourcesScanned" -eq "$sessionContextSourcesTotal" ] ; then
			return 0
		fi
		if [ "$sessionContextSourcesScanned" -eq 0 ] ; then
			set +e ; return 4
		fi
		set +e ; return 3
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
