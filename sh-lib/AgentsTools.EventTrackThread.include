#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.EventTrackThread.include -- the one record of a coworking session's
## event-track thread, the one way a post opens it, and the switch of a participant's feed.
## Function-only. Sourced by whatever opens, reads or posts into a session's thread: the
## spawn proxy (the start post), the feed (AgentsTools.EventTrackFeed.include), the
## permission posts (AgentsTools.InternOpPermission.include), the housekeeping report
## (AgentsTools.SpawnSandbox.include), the transcript and the harness context.
##
## THE THREAD belongs to the coworking session, and every participant's tracking posts go
## into it: its start, its feed, a refusal, a grant, a denial, a notice, its handback, its
## end, its housekeeping. ONE THREAD PER COWORKING SESSION, in one record:
## $MMDAPP/.local/agents/sessions/<session-id>/event-track.thread, one line `<channel>:<ts>`,
## keyed by the coworking session id -- the `session-id` the spawn proxy settles: a spawn's
## own id where it starts a session, the joined session's where it joins. The spawn that
## starts a session opens the thread with its start post; a session with no start post has
## it opened by its first tracking post. Whoever opens it records it here, under the
## session's lock (AgentsToolsEventTrackThreadPost), the first record stands, and everything
## after is a reply there, a joining spawn's start post too. A spawn that starts a session
## of its own, a sub-spawn that does not join its parent's included, has a thread of its own.
##
## A caller names a session by the store directory of an id, sessions/<id>: the session's
## own, or the id of one spawn of it, whose session is found through its spawn record
## (spawned/<sandbox>/<id>.md, `session-id`). No spawn has a thread or a record of its own.
##
## THE FEED SWITCH is each participant's own: sessions/<its own id>/feed.open, an empty
## marker. While it is there that participant's lines are kept in sessions/<its own id>/feed
## for its poster, which posts them into the session's thread. Only what starts a poster
## switches it on, so a thread recorded for a session with no poster buffers nothing.
##
## BEFORE THIS RULE every spawn had a thread of its own, recorded in its own store. A
## session still running from then keeps posting to its own thread until it ends, and
## nothing it holds is rewritten: a store that holds a thread by itself is read as it is --
## its file event-track (then both its thread and its feed switch, the thread of its start
## post, over one a refusal opened beside it), else its event-track.thread. A spawn from
## then that had no feed holds neither: its thread is in its spawn record alone
## (`agent-log-thread`), read from there where nothing else names one. Nothing writes
## event-track any more.
##

if ! type AgentsToolsEventTrackThreadRead > /dev/null 2>&1 ; then

	## The record written whole or not at all, by a rename: a write cut short must never read
	## as a session with no thread, or its next post would open a second one. A record that
	## could not be written is said on stderr.
	AgentsToolsEventTrackThreadWrite(){ ## session dir, thread
		## stderr first: a redirection that cannot be opened is reported before a later one applies.
		mkdir -p "$1" 2>/dev/null && printf '%s\n' "$2" 2>/dev/null > "$1/event-track.thread.$$" \
			&& mv -f "$1/event-track.thread.$$" "$1/event-track.thread" 2>/dev/null && return 0
		rm -f "$1/event-track.thread.$$" 2>/dev/null
		echo "⚠️ WARNING: the event-track thread $2 of session ${1##*/} could not be recorded, so a later post of it may open another thread" >&2
		return 1
	}

	## The thread one store holds by itself, or nothing: never written here, so a store from
	## before the rule is read exactly as it was left.
	AgentsToolsEventTrackThreadHeld(){ ## session dir
		local heldThread=""
		[ -n "${1:-}" ] || return 0
		## From before the rule: event-track was the thread of the start post, which stands over
		## one a refusal opened beside it.
		[ ! -s "$1/event-track" ] || IFS= read -r heldThread < "$1/event-track" || :
		[ -n "$heldThread" ] || [ ! -s "$1/event-track.thread" ] || IFS= read -r heldThread < "$1/event-track.thread" || :
		printf '%s' "$heldThread"
	}

	## One header of the spawn record of the id a store directory is named by, or nothing:
	## the record is spawned/<sandbox>/<id>.md, beside the store.
	AgentsToolsEventTrackThreadSpawnHeader(){ ## session dir, header
		local spawnRecord spawnLine
		[ -n "${1:-}" ] || return 0
		for spawnRecord in "${1%/sessions/*}/spawned"/*/"${1##*/}.md" ; do
			[ -f "$spawnRecord" ] || continue
			while IFS= read -r spawnLine ; do
				case "$spawnLine" in
					"$2: "*) printf '%s' "${spawnLine#"$2: "}" ; return 0 ;;
					'# '*) return 0 ;;
				esac
			done < "$spawnRecord"
			return 0
		done
	}

	## The store directory that holds the thread record for the id a store directory is named
	## by: the store of the coworking session a spawn belongs to, by its spawn record. A store
	## that holds a thread by itself is its own: a session's own store, or a spawn from before
	## the rule, which keeps the thread it has. With no spawn record it is its own too: a
	## session that was not spawned, or a spawn whose record is not written yet.
	AgentsToolsEventTrackThreadDir(){ ## session dir
		local dirSession=""
		[ -n "${1:-}" ] || return 0
		if [ -z "$( AgentsToolsEventTrackThreadHeld "$1" )" ] ; then
			dirSession="$( AgentsToolsEventTrackThreadSpawnHeader "$1" session-id )"
			case "$dirSession" in ''|*/*|.|..|*' '*) dirSession="" ;; esac
		fi
		printf '%s' "${1%/*}/${dirSession:-${1##*/}}"
	}

	## The store directory of this process's own session, for a post it makes about itself:
	## by its own id (MDAT_SPAWN_SESSION_ID), in the store beside the sandbox it was given
	## (MDAT_SPAWN_SANDBOX_ROOT), where its spawn was recorded even when it runs in another
	## workspace; with no sandbox, in this workspace's store. Prints nothing with no id.
	AgentsToolsEventTrackThreadOwnDir(){
		local ownBase="${MMDAPP:-}/.local/agents"
		case "${MDAT_SPAWN_SESSION_ID:-}" in ''|*/*|.|..|*' '*) return 0 ;; esac
		case "${MDAT_SPAWN_SANDBOX_ROOT:-}" in ?*/spawned/?*) ownBase="${MDAT_SPAWN_SANDBOX_ROOT%/spawned/*}" ;; esac
		printf '%s' "$ownBase/sessions/$MDAT_SPAWN_SESSION_ID"
	}

	## The thread of the session a store directory names, or nothing where it has none yet.
	AgentsToolsEventTrackThreadRead(){ ## session dir
		local readThread=""
		[ -n "${1:-}" ] || return 0
		readThread="$( AgentsToolsEventTrackThreadHeld "$( AgentsToolsEventTrackThreadDir "$1" )" )"
		## Nothing recorded: a spawn from before the rule that had no feed has its thread in its
		## spawn record alone.
		[ -n "$readThread" ] || readThread="$( AgentsToolsEventTrackThreadSpawnHeader "$1" agent-log-thread )"
		printf '%s' "$readThread"
	}

	## Records the thread a post just opened as the session's, unless the session already has
	## one: the first record stands. Prints the session's thread, which every later post goes
	## into. The caller holds the lock that orders two first posts (AgentsToolsEventTrackThreadPost).
	AgentsToolsEventTrackThreadRecord(){ ## session dir, thread
		local recordHeld=""
		[ -n "${1:-}" ] && [ -n "${2:-}" ] || return 0
		recordHeld="$( AgentsToolsEventTrackThreadRead "$1" )"
		if [ -z "$recordHeld" ] ; then
			AgentsToolsEventTrackThreadWrite "$( AgentsToolsEventTrackThreadDir "$1" )" "$2" || :
			recordHeld="$2"
		fi
		printf '%s' "$recordHeld"
	}

	## One tracking post of a session, into its thread: a reply where the session has one,
	## else the post that opens it, recorded at once as the session's. Reading the record,
	## posting and recording are one step under the session's own lock, so of two first posts
	## at once -- two participants', or a start post and a refusal -- one opens the thread and
	## the other is a reply in it. Leaves agentsEventTrackThread (the session's thread after
	## the call, also where this post failed), agentsEventTrackPost (this post, as
	## `<channel>:<ts>`) and agentsEventTrackError (what the post operation said when it
	## failed). rc 0 posted; rc 1 not posted; rc 2 no event-track channel is configured, so
	## nothing was tried. Prints nothing: each caller words its own warning. The post's lines,
	## where it takes them from stdin, are the caller's stdin.
	AgentsToolsEventTrackThreadPost(){ ## member, session dir, --intern-op-event-track-post arguments...
		local postMember="$1" postDir="$2" postStore postLock="" postOut postRc=0
		shift 2
		agentsEventTrackThread="" ; agentsEventTrackPost="" ; agentsEventTrackError=""
		[ -n "$( DistroAgentsTools --agents-config-option magic-team --select SLACK_CHANNEL_EVENT_TRACK 2>/dev/null < /dev/null )" ] || return 2
		postStore="$( AgentsToolsEventTrackThreadDir "$postDir" )"
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.LocalLock.include"
		if AgentsToolsLocalLockTake "event-track-${postStore##*/}" 30 "the event-track thread of ${postStore##*/}" ; then
			postLock="$agentsLocalLockPath"
		else
			echo "⚠️ WARNING: ${MDSC_CMD:-event-track}: the event-track thread lock of ${postStore##*/} could not be taken, so this post may open a second thread" >&2
		fi
		agentsEventTrackThread="$( AgentsToolsEventTrackThreadRead "$postDir" )"
		postOut="$MMDAPP/.local/temp/mdat-event-track-post.$$"
		if mkdir -p "$MMDAPP/.local/temp" 2>/dev/null \
			&& DistroAgentsTools --intern-op-event-track-post "$postMember" "${agentsEventTrackThread:-event-track}" "$@" > /dev/null 2> "$postOut" ; then
			agentsEventTrackPost="$( LC_ALL=C awk -F= '
				$1 == "SENT_MESSAGE_CHANNEL" { sentChannel = $2 ; }
				$1 == "SENT_MESSAGE_TS" { sentTs = $2 ; }
				END { if ( sentChannel != "" && sentTs != "" ) { print sentChannel ":" sentTs ; } }
			' "$postOut" 2>/dev/null )"
			[ -n "$agentsEventTrackThread" ] || [ -z "$agentsEventTrackPost" ] \
				|| agentsEventTrackThread="$( AgentsToolsEventTrackThreadRecord "$postDir" "$agentsEventTrackPost" )"
		else
			postRc=1
			agentsEventTrackError="$( LC_ALL=C grep -m1 '⛔' "$postOut" 2>/dev/null )"
		fi
		rm -f "$postOut"
		AgentsToolsLocalLockGive "$postLock"
		return "$postRc"
	}

	## rc 0 while a participant's feed is switched on.
	AgentsToolsEventTrackFeedOn(){ ## the participant's own session dir
		[ -n "${1:-}" ] && { [ -e "$1/feed.open" ] || [ -s "$1/event-track" ] ; }
	}

	## Switches a participant's feed on: only what starts its poster does.
	AgentsToolsEventTrackFeedSwitchOn(){ ## the participant's own session dir
		[ -n "${1:-}" ] || return 0
		mkdir -p "$1" 2>/dev/null && : > "$1/feed.open" 2>/dev/null || :
		return 0
	}

fi
