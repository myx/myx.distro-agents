#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.InternOpMemberInboxUpsert.include -- the
## --intern-op-member-inbox-upsert op for DistroAgentsTools.fn.sh's
## dispatcher. Sourced lazily from that exact op's own dispatcher arm (not a
## wildcard -- this file holds one op only) via the standard
## $MDLT_ORIGIN-based path. Not standalone: relies on being dot-sourced for
## $1/$@/$MDSC_CMD.
##
## No --help entry: this is internal plumbing. The generic write mechanism
## every --member-upsert-inbox-note/--member-upsert-member-inquiry/
## --member-upsert-inbox-reflection wrapper calls -- each wrapper validates
## and forwards its own allowed argument set, none of them call each other.
##
## <member> <item-filename> [--from-file <path>|--edit-patch-from-stdin]
##
## Content resolution: stdin by default; --from-file <path> reads the given
## file instead; --edit-patch-from-stdin reads a JSON array of
## {"old": <text>, "new": <text>, "replace_all": <bool, default false>}
## patch objects from stdin and applies each, in order, against the
## existing target content (empty if the target doesn't exist yet) as an
## exact literal (non-regex) substring match-and-replace -- same semantics,
## same externalized AgentsBoardItemPatchApply.py, as
## --intern-op-board-upsert-move-edit's own --edit-patch-from-stdin. The
## three body-input modes are mutually exclusive.
##

case "$1" in

	--intern-op-member-inbox-upsert)
		shift
		## --context <caller-op>: see AgentsTools.InternOpBoardUpsertMoveEdit.include's
		## own copy of this block for the full reasoning. Pre-scanned before any
		## validation so every message here can name the invoking operation;
		## the option loop below consumes it again as an ordinary option.
		local opContext="<no --context given>"
		local ctxWanted="" ctxArg
		for ctxArg in "$@" ; do
			if [ -n "$ctxWanted" ] ; then
				opContext="$ctxArg" ; ctxWanted="" ; continue
			fi
			if [ "$ctxArg" = "--context" ] ; then ctxWanted="1" ; fi
		done
		local memberName="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$memberName" ] || [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-op-member-inbox-upsert (internal operation, invoked via $opContext): syntax is <member> <item-filename> -- content via stdin, --from-file <path>, or --edit-patch-from-stdin" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$memberName" "<member>" "$MDSC_CMD --intern-op-member-inbox-upsert (internal operation, invoked via $opContext)" || { set +e ; return 1 ; }
		AgentsToolsAssertBareName "$itemName" "<item-filename>" "$MDSC_CMD --intern-op-member-inbox-upsert (internal operation, invoked via $opContext)" || { set +e ; return 1 ; }
		local memberDir="$HOME/.claude/skills/$memberName"
		if [ ! -d "$memberDir" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-op-member-inbox-upsert (internal operation, invoked via $opContext): no such member skill directory: $memberDir" >&2
			set +e ; return 1
		fi
		[ -n "${MDAT_DATA_ROOT:-}" ] || {
			echo "⛔ ERROR: $MDSC_CMD --intern-op-member-inbox-upsert (internal operation, invoked via $opContext): MDAT_DATA_ROOT is not set" >&2
			set +e ; return 1
		}
		local inboxDir="$MDAT_DATA_ROOT/inboxes/$memberName"
		mkdir -p "$inboxDir" || {
			echo "⛔ ERROR: $MDSC_CMD --intern-op-member-inbox-upsert (internal operation, invoked via $opContext): can't create inbox directory: $inboxDir" >&2
			set +e ; return 1
		}
		local target="$inboxDir/$itemName"
		local content contentFromFile="false" bodyMode="" bodyModeCount=0
		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-file)
					if [ -z "$2" ] || [ ! -f "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --intern-op-member-inbox-upsert (internal operation, invoked via $opContext): --from-file: file not found: $2" >&2
						set +e ; return 1
					fi
					content="$( cat "$2" )"
					contentFromFile="true"
					bodyMode="file"
					bodyModeCount=$(( bodyModeCount + 1 ))
					shift 2
				;;
				--edit-patch-from-stdin)
					bodyMode="patch"
					bodyModeCount=$(( bodyModeCount + 1 ))
					shift
				;;
				--context)
					if [ -z "${2:-}" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --intern-op-member-inbox-upsert (internal operation, invoked via $opContext): --context: value required" >&2
						set +e ; return 1
					fi
					shift 2
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --intern-op-member-inbox-upsert (internal operation, invoked via $opContext): unrecognized argument: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ "$bodyModeCount" -gt 1 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-op-member-inbox-upsert (internal operation, invoked via $opContext): --from-file and --edit-patch-from-stdin are mutually exclusive" >&2
			set +e ; return 1
		fi
		if [ "$bodyMode" = "patch" ] ; then
			local patchJson existingContent contentFile patchFile
			patchJson="$( cat )"
			if [ -f "$target" ] ; then existingContent="$( cat "$target" )" ; else existingContent="" ; fi
			contentFile="$MMDAPP/.local/temp/mdat-member-inbox-patch-content.$$"
			mkdir -p "$MMDAPP/.local/temp" && : > "$contentFile" || { set +e ; return 1 ; }
			patchFile="$MMDAPP/.local/temp/mdat-member-inbox-patch-spec.$$"
			mkdir -p "$MMDAPP/.local/temp" && : > "$patchFile" || { set +e ; return 1 ; }
			printf '%s' "$existingContent" > "$contentFile"
			printf '%s' "$patchJson" > "$patchFile"
			content="$( python3 "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsBoardItemPatchApply.py" "$contentFile" "$patchFile" )" || { rm -f "$contentFile" "$patchFile" ; set +e ; return 1 ; }
			rm -f "$contentFile" "$patchFile"
		else
			[ "$contentFromFile" = "true" ] || content="$( cat )"
		fi
		if [ -z "$content" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-op-member-inbox-upsert (internal operation, invoked via $opContext): empty content -- refusing to write an empty inbox item" >&2
			set +e ; return 1
		fi
		printf '%s\n' "$content" > "$target"
		echo "# $MDSC_CMD --intern-op-member-inbox-upsert: wrote $target ($( printf '%s\n' "$content" | wc -l | tr -d '[:space:]' ) lines)" >&2
		return 0
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1 (invoked via $opContext)" >&2
		set +e ; return 1
	;;
esac
