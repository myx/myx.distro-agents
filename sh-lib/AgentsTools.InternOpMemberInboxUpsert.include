#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.InternOpMemberInboxUpsert.include -- the
## --intern-op-member-inbox-upsert op for DistroAgentsTools.fn.sh's
## dispatcher. Sourced lazily from that exact op's own dispatcher arm (not a
## wildcard -- this file holds one op only) via the standard
## $MDLT_ORIGIN-based path. Not standalone: relies on being dot-sourced for
## $1/$@/$MDSC_CMD.
##

. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.OutputStyle.include"

case "$1" in

	--intern-op-member-inbox-upsert)
		shift
		local opContext="<no --context given>"
		local ctxWanted="" ctxArg
		for ctxArg in "$@" ; do
			if [ -n "$ctxWanted" ] ; then
				opContext="$ctxArg" ; ctxWanted="" ; continue
			fi
			if [ "$ctxArg" = "--context" ] ; then ctxWanted="1" ; fi
		done
		local memberName="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$memberName" ] || [ -z "$itemName" ] ; then
			echo "$MDSC_CMD: member-inbox-upsert: ⛔ ERROR: syntax is <member> <item-filename> [--from-member <member>] -- content via stdin, --from-file <path>, or --edit-patch-from-stdin" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$memberName" "<member>" member-inbox-upsert || { set +e ; return 1 ; }
		AgentsToolsAssertBareName "$itemName" "<item-filename>" member-inbox-upsert || { set +e ; return 1 ; }
		local memberDir="$MDAT_SKILLSET_ROOT/$memberName"
		if [ ! -d "$memberDir" ] ; then
			echo "$MDSC_CMD: member-inbox-upsert: ⛔ ERROR: no such member skill directory: $memberDir" >&2
			set +e ; return 1
		fi
		[ -n "${MDAT_DATA_ROOT:-}" ] || {
			echo "$MDSC_CMD: member-inbox-upsert: ⛔ ERROR: MDAT_DATA_ROOT is not set" >&2
			set +e ; return 1
		}
		local inboxDir="$MDAT_DATA_ROOT/inboxes/$memberName"
		mkdir -p "$inboxDir" || {
			echo "$MDSC_CMD: member-inbox-upsert: ⛔ ERROR: can't create inbox directory: $inboxDir" >&2
			set +e ; return 1
		}
		local target="$inboxDir/$itemName"
		local content contentFromFile="false" bodyMode="" bodyModeCount=0
		## Who is writing: the `from` a new item is stamped with when its content names none.
		## A spawned session's own member when not given; nothing is guessed beyond that.
		local fromMember="${MDAT_SPAWN_AGENT:-}"
		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-file)
					if [ -z "$2" ] || [ ! -f "$2" ] ; then
						echo "$MDSC_CMD: member-inbox-upsert: ⛔ ERROR: --from-file: file not found: $2" >&2
						set +e ; return 1
					fi
					content="$( cat "$2" )"
					contentFromFile="true"
					bodyMode="file"
					bodyModeCount=$(( bodyModeCount + 1 ))
					shift 2
				;;
				--edit-patch-from-stdin)
					bodyMode="patch"
					bodyModeCount=$(( bodyModeCount + 1 ))
					shift
				;;
				--from-member)
					if [ -z "${2:-}" ] ; then
						echo "$MDSC_CMD: member-inbox-upsert: ⛔ ERROR: --from-member: value required" >&2
						set +e ; return 1
					fi
					AgentsToolsAssertBareName "$2" "--from-member" member-inbox-upsert || { set +e ; return 1 ; }
					fromMember="$2"
					shift 2
				;;
				--context)
					if [ -z "${2:-}" ] ; then
						echo "$MDSC_CMD: member-inbox-upsert: ⛔ ERROR: --context: value required" >&2
						set +e ; return 1
					fi
					shift 2
				;;
				*)
					echo "$MDSC_CMD: member-inbox-upsert: ⛔ ERROR: unrecognized argument: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ "$bodyModeCount" -gt 1 ] ; then
			echo "$MDSC_CMD: member-inbox-upsert: ⛔ ERROR: --from-file and --edit-patch-from-stdin are mutually exclusive" >&2
			set +e ; return 1
		fi
		if [ "$bodyMode" = "patch" ] ; then
			local patchJson existingContent
			patchJson="$( cat )"
			if [ -f "$target" ] ; then existingContent="$( cat "$target" )" ; else existingContent="" ; fi
			content="$( printf '%s%s' "$patchJson" "$existingContent" | python3 "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsBoardItemPatchApply.py" "$opContext" )" || { set +e ; return 1 ; }
		else
			[ "$contentFromFile" = "true" ] || content="$( cat )"
			## Measured, never refused: this tier reports and the write proceeds.
			## Only this branch carries the caller's own new text -- a patch merges
			## into content somebody else wrote, and measuring that would report
			## against the wrong author.
			printf '%s' "$content" | AgentsToolsOutputStyleRefusal "$memberName" "" "$itemName" "" none || :
		fi
		if [ -z "$content" ] ; then
			echo "$MDSC_CMD: member-inbox-upsert: ⛔ ERROR: empty content -- refusing to write an empty inbox item" >&2
			set +e ; return 1
		fi
		## A new item's name is checked against the naming Rule: said, never refused, and
		## never rewritten. An item that already exists is updated under the name it has.
		if [ ! -f "$inboxDir/$itemName" ] ; then
			. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.ItemNameShape.include"
			AgentsToolsItemNameShapeCheck "$itemName" member-inbox-upsert "new item"
			## An inbox holds inbox types, and a board type here is misfiled.
			case "$( AgentsToolsItemNameType "$itemName" )" in
				note|inquiry|reflection) ;;
				*) echo "$MDSC_CMD: member-inbox-upsert: ⚠️ WARNING: $itemName is not an inbox type (note-*, inquiry-*, reflection-*) -- a board type filed in an inbox is misfiled; written anyway" >&2 ;;
			esac
		fi
		target="$inboxDir/$itemName"
		## created vs updated is decided before the write, while the target's
		## prior presence still tells the two apart.
		local existedBefore="false"
		if [ -f "$target" ] ; then existedBefore="true" ; fi

		## A new item's required headers -- type, from, date, owner -- stamped only where the
		## content names none of them: type from the name's prefix, from the writing member
		## when known, date now, owner the member whose inbox this is. Never on an update:
		## those are creation facts, and the one updating is not the one who created it.
		## A body opening a frontmatter block it never closes is written as given, as before:
		## there is no frontmatter to complete, and the header awk would refuse it.
		local openFrontmatter="false"
		if [ "${content%%$'\n'*}" = "---" ] && [ "$( printf '%s\n' "$content" | LC_ALL=C awk -v fieldName=type -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsBoardItemFrontmatterFieldProbe.awk" )" = "NONE" ] ; then
			openFrontmatter="true"
		fi
		if [ "$existedBefore" = "false" ] && [ "$openFrontmatter" = "false" ] ; then
			[ -n "$fromMember" ] && AgentsToolsAssertBareName "$fromMember" "MDAT_SPAWN_AGENT" member-inbox-upsert 2>/dev/null || fromMember=""
			local createDefaults="" createType
			createType="$( AgentsToolsItemNameType "$itemName" )"
			[ -z "$createType" ] || createDefaults="default"$'\t'"type"$'\t'"$createType"$'\n'
			[ -z "$fromMember" ] || createDefaults="${createDefaults}default"$'\t'"from"$'\t'"$fromMember"$'\n'
			createDefaults="${createDefaults}default"$'\t'"date"$'\t'"$( date +"%Y-%m-%d %H:%M %z" )"$'\n'
			createDefaults="${createDefaults}default"$'\t'"owner"$'\t'"$memberName"$'\n'
			## Same ops file discipline as --intern-op-board-upsert-move-edit: a real path the
			## awk reads, made and removed inside this one subshell.
			content="$(
				headerOpsFile="$MMDAPP/.local/temp/mdat-intern-op-inbox-headers.$$"
				trap 'rm -f "$headerOpsFile"' EXIT
				mkdir -p "$MMDAPP/.local/temp" || exit 1
				printf '%s' "$createDefaults" > "$headerOpsFile" || exit 1
				printf '%s\n' "$content" | LC_ALL=C awk -v opsFile="$headerOpsFile" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsBoardItemHeaderOpsApply.awk"
			)" || { set +e ; return 1 ; }
		fi
		printf '%s\n' "$content" > "$target"
		echo "# $MDSC_CMD: member-inbox-upsert: wrote ${target#"$inboxDir"/} ($( printf '%s\n' "$content" | wc -l | tr -d '[:space:]' ) lines)" >&2

		## Commit gate: .git presence in the team-data root, presence only --
		## this op never pushes. Mirrors --intern-op-board-upsert-move-edit.
		local repoRoot=""
		repoRoot="$( git -C "$MDAT_DATA_ROOT" rev-parse --show-toplevel 2>/dev/null )" || repoRoot=""
		if [ -n "$repoRoot" ] ; then
			local msgPrefix="+" msgAction="created"
			if [ "$existedBefore" = "true" ] ; then msgPrefix="*" ; msgAction="updated" ; fi
			local ctxForMsg="$opContext"
			if [ "$ctxForMsg" = "<no --context given>" ] ; then ctxForMsg="--intern-op-member-inbox-upsert" ; fi
			local gitOut="" gitRc=0
			gitOut="$( git -C "$repoRoot" add -- "$target" 2>&1 )" || gitRc=$?
			if [ "$gitRc" -ne 0 ] ; then
				echo "$MDSC_CMD: member-inbox-upsert: ⛔ ERROR: git add failed for $target: $gitOut" >&2
				set +e ; return 1
			fi
			gitOut="$( git -C "$repoRoot" commit -m "$msgPrefix $msgAction: $ctxForMsg" -- "$target" 2>&1 )" || gitRc=$?
			if [ "$gitRc" -ne 0 ] ; then
				echo "$MDSC_CMD: member-inbox-upsert: ⛔ ERROR: git commit failed for $target: $gitOut" >&2
				set +e ; return 1
			fi
			echo "# $MDSC_CMD: member-inbox-upsert: committed ${target#"$MDAT_DATA_ROOT"/}" >&2
		fi
		return 0
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
