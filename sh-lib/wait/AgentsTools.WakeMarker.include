#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.WakeMarker.include -- THE WAKE MARKER of a member: one small file per member, written the moment a
## message addressed to that member is posted, and watched by that member's waiting session, so the wait is woken
## by the ARRIVAL instead of by its next look at a costly source.
##
## WHY IT EXISTS. A wait reads its local sources -- an inbox, a board state, the session chat file, this marker --
## out of files, which costs nothing, so it can read them every second. A Slack source costs a request of the
## team's own budget (about fifty a minute for the app, shared by every host and session of it), so a wait must
## not read one that often; it looks at those on a gap that grows from five seconds to five minutes. Without a
## marker that gap IS the wake latency of a message from one of our own members, which is what the owner
## reported: a coordinator's direct message to a member sat unread for minutes. But that message is posted by
## this host -- the send operation runs here -- so the arrival is known here at once. The sender writes this
## marker, the recipient's wait sees it within a tick, and the wait reads its costly sources immediately
## instead of at their next scheduled look.
##
## THE FILE IS ONE LINE: `<epoch> <seq> <who>`. The sequence is what makes two messages in one second two
## wake-ups -- a wait compares the rendering of the source, and an unchanged line is no arrival. It lives under
## the workspace's `.local/agents/`, never in the team data: it is a signal between this host's own processes,
## and nothing another host, a clone or the manager should read as its own.
##
## IT IS NO ARRIVAL OF ITS OWN. What it says is not what a member is to read: the message itself is carried by
## the source that reads that conversation, and a wait that returned the marker would return nothing a person
## could read. So a wait takes it as read and reads its sources again (AgentsTools.MemberWait.include).
## Sourced, never run. Functions only.
##

## The marker of a member: nothing for a name that is no member name, or for a workspace with no `.local`.
AgentsToolsWakePath(){ ## team member
	local wakeName="$1"
	[ -n "${MMDAPP:-}" ] || return 1
	case "$wakeName" in ''|.|..|*/*|*[[:space:]]*) return 1 ;; esac
	printf '%s' "$MMDAPP/.local/agents/wake/$wakeName"
}

## Writes the marker of a member: one line, the moment, a sequence one past what the file held, and who wrote it.
## Quiet and best effort, and never locked: a marker that cannot be written must not fail the message it follows
## (the wait still finds that message at its next look of the costly sources), and two writers at once can only
## lose one increment, which merges two wake-ups of one second into one -- the message they announce is still
## there for the next look.
AgentsToolsWakeTouch(){ ## team member, who wrote it (may be empty)
	local wakeTarget="$1" wakeFrom="${2:-}" wakeFile wakeLine="" wakeAt wakeSeq wakeTemp
	wakeFile="$( AgentsToolsWakePath "$wakeTarget" )" || return 0
	mkdir -p "${wakeFile%/*}" 2> /dev/null || return 0
	{ IFS= read -r wakeLine < "$wakeFile" ; } 2> /dev/null || wakeLine=""
	wakeSeq="${wakeLine#* }" ; wakeSeq="${wakeSeq%% *}"
	case "$wakeSeq" in ''|*[!0123456789]*) wakeSeq=0 ;; esac
	wakeAt="$( date +%s )" || return 0
	wakeTemp="$( mktemp "$wakeFile.tmp.XXXXXX" )" || return 0
	{ printf '%s %s %s\n' "$wakeAt" "$(( wakeSeq + 1 ))" "$wakeFrom" > "$wakeTemp" && chmod 644 "$wakeTemp" && mv -f "$wakeTemp" "$wakeFile" ; } 2> /dev/null \
		|| { rm -f "$wakeTemp" 2> /dev/null ; return 0 ; }
	AgentsToolsWakePoke "$wakeTarget"
	return 0
}

## THE SESSION A MEMBER'S DIRECT MESSAGES ENTER (S12.29): the member's live session whose stored wait carries its own `wake:` source,
## else the oldest of its live sessions. One fact has one carrier, and the marker a member's waits already hold is that carrier, so the
## import needs no new store and no per-session choice by hand. Prints the session id; rc 1, nothing printed, for a member with no live
## session here. Reads the kept list of started records, its own headers, and one wait state a session, walking no store: the oldest is
## the record the others are not older than, compared by the shell's own `-ot`, so no start is read from a date.
AgentsToolsWakeSession(){ ## team member
	local wakeOf="${1:-}" wakeRecord wakeOwner wakeSession wakeOldest="" wakeOldestRecord="" wakeNamed="" wakeNamedRecord="" wakeSources=""
	type AgentsToolsSpawnedStartedRecords > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/schedule/AgentsTools.StartedRecords.include"
	type AgentsToolsFrontmatterKey > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/common/AgentsTools.FrontmatterKey.include"
	type AgentsSessionWaitSourcesLineInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.include"
	case "$wakeOf" in ''|*/*|*[[:space:]]*) return 1 ;; esac
	while IFS= read -r wakeRecord ; do
		[ -n "$wakeRecord" ] && [ -f "$wakeRecord" ] || continue
		wakeOwner="$( AgentsToolsFrontmatterKey "$wakeRecord" owner )"
		[ "$wakeOwner" = "$wakeOf" ] || continue
		wakeSession="$( AgentsToolsFrontmatterKey "$wakeRecord" session-id )"
		case "$wakeSession" in ''|-|.|..|*/*|*[[:space:]]*) continue ;; esac
		## A wait that stands names the session its member's messages enter; among several, the one that began first.
		wakeSources=""
		AgentsSessionWaitSourcesLineInto wakeSources "$wakeSession"
		case " $wakeSources " in
			*" wake:$wakeOf "*)
				if [ -z "$wakeNamed" ] || [ "$wakeRecord" -ot "$wakeNamedRecord" ] ; then wakeNamed="$wakeSession" ; wakeNamedRecord="$wakeRecord" ; fi
				continue
			;;
		esac
		[ -n "$wakeOldest" ] && ! [ "$wakeRecord" -ot "$wakeOldestRecord" ] && continue
		wakeOldest="$wakeSession" ; wakeOldestRecord="$wakeRecord"
	done <<< "$( AgentsToolsSpawnedStartedRecords 2> /dev/null )"
	[ -z "$wakeNamed" ] || { printf '%s\n' "$wakeNamed" ; return 0 ; }
	[ -n "$wakeOldest" ] || return 1
	printf '%s\n' "$wakeOldest"
	return 0
}

## POKES THE NAP OF THE WAITS: a wait naps on a fifo it holds both ends of (nap.fifo in its folder, AgentsTools.MemberWaitRun.include), and a line written
## into it ends that nap at once, so the wait looks at its sources now and not at the end of its nap. This is what lets a wait nap long: the writers of
## what it watches poke it, and the nap's length is only the fallback for a writer that does not. A poke is one newline; a wait that wakes reads its
## sources (a pointer against a file size, for a chat file) and naps again. With a member, the waits of that member; with none, every wait of the workspace.
## The fifo is opened read-write, which never blocks, in a subshell so the descriptor is never kept; a wait that is gone leaves a pipe nobody reads, which
## the system frees when this one closes. Quiet and best effort.
AgentsToolsWakePoke(){ ## team member (may be empty: every wait)
	local pokeBase="" pokeDir pokePointer pokeTarget
	[ -n "${MMDAPP:-}" ] || return 0
	case "${1:-}" in */*|*[[:space:]]*) return 0 ;; esac
	## The wait folders of the member, and with none, those of every member: the base is the member's own folder, then one folder a
	## wait. A session's wait keeps its folder under that session, where this cannot reach, so it publishes its fifo's path in the
	## member's own folder, one small file a run.
	[ -z "${1:-}" ] || pokeBase="$1"
	for pokeDir in "$MMDAPP/.local/temp/mdat-member-wait${pokeBase:+.${pokeBase}}" "$MMDAPP/.local/temp/mdat-member-wait${pokeBase:+.${pokeBase}}."*/ ; do
		[ -d "$pokeDir" ] || continue
		## The star is outside the quotes, where a glob works.
		for pokePointer in "$pokeDir"/nap.fifo "$pokeDir"/nap.run.* ; do
			if [ -p "$pokePointer" ] ; then
				pokeTarget="$pokePointer"
			else
				[ -f "$pokePointer" ] || continue
				pokeTarget=""
				{ IFS= read -r pokeTarget < "$pokePointer" ; } 2> /dev/null || continue
			fi
			[ -p "$pokeTarget" ] || continue
			( exec 7<> "$pokeTarget" && printf '\n' >&7 ) 2> /dev/null || :
		done
	done
	return 0
}
