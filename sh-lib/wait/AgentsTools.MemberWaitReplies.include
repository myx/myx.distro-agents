#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only
type AgentsOwnPostsHas > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.OwnPosts.include"
type AgentsToolsAssertBareName > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.BareName.include"
type AgentsSessionThread > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.include"
type AgentsSlackIdentityId > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/slack/AgentsTools.SlackIdentities.include"

##
## AgentsTools.MemberWaitReplies.include -- the probe of the replies to the run's own posts.
## Sourced by --wait-for-input for a source of its kind, and by a caller that needs one probe of it.
## Its helpers shared with the other probes are in AgentsTools.MemberWaitCore.include.
##
type AgentsWaitPut > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/wait/AgentsTools.MemberWaitCore.include"
type AgentsWaitReadRendered > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/wait/AgentsTools.MemberWaitSlack.include"

## THE REPLIES TO THE RUN'S OWN POSTS: the floor of a plain Wait, `replies:<session id>`. A run that
## posted a question does not choose where to watch for the answer, a channel or a thread: it calls
## Wait, and Wait holds every post the run made. They are in sessions/<id>/last-own-post, written at
## each send (AgentsHarnessOwnPostRecord), a line each, the latest first: `<channel>:<thread> <ts>
## <addressees> <thread floor> <conversation floor> <siblings> <reactions> <checked>`, a word not known
## yet `-`. What a post holds, as the epic's floor reads (F3.3):
##   - every reply in its thread where the post opens it, the run's own posts apart (AgentsWaitOwnPostReplies.awk, mode thread);
##     inside another's thread, only the messages of the people it addressed and those that mention the run (mode channel);
##   - for a post at the top of its conversation, the messages after it there from the people it
##     addressed, and any that mention the run, until ten siblings have followed it. After that its
##     siblings are no longer watched: the conversation is read on from where it stopped for a mention
##     of the run alone. The thread is read as ever: its watch does not end by time alone;
##   - the reactions to the post, and the mentions of the run, whatever else has ended.
## A post is looked at only when its TTL has passed since the last look (<checked>): 5 seconds, and 1 more
## for every 20 it has been quiet, from its newest message seen, to a ceiling of 100 at 1900 quiet (S21.2), so a
## quiet thread is looked at ever more rarely, on some loop runs only, and is never dropped. A post whose thread another source
## of the same Wait reads is left to that source, and so is a conversation it reads by name, so a message
## is returned once; a post a question (AskQuestion and its kin) opened belongs to its pending record's
## ask: source. What a look finds is rendered to the wait and stored only once the wait has returned it
## (AgentsOwnPostsReplace): a wait that ended before it was said loses nothing. The words stored are
## this record's, the one record of the run's own posts.
agentsWaitRepliesSiblings=10

## A value of a side file the reading awk wrote, `<key> <value>` a line.
## THE SLACK ACCOUNTS THAT REACT FOR THE TEAM, spaced: the bot's own account, and every member's account this workspace knows. A
## reaction only they hold is the tooling's own and no input to handle (S6.38: the human-owner's rule is at least the bot's reactions on
## a session root message). Both are files the workspace already keeps, so this starts no request of its own:
## `.local/cache/comms/slack/.user-id-<member>.txt` (`<epoch> <U-id>`, what the tooling reacts as), and the mention-id cache. One awk
## over a few small files, once for the process.
AgentsToolsWaitOursReactIds(){
	if [ -z "${agentsWaitOursReactIds+set}" ] ; then
		agentsWaitOursReactIds=""
		if [ -n "${MMDAPP:-}" ] ; then
			agentsWaitOursReactIds="$( AgentsSlackIdentityOwnIds | LC_ALL=C awk 'NF { printf "%s ", $0 ; }' )"
		fi
	fi
	printf '%s' "${agentsWaitOursReactIds% }"
}

AgentsWaitRepliesSide(){ ## side file, key
	LC_ALL=C awk -v wantKey="$2" '$1 == wantKey { sub(/^[^ ]+ /, "") ; print ; exit ; }' "$1" 2> /dev/null
}

## One post of the record: looked at when its TTL has passed. Appends what it found to the rendering
## file ($4) and its new line to $4.advance. rc 0 looked, 1 left alone (not due, or not this floor's), 2 could not be read.
## A post that could not be read is not looked at again at the next round: it keeps its words and has its
## check time moved, so the TTL paces the retry.
AgentsWaitRepliesLook(){ ## member, now (epoch), the post's line, the rendering file, a number for its working files
	local lookRc=0 lookFail
	AgentsWaitRepliesLookRead "$@" || lookRc=$?
	if [ "$lookRc" = "2" ] ; then
		lookFail="$( printf '%s\n' "$3" | LC_ALL=C awk -v now="$2" '{ print $1 " " $2 " " ( NF >= 3 ? $3 : "-" ) " " ( NF >= 4 ? $4 : "-" ) " " ( NF >= 5 ? $5 : "-" ) " " ( NF >= 6 ? $6 : 0 ) " " ( NF >= 7 ? $7 : "-" ) " " now ; }' )"
		printf '%s\n' "$lookFail" >> "$4.advance"
	fi
	return "$lookRc"
}

## THE RUN'S OWN BEGINNING (S6.39): the launch marker this run was given, else the launch the session folder keeps, read once
## for the wait into agentsWaitRepliesStart. A post never looked at is watched from here, never from its own ts. A run the
## tooling launched through no marker has none, and such a post keeps the older floor its line carries. It sets the variable,
## never prints it: a command substitution would set it in a subshell and lose it.
AgentsWaitRepliesStart(){
	[ -z "${agentsWaitRepliesStartSeen:-}" ] || return 0
	agentsWaitRepliesStartSeen="yes"
	type AgentsSessionLaunchEpochInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.include"
	AgentsSessionLaunchEpochInto agentsWaitRepliesStart "${waitSessionId:-}" "${MDAT_SPAWN_LAUNCH_MARKER:-}"
	return 0
}

AgentsWaitRepliesLookRead(){ ## the same arguments
	local lookMember="$1" lookNow="$2" lookOut="$4" lookFile="$4.post.$5" lookRc=0
	local lookWhere lookTs lookAddr lookThreadFloor lookChanFloor lookSibs lookReact lookChecked lookRest
	local lookChannel lookThread lookActivity lookQuiet lookTtlQuiet lookFrom lookDeliver=1 lookChannelCovered="" lookFound="" lookSide lookNew
	local lookNewThreadFloor lookNewChanFloor lookNewSibs lookNewReact lookReactions lookSignature lookMentionsOnly lookStart
	read -r lookWhere lookTs lookAddr lookThreadFloor lookChanFloor lookSibs lookReact lookChecked lookRest <<< "$3"
	lookAddr="${lookAddr:--}" ; lookThreadFloor="${lookThreadFloor:--}" ; lookChanFloor="${lookChanFloor:--}"
	lookSibs="${lookSibs:-0}" ; lookReact="${lookReact:--}" ; lookChecked="${lookChecked:-0}"
	case "$lookTs" in ''|.*|*.|*.*.*|*[!0-9.]*) return 1 ;; esac
	case "$lookSibs$lookChecked" in ''|*[!0-9]*) return 1 ;; esac
	case "$lookWhere" in
		*:*) lookChannel="${lookWhere%:*}" ; lookThread="${lookWhere##*:}" ;;
		*) return 1 ;;
	esac
	case "$lookThread" in ''|.*|*.|*.*.*|*[!0-9.]*) return 1 ;; esac
	## Quiet since its newest message seen: the TTL grows with it.
	lookActivity="${lookTs%%.*}"
	for lookRest in "$lookThreadFloor" "$lookChanFloor" ; do
		lookRest="${lookRest%%.*}"
		case "$lookRest" in ''|*[!0-9]*) continue ;; esac
		[ "$lookRest" -le "$lookActivity" ] || lookActivity="$lookRest"
	done
	lookQuiet=$(( lookNow - lookActivity ))
	[ "$lookQuiet" -ge 0 ] || lookQuiet=0
	## Backing off linearly to a ceiling of 100 at 1900 quiet, never past it (S21.2): a run quiet for a long time
	## still watches its own posts, rather than drifting toward an unbounded wait.
	lookTtlQuiet="$lookQuiet" ; [ "$lookTtlQuiet" -le 1900 ] || lookTtlQuiet=1900
	[ $(( lookNow - lookChecked )) -ge $(( 5 + lookTtlQuiet / 20 )) ] || return 1
	## What the other sources of this wait read, found once for the call and the first post that needs it.
	[ "$agentsWaitCovered" != "?" ] || agentsWaitCovered="$( AgentsWaitCoveredSet "$lookMember" $agentsWaitCoverSources )"
	## A post in a thread another source reads is not read from Slack again.
	case " $agentsWaitCovered " in *" $lookChannel:$lookThread "*) return 1 ;; esac
	## Nor one in the session thread, while the chat source reads that thread from the session's file (sketch 12.1).
	case " ${waitSources:-} " in
		*" chat:"*)
			if [ -z "${agentsWaitRepliesSessionThread+x}" ] ; then
				agentsWaitRepliesSessionThread="${MDAT_SESSION_THREAD:-}"
				[ -n "$agentsWaitRepliesSessionThread" ] || agentsWaitRepliesSessionThread="$( AgentsSessionThread "${waitSessionId:-.}" )" || agentsWaitRepliesSessionThread=""
			fi
			[ "$lookChannel:$lookThread" != "$agentsWaitRepliesSessionThread" ] || return 1
		;;
	esac
	## A question the ask tools opened, and the thread it lives in, are answered through its pending record --
	## its answer, its clicks, what the person adds -- which the stored wait carries as an ask: source.
	LC_ALL=C grep -q -x -F -e "question-ts: $lookTs" -e "thread-ts: $lookThread" "$MMDAPP/.local/agents/pending"/*.md 2> /dev/null && return 1
	case " $agentsWaitCovered " in *" $lookChannel "*) lookChannelCovered=1 ;; esac
	lookNewThreadFloor="$lookThreadFloor" ; lookNewChanFloor="$lookChanFloor" ; lookNewSibs="$lookSibs" ; lookNewReact="$lookReact"
	## A POST NEVER LOOKED AT STARTS AT THE RUN'S OWN BEGINNING, never at its own ts (S6.39). What stands after the post but
	## before this run began is history: reading from the post handed it over as new and marked it seen, 373 of them over six
	## hours old on MDV for claims written on 3 November. Where the run began before the post, the post itself is the start.
	AgentsWaitRepliesStart ; lookStart="${agentsWaitRepliesStart:-}"
	if [ "$lookThreadFloor" = "-" ] && [ -n "$lookStart" ] && AgentsWaitTsNewer "$lookStart" "$lookTs" ; then
		lookNewThreadFloor="$lookStart"
	fi
	if [ "$lookChanFloor" = "-" ] && [ -n "$lookStart" ] && AgentsWaitTsNewer "$lookStart" "$lookTs" ; then
		lookNewChanFloor="$lookStart"
	fi
	## Its thread: every reply after the post, or after the last one returned. A post inside another's thread gets only its addressees and mentions.
	lookFrom="$lookTs"
	[ "$lookNewThreadFloor" = "-" ] || ! AgentsWaitTsNewer "$lookNewThreadFloor" "$lookFrom" || lookFrom="$lookNewThreadFloor"
	AgentsWaitReadRendered "$lookMember" "$lookChannel:$lookThread" thread "" "$lookFile.thread" || return 2
	## The sibling cap is off for a thread read: the awk reads nothing at a cap of 0, and a thread never holds a million.
	LC_ALL=C awk -v threadTs="$lookThread" -v addressees="${lookAddr//,/ }" -v siblingsMax=1000000 -v postTs="$lookTs" -v floorTs="$lookFrom" -v callerName="$lookMember" -v deliver="$lookDeliver" -v side="$lookFile.thread.side" \
		-v oursReactIds="$( AgentsToolsWaitOursReactIds )" -v callerId="$( AgentsSlackIdentityId "$lookMember" )" \
		-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsDismissalMatch.awk" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/wait/AgentsWaitOwnPostReplies.awk" \
		< "$lookFile.thread" > "$lookFile.thread.out" 2>> "$lookFile.thread.err" || lookRc=$?
	AgentsWaitOwnFile "$lookFile.thread.out" || return 2
	AgentsWaitOwnFile "$lookFile.thread.side" || return 2
	if [ "$lookRc" != "0" ] ; then
		[ ! -s "$lookFile.thread.err" ] || cat "$lookFile.thread.err" >&2
		return 2
	fi
	if [ "$lookDeliver" = "1" ] ; then
		lookSide="$( AgentsWaitRepliesSide "$lookFile.thread.side" newest )"
		[ "$lookSide" = "-" ] || [ -z "$lookSide" ] || lookNewThreadFloor="$lookSide"
	fi
	lookReactions="$( AgentsWaitRepliesSide "$lookFile.thread.side" reactions )"
	: > "$lookFile.chan.out"
	## Its conversation, for a post at the top of it: until ten siblings have followed, the people it
	## addressed and whoever mentions the run; after the tenth only a mention of the run, read on from
	## where the last read stopped, which is the cheapest read that finds one. Not where another source
	## of this wait reads the conversation by name.
	if [ "$lookThread" = "$lookTs" ] && [ -z "$lookChannelCovered" ] ; then
		lookMentionsOnly=0
		[ "$lookSibs" -lt "$agentsWaitRepliesSiblings" ] || lookMentionsOnly=1
		lookFrom="$lookTs"
		[ "$lookNewChanFloor" = "-" ] || ! AgentsWaitTsNewer "$lookNewChanFloor" "$lookFrom" || lookFrom="$lookNewChanFloor"
		## THE CONVERSATION NOT READ (its cache not pulled yet, or its read failed) TAKES NOTHING FROM THE THREAD: what the thread gave is
		## returned, and the conversation is read as empty, so its floor and its siblings stay where they were and its next look reads it
		## from the same place. Failing the look here threw away replies already read, and left the whole source unread (a run's first
		## look at a top-level post, whose conversation the comms thread had not pulled yet).
		if ! AgentsWaitReadRendered "$lookMember" "$lookChannel" conversation "$lookFrom" "$lookFile.chan" ; then
			: > "$lookFile.chan"
		fi
		## A top-level message is the reply of the LATEST post of the run above it in that conversation, and is returned once: what stands at or after the run's next
		## top-level post there belongs to that post, never to this one.
		if [ -n "${waitSessionId:-}" ] && AgentsOwnPostsHas "$waitSessionId" ; then
			local lookUntil
			lookUntil="$( LC_ALL=C awk -v channel="$lookChannel" -v after="$lookTs" '
				function secOf(v) { sub(/\..*$/, "", v) ; return ( v == "" ? 0 : v + 0 ) ; }
				function fracOf(v) { if ( v !~ /\./ ) { return "000000" ; } sub(/^[^.]*\./, "", v) ; return substr(v "000000", 1, 6) ; }
				function newer(a, b) { return ( secOf(a) > secOf(b) || ( secOf(a) == secOf(b) && fracOf(a) > fracOf(b) ) ) ; }
				{ split($1, where, ":") ; if ( where[1] == channel && where[2] == $2 && newer($2, after) && ( best == "" || newer(best, $2) ) ) { best = $2 ; } ; }
				END { print best ; }' 2> /dev/null <<< "$( AgentsOwnPostsLines "$waitSessionId" )" )" || lookUntil=""
			if [ -n "$lookUntil" ] ; then
				LC_ALL=C awk -v untilTs="$lookUntil" '
					function secOf(v) { sub(/\..*$/, "", v) ; return ( v == "" ? 0 : v + 0 ) ; }
					function fracOf(v) { if ( v !~ /\./ ) { return "000000" ; } sub(/^[^.]*\./, "", v) ; return substr(v "000000", 1, 6) ; }
					/^[0-9]+\.[0-9]+ \| / { keep = ( secOf(untilTs) > secOf($1) || ( secOf(untilTs) == secOf($1) && fracOf(untilTs) > fracOf($1) ) ) ; }
					NR == 1 && /^## target=/ { print ; next ; }
					keep || NR == 1 { print ; }' < "$lookFile.chan" > "$lookFile.chan.cut" 2> /dev/null && mv -f "$lookFile.chan.cut" "$lookFile.chan" || rm -f "$lookFile.chan.cut"
			fi
		fi
		LC_ALL=C awk -v mode=channel -v postTs="$lookTs" -v floorTs="$lookFrom" -v callerName="$lookMember" -v addressees="${lookAddr//,/ }" \
			-v siblings="$lookSibs" -v siblingsMax="$agentsWaitRepliesSiblings" -v mentionsOnly="$lookMentionsOnly" -v side="$lookFile.chan.side" \
			-v oursReactIds="$( AgentsToolsWaitOursReactIds )" -v callerId="$( AgentsSlackIdentityId "$lookMember" )" \
			-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsDismissalMatch.awk" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/wait/AgentsWaitOwnPostReplies.awk" \
			< "$lookFile.chan" > "$lookFile.chan.out" 2>> "$lookFile.chan.err" || lookRc=$?
		AgentsWaitOwnFile "$lookFile.chan.out" || return 2
		AgentsWaitOwnFile "$lookFile.chan.side" || return 2
		if [ "$lookRc" != "0" ] ; then
			[ ! -s "$lookFile.chan.err" ] || cat "$lookFile.chan.err" >&2
			return 2
		fi
		lookSide="$( AgentsWaitRepliesSide "$lookFile.chan.side" newest )"
		[ "$lookSide" = "-" ] || [ -z "$lookSide" ] || lookNewChanFloor="$lookSide"
		lookSide="$( AgentsWaitRepliesSide "$lookFile.chan.side" siblings )"
		case "$lookSide" in ''|*[!0-9]*) ;; *) lookNewSibs="$lookSide" ;; esac
	fi
	## A reaction to the post: returned when the post has a set it did not have when it was last returned.
	if [ -n "$lookReactions" ] && [ "$lookReactions" != "-" ] ; then
		lookSignature="$( printf '%s' "$lookReactions" | LC_ALL=C cksum | LC_ALL=C cut -d' ' -f1 )"
		if [ "$lookSignature" != "$lookReact" ] ; then
			lookNewReact="$lookSignature"
			lookFound="reactions on your post $lookTs: $lookReactions"
		fi
	fi
	## What the floor returns of this post is brought into the session chat file too, as replies to the member's own post
	## delivered by this wait itself (AgentsWaitChatImportReplies): the tool returns of its other runs carry them only
	## if this wait did not, and the file stays the record of the session.
	[ ! -s "$lookFile.thread.out" ] || AgentsWaitChatImportReplies "$lookMember" "$lookChannel:$lookThread" "$lookFile.thread.out" || :
	[ ! -s "$lookFile.chan.out" ] || AgentsWaitChatImportReplies "$lookMember" "$lookChannel:$lookThread" "$lookFile.chan.out" || :
	if [ -s "$lookFile.thread.out" ] || [ -s "$lookFile.chan.out" ] || [ -n "$lookFound" ] ; then
		printf '# replies to your post %s:%s\n' "$lookChannel" "$lookTs" >> "$lookOut"
		cat "$lookFile.thread.out" "$lookFile.chan.out" >> "$lookOut"
		[ -z "$lookFound" ] || printf '%s\n' "$lookFound" >> "$lookOut"
	fi
	lookNew="$lookWhere $lookTs $lookAddr $lookNewThreadFloor $lookNewChanFloor $lookNewSibs $lookNewReact $lookNow"
	printf '%s\n' "$lookNew" >> "$lookOut.advance"
	return 0
}

## The replies source: every post of the record that is due, oldest first. An unreadable post is left
## as it was and is looked at again; the source is unreadable only where every look failed.
AgentsWaitProbeReplies(){
	local probeMember="$1" probeSession="$2" probeOut="$4" probeNow probeLine probeCount=0 probeIndex probeAttempted=0 probeFailed=0 probeRc
	local probeLines=()
	AgentsWaitClear "$probeOut" || return 2
	AgentsWaitClear "$probeOut.advance" || return 2
	AgentsToolsAssertBareName "$probeSession" "<session-id>" replies > /dev/null 2>&1 || return 2
	AgentsOwnPostsHas "$probeSession" || return 0
	## The round's own moment where there is one: no date process per tick.
	probeNow="${roundNow:-}"
	case "$probeNow" in ''|*[!0-9]*) probeNow="$( date +%s )" ;; esac
	while IFS= read -r probeLine ; do
		[ -z "$probeLine" ] || { probeCount=$(( probeCount + 1 )) ; probeLines[$probeCount]="$probeLine" ; }
	done <<< "$( AgentsOwnPostsLines "$probeSession" )"
	## EVERY POST IS WATCHED, THREE A ROUND, THE ONE WHOSE CHECK HAS BEEN DUE LONGEST FIRST: a post's due moment is its last look plus its own TTL
	## (the look's rule), which the record carries, so the awk below puts the posts in the order of it. A post never looked at is due since
	## the beginning, and so goes first: the question an answer is due on is read at once. A Wait call starts its round count at 1 and a run
	## waits in short calls, so an order keyed on the round count looked at the newest posts alone, and a reply to an older post was never
	## read. A post is never dropped for its age or for the count of the record (a cap on the count alone dropped the newest).
	probeTake="${agentsWaitRepliesWatched:-3}"
	## THE THREE ARE THREE LOOKS, NOT THREE PLACES: a post its own TTL leaves alone (rc 1) reads nothing and costs nothing, so it
	## takes no place of the round's three; the round passes over it to the next, every post of the record at most once. Counted by
	## place, a round of three posts not due read nothing, and a reply under the fourth waited a round of the backoff more for each.
	## A POST ANOTHER LINE OF THE SAME THREAD COVERS IS NOT LOOKED AT: several posts of the run in one thread are one line each, and the
	## line whose window starts first (the later of its post and its thread floor), for the same addressees or as the thread's own top
	## post (every reply), returns every reply the other would. The covered one is passed over like a post not due, so the round's three
	## looks go to threads, not to copies of one. A top post is never passed over: it alone watches its conversation too.
	## ONE AWK GIVES BOTH: the covered indexes on its first line, the order of the posts by due moment on its second (ties keep the record's
	## order, the newest first).
	local probeCovered=" " probeInfo probeOrder
	probeInfo="$( printf '%s\n' "${probeLines[@]}" | LC_ALL=C awk -v now="$probeNow" '
		function newer( a, b ) { return ( a + 0 > b + 0 ) ; }
		NF >= 2 {
			n++ ; where[n] = $1 ; ts[n] = $2 ; addr[n] = ( $3 == "" ? "-" : $3 ) ; thread = $1 ; sub( /^.*:/, "", thread )
			from[n] = $2 ; if ( $4 != "-" && $4 != "" && newer( $4, $2 ) ) from[n] = $4
			top[n] = ( thread == $2 )
			quietFrom = int( $2 ) ; if ( $4 ~ /^[0-9]/ && int( $4 ) > quietFrom ) quietFrom = int( $4 ) ; if ( $5 ~ /^[0-9]/ && int( $5 ) > quietFrom ) quietFrom = int( $5 )
			quiet = now - quietFrom ; if ( quiet < 0 ) quiet = 0 ; if ( quiet > 1900 ) quiet = 1900
			due[n] = ( $8 ~ /^[0-9]+$/ && $8 + 0 > 0 ? $8 + 5 + int( quiet / 20 ) : 0 )
		}
		END {
			for ( i = 1 ; i <= n ; i++ ) {
				if ( top[i] ) continue
				for ( j = 1 ; j <= n ; j++ ) {
					if ( j == i || where[j] != where[i] ) continue
					if ( ! top[j] && addr[j] != addr[i] ) continue
					if ( newer( from[j], from[i] ) ) continue
					if ( from[j] == from[i] && j > i ) continue
					printf "%d ", i ; break
				}
			}
			printf "\n"
			for ( i = 1 ; i <= n ; i++ ) {
				for ( j = i - 1 ; j >= 1 && due[ord[j]] > due[i] ; j-- ) ord[j + 1] = ord[j]
				ord[j + 1] = i
			}
			for ( i = 1 ; i <= n ; i++ ) printf "%d ", ord[i]
		}' 2> /dev/null )"
	probeCovered=" ${probeInfo%%$'\n'*} " ; probeOrder="${probeInfo#*$'\n'}"
	probeWatched=0
	for probeStart in $probeOrder ; do
		[ "$probeWatched" -lt "$probeTake" ] || break
		probeRc=0
		case "$probeCovered" in
			*" $probeStart "*) probeRc=1 ;;
			*) AgentsWaitRepliesLook "$probeMember" "$probeNow" "${probeLines[$probeStart]}" "$probeOut" "$probeStart" || probeRc=$? ;;
		esac
		case "$probeRc" in
			0) probeAttempted=$(( probeAttempted + 1 )) ; probeWatched=$(( probeWatched + 1 )) ;;
			2) probeAttempted=$(( probeAttempted + 1 )) ; probeFailed=$(( probeFailed + 1 )) ; probeWatched=$(( probeWatched + 1 )) ;;
		esac
	done
	if [ "$probeAttempted" != "0" ] && [ "$probeFailed" -ge "$probeAttempted" ] ; then
		## The round that returns this stops short of the commit of a source that ran: the pacing is stored here.
		AgentsOwnPostsReplace "$probeSession" "$probeOut.advance"
		return 2
	fi
	return 0
}

## The replies to a post of the member, read by its own wait: the member's, and delivered by that wait.
AgentsWaitChatImportReplies(){ ## member, conversation:thread of the post, the rendering file
	local repliesSession
	type AgentsToolsSessionChatImport > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionChat.include"
	repliesSession="${MDAT_SESSION_ID:-${harnessSessionId:-${MDAT_SPAWN_SESSION_ID:-${CLAUDE_CODE_SESSION_ID:-}}}}"
	[ -n "$repliesSession" ] || return 0
	AgentsToolsSessionChatImport "$repliesSession" "$2" "$3" "reply:$1" "$1"
	return 0
}

