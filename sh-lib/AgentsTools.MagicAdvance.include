#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.MagicAdvance.include -- routine-advance's own --magic-advance-*
## operation group for DistroAgentsTools.fn.sh's dispatcher. Sourced lazily
## from the `--magic-advance-*)` wildcard arm via the standard
## $MDLT_ORIGIN-based path. Not standalone: relies on being dot-sourced for
## $1/$@/$MDSC_CMD.
##
## The two lock paths resync the board through myx.common git/cloneSync
## whenever TEAM_DATA_GIT_REMOTE is set, and the acquire path refuses a lock
## it cannot prove is the actual head's. See MAGIC.md, "The advance lock
## paths: resync, conflict check, and the unlock order".
##

## Runs the board's own resync primitive. Caller declares advanceSyncOut.
AgentsToolsAdvanceCloneSync(){
	local repoRoot="$1" originUrl="$2" lockBranch="$3"
	advanceSyncOut=""
	if [ -z "${MYXROOT:-}" ] || [ ! -f "$MYXROOT/bin/git/cloneSync.Common" ] ; then
		advanceSyncOut="myx.common git/cloneSync is not reachable (MYXROOT=${MYXROOT:-<unset>})"
		return 1
	fi
	local syncRc=0
	set +e
	advanceSyncOut="$( "$MYXROOT/bin/git/cloneSync.Common" --no-push "$repoRoot" "$originUrl" "$lockBranch" 2>&1 )"
	syncRc=$?
	set -e
	return "$syncRc"
}

## Refuses a lock whose local copy is in a state the checkout cannot vouch
## for -- an unresolved merge, or an edit that was never committed. Runs both
## before and after the resync: the resync itself can leave either state.
AgentsToolsAdvanceLockStateCheck(){
	local repoRoot="$1" lockRelPath="$2" opName="$3" phase="$4"
	local checkOut="" checkRc=0

	set +e
	checkOut="$( git -C "$repoRoot" ls-files -u -- "$lockRelPath" 2>&1 )"
	checkRc=$?
	set -e
	if [ "$checkRc" -ne 0 ] ; then
		echo "⛔ ERROR: $MDSC_CMD $opName: LOCK_UNCHECKABLE -- could not read the index state of $lockRelPath $phase: $checkOut" >&2
		return 1
	fi
	if [ -n "$checkOut" ] ; then
		echo "⛔ ERROR: $MDSC_CMD $opName: LOCK_CONFLICT -- $lockRelPath has unmerged index entries $phase; the checkout carries an unresolved merge and the lock must not be taken over it" >&2
		return 1
	fi

	if [ -f "$repoRoot/$lockRelPath" ] && LC_ALL=C grep -Eq '^(<<<<<<< |>>>>>>> )' "$repoRoot/$lockRelPath" ; then
		echo "⛔ ERROR: $MDSC_CMD $opName: LOCK_CONFLICT -- $lockRelPath carries merge conflict markers $phase; the lock must not be taken over it" >&2
		return 1
	fi

	set +e
	checkOut="$( git -C "$repoRoot" status --porcelain -- "$lockRelPath" 2>&1 )"
	checkRc=$?
	set -e
	if [ "$checkRc" -ne 0 ] ; then
		echo "⛔ ERROR: $MDSC_CMD $opName: LOCK_UNCHECKABLE -- could not read the working-tree state of $lockRelPath $phase: $checkOut" >&2
		return 1
	fi
	if [ -n "$checkOut" ] ; then
		echo "⛔ ERROR: $MDSC_CMD $opName: LOCK_CONFLICT -- $lockRelPath differs $phase from the commit it was checked out from ($checkOut); the lock must not be taken over an uncommitted local copy" >&2
		return 1
	fi
	return 0
}

## Refuses a lock whose local copy is not the one published on the branch head.
AgentsToolsAdvanceLockHeadCheck(){
	local repoRoot="$1" lockRelPath="$2" lockBranch="$3" opName="$4"
	local fetchOut="" fetchRc=0 headBlob="" remoteBlob=""

	## FETCH_HEAD, not origin/<branch>: an instrument that does not depend on
	## the resync having updated the remote-tracking ref.
	set +e
	fetchOut="$( git -C "$repoRoot" fetch origin "$lockBranch" 2>&1 )"
	fetchRc=$?
	set -e
	if [ "$fetchRc" -ne 0 ] ; then
		echo "⛔ ERROR: $MDSC_CMD $opName: LOCK_UNCHECKABLE -- could not fetch origin/$lockBranch to compare the lock against the actual head: $fetchOut" >&2
		return 1
	fi
	set +e
	headBlob="$( git -C "$repoRoot" rev-parse --verify --quiet "HEAD:$lockRelPath" 2>/dev/null )"
	remoteBlob="$( git -C "$repoRoot" rev-parse --verify --quiet "FETCH_HEAD:$lockRelPath" 2>/dev/null )"
	set -e
	if [ "$headBlob" != "$remoteBlob" ] ; then
		echo "⛔ ERROR: $MDSC_CMD $opName: LOCK_STALE -- $lockRelPath is ${headBlob:-absent} locally and ${remoteBlob:-absent} on origin/$lockBranch; the local copy is not the actual head's and the lock must not be taken over it" >&2
		return 1
	fi
	return 0
}

## Closes what a dead spawn left open, silently on stdout, so the reads after it see the moved items: a started sandbox record whose session
## is dead (a local one by process list, any other by age), the dispatch item it links, a running dispatch item whose own record already ended,
## and a review item whose reviewer session has ended.
AgentsToolsAdvanceSpawnHousekeeping(){ ## stale hours, calling member
	local staleHours="$1" spawnRoot="$MMDAPP/.local/agents/spawned"
	local measureText startedRows rowTracking rowSession rowParent rowHost rowOwner rowStatus rowExit rowSpawn rowAgentLog rowSessionThread rowWorkspace rowLive rowState
	local reviewBy reviewId sessionKind housekeepingLog=""
	## The one place the outcome word of a closed-by-tooling spawn is spelled; the status values are `spawn-` and `dispatch-` plus it.
	local endedOutcome="ended-without-close"
	local recordPath recordCandidate recordStatus recordExit rowSide linkField linkStem itemName itemState itemPath itemSpawn itemOutput targetState closeOutcome
	measureText="$( AgentsToolsRegistryRenderSpawnedSessions agents )"
	case "$measureText" in
		*"**NOTE:** no scan was made"*) return 0 ;;
	esac
	startedRows="$( printf '%s\n' "$measureText" | LC_ALL=C awk 'NF == 13 && $6 == "spawn-started" && $8 != "-" { print ; }' )"
	while read -r rowTracking rowSession rowParent rowHost rowOwner rowStatus rowExit rowSpawn rowAgentLog rowSessionThread rowWorkspace rowLive rowState ; do
		[ -n "$rowTracking" ] || continue
		recordPath="$spawnRoot/$rowTracking/$rowSpawn.md"
		[ -f "$recordPath" ] || continue
		case "$rowLive" in
			running) continue ;;
			no-process)
				[ "$rowState" != waiting ] || continue
				[ -z "$( find "$spawnRoot/$rowTracking" "$MMDAPP/.local/agents/sessions/$rowSpawn" "$MMDAPP/.local/agents/sessions/$rowSession" -type f -mmin -15 2> /dev/null | head -1 )" ] || continue
				rowSide=local
			;;
			*)
				if AgentsToolsRegistryPendingSessionOpen "$rowSession" ; then continue ; fi
				[ -z "$( find "$spawnRoot/$rowTracking" "$MMDAPP/.local/agents/sessions/$rowSpawn" "$MMDAPP/.local/agents/sessions/$rowSession" -type f -mmin -"$(( staleHours * 60 ))" 2> /dev/null | head -1 )" ] || continue
				rowSide=foreign
			;;
		esac
		[ "$( AgentsToolsSpawnSandboxRecordHeader "$recordPath" status )" = spawn-started ] || continue
		AgentsToolsSpawnProxyCloseSandbox "$recordPath" "$endedOutcome" unknown
		if [ "$( AgentsToolsSpawnSandboxRecordHeader "$recordPath" status )" != "spawn-$endedOutcome" ] ; then
			echo "⚠️ WARNING: $MDSC_CMD --magic-advance-input-scan: could not close the record of spawn $rowSpawn in $rowTracking" >&2
			continue
		fi
		housekeepingLog="${housekeepingLog}housekeeping: closed record $rowTracking $rowSpawn"$'\n'
		itemOutput="$( AgentsToolsSpawnSandboxRecordHeader "$recordPath" output-file )"
		[ -n "$itemOutput" ] || itemOutput="-"
		for linkField in spawns spawned-by ; do
			linkStem="$( AgentsToolsSpawnSandboxRecordHeader "$recordPath" "$linkField" )"
			[ -n "$linkStem" ] || continue
			itemName="${linkStem%.md}.md"
			itemState="$( AgentsToolsSpawnProxyBoardStateOf "$itemName" )"
			[ -n "$itemState" ] || continue
			itemPath="$MDAT_DATA_ROOT/board/$itemState/$itemName"
			[ "$( AgentsToolsSpawnSandboxRecordHeader "$itemPath" status )" = dispatch-started ] || continue
			## An item that names a newer spawn belongs to that one, not to this dead record.
			itemSpawn="$( AgentsToolsSpawnSandboxRecordHeader "$itemPath" spawn-id )"
			[ -z "$itemSpawn" ] || [ "$itemSpawn" = "-" ] || [ "$itemSpawn" = "$rowSpawn" ] || continue
			targetState="$itemState"
			[ "$linkField" != spawns ] || [ "$itemState" != running ] || targetState=review
			AgentsToolsSpawnProxyCloseDispatch "$itemName" "" unknown "$itemOutput" "$endedOutcome" "$itemState" "$targetState" > /dev/null 2>&1
			if [ "$( AgentsToolsSpawnSandboxRecordHeader "$MDAT_DATA_ROOT/board/$targetState/$itemName" status )" = "dispatch-$endedOutcome" ] ; then
				housekeepingLog="${housekeepingLog}housekeeping: $itemName $itemState->$targetState $endedOutcome"$'\n'
			fi
		done
	done <<< "$startedRows"
	for itemPath in "$MDAT_DATA_ROOT"/board/running/dispatch-*.md ; do
		[ -f "$itemPath" ] || continue
		[ "$( AgentsToolsSpawnSandboxRecordHeader "$itemPath" status )" = dispatch-started ] || continue
		itemName="${itemPath##*/}"
		itemSpawn="$( AgentsToolsSpawnSandboxRecordHeader "$itemPath" spawn-id )"
		recordPath=""
		if [ -n "$itemSpawn" ] && [ "$itemSpawn" != "-" ] ; then
			for recordCandidate in "$spawnRoot"/*/"$itemSpawn.md" ; do
				[ ! -f "$recordCandidate" ] || { recordPath="$recordCandidate" ; break ; }
			done
		fi
		if [ -n "$recordPath" ] ; then
			recordStatus="$( AgentsToolsSpawnSandboxRecordHeader "$recordPath" status )"
			case "$recordStatus" in ''|spawn-started) continue ;; esac
			closeOutcome="${recordStatus#spawn-}"
			recordExit="$( AgentsToolsSpawnSandboxRecordHeader "$recordPath" exit-code )"
			[ -n "$recordExit" ] || recordExit="unknown"
			itemOutput="$( AgentsToolsSpawnSandboxRecordHeader "$recordPath" output-file )"
			[ -n "$itemOutput" ] || itemOutput="-"
		else
			[ -z "$( find "$itemPath" -mmin -"$(( staleHours * 60 ))" 2> /dev/null | head -1 )" ] || continue
			closeOutcome="$endedOutcome" ; recordExit="unknown" ; itemOutput="-"
		fi
		AgentsToolsSpawnProxyCloseDispatch "$itemName" "" "$recordExit" "$itemOutput" "$closeOutcome" running review > /dev/null 2>&1
		if [ -f "$MDAT_DATA_ROOT/board/review/$itemName" ] ; then
			housekeepingLog="${housekeepingLog}housekeeping: $itemName running->review $closeOutcome"$'\n'
		fi
	done
	## A review item whose named reviewer session has ended goes to the coordinator. A bare member name, `human-owner`, a live session and a missing review-by stay as they are.
	measureText="$( AgentsToolsRegistryRenderSpawnedSessions agents )"
	for itemPath in "$MDAT_DATA_ROOT"/board/review/*.md ; do
		[ -f "$itemPath" ] || continue
		itemName="${itemPath##*/}"
		reviewBy="$( AgentsToolsSpawnSandboxRecordHeader "$itemPath" review-by )"
		case "$reviewBy" in
			''|human-owner|advance.routine) continue ;;
			*:*) reviewId="${reviewBy%%:*}" ;;
			magic-*|keeper-*|warden-*|partner-*|client-*|oncall-*|expert-*) continue ;;
			*) [ ! -f "${MDAT_SKILLSET_ROOT:-$MMDAPP/.local/agents/members}/$reviewBy/SKILL.md" ] || continue ; reviewId="$reviewBy" ;;
		esac
		sessionKind="$( printf '%s\n' "$measureText" | LC_ALL=C awk -v wantSession="$reviewId" '
			NF == 13 && $2 == wantSession { sawRow = 1 ; if ( $13 == "running" || $13 == "waiting" ) { sawLive = 1 ; } }
			END { if ( sawLive ) { print "live" ; } else if ( sawRow ) { print "ended" ; } }
		' )"
		case "$sessionKind" in
			live) continue ;;
			ended) ;;
			*) [ -z "$( find "$itemPath" -mmin -"$(( staleHours * 60 ))" 2> /dev/null | head -1 )" ] || continue ;;
		esac
		if DistroAgentsTools --intern-op-board-upsert-move-edit review "$itemName" --from-state:review \
			--header:upsert:review-by:magic-coordinator --context --magic-advance-input-scan > /dev/null 2>&1 ; then
			housekeepingLog="${housekeepingLog}housekeeping: $itemName review-by -> magic-coordinator"$'\n'
		fi
	done
	## What was done never enters the scan's output; it goes to this spawn's own event-track thread.
	AgentsToolsHousekeepingReport "$2" "${housekeepingLog%$'\n'}"
	return 0
}

. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.RecheckDate.include"

case "$1" in

	--magic-advance-input-scan)
		shift
		## <team-member> captured for future logging/validation, unused today
		local callingMember="$1"
		shift || true
		if [ -z "$callingMember" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-advance-input-scan: syntax is <team-member>" >&2
			set +e ; return 1
		fi
		if [ $# -gt 0 ] ; then
			case "$1" in
				--*)
					echo "⛔ ERROR: $MDSC_CMD --magic-advance-input-scan: invalid option: $1 -- syntax is <team-member>, no other arguments -- an input-scan reads all baseline-relevant items itself. SEE Skill magic-coordinator/magic-coordinator.advance.routine.md" >&2
					set +e ; return 1
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --magic-advance-input-scan: syntax is <team-member>, no other arguments -- an input-scan reads all baseline-relevant items itself, an item name is not a parameter. SEE Skill magic-coordinator/magic-coordinator.advance.routine.md" >&2
					set +e ; return 1
				;;
			esac
		fi
		[ -n "${MDAT_DATA_ROOT:-}" ] || {
			echo "⛔ ERROR: $MDSC_CMD --magic-advance-input-scan: MDAT_DATA_ROOT is not set" >&2
			set +e ; return 1
		}
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.Registries.include"
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.SpawnSandbox.include"
		AgentsToolsAdvanceSpawnHousekeeping 24 "$callingMember"
		printf '%s\n\n' "## state-and-lock (routine-advance)"
		local lockNote="$MDAT_DATA_ROOT/inboxes/magic-coordinator/note-20260809T154715Z-advance-state-and-lock.md"
		if [ -f "$lockNote" ] ; then cat "$lockNote" ; else echo "(no state-and-lock note recorded yet)" ; fi
		## Scoped to what advance itself acts on, per the owner's "grooming reads
		## backlog+inquiries+notes, advance does not": no backlog (promotion is
		## grooming's), and of the own inbox only notes -- the pending-slack-reaction and
		## pending-trello-update records check-pending-comms-actions reads. Inquiries,
		## reflections and the client-* inboxes are read by --magic-grooming-input-scan.
		printf '\n%s\n\n' "## board digest"
		DistroAgentsTools --intern-op-session-context-scan "$callingMember" \
			--state pending --state running --state review --state blocked --state parked \
			--all-types \
			--no-inbox-inquiry \
			--no-inbox-reflections \
			--do-inbox-notes \
			--no-slack --no-email --no-trello \
			--no-inbox-other \
			--no-board-related \
			--context --magic-advance-input-scan
		local advanceScanRc=$?
		## All three registries ride in this scan's output because the pass that reads
		## the board also needs to know who can be spawned, what is actually running
		## and what is waiting on an answer. The rescan is what keeps each one a cache
		## rather than a record anyone maintains by hand. The instruction to poll these
		## and compare them with the board's own running items lives in
		## magic-coordinator.advance.routine, not here -- this emits the facts that
		## instruction is carried out against.
		printf '\n'
		AgentsToolsRegistryRenderAll || :
		return $advanceScanRc
	;;

	--magic-advance-to-running)
		shift
		local callingMember="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$callingMember" ] || [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-advance-to-running: syntax is <team-member> <item-filename> --from-state:<state> [--header:<upsert|append|remove>:name[:value]]... [--upsert-from-stdin|--edit-script-from-stdin:<py|awk>|--edit-patch-from-stdin]" >&2
			set +e ; return 1
		fi
		local fromStateArg=""
		local passthrough=()
		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-state:*) fromStateArg="$1" ; shift ;;
				--recheck-in) passthrough+=( "$1" "${2:-}" ) ; shift ; shift || true ;;
				--header:*|--upsert-from-stdin|--edit-script-from-stdin:*|--edit-patch-from-stdin)
					passthrough+=( "$1" ) ; shift
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --magic-advance-to-running: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$fromStateArg" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-advance-to-running: --from-state:<state> is required" >&2
			set +e ; return 1
		fi
		local startedAt ; startedAt="$( date +"%Y-%m-%d %H:%M %z" )"
		mkdir -p "$MDAT_DATA_ROOT/board/running" || {
			echo "⛔ ERROR: $MDSC_CMD --magic-advance-to-running: can't create board state directory: $MDAT_DATA_ROOT/board/running" >&2
			set +e ; return 1
		}
		## Stamped on a move only: a same-state edit of an item already running keeps the
		## started-at it has, as the help says.
		local startedArgs=( --header:upsert:started-at:"$startedAt" )
		[ "$fromStateArg" != "--from-state:running" ] || startedArgs=()
		DistroAgentsTools --intern-op-board-upsert-move-edit running "$itemName" \
			"$fromStateArg" \
			${startedArgs[@]+"${startedArgs[@]}"} \
			--context --magic-advance-to-running \
			${passthrough[@]+"${passthrough[@]}"}
		return $?
	;;

	--magic-advance-to-parked)
		shift
		## <team-member> captured for future logging/validation, unused today
		local callingMember="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$callingMember" ] || [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-advance-to-parked: syntax is <team-member> <item-filename> --from-state:<state> [--header:<upsert|append|remove>:name[:value]]... [--upsert-from-stdin|--edit-script-from-stdin:<py|awk>|--edit-patch-from-stdin]" >&2
			set +e ; return 1
		fi
		local fromStateArg=""
		local passthrough=()
		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-state:*) fromStateArg="$1" ; shift ;;
				--recheck-in) passthrough+=( "$1" "${2:-}" ) ; shift ; shift || true ;;
				--header:*|--upsert-from-stdin|--edit-script-from-stdin:*|--edit-patch-from-stdin)
					passthrough+=( "$1" ) ; shift
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --magic-advance-to-parked: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$fromStateArg" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-advance-to-parked: --from-state:<state> is required" >&2
			set +e ; return 1
		fi
		mkdir -p "$MDAT_DATA_ROOT/board/parked" || {
			echo "⛔ ERROR: $MDSC_CMD --magic-advance-to-parked: can't create board state directory: $MDAT_DATA_ROOT/board/parked" >&2
			set +e ; return 1
		}
		DistroAgentsTools --intern-op-board-upsert-move-edit parked "$itemName" \
			"$fromStateArg" \
			--context --magic-advance-to-parked \
			"${passthrough[@]}"
		return $?
	;;

	## HEADER ORDER IS LOAD-BEARING, and deliberately NOT the uniform
	## stamp-first order --magic-advance-to-running uses.
	--magic-advance-state-and-lock-upsert)
		shift
		local callingMember="$1"
		shift || true
		if [ -z "$callingMember" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-advance-state-and-lock-upsert: syntax is <team-member> [--header:<upsert|append|remove>:name[:value]]... [--from-file <path>|--upsert-from-stdin|--edit-patch-from-stdin]" >&2
			set +e ; return 1
		fi
		local passthrough=()
		while [ $# -gt 0 ] ; do
			case "$1" in
				--header:*|--upsert-from-stdin|--edit-patch-from-stdin) passthrough+=( "$1" ) ; shift ;;
				--from-file)
					if [ -z "${2:-}" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --magic-advance-state-and-lock-upsert: --from-file: value required" >&2
						set +e ; return 1
					fi
					passthrough+=( "$1" "$2" ) ; shift 2
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --magic-advance-state-and-lock-upsert: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		local recheckDate
		recheckDate="$( AgentsToolsRecheckDate 10 )"
		DistroAgentsTools --intern-op-item-upsert "$callingMember" \
			note-20260809T154715Z-advance-state-and-lock.md \
			--header:upsert:state:advance-running \
			"${passthrough[@]}" \
			--header:upsert:recheck-date:"$recheckDate" \
			--context --magic-advance-state-and-lock-upsert
		return $?
	;;

	--magic-advance-batch-outcome)
		shift
		local callingMember="$1"
		shift || true
		if [ -z "$callingMember" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-advance-batch-outcome: syntax is <team-member> --items:<item-filename>:<outcome>:<execution-receipt>[,...]" >&2
			set +e ; return 1
		fi
		local itemsArg=""
		while [ $# -gt 0 ] ; do
			case "$1" in
				--items:*)
					if [ -n "$itemsArg" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --magic-advance-batch-outcome: --items: given more than once" >&2
						set +e ; return 1
					fi
					itemsArg="${1#--items:}"
					shift
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --magic-advance-batch-outcome: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$itemsArg" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-advance-batch-outcome: --items:<item-filename>:<outcome>:<execution-receipt>[,...] is required" >&2
			set +e ; return 1
		fi

		local itemsRemaining="$itemsArg"
		local spec itemName rest outcome receipt itemCount=0 failCount=0
		while [ -n "$itemsRemaining" ] ; do
			case "$itemsRemaining" in
				*,*) spec="${itemsRemaining%%,*}" ; itemsRemaining="${itemsRemaining#*,}" ;;
				*)   spec="$itemsRemaining" ; itemsRemaining="" ;;
			esac
			[ -z "$spec" ] && continue
			itemCount=$(( itemCount + 1 ))
			itemName="${spec%%:*}"
			rest="${spec#*:}"
			if [ "$rest" = "$spec" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --magic-advance-batch-outcome: malformed entry (need <item-filename>:<outcome>:<execution-receipt>): $spec" >&2
				set +e ; return 1
			fi
			outcome="${rest%%:*}"
			receipt="${rest#*:}"
			if [ "$receipt" = "$rest" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --magic-advance-batch-outcome: malformed entry (need <item-filename>:<outcome>:<execution-receipt>): $spec" >&2
				set +e ; return 1
			fi
			AgentsToolsAssertBareName "$itemName" "<item-filename> (in --items entry: $spec)" magic-advance-batch-outcome || { set +e ; return 1 ; }
			case "$outcome" in
				nudged|respawned|redispatched|flagged-once|no-action) ;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --magic-advance-batch-outcome: invalid outcome in entry $spec: $outcome" >&2
					set +e ; return 1
				;;
			esac
			if [ -z "$receipt" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --magic-advance-batch-outcome: entry $spec: execution-receipt required" >&2
				set +e ; return 1
			fi
			if ! DistroAgentsTools --intern-op-board-upsert-move-edit running "$itemName" \
				--from-state:running \
				--header:upsert:outcome:"$outcome" \
				--header:upsert:execution-receipt:"$receipt" \
				--context --magic-advance-batch-outcome
			then
				failCount=$(( failCount + 1 ))
			fi
		done

		if [ "$itemCount" -eq 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-advance-batch-outcome: --items: no item entries found" >&2
			set +e ; return 1
		fi
		if [ "$failCount" -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-advance-batch-outcome: $failCount of $itemCount item(s) failed" >&2
			set +e ; return 1
		fi
		echo "# $MDSC_CMD --magic-advance-batch-outcome: recorded outcomes for $itemCount item(s)" >&2
		return 0
	;;

	## Fixed 5-loop countdown-then-continue signal. No options.
	--magic-advance-sleep-run)
		shift
		if [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-advance-sleep-run: takes no arguments" >&2
			set +e ; return 1
		fi
		## Five one-second loops, the owner's own specification.
		local remaining=5
		while [ "$remaining" -gt 0 ] ; do
			echo "$remaining"
			sleep 1
			remaining=$(( remaining - 1 ))
		done
		printf 'All Done.\nPLEASE CONTINUE!\n'
		return 0
	;;


	--magic-advance-lock-acquire)
		shift
		local callingMember="$1" ; shift || true
		local ownerLabel="$1" ; shift || true
		if [ -z "$callingMember" ] || [ -z "$ownerLabel" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-advance-lock-acquire: <team-member> <owner-label> required" >&2
			set +e ; return 1
		fi
		if [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-advance-lock-acquire: invalid option: $1" >&2
			set +e ; return 1
		fi
		[ -n "${MDAT_DATA_ROOT:-}" ] || {
			echo "⛔ ERROR: $MDSC_CMD --magic-advance-lock-acquire: MDAT_DATA_ROOT is not set" >&2
			set +e ; return 1
		}

		local lockTarget="$MDAT_DATA_ROOT/inboxes/magic-coordinator/note-20260809T154715Z-advance-state-and-lock.md"
		local originUrl="" repoRoot="" lockRelPath="" lockBranch=""
		set +e
		originUrl="$( DistroAgentsTools --agents-config-option magic-team --select TEAM_DATA_GIT_REMOTE 2>/dev/null )"
		if [ -n "$originUrl" ] ; then
			repoRoot="$( git -C "$MDAT_DATA_ROOT" rev-parse --show-toplevel 2>/dev/null )"
		fi
		set -e

		## The pre-write half of the lock's concurrency control, ahead of
		## item-upsert's own post-push read-back: refuse a conflicted copy,
		## resync, refuse again, then refuse anything still not the head's.
		if [ -n "$originUrl" ] && [ -n "$repoRoot" ] ; then
			lockRelPath="${lockTarget#"$repoRoot"/}"
			set +e
			lockBranch="$( git -C "$repoRoot" rev-parse --abbrev-ref HEAD 2>/dev/null )"
			set -e
			case "$lockRelPath" in
				/*|'')
					echo "⛔ ERROR: $MDSC_CMD --magic-advance-lock-acquire: LOCK_UNCHECKABLE -- the lock note does not resolve inside the board checkout $repoRoot" >&2
					set +e ; return 1
				;;
			esac
			if [ -z "$lockBranch" ] || [ "$lockBranch" = "HEAD" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --magic-advance-lock-acquire: LOCK_UNCHECKABLE -- the board checkout $repoRoot is not on a named branch" >&2
				set +e ; return 1
			fi
			AgentsToolsAdvanceLockStateCheck "$repoRoot" "$lockRelPath" --magic-advance-lock-acquire "before the board resync" || { set +e ; return 1 ; }
			local advanceSyncOut
			if ! AgentsToolsAdvanceCloneSync "$repoRoot" "$originUrl" "$lockBranch" ; then
				echo "⛔ ERROR: $MDSC_CMD --magic-advance-lock-acquire: LOCK_UNCHECKABLE -- could not resync the board before taking the lock, so whether the local copy is the published one is UNKNOWN: $advanceSyncOut" >&2
				set +e ; return 1
			fi
			AgentsToolsAdvanceLockStateCheck "$repoRoot" "$lockRelPath" --magic-advance-lock-acquire "after the board resync" || { set +e ; return 1 ; }
			AgentsToolsAdvanceLockHeadCheck "$repoRoot" "$lockRelPath" "$lockBranch" --magic-advance-lock-acquire || { set +e ; return 1 ; }
		fi

		local recheckDate
		recheckDate="$( AgentsToolsRecheckDate 10 )"
		if ! DistroAgentsTools --intern-op-item-read "$callingMember" \
			note-20260809T154715Z-advance-state-and-lock.md \
			--acquire-lock "$ownerLabel" \
			--commit-message "* advance.routine: activate, lock" \
			--header:upsert:state:advance-running \
			--header:upsert:recheck-date:"$recheckDate" \
			--context --magic-advance-lock-acquire
		then
			set +e ; return 1
		fi

		if [ -n "$originUrl" ] && [ -n "$repoRoot" ] ; then
			local fetchOut="" fetchRc=0
			set +e
			fetchOut="$( git -C "$repoRoot" fetch origin "$lockBranch" 2>&1 )"
			fetchRc=$?
			set -e
			if [ "$fetchRc" -ne 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --magic-advance-lock-acquire: LOCK_UNCHECKABLE -- could not fetch origin/$lockBranch to verify the published lock: $fetchOut" >&2
				set +e ; return 1
			fi
			local publishedSessionId
			publishedSessionId="$( git -C "$repoRoot" show "FETCH_HEAD:$lockRelPath" 2>/dev/null | LC_ALL=C awk '/^session-id: /{ print substr($0, 13) ; exit ; }' )"
			if [ "$publishedSessionId" != "$ownerLabel" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --magic-advance-lock-acquire: LOCK_NOT_PUBLISHED -- origin/$lockBranch:$lockRelPath reads session-id '$publishedSessionId', not '$ownerLabel' -- the lock write did not actually land on the remote" >&2
				set +e ; return 1
			fi
		fi
		return 0
	;;

	--magic-advance-lock-refresh)
		shift
		local callingMember="$1" ; shift || true
		if [ -z "$callingMember" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-advance-lock-refresh: <team-member> required" >&2
			set +e ; return 1
		fi
		if [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-advance-lock-refresh: invalid option: $1" >&2
			set +e ; return 1
		fi
		local recheckDate
		recheckDate="$( AgentsToolsRecheckDate 10 )"
		DistroAgentsTools --intern-op-item-upsert "$callingMember" \
			note-20260809T154715Z-advance-state-and-lock.md \
			--update-lock \
			--header:upsert:state:advance-running \
			--header:upsert:recheck-date:"$recheckDate" \
			--context --magic-advance-lock-refresh
		return $?
	;;

	## ORDER IS LOAD-BEARING: the GC runs and commits under the still-held
	## lock, the unlock commit is the last write under it, and the push plus
	## resync publish both together.
	--magic-advance-close-state-and-unlock)
		shift
		local callingMember="$1" ; shift || true
		if [ -z "$callingMember" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-advance-close-state-and-unlock: <team-member> required" >&2
			set +e ; return 1
		fi
		local passthrough=()
		while [ $# -gt 0 ] ; do
			case "$1" in
				--edit-patch-from-stdin) passthrough+=( "$1" ) ; shift ;;
				--from-file)
					if [ -z "${2:-}" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --magic-advance-close-state-and-unlock: --from-file: value required" >&2
						set +e ; return 1
					fi
					passthrough+=( "$1" "$2" ) ; shift 2
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --magic-advance-close-state-and-unlock: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		local gcRc=0
		DistroAgentsTools --intern-team-data-final-gc-deletion "$callingMember" \
			--context --magic-advance-close-state-and-unlock || gcRc=$?
		if [ "$gcRc" -ne 0 ] && [ "$gcRc" -ne 2 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-advance-close-state-and-unlock: team-data-final-gc-deletion failed (exit $gcRc) -- aborting unlock rather than degrading silently (PROVISIONAL policy, see AgentsTools.InternTeamDataFinalGcDeletion.include's own header / this task's own report)" >&2
			set +e ; return 1
		fi
		## gcRc=2: nothing to delete -- not a failure, continue.

		if ! DistroAgentsTools --intern-op-item-upsert "$callingMember" \
			note-20260809T154715Z-advance-state-and-lock.md \
			"${passthrough[@]}" \
			--unlock-lock \
			--header:upsert:state:advance-finished \
			--no-push \
			--commit-message "* advance.routine: update, unlock" \
			--context --magic-advance-close-state-and-unlock
		then
			set +e ; return 1
		fi

		local originUrl="" repoRoot=""
		set +e
		originUrl="$( DistroAgentsTools --agents-config-option magic-team --select TEAM_DATA_GIT_REMOTE 2>/dev/null )"
		if [ -n "$originUrl" ] ; then
			repoRoot="$( git -C "$MDAT_DATA_ROOT" rev-parse --show-toplevel 2>/dev/null )"
		fi
		set -e
		if [ -n "$originUrl" ] && [ -n "$repoRoot" ] ; then
			local lockBranch=""
			set +e
			lockBranch="$( git -C "$repoRoot" rev-parse --abbrev-ref HEAD 2>/dev/null )"
			set -e
			local pushAttempt=1 pushOut="" pushRc=0
			while : ; do
				set +e
				pushOut="$( git -C "$repoRoot" push origin HEAD 2>&1 )"
				pushRc=$?
				set -e
				[ "$pushRc" -eq 0 ] && break
				case "$pushOut" in
					*"Could not resolve host"*|*"could not resolve host"*|*"unable to access"*|*"Could not read from remote repository"*|*"Connection timed out"*|*"Connection refused"*|*"Operation timed out"*|*"Network is unreachable"*|*"connection reset"*)
						if [ "$pushAttempt" -eq 1 ] ; then
							echo "# $MDSC_CMD --magic-advance-close-state-and-unlock: push network failure, retrying once in 15s" >&2
							sleep 15
							pushAttempt=2
							continue
						fi
					;;
				esac
				break
			done
			if [ "$pushRc" -ne 0 ] ; then
				echo "⚠️ WARNING: $MDSC_CMD --magic-advance-close-state-and-unlock: push failed after unlock commits landed locally -- closing anyway (same tolerance as --intern-op-item-upsert's own closing-update warning): $pushOut" >&2
			fi
			local advanceSyncOut
			if ! AgentsToolsAdvanceCloneSync "$repoRoot" "$originUrl" "$lockBranch" ; then
				echo "⚠️ WARNING: $MDSC_CMD --magic-advance-close-state-and-unlock: board resync failed after the unlock landed locally -- closing anyway, the checkout is left unreconciled: $advanceSyncOut" >&2
			fi
		fi
		return 0
	;;

	--magic-advance-lock-status)
		shift
		local callingMember="$1" ; shift || true
		if [ -z "$callingMember" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-advance-lock-status: <team-member> required" >&2
			set +e ; return 1
		fi
		if [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --magic-advance-lock-status: invalid option: $1" >&2
			set +e ; return 1
		fi
		DistroAgentsTools --intern-op-item-read "$callingMember" \
			note-20260809T154715Z-advance-state-and-lock.md \
			--context --magic-advance-lock-status
		return $?
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
