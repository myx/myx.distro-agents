#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## The `myx.distro` MCP stdio server. Sourced from DistroAgentsTools.fn.sh's
## `--intern-mcp-server` arm; needs $1/$@/$MDSC_CMD from dot-sourcing.
## stdout is the JSON-RPC wire: every diagnostic goes to stderr.
## Every request is handled in its own background job, and the wire is
## serialised by a mkdir lock so two responses can never interleave.
## Every scratch file lives under $MMDAPP/.local/temp/agent-mcp.$$/ and that
## path is written out in full at each use: the location is on the line itself.
## set -e rules, portability floor and design notes: see MAGIC.md.
##

## Bounded, and never reclaims: the holder writes to a pipe the MCP host may stop
## draining, so a timeout cannot mean it is gone. The caller drops its response.
AgentsMcpWireLockAcquire(){
	local mcpLockSpin=0 mcpLockWaited=0
	while ! mkdir "$MMDAPP/.local/temp/agent-mcp.$$/wire.lock" 2>/dev/null ; do
		mcpLockSpin=$(( mcpLockSpin + 1 ))
		[ 500 -le "$mcpLockSpin" ] || continue
		sleep 1
		mcpLockSpin=0
		mcpLockWaited=$(( mcpLockWaited + 1 ))
		[ 30 -le "$mcpLockWaited" ] || continue
		return 1
	done
	return 0
}

AgentsMcpSendResult(){
	[ -n "$1" ] || return 0
	if ! AgentsMcpWireLockAcquire ; then
		printf '%s\n' "$MDSC_CMD: mcp-server: ⛔ ERROR: wire lock not acquired after 30s -- DROPPING the response for request id $1. Another handler holds the wire and its write to the MCP host has not completed; the lock is never taken from it." >&2
		return 0
	fi
	printf '{"jsonrpc":"2.0","id":%s,"result":%s}\n' "$1" "$2"
	rmdir "$MMDAPP/.local/temp/agent-mcp.$$/wire.lock" 2>/dev/null
	return 0
}

## mcpErrText is held: escaping forks awk, which must stay outside the lock.
AgentsMcpSendError(){
	local mcpErrText=''
	[ -n "$1" ] || return 0
	mcpErrText="$( printf '%s' "$3" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsMcpJsonEscape.awk" )" || mcpErrText=''
	if ! AgentsMcpWireLockAcquire ; then
		printf '%s\n' "$MDSC_CMD: mcp-server: ⛔ ERROR: wire lock not acquired after 30s -- DROPPING the error response for request id $1 (code $2). Another handler holds the wire and its write to the MCP host has not completed; the lock is never taken from it." >&2
		return 0
	fi
	printf '{"jsonrpc":"2.0","id":%s,"error":{"code":%s,"message":"%s"}}\n' "$1" "$2" "$mcpErrText"
	rmdir "$MMDAPP/.local/temp/agent-mcp.$$/wire.lock" 2>/dev/null
	return 0
}

case "$1" in

	--intern-mcp-server)
		shift

		## Never serve without --run: an accidental stdin loop hangs forever.
		if [ "--run" != "$1" ] ; then
			printf '%s\n' "$MDSC_CMD --intern-mcp-server -- MCP stdio server registered as 'myx.distro'." >&2
			printf '%s\n' "" >&2
			printf '%s\n' "  $MDSC_CMD --intern-mcp-server --run" >&2
			printf '%s\n' "      Speak JSON-RPC 2.0 over stdin/stdout until stdin closes." >&2
			printf '%s\n' "      Launched by an MCP host, not by hand." >&2
			printf '%s\n' "" >&2
			printf '%s\n' "Exposes 'execute', backed by $MDSC_CMD --intern-mcp-execute, plus the" >&2
			printf '%s\n' "harness tool floor rendered by sh-lib/AgentsHarnessMcpMirror.sh and run one" >&2
			printf '%s\n' "call at a time by sh-lib/AgentsUniversalHarness.sh --intern-tool. Bash is not" >&2
			printf '%s\n' "among them: arbitrary command execution is myx.common's own MCP method." >&2
			set +e ; return 1
		fi
		shift

		if [ 0 -lt $# ] ; then
			printf '%s\n' "$MDSC_CMD: mcp-server --run: ⛔ ERROR: takes no further arguments: $*" >&2
			set +e ; return 1
		fi

		set +e

		## MMDAPP is frozen into the host registration at install time.
		if [ ! -d "$MMDAPP/.local" ] ; then
			printf '%s\n' "$MDSC_CMD: mcp-server: ⛔ ERROR: MMDAPP is not a set-up myx.distro workspace: $MMDAPP -- the MCP host registration freezes this path at install time and it no longer resolves. Re-run DistroAgentsTools.fn.sh --make-workspace-integrations from that workspace to rewrite it." >&2
			return 1
		fi

		rm -rf "$MMDAPP/.local/temp/agent-mcp.$$"
		if ! mkdir -p "$MMDAPP/.local/temp/agent-mcp.$$" ; then
			printf '%s\n' "$MDSC_CMD: mcp-server: ⛔ ERROR: cannot create scratch directory $MMDAPP/.local/temp/agent-mcp.$$" >&2
			return 1
		fi
		AGENTS_MCP_REQ_SEQ=0
		trap 'rm -rf "$MMDAPP/.local/temp/agent-mcp.$$"' EXIT INT TERM

		## The harness tool floor, rendered ONCE for this server's whole life, from the
		## same wire declarations the model is offered. Nothing here is a second list:
		## AgentsHarnessMcpMirror.sh derives it, and a render that fails leaves this
		## server serving `execute` alone rather than a floor nobody rendered.
		## Two tools are ABSENT rather than present-and-refusing: a tool that exists and
		## refuses reads as a broken server. Bash, because arbitrary command execution is
		## myx.common's own method. Monitor, because it starts a background job whose
		## handle exists only inside the harness process that started it, and a tools/call
		## runs one tool in a FRESH process -- measured, the handle is dead before the call
		## returns and the job is left running with its log already removed. tools/call
		## still names what to use instead, for both.
		## THE TEST WHEN A NEW HARNESS TOOL LANDS: a tool that takes a command, or that
		## hands back a handle only its own process can resolve, belongs on this list.
		## Nothing else applies it, so MAGIC.md's own `A harness tool joins the served MCP
		## floor by default` states it where a reader adding a tool will actually meet it.
		## A marker inherited from an outer copy of this server means we were reached
		## through another server: we then serve `execute` only, so enumeration cannot
		## descend through us a second time.
		mcpUnservedToolNames="Bash Monitor"
		mcpServedToolsJson='' ; mcpServedToolNames=''
		if [ -n "${MDAT_MCP_SERVED_MARKER:-}" ] ; then
			printf '%s\n' "$MDSC_CMD: mcp-server: reached through another MCP server (MDAT_MCP_SERVED_MARKER is set) -- serving 'execute' only, and declining every harness tool, so enumeration cannot recurse through this server." >&2
		else
			mcpMirrorJson="$( bash "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsHarnessMcpMirror.sh" )" || mcpMirrorJson=''
			if [ -z "$mcpMirrorJson" ] ; then
				printf '%s\n' "$MDSC_CMD: mcp-server: ⛔ ERROR: the harness tool floor did not render, so ONLY 'execute' is served. The mirror's own error is above; repair the declaration it names in sh-lib/AgentsOpenAiChatWire.sh." >&2
			else
				mcpMirrorIndex=0
				while : ; do
					mcpMirrorName="$( printf '{"tools":%s}' "$mcpMirrorJson" | LC_ALL=C awk -v path="tools.$mcpMirrorIndex.name" -v mode=raw -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsHarnessJsonSlice.awk" 2>/dev/null )" || break
					[ -n "$mcpMirrorName" ] || break
					## The raw name carries its own quotes; the bare form is what routes.
					mcpMirrorName="${mcpMirrorName#\"}" ; mcpMirrorName="${mcpMirrorName%\"}"
					mcpMirrorEntry="$( printf '{"tools":%s}' "$mcpMirrorJson" | LC_ALL=C awk -v path="tools.$mcpMirrorIndex" -v mode=raw -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsHarnessJsonSlice.awk" 2>/dev/null )" || mcpMirrorEntry=''
					mcpMirrorIndex=$(( mcpMirrorIndex + 1 ))
					[ -n "$mcpMirrorEntry" ] || continue
					case " $mcpUnservedToolNames " in
						*" $mcpMirrorName "*) continue ;;
					esac
					mcpServedToolsJson="$mcpServedToolsJson$mcpMirrorEntry,"
					mcpServedToolNames="$mcpServedToolNames $mcpMirrorName"
				done
				if [ -z "$mcpServedToolNames" ] ; then
					printf '%s\n' "$MDSC_CMD: mcp-server: ⛔ ERROR: the floor rendered but no tool survived the walk, so ONLY 'execute' is served -- an empty population is a fault here, never a floor that declares nothing." >&2
				fi
			fi
		fi

		## Check-init witness; stderr only.
		printf '%s\n' "# myx.distro agentMcp: pid=$$ origin=$MDLT_ORIGIN mode=${MDLC_INMODE:-?} spec=${MDLT_OPTION:-?} root=$MMDAPP scratch=$MMDAPP/.local/temp/agent-mcp.$$ served=$( set -- $mcpServedToolNames ; echo $# ) harness tools plus execute" >&2

		## `|| [ -n ... ]` keeps a final line that has no trailing newline.
		while IFS= read -r mcpLine || [ -n "$mcpLine" ] ; do
			## Per iteration: the dispatcher re-arms -e on every call.
			set +e

			[ -n "$mcpLine" ] || continue

			rm -rf "$MMDAPP/.local/temp/agent-mcp.$$/req"
			if ! mkdir -p "$MMDAPP/.local/temp/agent-mcp.$$/req" ; then
				printf '%s\n' "$MDSC_CMD: mcp-server: ⛔ ERROR: cannot create request scratch directory, skipping one message" >&2
				continue
			fi

			printf '%s\n' "$mcpLine" | LC_ALL=C awk -v outDir="$MMDAPP/.local/temp/agent-mcp.$$/req" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsMcpJsonParseRequest.awk"

			mcpMethod='' ; mcpId='' ; mcpToolName=''
			[ ! -f "$MMDAPP/.local/temp/agent-mcp.$$/req/method" ] || IFS= read -r mcpMethod < "$MMDAPP/.local/temp/agent-mcp.$$/req/method" || true
			[ ! -f "$MMDAPP/.local/temp/agent-mcp.$$/req/tool_name" ] || IFS= read -r mcpToolName < "$MMDAPP/.local/temp/agent-mcp.$$/req/tool_name" || true
			[ ! -f "$MMDAPP/.local/temp/agent-mcp.$$/req/has_id" ] || IFS= read -r mcpId < "$MMDAPP/.local/temp/agent-mcp.$$/req/id" || true
			## $(cat) not read: a script spans lines.
			mcpScript="$( cat "$MMDAPP/.local/temp/agent-mcp.$$/req/arg_command" 2>/dev/null || true )"
			## Optional per-call workspace override; empty means "this server's own MMDAPP", unchanged.
			mcpWorkspace="$( cat "$MMDAPP/.local/temp/agent-mcp.$$/req/arg_workspace" 2>/dev/null || true )"
			## Every remaining per-request field is read HERE, before the fork: the next message wipes req/.
			mcpTimeout="$( cat "$MMDAPP/.local/temp/agent-mcp.$$/req/arg_timeout" 2>/dev/null || true )"
			mcpBackground="$( cat "$MMDAPP/.local/temp/agent-mcp.$$/req/arg_background" 2>/dev/null || true )"
			mcpJob="$( cat "$MMDAPP/.local/temp/agent-mcp.$$/req/arg_job" 2>/dev/null || true )"
			mcpAction="$( cat "$MMDAPP/.local/temp/agent-mcp.$$/req/arg_action" 2>/dev/null || true )"

			AGENTS_MCP_REQ_SEQ=$(( AGENTS_MCP_REQ_SEQ + 1 ))
			{
				case "$mcpMethod" in
					initialize)
						AgentsMcpSendResult "$mcpId" '{"protocolVersion":"2025-06-18","capabilities":{"tools":{}},"serverInfo":{"name":"myx.distro","version":"1.0.0"}}'
					;;
					notifications/*)
						## No response ever; cancelled is a no-op while nothing is tracked.
						:
					;;
					ping)
						AgentsMcpSendResult "$mcpId" '{}'
					;;
					tools/list)
						AgentsMcpSendResult "$mcpId" '{"tools":['"$mcpServedToolsJson"'{"name":"execute","description":"Evaluate a shell script with its environment already established. MMDAPP is the workspace root and MDLT_ORIGIN the tooling tree, and the two may point at different trees. DistroAgentsTools, DistroAgentsContext, Agents, Require, Distro, Action and DistroSystemContext are all defined, and nothing in the caller environment is overwritten: a spec the caller already named stays. No input tier is resolved, so a script that reads a distro index names one itself, and loads the tool with Require first, because Distro resolves through PATH and this surface carries no sh-scripts directory. For example: DistroSystemContext --distro-from-source ; Require ListDistroProjects ; Distro ListDistroProjects --select-all. Defaults to this server'"'"'s own workspace; pass '"'"'workspace'"'"' to run against a different one instead: a fresh process with MMDAPP moved to it, its index caches dropped, and MDLT_ORIGIN deliberately unchanged, since that workspace own copy may be stale, broken or absent. Returns the script combined stdout and stderr, plus its exit status.","inputSchema":{"type":"object","properties":{"command":{"type":"string","description":"Shell script to evaluate. May span multiple lines."},"workspace":{"type":"string","description":"Optional: absolute path of a different myx.distro workspace (one with its own .local) to run this one call against, overriding this server'"'"'s own default MMDAPP for this call only. Leave unset to use this server'"'"'s own workspace."},"timeout":{"type":"integer","description":"Optional, foreground calls only: seconds to allow this script before it is killed (TERM, then KILL after 5s). Default 600, maximum 3600. On a timeout the call returns an error naming the limit, and the partial output is kept in a file whose path is named in that error, so a long build that stalls can still be inspected."},"background":{"type":"boolean","description":"Optional: start the script and return AT ONCE with a job id instead of waiting for it. Use this for anything long -- a build, a deploy, a sync -- so you keep working while it runs, watch its output as it appears, and can stop it. No timeout is applied to a background job, because you can see it and kill it. Poll it by calling execute again with '"'"'job'"'"' and no '"'"'command'"'"'."},"job":{"type":"integer","description":"Optional: the id of a background job started earlier by this same server. Pass it WITHOUT '"'"'command'"'"' to read whatever output has appeared since your last poll, plus whether the job is still running or its exit code. Each poll returns only what is new."},"action":{"type":"string","description":"Optional, only with '"'"'job'"'"': '"'"'kill'"'"' sends TERM to that job. Omit to poll it."}},"required":[]}}]}'
					;;
					tools/call)
						mcpJobsDir="$MMDAPP/.local/temp/agent-mcp.$$/jobs"

						## Whole-token membership, and only for a name that is actually there:
						## the served list carries a leading space, so an empty name would match
						## it as a run of two and route a nameless call into the harness.
						mcpIsHarnessTool=''
						if [ -n "$mcpToolName" ] ; then
							case " $mcpServedToolNames " in
								*" $mcpToolName "*) mcpIsHarnessTool=1 ;;
							esac
						fi

						## Bash is absent from tools/list rather than present-and-refusing, so a
						## caller only reaches this by naming it anyway; it is told where
						## arbitrary command execution actually lives instead of being refused
						## with nothing to go on. myx.common is not modified by this.
						if [ "Bash" = "$mcpToolName" ] ; then
							AgentsMcpSendError "$mcpId" -32602 "Bash is not served by this server. Arbitrary command execution is myx.common's own MCP method -- call that server's lib_execShStdin instead. This server's own 'execute' is a different thing: it evaluates a shell script with the myx.distro workspace context already established."

						## Any other tool the floor rendered: run exactly that one tool in the
						## harness and return its output. The harness may leave a background
						## child, and a $( ) capture waits on the pipe's writers rather than on
						## the process -- so the output goes to a file and the pid is waited on,
						## the same shape the execute path below already uses for the same reason.
						elif [ -n "$mcpIsHarnessTool" ] ; then
							## Lifted RAW out of the request and handed over unchanged: these
							## bytes are already escaped for JSON, and escaping them again
							## corrupts every value that carried an escape.
							mcpToolArgs="$( printf '%s\n' "$mcpLine" | LC_ALL=C awk -v path="params.arguments" -v mode=raw -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsHarnessJsonSlice.awk" 2>/dev/null )" || mcpToolArgs=''
							[ -n "$mcpToolArgs" ] || mcpToolArgs='{}'

							mcpOutFile="$MMDAPP/.local/temp/agent-mcp.$$/tool.$AGENTS_MCP_REQ_SEQ"
							mcpKillFile="$MMDAPP/.local/temp/agent-mcp.$$/toolkilled.$AGENTS_MCP_REQ_SEQ"
							rm -f "$mcpKillFile"

							## STDOUT ONLY is the result. The harness announces the call and
							## names its hook source on stderr, and folding that in would put
							## those lines inside the file a Read returned. A refusal is already
							## on stdout, as `ERROR: ...`, so nothing a caller needs is lost.
							## The bound is this server's cap rather than its default, and no
							## caller argument sets it: `timeout` belongs to Wait and to
							## AskUserQuestion themselves. Both block by design and carry their
							## own inner bound, every other tool is quick, and each request
							## already runs in its own job -- so a long call holds its own
							## handler and never this server. The watchdog exists only so a
							## wedged call cannot hold that handler for the process's whole life.
							mcpExitCode=0
							set -m
							( printf '%s\n' "$mcpToolArgs" | "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsUniversalHarness.sh" --intern-tool "$mcpToolName" ) > "$mcpOutFile" &
							mcpCmdPid=$!
							(
								sleep 3600
								kill -0 "$mcpCmdPid" 2>/dev/null || exit 0
								: > "$mcpKillFile"
								kill -TERM -- "-$mcpCmdPid" 2>/dev/null
								sleep 5
								kill -KILL -- "-$mcpCmdPid" 2>/dev/null
							) &
							mcpWatchPid=$!
							set +m

							wait "$mcpCmdPid" || mcpExitCode=$?
							kill -TERM -- "-$mcpWatchPid" 2>/dev/null
							wait "$mcpWatchPid" 2>/dev/null
							set +e

							mcpOutput="$( < "$mcpOutFile" )"
							mcpIsError='false'
							if [ -f "$mcpKillFile" ] ; then
								mcpIsError='true'
								mcpOutput="$mcpOutput"$'\n'"[$mcpToolName timed out after 3600s and was killed; partial output above is kept at: $mcpOutFile]"
								rm -f "$mcpKillFile"
							elif [ 0 -ne "$mcpExitCode" ] ; then
								## The harness exits non-zero on its own ERROR result, which is
								## already the text above -- so this marks it rather than
								## restating it, and names a crash where there is no text at all.
								mcpIsError='true'
								[ -n "$mcpOutput" ] || mcpOutput="[$mcpToolName produced no output and exited $mcpExitCode -- the harness's own diagnostics are on this server's stderr]"
								rm -f "$mcpOutFile"
							else
								rm -f "$mcpOutFile"
							fi
							[ -n "$mcpOutput" ] || mcpOutput='(no output)'

							AgentsMcpSendResult "$mcpId" "$( printf '{"content":[{"type":"text","text":"%s"}],"isError":%s}' "$( printf '%s' "$mcpOutput" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsMcpJsonEscape.awk" )" "$mcpIsError" )"

						## Reached through another server: say which bound refused this, because
						## the same name works on the server the host registered directly, and
						## `unknown tool` would send a caller looking for a fault that is not there.
						elif [ -n "${MDAT_MCP_SERVED_MARKER:-}" ] && [ "execute" != "$mcpToolName" ] ; then
							AgentsMcpSendError "$mcpId" -32602 "This server was reached through another MCP server, so it serves 'execute' only and declines every harness tool -- otherwise an enumeration could descend through copies of this server without end. Call '$mcpToolName' on the myx.distro server your host registered directly."

						elif [ "execute" != "$mcpToolName" ] ; then
							AgentsMcpSendError "$mcpId" -32602 "Unknown tool: $mcpToolName"

						## A job named, no command: poll or kill a script already running.
						elif [ -n "$mcpJob" ] ; then
							case "$mcpJob" in
								*[!0-9]*) AgentsMcpSendError "$mcpId" -32602 "job must be the numeric id returned by a background start: $mcpJob" ;;
								*)
									if [ ! -d "$mcpJobsDir/$mcpJob" ] ; then
										AgentsMcpSendError "$mcpId" -32602 "no such job in this server: $mcpJob"
									else
										mcpJobPid="$( cat "$mcpJobsDir/$mcpJob/pid" 2>/dev/null || true )"
										if [ "kill" = "$mcpAction" ] ; then
											## Signals the job's whole process group: the pid is its leader, so
											## the script and everything it forked go together. TERM to the pid
											## alone kills the wrapper and leaves the real work running.
											if [ -n "$mcpJobPid" ] && kill -0 "$mcpJobPid" 2>/dev/null ; then
												kill -TERM -- "-$mcpJobPid" 2>/dev/null
												mcpOutput="[job $mcpJob: TERM sent to process group $mcpJobPid]"
											else
												mcpOutput="[job $mcpJob: already finished, nothing to kill]"
											fi
											AgentsMcpSendResult "$mcpId" "$( printf '{"content":[{"type":"text","text":"%s"}],"isError":false}' "$( printf '%s' "$mcpOutput" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsMcpJsonEscape.awk" )" )"
										else
											## Only what is NEW since the last poll, so polling a long build does
											## not re-deliver everything each time.
											mcpCursor="$( cat "$mcpJobsDir/$mcpJob/cursor" 2>/dev/null || true )"
											case "$mcpCursor" in ''|*[!0-9]*) mcpCursor=0 ;; esac
											mcpOutput="$( tail -c "+$(( mcpCursor + 1 ))" "$mcpJobsDir/$mcpJob/out" 2>/dev/null || true )"
											wc -c < "$mcpJobsDir/$mcpJob/out" 2>/dev/null | tr -d ' ' > "$mcpJobsDir/$mcpJob/cursor"

											## rc is written by the job itself, so its absence on a job no longer
											## running is a real distinction and never reported as an exit code.
											if [ -n "$mcpJobPid" ] && kill -0 "$mcpJobPid" 2>/dev/null ; then
												mcpOutput="$mcpOutput"$'\n'"[job $mcpJob: still running, pid $mcpJobPid -- poll again for more]"
											elif [ -f "$mcpJobsDir/$mcpJob/rc" ] ; then
												mcpOutput="$mcpOutput"$'\n'"[job $mcpJob: finished, exit code $( cat "$mcpJobsDir/$mcpJob/rc" )]"
											else
												mcpOutput="$mcpOutput"$'\n'"[job $mcpJob: stopped before it could finish -- killed, or died without recording an exit code]"
											fi
											[ -n "$mcpOutput" ] || mcpOutput='(no new output)'
											AgentsMcpSendResult "$mcpId" "$( printf '{"content":[{"type":"text","text":"%s"}],"isError":false}' "$( printf '%s' "$mcpOutput" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsMcpJsonEscape.awk" )" )"
										fi
									fi
								;;
							esac

						elif [ -z "$mcpScript" ] ; then
							AgentsMcpSendError "$mcpId" -32602 "execute requires a non-empty 'command' argument, or a 'job' id to poll or kill"
						elif [ -n "$mcpWorkspace" ] && [ ! -d "$mcpWorkspace/.local" ] ; then
							AgentsMcpSendError "$mcpId" -32602 "workspace has no .local, not a set-up myx.distro workspace: $mcpWorkspace"
						## Starts and returns at once, with a job id to poll and to kill by.
						## No timeout is imposed: a bound is what a foreground call needs,
						## because nothing can watch it, and a job the caller can see needs none.
						elif [ "true" = "$mcpBackground" ] ; then
							mcpJobId="$AGENTS_MCP_REQ_SEQ"
							mkdir -p "$mcpJobsDir/$mcpJobId"
							: > "$mcpJobsDir/$mcpJobId/out"
							printf '0\n' > "$mcpJobsDir/$mcpJobId/cursor"

							## set -m puts the job in a process group of its own, so the recorded
							## $! is its leader and one signal reaches everything the script forked.
							## The whole pipeline goes inside the subshell for that: with a bare
							## pipeline, $! is its LAST process and the group id is its first.
							set -m
							if [ -n "$mcpWorkspace" ] ; then
								(
									mcpJobRc=0
									printf '%s\n' "$mcpScript" | ( exec "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh" --intern-mcp-execute --workspace "$mcpWorkspace" ) >> "$mcpJobsDir/$mcpJobId/out" 2>&1 || mcpJobRc=$?
									printf '%s\n' "$mcpJobRc" > "$mcpJobsDir/$mcpJobId/rc"
								) &
							else
								(
									mcpJobRc=0
									printf '%s\n' "$mcpScript" | DistroAgentsTools --intern-mcp-execute >> "$mcpJobsDir/$mcpJobId/out" 2>&1 || mcpJobRc=$?
									printf '%s\n' "$mcpJobRc" > "$mcpJobsDir/$mcpJobId/rc"
								) &
							fi
							printf '%s\n' "$!" > "$mcpJobsDir/$mcpJobId/pid"
							set +m

							mcpOutput="[job $mcpJobId started, pid $( cat "$mcpJobsDir/$mcpJobId/pid" )]"$'\n'"[poll it:  execute with job=$mcpJobId]"$'\n'"[stop it:  execute with job=$mcpJobId action=kill]"$'\n'"[log file: $mcpJobsDir/$mcpJobId/out]"
							AgentsMcpSendResult "$mcpId" "$( printf '{"content":[{"type":"text","text":"%s"}],"isError":false}' "$( printf '%s' "$mcpOutput" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsMcpJsonEscape.awk" )" )"

						else
							## Seconds. A non-numeric or absent value takes the default rather than
							## failing the call, so a caller that never knew this argument exists
							## keeps working; the cap stops one call holding the server for an hour.
							case "$mcpTimeout" in
								''|*[!0-9]*) mcpTimeout=600 ;;
								*) [ "$mcpTimeout" -ge 1 ] 2>/dev/null || mcpTimeout=600 ;;
							esac
							[ "$mcpTimeout" -le 3600 ] || mcpTimeout=3600

							mcpOutFile="$MMDAPP/.local/temp/agent-mcp.$$/out.$AGENTS_MCP_REQ_SEQ"
							mcpKillFile="$MMDAPP/.local/temp/agent-mcp.$$/killed.$AGENTS_MCP_REQ_SEQ"
							rm -f "$mcpKillFile"

							## Both forks run under set -m, each in a process group of its own, so
							## one signal reaches the whole tree and the watchdog's own sleep dies
							## with it. Pipeline inside the subshell so $! is the group leader.
							mcpExitCode=0
							set -m
							if [ -n "$mcpWorkspace" ] ; then
								( printf '%s\n' "$mcpScript" | ( exec "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh" --intern-mcp-execute --workspace "$mcpWorkspace" ) ) > "$mcpOutFile" 2>&1 &
							else
								( printf '%s\n' "$mcpScript" | DistroAgentsTools --intern-mcp-execute ) > "$mcpOutFile" 2>&1 &
							fi
							mcpCmdPid=$!

							## Marks the kill before sending it, so the wait below tells a timeout
							## from the script's own non-zero exit; TERM first for a script with
							## traps of its own, KILL after a grace period for one that ignores it.
							(
								sleep "$mcpTimeout"
								kill -0 "$mcpCmdPid" 2>/dev/null || exit 0
								: > "$mcpKillFile"
								kill -TERM -- "-$mcpCmdPid" 2>/dev/null
								sleep 5
								kill -KILL -- "-$mcpCmdPid" 2>/dev/null
							) &
							mcpWatchPid=$!
							set +m

							wait "$mcpCmdPid" || mcpExitCode=$?
							kill -TERM -- "-$mcpWatchPid" 2>/dev/null
							wait "$mcpWatchPid" 2>/dev/null
							set +e

							mcpOutput="$( < "$mcpOutFile" )"

							mcpIsError='false'
							if [ -f "$mcpKillFile" ] ; then
								## The partial output is kept and its path named: a timeout is when
								## the caller most needs to see how far the command got.
								mcpIsError='true'
								mcpOutput="$mcpOutput"$'\n'"[timed out after ${mcpTimeout}s and was killed; partial output above is kept at: $mcpOutFile]"
								rm -f "$mcpKillFile"
							elif [ 0 -ne "$mcpExitCode" ] ; then
								mcpIsError='true'
								mcpOutput="$mcpOutput"$'\n'"[exit code: $mcpExitCode]"
								rm -f "$mcpOutFile"
							else
								rm -f "$mcpOutFile"
							fi
							[ -n "$mcpOutput" ] || mcpOutput='(no output)'

							AgentsMcpSendResult "$mcpId" "$( printf '{"content":[{"type":"text","text":"%s"}],"isError":%s}' "$( printf '%s' "$mcpOutput" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsMcpJsonEscape.awk" )" "$mcpIsError" )"
						fi
					;;
					'')
						AgentsMcpSendError "$mcpId" -32700 "Parse error"
					;;
					*)
						AgentsMcpSendError "$mcpId" -32601 "Method not found: $mcpMethod"
					;;
				esac
			} < /dev/null &
		done
		wait

		rm -rf "$MMDAPP/.local/temp/agent-mcp.$$"
		trap - EXIT INT TERM
		return 0
	;;

	*)
		printf '%s\n' "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;

esac
