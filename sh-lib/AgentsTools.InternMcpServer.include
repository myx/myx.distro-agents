#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## The `myx.distro` MCP stdio server. Sourced from DistroAgentsTools.fn.sh's
## `--intern-mcp-server` arm; needs $1/$@/$MDSC_CMD from dot-sourcing.
## stdout is the JSON-RPC wire: every diagnostic goes to stderr.
## Every request is handled in its own background job, and the wire is
## serialised by a mkdir lock so two responses can never interleave.
## Every scratch file lives under $MMDAPP/.local/temp/agent-mcp.$$/ and that
## path is written out in full at each use: the location is on the line itself.
## set -e rules, portability floor and design notes: see MAGIC.md.
##

## Empty id means a notification: no response.
## mkdir is the atomic test-and-set every POSIX filesystem has, where flock is
## not guaranteed on bare FreeBSD/Darwin. Held for the one printf only.
## $$ is the server's own pid in a background job too, never the subshell's.
AgentsMcpSendResult(){
	local mcpLockSpin=0
	[ -n "$1" ] || return 0
	while ! mkdir "$MMDAPP/.local/temp/agent-mcp.$$/wire.lock" 2>/dev/null ; do
		mcpLockSpin=$(( mcpLockSpin + 1 ))
		if [ 500 -le "$mcpLockSpin" ] ; then
			sleep 1
			mcpLockSpin=0
		fi
	done
	printf '{"jsonrpc":"2.0","id":%s,"result":%s}\n' "$1" "$2"
	rmdir "$MMDAPP/.local/temp/agent-mcp.$$/wire.lock" 2>/dev/null
	return 0
}

## mcpErrText is held: escaping forks awk, which must stay outside the lock.
AgentsMcpSendError(){
	local mcpErrText='' mcpLockSpin=0
	[ -n "$1" ] || return 0
	mcpErrText="$( printf '%s' "$3" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsMcpJsonEscape.awk" )" || mcpErrText=''
	while ! mkdir "$MMDAPP/.local/temp/agent-mcp.$$/wire.lock" 2>/dev/null ; do
		mcpLockSpin=$(( mcpLockSpin + 1 ))
		if [ 500 -le "$mcpLockSpin" ] ; then
			sleep 1
			mcpLockSpin=0
		fi
	done
	printf '{"jsonrpc":"2.0","id":%s,"error":{"code":%s,"message":"%s"}}\n' "$1" "$2" "$mcpErrText"
	rmdir "$MMDAPP/.local/temp/agent-mcp.$$/wire.lock" 2>/dev/null
	return 0
}

case "$1" in

	--intern-mcp-server)
		shift

		## Never serve without --run: an accidental stdin loop hangs forever.
		if [ "--run" != "$1" ] ; then
			printf '%s\n' "$MDSC_CMD --intern-mcp-server -- MCP stdio server registered as 'myx.distro'." >&2
			printf '%s\n' "" >&2
			printf '%s\n' "  $MDSC_CMD --intern-mcp-server --run" >&2
			printf '%s\n' "      Speak JSON-RPC 2.0 over stdin/stdout until stdin closes." >&2
			printf '%s\n' "      Launched by an MCP host, not by hand." >&2
			printf '%s\n' "" >&2
			printf '%s\n' "Exposes one tool, 'execute', backed by $MDSC_CMD --intern-mcp-execute." >&2
			set +e ; return 1
		fi
		shift

		if [ 0 -lt $# ] ; then
			printf '%s\n' "$MDSC_CMD: mcp-server --run: ⛔ ERROR: takes no further arguments: $*" >&2
			set +e ; return 1
		fi

		set +e

		## The one scratch root, workspace-local and one per server process:
		## req is the current request's parsed fields, wire.lock the response
		## mutex, out.<seq> one job's output. The pid keeps concurrent servers
		## apart; a leftover directory from a crashed run under a recycled pid
		## is cleared first, so a restart never inherits a stale wire.lock.
		rm -rf "$MMDAPP/.local/temp/agent-mcp.$$"
		if ! mkdir -p "$MMDAPP/.local/temp/agent-mcp.$$" ; then
			printf '%s\n' "$MDSC_CMD: mcp-server: ⛔ ERROR: cannot create scratch directory $MMDAPP/.local/temp/agent-mcp.$$" >&2
			return 1
		fi
		AGENTS_MCP_REQ_SEQ=0
		trap 'rm -rf "$MMDAPP/.local/temp/agent-mcp.$$"' EXIT INT TERM

		## Check-init witness; stderr only.
		printf '%s\n' "# myx.distro agentMcp: pid=$$ origin=$MDLT_ORIGIN mode=${MDLC_INMODE:-?} spec=${MDLT_OPTION:-?} root=$MMDAPP scratch=$MMDAPP/.local/temp/agent-mcp.$$" >&2

		## `|| [ -n ... ]` keeps a final line that has no trailing newline.
		while IFS= read -r mcpLine || [ -n "$mcpLine" ] ; do
			## Per iteration: the dispatcher re-arms -e on every call.
			set +e

			[ -n "$mcpLine" ] || continue

			rm -rf "$MMDAPP/.local/temp/agent-mcp.$$/req"
			if ! mkdir -p "$MMDAPP/.local/temp/agent-mcp.$$/req" ; then
				printf '%s\n' "$MDSC_CMD: mcp-server: ⛔ ERROR: cannot create request scratch directory, skipping one message" >&2
				continue
			fi

			printf '%s\n' "$mcpLine" | LC_ALL=C awk -v outDir="$MMDAPP/.local/temp/agent-mcp.$$/req" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsMcpJsonParseRequest.awk"

			## Read here and not in the job below: the next message wipes this
			## directory while that job still runs, and the fork copies these.
			## `read`, not $( ): avoiding the fork is the point. Guarded on the
			## file, never on 2>/dev/null: a failing `<` reports before a later
			## redirection applies. An absent file leaves the empty default,
			## which is exactly what the parser omitting that field means.
			## has_id exists only when the parser also wrote id.
			mcpMethod='' ; mcpId='' ; mcpToolName=''
			[ ! -f "$MMDAPP/.local/temp/agent-mcp.$$/req/method" ] || IFS= read -r mcpMethod < "$MMDAPP/.local/temp/agent-mcp.$$/req/method" || true
			[ ! -f "$MMDAPP/.local/temp/agent-mcp.$$/req/tool_name" ] || IFS= read -r mcpToolName < "$MMDAPP/.local/temp/agent-mcp.$$/req/tool_name" || true
			[ ! -f "$MMDAPP/.local/temp/agent-mcp.$$/req/has_id" ] || IFS= read -r mcpId < "$MMDAPP/.local/temp/agent-mcp.$$/req/id" || true
			## $(cat) not read: a script spans lines.
			mcpScript="$( cat "$MMDAPP/.local/temp/agent-mcp.$$/req/arg_command" 2>/dev/null || true )"

			## The whole handler forks, not just the command: this loop then
			## waits on nothing a script can influence, and a slow request
			## delays only its own response. stdin is /dev/null so no handler
			## can ever eat the wire.
			AGENTS_MCP_REQ_SEQ=$(( AGENTS_MCP_REQ_SEQ + 1 ))
			{
				case "$mcpMethod" in
					initialize)
						AgentsMcpSendResult "$mcpId" '{"protocolVersion":"2025-06-18","capabilities":{"tools":{}},"serverInfo":{"name":"myx.distro","version":"1.0.0"}}'
					;;
					notifications/*)
						## No response ever; cancelled is a no-op while nothing is tracked.
						:
					;;
					ping)
						AgentsMcpSendResult "$mcpId" '{}'
					;;
					tools/list)
						AgentsMcpSendResult "$mcpId" '{"tools":[{"name":"execute","description":"Evaluate a shell script in this workspace with its environment already initialized: MMDAPP and MDLT_ORIGIN resolved to the tree actually in use, and the workspace consoles and tools reachable. Returns the script combined stdout and stderr, plus its exit status.","inputSchema":{"type":"object","properties":{"command":{"type":"string","description":"Shell script to evaluate. May span multiple lines."}},"required":["command"]}}]}'
					;;
					tools/call)
						if [ "execute" != "$mcpToolName" ] ; then
							AgentsMcpSendError "$mcpId" -32602 "Unknown tool: $mcpToolName"
						elif [ -z "$mcpScript" ] ; then
							AgentsMcpSendError "$mcpId" -32602 "execute requires a non-empty 'command' argument"
						else
							## Redirected to a file, never captured by $( ): a command substitution
							## returns only once its pipe has no writers left, so any child the script
							## leaves running (`&`, a daemon, nohup) would hold this response forever.
							## The pipe keeps the script off the loop's stdin, which is the wire.
							## The seq counter keeps two concurrent jobs off each other's output file.
							## Never `cmd ; rc=$?`: under -e that dies before reading $?.
							mcpExitCode=0
							printf '%s\n' "$mcpScript" | DistroAgentsTools --intern-mcp-execute > "$MMDAPP/.local/temp/agent-mcp.$$/out.$AGENTS_MCP_REQ_SEQ" 2>&1 || mcpExitCode=$?
							set +e

							mcpOutput="$( < "$MMDAPP/.local/temp/agent-mcp.$$/out.$AGENTS_MCP_REQ_SEQ" )"
							rm -f "$MMDAPP/.local/temp/agent-mcp.$$/out.$AGENTS_MCP_REQ_SEQ"

							mcpIsError='false'
							if [ 0 -ne "$mcpExitCode" ] ; then
								mcpIsError='true'
								mcpOutput="$mcpOutput"$'\n'"[exit code: $mcpExitCode]"
							fi
							[ -n "$mcpOutput" ] || mcpOutput='(no output)'

							AgentsMcpSendResult "$mcpId" "$( printf '{"content":[{"type":"text","text":"%s"}],"isError":%s}' "$( printf '%s' "$mcpOutput" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsMcpJsonEscape.awk" )" "$mcpIsError" )"
						fi
					;;
					'')
						AgentsMcpSendError "$mcpId" -32700 "Parse error"
					;;
					*)
						AgentsMcpSendError "$mcpId" -32601 "Method not found: $mcpMethod"
					;;
				esac
			} < /dev/null &
		done
		## Every handler is a background job of THIS shell, so end-of-stdin
		## must not be the end of the process: without this wait the loop
		## falls straight through to the rm -rf below and deletes
		## out.<seq> under a handler still writing its response, which is
		## then answered never -- measured, both tools/call requests of a
		## six-message probe were lost exactly this way. wait returns as
		## soon as each handler pipeline does; a child the script itself
		## left running (`&`, a daemon) is a grandchild, not a job of this
		## shell, so it is never waited on and cannot hold shutdown.
		wait

		rm -rf "$MMDAPP/.local/temp/agent-mcp.$$"
		trap - EXIT INT TERM
		return 0
	;;

	*)
		printf '%s\n' "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;

esac
