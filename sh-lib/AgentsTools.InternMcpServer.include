#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## The `myx.distro` MCP stdio server. Sourced from DistroAgentsTools.fn.sh's
## `--intern-mcp-server` arm; needs $1/$@/$MDSC_CMD from dot-sourcing.
## A launcher and nothing more: it holds MMDAPP and MDLT_ORIGIN, reads one message
## at a time, and starts `--intern-mcp-request` for each in a fresh process, which
## reads everything else -- the tool floor, identity, access, workspace context --
## on that call. Nothing a request is answered from depends on when this started.
## stdout is the JSON-RPC wire, handed to each request as its fd 3; every
## diagnostic goes to stderr. Every scratch file lives under
## $MMDAPP/.local/temp/agent-mcp.$$/, written out in full at each use.
## set -e rules, portability floor and design notes: see MAGIC.md.
##


case "$1" in

	--intern-mcp-server)
		shift

		## Never serve without --run: an accidental stdin loop hangs forever.
		if [ "--run" != "$1" ] ; then
			printf '%s\n' "$MDSC_CMD --intern-mcp-server -- MCP stdio server registered as 'myx.distro'." >&2
			printf '%s\n' "" >&2
			printf '%s\n' "  $MDSC_CMD --intern-mcp-server --run" >&2
			printf '%s\n' "      Speak JSON-RPC 2.0 over stdin/stdout until stdin closes." >&2
			printf '%s\n' "      Launched by an MCP host, not by hand." >&2
			printf '%s\n' "" >&2
			printf '%s\n' "Exposes 'execute', backed by $MDSC_CMD --intern-mcp-execute, plus the" >&2
			printf '%s\n' "harness tool floor rendered by sh-lib/AgentsHarnessMcpMirror.sh and run one" >&2
			printf '%s\n' "call at a time by sh-lib/AgentsUniversalHarness.sh --intern-tool. Bash is not" >&2
			printf '%s\n' "among them: arbitrary command execution is myx.common's own MCP method." >&2
			set +e ; return 1
		fi
		shift

		if [ 0 -lt $# ] ; then
			printf '%s\n' "$MDSC_CMD: mcp-server --run: ⛔ ERROR: takes no further arguments: $*" >&2
			set +e ; return 1
		fi

		set +e

		## MMDAPP is frozen into the host registration at install time.
		if [ ! -d "$MMDAPP/.local" ] ; then
			printf '%s\n' "$MDSC_CMD: mcp-server: ⛔ ERROR: MMDAPP is not a set-up myx.distro workspace: $MMDAPP -- the MCP host registration freezes this path at install time and it no longer resolves. Re-run DistroAgentsTools.fn.sh --make-workspace-integrations from that workspace to rewrite it." >&2
			return 1
		fi

		rm -rf "$MMDAPP/.local/temp/agent-mcp.$$"
		if ! mkdir -p "$MMDAPP/.local/temp/agent-mcp.$$" ; then
			printf '%s\n' "$MDSC_CMD: mcp-server: ⛔ ERROR: cannot create scratch directory $MMDAPP/.local/temp/agent-mcp.$$" >&2
			return 1
		fi
		AGENTS_MCP_REQ_SEQ=0
		## A signal ends the server: removing the scratch root and reading on would leave
		## every later request with nowhere to answer from, and the host waiting on it.
		trap 'rm -rf "$MMDAPP/.local/temp/agent-mcp.$$"' EXIT
		trap 'exit 130' INT
		trap 'exit 143' TERM

		## Check-init witness; stderr only.
		printf '%s\n' "# myx.distro agentMcp: pid=$$ origin=$MDLT_ORIGIN root=$MMDAPP scratch=$MMDAPP/.local/temp/agent-mcp.$$ -- every request is served by a fresh --intern-mcp-request" >&2

		## `|| [ -n ... ]` keeps a final line that has no trailing newline.
		while IFS= read -r mcpLine || [ -n "$mcpLine" ] ; do
			[ -n "$mcpLine" ] || continue
			AGENTS_MCP_REQ_SEQ=$(( AGENTS_MCP_REQ_SEQ + 1 ))
			## One process per message, so a slow request delays only its own response
			## and the next message is read at once. What this shell derived at start
			## from configuration is dropped first -- the team-data root, MYXROOT and
			## the distro index state -- so the request resolves them again, now.
			## MMDAPP and the origin pair stay, and so does the skillset root: it is
			## the one a caller may hand in (every rig does), it names a directory
			## rather than a setting, and the members inside it are read per call.
			## The message goes in on stdin; the wire goes in as fd 3 and the
			## request's own stdout is stderr, so nothing it or anything it runs
			## prints can land on the wire.
			(
				unset MDAT_DATA_ROOT MYXROOT MDSC_OPTION MDSC_INMODE MDSC_SOURCE MDSC_CACHED MDSC_OUTPUT MDSC_MEMORY
				for mcpStaleIndex in ${!MDSC_ID*} ; do unset "$mcpStaleIndex" ; done
				printf '%s\n' "$mcpLine" | exec "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh" --intern-mcp-request "$$" "$AGENTS_MCP_REQ_SEQ" 3>&1 1>&2
			) < /dev/null &
		done
		wait

		rm -rf "$MMDAPP/.local/temp/agent-mcp.$$"
		trap - EXIT INT TERM
		return 0
	;;

	*)
		printf '%s\n' "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;

esac
