#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.InternContact.include -- the --intern-op-contact-* primitives,
## the contact family's own file. Sourced lazily from the
## `--intern-op-contact-*)` wildcard arm via the standard $MDLT_ORIGIN-based
## path, so a further contact primitive is a new arm here and no dispatcher
## line. Not standalone: relies on being dot-sourced for $1/$@/$MDSC_CMD.
## Contracts in MAGIC.md.
##

case "$1" in

	## Sits above the send path and composes what it already accepts: which
	## client-*/partner- the request came through is the caller's knowledge,
	## not the shared sender's. See MAGIC.md.
	--intern-op-contact-digest-send)
		shift
		## Which wrapper the caller actually invoked, so an error names the
		## operation they typed rather than this primitive.
		local opContext="--intern-op-contact-digest-send"
		local ctxWanted="" ctxArg
		for ctxArg in "$@" ; do
			if [ -n "$ctxWanted" ] ; then
				opContext="$ctxArg" ; ctxWanted="" ; continue
			fi
			if [ "$ctxArg" = "--context" ] ; then ctxWanted="1" ; fi
		done
		local digestMember="$1"
		shift || true
		local digestOrigin="$1"
		shift || true
		if [ -z "$digestMember" ] || [ -z "$digestOrigin" ] ; then
			echo "⛔ ERROR: $MDSC_CMD $opContext: syntax is <team-member> <origin team-member> (--resolved|--needs-ruling) <text...>" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$digestMember" "<team-member>" intern-op-contact-digest-send || { set +e ; return 1 ; }
		AgentsToolsAssertBareName "$digestOrigin" "<origin>" intern-op-contact-digest-send || { set +e ; return 1 ; }
		local digestRoute="" digestText=""
		while [ $# -gt 0 ] ; do
			case "$1" in
				--resolved|--needs-ruling)
					if [ -n "$digestRoute" ] ; then
						echo "⛔ ERROR: $MDSC_CMD $opContext: --resolved and --needs-ruling are mutually exclusive -- one assessment, one route" >&2
						set +e ; return 1
					fi
					digestRoute="$1" ; shift
				;;
				--context)
					if [ -z "${2:-}" ] ; then
						echo "⛔ ERROR: $MDSC_CMD $opContext: --context: value required" >&2
						set +e ; return 1
					fi
					shift 2
				;;
				--*)
					echo "⛔ ERROR: $MDSC_CMD $opContext: invalid option: $1 -- syntax is <team-member> <origin team-member> (--resolved|--needs-ruling) <text...>" >&2
					set +e ; return 1
				;;
				*)
					digestText="$digestText $1" ; shift
				;;
			esac
		done
		if [ -z "$digestRoute" ] || [ -z "$digestText" ] ; then
			echo "⛔ ERROR: $MDSC_CMD $opContext: syntax is <team-member> <origin team-member> (--resolved|--needs-ruling) <text...>" >&2
			set +e ; return 1
		fi

		## --address-to carries the origin: the header's `to` slot is the one
		## that renders on a send, and he has ruled that arrangement in as it
		## stands rather than have the header changed for it.
		if [ "$digestRoute" = "--needs-ruling" ] ; then
			## His own Slack DM, because that is where he replies: the send
			## path's own human-owner target, which forces a user identity.
			DistroAgentsTools --member-comms-slack-send-message "$digestMember" human-owner \
				--address-to "$digestOrigin" "${digestText# }"
			return $?
		fi

		## The bot's own conversation with him. That same human-owner target
		## cannot be it -- it forces the user identity by design -- so this
		## route names his account and lets --identity-bot open the bot DM.
		local ownerUserId
		ownerUserId="$( DistroAgentsTools --agents-config-option magic-team --select SLACK_CHANNEL_HUMAN_OWNER )" || ownerUserId=""
		if [ -z "$ownerUserId" ] ; then
			echo "⛔ ERROR: $MDSC_CMD $opContext: --resolved: no SLACK_CHANNEL_HUMAN_OWNER configured -- the bot's own conversation with him cannot be addressed without his account id" >&2
			set +e ; return 1
		fi
		DistroAgentsTools --member-comms-slack-send-message "$digestMember" "$ownerUserId" --identity-bot \
			--address-to "$digestOrigin" "${digestText# }"
		return $?
	;;

	## The outbound-to-unlisted-people gate: one shared check, called from
	## each real send op (Slack, email) right before its own network call,
	## never duplicated per protocol. "Known" is deliberately narrow here --
	## any row in the acting member's own contacts note, by the format in
	## magic-team/templates/contacts.document.format.md, counts regardless of
	## its own permission-level: this gate is about a recipient being on
	## record at all, not about the separate tier-3 permission question that
	## format's own permission-level field answers. Not known: refused via
	## the existing --intern-op-permission-refusal-log/grant-open flow, so
	## approval travels the one path every other refusal already does.
	--intern-op-contact-assert-known)
		shift
		local assertMember="$1"
		shift || true
		local assertTool="" assertTarget="" assertNamed="" assertMessage=""
		while [ $# -gt 0 ] ; do
			case "$1" in
				--tool)
					if [ -z "${2:-}" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --intern-op-contact-assert-known: --tool value missing" >&2
						set +e ; return 1
					fi
					assertTool="$2" ; shift 2
				;;
				--target)
					if [ -z "${2:-}" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --intern-op-contact-assert-known: --target value missing" >&2
						set +e ; return 1
					fi
					assertTarget="$2" ; shift 2
				;;
				--named-member)
					assertNamed="${2:-}" ; shift 2
				;;
				--message)
					assertMessage="${2:-}" ; shift 2
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --intern-op-contact-assert-known: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$assertMember" ] || [ -z "$assertTool" ] || [ -z "$assertTarget" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-op-contact-assert-known: syntax is <team-member> --tool <bare-op-name, no leading --> --target <recipient> [--named-member <team-member>] [--message <text>]" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$assertMember" "<team-member>" intern-op-contact-assert-known || { set +e ; return 1 ; }
		AgentsToolsAssertBareName "$assertTool" "--tool" intern-op-contact-assert-known || { set +e ; return 1 ; }

		## A recipient already addressed by our own internal member name --
		## a partner-*/human-owner team member -- is always known: these are
		## the "partner and human members" the human-owner named, independent
		## of any contacts note.
		case "$assertNamed" in
			partner-*|human-owner) return 0 ;;
		esac

		## The acting member's own contacts note -- one per identity, per
		## that format's own "Goals" section -- is read directly (this is
		## the op's own internal implementation, not a member-facing read),
		## first file matching regardless of its own creation timestamp.
		local assertContactsFile="" assertCandidate
		for assertCandidate in "$MDAT_DATA_ROOT/inboxes/$assertMember"/note-*-contacts.md ; do
			[ -f "$assertCandidate" ] || continue
			assertContactsFile="$assertCandidate" ; break
		done
		if [ -n "$assertContactsFile" ] ; then
			## Two sources, not one: the `# Index` table's own slack-id/email
			## columns, AND each person's `conversations:` line under `#
			## Contacts` -- the Index table carries no conversation-id column
			## of its own, so a raw channel/DM target (what a Slack send
			## actually gets as its recipient) can only ever be found there.
			## $0 is read as-is in the `conversations:` pattern-action below
			## regardless of the `-F'|'` split used for the Index rows: FS
			## splits fields, never the stored record text itself.
			if LC_ALL=C awk -F'|' -v want="$assertTarget" '
				function trim(s) { sub(/^[ \t]+/, "", s) ; sub(/[ \t]+$/, "", s) ; return tolower(s) }
				NF >= 6 {
					sid = trim($2) ; mail = trim($5) ;
					if ( sid != "" && sid == tolower(want) ) { found = 1 ; exit }
					if ( mail != "" && mail == tolower(want) ) { found = 1 ; exit }
				}
				/^[ \t]*conversations:/ {
					line = $0
					sub(/^[ \t]*conversations:[ \t]*/, "", line)
					n = split(line, ids, ",")
					for (i = 1; i <= n; i++) {
						cid = trim(ids[i])
						if ( cid != "" && cid == tolower(want) ) { found = 1 ; exit }
					}
				}
				END { exit found ? 0 : 1 }
			' "$assertContactsFile" ; then
				return 0
			fi
		fi

		## Not known: refused, bound to this exact message text so a later
		## approval covers only what the human-owner actually saw -- a
		## changed message to the same recipient needs its own approval.
		local assertDigest assertBoundTarget
		assertDigest="$( printf '%s' "$assertMessage" | LC_ALL=C cksum | LC_ALL=C awk '{ print $1 }' )"
		assertBoundTarget="$assertTarget#msg-$assertDigest"
		local assertRefusalId=""
		assertRefusalId="$( DistroAgentsTools --intern-op-permission-refusal-log "$assertMember" \
			--session-id "${MDAT_SPAWN_SESSION_ID:-no-session-$$}" \
			--tool "$assertTool" --target "$assertBoundTarget" \
			--reason "outbound --$assertTool to '$assertTarget' refused: not the human-owner's own chat, not a partner-/human- member, not listed in ${assertMember}'s own contacts note" \
			2>/dev/null | LC_ALL=C sed -n 's/^\(refusal-[0-9a-f-]*\)$/\1/p' | head -1 )" || assertRefusalId=""
		echo "⛔ ERROR: $MDSC_CMD --$assertTool: REFUSED -- '$assertTarget' is not a known contact (not the human-owner's own chat, not a partner-/human- member, not listed in ${assertMember}'s own contacts note). This message was NOT sent. REFUSAL-ID: ${assertRefusalId:-none}. To send it: show the EXACT text of this message to the human-owner and wait for his approved reply -- approval covers only this exact text to this recipient; a changed message needs fresh approval." >&2
		set +e ; return 1
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
