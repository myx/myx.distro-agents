#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.AskThread.include -- how one AskUserQuestion stands in a thread that
## several questions share. Definitions only, sourced by the two readers that judge an
## answer: the wait over a thread (AgentsTools.MemberWait.include) and the escalation
## read (AgentsTools.MemberEscalation.include). Both hand the result to
## AgentsSlackThreadAnswers.awk as -v tag / -v threadCount / -v others (MAGIC.md, "AskUserQuestion").
##

## Prints "<tag>\t<questions the thread has held>" for the question posted at
## <channel>:<question ts>, read from the pending-reply records; "\t0" when no record
## names it, which leaves the answer rules exactly as for a thread of its own. Whether a
## thread is shared is a fact about what it has held, not about how many are open now:
## a late reply tagged for an answered question must not answer the one still open.
## grep does the scanning, so a poll costs one pass over the store however it grows.
AgentsToolsAskThreadStanding(){ ## channel, question ts
	local standChannel="$1" standTs="$2" standStore="$MMDAPP/.local/agents/pending"
	local standFile standLine standTag="" standThread="" standFileChannel standFileThread standFileTag standTotal=0
	[ -n "$standChannel" ] && [ -n "$standTs" ] && [ -d "$standStore" ] || { printf '\t0\n' ; return 0 ; }
	while IFS= read -r standFile ; do
		[ -f "$standFile" ] || continue
		standFileChannel="" standFileThread="" standFileTag=""
		while IFS= read -r standLine ; do
			case "$standLine" in
				'channel: '*) standFileChannel="${standLine#channel: }" ;;
				'thread-ts: '*) standFileThread="${standLine#thread-ts: }" ;;
				'question-tag: '*) standFileTag="${standLine#question-tag: }" ;;
				'# '*) break ;;
			esac
		done < "$standFile"
		if [ "$standFileChannel" = "$standChannel" ] ; then
			standTag="$standFileTag" ; standThread="$standFileThread" ; break
		fi
	done < <( LC_ALL=C grep -r -l -x -F --include='*.md' "question-ts: $standTs" "$standStore" 2>/dev/null )
	[ -n "$standThread" ] || { printf '%s\t0\n' "$standTag" ; return 0 ; }
	while IFS= read -r standFile ; do
		[ -f "$standFile" ] || continue
		LC_ALL=C grep -q -x -F "channel: $standChannel" "$standFile" && standTotal=$(( standTotal + 1 ))
	done < <( LC_ALL=C grep -r -l -x -F --include='*.md' "thread-ts: $standThread" "$standStore" 2>/dev/null )
	printf '%s\t%s\n' "$standTag" "$standTotal"
}

## Prints, space-separated, "<question ts>/<state>" for every OTHER question the thread of
## the question at <channel>:<question ts> has held. <state> is `open` while its record
## waits, the epoch second it was closed at, or `closed` for a record closed before that
## was stamped. AgentsSlackThreadAnswers.awk takes it as -v others: a reply with no
## question number answers the latest question posted above it, only while that one is
## still open. Prints nothing for a thread that has held one question.
AgentsToolsAskThreadOthers(){ ## channel, question ts
	local othChannel="$1" othTs="$2" othStore="$MMDAPP/.local/agents/pending"
	local othFile othLine othThread="" othFileChannel othFileThread othFileTs othFileStatus othFileEpoch othList=""
	[ -n "$othChannel" ] && [ -n "$othTs" ] && [ -d "$othStore" ] || return 0
	while IFS= read -r othFile ; do
		[ -f "$othFile" ] || continue
		othFileChannel="" othFileThread=""
		while IFS= read -r othLine ; do
			case "$othLine" in
				'channel: '*) othFileChannel="${othLine#channel: }" ;;
				'thread-ts: '*) othFileThread="${othLine#thread-ts: }" ;;
				'# '*) break ;;
			esac
		done < "$othFile"
		if [ "$othFileChannel" = "$othChannel" ] ; then
			othThread="$othFileThread" ; break
		fi
	done < <( LC_ALL=C grep -r -l -x -F --include='*.md' "question-ts: $othTs" "$othStore" 2>/dev/null )
	[ -n "$othThread" ] || return 0
	while IFS= read -r othFile ; do
		[ -f "$othFile" ] || continue
		othFileChannel="" othFileTs="" othFileStatus="" othFileEpoch=""
		while IFS= read -r othLine ; do
			case "$othLine" in
				'channel: '*) othFileChannel="${othLine#channel: }" ;;
				'question-ts: '*) othFileTs="${othLine#question-ts: }" ;;
				'status: '*) othFileStatus="${othLine#status: }" ;;
				'resolved-epoch: '*) othFileEpoch="${othLine#resolved-epoch: }" ;;
				'# '*) break ;;
			esac
		done < "$othFile"
		[ "$othFileChannel" = "$othChannel" ] && [ -n "$othFileTs" ] && [ "$othFileTs" != "$othTs" ] || continue
		if [ "$othFileStatus" = "reply-pending" ] ; then
			othList="$othList $othFileTs/open"
		else
			othList="$othList $othFileTs/${othFileEpoch:-closed}"
		fi
	done < <( LC_ALL=C grep -r -l -x -F --include='*.md' "thread-ts: $othThread" "$othStore" 2>/dev/null )
	printf '%s\n' "${othList# }"
}

## The next question number for one addressee, Q<n>, counted per person rather than per
## thread, so two threads to the same person never both show a Q1. Kept as a small counter
## file under the local agents store; taken under the caller's per-addressee ask-thread
## lock. On first use the counter starts above the highest `question-tag` any record to
## that addressee already carries, so no number in use is given again.
AgentsToolsAskThreadNextTag(){ ## addressee
	local tagDir="$MMDAPP/.local/agents/ask-counters" tagKey tagFile tagLast="" tagNext
	tagKey="$( printf '%s' "$1" | LC_ALL=C tr -c 'A-Za-z0-9._-' '_' )"
	tagFile="$tagDir/$tagKey"
	mkdir -p "$tagDir" 2>/dev/null || { printf 'Q1\n' ; return 0 ; }
	[ ! -s "$tagFile" ] || tagLast="$( LC_ALL=C tr -cd '0-9' < "$tagFile" )"
	if [ -z "$tagLast" ] ; then
		tagLast="$( LC_ALL=C grep -r -l -x -F --include='*.md' "address-to: $1" "$MMDAPP/.local/agents/pending" 2>/dev/null \
			| while IFS= read -r tagRecord ; do LC_ALL=C sed -n 's/^question-tag: [Qq]\([0-9][0-9]*\)$/\1/p' "$tagRecord" ; done \
			| LC_ALL=C awk 'BEGIN { top = 0 ; } $1 + 0 > top { top = $1 + 0 ; } END { print top ; }' )"
	fi
	tagNext=$(( ${tagLast:-0} + 1 ))
	printf '%s\n' "$tagNext" > "$tagFile.$$" 2>/dev/null && mv -f "$tagFile.$$" "$tagFile" 2>/dev/null || rm -f "$tagFile.$$"
	printf 'Q%s\n' "$tagNext"
}

## Before a question is posted: prints one line saying whether it is, and where.
##   DUPLICATE<TAB><pending id><TAB><owner><TAB><session>  -- an open question to the same
##       addressee with the same key already stands; nothing is to be posted
##   SAME<TAB><channel><TAB><thread ts><TAB><tag><TAB><pending id><TAB><identity> -- the same
##       question to the same addressee was asked before and is closed: asked again, it is
##       still that question, so it goes into that question's own thread, under its own
##       number (or none), and under the identity (bot|member) it was asked with there
##   NEW<TAB>Q1                                           -- post it, as a message of its own
## A different question never takes over another question's thread: each new question to a
## person or a conversation opens its own thread, which belongs to that question alone, and
## only a <to> naming a thread already (channel:ts) puts a question inside one. SAME comes
## back only for a <to> that would otherwise open a new top-level message, and only for a
## thread the asker can post in again: one asked as the team bot, or by this same member.
## The newest such record wins.
AgentsToolsAskThreadFind(){ ## to, address_to, question key, asking member
	local findTo="$1" findAddress="$2" findKey="$3" findAsker="${4:-}" findFile findLine
	local dupId="" dupOwner="" dupSession=""
	local sameId="" sameChannel="" sameThread="" sameTag="" sameTs="" sameIdentity=""
	local fileStatus fileAddress fileKey fileOwner fileSession fileChannel fileThread fileTag fileTs fileIdentity
	for findFile in "$MMDAPP/.local/agents/pending"/*.md ; do
		[ -f "$findFile" ] || continue
		fileStatus="" fileAddress="" fileKey="" fileOwner="" fileSession="" fileChannel="" fileThread="" fileTag="" fileTs="" fileIdentity=""
		while IFS= read -r findLine ; do
			case "$findLine" in
				'status: '*) fileStatus="${findLine#status: }" ;;
				'address-to: '*) fileAddress="${findLine#address-to: }" ;;
				'question-key: '*) fileKey="${findLine#question-key: }" ;;
				'owner: '*) fileOwner="${findLine#owner: }" ;;
				'session-id: '*) fileSession="${findLine#session-id: }" ;;
				'channel: '*) fileChannel="${findLine#channel: }" ;;
				'thread-ts: '*) fileThread="${findLine#thread-ts: }" ;;
				'question-tag: '*) fileTag="${findLine#question-tag: }" ;;
				'question-ts: '*) fileTs="${findLine#question-ts: }" ;;
				'ask-identity: '*) fileIdentity="${findLine#ask-identity: }" ;;
				'# '*) break ;;
			esac
		done < "$findFile"
		[ "$fileAddress" = "$findAddress" ] && [ -n "$findKey" ] && [ "$fileKey" = "$findKey" ] || continue
		if [ "$fileStatus" = "reply-pending" ] ; then
			dupId="${findFile##*/}" ; dupId="${dupId%.md}" ; dupOwner="$fileOwner" ; dupSession="$fileSession"
			break
		fi
		[ -n "$fileChannel" ] && [ -n "$fileThread" ] || continue
		[ "$fileIdentity" = "bot" ] || { [ -n "$findAsker" ] && [ "$fileOwner" = "$findAsker" ] ; } || continue
		if [ -z "$sameId" ] || [[ "$fileTs" > "$sameTs" ]] ; then
			sameId="${findFile##*/}" ; sameId="${sameId%.md}" ; sameChannel="$fileChannel" ; sameThread="$fileThread" ; sameTag="$fileTag" ; sameTs="$fileTs"
			sameIdentity="${fileIdentity:-member}"
		fi
	done
	if [ -n "$dupId" ] ; then
		printf 'DUPLICATE\t%s\t%s\t%s\n' "$dupId" "$dupOwner" "$dupSession"
		return 0
	fi
	case "$findTo" in
		*:*|*.routine) ;;
		*)
			if [ -n "$sameId" ] ; then
				printf 'SAME\t%s\t%s\t%s\t%s\t%s\n' "$sameChannel" "$sameThread" "$sameTag" "$sameId" "$sameIdentity"
				return 0
			fi
		;;
	esac
	printf 'NEW\tQ1\n'
}

## Whether <channel>:<ts> is the thread a question opened for itself -- its top-level
## message, or the opener a question posted before this design put ahead of it. Prints that
## question's number (empty for a question with none) and returns 0 when it is; returns 1
## otherwise. <channel> may be the conversation id the record names, or the <to> it was asked to.
## A question asked into such a thread is a follow-up on the same question, so it takes no
## number of its own.
AgentsToolsAskThreadRootTag(){ ## channel or to, thread ts
	local rootWhere="$1" rootTs="$2" rootFile rootLine rootChannel rootTo rootTag
	[ -n "$rootWhere" ] && [ -n "$rootTs" ] && [ -d "$MMDAPP/.local/agents/pending" ] || return 1
	while IFS= read -r rootFile ; do
		[ -f "$rootFile" ] || continue
		rootChannel="" rootTo="" rootTag=""
		while IFS= read -r rootLine ; do
			case "$rootLine" in
				'channel: '*) rootChannel="${rootLine#channel: }" ;;
				'communication-channel-id: slack:'*) rootTo="${rootLine#communication-channel-id: slack:}" ;;
				'question-tag: '*) rootTag="${rootLine#question-tag: }" ;;
				'# '*) break ;;
			esac
		done < "$rootFile"
		## Only a question that opened this thread: one asked into it names a thread as its <to>.
		case "$rootTo" in *:*|'') continue ;; esac
		[ "$rootChannel" = "$rootWhere" ] || [ "$rootTo" = "$rootWhere" ] || continue
		printf '%s\n' "$rootTag"
		return 0
	done < <( LC_ALL=C grep -r -l -x -F --include='*.md' "thread-ts: $rootTs" "$MMDAPP/.local/agents/pending" 2>/dev/null )
	return 1
}
