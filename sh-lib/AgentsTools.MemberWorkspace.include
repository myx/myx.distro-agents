#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.MemberWorkspace.include -- the workspace a team-member operation runs in.
## Functions only; sourced at the entry of DistroAgentsTools, before its context is resolved.
##

## The member set root for work in another workspace: that workspace's own member index
## view where the root here is this workspace's own view, which holds this workspace's
## members only (AgentsTools.TeamRegistry.include); a root set anywhere else is kept as it is.
AgentsToolsWorkspaceSkillsetRoot(){ ## workspace path
	if [ "${MDAT_SKILLSET_ROOT:-}" = "${MMDAPP%/}/.local/agents/members" ] ; then
		printf '%s\n' "${1%/}/.local/agents/members"
	else
		printf '%s\n' "${MDAT_SKILLSET_ROOT:-}"
	fi
}

## Moves this process to another workspace root. The tooling origin stays, and everything
## derived from the previous root is dropped so it is derived again from the new one.
AgentsToolsWorkspaceSwitch(){ ## workspace path
	local switchStale
	## the member set root, worked out against the previous root before MMDAPP moves
	MDAT_SKILLSET_ROOT="$( AgentsToolsWorkspaceSkillsetRoot "$1" )"
	export MMDAPP="$1"
	## all derived from the previous root, and an index path is matched before MDSC_CACHED
	unset MDSC_OPTION MDSC_INMODE MDSC_SOURCE MDSC_CACHED MDSC_OUTPUT MDSC_MEMORY
	## the team data store of the previous root; resolved again from the new one
	unset MDAT_DATA_ROOT
	## by prefix, so a new index variable needs no edit here
	for switchStale in ${!MDSC_ID*} ; do unset "$switchStale" ; done
	## ...and the input tier derived again now, from the new root, the way the front door
	## (DistroAgentsTools.fn.sh's tail) derived it for the previous one -- so a reader of
	## the distro index finds the same tier selected as a direct run in that workspace.
	## Quiet and non-fatal: a root with no detectable input still switches, and a reader
	## that needs an index then names the failure itself.
	if type DistroSystemContext >/dev/null 2>&1 ; then
		DistroSystemContext --distro-path-auto 2>/dev/null || :
	fi
}

## The workspace a member operation runs in, from the machine-wide member directory, the
## member homes and the workspaces this machine knows, all in $HOME/.agents/magic-team
## (AgentsTools.TeamRegistry.include, AgentsTools.MemberHomes.include, AgentsTools.Places.include).
## Order: the current workspace when the member is there, else the member's home, else the
## known workspace where the member is a source link, else the first known workspace that
## has it. A member registered only from a workspace without agents (source-declared) runs
## where it was asked. Prints the path to switch to, and nothing when no switch is needed:
## the member is in the current workspace, is not in the directory (its operation refuses
## as it always has), or the current workspace is not in it. Refuses, naming the cause, when
## the member is in no known workspace or the chosen workspace is not on this machine.
AgentsToolsMemberWorkspaceResolve(){ ## member, operation
	local resolveMember="$1" resolveOp="$2"
	local resolveIndex="${HOME:-}/.agents/magic-team/members.registry" resolveTracked resolveHome=""
	local resolveHere resolveRows resolveWanted resolveRoot resolveKind resolvePath=""
	case "$resolveMember" in
		''|magic-team|human-owner) return 0 ;;
	esac
	[ -f "$resolveIndex" ] || return 0
	resolveHere="$( cd "$MMDAPP" 2>/dev/null && pwd )" || resolveHere="${MMDAPP%/}"
	resolveRows="$( LC_ALL=C awk -F'\t' -v who="$resolveMember" -v here="$resolveHere" '
		NF < 5 { next ; }
		$2 == here { tracked = 1 ; }
		$1 == who {
			found = 1
			if ( $3 == "source-declared" ) { next ; }
			if ( $2 == here ) { present = 1 ; }
			switchable = 1 ; rows = rows $2 "\t" $3 "\n"
		}
		END {
			if ( ! found ) { print "unknown" ; exit ; }
			if ( ! tracked ) { print "untracked" ; exit ; }
			if ( present || ! switchable ) { print "present" ; exit ; }
			print "switch" ;
			printf "%s", rows ;
		}
	' "$resolveIndex" )"
	[ "${resolveRows%%$'\n'*}" = "switch" ] || return 0
	resolveRows="${resolveRows#*$'\n'}"
	type AgentsToolsPlacesWorkspaceRoots > /dev/null 2>&1 || . "${BASH_SOURCE[0]%/*}/AgentsTools.Places.include"
	resolveTracked="$( AgentsToolsPlacesWorkspaceRoots )"
	resolveHome="$( LC_ALL=C awk -F'\t' -v who="$resolveMember" '$1 == who { print $2 ; exit ; }' "${HOME:-}/.agents/magic-team/member-homes.registry" 2> /dev/null )" || resolveHome=""
	for resolveWanted in home source-symlink any ; do
		while IFS=$'\t' read -r resolveRoot resolveKind ; do
			[ -n "$resolveRoot" ] || continue
			case "$resolveWanted" in
				home) [ -n "$resolveHome" ] && [ "$resolveRoot" = "$resolveHome" ] || continue ;;
				source-symlink) [ "$resolveKind" = "source-symlink" ] || continue ;;
			esac
			## Only a known workspace is switched to.
			case $'\n'"$resolveTracked"$'\n' in
				*$'\n'"$resolveRoot"$'\n'*) resolvePath="$resolveRoot" ; break ;;
			esac
		done <<< "$resolveRows"
		[ -z "$resolvePath" ] || break
	done
	if [ -z "$resolvePath" ] ; then
		echo "⛔ ERROR: $MDSC_CMD $resolveOp: member '$resolveMember' is in the team members index but is present in no tracked workspace -- nothing was done" >&2
		return 1
	fi
	if [ ! -d "$resolvePath" ] ; then
		echo "⛔ ERROR: $MDSC_CMD $resolveOp: the workspace of member '$resolveMember' is not present on this machine: $resolvePath -- nothing was done" >&2
		return 1
	fi
	[ "$( cd "$resolvePath" && pwd -P )" != "$( cd "$MMDAPP" && pwd -P )" ] || return 0
	printf '%s\n' "$resolvePath"
}
