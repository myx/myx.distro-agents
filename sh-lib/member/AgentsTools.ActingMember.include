#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.ActingMember.include -- the member a call acts as, the session it comes from, and the refusal of a call naming another
## member than its own session's. Split from AgentsTools.CallerCheck.include: a path that only asks who acts here parses this and not
## the four caller checks, and the 32 sites that ask it say so at the call.
##

if ! type AgentsToolsActingMember >/dev/null 2>&1 ; then
	## The member a session the tooling spawned acts as: MDAT_SPAWN_AGENT, else the harness's
	## own harnessAgent, else the `owner:` of the spawn record MDAT_SPAWN_SESSION_ID names.
	## An adopted root session has no spawn record: it acts as the member whose routine it runs,
	## which its own store names. Prints nothing otherwise: a human at the console.
	AgentsToolsActingMember(){
		local actingName="${MDAT_SPAWN_AGENT:-${harnessAgent:-}}" actingRecord actingStore actingRoutine
		if [ -z "$actingName" ] && [ -n "${MDAT_SPAWN_SESSION_ID:-}" ] && [ -n "${MMDAPP:-}" ] ; then
			case "$MDAT_SPAWN_SESSION_ID" in
				*/*|.|..) ;;
				*)
					type AgentsSessionRunRecordInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.include"
					AgentsSessionRunRecordInto actingRecord "$MDAT_SPAWN_SESSION_ID" || :
					for actingRecord in ${actingRecord:+"$actingRecord"} ; do
						[ -f "$actingRecord" ] || continue
						type AgentsToolsFrontmatterKey > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/common/AgentsTools.FrontmatterKey.include"
						actingName="$( AgentsToolsFrontmatterKey "$actingRecord" owner )" || actingName=""
						[ -z "$actingName" ] || break
					done
				;;
			esac
		fi
		if [ -z "$actingName" ] && [ -n "${MMDAPP:-}" ] ; then
			## An MCP server hands its adopted root session down as MDAT_SPAWN_SESSION_ID, so that id is
			## read here too: a root session has no spawn record, and its own store names its member.
			actingStore="${MDAT_SESSION_ID:-${harnessSessionId:-${MDAT_SPAWN_SESSION_ID:-${CLAUDE_CODE_SESSION_ID:-}}}}"
			case "$actingStore" in
				''|*/*|.|..) ;;
				*)
					## The session's home is the workspace the call came from; a call run against another workspace
					## reads that one second. A minted root session names its member by its routine; a native root
					## session, never minted, by the one member whose CheckList its store keeps, the rule the spawn
					## proxy names a root session's starter by. Several CheckLists in one store name no one.
					local actingHome="" actingOne=0
					type AgentsSessionKnownIn > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.include"
					type AgentsToolsRootHarnessRoutineInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/routine/AgentsTools.RoutineRootHarness.include"
					for actingHome in "${MDAT_CALLER_WORKSPACE:-$MMDAPP}" "$MMDAPP" ; do
						AgentsSessionKnownIn "$actingHome" "$actingStore" || continue
						if AgentsToolsRootHarnessRoutineInto actingRoutine "$actingStore" "$actingHome" ; then
							actingName="${actingRoutine%%.*}"
							break
						fi
						type AgentsSessionSoleChecklistMemberInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.CheckListSeed.include"
						AgentsSessionSoleChecklistMemberInto actingName "$actingHome" "$actingStore" || actingOne=$?
						[ "$actingOne" != 1 ] || continue
						break
					done
				;;
			esac
		fi
		printf '%s' "$actingName"
	}
	## The session this call comes from, by the rule the spawn proxy names a parent with.
	AgentsToolsActingSession(){
		## A root session, never minted through a spawn, names its own coworking session here
		## too (S21.21): no tooling file read MDAT_SESSION_ID before.
		printf '%s' "${harnessSessionId:-${MDAT_SPAWN_SESSION_ID:-${CLAUDE_CODE_SESSION_ID:-${MDAT_SESSION_ID:-}}}}"
	}
	## The session a call belongs to, by id: the run's own where it runs as itself, the one it joined
	## where the spawn proxy exported that as MDAT_SESSION_ID. A joined run's own id is its spawn id,
	## and the two differ, so a call asking about a session reads this and not the id alone.
	AgentsToolsActingSessionIs(){ ## session id
		[ -n "${1:-}" ] || return 1
		[ "$1" = "$( AgentsToolsActingSession )" ] && return 0
		[ "$1" = "${MDAT_SESSION_ID:-}" ]
	}
	## A call naming another member than the spawned session it runs in is
	## refused: rc 1 with the reason. A call from no such session keeps the name it gives.
	AgentsToolsActingMemberCheck(){ ## named member, operation
		local checkActing
		checkActing="$( AgentsToolsActingMember )"
		[ -n "$checkActing" ] && [ "$checkActing" != "$1" ] || return 0
		## magic-coordinator acts for another member inside our own team in the comms operations it shares with the members (it did so with the coordinator's forms the names merged into).
		if [ "$checkActing" = magic-coordinator ] ; then
			case " slack-read slack-send-message slack-react email-send email-mark-seen jira-board-list jira-board-read jira-board-issue-search jira-sprint-list jira-sprint-issue-search jira-issue-read confluence-space-list confluence-page-read " in
				*" $2 "*) return 0 ;;
			esac
		fi
		echo "$MDSC_CMD: $2: ⛔ ERROR: this session acts as $checkActing, so it cannot act as $1 -- nothing was done: ask $1 to run it, or the session's magic-coordinator to spawn one that acts as $1.$( AgentsToolsCallerRefusalId "$checkActing" "$2" "acts as $checkActing, named $1" )" >&2
		return 1
	}
fi

if ! type AgentsToolsConsoleAccount >/dev/null 2>&1 ; then
	## THE PERSON AT THE CONSOLE, the one place that says it, and every caller takes it from here: the account that used sudo to get to this process
	## (SUDO_USER, root included, so a root login acting as another account is told from that account itself), else the effective account of the process
	## (`id -un`, or USER and LOGNAME where the system gives none). One word, blanks as `_`. Nothing and rc 1 where there is none: the name is never made up.
	AgentsToolsConsoleAccount(){
		local personName="${SUDO_USER:-}"
		[ -n "$personName" ] || personName="$( id -un 2> /dev/null )" || personName=""
		[ -n "$personName" ] || personName="${USER:-${LOGNAME:-}}"
		personName="$( printf '%s' "$personName" | LC_ALL=C tr -s ' \t\r\n' '_' )"
		[ -n "$personName" ] || return 1
		printf '%s\n' "$personName"
	}
fi

if ! type AgentsToolsCallerRefusalId >/dev/null 2>&1 ; then
	## EVERY REFUSAL OF THIS FILE CARRIES ITS REFUSAL-ID: the permission model records it, and the brief every member holds says to
	## escalate a refusal by that id (RequestPermission refusal_id). Prints ` REFUSAL-ID: <id>` for the end of the message, and
	## ` REFUSAL-ID: none` where nothing could be recorded. Runs on a refusal only, so an allowed call pays nothing for it.
	AgentsToolsCallerRefusalId(){ ## acting member, operation, reason
		local refusalId="" refusalSession=""
		refusalSession="$( AgentsToolsActingSession )"
		type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
		refusalId="$( DistroAgentsTools --intern-op-permission-refusal-log "$1" --session-id "${refusalSession:-no-session-$$}" --tool "$2" --target "$2" --reason "$3" \
			2> /dev/null | LC_ALL=C sed -n 's/^\(refusal-[0-9a-f-]*\)$/\1/p' | head -1 )" || refusalId=""
		printf ' REFUSAL-ID: %s' "${refusalId:-none}"
	}
fi
