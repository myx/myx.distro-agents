#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.MemberRetest.include -- the dispatcher of the --retest-* operations of
## DistroAgentsTesting.fn.sh, and nothing else: its `case "$1"` only. The functions that
## do the work live in AgentsTools.RetestQueue.include, which each arm loads when it runs,
## so a caller that only needs the functions sources that library and never runs this
## dispatcher. Sourced, never run. Not standalone: relies on being dot-sourced for
## $1/$@/$MDSC_CMD.
##

case "$1" in

	--retest-queue|--retest-drain|--retest-result)
		local retestOp="$1" retestRc=0
		type AgentsToolsRetestQueue > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.RetestQueue.include"
		shift
		## Each in a shell of its own: the drain holds a lock for as long as it runs, and gives it back however it ends.
		case "$retestOp" in
			--retest-queue) ( set +e ; AgentsToolsRetestQueue "$retestOp" "$@" ) || retestRc=$? ;;
			--retest-drain) ( set +e ; AgentsToolsRetestDrain "$retestOp" "$@" ) || retestRc=$? ;;
			--retest-result) ( set +e ; AgentsToolsRetestResult "$retestOp" "$@" ) || retestRc=$? ;;
		esac
		[ "$retestRc" = 0 ] || { set +e ; return "$retestRc" ; }
		return 0
	;;

	*)
		echo "⛔ ERROR: $MDSC_CMD: invalid option: $1" >&2
		set +e ; return 1
	;;

esac
