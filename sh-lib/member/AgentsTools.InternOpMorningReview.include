#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.InternOpMorningReview.include -- magic-librarian.morning-review.routine's
## own input scan: the --intern-op-morning-review-input-scan implementation, run by the spawner for
## the routine's `input-scan-def: morning-review` line (F6.3, F6.4). Sourced from the dispatcher's
## `--intern-op-morning-review-*` arm; relies on being dot-sourced for $1/$@/$MDSC_CMD.
##
## The scan returns this caller's own cut-off, the board's current state shape (counts, and a
## capped header-only sample of items whose headers contradict their state), and the
## skillset files changed since the cut-off, names only. EVERY CALLER KEEPS ITS OWN CUT-OFF,
## in a fixed record in its own inbox, which is also the routine's locked document (`routine-lock-document:`), moved only by the
## routine's own state update, --update-routine-state (ThisSession), with the scan's `next:` value as `last_reviewed_ts`.
##
## Exit status: 0 every source read, 2 some read (each gap is a `**NOTE:** partial`
## line), 1 none.
##

## Where an inbox item lives (F4.3).
type AgentsToolsInboxDir > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/inbox/AgentsTools.InboxPlace.include"

## Prints the path of <member>'s own morning-review cut-off record.
AgentsToolsMorningReviewStatePath(){ ## member
	printf '%s\n' "$( AgentsToolsInboxDir "$1" )/note-20261008T000000Z-morning-review-state.md"
}

## Prints <member>'s own stored `last_reviewed_ts`: rc 0 found, rc 3 nothing stored yet,
## rc 1 a record that cannot be read (never read as "nothing stored").
AgentsToolsMorningReviewStoredTs(){ ## member
	local storedTarget storedTs
	storedTarget="$( AgentsToolsMorningReviewStatePath "$1" )"
	[ -f "$storedTarget" ] || return 3
	storedTs="$( LC_ALL=C awk '
		NR == 1 && $0 == "---" { inFm = 1 ; sawFm = 1 ; next }
		inFm && $0 == "---" { inFm = 0 ; closed = 1 ; exit }
		inFm && index($0, "last_reviewed_ts:") == 1 { v = substr($0, 18) ; gsub(/^[ \t]+|[ \t]+$/, "", v) }
		END { if (!sawFm || !closed) exit 1 ; if (v == "") exit 3 ; print v }
	' "$storedTarget" )" || return $?
	case "$storedTs" in
		''|*[!0-9]*) return 1 ;;
	esac
	## A cut-off ahead of now would hide every change until then: not a cut-off, a record that cannot be read.
	[ "${#storedTs}" -le 12 ] && [ "$storedTs" -le "$(( $( date +%s ) + 60 ))" ] || return 1
	printf '%s\n' "$storedTs"
}

## Prints epoch <ts> as local `YYYY-MM-DD HH:MM:SS`, the form --librarian-list-team-files-dates
## prints, or nothing when it cannot be converted.
AgentsToolsMorningReviewLocalTime(){ ## epoch
	date -r "$1" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || date -d "@$1" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || :
}

case "$1" in

	--intern-op-morning-review-input-scan)
		shift
		local mrMember="${1:-}" mrContext="--intern-op-morning-review-input-scan"
		shift || true
		if [ "${1:-}" = "--context" ] && [ -n "${2:-}" ] ; then mrContext="$2" ; shift 2 ; fi
		if [ -z "$mrMember" ] || [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD $mrContext: syntax is <team-member>, no other arguments -- an input-scan reads all baseline-relevant items itself. SEE Skill magic-librarian/magic-librarian.morning-review.routine.md" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$mrMember" "<team-member>" morning-review-input-scan || { set +e ; return 1 ; }
		## Run for one of the routine's executors alone: the stub that said so is gone, the spawner runs the scan (F6.4).
		case "$mrMember" in
			magic-coordinator|magic-librarian) ;;
			*)
				echo "⛔ ERROR: $MDSC_CMD $mrContext: unsupported caller: $mrMember (allowed: magic-coordinator | magic-librarian, the routine's executors). SEE Skill magic-librarian/magic-librarian.morning-review.routine.md" >&2
				set +e ; return 1
			;;
		esac
		if [ -z "${MDAT_DATA_ROOT:-}" ] || [ ! -d "$MDAT_DATA_ROOT/board" ] ; then
			echo "⛔ ERROR: $MDSC_CMD $mrContext: no board to read -- MDAT_DATA_ROOT is not set or has no board/" >&2
			set +e ; return 1
		fi
		local mrDefaultDays=7 mrSampleCap=3 mrFilesCap=20
		local mrPartial="" mrSourcesRead=0 mrNow mrSince="" mrSinceFrom="" mrStoredRc=0
		mrNow="$( date +%s )"

		## The cut-off: this caller's own, else the default window.
		mrSince="$( AgentsToolsMorningReviewStoredTs "$mrMember" )" || mrStoredRc=$?
		case "$mrStoredRc" in
			0) mrSinceFrom="stored" ;;
			3) mrSince="$(( mrNow - mrDefaultDays * 86400 ))" ; mrSinceFrom="default, $mrDefaultDays days, nothing stored yet" ;;
			*) mrSince="" ; mrPartial="$mrPartial**NOTE:** partial -- $mrMember's cut-off record $( AgentsToolsMorningReviewStatePath "$mrMember" ) cannot be read, so the changed files are not listed"$'\n' ;;
		esac
		printf '## cutoff (morning-review, %s)\n\n' "$mrMember"
		if [ -n "$mrSince" ] ; then
			printf 'since: %s (%s) -- %s\n' "$mrSince" "$( AgentsToolsMorningReviewLocalTime "$mrSince" )" "$mrSinceFrom"
		else
			printf 'since: unknown\n'
		fi
		printf 'next: %s -- at close: --update-routine-state --header:upsert:last_reviewed_ts:%s\n' "$mrNow" "$mrNow"

		## State shape: live counts, then the sample.
		printf '\n## state shape\n\n'
		local mrState mrFile mrN mrCounts="" mrShapeFiles=()
		for mrState in backlog pending running review blocked parked processed archived retained ; do
			mrN=0
			for mrFile in "$MDAT_DATA_ROOT/board/$mrState"/*.md ; do
				[ -f "$mrFile" ] || continue
				mrN=$(( mrN + 1 ))
				case "$mrState" in running|review|blocked|parked|processed) mrShapeFiles+=( "$mrFile" ) ;; esac
			done
			mrCounts="$mrCounts${mrCounts:+, }$mrState $mrN"
		done
		printf 'counts: %s\n\n' "$mrCounts"
		## Sessions the spawned-sessions registry knows and holds none live (as advance reads them).
		local mrEndedFile="" mrRegistryText=""
		mkdir -p "$MMDAPP/.local/temp" 2> /dev/null && mrEndedFile="$( mktemp "$MMDAPP/.local/temp/mdat-morning-review-ended.XXXXXX" )" || mrEndedFile=""
		if [ -n "$mrEndedFile" ] && . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.Registries.include" 2>/dev/null ; then
			mrRegistryText="$( AgentsToolsRegistryRenderSpawnedSessions agents 2>/dev/null )" || mrRegistryText=""
			case "$mrRegistryText" in
				*"no spawn sandbox root exists"*) : ;;
				""|*"**NOTE:** no scan was made"*)
					mrPartial="$mrPartial**NOTE:** partial -- the spawned-sessions registry could not be read, so running-session-ended is not checked"$'\n'
				;;
				*)
					printf '%s\n' "$mrRegistryText" | LC_ALL=C awk '
						NF == 13 { seen[$2] = 1 ; if ($13 == "running" || $13 == "waiting") live[$2] = 1 }
						END { for (s in seen) if (!(s in live) && s != "-") print s }
					' > "$mrEndedFile"
				;;
			esac
		else
			mrPartial="$mrPartial**NOTE:** partial -- the spawned-sessions registry could not be read, so running-session-ended is not checked"$'\n'
		fi
		## The runs with a spawn record here: an item in review that names no reviewer falls to where its run reports to.
		local mrRunsFile="" mrRunRecord
		mkdir -p "$MMDAPP/.local/temp" 2> /dev/null && mrRunsFile="$( mktemp "$MMDAPP/.local/temp/mdat-morning-review-runs.XXXXXX" )" || mrRunsFile=""
		[ -z "$mrRunsFile" ] || for mrRunRecord in "$MMDAPP"/.local/agents/spawned/*/*.md ; do
			[ -f "$mrRunRecord" ] || continue
			mrRunRecord="${mrRunRecord##*/}" ; printf '%s\n' "${mrRunRecord%.md}"
		done > "$mrRunsFile"
		if mrShapeEndedFile="$mrEndedFile" mrShapeRunsFile="$mrRunsFile" LC_ALL=C awk -v cap="$mrSampleCap" -v width=100 \
			-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsMorningReviewStateShape.awk" \
			"${mrShapeFiles[@]+"${mrShapeFiles[@]}"}" ; then
			mrSourcesRead=$(( mrSourcesRead + 1 ))
		else
			mrPartial="$mrPartial**NOTE:** partial -- the state-shape sample could not be computed"$'\n'
		fi
		[ -z "$mrEndedFile" ] || rm -f -- "$mrEndedFile"
		[ -z "$mrRunsFile" ] || rm -f -- "$mrRunsFile"

		## Skillset files changed since the cut-off: names only, newest first.
		printf '\n## skillset files changed since cutoff\n\n'
		local mrSinceLocal="" mrListed="" mrChanged="" mrChangedN=0 mrFilesListed="false"
		if [ -n "$mrSince" ] ; then
			mrSinceLocal="$( AgentsToolsMorningReviewLocalTime "$mrSince" )"
			if [ -z "$mrSinceLocal" ] ; then
				mrPartial="$mrPartial**NOTE:** partial -- the cut-off could not be turned into a local time, so the changed files are not listed"$'\n'
			elif [ -z "${MDAT_SKILLSET_ROOT:-}" ] || [ ! -d "$MDAT_SKILLSET_ROOT" ] ; then
				mrPartial="$mrPartial**NOTE:** partial -- no skillset root, so the changed files are not listed"$'\n'
			elif mrListed="$( DistroAgentsTools --librarian-list-team-files-dates 2>/dev/null )" ; then
				mrChanged="$( printf '%s\n' "$mrListed" | LC_ALL=C awk -v since="$mrSinceLocal" 'length($0) > 21 && substr($0, 1, 19) > since { print substr($0, 22) }' )"
				[ -z "$mrChanged" ] || mrChangedN="$( printf '%s\n' "$mrChanged" | LC_ALL=C awk 'END { print NR }' )"
				if [ "$mrChangedN" -gt "$mrFilesCap" ] ; then
					printf 'changed: %s (capped, %s shown)\n' "$mrChangedN" "$mrFilesCap"
				else
					printf 'changed: %s\n' "$mrChangedN"
				fi
				[ -z "$mrChanged" ] || printf '%s\n' "$mrChanged" | head -n "$mrFilesCap"
				mrSourcesRead=$(( mrSourcesRead + 1 ))
				mrFilesListed="true"
			else
				mrPartial="$mrPartial**NOTE:** partial -- --librarian-list-team-files-dates failed, so the changed files are not listed"$'\n'
			fi
		fi
		[ "$mrFilesListed" = "true" ] || printf '(not listed)\n'

		if [ -n "$mrPartial" ] ; then
			printf '\n%s' "$mrPartial"
			[ "$mrSourcesRead" -gt 0 ] || { set +e ; return 1 ; }
			set +e ; return 2
		fi
		return 0
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;

esac
