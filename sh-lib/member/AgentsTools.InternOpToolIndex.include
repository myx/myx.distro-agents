#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.InternOpToolIndex.include -- the tool index: `--intern-op-tool-index` writes
## `$MMDAPP/.local/agents/tool-index.md`, one section per team member, generated and never
## written by hand. Its text is the tooling template sh-lib/templates/tool-index.document.format.md,
## filled by AgentsToolIndexFill.awk. A member's Skill read of its own skill serves that
## member's section, as one section `Tool index` (AgentsUniversalHarness.sh, through
## --intern-merge-md-files); --make-harness-indices builds it under the name `tool-index`.
##
## WHO MAY USE WHAT is read, never written here: for the three families the dispatcher's gate
## asks a caller check for (DistroAgentsTools.fn.sh: --magic-, --client-, --manager-), that
## check itself, asked for each member and for a call from no member's session; for the tools,
## the grants index's tool rows, which carry the floor (AgentsToolsGrantsBuiltinText) and what
## the projects declare in project.inf. A family no check is asked for, and a tool no row
## names, is everyone's, gated per call.
##
## The same inputs give the same bytes: no date or time, members and files in byte order,
## operations in their help's order. Rebuilt the way the grants index is: a reader finding it
## missing or older than what it is made from rebuilds it first (AgentsToolsToolIndexEnsure).
## Sourced from its op's own dispatcher arm, or for its functions only.
##

agentsToolIndexHere="${harnessHere:-$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib}"
agentsToolIndexFormat="format: myx.distro tool-index 1"
agentsToolIndexFile=""

## Whether the check of an enforced family admits a call from this member, '' a call from no
## member's session: rc 0 where it does. The check is asked as the dispatcher asks it, in a
## subshell acting as that member alone; a --client-* operation names the member itself where
## it is a client, and no client of this team otherwise.
AgentsToolsToolIndexMay(){ ## family, member
	(
		MDAT_SPAWN_AGENT="$2" ; harnessAgent="" ; MDAT_SPAWN_SESSION_ID=""
		case "$1" in
			--magic-) AgentsToolsMagicCallerCheck magic-tool-index-probe ;;
			--client-)
				case "$2" in
					client-*) AgentsToolsClientCallerCheck "$2" client-tool-index-probe ;;
					*) AgentsToolsClientCallerCheck client- client-tool-index-probe ;;
				esac
			;;
			--manager-) AgentsToolsManagerCallerCheck manager-tool-index-probe ;;
			*) exit 1 ;;
		esac
	) 2> /dev/null
}

## The files the index is made from, one path per line: what its freshness is checked against.
AgentsToolsToolIndexSources(){ ## workspace
	local sourcesPackage="${agentsToolIndexHere%/sh-lib}" sourcesFile sourcesStem
	printf '%s\n' "${1%/}/.local/agents/grants.index" "$sourcesPackage/sh-scripts" \
		"$agentsToolIndexHere/harness/AgentsOpenAiChatWire.sh" "$agentsToolIndexHere/mcp/AgentsTools.InternMcpRequest.include" \
		"$agentsToolIndexHere/harness/AgentsContext.UseAgentsTools.include" "$agentsToolIndexHere/member/AgentsTools.InternOpToolIndex.include" \
		"$agentsToolIndexHere/member/AgentsToolIndexFill.awk" "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/output/AgentsToolingTemplateFill.awk" \
		"$agentsToolIndexHere/templates/tool-index.document.format.md"
	for sourcesFile in "$sourcesPackage"/sh-scripts/DistroAgents*.fn.sh "$sourcesPackage"/sh-scripts/Agent*Tools.fn.sh ; do
		[ -f "$sourcesFile" ] || continue
		sourcesStem="${sourcesFile##*/}" ; sourcesStem="${sourcesStem%.fn.sh}"
		printf '%s\n' "$sourcesFile" "$agentsToolIndexHere/help/Help.$sourcesStem.help.md"
	done
}

## The generator's input on stdout, one TAB-separated row a line (AgentsToolIndexFill.awk):
## `member <name>`, `shell <file> <command> <help md>`, `calls <harness tools file> <MCP request
## file>`, `may <family> <member> yes|no` (an empty member: a call from no member's session),
## `holds <tool> <member>`. rc 1 when the members cannot be read.
AgentsToolsToolIndexData(){ ## workspace
	local dataWs="${1%/}" dataPackage="${agentsToolIndexHere%/sh-lib}" dataMembers dataMember dataFamily dataFile dataStem dataHelp dataVerdict
	type AgentsToolsGrantsIndexEnsure > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.Grants.include" || return 1
	type AgentsToolsTeamMemberDirectoryText > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.TeamRegistry.include" || return 1
	AgentsToolsGrantsSkillsetRoot "$dataWs"
	dataMembers="$( MDAT_SKILLSET_ROOT="$agentsGrantsSkillsetRoot" AgentsToolsTeamMemberDirectoryText | LC_ALL=C awk -F'\t' 'NF && $1 != "" { print $1 ; }' | LC_ALL=C sort -u )" || return 1
	while IFS= read -r dataMember ; do
		[ -z "$dataMember" ] || printf 'member\t%s\n' "$dataMember"
	done <<< "$dataMembers"
	for dataFile in "$dataPackage"/sh-scripts/DistroAgents*.fn.sh "$dataPackage"/sh-scripts/Agent*Tools.fn.sh ; do
		[ -f "$dataFile" ] || continue
		dataStem="${dataFile##*/}" ; dataStem="${dataStem%.fn.sh}"
		dataHelp="$agentsToolIndexHere/help/Help.$dataStem.help.md"
		[ -f "$dataHelp" ] || dataHelp=""
		printf 'shell\t%s\t%s\t%s\n' "${dataFile##*/}" "$dataStem" "$dataHelp"
	done | LC_ALL=C sort -u
	printf 'calls\t%s\t%s\n' "$agentsToolIndexHere/harness/AgentsOpenAiChatWire.sh" "$agentsToolIndexHere/mcp/AgentsTools.InternMcpRequest.include"
	for dataFamily in --magic- --client- --manager- ; do
		while IFS= read -r dataMember ; do
			dataVerdict=no ; AgentsToolsToolIndexMay "$dataFamily" "$dataMember" && dataVerdict=yes
			printf 'may\t%s\t%s\t%s\n' "$dataFamily" "$dataMember" "$dataVerdict"
		done <<< "$( printf '\n%s\n' "$dataMembers" )"
	done
	## The standing tool rows, `<member> tool <tool>[:<target>] ...`: who holds a tool.
	if AgentsToolsGrantsIndexEnsure "$dataWs" ; then
		if [ -n "$agentsGrantsIndexFile" ] ; then cat "$agentsGrantsIndexFile" ; else printf '%s\n' "$agentsGrantsIndexText" ; fi \
			| LC_ALL=C awk -F'\t' '$2 == "tool" && $1 != "" && $3 != "" { tool = $3 ; sub( /:.*$/, "", tool ) ; print "holds\t" tool "\t" $1 ; }' | LC_ALL=C sort -u
	fi
}

## The index written beside its place and renamed over it, so a reader never meets half of
## one; its input in a scratch file of this write's own. rc 1, the old index kept, on a failure.
AgentsToolsToolIndexWrite(){ ## workspace
	local writeWs="${1%/}" writeFile writeTemp="" writeData=""
	writeFile="$writeWs/.local/agents/tool-index.md"
	mkdir -p "$writeWs/.local/agents" "$writeWs/.local/temp" 2> /dev/null || :
	type AgentsToolsToolingTemplateFill > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/output/AgentsTools.ToolingTemplate.include" || return 1
	writeData="$( mktemp "$writeWs/.local/temp/mdat-tool-index.XXXXXX" )" || writeData=""
	[ -n "$writeData" ] && writeTemp="$( mktemp "$writeFile.XXXXXX" )" || writeTemp=""
	if [ -z "$writeTemp" ] || ! ( AgentsToolsToolIndexData "$writeWs" ) > "$writeData" \
		|| ! TIX_DATA="$writeData" AgentsToolsToolingTemplateFill tool-index.document.format.md member/AgentsToolIndexFill.awk > "$writeTemp" ; then
		rm -f -- ${writeData:+"$writeData"} ${writeTemp:+"$writeTemp"}
		echo "⛔ ERROR: ${MDSC_CMD:-DistroAgentsTools} --intern-op-tool-index: the tool index could not be generated -- $writeFile left unchanged" >&2
		return 1
	fi
	rm -f -- "$writeData"
	chmod 644 "$writeTemp" && mv -f -- "$writeTemp" "$writeFile" || { rm -f -- "$writeTemp" ; return 1 ; }
}

## Whether the index is current, by builtins only: its format is this code's, and it is newer
## than everything it is made from.
AgentsToolsToolIndexFresh(){ ## workspace, index file
	local freshFile="$2" freshLine="" freshSource
	[ -f "$freshFile" ] || return 1
	{ IFS= read -r freshLine && IFS= read -r freshLine ; } < "$freshFile" || return 1
	[ "$freshLine" = "$agentsToolIndexFormat" ] || return 1
	while IFS= read -r freshSource ; do
		[ -z "$freshSource" ] || [ ! -e "$freshSource" ] || [ "$freshFile" -nt "$freshSource" ] || return 1
	done <<< "$( AgentsToolsToolIndexSources "$1" )"
	return 0
}

## A current index for a reader: agentsToolIndexFile names it. The grants index is made current
## first, since the index is read from it; a stale or missing index is rebuilt; one whose
## rebuild failed is read as it stood. rc 1 with none.
AgentsToolsToolIndexEnsure(){ ## workspace
	local ensureFile="${1%/}/.local/agents/tool-index.md"
	agentsToolIndexFile=""
	[ -n "${1:-}" ] && [ -d "$1" ] || return 1
	type AgentsToolsGrantsIndexEnsure > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.Grants.include" || return 1
	AgentsToolsGrantsIndexEnsure "$1" || :
	if AgentsToolsToolIndexFresh "$1" "$ensureFile" ; then
		agentsToolIndexFile="$ensureFile" ; return 0
	fi
	if AgentsToolsToolIndexWrite "$1" || [ -f "$ensureFile" ] ; then
		agentsToolIndexFile="$ensureFile" ; return 0
	fi
	return 1
}

## --intern-op-tool-index writes the index, whatever it held. --ensure rebuilds it only where
## it is missing or stale, and prints its path: what the Skill read asks.
case "${1:-}" in
	--intern-op-tool-index)
		shift
		case "$#:${1:-}" in
			0:)
				AgentsToolsToolIndexWrite "$MMDAPP" || { set +e ; return 1 ; }
				echo "# ${MDSC_CMD:-DistroAgentsTools} --intern-op-tool-index: wrote $MMDAPP/.local/agents/tool-index.md" >&2
				return 0
			;;
			1:--ensure)
				AgentsToolsToolIndexEnsure "$MMDAPP" || { set +e ; return 1 ; }
				printf '%s\n' "$agentsToolIndexFile"
				return 0
			;;
			*)
				echo "⛔ ERROR: ${MDSC_CMD:-DistroAgentsTools} --intern-op-tool-index takes no argument but --ensure, got: $* -- nothing was written" >&2
				set +e ; return 1
			;;
		esac
	;;
	*) ;;
esac
