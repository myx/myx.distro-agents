#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.CamundaDiagramSync.include -- the mtime comparison of partner-ndm-camunda's diagram sync
## (routine-camunda-diagram-sync): the newest team-definition mtime against each diagram's. Sourced, never
## run. Functions only.
##
## The op is a mechanical drift check, not a decision: it prints the stale diagrams and nothing else, so the
## agent only decides what to do with the list (a redeploy, or a hand-authored content fix first).
##

## The stale diagrams: a diagram whose mtime is older than the newest team-definition mtime. Each is printed
## as its path, one a line; nothing is printed where none is stale. rc 0 for a run, rc 1 where a directory is
## missing or not a directory.
AgentsToolsCamundaDiagramSyncStale(){ ## definitions directory, diagrams directory
	local staleDefs="$1" staleDiagrams="$2" staleNewest=0 staleFile staleTs staleMtime
	[ -n "$staleDefs" ] && [ -d "$staleDefs" ] || return 1
	[ -n "$staleDiagrams" ] && [ -d "$staleDiagrams" ] || return 1
	while IFS= read -r staleFile ; do
		[ -f "$staleFile" ] || continue
		staleTs="$( stat -f %m "$staleFile" 2>/dev/null || stat -c %Y "$staleFile" 2>/dev/null )" || staleTs=""
		case "$staleTs" in ''|*[!0123456789]*) continue ;; esac
		[ "$staleTs" -le "$staleNewest" ] || staleNewest="$staleTs"
	done < <( find "$staleDefs" -type f 2>/dev/null )
	while IFS= read -r staleFile ; do
		[ -f "$staleFile" ] || continue
		staleMtime="$( stat -f %m "$staleFile" 2>/dev/null || stat -c %Y "$staleFile" 2>/dev/null )" || staleMtime=""
		case "$staleMtime" in ''|*[!0123456789]*) continue ;; esac
		[ "$staleMtime" -ge "$staleNewest" ] || printf '%s\n' "$staleFile"
	done < <( find "$staleDiagrams" -type f 2>/dev/null )
	return 0
}
