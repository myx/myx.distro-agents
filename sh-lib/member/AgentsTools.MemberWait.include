#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.MemberWait.include -- --wait-for-input: one bounded long
## poll over a list of input sources, returning the moment any of them changes.
##
## The waiting happens HERE, in the shell, which is the whole point: a caller
## that would otherwise burn a round trip per check spends one call and one
## result, and its context does not grow while nothing is happening.
##
## A TIMEOUT IS NOT A FAILURE. "Nothing arrived within N seconds" is a normal,
## successful outcome, and a caller must be able to tell it apart from "the
## probe could not run" without guessing -- otherwise it cannot choose between
## waiting again and escalating, which is the only reason this operation exists.
## So stdout ALWAYS opens with exactly one marker line:
##
##     WAIT-RESULT: RECEIVED   -- something arrived; the detail follows
##     WAIT-RESULT: TIMEOUT    -- the bound expired with nothing new; normal. No --wait-timeout
##                                is no bound, so then only an unreadable first round returns it
##     WAIT-RESULT: ERROR      -- the wait could not be performed; see stderr
##     WAIT-RESULT: CLOSED     -- --wait-close ended the stored wait; nothing was waited on
##
## RECEIVED, TIMEOUT, CLOSED, ADDED and DROPPED all return 0, because all are answers. ERROR returns 1.
##
##     WAIT-RESULT: ADDED      -- --wait-add put its sources into the stored wait; nothing was waited on
##     WAIT-RESULT: DROPPED    -- --wait-drop took its sources out of it; nothing was waited on
##
## MODES, mutually exclusive, each needing --wait-session-id: --wait-default waits on the
## sources and filters it is given (or the default ones), --wait-continue repeats the stored
## sources and filters, --wait-close removes the state. With none of them the call keeps no state.
##
## LOSSLESS BY DESIGN. Neither --wait-default nor --wait-continue drops a stored per-source
## floor: a Slack source the session already waited on resumes after the last message a
## wait returned on it, so a post that landed while the caller was busy between two calls
## is returned by the next one, whichever mode it names. Only an explicit
## --wait-since-utime replaces those floors, and only --wait-close (or --wait-drop) removes
## them. A :conversation thread with no stored floor starts at the session's own last post
## in that thread (sessions/<id>/last-own-post, written by the harness send), else at the
## spawn's launch (the mtime of $MDAT_SPAWN_LAUNCH_MARKER), whichever applies and is older
## than the wait; every other source with none starts at the wait's start. A floor only ever advances to the newest
## message a result actually carried. On an arrival from a Slack source the wait settles
## for $MDAT_WAIT_SETTLE_SECONDS (default 3) and re-reads, up to
## $MDAT_WAIT_SETTLE_ROUNDS (default 3) times while more keeps arriving, so a burst
## returns together, oldest first.
## --wait-add appends sources to the stored wait, creating it when there is none, and
## --wait-drop removes them, removing the wait once none is left: this is how an asked
## question's wait item (ask:<pending-id>) joins the session's wait and leaves it once
## answered. Neither takes a thread source, since, addressee or include-own: those are
## shared by the whole stored wait, which a source joining it must not change.
## Message ids named in --wait-react-seen|note|done|wait are reacted to before anything else.
##
## --unwait <kind>:<target> is a named shorthand for --wait-drop --wait-source <kind>:<target>:
## nothing more than that, and returns the same WAIT-RESULT: DROPPED. Dropping a source from
## the stored wait is never blocking it: a later call naming the same source explicitly,
## whatever mode it uses, reaches it exactly as if it had never been dropped.
##
## A source never read once during the wait is named on the line right after it:
##
##     WAIT-NEVER-READ: [<kind>:<target>] ...
##
## absent when every source was read at least once. It changes neither the outcome
## nor the return code; a caller watching one thread reads it to tell a quiet
## thread from one it could not see at all.
##
## NAMED SOURCES ARE ADDED, THE STORED SET NEVER SHRINKS. A --wait-default call always watches the defaults (the session
## thread, or the team channel and the owner DM), and the sources it names and the sources the stored wait holds come
## beside them. Only --unwait, --wait-drop and --wait-close take a source out of the stored wait. A floor lives for a
## source of the stored set alone and advances at every wait that watches it; the floor of a source that left the set is
## dropped at the next write, and a source that comes back starts at the wait's start: what came in the gap is not replayed.
## An answered ask: source is not dropped by age either: a later reply in its thread arrives however long it was quiet.
## The header says which session thread is on record for the session (`# session thread:`), or that none is.
##
## RECEIVED on a thread source (slack:<channel>:<ts>, or its :conversation form)
## also names the newest message it just printed:
##
##     WAIT-LAST-TS: <ts>
##
## Pass that ts back as the next call's --wait-since-utime to keep reading
## forward without re-parsing the body for it. Absent on a bare conversation or
## file source: neither prints one message per line, so neither has a single
## ts this line could name.
##
## SOURCE ADAPTERS -- the extension point.
##
## A source is named `<kind>:<target>`. The kind selects a probe function by
## name, `AgentsWaitProbe` + the kind with its first letter uppercased, and
## $agentsWaitSourceKinds lists the kinds this build carries. Adding an input
## source -- an IM bridge, a portal interaction feed, anything later -- is one
## new function plus one word in that list. Nothing else in this operation, in
## the Wait harness tool, or in the harness self-check knows a source kind.
##
## The adapter contract is deliberately narrow:
##
##     AgentsWaitProbe<Kind> <team-member> <target> <since-epoch> <render-file> <addressee>
##         rc 0 -- <render-file> now holds this source's current state for
##                 <target>. An empty rendering is a legitimate state.
##         rc 2 -- the probe could not run. <render-file> is not a rendering
##                 and is not compared against anything.
##
## An adapter is never asked what "new" means: this operation decides that
## generically, by comparing each rendering against the baseline it took at the
## start of the wait. So an adapter needs no notion of cursors, read marks or
## message identity -- only "render what is there now".
##
## The third argument is a READ FLOOR, not that decision. It defaults to the wait's
## own start time, and an adapter that can narrow server-side should render only
## from it -- otherwise every poll re-renders a whole conversation to discover
## nothing changed. An adapter that cannot narrow ignores it and renders the lot;
## the baseline comparison above is unaffected either way.
##
## The fifth argument is WHOSE ANSWER COUNTS -- the Slack accounts of the party a
## question was addressed to, exactly as the send operation resolved and reported
## them, so the send and the wait read one value rather than each deciding for
## itself. An adapter that cannot tell one author from another ignores it. The slack
## adapter does not ignore it: on a thread it is what makes a reply an answer,
## together with our own message being the floor it must come after.
##
## The sixth argument is INCLUDE OWN POSTS -- true on a :conversation thread source
## lifts this operation's own default skip of the caller's own posts there. An
## adapter with no such skip ignores it, same as an adapter that cannot tell one
## author from another ignores the fifth.
##
## Any number of sources and threads may share one wait. A plain thread source, the
## question-and-answer form, takes the one --wait-since-utime and --wait-addressee the
## call carries, so several of them share those values; the own-post skip and the
## addressee keep the sending session's own post from coming back.
##
## ITERATION DIVIDERS. $agentsWaitKindEvery says a kind is probed on every Nth poll
## round (the first round always probes all), so a costly kind, a repository check later,
## can be read less often than a session thread. 1 is every round.
##
## THE TICK AND THE SLOW LOOK -- THE WAKE LATENCY. A duty session's routine promises it wakes "within seconds of an item
## arriving in its inbox", and a poll cannot keep that promise with one interval for every source: an inbox is a
## listing of a directory and costs nothing to read every second, a Slack conversation is a request out of a budget of
## about fifty a minute for the whole app, so it cannot be. The wait therefore runs a ONE-SECOND TICK over the kinds it
## reads out of files ($agentsWaitKindLocal: file, inbox, board, process, the session chat file, the replies, and the
## own wake marker) and reads the costly kinds (slack, tagged, ask) on THE SLOW GAP instead -- the interval this
## operation used to poll at, which still grows with the idle time of the sources (AgentsWaitBackoffNap), so no Slack
## request is made more often than before. A scan keeps its own TTL of the table, and a wake marker brings its next
## run forward (THE WAKE MARKER, and THE SCAN IS WOKEN AND NOT ON ITS TTL, below).
##
## THE WAKE MARKER closes the one gap a tick cannot: a message one of our own members sends. The send operation
## writes the recipient's marker the moment the message is posted (AgentsTools.WakeMarker.include) and the wait
## reads it on its tick, so the arrival wakes the wait in about a second rather than at the next slow look of the
## Slack source. The marker is no arrival of its own: the round that finds it changed takes it as read and reads
## every source again at once, costly ones included, and returns what those find.
##
## THE SCAN IS WOKEN AND NOT ON ITS TTL. A scan is the one source a duty's own arrivals are read from -- the inbox,
## the tags, the board, in one report -- so a scan-only watcher that is left to the table's TTL of five minutes (or,
## in a session, to the end of the wait round that precedes the next call's first look) is exactly the duty that
## "reacts in five minutes or so". The marker brings the scan's next run forward with every other costly source, so
## the item a message announces is in the report returned within about a second. The TTL stays what it is for: an
## unchanged scan is still left alone for it, and the TTL is no floor on noticing a message.
##
## WHY THAT DOES NOT MAKE A SCAN RUN EVERY SECOND. A scan is minutes of work (an inbox, the board, a Slack collect
## window), and nothing here runs one on a tick: the marker is written by a send alone, one line per message, and
## the round that finds it changed takes it as read -- its rendering becomes the baseline -- so one message buys at
## most one extra run. Ten messages in an hour are ten scans, where a one-second tick would be three thousand six
## hundred. A quiet wait runs no scan at all once its TTL has passed, exactly as before.
##
## Not built, one probe away: repo:<name>, returning that repository HEAD through the
## team git tooling. inbox:<member> is the own inbox only, board:<state> one board state.
##
## THE FLOOR. A --wait-default or --wait-continue call, in a session, always waits on
## replies:<session id>: the replies to the run's own posts, ahead of its other sources (AgentsWaitProbeReplies),
## and, where the session has a folder, on chat:<session>: the messages of its session thread that are for the run,
## read from the session chat file by the member's pointer (AgentsWaitProbeChat, AgentsTools.SessionChat.include).
## A caller never names a channel, a thread or an addressee to get a reply, and the sources it names are
## added to the floor, never put in its place. What a return carries is the floor first, then the messages of all
## the other sources together in one group sorted by time, each behind the source it came from
## (AgentsWaitArrivalsOrder.awk). The same floor goes with every tool return, from the same file and no network
## (AgentsTranscriptReplyFloor), so a message is delivered once, by whichever reaches the member first.
##
## ALSO CARRIED, for the tooling's own use and for the work-duty scan: scan:<scan> (a scan's report, run afresh past its TTL,
## and at once on the round a wake marker announces a message -- THE SCAN IS WOKEN AND NOT ON ITS TTL),
## tagged:<member> (what is for the member by name), wake:<member> (the marker a message to that member writes, read on the
## tick, never returned -- see THE WAKE MARKER), and --wait-collect <seconds> (a window that returns, ahead of
## its end, on an arrival of the tags). Their TTLs are AgentsWaitTtlOf's.
##
## REMINDERS. A wait also reminds: the asks it stands for, still waiting on a person, on
## their schedule (AgentsWaitRemind below, AgentsTools.PendingReplyRemind.include). It changes
## nothing a wait returns, and what it did is said on stderr only.
##

## The kinds this build carries. One word per adapter, in the order they are
## offered to a caller that asks.
agentsWaitSourceKinds="slack file inbox board ask replies chat scan tagged mentions process wake"
agentsWaitKindEvery="slack:1 file:1 inbox:1 board:1 ask:1 replies:1 chat:1 scan:1 tagged:1 mentions:1 process:1 wake:1"
## THE TICK AND THE SLOW LOOK. A wait reads a source out of a file every second -- an inbox listing, a board
## state, the session chat file, the own wake marker -- and that is what makes it wake within a second of an
## arrival in one of them. A source that costs a request must not be read that often (about fifty a minute for
## the app, shared by every host and session of it), so the kinds watched over the network are read on the slow
## gap instead: the gap this operation used to poll at, five seconds growing by one for every twenty idle up to
## five minutes, counted from the newest activity on the watched sources (AgentsWaitBackoffNap). A wait whose
## caller names an interval (--wait-poll-interval, else MDAT_WAIT_POLL_SECONDS) keeps that one interval for
## every source, as it always did: that is how a check drives it.
agentsWaitKindLocal="file inbox board process chat replies wake"
## The seconds of the tick, when no interval was named: an arrival in a local source is woken on within it.
agentsWaitTickSeconds=1
## Kinds whose rendering holds arrivals only, never a standing state, so a source of one with no
## stored baseline starts from an empty one: an arrival already there returns at once, as a
## --wait-since-utime does for a thread. Every other kind takes its first probe as the baseline.
agentsWaitKindEmptyBaseline="ask replies chat scan tagged mentions"
## The kinds of THE FLOOR: delivered ahead of every other source of a return, and by every plain Wait.
agentsWaitKindFloor="replies chat"
## Kinds whose rendering is a list of arrivals from a floor, so only a line the baseline lacks
## is an arrival: an item taken away (an inbox item marked handled, moved out of incoming/) is none.
agentsWaitKindArrivalsOnly="inbox"
## How far a floor (--wait-since-utime) may lead this host's clock, in seconds. The ts of a
## message just posted is another clock's "now", so a floor that close ahead is still a
## moment that has passed; one further ahead is not, and is refused before anything is waited on.
agentsWaitFloorAhead=300

## Slack. Through the team's own sanctioned read operation and no other path:
## the credential stays inside that operation and never reaches argv here.
##
## A target carrying a `:` names ONE THREAD, and a thread is where a question put
## to somebody is answered, so that case renders THE ANSWERS IN IT and nothing
## else. Three existing pieces and no fourth way: the read operation returns the
## whole thread, AgentsSlackMessagesFormat.awk renders it in its own ts order, and
## AgentsSlackThreadAnswers.awk keeps only what came after our own message -- a reply
## from the party the question was addressed to, or a reaction on our own message.
## No message text decides any of it.
##
## <since-epoch> is our own message's ts for a thread, which is what a caller
## already passes it for, and <addressee> carries the accounts whose answer counts.
## Because nothing our own side wrote survives that rendering, a wait over a thread
## CANNOT be satisfied by the session's own post -- which is what it did before,
## on its first poll, in zero seconds, every time.
##
## A bare conversation is rendered from the cut-off forward, which is Slack doing
## the narrowing server-side rather than this operation pulling history it would
## only throw away.
## A SOURCE THAT NAMES A PERSON (slack:human-owner, or a user id) is every direct conversation with that person the member posts in: the member's own and the team bot's
## (a person is a different DM per identity, and every ask of the bot is posted in the bot's). Each is read by its own id, and its messages stand behind a `# in <conversation>`
## line, so a reply goes back to the conversation it was read from. From the bot's DM only what the person wrote is kept. rc 0 read, 1 the target names no person (the
## caller reads it as a conversation), 2 neither DM could be read.
AgentsWaitProbeSlackPerson(){ ## member, target, since, the probe's out file
	local personMember="$1" personTarget="$2" personSince="$3" personOut="$4" personId personIdentity personInfo personDm personSeen=" " personFailed=0 personParts=0
	type DistroAgentsToolsResolveTarget > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.CommsSlack.include" 2> /dev/null || return 1
	personId="$( DistroAgentsToolsResolveTarget "$personTarget" "$personMember" 2> /dev/null | LC_ALL=C sed -n 's/^CHANNEL=//p' | head -1 )" || personId=""
	case "$personId" in U*|W*) ;; *) return 1 ;; esac
	: > "$personOut.rendered" || return 2
	for personIdentity in user bot ; do
		personParts=$(( personParts + 1 ))
		personInfo="$( DistroAgentsTools --intern-op-slack-call "$personMember" --api conversations.info --resolve-dm "$personId" --identity "$personIdentity" --context "wait: the direct conversation with $personTarget" 2> "$personOut.err" )" || { personFailed=$(( personFailed + 1 )) ; continue ; }
		personDm="$( printf '%s\n' "$personInfo" | LC_ALL=C awk -v path=channel.id -v dialect=slack -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsHarnessJsonField.awk" 2> /dev/null )" || personDm=""
		[ -n "$personDm" ] || { personFailed=$(( personFailed + 1 )) ; continue ; }
		case "$personSeen" in *" $personDm "*) continue ;; esac
		personSeen="$personSeen$personDm "
		DistroAgentsTools --intern-op-comms-slack-read "$personMember" "$personDm" ${personSince:+--oldest "$personSince"} $( [ "$personIdentity" = bot ] && printf '%s' --identity-bot ) > "$personOut.part" 2> "$personOut.err" || { personFailed=$(( personFailed + 1 )) ; cat "$personOut.err" >&2 ; continue ; }
		AgentsWaitOwnFile "$personOut.part" || return 2
		LC_ALL=C awk -v person="$personId" -v onlyPerson="$( [ "$personIdentity" = bot ] && printf 1 || printf 0 )" '
			NR == 1 && /^## target=/ { next ; }
			/^[0-9]+\.[0-9]+ \| / { split($0, f, " \\| ") ; keep = ( onlyPerson == 0 || f[2] == person ) ; }
			keep { print ; }' "$personOut.part" > "$personOut.part.kept" 2>> "$personOut.err" || return 2
		AgentsWaitTrackingDropFile "$personMember" "$personOut.part.kept"
		{ printf '# in %s\n' "$personDm" ; cat "$personOut.part.kept" ; } >> "$personOut.rendered"
	done
	[ "$personFailed" -lt "$personParts" ] || return 2
	return 0
}
## THE STATE OF A WAIT, stored: its sources, addressee, include-own, modes and floors (the newest ts returned for a slack source), the baselines of the rest. Run in the wait's own
## scope (its locals are the caller's) once BEFORE the result is said, so a result that was emitted has its floors committed whatever becomes of the caller after it (a client that
## moves the call to the background or interrupts it), and again at the end. rc 1 where the state cannot be written.
AgentsWaitStateStore(){
	if [ -n "$waitMode" ] ; then
		local waitStateTmp
		mkdir -p "$waitStateDir" && waitStateTmp="$( mktemp "$waitStateDir/state.XXXXXX" )" || {
			echo "# NOTE: the state of this wait could not be stored under $waitStateDir, so --wait-continue will not find it." >&2
			return 1
		}
		floorIndex=0
		{
			echo "sources: $waitSources"
			echo "addressee: $waitAddressee"
			echo "include-own: $waitIncludeOwn"
			for checkSource in $waitSources ; do
				[ -z "$( AgentsWaitModeOf "$checkSource" )" ] || echo "mode $checkSource $( AgentsWaitModeOf "$checkSource" )"
			done
			for checkSource in $waitSources ; do
				floorIndex=$(( floorIndex + 1 ))
				case "$checkSource" in
					slack:*) echo "floor $checkSource ${waitFloorNew[$floorIndex]:-${waitFloorOf[$floorIndex]}}" ;;
					## The replies keep their words in the record of the run's own posts, the chat file's reader in its pointers, not here.
					replies:*|chat:*) ;;
					*)
						if [ -f "$waitDir/now.$floorIndex" ] ; then
							cp "$waitDir/now.$floorIndex" "$waitStateDir/base.$floorIndex"
						elif [ -f "$waitDir/base.$floorIndex" ] ; then
							cp "$waitDir/base.$floorIndex" "$waitStateDir/base.$floorIndex"
						fi
					;;
				esac
			done
			## A floor lives only for a source of the set stored above: none of a source that is not in it is written again.
		} > "$waitStateTmp"
		mv -f "$waitStateTmp" "$waitStateDir/state"
	fi
	return 0
}

## The ids (`<conversation>:<ts>`) of the messages a person wrote in the rendering of one source that a wait returned: the conversation is the one the source names, or the
## one the rendering names before its messages (`# in <conversation>`, `# replies to your post <conversation>:<ts>`); a source that names a team channel or the owner by
## name is resolved. The member's own and anything that is not a user id are left out.
AgentsWaitSeenIds(){ ## member, source, the rendering file, the member's own Slack id
	local seenChannel=""
	case "${2/#slack:client:/slack:}" in
		slack:[CDG][A-Z0-9]*) seenChannel="${2#slack:}" ; seenChannel="${seenChannel%%:*}" ;;
		slack:*) type DistroAgentsToolsResolveTarget > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.CommsSlack.include" 2> /dev/null || :
			seenChannel="$( DistroAgentsToolsResolveTarget "${2#slack:}" "$1" 2> /dev/null | LC_ALL=C sed -n 's/^CHANNEL=//p' | head -1 )" ;;
		ask:*)
			local seenRecord="$MMDAPP/.local/agents/pending/${2#ask:}.md"
			[ -f "$seenRecord" ] || seenRecord="$MMDAPP/.local/agents/pending/closed/${2#ask:}.md"
			seenChannel="$( LC_ALL=C awk '/^# / { exit } index( $0, "channel: " ) == 1 { print substr( $0, 10 ) ; exit }' "$seenRecord" 2> /dev/null )"
		;;
	esac
	LC_ALL=C awk -v channel="$seenChannel" -v own="$4" '
		function conv( word ) { return ( word ~ /^[CDG][A-Z0-9]+$/ ) ? word : "" }
		/^# in / { w = $3 ; sub(/:.*$/, "", w) ; channel = conv( w ) ; next }
		/^# replies to your post / { w = $5 ; sub(/:.*$/, "", w) ; channel = conv( w ) ; next }
		/^[0-9]+\.[0-9]+ \| / { split( $0, f, " \\| " ) ; if ( channel != "" && f[2] ~ /^[UW][A-Z0-9]+$/ && f[2] != own ) { print channel ":" $1 } }' "$3"
}
AgentsWaitProbeSlack(){
	local probeMember="$1" probeTarget="$2" probeSince="$3" probeOut="$4" probeAddressee="$5" probeIncludeOwn="$6" probeRc=0
	## Given by the ask probe only: the accounts that asked, whose reaction never answers, and
	## the first post of a question asked again in its own thread, where a click still answers.
	local probeAsking="${7:-}" probeAlso="${8:-}"
	## The identity the thread is read with: the member's own, or the team bot's for a question
	## the bot posted (its record's `ask-identity: bot`), which may stand in a conversation the
	## member's own account is not in. Given by the ask probe, or by the collector for the one
	## read it makes of such a question (MDAT_WAIT_READ_AS_BOT).
	local probeAsBot="${9:-${MDAT_WAIT_READ_AS_BOT:-}}"
	local probeArgs probeThread="false" probeMode="" probePersonRc=1
	case "$probeTarget" in
		*:*|'') ;;
		*) case "$probeMember" in client-*) ;; *) [ "$probeAsBot" = "true" ] || { AgentsWaitProbeSlackPerson "$probeMember" "$probeTarget" "$probeSince" "$probeOut" && probePersonRc=0 || probePersonRc=$? ; } ;; esac ;;
	esac
	if [ "$probePersonRc" = "2" ] ; then
		[ ! -s "$probeOut.err" ] || cat "$probeOut.err" >&2
		return 2
	fi
	if [ "$probePersonRc" = "0" ] ; then
		## Strictly after the floor, a `# in` line only before a message that is kept: a conversation with nothing new says nothing.
		LC_ALL=C awk -v floorTs="${probeSince:-0}" '
			function secOf(v) { sub(/\..*$/, "", v) ; return ( v == "" ? 0 : v + 0 ) ; }
			function fracOf(v) { if ( v !~ /\./ ) { return "000000" ; } sub(/^[^.]*\./, "", v) ; return substr(v "000000", 1, 6) ; }
			/^# in / { pending = $0 ; next ; }
			/^[0-9]+\.[0-9]+ \| / { keep = ( secOf($1) > secOf(floorTs) || ( secOf($1) == secOf(floorTs) && fracOf($1) > fracOf(floorTs) ) ) ; if ( keep && pending != "" ) { print pending ; pending = "" ; } }
			keep { print ; }' < "$probeOut.rendered" > "$probeOut" 2>> "$probeOut.err" || return 2
		return 0
	fi
	probeArgs=( "$probeMember" )
	## The shape is read past a client: marker (the other organisation's side of a client-*
	## member, AgentsTools.CommsSlack.include), which stays on the target the read is given.
	case "${probeTarget#client:}" in
		*:*:conversation)
			probeThread="true"
			probeMode="conversation"
			probeTarget="${probeTarget%:conversation}"
			probeArgs=( "${probeArgs[@]}" "$probeTarget" --thread )
		;;
		*:*)
			probeThread="true"
			probeArgs=( "${probeArgs[@]}" "$probeTarget" --thread )
		;;
		*)
			probeArgs=( "${probeArgs[@]}" "$probeTarget" )
			[ -z "$probeSince" ] || probeArgs=( "${probeArgs[@]}" --oldest "$probeSince" )
		;;
	esac
	[ "$probeAsBot" != "true" ] || probeArgs=( "${probeArgs[@]}" --identity-bot )
	## Output to a file, never a capture: the read operation forks curl, and a
	## capture returns on pipe EOF rather than on the process that holds it.
	DistroAgentsTools --intern-op-comms-slack-read "${probeArgs[@]}" \
		> "$probeOut.read" 2> "$probeOut.err" || probeRc=$?
	if [ "$probeRc" != "0" ] ; then
		## Actually onto stderr: the TIMEOUT text tells the caller a failed probe's
		## diagnostics are there, and without this the file is written, read by
		## nothing, and removed with the working directory -- a claim that reads as
		## verified while the reason is discarded.
		[ ! -s "$probeOut.err" ] || cat "$probeOut.err" >&2
		return 2
	fi
	## What a step wrote is there when the next one reads it, or the wait ends on it (AgentsWaitOwnFile).
	AgentsWaitOwnFile "$probeOut.read" || return 2
	## Every message is one "<ts> | user | text" line and has an id. A thread is read raw and formatted here. A
	## bare conversation is read formatted already (AgentsToolsSlackCheck, its first line a `## target=` mark): its
	## lines are the rendering, and the JSON formatter would print nothing of them -- so no bare conversation
	## ever returned an arrival.
	if [ "$probeThread" = "true" ] ; then
		LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsSlackMessagesFormat.awk" \
			< "$probeOut.read" > "$probeOut.rendered" 2>> "$probeOut.err" || probeRc=$?
	else
		LC_ALL=C awk 'NR == 1 && /^## target=/ { next ; } { print ; }' \
			< "$probeOut.read" > "$probeOut.rendered" 2>> "$probeOut.err" || probeRc=$?
	fi
	AgentsWaitOwnFile "$probeOut.rendered" || return 2
	## A person is a different DM per identity: what that person wrote in the bot's DM is read too.
	local probePerson=""
	if [ "$probeThread" = "false" ] && [ "$probeRc" = "0" ] && [ "$probeAsBot" != "true" ] ; then
		probePerson="$( LC_ALL=C awk 'NR == 1 && /^## target=U[A-Z0-9]+ / { sub(/^## target=/, "") ; sub(/ .*$/, "") ; print ; } { exit ; }' "$probeOut.read" 2> /dev/null )"
	fi
	if [ -n "$probePerson" ] ; then
		if DistroAgentsTools --intern-op-comms-slack-read "${probeArgs[@]}" --identity-bot > "$probeOut.bot.read" 2> "$probeOut.bot.err" ; then
			LC_ALL=C awk -v person="$probePerson" '
				NR == 1 && /^## target=/ { next ; }
				/^[0-9]+\.[0-9]+ \| / { split($0, f, " \\| ") ; keep = ( f[2] == person ) ; }
				keep { print ; }' < "$probeOut.bot.read" >> "$probeOut.rendered" 2>> "$probeOut.err" || { [ ! -s "$probeOut.err" ] || cat "$probeOut.err" >&2 ; return 2 ; }
		else
			echo "⛔ ERROR: the bot's DM with $probePerson could not be read, so what is written there is not seen:" >&2
			cat "$probeOut.bot.err" >&2
			return 2
		fi
	fi
	## A client-* member reaches the human-owner on the other organisation's side too: the conversations its own scope names.
	local probeClientConvs="" probeClientConv
	if [ "$probeThread" = "false" ] && [ "$probeTarget" = "human-owner" ] ; then
		case "$probeMember" in client-*) probeClientConvs="$( DistroAgentsTools --agents-config-option "$probeMember" --select SLACK_CHANNEL_HUMAN_OWNER 2> /dev/null )" || probeClientConvs="" ;; esac
	fi
	for probeClientConv in ${probeClientConvs//,/ } ; do
		if DistroAgentsTools --intern-op-comms-slack-read "$probeMember" "client:$probeClientConv" ${probeSince:+--oldest "$probeSince"} > "$probeOut.client.read" 2> "$probeOut.client.err" ; then
			LC_ALL=C awk 'NR == 1 && /^## target=/ { next ; } { print ; }' < "$probeOut.client.read" >> "$probeOut.rendered" 2>> "$probeOut.err" || return 2
		else
			echo "⛔ ERROR: the human-owner conversation $probeClientConv on $probeMember's other side could not be read, so what is written there is not seen:" >&2
			cat "$probeOut.client.err" >&2
			return 2
		fi
	done
	## The session thread, read here, is brought into the session chat file too: one read serves this source and the file.
	case "$probeTarget" in client:*) ;; *) [ "$probeThread" != "true" ] || [ "$probeRc" != "0" ] || AgentsWaitChatImportRead "$probeMember" "$probeTarget" "$probeOut.rendered" || : ;; esac
	## What the tooling posted itself is no arrival (AgentsTools.TrackingDrop.include); the chat file above holds the whole thread as it was.
	AgentsWaitTrackingDropFile "$probeMember" "$probeOut.rendered"
	if [ "$probeThread" = "false" ] ; then
		if [ "$probeRc" != "0" ] ; then
			[ ! -s "$probeOut.err" ] || cat "$probeOut.err" >&2
			return 2
		fi
		## Strictly after the floor, whatever the server did with --oldest: the floor is the
		## last message a result already carried, so one at the floor must not come back.
		if [ -n "$probeSince" ] ; then
			LC_ALL=C awk -v floorTs="$probeSince" '
				function secOf(v) { sub(/\..*$/, "", v) ; return ( v == "" ? 0 : v + 0 ) ; }
				function fracOf(v) { if ( v !~ /\./ ) { return "000000" ; } sub(/^[^.]*\./, "", v) ; return substr(v "000000", 1, 6) ; }
				/^[0-9]+\.[0-9]+ \| / { keep = ( secOf($1) > secOf(floorTs) || ( secOf($1) == secOf(floorTs) && fracOf($1) > fracOf(floorTs) ) ) ; }
				keep { print ; }' < "$probeOut.rendered" > "$probeOut" 2>> "$probeOut.err" || return 2
			return 0
		fi
		mv -f "$probeOut.rendered" "$probeOut" || return 2
		return 0
	fi
	## A thread several questions share answers each by its tag (AgentsTools.AskThread.include).
	## Conversation mode has no question to tag, so it skips this lookup entirely.
	local probeStanding="" probeOthers=""
	if [ "$probeMode" != "conversation" ] ; then
		type AgentsToolsAskThreadStanding > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.AskThread.include"
		probeStanding="$( AgentsToolsAskThreadStanding "${probeTarget%:*}" "$probeSince" )"
		[ "${probeStanding#*$'\t'}" = "0" ] || [ "${probeStanding#*$'\t'}" = "1" ] || probeOthers="$( AgentsToolsAskThreadOthers "${probeTarget%:*}" "$probeSince" )"
	fi
	AgentsWaitOwnFile "$probeOut.rendered" || return 2
	if [ "$probeRc" = "0" ] ; then
		## 0|1, never true|false: a bare digit needs no quoting -v could mangle, and
		## the awk guard below reads it as the strnum truth value it already is.
		local probeIncludeOwnFlag=0
		[ "$probeIncludeOwn" != "true" ] || probeIncludeOwnFlag=1
		LC_ALL=C awk -v rootTs="$probeSince" -v alsoTs="$probeAlso" -v askingUsers="$probeAsking" -v fromUsers="$probeAddressee" -v tag="${probeStanding%%$'\t'*}" -v threadCount="${probeStanding#*$'\t'}" -v others="$probeOthers" -v mode="$probeMode" -v callerName="$probeMember" -v includeOwn="$probeIncludeOwnFlag" \
			-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsDismissalMatch.awk" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsSlackThreadAnswers.awk" \
			< "$probeOut.rendered" > "$probeOut" 2>> "$probeOut.err" || probeRc=$?
	fi
	## A rendering step that could not run is an UNREADABLE SOURCE and is reported as
	## one -- never as a thread that holds no answer. The filter refuses a rendering
	## that does not carry our own message for exactly that reason.
	if [ "$probeRc" != "0" ] ; then
		[ ! -s "$probeOut.err" ] || cat "$probeOut.err" >&2
		return 2
	fi
	return 0
}

## A local drop path -- a file, or a directory listed by name. This is the shape
## an IM bridge or a portal interaction feed writes into before either has a
## native adapter of its own, and it is what makes a wait testable with no host
## involved. An absent path renders empty rather than failing: "not there yet"
## is a state, and a drop that appears later is exactly the arrival being waited
## for.
AgentsWaitProbeFile(){
	local probeMember="$1" probeTarget="$2" probeSince="$3" probeOut="$4" probeRc=0
	case "$probeTarget" in
		/*) ;;
		*)  return 2 ;;
	esac
	if [ -d "$probeTarget" ] ; then
		( cd "$probeTarget" && ls -1 ) > "$probeOut" 2>/dev/null || probeRc=$?
		[ "$probeRc" = "0" ] || return 2
		return 0
	fi
	if [ -f "$probeTarget" ] ; then
		cat "$probeTarget" > "$probeOut" 2>/dev/null || probeRc=$?
		[ "$probeRc" = "0" ] || return 2
		return 0
	fi
	: > "$probeOut" || return 2
	return 0
}

## A detached Bash process's output, owned by the session: its stdout and stderr so far,
## each line prefixed with > for stdout and ! for stderr, under a State line so a wait
## wakes on new output AND on the process ending. The target is the handle the Bash
## start returned; the session folder it lives in is this wait's own session's.
## A STOPPED handle is read only as far as it stood when the stop took effect: its `.closed`
## marker keeps the byte counts (out <n>, err <n>), and the rendering stops there. So a child
## that outlived the stop cannot make a closed handle look like it wrote something new, and a
## wait that has returned CLOSED never returns that source again on what came after it. A marker
## with no counts in it was written by an older build, and its output is read whole, as it was.
AgentsWaitProbeProcess(){
	local probeTarget="$2" probeOut="$4" probeDir probePid probeCaps="" probeClosedLine probeOutCap="" probeErrCap=""
	[ -n "${waitSessionId:-}" ] || return 2
	[ -n "$probeTarget" ] || return 2
	probeDir="$MMDAPP/.local/agents/sessions/$waitSessionId/processes"
	[ -d "$probeDir" ] || return 2
	[ -f "$probeDir/$probeTarget.out" ] || [ -f "$probeDir/$probeTarget.err" ] || return 2
	probePid=""
	read -r probePid < "$probeDir/$probeTarget.pid" 2>/dev/null || probePid=""
	if [ -f "$probeDir/$probeTarget.closed" ] ; then
		while IFS= read -r probeClosedLine ; do
			case "$probeClosedLine" in
				'out '*) probeOutCap="${probeClosedLine#out }" ; probeCaps="yes" ;;
				'err '*) probeErrCap="${probeClosedLine#err }" ; probeCaps="yes" ;;
			esac
		done < "$probeDir/$probeTarget.closed"
		if [ -n "$probeCaps" ] ; then
			case "$probeOutCap" in ''|*[!0-9]*) probeOutCap=0 ;; esac
			case "$probeErrCap" in ''|*[!0-9]*) probeErrCap=0 ;; esac
		fi
	fi
	{
		if [ -f "$probeDir/$probeTarget.closed" ] ; then
			printf 'State: CLOSED\n'
		elif [ -n "$probePid" ] && kill -0 "$probePid" 2>/dev/null ; then
			printf 'State: RUNNING\n'
		elif [ -f "$probeDir/$probeTarget.status" ] ; then
			printf 'State: FINISHED, exit status %s\n' "$( cat "$probeDir/$probeTarget.status" 2>/dev/null )"
		else
			printf 'State: UNKNOWN\n'
		fi
		if [ -n "$probeCaps" ] ; then
			head -c "$probeOutCap" "$probeDir/$probeTarget.out" 2>/dev/null | LC_ALL=C awk '{ print ">" $0 }'
			head -c "$probeErrCap" "$probeDir/$probeTarget.err" 2>/dev/null | LC_ALL=C awk '{ print "!" $0 }'
		else
			LC_ALL=C awk '{ print ">" $0 }' "$probeDir/$probeTarget.out" 2>/dev/null
			LC_ALL=C awk '{ print "!" $0 }' "$probeDir/$probeTarget.err" 2>/dev/null
		fi
	} > "$probeOut" 2>/dev/null || return 2
	return 0
}

## The own inbox and one board state are listings of a directory, so they are the file probe over it.
## The inbox listing is names only, deliberately: an arrival adds a name and wakes the wait.
## The inbox (AgentsTools.InboxPlace.include) is listed in its incoming/ alone, and only the
## items that came at or after the read floor: an item in processed/ wakes nothing, and marking an
## item that came before the floor handled, which moves it out of incoming/, changes nothing that is
## listed -- marking is the waiting member's own act, never new input for it.
AgentsWaitProbeInbox(){
	[ -n "${MDAT_DATA_ROOT:-}" ] || return 2
	local probeDir="$MDAT_DATA_ROOT/inboxes/$2/incoming" probeFloor="${3%%.*}" probeFile probeAt
	: > "$4" || return 2
	[ -d "$probeDir" ] || return 0
	for probeFile in "$probeDir"/*.md ; do
		[ -f "$probeFile" ] || continue
		probeAt="$( date -r "$probeFile" +%s 2> /dev/null )" || continue
		case "$probeFloor" in
			''|*[!0-9]*) ;;
			*) [ "$probeAt" -ge "$probeFloor" ] || continue ;;
		esac
		printf '%s\n' "${probeFile##*/}" >> "$4" || return 2
	done
	return 0
}
AgentsWaitProbeBoard(){
	[ -n "${MDAT_DATA_ROOT:-}" ] || return 2
	AgentsWaitProbeFile "$1" "$MDAT_DATA_ROOT/board/$2" "$3" "$4"
}

## THE WAKE MARKER of the member (AgentsTools.WakeMarker.include): the one line a message posted to it by one of
## our own members writes, one file, no request. It is read at every tick and it is NO ARRIVAL of its own -- what
## it says is not what a member is to read, so the round that finds it changed takes it as read and reads the
## sources again at once, the costly ones included, and returns whatever that finds (see the round below).
## A marker that is absent, or that cannot be read, renders EMPTY and is no fault: it is a hint that a message is
## there, and a hint missed must never turn a quiet wait into one that reports a source it could not read -- which
## would silence the keepalive round of a duty session (AgentsHarnessIdleWait) for a file it does not need.
AgentsWaitProbeWake(){
	local probeFile
	type AgentsToolsWakePath > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.WakeMarker.include" 2> /dev/null || :
	probeFile="$( AgentsToolsWakePath "$2" )" || probeFile=""
	: > "$4" || return 2
	[ -z "$probeFile" ] || [ ! -f "$probeFile" ] || cat "$probeFile" > "$4" 2> /dev/null || :
	return 0
}

## A question asked with AskQuestion, named by its pending reply id: the wait item the ask
## adds to its session's wait. What it is judged against comes from its record -- the thread,
## our own question's ts as the floor, the accounts whose answer counts -- and the thread is read
## through the slack probe above, so this is exactly the read AskQuestion's own wait makes.
## An escalation to a member with no Slack account is answered by the team operation closing
## the record, so there the record's status is the arrival; on a thread a closed record adds its
## status line too, which is how an answer taken elsewhere is seen. Arrivals only, so its
## baseline is empty (agentsWaitKindEmptyBaseline). Turning the answer into the record's verdict
## is the asking harness's (AgentsHarnessAskResolve), never this probe's.
## A decision its asker closed by readback keeps a `follow-floor`, the readback's own ts: it
## is then watched from there, with no closed line, so what arrives is only what the person
## wrote after the readback -- an objection, or more -- which the asking harness keeps.
## An answer given through the team operation -- by the one asked, or on its behalf -- is in
## no thread, and the record keeps the session that gave it: there the record's status is the
## arrival, said beside whatever its thread holds from its follow floor, and when that thread
## cannot be read. So it reaches its asker in the wait that runs, or in the next one, whoever
## was asked: an account, or a member with none, which stands among the addressees by its
## member name and whose reply in the thread is read too (AgentsSlackThreadAnswers.awk).
## The conversation of an ask that is one top-level post of a direct conversation, read for what its person typed there after the floor, appended to the ask's rendering
## in the form of a thread's answers. The escalation reader does the same (AgentsToolsEscalationAskDirect): a reply typed in the conversation is no reply to the post, so no
## read of the thread carries it. Whether the conversation is a direct one is asked of Slack once and kept beside the record (`.direct`: `im`, or `other <epoch>`, asked again
## after five minutes); only a conversation id that begins with D is asked about at all. A read that fails leaves the thread's result as it was.
AgentsWaitAskDirectLoad(){
	set -- --helpers-only
	. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.MemberEscalation.include" > /dev/null 2>&1 || :
}
AgentsWaitAskDirectRead(){ ## member, record file, channel, floor, addressees, asking accounts, ask identity, the ask's rendering file, the question's own ts (the conversation is read from it)
	local directCache="${2%.md}.direct" directKind="" directNow directThen
	case "$3" in D*) ;; *) return 1 ;; esac
	[ ! -f "$directCache" ] || directKind="$( cat "$directCache" 2> /dev/null )"
	directNow="$( date +%s )"
	case "$directKind" in
		im) ;;
		other\ *)
			directThen="${directKind#other }"
			case "$directThen" in ''|*[!0-9]*) directThen=0 ;; esac
			[ $(( directNow - directThen )) -ge 300 ] || return 1
			directKind=""
		;;
		*) directKind="" ;;
	esac
	if [ -z "$directKind" ] ; then
		type AgentsToolsEscalationAskDirect > /dev/null 2>&1 || AgentsWaitAskDirectLoad
		type AgentsToolsEscalationAskDirect > /dev/null 2>&1 || return 1
		if AgentsToolsEscalationAskDirect "$2" "$3" ; then
			printf 'im\n' > "$directCache" 2> /dev/null || :
		else
			printf 'other %s\n' "$directNow" > "$directCache" 2> /dev/null || :
			return 1
		fi
	fi
	DistroAgentsTools --intern-op-comms-slack-read "$1" "$3" --oldest "${9:-$4}" ${7:+$( [ "$7" = bot ] && printf '%s' --identity-bot )} > "$8.direct" 2> /dev/null || return 1
	AgentsWaitOwnFile "$8.direct" || return 1
	LC_ALL=C awk 'NR == 1 && /^## target=/ { next ; } { print }' "$8.direct" \
		| LC_ALL=C awk -v rootTs="${9:-$4}" -v askingUsers="$6" -v fromUsers="$5" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsDismissalMatch.awk" \
			-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsSlackThreadAnswers.awk" 2> /dev/null \
		| LC_ALL=C awk -v floorTs="$4" '
			function secOf(v) { sub(/\..*$/, "", v) ; return ( v == "" ? 0 : v + 0 ) ; }
			function fracOf(v) { if ( v !~ /\./ ) { return "000000" ; } sub(/^[^.]*\./, "", v) ; return substr(v "000000", 1, 6) ; }
			## what stands at or before the floor was delivered already: only the rows after it
			/^[0-9]+\.[0-9]+ \| / { keep = ( secOf($1) > secOf(floorTs) || ( secOf($1) == secOf(floorTs) && fracOf($1) > fracOf(floorTs) ) ) ; }
			keep { print ; }' > "$8.direct.out" 2> /dev/null || return 1
	AgentsWaitOwnFile "$8.direct.out" || return 1
	cat "$8.direct.out" >> "$8"
}
AgentsWaitProbeAsk(){
	local probeMember="$1" probeTarget="$2" probeOut="$4" probeRecord probeLine
	local probeStatus="" probeChannel="" probeTs="" probeThreadTs="" probeAddressees="" probeFollow=""
	local probeAsking="" probeRevision="" probeKind="" probeSelect="" probeIdentity=""
	local probeBySession="" probeByOperation="" probeUnread=""
	probeRecord="$MMDAPP/.local/agents/pending/$probeTarget.md"
	[ -f "$probeRecord" ] || probeRecord="$MMDAPP/.local/agents/pending/closed/$probeTarget.md"
	[ -f "$probeRecord" ] || return 2
	while IFS= read -r probeLine ; do
		case "$probeLine" in
			'status: '*) probeStatus="${probeLine#status: }" ;;
			'channel: '*) probeChannel="${probeLine#channel: }" ;;
			'question-ts: '*) probeTs="${probeLine#question-ts: }" ;;
			'thread-ts: '*) probeThreadTs="${probeLine#thread-ts: }" ;;
			'addressees: '*) probeAddressees="${probeLine#addressees: }" ;;
			'follow-floor: '*) probeFollow="${probeLine#follow-floor: }" ;;
			'asking-accounts: '*) probeAsking="${probeLine#asking-accounts: }" ;;
			'revision-ts: '*) probeRevision="${probeLine#revision-ts: }" ;;
			'kind: '*) probeKind="${probeLine#kind: }" ;;
			'select: '*) probeSelect="${probeLine#select: }" ;;
			'ask-identity: '*) probeIdentity="${probeLine#ask-identity: }" ;;
			'answered-session: '*) probeBySession="${probeLine#answered-session: }" ;;
			'# '*) break ;;
		esac
	done < "$probeRecord"
	[ "$probeStatus" != "reply-pending" ] || probeFollow=""
	## Answered through the team operation.
	[ "$probeStatus" = "reply-pending" ] || [ -z "$probeBySession" ] || probeByOperation=1
	## A question asked again, changed, is answered on its live version: the replies after it
	## and the clicks under it -- and, where the question has its own thread, the clicks under
	## its first post too, which stays the place to answer.
	local probeAlso=""
	[ -z "$probeRevision" ] || [ "$probeThreadTs" != "$probeTs" ] || [ -n "$probeFollow" ] || probeAlso="$probeTs"
	if [ -n "$probeChannel" ] && [ -n "$probeTs" ] && [ -n "$probeThreadTs" ] && [ -n "$probeAddressees" ] ; then
		## Read with the identity the question was asked with, as every reader of its answer does.
		## A proposal is answered on its root alone: the clicks under its root, never those under
		## the proposal reply, and the replies after that reply (AgentsSlackThreadAnswersSince.awk).
		if [ "$probeKind" = "proposal" ] && [ -n "$probeRevision" ] && [ -z "$probeFollow" ] ; then
			AgentsWaitProbeSlack "$probeMember" "$probeChannel:$probeThreadTs" "$probeTs" "$probeOut.root" "$probeAddressees" "false" "$probeAsking" "" "$( [ "$probeIdentity" = "bot" ] && printf 'true' || printf 'false' )" || probeUnread=1
			[ -n "$probeUnread" ] || LC_ALL=C awk -v sinceTs="$probeRevision" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsSlackThreadAnswersSince.awk" \
				< "$probeOut.root" > "$probeOut" 2>/dev/null || probeUnread=1
		else
			AgentsWaitProbeSlack "$probeMember" "$probeChannel:$probeThreadTs" "${probeFollow:-${probeRevision:-$probeTs}}" "$probeOut" "$probeAddressees" "false" "$probeAsking" "$probeAlso" "$( [ "$probeIdentity" = "bot" ] && printf 'true' || printf 'false' )" || probeUnread=1
		fi
		## A thread that cannot be read is an unreadable source, except where the record itself
		## holds the answer: what the team operation answered is said from the record alone.
		if [ -n "$probeUnread" ] ; then
			[ -n "$probeByOperation" ] || return 2
			: > "$probeOut" || return 2
		fi
		## An answered question is watched for what the person writes after. A click under it
		## answers nothing any more, and the emoji there change by the tooling's own hand: its
		## answer emoji leave that post with the answered mark, or as the post is closed. So
		## once the record is closed no reaction line is an arrival: only a message is.
		if [ "$probeStatus" != "reply-pending" ] && LC_ALL=C grep -q '^reaction on the question: ' "$probeOut" 2>/dev/null ; then
			LC_ALL=C grep -v '^reaction on the question: ' "$probeOut" > "$probeOut.kept" 2>/dev/null || :
			mv -f "$probeOut.kept" "$probeOut" || return 2
		fi
		## Several options are sent by the send mark: until the clicks give a verdict
		## (AgentsEscalationVerdict.awk, the one reader), a number clicked is no arrival yet.
		if [ "$probeSelect" = "many" ] && [ "$probeStatus" = "reply-pending" ] && LC_ALL=C grep -q '^reaction on the question: ' "$probeOut" 2>/dev/null ; then
			case "$( LC_ALL=C grep '^reaction on the question: ' "$probeOut" | MDAT_VERDICT_KIND="${probeKind:-question}" MDAT_VERDICT_SELECT="$probeSelect" \
				MDAT_VERDICT_OPTIONS="$( cat "${probeRecord%.md}.options" 2>/dev/null )" MDAT_VERDICT_AUTHORS="$probeAddressees" MDAT_VERDICT_ASKING="$probeAsking" \
				LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsEscalationVerdict.awk" 2>/dev/null )" in
				RETURNED*|'')
					LC_ALL=C grep -v '^reaction on the question: ' "$probeOut" > "$probeOut.kept" 2>/dev/null || :
					mv -f "$probeOut.kept" "$probeOut" || return 2
				;;
			esac
		fi
		## What the person types at the top of a direct conversation, where the question is one top-level post of it, answers too.
		if [ -z "$probeUnread" ] && ! LC_ALL=C grep -q -E '^([0-9]+\.[0-9]+ \| |reaction on the question: )' "$probeOut" 2>/dev/null ; then
			AgentsWaitAskDirectRead "$probeMember" "$probeRecord" "$probeChannel" "${probeFollow:-${probeRevision:-$probeTs}}" "$probeAddressees" "$probeAsking" "$probeIdentity" "$probeOut" "${probeRevision:-$probeTs}" || :
		fi
	else
		## No thread is read here, so a record's status is all there is to watch: closed, it says so.
		probeFollow=""
		: > "$probeOut" || return 2
	fi
	[ "$probeStatus" = "reply-pending" ] || { [ -n "$probeFollow" ] && [ -z "$probeByOperation" ] ; } || printf '# pending reply %s is closed: %s\n' "$probeTarget" "${probeStatus:-none}" >> "$probeOut" || return 2
	return 0
}

## THE REPLIES TO THE RUN'S OWN POSTS: the floor of a plain Wait, `replies:<session id>`. A run that
## posted a question does not choose where to watch for the answer, a channel or a thread: it calls
## Wait, and Wait holds every post the run made. They are in sessions/<id>/last-own-post, written at
## each send (AgentsHarnessOwnPostRecord), a line each, the latest first: `<channel>:<thread> <ts>
## <addressees> <thread floor> <conversation floor> <siblings> <reactions> <checked>`, a word not known
## yet `-`. What a post holds, as the epic's floor reads (F3.3):
##   - every reply in its thread, the run's own posts apart (AgentsWaitOwnPostReplies.awk, mode thread);
##   - for a post at the top of its conversation, the messages after it there from the people it
##     addressed, and any that mention the run, until ten siblings have followed it. After that its
##     siblings are no longer watched: the conversation is read on from where it stopped for a mention
##     of the run alone. The thread is read as ever: its watch does not end by time alone;
##   - the reactions to the post, and the mentions of the run, whatever else has ended.
## A post is looked at only when its TTL has passed since the last look (<checked>): 5 seconds, and 1 more
## for every 20 it has been quiet, from its newest message seen, with no cap, so a quiet thread is looked
## at ever more rarely, on some loop runs only, and is never dropped. A post whose thread another source
## of the same Wait reads is left to that source, and so is a conversation it reads by name, so a message
## is returned once; a post a question (AskQuestion and its kin) opened belongs to its pending record's
## ask: source. What a look finds is rendered to the wait and stored only once the wait has returned it
## (AgentsWaitRepliesCommit): a wait that ended before it was said loses nothing. The words stored are
## this record's, the one record of the run's own posts.
agentsWaitRepliesSiblings=10
## The conversations and threads the other sources of this wait read, found from agentsWaitCoverSources (the
## wait's sources, set before it polls) when a post needs them, `?` until then: `<channel>` for a whole
## conversation, `<channel>:<thread>` for a thread, spaced.
agentsWaitCovered=""
agentsWaitCoverSources=""

## What the other sources of a wait read, for the floor to leave to them.
AgentsWaitCoveredSet(){ ## member, sources...
	local coverMember="$1" coverSource coverName coverResolved coverRecord coverLine coverChannel coverThread coverList=""
	shift
	for coverSource in "$@" ; do
		case "${coverSource/#slack:client:/slack:}" in
			slack:*:*:conversation)
				coverName="${coverSource#slack:}"
				coverList="$coverList ${coverName%:conversation}"
			;;
			slack:*:*) ;;
			slack:?*)
				type DistroAgentsToolsResolveTarget > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.CommsSlack.include" 2> /dev/null || continue
				coverResolved="$( DistroAgentsToolsResolveTarget "${coverSource#slack:}" "$coverMember" 2> /dev/null )" || continue
				coverChannel="$( printf '%s\n' "$coverResolved" | sed -n 's/^CHANNEL=//p' )"
				[ -z "$coverChannel" ] || coverList="$coverList $coverChannel"
			;;
			ask:*)
				coverRecord="$MMDAPP/.local/agents/pending/${coverSource#ask:}.md"
				[ -f "$coverRecord" ] || coverRecord="$MMDAPP/.local/agents/pending/closed/${coverSource#ask:}.md"
				[ -f "$coverRecord" ] || continue
				coverChannel="" coverThread=""
				while IFS= read -r coverLine ; do
					case "$coverLine" in
						'channel: '*) coverChannel="${coverLine#channel: }" ;;
						'thread-ts: '*) coverThread="${coverLine#thread-ts: }" ;;
						'# '*) break ;;
					esac
				done < "$coverRecord"
				[ -z "$coverChannel" ] || [ -z "$coverThread" ] || coverList="$coverList $coverChannel:$coverThread"
			;;
		esac
	done
	printf '%s\n' "${coverList# }"
}

## One look at a thread or a conversation, rendered in the form every reader of Slack here reads. The
## file is the caller's own, and a step of the wait that wrote it is noted (AgentsWaitOwnFile).
AgentsWaitReadRendered(){ ## member, read target, thread|conversation, oldest (a conversation only; may be empty), the rendering file
	local readMember="$1" readTarget="$2" readKind="$3" readOldest="$4" readOut="$5" readArgs readRc=0
	readArgs=( "$readMember" "$readTarget" )
	[ "${MDAT_WAIT_READ_AS_BOT:-}" != "true" ] || readArgs=( "${readArgs[@]}" --identity-bot )
	if [ "$readKind" = "thread" ] ; then
		readArgs=( "${readArgs[@]}" --thread )
	elif [ -n "$readOldest" ] ; then
		readArgs=( "${readArgs[@]}" --oldest "$readOldest" )
	fi
	DistroAgentsTools --intern-op-comms-slack-read "${readArgs[@]}" > "$readOut.read" 2> "$readOut.err" || readRc=$?
	## A conversation the user identity cannot see, such as the bot's own DM with a person, is read again as the bot.
	if [ "$readRc" != "0" ] && [ "${MDAT_WAIT_READ_AS_BOT:-}" != "true" ] && LC_ALL=C grep -q 'channel_not_found' "$readOut.err" 2> /dev/null ; then
		readRc=0
		DistroAgentsTools --intern-op-comms-slack-read "${readArgs[@]}" --identity-bot > "$readOut.read" 2> "$readOut.err" || readRc=$?
	fi
	if [ "$readRc" != "0" ] ; then
		[ ! -s "$readOut.err" ] || cat "$readOut.err" >&2
		return 2
	fi
	AgentsWaitOwnFile "$readOut.read" || return 2
	if [ "$readKind" = "thread" ] ; then
		LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsSlackMessagesFormat.awk" < "$readOut.read" > "$readOut" 2>> "$readOut.err" || readRc=$?
	else
		## A conversation is read formatted already (AgentsToolsSlackCheck), its lines the rendering, less the
		## `## target=` mark: the JSON formatter would print nothing of them.
		LC_ALL=C awk 'NR == 1 && /^## target=/ { next ; } { print ; }' < "$readOut.read" > "$readOut" 2>> "$readOut.err" || readRc=$?
	fi
	AgentsWaitOwnFile "$readOut" || return 2
	if [ "$readRc" != "0" ] ; then
		[ ! -s "$readOut.err" ] || cat "$readOut.err" >&2
		return 2
	fi
	AgentsWaitTrackingDropFile "$readMember" "$readOut"
	return 0
}

## The tooling's own posts out of a rendering file, in place, for a member: a tracking post is no input to it (AgentsTools.TrackingDrop.include).
AgentsWaitTrackingDropFile(){ ## member, a rendering file
	type AgentsToolsTrackingDrop > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.TrackingDrop.include" 2> /dev/null || return 0
	[ -f "$2" ] || return 0
	AgentsToolsTrackingDrop "$1" < "$2" > "$2.nt" 2> /dev/null && mv -f "$2.nt" "$2" || rm -f "$2.nt"
	return 0
}

## A value of a side file the reading awk wrote, `<key> <value>` a line.
AgentsWaitRepliesSide(){ ## side file, key
	LC_ALL=C awk -v wantKey="$2" '$1 == wantKey { sub(/^[^ ]+ /, "") ; print ; exit ; }' "$1" 2> /dev/null
}

## One post of the record: looked at when its TTL has passed. Appends what it found to the rendering
## file ($4) and its new line to $4.advance. rc 0 looked, 1 left alone (not due, or not this floor's), 2 could not be read.
## A post that could not be read is not looked at again at the next round: it keeps its words and has its
## check time moved, so the TTL paces the retry.
AgentsWaitRepliesLook(){ ## member, now (epoch), the post's line, the rendering file, a number for its working files
	local lookRc=0 lookFail
	AgentsWaitRepliesLookRead "$@" || lookRc=$?
	if [ "$lookRc" = "2" ] ; then
		lookFail="$( printf '%s\n' "$3" | LC_ALL=C awk -v now="$2" '{ print $1 " " $2 " " ( NF >= 3 ? $3 : "-" ) " " ( NF >= 4 ? $4 : "-" ) " " ( NF >= 5 ? $5 : "-" ) " " ( NF >= 6 ? $6 : 0 ) " " ( NF >= 7 ? $7 : "-" ) " " now ; }' )"
		printf '%s\n' "$lookFail" >> "$4.advance"
	fi
	return "$lookRc"
}
AgentsWaitRepliesLookRead(){ ## the same arguments
	local lookMember="$1" lookNow="$2" lookOut="$4" lookFile="$4.post.$5" lookRc=0
	local lookWhere lookTs lookAddr lookThreadFloor lookChanFloor lookSibs lookReact lookChecked lookRest
	local lookChannel lookThread lookActivity lookQuiet lookFrom lookDeliver=1 lookChannelCovered="" lookFound="" lookSide lookNew
	local lookNewThreadFloor lookNewChanFloor lookNewSibs lookNewReact lookReactions lookSignature lookMentionsOnly
	read -r lookWhere lookTs lookAddr lookThreadFloor lookChanFloor lookSibs lookReact lookChecked lookRest <<< "$3"
	lookAddr="${lookAddr:--}" ; lookThreadFloor="${lookThreadFloor:--}" ; lookChanFloor="${lookChanFloor:--}"
	lookSibs="${lookSibs:-0}" ; lookReact="${lookReact:--}" ; lookChecked="${lookChecked:-0}"
	case "$lookTs" in ''|.*|*.|*.*.*|*[!0-9.]*) return 1 ;; esac
	case "$lookSibs$lookChecked" in ''|*[!0-9]*) return 1 ;; esac
	case "$lookWhere" in
		*:*) lookChannel="${lookWhere%:*}" ; lookThread="${lookWhere##*:}" ;;
		*) return 1 ;;
	esac
	case "$lookThread" in ''|.*|*.|*.*.*|*[!0-9.]*) return 1 ;; esac
	## Quiet since its newest message seen: the TTL grows with it.
	lookActivity="${lookTs%%.*}"
	for lookRest in "$lookThreadFloor" "$lookChanFloor" ; do
		lookRest="${lookRest%%.*}"
		case "$lookRest" in ''|*[!0-9]*) continue ;; esac
		[ "$lookRest" -le "$lookActivity" ] || lookActivity="$lookRest"
	done
	lookQuiet=$(( lookNow - lookActivity ))
	[ "$lookQuiet" -ge 0 ] || lookQuiet=0
	[ $(( lookNow - lookChecked )) -ge $(( 5 + lookQuiet / 20 )) ] || return 1
	## A question the ask tools opened, and the thread it lives in, are answered through its pending record --
	## its answer, its clicks, what the person adds -- which the stored wait carries as an ask: source.
	LC_ALL=C grep -q -x -F -e "question-ts: $lookTs" -e "thread-ts: $lookThread" "$MMDAPP/.local/agents/pending"/*.md 2> /dev/null && return 1
	## What the other sources of this wait read, found once for the call and the first post that needs it.
	[ "$agentsWaitCovered" != "?" ] || agentsWaitCovered="$( AgentsWaitCoveredSet "$lookMember" $agentsWaitCoverSources )"
	case " $agentsWaitCovered " in *" $lookChannel:$lookThread "*) lookDeliver=0 ;; esac
	case " $agentsWaitCovered " in *" $lookChannel "*) lookChannelCovered=1 ;; esac
	lookNewThreadFloor="$lookThreadFloor" ; lookNewChanFloor="$lookChanFloor" ; lookNewSibs="$lookSibs" ; lookNewReact="$lookReact"
	## Its thread: every reply after the post, or after the last one returned.
	lookFrom="$lookTs"
	[ "$lookThreadFloor" = "-" ] || ! AgentsWaitTsNewer "$lookThreadFloor" "$lookFrom" || lookFrom="$lookThreadFloor"
	AgentsWaitReadRendered "$lookMember" "$lookChannel:$lookThread" thread "" "$lookFile.thread" || return 2
	LC_ALL=C awk -v mode=thread -v postTs="$lookTs" -v floorTs="$lookFrom" -v callerName="$lookMember" -v deliver="$lookDeliver" -v side="$lookFile.thread.side" \
		-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsDismissalMatch.awk" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsWaitOwnPostReplies.awk" \
		< "$lookFile.thread" > "$lookFile.thread.out" 2>> "$lookFile.thread.err" || lookRc=$?
	AgentsWaitOwnFile "$lookFile.thread.out" || return 2
	AgentsWaitOwnFile "$lookFile.thread.side" || return 2
	if [ "$lookRc" != "0" ] ; then
		[ ! -s "$lookFile.thread.err" ] || cat "$lookFile.thread.err" >&2
		return 2
	fi
	if [ "$lookDeliver" = "1" ] ; then
		lookSide="$( AgentsWaitRepliesSide "$lookFile.thread.side" newest )"
		[ "$lookSide" = "-" ] || [ -z "$lookSide" ] || lookNewThreadFloor="$lookSide"
	fi
	lookReactions="$( AgentsWaitRepliesSide "$lookFile.thread.side" reactions )"
	: > "$lookFile.chan.out"
	## Its conversation, for a post at the top of it: until ten siblings have followed, the people it
	## addressed and whoever mentions the run; after the tenth only a mention of the run, read on from
	## where the last read stopped, which is the cheapest read that finds one. Not where another source
	## of this wait reads the conversation by name.
	if [ "$lookThread" = "$lookTs" ] && [ -z "$lookChannelCovered" ] ; then
		lookMentionsOnly=0
		[ "$lookSibs" -lt "$agentsWaitRepliesSiblings" ] || lookMentionsOnly=1
		lookFrom="$lookTs"
		[ "$lookChanFloor" = "-" ] || ! AgentsWaitTsNewer "$lookChanFloor" "$lookFrom" || lookFrom="$lookChanFloor"
		AgentsWaitReadRendered "$lookMember" "$lookChannel" conversation "$lookFrom" "$lookFile.chan" || return 2
		## A top-level message is the reply of the LATEST post of the run above it in that conversation, and is returned once: what stands at or after the run's next
		## top-level post there belongs to that post, never to this one.
		if [ -n "${waitSessionId:-}" ] && [ -f "$MMDAPP/.local/agents/sessions/$waitSessionId/last-own-post" ] ; then
			local lookUntil
			lookUntil="$( LC_ALL=C awk -v channel="$lookChannel" -v after="$lookTs" '
				function secOf(v) { sub(/\..*$/, "", v) ; return ( v == "" ? 0 : v + 0 ) ; }
				function fracOf(v) { if ( v !~ /\./ ) { return "000000" ; } sub(/^[^.]*\./, "", v) ; return substr(v "000000", 1, 6) ; }
				function newer(a, b) { return ( secOf(a) > secOf(b) || ( secOf(a) == secOf(b) && fracOf(a) > fracOf(b) ) ) ; }
				{ split($1, where, ":") ; if ( where[1] == channel && where[2] == $2 && newer($2, after) && ( best == "" || newer(best, $2) ) ) { best = $2 } }
				END { print best }' "$MMDAPP/.local/agents/sessions/$waitSessionId/last-own-post" 2> /dev/null )" || lookUntil=""
			if [ -n "$lookUntil" ] ; then
				LC_ALL=C awk -v untilTs="$lookUntil" '
					function secOf(v) { sub(/\..*$/, "", v) ; return ( v == "" ? 0 : v + 0 ) ; }
					function fracOf(v) { if ( v !~ /\./ ) { return "000000" ; } sub(/^[^.]*\./, "", v) ; return substr(v "000000", 1, 6) ; }
					/^[0-9]+\.[0-9]+ \| / { keep = ( secOf(untilTs) > secOf($1) || ( secOf(untilTs) == secOf($1) && fracOf(untilTs) > fracOf($1) ) ) ; }
					NR == 1 && /^## target=/ { print ; next ; }
					keep || NR == 1 { print ; }' < "$lookFile.chan" > "$lookFile.chan.cut" 2> /dev/null && mv -f "$lookFile.chan.cut" "$lookFile.chan" || rm -f "$lookFile.chan.cut"
			fi
		fi
		LC_ALL=C awk -v mode=channel -v postTs="$lookTs" -v floorTs="$lookFrom" -v callerName="$lookMember" -v addressees="${lookAddr//,/ }" \
			-v siblings="$lookSibs" -v siblingsMax="$agentsWaitRepliesSiblings" -v mentionsOnly="$lookMentionsOnly" -v side="$lookFile.chan.side" \
			-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsDismissalMatch.awk" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsWaitOwnPostReplies.awk" \
			< "$lookFile.chan" > "$lookFile.chan.out" 2>> "$lookFile.chan.err" || lookRc=$?
		AgentsWaitOwnFile "$lookFile.chan.out" || return 2
		AgentsWaitOwnFile "$lookFile.chan.side" || return 2
		if [ "$lookRc" != "0" ] ; then
			[ ! -s "$lookFile.chan.err" ] || cat "$lookFile.chan.err" >&2
			return 2
		fi
		lookSide="$( AgentsWaitRepliesSide "$lookFile.chan.side" newest )"
		[ "$lookSide" = "-" ] || [ -z "$lookSide" ] || lookNewChanFloor="$lookSide"
		lookSide="$( AgentsWaitRepliesSide "$lookFile.chan.side" siblings )"
		case "$lookSide" in ''|*[!0-9]*) ;; *) lookNewSibs="$lookSide" ;; esac
	fi
	## A reaction to the post: returned when the post has a set it did not have when it was last returned.
	if [ -n "$lookReactions" ] && [ "$lookReactions" != "-" ] ; then
		lookSignature="$( printf '%s' "$lookReactions" | LC_ALL=C cksum | LC_ALL=C cut -d' ' -f1 )"
		if [ "$lookSignature" != "$lookReact" ] ; then
			lookNewReact="$lookSignature"
			lookFound="reactions on your post $lookTs: $lookReactions"
		fi
	fi
	## What the floor returns of this post is brought into the session chat file too, as replies to the member's own post
	## delivered by this wait itself (AgentsWaitChatImportReplies): the tool returns of its other runs carry them only
	## if this wait did not, and the file stays the record of the session.
	[ ! -s "$lookFile.thread.out" ] || AgentsWaitChatImportReplies "$lookMember" "$lookChannel:$lookThread" "$lookFile.thread.out" || :
	[ ! -s "$lookFile.chan.out" ] || AgentsWaitChatImportReplies "$lookMember" "$lookChannel:$lookThread" "$lookFile.chan.out" || :
	if [ -s "$lookFile.thread.out" ] || [ -s "$lookFile.chan.out" ] || [ -n "$lookFound" ] ; then
		printf '# replies to your post %s:%s\n' "$lookChannel" "$lookTs" >> "$lookOut"
		cat "$lookFile.thread.out" "$lookFile.chan.out" >> "$lookOut"
		[ -z "$lookFound" ] || printf '%s\n' "$lookFound" >> "$lookOut"
	fi
	lookNew="$lookWhere $lookTs $lookAddr $lookNewThreadFloor $lookNewChanFloor $lookNewSibs $lookNewReact $lookNow"
	printf '%s\n' "$lookNew" >> "$lookOut.advance"
	return 0
}

## The replies source: every post of the record that is due, oldest first. An unreadable post is left
## as it was and is looked at again; the source is unreadable only where every look failed.
AgentsWaitProbeReplies(){
	local probeMember="$1" probeSession="$2" probeOut="$4" probeRecord probeNow probeLine probeCount=0 probeIndex probeAttempted=0 probeFailed=0 probeRc
	local probeLines=()
	: > "$probeOut" || return 2
	: > "$probeOut.advance" || return 2
	AgentsToolsAssertBareName "$probeSession" "<session-id>" replies > /dev/null 2>&1 || return 2
	probeRecord="$MMDAPP/.local/agents/sessions/$probeSession/last-own-post"
	[ -f "$probeRecord" ] || return 0
	probeNow="$( date +%s )"
	while IFS= read -r probeLine ; do
		[ -z "$probeLine" ] || { probeCount=$(( probeCount + 1 )) ; probeLines[$probeCount]="$probeLine" ; }
	done < "$probeRecord"
	probeIndex="$probeCount"
	while [ "$probeIndex" -ge 1 ] ; do
		probeRc=0
		AgentsWaitRepliesLook "$probeMember" "$probeNow" "${probeLines[$probeIndex]}" "$probeOut" "$probeIndex" || probeRc=$?
		case "$probeRc" in
			0) probeAttempted=$(( probeAttempted + 1 )) ;;
			2) probeAttempted=$(( probeAttempted + 1 )) ; probeFailed=$(( probeFailed + 1 )) ;;
		esac
		probeIndex=$(( probeIndex - 1 ))
	done
	if [ "$probeAttempted" != "0" ] && [ "$probeFailed" -ge "$probeAttempted" ] ; then
		## The round that returns this stops short of the commit of a source that ran: the pacing is stored here.
		AgentsWaitRepliesCommit "$probeSession" "$probeOut.advance"
		return 2
	fi
	return 0
}

## Stores what a look found, once the wait has said it: the lines of $2 replace the lines of the record
## that start with the same two words. Under the lock the harness takes to add a post.
AgentsWaitRepliesCommit(){ ## session id, the advance file
	local commitRecord="$MMDAPP/.local/agents/sessions/$1/last-own-post" commitTmp commitLock=""
	[ -s "$2" ] && [ -f "$commitRecord" ] || return 0
	type AgentsToolsLocalLockTake > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/magic/AgentsTools.LocalLock.include" 2> /dev/null || :
	! AgentsToolsLocalLockTake "own-posts-$1" 5 "the record of the run's own posts" 2> /dev/null || commitLock="$agentsLocalLockPath"
	commitTmp="$( mktemp "$MMDAPP/.local/agents/sessions/$1/last-own-post.XXXXXX" 2> /dev/null )" || commitTmp=""
	if [ -n "$commitTmp" ] ; then
		LC_ALL=C awk -v advance="$2" '
			BEGIN {
				while ( ( getline line < advance ) > 0 ) {
					split(line, word, " ")
					replaced[word[1] " " word[2]] = line
				}
			}
			{
				split($0, word, " ")
				key = word[1] " " word[2]
				print ( key in replaced ? replaced[key] : $0 )
			}' "$commitRecord" >| "$commitTmp" 2> /dev/null \
			&& mv -f "$commitTmp" "$commitRecord" 2> /dev/null || rm -f "$commitTmp"
	fi
	[ -z "$commitLock" ] || AgentsToolsLocalLockGive "$commitLock"
	return 0
}

## Whether Slack ts (or epoch seconds) $1 is strictly newer than $2. Seconds as a number,
## microseconds as a fixed-width string, never a float -- the AgentsSlackThreadAnswers.awk rule.
AgentsWaitTsNewer(){ ## candidate, floor
	LC_ALL=C awk -v a="$1" -v b="$2" '
		function secOf(v) { sub(/\..*$/, "", v) ; return ( v == "" ? 0 : v + 0 ) ; }
		function fracOf(v) { if ( v !~ /\./ ) { return "000000" ; } sub(/^[^.]*\./, "", v) ; return substr(v "000000", 1, 6) ; }
		BEGIN { exit !( secOf(a) > secOf(b) || ( secOf(a) == secOf(b) && fracOf(a) > fracOf(b) ) ) ; }'
}

## THE FORM OF A SOURCE THE CALLER ADDS (F3.3, Settled). Short or full is the caller's choice when it adds the source, written after it,
## `slack:magic-team#short` or `slack:magic-team#full`. SHORT returns each message cut to a short form with its own reference, <source>:<ts>,
## and, once in the return, the line that says how to read one in full (--slack-read <member> <source>:<ts> --thread, the
## operation the agent has); it keeps only that short form, so a large message is copied nowhere. FULL returns every message whole; a single message too long for the return, over F2.4's threshold,
## is kept as a file of its own in the session's folder and the return carries a preview and a reference (the preview of F2.4), and no file is
## made for any other. Either way the source's index cache file, sessions/<session>/sources/<source>.md, keeps a line for each message once,
## the short form, the whole message's first words, or the preview with its file. A source with neither is returned whole, as it always was. The
## form is kept in the stored wait (`mode <source> <form>`) and goes with the source. A long return follows F2.4 as every result does.
## Prints the form of a source, nothing for none.
AgentsWaitModeOf(){ ## source
	local modeRest
	case "$waitModes" in *" $1="*) ;; *) return 0 ;; esac
	modeRest="${waitModes#* $1=}"
	printf '%s' "${modeRest%% *}"
}
## The rendering <in> of a source in its form, into <out>. rc 1, <out> not made, where the source is to be served as it is.
AgentsWaitSourceModeApply(){ ## member, source, form, in, out
	local applyTarget="${2#slack:}" applyRef applySlug applyKey applyDir="" applyIndex="" applySession=""
	applyRef="$applyTarget"
	case "$applyTarget" in
		client:*:*.*) applyRef="${applyTarget%%:*}:$( printf '%s' "${applyTarget#client:}" | LC_ALL=C cut -d: -f1 )" ;;
		*:[0-9]*.*) applyRef="${applyTarget%%:*}" ;;
	esac
	applySlug="$( printf '%s' "$2" | LC_ALL=C tr -c 'A-Za-z0-9_.-' '_' )"
	type AgentsToolsSessionChatKey > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionChat.include" 2> /dev/null || return 1
	applyKey="$( AgentsToolsSessionChatKey )"
	if [ -n "$applyKey" ] && applySession="$( AgentsToolsSessionChatDir "$applyKey" )" && mkdir -p "$applySession/sources" 2> /dev/null ; then
		applyIndex="$applySession/sources/$applySlug.md"
		applyDir="$applySession/messages/$applySlug"
	fi
	if [ "$3" = "full" ] && [ -z "$applyDir" ] ; then
		echo "# --wait-for-input: $2#full: this call has no session folder to keep the messages in, so each is returned whole" >&2
		return 1
	fi
	LC_ALL=C awk -v mode="$3" -v ref="$applyRef" -v member="$1" -v cutFlag="$5.cut" -v longBytes="${agentsReplyLongBytes:-8192}" -v dir="$( [ "$3" = full ] && printf '%s' "$applyDir" )" -v indexFile="$applyIndex" \
		-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsWaitSourceMode.awk" < "$4" > "$5" 2> /dev/null || return 1
	[ -f "$5" ]
}

## THE TTL OF A SOURCE (F3.3). The timing of a source is a TTL and no interval: Wait loops, and a source whose previous check is
## still inside its own TTL is skipped on that pass. The TTLs are hardcoded, in seconds, and each is where its source is read:
##   - the session thread, read into the chat file (AgentsWaitChatTopUp) when no other source of the wait reads it: after 5, and 1
##     more for every 20 it has been quiet, from its newest message in the file, to 300 at most, so it is looked at ever more
##     rarely and stays watched;
##   - the replies to the run's own posts, a post at a time (AgentsWaitRepliesLookRead): 5, and 1 more for every 20 quiet, no cap;
##   - the tags and mentions, and with them the team channel and the DMs they read (AgentsWaitProbeTagged): 15;
##   - a scan (AgentsWaitProbeScan): 300, how long an unchanged scan is left to stand. It is no floor on noticing a
##     message: a wake marker runs the scan at once (THE SCAN IS WOKEN AND NOT ON ITS TTL).
## The inbox, the board, a file and an ask are read at every pass, and so is a Slack source a caller names, at the divider of its
## kind (agentsWaitKindEvery, 1): the caller chose where to look. Email has no source of its own in Wait; its TTL, and Trello's, are in the table all the same,
## for the collection of the sources a scan reads (F4.2).
## Prints the seconds a source of the loop waits between its checks; 0 is every pass. Nothing of it is said in a return: an agent never needs the TTLs.
## The table itself is AgentsTools.SourceTtl.include's, the one the collection of the sources a scan reads (F4.2) reads too.
AgentsWaitTtlOf(){ ## source
	type AgentsToolsSourceTtlOf > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.SourceTtl.include"
	AgentsToolsSourceTtlOf "$1"
}
## THE SESSION CHAT FILE AS A SOURCE (F9.2): `chat:<session>`, the floor of a run beside the replies to its own posts. It reads
## the file (AgentsTools.SessionChat.include) from the pointer of the member forward, in full, the executor of the session every
## message of its thread (and, in a session with no thread, its `local` console message), a participant the ones that name it,
## and the session's own printback channel's message (F2.2). The file is kept up to date here: where no other source of this
## wait reads the session thread, the thread is read into the file when its TTL has passed (AgentsWaitChatTopUp); where one does,
## that source's own read brings it in (AgentsWaitChatImportRead), so the thread is read once. Both paths run, and a message is
## delivered once: what a source of the same Wait reads itself is read past here and not returned (AgentsWaitCoveredSet).
## Its rendering holds arrivals only (agentsWaitKindEmptyBaseline); the pointer moves once the wait has returned it
## (AgentsWaitChatCommit), and at once where the read held nothing to return.
## ThisSession's --wait-session-channel (F7.2, DistroAgentsSession.fn.sh) is a wait on this source alone, with MDAT_WAIT_CHAT_FILTER set
## for its one call to the spaced words me, here, any: the floor's rule for the messages of the session thread is then theirs
## (AgentsToolsSessionChatFloor, agentsSessionChatFilter), and what the call delivered beyond a block the floor still owes is marked
## delivered to the member at the commit, so nothing is lost and nothing comes twice.
AgentsWaitChatTopUp(){ ## member, session, thread (channel:ts), a name for the read's files
	local topNow topLast topNewest topQuiet=0 topTtl topReader
	topNow="$( date +%s )"
	topLast="$( AgentsToolsSessionChatPointer "$2" "topup:$3" )" || topLast=0
	case "$topLast" in ''|*[!0123456789]*) topLast=0 ;; esac
	topNewest="$( LC_ALL=C awk -F'\t' -v where="$3" '$3 == where { split($2, part, ".") ; if ( ( part[1] + 0 ) > newest ) { newest = part[1] + 0 ; } } END { print newest + 0 ; }' "$MMDAPP/.local/agents/sessions/$2/session.chat.index" 2> /dev/null )" || topNewest=0
	[ "$topNewest" -le 0 ] || [ "$topNow" -le "$topNewest" ] || topQuiet=$(( topNow - topNewest ))
	topTtl=$(( 5 + topQuiet / 20 ))
	[ "$topTtl" -le 300 ] || topTtl=300
	[ $(( topNow - topLast )) -ge "$topTtl" ] || return 0
	## The communications reader (F9.3) keeps the file up to date while it is current: a look of its own within the TTL and ten seconds
	## more stands this one down, and only a reader that is late, or not running, leaves the reading to the wait.
	topReader="$( AgentsToolsSessionChatReaderLooked "$2" )"
	[ -z "$topReader" ] || [ $(( topNow - topReader )) -ge $(( topTtl + 10 )) ] || return 0
	AgentsWaitReadRendered "$1" "$3" thread "" "$4" || return 1
	AgentsToolsSessionChatImport "$2" "$3" "$4" slack -
	AgentsToolsSessionChatPointerSet "$2" "topup:$3" "$topNow"
	return 0
}
## A read of the session thread by another source of this wait brings it into the file too: the rendering <file> is the thread's.
AgentsWaitChatImportRead(){ ## member, conversation:thread, the rendering file
	local importSession importThread
	type AgentsToolsSessionChatImport > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionChat.include" 2> /dev/null || return 0
	importSession="$( AgentsToolsSessionChatKey )"
	[ -n "$importSession" ] || return 0
	importThread="$( AgentsToolsSessionChatThread "$importSession" )" || return 0
	[ "$importThread" = "$2" ] || return 0
	## Delivered by the source that read it, so it is the member's own.
	AgentsToolsSessionChatImport "$importSession" "$2" "$3" slack "$1"
	AgentsToolsSessionChatPointerSet "$importSession" "topup:$2" "$( date +%s )"
	return 0
}
## The replies to a post of the member, read by its own wait: the member's, and delivered by that wait.
AgentsWaitChatImportReplies(){ ## member, conversation:thread of the post, the rendering file
	local repliesSession
	type AgentsToolsSessionChatImport > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionChat.include" 2> /dev/null || return 0
	repliesSession="$( AgentsToolsSessionChatKey )"
	[ -n "$repliesSession" ] || return 0
	AgentsToolsSessionChatImport "$repliesSession" "$2" "$3" "reply:$1" "$1"
	return 0
}
AgentsWaitProbeChat(){
	local probeMember="$1" probeSession="$2" probeOut="$4" probeThread="" probeSeen
	: > "$probeOut" || return 2
	AgentsToolsAssertBareName "$probeSession" "<session-id>" chat > /dev/null 2>&1 || return 2
	type AgentsToolsSessionChatFloor > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionChat.include" 2> /dev/null || return 2
	[ "$agentsWaitCovered" != "?" ] || agentsWaitCovered="$( AgentsWaitCoveredSet "$probeMember" $agentsWaitCoverSources )"
	## The member's pointer first: what the file holds before this wait reads anything into it is not new to the member.
	AgentsToolsSessionChatReaderInit "$probeSession" "$probeMember"
	## Says to the communications reader that a wait is blocked on the session, so that it looks at the thread every few seconds.
	AgentsToolsSessionChatWaiting "$probeSession"
	probeThread="$( AgentsToolsSessionChatThread "$probeSession" )" || probeThread=""
	if [ -n "$probeThread" ] ; then
		case " $agentsWaitCovered " in
			*" $probeThread "*) ;;
			*) AgentsWaitChatTopUp "$probeMember" "$probeSession" "$probeThread" "$probeOut.thread" || : ;;
		esac
	fi
	agentsSessionChatFilter="${MDAT_WAIT_CHAT_FILTER:-}"
	AgentsToolsSessionChatFloor "$probeSession" "$probeMember" "$agentsWaitCovered" > "$probeOut" 2> /dev/null || :
	agentsSessionChatFilter=""
	{
		printf '%s\n' "${agentsSessionChatNewest:-}"
		for probeSeen in ${agentsSessionChatSeen:-} ; do printf 'seen %s\n' "$probeSeen" ; done
	} > "$probeOut.newest"
	return 0
}
## Moves the member's pointer to what a look at the file read, once the wait has said it (the file holds the number on its first
## line, and a line `seen <n>` for each block the call delivered beyond it, to be marked delivered to the member).
AgentsWaitChatCommit(){ ## session, member, the file holding the number
	local commitNewest="" commitLine commitSeen=""
	[ -f "$3" ] && IFS= read -r commitNewest < "$3" || return 0
	case "$commitNewest" in ''|*[!0123456789]*) return 0 ;; esac
	AgentsToolsSessionChatPointerSet "$1" "read:$2" "$commitNewest" max
	while IFS= read -r commitLine ; do
		case "$commitLine" in "seen "[0123456789]*) commitSeen="$commitSeen${commitLine#seen } " ;; esac
	done < "$3"
	[ -z "$commitSeen" ] || AgentsToolsSessionChatSeen "$1" "$2" $commitSeen
	return 0
}

## A SCAN AS A SOURCE (F3.3): `scan:<scan>`, one of the scans of the tooling (AgentsToolsInputScanNames) for the tooling's own
## use -- a tool or a routine run that waits on a scan, as AskQuestion adds an ask to a set. No member is taught it (F6.4) and the
## default set holds none. The scan runs afresh at each pass that is past its TTL of the table (AgentsToolsSourceTtlOf) -- or at
## once on a pass the member's wake marker brought forward, so a message the scan would report is not behind that TTL: the table's
## 300 is how long an UNCHANGED scan is left to stand, never how late a message may be (THE SCAN IS WOKEN AND NOT ON ITS TTL) --,
## and its report is the one the scan returned; the Wait wakes when the report differs from the one this session was last given
## (the pointer `scan:<scan>:<member>` of session.chat.pointers, kept once a wait has returned it; with no session, the one an
## earlier pass of the same call saw), and the first time with the report it has.
AgentsWaitProbeScan(){
	local probeMember="$1" probeScan="$2" probeOut="$4" probeKept probeSum probeKey probeStored=""
	type AgentsToolsInputScanNames > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.InputScanDef.include" 2> /dev/null || return 2
	AgentsToolsInputScanNames | LC_ALL=C grep -q -x -- "$probeScan" || return 2
	DistroAgentsTools "--intern-op-$probeScan-input-scan" "$probeMember" > "$probeOut.reply" 2> "$probeOut.err" || {
		[ ! -s "$probeOut.err" ] || cat "$probeOut.err" >&2
		return 2
	}
	AgentsWaitOwnFile "$probeOut.reply" || return 2
	## MDAT_SCAN_TRACE=1 on the wait: the seconds each section of the scan took, which the scan wrote to its stderr, are said on this one.
	[ -z "${MDAT_SCAN_TRACE:-}" ] || LC_ALL=C grep '^scan-trace: ' "$probeOut.err" >&2 || :
	## A report kept for the session is named by the reply (AgentsTranscriptReplyRef); the report is what that file holds.
	probeKept="$( LC_ALL=C sed -n 's/^\.\.\. KEPT: .* is in \(.*\) -- .*\.\.\.$/\1/p' "$probeOut.reply" | head -1 )"
	if [ -n "$probeKept" ] && [ -f "$probeKept" ] ; then
		cat "$probeKept" > "$probeOut.report" 2> /dev/null || return 2
	else
		cp "$probeOut.reply" "$probeOut.report" 2> /dev/null || return 2
	fi
	## THE SUM IS OF THE REPORT LESS ITS TOKEN COUNTERS. The board sections of a scan print the `tokens:` and `tokens-total:` lines of
	## every running item, the session's own dispatch item among them, and the harness rewrites those at every model round: summed whole,
	## the report differed at every wait and the wait never idled. Only a line of exactly the counters' own shape is left out
	## (AgentsSessionTokensRollupText); the report returned is whole.
	probeSum="$( LC_ALL=C awk '/^tokens(-total)?: in=[0-9]+ cache-read=[0-9]+ cache-write=[0-9]+ out=[0-9]+( \(incl\. [0-9]+ sub-sessions?\))?$/ { next ; } { print ; }' "$probeOut.report" | LC_ALL=C cksum | LC_ALL=C awk '{ print $1 "-" $2 ; }' )"
	type AgentsToolsSessionChatKey > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionChat.include" 2> /dev/null || :
	probeKey="$( AgentsToolsSessionChatKey 2> /dev/null )" || probeKey=""
	if [ -n "$probeKey" ] ; then
		probeStored="$( AgentsToolsSessionChatPointer "$probeKey" "scan:$probeScan:$probeMember" 2> /dev/null )" || probeStored=""
	elif [ -f "$probeOut.stored" ] ; then
		IFS= read -r probeStored < "$probeOut.stored" || :
	fi
	: > "$probeOut" || return 2
	if [ "$probeSum" != "$probeStored" ] ; then
		cp "$probeOut.report" "$probeOut" 2> /dev/null || return 2
		printf '%s\n' "$probeSum" > "$probeOut.sum"
		## With no session to keep it in, the report this call has returned is kept for its later passes.
		[ -n "$probeKey" ] || cp "$probeOut.sum" "$probeOut.stored" 2> /dev/null || :
	fi
	return 0
}
## Keeps the report a wait has returned as the one the session was last given.
AgentsWaitScanCommit(){ ## member, scan, the file holding the report's sum
	local commitSum="" commitKey
	[ -f "$3" ] && IFS= read -r commitSum < "$3" || return 0
	[ -n "$commitSum" ] || return 0
	type AgentsToolsSessionChatKey > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionChat.include" 2> /dev/null || return 0
	commitKey="$( AgentsToolsSessionChatKey 2> /dev/null )" || commitKey=""
	[ -z "$commitKey" ] || AgentsToolsSessionChatPointerSet "$commitKey" "scan:$2:$1" "$commitSum"
	return 0
}

## THE MENTIONS (sketch 3.2): `mentions:<member>`, a mention of the member in any conversation, thread replies included, by ONE
## search.messages call from the session's pointer of the source (`mentions:<member>`, the newest mention returned). Its TTL holds
## across Wait calls: the session keeps when it was last checked (`mentions-checked:<member>`), and a check inside the TTL reads
## nothing, so a Wait start never calls it unless the TTL has run out. A member with a Slack account is searched for its `<@id>`;
## one with none, by text, for `@<member>`. The call is made with the member's own user token where it may search, else with the
## team identity that may: the magic-team setting WAIT_MENTIONS_SEARCHER, magic-coordinator where it is not set. Where neither may,
## the source is unreadable, said on stderr and in the Wait header (WAIT-NEVER-READ), never an empty result. Each mention stands
## behind a `# in <conversation>` line, so the seen reaction finds its conversation (AgentsWaitSeenIds).
AgentsWaitProbeMentions(){
	local probeMember="$1" probeTarget="$2" probeFloor="$3" probeOut="$4" probeKey="" probeNow probeChecked="" probeTtl probePointer="" probeId probeQuery probeAfter probeJson probeRc=1 probeAs probeErr="" probeStored=""
	[ "$probeTarget" = "$probeMember" ] || return 2
	: > "$probeOut" || return 2
	rm -f "$probeOut.newest"
	type AgentsToolsSessionChatKey > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionChat.include" 2> /dev/null || return 2
	probeKey="$( AgentsToolsSessionChatKey 2> /dev/null )" || probeKey=""
	[ -n "$probeKey" ] && [ -d "$MMDAPP/.local/agents/sessions/$probeKey" ] || probeKey=""
	probeNow="$( date +%s )"
	probeTtl="$( AgentsWaitTtlOf "mentions:$probeMember" )"
	## The TTL across calls: a check inside it is no check now.
	if [ -n "$probeKey" ] ; then
		probeChecked="$( AgentsToolsSessionChatPointer "$probeKey" "mentions-checked:$probeMember" 2> /dev/null )" || probeChecked=""
	else
		{ IFS= read -r probeChecked < "$probeOut.checked" ; } 2> /dev/null || probeChecked=""
	fi
	case "$probeChecked" in ''|*[!0123456789]*) probeChecked=0 ;; esac
	[ $(( probeNow - probeChecked )) -ge "$probeTtl" ] || return 0
	if [ -n "$probeKey" ] ; then
		AgentsToolsSessionChatPointerSet "$probeKey" "mentions-checked:$probeMember" "$probeNow" 2> /dev/null || :
	else
		printf '%s\n' "$probeNow" > "$probeOut.checked" 2> /dev/null || :
	fi
	## From the pointer, else the wait's floor, else now: a first check returns no backlog.
	if [ -n "$probeKey" ] ; then
		probeStored="$( AgentsToolsSessionChatPointer "$probeKey" "mentions:$probeMember" 2> /dev/null )" || probeStored=""
	else
		{ IFS= read -r probeStored < "$probeOut.pointer" ; } 2> /dev/null || probeStored=""
	fi
	probePointer="${probeStored:-${probeFloor:-$probeNow.000000}}"
	case "$probePointer" in ''|*[!0123456789.]*) probePointer="$probeNow.000000" ;; esac
	local probeSearcher=""
	probeSearcher="$( DistroAgentsTools --agents-config-option magic-team --select WAIT_MENTIONS_SEARCHER 2> /dev/null )" || probeSearcher=""
	AgentsToolsAssertBareName "${probeSearcher:-magic-coordinator}" WAIT_MENTIONS_SEARCHER mentions > /dev/null 2>&1 || probeSearcher=""
	probeSearcher="${probeSearcher:-magic-coordinator}"
	probeId="$( AgentsToolsSessionChatMemberId "$probeMember" 2> /dev/null )" || probeId=""
	if [ -n "$probeId" ] ; then probeQuery="<@$probeId>" ; else probeQuery="\"@$probeMember\"" ; fi
	probeAfter="$( printf '%s\n' "$(( ${probePointer%%.*} - 86400 ))" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/output/LocalEpochToIsoDate.awk" 2> /dev/null )" || probeAfter=""
	## ONE call that answers: the member's own user token, else the team identity that may search.
	for probeAs in "$probeMember" "$probeSearcher" ; do
		probeRc=0
		probeJson="$( DistroAgentsTools --intern-op-slack-call "$probeAs" --api search.messages --identity user \
			--form "query=$probeQuery${probeAfter:+ after:$probeAfter}" --form sort=timestamp --form sort_dir=desc --form count=100 \
			--context "wait: the mentions of $probeMember" 2> "$probeOut.err" )" || probeRc=$?
		if [ "$probeRc" = 0 ] ; then
			printf '%s\n' "$probeJson" | LC_ALL=C awk -v cutoff="$probePointer" -v channelMark=1 \
				-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsSlackSearchMatches.awk" > "$probeOut.found" 2>> "$probeOut.err" || probeRc=$?
			case "$probeRc" in 0|3) break ;; esac
		fi
		probeErr="$probeErr${probeErr:+; }$probeAs: $( LC_ALL=C grep -m 1 -o -E 'missing_scope|not_allowed_token_type|invalid_auth|not_authed|no (SLACK_USER_TOKEN|user token)[^.]*' "$probeOut.err" 2> /dev/null || printf 'the search was refused' )"
		[ "$probeAs" != "$probeSearcher" ] && [ "$probeMember" != "$probeSearcher" ] || break
	done
	case "$probeRc" in
		0|3) ;;
		*)
			echo "⛔ ERROR: mentions:$probeMember: no identity may search its mentions (search.messages needs a user token with search:read) -- $probeErr. This is NOT an empty result: its mentions are unknown." >&2
			return 2
		;;
	esac
	## Strictly newer than the pointer: the one returned last is not returned again. The conversation of each goes on a `# in` line before it.
	LC_ALL=C awk -v after="$probePointer" '
		match( $0, /^[0-9]+\.[0-9]+ \| / ) {
			split( $0, head, " " ) ; keep = ( head[1] + 0 > after + 0 )
			if ( keep && match( $0, / \[in [A-Z0-9]+\]/ ) ) {
				where = substr( $0, RSTART + 5, RLENGTH - 6 ) ; $0 = substr( $0, 1, RSTART - 1 ) substr( $0, RSTART + RLENGTH )
				if ( where != last ) { print "# in " where ; last = where }
			}
		}
		keep { print }' "$probeOut.found" > "$probeOut" 2> /dev/null || return 2
	AgentsWaitOwnFile "$probeOut" || return 2
	LC_ALL=C awk '/^[0-9]+\.[0-9]+ \| / { ts = $1 } END { if ( ts != "" ) print ts }' "$probeOut" > "$probeOut.newest" 2> /dev/null || :
	return 0
}
## Keeps the newest mention a wait has returned as the session's pointer of the source (else the call's own, with no session).
AgentsWaitMentionsCommit(){ ## member, the file holding the newest ts
	local commitTs="" commitKey
	[ -f "$2" ] && IFS= read -r commitTs < "$2" || return 0
	[ -n "$commitTs" ] || return 0
	type AgentsToolsSessionChatKey > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionChat.include" 2> /dev/null || return 0
	commitKey="$( AgentsToolsSessionChatKey 2> /dev/null )" || commitKey=""
	if [ -n "$commitKey" ] && [ -d "$MMDAPP/.local/agents/sessions/$commitKey" ] ; then
		AgentsToolsSessionChatPointerSet "$commitKey" "mentions:$1" "$commitTs"
	else
		printf '%s\n' "$commitTs" > "${2%.newest}.pointer" 2> /dev/null || :
	fi
	return 0
}

## THE TAGS, for a collect (F4.1): `tagged:<member>`, what is for the member by name -- a mention of it in the team channel or in
## its session thread, and any message of any DM -- from the floor forward. Each part behind a `# in <where>` line. It is
## immediate: in a collect an arrival here ends the window. A part that cannot be read is said on stderr; the source is
## unreadable only where every part was. A message of a session thread where the member's instance is present is no work: it is
## returned for knowledge only, its rows marked FYI, which no duty takes as an item (AgentsWaitTaggedPart,
## AgentsToolsInputScanReportEmpty in AgentsTools.InputScanDef.include).
AgentsWaitProbeTagged(){
	local probeMember="$1" probeTarget="$2" probeFloor="$3" probeOut="$4" probeParts=0 probeFailed=0 probeThread probeSession probeRoster probeLine probeConv probeKind probeIdentity probeParty probeIdentArg probeSeenConvs="" probeFyi=""
	[ "$probeTarget" = "$probeMember" ] || return 2
	: > "$probeOut" || return 2
	type AgentsToolsSessionChatThread > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionChat.include" 2> /dev/null || return 2
	## The team channel: a message that mentions the member. Where another source of this wait reads the team channel, it shows the
	## message among the rest, once: this source then says only that it is tagged there, which is what ends a collect.
	local probeTeamChannel probeShown=0
	[ "$agentsWaitCovered" != "?" ] || agentsWaitCovered="$( AgentsWaitCoveredSet "$probeMember" $agentsWaitCoverSources )"
	type DistroAgentsToolsResolveTarget > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.CommsSlack.include" 2> /dev/null || :
	probeTeamChannel="$( DistroAgentsToolsResolveTarget magic-team "$probeMember" 2> /dev/null | LC_ALL=C sed -n 's/^CHANNEL=//p' )" || probeTeamChannel=""
	case " $agentsWaitCovered " in *" $probeTeamChannel "*) [ -z "$probeTeamChannel" ] || probeShown=1 ;; esac
	probeParts=$(( probeParts + 1 ))
	if AgentsWaitReadRendered "$probeMember" magic-team conversation "$probeFloor" "$probeOut.team" ; then
		AgentsWaitTaggedPart "$probeMember" "magic-team" mentions "$probeFloor" "$probeOut.team" "$probeOut" "$probeShown" || probeFailed=$(( probeFailed + 1 ))
	else
		probeFailed=$(( probeFailed + 1 ))
	fi
	## The session thread: a message that mentions the member. A session thread where the member's own instance is present is
	## no work for a duty: its instance reads that thread itself, and the run reads it as its own chat. Those messages are
	## returned for knowledge only, every row marked FYI (AgentsWaitTaggedPart), and no duty acts on them.
	probeSession="$( AgentsToolsSessionChatKey )"
	probeThread=""
	[ -z "$probeSession" ] || probeThread="$( AgentsToolsSessionChatThread "$probeSession" )" || probeThread=""
	if [ -n "$probeThread" ] ; then
		probeParts=$(( probeParts + 1 ))
		if AgentsWaitReadRendered "$probeMember" "$probeThread" thread "" "$probeOut.session" ; then
			probeFyi=""
			type AgentsToolsSessionMemberPresent > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SpawnSandbox.include" 2> /dev/null || :
			AgentsToolsSessionMemberPresent "$probeSession" "$probeMember" 2> /dev/null && probeFyi="the session chat thread of $probeMember's instance"
			AgentsWaitTaggedPart "$probeMember" "$probeThread" mentions "$probeFloor" "$probeOut.session" "$probeOut" "" "$probeFyi" || probeFailed=$(( probeFailed + 1 ))
		else
			probeFailed=$(( probeFailed + 1 ))
		fi
	fi
	## Every DM: nobody mentions anyone in a direct conversation, so a message there is for the member by being there.
	type AgentsToolsCommsSlackConversationsRoster > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/magic/AgentsTools.MagicComms.include" 2> /dev/null || :
	probeParts=$(( probeParts + 1 ))
	## A roster one identity could not list is a partial one, used for what it names (the context scan's rule): only an empty answer is a failure.
	probeRoster="$( AgentsToolsCommsSlackConversationsRoster "$probeMember" --types im,mpim 2> /dev/null )" || :
	if [ -n "$probeRoster" ] ; then
		while IFS= read -r probeLine ; do
			case "$probeLine" in "CONV|"*) ;; *) continue ;; esac
			probeConv="" probeKind="" probeIdentity="" probeParty=""
			for probeIdentArg in $( printf '%s\n' "$probeLine" | LC_ALL=C tr '|' ' ' ) ; do
				case "$probeIdentArg" in
					id=*) probeConv="${probeIdentArg#id=}" ;;
					kind=*) probeKind="${probeIdentArg#kind=}" ;;
					identity=*) probeIdentity="${probeIdentArg#identity=}" ;;
					counterparty=*) probeParty="${probeIdentArg#counterparty=}" ;;
				esac
			done
			[ -n "$probeConv" ] || continue
			case "$probeKind" in im|mpim) ;; *) continue ;; esac
			## A DM both identities list is read once, under the first.
			case " $probeSeenConvs " in *" $probeConv "*) continue ;; esac
			probeSeenConvs="$probeSeenConvs $probeConv"
			if MDAT_WAIT_READ_AS_BOT="$( [ "$probeIdentity" = "bot" ] && printf true )" AgentsWaitReadRendered "$probeMember" "$probeConv" conversation "$probeFloor" "$probeOut.dm" ; then
				AgentsWaitTaggedPart "$probeMember" "$probeConv" "$probeParty" "$probeFloor" "$probeOut.dm" "$probeOut" || probeFailed=$(( probeFailed + 1 ))
			else
				probeFailed=$(( probeFailed + 1 ))
			fi
		done <<< "$probeRoster"
	else
		probeFailed=$(( probeFailed + 1 ))
	fi
	## A client-* member: the human-owner conversations its own scope names on the other organisation's side are its DMs there.
	local probeClientConvs="" probeClientConv
	case "$probeMember" in client-*) probeClientConvs="$( DistroAgentsTools --agents-config-option "$probeMember" --select SLACK_CHANNEL_HUMAN_OWNER 2> /dev/null )" || probeClientConvs="" ;; esac
	for probeClientConv in ${probeClientConvs//,/ } ; do
		probeParts=$(( probeParts + 1 ))
		if AgentsWaitReadRendered "$probeMember" "client:$probeClientConv" conversation "$probeFloor" "$probeOut.client" ; then
			AgentsWaitTaggedPart "$probeMember" "client:$probeClientConv" "" "$probeFloor" "$probeOut.client" "$probeOut" || probeFailed=$(( probeFailed + 1 ))
		else
			probeFailed=$(( probeFailed + 1 ))
		fi
	done
	AgentsWaitOwnFile "$probeOut" || return 2
	[ "$probeFailed" -lt "$probeParts" ] || return 2
	return 0
}
## One part of the tags: the lines of a rendering that are for the member, after the floor, appended to the rendering behind a
## `# in <where>` line. <what> is `mentions` (the messages that mention the member) or the Slack account of the other party of a DM.
## With a seventh word of 1 the messages are shown elsewhere, and only the fact is said here. An eighth word is the FYI note of a
## part that is for the member's knowledge only -- a session thread where its own instance is present: each row of it carries
## `[fyi: <note>]` in its head line, right after the sender, and a `# fyi: <note> -- for your knowledge, not yours to answer` line
## stands before the part. That mark is what a reader of the rows (AgentsToolsInputScanReportEmpty) tells a message of no work by.
AgentsWaitTaggedPart(){ ## member, where, what, floor, the rendering, the tags rendering, [shown elsewhere], [the FYI note]
	local partOut="$6.part"
	LC_ALL=C awk -v mode=channel -v postTs=0 -v floorTs="${4:-0}" -v callerName="$1" -v callerId="$( AgentsToolsSessionChatMemberId "$1" )" -v addressees="$( [ "$3" = mentions ] || printf '%s' "$3" )" \
		-v siblings=0 -v siblingsMax=1000000 -v mentionsOnly="$( [ "$3" = mentions ] && printf 1 || printf 0 )" -v side="$partOut.side" \
		-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsDismissalMatch.awk" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsWaitOwnPostReplies.awk" \
		< "$5" > "$partOut" 2> /dev/null || return 1
	AgentsWaitOwnFile "$partOut" || return 1
	if [ -s "$partOut" ] && [ -n "${8:-}" ] ; then
		LC_ALL=C awk -v mark="[fyi: ${8}]" '
			match( $0, /^[0-9]+\.[0-9]+ \| [^|]*\|/ ) { $0 = substr( $0, 1, RSTART + RLENGTH - 1 ) mark substr( $0, RSTART + RLENGTH ) ; }
			{ print }' "$partOut" > "$partOut.fyi" && mv -f "$partOut.fyi" "$partOut" || return 1
	fi
	if [ -s "$partOut" ] ; then
		if [ -n "${8:-}" ] ; then
			printf '# fyi: %s -- for your knowledge, not yours to answer\n' "${8}" >> "$6" || return 1
		fi
		if [ "${7:-0}" = "1" ] ; then
			## Shown by the source that reads the conversation. The ts of the newest is kept, for the pointer, as a head line would be.
			printf '# in %s: tagged there, and shown among its messages under the source that reads it\n' "$2" >> "$6" || return 1
			LC_ALL=C awk '/^[0-9]+\.[0-9]+ \| / { ts = $1 ; } END { if ( ts != "" ) { print ts " | tagged | (see the source that reads this conversation)" ; } }' "$partOut" >> "$6" || return 1
		else
			{ printf '# in %s\n' "$2" ; cat "$partOut" ; } >> "$6" || return 1
		fi
	fi
	return 0
}

## `slack` -> `AgentsWaitProbeSlack`, without ${var^} -- bash 3.2 has no such
## expansion, and this package targets it.
AgentsWaitProbeFunctionName(){
	local nameKind="$1" nameHead nameTail
	nameHead="$( printf '%s' "$nameKind" | cut -c1 | tr '[:lower:]' '[:upper:]' )"
	nameTail="$( printf '%s' "$nameKind" | cut -c2- )"
	printf 'AgentsWaitProbe%s%s' "$nameHead" "$nameTail"
}

## THE BACKOFF IS MEASURED FROM THE NEWEST ACTIVITY on what a wait watches, never from
## when the call started alone: in a long call, a question asked an hour in must still be
## watched closely. The newest of: the call start; the floor of each Slack source (the last
## message a wait returned there, or the since given); each watched question's own ts and
## follow floor; and the session's own latest post (last-own-post), where a watched source
## would carry its reply -- that thread, an ask's thread, or a whole conversation. Prints
## "<epoch seconds>\t<what>", <what> one of start, floor, question, own-post.
AgentsWaitNewestActivity(){ ## call start (epoch), session id, sources, floors used ("<source>=<ts> ...")
	local actBest="$1" actWhat="start" actOne actSource actLine actOwn="" actOwnWhere="" actOwnTs="" actOwnSeen=""
	local actChannel actThread actQts actFollow actRecord
	for actOne in $4 ; do
		actOne="${actOne##*=}" ; actOne="${actOne%%.*}"
		case "$actOne" in ''|*[!0-9]*) continue ;; esac
		[ "$actOne" -le "$actBest" ] || { actBest="$actOne" ; actWhat="floor" ; }
	done
	if [ -n "$2" ] && [ -f "$MMDAPP/.local/agents/sessions/$2/last-own-post" ] ; then
		IFS= read -r actOwn < "$MMDAPP/.local/agents/sessions/$2/last-own-post" || :
		## The record's first line is its latest post, and its first two words are the thread and the ts.
		actOwnWhere="${actOwn%% *}" ; actOwnTs="${actOwn#* }" ; actOwnTs="${actOwnTs%% *}" ; actOwnTs="${actOwnTs%%.*}"
		case "$actOwnTs" in ''|*[!0-9]*) actOwnTs="" ;; esac
	fi
	for actSource in $3 ; do
		## Here and below, a slack source's shape is read past a client: marker.
		case "${actSource/#slack:client:/slack:}" in
			slack:*:*:conversation) actOne="${actSource#slack:}" ; [ "${actOne%:conversation}" != "$actOwnWhere" ] || actOwnSeen=1 ;;
			slack:*:*) [ "${actSource#slack:}" != "$actOwnWhere" ] || actOwnSeen=1 ;;
			slack:*) actOwnSeen=1 ;;
			## The replies to the run's own posts carry the reply to any of them.
			replies:*) actOwnSeen=1 ;;
			ask:*)
				actRecord="$MMDAPP/.local/agents/pending/${actSource#ask:}.md"
				[ -f "$actRecord" ] || actRecord="$MMDAPP/.local/agents/pending/closed/${actSource#ask:}.md"
				[ -f "$actRecord" ] || continue
				actChannel="" actThread="" actQts="" actFollow=""
				while IFS= read -r actLine ; do
					case "$actLine" in
						'channel: '*) actChannel="${actLine#channel: }" ;;
						'thread-ts: '*) actThread="${actLine#thread-ts: }" ;;
						'question-ts: '*) actQts="${actLine#question-ts: }" ;;
						'follow-floor: '*) actFollow="${actLine#follow-floor: }" ;;
						'# '*) break ;;
					esac
				done < "$actRecord"
				[ "$actChannel:$actThread" != "$actOwnWhere" ] || actOwnSeen=1
				for actOne in "$actQts" "$actFollow" ; do
					actOne="${actOne%%.*}"
					case "$actOne" in ''|*[!0-9]*) continue ;; esac
					[ "$actOne" -le "$actBest" ] || { actBest="$actOne" ; actWhat="question" ; }
				done
			;;
		esac
	done
	if [ -n "$actOwnSeen" ] && [ -n "$actOwnTs" ] && [ "$actOwnTs" -gt "$actBest" ] ; then
		actBest="$actOwnTs" ; actWhat="own-post"
	fi
	printf '%s\t%s\n' "$actBest" "$actWhat"
}

## One nap of the default backoff, in seconds: 5, plus 1 for every 20 since the newest
## activity, capped at 300 -- the formula and cap as ever, only its base is the activity.
AgentsWaitBackoffNap(){ ## now (epoch), newest activity (epoch)
	local napSeconds=5
	[ "$1" -le "$2" ] || napSeconds=$(( 5 + ( $1 - $2 ) / 20 ))
	[ "$napSeconds" -le 300 ] || napSeconds=300
	printf '%s\n' "$napSeconds"
}

## THE REMINDERS OF A WAIT. An ask still waiting on a person is reminded on its schedule
## (30 minutes, 2 hours, then daily: AgentsTools.PendingReplyRemind.include) by the wait that
## stands for it, so it is reminded while a member waits and no main loop runs: the asks the
## wait watches (its ask:<pending-id> sources) and every open ask of its coworking session,
## whoever of that session asked it. The record's own stamps make a repeat send nothing, so
## this and the main loop's run send one reminder for a stage. A wait that reads a thread
## for a reminder run (agentsPendingReplyRemindRunning, set by that run) starts none itself.
## In a subshell, and it fails nothing here: what a run did is said on stderr, each line once
## a call, and a run that could not start is said there too. MDAT_WAIT_REMIND=off switches
## it off for a call: the test runner sets it for every test (sh-test/AgentsRunTests.sh).
AgentsWaitRemind(){ ## session id (may be empty), sources, the wait's working directory
	local remindLine
	[ "${MDAT_WAIT_REMIND:-}" != "off" ] || return 0
	[ -z "${agentsPendingReplyRemindRunning:-}" ] || return 0
	[ -n "$1" ] || case " $2" in *" ask:"*) ;; *) return 0 ;; esac
	(
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.PendingReplyCollect.include"
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.PendingReplyRemind.include"
		AgentsToolsPendingReplyRemindWaitRun "$1" "$2"
	) > "$3/remind.out" 2> /dev/null || {
		echo "# --wait-for-input: the reminders of this wait could not run" >&2
		return 0
	}
	while IFS= read -r remindLine ; do
		case "$remindLine" in
			'REMINDED '*|'FAILED '*|'SKIPPED '*|'HELD '*) ;;
			*) continue ;;
		esac
		LC_ALL=C grep -q -x -F -- "$remindLine" "$3/remind.said" 2> /dev/null && continue
		printf '%s\n' "$remindLine" >> "$3/remind.said"
		echo "# --wait-for-input: $remindLine" >&2
	done < "$3/remind.out"
	return 0
}

## THE WORKING DIRECTORY OF A WAIT, AND WHOSE IT IS. Every wait makes one of its own (mktemp,
## below) and removes it as it ends, and nothing else removes it while that wait lives. A wait
## that was killed leaves its directory behind, so the next wait of that member sweeps on its
## way in: by whose a directory is, never by how old it looks. A directory holds `owner`, the
## host and the process its wait runs in with when that process began, as the one reading of
## that gives it (AgentsToolsRegistryProcessesBegan), and it goes only once that process is no
## process of this host any more; the same pid begun at another time is another process. So a
## wait that stands for days keeps its directory, and so do several waits of one member at
## once, in as many sessions. A directory another host made is never touched, and none is
## while the process list cannot be read: this shell is a process, and a reading that does not
## hold it read nothing. One with no whole record was made before records were kept, or is
## being made this instant: it goes once it stood a day untouched, its age taken from its own
## modification time and compared here, never by a -mtime of find, which one find rounds up
## to whole days and another down.
## A directory its wait kept for whoever looks into it (`kept`, AgentsWaitLost below) stands that
## same day, whoever owned it.
AgentsWaitFolderSweep(){ ## member -- keeps this shell's own `<pid> <start>` for the record (agentsWaitFolderShell)
	local sweepDir sweepOwner sweepHere sweepSelf sweepBegan sweepNow sweepAged sweepList=""
	agentsWaitFolderShell=""
	type AgentsToolsRegistryProcessesBegan > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.Registries.include" 2> /dev/null || return 0
	sweepHere="$( hostname -s 2>/dev/null )" || sweepHere="unknown"
	## This shell's own process, which `$$` does not name in a subshell: what a command it starts has as its parent.
	sweepSelf="$( exec sh -c 'echo "$PPID"' 2> /dev/null )" || sweepSelf=""
	case "$sweepSelf" in ''|*[!0123456789]*) return 0 ;; esac
	sweepNow="$( date +%s )"
	for sweepDir in "$MMDAPP/.local/temp/mdat-member-wait.$1."* ; do
		[ -d "$sweepDir" ] && [ ! -L "$sweepDir" ] || continue
		sweepOwner="$( LC_ALL=C awk '
			index( $0, "host: " ) == 1 { ownerHost = substr( $0, 7 ) ; }
			index( $0, "process: " ) == 1 { ownerProcess = substr( $0, 10 ) ; }
			END { if ( ownerHost != "" && ownerProcess ~ /^[0-9]+ [^ ]+$/ ) { print ownerHost "\t" ownerProcess ; } }
		' "$sweepDir/owner" 2>/dev/null )" || sweepOwner=""
		[ ! -f "$sweepDir/kept" ] || sweepOwner=""
		if [ -z "$sweepOwner" ] ; then
			sweepAged="$( stat -c %Y "$sweepDir" 2>/dev/null || stat -f %m "$sweepDir" 2>/dev/null )" || sweepAged=""
			case "$sweepAged" in ''|*[!0123456789]*) continue ;; esac
			[ $(( sweepNow - sweepAged )) -lt 86400 ] || rm -rf "$sweepDir" 2>/dev/null || true
			continue
		fi
		[ "${sweepOwner%%$'\t'*}" = "$sweepHere" ] || continue
		sweepList="$sweepList${sweepOwner#*$'\t'}"$'\t'"$sweepDir"$'\n'
	done
	sweepBegan="$( { printf '%s\n' "$sweepSelf" ; printf '%s' "$sweepList" | LC_ALL=C awk '{ print $1 ; }' ; } | AgentsToolsRegistryProcessesBegan )" || sweepBegan=""
	agentsWaitFolderShell="$( printf '%s\n' "$sweepBegan" | LC_ALL=C awk -v selfPid="$sweepSelf" '$1 == selfPid { print ; exit ; }' )" || agentsWaitFolderShell=""
	[ -n "$agentsWaitFolderShell" ] || return 0
	printf '%s' "$sweepList" | while IFS=$'\t' read -r sweepOwner sweepDir ; do
		case $'\n'"$sweepBegan"$'\n' in *$'\n'"$sweepOwner"$'\n'*) continue ;; esac
		rm -rf "$sweepDir" 2>/dev/null || true
	done
	return 0
}
## The record the sweep reads, written by the wait into the directory it just made. A shell the
## process list did not give keeps no process there: its directory is then one with no whole record.
AgentsWaitFolderOwn(){ ## the working directory
	local ownHere
	ownHere="$( hostname -s 2>/dev/null )" || ownHere="unknown"
	printf 'host: %s\nprocess: %s\n' "$ownHere" "${agentsWaitFolderShell:-}" > "$1/owner"
}
## WHAT A STEP OF A WAIT WROTE IS THERE WHEN THE NEXT STEP READS IT. Where it is not -- the
## directory was taken from under the wait, or one file of it was -- the wait cannot tell an
## arrival from nothing: a rendering that is not there differs from every baseline, and was
## returned as RECEIVED with nothing in it, or its probes failed round after round and the
## wait stood deaf to its bound. So a step notes the first file it misses (AgentsWaitOwnFile),
## and the wait ends at once on WAIT-RESULT: ERROR and one line that names it. Nothing that
## arrived is taken as read by that: no floor moved, and the next wait reads from the same
## place. A directory that still stands is not removed then: it is kept as it stands, with
## `kept` saying what was missed and when, and its path is in that line.
AgentsWaitOwnFile(){ ## a file a step of this wait wrote -- rc 0 while it is there
	[ ! -f "$1" ] || return 0
	agentsWaitLost="${agentsWaitLost:-$1}"
	return 1
}
AgentsWaitLost(){ ## the working directory -- rc 0 once it, or a file a step noted, is not there
	[ -d "$1" ] || agentsWaitLost="$1"
	[ -n "${agentsWaitLost:-}" ]
}

case "$1" in

	## The member stub. A wait reads and reacts under the named member's own credentials, so
	## a spawned session names only itself; tooling calls --intern-op-wait-for-input directly.
	--wait-for-input)
		if [ -n "${2:-}" ] && ! AgentsToolsActingMemberCheck "$2" wait-for-input ; then
			echo "WAIT-RESULT: ERROR"
			set +e ; return 1
		fi
		DistroAgentsTools --intern-op-wait-for-input "${@:2}"
		return $?
	;;

	--intern-op-wait-for-input)
		shift
		local memberName="$1"
		shift || true
		if [ -z "$memberName" ] ; then
			echo "WAIT-RESULT: ERROR"
			echo "⛔ ERROR: $MDSC_CMD --wait-for-input: <team-member> missing" >&2
			set +e ; return 1
		fi
		case "$memberName" in
			--*)
				echo "WAIT-RESULT: ERROR"
				echo "⛔ ERROR: $MDSC_CMD --wait-for-input: <team-member> comes first, ahead of every flag, and '$memberName' is a flag. Nothing was waited on." >&2
				set +e ; return 1
			;;
		esac
		AgentsToolsAssertBareName "$memberName" "<team-member>" wait-for-input || {
			echo "WAIT-RESULT: ERROR"
			set +e ; return 1
		}

		## A run that holds the lock of its routine keeps it held while it waits (AgentsToolsRoutineLockRefreshOwn): the record of the run is looked at first,
		## and the lock code loaded only for a run that holds one.
		if [ -n "${MDAT_SPAWN_SESSION_ID:-}" ] && LC_ALL=C grep -q -s '^routine-lock: ' "${MMDAPP%/}"/.local/agents/spawned/*/"$MDAT_SPAWN_SESSION_ID.spawn.md" 2> /dev/null ; then
			type AgentsToolsRoutineLockRefreshOwn > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/magic/AgentsTools.RoutineLock.include" 2> /dev/null || :
			! type AgentsToolsRoutineLockRefreshOwn > /dev/null 2>&1 || AgentsToolsRoutineLockRefreshOwn "$MDAT_SPAWN_SESSION_ID" || :
		fi
		local waitSources="" waitTimeout="" waitPoll="" waitSince="" waitListOnly="false" waitAddressee="" waitIncludeOwn="false" waitCollect="" waitModes=" "
		local waitMode="" waitSessionId="" waitReactions="" waitFloors="" reactWord
		while [ $# -gt 0 ] ; do
			case "$1" in
				--wait-default|--wait-continue|--wait-close|--wait-add|--wait-drop)
					if [ -n "$waitMode" ] ; then
						echo "WAIT-RESULT: ERROR"
						echo "⛔ ERROR: $MDSC_CMD --wait-for-input: modes are mutually exclusive, and this call names --wait-$waitMode and $1. Nothing was waited on." >&2
						set +e ; return 1
					fi
					waitMode="${1#--wait-}"
					shift
				;;
				## One flag, its source inline -- the named shorthand for --wait-drop --wait-source
				## <source>, nothing more. Dropping from the stored set is not blocking it: naming
				## the same source again, explicitly, on a later call is unaffected by this.
				--unwait)
					if [ -n "$waitMode" ] ; then
						echo "WAIT-RESULT: ERROR"
						echo "⛔ ERROR: $MDSC_CMD --wait-for-input: modes are mutually exclusive, and this call names --wait-$waitMode and --unwait. Nothing was waited on." >&2
						set +e ; return 1
					fi
					if [ -z "${2:-}" ] ; then
						echo "WAIT-RESULT: ERROR"
						echo "⛔ ERROR: $MDSC_CMD --wait-for-input: --unwait: value required (<kind>:<target> to drop from the stored wait)" >&2
						set +e ; return 1
					fi
					waitMode="drop"
					waitSources="$waitSources${2%%#*} "
					shift 2
				;;
				--wait-session-id)
					if [ -z "${2:-}" ] ; then
						echo "WAIT-RESULT: ERROR"
						echo "⛔ ERROR: $MDSC_CMD --wait-for-input: --wait-session-id: value required" >&2
						set +e ; return 1
					fi
					waitSessionId="$2"
					shift 2
				;;
				## Each id is kept as <set>=<id>, and gated byte-wise here before it can reach a command line.
				--wait-react-seen|--wait-react-note|--wait-react-done|--wait-react-wait)
					if [ -z "${2:-}" ] ; then
						echo "WAIT-RESULT: ERROR"
						echo "⛔ ERROR: $MDSC_CMD --wait-for-input: $1: value required (message ids, space-separated)" >&2
						set +e ; return 1
					fi
					if ! LC_ALL=C awk -v ids="$2" 'BEGIN { exit ( ids ~ /[^0-9A-Za-z._: -]/ ) ; }' ; then
						echo "WAIT-RESULT: ERROR"
						echo "⛔ ERROR: $MDSC_CMD --wait-for-input: $1: a message id holds only letters, digits, '.', ':', '-' and '_'. Nothing was reacted to or waited on." >&2
						set +e ; return 1
					fi
					for reactWord in $2 ; do
						waitReactions="$waitReactions${1#--wait-react-}=$reactWord "
					done
					shift 2
				;;
				--wait-source)
					if [ -z "${2:-}" ] ; then
						echo "WAIT-RESULT: ERROR"
						echo "⛔ ERROR: $MDSC_CMD --wait-for-input: --wait-source: value required (<kind>:<target>)" >&2
						set +e ; return 1
					fi
					## A source the caller adds may end in #short or #full, chosen when it is added (F3.3, AgentsWaitSourceModeApply).
					case "$2" in
						*'#'*)
							case "${2##*#}" in
								short|full) ;;
								*)
									echo "WAIT-RESULT: ERROR"
									echo "⛔ ERROR: $MDSC_CMD --wait-for-input: --wait-source '$2': what follows # is short or full, and nothing else. Nothing was waited on." >&2
									set +e ; return 1
								;;
							esac
							waitModes="$waitModes${2%'#'*}=${2##*#} "
							waitSources="$waitSources${2%'#'*} "
						;;
						*) waitSources="$waitSources$2 " ;;
					esac
					shift 2
				;;
				--wait-timeout)
					if [ -z "${2:-}" ] ; then
						echo "WAIT-RESULT: ERROR"
						echo "⛔ ERROR: $MDSC_CMD --wait-for-input: --wait-timeout: value required (whole seconds)" >&2
						set +e ; return 1
					fi
					waitTimeout="$2"
					shift 2
				;;
				--wait-poll-interval)
					if [ -z "${2:-}" ] ; then
						echo "WAIT-RESULT: ERROR"
						echo "⛔ ERROR: $MDSC_CMD --wait-for-input: --wait-poll-interval: value required (whole seconds)" >&2
						set +e ; return 1
					fi
					waitPoll="$2"
					shift 2
				;;
				--wait-since-utime)
					if [ -z "${2:-}" ] ; then
						echo "WAIT-RESULT: ERROR"
						echo "⛔ ERROR: $MDSC_CMD --wait-for-input: --wait-since-utime: value required (epoch seconds)" >&2
						set +e ; return 1
					fi
					waitSince="$2"
					shift 2
				;;
				--wait-addressee)
					if [ -z "${2:-}" ] ; then
						echo "WAIT-RESULT: ERROR"
						echo "⛔ ERROR: $MDSC_CMD --wait-for-input: --wait-addressee: value required (the Slack account id the question was addressed to)" >&2
						set +e ; return 1
					fi
					## Resolved ids only, never a name: the send resolves a name once and reports
					## what it resolved, and a second resolution here could disagree with the
					## party the message was actually addressed to.
					waitAddressee="$waitAddressee$2 "
					shift 2
				;;
				--wait-list-sources)
					waitListOnly="true"
					shift
				;;
				--wait-include-own)
					waitIncludeOwn="true"
					shift
				;;
				## A COLLECT (F4.1): a wait of a window of seconds that returns, ahead of it, on an immediate arrival -- the tags
				## (tagged:<member>) are immediate, every other source collects until the window ends. See AgentsWaitCollectFloors.
				--wait-collect)
					case "${2:-}" in
						''|*[!0123456789]*|0)
							echo "WAIT-RESULT: ERROR"
							echo "⛔ ERROR: $MDSC_CMD --wait-for-input: --wait-collect: value required (the window, in whole seconds, one or more)" >&2
							set +e ; return 1
						;;
					esac
					waitCollect="$2"
					shift 2
				;;
				*)
					echo "WAIT-RESULT: ERROR"
					echo "⛔ ERROR: $MDSC_CMD --wait-for-input: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -n "$waitCollect" ] && { [ -n "$waitMode" ] || [ -n "$waitTimeout" ] ; } ; then
			echo "WAIT-RESULT: ERROR"
			echo "⛔ ERROR: $MDSC_CMD --wait-for-input: --wait-collect is a call of its own: the window is its bound, and the floors it resumes from are the pointers of the session (session.chat.pointers), not a stored wait. It takes no --wait-timeout and no mode. Nothing was waited on." >&2
			set +e ; return 1
		fi
		[ -z "$waitCollect" ] || waitTimeout="$waitCollect"
		## Only a Slack source has a short and a full form in this build: the one kind whose messages are text a person wrote.
		local modeOne
		for modeOne in $waitModes ; do
			case "${modeOne%=*}" in
				slack:*) ;;
				*)
					echo "WAIT-RESULT: ERROR"
					echo "⛔ ERROR: $MDSC_CMD --wait-for-input: --wait-source '${modeOne%=*}#${modeOne##*=}': only a Slack source takes a short or a full form. Nothing was waited on." >&2
					set +e ; return 1
				;;
			esac
		done

		## Asked what it can wait on, it answers and waits on nothing. This is the
		## extension point made observable: whatever this prints is what a caller
		## may name, with no second list to keep in step.
		if [ "$waitListOnly" = "true" ] ; then
			echo "WAIT-RESULT: RECEIVED"
			echo "# input source kinds this build carries:"
			local listKind
			for listKind in $agentsWaitSourceKinds ; do
				printf '%s\t%s\n' "$listKind" "$( AgentsWaitProbeFunctionName "$listKind" )"
			done
			return 0
		fi

		## slack:session-current and slack:session-parent each name that session's thread, as the Wait tool
		## takes them: the one address resolver gives the thread, and it is waited on as its :conversation
		## source, before anything below checks or stores a source. With :<ts> the name is one message in
		## that thread's conversation, and the source is the thread of that message: plain for an answer
		## to it, with :conversation for any new post there. A name that names nowhere is refused by the
		## resolver's own line.
		local sessionSource sessionSources="" sessionResolved="" sessionRc=0 sessionAddress="" sessionForm="" sessionOriginal=""
		for sessionSource in $waitSources ; do
			sessionOriginal="$sessionSource"
			case "$sessionSource" in
				slack:session-current|slack:session-current:*|slack:session-parent|slack:session-parent:*)
					sessionAddress="${sessionSource#slack:}" ; sessionForm=""
					case "$sessionAddress" in *:conversation) sessionForm=":conversation" ; sessionAddress="${sessionAddress%:conversation}" ;; esac
					## The name alone is the thread itself: any new post there.
					case "$sessionAddress" in *:*) ;; *) sessionForm=":conversation" ;; esac
					type DistroAgentsToolsResolveTarget > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.CommsSlack.include"
					sessionRc=0
					sessionResolved="$( DistroAgentsToolsResolveTarget "$sessionAddress" "$memberName" )" || sessionRc=$?
					if [ "$sessionRc" != "0" ] ; then
						echo "WAIT-RESULT: ERROR"
						echo "⛔ ERROR: $MDSC_CMD --wait-for-input: $sessionResolved Nothing was waited on." >&2
						set +e ; return 1
					fi
					sessionSource="slack:$( printf '%s\n' "$sessionResolved" | sed -n 's/^CHANNEL=//p' ):$( printf '%s\n' "$sessionResolved" | sed -n 's/^THREAD_TS=//p' )$sessionForm"
				;;
			esac
			## The form chosen for the name the caller gave stays with the thread it names.
			[ "$sessionSource" = "${sessionOriginal:-$sessionSource}" ] || waitModes="${waitModes/ ${sessionOriginal}=/ ${sessionSource}=}"
			sessionSources="$sessionSources$sessionSource "
		done
		waitSources="$sessionSources"

		## State is per session, never per member, and --wait-continue refuses a source or filter of its own.
		local waitStateDir="" waitStateLine waitStoredSources="" waitStoredAddressee="" waitOwnPost="" waitOwnSecond="" waitSessionStart=""
		if [ -n "$waitMode" ] ; then
			if [ -z "$waitSessionId" ] ; then
				echo "WAIT-RESULT: ERROR"
				echo "⛔ ERROR: $MDSC_CMD --wait-for-input: --wait-$waitMode needs --wait-session-id, because the state it keeps or ends is the state of one session. Nothing was waited on." >&2
				set +e ; return 1
			fi
			AgentsToolsAssertBareName "$waitSessionId" "<session-id>" wait-for-input || {
				echo "WAIT-RESULT: ERROR"
				set +e ; return 1
			}
			if [ "$waitMode" = "continue" ] && { [ -n "$waitSources" ] || [ -n "$waitSince" ] || [ -n "$waitAddressee" ] || [ "$waitIncludeOwn" = "true" ] ; } ; then
				echo "WAIT-RESULT: ERROR"
				echo "⛔ ERROR: $MDSC_CMD --wait-for-input: --wait-continue repeats the stored wait and takes no source, since, addressee or include-own of its own. Nothing was waited on: call --wait-default to change them." >&2
				set +e ; return 1
			fi
			if [ "$waitMode" = "add" ] || [ "$waitMode" = "drop" ] ; then
				if [ -z "$waitSources" ] || [ -n "$waitSince" ] || [ -n "$waitAddressee" ] || [ "$waitIncludeOwn" = "true" ] || [ -n "$waitReactions" ] ; then
					echo "WAIT-RESULT: ERROR"
					echo "⛔ ERROR: $MDSC_CMD --wait-for-input: --wait-$waitMode takes one or more --wait-source and nothing else, since the since, addressee and include-own of a stored wait are shared by all its sources. Nothing was changed." >&2
					set +e ; return 1
				fi
				local editSource
				for editSource in $waitSources ; do
					case "${editSource/#slack:client:/slack:}" in
						slack:*:*)
							echo "WAIT-RESULT: ERROR"
							echo "⛔ ERROR: $MDSC_CMD --wait-for-input: --wait-$waitMode does not take the thread source '$editSource', which needs a since and an addressee of its own. Nothing was changed: name it in a --wait-default." >&2
							set +e ; return 1
						;;
					esac
				done
			fi
			waitStateDir="$MMDAPP/.local/agents/sessions/$waitSessionId/wait"
			echo "# --wait-for-input: mode=$waitMode member=$memberName session=$waitSessionId" >&2
			## Abandoned state is swept on the way in, as the working directories below are.
			find "$MMDAPP/.local/agents/sessions" -maxdepth 2 -type d -name wait -mtime +7 -exec rm -rf {} + 2>/dev/null || true
			if [ "$waitMode" = "continue" ] && [ ! -f "$waitStateDir/state" ] ; then
				echo "WAIT-RESULT: ERROR"
				echo "⛔ ERROR: $MDSC_CMD --wait-for-input: --wait-continue found no stored wait for session $waitSessionId. Nothing was waited on, and no default wait was started in its place: call --wait-default." >&2
				set +e ; return 1
			fi
			## close names its own ids against the stored sources, unless it was given some.
			if [ -f "$waitStateDir/state" ] && { [ "$waitMode" = "continue" ] || { [ "$waitMode" = "close" ] && [ -z "$waitSources" ] ; } ; } ; then
				while IFS= read -r waitStateLine ; do
					case "$waitStateLine" in
						"sources: "*) waitSources="${waitStateLine#sources: }" ;;
						"addressee: "*) waitAddressee="${waitStateLine#addressee: }" ;;
						"include-own: "*) waitIncludeOwn="${waitStateLine#include-own: }" ;;
						"mode "*)
							waitStateLine="${waitStateLine#mode }"
							waitModes="$waitModes${waitStateLine% *}=${waitStateLine##* } "
						;;
						"floor "*)
							waitStateLine="${waitStateLine#floor }"
							waitFloors="$waitFloors${waitStateLine% *}=${waitStateLine##* } "
						;;
					esac
				done < "$waitStateDir/state"
			fi
			## default keeps every stored floor: never dropped, only reused or replaced by an explicit since.
			if [ -f "$waitStateDir/state" ] && [ "$waitMode" = "default" ] ; then
				while IFS= read -r waitStateLine ; do
					case "$waitStateLine" in
						"sources: "*) waitStoredSources="${waitStateLine#sources: }" ;;
						"addressee: "*) waitStoredAddressee="${waitStateLine#addressee: }" ;;
						## A floor lives only for a source of the stored set: one stored for a source that left it is stale, and a source that comes back starts at the wait's start.
						"floor "*)
							waitStateLine="${waitStateLine#floor }"
							case " $waitStoredSources " in
								*" ${waitStateLine% *} "*) waitFloors="$waitFloors${waitStateLine% *}=${waitStateLine##* } " ;;
							esac
						;;
					esac
				done < "$waitStateDir/state"
			fi
			## The session's own last post, "<channel> <ts>": the floor of a thread source with none stored.
			[ ! -f "$MMDAPP/.local/agents/sessions/$waitSessionId/last-own-post" ] \
				|| IFS= read -r waitOwnPost < "$MMDAPP/.local/agents/sessions/$waitSessionId/last-own-post" || :
			## Its first two words only, the thread and the ts of the latest post: the rest of the line is the floor's.
			case "$waitOwnPost" in
				*" "*" "*) waitOwnSecond="${waitOwnPost#* }" ; waitOwnPost="${waitOwnPost%% *} ${waitOwnSecond%% *}" ;;
			esac
			## When this spawn launched: the launcher's own marker file, written once at launch.
			## The floor of a session or conversation thread with no stored floor and no own post.
			if [ -n "${MDAT_SPAWN_LAUNCH_MARKER:-}" ] && [ -f "$MDAT_SPAWN_LAUNCH_MARKER" ] ; then
				waitSessionStart="$( stat -f %m "$MDAT_SPAWN_LAUNCH_MARKER" 2>/dev/null || stat -c %Y "$MDAT_SPAWN_LAUNCH_MARKER" 2>/dev/null )" || waitSessionStart=""
				case "$waitSessionStart" in ''|*[!0-9]*) waitSessionStart="" ;; esac
			fi
		fi

		## Defaults. A caller inside a coworking session defaults to that session's
		## own thread, any post but its own -- the common "tell me when this session
		## moves" case. One shared by every entry point that reaches this operation,
		## harness and MCP twin alike, since the default lives here and not above it.
		## Absent a session thread, the two team conversations every member already
		## watches: the common "tell me when anyone says anything to me" case.
		## NAMED SOURCES ARE ADDED TO THE DEFAULTS, NEVER PUT IN THEIR PLACE (a default call): the session thread or the team channel and the owner DM are
		## always watched, so their floors advance at every Wait, and what the call names, and what the stored wait holds, comes beside them.
		local waitNamedSources=""
		## A client-* member names what it reads: our team's conversations are never added beside it, so its call never reads under our team's identities.
		## A call naming only its own floor (replies:<session>, chat:<own key>, wake:<own member>) asks for the floor alone: no defaults beside it.
		local waitFloorOnly="" floorOnlyOne floorOnlyKey=""
		if [ "$waitMode" = "default" ] && [ -n "$waitSources" ] && [ -n "$waitSessionId" ] ; then
			type AgentsToolsSessionChatKey > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionChat.include" 2> /dev/null || :
			floorOnlyKey="$( AgentsToolsSessionChatKey 2> /dev/null )" || floorOnlyKey=""
			waitFloorOnly="true"
			for floorOnlyOne in $waitSources ; do
				case "$floorOnlyOne" in
					"replies:$waitSessionId"|"wake:$memberName") ;;
					"chat:$floorOnlyKey") [ -n "$floorOnlyKey" ] || waitFloorOnly="" ;;
					*) waitFloorOnly="" ;;
				esac
			done
		fi
		if [ "$waitMode" = "default" ] && [ -n "$waitSources" ] && [ -z "$waitFloorOnly" ] ; then
			case "$memberName" in
				client-*) ;;
				*) waitNamedSources="$waitSources" ; waitSources="" ;;
			esac
		fi
		if [ -z "$waitSources" ] ; then
			type AgentsToolsWaitDefaultSources > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SpawnSandbox.include" 2> /dev/null || :
			local defaultSessionSources=""
			defaultSessionSources="$( AgentsToolsWaitDefaultSources 2>/dev/null )" || defaultSessionSources=""
			if [ -n "$defaultSessionSources" ] ; then
				## The session thread and every conversation thread this session continues.
				waitSources="$defaultSessionSources "
				## A thread source needs a floor. With no explicit one it is the floor
				## stored for this source, else the session's own last post there, else
				## the wait's start -- set per source below, never a fresh "now" that
				## would skip what arrived since the last wait.
			else
				waitSources="slack:magic-team slack:human-owner "
				## A session that is itself the coworking session -- a native client session, never
				## spawned -- has no thread of a spawn, so it watches these two as it always has, and
				## beside them its own session thread once that is on record, as any new post there
				## but its own (AgentsToolsSessionCurrentThreadFind). With no record, these two alone.
				local defaultOwnThread=""
				type AgentsToolsSessionCurrentThreadFind > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SpawnSandbox.include" 2> /dev/null || :
				defaultOwnThread="$( AgentsToolsSessionCurrentThreadFind 2>/dev/null )" || defaultOwnThread=""
				[ -z "$defaultOwnThread" ] || ! AgentsToolsSpawnConversationThreadValid "$defaultOwnThread" || waitSources="${waitSources}slack:$defaultOwnThread:conversation "
			fi
		fi
		if [ -n "$waitNamedSources" ] ; then
			local namedOne
			for namedOne in $waitNamedSources ; do
				case " $waitSources" in *" $namedOne "*) continue ;; esac
				waitSources="$waitSources$namedOne "
			done
		fi
		## An asked question's wait item (ask:<pending-id>) stays in the session's wait through a
		## default call too, while its record exists: it leaves by --wait-drop only once closed for
		## good (an answered one keeps its thread watched), and a default call that dropped it
		## would leave the answer with nothing waiting for it. It is never dropped by age: the replies
		## probe leaves a question's thread to it (AgentsWaitRepliesLook), so a dropped one would lose
		## every later reply there.
		if [ "$waitMode" = "default" ] && [ -n "$waitStoredSources" ] ; then
			local carrySource carryRecord
			for carrySource in $waitStoredSources ; do
				case " $waitSources" in *" $carrySource "*) continue ;; esac
				case "$carrySource" in
					ask:*)
						carryRecord="$MMDAPP/.local/agents/pending/${carrySource#ask:}.md"
						[ -f "$carryRecord" ] || carryRecord="$MMDAPP/.local/agents/pending/closed/${carrySource#ask:}.md"
						[ -f "$carryRecord" ] || continue
					;;
					## the floor adds these two itself, below
					replies:*|chat:*) continue ;;
					## a thread source answers by the addressee of the wait that stored it
					slack:*:*:conversation) ;;
					slack:*:*)
						[ -n "$waitAddressee" ] || waitAddressee="$waitStoredAddressee"
						[ -n "$waitAddressee" ] || continue
					;;
				esac
				waitSources="$waitSources$carrySource "
			done
		fi
		## THE FLOOR. A session's wait -- a default or a continued one -- always holds the replies to the run's own
		## posts (AgentsWaitProbeReplies), ahead of the rest: an agent never chooses a channel or a thread to get a
		## reply, and the sources it names are added to the floor, never put in its place. What a named source
		## reads is left to that source (AgentsWaitCoveredSet), so nothing is read or returned twice.
		if [ -n "$waitSessionId" ] && { [ "$waitMode" = "default" ] || [ "$waitMode" = "continue" ] ; } ; then
			case " $waitSources" in
				*" replies:$waitSessionId "*) ;;
				*) waitSources="replies:$waitSessionId $waitSources" ;;
			esac
			## And the session chat file (F9.2, F3.3): the messages of its session thread that are the run's floor, read from the
			## file, beside the replies. Where the run has a session with a folder; the sources named are added behind it.
			local floorChatKey=""
			type AgentsToolsSessionChatKey > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionChat.include" 2> /dev/null || :
			floorChatKey="$( AgentsToolsSessionChatKey 2> /dev/null )" || floorChatKey=""
			if [ -n "$floorChatKey" ] && AgentsToolsSessionChatDir "$floorChatKey" > /dev/null 2>&1 && [ -d "$MMDAPP/.local/agents/sessions/$floorChatKey" ] ; then
				case " $waitSources" in
					*" chat:$floorChatKey "*) ;;
					*) waitSources="${waitSources/replies:$waitSessionId /replies:$waitSessionId chat:$floorChatKey }" ;;
				esac
			fi
		fi
		## THE SCANS ARE READ LAST. A scan is the one source whose read takes minutes (the work-duty scan runs the inbox, the owner's
		## items, the board and a collect window), so a source that follows it in a round is read when the scan has ended. Every other
		## source keeps its order. This is an order within the call: a stored wait read back by `continue` is ordered the same way.
		if [ -n "$waitSessionId" ] && { [ "$waitMode" = "default" ] || [ "$waitMode" = "continue" ] ; } ; then
			local orderOne orderFirst="" orderScans=""
			for orderOne in $waitSources ; do
				case "$orderOne" in
					scan:*) orderScans="$orderScans$orderOne " ;;
					*) orderFirst="$orderFirst$orderOne " ;;
				esac
			done
			waitSources="$orderFirst$orderScans"
		fi
		## THE RETURN BOUND. No --wait-timeout is no bound: the wait returns on an arrival and on
		## nothing else, so an idle caller spends no round per quiet interval. A caller that must
		## return by a deadline (an MCP client cutoff, a zero-bound read) names one.
		## A bound is also kept inside a round, between two sources (THE BOUND IS KEPT BETWEEN SOURCES, in the round below).
		## THE POLL CADENCE is separate and only decides how soon an arrival is noticed. IT IS A TICK AND A
		## SLOW LOOK (see agentsWaitKindLocal above): a source read out of a file is read every second, so an
		## item arriving in an inbox, a board state, the session chat file or the own wake marker wakes the
		## caller within about a second, and a source read over the network is read on the slow gap -- five
		## seconds growing by one for every twenty idle, capped at five minutes, counted from the newest
		## activity on the watched sources (AgentsWaitNewestActivity) rather than from the call start alone.
		## A given interval (--wait-poll-interval, else MDAT_WAIT_POLL_SECONDS) stays fixed for every source,
		## as it always did.
		local waitBackoff="false" waitActivity="" waitWakeSeen=""
		[ -n "$waitPoll" ] || waitPoll="${MDAT_WAIT_POLL_SECONDS:-}"
		[ -n "$waitPoll" ] || { waitPoll="$agentsWaitTickSeconds" ; waitBackoff="true" ; }

		case "$waitTimeout" in
			'') ;;
			*[!0-9]*)
				echo "WAIT-RESULT: ERROR"
				echo "⛔ ERROR: $MDSC_CMD --wait-for-input: --wait-timeout must be a whole number of seconds, got: $waitTimeout" >&2
				set +e ; return 1
			;;
		esac
		## THE ROUND OF A SESSION'S WAIT. A wait that belongs to a session -- a mode, with its
		## session id -- comes back, when nothing arrived, a little sooner than the prompt cache
		## of the CLI service that session runs on expires, so the turn that goes on waiting
		## reads the session's history from that cache. Its bound is at most that service's round
		## (AgentsTools.CliService.include), whatever bound the call names, and that round where
		## it names none. A wait of no session keeps the bound it was given, or none.
		if [ -n "$waitSessionId" ] ; then
			case "$waitMode" in
				default|continue)
					local waitRound=""
					type AgentsToolsCliServiceWaitRound > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsTools.CliService.include"
					waitRound="$( AgentsToolsCliServiceWaitRound "$( AgentsToolsCliServiceOfSession "$waitSessionId" )" )"
					case "$waitRound" in
						''|*[!0-9]*) ;;
						*) [ -n "$waitTimeout" ] && [ "$waitTimeout" -le "$waitRound" ] || waitTimeout="$waitRound" ;;
					esac
				;;
			esac
		fi
		case "$waitPoll" in
			''|*[!0-9]*)
				echo "WAIT-RESULT: ERROR"
				echo "⛔ ERROR: $MDSC_CMD --wait-for-input: --wait-poll-interval must be a whole number of seconds, got: $waitPoll" >&2
				set +e ; return 1
			;;
		esac
		if [ "$waitPoll" -lt 1 ] ; then
			echo "WAIT-RESULT: ERROR"
			echo "⛔ ERROR: $MDSC_CMD --wait-for-input: --wait-poll-interval must be at least 1 second -- a zero interval is a spin, not a poll." >&2
			set +e ; return 1
		fi
		if [ -n "$waitSince" ] ; then
			case "$waitSince" in
				## A Slack message ts is epoch seconds with microseconds, and is the value a
				## caller passes when it is waiting on what follows a message it posted -- the
				## same <epoch>[.<micros>] shape --oldest already takes on the read side.
				''|.*|*.|*[!0-9.]*|*.*.*)
					echo "WAIT-RESULT: ERROR"
					echo "⛔ ERROR: $MDSC_CMD --wait-for-input: --wait-since-utime: not epoch seconds, and not a Slack message ts either -- pass <epoch>[.<micros>]: $waitSince" >&2
					set +e ; return 1
				;;
			esac
			## A FLOOR IS A MOMENT THAT HAS PASSED. Nothing at or before it counts, so a wait from
			## a floor ahead of the present returns on nothing until that moment comes, whatever
			## arrives meanwhile: for the length of its bound, and through every --wait-continue
			## after it, which resumes from the floor stored. Refused at second zero, like a kind
			## this build does not carry, with both moments named.
			local waitSinceNow
			waitSinceNow="$( date +%s )"
			if AgentsWaitTsNewer "$waitSince" "$(( waitSinceNow + agentsWaitFloorAhead ))" ; then
				echo "WAIT-RESULT: ERROR"
				echo "⛔ ERROR: $MDSC_CMD --wait-for-input: --wait-since-utime: $waitSince is ahead of the present, which is $waitSinceNow in epoch seconds on this host. A floor is a moment that has passed: nothing at or before it counts, so from this one nothing that arrives would be returned until then. Nothing was waited on: pass the ts of a message already posted, or epoch seconds at or before the present, or leave it out to wait from the floor stored for the source, else from now." >&2
				set +e ; return 1
			fi
		fi

		## Every source is resolved to its probe BEFORE the wait starts. A kind
		## this build does not carry is a stated error at second zero, never a
		## source that silently never fires for the length of the bound.
		local checkSource checkKind checkTarget checkFn
		for checkSource in $waitSources ; do
			checkKind="${checkSource%%:*}"
			checkTarget="${checkSource#*:}"
			if [ "$checkKind" = "$checkSource" ] || [ -z "$checkTarget" ] ; then
				echo "WAIT-RESULT: ERROR"
				echo "⛔ ERROR: $MDSC_CMD --wait-for-input: --wait-source '$checkSource' is not <kind>:<target>. Nothing was waited on. Kinds this build carries: $agentsWaitSourceKinds" >&2
				set +e ; return 1
			fi
			checkFn="$( AgentsWaitProbeFunctionName "$checkKind" )"
			if ! command -v "$checkFn" >/dev/null 2>&1 ; then
				echo "WAIT-RESULT: ERROR"
				echo "⛔ ERROR: $MDSC_CMD --wait-for-input: no input source of kind '$checkKind' exists in this build, so nothing was waited on -- this is NOT a wait that found nothing. Kinds this build carries: $agentsWaitSourceKinds" >&2
				set +e ; return 1
			fi
			## A member waits on its own inbox only, and a board state is one of the nine directories.
			case "$checkKind:$checkTarget" in
				inbox:"$memberName"|board:backlog|board:pending|board:running|board:review|board:blocked|board:parked|board:processed|board:archived|board:retained) ;;
				inbox:*|board:*)
					echo "WAIT-RESULT: ERROR"
					echo "⛔ ERROR: $MDSC_CMD --wait-for-input: --wait-source '$checkSource' names nothing this build can wait on: inbox:<own member name> is the own inbox only, and board:<state> is one of backlog pending running review blocked parked processed archived retained. Nothing was waited on." >&2
					set +e ; return 1
				;;
				## A scan is one of the tooling's own scans (AgentsToolsInputScanNames); the tags are the member's own; the session chat is a session's.
				scan:*)
					type AgentsToolsInputScanNames > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.InputScanDef.include" 2> /dev/null || :
					if ! AgentsToolsInputScanNames | LC_ALL=C grep -q -x -- "$checkTarget" ; then
						echo "WAIT-RESULT: ERROR"
						echo "⛔ ERROR: $MDSC_CMD --wait-for-input: --wait-source '$checkSource' names no scan of the tooling: scan:<scan> takes one of $( AgentsToolsInputScanNames | LC_ALL=C tr '\n' ' ' | LC_ALL=C sed 's/ $//' ). Nothing was waited on." >&2
						set +e ; return 1
					fi
				;;
				tagged:*)
					if [ "$checkTarget" != "$memberName" ] ; then
						echo "WAIT-RESULT: ERROR"
						echo "⛔ ERROR: $MDSC_CMD --wait-for-input: --wait-source '$checkSource' names nothing this build can wait on: tagged:<own member name> is the own tags only. Nothing was waited on." >&2
						set +e ; return 1
					fi
				;;
				mentions:*)
					if [ "$checkTarget" != "$memberName" ] ; then
						echo "WAIT-RESULT: ERROR"
						echo "⛔ ERROR: $MDSC_CMD --wait-for-input: --wait-source '$checkSource' names nothing this build can wait on: mentions:<own member name> is the own mentions only. Nothing was waited on." >&2
						set +e ; return 1
					fi
				;;
				chat:*)
					AgentsToolsAssertBareName "$checkTarget" "<session-id>" wait-for-input || {
						echo "WAIT-RESULT: ERROR"
						set +e ; return 1
					}
				;;
				## A detached process is one this session started with Bash detach true; the handle
				## is a bare name, and its output is read from this session's own processes folder.
				process:*)
					AgentsToolsAssertBareName "$checkTarget" "<process-handle>" wait-for-input || {
						echo "WAIT-RESULT: ERROR"
						set +e ; return 1
					}
				;;
				## An asked question's record must exist, and only the session that asked may wait on it,
				## the rule AskQuestion's own pending_id re-wait keeps. Not checked on a drop, which
				## must still take out an item whose record was since removed. A permission set is
				## asked once for all its participants, so each of them may wait on its answer too,
				## whichever session asked: the members its own record names (`<id>.set`, participants).
				ask:*)
					[ "$waitMode" != "drop" ] || continue
					local checkAskLine checkAskSession="" checkAskRecord=""
					## A record closed since it was asked is retired to pending/closed/ (retention, T9),
					## its sidecars with it: resolved there too, as AgentsWaitProbeAsk does, so the
					## session that asked can still wait on the question it asked.
					checkAskRecord="$MMDAPP/.local/agents/pending/$checkTarget.md"
					[ -f "$checkAskRecord" ] || checkAskRecord="$MMDAPP/.local/agents/pending/closed/$checkTarget.md"
					if ! AgentsToolsAssertBareName "$checkTarget" "<pending-id>" wait-for-input || [ ! -f "$checkAskRecord" ] ; then
						echo "WAIT-RESULT: ERROR"
						echo "⛔ ERROR: $MDSC_CMD --wait-for-input: --wait-source '$checkSource' names no pending reply in this workspace, so there is no question to wait on. Nothing was waited on." >&2
						set +e ; return 1
					fi
					while IFS= read -r checkAskLine ; do
						case "$checkAskLine" in
							'session-id: '*) checkAskSession="${checkAskLine#session-id: }" ;;
							'# '*) break ;;
						esac
					done < "$checkAskRecord"
					if [ -n "$checkAskSession" ] && [ -n "$waitSessionId" ] && [ "$checkAskSession" != "$waitSessionId" ] \
						&& [ -f "${checkAskRecord%.md}.set" ] \
						&& LC_ALL=C grep -q -x -F -- 'kind: permission-set' "$checkAskRecord" \
						&& case " $( LC_ALL=C sed -n 's/^participants: //p' "${checkAskRecord%.md}.set" | head -1 ) " in *" $memberName "*) true ;; *) false ;; esac ; then
						checkAskSession=""
					fi
					if [ -n "$checkAskSession" ] && [ -n "$waitSessionId" ] && [ "$checkAskSession" != "$waitSessionId" ] ; then
						echo "WAIT-RESULT: ERROR"
						echo "⛔ ERROR: $MDSC_CMD --wait-for-input: --wait-source '$checkSource' is a question asked by session $checkAskSession, not $waitSessionId, so this session may not wait on it. Nothing was waited on." >&2
						set +e ; return 1
					fi
				;;
			esac
		done

		## --wait-add and --wait-drop change the stored wait's source list and wait on nothing. A
		## source keeps its floor line and its base.<position> file, renumbered when one before
		## it is dropped; an added source starts with no base, so its first wait reads it afresh.
		if [ "$waitMode" = "add" ] || [ "$waitMode" = "drop" ] ; then
			local editLine editOld="" editNew="" editAddressee="" editIncludeOwn="false" editFloors="" editModes="" editIndex=0 editKept=0 editTmp
			if [ -f "$waitStateDir/state" ] ; then
				while IFS= read -r editLine ; do
					case "$editLine" in
						"sources: "*) editOld="${editLine#sources: }" ;;
						"addressee: "*) editAddressee="${editLine#addressee: }" ;;
						"include-own: "*) editIncludeOwn="${editLine#include-own: }" ;;
						"floor "*) editFloors="$editFloors$editLine"$'\n' ;;
						"mode "*) editModes="$editModes$editLine"$'\n' ;;
					esac
				done < "$waitStateDir/state"
			fi
			for editSource in $editOld ; do
				editIndex=$(( editIndex + 1 ))
				if [ "$waitMode" = "drop" ] && case " $waitSources" in *" $editSource "*) true ;; *) false ;; esac ; then
					rm -f "$waitStateDir/base.$editIndex"
					editFloors="$( printf '%s' "$editFloors" | LC_ALL=C awk -v gone="$editSource" '$1 == "floor" && $2 == gone { next ; } { print ; }' )"
					[ -z "$editFloors" ] || editFloors="$editFloors"$'\n'
					editModes="$( printf '%s' "$editModes" | LC_ALL=C awk -v gone="$editSource" '$1 == "mode" && $2 == gone { next ; } { print ; }' )"
					[ -z "$editModes" ] || editModes="$editModes"$'\n'
					continue
				fi
				editKept=$(( editKept + 1 ))
				editNew="$editNew$editSource "
				[ "$editKept" = "$editIndex" ] || [ ! -f "$waitStateDir/base.$editIndex" ] || mv -f "$waitStateDir/base.$editIndex" "$waitStateDir/base.$editKept"
			done
			if [ "$waitMode" = "add" ] ; then
				for editSource in $waitSources ; do
					case " $editNew" in *" $editSource "*) continue ;; esac
					editKept=$(( editKept + 1 ))
					editNew="$editNew$editSource "
					rm -f "$waitStateDir/base.$editKept"
				done
				## The form an added source was added in is kept with it, a new one replacing an old.
				for editSource in $waitSources ; do
					case "$waitModes" in *" $editSource="*) ;; *) continue ;; esac
					editModes="$( printf '%s' "$editModes" | LC_ALL=C awk -v gone="$editSource" '$1 == "mode" && $2 == gone { next ; } { print ; }' )"
					[ -z "$editModes" ] || editModes="$editModes"$'\n'
					editModes="${editModes}mode $editSource $( AgentsWaitModeOf "$editSource" )"$'\n'
				done
			fi
			if [ -z "$editNew" ] ; then
				rm -rf "$waitStateDir" 2>/dev/null || true
			else
				mkdir -p "$waitStateDir" && editTmp="$( mktemp "$waitStateDir/state.XXXXXX" )" || {
					echo "WAIT-RESULT: ERROR"
					echo "⛔ ERROR: $MDSC_CMD --wait-for-input: the stored wait under $waitStateDir could not be written, so it is unchanged." >&2
					set +e ; return 1
				}
				{
					echo "sources: $editNew"
					echo "addressee: $editAddressee"
					echo "include-own: $editIncludeOwn"
					printf '%s' "$editFloors"
					printf '%s' "$editModes"
				} > "$editTmp"
				mv -f "$editTmp" "$waitStateDir/state"
			fi
			[ "$waitMode" = "add" ] && echo "WAIT-RESULT: ADDED" || echo "WAIT-RESULT: DROPPED"
			echo "WAIT-MODE: $waitMode"
			echo "# member: $memberName"
			echo "# sources: ${editNew% }"
			return 0
		fi

		## Settled before the wait starts and not discovered in its result. A thread source
		## is a question waiting on its own answer, and an answer is qualified by the
		## message it came after and the party it came from. A thread source missing
		## either of those is refused here rather than waited on.
		## `slack:<channel>:<ts>:conversation` is the "any new post" thread mode:
		## no addressee, sibling to today's named `slack:magic-team` etc. targets.
		local checkThreads=0 checkConversation=0 checkUnfloored=0
		for checkSource in $waitSources ; do
			case "${checkSource/#slack:client:/slack:}" in
				slack:*:*:conversation)
					checkThreads=$(( checkThreads + 1 ))
					checkConversation=$(( checkConversation + 1 ))
				;;
				slack:*:*)
					checkThreads=$(( checkThreads + 1 ))
					## A question thread's floor is our own message there: given, or stored by an earlier wait.
					case " $waitFloors" in
						*" $checkSource="*) ;;
						*) checkUnfloored=$(( checkUnfloored + 1 )) ;;
					esac
				;;
			esac
		done
		## A continued or closed wait has its floors stored, so no since is asked for. A
		## :conversation thread with no since takes its stored floor, the session's own last
		## post there, or the wait's start (below), any of which is a floor.
		if [ "$checkUnfloored" -gt 0 ] && [ -z "$waitSince" ] && [ "$waitMode" != "continue" ] && [ "$waitMode" != "close" ] ; then
			echo "WAIT-RESULT: ERROR"
			echo "⛔ ERROR: $MDSC_CMD --wait-for-input: a thread source needs --wait-since-utime carrying the ts of our own message in that thread, because an answer is what arrives AFTER it. Without that floor every message already in the thread would count as an answer, our own included. Nothing was waited on." >&2
			set +e ; return 1
		fi
		if [ "$checkThreads" -gt "$checkConversation" ] && [ -z "$waitAddressee" ] ; then
			echo "WAIT-RESULT: ERROR"
			echo "⛔ ERROR: $MDSC_CMD --wait-for-input: a thread source needs --wait-addressee carrying the Slack account the question was addressed to, because an answer is what that party wrote. Without it an unrelated message in the same thread would count as the answer, and so would our own next post. Nothing was waited on." >&2
			set +e ; return 1
		fi
		if [ "$checkConversation" -gt 0 ] && [ "$checkThreads" = "$checkConversation" ] && [ -n "$waitAddressee" ] ; then
			echo "WAIT-RESULT: ERROR"
			echo "⛔ ERROR: $MDSC_CMD --wait-for-input: a :conversation thread source takes no --wait-addressee, because any new post counts, not just one party's reply. Nothing was waited on." >&2
			set +e ; return 1
		fi
		if [ "$checkThreads" = "0" ] && [ -n "$waitAddressee" ] ; then
			echo "WAIT-RESULT: ERROR"
			echo "⛔ ERROR: $MDSC_CMD --wait-for-input: --wait-addressee qualifies an answer inside the thread the question was posted in, and this wait names no thread source. Over a whole conversation there is no message for an answer to come after. Nothing was waited on: name the thread as slack:<channel>:<ts>." >&2
			set +e ; return 1
		fi
		## --wait-include-own only changes anything on a :conversation thread source,
		## the one place this operation skips the caller's own posts by default (see
		## AgentsSlackThreadAnswers.awk). Everywhere else already includes them, so the
		## flag would be a silent no-op there -- refused instead, same shape as the
		## --wait-addressee mismatch checks above.
		if [ "$waitIncludeOwn" = "true" ] && [ "$checkConversation" = "0" ] ; then
			echo "WAIT-RESULT: ERROR"
			echo "⛔ ERROR: $MDSC_CMD --wait-for-input: --wait-include-own only changes anything on a slack:<channel>:<ts>:conversation source, which already includes this member's own posts everywhere else. Nothing was waited on: name a :conversation source, or drop the flag." >&2
			set +e ; return 1
		fi
		## Reactions follow every check and precede the wait; a failed one is listed and never stops it.
		local reactSet reactId reactEmoji reactOk reactFailed="" reactSummary="" reactNew="" reactSlack=0 reactChannel=""
		if [ -n "$waitReactions" ] ; then
			for checkSource in $waitSources ; do
				case "$checkSource" in
					slack:*)
						reactSlack=$(( reactSlack + 1 ))
						reactChannel="${checkSource#slack:}"
						case "$reactChannel" in
							client:*) reactChannel="${reactChannel#client:}" ; reactChannel="client:${reactChannel%%:*}" ;;
							*) reactChannel="${reactChannel%%:*}" ;;
						esac
					;;
				esac
			done
			for reactWord in $waitReactions ; do
				case "${reactWord#*=}" in
					*:*) reactNew="$reactNew$reactWord " ;;
					*)
						if [ "$reactSlack" != "1" ] ; then
							echo "WAIT-RESULT: ERROR"
							echo "⛔ ERROR: $MDSC_CMD --wait-for-input: the message id '${reactWord#*=}' is a bare ts, which names a message only when the wait has exactly one slack source, and this one has $reactSlack. Nothing was reacted to or waited on: write it <channel>:<ts>." >&2
							set +e ; return 1
						fi
						reactNew="$reactNew${reactWord%%=*}=$reactChannel:${reactWord#*=} "
					;;
				esac
			done
			waitReactions="$reactNew"
		fi
		for reactSet in seen note done wait ; do
			reactOk=0
			case "$reactSet" in
				seen) reactEmoji="eyes" ;;
				note) reactEmoji="writing_hand" ;;
				done) reactEmoji="white_check_mark" ;;
				wait) reactEmoji="hourglass_flowing_sand" ;;
			esac
			for reactWord in $waitReactions ; do
				[ "${reactWord%%=*}" = "$reactSet" ] || continue
				reactId="${reactWord#*=}"
				## The member's own identity first, then the bot: which one may react differs by conversation.
				if DistroAgentsTools --intern-op-comms-slack-react "$memberName" "$reactId" "$reactEmoji" > /dev/null 2>&1 \
					|| DistroAgentsTools --intern-op-comms-slack-react "$memberName" "$reactId" "$reactEmoji" --identity-bot > /dev/null 2>&1 ; then
					reactOk=$(( reactOk + 1 ))
				else
					reactFailed="$reactFailed$reactId "
				fi
			done
			reactSummary="$reactSummary$reactSet=$reactOk "
		done
		reactSummary="${reactSummary}failed=${reactFailed:-none}"
		reactSummary="${reactSummary% }"

		if [ "$waitMode" = "close" ] ; then
			rm -rf "$waitStateDir" 2>/dev/null || true
			echo "WAIT-RESULT: CLOSED"
			echo "WAIT-MODE: close"
			echo "# reactions: $reactSummary"
			return 0
		fi
		## default does not remove the stored state: its floors are kept (see the floor loop below).

		## mktemp, never `$$`: this operation is a shell function inside a long-lived
		## process, so every call in that process shares one PID. Two concurrent waits
		## by one member then share a directory, and the first to finish removes the
		## other's state mid-poll -- which surfaces as a missing base file, not as the
		## collision it is. Coworking makes concurrent waits the normal case.
		local waitDir waitDirWhy="" agentsWaitLost=""
		mkdir -p "$MMDAPP/.local/temp" 2>/dev/null || true
		## A unique name per call means an interrupted wait no longer has its directory
		## overwritten by the next one, so they accumulate instead. An EXIT trap cannot
		## clean up here -- this is a shell function inside a long-lived process, and its
		## trap would silently replace the caller's -- so stale ones are swept on the way
		## in. This member's own, and only those whose wait is proven gone (AgentsWaitFolderSweep).
		AgentsWaitFolderSweep "$memberName"
		## What mktemp says of a failure is kept and said: the wait then ends on one line, never on a
		## name that is no directory. A directory its record cannot be written into holds no rendering either.
		waitDir="$( mktemp -d "$MMDAPP/.local/temp/mdat-member-wait.$memberName.XXXXXX" 2>&1 )" || { waitDirWhy="${waitDir//$'\n'/ }" ; waitDir="" ; }
		if [ -n "$waitDir" ] && [ ! -d "$waitDir" ] ; then
			waitDirWhy="mktemp named ${waitDir//$'\n'/ }, which is no directory" ; waitDir=""
		fi
		if [ -n "$waitDir" ] && ! AgentsWaitFolderOwn "$waitDir" 2>/dev/null ; then
			rm -rf "$waitDir" 2>/dev/null || true
			waitDirWhy="the owner record could not be written into $waitDir" ; waitDir=""
		fi
		if [ -z "$waitDir" ] ; then
			echo "WAIT-RESULT: ERROR"
			echo "⛔ ERROR: $MDSC_CMD --wait-for-input: could not create a working directory under $MMDAPP/.local/temp (${waitDirWhy:-mktemp gave no reason}), so no probe could write a rendering. Nothing was waited on." >&2
			set +e ; return 1
		fi

		## With a cut-off named, the caller is waiting on something at or after a
		## moment it already knows -- so the first probe is EVALUATED against an
		## empty baseline, and a reply already sitting there returns immediately.
		## With no cut-off, "new" can only mean "different from now", so the first
		## probe is the baseline and the wait starts from it.
		local waitBaselineMode="first-probe"
		[ -z "$waitSince" ] || waitBaselineMode="empty"

		local waitStart waitDeadline=""
		waitStart="$( date +%s )"
		[ -z "$waitTimeout" ] || waitDeadline=$(( waitStart + waitTimeout ))

		## What a probe READS from, which is not what the baseline is taken against.
		## With no cut-off named, a source that can narrow reads from this wait's own
		## start: measured at 142s per round otherwise -- 40s for one channel and 102s
		## for a DM -- because each round re-renders the whole conversation only to
		## diff it and find nothing. At that cost a 15s interval means nothing and a
		## reply lands a minute or more late. A probe that cannot narrow ignores this,
		## so the file adapter keeps comparing whole renderings and a file already
		## sitting there still does not count as an arrival.
		local waitReadFloor="${waitSince:-$waitStart}"

		## One floor per source. LOSSLESS: a stored floor is never dropped. Without an explicit
		## since it is the floor; with one, a plain question thread takes the since (its own
		## question is the root an answer must follow), and any other Slack source takes the
		## OLDER of the two, so a since newer than the stored floor -- the ts of a reply the
		## caller posted after the last wait returned -- cannot skip what landed in between.
		## With neither, a :conversation thread starts at the session's own last post in
		## that thread, else at the spawn's launch, and every other source at the wait's start.
		## Every Slack source's baseline is empty: its rendering holds only what is after its
		## floor, so whatever is there is new, including a post made before the first read.
		## A continued wait, and a default one over a source the stored wait already had,
		## also start a non-Slack source from its stored baseline.
		local waitFloorOf=() waitFloorNew=() waitFloorsUsed="" floorIndex=0 floorStored floorStoredIndex floorStoredSource
		[ "$waitMode" != "continue" ] || waitBaselineMode="stored"
		## A COLLECT resumes each Slack source and the tags from the pointer the session kept for it, the last message of
		## it a collect returned (AgentsToolsSessionChatPointer, `collect:<member>:<source>`): it has no stored wait to keep
		## floors in. A source with none starts at the wait's start, as every source does.
		local collectKey="" collectStored
		if [ -n "$waitCollect" ] ; then
			type AgentsToolsSessionChatKey > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionChat.include" 2> /dev/null || :
			collectKey="$( AgentsToolsSessionChatKey 2> /dev/null )" || collectKey=""
			if [ -n "$collectKey" ] ; then
				for checkSource in $waitSources ; do
					case "$checkSource" in slack:*|tagged:*) ;; *) continue ;; esac
					collectStored="$( AgentsToolsSessionChatPointer "$collectKey" "collect:$memberName:$checkSource" 2> /dev/null )" || continue
					waitFloors="$waitFloors$checkSource=$collectStored "
				done
			fi
		fi
		for checkSource in $waitSources ; do
			floorIndex=$(( floorIndex + 1 ))
			waitFloorOf[$floorIndex]="$waitReadFloor"
			floorStored=""
			case " $waitFloors" in
				*" $checkSource="*)
					floorStored="${waitFloors#*"$checkSource="}"
					floorStored="${floorStored%% *}"
				;;
			esac
			if [ -n "$floorStored" ] ; then
				if [ -z "$waitSince" ] ; then
					waitFloorOf[$floorIndex]="$floorStored"
				else
					case "${checkSource/#slack:client:/slack:}" in
						slack:*:*:conversation) ;;
						slack:*:*) floorStored="" ;;
					esac
					[ -z "$floorStored" ] || AgentsWaitTsNewer "$floorStored" "$waitSince" || waitFloorOf[$floorIndex]="$floorStored"
				fi
			elif [ -z "$waitSince" ] ; then
				case "${checkSource/#slack:client:/slack:}" in
					slack:*:*:conversation)
						if [ -n "$waitOwnPost" ] && [ "$checkSource" = "slack:${waitOwnPost%% *}:conversation" ] ; then
							AgentsWaitTsNewer "${waitOwnPost##* }" "$waitStart" || waitFloorOf[$floorIndex]="${waitOwnPost##* }"
						elif [ -n "$waitSessionStart" ] && [ "$waitSessionStart" -lt "$waitStart" ] ; then
							waitFloorOf[$floorIndex]="$waitSessionStart"
						fi
					;;
				esac
			fi
			case "$checkSource" in
				slack:*)
					waitFloorsUsed="$waitFloorsUsed$checkSource=${waitFloorOf[$floorIndex]} "
					: > "$waitDir/base.$floorIndex"
				;;
				*)
					if [ "$waitMode" = "continue" ] ; then
						[ ! -f "$waitStateDir/base.$floorIndex" ] || cp "$waitStateDir/base.$floorIndex" "$waitDir/base.$floorIndex"
						## An inbox renders from its floor (AgentsWaitProbeInbox): continued, from when the
						## stored wait ended, so what came between the two calls is rendered, and is new.
						case "$checkSource" in
							inbox:*) [ ! -f "$waitStateDir/base.$floorIndex" ] || waitFloorOf[$floorIndex]="$( date -r "$waitStateDir/base.$floorIndex" +%s 2> /dev/null || printf '%s' "${waitFloorOf[$floorIndex]}" )" ;;
						esac
					elif [ "$waitMode" = "default" ] ; then
						## since_utime is a Slack-source floor (AgentsWaitTsNewer, above); it names no
						## opinion about a non-Slack source's own stored content baseline, so carrying
						## a held source's baseline forward here does not wait on it being empty. A
						## default wait naming since_utime must still start an ask:/file:/inbox:/board:
						## source already in waitStoredSources from what it last held, or the same
						## unchanging content -- an ask: record's own closed-line among it -- reads as
						## arriving fresh on every call that also names a since_utime.
						floorStoredIndex=0
						for floorStoredSource in $waitStoredSources ; do
							floorStoredIndex=$(( floorStoredIndex + 1 ))
							[ "$floorStoredSource" = "$checkSource" ] || continue
							[ ! -f "$waitStateDir/base.$floorStoredIndex" ] || cp "$waitStateDir/base.$floorStoredIndex" "$waitDir/base.$floorIndex"
							break
						done
					fi
				;;
			esac
		done
		## The stored baselines are taken over above; what is stored again is this wait's own.
		[ "$waitMode" != "default" ] || rm -f "$waitStateDir"/base.* 2>/dev/null || true

		local waitRound=0 waitOutcome="TIMEOUT" waitHits=""
		local waitProbeFailures="" waitReadSources="" waitRemindNext=0 waitProbedAt=() waitDeferred="" waitReturned=""
		## What the other sources of this wait read, for the floor to leave to them (AgentsWaitCoveredSet).
		agentsWaitCovered="?" ; agentsWaitCoverSources="$waitSources"
		while : ; do
			waitRound=$(( waitRound + 1 ))
			## A wait whose directory was taken from under it reads nothing any more: it ends here (AgentsWaitLost).
			if AgentsWaitLost "$waitDir" ; then waitOutcome="LOST" ; break ; fi
			local roundSource roundKind roundTarget roundFn roundIndex=0 roundRc roundEvery roundNow roundTtl roundSlowGap=""
			roundNow="$( date +%s )"
			for roundSource in $waitSources ; do
				roundIndex=$(( roundIndex + 1 ))
				roundKind="${roundSource%%:*}"
				roundTarget="${roundSource#*:}"
				roundFn="$( AgentsWaitProbeFunctionName "$roundKind" )"
				roundEvery="${agentsWaitKindEvery#*"$roundKind:"}"
				roundEvery="${roundEvery%% *}"
				## A kind the list does not name is read every round.
				case "$roundEvery" in ''|*[!0-9]*) roundEvery=1 ;; esac
				[ "$waitRound" = "1" ] || [ $(( ( waitRound - 1 ) % roundEvery )) = "0" ] || continue
				## THE TTL of the source (AgentsWaitTtlOf): while its previous check is inside it, the source is skipped on this
				## pass. The first round reads every source, so a quiet wait still reads each once.
				if [ "$waitRound" != "1" ] ; then
					case "$roundKind" in
						tagged|scan|mentions)
							roundTtl="$( AgentsWaitTtlOf "$roundSource" )"
							[ "$roundTtl" = "0" ] || [ $(( roundNow - ${waitProbedAt[$roundIndex]:-0} )) -ge "$roundTtl" ] || continue
						;;
					esac
				fi
				## THE TICK AND THE SLOW LOOK: a local source is read every tick, a costly one only once the slow gap has
				## passed -- the gap that was the wait's own poll before, from the same activity, so the requests the
				## team's Slack budget pays for are no more than they were. Read once, and only when a costly source is
				## actually due, so a quiet tick over local files spends nothing on the activity reading either.
				if [ "$waitBackoff" = "true" ] && [ "$waitRound" != "1" ] ; then
					case " $agentsWaitKindLocal " in
						*" $roundKind "*) ;;
						*)
							[ -n "$roundSlowGap" ] || { waitActivity="$( AgentsWaitNewestActivity "$waitStart" "$waitSessionId" "$waitSources" "$waitFloorsUsed" )" ; roundSlowGap="$( AgentsWaitBackoffNap "$roundNow" "${waitActivity%%$'\t'*}" )" ; }
							[ $(( roundNow - ${waitProbedAt[$roundIndex]:-0} )) -ge "$roundSlowGap" ] || continue
						;;
					esac
				fi
				## THE BOUND IS KEPT BETWEEN SOURCES, once something has arrived. A round that has an arrival in hand and finds the bound
				## passed ends before the next source is probed, and returns what it has: the arrival is not held for the rest of the round.
				## The sources not reached show in WAIT-NEVER-READ. A probe already running is never cut short, and a round with nothing
				## in hand reads every source, as it always did: a quiet round that stopped at the bound would never reach the sources
				## at its tail, whatever they are, and that is a matter of the order of the sources. A round that began at or after the
				## bound (a zero-bound read) reads every source.
				if [ "$waitOutcome" = "RECEIVED" ] && [ -n "$waitDeadline" ] && [ "$roundNow" -lt "$waitDeadline" ] && [ "$( date +%s )" -ge "$waitDeadline" ] ; then
					break
				fi
				## A scan takes minutes, so one that has not begun is not begun once something has arrived in this round (the arrival wakes
				## the caller, and the scan is read at the next wait, its report being compared with the one last given), nor once the
				## bound has passed in it. It then shows in WAIT-NEVER-READ.
				if [ "$roundKind" = "scan" ] && { [ "$waitOutcome" = "RECEIVED" ] || { [ -n "$waitDeadline" ] && [ "$roundNow" -lt "$waitDeadline" ] && [ "$( date +%s )" -ge "$waitDeadline" ] ; } ; } ; then
					continue
				fi
				waitProbedAt[$roundIndex]="$roundNow"

				roundRc=0
				"$roundFn" "$memberName" "$roundTarget" "${waitFloorOf[$roundIndex]}" "$waitDir/now.$roundIndex" "${waitAddressee% }" "$waitIncludeOwn" || roundRc=$?
				if [ "$roundRc" != "0" ] ; then
					## A probe that missed what this wait itself wrote is no unreachable source: the wait ends on it.
					if AgentsWaitLost "$waitDir" ; then waitOutcome="LOST" ; break ; fi
					## A probe that cannot run is reported, and the wait carries on
					## over the sources that can: one unreachable source must not
					## turn a multi-source wait into silence.
					case "$waitProbeFailures" in
						*"[$roundSource]"*) ;;
						*) waitProbeFailures="$waitProbeFailures[$roundSource] " ;;
					esac
					continue
				fi
				## Which sources were read at least once, so the TIMEOUT text claims a read only for those.
				case "$waitReadSources" in
					*"[$roundSource]"*) ;;
					*) waitReadSources="$waitReadSources[$roundSource] " ;;
				esac

				## A rendering that is not there differs from every baseline, and is no arrival.
				AgentsWaitOwnFile "$waitDir/now.$roundIndex" || { waitOutcome="LOST" ; break ; }
				## What a look at the posts found nothing to return is stored at once, and what it found once it is said.
				if [ "$roundKind" = "replies" ] && [ ! -s "$waitDir/now.$roundIndex" ] ; then
					AgentsWaitRepliesCommit "$roundTarget" "$waitDir/now.$roundIndex.advance"
				fi
				## The same for the session chat file: a look that found nothing to return moved past what it read (the covered, the not its own).
				if [ "$roundKind" = "chat" ] && [ ! -s "$waitDir/now.$roundIndex" ] ; then
					AgentsWaitChatCommit "$roundTarget" "$memberName" "$waitDir/now.$roundIndex.newest"
				fi
				if [ ! -f "$waitDir/base.$roundIndex" ] ; then
					if [ "$waitBaselineMode" = "empty" ] || case " $agentsWaitKindEmptyBaseline " in *" $roundKind "*) true ;; *) false ;; esac ; then
						: > "$waitDir/base.$roundIndex"
					else
						cp "$waitDir/now.$roundIndex" "$waitDir/base.$roundIndex" 2>/dev/null || : > "$waitDir/base.$roundIndex"
						continue
					fi
				fi

				## THE WAKE MARKER IS NO ARRIVAL OF ITS OWN (AgentsTools.WakeMarker.include). One of our own members
				## posted a message to this one, and what the marker says is not what a member is to read. So it is
				## taken as read -- its rendering becomes its baseline -- and every source is read again at once,
				## the costly kinds included, so that the message itself is returned by this call in about a second
				## instead of at the next slow look. The marker is read at every tick, so this costs no request.
				if [ "$roundKind" = "wake" ] ; then
					if ! cmp -s "$waitDir/base.$roundIndex" "$waitDir/now.$roundIndex" ; then
						cp "$waitDir/now.$roundIndex" "$waitDir/base.$roundIndex" 2>/dev/null || : > "$waitDir/base.$roundIndex"
						waitWakeSeen=1
					fi
					continue
				fi

				## Every source is scanned, and every one that changed is returned, not the first.
				## A kind whose rendering holds arrivals only has nothing to return while that rendering
				## is empty: what stood there was taken -- an answer its asker read moves the floor of
				## its thread past it -- or taken back, and neither is an arrival.
				if ! cmp -s "$waitDir/base.$roundIndex" "$waitDir/now.$roundIndex" \
					&& { [ -s "$waitDir/now.$roundIndex" ] || case " $agentsWaitKindEmptyBaseline " in *" $roundKind "*) false ;; *) true ;; esac ; } \
					&& case " $agentsWaitKindArrivalsOnly " in
						*" $roundKind "*) LC_ALL=C awk 'FILENAME == ARGV[1] { seen[$0] = 1 ; next } !( $0 in seen ) { added = 1 ; exit } END { exit !added }' "$waitDir/base.$roundIndex" "$waitDir/now.$roundIndex" ;;
						*) true ;;
					esac ; then
					if [ -n "$waitCollect" ] && [ "$roundKind" != "tagged" ] && [ "$roundKind" != "mentions" ] ; then
						## In a collect only the tags are immediate: every other source accumulates until the window ends.
						case " $waitDeferred" in *" $roundIndex=$roundSource "*) ;; *) waitDeferred="$waitDeferred$roundIndex=$roundSource " ;; esac
					else
						waitOutcome="RECEIVED"
						waitHits="$waitHits$roundIndex=$roundSource "
						[ -z "$waitCollect" ] || waitReturned="immediate"
					fi
				fi
			done
			[ "$waitOutcome" != "LOST" ] || break
			[ "$waitOutcome" != "RECEIVED" ] || break
			## Unbounded, a first round that could read no source at all returns at once rather
			## than wait forever on sources nothing is known about: TIMEOUT with WAIT-NEVER-READ.
			[ -n "$waitDeadline" ] || [ -n "$waitReadSources" ] || break

			## THE MARKER WAS WRITTEN: read every source again now, the costly kinds included, and do not sleep
			## first -- that immediate re-read is the whole point of the marker. THE SCANS COME FORWARD WITH THE
			## REST: a scan is where a duty's own arrivals are read from, and without this a message waits for the
			## table's 300s (or for the end of the session's wait round, whichever comes first) -- the five minutes
			## the owner reported. THE COST IS BOUNDED BY THE MESSAGES, NOT BY THE TICK: the marker is written by a
			## send alone, one line per message, and the round that reads it takes it as read (its rendering becomes
			## its baseline), so a message buys at most one extra run -- a scan of minutes, once per message, where
			## a tick would run it sixty times a minute. An unchanged scan is still left to its TTL, which is what
			## the TTL is for.
			if [ -n "$waitWakeSeen" ] ; then
				waitWakeSeen=""
				local waitWakeAt=0 waitWakeSource
				for waitWakeSource in $waitSources ; do
					waitWakeAt=$(( waitWakeAt + 1 ))
					waitProbedAt[$waitWakeAt]=0
				done
				continue
			fi

			local waitNow waitRemaining waitNap
			waitNow="$( date +%s )"
			## The asks this wait stands for are reminded from here (AgentsWaitRemind): after a
			## round that brought nothing, and at most once a minute.
			if [ "$waitNow" -ge "$waitRemindNext" ] ; then
				waitRemindNext=$(( waitNow + 60 ))
				AgentsWaitRemind "$waitSessionId" "$waitSources" "$waitDir" || :
			fi
			if [ -n "$waitDeadline" ] && [ "$waitNow" -ge "$waitDeadline" ] ; then
				break
			fi
			## THE NAP IS THE TICK. A local source was read this round and is read again in a second; a costly one
			## waits for its own slow gap, which the round gate above holds it to, so no read of the team's Slack
			## budget is made more often than before. A caller's own interval (waitBackoff false) is the nap, as it
			## always was.
			waitNap="$waitPoll"
			if [ -n "$waitDeadline" ] ; then
				waitRemaining=$(( waitDeadline - waitNow ))
				[ "$waitNap" -le "$waitRemaining" ] || waitNap="$waitRemaining"
			fi
			## The only thing this process does between probes. No spin, no token.
			sleep "$waitNap"
		done

		## A COLLECT ends on its window or on an immediate arrival, whichever came first, and returns everything accumulated
		## with either: the sources that changed, the tags that ended it among them.
		if [ -n "$waitCollect" ] && [ "$waitOutcome" != "LOST" ] ; then
			if [ "$waitOutcome" = "RECEIVED" ] || [ -n "$waitDeferred" ] ; then
				local collectAll="" collectAt=0 collectOne
				for collectOne in $waitSources ; do
					collectAt=$(( collectAt + 1 ))
					case " $waitHits $waitDeferred" in *" $collectAt=$collectOne "*) collectAll="$collectAll$collectAt=$collectOne " ;; esac
				done
				waitHits="$collectAll"
				waitOutcome="RECEIVED"
			fi
			[ -n "$waitReturned" ] || waitReturned="window"
		fi

		## BURST SETTLE. An arrival on a Slack source is rarely alone: a person sends two or
		## three lines in a row. Returning on the first and leaving the rest to the next call
		## costs a round trip each, and before floors were lossless it lost them outright. So
		## the Slack sources are re-read after a short settle, again while more keeps coming,
		## up to a small cap; every source that differs from its baseline then is returned,
		## each rendering whole and oldest first. A re-read that fails keeps what was read.
		local settleSeconds="${MDAT_WAIT_SETTLE_SECONDS:-3}" settleRounds="${MDAT_WAIT_SETTLE_ROUNDS:-3}" settleRound=0 settleChanged settleSlackHit="false" settleIndex settleSource settleRc settleRead=""
		case "$settleSeconds" in ''|*[!0-9]*) settleSeconds=3 ;; esac
		case "$settleRounds" in ''|*[!0-9]*) settleRounds=3 ;; esac
		case " $waitHits" in *"=slack:"*) settleSlackHit="true" ;; esac
		while [ "$waitOutcome" = "RECEIVED" ] && [ "$settleSlackHit" = "true" ] && [ -z "$waitCollect" ] && [ "$settleSeconds" -gt 0 ] && [ "$settleRound" -lt "$settleRounds" ] ; do
			settleRound=$(( settleRound + 1 ))
			sleep "$settleSeconds"
			settleChanged="false"
			settleIndex=0
			for settleSource in $waitSources ; do
				settleIndex=$(( settleIndex + 1 ))
				case "$settleSource" in slack:*) ;; *) continue ;; esac
				settleRc=0
				AgentsWaitProbeSlack "$memberName" "${settleSource#slack:}" "${waitFloorOf[$settleIndex]}" "$waitDir/settle.$settleIndex" "${waitAddressee% }" "$waitIncludeOwn" || settleRc=$?
				if [ "$settleRc" != "0" ] ; then
					! AgentsWaitLost "$waitDir" || { waitOutcome="LOST" ; break ; }
					continue
				fi
				AgentsWaitOwnFile "$waitDir/settle.$settleIndex" || { waitOutcome="LOST" ; break ; }
				case " $settleRead " in *" $settleIndex "*) ;; *) settleRead="$settleRead $settleIndex" ;; esac
				if [ -f "$waitDir/now.$settleIndex" ] && cmp -s "$waitDir/now.$settleIndex" "$waitDir/settle.$settleIndex" ; then
					continue
				fi
				mv -f "$waitDir/settle.$settleIndex" "$waitDir/now.$settleIndex" || continue
				[ -f "$waitDir/base.$settleIndex" ] || : > "$waitDir/base.$settleIndex"
				settleChanged="true"
			done
			[ "$settleChanged" = "true" ] || break
		done
		## Hits in source order: every earlier hit, and every Slack source a settle re-read
		## successfully that now differs from its baseline.
		if [ "$waitOutcome" = "RECEIVED" ] && [ "$settleRound" -gt 0 ] ; then
			local settleHits=""
			settleIndex=0
			for settleSource in $waitSources ; do
				settleIndex=$(( settleIndex + 1 ))
				case " $waitHits" in
					*" $settleIndex=$settleSource "*) settleHits="$settleHits$settleIndex=$settleSource " ; continue ;;
				esac
				case " $settleRead " in *" $settleIndex "*) ;; *) continue ;; esac
				cmp -s "$waitDir/base.$settleIndex" "$waitDir/now.$settleIndex" || settleHits="$settleHits$settleIndex=$settleSource "
			done
			waitHits="$settleHits"
		fi

		## What is returned is read from the renderings, so each of them is there before a result is said.
		if [ "$waitOutcome" = "RECEIVED" ] ; then
			local waitLostHit
			for waitLostHit in $waitHits ; do
				AgentsWaitOwnFile "$waitDir/now.${waitLostHit%%=*}" || { waitOutcome="LOST" ; break ; }
			done
		fi
		if [ "$waitOutcome" = "LOST" ] ; then
			echo "WAIT-RESULT: ERROR"
			if [ -d "$waitDir" ] ; then
				printf 'missed: %s\nat: %s\n' "$agentsWaitLost" "$( date -u +%Y-%m-%dT%H:%M:%SZ )" > "$waitDir/kept" 2>/dev/null || true
				echo "⛔ ERROR: $MDSC_CMD --wait-for-input: $agentsWaitLost, which a step of this wait wrote, is not there to be read. The wait ended at once, and its working directory is kept as it stands for whoever looks into it: $waitDir. Nothing that arrived is taken as read: wait again." >&2
			else
				echo "⛔ ERROR: $MDSC_CMD --wait-for-input: the working directory of this wait, $waitDir, is gone: something other than this wait removed it. The wait ended at once. Nothing that arrived is taken as read: wait again." >&2
			fi
			set +e ; return 1
		fi

		local waitEnd waitElapsed
		waitEnd="$( date +%s )"
		waitElapsed=$(( waitEnd - waitStart ))

		local waitNeverRead="" waitOneSource
		for waitOneSource in $waitSources ; do
			case "$waitReadSources" in
				*"[$waitOneSource]"*) ;;
				*) waitNeverRead="$waitNeverRead[$waitOneSource] " ;;
			esac
		done

		## THE SEEN REACTION IS THE TOOLING'S, NOT THE AGENT'S (epic S11.2): every message a person wrote that this wait returns gets an eyes reaction at once, in
		## its own conversation, by the identity that can reach it (the member's, else the bot's), without the agent passing seen=. A reaction that fails is an
		## error in the header; it never stops the wait.
		## COMMITTED BEFORE IT IS SAID. What a RECEIVED result carries -- the newest ts of each slack source, the replies, the session chat, the scan -- is stored before the first
		## line of the result is printed: a caller that is gone or moved to the background once the result is out has its floors in the state, and the next wait does not return it again.
		if [ "$waitOutcome" = "RECEIVED" ] ; then
			local commitHit commitIndex commitTs
			for commitHit in $waitHits ; do
				commitIndex="${commitHit%%=*}"
				case "${commitHit#*=}" in
					replies:*) AgentsWaitRepliesCommit "${commitHit#*=replies:}" "$waitDir/now.$commitIndex.advance" ;;
					chat:*) AgentsWaitChatCommit "${commitHit#*=chat:}" "$memberName" "$waitDir/now.$commitIndex.newest" ;;
					scan:*) AgentsWaitScanCommit "$memberName" "${commitHit#*=scan:}" "$waitDir/now.$commitIndex.sum" ;;
					mentions:*) AgentsWaitMentionsCommit "$memberName" "$waitDir/now.$commitIndex.newest" ;;
					slack:*)
						commitTs="$( LC_ALL=C awk '/^[0-9]+\.[0-9]+ \| / { ts = $1; } END { if (ts != "") print ts; }' "$waitDir/now.$commitIndex" )"
						[ -z "$commitTs" ] || waitFloorNew[$commitIndex]="$commitTs"
					;;
				esac
			done
		fi
		AgentsWaitStateStore || echo "# NOTE: the state of this wait could not be stored under $waitStateDir, so --wait-continue will not find it." >&2

		local seenIds="" seenOk=0 seenFailed="" seenOne seenFile seenKind seenSource seenOwnId=""
		## Not for a call that reacts to what it takes itself (an asking call, MDAT_WAIT_SEEN_OWN), nor for a call that keeps no state (the tooling's own internal waits).
		## A collect is a delivery too: the work-duty scan reads a member's sources through it, and what it returns is what the duty is handed. Sketch 12.3 (settled): eyes goes on when the member is handed the message.
		if [ "$waitOutcome" = "RECEIVED" ] && { [ -n "$waitMode" ] || [ -n "$waitCollect" ] ; } && [ -z "${MDAT_WAIT_SEEN_OWN:-}" ] ; then
			type AgentsToolsSeenReact > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.SeenReaction.include"
			type AgentsToolsSessionChatMemberId > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionChat.include" 2> /dev/null || :
			seenOwnId="$( AgentsToolsSessionChatMemberId "$memberName" 2> /dev/null )" || seenOwnId=""
			for seenOne in $waitHits ; do
				seenSource="${seenOne#*=}" ; seenKind="${seenSource%%:*}" ; seenFile="$waitDir/now.${seenOne%%=*}"
				case "$seenKind" in slack|ask|replies|tagged|mentions) ;; *) continue ;; esac
				[ -f "$seenFile" ] || continue
				seenIds="$seenIds$( AgentsWaitSeenIds "$memberName" "$seenSource" "$seenFile" "$seenOwnId" ) "
			done
			for seenOne in $( printf '%s\n' $seenIds | LC_ALL=C sort -u ) ; do
				## The store of seen messages (AgentsTools.SeenReaction.include): a message handed over before, by a Wait or a collect, is not reacted to again.
				if AgentsToolsSeenReact "$memberName" "$seenOne" ; then
					seenOk=$(( seenOk + 1 ))
				else
					seenFailed="$seenFailed$seenOne "
				fi
			done
		fi

		echo "WAIT-RESULT: $waitOutcome"
		[ -z "$waitMode" ] || echo "WAIT-MODE: $waitMode"
		[ -z "$seenFailed" ] || echo "# ERROR: the seen reaction (eyes) failed on ${seenFailed% }, so those messages show no sign that they were read"
		[ -z "$waitNeverRead" ] || echo "WAIT-NEVER-READ: ${waitNeverRead% }"
		if [ -n "$waitMode" ] ; then
			echo "# filters: sources=${waitSources% } floors=${waitFloorsUsed% } addressee=${waitAddressee% } include-own=$waitIncludeOwn"
			if [ "$waitMode" = "default" ] ; then
				local headerThread=""
				type AgentsToolsSessionCurrentThreadFind > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SpawnSandbox.include" 2> /dev/null || :
				headerThread="$( AgentsToolsSessionCurrentThreadFind 2>/dev/null )" || headerThread=""
				if [ -n "$headerThread" ] ; then
					echo "# session thread: $headerThread, the one on record for this session"
				else
					echo "# session thread: none on record for this session, so its defaults are the team channel and the owner DM alone"
				fi
			fi
			echo "# reactions: $reactSummary"
		fi
		echo "# member: $memberName"
		echo "# sources: ${waitSources% }"
		[ -z "$waitAddressee" ] || echo "# answers counted only from: ${waitAddressee% }"
		local waitBoundText="no bound"
		[ -z "$waitTimeout" ] || waitBoundText="${waitTimeout}s bound"
		local waitPollText="${waitPoll}s"
		if [ "$waitBackoff" = "true" ] ; then
			## Honest about both cadences: the tick, and the slow gap of the costly sources with the newest activity it
			## counted from and how long before the end -- the same activity, and so the same gap, as the old poll.
			waitActivity="$( AgentsWaitNewestActivity "$waitStart" "$waitSessionId" "$waitSources" "$waitFloorsUsed" )"
			waitPollText="${waitPoll}s tick for local sources, costly ones by backoff from 5s, cap 300s, since the newest activity (${waitActivity#*$'\t'}) $(( waitEnd - ${waitActivity%%$'\t'*} ))s before the end"
		fi
		echo "# waited: ${waitElapsed}s of ${waitBoundText}, ${waitRound} poll round(s) at $waitPollText, baseline: $waitBaselineMode"
		[ -z "$waitProbeFailures" ] || echo "# probes that could not run this wait (their diagnostics are on stderr): ${waitProbeFailures% }"

		[ -z "$waitCollect" ] || echo "# returned: $waitReturned"

		case "$waitOutcome" in
			RECEIVED)
				local waitHit waitHitIndex waitLastTs waitLastLines="" waitHitKind waitHitFile
				## THE FLOOR FIRST, then all the rest together in one group sorted by time, each message naming the source it
				## came from and consecutive messages of one source under one block (AgentsWaitArrivalsOrder.awk).
				: > "$waitDir/rest.manifest"
				for waitHit in $waitHits ; do
					waitHitIndex="${waitHit%%=*}"
					waitHitKind="${waitHit#*=}" ; waitHitKind="${waitHitKind%%:*}"
					case " $agentsWaitKindFloor " in
						*" $waitHitKind "*)
							if [ "$waitHitKind" = "chat" ] ; then
								## The messages of the session thread come each behind the source it is of (`# via <source>`).
								LC_ALL=C awk '
									/^# via / { if ( open ) { print "# --- end ---" ; } print "# arrived on: " substr($0, 7) ; print "# --- what that source holds now follows ---" ; open = 1 ; next ; }
									{ print ( $0 ~ /^(WAIT-|# --- |# arrived on: )/ ? " " $0 : $0 ) ; }
									END { if ( open ) { print "# --- end ---" ; } }' "$waitDir/now.$waitHitIndex"
							else
								echo "# arrived on: ${waitHit#*=}"
								echo "# --- what that source holds now follows ---"
								## A line of the source's own content never reads as a line of this wait's: one that
								## starts as a section mark, as `# arrived on: ` or as `WAIT-` is printed one space in.
								## Read as the wait's own, three such lines typed into a watched conversation closed
								## a question there with somebody else's next message as its answer.
								LC_ALL=C awk '{ print ( $0 ~ /^(WAIT-|# --- |# arrived on: )/ ? " " $0 : $0 ) ; }' "$waitDir/now.$waitHitIndex"
								echo "# --- end ---"
							fi
						;;
						*)
							## A source added in its short or its full form is served as that (AgentsWaitSourceModeApply).
							waitHitFile="$waitDir/now.$waitHitIndex"
							if [ -n "$( AgentsWaitModeOf "${waitHit#*=}" )" ] && AgentsWaitSourceModeApply "$memberName" "${waitHit#*=}" "$( AgentsWaitModeOf "${waitHit#*=}" )" "$waitHitFile" "$waitDir/mode.$waitHitIndex" ; then
								waitHitFile="$waitDir/mode.$waitHitIndex"
							fi
							printf '%s\t%s\t%s\n' "$waitHitIndex" "${waitHit#*=}" "$waitHitFile" >> "$waitDir/rest.manifest"
						;;
					esac
				done
				[ ! -s "$waitDir/rest.manifest" ] || LC_ALL=C awk -v manifest="$waitDir/rest.manifest" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsWaitArrivalsOrder.awk" < /dev/null
				## The line that reads a cut message in full stands once in a return, not once for each message.
				[ -z "$( ls "$waitDir"/mode.*.cut 2> /dev/null )" ] || echo "# short forms: read one in full with --slack-read $memberName <source>:<ts> --thread, the source and ts as the message shows them"
				## What the wait has said is stored, and the last ts of each Slack source named.
				for waitHit in $waitHits ; do
					waitHitIndex="${waitHit%%=*}"
					case "${waitHit#*=}" in
						replies:*) AgentsWaitRepliesCommit "${waitHit#*=replies:}" "$waitDir/now.$waitHitIndex.advance" ;;
						chat:*) AgentsWaitChatCommit "${waitHit#*=chat:}" "$memberName" "$waitDir/now.$waitHitIndex.newest" ;;
						scan:*) AgentsWaitScanCommit "$memberName" "${waitHit#*=scan:}" "$waitDir/now.$waitHitIndex.sum" ;;
						mentions:*) AgentsWaitMentionsCommit "$memberName" "$waitDir/now.$waitHitIndex.newest" ;;
					esac
					## A slack rendering carries one "<ts> | ..." message head per line, in ts
					## order; that newest ts is named, and is the floor a continued wait takes.
					## A file, inbox or board listing has no per-message ts, so it names none.
					case "${waitHit#*=}" in
						slack:*)
							waitLastTs="$( LC_ALL=C awk '/^[0-9]+\.[0-9]+ \| / { ts = $1; } END { if (ts != "") print ts; }' "$waitDir/now.$waitHitIndex" )"
							[ -n "$waitLastTs" ] || continue
							waitFloorNew[$waitHitIndex]="$waitLastTs"
							## One hit reads as it always did; several name the source each ts belongs to.
							if [ -z "${waitHits#* }" ] ; then
								waitLastLines="WAIT-LAST-TS: $waitLastTs"
							else
								waitLastLines="${waitLastLines}WAIT-LAST-TS: ${waitHit#*=} $waitLastTs"$'\n'
							fi
						;;
					esac
				done
				[ -z "$waitLastLines" ] || printf '%s\n' "${waitLastLines%$'\n'}"
				## A collect keeps where each Slack source and the tags got to, the last message it returned: the pointer of the
				## session (`collect:<member>:<source>`) the next collect resumes from.
				if [ -n "$waitCollect" ] && [ -n "$collectKey" ] ; then
					for waitHit in $waitHits ; do
						waitHitIndex="${waitHit%%=*}"
						case "${waitHit#*=}" in slack:*|tagged:*) ;; *) continue ;; esac
						waitLastTs="$( LC_ALL=C awk '/^[0-9]+\.[0-9]+ \| / { if ( ts == "" || $1 + 0 > ts + 0 ) { ts = $1 ; } } END { if (ts != "") print ts; }' "$waitDir/now.$waitHitIndex" )"
						[ -z "$waitLastTs" ] || AgentsToolsSessionChatPointerSet "$collectKey" "collect:$memberName:${waitHit#*=}" "$waitLastTs"
					done
				fi
			;;
			## TIMEOUT carries no prose: that it is a normal, successful outcome is stated once, in
			## the Wait tool description, and a source never read is named by WAIT-NEVER-READ above.
		esac

		## Stored again at the end, whatever the commit before the return said: the same state.
		AgentsWaitStateStore || { rm -rf "$waitDir" 2>/dev/null || true ; return 0 ; }

		rm -rf "$waitDir" 2>/dev/null || true
		return 0
	;;

		*)
			echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
			set +e ; return 1
		;;
esac
