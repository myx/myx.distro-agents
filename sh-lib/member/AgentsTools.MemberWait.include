#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

## AgentsTools.MemberWait.include -- --wait-for-input: one bounded poll over input sources, returning when any changes. Its contract and the source adapters are in MAGIC.md, "The Wait includes".

type AgentsToolsSessionPauseWait > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionPause.include"

## The kinds this build carries, one word per adapter, in the order they are offered to a caller.
agentsWaitSourceKinds="slack file inbox board ask replies chat checklist scan tagged dms mentions process wake"
agentsWaitKindEvery="slack:1 file:1 inbox:1 board:1 ask:1 replies:1 chat:1 checklist:1 scan:1 tagged:1 dms:1 mentions:1 process:1 wake:1"
## The tick and the slow look: local sources are read every second, and sources that cost a request are read on the slow gap.
agentsWaitKindLocal="file inbox board process chat replies checklist wake"
## The local kinds minus chat and replies, which still make a real Slack call and need the bound wrapper.
agentsWaitKindUnbounded="file inbox board process checklist wake"
## The seconds of the tick, when no interval was named: an arrival in a local source is woken on within it.
agentsWaitTickSeconds=10
## The fallback nap of a wait that is woken by pokes (AgentsToolsWakePoke): the seconds it naps when no interval was named and none of its sources is a file,
## a process or an ask, which no writer pokes. The chat file and the wake marker end the nap at once, so only a writer that does not poke waits this long.
agentsWaitIdleSeconds="${MDAT_WAIT_IDLE_SECONDS:-30}"
## Kinds whose rendering holds arrivals only start from an empty baseline, so an arrival already there returns at once.
## The inbox is among them: an item standing in incoming/ when a wait begins is input not yet handled, so it arrives at once rather
## than being taken as the baseline of a fresh wait (a member busy while four items came found nothing on its idle wait).
agentsWaitKindEmptyBaseline="ask replies chat scan tagged dms mentions inbox"
## The kinds of THE FLOOR: delivered ahead of every other source of a return, and by every plain Wait.
agentsWaitKindFloor="replies chat"
## Kinds whose rendering is a list of arrivals from a floor, so an item taken away is no arrival.
agentsWaitKindArrivalsOnly="inbox"
## How far a floor may lead this host's clock, in seconds. A floor further ahead is refused before anything is waited on.
agentsWaitFloorAhead=300

. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.MemberWaitCore.include"

## Writes the check times of the wait's costly sources to the session's probed file, one line a source, where any changed. Run in the wait's own scope.
AgentsWaitProbedFlush(){
	[ -n "${waitProbedFile:-}" ] && [ -n "${waitProbedDirty:-}" ] || return 0
	local flushTmp flushSource flushIndex=0 flushKeep="" flushLines=""
	for flushSource in $waitSources ; do
		flushIndex=$(( flushIndex + 1 ))
		case "${flushSource%%:*}" in tagged|scan|mentions|dms|slack) ;; *) continue ;; esac
		case "${waitProbedAt[$flushIndex]:-}" in ''|*[!0-9]*) continue ;; esac
		flushKeep="$flushKeep[$flushSource]"
		flushLines="$flushLines$flushSource"$'\t'"${waitProbedAt[$flushIndex]}"$'\n'
	done
	if [ -n "$flushLines" ] && mkdir -p "$waitStateDir" 2> /dev/null && flushTmp="$( mktemp "$waitProbedFile.XXXXXX" 2> /dev/null )" ; then
		{ LC_ALL=C awk -F'\t' -v keep="$flushKeep" 'index(keep, "[" $1 "]") == 0' "$waitProbedFile" 2> /dev/null ; printf '%s' "$flushLines" ; } > "$flushTmp" 2> /dev/null \
			&& mv -f "$flushTmp" "$waitProbedFile" 2> /dev/null || rm -f "$flushTmp" 2> /dev/null
	fi
	waitProbedDirty="" waitProbedFlushedAt="$SECONDS"
}

## A wait on its floor alone is idle: the mark of its run is rewritten as idle in the round it holds.
AgentsWaitActivityIdle(){ ## the sources of the wait, as they stand after the floor is added
	local idleFile="${MMDAPP:-/nonexistent}/.local/agents/sessions/${MDAT_SPAWN_SESSION_ID:-/}/activity" idleLine="" idleDefaults idleOne
	[ -n "${MDAT_SPAWN_SESSION_ID:-}" ] && [ -f "$idleFile" ] || return 0
	IFS= read -r idleLine < "$idleFile" || :
	[ "${idleLine#* * }" = "tool Wait" ] || return 0
	type AgentsToolsWaitDefaultSources > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SpawnSandbox.include" 2> /dev/null || :
	idleDefaults=" slack:magic-team slack:human-owner $( AgentsToolsWaitDefaultSources 2> /dev/null | LC_ALL=C tr '\n' ' ' ) "
	for idleOne in $1 ; do
		case "$idleOne" in replies:*|chat:*|dms:*|mentions:*|wake:*|scan:*|tagged:*|inbox:*|board:*|checklist*) continue ;; esac
		case "$idleDefaults" in *" $idleOne "*) continue ;; esac
		return 0
	done
	printf '%s %s idle\n' "${idleLine%% *}" "$( date +%s 2> /dev/null )" > "$idleFile.$$" 2> /dev/null && mv -f "$idleFile.$$" "$idleFile" 2> /dev/null || rm -f "$idleFile.$$" 2> /dev/null
	return 0
}

AgentsWaitStateStore(){
	AgentsWaitProbedFlush
	if [ -n "$waitMode" ] ; then
		local waitStateTmp
		mkdir -p "$waitStateDir" && waitStateTmp="$( mktemp "$waitStateDir/state.XXXXXX" )" || {
			echo "# NOTE: the state of this wait could not be stored under $waitStateDir, so --wait-continue will not find it." >&2
			return 1
		}
			## What is stored is what is still open: a closed ask leaves the stored wait, and a kept source keeps its base and floor files.
			local waitKeepList waitKeepAt waitKeepCount=0 storeIndex=0 storeAsk="" storeSource
			for storeSource in $waitSources ; do
				storeIndex=$(( storeIndex + 1 ))
				case "$storeSource" in
					ask:*)
						storeAsk="$( LC_ALL=C awk 'NR > 1 && $0 == "---" { exit } index($0, "status: ") == 1 { print substr($0, 9) ; exit }' \
							"$MMDAPP/.local/agents/pending/${storeSource#ask:}.md" 2> /dev/null )" || storeAsk=""
						if [ "$storeAsk" != "reply-pending" ] ; then
							## A closed ask the caller named is stored with its own base, so a later call naming it again stays quiet.
							case " $waitNamedSources " in *" $storeSource "*) ;; *) continue ;; esac
						fi
					;;
				esac
				waitKeepCount=$(( waitKeepCount + 1 ))
				waitKeepList[$waitKeepCount]="$storeSource"
				waitKeepAt[$waitKeepCount]="$storeIndex"
			done
			{
				printf 'sources:'
				storeIndex=0
				while [ "$storeIndex" -lt "$waitKeepCount" ] ; do
					storeIndex=$(( storeIndex + 1 ))
					printf ' %s' "${waitKeepList[$storeIndex]}"
				done
				printf '\n'
				echo "addressee: $waitAddressee"
				echo "include-own: $waitIncludeOwn"
				storeIndex=0
				while [ "$storeIndex" -lt "$waitKeepCount" ] ; do
					storeIndex=$(( storeIndex + 1 ))
					storeSource="${waitKeepList[$storeIndex]}"
					[ -z "$( AgentsWaitModeOf "$storeSource" )" ] || echo "mode $storeSource $( AgentsWaitModeOf "$storeSource" )"
					[ -z "$( AgentsWaitTtlOwn "$storeSource" )" ] || echo "ttl $storeSource $( AgentsWaitTtlOwn "$storeSource" )"
				done
				storeIndex=0
				while [ "$storeIndex" -lt "$waitKeepCount" ] ; do
					storeIndex=$(( storeIndex + 1 ))
					storeSource="${waitKeepList[$storeIndex]}"
					case "$storeSource" in
						slack:*) echo "floor $storeSource ${waitFloorNew[${waitKeepAt[$storeIndex]}]:-${waitFloorOf[${waitKeepAt[$storeIndex]}]}}" ;;
						## A tag, a DM and a mention keep their floor here too, or each call starts at its own start.
						tagged:*|dms:*|mentions:*)
							local storeNewestTs=""
							storeNewestTs="$( LC_ALL=C awk '/^[0-9]+\.[0-9]+ \| / { if ( ts == "" || $1 + 0 > ts + 0 ) { ts = $1 } } END { if ( ts != "" ) { print ts } }' "$waitDir/now.${waitKeepAt[$storeIndex]}" 2> /dev/null )" || :
							echo "floor $storeSource ${storeNewestTs:-${waitFloorNew[${waitKeepAt[$storeIndex]}]:-${waitFloorOf[${waitKeepAt[$storeIndex]}]}}}"
						;;
						## The replies keep their words in the record of the run's own posts, the chat file's reader in its pointers, not here.
						replies:*|chat:*) ;;
						*)
							if [ -f "$waitDir/now.${waitKeepAt[$storeIndex]}" ] ; then
								AgentsWaitCopy "$waitDir/now.${waitKeepAt[$storeIndex]}" "$waitStateDir/base.$storeIndex"
							elif [ -f "$waitDir/base.${waitKeepAt[$storeIndex]}" ] ; then
								AgentsWaitCopy "$waitDir/base.${waitKeepAt[$storeIndex]}" "$waitStateDir/base.$storeIndex"
							fi
						;;
					esac
				done
				## A floor lives only for a source of the set stored above: none of a source that is not in it is written again.
			} > "$waitStateTmp"
		mv -f "$waitStateTmp" "$waitStateDir/state"
	fi
	return 0
}

## The conversation a message's reply address is built in, for a source whose own name is not one. Empty where the source names none.
AgentsWaitAddressConv(){ ## member, source
	local addrTarget="${2#slack:}"
	case "$2" in slack:*) ;; *) return 0 ;; esac
	case "$addrTarget" in
		[CDG][A-Z0-9]*:*|[CDG][A-Z0-9]*) printf '%s' "${addrTarget%%:*}" ; return 0 ;;
		client:*) return 0 ;;
	esac
	type DistroAgentsToolsResolveTarget > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.CommsSlack.include" 2> /dev/null || return 0
	DistroAgentsToolsResolveTarget "$addrTarget" "$1" 2> /dev/null | LC_ALL=C sed -n 's/^CHANNEL=//p' | head -1
}

## The ids of the messages a person wrote in one source's rendering that a wait returned. The member's own and non-user ids are left out.
AgentsWaitSeenIds(){ ## member, source, the rendering file, the member's own Slack id
	local seenChannel=""
	## A source that keeps its own ids beside its rendering answers for itself, before any channel is worked out.
	case "$2" in chat:*) LC_ALL=C sed -n 's/^eye //p' "$3.newest" 2> /dev/null ; return 0 ;; esac
	case "${2/#slack:client:/slack:}" in
		slack:[CDG][A-Z0-9]*) seenChannel="${2#slack:}" ; seenChannel="${seenChannel%%:*}" ;;
		slack:*) type DistroAgentsToolsResolveTarget > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.CommsSlack.include" 2> /dev/null || :
			seenChannel="$( DistroAgentsToolsResolveTarget "${2#slack:}" "$1" 2> /dev/null | LC_ALL=C sed -n 's/^CHANNEL=//p' | head -1 )" ;;
		ask:*)
			local seenRecord="$MMDAPP/.local/agents/pending/${2#ask:}.md"
			[ -f "$seenRecord" ] || seenRecord="$MMDAPP/.local/agents/pending/closed/${2#ask:}.md"
			seenChannel="$( LC_ALL=C awk '/^# / { exit } index( $0, "channel: " ) == 1 { print substr( $0, 10 ) ; exit }' "$seenRecord" 2> /dev/null )"
		;;
		## THE SESSION CHAT: the ids are the probe's own, from the block numbers it read (S6.48).
		chat:*) LC_ALL=C sed -n 's/^eye //p' "$3.newest" 2> /dev/null ; return 0 ;;
		esac
	LC_ALL=C awk -v channel="$seenChannel" -v own="$4" '
		function conv( word ) { return ( word ~ /^[CDG][A-Z0-9]+$/ ) ? word : "" }
		/^# in / { w = $3 ; sub(/:.*$/, "", w) ; channel = conv( w ) ; next }
		/^# via slack:/ { w = $3 ; sub(/:.*$/, "", w) ; channel = conv( w ) ; next }
		## `# replies to your post <conversation>:<ts>`: the conversation is its sixth word, the fifth being `post`.
		/^# replies to your post / { w = $6 ; sub(/:.*$/, "", w) ; channel = conv( w ) ; next }
		/^[0-9]+\.[0-9]+ \| / { split( $0, f, " \\| " ) ; if ( channel != "" && f[2] ~ /^[UW][A-Z0-9]+$/ && f[2] != own ) { print channel ":" $1 } }' "$3"
}

## The TTL a caller gave a source, nothing for none: the table's TTL then holds.
AgentsWaitTtlOwn(){ ## source
	local ttlRest
	case "$waitTtls" in *" $1="*) ;; *) return 0 ;; esac
	ttlRest="${waitTtls#* $1=}"
	printf '%s' "${ttlRest%% *}"
}

AgentsWaitModeOf(){ ## source
	local modeRest
	case "$waitModes" in *" $1="*) ;; *) return 0 ;; esac
	modeRest="${waitModes#* $1=}"
	printf '%s' "${modeRest%% *}"
}

## The rendering <in> of a source in its form, into <out>. rc 1, <out> not made, where the source is to be served as it is.
AgentsWaitSourceModeApply(){ ## member, source, form, in, out
	local applyTarget="${2#slack:}" applyRef applySlug applyKey applyDir="" applyIndex="" applySession=""
	applyRef="$applyTarget"
	case "$applyTarget" in
		client:*:*.*) applyRef="${applyTarget%%:*}:$( printf '%s' "${applyTarget#client:}" | LC_ALL=C cut -d: -f1 )" ;;
		*:[0-9]*.*) applyRef="${applyTarget%%:*}" ;;
	esac
	applySlug="$( printf '%s' "$2" | LC_ALL=C tr -c 'A-Za-z0-9_.-' '_' )"
	type AgentsToolsSessionChatKey > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionChat.include" 2> /dev/null || return 1
	AgentsToolsSessionChatKeyInto ; applyKey="$agentsSessionChatKey"
	if [ -n "$applyKey" ] && applySession="$( AgentsToolsSessionChatDir "$applyKey" )" && mkdir -p "$applySession/sources" 2> /dev/null ; then
		applyIndex="$applySession/sources/$applySlug.md"
		applyDir="$applySession/messages/$applySlug"
	fi
	if [ "$3" = "full" ] && [ -z "$applyDir" ] ; then
		echo "# --wait-for-input: $2#full: this call has no session folder to keep the messages in, so each is returned whole" >&2
		return 1
	fi
	LC_ALL=C awk -v mode="$3" -v ref="$applyRef" -v member="$1" -v cutFlag="$5.cut" -v longBytes="${agentsReplyLongBytes:-4096}" -v dir="$( [ "$3" = full ] && printf '%s' "$applyDir" )" -v indexFile="$applyIndex" \
		-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsWaitSourceMode.awk" < "$4" > "$5" 2> /dev/null || return 1
	[ -f "$5" ]
}

## The probe function of a source kind, by a case, because the cut and tr it replaces cost three processes a call.
AgentsWaitProbeFunctionName(){
	local nameKind="$1" nameHead nameTail
	case "$nameKind" in
		slack) printf 'AgentsWaitProbeSlack' ; return 0 ;;
		file) printf 'AgentsWaitProbeFile' ; return 0 ;;
		inbox) printf 'AgentsWaitProbeInbox' ; return 0 ;;
		board) printf 'AgentsWaitProbeBoard' ; return 0 ;;
		ask) printf 'AgentsWaitProbeAsk' ; return 0 ;;
		replies) printf 'AgentsWaitProbeReplies' ; return 0 ;;
		chat) printf 'AgentsWaitProbeChat' ; return 0 ;;
		scan) printf 'AgentsWaitProbeScan' ; return 0 ;;
		tagged) printf 'AgentsWaitProbeTagged' ; return 0 ;;
		dms) printf 'AgentsWaitProbeDms' ; return 0 ;;
		mentions) printf 'AgentsWaitProbeMentions' ; return 0 ;;
		process) printf 'AgentsWaitProbeProcess' ; return 0 ;;
		wake) printf 'AgentsWaitProbeWake' ; return 0 ;;
	esac
	nameHead="$( printf '%s' "$nameKind" | cut -c1 | tr '[:lower:]' '[:upper:]' )"
	nameTail="$( printf '%s' "$nameKind" | cut -c2- )"
	printf 'AgentsWaitProbe%s%s' "$nameHead" "$nameTail"
}

## Two renderings hold the same bytes, rc 0 when they do, read by builtin in place of a cmp process a tick.
AgentsWaitSameFile(){ ## a, b
	local sameA="" sameB=""
	IFS= read -r -d '' sameA < "$1" 2> /dev/null || :
	IFS= read -r -d '' sameB < "$2" 2> /dev/null || :
	[ "$sameA" = "$sameB" ]
}

## A file is copied only where the copy differs, so a quiet call writes no baseline. rc as cp's.
AgentsWaitCopy(){ ## from, to
	[ -f "$2" ] && AgentsWaitSameFile "$1" "$2" && return 0
	cp "$1" "$2"
}

## The backoff is measured from the newest activity on what a wait watches, never from the call start alone.
AgentsWaitNewestActivity(){ ## call start (epoch), session id, sources, floors used ("<source>=<ts> ...")
	local actBest="$1" actWhat="start" actOne actSource actLine actOwn="" actOwnWhere="" actOwnTs="" actOwnSeen=""
	local actChannel actThread actQts actFollow actRecord
	for actOne in $4 ; do
		actOne="${actOne##*=}" ; actOne="${actOne%%.*}"
		case "$actOne" in ''|*[!0-9]*) continue ;; esac
		[ "$actOne" -le "$actBest" ] || { actBest="$actOne" ; actWhat="floor" ; }
	done
	if [ -n "$2" ] && [ -f "$MMDAPP/.local/agents/sessions/$2/last-own-post" ] ; then
		IFS= read -r actOwn < "$MMDAPP/.local/agents/sessions/$2/last-own-post" || :
		## The record's first line is its latest post, and its first two words are the thread and the ts.
		actOwnWhere="${actOwn%% *}" ; actOwnTs="${actOwn#* }" ; actOwnTs="${actOwnTs%% *}" ; actOwnTs="${actOwnTs%%.*}"
		case "$actOwnTs" in ''|*[!0-9]*) actOwnTs="" ;; esac
	fi
	for actSource in $3 ; do
		## Here and below, a slack source's shape is read past a client: marker.
		case "${actSource/#slack:client:/slack:}" in
			slack:*:*:conversation) actOne="${actSource#slack:}" ; [ "${actOne%:conversation}" != "$actOwnWhere" ] || actOwnSeen=1 ;;
			slack:*:*) [ "${actSource#slack:}" != "$actOwnWhere" ] || actOwnSeen=1 ;;
			slack:*) actOwnSeen=1 ;;
			## The replies to the run's own posts carry the reply to any of them.
			replies:*) actOwnSeen=1 ;;
			ask:*)
				actRecord="$MMDAPP/.local/agents/pending/${actSource#ask:}.md"
				[ -f "$actRecord" ] || actRecord="$MMDAPP/.local/agents/pending/closed/${actSource#ask:}.md"
				[ -f "$actRecord" ] || continue
				actChannel="" actThread="" actQts="" actFollow=""
				while IFS= read -r actLine ; do
					case "$actLine" in
						'channel: '*) actChannel="${actLine#channel: }" ;;
						'thread-ts: '*) actThread="${actLine#thread-ts: }" ;;
						'question-ts: '*) actQts="${actLine#question-ts: }" ;;
						'follow-floor: '*) actFollow="${actLine#follow-floor: }" ;;
						'# '*) break ;;
					esac
				done < "$actRecord"
				[ "$actChannel:$actThread" != "$actOwnWhere" ] || actOwnSeen=1
				for actOne in "$actQts" "$actFollow" ; do
					actOne="${actOne%%.*}"
					case "$actOne" in ''|*[!0-9]*) continue ;; esac
					[ "$actOne" -le "$actBest" ] || { actBest="$actOne" ; actWhat="question" ; }
				done
			;;
		esac
	done
	if [ -n "$actOwnSeen" ] && [ -n "$actOwnTs" ] && [ "$actOwnTs" -gt "$actBest" ] ; then
		actBest="$actOwnTs" ; actWhat="own-post"
	fi
	printf '%s\t%s\n' "$actBest" "$actWhat"
}

## One nap of the default backoff: 5 seconds, plus 1 for every 20 since the newest activity, capped at 300.
AgentsWaitBackoffNap(){ ## now (epoch), newest activity (epoch)
	local napSeconds=5
	[ "$1" -le "$2" ] || napSeconds=$(( 5 + ( $1 - $2 ) / 20 ))
	[ "$napSeconds" -le 300 ] || napSeconds=300
	printf '%s\n' "$napSeconds"
}

## The reminders of a wait: an ask still waiting on a person is reminded on its schedule by the wait that stands for it.
AgentsWaitRemind(){ ## session id (may be empty), sources, the wait's working directory
	local remindLine remindOut
	[ "${MDAT_WAIT_REMIND:-}" != "off" ] || return 0
	[ -z "${agentsPendingReplyRemindRunning:-}" ] || return 0
	[ -n "$1" ] || case " $2" in *" ask:"*) ;; *) return 0 ;; esac
	remindOut="$(
	(
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.PendingReplyCollect.include"
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.PendingReplyRemind.include"
		AgentsToolsPendingReplyRemindWaitRun "$1" "$2"
	) 2> /dev/null )" || {
		echo "# --wait-for-input: the reminders of this wait could not run" >&2
		return 0
	}
	while IFS= read -r remindLine ; do
		case "$remindLine" in
			'REMINDED '*|'FAILED '*|'SKIPPED '*|'HELD '*) ;;
			*) continue ;;
		esac
		LC_ALL=C grep -q -x -F -- "$remindLine" "$3/remind.said" 2> /dev/null && continue
		printf '%s\n' "$remindLine" >> "$3/remind.said"
		echo "# --wait-for-input: $remindLine" >&2
	done <<< "$remindOut"
	return 0
}

## The working directory of a wait and whose it is: stale ones of the member are swept by owner, never by age.
AgentsWaitFolderSweep(){ ## member -- keeps this shell's own `<pid> <start>` for the record (agentsWaitFolderShell)
	local sweepDir sweepOwner sweepHere sweepSelf sweepBegan sweepNow sweepAged sweepList=""
	agentsWaitFolderShell=""
	type AgentsToolsRegistryProcessesBegan > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.Registries.include" 2> /dev/null || return 0
	sweepHere="$( hostname -s 2>/dev/null )" || sweepHere="unknown"
	## This shell's own process, which `$$` does not name in a subshell: what a command it starts has as its parent.
	sweepSelf="$( exec sh -c 'echo "$PPID"' 2> /dev/null )" || sweepSelf=""
	case "$sweepSelf" in ''|*[!0123456789]*) return 0 ;; esac
	sweepNow="$( date +%s )"
	for sweepDir in "$MMDAPP/.local/temp/mdat-member-wait.$1."* ; do
		[ -d "$sweepDir" ] && [ ! -L "$sweepDir" ] || continue
		sweepOwner="$( LC_ALL=C awk '
			index( $0, "host: " ) == 1 { ownerHost = substr( $0, 7 ) ; }
			index( $0, "process: " ) == 1 { ownerProcess = substr( $0, 10 ) ; }
			END { if ( ownerHost != "" && ownerProcess ~ /^[0-9]+ [^ ]+$/ ) { print ownerHost "\t" ownerProcess ; } }
		' "$sweepDir/owner" 2>/dev/null )" || sweepOwner=""
		[ ! -f "$sweepDir/kept" ] || sweepOwner=""
		if [ -z "$sweepOwner" ] ; then
			sweepAged="$( stat -c %Y "$sweepDir" 2>/dev/null || stat -f %m "$sweepDir" 2>/dev/null )" || sweepAged=""
			case "$sweepAged" in ''|*[!0123456789]*) continue ;; esac
			[ $(( sweepNow - sweepAged )) -lt 86400 ] || rm -rf "$MMDAPP/.local/temp/mdat-member-wait.$1.${sweepDir##*.}" 2> /dev/null || :
			continue
		fi
		[ "${sweepOwner%%$'\t'*}" = "$sweepHere" ] || continue
		sweepList="$sweepList${sweepOwner#*$'\t'}"$'\t'"$sweepDir"$'\n'
	done
	sweepBegan="$( { printf '%s\n' "$sweepSelf" ; printf '%s' "$sweepList" | LC_ALL=C awk '{ print $1 ; }' ; } | AgentsToolsRegistryProcessesBegan )" || sweepBegan=""
	agentsWaitFolderShell="$( printf '%s\n' "$sweepBegan" | LC_ALL=C awk -v selfPid="$sweepSelf" '$1 == selfPid { print ; exit ; }' )" || agentsWaitFolderShell=""
	[ -n "$agentsWaitFolderShell" ] || return 0
	printf '%s' "$sweepList" | while IFS=$'\t' read -r sweepOwner sweepDir ; do
		case $'\n'"$sweepBegan"$'\n' in *$'\n'"$sweepOwner"$'\n'*) continue ;; esac
		rm -rf "$MMDAPP/.local/temp/mdat-member-wait.$1.${sweepDir##*.}" 2> /dev/null || :
	done
	return 0
}

## The end of a Wait's folder: a kept one only lets its hold go, one of its own under .local/temp goes whole. Run in the wait's scope.
AgentsWaitFolderEnd(){
	if [ -n "${waitDirKept:-}" ] ; then
		rm -f "$waitStateDir/work.$memberName/.held" 2> /dev/null
	elif [ -n "${waitDetachedTask:-}" ] ; then
		## A probe detached at the bound still writes into this directory, so the detached task cleans up once it ends.
		:
	else
		rm -rf "$MMDAPP/.local/temp/mdat-member-wait.$memberName.${waitDir##*.}" 2> /dev/null
	fi
	return 0
}

AgentsWaitFolderOwn(){ ## the working directory
	local ownHere
	ownHere="$( hostname -s 2>/dev/null )" || ownHere="unknown"
	printf 'host: %s\nprocess: %s\n' "$ownHere" "${agentsWaitFolderShell:-}" > "$1/owner"
}

AgentsWaitLost(){ ## the working directory -- rc 0 once it, or a file a step noted, is not there
	[ -d "$1" ] || agentsWaitLost="$1"
	[ -n "${agentsWaitLost:-}" ]
}

case "$1" in

	## The member stub and its implementation, one arm: a wait runs under the named member's own credentials.
	--wait-for-input|--intern-op-wait-for-input)
		if [ "$1" = --wait-for-input ] && [ -n "${2:-}" ] && ! AgentsToolsActingMemberCheck "$2" wait-for-input ; then
			echo "WAIT-RESULT: ERROR"
			set +e ; return 1
		fi
		shift
		## S19.2: a wait is held at its START, so a paused run reads nothing of its sources while it holds.
		AgentsToolsSessionPauseWait
		local memberName="$1"
		shift || true
		if [ -z "$memberName" ] ; then
			echo "WAIT-RESULT: ERROR"
			echo "⛔ ERROR: $MDSC_CMD --wait-for-input: <team-member> missing" >&2
			set +e ; return 1
		fi
		case "$memberName" in
			--*)
				echo "WAIT-RESULT: ERROR"
				echo "⛔ ERROR: $MDSC_CMD --wait-for-input: <team-member> comes first, ahead of every flag, and '$memberName' is a flag. Nothing was waited on." >&2
				set +e ; return 1
			;;
		esac
		AgentsToolsAssertBareName "$memberName" "<team-member>" wait-for-input || {
			echo "WAIT-RESULT: ERROR"
			set +e ; return 1
		}

		## A run holding its routine's lock keeps it while it waits: its own record, at its exact path, says so.
		local waitLockRecord=""
		case "${MDAT_SPAWN_SESSION_ID:-}" in ''|*/*|.|..) ;; *)
			waitLockRecord="${MDAT_SPAWN_SANDBOX_ROOT:-}/$MDAT_SPAWN_SESSION_ID.spawn.md"
			[ -f "$waitLockRecord" ] || waitLockRecord="${MMDAPP%/}/.local/agents/spawned/$MDAT_SPAWN_SESSION_ID/$MDAT_SPAWN_SESSION_ID.spawn.md"
		esac
		if [ -n "$waitLockRecord" ] && LC_ALL=C grep -q -s '^routine-lock: ' "$waitLockRecord" 2> /dev/null ; then
			type AgentsToolsRoutineLockRefreshOwn > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/magic/AgentsTools.RoutineLock.include" 2> /dev/null || :
			! type AgentsToolsRoutineLockRefreshOwn > /dev/null 2>&1 || AgentsToolsRoutineLockRefreshOwn "$MDAT_SPAWN_SESSION_ID" || :
		fi
		local waitSources="" waitTimeout="" waitPoll="" waitSince="" waitListOnly="false" waitAddressee="" waitIncludeOwn="false" waitCollect="" waitModes=" " waitTtls=" " waitTtlNext=""
		local waitMode="" waitSessionId="" waitReactions="" waitFloors="" reactWord
		while [ $# -gt 0 ] ; do
			case "$1" in
				--wait-default|--wait-continue|--wait-close|--wait-add|--wait-drop)
					if [ -n "$waitMode" ] ; then
						echo "WAIT-RESULT: ERROR"
						echo "⛔ ERROR: $MDSC_CMD --wait-for-input: modes are mutually exclusive, and this call names --wait-$waitMode and $1. Nothing was waited on." >&2
						set +e ; return 1
					fi
					waitMode="${1#--wait-}"
					shift
				;;
				## --unwait is the shorthand for --wait-drop --wait-source, and dropping a source does not block it.
				--unwait)
					if [ -n "$waitMode" ] ; then
						echo "WAIT-RESULT: ERROR"
						echo "⛔ ERROR: $MDSC_CMD --wait-for-input: modes are mutually exclusive, and this call names --wait-$waitMode and --unwait. Nothing was waited on." >&2
						set +e ; return 1
					fi
					if [ -z "${2:-}" ] ; then
						echo "WAIT-RESULT: ERROR"
						echo "⛔ ERROR: $MDSC_CMD --wait-for-input: --unwait: value required (<kind>:<target> to drop from the stored wait)" >&2
						set +e ; return 1
					fi
					waitMode="drop"
					waitSources="$waitSources${2%%#*} "
					shift 2
				;;
				--wait-session-id)
					if [ -z "${2:-}" ] ; then
						echo "WAIT-RESULT: ERROR"
						echo "⛔ ERROR: $MDSC_CMD --wait-for-input: --wait-session-id: value required" >&2
						set +e ; return 1
					fi
					waitSessionId="$2"
					shift 2
				;;
				## Each id is kept as <set>=<id>, and gated byte-wise here before it can reach a command line.
				--wait-react-seen|--wait-react-note|--wait-react-done|--wait-react-wait)
					if [ -z "${2:-}" ] ; then
						echo "WAIT-RESULT: ERROR"
						echo "⛔ ERROR: $MDSC_CMD --wait-for-input: $1: value required (message ids, space-separated)" >&2
						set +e ; return 1
					fi
					if ! LC_ALL=C awk -v ids="$2" 'BEGIN { exit ( ids ~ /[^0-9A-Za-z._: -]/ ) ; }' ; then
						echo "WAIT-RESULT: ERROR"
						echo "⛔ ERROR: $MDSC_CMD --wait-for-input: $1: a message id holds only letters, digits, '.', ':', '-' and '_'. Nothing was reacted to or waited on." >&2
						set +e ; return 1
					fi
					for reactWord in $2 ; do
						waitReactions="$waitReactions${1#--wait-react-}=$reactWord "
					done
					shift 2
				;;
				--wait-source)
					if [ -z "${2:-}" ] ; then
						echo "WAIT-RESULT: ERROR"
						echo "⛔ ERROR: $MDSC_CMD --wait-for-input: --wait-source: value required (<kind>:<target>)" >&2
						set +e ; return 1
					fi
					## A source may end in #short or #full, and in #ttl=<seconds>. --wait-source-ttl before it gives the same.
					local sourceSpec="$2" sourceTail sourceTtl="$waitTtlNext" sourceMode=""
					waitTtlNext=""
					while : ; do
						case "$sourceSpec" in *'#'*) ;; *) break ;; esac
						sourceTail="${sourceSpec##*#}" ; sourceSpec="${sourceSpec%'#'*}"
						case "$sourceTail" in
							short|full) sourceMode="$sourceTail" ;;
							ttl=[1-9]*) case "${sourceTail#ttl=}" in *[!0-9]*) sourceTail="" ;; *) sourceTtl="${sourceTail#ttl=}" ;; esac ;;
							*) sourceTail="" ;;
						esac
						if [ -z "$sourceTail" ] ; then
							echo "WAIT-RESULT: ERROR"
							echo "⛔ ERROR: $MDSC_CMD --wait-for-input: --wait-source '$2': what follows # is short, full or ttl=<seconds>, and nothing else. Nothing was waited on." >&2
							set +e ; return 1
						fi
					done
					[ -z "$sourceMode" ] || waitModes="$waitModes$sourceSpec=$sourceMode "
					[ -z "$sourceTtl" ] || waitTtls="$waitTtls$sourceSpec=$sourceTtl "
					waitSources="$waitSources$sourceSpec "
					shift 2
				;;
				--wait-source-ttl)
					case "${2:-}" in
						''|*[!0-9]*|0)
							echo "WAIT-RESULT: ERROR"
							echo "⛔ ERROR: $MDSC_CMD --wait-for-input: --wait-source-ttl: whole seconds above zero, the TTL of the --wait-source after it" >&2
							set +e ; return 1
						;;
					esac
					waitTtlNext="$2"
					shift 2
				;;
				--wait-timeout)
					if [ -z "${2:-}" ] ; then
						echo "WAIT-RESULT: ERROR"
						echo "⛔ ERROR: $MDSC_CMD --wait-for-input: --wait-timeout: value required (whole seconds)" >&2
						set +e ; return 1
					fi
					waitTimeout="$2"
					shift 2
				;;
				--wait-poll-interval)
					if [ -z "${2:-}" ] ; then
						echo "WAIT-RESULT: ERROR"
						echo "⛔ ERROR: $MDSC_CMD --wait-for-input: --wait-poll-interval: value required (whole seconds)" >&2
						set +e ; return 1
					fi
					waitPoll="$2"
					shift 2
				;;
				--wait-since-utime)
					if [ -z "${2:-}" ] ; then
						echo "WAIT-RESULT: ERROR"
						echo "⛔ ERROR: $MDSC_CMD --wait-for-input: --wait-since-utime: value required (epoch seconds)" >&2
						set +e ; return 1
					fi
					waitSince="$2"
					shift 2
				;;
				--wait-addressee)
					if [ -z "${2:-}" ] ; then
						echo "WAIT-RESULT: ERROR"
						echo "⛔ ERROR: $MDSC_CMD --wait-for-input: --wait-addressee: value required (the Slack account id the question was addressed to)" >&2
						set +e ; return 1
					fi
					## Resolved ids only, never a name, because a second resolution here could disagree with the send.
					waitAddressee="$waitAddressee$2 "
					shift 2
				;;
				--wait-list-sources)
					waitListOnly="true"
					shift
				;;
				--wait-include-own)
					waitIncludeOwn="true"
					shift
				;;
				## A collect is a wait of a window of seconds that returns early on an immediate arrival. The tags are immediate and every other source collects until the window ends.
				--wait-collect)
					case "${2:-}" in
						''|*[!0123456789]*|0)
							echo "WAIT-RESULT: ERROR"
							echo "⛔ ERROR: $MDSC_CMD --wait-for-input: --wait-collect: value required (the window, in whole seconds, one or more)" >&2
							set +e ; return 1
						;;
					esac
					waitCollect="$2"
					shift 2
				;;
				*)
					echo "WAIT-RESULT: ERROR"
					echo "⛔ ERROR: $MDSC_CMD --wait-for-input: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		## A --wait-timeout that names the window itself says nothing new and is taken (the work-duty scan passes both); another bound is refused.
		if [ -n "$waitCollect" ] && { [ -n "$waitMode" ] || { [ -n "$waitTimeout" ] && [ "$waitTimeout" != "$waitCollect" ] ; } ; } ; then
			echo "WAIT-RESULT: ERROR"
			echo "⛔ ERROR: $MDSC_CMD --wait-for-input: --wait-collect is a call of its own: the window is its bound, and the floors it resumes from are the pointers of the session (session.chat.pointers), not a stored wait. It takes no mode, and no --wait-timeout other than its own window. Nothing was waited on." >&2
			set +e ; return 1
		fi
		[ -z "$waitCollect" ] || waitTimeout="$waitCollect"
		## Only a Slack source has a short and a full form in this build: the one kind whose messages are text a person wrote.
		local modeOne
		for modeOne in $waitModes ; do
			case "${modeOne%=*}" in
				slack:*) ;;
				*)
					echo "WAIT-RESULT: ERROR"
					echo "⛔ ERROR: $MDSC_CMD --wait-for-input: --wait-source '${modeOne%=*}#${modeOne##*=}': only a Slack source takes a short or a full form. Nothing was waited on." >&2
					set +e ; return 1
				;;
			esac
		done

		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.MemberWaitSources.include"
		return $?
	;;

		*)
			echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
			set +e ; return 1
		;;
esac
