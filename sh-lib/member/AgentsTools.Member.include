#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.Member.include -- the inbox-writing, transcript, item-reading and help operations
## of the tool files (DistroAgentsItems, DistroAgentsSession, DistroAgentsKnowledge), sourced lazily
## from the arm of the tool file that owns the name, via the absolute $MDLT_ORIGIN-based path.
##

## Where an inbox item lives (F4.3).
type AgentsToolsInboxDir > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/inbox/AgentsTools.InboxPlace.include"

case "$1" in

	## A note and a reflection go into the writer's own inbox only: a spawned session names itself.
	--upsert-inbox-note)
		shift
		[ -z "${1:-}" ] || AgentsToolsActingMemberCheck "$1" upsert-inbox-note || return 1
		type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
		DistroAgentsTools --intern-op-member-inbox-upsert "$@" --context --upsert-inbox-note || return 1
		return 0
	;;

	## An inquiry into any member's inbox, from the caller: --from-member names the acting
	## member only, and an item already there is updated only by the member that wrote it.
	--upsert-inbox-inquiry)
		shift
		local inquiryFrom="" inquiryArg inquiryNext="" inquiryFile inquiryAuthor
		## --from-reflection <reflection-file>: the lesson this inquiry files came from a reflection of the filing member's own inbox, and
		## filing it is that reflection's exit -- the reflection is marked processed in the same call, after the inquiry is written.
		local inquiryReflection="" inquiryReflectionNext="" inquiryArgs=()
		for inquiryArg in "$@" ; do
			[ -z "$inquiryNext" ] || { inquiryFrom="$inquiryArg" ; inquiryNext="" ; inquiryArgs+=( "$inquiryArg" ) ; continue ; }
			[ -z "$inquiryReflectionNext" ] || { inquiryReflection="$inquiryArg" ; inquiryReflectionNext="" ; continue ; }
			case "$inquiryArg" in
				--edit-patch-from-stdin)
					echo "⛔ ERROR: $MDSC_CMD --upsert-inbox-inquiry: --edit-patch-from-stdin is not taken -- an inquiry is filed whole, never patched -- nothing was written" >&2
					set +e ; return 1
				;;
				--from-member) inquiryNext=1 ; inquiryArgs+=( "$inquiryArg" ) ;;
				--from-reflection) inquiryReflectionNext=1 ;;
				--reply) inquiryArgs+=( "--reply-requested" ) ;;
				*) inquiryArgs+=( "$inquiryArg" ) ;;
			esac
		done
		if [ -n "$inquiryReflectionNext" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --upsert-inbox-inquiry: --from-reflection takes a reflection file name -- nothing was done" >&2
			set +e ; return 1
		fi
		set -- ${inquiryArgs[@]+"${inquiryArgs[@]}"}
		[ -z "$inquiryFrom" ] || AgentsToolsActingMemberCheck "$inquiryFrom" upsert-inbox-inquiry || { set +e ; return 1 ; }
		[ -n "$inquiryFrom" ] || inquiryFrom="$( AgentsToolsActingMember )"
		## AN INQUIRY GOES TO ONE EXACT PLACE (the human-owner's routing): magic-coordinator by default, which files it, resolves it or starts a
		## session. A target alias names the kind of inquiry, never a list; several targets are one inquiry to the coordinator, never a fan-out.
		## A member target stays where it is only for the clear cases: the coordinator writing, the coordinator or the librarian addressed, a
		## domain owner addressed (keeper-*, partner-*, client-*), or a reply to a member that wrote to the sender within the last day.
		local inquiryTarget="${1:-}" inquiryRouted=""
		case "$inquiryTarget" in
			*,*) inquiryRouted="magic-coordinator" ;;
			@coordinator|@all|@team|@grooming|@default) inquiryRouted="magic-coordinator" ;;
			@retro|@docs|@conventions|@librarian) inquiryRouted="magic-librarian" ;;
			@design|@architecture) inquiryRouted="magic-architect" ;;
			@ops|@deploy|@infra) inquiryRouted="magic-devops" ;;
			@tests|@verify) inquiryRouted="magic-tester" ;;
			@code) inquiryRouted="magic-developer" ;;
			@ui|@frontend) inquiryRouted="magic-frontender" ;;
			@*) echo "⛔ ERROR: $MDSC_CMD --upsert-inbox-inquiry: $inquiryTarget is no target alias: @coordinator (default, also @all @team @grooming), @retro @docs @conventions (librarian), @design, @ops, @tests, @code, @ui -- nothing was written" >&2 ; set +e ; return 1 ;;
			''|magic-coordinator|magic-librarian|keeper-*|partner-*|client-*) ;;
			*)
				## A NAME NO MEMBER RECORD HOLDS IS REFUSED BEFORE ANY ROUTING, as the send refuses an addressee that names nobody: a typo
				## never passes silently to the coordinator.
				type AgentsToolsTeamMemberDirectory > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.TeamRegistry.include" 2> /dev/null || :
				if type AgentsToolsTeamMemberDirectory > /dev/null 2>&1 && ! AgentsToolsTeamMemberDirectory "$inquiryTarget" > /dev/null 2>&1 ; then
					echo "⛔ ERROR: $MDSC_CMD --upsert-inbox-inquiry: $inquiryTarget is no team member here and no target alias, so it names nobody -- nothing was written" >&2
					set +e ; return 1
				fi
				if [ "$inquiryFrom" != "magic-coordinator" ] ; then
					local inquiryRecent=""
					[ -z "${MDAT_DATA_ROOT:-}" ] || [ -z "$inquiryFrom" ] || inquiryRecent="$( find "$MDAT_DATA_ROOT/inboxes/$inquiryFrom" -name '*.md' -mtime -1 -exec grep -l -x "from: $inquiryTarget" {} + 2> /dev/null | head -1 )" || inquiryRecent=""
					[ -n "$inquiryRecent" ] || inquiryRouted="magic-coordinator"
				fi
			;;
		esac
		## In an emergency a member target stays direct: no detour through the coordinator (AgentsToolsEmergencyHolds); an alias still resolves.
		case "$inquiryTarget" in @*|*,*) ;; *) { type AgentsToolsEmergencyHolds > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/common/AgentsTools.Emergency.include" 2> /dev/null ; } ; ! AgentsToolsEmergencyHolds || inquiryRouted="" ;; esac
		if [ -n "$inquiryRouted" ] && [ "$inquiryRouted" != "$inquiryTarget" ] ; then
			echo "# $MDSC_CMD --upsert-inbox-inquiry: routed to $inquiryRouted, not $inquiryTarget: an inquiry goes to one place, the coordinator by default; a member is written to directly only as the reply to its own inquiry, or as a domain owner." >&2
			shift ; set -- "$inquiryRouted" "$@"
		fi
		## The reflection is checked before anything is written: a bare name of a reflection still in the filing member's own incoming/.
		if [ -n "$inquiryReflection" ] ; then
			AgentsToolsAssertBareName "$inquiryReflection" "<reflection-file>" upsert-inbox-inquiry || { set +e ; return 1 ; }
			case "$inquiryReflection" in
				reflection-*.md) ;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --upsert-inbox-inquiry: --from-reflection names a reflection-*.md item, not $inquiryReflection -- nothing was done" >&2
					set +e ; return 1
				;;
			esac
			if [ -z "$inquiryFrom" ] || [ ! -f "$( AgentsToolsInboxDir "$inquiryFrom" )/$inquiryReflection" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --upsert-inbox-inquiry: $inquiryReflection is not an unprocessed reflection in ${inquiryFrom:-the filing member}'s own inbox -- nothing was done" >&2
				set +e ; return 1
			fi
		fi
		## ONE SUBJECT, ONE OPEN INQUIRY (the human-owner: match, then append): where the target's open inbox holds an inquiry from the same
		## sender whose title shares 0.7 or more of its words with this one's, the new text is appended to it under a dated heading instead
		## of a second item. Only an inquiry given whole by --from-file is matched.
		local inquirySource="" inquiryAt=0 inquiryWord inquiryNewTitle="" inquirySame="" inquiryMerged=""
		for inquiryWord in "$@" ; do
			[ "$inquiryAt" = 1 ] && { inquirySource="$inquiryWord" ; break ; }
			[ "$inquiryWord" = "--from-file" ] && inquiryAt=1
		done
		if [ -n "$inquirySource" ] && [ -f "$inquirySource" ] && [ -n "${MDAT_DATA_ROOT:-}" ] && [ -n "$inquiryFrom" ] && [ -d "$MDAT_DATA_ROOT/inboxes/${1:-}/incoming" ] ; then
			inquiryNewTitle="$( LC_ALL=C awk '/^# / { print substr( $0, 3 ) ; exit }' "$inquirySource" )"
			[ -z "$inquiryNewTitle" ] || inquirySame="$( LC_ALL=C awk -v want="$inquiryNewTitle" -v from="$inquiryFrom" -v self="${2:-}" '
				function words( t, set,   n, i, w ) { t = tolower( t ) ; gsub( /[^a-z0-9]+/, " ", t ) ; n = split( t, w, " " ) ; for ( i = 1 ; i <= n ; i++ ) if ( length( w[i] ) > 2 ) set[w[i]] = 1 }
				function jac(   k, i, u ) { i = 0 ; u = 0 ; for ( k in A ) { u++ ; if ( k in B ) i++ } ; for ( k in B ) if ( !( k in A ) ) u++ ; return u ? i / u : 0 }
				BEGIN { words( want, A ) }
				FNR == 1 { hdr = 0 ; fr = "" ; ty = "" ; name = FILENAME ; sub( /.*\//, "", name ) }
				/^---$/ { hdr++ ; next }
				hdr == 1 && /^from: / { fr = substr( $0, 7 ) } hdr == 1 && /^type: / { ty = substr( $0, 7 ) }
				hdr >= 2 && /^# / { if ( fr == from && ty == "inquiry" && name != self ) { delete B ; words( substr( $0, 3 ), B ) ; if ( jac() >= 0.7 ) { print name ; exit } } nextfile }
			' "$MDAT_DATA_ROOT/inboxes/${1:-}/incoming/"inquiry-*.md 2> /dev/null )" || inquirySame=""
			if [ -n "$inquirySame" ] ; then
				mkdir -p "$MMDAPP/.local/temp" 2> /dev/null
				inquiryMerged="$( mktemp "$MMDAPP/.local/temp/mdat-inquiry-append.XXXXXX" 2> /dev/null )" || inquiryMerged=""
				if [ -n "$inquiryMerged" ] ; then
					{ LC_ALL=C awk '/^---$/ { hdr++ ; next } hdr >= 2' "$MDAT_DATA_ROOT/inboxes/$1/incoming/$inquirySame"
					  printf '\n## Added %s\n\n' "$( date '+%Y-%m-%d %H:%M %z' )"
					  LC_ALL=C awk 'done || !/^# / { print ; next } { done = 1 }' "$inquirySource" ; } > "$inquiryMerged"
					echo "# $MDSC_CMD --upsert-inbox-inquiry: appended to $inquirySame in $1's inbox, the open inquiry from $inquiryFrom on the same subject, instead of a second item ${2:-}." >&2
					local inquiryRebuilt=() inquiryNextIsSource=""
					for inquiryWord in "$@" ; do
						if [ -n "$inquiryNextIsSource" ] ; then inquiryRebuilt+=( "$inquiryMerged" ) ; inquiryNextIsSource="" ; continue ; fi
						[ "$inquiryWord" = "--from-file" ] && inquiryNextIsSource=1
						inquiryRebuilt+=( "$inquiryWord" )
					done
					inquiryRebuilt[1]="$inquirySame"
					set -- ${inquiryRebuilt[@]+"${inquiryRebuilt[@]}"}
				fi
			fi
		fi
		case "${1:-}:${2:-}" in
			*/*|:*|*:) ;;
			*)
				inquiryFile=""
				[ -z "${MDAT_DATA_ROOT:-}" ] || inquiryFile="$( AgentsToolsInboxItemFind "$1" "$2" yes )" || inquiryFile=""
				if [ -n "$inquiryFile" ] && [ -f "$inquiryFile" ] && [ -n "$inquiryFrom" ] ; then
					inquiryAuthor="$( LC_ALL=C awk '$0 == "---" { if ( ++fm == 2 ) exit ; next ; } fm == 1 && index( $0, "from: " ) == 1 { print substr( $0, 7 ) ; exit ; }' "$inquiryFile" 2> /dev/null )" || inquiryAuthor=""
					if [ "$inquiryAuthor" != "$inquiryFrom" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --upsert-inbox-inquiry: $2 is already in $1's inbox, written by ${inquiryAuthor:-nobody named}, so $inquiryFrom cannot overwrite it -- nothing was done" >&2
						set +e ; return 1
					fi
				fi
			;;
		esac
		type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
		DistroAgentsTools --intern-op-member-inbox-upsert "$@" --context --upsert-inbox-inquiry || { [ -z "$inquiryMerged" ] || rm -f "$inquiryMerged" ; return 1 ; }
		[ -z "$inquiryMerged" ] || rm -f "$inquiryMerged"
		if [ -n "$inquiryReflection" ] ; then
			type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
			DistroAgentsTools --intern-op-inbox-to-processed "$inquiryFrom" "$inquiryReflection" \
				--context --upsert-inbox-inquiry \
				"--header:upsert:disposition:filed-as-inquiry" "--header:upsert:filed-as:${2:-}" || {
				echo "⛔ ERROR: $MDSC_CMD --upsert-inbox-inquiry: the inquiry ${2:-} is filed, but $inquiryReflection could not be marked processed -- mark it with --mark-inbox-processed" >&2
				set +e ; return 1
			}
		fi
		return 0
	;;

	--upsert-inbox-reflection)
		shift
		[ -z "${1:-}" ] || AgentsToolsActingMemberCheck "$1" upsert-inbox-reflection || return 1
		type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
		DistroAgentsTools --intern-op-member-inbox-upsert "$@" --context --upsert-inbox-reflection || return 1
		return 0
	;;

	## The calling session's own transcript, or a named shared one; magic-coordinator's, any session's, named by --of-session <session-id>.
	## A spawned session appends as its own member only.
	--append-transcript)
		shift
		local ofSession="" ofArgs=() ofNext=""
		for ofArg in "$@" ; do
			if [ -n "$ofNext" ] ; then ofSession="$ofArg" ; ofNext="" ; continue ; fi
			if [ "$ofArg" = "--of-session" ] ; then ofNext=1 ; continue ; fi
			ofArgs[${#ofArgs[@]}]="$ofArg"
		done
		set -- ${ofArgs[@]+"${ofArgs[@]}"}
		if [ -n "$ofNext" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --append-transcript: --of-session takes a session id -- nothing was done" >&2
			set +e ; return 1
		fi
		if [ -n "$ofSession" ] ; then
			if [ "${1:-}" != magic-coordinator ] ; then
				echo "⛔ ERROR: $MDSC_CMD --append-transcript: --of-session runs only as magic-coordinator, and ${1:-nobody} is not it -- a member appends to its own session by leaving it out" >&2
				set +e ; return 1
			fi
			AgentsToolsActingMemberCheck "$1" append-transcript || { set +e ; return 1 ; }
			type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
			DistroAgentsTools --intern-op-append-session-transcript "$1" "$ofSession" "${@:2}"
			return $?
		fi
		[ -z "${1:-}" ] || AgentsToolsActingMemberCheck "$1" append-transcript || { set +e ; return 1 ; }
		type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
		DistroAgentsTools --intern-op-append-session-transcript "${1:-}" - "${@:2}"
		return $?
	;;

	## The implementation. <session-id> is `-` for the calling session's own transcript.
	--intern-op-append-session-transcript)
		shift
		local memberName="$1"
		shift || true
		local namedSessionId="${1:-}"
		shift || true
		[ "$namedSessionId" != "-" ] || namedSessionId=""
		[ -z "$namedSessionId" ] || AgentsToolsAssertBareName "$namedSessionId" "<session-id>" intern-op-append-session-transcript || { set +e ; return 1 ; }
		if [ -z "$memberName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --append-transcript: syntax is <team-member> [--speaker <speaker-name>] [--timestamp <ISO-UTC-date-time>] (--message <verbatim-text>|--from-stdin|--from-file <path>) [--transcript-name <transcript-file-name>] [--create]" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$memberName" "<team-member>" append-transcript || { set +e ; return 1 ; }
		local speakerName timestampUtc messageText transcriptName
		local messageFromStdin="false" messageFile messageArgProvided="false"
		local allowCreate="false"
		while [ $# -gt 0 ] ; do
			case "$1" in
				--speaker)
					speakerName="$2"
					shift 2
				;;
				--timestamp)
					timestampUtc="$2"
					shift 2
				;;
				--message)
					messageText="$2"
					messageArgProvided="true"
					shift 2
				;;
				--message-from-stdin|--from-stdin)
					messageFromStdin="true"
					shift
				;;
				--message-file|--from-file)
					messageFile="$2"
					shift 2
				;;
				--transcript-name)
					transcriptName="$2"
					shift 2
				;;
				--create)
					allowCreate="true"
					shift
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --append-transcript: unrecognized argument: $1" >&2
					set +e ; return 1
				;;
			esac
		done

		## With no --transcript-name: the calling session's own transcript, never another
		## session's (AgentsTranscriptSessionKey). --create starts it when the session has
		## none yet. Refused where no session resolves.
		local sessionMode="false"
		if [ -n "$namedSessionId" ] && [ -n "$transcriptName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-op-append-session-transcript: a named session takes no --transcript-name" >&2
			set +e ; return 1
		fi
		if [ -z "$transcriptName" ] ; then
			sessionMode="true"
			[ -n "$speakerName" ] || speakerName="$memberName"
			[ -n "$timestampUtc" ] || timestampUtc="$( date -u +%Y-%m-%dT%H:%M:%SZ )"
		fi
		if [ -z "$speakerName" ] || [ -z "$timestampUtc" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --append-transcript: required args with --transcript-name: --speaker --timestamp" >&2
			set +e ; return 1
		fi
		local payloadSources=0
		if [ "$messageArgProvided" = "true" ] ; then
			payloadSources=$((payloadSources + 1))
		fi
		if [ "$messageFromStdin" = "true" ] ; then
			payloadSources=$((payloadSources + 1))
		fi
		if [ -n "$messageFile" ] ; then
			payloadSources=$((payloadSources + 1))
		fi
		if [ "$payloadSources" -ne 1 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --append-transcript: provide exactly one payload source: --message, --from-stdin, or --from-file" >&2
			set +e ; return 1
		fi
		if [ "$messageFromStdin" = "true" ] ; then
			messageText="$(cat)"
		elif [ -n "$messageFile" ] ; then
			if [ ! -f "$messageFile" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --append-transcript: message file not found: $messageFile" >&2
				set +e ; return 1
			fi
			messageText="$(cat -- "$messageFile")"
		fi
		if [ "$sessionMode" = "true" ] ; then
			if ! printf '%s' "$timestampUtc" | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?Z$' ; then
				echo "⛔ ERROR: $MDSC_CMD --append-transcript: --timestamp must be ISO UTC date-time (suffix Z): $timestampUtc" >&2
				set +e ; return 1
			fi
			. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionTranscript.include"
			local sessionOut="" sessionRc=0 targetSessionId=""
			targetSessionId="${namedSessionId:-$( AgentsTranscriptSessionKey )}"
			if [ "$allowCreate" = "true" ] && [ -n "$targetSessionId" ] && ! AgentsTranscriptBase "$targetSessionId" > /dev/null 2>&1 ; then
				AgentsTranscriptStart "$targetSessionId" "${MDAT_DATA_ROOT:-}" "$( AgentsTranscriptNewRel "$memberName" "$targetSessionId" )" "$memberName"
			fi
			sessionOut="$( AgentsTranscriptNote "$targetSessionId" "$speakerName" "$messageText" "$timestampUtc" )" || sessionRc=$?
			if [ "$sessionRc" != "0" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --append-transcript: ${sessionOut#ERROR: }" >&2
				set +e ; return 1
			fi
			echo "$sessionOut"
			return 0
		fi
		AgentsToolsAssertBareName "$transcriptName" "<transcript-file-name>" append-transcript || { set +e ; return 1 ; }
		## A session's tooling-written log is that session's alone: it is reached with no
		## --transcript-name, from inside the session, never named from another.
		case "$transcriptName" in
			session-*.log|session-*-part[0-9]*.log)
				echo "⛔ ERROR: $MDSC_CMD --append-transcript: $transcriptName is a session's own log -- only that session writes it, with no --transcript-name" >&2
				set +e ; return 1
			;;
		esac
		if ! printf '%s' "$timestampUtc" | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?Z$' ; then
			echo "⛔ ERROR: $MDSC_CMD --append-transcript: --timestamp must be ISO UTC date-time (suffix Z): $timestampUtc" >&2
			set +e ; return 1
		fi

		local memberDir="$MDAT_SKILLSET_ROOT/$memberName"
		if [ ! -d "$memberDir" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --append-transcript: no such member skill directory: $memberDir" >&2
			set +e ; return 1
		fi
		## The month folder comes from the name's own date, so a session crossing
		## a month boundary keeps appending to the one file it started.
		## By the one audit lookup (AgentsToolsAuditMonth), which every reader of it looks up by.
		type AgentsToolsAuditMonth > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.InternOpDataRead.include"
		local yearMonth
		yearMonth="$( AgentsToolsAuditMonth "$transcriptName" )" || yearMonth="$( date -u +%Y-%m )"
		[ -n "${MDAT_DATA_ROOT:-}" ] || {
			echo "⛔ ERROR: $MDSC_CMD --append-transcript: MDAT_DATA_ROOT is not set" >&2
			set +e ; return 1
		}
		local transcriptDir="$MDAT_DATA_ROOT/audit/$yearMonth"
		mkdir -p "$transcriptDir" || {
			echo "⛔ ERROR: $MDSC_CMD --append-transcript: can't create transcript directory: $transcriptDir" >&2
			set +e ; return 1
		}
		local target="$transcriptDir/$transcriptName"
		if [ ! -f "$target" ] && [ "$allowCreate" != "true" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --append-transcript: transcript does not exist (pass --create to allow creation): $target" >&2
			set +e ; return 1
		fi
		## A new transcript opens with the frontmatter that names its contract (audit-item.transcript), as `type` is named,
		## filled from the tool-side template (sh-lib/templates/audit-item.transcript.document.format.md).
		if [ ! -f "$target" ] ; then
			type AgentsToolsToolingTemplateFill > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.ToolingTemplate.include"
			AgentsToolsToolingTemplateFill "audit-item.transcript.document.format.md" team-data/AgentsVaultAuditDocumentFill.awk > "$target" || {
				echo "⛔ ERROR: $MDSC_CMD --append-transcript: failed to create transcript: $target" >&2
				set +e ; return 1
			}
		fi

		## One small entry, built in a variable and appended once. $( ) drops the
		## trailing newlines, which the `\n\n` below puts back -- the blank line
		## that separates one transcript entry from the next.
		local entryText
		entryText="$( printf '%s (%s):\n\n' "$speakerName" "$timestampUtc" ; printf '%s' "$messageText" | LC_ALL=C awk '{ print "> " $0 } END { if (NR == 0) print "> " }' )"

		local addedBytes addedLines
		addedBytes="$( printf '%s\n\n' "$entryText" | wc -c | tr -d '[:space:]' )"
		addedLines="$( printf '%s\n\n' "$entryText" | wc -l | tr -d '[:space:]' )"
		printf '%s\n\n' "$entryText" >> "$target" || {
			echo "⛔ ERROR: $MDSC_CMD --append-transcript: failed to append to transcript: $target" >&2
			set +e ; return 1
		}

		echo "# $MDSC_CMD --append-transcript: appended ${target#"$MDAT_DATA_ROOT/audit"/} (+${addedLines} lines, +${addedBytes} bytes)" >&2
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.TeamDataCommit.include"
		AgentsToolsTeamDataCommitPaths "append-transcript, $transcriptName" "$target"
		echo "$target"
		return 0
	;;

	## One audit document, by bare filename. A stub: it checks who is asking, and
	## --intern-op-audit-item-read resolves and reads (AgentsTools.InternOpVaultAudit.include).
	--get-audit-item)
		shift
		local memberName="${1:-}"
		shift || true
		local documentName="${1:-}"
		shift || true
		if [ -z "$memberName" ] || [ -z "$documentName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --get-audit-item: syntax is <team-member> <document-name> [--start-line <N> --end-line <N>]" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$memberName" "<team-member>" get-audit-item || { set +e ; return 1 ; }
		if [ ! -d "$MDAT_SKILLSET_ROOT/$memberName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --get-audit-item: no such member skill directory: $MDAT_SKILLSET_ROOT/$memberName" >&2
			set +e ; return 1
		fi
		type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
		DistroAgentsTools --intern-op-audit-item-read "$documentName" "$@"
		return $?
	;;

	## One vault item, by bare filename. A stub: it checks who is asking, and
	## --intern-op-vault-item-read resolves and reads (AgentsTools.InternOpVaultAudit.include).
	--get-vault-item)
		shift
		local memberName="${1:-}"
		shift || true
		local itemName="${1:-}"
		shift || true
		if [ -z "$memberName" ] || [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --get-vault-item: syntax is <team-member> <item-name> [--start-line <N> --end-line <N>]" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$memberName" "<team-member>" get-vault-item || { set +e ; return 1 ; }
		if [ ! -d "$MDAT_SKILLSET_ROOT/$memberName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --get-vault-item: no such member skill directory: $MDAT_SKILLSET_ROOT/$memberName" >&2
			set +e ; return 1
		fi
		type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
		DistroAgentsTools --intern-op-vault-item-read "$itemName" "$@"
		return $?
	;;

	## The vault write, the sibling of the read above. A stub: it checks the two names, and
	## --intern-op-vault-item-write does the writing (AgentsTools.InternOpVaultAudit.include).
	## The three typed siblings, one for each vault contract, write only a name of that contract's type word, and check the item against it.
	--upsert-vault-item|--upsert-vault-investigation-report|--upsert-vault-decision-record|--upsert-vault-verbatim-record|--upsert-vault-epic-blueprint)
		local vaultOp="${1#--}" vaultTyped=()
		[ "$vaultOp" = "upsert-vault-item" ] || vaultTyped=( --typed "vault-item.${vaultOp#upsert-vault-}" )
		shift
		local vaultMember="${1:-}"
		shift || true
		local vaultItem="${1:-}"
		shift || true
		if [ -z "$vaultMember" ] || [ -z "$vaultItem" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --$vaultOp: syntax is <team-member> <item-name> $( [ "$vaultOp" = "upsert-vault-item" ] && printf '%s' '[--header:<upsert|append|remove>:name[:value]]... ' )[--from-file <path>|--upsert-from-stdin|--edit-patch-from-stdin]" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$vaultMember" "<team-member>" "$vaultOp" || { set +e ; return 1 ; }
		AgentsToolsAssertBareName "$vaultItem" "<item-name>" "$vaultOp" || { set +e ; return 1 ; }
		type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
		DistroAgentsTools --intern-op-vault-item-write "$vaultMember" "$vaultItem" ${vaultTyped[@]+"${vaultTyped[@]}"} "$@" || return 1
		return 0
	;;

	## The board items assigned to a member and active (pending and running): the collection the work-duty input scan reads for the member
	## (`--do-board-related-startable` of the session-context scan), so a member asks at any point of its work what the duty's scan
	## would list, and the two never disagree. Read only. Blocked and review items are not in it (the scan has no such collection).
	--get-my-board-items)
		shift
		local memberName="$1"
		shift || true
		if [ -z "$memberName" ] || [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --get-my-board-items: syntax is <team-member>" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$memberName" "<team-member>" get-my-board-items || { set +e ; return 1 ; }
		if [ ! -d "$MDAT_SKILLSET_ROOT/$memberName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --get-my-board-items: no such member skill directory: $MDAT_SKILLSET_ROOT/$memberName" >&2
			set +e ; return 1
		fi
		type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
		DistroAgentsTools --intern-op-session-context-scan "$memberName" --all-types \
			--no-slack --no-email --no-trello --do-board-related-startable \
			--context --get-my-board-items
		return $?
	;;

	## Read one board item by filename and optional state restrictions, with
	## optional line range. Path lookup remains inside AgentsToolsDataRead.
	--get-board-item)
		shift
		local memberName="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$memberName" ] || [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --get-board-item: syntax is <team-member> <item-name> [--board-state <state>]... [--start-line <N> --end-line <N>]" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$memberName" "<team-member>" get-board-item || { set +e ; return 1 ; }
		local memberDir="$MDAT_SKILLSET_ROOT/$memberName"
		if [ ! -d "$memberDir" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --get-board-item: no such member skill directory: $memberDir" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$itemName" "<item-name>" get-board-item || { set +e ; return 1 ; }
		case "$itemName" in
			*-*.md)
			;;
			*)
				echo "⛔ ERROR: $MDSC_CMD --get-board-item: item name must match <type>-<name>.md: $itemName" >&2
				set +e ; return 1
			;;
		esac

		local boardStates=()
		local startLine="" endLine=""
		while [ $# -gt 0 ] ; do
			case "$1" in
				--board-state)
					case "$2" in
						backlog|pending|running|review|blocked|parked|processed|archived|retained)
							boardStates+=( "$2" )
						;;
						*)
							echo "⛔ ERROR: $MDSC_CMD --get-board-item: invalid --board-state: $2" >&2
							set +e ; return 1
						;;
					esac
					shift 2
				;;
				--start-line)
					startLine="$2"
					shift 2
				;;
				--end-line)
					endLine="$2"
					shift 2
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --get-board-item: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done

		if [ -n "$startLine" ] || [ -n "$endLine" ] ; then
			if [ -z "$startLine" ] || [ -z "$endLine" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --get-board-item: --start-line and --end-line must be provided together" >&2
				set +e ; return 1
			fi
		fi
		if [ ${#boardStates[@]} -eq 0 ] ; then
			boardStates=( backlog pending running review blocked parked processed archived retained )
		fi
		[ -n "${MDAT_DATA_ROOT:-}" ] || {
			echo "⛔ ERROR: $MDSC_CMD --get-board-item: MDAT_DATA_ROOT is not set" >&2
			set +e ; return 1
		}
		local readArgs=( "$itemName" --context --get-board-item )
		local boardState
		for boardState in ${boardStates[@]+"${boardStates[@]}"} ; do
			readArgs+=( --lookup-folder "$MDAT_DATA_ROOT/board/$boardState" )
		done

		if [ -n "$startLine" ] ; then
			readArgs+=( --start-line "$startLine" --end-line "$endLine" )
		fi
		type AgentsToolsDataRead > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.InternOpDataRead.include"
		AgentsToolsDataRead ${readArgs[@]+"${readArgs[@]}"}
		return $?
	;;

	## THE ITEMS OF AN INBOX, ONE ROW EACH, in one call: what a run otherwise found by cd, ls and cat over the inbox folders. A row is
	## `<state> <item> <type> <from> <date> <title>`, newest first; --of <member> lists another member's inbox, --include-processed its
	## processed items too, --grep <text> keeps the items whose title or name holds the text. Read only. An item is read whole with
	## --get-inbox-item, several at once in one BatchTools call.
	--list-inbox-items)
		shift
		local listMember="" listOf="" listProcessed="no" listGrep="" listFolder listState
		case "${1:-}" in ''|-*) ;; *) listMember="$1" ; shift ;; esac
		[ -n "$listMember" ] || listMember="$( AgentsToolsTeamMember 2> /dev/null )" || listMember=""
		while [ $# -gt 0 ] ; do
			case "$1" in
				--of) listOf="${2:-}" ; shift 2 ;;
				--include-processed) listProcessed="yes" ; shift ;;
				--grep) listGrep="${2:-}" ; shift 2 ;;
				*) echo "⛔ ERROR: $MDSC_CMD --list-inbox-items: syntax is [--team-member <member>] [--of <member>] [--include-processed] [--grep <text>], got: $1" >&2 ; set +e ; return 1 ;;
			esac
		done
		listMember="${listOf:-$listMember}"
		[ -n "$listMember" ] || { echo "⛔ ERROR: $MDSC_CMD --list-inbox-items: whose inbox is not known: give --team-member or --of" >&2 ; set +e ; return 1 ; }
		AgentsToolsAssertBareName "$listMember" "<member>" list-inbox-items || { set +e ; return 1 ; }
		[ -n "${MDAT_DATA_ROOT:-}" ] || { echo "⛔ ERROR: $MDSC_CMD --list-inbox-items: MDAT_DATA_ROOT is not set" >&2 ; set +e ; return 1 ; }
		type AgentsToolsInboxFolders > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/inbox/AgentsTools.InboxPlace.include"
		while IFS= read -r listFolder ; do
			[ -d "$listFolder" ] || continue
			listState="${listFolder##*/}"
			LC_ALL=C awk -v state="$listState" -v want="$( printf '%s' "$listGrep" | LC_ALL=C tr 'A-Z' 'a-z' )" '
				function emit() { if ( name == "" ) return ; line = state "\t" name "\t" ( type != "" ? type : "-" ) "\t" ( from != "" ? from : "-" ) "\t" ( date != "" ? date : "-" ) "\t" ( title != "" ? title : "-" )
					if ( want == "" || index( tolower( name "\t" title ), want ) ) print line }
				FNR == 1 { emit() ; name = FILENAME ; sub( /.*\//, "", name ) ; type = "" ; from = "" ; date = "" ; title = "" ; hdr = 0 }
				/^---$/ { hdr++ ; next }
				hdr == 1 && /^type: / { type = substr( $0, 7 ) }
				hdr == 1 && /^from: / { from = substr( $0, 7 ) }
				hdr == 1 && /^date: / { date = substr( $0, 7, 16 ) }
				hdr >= 2 && title == "" && /^# / { title = substr( $0, 3 ) }
				END { emit() }' "$listFolder"/*.md 2> /dev/null || :
		done < <( AgentsToolsInboxFolders "$listMember" "$listProcessed" ) | LC_ALL=C sort -t "$( printf '\t' )" -k5,5r
		return 0
	;;

	--get-inbox-item)
		shift
		local memberName="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$memberName" ] || [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --get-inbox-item: syntax is [--team-member <member>] <item-filename> [--include-processed] [--start-line <N> --end-line <N>]" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$memberName" "<member>" get-inbox-item || { set +e ; return 1 ; }
		local memberDir="$MDAT_SKILLSET_ROOT/$memberName"
		if [ ! -d "$memberDir" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --get-inbox-item: no such member skill directory: $memberDir" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$itemName" "<item-filename>" get-inbox-item || { set +e ; return 1 ; }
		case "$itemName" in
			note-*|inquiry-*|reflection-*|warning-*)
			;;
			*)
				echo "⛔ ERROR: $MDSC_CMD --get-inbox-item: only note-*/inquiry-*/reflection-*/warning-* items are allowed: $itemName" >&2
				set +e ; return 1
			;;
		esac

		local startLine="" endLine="" includeProcessed="no"
		while [ $# -gt 0 ] ; do
			case "$1" in
				--include-processed)
					includeProcessed="yes"
					shift
				;;
				--start-line)
					startLine="$2"
					shift 2
				;;
				--end-line)
					endLine="$2"
					shift 2
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --get-inbox-item: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done

		if [ -n "$startLine" ] || [ -n "$endLine" ] ; then
			if [ -z "$startLine" ] || [ -z "$endLine" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --get-inbox-item: --start-line and --end-line must be provided together" >&2
				set +e ; return 1
			fi
		fi
		[ -n "${MDAT_DATA_ROOT:-}" ] || {
			echo "⛔ ERROR: $MDSC_CMD --get-inbox-item: MDAT_DATA_ROOT is not set" >&2
			set +e ; return 1
		}
		## Where a read finds it (AgentsToolsInboxFolders): incoming/, and processed/ with
		## --include-processed.
		local readArgs=( "$itemName" --context --get-inbox-item ) readFolder
		while IFS= read -r readFolder ; do
			readArgs+=( --lookup-folder "$readFolder" )
		done < <( AgentsToolsInboxFolders "$memberName" "$includeProcessed" )

		if [ -n "$startLine" ] ; then
			readArgs+=( --start-line "$startLine" --end-line "$endLine" )
		fi
		type AgentsToolsDataRead > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.InternOpDataRead.include"
		AgentsToolsDataRead ${readArgs[@]+"${readArgs[@]}"}
		return $?
	;;

	##
	## Member-scoped trash for one item out of the member's OWN inbox, by its name
	## alone, from either folder of the inbox (with --exclude-incoming a processed
	## item only).
	## Forwards to the same intern-op arm --librarian-inbox-item-trash
	## calls; the difference is only where --from-inbox: comes from.
	##
	## <member> is one positional carrying both the acting member and the
	## owning inbox, matching --get-inbox-item's own convention.
	## A spawned session naming another member than itself is refused
	## (AgentsToolsActingMemberCheck); a call from no spawned session, a
	## human at the console, is taken at the name it gives.
	##
	## No type-prefix whitelist, unlike the sibling read op: see the
	## "DELIBERATELY ABSENT" note in AgentsTools.InternOpBoardTrash.include
	## for why -- a whitelist would make the misfiled board-type document,
	## the item whose removal is least in doubt, the one item that cannot
	## be removed.
	##
	--trash-inbox-item)
		shift
		##
		## --from-inbox: FAILS CLOSED in every position. This op synthesises
		## that value from the acting member itself; accepting a
		## caller-supplied one would turn a member-scoped operation into a
		## cross-member one silently. Scanned across the whole argument
		## vector before the positionals are consumed, so a --from-inbox:
		## standing where <item-filename> belongs is refused for the real
		## reason rather than as some downstream arity error.
		##
		local trashScanArg
		for trashScanArg in "$@" ; do
			## A ROUTINE'S LOCK NOTE IS THE TOOLING'S (AgentsToolsInboxIsLockNote, the index of the routines' own declarations): never trashed.
			type AgentsToolsInboxIsLockNote > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/inbox/AgentsTools.InboxPlace.include"
			if AgentsToolsInboxIsLockNote "$trashScanArg" ; then
				echo "⛔ ERROR: $MDSC_CMD --trash-inbox-item: $trashScanArg is a routine's lock note, which the routine lock reads at its own place -- it is never trashed, and nothing was done" >&2
				set +e ; return 1
			fi
			case "$trashScanArg" in
				--from-inbox:*)
					echo "⛔ ERROR: $MDSC_CMD --trash-inbox-item: $trashScanArg is not valid here -- this op trashes an item out of <member>'s own inbox, so the source inbox and the acting member are the same one positional. Use --librarian-inbox-item-trash for a cross-member inbox." >&2
					set +e ; return 1
				;;
			esac
		done
		local memberName="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$memberName" ] || [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --trash-inbox-item: syntax is [--team-member <member>] <item-filename> [--exclude-incoming]" >&2
			set +e ; return 1
		fi
		local trashOnly=()
		if [ "${1:-}" = "--exclude-incoming" ] ; then
			trashOnly=( --exclude-incoming ) ; shift
		fi
		if [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --trash-inbox-item: invalid option: $1" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$memberName" "<member>" trash-inbox-item || { set +e ; return 1 ; }
		AgentsToolsAssertBareName "$itemName" "<item-filename>" trash-inbox-item || { set +e ; return 1 ; }
		AgentsToolsActingMemberCheck "$memberName" trash-inbox-item || { set +e ; return 1 ; }
		case "$itemName" in
			*.md) ;;
			*)
				echo "⛔ ERROR: $MDSC_CMD --trash-inbox-item: <item-filename> must end in .md -- every inbox item is a markdown document: $itemName" >&2
				set +e ; return 1
			;;
		esac
		type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
		DistroAgentsTools --intern-op-board-trash "$memberName" "--from-inbox:$memberName" "$itemName" \
			${trashOnly[@]+"${trashOnly[@]}"} --context --trash-inbox-item
		return $?
	;;

	## The coordinator removes a board item that must not stand: one written under a name that is no item's (an extensionless one), or a stray
	## of an older kind. Through the board's own trash (--intern-op-board-trash), so a git store commits the deletion through the team-data
	## thread and keeps the item in its history, and any other store keeps it in trash/. The coordinator alone writes the board.
	--trash-board-item)
		shift
		local memberName="$1"
		shift || true
		local itemName="$1"
		shift || true
		local trashFromState=""
		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-state:?*) trashFromState="${1#--from-state:}" ; shift ;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --trash-board-item: invalid option: $1 -- syntax is [--team-member <team-member>] <item-filename> --from-state:<state>" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$memberName" ] || [ -z "$itemName" ] || [ -z "$trashFromState" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --trash-board-item: syntax is [--team-member <team-member>] <item-filename> --from-state:<state>" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$memberName" "<team-member>" trash-board-item || { set +e ; return 1 ; }
		AgentsToolsAssertBareName "$itemName" "<item-filename>" trash-board-item || { set +e ; return 1 ; }
		AgentsToolsActingMemberCheck "$memberName" trash-board-item || { set +e ; return 1 ; }
		if [ "$memberName" != magic-coordinator ] ; then
			echo "⛔ ERROR: $MDSC_CMD --trash-board-item: only magic-coordinator writes the board; $memberName asks it with an inquiry" >&2
			set +e ; return 1
		fi
		type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
		DistroAgentsTools --intern-op-board-trash "$memberName" "$trashFromState" "$itemName" --context --trash-board-item
		return $?
	;;

	## Any member marks its own inbox item handled: `processed-at` stamped, and the item moved
	## to processed/ of the inbox, through the same
	## primitive --librarian-inbox-to-processed uses.
	## Own inbox only -- <team-member> is both the actor and the inbox, and a spawned
	## session naming another member than itself is refused.
	--mark-inbox-processed)
		shift
		local memberName="$1"
		shift || true
		local itemName="$1"
		shift || true
		## A ROUTINE'S LOCK NOTE IS THE TOOLING'S (AgentsToolsInboxIsLockNote, the index of the routines' own declarations): its folder is
		## set by the routine lock, and a move by hand loses the lock, which then answers NO_LOCK_HELD.
		type AgentsToolsInboxIsLockNote > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/inbox/AgentsTools.InboxPlace.include"
		if AgentsToolsInboxIsLockNote "$itemName" ; then
			echo "⛔ ERROR: $MDSC_CMD --mark-inbox-processed: $itemName is a routine's lock note, which the routine lock keeps in its own folder -- it is never marked by hand, and nothing was done" >&2
			set +e ; return 1
		fi
		if [ -z "$memberName" ] || [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --mark-inbox-processed: syntax is [--team-member <team-member>] <item-filename> [--include-processed] [--header:<upsert|append|remove>:name[:value]]... [--upsert-from-stdin|--edit-script-from-stdin:<py|awk>|--edit-patch-from-stdin]" >&2
			set +e ; return 1
		fi
		local passthrough=()
		while [ $# -gt 0 ] ; do
			case "$1" in
				--header:*|--upsert-from-stdin|--edit-script-from-stdin:*|--edit-patch-from-stdin|--include-processed)
					passthrough+=( "$1" ) ; shift
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --mark-inbox-processed: invalid option: $1 -- this op marks an item in <team-member>'s own inbox processed, nothing else" >&2
					set +e ; return 1
				;;
			esac
		done
		AgentsToolsAssertBareName "$memberName" "<team-member>" mark-inbox-processed || { set +e ; return 1 ; }
		AgentsToolsAssertBareName "$itemName" "<item-filename>" mark-inbox-processed || { set +e ; return 1 ; }
		if [ ! -d "$MDAT_SKILLSET_ROOT/$memberName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --mark-inbox-processed: no such member skill directory: $MDAT_SKILLSET_ROOT/$memberName" >&2
			set +e ; return 1
		fi
		if [ -n "${MDAT_SPAWN_AGENT:-}" ] && [ "$MDAT_SPAWN_AGENT" != "$memberName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --mark-inbox-processed: this session acts as $MDAT_SPAWN_AGENT, and only its own inbox items are its to mark handled -- not $memberName's" >&2
			set +e ; return 1
		fi
		case "$itemName" in
			*.md) ;;
			*)
				echo "⛔ ERROR: $MDSC_CMD --mark-inbox-processed: <item-filename> must end in .md -- every inbox item is a markdown document: $itemName" >&2
				set +e ; return 1
			;;
		esac
		type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
		DistroAgentsTools --intern-op-inbox-to-processed "$memberName" "$itemName" \
			--context --mark-inbox-processed \
			${passthrough[@]+"${passthrough[@]}"}
		return $?
	;;

	--intern-op-member-work-session-input-scan)
		shift
		local memberName="$1"
		shift || true
		if [ -z "$memberName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-op-member-work-session-input-scan: syntax is <member>" >&2
			set +e ; return 1
		fi
		if [ $# -gt 0 ] ; then
			case "$1" in
				--*)
					echo "⛔ ERROR: $MDSC_CMD --intern-op-member-work-session-input-scan: invalid option: $1 -- syntax is <team-member>, no other arguments -- an input-scan reads all baseline-relevant items itself. SEE Skill magic-team/magic-team.armed.md" >&2
					set +e ; return 1
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --intern-op-member-work-session-input-scan: syntax is <team-member>, no other arguments -- an input-scan reads all baseline-relevant items itself, an item name is not a parameter. SEE Skill magic-team/magic-team.armed.md" >&2
					set +e ; return 1
				;;
			esac
		fi
		AgentsToolsAssertBareName "$memberName" "<team-member>" member-work-session-input-scan || { set +e ; return 1 ; }
		local memberDir="$MDAT_SKILLSET_ROOT/$memberName"
		if [ ! -d "$memberDir" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-op-member-work-session-input-scan: no such member skill directory: $memberDir" >&2
			set +e ; return 1
		fi

		## Every non-terminal state, owner-filtered, and the member's whole own inbox: the item's own terms.
		type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
		DistroAgentsTools --intern-op-session-context-scan "$memberName" \
			--state backlog --state pending --state running --state review --state blocked --state parked \
			--all-types --filter-owner "$memberName" \
			--do-inbox-reflections \
			--do-inbox-notes \
			--do-inbox-inquiry-active \
			--do-inbox-other \
			--no-slack --no-email --no-trello \
			--no-board-related \
			--context --intern-op-member-work-session-input-scan
		return $?
	;;

	--member-help)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.MemberHelp.include"
		return $?
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
