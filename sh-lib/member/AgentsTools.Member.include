#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.Member.include -- the inbox-writing, transcript, item-reading and help operations
## of the tool files (DistroAgentsItems, DistroAgentsSession, DistroAgentsKnowledge), sourced lazily
## from the arm of the tool file that owns the name, via the absolute $MDLT_ORIGIN-based path.
##

## Where an inbox item lives (F4.3).

case "$1" in

	## A note and a reflection go into the writer's own inbox only: a spawned session names itself.
	--upsert-inbox-note)
		shift
		type AgentsToolsActingMemberCheck > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.ActingMember.include"
		[ -z "${1:-}" ] || AgentsToolsActingMemberCheck "$1" upsert-inbox-note || return 1
		type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
		DistroAgentsTools --intern-op-member-inbox-upsert "$@" --context --upsert-inbox-note || return 1
		return 0
	;;

	--upsert-inbox-inquiry)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/inbox/AgentsTools.OpUpsertInboxInquiry.include"
	;;

	--upsert-inbox-reflection)
		shift
		type AgentsToolsActingMemberCheck > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.ActingMember.include"
		[ -z "${1:-}" ] || AgentsToolsActingMemberCheck "$1" upsert-inbox-reflection || return 1
		type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
		DistroAgentsTools --intern-op-member-inbox-upsert "$@" --context --upsert-inbox-reflection || return 1
		return 0
	;;

	--append-transcript)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.OpAppendTranscript.include"
	;;

	--intern-op-append-session-transcript)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.InternOpAppendSessionTranscript.include"
	;;

	--get-audit-item)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/vault/AgentsTools.OpGetAuditItem.include"
	;;

	--get-vault-item)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/vault/AgentsTools.OpGetVaultItem.include"
	;;

	## The vault write, the sibling of the read above. A stub: it checks the two names, and
	## --intern-op-vault-item-write does the writing (AgentsTools.InternOpVaultAudit.include).
	## The typed siblings, one for each vault contract, write only a name of that contract's type word, and check the item against it.
	--upsert-vault-item|--upsert-vault-investigation-report|--upsert-vault-decision-record|--upsert-vault-verbatim-record|--upsert-vault-epic-blueprint|--upsert-vault-planning|--upsert-vault-tracking)
		type AgentsToolsVaultTypedUpsert > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/vault/AgentsTools.VaultTypedUpsert.include"
		AgentsToolsVaultTypedUpsert "$@"
		return $?
	;;
	--upsert-vault-*)
		type AgentsToolsVaultTypedUpsert > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/vault/AgentsTools.VaultTypedUpsert.include"
		AgentsToolsVaultTypedUpsert "$@"
		return $?
	;;

	--get-my-board-items)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.OpGetMyBoardItems.include"
	;;

	--get-board-item)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.OpGetBoardItem.include"
	;;

	--list-inbox-items)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/inbox/AgentsTools.OpListInboxItems.include"
	;;

	--get-inbox-item)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/inbox/AgentsTools.OpGetInboxItem.include"
	;;

	--trash-inbox-item)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/inbox/AgentsTools.OpTrashInboxItem.include"
	;;

	--trash-board-item)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.OpTrashBoardItem.include"
	;;

	--mark-inbox-processed)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/inbox/AgentsTools.OpMarkInboxProcessed.include"
	;;

	--intern-op-member-work-session-input-scan)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.InternOpMemberWorkSessionInputScan.include"
	;;

	--member-help)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.MemberHelp.include"
		return $?
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
