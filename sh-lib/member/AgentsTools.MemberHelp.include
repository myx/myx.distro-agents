#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.MemberHelp.include -- --member-help <team-member>'s own
## operation group for DistroAgentsTools.fn.sh's dispatcher. Sourced lazily
## from the `--member-help)` arm inside AgentsTools.Member.include, via the
## standard $MDLT_ORIGIN-based path.
## Not standalone: relies on being dot-sourced for $1/$@/$MDSC_CMD.
##

case "$1" in

	--member-help)
		shift
		local targetMember="$1"
		shift || true
		if [ -z "$targetMember" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --member-help: syntax is <team-member>" >&2
			set +e ; return 1
		fi
		if [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --member-help: takes exactly one argument" >&2
			set +e ; return 1
		fi

		local commonPrefixes
		case "$targetMember" in
			magic-coordinator)
				commonPrefixes=(
					"@member"
					"--owner-workspace-list"
					"--check-*"
					"--email-send"
					"--email-mark-seen"
					"@coordinator"
					"--console-*"
					"--slack-react"
					"--routine-*"
				)
			;;
			magic-librarian)
				commonPrefixes=(
					"@member"
					"--librarian-*"
				)
			;;
			magic-devops)
				commonPrefixes=(
					"@member"
					"--install-*"
				)
			;;
			magic-*)
				commonPrefixes=(
					"@member"
				)
			;;
			partner-*)
				commonPrefixes=(
					"@member"
				)
			;;
			## A client-* member works on both sides: our own team by the operations of the tool files, the other organisation by --client-*.
			client-*)
				commonPrefixes=(
					"@member"
					"--client-*"
				)
			;;
			keeper-*|warden-*)
				commonPrefixes=(
					"@member"
					"--console-*"
				)
			;;
			oncall-*|expert-*)
				commonPrefixes=(
					"@member"
				)
			;;
			human-owner)
				commonPrefixes=(
					"--help"
					"@member"
					"--owner-*"
				)
			;;
			## A root console with no team member resolved falls to this (S21.20): the implied-member
			## default that fills every front tool's own first argument is this call's OWN identity,
			## never the member whose help is wanted, so filling it in here just hides the real gap.
			user-*)
				echo "⛔ ERROR: $MDSC_CMD --member-help: no team member was named, so this call's own identity ($targetMember) was used by default and has no help of its own. Name the member whose help you want: $MDSC_CMD --member-help <team-member>." >&2
				set +e ; return 1
			;;
			*)
				echo "⛔ ERROR: $MDSC_CMD --member-help: not a recognized team-member naming pattern: $targetMember" >&2
				set +e ; return 1
			;;
		esac

		## The names of the tool files stand for their audiences: every member's, and the coordinator's own (the table of the tool files).
		type AgentsToolsFrontNamesOf > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsContext.FrontTable.include"
		local expandedPrefixes=() prefixItem prefixName
		for prefixItem in "${commonPrefixes[@]}" ; do
			case "$prefixItem" in
				@member|@coordinator)
					while IFS= read -r prefixName ; do
						[ -z "$prefixName" ] || expandedPrefixes[${#expandedPrefixes[@]}]="$prefixName"
					done <<< "$( AgentsToolsFrontNamesOf "${prefixItem#@}" )"
				;;
				*) expandedPrefixes[${#expandedPrefixes[@]}]="$prefixItem" ;;
			esac
		done

		local skillRoot="$MDAT_SKILLSET_ROOT"
		local memberFile="$skillRoot/$targetMember/$targetMember.armed.md"
		if [ ! -f "$memberFile" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --member-help: no such team-member: $targetMember ($memberFile not found)" >&2
			set +e ; return 1
		fi

		ExtractOpNames(){
			LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsMemberHelpExtractOpNames.awk" "$1"
		}

		local ownOpNames
		ownOpNames="$( ExtractOpNames "$memberFile" | sort -u )"

		echo "# Duty instructions" >&2
		echo >&2
		if [ -n "$ownOpNames" ] ; then
			echo "$targetMember's own declared operations ($memberFile):" >&2
			printf '%s\n' "$ownOpNames" | sed 's/^/  /' >&2
		else
			echo "$targetMember declares no operations of its own ($memberFile) -- floor + role-family common filter still apply below." >&2
		fi
		echo >&2

		## The team's own operations, the floor under every member's: a file this operation
		## needs. Where the member set view cannot give it, the help stops and names it,
		## never an empty floor with rc 0.
		local floorFile="$skillRoot/magic-team/magic-team.armed.md"
		if [ ! -f "$floorFile" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --member-help: the team's own operations cannot be read for $targetMember: $floorFile not found in the member set view $skillRoot -- the help was not completed" >&2
			set +e ; return 1
		fi
		local floorOpNames
		floorOpNames="$( ExtractOpNames "$floorFile" | sort -u )"

		local allNames
		allNames="$( { printf '%s\n' "$floorOpNames" ; printf '%s\n' "$ownOpNames" ; printf '%s\n' "${expandedPrefixes[@]}" ; } | sort -u )"

		echo "# Tooling help output" >&2
		echo >&2


		export MDAT_MEMBER_HELP_NAMES="$allNames"
		## What the coordinator alone calls is not shown to another member through a family prefix of its own.
		export MDAT_MEMBER_HELP_EXCLUDE=""
		[ "$targetMember" = magic-coordinator ] || MDAT_MEMBER_HELP_EXCLUDE="$( AgentsToolsFrontNamesOf coordinator )"
		LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsMemberHelpToolingLinesFilter.awk" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/help/Help.DistroAgentsTools.include"

		echo >&2

		LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsMemberHelpEntriesRender.awk" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/help/Help.DistroAgentsTools.help.md"

		return 0
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
