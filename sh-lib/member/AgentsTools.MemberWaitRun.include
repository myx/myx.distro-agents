#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

## AgentsTools.MemberWaitRun.include -- the wait itself: its directory, its floors, the rounds of probes, dot-sourced inside the --wait-for-input arm. Its longer notes are in MAGIC.md, "The Wait includes".

		## default does not remove the stored state: its floors are kept (see the floor loop below).

		## The directory comes from mktemp and never from $$, because every call in one long-lived process shares one PID.
		local waitDir waitDirWhy="" agentsWaitLost=""
		mkdir -p "$MMDAPP/.local/temp" 2>/dev/null || true
		## A unique name per call leaves stale directories, so the wait sweeps them on the way in, only where their wait is proven gone.
		AgentsWaitFolderSweep "$memberName"
		## One working folder per member is kept in its session across Waits and held by one Wait at a time. Otherwise the wait makes its own under .local/temp.
		local waitDirKept="" waitSeenBefore=""
		if [ -n "${waitStateDir:-}" ] && [ -d "${waitStateDir%/wait}" ] ; then
			waitDirKept="$waitStateDir/work.$memberName"
			if [ -f "$waitDirKept/.held" ] ; then
				local heldBy=""
				heldBy="$( LC_ALL=C awk 'index( $0, "process: " ) == 1 { print substr( $0, 10 ) ; exit ; }' "$waitDirKept/.held" 2> /dev/null )" || heldBy=""
				case "$heldBy" in
					[0-9]*' '*) [ -z "$( printf '%s\n' "${heldBy%% *}" | AgentsToolsRegistryProcessesBegan 2> /dev/null | LC_ALL=C awk -v want="$heldBy" '$0 == want' )" ] || waitDirKept="" ;;
				esac
			fi
		fi
		if [ -n "$waitDirKept" ] && mkdir -p "$waitDirKept" 2> /dev/null && AgentsWaitFolderOwn "$waitDirKept" 2> /dev/null && cp -f "$waitDirKept/owner" "$waitDirKept/.held" 2> /dev/null ; then
			waitDir="$waitDirKept"
			rm -f "$waitDir/kept" 2> /dev/null
			{ IFS= read -r waitSeenBefore < "$waitDir/seen.txt" ; } 2> /dev/null || waitSeenBefore=""
			agentsWaitConvSeen="$waitSeenBefore"
		else
			waitDirKept=""
			waitDir="$( mktemp -d "$MMDAPP/.local/temp/mdat-member-wait.$memberName.XXXXXX" 2>&1 )" || { waitDirWhy="${waitDir//$'\n'/ }" ; waitDir="" ; }
			if [ -n "$waitDir" ] && [ ! -d "$waitDir" ] ; then
				waitDirWhy="mktemp named ${waitDir//$'\n'/ }, which is no directory" ; waitDir=""
			fi
			if [ -n "$waitDir" ] && ! AgentsWaitFolderOwn "$waitDir" 2>/dev/null ; then
				rm -rf "$MMDAPP/.local/temp/mdat-member-wait.$memberName.${waitDir##*.}" 2> /dev/null || :
				waitDirWhy="the owner record could not be written into $waitDir" ; waitDir=""
			fi
		fi
		if [ -z "$waitDir" ] ; then
			echo "WAIT-RESULT: ERROR"
			echo "⛔ ERROR: $MDSC_CMD --wait-for-input: could not create a working directory under $MMDAPP/.local/temp (${waitDirWhy:-mktemp gave no reason}), so no probe could write a rendering. Nothing was waited on." >&2
			set +e ; return 1
		fi

		## With a cut-off named, the first probe is judged against an empty baseline. With none, the first probe is the baseline.
		local waitBaselineMode="first-probe"
		[ -z "$waitSince" ] || waitBaselineMode="empty"

		local waitStart waitSecs0 waitCallerPid waitDeadline=""
		waitStart="$( date +%s )"
		## The one clock of this wait is the shell's own second count, so a quiet tick starts no date process.
		waitSecs0=$SECONDS
		waitCallerPid=$PPID
		[ -z "$waitTimeout" ] || waitDeadline=$(( waitStart + waitTimeout ))

		## What a probe reads from is not what the baseline is taken against. With no cut-off, a source that can narrow reads from the wait's start.
		local waitReadFloor="${waitSince:-$waitStart}"

		## Sources are read shortest check interval first (S5.7), sorted once: no interval changes while one wait runs. The sort comes before
		## the floors, the baselines and the probe functions below, which are kept by position: sorted after them, a source read the floor
		## and the baseline of the one that had stood at its new index, and the session thread's new message was dropped as older than a
		## floor that was never its own.
		## The order is made by the shell (call-path audit row 58): each source is put after the last one whose interval is not longer,
		## and two of one interval stand in the byte order of their names, as `sort -n` over `<interval> <source>` lines placed them.
		local roundPlanSource roundPlanTtl roundPlanTtls=() roundPlanNames=() roundPlanCount=0 roundPlanAt roundPlanGap
		for roundPlanSource in $waitSources ; do
			## The TTL the caller gave the source when it added it (AgentsWaitTtlOwn), else the kind's own.
			roundPlanTtl=""
			case "$waitTtls" in *" $roundPlanSource="*) roundPlanTtl="${waitTtls#* $roundPlanSource=}" ; roundPlanTtl="${roundPlanTtl%% *}" ;; esac
			[ -n "$roundPlanTtl" ] || roundPlanTtl="$( AgentsWaitTtlOf "$roundPlanSource" )"
			case "$roundPlanTtl" in ''|*[!0-9]*) roundPlanTtl=0 ;; esac
			roundPlanAt="$roundPlanCount"
			while [ "$roundPlanAt" -gt 0 ] && AgentsWaitPlanAfter "${roundPlanTtls[$(( roundPlanAt - 1 ))]}" "${roundPlanNames[$(( roundPlanAt - 1 ))]}" "$roundPlanTtl" "$roundPlanSource" ; do
				roundPlanTtls[$roundPlanAt]="${roundPlanTtls[$(( roundPlanAt - 1 ))]}" ; roundPlanNames[$roundPlanAt]="${roundPlanNames[$(( roundPlanAt - 1 ))]}"
				roundPlanAt=$(( roundPlanAt - 1 ))
			done
			roundPlanTtls[$roundPlanAt]="$roundPlanTtl" ; roundPlanNames[$roundPlanAt]="$roundPlanSource"
			roundPlanCount=$(( roundPlanCount + 1 ))
		done
		waitSources="" ; roundPlanAt=0
		while [ "$roundPlanAt" -lt "$roundPlanCount" ] ; do
			waitSources="$waitSources${roundPlanNames[$roundPlanAt]} " ; roundPlanAt=$(( roundPlanAt + 1 ))
		done

		## One floor per source, and a stored floor is never dropped. The rules that combine it with a since are in MAGIC.md.
		local waitFloorOf=() waitFloorNew=() waitFloorsUsed="" floorIndex=0 floorStored floorStoredIndex floorStoredSource
		[ "$waitMode" != "continue" ] || waitBaselineMode="stored"
		## A collect resumes each Slack source and the tags from the pointer the session kept for it, and has no stored wait.
		local collectKey="" collectStored
		if [ -n "$waitCollect" ] ; then
			type AgentsToolsSessionChatKey > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionChat.include" 2> /dev/null || :
			AgentsToolsSessionChatKeyInto ; collectKey="$agentsSessionChatKey"
			if [ -n "$collectKey" ] ; then
				for checkSource in $waitSources ; do
					case "$checkSource" in slack:*|tagged:*) ;; *) continue ;; esac
					collectStored="$( AgentsToolsSessionChatPointer "$collectKey" "collect:$memberName:$checkSource" 2> /dev/null )" || continue
					waitFloors="$waitFloors$checkSource=$collectStored "
				done
			fi
		fi
		for checkSource in $waitSources ; do
			floorIndex=$(( floorIndex + 1 ))
			waitFloorOf[$floorIndex]="$waitReadFloor"
			floorStored=""
			case " $waitFloors" in
				*" $checkSource="*)
					floorStored="${waitFloors#*"$checkSource="}"
					floorStored="${floorStored%% *}"
				;;
			esac
			if [ -n "$floorStored" ] ; then
				if [ -z "$waitSince" ] ; then
					waitFloorOf[$floorIndex]="$floorStored"
				else
					case "${checkSource/#slack:client:/slack:}" in
						slack:*:*:conversation) ;;
						slack:*:*) floorStored="" ;;
					esac
					[ -z "$floorStored" ] || AgentsWaitTsNewer "$floorStored" "$waitSince" || waitFloorOf[$floorIndex]="$floorStored"
				fi
			elif [ -z "$waitSince" ] ; then
				case "${checkSource/#slack:client:/slack:}" in
					slack:*:*:conversation)
						## The older of the two is the floor, so a message that landed before the member's own last post still arrives.
						local convFloorCandidate=""
						if [ -n "$waitOwnPost" ] && [ "$checkSource" = "slack:${waitOwnPost%% *}:conversation" ] ; then
							convFloorCandidate="${waitOwnPost##* }"
						fi
						if [ -n "$waitSessionStart" ] && [ "$waitSessionStart" -lt "$waitStart" ] ; then
							if [ -z "$convFloorCandidate" ] || AgentsWaitTsNewer "$convFloorCandidate" "$waitSessionStart" ; then
								convFloorCandidate="$waitSessionStart"
							fi
						fi
						if [ -n "$convFloorCandidate" ] && ! AgentsWaitTsNewer "$convFloorCandidate" "$waitStart" ; then
							waitFloorOf[$floorIndex]="$convFloorCandidate"
						fi
					;;
				esac
			fi
			case "$checkSource" in
				slack:*)
					waitFloorsUsed="$waitFloorsUsed$checkSource=${waitFloorOf[$floorIndex]} "
					AgentsWaitEmpty "$waitDir/base.$floorIndex"
				;;
				*)
					if [ "$waitMode" = "continue" ] ; then
						[ ! -f "$waitStateDir/base.$floorIndex" ] || AgentsWaitCopy "$waitStateDir/base.$floorIndex" "$waitDir/base.$floorIndex"
						## An inbox renders from its floor, continued from when the stored wait ended, so what came between two calls is new.
						case "$checkSource" in
							inbox:*) [ ! -f "$waitStateDir/base.$floorIndex" ] || waitFloorOf[$floorIndex]="$( date -r "$waitStateDir/base.$floorIndex" +%s 2> /dev/null || printf '%s' "${waitFloorOf[$floorIndex]}" )" ;;
						esac
					elif [ "$waitMode" = "default" ] ; then
						## The kept directory still holds the baseline of whatever source stood at this index in the last call. It goes: a source
						## that was not stored at this index is read first-probe, and is never compared to another source's old rendering,
						## which read as an arrival with an empty block. A held source takes its stored baseline back below.
						rm -f "$waitDir/base.$floorIndex" 2> /dev/null || :
						## A since is a Slack-source floor and says nothing about a non-Slack source's stored baseline, which a held source carries forward.
						floorStoredIndex=0
						for floorStoredSource in $waitStoredSources ; do
							floorStoredIndex=$(( floorStoredIndex + 1 ))
							[ "$floorStoredSource" = "$checkSource" ] || continue
							[ ! -f "$waitStateDir/base.$floorStoredIndex" ] || AgentsWaitCopy "$waitStateDir/base.$floorStoredIndex" "$waitDir/base.$floorIndex"
							break
						done
					fi
				;;
			esac
		done
		## The stored baselines are taken over above; what is stored again is this wait's own.
		[ "$waitMode" != "default" ] || rm -f "$waitStateDir"/base.* 2>/dev/null || true

		## THE NAP STARTS NO PROCESS (S12.7): a `sleep` a tick is a fork a tick, and an idle run waits a tick a second for
		## hours, so that fork rather than any probe is what an idle estate cost the machine. A fifo this wait holds both
		## ends of, waited on by the shell's own `read -t`, blocks for the nap and starts nothing. Measured on bash 3.2.57:
		## a read of 300 seconds is woken by TERM as promptly as a sleep is, so a wait is still ended the way it was.
		local waitNapFifo="" waitNapLine=""
		if mkfifo "$waitDir/nap.fifo" 2> /dev/null || [ -p "$waitDir/nap.fifo" ] ; then
			## The redirection is on the block and not on the `exec`, which given redirections alone would keep them for the
			## life of this shell: on the exec itself, `2> /dev/null` would silence every line the wait still owes.
			{ exec 6<> "$waitDir/nap.fifo" ; } 2> /dev/null && waitNapFifo="yes"
		fi

		local waitRound=0 waitOutcome="TIMEOUT" waitHits=""
		local waitProbeFailures="" waitReadSources="" waitRemindNext=0 waitProbedAt=() waitDeferred="" waitReturned="" waitPermissionErrors="" waitDetachedTask=""
		## The TTL holds across Waits. A source is checked only once its TTL has passed since any Wait of the session last checked it.
		local waitProbedFile="" probedSource probedAt probedIndex=0 probedLines="" probedName probedWhen
		if [ -n "$waitStateDir" ] ; then
			waitProbedFile="$waitStateDir/probed"
			## ONE READ OF THE FILE, BY THE SHELL (call-path audit row 6): each line is `<source><tab><at>`, and the sources of this
			## Wait pick their own out of it, the last line of a source winning as the awk before took it. No process per source.
			if [ -f "$waitProbedFile" ] ; then
				while IFS=$'\t' read -r probedName probedWhen || [ -n "$probedName" ] ; do
					[ -n "$probedName" ] || continue
					probedLines="$probedLines"$'\n'"$probedName"$'\t'"$probedWhen"
				done < "$waitProbedFile" 2> /dev/null
			fi
			for probedSource in $waitSources ; do
				probedIndex=$(( probedIndex + 1 ))
				case "${probedSource%%:*}" in tagged|scan|mentions|dms|slack) ;; *) continue ;; esac
				probedAt=0
				case "$probedLines" in
					*$'\n'"$probedSource"$'\t'*)
						probedAt="${probedLines##*$'\n'"$probedSource"$'\t'}"
						probedAt="${probedAt%%$'\n'*}"
					;;
				esac
				case "$probedAt" in ''|*[!0-9]*) probedAt=0 ;; esac
				[ "$probedAt" = 0 ] || waitProbedAt[$probedIndex]="$probedAt"
			done
		fi
		## What the other sources of this wait read, for the floor to leave to them (AgentsWaitCoveredSet).
		agentsWaitCovered="?" ; agentsWaitCoverSources="$waitSources"
		## The probe function of each source is resolved once, because it cannot change while this wait runs.
		local waitRoundFn=() waitRoundIndex=0 waitRoundSource
		for waitRoundSource in $waitSources ; do
			waitRoundIndex=$(( waitRoundIndex + 1 ))
			waitRoundFn[$waitRoundIndex]="$( AgentsWaitProbeFunctionName "${waitRoundSource%%:*}" )"
		done
		## A Slack look is served from the comms cache at the age waitCacheTtl, so a Wait never re-reads a long thread whole.
		local waitCacheTtl=1
		case "${MDAT_SLACK_THREAD_CACHE_SECONDS:-1}" in 0) waitCacheTtl=0 ;; esac
		while : ; do
			waitRound=$(( waitRound + 1 ))
			## A caller that is gone takes its wait with it: signal 0 asks about the starting process and forks nothing.
			case "$waitCallerPid" in
				''|*[!0-9]*) ;;
				*)
					if ! kill -0 "$waitCallerPid" 2> /dev/null ; then
						AgentsWaitFolderEnd
						echo "WAIT-RESULT: ERROR"
						echo "⛔ ERROR: $MDSC_CMD --wait-for-input: the process that started this wait is gone, so nothing is waiting for its result. The wait ended at once." >&2
						set +e ; return 1
					fi
				;;
			esac
			## A wait whose directory was taken from under it reads nothing any more: it ends here (AgentsWaitLost).
			if AgentsWaitLost "$waitDir" ; then waitOutcome="LOST" ; break ; fi
			local roundSource roundKind roundTarget roundFn roundQuietFrom roundQuiet roundStaleOk roundIndex=0 roundRc roundEvery roundNow sourceNow roundTtl roundSlowGap="" roundProbeTimeout=""
			roundNow=$(( waitStart + SECONDS - waitSecs0 ))
			## ONE CLOCK A ROUND (call-path audit rows 15 and 18): the probes read agentsWaitRoundNow where it is set, and fork a date
			## of their own only when called outside a round.
			agentsWaitRoundNow="$roundNow"
			for roundSource in $waitSources ; do
				roundIndex=$(( roundIndex + 1 ))
				## A round reads every source it holds (MAGIC.md, THE RETURN BOUND): a hit does not end it, so a return carries the floor and the
				## messages of the other sources together. A scan alone stays unbegun once something has arrived (below).
				## The bound is looked at before each source: one slow source read past it held the whole call past it.
				## A timeout of 0 reads every source once and returns after the round (below): its bound is spent at the start, and a check here would read none.
			## The first round reads every source whatever the bound says: a wait whose start-up spent its bound would otherwise end having read nothing, and say WAIT-NEVER-READ of every source.
			[ "$waitRound" = "1" ] || [ -z "$waitDeadline" ] || [ "${waitTimeout:-0}" = "0" ] || [ $(( waitStart + SECONDS - waitSecs0 )) -lt "$waitDeadline" ] || break
				roundKind="${roundSource%%:*}"
				roundTarget="${roundSource#*:}"
				roundFn="${waitRoundFn[$roundIndex]}"
				roundEvery="${agentsWaitKindEvery#*"$roundKind:"}"
				roundEvery="${roundEvery%% *}"
				## A kind the list does not name is read every round.
				case "$roundEvery" in ''|*[!0-9]*) roundEvery=1 ;; esac
				[ "$waitRound" = "1" ] || [ $(( ( waitRound - 1 ) % roundEvery )) = "0" ] || continue
				## While the previous check of a source is inside its TTL the source is skipped, and a source skipped so is not one never read.
				case "$roundKind" in
					tagged|scan|mentions|dms)
						roundTtl="$( AgentsWaitTtlOf "$roundSource" )"
						## A duty's DMs, mentions and tags are due at the poll, never at their own TTL.
						[ -z "${waitDutyRun:-}" ] || ! AgentsWaitImmediateKind "$roundKind" || roundTtl="$agentsWaitImmediateGap"
						## The TTL the caller gave the source when it added it, where it gave one (AgentsWaitTtlOwn).
						case "$waitTtls" in *" $roundSource="*) roundTtl="${waitTtls#* $roundSource=}" ; roundTtl="${roundTtl%% *}" ;; esac
						if [ "$roundTtl" != "0" ] && [ $(( roundNow - ${waitProbedAt[$roundIndex]:-0} )) -lt "$roundTtl" ] ; then
							case "$waitReadSources" in *"[$roundSource]"*) ;; *) waitReadSources="$waitReadSources[$roundSource] " ;; esac
							continue
						fi
					;;
				esac
				## The tick and the slow look: a local source is read every tick, a costly one only once the slow gap has passed.
				if [ "$waitBackoff" = "true" ] ; then
					case " $agentsWaitKindLocal " in
						*" $roundKind "*) ;;
						*)
							## A named Slack source has its own TTL floor too, kept inside this backoff-only branch, so a named poll interval still reads every round.
							if [ "$roundKind" = "slack" ] ; then
								roundTtl="$( AgentsWaitTtlOf "$roundSource" )"
								## The TTL the caller gave the source when it added it, where it gave one (AgentsWaitTtlOwn).
								case "$waitTtls" in *" $roundSource="*) roundTtl="${waitTtls#* $roundSource=}" ; roundTtl="${roundTtl%% *}" ;; esac
								## The source backs off while it brings nothing, from its TTL to twenty times it -- quiet from its floor, or from this wait's start where the floor is older (S27.9).
								roundQuietFrom="${waitFloorOf[$roundIndex]%%.*}"
								case "$roundQuietFrom" in ''|*[!0-9]*) roundQuietFrom="$waitStart" ;; *) [ "$roundQuietFrom" -ge "$waitStart" ] || roundQuietFrom="$waitStart" ;; esac
								roundQuiet=$(( roundNow - roundQuietFrom ))
								[ "$roundQuiet" -ge 0 ] || roundQuiet=0
								[ "$roundQuiet" -le $(( roundTtl * 200 )) ] || roundQuiet=$(( roundTtl * 200 ))
								roundTtl=$(( roundTtl + 19 * roundQuiet / 200 ))
								if [ "$roundTtl" != "0" ] && [ $(( roundNow - ${waitProbedAt[$roundIndex]:-0} )) -lt "$roundTtl" ] ; then
									case "$waitReadSources" in *"[$roundSource]"*) ;; *) waitReadSources="$waitReadSources[$roundSource] " ;; esac
									continue
								fi
							fi
							[ -n "$roundSlowGap" ] || { waitActivity="$( AgentsWaitNewestActivity "$waitStart" "$waitSessionId" "$waitSources" "$waitFloorsUsed" )" ; roundSlowGap="$( AgentsWaitBackoffNap "$roundNow" "${waitActivity%%$'\t'*}" )" ; }
							## A source skipped here was read within its own slow gap, so it is not one never read. A duty's immediate source is never left to it.
							if [ $(( roundNow - ${waitProbedAt[$roundIndex]:-0} )) -lt "$roundSlowGap" ] \
								&& { [ -z "${waitDutyRun:-}" ] || ! AgentsWaitImmediateKind "$roundKind" ; } ; then
								case "$waitReadSources" in *"[$roundSource]"*) ;; *) waitReadSources="$waitReadSources[$roundSource] " ;; esac
								continue
							fi
						;;
					esac
				fi
				## A round reads every source it holds. A scan not yet begun stays unbegun once something has arrived or the bound has passed.
				if [ "$roundKind" = "scan" ] && { [ "$waitOutcome" = "RECEIVED" ] || { [ -n "$waitDeadline" ] && [ "$roundNow" -lt "$waitDeadline" ] && [ $(( waitStart + SECONDS - waitSecs0 )) -ge "$waitDeadline" ] ; } ; } ; then
					continue
				fi
				waitProbedAt[$roundIndex]="$roundNow"
				## The check is kept for the next Wait of the session. It is written with the others at most every 30 seconds and when the state is stored.
				if [ -n "$waitProbedFile" ] ; then
					case "$roundKind" in
						tagged|scan|mentions|dms|slack)
							waitProbedDirty="yes"
							[ $(( SECONDS - ${waitProbedFlushedAt:--100} )) -lt 30 ] || AgentsWaitProbedFlush
						;;
					esac
				fi

				roundRc=0
				## A source takes the cache's look, and one with under two seconds left is served what the cache holds, its refresh detached. Its clock is its own start, never the round's.
				sourceNow=$(( waitStart + SECONDS - waitSecs0 ))
				roundStaleOk=""
				## The first round is never served stale: it is the one read a short call makes, and a stale read returns nothing that arrived since.
				case "$roundKind" in slack|ask|replies|dms) [ "$waitRound" = "1" ] || [ -z "$waitDeadline" ] || [ $(( waitDeadline - sourceNow )) -ge 2 ] || roundStaleOk="true" ;; esac
				## A probe past the bound is never cut short, but it no longer holds the call: a costly probe is handed to the task wrapper.
				roundProbeTimeout=""
				## Chat and replies are excluded here, because each makes a real Slack call and must not be exempt from the bound wrapper.
				case " $agentsWaitKindUnbounded " in
					*" $roundKind "*) ;;
					## A zero bound is one pass and no wait, so the probe is read in line and finishes.
					*) [ -z "$waitDeadline" ] || [ "${waitTimeout:-0}" = "0" ] || roundProbeTimeout=$(( waitDeadline - sourceNow )) ;;
				esac
				## A wrapper is never given the last second, because below two seconds the round reads that source in line instead.
				case "$roundProbeTimeout" in
					''|*[!0-9]*) roundProbeTimeout="" ;;
					*) [ "$roundProbeTimeout" -ge 2 ] || roundProbeTimeout="" ;;
				esac
				## CACHE-ONLY WHERE A COMMS THREAD IS LIVE: with none (a check rig, a rig whose thread ended) a cache-only read waits on a cache
				## nobody fills and every source stands never-read (AgentsWaitOwnPostRepliesCheck, 24 of 24). MDAT_WAIT_CACHE_ONLY given wins; else the
				## lock of the comms thread decides, once a call.
				if [ -z "${waitCacheOnly:-}" ] ; then
					waitCacheOnly="${MDAT_WAIT_CACHE_ONLY:-}"
					if [ -z "$waitCacheOnly" ] ; then
						type AgentsToolsSessionCommsLive > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionComms.include" 2> /dev/null || :
						if type AgentsToolsSessionCommsLive > /dev/null 2>&1 && AgentsToolsSessionCommsLive > /dev/null 2>&1 ; then waitCacheOnly=true ; else waitCacheOnly=false ; fi
					fi
				fi
				## A Wait's reads are of the comms cache alone (MDAT_COMMS_CACHE_ONLY): the one comms thread ingests, and no probe calls Slack, so
				## a probe read in line is cheap and a round never pays a Retry-After. A costly probe past the bound is handed to the task wrapper.
				## A CACHE-ONLY PROBE IS READ IN LINE: its only wait is the folder's fifo, bounded below to end inside the round's own bound. Under the
				## wrapper, a probe that waited its fifo budget crossed the wrapper's window, was detached, and the source stood never-read with the
				## cache already served beside it (AgentsWaitRepliesFirstLookCheck, 11 of 19).
				if [ -n "$roundProbeTimeout" ] && [ "$waitCacheOnly" != "true" ] ; then
					type AgentsToolsTaskCall > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.ToolTask.include" 2> /dev/null || :
					## With no session id set, the task call runs the probe in line with no bound, so this wait passes its own session id.
					## A probe is a read of what reaches the member, so a chat message does not detach it (MDAT_TOOL_TASK_NO_MESSAGE): it is what the probe reads.
					MDAT_COMMS_CACHE_ONLY="$waitCacheOnly" MDAT_COMMS_CACHE_WAIT_SECONDS="$(( roundProbeTimeout < 30 ? roundProbeTimeout : 30 ))" MDAT_COMMS_CACHE_WAIT_UNTIL="$(( sourceNow + ( roundProbeTimeout < 30 ? roundProbeTimeout : 30 ) ))" MDAT_COMMS_CACHE_STALE_OK="$roundStaleOk" MDAT_SLACK_THREAD_CACHE_SECONDS="$waitCacheTtl" \
						MDAT_SPAWN_SESSION_ID="${harnessSessionId:-${MDAT_SPAWN_SESSION_ID:-${CLAUDE_CODE_SESSION_ID:-$waitSessionId}}}" MDAT_TOOL_TASK_NO_MESSAGE=yes \
						AgentsToolsTaskCall "wait probe $roundSource" "" "$roundProbeTimeout" return "$roundFn" "$memberName" "$roundTarget" "${waitFloorOf[$roundIndex]}" "$waitDir/now.$roundIndex" "${waitAddressee% }" "$waitIncludeOwn" "$waitDir/base.$roundIndex" \
						|| roundRc=$?
					if [ "$agentsTaskDetached" = yes ] ; then
						## A detached probe ends no round: it is named as unread, and the round goes on to its remaining sources.
						waitDetachedTask="$agentsTaskHandle ($roundSource)"
						[ "$waitOutcome" = "RECEIVED" ] || waitOutcome="TIMEOUT"
						continue
					fi
					[ "$agentsTaskRc" = 0 ] || roundRc="$agentsTaskRc"
				else
					## THE BUDGET IS ONE MOMENT FOR THE WHOLE PROBE (MDAT_COMMS_CACHE_WAIT_UNTIL): a probe over several folders shares it, so a round never
					## outlives the Wait's bound by the seconds times the folders (the ask probe over three asks held a 300 s Wait for 500).
					MDAT_COMMS_CACHE_ONLY="$waitCacheOnly" MDAT_COMMS_CACHE_WAIT_SECONDS="$( [ -n "$waitDeadline" ] && [ "${waitTimeout:-0}" != "0" ] && [ $(( waitDeadline - sourceNow )) -gt 0 ] && printf '%s' $(( waitDeadline - sourceNow < 30 ? waitDeadline - sourceNow : 30 )) || printf 0 )" MDAT_COMMS_CACHE_WAIT_UNTIL="$( [ -n "$waitDeadline" ] && [ "${waitTimeout:-0}" != "0" ] && [ $(( waitDeadline - sourceNow )) -gt 0 ] && printf '%s' $(( waitDeadline - sourceNow < 30 ? waitDeadline : sourceNow + 30 )) || printf '' )" MDAT_COMMS_CACHE_STALE_OK="$roundStaleOk" MDAT_SLACK_THREAD_CACHE_SECONDS="$waitCacheTtl" "$roundFn" "$memberName" "$roundTarget" "${waitFloorOf[$roundIndex]}" "$waitDir/now.$roundIndex" "${waitAddressee% }" "$waitIncludeOwn" "$waitDir/base.$roundIndex" || roundRc=$?
				fi
				## A source denied by a permission is an error of its own, said in the header, and is not a source never read.
				if [ "$roundRc" = "4" ] ; then
					## A probe whose own files went with the wait's directory is no denial: the wait ends on it.
					if AgentsWaitLost "$waitDir" ; then waitOutcome="LOST" ; break ; fi
					case "$waitPermissionErrors" in
						*"[$roundSource]"*) ;;
						*) waitPermissionErrors="$waitPermissionErrors[$roundSource] $( head -1 "$waitDir/now.$roundIndex.permission" 2> /dev/null )"$'\n' ;;
					esac
					case "$waitReadSources" in *"[$roundSource]"*) ;; *) waitReadSources="$waitReadSources[$roundSource] " ;; esac
					: > "$waitDir/now.$roundIndex"
					continue
				fi
				## A SOURCE THE CACHE DOES NOT SERVE YET (rc 5): the comms service thread has not pulled it, and the probe made no call of its own,
				## as the design says. It is no failure and no read: the source stands in WAIT-NEVER-READ until a round finds it served.
				## An unserved probe was no probe: its TTL clock is not started, so the next round asks the cache again instead of reading nothing
				## inside the TTL and counting the source as read.
				[ "$roundRc" != "5" ] || { waitProbedAt[$roundIndex]=0 ; continue ; }
				if [ "$roundRc" != "0" ] ; then
					## A probe that missed what this wait itself wrote is no unreachable source: the wait ends on it.
					if AgentsWaitLost "$waitDir" ; then waitOutcome="LOST" ; break ; fi
					## A probe that cannot run is reported and the wait carries on over the sources that can.
					case "$waitProbeFailures" in
						*"[$roundSource]"*) ;;
						*) waitProbeFailures="$waitProbeFailures[$roundSource] " ;;
					esac
					continue
				fi
				## Which sources were read at least once, so the TIMEOUT text claims a read only for those.
				case "$waitReadSources" in
					*"[$roundSource]"*) ;;
					*) waitReadSources="$waitReadSources[$roundSource] " ;;
				esac

				## A rendering that is not there differs from every baseline, and is no arrival.
				AgentsWaitOwnFile "$waitDir/now.$roundIndex" || { waitOutcome="LOST" ; break ; }
				## What a look at the posts found nothing to return is stored at once, and what it found once it is said.
				if [ "$roundKind" = "replies" ] && [ ! -s "$waitDir/now.$roundIndex" ] ; then
					AgentsWaitRepliesCommit "$roundTarget" "$waitDir/now.$roundIndex.advance"
				fi
				## The same for the session chat file: a look that found nothing to return moved past what it read (the covered, the not its own).
				if [ "$roundKind" = "chat" ] && [ ! -s "$waitDir/now.$roundIndex" ] ; then
					AgentsWaitChatCommit "$roundTarget" "$memberName" "$waitDir/now.$roundIndex.newest"
				fi
				if [ ! -f "$waitDir/base.$roundIndex" ] ; then
					if [ "$waitBaselineMode" = "empty" ] || case " $agentsWaitKindEmptyBaseline " in *" $roundKind "*) true ;; *) false ;; esac ; then
						: > "$waitDir/base.$roundIndex"
					else
						cp "$waitDir/now.$roundIndex" "$waitDir/base.$roundIndex" 2>/dev/null || : > "$waitDir/base.$roundIndex"
						continue
					fi
				fi

				## The wake marker is no arrival of its own: it is taken as read and every source is read again at once.
				if [ "$roundKind" = "wake" ] ; then
					if ! AgentsWaitSameFile "$waitDir/base.$roundIndex" "$waitDir/now.$roundIndex" ; then
						cp "$waitDir/now.$roundIndex" "$waitDir/base.$roundIndex" 2>/dev/null || : > "$waitDir/base.$roundIndex"
						waitWakeSeen=1
					fi
					continue
				fi

				## Every source is scanned and every changed one is returned. An empty rendering of an arrivals-only or Slack source is no arrival.
				if ! AgentsWaitSameFile "$waitDir/base.$roundIndex" "$waitDir/now.$roundIndex" \
					&& { LC_ALL=C grep -q '[^[:space:]]' "$waitDir/now.$roundIndex" 2> /dev/null || case " $agentsWaitKindEmptyBaseline slack " in *" $roundKind "*) false ;; *) true ;; esac ; } \
					&& case " $agentsWaitKindArrivalsOnly " in
						*" $roundKind "*) LC_ALL=C awk 'FILENAME == ARGV[1] { seen[$0] = 1 ; next } !( $0 in seen ) { added = 1 ; exit } END { exit !added }' "$waitDir/base.$roundIndex" "$waitDir/now.$roundIndex" ;;
						*) true ;;
					esac \
					&& { [ "$roundKind" != "replies" ] || LC_ALL=C grep -q -E -e '^[0-9]+\.[0-9]+ \| ' -e '^reactions on your post ' "$waitDir/now.$roundIndex" 2> /dev/null ; } ; then
					if [ -n "$waitCollect" ] && [ "$roundKind" != "tagged" ] && [ "$roundKind" != "mentions" ] && [ "$roundKind" != "dms" ] ; then
						## In a collect only the tags are immediate: every other source accumulates until the window ends.
						case " $waitDeferred" in *" $roundIndex=$roundSource "*) ;; *) waitDeferred="$waitDeferred$roundIndex=$roundSource " ;; esac
					else
						waitOutcome="RECEIVED"
						waitHits="$waitHits$roundIndex=$roundSource "
						[ -z "$waitCollect" ] || waitReturned="immediate"
					fi
				fi
			done
			[ "$waitOutcome" != "LOST" ] || break
			[ "$waitOutcome" != "RECEIVED" ] || break
			## A wait whose bound is spent returns now, its detached probe named in the header. The next call reads on.
			[ -z "$waitDetachedTask" ] || { [ -z "$waitDeadline" ] || [ "$roundNow" -lt "$waitDeadline" ] || break ; }
			## Unbounded, a first round that read no source at all returns TIMEOUT with WAIT-NEVER-READ at once.
			[ -n "$waitDeadline" ] || [ -n "$waitReadSources" ] || break

			## The wake marker was written, so every source, scans included, is read again now with no sleep first.
			if [ -n "$waitWakeSeen" ] ; then
				waitWakeSeen=""
				local waitWakeAt=0 waitWakeSource
				for waitWakeSource in $waitSources ; do
					waitWakeAt=$(( waitWakeAt + 1 ))
					waitProbedAt[$waitWakeAt]=0
				done
				continue
			fi

			local waitNow waitRemaining waitNap
			waitNow=$roundNow
			## The asks this wait stands for are reminded from here, after a round that brought nothing, at most once a minute.
			if [ "$waitNow" -ge "$waitRemindNext" ] ; then
				waitRemindNext=$(( waitNow + 60 ))
				AgentsWaitRemind "$waitSessionId" "$waitSources" "$waitDir" || :
			fi
			if [ -n "$waitDeadline" ] && [ "$waitNow" -ge "$waitDeadline" ] ; then
				break
			fi
			## THE NAP IS THE NEAREST PENDING CHECK (S5.7), never longer than the caller's own interval: with nothing due a
			## wait sleeps up to the first source that comes due, so a costly source is not re-read on every tick.
			waitNap="$waitPoll"
			## A wait woken by pokes naps its long fallback: the interval was not named, the nap is a fifo, and no source is one that no writer pokes.
			if [ -n "$waitNapFifo" ] && [ "$waitBackoff" = "true" ] && [ "$waitNap" -lt "${agentsWaitIdleSeconds:-0}" ] 2> /dev/null ; then
				case " $waitSources" in *" file:"*|*" process:"*|*" ask:"*) ;; *) waitNap="$agentsWaitIdleSeconds" ;; esac
			fi
			local napIndex=0 napNext="" napGap
			for roundPlanSource in $waitSources ; do
				napIndex=$(( napIndex + 1 ))
				napNext="$( AgentsWaitTtlOf "$roundPlanSource" )"
				case "$napNext" in ''|*[!0-9]*|0) continue ;; esac
				napGap=$(( ${waitProbedAt[$napIndex]:-0} + napNext - waitNow ))
				[ "$napGap" -gt 0 ] || napGap=1
				[ "$waitNap" -le "$napGap" ] || waitNap="$napGap"
			done
			if [ -n "$waitDeadline" ] ; then
				waitRemaining=$(( waitDeadline - waitNow ))
				[ "$waitNap" -le "$waitRemaining" ] || waitNap="$waitRemaining"
			fi
			## The only thing this process does between probes. No spin, no token, and no process.
			## A read that waited out its whole time reports 1, as `sleep` reports 0: the guard carries that, or `set -e` ends the wait.
			if [ -n "$waitNapFifo" ] ; then
				IFS= read -r -t "$waitNap" -u 6 waitNapLine || :
			else
				sleep "$waitNap"
			fi
		done
		[ -z "$waitNapFifo" ] || exec 6>&-
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.MemberWaitResult.include"
		return $?
