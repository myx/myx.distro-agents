#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.InternTeamDataCommit.include -- the one thread that commits and pushes the team data (S12.4), run on the shared
## on-demand thread (S12.11, AgentsTools.OnDemandThread.include): a shell process of the tooling and no agent. Sourced from
## DistroAgentsTools.fn.sh's `--intern-team-data-commit` arm; needs $1/$@/$MDSC_CMD from dot-sourcing. What a request does and
## where the thread keeps its files: AgentsTools.TeamDataThread.include. A sibling of --intern-source-collect: a usage blurb on no
## mode, the same set +e/set -e discipline, `--run` stays and `--one` makes one pass and ends.
##
## ONE A STORE ON A HOST: its lock is thread.lock in team-data-commit/ of the store's git directory, held for the life of the process
## (AgentsTools.ThreadLock.include). It starts where a writer asks for one and none lives, and ends by itself once no request came for
## MDAT_TEAM_DATA_COMMIT_IDLE_SECONDS (a minute), and on TERM. It runs as no member.
##

case "$1" in

	--intern-team-data-commit)
		shift

		## Never run without a mode: an accidental invocation would stay.
		local teamThreadMode=''
		case "${1:-}" in
			--run) teamThreadMode='--run' ;;
			--one) teamThreadMode='--one' ;;
			--start) teamThreadMode='--start' ;;
		esac
		if [ -z "$teamThreadMode" ] ; then
			printf '%s\n' "$MDSC_CMD --intern-team-data-commit -- the one thread that commits and pushes the team data: a shell process of the tooling. A writer of the team data writes its files and leaves an entry, and no agent runs it or calls it." >&2
			printf '%s\n' "" >&2
			printf '%s\n' "  $MDSC_CMD --intern-team-data-commit --run" >&2
			printf '%s\n' "      The thread: takes the lock of the store, commits the entries that wait, one commit each, oldest first, and pushes once. Ends on TERM, and by itself when no request came for MDAT_TEAM_DATA_COMMIT_IDLE_SECONDS (60)." >&2
			printf '%s\n' "" >&2
			printf '%s\n' "  $MDSC_CMD --intern-team-data-commit --one" >&2
			printf '%s\n' "      One pass under the same lock, then the end: for a test, and for a check by hand." >&2
			printf '%s\n' "" >&2
			printf '%s\n' "  $MDSC_CMD --intern-team-data-commit --start" >&2
			printf '%s\n' "      Starts the thread detached where none lives, and says alive <pid>, started <pid> or failed - <why>." >&2
			printf '%s\n' "" >&2
			printf '%s\n' "Its files are in team-data-commit/ of the git directory of the store: request.fifo, thread.lock, thread.log, and the entries of the writers." >&2
			set +e ; return 1
		fi
		shift
		if [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-team-data-commit: invalid option: $1" >&2
			set +e ; return 1
		fi
		[ -n "${MDAT_DATA_ROOT:-}" ] && [ -n "${MMDAPP:-}" ] || {
			echo "⛔ ERROR: $MDSC_CMD --intern-team-data-commit: MDAT_DATA_ROOT or MMDAPP is not set" >&2
			set +e ; return 1
		}

		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.TeamDataCommit.include" || { set +e ; return 1 ; }
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.TeamDataThread.include" || { set +e ; return 1 ; }
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/common/AgentsTools.OnDemandThread.include" || { set +e ; return 1 ; }
		set +e +u

		local teamThreadDir="" teamThreadIdle="${MDAT_TEAM_DATA_COMMIT_IDLE_SECONDS:-60}"
		case "$teamThreadIdle" in ''|*[!0123456789]*|0) teamThreadIdle=60 ;; esac
		teamThreadDir="$( AgentsToolsTeamDataThreadDir )" || {
			echo "⛔ ERROR: $MDSC_CMD --intern-team-data-commit: $MDAT_DATA_ROOT is no repository -- nothing was started" >&2
			return 1
		}

		if [ "$teamThreadMode" = "--start" ] ; then
			AgentsToolsOnDemandThreadStart "$teamThreadDir" --intern-team-data-commit --run
			return $?
		fi

		## IT RUNS AS NO MEMBER: each name that carries a member's session is emptied here, for this operation and what it starts.
		local teamThreadDrop
		for teamThreadDrop in ${!MDAT_SPAWN_@} MDAT_SESSION_ID MDAT_SESSION_THREAD MDAT_CONVERSATION_THREADS harnessSessionId harnessAgent CLAUDE_CODE_SESSION_ID ; do
			[ -z "${!teamThreadDrop+set}" ] || local -x "$teamThreadDrop="
		done

		if [ "$teamThreadMode" = "--run" ] ; then
			## From here on its input is /dev/null, its output and its errors are its own log, and its working folder is one that does
			## not vanish, so a request it serves never depends on where it was started.
			mkdir -p "$teamThreadDir" 2> /dev/null || { echo "⛔ ERROR: $MDSC_CMD --intern-team-data-commit: could not make $teamThreadDir -- nothing was started" >&2 ; return 1 ; }
			exec < /dev/null >> "$teamThreadDir/thread.log" 2>&1
			case "$MMDAPP:$MDLT_ORIGIN" in /*:/*) cd / 2> /dev/null ;; esac
			AgentsToolsOnDemandThreadServe "$teamThreadDir" "$teamThreadIdle" AgentsToolsTeamDataThreadPass AgentsToolsTeamDataThreadPass no
			return $?
		fi

		AgentsToolsOnDemandThreadServe "$teamThreadDir" 0 AgentsToolsTeamDataThreadPass AgentsToolsTeamDataThreadPass yes
		return $?
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
