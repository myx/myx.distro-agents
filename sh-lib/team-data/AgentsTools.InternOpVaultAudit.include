#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.InternOpVaultAudit.include -- the --intern-op-vault-* and
## --intern-op-audit-* families: the implementation behind the member stubs
## --get-vault-item and --get-audit-item (AgentsTools.Member.include).
## The stubs check who is asking; these resolve and read. Both stores are read through
## AgentsToolsDataRead today, and a later back end of the vault (a Confluence or Google
## Docs one, for example) is a change here, never in a stub or a caller.
##
## Sourced lazily from DistroAgentsTools.fn.sh's `--intern-op-vault-*|--intern-op-audit-*`
## arm. Not standalone: relies on being dot-sourced for $1/$@/$MDSC_CMD.
##

type AgentsToolsDataRead > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.InternOpDataRead.include"

## THE FILE NAME OF A VAULT ITEM (the human-owner's ruling): a vault item is a file with an extension, since the vault holds
## many kinds of file. A name given with no extension names a Markdown document, `.md`, so `epic-blueprint-x` and
## `epic-blueprint-x.md` are one item, on the read and on the write alike.
## Inline at each reader (no function and no substitution on a call path): `case "$name" in *.*) ;; *) name="$name.md" ;; esac`.

## The optional line range both reads take, as a complete pair. Sets rangeArgs.
AgentsToolsVaultAuditRange(){ ## op name, arguments...
	local rangeOp="$1" rangeStart="" rangeEnd=""
	shift
	rangeArgs=()
	while [ $# -gt 0 ] ; do
		case "$1" in
			--start-line)
				[ $# -ge 2 ] || { echo "⛔ ERROR: $MDSC_CMD $rangeOp: --start-line requires a value (<N>)" >&2 ; return 1 ; }
				rangeStart="$2" ; shift 2
			;;
			--end-line)
				[ $# -ge 2 ] || { echo "⛔ ERROR: $MDSC_CMD $rangeOp: --end-line requires a value (<N>)" >&2 ; return 1 ; }
				rangeEnd="$2" ; shift 2
			;;
			*)
				echo "⛔ ERROR: $MDSC_CMD $rangeOp: invalid option: $1" >&2
				return 1
			;;
		esac
	done
	if [ -n "$rangeStart" ] || [ -n "$rangeEnd" ] ; then
		if [ -z "$rangeStart" ] || [ -z "$rangeEnd" ] ; then
			echo "⛔ ERROR: $MDSC_CMD $rangeOp: --start-line and --end-line must be provided together" >&2
			return 1
		fi
		rangeArgs=( --start-line "$rangeStart" --end-line "$rangeEnd" )
	fi
	[ -n "${MDAT_DATA_ROOT:-}" ] || { echo "⛔ ERROR: $MDSC_CMD $rangeOp: MDAT_DATA_ROOT is not set" >&2 ; return 1 ; }
	return 0
}

case "$1" in

	## One vault item by bare filename, with an optional line range. Any bare name: the
	## vault's document types are left open.
	--intern-op-vault-item-read)
		shift
		local itemName="${1:-}" rangeArgs=()
		shift || true
		if [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-op-vault-item-read: syntax is <item-name> [--start-line <N> --end-line <N>]" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$itemName" "<item-name>" intern-op-vault-item-read || { set +e ; return 1 ; }
		case "$itemName" in *.*) ;; *) itemName="$itemName.md" ;; esac
		## A name a vault contract's type word claims is read only in that contract's form (AgentsToolsDocValidateVaultItemName).
		type AgentsToolsDocValidateVaultItemName > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.DocValidate.include"
		local itemNameFault=""
		itemNameFault="$( AgentsToolsDocValidateVaultItemName "$itemName" )" || { echo "⛔ ERROR: $MDSC_CMD --get-vault-item: $itemNameFault -- nothing was read" >&2 ; set +e ; return 1 ; }
		AgentsToolsVaultAuditRange --intern-op-vault-item-read "$@" || { set +e ; return 1 ; }
		AgentsToolsDataRead "$itemName" --context --intern-op-vault-item-read --lookup-folder "$MDAT_DATA_ROOT/vault" ${rangeArgs[@]+"${rangeArgs[@]}"}
		return $?
	;;

	## The vault write, the sibling of the read above: any bare name, written whole or patched.
	## The store and the commit are AgentsToolsItemUpsert's, the same as the board writer's.
	## A name that carries the type word of a vault contract is written only by that contract's typed op: `--typed <kind>`,
	## first after the two names, from the stubs --upsert-vault-<kind>. The generic write refuses such a name. The typed write
	## stamps what a new item lacks, checks the item against its contract (AgentsToolsDocValidateGate), then writes it as the generic one does.
	--intern-op-vault-item-write)
		shift
		local writeMember="${1:-}" writeItem="${2:-}" writeTyped="" writeWord="" writeKind=""
		shift || true
		shift || true
		if [ -z "$writeMember" ] || [ -z "$writeItem" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-op-vault-item-write: syntax is <team-member> <item-name> [--typed <kind>] [--header:<upsert|append|remove>:name[:value]]... [--from-file <path>|--upsert-from-stdin|--edit-patch-from-stdin]" >&2
			set +e ; return 1
		fi
		if [ "${1:-}" = "--typed" ] ; then
			writeTyped="${2:-}"
			[ -n "$writeTyped" ] || { echo "⛔ ERROR: $MDSC_CMD --intern-op-vault-item-write: --typed takes a kind -- nothing was written" >&2 ; set +e ; return 1 ; }
			shift 2
		fi
		[ -n "${MDAT_DATA_ROOT:-}" ] || { echo "⛔ ERROR: $MDSC_CMD --intern-op-vault-item-write: MDAT_DATA_ROOT is not set" >&2 ; set +e ; return 1 ; }
		case "$writeItem" in *.*) ;; *) writeItem="$writeItem.md" ;; esac
		type AgentsToolsDocValidateVaultKind > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.DocValidate.include"
		writeWord="$( AgentsToolsDocValidateVaultItemWord "$writeItem" )" || writeWord=""
		writeKind="$( AgentsToolsDocValidateVaultKind "$writeWord" )" || writeKind=""
		if [ -z "$writeTyped" ] && [ -n "$writeKind" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --upsert-vault-item: $writeItem carries the type word $writeWord of the contract $writeKind, so it is written by --upsert-vault-${writeKind#vault-item.} -- nothing was written" >&2
			set +e ; return 1
		fi
		if [ -n "$writeTyped" ] && [ "$writeKind" != "$writeTyped" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --upsert-vault-${writeTyped#vault-item.}: $writeItem does not start with the type word of the contract $writeTyped -- nothing was written" >&2
			set +e ; return 1
		fi
		local writeNameFault=""
		writeNameFault="$( AgentsToolsDocValidateVaultItemName "$writeItem" )" || { echo "⛔ ERROR: $MDSC_CMD --upsert-vault-${writeTyped#vault-item.}: $writeNameFault -- nothing was written" >&2 ; set +e ; return 1 ; }
		mkdir -p "$MDAT_DATA_ROOT/vault" || { echo "⛔ ERROR: $MDSC_CMD --intern-op-vault-item-write: the vault folder could not be made" >&2 ; set +e ; return 1 ; }
		type AgentsToolsItemUpsert > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.InternOpItem.include"
		if [ -z "$writeTyped" ] ; then
			AgentsToolsItemUpsert "$writeMember" --from-vault "$writeItem" "$@" --context --intern-op-vault-item-write
			return $?
		fi
		local typedPath="$MDAT_DATA_ROOT/vault/$writeItem" typedMode="create" typedLabel="new item" typedBody="" typedOps="" typedTemp="" typedRc=0
		[ ! -f "$typedPath" ] || { typedMode="change" ; typedLabel="$writeItem" ; }
		case "${1:-}" in
			--upsert-from-stdin) typedBody="$( cat )" ; shift ;;
			--from-file)
				[ -f "${2:-}" ] || { echo "⛔ ERROR: $MDSC_CMD --upsert-vault-${writeTyped#vault-item.}: --from-file: file not found: ${2:-} -- nothing was written" >&2 ; set +e ; return 1 ; }
				typedBody="$( cat "$2" )" ; shift 2
			;;
			--edit-patch-from-stdin)
				typedBody="$( printf '%s%s' "$( cat )" "$( [ ! -f "$typedPath" ] || cat "$typedPath" )" | python3 "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsBoardItemPatchApply.py" )" || { set +e ; return 1 ; }
				shift
			;;
			*)
				echo "⛔ ERROR: $MDSC_CMD --upsert-vault-${writeTyped#vault-item.}: syntax is <team-member> <item-name> [--from-file <path>|--upsert-from-stdin|--edit-patch-from-stdin] -- nothing was written" >&2
				set +e ; return 1
			;;
		esac
		if [ $# -gt 0 ] || [ -z "$typedBody" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --upsert-vault-${writeTyped#vault-item.}: one body, given once, and not empty -- nothing was written" >&2
			set +e ; return 1
		fi
		mkdir -p "$MMDAPP/.local/temp" || { set +e ; return 1 ; }
		## The type word and the contract are the typed op's own, so they are stamped on every write; the author and the date are a new item's.
		typedOps="$( mktemp "$MMDAPP/.local/temp/mdat-vault-typed-headers.XXXXXX" )" || { set +e ; return 1 ; }
		printf 'default\ttype\t%s\ndefault\tdocument-contract\t%s\n' "$writeWord" "$writeTyped" > "$typedOps" || { rm -f "$typedOps" ; set +e ; return 1 ; }
		[ "$typedMode" != "create" ] || printf 'default\tfrom\t%s\ndefault\tdate\t%s\n' "$writeMember" "$( date +"%Y-%m-%d %H:%M %z" )" >> "$typedOps" || { rm -f "$typedOps" ; set +e ; return 1 ; }
		typedBody="$( printf '%s\n' "$typedBody" | LC_ALL=C awk -v opsFile="$typedOps" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsBoardItemHeaderOpsApply.awk" )" || typedRc=$?
		rm -f "$typedOps"
		[ "$typedRc" -eq 0 ] || { set +e ; return 1 ; }
		printf '%s\n' "$typedBody" | AgentsToolsDocValidateGate "vault-${writeTyped#vault-item.}-write" "$typedLabel" vault "$writeItem" "$( [ ! -f "$typedPath" ] || printf '%s' "$typedPath" )" "$typedMode" || { set +e ; return 1 ; }
		typedTemp="$( mktemp "$MMDAPP/.local/temp/mdat-vault-typed-body.XXXXXX" )" || { set +e ; return 1 ; }
		printf '%s\n' "$typedBody" > "$typedTemp" || { rm -f "$typedTemp" ; set +e ; return 1 ; }
		AgentsToolsItemUpsert "$writeMember" --from-vault "$writeItem" --from-file "$typedTemp" --context --intern-op-vault-item-write || typedRc=$?
		rm -f "$typedTemp"
		return $typedRc
	;;

	## One audit document by bare filename, with an optional line range. Only transcript-*
	## names, found in its month folder first, then the audit root.
	--intern-op-audit-item-read)
		shift
		local documentName="${1:-}" rangeArgs=() readArgs folder
		shift || true
		if [ -z "$documentName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-op-audit-item-read: syntax is <document-name> [--start-line <N> --end-line <N>]" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$documentName" "<document-name>" intern-op-audit-item-read || { set +e ; return 1 ; }
		## A transcript, and a session's own transcript, the log a spawn record names.
		case "$documentName" in
			transcript-*|session-*.log) ;;
			*)
				echo "⛔ ERROR: $MDSC_CMD --intern-op-audit-item-read: only transcript-* documents and session-*.log transcripts are allowed: $documentName" >&2
				set +e ; return 1
			;;
		esac
		AgentsToolsVaultAuditRange --intern-op-audit-item-read "$@" || { set +e ; return 1 ; }
		## Where it is filed, by the one audit lookup (AgentsToolsAuditFolders).
		readArgs=( "$documentName" --context --intern-op-audit-item-read )
		while IFS= read -r folder ; do
			readArgs+=( --lookup-folder "$folder" )
		done < <( AgentsToolsAuditFolders "$documentName" )
		AgentsToolsDataRead ${readArgs[@]+"${readArgs[@]}"} ${rangeArgs[@]+"${rangeArgs[@]}"}
		return $?
	;;

	## THE RENAME OF A VAULT ITEM: the item moves to a name its contract accepts (AgentsToolsDocValidateVaultItemName), and every
	## board item, inbox item and vault item that names it by its old name names it by the new one. The old name is matched whole,
	## never as a part of a longer name. One commit carries the move and every rewritten file. Refused, with nothing changed: an old
	## item that is not there, a new name the vault refuses, a new name already taken.
	--intern-op-vault-item-rename)
		shift
		local renMember="${1:-}" renOld="${2:-}" renNew="${3:-}" renFile renChanged=() renCount=0
		if [ -z "$renMember" ] || [ -z "$renOld" ] || [ -z "$renNew" ] || [ $# -ne 3 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-op-vault-item-rename: syntax is <team-member> <old-item-name> <new-item-name>" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$renOld" "<old-item-name>" intern-op-vault-item-rename || { set +e ; return 1 ; }
		AgentsToolsAssertBareName "$renNew" "<new-item-name>" intern-op-vault-item-rename || { set +e ; return 1 ; }
		[ -n "${MDAT_DATA_ROOT:-}" ] || { echo "⛔ ERROR: $MDSC_CMD --intern-op-vault-item-rename: MDAT_DATA_ROOT is not set" >&2 ; set +e ; return 1 ; }
		case "$renOld" in *.*) ;; *) renOld="$renOld.md" ;; esac
		case "$renNew" in *.*) ;; *) renNew="$renNew.md" ;; esac
		[ -f "$MDAT_DATA_ROOT/vault/$renOld" ] || { echo "⛔ ERROR: $MDSC_CMD --intern-op-vault-item-rename: no vault item $renOld -- nothing was changed" >&2 ; set +e ; return 1 ; }
		[ ! -e "$MDAT_DATA_ROOT/vault/$renNew" ] || { echo "⛔ ERROR: $MDSC_CMD --intern-op-vault-item-rename: $renNew is taken already -- nothing was changed" >&2 ; set +e ; return 1 ; }
		type AgentsToolsDocValidateVaultItemName > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.DocValidate.include"
		local renFault=""
		renFault="$( AgentsToolsDocValidateVaultItemName "$renNew" )" || { echo "⛔ ERROR: $MDSC_CMD --intern-op-vault-item-rename: $renFault -- nothing was changed" >&2 ; set +e ; return 1 ; }
		mv -- "$MDAT_DATA_ROOT/vault/$renOld" "$MDAT_DATA_ROOT/vault/$renNew" || { echo "⛔ ERROR: $MDSC_CMD --intern-op-vault-item-rename: the move failed -- nothing was changed" >&2 ; set +e ; return 1 ; }
		## Every citation, matched whole: the old name with or without its extension, not followed by a character a name goes on with.
		local renOldBase="${renOld%.md}" renNewBase="${renNew%.md}" renTmp
		while IFS= read -r renFile ; do
			[ -f "$renFile" ] && [ ! -L "$renFile" ] || continue
			renTmp="$( mktemp "$renFile.XXXXXX" )" || continue
			if REN_OLD="$renOldBase" REN_NEW="$renNewBase" LC_ALL=C awk '
				BEGIN { o = ENVIRON["REN_OLD"] ; n = ENVIRON["REN_NEW"] ; changed = 0 }
				{
					line = $0 ; out = ""
					while ( ( at = index( line, o ) ) > 0 ) {
						before = ( at > 1 ) ? substr( line, at - 1, 1 ) : ""
						after = substr( line, at + length( o ), 1 )
						if ( before !~ /[A-Za-z0-9_-]/ && after !~ /[A-Za-z0-9_-]/ ) { out = out substr( line, 1, at - 1 ) n ; changed = 1 }
						else { out = out substr( line, 1, at - 1 + length( o ) ) }
						line = substr( line, at + length( o ) )
					}
					print out line
				}
				END { exit changed ? 0 : 1 }' "$renFile" > "$renTmp" ; then
				mv -f "$renTmp" "$renFile" && { renChanged=( ${renChanged[@]+"${renChanged[@]}"} "$renFile" ) ; renCount=$(( renCount + 1 )) ; }
			else
				rm -f "$renTmp"
			fi
		done <<< "$( LC_ALL=C grep -rl -F -- "$renOldBase" "$MDAT_DATA_ROOT/board" "$MDAT_DATA_ROOT/inboxes" "$MDAT_DATA_ROOT/vault" 2> /dev/null )"
		type AgentsToolsTeamDataCommitPaths > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.TeamDataCommit.include"
		AgentsToolsTeamDataCommitPaths "* vault: $renOld renamed $renNew by $renMember, $renCount citing item(s) repointed" \
			"$MDAT_DATA_ROOT/vault/$renOld" "$MDAT_DATA_ROOT/vault/$renNew" ${renChanged[@]+"${renChanged[@]}"}
		printf 'RENAMED: %s -> %s\nREPOINTED: %s item(s)\n' "$renOld" "$renNew" "$renCount"
		return 0
	;;

	*)
		echo "⛔ ERROR: $MDSC_CMD: invalid operation: $1" >&2
		set +e ; return 1
	;;
esac
