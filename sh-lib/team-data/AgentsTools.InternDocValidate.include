#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.InternDocValidate.include -- --intern-doc-validate <kind> <file|--from-stdin>: the one
## validator of a document against its contract (F5.3). Read-only: it reads the document and prints
## one row per fault, `<file>:<line>: <rule>: <text>`, and exits non-zero where it printed any. It
## needs no store, no model and no decision. Sourced from its arm of DistroAgentsTools.fn.sh, so
## $1 is the operation and `local` is the operation's own. Its rule sets, one for each kind, are
## AgentsTools.DocValidateRuleSets.include. Kinds built so far: `routine`, the contract of a `*.routine.md` skillset file
## (magic-team/contracts/routine.contract.format.md); and `document`, the self-check of any document
## against itself (F5.7): what it cites, counts, adds up and says twice; and `epic`, an epic against its contract
## (magic-team/contracts/epic.contract.format.md, AgentsEpicCheck.awk), whose structural rules refuse; and every team-data type, `<store>-item.<type>`
## (`board-item.task`), whose rule set is its contract (AgentsTools.DocValidate.include, F5.3). The rules of `routine`
## refuse; the rules of `document` arrive REPORTING, rows of a `report-` rule that refuse nothing; each rule of a
## type has its disposition in the one table, per rule and call site.
## The thin stubs of other surfaces, such as DistroAgentsTesting.fn.sh --skillset-validate-routine, call this and carry
## no logic of their own.
##

## The rule sets of the kinds whose rules are code, and the functions every kind shares: the type rule sets, the kinds.
type AgentsToolsDocValidateRoutine > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.DocValidateRuleSets.include"
type AgentsToolsDocValidateKinds > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.DocValidate.include"

## THE BOARD'S DOOR FOR THE DOCUMENT RULE SET: this front holds it, documents asks it, and no store path crosses.
## rc 0 the board holds the item, rc 1 the board does not, rc 2 there is no board to ask. No process: the board's own lookup is
## a test of the nine state folders, and one document may ask it a hundred times.
## A BOARD THE RUN DOES NOT HAVE IS NO ANSWER, never an empty one: a missing store says the same words as an absent item,
## and a citation reported "not there" over a board nobody read is a fact the run did not establish.
AgentsToolsDocValidateBoardAnswer(){ ## item name, without .md
	type AgentsToolsBoardItemInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.ItemDecisions.include"
	local answerItem=""
	[ -n "${MDAT_DATA_ROOT:-}" ] && [ -d "${MDAT_DATA_ROOT%/}/board" ] || return 2
	AgentsToolsBoardItemInto answerItem "$1" || return 1
	[ -n "$answerItem" ]
}
agentsDocValidateBoardAsk="AgentsToolsDocValidateBoardAnswer"

case "$1" in

	--intern-doc-validate)
		shift
		local validateKind="${1:-}" validateInput="${2:-}" validateFile validateShown validateTemp="" validateDoc="" validateAs=""
		## `routine --many`: EVERY FILE ON STDIN, validated in this one process. The validator was
		## called once per file, and each call paid for starting a shell and reading its own rule
		## sets -- 55 times for a list. The rules are the same functions, called here in place.
		if [ "$validateKind" = "routine" ] && [ "$validateInput" = "--many" ] ; then
			local validateOne validateSaid
			while IFS= read -r validateOne ; do
				[ -n "$validateOne" ] || continue
				[ -f "$validateOne" ] || continue
				validateSaid="$( AgentsToolsDocValidateRoutine "$validateOne" "$validateOne" )" || validateSaid="$validateOne:1: validator: the rule set itself failed"
				[ -z "$validateSaid" ] || printf '%s\n' "$validateSaid"
			done
			set +e ; return 0
		fi
		## `--from-stdin --as <path>`: the text on stdin is the document that will stand at that path (F7.7: a skillset file checked before it
		## is saved), so it is shown by that path and its citations are looked for from there, as for the file itself.
		if [ $# -eq 4 ] && [ "$validateInput" = "--from-stdin" ] && [ "${3:-}" = "--as" ] && [ -n "${4:-}" ] ; then
			validateAs="$4" ; set -- "$1" "$2"
		fi
		if [ -z "$validateKind" ] || [ -z "$validateInput" ] || [ $# -gt 2 ] ; then
			echo "$MDSC_CMD: doc-validate: ⛔ ERROR: syntax is <kind> <file|--from-stdin [--as <path>]> -- the kinds built: $( AgentsToolsDocValidateKinds | LC_ALL=C tr '\n' ' ' )" >&2
			set +e ; return 1
		fi
		case "$validateKind" in
			routine|document|epic) ;;
			*)
				AgentsToolsDocValidateContractFile "$validateKind" > /dev/null || {
					echo "$MDSC_CMD: doc-validate: ⛔ ERROR: no rule set for the kind: $validateKind -- the kinds built: $( AgentsToolsDocValidateKinds | LC_ALL=C tr '\n' ' ' )" >&2
					set +e ; return 1
				}
			;;
		esac
		if [ "$validateInput" = "--from-stdin" ] ; then
			mkdir -p "$MMDAPP/.local/temp" || { set +e ; return 1 ; }
			validateTemp="$( mktemp "$MMDAPP/.local/temp/AgentsDocValidate.XXXXXX" )" || { set +e ; return 1 ; }
			cat > "$validateTemp"
			validateFile="$validateTemp" ; validateShown="${validateAs:-<stdin>}" ; validateDoc="$validateAs"
		else
			if [ ! -f "$validateInput" ] ; then
				echo "$MDSC_CMD: doc-validate: ⛔ ERROR: no such file: $validateInput" >&2
				set +e ; return 1
			fi
			validateFile="$validateInput" ; validateShown="$validateInput" ; validateDoc="$validateInput"
		fi
		local validateRows
		case "$validateKind" in
			document) validateRows="$( AgentsToolsDocValidateSelfCheck "$validateFile" "$validateShown" "$validateDoc" )" || validateRows="$validateShown:1: validator: the rule set itself failed" ;;
			epic) validateRows="$( AgentsToolsDocValidateEpic "$validateFile" "$validateShown" "$validateDoc" )" || validateRows="$validateShown:1: validator: the rule set itself failed" ;;
			*-item.*) validateRows="$( AgentsToolsDocValidateType "$validateFile" "$validateShown" "$validateKind" check )" || validateRows="$validateShown:1: validator: the rule set itself failed" ;;
			*) validateRows="$( AgentsToolsDocValidateRoutine "$validateFile" "$validateShown" )" || validateRows="$validateShown:1: validator: the rule set itself failed" ;;
		esac
		[ -z "$validateTemp" ] || rm -f -- "$validateTemp"
		if [ -n "$validateRows" ] ; then
			printf '%s\n' "$validateRows"
			## A row of a report- rule says what a check found and refuses nothing (operations).
			if [ -n "$( printf '%s\n' "$validateRows" | LC_ALL=C grep -v -e '^[^ ]*:[0-9]*: report-' )" ] ; then
				echo "$MDSC_CMD: doc-validate: ⛔ ERROR: $validateShown: the $validateKind contract is not met" >&2
				set +e ; return 1
			fi
		fi
		return 0
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
