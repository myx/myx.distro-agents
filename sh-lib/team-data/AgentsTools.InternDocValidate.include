#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.InternDocValidate.include -- --intern-doc-validate <kind> <file|--from-stdin>: the one
## validator of a document against its contract (F5.3). Read-only: it reads the document and prints
## one row per fault, `<file>:<line>: <rule>: <text>`, and exits non-zero where it printed any. It
## needs no store, no model and no decision. Sourced from its arm of DistroAgentsTools.fn.sh, so
## $1 is the operation and `local` is the operation's own; the functions below are the rule sets,
## one for each kind. Kinds built so far: `routine`, the contract of a `*.routine.md` skillset file
## (magic-team/templates/routine.contract.format.md). The thin stubs of other surfaces, such as
## --tester-skillset-validate-routine, call this and carry no logic of their own.
##

type AgentsToolsRoutineRequirement > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.RoutineRequirements.include"

## One fault row: the rows a rule set prints are its faults, one line each.
AgentsToolsDocValidateRow(){ ## file as shown, line, rule, text
	printf '%s:%s: %s: %s\n' "$1" "$2" "$3" "$4"
}

## The line of a frontmatter key in a file; 1 where the key is not there.
AgentsToolsDocValidateKeyLine(){ ## file, key
	local keyLineAt
	keyLineAt="$( LC_ALL=C awk -v key="$2" '
		NR == 1 && $0 == "---" { inFront = 1 ; next ; }
		inFront && $0 == "---" { exit ; }
		inFront && index( $0, key ": " ) == 1 { print NR ; exit ; }
	' "$1" )"
	printf '%s\n' "${keyLineAt:-1}"
}

## The line of a frontmatter line `key: value` in a file, exactly; 1 where it is not there.
AgentsToolsDocValidateKeyLineOf(){ ## file, key, value
	local keyLineOfAt
	keyLineOfAt="$( LC_ALL=C awk -v want="$2: $3" '
		NR == 1 && $0 == "---" { inFront = 1 ; next ; }
		inFront && $0 == "---" { exit ; }
		inFront && $0 == want { print NR ; exit ; }
	' "$1" )"
	printf '%s\n' "${keyLineOfAt:-1}"
}

## The rule set of the `routine` kind: the frontmatter keys, the requirements, the sections.
AgentsToolsDocValidateRoutine(){ ## file, file as shown
	local routineFile="$1" routineShown="$2" routineFirst="" routineType routineKeyName routineVerdict routineWhy routineRows routineHeading routineLine
	local routineKindPath routineEffective routineEffectiveLine routineLockValue routineLockOne routineScanValue routineScanWhy routineScanOne routineScanAt routineScanCount
	local routineRunsAt routineRunsDays routineRunsTime routineRunsOk routineRunsAfter
	IFS= read -r routineFirst < "$routineFile" 2> /dev/null || :
	if [ "$routineFirst" != "---" ] ; then
		AgentsToolsDocValidateRow "$routineShown" 1 frontmatter "the file does not open with a frontmatter block"
		return 0
	fi
	## type: routine, so a routine is told from any other document by what it says of itself.
	routineType="$( AgentsToolsRoutineKeyOwn "$routineFile" type )"
	[ "$routineType" = "routine" ] || AgentsToolsDocValidateRow "$routineShown" "$( AgentsToolsDocValidateKeyLine "$routineFile" type )" type "type: routine is required, found '${routineType:-<absent>}'"
	## executors and maintainers: set by the routine, or by the default settings of its kind routine.
	routineKindPath="$( AgentsToolsSpawnRoutineKindPath "$routineFile" )"
	routineEffective="$( AgentsToolsSpawnRoutineFrontmatter "$routineFile" "$routineKindPath" )"
	for routineKeyName in executors maintainers ; do
		routineEffectiveLine="$( printf '%s\n' "$routineEffective" | LC_ALL=C grep -m 1 "^$routineKeyName: " )"
		[ -n "${routineEffectiveLine#"$routineKeyName: "}" ] || AgentsToolsDocValidateRow "$routineShown" "$( AgentsToolsDocValidateKeyLine "$routineFile" "$routineKeyName" )" "$routineKeyName" "$routineKeyName: is empty, and the routine's kind routine sets none"
	done
	## The requirements, asked of the one evaluator at this site.
	for routineKeyName in requires-session-kind tracking-item start-context review-by ; do
		routineVerdict="$( AgentsToolsRoutineRequirement "$routineKeyName" save "$routineFile" )" && continue
		routineWhy="${routineVerdict#*$'\t'}"
		AgentsToolsDocValidateRow "$routineShown" "$( AgentsToolsDocValidateKeyLine "$routineFile" "$routineKeyName" )" "$routineKeyName" "$routineWhy"
	done
	## `operations:` is REPORTED, NEVER ENFORCED: its findings are rows of the rule report-operations, which refuse nothing.
	routineVerdict="$( AgentsToolsRoutineRequirement operations save "$routineFile" )" || :
	while IFS=$'\t' read -r routineLine routineWhy ; do
		case "$routineLine" in reject|help) AgentsToolsDocValidateRow "$routineShown" "$( AgentsToolsDocValidateKeyLine "$routineFile" operations )" report-operations "$routineWhy" ;; esac
	done <<< "$routineVerdict"
	## The lock the spawner takes for the routine's session: `routine-lock-document: inbox:<member>:<note>.md`.
	routineLockValue="$( AgentsToolsRoutineKeyOwn "$routineFile" routine-lock-document )"
	if [ -n "$routineLockValue" ] ; then
		type AgentsToolsRoutineLockParse > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/magic/AgentsTools.RoutineLock.include"
		for routineLockOne in $( printf '%s' "$routineLockValue" | LC_ALL=C tr ',' ' ' ) ; do
			AgentsToolsRoutineLockParse "$routineLockOne" > /dev/null || AgentsToolsDocValidateRow "$routineShown" "$( AgentsToolsDocValidateKeyLine "$routineFile" routine-lock-document )" routine-lock-document "routine-lock-document: $routineLockOne is not inbox:<member>:<note>.md, a note in the inbox of the executor or of a named member (several, separated by commas)"
		done
	fi
	## The routine's own input scans: one line for each, `<scan> [--option value ...]` (macros among the five names of the common
	## option set), or `none` alone. The line form is read by the one parser the spawner reads it with.
	routineScanValue="$( AgentsToolsRoutineKeyLinesOwn "$routineFile" input-scan-def )"
	if [ -n "$routineScanValue" ] ; then
		type AgentsToolsInputScanDefWords > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.InputScanDef.include"
		routineScanCount="$( printf '%s\n' "$routineScanValue" | LC_ALL=C grep -c . )"
		while IFS= read -r routineScanOne ; do
			routineScanAt="$( AgentsToolsDocValidateKeyLineOf "$routineFile" input-scan-def "$routineScanOne" )"
			if [ "$routineScanOne" = "none" ] ; then
				[ "$routineScanCount" -le 1 ] || AgentsToolsDocValidateRow "$routineShown" "$routineScanAt" input-scan-def "input-scan-def: none stands alone, and the routine declares other scans"
				continue
			fi
			routineScanWhy="$( AgentsToolsInputScanDefWords "$routineScanOne" member session spawn 2>&1 > /dev/null )" || AgentsToolsDocValidateRow "$routineShown" "$routineScanAt" input-scan-def "${routineScanWhy#*input-scan-def: }"
		done <<< "$routineScanValue"
	fi
	## The autorun keys: `runs-at: <days> <HH:MM>` or `none`, days being workdays, weekend, daily or a list such as mon,thu; and
	## `runs-after: <routine>`, one routine, kept apart from it.
	routineRunsAt="$( AgentsToolsRoutineKeyOwn "$routineFile" runs-at )"
	if [ -n "$routineRunsAt" ] && [ "$routineRunsAt" != "none" ] ; then
		routineRunsDays="${routineRunsAt%% *}" ; routineRunsTime="${routineRunsAt#* }"
		routineRunsOk="yes"
		[ "$routineRunsAt" != "$routineRunsDays" ] || routineRunsOk="no"
		case "$routineRunsDays" in
			workdays|weekend|daily) ;;
			*) printf '%s\n' "$routineRunsDays" | LC_ALL=C grep -q -E '^(mon|tue|wed|thu|fri|sat|sun)(,(mon|tue|wed|thu|fri|sat|sun))*$' || routineRunsOk="no" ;;
		esac
		printf '%s\n' "$routineRunsTime" | LC_ALL=C grep -q -E '^([01][0-9]|2[0-3]):[0-5][0-9]$' || routineRunsOk="no"
		[ "$routineRunsOk" = "yes" ] || AgentsToolsDocValidateRow "$routineShown" "$( AgentsToolsDocValidateKeyLine "$routineFile" runs-at )" runs-at "runs-at: $routineRunsAt is not none or <days> <HH:MM>, days being workdays, weekend, daily or a list such as mon,thu"
	fi
	routineRunsAfter="$( AgentsToolsRoutineKeyOwn "$routineFile" runs-after )"
	case "$routineRunsAfter" in
		''|*[[:space:]]*|*,*) [ -z "$routineRunsAfter" ] || AgentsToolsDocValidateRow "$routineShown" "$( AgentsToolsDocValidateKeyLine "$routineFile" runs-after )" runs-after "runs-after: $routineRunsAfter is not one routine" ;;
	esac
	## The sections: # Opening steps, # Steps and # Closure steps, each once, in that order; and the local procedures.
	routineRows="$( LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsRoutineHeadings.awk" "$routineFile" )"
	local headingAt
	for routineHeading in "Opening steps" "Steps" "Closure steps" "Routine's local procedures" ; do
		routineLine="$( printf '%s\n' "$routineRows" | LC_ALL=C awk -F'\t' -v want="$routineHeading" '$2 == want { n++ ; if ( n == 1 ) first = $1 ; } END { printf "%d %d", n, first ; }' )"
		headingAt="${routineLine#* }"
		case "${routineLine%% *}" in
			0) AgentsToolsDocValidateRow "$routineShown" 1 sections "the section # $routineHeading is missing" ;;
			1) ;;
			*) AgentsToolsDocValidateRow "$routineShown" "$headingAt" sections "the section # $routineHeading stands more than once" ;;
		esac
	done
	## In order: the three steps headings, as found, ascend.
	local orderPrev=0 orderBad=""
	for routineHeading in "Opening steps" "Steps" "Closure steps" ; do
		routineLine="$( printf '%s\n' "$routineRows" | LC_ALL=C awk -F'\t' -v want="$routineHeading" '$2 == want { print $1 ; exit ; }' )"
		[ -n "$routineLine" ] || continue
		[ "$routineLine" -gt "$orderPrev" ] || orderBad="$orderBad${orderBad:+ }# $routineHeading"
		orderPrev="$routineLine"
	done
	[ -z "$orderBad" ] || AgentsToolsDocValidateRow "$routineShown" 1 sections "the sections stand out of order, # Opening steps then # Steps then # Closure steps: $orderBad"
	return 0
}

case "$1" in

	--intern-doc-validate)
		shift
		local validateKind="${1:-}" validateInput="${2:-}" validateFile validateShown validateTemp=""
		if [ -z "$validateKind" ] || [ -z "$validateInput" ] || [ $# -gt 2 ] ; then
			echo "$MDSC_CMD: doc-validate: ⛔ ERROR: syntax is <kind> <file|--from-stdin> -- the kinds built: routine" >&2
			set +e ; return 1
		fi
		case "$validateKind" in
			routine) ;;
			*)
				echo "$MDSC_CMD: doc-validate: ⛔ ERROR: no rule set for the kind: $validateKind -- the kinds built: routine" >&2
				set +e ; return 1
			;;
		esac
		if [ "$validateInput" = "--from-stdin" ] ; then
			mkdir -p "$MMDAPP/.local/temp" || { set +e ; return 1 ; }
			validateTemp="$( mktemp "$MMDAPP/.local/temp/AgentsDocValidate.XXXXXX" )" || { set +e ; return 1 ; }
			cat > "$validateTemp"
			validateFile="$validateTemp" ; validateShown="<stdin>"
		else
			if [ ! -f "$validateInput" ] ; then
				echo "$MDSC_CMD: doc-validate: ⛔ ERROR: no such file: $validateInput" >&2
				set +e ; return 1
			fi
			validateFile="$validateInput" ; validateShown="$validateInput"
		fi
		local validateRows
		validateRows="$( AgentsToolsDocValidateRoutine "$validateFile" "$validateShown" )" || validateRows="$validateShown:1: validator: the rule set itself failed"
		[ -z "$validateTemp" ] || rm -f -- "$validateTemp"
		if [ -n "$validateRows" ] ; then
			printf '%s\n' "$validateRows"
			## A row of a report- rule says what a check found and refuses nothing (operations).
			if [ -n "$( printf '%s\n' "$validateRows" | LC_ALL=C grep -v -e '^[^ ]*:[0-9]*: report-' )" ] ; then
				echo "$MDSC_CMD: doc-validate: ⛔ ERROR: $validateShown: the $validateKind contract is not met" >&2
				set +e ; return 1
			fi
		fi
		return 0
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
