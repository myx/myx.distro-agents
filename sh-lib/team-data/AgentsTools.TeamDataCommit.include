#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.TeamDataCommit.include -- the commit step of every writer into the team-data
## store, and the push. Sourced, never run. Functions only.
##
## A writer leaves an entry, and the one team-data thread commits it and pushes
## (AgentsToolsTeamDataCommitPaths, AgentsTools.TeamDataThread.include). The gate is a
## git directory under $MDAT_DATA_ROOT, independent of TEAM_DATA_GIT_REMOTE. A failed
## commit warns on stderr and never fails the write that came before it: the write has
## happened, and the dirty-store warning at a spawn close names what is left. The closes,
## the main loop and the set-up push through AgentsToolsTeamDataPushIfAhead as before.
##
## With TEAM_DATA_GIT_REMOTE set, the store's step of the set-up and the close push call
## myx.common's git/cloneSync for a store that has a remote, as the main loop's pass does,
## and a store with no origin, or another one, is given the remote first.
##

## Where the entries and the lock of the one thread of a store are: team-data-commit/ inside the store's own git directory, so that every
## workspace that writes the store meets the one thread. rc 1, nothing printed, for a store that is no repository.
AgentsToolsTeamDataThreadDir(){
	local dirGit
	dirGit="$( git -C "$MDAT_DATA_ROOT" rev-parse --absolute-git-dir 2> /dev/null )" || return 1
	printf '%s' "$dirGit/team-data-commit"
}

## THE STORE'S WRITERS ARE SETTLED BEFORE ANYTHING MOVES ITS TREE (S12.4). The store's checkout is also its writers' working tree, so a
## writer's file that waits for its commit is an uncommitted change to that tree. Git refuses to move a tree whose file origin changed
## holds such a change, which is how a duty start met LOCK_UNCHECKABLE and a retry a minute later passed. So a caller about to move the
## tree settles what waits first. A store with nothing waiting costs one git status and no process.
## rc 0 where nothing waited, or everything did and is committed; rc 1 where a writer was still uncommitted at the bound.
AgentsToolsTeamDataSettleDirty(){ ## -- the store's uncommitted tracked paths, one a line, absolute
	## `-z` prints no quotes at all, so a path holding a blank or a quote stays one word: the plain form wraps such a path in
	## quotes, and the commit step then refuses the pieces of it as not under the store. Each entry reads `<XY> <path>`.
	git -C "$MDAT_DATA_ROOT" status --porcelain -z 2> /dev/null \
		| while IFS= read -r -d '' settleEntry ; do
			settleEntry="${settleEntry#???}"
			## A live run's transcript is written by that run alone and committed on its own bound: no resync waits on it.
			case "$settleEntry" in ''|'??'*|audit/*/session-*.log) continue ;; esac
			printf '%s/%s\n' "${MDAT_DATA_ROOT%/}" "$settleEntry"
		done
}
AgentsToolsTeamDataSettle(){ ## bound seconds
	local settleDir settleBound="${1:-60}" settlePath
	[ -n "${MDAT_DATA_ROOT:-}" ] && [ -n "${MMDAPP:-}" ] || return 0
	settleDir="$( AgentsToolsTeamDataThreadDir )" || return 0
	for settlePath in "$settleDir"/*.entry ; do
		[ -f "$settlePath" ] && break
		settlePath=""
	done
	[ -n "$settlePath" ] || [ -n "$( AgentsToolsTeamDataSettleDirty )" ] || return 0
	## With the thread off, as the checks have it, the writers are committed here: there is no thread to ask.
	if [ "${MDAT_TEAM_DATA_COMMIT_THREAD:-}" != "off" ] ; then
		type AgentsToolsOnDemandThreadStart > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/common/AgentsTools.OnDemandThread.include"
		mkdir -p "$settleDir" 2> /dev/null || :
		AgentsToolsOnDemandThreadStart "$settleDir" --intern-team-data-commit --run > /dev/null 2>&1 || :
		AgentsToolsOnDemandThreadAsk "$settleDir" "$settleBound" "commit" > /dev/null || :
	fi
	## A write that landed while that pass ran, and one whose entry never came: committed here, as the thread would have committed it.
	while IFS= read -r settlePath ; do
		[ -z "$settlePath" ] || AgentsToolsTeamDataCommitPathsNow "the store's writers, settled before the resync" "$settlePath"
	done <<< "$( AgentsToolsTeamDataSettleDirty )"
	[ -z "$( AgentsToolsTeamDataSettleDirty )" ]
}

## A write into the team data that is to be committed and pushed. The writer runs no git: the paths and what to say of them are left as
## one entry file in the thread's folder (AgentsToolsTeamDataThreadDir), and the one thread that commits and pushes (--intern-team-data-commit,
## AgentsTools.InternTeamDataCommit.include) is started where none lives and asked to commit. A lock another writer holds can no longer
## fail the write, and the thread commits one entry after another. Never fails its caller.
## The context is the subject of the commit, `* ` before it unless it starts with `+ `, `- ` or `* `. MDAT_TEAM_DATA_COMMIT_WAIT=yes in front
## of the call keeps it until the thread has committed the entry, for a writer that deletes what it has just written: the history of a
## file is made before the file goes. With MDAT_TEAM_DATA_COMMIT_THREAD=off the commit is made here, in the caller, as the rigs and the
## checks have it.
AgentsToolsTeamDataCommitPaths(){ ## context, path...
	local queueContext="$1" queueDir queueEntry queueStart
	shift
	[ "$#" -gt 0 ] && [ -n "${MDAT_DATA_ROOT:-}" ] && [ -n "${MMDAPP:-}" ] || return 0
	queueDir="$( AgentsToolsTeamDataThreadDir )" || return 0
	if [ "${MDAT_TEAM_DATA_COMMIT_THREAD:-}" = "off" ] || ! mkdir -p "$queueDir" 2> /dev/null ; then
		AgentsToolsTeamDataCommitPathsNow "$queueContext" "$@"
		return 0
	fi
	queueEntry="$( mktemp "$queueDir/write.XXXXXX" 2> /dev/null )" || queueEntry=""
	if [ -z "$queueEntry" ] || ! { printf '\n%s\n' "$queueContext" ; printf '%s\n' "$@" ; } > "$queueEntry" 2> /dev/null || ! mv -f "$queueEntry" "$queueEntry.entry" 2> /dev/null ; then
		[ -z "$queueEntry" ] || rm -f "$queueEntry" 2> /dev/null
		AgentsToolsTeamDataCommitPathsNow "$queueContext" "$@"
		return 0
	fi
	type AgentsToolsOnDemandThreadAsk > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/common/AgentsTools.OnDemandThread.include"
	queueStart="$( AgentsToolsOnDemandThreadStart "$queueDir" --intern-team-data-commit --run )" || queueStart="failed - the start ended with an error"
	case "$queueStart" in
		failed*)
			## No thread to take the entry: it is taken back and committed here, never left unseen.
			rm -f "$queueEntry.entry" 2> /dev/null
			echo "# $MDSC_CMD: team-data commit: ⚠️ WARNING: the team-data thread could not be started ($queueStart), so the commit is made here" >&2
			AgentsToolsTeamDataCommitPathsNow "$queueContext" "$@"
			return 0
		;;
	esac
	## A writer that asked to wait holds the entry until the thread has committed it, half a minute at most, for a writer that deletes
	## what it has just written: the history of a file is made before the file goes. Past the bound, or with no answer at all, the entry
	## is the thread's alone, so the commit is made here as it would be after a failed one.
	if [ "${MDAT_TEAM_DATA_COMMIT_WAIT:-}" = "yes" ] ; then
		if AgentsToolsOnDemandThreadAsk "$queueDir" 30 "commit" > /dev/null ; then
			return 0
		fi
		rm -f "$queueEntry.entry" 2> /dev/null
		AgentsToolsTeamDataCommitPathsNow "$queueContext" "$@"
		return 0
	fi
	AgentsToolsOnDemandThreadAsk "$queueDir" - "commit" || :
	return 0
}

## A COMMIT THAT COULD NOT BE MADE IS OWED, LIKE A PUSH. This system runs unattended: a lock,
## a full disk or a concurrent writer must not leave a write that "warned" and never landed. The
## paths are recorded here, and the NEXT commit call of any kind picks them up and commits them
## with this one, so the store heals itself on the next run instead of waiting for a person to
## read a warning. A path is dropped from the debt only once a commit has actually carried it.
AgentsToolsTeamDataCommitOwedPath(){
	[ -n "${MMDAPP:-}" ] || return 1
	printf '%s\n' "${MMDAPP%/}/.local/agents/team-data-commit.owed"
}

AgentsToolsTeamDataCommitOwedAdd(){ ## the paths that could not be committed
	local owedFile="" owedOne=""
	owedFile="$( AgentsToolsTeamDataCommitOwedPath )" || return 0
	[ -n "$owedFile" ] || return 0
	mkdir -p "${owedFile%/*}" 2> /dev/null || return 0
	for owedOne in "$@" ; do
		grep -F -x -q -- "$owedOne" "$owedFile" 2> /dev/null || printf '%s\n' "$owedOne" >> "$owedFile" 2> /dev/null || :
	done
	return 0
}

AgentsToolsTeamDataCommitOwedTake(){
	local owedFile=""
	owedFile="$( AgentsToolsTeamDataCommitOwedPath )" || return 0
	[ -f "$owedFile" ] || return 0
	cat "$owedFile" 2> /dev/null || :
	rm -f "$owedFile" 2> /dev/null || :
	return 0
}

## What the thread does with one entry: commits exactly the given paths, which must lie under $MDAT_DATA_ROOT.
AgentsToolsTeamDataCommitPathsNow(){ ## context, path...
	local commitContext="$1" ; shift
	[ "$#" -gt 0 ] || return 0
	[ -n "${MDAT_DATA_ROOT:-}" ] || return 0
	local repoRoot="" gitOut="" gitRc=0 gitDir="" commitPath commitPaths=() commitSubject=""
	case "$commitContext" in '+ '*|'- '*|'* '*) commitSubject="$commitContext" ;; *) commitSubject="* $commitContext" ;; esac
	repoRoot="$( git -C "$MDAT_DATA_ROOT" rev-parse --show-toplevel 2>/dev/null )" || repoRoot=""
	[ -n "$repoRoot" ] || return 0
	## THE STORE'S OWN HISTORY, OR NONE. A data folder with no repository of its own, placed inside another repository's work tree, resolves
	## that repository: committed there its files become the other repository's history, which is how a check rig's scratch file reached the
	## shared store. A store that is no repository root commits nothing, and says so once.
	if [ "$( cd "$MDAT_DATA_ROOT" 2> /dev/null && pwd -P )" != "$( cd "$repoRoot" 2> /dev/null && pwd -P )" ] ; then
		echo "# $MDSC_CMD: team-data commit: ⚠️ WARNING: the store $MDAT_DATA_ROOT is no repository of its own, inside $repoRoot, so nothing is committed into that one: $commitContext" >&2
		return 0
	fi
	for commitPath in "$@" ; do
		case "$commitPath" in
			*/../*|*/..) echo "# $MDSC_CMD: team-data commit: ⚠️ WARNING: a path with .. is never committed: $commitPath" >&2 ;;
			## THE STORE'S OWN .local IS NO TEAM DATA: it holds the local state of the workspace that runs the tooling. One already tracked
			## is let through, and only so that its removal can be committed by this same step, which is how a stray leaves.
			"$MDAT_DATA_ROOT"/.local/*)
				if git -C "$repoRoot" ls-files --error-unmatch -- "$commitPath" > /dev/null 2>&1 ; then
					commitPaths+=( "$commitPath" )
				else
					echo "# $MDSC_CMD: team-data commit: ⚠️ WARNING: local state is never committed into the store: $commitPath" >&2
				fi
			;;
			"$MDAT_DATA_ROOT"/*) commitPaths+=( "$commitPath" ) ;;
			*) echo "# $MDSC_CMD: team-data commit: ⚠️ WARNING: not under the team-data store, not committed: $commitPath" >&2 ;;
		esac
	done
	## THE DEBT IS PAID FIRST: paths a previous run could not commit are carried with this one.
	local owedPath=""
	while IFS= read -r owedPath ; do
		[ -n "$owedPath" ] || continue
		case " ${commitPaths[*]} " in *" $owedPath "*) ;; *) commitPaths+=( "$owedPath" ) ;; esac
	done <<< "$( AgentsToolsTeamDataCommitOwedTake )"
	## A path that is gone and that git never knew fails `git add -A` for the whole commit, and its entry would then be owed for good: a moved
	## item names both of its places, an item created and trashed before its commit names one that is no more. Git is asked for the one it knew.
	## A deletion already staged, gone from the index and held by HEAD, skips the add and is committed.
	local knownPaths=() addPaths=()
	for commitPath in ${commitPaths[@]+"${commitPaths[@]}"} ; do
		if [ -e "$commitPath" ] || git -C "$repoRoot" ls-files --error-unmatch -- "$commitPath" > /dev/null 2>&1 ; then
			addPaths+=( "$commitPath" )
		elif ! git -C "$repoRoot" ls-files --error-unmatch --with-tree=HEAD -- "$commitPath" > /dev/null 2>&1 ; then
			continue
		fi
		knownPaths+=( "$commitPath" )
	done
	commitPaths=( ${knownPaths[@]+"${knownPaths[@]}"} )
	[ "${#commitPaths[@]}" -gt 0 ] || return 0
	## A STALE index.lock IS NOT A FAILED WRITE, IT IS A LOCK NOBODY HOLDS. An index upsert that
	## was killed leaves one behind, and every commit after it fails "Unable to create .git/index.lock"
	## -- the write lands on disk and NEVER reaches the branch, which is how items sat uncommitted
	## for days while each tool run reported a warning nobody could act on. So when the add fails
	## and the lock is there, ask whether a live git holds it: if none does, the lock is stale, it is
	## removed and the add is tried ONCE more. A live holder is never touched.
	gitAddStale(){
		local lockFile="$1" holder=""
		[ -n "$lockFile" ] && [ -e "$lockFile" ] || return 1
		holder="$( pgrep -f "git.*$( printf '%s' "$repoRoot" | sed 's/[][\.*^$/]/\\&/g' )" 2> /dev/null | head -1 )" || holder=""
		[ -z "$holder" ] || return 1
		echo "# $MDSC_CMD: team-data commit: ⚠️ WARNING: a stale index.lock was found with no git holding it, removed: $lockFile" >&2
		rm -f "$lockFile" 2> /dev/null || return 1
		return 0
	}
	[ "${#addPaths[@]}" -eq 0 ] || gitOut="$( git -C "$repoRoot" add -A -- "${addPaths[@]}" 2>&1 )" || gitRc=$?
	if [ "$gitRc" -ne 0 ] ; then
		gitDir="$( git -C "$repoRoot" rev-parse --absolute-git-dir 2> /dev/null )" || gitDir=""
		if gitAddStale "${gitDir:+$gitDir/index.lock}" ; then
			gitRc=0
			gitOut="$( git -C "$repoRoot" add -A -- "${addPaths[@]}" 2>&1 )" || gitRc=$?
		fi
	fi
	if [ "$gitRc" -ne 0 ] ; then
		AgentsToolsTeamDataCommitOwedAdd "${commitPaths[@]}"
		echo "# $MDSC_CMD: team-data commit: ⚠️ WARNING: git add failed, so the commit is OWED and the next run carries it (${commitPaths[*]}): $gitOut" >&2
		return 0
	fi
	## Nothing staged for these paths -- the write changed nothing -- is not a commit. And a path that changed nothing is left out of it: a
	## pathspec of a commit that git knows no such path for, an index entry the staging has just taken away, fails the whole commit.
	local commitChanged=()
	while IFS= read -r commitPath ; do
		[ -z "$commitPath" ] || commitChanged+=( "$commitPath" )
	done <<< "$( git -C "$repoRoot" diff --cached --no-renames --name-only -- "${commitPaths[@]}" 2>/dev/null )"
	[ "${#commitChanged[@]}" -gt 0 ] || return 0
	gitOut="$( git -C "$repoRoot" commit -m "$commitSubject" -- "${commitChanged[@]}" 2>&1 )" || gitRc=$?
	if [ "$gitRc" -ne 0 ] ; then
		AgentsToolsTeamDataCommitOwedAdd "${commitPaths[@]}"
		echo "# $MDSC_CMD: team-data commit: ⚠️ WARNING: git commit failed, so the commit is OWED and the next run carries it (${commitPaths[*]}): $gitOut" >&2
		return 0
	fi
	echo "# $MDSC_CMD: team-data commit: committed ${#commitPaths[@]} path(s), $commitContext" >&2
	return 0
}

## The last-change stamp a document carries in its header: the greatest value of its updated, updated-at, last-updated, last-change, changed-at and
## resolved-at keys, empty where it has none. The stamps are ISO forms, which compare as text.
AgentsToolsTeamDataChangeStamp(){ ## file
	LC_ALL=C awk '
		NR == 1 && $0 == "---" { fm = 1 ; next ; }
		fm && $0 == "---" { exit ; }
		fm && /^(updated|updated-at|last-updated|last-change|changed-at|resolved-at):/ { value = $0 ; sub( /^[^:]*:[ ]*/, "", value ) ; if ( value > best ) best = value ; }
		END { print best ; }
	' "$1"
}

## A merge the sync left unfinished -- origin and the local commits changed one file -- is settled here, inside the file itself, with no
## person and no extra file: a conflict is never committed, no line of either side is lost, and the local commits can go out.
## The conflicting blocks of a file (git merge-file, the 3-way merge) are resolved by what the block is:
##   - line records, every line of the block starting with a timestamp (logs, registries): the lines of both sides, each once, in time order;
##   - the header of a document: a key both sides changed ends with one line, the value of the side whose own last-change stamp is later
##     (AgentsToolsTeamDataChangeStamp), origin's where neither has one; a key only one side holds stays;
##   - the body of a document: origin's block, then the lines of the local block it does not already hold -- both versions in the one file,
##     with no marker.
## A file that one side deleted and the other changed keeps the changed one. The merge is then committed. rc 0 where no merge was in
## progress or it was settled; rc 1, the merge left as it was and one warning, where it could not be.
## THE MERGE TAKEN AGAIN, where the sync gave up on a conflict: cloneSync aborts a merge it cannot settle and leaves no MERGE_HEAD behind,
## so origin's branch is merged here by the tooling's own merge, which the settling engine (AgentsToolsTeamDataMergeSettle) can work, and a
## merge left with no conflict is committed. One step for every caller that integrates origin: the close push and the checkout repair.
## rc 0 where the merge is committed and nothing is open; rc 1 where a conflict stays, the merge aborted and the checkout as before.
AgentsToolsTeamDataMergeAgain(){ ## where, repository root, branch
	local againWhere="$1" againRoot="$2" againBranch="$3" againGit=""
	againGit="$( git -C "$againRoot" rev-parse --absolute-git-dir 2>/dev/null )" || return 1
	git -C "$againRoot" fetch -q origin "+refs/heads/$againBranch:refs/remotes/origin/$againBranch" > /dev/null 2>&1 || :
	git -C "$againRoot" merge --no-commit --no-ff "refs/remotes/origin/$againBranch" > /dev/null 2>&1 || :
	AgentsToolsTeamDataMergeSettle "$againWhere" || :
	if [ -e "$againGit/MERGE_HEAD" ] && [ -z "$( git -C "$againRoot" diff --name-only --diff-filter=U 2>/dev/null )" ] ; then
		git -C "$againRoot" commit -q -m "* team-data merge committed by the tooling, no conflict in it" > /dev/null 2>&1 || :
	fi
	if [ -e "$againGit/MERGE_HEAD" ] ; then
		git -C "$againRoot" merge --abort > /dev/null 2>&1
		return 1
	fi
	return 0
}
AgentsToolsTeamDataMergeSettle(){ ## where
	local settleRoot="" settleGit="" settlePath="" settleCount=0 settleOut="" settleWork="" settleOurs="" settleBase="" settleTheirs=""
	[ -n "${MDAT_DATA_ROOT:-}" ] || return 0
	settleRoot="$( git -C "$MDAT_DATA_ROOT" rev-parse --show-toplevel 2>/dev/null )" || return 0
	settleGit="$( git -C "$settleRoot" rev-parse --absolute-git-dir 2>/dev/null )" || return 0
	[ -e "$settleGit/MERGE_HEAD" ] || return 0
	mkdir -p "${MMDAPP:-$settleGit}/.local/temp" 2>/dev/null || :
	settleWork="$( mktemp -d "${MMDAPP:-$settleGit}/.local/temp/mdat-merge-settle.XXXXXX" 2>/dev/null )" || settleWork="$( mktemp -d "$settleGit/mdat-merge-settle.XXXXXX" )" || {
		echo "⚠️ WARNING: $MDSC_CMD: $1: no work folder for the merge settle could be made, so the merge is left as it was" >&2
		return 1
	}
	settleOurs="$settleWork/ours" settleBase="$settleWork/base" settleTheirs="$settleWork/theirs"
	while IFS= read -r -d '' settlePath ; do
		[ -n "$settlePath" ] || continue
		if git -C "$settleRoot" cat-file -e ":3:$settlePath" 2>/dev/null && git -C "$settleRoot" cat-file -e ":2:$settlePath" 2>/dev/null ; then
			: > "$settleBase"
			git -C "$settleRoot" cat-file -e ":1:$settlePath" 2>/dev/null && git -C "$settleRoot" show ":1:$settlePath" > "$settleBase" 2>/dev/null
			git -C "$settleRoot" show ":2:$settlePath" > "$settleOurs" 2>/dev/null && git -C "$settleRoot" show ":3:$settlePath" > "$settleTheirs" 2>/dev/null || {
				echo "⚠️ WARNING: $MDSC_CMD: $1: the versions of $settlePath could not be read, so the merge is left as it was" >&2
				rm -rf "$settleWork" ; return 1
			}
			## The 3-way merge with its markers, and each conflicting block resolved in place.
			git merge-file -p -L ours -L base -L theirs "$settleOurs" "$settleBase" "$settleTheirs" 2>/dev/null \
				| LC_ALL=C awk -v oursStamp="$( AgentsToolsTeamDataChangeStamp "$settleOurs" )" -v theirsStamp="$( AgentsToolsTeamDataChangeStamp "$settleTheirs" )" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTeamDataMergeSettle.awk" > "$settleWork/merged" 2>/dev/null
			if [ "${PIPESTATUS[1]}" != 0 ] ; then
				echo "⚠️ WARNING: $MDSC_CMD: $1: $settlePath could not be settled in place, so the merge is left as it was" >&2
				rm -rf "$settleWork" ; return 1
			fi
			cp "$settleWork/merged" "$settleRoot/$settlePath" && git -C "$settleRoot" add -- "$settlePath" > /dev/null 2>&1 || {
				echo "⚠️ WARNING: $MDSC_CMD: $1: $settlePath could not be written settled, so the merge is left as it was" >&2
				rm -rf "$settleWork" ; return 1
			}
		elif git -C "$settleRoot" cat-file -e ":3:$settlePath" 2>/dev/null ; then
			## Deleted here and changed by origin: origin's file.
			git -C "$settleRoot" checkout --theirs -- "$settlePath" > /dev/null 2>&1 && git -C "$settleRoot" add -- "$settlePath" > /dev/null 2>&1 || {
				echo "⚠️ WARNING: $MDSC_CMD: $1: origin's version of $settlePath could not be taken, so the merge is left as it was" >&2
				rm -rf "$settleWork" ; return 1
			}
		else
			## Deleted by origin and changed here: the changed file stays.
			git -C "$settleRoot" add -- "$settlePath" > /dev/null 2>&1 || {
				echo "⚠️ WARNING: $MDSC_CMD: $1: $settlePath could not be settled, so the merge is left as it was" >&2
				rm -rf "$settleWork" ; return 1
			}
		fi
		settleCount=$(( settleCount + 1 ))
	done < <( git -C "$settleRoot" diff --name-only -z --diff-filter=U 2>/dev/null )
	rm -rf "$settleWork"
	if [ -n "$( git -C "$settleRoot" diff --name-only --diff-filter=U 2>/dev/null )" ] ; then
		echo "⚠️ WARNING: $MDSC_CMD: $1: the merge still holds conflicted paths after the settle, so it is left as it was" >&2
		return 1
	fi
	settleOut="$( git -C "$settleRoot" commit -q -m "* team-data merge settled by the tooling, $settleCount conflicted file(s) settled inside the file, no line of either side lost" 2>&1 )" || {
		echo "⚠️ WARNING: $MDSC_CMD: $1: the settled merge could not be committed, so it is left as it was: $settleOut" >&2
		return 1
	}
	echo "# $MDSC_CMD: $1: a merge left unfinished was settled, $settleCount conflicted file(s) settled inside the file with no line lost, and committed" >&2
	return 0
}

## Pushes the store's branch when it is ahead of origin, at a close point, never per
## write: one push carries everything committed since. A conflict between origin and the local commits is settled and
## committed first (AgentsToolsTeamDataMergeSettle), so the commits always go out and none is committed with a marker in it. The primitive is item-upsert's:
## push origin HEAD; when the remote moved, integrate with myx.common git/cloneSync
## --no-push and push once more; then read origin back and require it to equal HEAD.
## Never a reset or a force, and local commits are never discarded: a failure is a
## stated warning naming the reason and the ahead count, and the next close retries.
## Pushes only when the store is its repository's own root; an origin that is not
## TEAM_DATA_GIT_REMOTE is set to it first (AgentsToolsTeamDataRemoteAlign), where before
## it returned there and said nothing. Always returns 0.
## One pusher at a time on this host: every close can call this, async spawn closes
## concurrently, so the body runs under the package's local lock. A BUSY LOCK IS A PUSH
## OWED, NEVER A SKIP: the holder's `git push origin HEAD` may have resolved HEAD before
## this process committed, so returning quietly leaves this process's commits local with
## nothing recorded to bring them out -- which is how five commits sat local and unmerged
## from August to October. So a call that finds the lock busy records the debt and goes;
## the NEXT push waits the holder out (a push is bounded) and carries the debt to the
## remote, and the debt goes only where the store is verified not ahead. A debt left
## unpaid is therefore re-attempted on every later push instead of being re-forgotten.
AgentsToolsTeamDataPushIfAhead(){ ## where
	[ -n "${MDAT_DATA_ROOT:-}" ] || return 0
	. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/magic/AgentsTools.LocalLock.include"
	local pushLock="" pushOwed="" pushTries=30
	pushOwed="$( AgentsToolsTeamDataPushOwedPath )" || pushOwed=""
	## A store already owed a push does not skip again: it waits the lock out, and the state
	## check below clears the debt only when the store is not ahead any more.
	[ -z "$pushOwed" ] || [ ! -e "$pushOwed" ] || pushTries=330
	if ! AgentsToolsLocalLockTake "team-data-push" "$pushTries" "the team-data push" ; then
		AgentsToolsTeamDataPushOwedMark
		echo "⚠️ WARNING: $MDSC_CMD: $1: another team-data push holds the lock; the store's commits stay local and the push is OWED, marked ${pushOwed:-<no workspace>}, so the next one waits the lock out instead of skipping" >&2
		return 0
	fi
	pushLock="$agentsLocalLockPath"
	AgentsToolsTeamDataPushIfAheadLocked "$1"
	AgentsToolsLocalLockGive "$pushLock"
	## The debt is the store being ahead: a push that failed, or one this configuration could
	## not make, records it too, so the next call is patient rather than quick to give up. It
	## goes only where the store is verified not ahead, or where nothing can be told.
	case "$( AgentsToolsTeamDataPushAheadState )" in
		ahead) AgentsToolsTeamDataPushOwedMark ;;
		*) [ -z "$pushOwed" ] || rm -f "$pushOwed" 2>/dev/null || : ;;
	esac
	return 0
}

## Where the store's owed push is recorded: one marker in the workspace's own local state.
## rc 1, printing nothing, where there is no workspace to keep it in.
AgentsToolsTeamDataPushOwedPath(){
	[ -n "${MMDAPP:-}" ] || return 1
	printf '%s\n' "${MMDAPP%/}/.local/agents/team-data-push.owed"
}

## Records that the store holds a commit no push has published, so that the next push waits
## the lock out rather than skipping. Idempotent, silent, and it never fails its caller.
AgentsToolsTeamDataPushOwedMark(){
	local owedFile=""
	[ -n "${MDAT_DATA_ROOT:-}" ] || return 0
	owedFile="$( AgentsToolsTeamDataPushOwedPath )" || return 0
	[ ! -e "$owedFile" ] || return 0
	mkdir -p "${owedFile%/*}" 2>/dev/null || return 0
	: > "$owedFile" 2>/dev/null || :
	return 0
}

## Whether the store's branch is still ahead of its origin ref: prints `ahead`, `in-step` or
## `unknown`, reading only and never failing. A branch whose origin ref is absent counts as
## ahead, because nothing yet proves it published.
AgentsToolsTeamDataPushAheadState(){
	local stateRoot="" stateBranch="" stateAhead=""
	[ -n "${MDAT_DATA_ROOT:-}" ] || { printf 'unknown\n' ; return 0 ; }
	stateRoot="$( git -C "$MDAT_DATA_ROOT" rev-parse --show-toplevel 2>/dev/null )" || stateRoot=""
	[ -n "$stateRoot" ] || { printf 'unknown\n' ; return 0 ; }
	stateBranch="$( git -C "$stateRoot" rev-parse --abbrev-ref HEAD 2>/dev/null )" || stateBranch=""
	case "$stateBranch" in ''|HEAD) printf 'unknown\n' ; return 0 ;; esac
	if ! git -C "$stateRoot" rev-parse --verify --quiet "refs/remotes/origin/$stateBranch" > /dev/null 2>&1 ; then
		printf 'ahead\n' ; return 0
	fi
	stateAhead="$( git -C "$stateRoot" rev-list --count "refs/remotes/origin/$stateBranch..HEAD" 2>/dev/null )" || stateAhead=""
	case "$stateAhead" in
		''|*[!0123456789]*) printf 'unknown\n' ;;
		0) printf 'in-step\n' ;;
		*) printf 'ahead\n' ;;
	esac
	return 0
}

AgentsToolsTeamDataPushIfAheadLocked(){ ## where
	local pushWhere="$1"
	local repoRoot="" gitDir="" originUrl="" repoOrigin="" storeRoot="" pushBranch="" aheadCount="" pushOut="" pushRc=0 headFull="" remoteHead=""
	repoRoot="$( git -C "$MDAT_DATA_ROOT" rev-parse --show-toplevel 2>/dev/null )" || return 0
	[ -n "$repoRoot" ] || return 0
	gitDir="$( git -C "$repoRoot" rev-parse --absolute-git-dir 2>/dev/null )" || return 0
	type AgentsToolsConfigOption > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/config/AgentsTools.ConfigOption.include"
	originUrl="$( AgentsToolsConfigOption magic-team --select TEAM_DATA_GIT_REMOTE 2>/dev/null )" || originUrl=""
	[ -n "$originUrl" ] || return 0
	storeRoot="$( cd "$MDAT_DATA_ROOT" && pwd -P )" || storeRoot=""
	[ -n "$storeRoot" ] && [ "$storeRoot" = "$( cd "$repoRoot" && pwd -P )" ] || return 0
	repoOrigin="$( git -C "$repoRoot" remote get-url origin 2>/dev/null )" || repoOrigin=""
	[ "$repoOrigin" = "$originUrl" ] || AgentsToolsTeamDataRemoteAlign "$pushWhere" "$originUrl" || return 0
	pushBranch="$( git -C "$repoRoot" rev-parse --abbrev-ref HEAD 2>/dev/null )" || pushBranch=""
	[ -n "$pushBranch" ] && [ "$pushBranch" != "HEAD" ] || return 0
	## A merge an earlier sync left unfinished is settled first, so its commits go out with the rest and no conflict stands committed or open.
	[ ! -e "$gitDir/MERGE_HEAD" ] || AgentsToolsTeamDataMergeSettle "$pushWhere" || :
	## Nothing ahead of the last fetch: no push is attempted.
	if git -C "$repoRoot" rev-parse --verify --quiet "refs/remotes/origin/$pushBranch" > /dev/null 2>&1 ; then
		aheadCount="$( git -C "$repoRoot" rev-list --count "refs/remotes/origin/$pushBranch..HEAD" 2>/dev/null )" || aheadCount=""
		[ "$aheadCount" != "0" ] || return 0
	fi
	pushOut="$( LC_ALL=C git -C "$repoRoot" push origin HEAD 2>&1 )" || pushRc=$?
	## Whether origin moved is read from state, never from the message: fetch, then ask
	## whether origin's branch is still an ancestor of HEAD.
	if [ "$pushRc" -ne 0 ] && LC_ALL=C git -C "$repoRoot" fetch -q origin "$pushBranch" > /dev/null 2>&1 \
		&& git -C "$repoRoot" rev-parse --verify --quiet "refs/remotes/origin/$pushBranch" > /dev/null 2>&1 \
		&& ! git -C "$repoRoot" merge-base --is-ancestor "refs/remotes/origin/$pushBranch" HEAD 2>/dev/null ; then
		## An operation already in progress is not ours to touch, and never integrated over.
		local interrupted=""
		[ ! -e "$gitDir/index.lock" ] || interrupted="$interrupted index.lock"
		[ ! -e "$gitDir/MERGE_HEAD" ] || interrupted="$interrupted merge"
		[ ! -e "$gitDir/CHERRY_PICK_HEAD" ] || interrupted="$interrupted cherry-pick"
		[ ! -e "$gitDir/REVERT_HEAD" ] || interrupted="$interrupted revert"
		[ ! -d "$gitDir/rebase-merge" ] && [ ! -d "$gitDir/rebase-apply" ] || interrupted="$interrupted rebase"
		if [ -n "$interrupted" ] ; then
			echo "⚠️ WARNING: $MDSC_CMD: $pushWhere: team-data push rejected (origin moved) and the store shows an operation in progress:$interrupted -- not integrated, not touched; ${aheadCount:-some} commit(s) stay local, kept, and the next close retries" >&2
			return 0
		fi
		if [ -n "$( git -C "$repoRoot" status --porcelain --untracked-files=all 2>/dev/null )" ] ; then
			echo "⚠️ WARNING: $MDSC_CMD: $pushWhere: team-data push rejected (origin moved) and the store holds uncommitted paths, so it was not integrated; ${aheadCount:-some} commit(s) stay local, kept, and the next close retries" >&2
			return 0
		fi
		type AgentsToolsMyRoot > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/common/AgentsTools.MyRoot.include"
		if [ -z "${MYXROOT:-}" ] || [ ! -f "$MYXROOT/bin/git/cloneSync.Common" ] ; then
			echo "⚠️ WARNING: $MDSC_CMD: $pushWhere: team-data push rejected (origin moved) and myx.common git/cloneSync is unreachable to integrate; ${aheadCount:-some} commit(s) stay local, kept, and the next close retries" >&2
			return 0
		fi
		## cloneSync's pull needs a reconcile mode when the two sides diverged: a merge,
		## which keeps both sides' commits and rewrites none. No merge was in progress
		## above, so one present after a failure is this call's own, and only that is aborted.
		## cloneSync aborts a merge it cannot settle and leaves no MERGE_HEAD behind, so the conflict is taken again
		## here, by our own merge of origin's branch, which the settling engine can work. A merge that came in clean is
		## committed too, so the push below runs on a store with nothing left open.
		pushOut="$( GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=pull.rebase GIT_CONFIG_VALUE_0=false LC_ALL=C \
			"$MYXROOT/bin/git/cloneSync.Common" --no-push "$repoRoot" "$originUrl" "$pushBranch" 2>&1 )" || {
			if AgentsToolsTeamDataMergeAgain "$pushWhere" "$repoRoot" "$pushBranch" ; then
				pushOut=""
			else
				echo "⚠️ WARNING: $MDSC_CMD: $pushWhere: team-data push rejected and integrating origin failed; ${aheadCount:-some} commit(s) stay local, kept, and the next close retries: $pushOut" >&2
				return 0
			fi
		}
		pushRc=0
		pushOut="$( LC_ALL=C git -C "$repoRoot" push origin HEAD 2>&1 )" || pushRc=$?
	fi
	if [ "$pushRc" -ne 0 ] ; then
		echo "⚠️ WARNING: $MDSC_CMD: $pushWhere: team-data push failed; ${aheadCount:-some} commit(s) stay local, kept, and the next close retries: $pushOut" >&2
		return 0
	fi
	headFull="$( git -C "$repoRoot" rev-parse HEAD 2>/dev/null )" || headFull=""
	remoteHead="$( git -C "$repoRoot" ls-remote origin "refs/heads/$pushBranch" 2>/dev/null | LC_ALL=C awk 'NR == 1 { print $1 ; }' )" || remoteHead=""
	if [ -z "$headFull" ] || [ "$remoteHead" != "$headFull" ] ; then
		echo "⚠️ WARNING: $MDSC_CMD: $pushWhere: team-data push reported success but origin/$pushBranch reads back '${remoteHead:-<nothing>}', not ${headFull:-<unknown>}; the next close retries" >&2
		return 0
	fi
	echo "# $MDSC_CMD: $pushWhere: team-data pushed, origin/$pushBranch = $headFull" >&2
	return 0
}

## A store that is a repository of its own and has no origin, or another one than
## TEAM_DATA_GIT_REMOTE, is given the remote as its origin, and one line says so. Such a
## store was made before the remote was set: myx.common's git/clonePull and git/cloneSync
## only `remote set-url origin`, which fails where there is none, and the close push skipped
## a store whose origin was another. Its branch, never renamed, is told to follow its
## namesake at the origin, which their `git pull` needs. Never a force; a store inside a
## larger repository is never touched. rc 0 where the origin is the remote, now or already.
AgentsToolsTeamDataRemoteAlign(){ ## where, remote
	local alignWas="" alignBranch=""
	[ -n "${MDAT_DATA_ROOT:-}" ] && [ -e "$MDAT_DATA_ROOT/.git" ] && [ -n "${2:-}" ] || return 1
	alignWas="$( git -C "$MDAT_DATA_ROOT" remote get-url origin 2> /dev/null )" || alignWas=""
	[ "$alignWas" != "$2" ] || return 0
	if [ -n "$alignWas" ] ; then
		git -C "$MDAT_DATA_ROOT" remote set-url origin "$2" > /dev/null 2>&1
	else
		git -C "$MDAT_DATA_ROOT" remote add origin "$2" > /dev/null 2>&1
	fi || {
		echo "⚠️ WARNING: $MDSC_CMD: $1: the origin of the team-data store $MDAT_DATA_ROOT could not be set to TEAM_DATA_GIT_REMOTE $2, so nothing is pushed from it" >&2
		return 1
	}
	echo "# $MDSC_CMD: $1: the team-data store $MDAT_DATA_ROOT had ${alignWas:+the origin $alignWas}${alignWas:-no origin}: its origin is now TEAM_DATA_GIT_REMOTE $2" >&2
	alignBranch="$( git -C "$MDAT_DATA_ROOT" symbolic-ref --short -q HEAD 2> /dev/null )" || alignBranch=""
	if [ -n "$alignBranch" ] && [ -z "$( git -C "$MDAT_DATA_ROOT" config --get "branch.$alignBranch.remote" 2> /dev/null )" ] ; then
		git -C "$MDAT_DATA_ROOT" config "branch.$alignBranch.remote" origin > /dev/null 2>&1 || :
		git -C "$MDAT_DATA_ROOT" config "branch.$alignBranch.merge" "refs/heads/$alignBranch" > /dev/null 2>&1 || :
	fi
	return 0
}

## When TEAM_DATA_GIT_REMOTE is set and no local board exists yet -- the store is
## missing or empty -- clones it with myx.common git/clonePull, the main loop's own
## primitive, on TEAM_DATA_BRANCH. A store holding content that is not a clone is left
## alone and said: adopting it is the main loop's decision, never a writer's. Returns 0.
AgentsToolsTeamDataEnsureClone(){ ## where
	[ -n "${MDAT_DATA_ROOT:-}" ] || return 0
	[ ! -e "$MDAT_DATA_ROOT/.git" ] || return 0
	## Called for every op: a store holding content costs one test and no config read.
	if [ -d "$MDAT_DATA_ROOT" ] && [ -n "$( ls -A "$MDAT_DATA_ROOT" 2>/dev/null )" ] ; then
		return 0
	fi
	## A workspace that keeps no team data (F13.1, AgentsTools.TeamDataGate.include) clones none: the remote it may have set is not read.
	type AgentsToolsTeamDataGateOpen > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.TeamDataGate.include"
	AgentsToolsTeamDataGateOpen || return 0
	## Once per process tree: an op dispatching nested ops never tries, or warns, twice.
	[ -z "${MDAT_TEAM_DATA_CLONE_TRIED:-}" ] || return 0
	local cloneRemote="" cloneLock=""
	type AgentsToolsConfigOption > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/config/AgentsTools.ConfigOption.include"
	cloneRemote="$( AgentsToolsConfigOption magic-team --select TEAM_DATA_GIT_REMOTE 2>/dev/null )" || cloneRemote=""
	[ -n "$cloneRemote" ] || return 0
	export MDAT_TEAM_DATA_CLONE_TRIED=1
	## Two first writers never both clone: the loser, once it holds the lock, finds the clone done.
	. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/magic/AgentsTools.LocalLock.include"
	if ! AgentsToolsLocalLockTake "team-data-clone" 30 "the team-data clone" ; then
		echo "⚠️ WARNING: $MDSC_CMD: $1: another writer holds the team-data clone lock, so this one did not clone" >&2
		return 0
	fi
	cloneLock="$agentsLocalLockPath"
	AgentsToolsTeamDataEnsureCloneLocked "$1" "$cloneRemote"
	AgentsToolsLocalLockGive "$cloneLock"
	return 0
}

AgentsToolsTeamDataEnsureCloneLocked(){ ## where, remote
	local cloneRemote="$2" cloneBranch=""
	[ ! -e "$MDAT_DATA_ROOT/.git" ] || return 0
	## A store inside a larger repository is already in one, and is never given a nested clone.
	if [ -d "$MDAT_DATA_ROOT" ] && git -C "$MDAT_DATA_ROOT" rev-parse --show-toplevel > /dev/null 2>&1 ; then
		return 0
	fi
	if [ -d "$MDAT_DATA_ROOT" ] && [ -n "$( ls -A "$MDAT_DATA_ROOT" 2>/dev/null )" ] ; then
		echo "⚠️ WARNING: $MDSC_CMD: $1: TEAM_DATA_GIT_REMOTE is set but $MDAT_DATA_ROOT holds local content and is not a clone, so nothing is committed or pushed from it; the main loop adopts such a store, a writer never does" >&2
		return 0
	fi
	type AgentsToolsMyRoot > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/common/AgentsTools.MyRoot.include"
	if [ -z "${MYXROOT:-}" ] || [ ! -f "$MYXROOT/bin/git/clonePull.Common" ] ; then
		echo "⚠️ WARNING: $MDSC_CMD: $1: TEAM_DATA_GIT_REMOTE is set and no local board exists, but myx.common git/clonePull is unreachable, so it was not cloned" >&2
		return 0
	fi
	type AgentsToolsConfigOption > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/config/AgentsTools.ConfigOption.include"
	cloneBranch="$( AgentsToolsConfigOption magic-team --select-default TEAM_DATA_BRANCH main 2>/dev/null )" || cloneBranch=""
	[ -n "$cloneBranch" ] || cloneBranch="main"
	if ( GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=init.defaultBranch GIT_CONFIG_VALUE_0="$cloneBranch" \
		"$MYXROOT/bin/git/clonePull.Common" "$MDAT_DATA_ROOT" "$cloneRemote" "$cloneBranch" >&2 ) ; then
		echo "# $MDSC_CMD: $1: no local board existed, cloned $cloneRemote ($cloneBranch) into $MDAT_DATA_ROOT" >&2
	else
		echo "⚠️ WARNING: $MDSC_CMD: $1: no local board existed and cloning $cloneRemote failed, so this write stays local and uncommitted" >&2
	fi
	return 0
}

## The store step of --owner-setup-storage --apply. MDAT_DATA_ROOT is resolved the
## dispatcher's way, which also clones a missing or empty store when a remote is set.
## With no remote the store is initialised. With a remote set, a store holding content
## that is not a clone is handed to myx.common git/cloneSync, as the main loop's pass hands
## it; a store that is a repository is given the remote as its origin where it has none or
## another (AgentsToolsTeamDataRemoteAlign) and pushed (AgentsToolsTeamDataPushIfAhead,
## which integrates a remote that moved with git/cloneSync). The configured author identity
## is written into the store repository's own config, and the board is made ready
## (AgentsToolsBoardReady). Non-zero only on a failure.
AgentsToolsTeamDataPrepareStore(){
	local MDSC_CMD="${MDSC_CMD:-DistroAgentsTools}" prepareRemote="" prepareName="" prepareEmail=""
	set -- --owner-setup-storage
	. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsContext.UseAgentsTools.include"
	[ -n "${MDAT_DATA_ROOT:-}" ] || { echo "⛔ ERROR: $MDSC_CMD --owner-setup-storage: the team-data store could not be resolved" >&2 ; return 1 ; }
	type AgentsToolsBoardReady > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.BoardStates.include"
	type AgentsToolsConfigOption > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/config/AgentsTools.ConfigOption.include"
	prepareRemote="$( AgentsToolsConfigOption magic-team --select TEAM_DATA_GIT_REMOTE 2>/dev/null )" || prepareRemote=""
	## A store inside a larger repository is never given a nested one, nor an identity of the outer one's.
	local prepareProbe="$MDAT_DATA_ROOT"
	while [ -n "$prepareProbe" ] && [ ! -d "$prepareProbe" ] ; do
		[ "${prepareProbe%/*}" != "$prepareProbe" ] || { prepareProbe="" ; break ; }
		prepareProbe="${prepareProbe%/*}"
	done
	if [ ! -e "$MDAT_DATA_ROOT/.git" ] && [ -n "$prepareProbe" ] && git -C "$prepareProbe" rev-parse --show-toplevel > /dev/null 2>&1 ; then
		echo "⚠️ WARNING: $MDSC_CMD --owner-setup-storage: $MDAT_DATA_ROOT sits inside the larger repository $( git -C "$prepareProbe" rev-parse --show-toplevel ), so no repository is made for it and no identity is written" >&2
		AgentsToolsBoardReady || return 1
		return 0
	fi
	if [ ! -e "$MDAT_DATA_ROOT/.git" ] ; then
		if [ -n "$prepareRemote" ] ; then
			type AgentsToolsMyRoot > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/common/AgentsTools.MyRoot.include"
			if [ -n "${MYXROOT:-}" ] && [ -f "$MYXROOT/bin/git/cloneSync.Common" ] && [ -d "$MDAT_DATA_ROOT" ] && [ -n "$( ls -A "$MDAT_DATA_ROOT" 2>/dev/null )" ] ; then
				local prepareBranch=""
				type AgentsToolsConfigOption > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/config/AgentsTools.ConfigOption.include"
				prepareBranch="$( AgentsToolsConfigOption magic-team --select-default TEAM_DATA_BRANCH main 2>/dev/null )" || prepareBranch=""
				[ -n "$prepareBranch" ] || prepareBranch="main"
				( GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=init.defaultBranch GIT_CONFIG_VALUE_0="$prepareBranch" \
					"$MYXROOT/bin/git/cloneSync.Common" "$MDAT_DATA_ROOT" "$prepareRemote" "$prepareBranch" >&2 ) || :
			fi
			if [ ! -e "$MDAT_DATA_ROOT/.git" ] ; then
				echo "⚠️ WARNING: $MDSC_CMD --owner-setup-storage: $MDAT_DATA_ROOT is not a clone of TEAM_DATA_GIT_REMOTE yet, for the reason above; the main loop's pass makes it one once the remote answers" >&2
				AgentsToolsBoardReady || return 1
				return 0
			fi
			echo "# $MDSC_CMD --owner-setup-storage: git/cloneSync made $MDAT_DATA_ROOT a clone of TEAM_DATA_GIT_REMOTE" >&2
		else
			mkdir -p "$MDAT_DATA_ROOT" && git -C "$MDAT_DATA_ROOT" init -q || { echo "⛔ ERROR: $MDSC_CMD --owner-setup-storage: could not initialise $MDAT_DATA_ROOT as a repository" >&2 ; return 1 ; }
			echo "# $MDSC_CMD --owner-setup-storage: no remote is set, so $MDAT_DATA_ROOT was initialised as a repository" >&2
		fi
	fi
	[ -z "$prepareRemote" ] || AgentsToolsTeamDataRemoteAlign "--owner-setup-storage" "$prepareRemote" || :
	type AgentsToolsConfigOption > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/config/AgentsTools.ConfigOption.include"
	prepareName="$( AgentsToolsConfigOption magic-team --select TEAM_DATA_GIT_USER_NAME 2>/dev/null )" || prepareName=""
	prepareEmail="$( AgentsToolsConfigOption magic-team --select TEAM_DATA_GIT_USER_EMAIL 2>/dev/null )" || prepareEmail=""
	[ -z "$prepareName" ] || git -C "$MDAT_DATA_ROOT" config user.name "$prepareName" || return 1
	[ -z "$prepareEmail" ] || git -C "$MDAT_DATA_ROOT" config user.email "$prepareEmail" || return 1
	[ -z "$prepareName$prepareEmail" ] || echo "# $MDSC_CMD --owner-setup-storage: the configured author identity is written into $MDAT_DATA_ROOT's own config" >&2
	AgentsToolsBoardReady || return 1
	[ -z "$prepareRemote" ] || AgentsToolsTeamDataPushIfAhead "--owner-setup-storage"
	return 0
}

## Says so on stderr when the store holds uncommitted changes, and when its branch
## is ahead of origin. Never fails and never changes anything: a silent dirty or
## unpushed store is what this exists to prevent.
AgentsToolsTeamDataDirtyWarning(){ ## where
	[ -n "${MDAT_DATA_ROOT:-}" ] || return 0
	git -C "$MDAT_DATA_ROOT" rev-parse --show-toplevel > /dev/null 2>&1 || return 0
	local dirtyList="" dirtyCount=0 dirtyBranch="" aheadCount=""
	dirtyList="$( git -C "$MDAT_DATA_ROOT" status --porcelain --untracked-files=all -- . 2>/dev/null )" || dirtyList=""
	if [ -n "$dirtyList" ] ; then
		dirtyCount="$( printf '%s\n' "$dirtyList" | wc -l | tr -d '[:space:]' )"
		echo "⚠️ WARNING: $MDSC_CMD: $1: the team-data store $MDAT_DATA_ROOT holds $dirtyCount uncommitted path(s) after the team's own ops -- a tooling writer did not commit. First ones:" >&2
		printf '%s\n' "$dirtyList" | head -10 >&2
	fi
	## Measured against the last fetched origin/<branch>: `git rev-list --count origin/<branch>..HEAD`.
	dirtyBranch="$( git -C "$MDAT_DATA_ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null )" || dirtyBranch=""
	if [ -n "$dirtyBranch" ] && [ "$dirtyBranch" != "HEAD" ] && git -C "$MDAT_DATA_ROOT" rev-parse --verify --quiet "refs/remotes/origin/$dirtyBranch" > /dev/null 2>&1 ; then
		aheadCount="$( git -C "$MDAT_DATA_ROOT" rev-list --count "refs/remotes/origin/$dirtyBranch..HEAD" 2>/dev/null )" || aheadCount=""
		if [ -n "$aheadCount" ] && [ "$aheadCount" != "0" ] ; then
			echo "⚠️ WARNING: $MDSC_CMD: $1: the team-data branch $dirtyBranch is $aheadCount commit(s) ahead of origin/$dirtyBranch (rev-list --count against the last fetch) -- not pushed yet" >&2
		fi
	fi
	return 0
}
