#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.TeamDataThread.include -- the work of the one thread that commits and pushes the team data (S12.4), run on the shared
## on-demand thread (S12.11, AgentsTools.OnDemandThread.include). Sourced, never run. One function, used both as the thread's handler
## and as its tick. The operation that runs it is --intern-team-data-commit (AgentsTools.InternTeamDataCommit.include).
##
## A writer runs no git. It leaves one entry file in the thread's folder, team-data-commit/ in the git directory of the store
## (AgentsToolsTeamDataThreadDir, AgentsTools.TeamDataCommit.include), and asks the thread to commit what waits. An entry holds, a
## line each: nothing, the context of the commit, and the paths. A pass commits the entries, oldest first, each as its own commit
## (AgentsToolsTeamDataCommitPathsNow), and pushes once.
## A pass runs on a request AND once a second with none, so an entry whose request was lost -- a request written in the moment the
## thread was born, before it held the fifo -- still commits within the second. A pass with nothing to do forks nothing: the folder
## and the debt's path are read once for the life of the thread, and an empty folder is found by the shell's own glob.
##

## The folder and the debt file, read once: this function runs once a second for the life of the thread, and each read is a git call
## or a subshell. Empty means not read yet, or no store.
teamPassDir=""
teamPassOwedFile=""

## A pass over the entries that wait, oldest first, each committed as its own commit, then one push. An entry already gone when the
## pass reaches it is nothing to commit, so a pass run twice for one request commits it once. `done` goes to descriptor 3, which the
## shared thread points at the caller's fifo for a request and at /dev/null for a tick.
AgentsToolsTeamDataThreadPass(){
	local passEntry passContext passPath passPaths passCount=0 passAny=""
	if [ -z "$teamPassDir" ] ; then
		teamPassDir="$( AgentsToolsTeamDataThreadDir )" || { printf 'no store\n' >&3 ; return 0 ; }
		teamPassOwedFile="$( AgentsToolsTeamDataCommitOwedPath )" || teamPassOwedFile=""
	fi
	for passEntry in "$teamPassDir"/*.entry ; do
		[ -f "$passEntry" ] && { passAny="yes" ; break ; }
	done
	if [ -n "$passAny" ] ; then
		while IFS= read -r passEntry ; do
			[ -f "$passEntry" ] || continue
			passPaths=()
			{
				IFS= read -r _
				IFS= read -r passContext
				while IFS= read -r passPath ; do
					[ -z "$passPath" ] || passPaths+=( "$passPath" )
				done
			} < "$passEntry"
			AgentsToolsTeamDataCommitPathsNow "$passContext" ${passPaths[@]+"${passPaths[@]}"}
			rm -f "$passEntry"
			passCount=$(( passCount + 1 ))
		done < <( ls -rt "$teamPassDir"/*.entry 2> /dev/null )
	fi
	AgentsToolsTeamDataThreadOwed
	[ "$passCount" = 0 ] || AgentsToolsTeamDataPushIfAhead "the team-data thread"
	printf 'done\n' >&3
	return 0
}

## How long ago the debt was last tried, in the thread's own clock: kept across passes, because the thread is one process and this is
## the state it holds.
teamOwedTriedAt=-100

## The debt of a commit that failed, tried again on its own timer, at least thirty seconds after the last try: a lock, a full disk or
## a merge left unfinished must not leave a write that "warned" and never landed. The debt is a file in the workspace, not this
## thread's memory, so a debt outlives the thread that met it.
AgentsToolsTeamDataThreadOwed(){
	local owedPath owedPaths=()
	[ -n "$teamPassOwedFile" ] && [ -s "$teamPassOwedFile" ] || return 0
	[ "$(( SECONDS - teamOwedTriedAt ))" -ge 30 ] || return 0
	teamOwedTriedAt="$SECONDS"
	## EVERY PATH THE DEBT HOLDS, not only its first line: a commit that failed with several paths owed the store all of them,
	## and reading one line left the rest owed for good while each retry reported a commit made.
	while IFS= read -r owedPath ; do
		[ -z "$owedPath" ] || owedPaths+=( "$owedPath" )
	done < "$teamPassOwedFile"
	[ "${#owedPaths[@]}" -gt 0 ] || return 0
	AgentsToolsTeamDataCommitPathsNow "owed commit" ${owedPaths[@]+"${owedPaths[@]}"}
	AgentsToolsTeamDataPushIfAhead "the team-data thread"
	return 0
}
