#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.ItemNameShape.include -- the item filename check every creating writer
## of board-items and inbox items shares: <type>-<YYYYMMDD'T'HHmm'Z'>[-<matter>].md, the
## seconds variant <type>-<YYYYMMDD'T'HHmmSS'Z'>[-<matter>].md also accepted (the naming
## Rule, magic-team.armed.md). Sourced by AgentsTools.DocValidate.include, whose write gate
## the two creating writers (AgentsTools.InternOpBoardUpsertMoveEdit.include and
## AgentsTools.InternOpMemberInboxUpsert.include) call. Contract: MAGIC.md.
##

if ! type AgentsToolsItemNameShapeFault > /dev/null 2>&1 ; then

	## The type an item filename names: its leading lowercase token, or nothing.
	AgentsToolsItemNameType(){ ## item filename
		printf '%s\n' "$1" | LC_ALL=C sed -n -E 's/^([a-z][a-z0-9]*)(-.*|\.md)?$/\1/p'
	}

	## What a name off the Rule's shape is told: the sentence quoting the Rule, or nothing where the name follows it. The
	## write gate (AgentsToolsDocValidateGate) says it, as a reporting rule: the item is still created under the name
	## given -- the name carries the caller's own matter, so the tooling never rewrites it.
	AgentsToolsItemNameShapeFault(){ ## item filename
		if ! printf '%s\n' "$1" | LC_ALL=C grep -Eq '^[a-z][a-z0-9]*-[0-9]{8}T[0-9]{4}([0-9]{2})?Z(-[A-Za-z0-9._-]+)?\.md$' ; then
			printf '%s' "$1 does not follow the naming Rule (magic-team.armed.md): \"when/if you add a date, always use \`YYYYMMDD'T'HHmm'Z'\` format. If seconds are required, use \`YYYYMMDD'T'HHmmSS'Z'\` extended variant.\" The shape is <type>-<date>-<matter>.md, for example task-$( date -u +%Y%m%dT%H%MZ )-short-matter.md. Created anyway."
		fi
		return 0
	}

fi
