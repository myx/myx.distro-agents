#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.MemberCommsSlack.include -- the raw per-member Slack comms
## operations (read, search, react, send, edit, delete, file info/fetch).
##

AgentsToolsCommsSlackFileInfoEmitField(){
	local emitKey="$1" emitPath="$2" emitPayload="$3"
	local emitNewline=$'\n'
	local emitValue="" emitRc=0
	emitValue="$( printf '%s\n' "$emitPayload" | LC_ALL=C awk -v path="$emitPath" -v optional=1 -v sentinel=1 \
		-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsSlackJsonField.awk" )" || emitRc=$?
	if [ "$emitRc" = "0" ] ; then
		emitValue="${emitValue%X}"
	fi
	case "$emitRc" in
		0)
			case "$emitValue" in
				*"$emitNewline"*)
					printf '%s_STATE=present-multiline\n' "$emitKey"
				;;
				*)
					printf '%s_STATE=present\n' "$emitKey"
					printf '%s=%s\n' "$emitKey" "$emitValue"
				;;
			esac
			return 0
		;;
		3)
			printf '%s_STATE=absent\n' "$emitKey"
			return 0
		;;
	esac
	echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-info: the field reader could not parse the files.info response body while reading '$emitPath' (rc=$emitRc -- 1: the body is not a parseable Slack API response, 2: no key path was given). Nothing about this file is known from this call, and the fields printed before this line are NOT a complete metadata set." >&2
	return 1
}

## One member's own display marks from its .basic.md, tab-separated: the icon
## (Slack shortcode, else the unicode character) and the alias (the member's
## own name instead, when the alias is absent or malformed).
AgentsToolsCommsSlackMemberMarks(){
	local marksFile="$HOME/.claude/skills/$1/$1.basic.md"
	[ -f "$marksFile" ] || return 1
	LC_ALL=C awk -F": " -v who="$1" '
		icon  == "" && /^- \*\*Slack shortcode\*\*:/	{ icon  = $2 ; }
		emoji == "" && /^- \*\*Unicode character\*\*:/	{ emoji = $2 ; }
		alias == "" && /^- \*\*Alias\*\*:/		{ alias = $2 ; }
		END {
			if ( icon == "" ) { icon = emoji ; }
			gsub( /`/, "", icon )  ; sub( /[[:space:]].*$/, "", icon ) ;
			gsub( /`/, "", alias ) ; sub( /[[:space:]].*$/, "", alias ) ; sub( /\.$/, "", alias ) ;
			if ( alias !~ /^[A-Za-z0-9._-]+$/ ) { alias = who ; }
			printf "%s\t%s\n", icon, alias ;
		}
	' "$marksFile"
}

. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.CommsSlack.include"

case "$1" in

		## Own file for size only; the service keeps one dispatcher arm.
		--member-comms-slack-presence-*)
			. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.MemberCommsSlackPresence.include"
			return $?
		;;

		## Own file for size only; the service keeps one dispatcher arm.
		--member-comms-slack-profile-*)
			. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.MemberCommsSlackProfile.include"
			return $?
		;;

		--member-comms-slack-read)
			shift
			if [ "$1" = "--print-required-scopes" ] ; then
				printf '%s\n' channels:read channels:history groups:read groups:history im:read im:history mpim:read mpim:history im:write
				return 0
			fi
			local memberName="$1"
			shift || true
			if [ -z "$memberName" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-read: syntax is <team-member> <channel>:<ts> [--thread] [--identity-bot] -- the acting member is required, since a direct conversation belongs to one identity and the member decides which conversation is read" >&2
				set +e ; return 1
			fi
			AgentsToolsAssertBareName "$memberName" "<team-member>" member-comms-slack-read || { set +e ; return 1 ; }
			case "$memberName" in
				routine-*)
				;;
				*)
					if [ ! -d "$HOME/.claude/skills/$memberName" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-read: no such member skill directory: $HOME/.claude/skills/$memberName" >&2
						set +e ; return 1
					fi
				;;
			esac
			local target="$1"
			shift || true
			if [ -z "$target" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-read: target required -- <channel>:<ts> only. Unlike --intern-op-slack-check, this op does not accept the magic-team/human-owner/event-track/event-alert channel shortcuts, nor a bare <conversation-id>: each of those names a conversation, and this op retrieves one specific message, which needs its own <ts>. That constraint is enforced further down by this same arm's own '<ts> is required' check." >&2
				set +e ; return 1
			fi

			local wantThread="false" identityAsBot="false"
			while [ $# -gt 0 ] ; do
				case "$1" in
					--thread)
						wantThread="true" ; shift
					;;
					--identity-bot)
						identityAsBot="true" ; shift
					;;
					*)
						echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-read: invalid option: $1" >&2
						set +e ; return 1
					;;
				esac
			done

			local resolved rc channel threadTs
			resolved="$( DistroAgentsToolsResolveTarget "$target" )" && rc=0 || rc=$?
			case "$rc" in
				0)
					channel="$( printf '%s\n' "$resolved" | sed -n 's/^CHANNEL=//p' )"
					local targetUserId=""
					targetUserId="$( printf '%s\n' "$resolved" | sed -n 's/^USER_ID=//p' )" || targetUserId=""
					threadTs="$( printf '%s\n' "$resolved" | sed -n 's/^THREAD_TS=//p' )"
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-read: could not resolve target '$target' -- pass <channel>:<ts> for a specific message" >&2
					set +e ; return 1
				;;
			esac
			if [ -z "$threadTs" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-read: a specific <ts> is required (magic-team/human-owner alone identify a channel, not one message) -- use <channel>:<ts>" >&2
				set +e ; return 1
			fi

			local identityArgs=()
			if [ "$identityAsBot" = "true" ] ; then
				identityArgs+=( --identity bot )
			fi
			if [ "$wantThread" = "true" ] ; then
				echo "# $MDSC_CMD --member-comms-slack-read: GET conversations.replies channel=$channel ts=$threadTs (full thread, acting member $memberName)" >&2
				DistroAgentsTools --intern-op-slack-call "$memberName" \
					--api conversations.replies \
					--resolve-target "$channel" \
					--form "ts=$threadTs" \
					"${identityArgs[@]}" \
					--context "--member-comms-slack-read" || { set +e ; return 1 ; }
			else
				echo "# $MDSC_CMD --member-comms-slack-read: GET conversations.replies channel=$channel ts=$threadTs (single message, selected by exact ts, acting member $memberName)" >&2
				local response callRc=0
				response="$( DistroAgentsTools --intern-op-slack-call "$memberName" \
					--api conversations.replies \
					--resolve-target "$channel" \
					--form "ts=$threadTs" \
					"${identityArgs[@]}" \
					--context "--member-comms-slack-read" )" || callRc=$?
				if [ "$callRc" != "0" ] ; then
					set +e ; return 1
				fi

				local selectStatus=0
				printf '%s\n' "$response" | LC_ALL=C awk -v wantTs="$threadTs" \
					-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsSlackMessageSelect.awk" || selectStatus=$?
				case "$selectStatus" in
					0)
					;;
					1)
						echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-read: COULD NOT READ $channel:$threadTs -- conversations.replies answered successfully but returned no message carrying that exact ts. This is a failed read, NOT an empty conversation: do not conclude the message is absent or unanswered from this result. Check the ts and the channel, then read again." >&2
						set +e ; return 1
					;;
					*)
						echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-read: COULD NOT READ $channel:$threadTs -- the conversations.replies response could not be parsed as an API response, or Slack refused it (see the selector's own error above). Nothing was read, so nothing about that message is known from this call." >&2
						set +e ; return 1
					;;
				esac
			fi
			return 0
		;;

		--member-comms-slack-search-messages)
			shift
			if [ "$1" = "--print-required-scopes" ] ; then
				printf '%s\n' search:read
				return 0
			fi
			local memberName="$1"
			shift || true
			if [ -z "$memberName" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-search-messages: syntax is <team-member> <magic-team|human-owner|event-track|event-alert|<conversation-id>|<channel>> (--comms-since-date-time <v>|--comms-since-utime <v>) [--max-pages <n>] [--raw] -- the acting member is required, and it is the only thing selecting which user token performs the search" >&2
				set +e ; return 1
			fi
			AgentsToolsAssertBareName "$memberName" "<team-member>" member-comms-slack-search-messages || { set +e ; return 1 ; }
			case "$memberName" in
				routine-*)
				;;
				*)
					if [ ! -d "$HOME/.claude/skills/$memberName" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-search-messages: no such member skill directory: $HOME/.claude/skills/$memberName" >&2
						set +e ; return 1
					fi
				;;
			esac
			local target="$1"
			shift || true

			if [ -z "$target" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-search-messages: target required (magic-team|human-owner|event-track|event-alert|<conversation-id>|<channel>)" >&2
				set +e ; return 1
			fi

			local cutoffKind="" cutoffValue="" maxPages=10 pretty="true"
			while [ $# -gt 0 ] ; do
				case "$1" in
					--comms-since-date-time|--comms-since-utime)
						if [ -n "$cutoffKind" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-search-messages: --comms-since-date-time and --comms-since-utime are mutually exclusive, and neither is repeatable -- one cut-off, one spelling" >&2
							set +e ; return 1
						fi
						if [ -z "${2:-}" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-search-messages: $1 requires a value" >&2
							set +e ; return 1
						fi
						cutoffKind="$1" ; cutoffValue="$2" ; shift 2
					;;
					--max-pages)
						if [ -z "${2:-}" ] || [ -n "$( printf '%s' "$2" | tr -d '0-9' )" ] || [ "$2" = "0" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-search-messages: --max-pages requires a positive whole number of pages, got: ${2:-}" >&2
							set +e ; return 1
						fi
						maxPages="$2" ; shift 2
					;;
					--raw)
						pretty="false" ; shift
					;;
					--identity-bot)
						echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-search-messages: --identity-bot is REFUSED by this operation -- Slack's search.messages is available to a user token only, and a bot token cannot call it at all. This is not a permission that could be granted: no scope makes a bot able to search. The flag is rejected rather than accepted-and-ignored on purpose, because acting under the member's user identity while the caller asked for the bot would be a silent identity substitution. Every other --member-comms-slack-* operation does accept --identity-bot; this one is the exception, and the exception is Slack's, not this tool's. Re-run without the flag to search under the member's own user identity." >&2
						set +e ; return 1
					;;
					*)
						echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-search-messages: invalid option: $1" >&2
						set +e ; return 1
					;;
				esac
			done

			if [ -z "$cutoffKind" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-search-messages: a cut-off is required -- pass --comms-since-date-time <YYYY-MM-DD...> or --comms-since-utime <epoch-seconds>. There is deliberately no default: an unbounded search would return this conversation's entire history a page at a time, and a caller that meant 'recently' would get a truncated prefix of years-old messages instead." >&2
				set +e ; return 1
			fi

			local cutoffEpoch=""
			if [ "$cutoffKind" = "--comms-since-utime" ] ; then
				case "$cutoffValue" in
					''|*[!0-9.]*)
						echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-search-messages: --comms-since-utime: not epoch seconds: $cutoffValue" >&2
						set +e ; return 1
					;;
				esac
				cutoffEpoch="$cutoffValue"
			else
				case "$cutoffValue" in
					[0-9][0-9][0-9][0-9]-[0-1][0-9]-[0-3][0-9]*) : ;;
					*)
						echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-search-messages: --comms-since-date-time: must start with YYYY-MM-DD: $cutoffValue" >&2
						set +e ; return 1
					;;
				esac
				cutoffEpoch="$( printf '%s\n' "$cutoffValue" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsIsoToEpoch.awk" )" || cutoffEpoch=""
				if [ -z "$cutoffEpoch" ] ; then
					echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-search-messages: --comms-since-date-time: could not convert to epoch seconds: $cutoffValue" >&2
					set +e ; return 1
				fi
			fi

			local afterDate=""
			afterDate="$( printf '%s\n' "$(( ${cutoffEpoch%%.*} - 86400 ))" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsEpochToIsoDate.awk" )" || afterDate=""
			if [ -z "$afterDate" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-search-messages: could not derive the search window's start date from cut-off $cutoffEpoch" >&2
				set +e ; return 1
			fi

			local resolved rc channel threadTs
			resolved="$( DistroAgentsToolsResolveTarget "$target" )" && rc=0 || rc=$?
			case "$rc" in
				0)
					channel="$( printf '%s\n' "$resolved" | sed -n 's/^CHANNEL=//p' )"
					threadTs="$( printf '%s\n' "$resolved" | sed -n 's/^THREAD_TS=//p' )"
				;;
				2)
					echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-search-messages: unrecognized target: $target" >&2
					set +e ; return 1
				;;
				*)
					local targetKey=""
					case "${target%%:*}" in
						event-track)	targetKey="SLACK_CHANNEL_EVENT_TRACK" ;;
						event-alert)	targetKey="SLACK_CHANNEL_EVENT_ALERT" ;;
						magic-team)	targetKey="SLACK_CHANNEL_MAGIC_TEAM" ;;
						human-owner)	targetKey="SLACK_CHANNEL_HUMAN_OWNER" ;;
					esac
					if [ -n "$targetKey" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-search-messages: could not resolve a channel for target '$target' -- check $targetKey in .local/.agents" >&2
					else
						echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-search-messages: could not resolve a channel for target '$target' -- it names a conversation directly, so no config key backs it; its channel part is empty" >&2
					fi
					set +e ; return 1
				;;
			esac

			if [ -n "$threadTs" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-search-messages: target '$target' names one specific message (<channel>:<ts>), and this operation searches a whole conversation over a time window. The <ts> was NOT ignored -- pass the channel alone. To read that one message or its thread, use --member-comms-slack-read <team-member> <channel>:<ts> [--thread] -- note that op takes the acting member as its FIRST argument, ahead of the target." >&2
				set +e ; return 1
			fi

			local inTerm=""
			case "$channel" in
				C*|D*|G*) inTerm="in:<#$channel>" ;;
				U*|W*)    inTerm="in:<@$channel>" ;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-search-messages: target '$target' resolved to '$channel', which is neither a conversation id (C/D/G) nor a party id (U/W), so no Slack \`in:\` term can be built for it. Nothing was searched." >&2
					set +e ; return 1
				;;
			esac

			local searchQuery="$inTerm after:$afterDate"
			echo "## target=$target channel=$channel query=$searchQuery cutoff=$cutoffEpoch"
			echo "# $MDSC_CMD --member-comms-slack-search-messages: GET search.messages query='$searchQuery' (asking from one day early on purpose; real cut-off $cutoffEpoch applied per match)" >&2

			local pageNum=1 pagesTotal="" grandMatches=0 grandReplies=0 truncated="false"
			local pageBodies=() pageLines=()
			while : ; do
				local opArgs=( "$memberName" --api search.messages --identity user
					--form "query=$searchQuery" --form sort=timestamp --form sort_dir=desc
					--form count=100 --form "page=$pageNum"
					--context "--member-comms-slack-search-messages" )

				local response callRc=0
				response="$( DistroAgentsTools --intern-op-slack-call "${opArgs[@]}" )" || callRc=$?
				if [ "$callRc" != "0" ] ; then
					echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-search-messages: COULD NOT SEARCH $channel -- search.messages failed on page $pageNum (see the op's own diagnostic above). This is NOT an empty result: nothing is known from this call about whether that conversation holds matching messages. A not_allowed_token_type error here means the acting identity has no user token, which this operation requires and cannot work around." >&2
					set +e ; return 1
				fi

				local metaOut metaRc=0
				metaOut="$( printf '%s\n' "$response" | LC_ALL=C awk -v cutoff="$cutoffEpoch" -v mode=meta \
					-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsSlackSearchMatches.awk" )" || metaRc=$?
				if [ "$metaRc" = "1" ] ; then
					echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-search-messages: COULD NOT READ the search.messages response for page $pageNum (see the reader's own error above). Nothing is known from this call about presence or absence of matches." >&2
					set +e ; return 1
				fi

				local pageMatches pageExpected pageInRange pageReplies pageOldest
				pagesTotal="$( printf '%s\n' "$metaOut" | sed -n 's/^SEARCH_PAGES=//p' )"
				pageMatches="$( printf '%s\n' "$metaOut" | sed -n 's/^PAGE_MATCH_COUNT=//p' )"
				pageExpected="$( printf '%s\n' "$metaOut" | sed -n 's/^PAGE_EXPECTED_COUNT=//p' )"
				pageInRange="$( printf '%s\n' "$metaOut" | sed -n 's/^PAGE_IN_RANGE_COUNT=//p' )"
				pageReplies="$( printf '%s\n' "$metaOut" | sed -n 's/^PAGE_THREAD_REPLIES=//p' )"
				pageOldest="$( printf '%s\n' "$metaOut" | sed -n 's/^PAGE_OLDEST_TS=//p' )"

				if [ -n "$pagesTotal" ] && [ "$pageNum" -lt "$pagesTotal" ] && [ -n "$pageExpected" ] \
					&& [ "$pageMatches" -lt "$pageExpected" ] ; then
					echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-search-messages: page $pageNum of $pagesTotal carried $pageMatches matches where Slack's own paging says a full page holds $pageExpected. A non-final page is short, so the response body was truncated in transit and the missing matches are NOT known to be absent. Nothing is reported from this read." >&2
					set +e ; return 1
				fi

				if [ "$pretty" = "true" ] ; then
					local linesOut linesRc=0
					linesOut="$( printf '%s\n' "$response" | LC_ALL=C awk -v cutoff="$cutoffEpoch" \
						-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsSlackSearchMatches.awk" )" || linesRc=$?
					if [ "$linesRc" = "1" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-search-messages: COULD NOT FORMAT the search.messages matches for page $pageNum (see the reader's own error above)." >&2
						set +e ; return 1
					fi
					pageLines+=( "$linesOut" )
				else
					pageBodies+=( "$response" )
				fi

				grandMatches=$(( grandMatches + pageInRange ))
				grandReplies=$(( grandReplies + pageReplies ))

				if [ -n "$pageOldest" ] && [ "$( LC_ALL=C awk -v a="$pageOldest" -v b="$cutoffEpoch" 'BEGIN{print (a+0 < b+0) ? "below" : "above"}' )" = "below" ] ; then
					break
				fi
				if [ -z "$pagesTotal" ] || [ "$pageNum" -ge "$pagesTotal" ] ; then
					break
				fi
				if [ "$pageNum" -ge "$maxPages" ] ; then
					truncated="true"
					break
				fi
				pageNum=$(( pageNum + 1 ))
			done

			local idx
			if [ "$pretty" = "true" ] ; then
				for (( idx = ${#pageLines[@]} - 1 ; idx >= 0 ; idx-- )) ; do
					if [ -n "${pageLines[$idx]}" ] ; then
						printf '%s\n' "${pageLines[$idx]}"
					fi
				done
			else
				for (( idx = ${#pageBodies[@]} - 1 ; idx >= 0 ; idx-- )) ; do
					printf '## page=%s\n' "$(( idx + 1 ))"
					printf '%s\n' "${pageBodies[$idx]}"
				done
			fi

			echo "## matches=$grandMatches thread-replies=$grandReplies pages-read=$pageNum pages-total=${pagesTotal:-?} cutoff=$cutoffEpoch after=$afterDate"

			if [ "$truncated" = "true" ] ; then
				echo "## result=truncated"
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-search-messages: INCOMPLETE -- the --max-pages bound of $maxPages was reached on a query Slack reports as $pagesTotal pages, and the search had not yet reached back to the cut-off. What is printed above is the NEWEST $grandMatches matches, a prefix of the answer and not the answer: older matches inside the requested window exist and were not read, so nothing here supports concluding any particular message is absent. Raise --max-pages or move the cut-off forward, then read again. rc=4 means exactly this incomplete state, distinct from rc=3 (a complete read that found nothing)." >&2
				set +e ; return 4
			fi
			if [ "$grandMatches" = "0" ] ; then
				echo "## result=none"
				echo "# $MDSC_CMD --member-comms-slack-search-messages: NO MATCHES in $channel at or after $cutoffEpoch. The search itself completed normally across $pageNum page(s), so this is a real, complete answer -- that conversation holds no message in the requested window, as far as this identity can see it. rc=3 says exactly that, and is deliberately not rc 0, so absence cannot be read as presence by a caller that ignores status. It is also not rc 1, which would mean the search could not be performed at all." >&2
				set +e ; return 3
			fi
			echo "## result=found"
			return 0
		;;

		--member-comms-slack-react)
			shift
			if [ "$1" = "--print-required-scopes" ] ; then
				printf '%s\n' reactions:write reactions:read im:write
				return 0
			fi
			local memberName="$1"
			shift || true
			if [ -z "$memberName" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-react: syntax is <team-member> <channel>:<ts> <emoji-name> [--identity-bot] -- the acting member is required, since a reaction is posted by one identity and the member decides which one posts it" >&2
				set +e ; return 1
			fi
			AgentsToolsAssertBareName "$memberName" "<team-member>" member-comms-slack-react || { set +e ; return 1 ; }
			case "$memberName" in
				routine-*)
					## Same routine-* carve-out as the sibling arms.
				;;
				*)
					if [ ! -d "$HOME/.claude/skills/$memberName" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-react: no such member skill directory: $HOME/.claude/skills/$memberName" >&2
						set +e ; return 1
					fi
				;;
			esac
			local target="$1"
			shift || true
			local emoji="$1"
			shift || true

			if [ -z "$target" ] || [ -z "$emoji" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-react: syntax is <team-member> <channel>:<ts> <emoji-name> [--identity-bot]" >&2
				set +e ; return 1
			fi

			local identityAsBot="false"
			while [ $# -gt 0 ] ; do
				case "$1" in
					--identity-bot)
						identityAsBot="true" ; shift
					;;
					*)
						echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-react: invalid option: $1" >&2
						set +e ; return 1
					;;
				esac
			done

			local resolved rc channel threadTs
			resolved="$( DistroAgentsToolsResolveTarget "$target" )" && rc=0 || rc=$?
			case "$rc" in
				0)
					channel="$( printf '%s\n' "$resolved" | sed -n 's/^CHANNEL=//p' )"
					local targetUserId=""
					targetUserId="$( printf '%s\n' "$resolved" | sed -n 's/^USER_ID=//p' )" || targetUserId=""
					threadTs="$( printf '%s\n' "$resolved" | sed -n 's/^THREAD_TS=//p' )"
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-react: could not resolve target '$target' -- pass <channel>:<ts>" >&2
					set +e ; return 1
				;;
			esac
			if [ -z "$threadTs" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-react: a specific <ts> is required -- use <channel>:<ts>" >&2
				set +e ; return 1
			fi

			local opArgs=( "$memberName" --api reactions.add --resolve-target "$channel" \
				--form "timestamp=$threadTs" --form "name=$emoji" )
			if [ "$identityAsBot" = "true" ] ; then
				opArgs+=( --identity bot )
			fi
			opArgs+=( --context "--member-comms-slack-react" )

			local diagFile
			diagFile="$( mktemp )" || { set +e ; return 1 ; }
			chmod 600 "$diagFile"
			trap 'rm -f "$diagFile"' EXIT

			echo "# $MDSC_CMD --member-comms-slack-react: POST reactions.add channel=$channel timestamp=$threadTs name=$emoji (acting member $memberName)" >&2
			local response callRc=0
			response="$( DistroAgentsTools --intern-op-slack-call "${opArgs[@]}" 2>"$diagFile" )" || callRc=$?

			local diag
			diag="$( cat "$diagFile" )"
			rm -f "$diagFile"
			trap - EXIT
			[ -z "$diag" ] || printf '%s\n' "$diag" >&2

			if [ "$callRc" != "0" ] ; then
				local actingIdentity=""
				actingIdentity="$( printf '%s\n' "$diag" | LC_ALL=C sed -n 's/^ACTING_IDENTITY=//p' | head -1 )"
				local actingIdentityText="the identity this call ran under (named in the op's own diagnostic above)"
				case "$actingIdentity" in
					bot|user)
						actingIdentityText="the $actingIdentity identity"
					;;
					not-yet-selected)
						actingIdentityText="no identity at all -- the call failed before one was selected"
					;;
				esac
				case "$diag" in
					*already_reacted*)
						local rawResponseState="" rawResponse=""
						rawResponseState="$( printf '%s\n' "$diag" | LC_ALL=C sed -n 's/^RESPONSE_BODY_STATE=//p' | head -1 )"
						if [ "$rawResponseState" = "in-diagnostic" ] ; then
							rawResponse="$( printf '%s\n' "$diag" | LC_ALL=C sed -n 's/^RESPONSE_BODY=//p' | head -1 )"
							printf '%s\n' "$rawResponse"
						fi
						echo "# $MDSC_CMD --member-comms-slack-react: ALREADY PRESENT on $channel:$threadTs -- $actingIdentityText had already added :$emoji: to this message, so the end state asked for HOLDS and nothing was posted by this call. This is a success, not a failure and not a fresh reaction, and it is deliberately reported apart from one. Reactions are per identity: this says nothing about whether any OTHER identity has reacted, and the same call under another identity adding the reaction again is correct behaviour, not a duplicate." >&2
						return 0
					;;
					*)
						echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-react: COULD NOT REACT to $channel:$threadTs with :$emoji: -- the call did not complete under $actingIdentityText (see the op's own diagnostic above, which carries Slack's own error code). The reaction was NOT added, and this is NOT an already-present result: nothing is known from this call about which reactions that message already carries. channel_not_found or not_in_channel here means this identity cannot reach that conversation at all, not that the message is gone -- and the right identity is a property of the METHOD, not of the member or the channel: one channel has been measured answering a read under user, a post under bot, and a reaction under user. Retry under the other identity before concluding anything about the message." >&2
						set +e ; return 1
					;;
				esac
			fi

			printf '%s\n' "$response"
			return 0
		;;

		--member-comms-slack-delete-message)
			shift
			if [ "$1" = "--print-required-scopes" ] ; then
				printf '%s\n' chat:write im:write
				return 0
			fi
			local memberName="$1"
			shift || true
			if [ -z "$memberName" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-delete-message: syntax is <team-member> <channel>:<ts> [<channel>:<ts>...] [--identity-bot] -- the acting member is required, since Slack permits deleting only a message the acting identity itself authored" >&2
				set +e ; return 1
			fi
			AgentsToolsAssertBareName "$memberName" "<team-member>" member-comms-slack-delete-message || { set +e ; return 1 ; }
			case "$memberName" in
				routine-*)
					## Same routine-* carve-out as the sibling arms.
				;;
				*)
					if [ ! -d "$HOME/.claude/skills/$memberName" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-delete-message: no such member skill directory: $HOME/.claude/skills/$memberName" >&2
						set +e ; return 1
					fi
				;;
			esac

			local identityAsBot="false"
			local deleteTargets=()
			while [ $# -gt 0 ] ; do
				case "$1" in
					--identity-bot)
						identityAsBot="true" ; shift
					;;
					--*)
						echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-delete-message: invalid option: $1" >&2
						set +e ; return 1
					;;
					*)
						deleteTargets+=( "$1" ) ; shift
					;;
				esac
			done

			if [ "${#deleteTargets[@]}" -eq 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-delete-message: syntax is <team-member> <channel>:<ts> [<channel>:<ts>...] [--identity-bot] -- at least one target is required. <channel>:<ts> only, same target grammar as --member-comms-slack-react (no magic-team/human-owner shortcut, since a deletion always targets one exact message, not a channel)" >&2
				set +e ; return 1
			fi

			local deleteTotal="${#deleteTargets[@]}" deleteDone=0 deleteFailed=0
			local oneTarget
			for oneTarget in "${deleteTargets[@]}" ; do
				local resolved rc channel threadTs
				rc=0
				resolved="$( DistroAgentsToolsResolveTarget "$oneTarget" )" || rc=$?
				if [ "$rc" != "0" ] ; then
					printf 'DELETE_TARGET=%s\n' "$oneTarget"
					printf '%s\n' DELETE_STATE=unresolvable-target
					echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-delete-message: could not resolve target '$oneTarget' -- pass <channel>:<ts>. Nothing was deleted for this target; the remaining targets are still attempted." >&2
					deleteFailed=$(( deleteFailed + 1 ))
					continue
				fi
				channel="$( printf '%s\n' "$resolved" | sed -n 's/^CHANNEL=//p' )"
				local targetUserId=""
				targetUserId="$( printf '%s\n' "$resolved" | sed -n 's/^USER_ID=//p' )" || targetUserId=""
				threadTs="$( printf '%s\n' "$resolved" | sed -n 's/^THREAD_TS=//p' )"
				if [ -z "$threadTs" ] ; then
					printf 'DELETE_TARGET=%s\n' "$oneTarget"
					printf '%s\n' DELETE_STATE=no-message-ts
					echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-delete-message: a specific <ts> is required -- use <channel>:<ts>. Nothing was deleted for '$oneTarget'; the remaining targets are still attempted." >&2
					deleteFailed=$(( deleteFailed + 1 ))
					continue
				fi

				local opArgs=( "$memberName" --api chat.delete --resolve-target "$channel" --form "ts=$threadTs" )
				if [ "$identityAsBot" = "true" ] ; then
					opArgs+=( --identity bot )
				fi
				opArgs+=( --context "--member-comms-slack-delete-message" )

				local diagFile
				diagFile="$( mktemp )" || { set +e ; return 1 ; }
				chmod 600 "$diagFile"
				trap 'rm -f "$diagFile"' EXIT

				echo "# $MDSC_CMD --member-comms-slack-delete-message: chat.delete channel=$channel ts=$threadTs (acting member $memberName, target $(( deleteDone + deleteFailed + 1 )) of $deleteTotal)" >&2
				local response callRc=0
				response="$( DistroAgentsTools --intern-op-slack-call "${opArgs[@]}" 2>"$diagFile" )" || callRc=$?

				local diag
				diag="$( cat "$diagFile" )"
				rm -f "$diagFile"
				trap - EXIT
				[ -z "$diag" ] || printf '%s\n' "$diag" >&2

				if [ "$callRc" != "0" ] ; then
					local actingIdentity=""
					actingIdentity="$( printf '%s\n' "$diag" | LC_ALL=C sed -n 's/^ACTING_IDENTITY=//p' | head -1 )"
					local actingIdentityText="the identity this call ran under (named in the op's own diagnostic above)"
					case "$actingIdentity" in
						bot|user)
							actingIdentityText="the $actingIdentity identity"
						;;
						not-yet-selected)
							actingIdentityText="no identity at all -- the call failed before one was selected"
						;;
					esac
					printf 'DELETE_TARGET=%s\n' "$oneTarget"
					case "$diag" in
						*cant_delete_message*|*message_not_found*)
							printf '%s\n' DELETE_STATE=refused-on-authorship
							echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-delete-message: REFUSED FOR $channel:$threadTs -- Slack permits deleting only a message the acting identity itself authored, and this call acted as $memberName under $actingIdentityText. The message was NOT deleted and nothing about it changed. Slack's own code is in the diagnostic above: cant_delete_message means the message exists and belongs to a different identity; message_not_found means this identity cannot see a message with that ts at all (already deleted, wrong ts, or once again another identity's message). Retrying under the other identity is deliberately NOT attempted -- substituting an identity to make a destructive call succeed is the silent degrade this op family forbids. Decide which identity should own this deletion and ask for it explicitly with --identity-bot." >&2
						;;
						*)
							printf '%s\n' DELETE_STATE=could-not-call
							echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-delete-message: COULD NOT DELETE $channel:$threadTs -- the call did not complete (see the op's own diagnostic above). This is NOT an authorship refusal: nothing is known from this result about who authored that message, and the message was not deleted." >&2
						;;
					esac
					deleteFailed=$(( deleteFailed + 1 ))
					continue
				fi

				printf 'DELETE_TARGET=%s\n' "$oneTarget"
				printf '%s\n' DELETE_STATE=deleted
				printf '%s\n' "$response"
				deleteDone=$(( deleteDone + 1 ))
			done

			echo "# $MDSC_CMD --member-comms-slack-delete-message: $deleteDone of $deleteTotal target(s) deleted, $deleteFailed not deleted (acting member $memberName)" >&2
			if [ "$deleteFailed" != "0" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-delete-message: $deleteFailed of $deleteTotal target(s) were NOT deleted -- read the per-target DELETE_STATE lines above; a non-zero exit here never means the whole run failed, and the targets reported DELETE_STATE=deleted really were deleted." >&2
				set +e ; return 1
			fi
			return 0
		;;

		--member-comms-slack-edit-message)
			shift
			if [ "$1" = "--print-required-scopes" ] ; then
				printf '%s\n' chat:write im:write
				return 0
			fi
			local memberName="$1"
			shift || true
			if [ -z "$memberName" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-edit-message: syntax is <team-member> <channel>:<ts> [--identity-bot] [text...] -- the acting member is required, since Slack permits editing only a message the acting identity itself authored" >&2
				set +e ; return 1
			fi
			AgentsToolsAssertBareName "$memberName" "<team-member>" member-comms-slack-edit-message || { set +e ; return 1 ; }
			case "$memberName" in
				routine-*)
					## Same routine-* carve-out as the sibling arms.
				;;
				*)
					if [ ! -d "$HOME/.claude/skills/$memberName" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-edit-message: no such member skill directory: $HOME/.claude/skills/$memberName" >&2
						set +e ; return 1
					fi
				;;
			esac
			local target="$1"
			shift || true

			if [ -z "$target" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-edit-message: syntax is <team-member> <channel>:<ts> [--identity-bot] [text...] -- or --from-stdin / --from-file <path>. <channel>:<ts> only, same target grammar as --member-comms-slack-delete-message (no magic-team/human-owner shortcut, since an edit replaces one exact message, not a channel)" >&2
				set +e ; return 1
			fi

			local identityAsBot="false" fromStdin="false"
			local textArgs stdinContent
			while [ $# -gt 0 ] ; do
				case "$1" in
					--identity-bot)
						identityAsBot="true" ; shift
					;;
					--message-from-stdin|--from-stdin)
						fromStdin="true" ; shift
					;;
					--from-file)
						if [ -z "$2" ] || [ ! -f "$2" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-edit-message: --from-file: file not found: $2" >&2
							set +e ; return 1
						fi
						stdinContent="$( cat "$2" )"
						fromStdin="true"
						shift 2
					;;
					--*)
						echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-edit-message: unrecognized option: $1 (if you need literal text starting with '--', use --from-stdin/--from-file instead of trailing argv)" >&2
						set +e ; return 1
					;;
					*)
						textArgs="$textArgs $1" ; shift
					;;
				esac
			done

			local sourceText
			if [ "$fromStdin" = "true" ] ; then
				[ -n "$stdinContent" ] || stdinContent="$( cat )"
				sourceText="$stdinContent"
			else
				sourceText="${textArgs# }"
			fi
			if [ -z "$sourceText" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-edit-message: no replacement text given -- chat.update with an empty text field blanks the message, so an empty edit is refused here rather than performed silently. Pass the text as trailing argv, --from-stdin, or --from-file <path>." >&2
				set +e ; return 1
			fi

			local resolved rc channel threadTs
			resolved="$( DistroAgentsToolsResolveTarget "$target" )" && rc=0 || rc=$?
			case "$rc" in
				0)
					channel="$( printf '%s\n' "$resolved" | sed -n 's/^CHANNEL=//p' )"
					local targetUserId=""
					targetUserId="$( printf '%s\n' "$resolved" | sed -n 's/^USER_ID=//p' )" || targetUserId=""
					threadTs="$( printf '%s\n' "$resolved" | sed -n 's/^THREAD_TS=//p' )"
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-edit-message: could not resolve target '$target' -- pass <channel>:<ts>" >&2
					set +e ; return 1
				;;
			esac
			if [ -z "$threadTs" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-edit-message: a specific <ts> is required -- use <channel>:<ts>" >&2
				set +e ; return 1
			fi

			local opArgs=( "$memberName" --api chat.update --resolve-target "$channel" --form "ts=$threadTs" --form "text=$sourceText" )
			if [ "$identityAsBot" = "true" ] ; then
				opArgs+=( --identity bot )
			fi
			opArgs+=( --context "--member-comms-slack-edit-message" )

			local diagFile
			diagFile="$( mktemp )" || { set +e ; return 1 ; }
			chmod 600 "$diagFile"
			trap 'rm -f "$diagFile"' EXIT

			echo "# $MDSC_CMD --member-comms-slack-edit-message: chat.update channel=$channel ts=$threadTs (acting member $memberName)" >&2
			local response callRc=0
			response="$( DistroAgentsTools --intern-op-slack-call "${opArgs[@]}" 2>"$diagFile" )" || callRc=$?

			local diag
			diag="$( cat "$diagFile" )"
			rm -f "$diagFile"
			trap - EXIT
			[ -z "$diag" ] || printf '%s\n' "$diag" >&2

			if [ "$callRc" != "0" ] ; then
				local actingIdentity=""
				actingIdentity="$( printf '%s\n' "$diag" | LC_ALL=C sed -n 's/^ACTING_IDENTITY=//p' | head -1 )"
				local actingIdentityText="the identity this call ran under (named in the op's own diagnostic above)"
				case "$actingIdentity" in
					bot|user)
						actingIdentityText="the $actingIdentity identity"
					;;
					not-yet-selected)
						actingIdentityText="no identity at all -- the call failed before one was selected"
					;;
				esac
				case "$diag" in
					*cant_update_message*|*message_not_found*)
						## STATE 2 of 3, refused-on-authorship.
						echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-edit-message: REFUSED FOR $channel:$threadTs -- Slack permits editing only a message the acting identity itself authored, and this call acted as $memberName under $actingIdentityText. The message was NOT edited and its text is unchanged. Slack's own code is in the diagnostic above: cant_update_message means the message exists and belongs to a different identity; message_not_found means this identity cannot see a message with that ts at all (wrong ts, deleted message, or once again another identity's message). Retrying under the other identity is deliberately NOT attempted -- substituting an identity to make a mutating call succeed is the silent degrade this op family forbids. Decide which identity should own this edit and ask for it explicitly with --identity-bot." >&2
					;;
					*)
						## STATE 3 of 3, could-not-call.
						echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-edit-message: COULD NOT EDIT $channel:$threadTs -- the call did not complete (see the op's own diagnostic above). This is NOT an authorship refusal: nothing is known from this result about who authored that message, and its text was not changed." >&2
					;;
				esac
				set +e ; return 1
			fi

			printf '%s\n' "$response"
			return 0
		;;

		--member-comms-slack-file-info)
			shift
			if [ "$1" = "--print-required-scopes" ] ; then
				printf '%s\n' files:read
				return 0
			fi
			local memberName="$1"
			shift || true
			if [ -z "$memberName" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-info: syntax is <team-member> <file-id> [--identity-bot] [--raw] -- the acting member is required, since a file lives in a conversation and the identity asking decides whether it is visible at all" >&2
				set +e ; return 1
			fi
			AgentsToolsAssertBareName "$memberName" "<team-member>" member-comms-slack-file-info || { set +e ; return 1 ; }
			case "$memberName" in
				routine-*)
					## Same routine-* carve-out as the sibling arms.
				;;
				*)
					if [ ! -d "$HOME/.claude/skills/$memberName" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-info: no such member skill directory: $HOME/.claude/skills/$memberName" >&2
						set +e ; return 1
					fi
				;;
			esac
			local fileId="$1"
			shift || true

			if [ -z "$fileId" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-info: syntax is <team-member> <file-id> [--identity-bot] [--raw] -- a Slack file id (F...), not a URL, a filename or a message ts. This op reports metadata ABOUT a file and never retrieves its content." >&2
				set +e ; return 1
			fi

			if ! printf '%s\n' "$fileId" | LC_ALL=C grep -qE '^F[A-Z0-9][A-Z0-9]*$' ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-info: '$fileId' is not a Slack file id -- expected F followed by uppercase letters and digits (e.g. FXXXXXXXXXX). Nothing was called. If this came out of a message payload, take the file object's own \`id\` field; a permalink, a filename or a <channel>:<ts> pair is not it." >&2
				set +e ; return 1
			fi

			local identityAsBot="false" rawOutput="false"
			while [ $# -gt 0 ] ; do
				case "$1" in
					--identity-bot)
						identityAsBot="true" ; shift
					;;
					--raw)
						rawOutput="true" ; shift
					;;
					*)
						echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-info: invalid option: $1" >&2
						set +e ; return 1
					;;
				esac
			done

			local opArgs=( "$memberName" --api files.info --form "file=$fileId" )
			if [ "$identityAsBot" = "true" ] ; then
				opArgs+=( --identity bot )
			fi
			opArgs+=( --context "--member-comms-slack-file-info" )

			local diagFile
			diagFile="$( mktemp )" || { set +e ; return 1 ; }
			chmod 600 "$diagFile"
			trap 'rm -f "$diagFile"' EXIT

			echo "# $MDSC_CMD --member-comms-slack-file-info: GET files.info file=$fileId (metadata only -- no file content is retrieved by this op, acting member $memberName)" >&2
			local response callRc=0
			response="$( DistroAgentsTools --intern-op-slack-call "${opArgs[@]}" 2>"$diagFile" )" || callRc=$?

			local diag
			diag="$( cat "$diagFile" )"
			rm -f "$diagFile"
			trap - EXIT
			[ -z "$diag" ] || printf '%s\n' "$diag" >&2

			if [ "$callRc" != "0" ] ; then
				local actingIdentity=""
				actingIdentity="$( printf '%s\n' "$diag" | LC_ALL=C sed -n 's/^ACTING_IDENTITY=//p' | head -1 )"
				local actingIdentityText="the identity this call ran under (named in the op's own diagnostic above)"
				case "$actingIdentity" in
					bot|user)
						actingIdentityText="the $actingIdentity identity"
					;;
					not-yet-selected)
						actingIdentityText="no identity at all -- the call failed before one was selected"
					;;
				esac

				local rawResponseState="" failBody="" failError="" failErrorRc=0
				rawResponseState="$( printf '%s\n' "$diag" | LC_ALL=C sed -n 's/^RESPONSE_BODY_STATE=//p' | head -1 )"
				if [ "$rawResponseState" = "in-diagnostic" ] ; then
					failBody="$( printf '%s\n' "$diag" | LC_ALL=C sed -n 's/^RESPONSE_BODY=//p' | head -1 )"
					failError="$( printf '%s\n' "$failBody" | LC_ALL=C awk -v path=error -v optional=1 \
						-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsSlackJsonField.awk" )" || failErrorRc=$?
				fi

				if [ "$failErrorRc" = "0" ] ; then
					case "$failError" in
						file_not_found)
							echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-info: NO METADATA FOR $fileId -- Slack answered file_not_found under $actingIdentityText. Slack returns this one code for two different situations and does not tell them apart: either no file has that id at all, or a file does and this identity cannot see it (it lives in a conversation this identity is not in). The other identity may well see it -- ask for it explicitly with --identity-bot; this op deliberately does not retry under it by itself. Nothing was fetched and nothing about the file's content is known." >&2
							set +e ; return 3
						;;
						file_deleted)
							echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-info: FILE DELETED -- $fileId existed and has been deleted, reported by Slack as file_deleted under $actingIdentityText. This is NOT a visibility problem and NOT a wrong id: no identity can read this file's metadata or content, and retrying under --identity-bot would change nothing." >&2
							set +e ; return 4
						;;
					esac
				fi

				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-info: COULD NOT READ METADATA FOR $fileId -- the call did not complete under $actingIdentityText (see the op's own diagnostic above, which carries Slack's own error code). This is NOT an absence result: nothing is known from this call about whether that file exists, whether it is deleted, or whether this identity can see it." >&2
				set +e ; return 1
			fi

			if [ "$rawOutput" = "true" ] ; then
				printf '%s\n' "$response"
				return 0
			fi

			local parseProbeRc=0
			printf '%s\n' "$response" | LC_ALL=C awk -v path=ok \
				-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsSlackJsonField.awk" >/dev/null || parseProbeRc=$?
			if [ "$parseProbeRc" != "0" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-info: COULD NOT PARSE THE files.info RESPONSE for $fileId (field reader rc=$parseProbeRc; its own one-line reason is above). Slack reported this call as successful, so this is a malformed, truncated or non-JSON body rather than an API refusal. NO metadata was emitted -- nothing at all was printed on stdout -- and nothing is known from this call about the file. Use --raw to see the body as it arrived." >&2
				set +e ; return 1
			fi

			printf '%s\n' FILE_INFO_STATE=found
			local fieldSpec fieldRc=0
			for fieldSpec in \
				"FILE_ID file.id" \
				"NAME file.name" \
				"TITLE file.title" \
				"MIMETYPE file.mimetype" \
				"FILETYPE file.filetype" \
				"SIZE file.size" \
				"TIMESTAMP file.timestamp" \
				"AUTHOR_USER_ID file.user" \
				"URL_PRIVATE file.url_private" \
				"URL_PRIVATE_DOWNLOAD file.url_private_download" \
				"THUMB_64 file.thumb_64" \
				"THUMB_80 file.thumb_80" \
				"THUMB_160 file.thumb_160" \
				"THUMB_360 file.thumb_360" \
				"THUMB_480 file.thumb_480" \
				"THUMB_720 file.thumb_720" \
				"THUMB_800 file.thumb_800" \
				"THUMB_960 file.thumb_960" \
				"THUMB_1024 file.thumb_1024" \
			; do
				AgentsToolsCommsSlackFileInfoEmitField $fieldSpec "$response" || { fieldRc=$? ; break ; }
			done
			if [ "$fieldRc" != "0" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-info: the field set above for $fileId is INCOMPLETE -- a field could not be read out of the files.info response (see the emitter's own error above) and the remaining fields were not attempted. Do not treat the lines already printed as a full metadata set." >&2
				set +e ; return 1
			fi
			return 0
		;;

		--member-comms-slack-file-fetch)
			shift
			if [ "$1" = "--print-required-scopes" ] ; then
				printf '%s\n' files:read
				return 0
			fi
			local memberName="$1"
			shift || true
			if [ -z "$memberName" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-fetch: syntax is <team-member> <file-id> <destination-path> [--identity-bot] [--overwrite] -- the acting member is required, since a file lives in a conversation and the identity fetching decides whether its bytes are reachable at all" >&2
				set +e ; return 1
			fi
			AgentsToolsAssertBareName "$memberName" "<team-member>" member-comms-slack-file-fetch || { set +e ; return 1 ; }
			case "$memberName" in
				routine-*)
					## Same routine-* carve-out as the sibling arms.
				;;
				*)
					if [ ! -d "$HOME/.claude/skills/$memberName" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-fetch: no such member skill directory: $HOME/.claude/skills/$memberName" >&2
						set +e ; return 1
					fi
				;;
			esac
			local fetchFileId="$1"
			shift || true
			local fetchDest="$1"
			shift || true

			if [ -z "$fetchFileId" ] || [ -z "$fetchDest" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-fetch: syntax is <team-member> <file-id> <destination-path> [--identity-bot] [--overwrite] -- ALL THREE are required. The destination is always named by the caller: this op has no default location and will not invent one. To decide whether a file is worth fetching at all, ask --member-comms-slack-file-info first." >&2
				set +e ; return 1
			fi

			if ! printf '%s\n' "$fetchFileId" | LC_ALL=C grep -qE '^F[A-Z0-9][A-Z0-9]*$' ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-fetch: '$fetchFileId' is not a Slack file id -- expected F followed by uppercase letters and digits (e.g. FXXXXXXXXXX). Nothing was called and nothing was written. If this came out of a message payload, take the file object's own \`id\` field." >&2
				set +e ; return 1
			fi

			local fetchAsBot="false" fetchOverwrite="false"
			while [ $# -gt 0 ] ; do
				case "$1" in
					--identity-bot)
						fetchAsBot="true" ; shift
					;;
					--overwrite)
						fetchOverwrite="true" ; shift
					;;
					*)
						echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-fetch: invalid option: $1" >&2
						set +e ; return 1
					;;
				esac
			done

			case "/$fetchDest/" in
				*/.agents/*)
					echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-fetch: refusing '$fetchDest' as a destination -- it is inside the credential store, which is never written to, read from or listed by any operation. Nothing was called. Choose a destination outside it." >&2
					set +e ; return 1
				;;
			esac

			local fetchDestDir="" fetchDestBase="" fetchDestDirAbs=""
			fetchDestDir="$( dirname "$fetchDest" )"
			fetchDestBase="$( basename "$fetchDest" )"
			fetchDestDirAbs="$( cd "$fetchDestDir" 2>/dev/null && pwd -P )" || fetchDestDirAbs=""
			if [ -z "$fetchDestDirAbs" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-fetch: the destination directory '$fetchDestDir' does not exist or cannot be entered. Nothing was called. This op writes a file; it does not create the directory tree above it." >&2
				set +e ; return 1
			fi
			case "$fetchDestDirAbs/" in
				*/.agents/*)
					echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-fetch: refusing '$fetchDest' as a destination -- it resolves to '$fetchDestDirAbs', which is inside the credential store. Nothing was called." >&2
					set +e ; return 1
				;;
			esac
			local fetchDestAbs="$fetchDestDirAbs/$fetchDestBase"

			if [ -d "$fetchDestAbs" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-fetch: '$fetchDestAbs' is a directory, not a file. Nothing was called. Name the file to write, including its filename." >&2
				set +e ; return 1
			fi
			if [ -e "$fetchDestAbs" ] && [ "$fetchOverwrite" != "true" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-fetch: '$fetchDestAbs' already exists and was left exactly as it is. Nothing was called. Pass --overwrite to replace it, or name a different destination -- this op does not overwrite by default." >&2
				set +e ; return 1
			fi

			local infoOut="" infoRc=0 infoDiagFile=""
			infoDiagFile="$( mktemp )" || { set +e ; return 1 ; }
			chmod 600 "$infoDiagFile"
			trap 'rm -f "$infoDiagFile"' EXIT

			local infoIdentityArgs=()
			if [ "$fetchAsBot" = "true" ] ; then
				infoIdentityArgs+=( --identity-bot )
			fi

			echo "# $MDSC_CMD --member-comms-slack-file-fetch: reading metadata for $fetchFileId before fetching (expected size and type come from there)" >&2
			infoOut="$( DistroAgentsTools --member-comms-slack-file-info "$memberName" "$fetchFileId" "${infoIdentityArgs[@]}" 2>"$infoDiagFile" )" || infoRc=$?
			local infoDiag=""
			infoDiag="$( cat "$infoDiagFile" )"
			rm -f "$infoDiagFile"
			trap - EXIT
			[ -z "$infoDiag" ] || printf '%s\n' "$infoDiag" >&2

			case "$infoRc" in
				0) ;;
				3)
					echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-fetch: NOT FETCHED -- $fetchFileId could not be read (file_not_found; the metadata op's own explanation of the two situations that produce it is above). No fetch was attempted and '$fetchDestAbs' was not created or modified." >&2
					set +e ; return 3
				;;
				4)
					echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-fetch: NOT FETCHED -- $fetchFileId has been deleted (file_deleted). There are no bytes to retrieve under any identity. '$fetchDestAbs' was not created or modified." >&2
					set +e ; return 4
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-fetch: NOT FETCHED -- the metadata read for $fetchFileId did not complete (see its own diagnostic above). This is NOT an absence result: nothing is known about whether the file exists. '$fetchDestAbs' was not created or modified." >&2
					set +e ; return 1
				;;
			esac

			local infoSizeState="" infoSize="" infoName="" infoMimetype=""
			local infoUrlDownloadState="" infoUrlDownload="" infoUrlPrivateState="" infoUrlPrivate=""
			infoSizeState="$( printf '%s\n' "$infoOut" | LC_ALL=C sed -n 's/^SIZE_STATE=//p' | head -1 )"
			infoSize="$( printf '%s\n' "$infoOut" | LC_ALL=C sed -n 's/^SIZE=//p' | head -1 )"
			infoName="$( printf '%s\n' "$infoOut" | LC_ALL=C sed -n 's/^NAME=//p' | head -1 )"
			infoMimetype="$( printf '%s\n' "$infoOut" | LC_ALL=C sed -n 's/^MIMETYPE=//p' | head -1 )"
			infoUrlDownloadState="$( printf '%s\n' "$infoOut" | LC_ALL=C sed -n 's/^URL_PRIVATE_DOWNLOAD_STATE=//p' | head -1 )"
			infoUrlDownload="$( printf '%s\n' "$infoOut" | LC_ALL=C sed -n 's/^URL_PRIVATE_DOWNLOAD=//p' | head -1 )"
			infoUrlPrivateState="$( printf '%s\n' "$infoOut" | LC_ALL=C sed -n 's/^URL_PRIVATE_STATE=//p' | head -1 )"
			infoUrlPrivate="$( printf '%s\n' "$infoOut" | LC_ALL=C sed -n 's/^URL_PRIVATE=//p' | head -1 )"

			local fetchUrlChosen="" fetchUrlWhich=""
			if [ "$infoUrlDownloadState" = "present" ] && [ -n "$infoUrlDownload" ] ; then
				fetchUrlChosen="$infoUrlDownload" ; fetchUrlWhich="url_private_download"
			elif [ "$infoUrlPrivateState" = "present" ] && [ -n "$infoUrlPrivate" ] ; then
				fetchUrlChosen="$infoUrlPrivate" ; fetchUrlWhich="url_private (fallback -- this file object carries no url_private_download)"
			else
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-fetch: NOT FETCHED -- files.info reported $fetchFileId but carried neither url_private_download nor url_private, so there is no address to retrieve the bytes from. This is a metadata shape this op does not know how to fetch, NOT a missing or deleted file. '$fetchDestAbs' was not created or modified." >&2
				set +e ; return 1
			fi

			if [ "$infoSizeState" != "present" ] || ! printf '%s\n' "$infoSize" | LC_ALL=C grep -qE '^[0-9][0-9]*$' ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-fetch: NOT FETCHED -- files.info did not report a usable byte size for $fetchFileId (SIZE_STATE='$infoSizeState', SIZE='$infoSize'). The fetch was NOT attempted: without the expected size there is no way to tell a complete file from a truncated one or from a sign-in page, and this op does not fetch what it cannot verify. '$fetchDestAbs' was not created or modified." >&2
				set +e ; return 1
			fi

			local fetchTmp=""
			fetchTmp="$( mktemp "$fetchDestDirAbs/.$fetchDestBase.fetch.XXXXXX" )" || {
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-fetch: could not create a temporary file in '$fetchDestDirAbs'. Nothing was fetched and '$fetchDestAbs' was not created or modified." >&2
				set +e ; return 1
			}
			chmod 600 "$fetchTmp"

			local fetchDiagFile=""
			fetchDiagFile="$( mktemp )" || { rm -f "$fetchTmp" ; set +e ; return 1 ; }
			chmod 600 "$fetchDiagFile"
			trap 'rm -f "$fetchDiagFile" "$fetchTmp"' EXIT

			local fetchOpArgs=( "$memberName" --fetch-url "$fetchUrlChosen" --fetch-to "$fetchTmp" )
			if [ "$fetchAsBot" = "true" ] ; then
				fetchOpArgs+=( --identity bot )
			fi
			fetchOpArgs+=( --context "--member-comms-slack-file-fetch" )

			echo "# $MDSC_CMD --member-comms-slack-file-fetch: GET $fetchUrlWhich for $fetchFileId (${infoName:-<no name>}, ${infoMimetype:-<no mimetype>}, expecting $infoSize bytes, acting member $memberName)" >&2
			local fetchCallRc=0
			DistroAgentsTools --intern-op-slack-call "${fetchOpArgs[@]}" 2>"$fetchDiagFile" || fetchCallRc=$?

			local fetchDiag=""
			fetchDiag="$( cat "$fetchDiagFile" )"
			rm -f "$fetchDiagFile"
			[ -z "$fetchDiag" ] || printf '%s\n' "$fetchDiag" >&2

			if [ "$fetchCallRc" != "0" ] ; then
				rm -f "$fetchTmp"
				trap - EXIT
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-fetch: NOT FETCHED -- the authenticated GET for $fetchFileId did not complete (see the op's own diagnostic above, which carries the HTTP status it saw). Whatever arrived was discarded with the temporary file, and '$fetchDestAbs' was not created or modified." >&2
				set +e ; return 1
			fi

			local fetchContentType=""
			fetchContentType="$( printf '%s\n' "$fetchDiag" | LC_ALL=C sed -n 's/^FETCH_CONTENT_TYPE=//p' | head -1 )"

			case "$fetchContentType" in
				text/html*)
					rm -f "$fetchTmp"
					trap - EXIT
					echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-fetch: NOT THE FILE -- the fetch of $fetchFileId returned HTTP 200 but the server sent Content-Type '$fetchContentType', which is a WEB PAGE and not $fetchFileId's content (files.info reports it as '${infoMimetype:-<no mimetype>}'). This is Slack's sign-in page: the request reached Slack but was not accepted as authenticated for this file, which answers 200 with a login form rather than an error. A 200 is NOT evidence the bytes are the file. Nothing was written to '$fetchDestAbs'." >&2
					set +e ; return 1
				;;
			esac

			if LC_ALL=C head -c 1024 "$fetchTmp" | LC_ALL=C tr -d '\000' | LC_ALL=C grep -qiE '<!doctype[[:space:]]+html|<html[[:space:]>]' ; then
				rm -f "$fetchTmp"
				trap - EXIT
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-fetch: NOT THE FILE -- the fetch of $fetchFileId returned HTTP 200 and Content-Type '$fetchContentType', but the bytes themselves begin as an HTML document. This is Slack's sign-in page wearing the right content type: an unauthenticated or under-scoped fetch of a url_private is answered with a login form at HTTP 200, and only reading the bytes catches it. files.info reports this file as '${infoMimetype:-<no mimetype>}'. Nothing was written to '$fetchDestAbs'." >&2
				set +e ; return 1
			fi

			local fetchActualBytes=""
			fetchActualBytes="$( wc -c < "$fetchTmp" | tr -d '[:space:]' )"
			if [ "$fetchActualBytes" -ne "$infoSize" ] ; then
				rm -f "$fetchTmp"
				trap - EXIT
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-fetch: NOT THE FILE -- the fetch of $fetchFileId returned HTTP 200 and $fetchActualBytes bytes, but files.info reports this file as $infoSize bytes. The sizes must match EXACTLY: a short body is a truncated or interrupted transfer, and a body of any other length is not this file's content at all. Nothing was written to '$fetchDestAbs'." >&2
				set +e ; return 1
			fi

			if ! mv -f "$fetchTmp" "$fetchDestAbs" ; then
				rm -f "$fetchTmp"
				trap - EXIT
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-fetch: the fetch of $fetchFileId succeeded and passed every check, but the verified result could not be moved into place at '$fetchDestAbs'. The temporary file has been removed; the destination was not modified." >&2
				set +e ; return 1
			fi
			trap - EXIT
			chmod 600 "$fetchDestAbs"

			printf '%s\n' FETCH_STATE=fetched
			printf 'FILE_ID=%s\n' "$fetchFileId"
			printf 'DESTINATION=%s\n' "$fetchDestAbs"
			printf 'VERIFIED_BYTES=%s\n' "$fetchActualBytes"
			printf 'MIMETYPE=%s\n' "$infoMimetype"
			printf 'SOURCE_URL_KIND=%s\n' "$fetchUrlWhich"
			return 0
		;;

		--member-comms-slack-file-share)
			shift
			if [ "$1" = "--print-required-scopes" ] ; then
				printf '%s\n' files:write chat:write im:write channels:read im:read
				return 0
			fi
			local memberName="$1"
			shift || true
			if [ -z "$memberName" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-share: syntax is <team-member> <target> (--from-file <path>|--from-stdin) [--snippet-type <v>] [--title <v>] [--comment <text>] [--identity-bot]" >&2
				set +e ; return 1
			fi
			AgentsToolsAssertBareName "$memberName" "<team-member>" member-comms-slack-file-share || { set +e ; return 1 ; }
			case "$memberName" in
				routine-*)
					## Same routine-* carve-out as the sibling arms.
				;;
				*)
					if [ ! -d "$HOME/.claude/skills/$memberName" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-share: no such member skill directory: $HOME/.claude/skills/$memberName" >&2
						set +e ; return 1
					fi
				;;
			esac

			local shareTarget="$1"
			shift || true
			if [ -z "$shareTarget" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-share: a <target> is required -- a share needs a conversation to land in." >&2
				set +e ; return 1
			fi

			local shareFromFile="" shareFromStdin="false" shareSnippetType="" shareTitle="" shareComment="" shareCommentGiven="false" shareAsBot="false"
			while [ $# -gt 0 ] ; do
				case "$1" in
					--from-file)
						if [ -z "${2:-}" ] || [ ! -f "$2" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-share: --from-file: file not found: ${2:-<no value>}" >&2
							set +e ; return 1
						fi
						shareFromFile="$2" ; shift 2
					;;
					--from-stdin)
						shareFromStdin="true" ; shift
					;;
					--snippet-type)
						if [ -z "${2:-}" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-share: --snippet-type: value required" >&2
							set +e ; return 1
						fi
						shareSnippetType="$2" ; shift 2
					;;
					--title)
						if [ -z "${2:-}" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-share: --title: value required" >&2
							set +e ; return 1
						fi
						shareTitle="$2" ; shift 2
					;;
					--comment)
						if [ -z "${2:-}" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-share: --comment: value required" >&2
							set +e ; return 1
						fi
						shareComment="$2" ; shareCommentGiven="true" ; shift 2
					;;
					--identity-bot)
						shareAsBot="true" ; shift
					;;
					*)
						echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-share: unrecognized option: $1" >&2
						set +e ; return 1
					;;
				esac
			done

			if [ "$shareFromStdin" = "true" ] && [ -n "$shareFromFile" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-share: --from-file and --from-stdin name two different bodies and there is no rule for which wins. Pass exactly one -- the same refusal --member-comms-slack-send-message makes." >&2
				set +e ; return 1
			fi
			if [ "$shareFromStdin" = "false" ] && [ -z "$shareFromFile" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-share: one of --from-file <path> or --from-stdin is required -- this call names no content to share." >&2
				set +e ; return 1
			fi

			## TARGET FIRST, UPLOAD SECOND. An unresolvable target costs no upload,
			## so a failed target never leaves a file behind.
			local shareResolved="" shareResolveRc=0 shareChannel="" shareThreadTs=""
			shareResolved="$( DistroAgentsToolsResolveTarget "$shareTarget" )" || shareResolveRc=$?
			case "$shareResolveRc" in
				0)
					shareChannel="$( printf '%s\n' "$shareResolved" | sed -n 's/^CHANNEL=//p' )"
					shareThreadTs="$( printf '%s\n' "$shareResolved" | sed -n 's/^THREAD_TS=//p' )"
				;;
				2)
					echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-share: unrecognized target: $shareTarget -- nothing was uploaded." >&2
					set +e ; return 1
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-share: could not resolve a channel for target '$shareTarget' -- nothing was uploaded." >&2
					set +e ; return 1
				;;
			esac

			local shareDiagFile=""
			shareDiagFile="$( mktemp )" || { set +e ; return 1 ; }
			chmod 600 "$shareDiagFile"

			local shareStdinFile=""

			local shareInfoArgs=( "$memberName" --api conversations.info --resolve-target "$shareChannel" )
			[ "$shareAsBot" = "false" ] || shareInfoArgs+=( --identity bot )
			shareInfoArgs+=( --context "--member-comms-slack-file-share" )
			local shareInfoResp="" shareInfoRc=0
			shareInfoResp="$( DistroAgentsTools --intern-op-slack-call "${shareInfoArgs[@]}" 2>"$shareDiagFile" )" || shareInfoRc=$?
			cat "$shareDiagFile" >&2
			if [ "$shareInfoRc" != "0" ] ; then
				rm -f "$shareDiagFile"
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-share: could not resolve target '$shareTarget' to a conversation (see the op's own diagnostic above) -- nothing was uploaded." >&2
				set +e ; return 1
			fi
			local shareConversation="" shareConvRc=0
			shareConversation="$( printf '%s\n' "$shareInfoResp" | LC_ALL=C awk -v path=channel.id -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsSlackJsonField.awk" )" || shareConvRc=$?
			if [ "$shareConvRc" != "0" ] || [ -z "$shareConversation" ] ; then
				rm -f "$shareDiagFile"
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-share: the conversation lookup for '$shareTarget' returned no usable channel.id (field reader rc=$shareConvRc -- 3: that path is absent, 1: the body was not a parseable API response) -- nothing was uploaded." >&2
				set +e ; return 1
			fi

			local shareParentTs="$shareThreadTs"
			if [ -n "$shareThreadTs" ] ; then
				local shareRepliesArgs=( "$memberName" --api conversations.replies --form "channel=$shareConversation" --form "ts=$shareThreadTs" --form limit=1 )
				[ "$shareAsBot" = "false" ] || shareRepliesArgs+=( --identity bot )
				shareRepliesArgs+=( --context "--member-comms-slack-file-share" )
				local shareRepliesResp="" shareRepliesRc=0
				shareRepliesResp="$( DistroAgentsTools --intern-op-slack-call "${shareRepliesArgs[@]}" 2>"$shareDiagFile" )" || shareRepliesRc=$?
				cat "$shareDiagFile" >&2
				if [ "$shareRepliesRc" != "0" ] ; then
					rm -f "$shareDiagFile"
					echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-share: could not read the thread at $shareThreadTs to find its parent (see the op's own diagnostic above) -- nothing was uploaded. A share is anchored to a thread's parent, and this call could not establish one." >&2
					set +e ; return 1
				fi
				local shareFoundParent="" shareParentRc=0
				shareFoundParent="$( printf '%s\n' "$shareRepliesResp" | LC_ALL=C awk -v path=messages.0.thread_ts -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsSlackJsonField.awk" )" || shareParentRc=$?
				case "$shareParentRc" in
					0)
						[ -z "$shareFoundParent" ] || shareParentTs="$shareFoundParent"
					;;
					3)
						## No thread_ts on the first message: it is not in a thread, so
						## it is its own parent and the caller's ts already is one.
					;;
					*)
						rm -f "$shareDiagFile"
						echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-share: the thread read for $shareThreadTs was not a parseable API response (field reader rc=$shareParentRc) -- nothing was uploaded." >&2
						set +e ; return 1
					;;
				esac
			fi

			## --from-stdin is buffered because step 1 needs the byte length up front.
			local shareBodyFile="$shareFromFile"
			if [ "$shareFromStdin" = "true" ] ; then
				shareStdinFile="$( mktemp )" || { rm -f "$shareDiagFile" ; set +e ; return 1 ; }
				chmod 600 "$shareStdinFile"
				cat > "$shareStdinFile"
				shareBodyFile="$shareStdinFile"
			fi

			## BYTES, never characters. A character count sends a wrong length to a
			## pre-signed upload and fails in a way that never names length.
			local shareBytes=""
			shareBytes="$( LC_ALL=C wc -c < "$shareBodyFile" | tr -d '[:space:]' )"
			if [ -z "$shareBytes" ] || [ "$shareBytes" = "0" ] ; then
				rm -f "$shareDiagFile" ; [ -z "$shareStdinFile" ] || rm -f "$shareStdinFile"
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-share: the content is empty -- there is nothing to share." >&2
				set +e ; return 1
			fi

			local shareFilename="$shareTitle"
			if [ -z "$shareFilename" ] ; then
				if [ -n "$shareFromFile" ] ; then
					shareFilename="$( basename "$shareFromFile" )"
				else
					shareFilename="shared-content"
				fi
			fi

			## ---- step 1 of 3: ask for an upload URL ----
			local shareStep1Args=( "$memberName" --api files.getUploadURLExternal --form "filename=$shareFilename" --form "length=$shareBytes" )
			[ -z "$shareSnippetType" ] || shareStep1Args+=( --form "snippet_type=$shareSnippetType" )
			[ "$shareAsBot" = "false" ] || shareStep1Args+=( --identity bot )
			shareStep1Args+=( --context "--member-comms-slack-file-share" )
			local shareStep1Resp="" shareStep1Rc=0
			shareStep1Resp="$( DistroAgentsTools --intern-op-slack-call "${shareStep1Args[@]}" 2>"$shareDiagFile" )" || shareStep1Rc=$?
			cat "$shareDiagFile" >&2
			if [ "$shareStep1Rc" != "0" ] ; then
				rm -f "$shareDiagFile" ; [ -z "$shareStdinFile" ] || rm -f "$shareStdinFile"
				if [ -n "$shareSnippetType" ] ; then
					echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-share: STEP 1 OF 3 FAILED (asking for an upload URL) -- see the op's own diagnostic above. This call passed --snippet-type '$shareSnippetType'; if that value is not one this platform supports, that is what the diagnostic reports. Nothing was uploaded." >&2
				else
					echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-share: STEP 1 OF 3 FAILED (asking for an upload URL) -- see the op's own diagnostic above. Nothing was uploaded." >&2
				fi
				set +e ; return 1
			fi
			local shareUploadUrl="" shareUploadUrlRc=0 shareFileId="" shareFileIdRc=0
			shareUploadUrl="$( printf '%s\n' "$shareStep1Resp" | LC_ALL=C awk -v path=upload_url -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsSlackJsonField.awk" )" || shareUploadUrlRc=$?
			shareFileId="$( printf '%s\n' "$shareStep1Resp" | LC_ALL=C awk -v path=file_id -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsSlackJsonField.awk" )" || shareFileIdRc=$?
			if [ "$shareUploadUrlRc" != "0" ] || [ -z "$shareUploadUrl" ] || [ "$shareFileIdRc" != "0" ] || [ -z "$shareFileId" ] ; then
				rm -f "$shareDiagFile" ; [ -z "$shareStdinFile" ] || rm -f "$shareStdinFile"
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-share: STEP 1 OF 3 answered ok:true but without a usable upload_url and file_id (field reader rc=$shareUploadUrlRc and rc=$shareFileIdRc -- 3: that path is absent, 1: the body was not a parseable API response). The upload URL is not quoted here: it is a bearer capability. Nothing was uploaded." >&2
				set +e ; return 1
			fi

			local shareStep2Rc=0
			DistroAgentsTools --intern-op-url-post-bytes --url "$shareUploadUrl" --body-file "$shareBodyFile" --context "--member-comms-slack-file-share" >/dev/null 2>"$shareDiagFile" || shareStep2Rc=$?
			cat "$shareDiagFile" >&2
			if [ "$shareStep2Rc" != "0" ] ; then
				rm -f "$shareDiagFile" ; [ -z "$shareStdinFile" ] || rm -f "$shareStdinFile"
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-share: STEP 2 OF 3 FAILED (sending the bytes) -- see the op's own POST_HTTP_STATUS and POST_BYTES above. The upload was begun and not completed; Slack abandons an uncompleted upload, so there is nothing to clean up and nothing was shared." >&2
				set +e ; return 1
			fi

			## ---- step 3 of 3: complete the upload into the conversation ----
			local shareTitleForJson="$shareFilename"
			[ -z "$shareTitle" ] || shareTitleForJson="$shareTitle"
			local shareEscapedTitle=""
			shareEscapedTitle="$( printf '%s' "$shareTitleForJson" | LC_ALL=C awk -f "$MYXROOT/include/data/agentMcpJsonEscape.awk" )"
			local shareStep3Args=( "$memberName" --api files.completeUploadExternal --form "files=[{\"id\":\"$shareFileId\",\"title\":\"$shareEscapedTitle\"}]" --form "channel_id=$shareConversation" )
			[ -z "$shareParentTs" ] || shareStep3Args+=( --form "thread_ts=$shareParentTs" )
			[ "$shareAsBot" = "false" ] || shareStep3Args+=( --identity bot )
			shareStep3Args+=( --context "--member-comms-slack-file-share" )
			local shareStep3Resp="" shareStep3Rc=0
			shareStep3Resp="$( DistroAgentsTools --intern-op-slack-call "${shareStep3Args[@]}" 2>"$shareDiagFile" )" || shareStep3Rc=$?
			cat "$shareDiagFile" >&2
			rm -f "$shareDiagFile"
			[ -z "$shareStdinFile" ] || rm -f "$shareStdinFile"
			if [ "$shareStep3Rc" != "0" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-share: STEP 3 OF 3 FAILED (completing the upload into the conversation) -- see the op's own diagnostic above. The bytes were sent but the upload was never completed; Slack abandons an uncompleted upload, so there is nothing to clean up and nothing was shared. THIS IS A FAILURE, not a partial success." >&2
				set +e ; return 1
			fi

			printf '%s\n' "$shareStep3Resp"
			printf 'SHARE_FILE_ID=%s\n' "$shareFileId" >&2
			printf 'SHARE_CONVERSATION=%s\n' "$shareConversation" >&2
			printf 'SHARE_BYTES=%s\n' "$shareBytes" >&2

			if [ "$shareCommentGiven" = "true" ] ; then
				local shareCommentTarget="$shareConversation"
				[ -z "$shareParentTs" ] || shareCommentTarget="$shareConversation:$shareParentTs"
				local shareCommentArgs=( "$memberName" "$shareCommentTarget" )
				[ "$shareAsBot" = "false" ] || shareCommentArgs+=( --identity-bot )
				local shareCommentRc=0
				printf '%s\n' "$shareComment" | DistroAgentsTools --member-comms-slack-send-message "${shareCommentArgs[@]}" --from-stdin >/dev/null || shareCommentRc=$?
				if [ "$shareCommentRc" != "0" ] ; then
					echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-file-share: the file was shared as $shareFileId but its accompanying message could not be posted (see the send op's own diagnostic above). A shared file with no message beside it is a FAILED operation, not a partial success: the material is there and nothing says what it is for. Post the message yourself with --member-comms-slack-send-message against $shareCommentTarget, or delete the file." >&2
					set +e ; return 1
				fi
			fi
			return 0
		;;

	--member-comms-slack-send-message)
		shift
		if [ "$1" = "--print-required-scopes" ] ; then
			printf '%s\n' chat:write users:read channels:read 'channels:join|channels:write' im:write mpim:write
			return 0
		fi
		local memberName="$1"
		shift || true
		if [ -z "$memberName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-send-message: syntax is <team-member> <target> [--identity-bot] [text...] (magic-team|human-owner|event-track|event-alert|<conversation-id>|<channel>:<ts>) -- or --from-stdin / --from-file <path>" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$memberName" "<team-member>" member-comms-slack-send-message || { set +e ; return 1 ; }
		local memberDir="$HOME/.claude/skills/$memberName"
		case "$memberName" in
			routine-*)
			;;
			*)
				if [ ! -d "$memberDir" ] ; then
					echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-send-message: no such member skill directory: $memberDir" >&2
					set +e ; return 1
				fi
			;;
		esac

		local target="$1"
		shift || true

		if [ -z "$target" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-send-message: target required (magic-team|human-owner|event-track|event-alert|<conversation-id>|<channel>:<ts>)" >&2
			set +e ; return 1
		fi

		AgentsToolsEmitRequestDetailHeader "$memberName" "$target"

		local resolved rc channel="" threadTs=""
		resolved="$( DistroAgentsToolsResolveTarget "$target" )" && rc=0 || rc=$?
		case "$rc" in
			0)
				channel="$( printf '%s\n' "$resolved" | sed -n 's/^CHANNEL=//p' )"
				## Unit-2 forward compatibility -- "" until the Unit-3 flip.
				local targetUserId=""
				targetUserId="$( printf '%s\n' "$resolved" | sed -n 's/^USER_ID=//p' )" || targetUserId=""

				if [ -n "$targetUserId" ] ; then
					channel="$targetUserId"
				fi
				threadTs="$( printf '%s\n' "$resolved" | sed -n 's/^THREAD_TS=//p' )"
			;;
			2)
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-send-message: unrecognized target: $target" >&2
				set +e ; return 1
			;;
			*)
				local targetKey=""
				case "${target%%:*}" in
					event-track)	targetKey="SLACK_CHANNEL_EVENT_TRACK" ;;
					event-alert)	targetKey="SLACK_CHANNEL_EVENT_ALERT" ;;
					magic-team)	targetKey="SLACK_CHANNEL_MAGIC_TEAM" ;;
					human-owner)	targetKey="SLACK_CHANNEL_HUMAN_OWNER" ;;
				esac
				if [ -n "$targetKey" ] ; then
					echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-send-message: could not resolve a channel for target '$target' -- check $targetKey in .local/.agents" >&2
				else
					echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-send-message: could not resolve a channel for target '$target' -- it names a conversation directly, so no config key backs it; its channel part is empty" >&2
				fi
				set +e ; return 1
			;;
		esac

		local format="markdown" fromStdin="false" identityAsBot="false"
		local textArgs stdinContent
		local bodySourceKind="argv"
		## The text version of a caller-supplied blocks payload. Not a
		## transcription of their blocks -- what the message SAYS, in text.
		local messageText="" messageTextGiven="false"
		## Addressees, repeatable. WHO THE MESSAGE IS FOR -- deliberately not
		## the operation's own target, which is the conversation it goes TO.
		local addressToList=""
		while [ $# -gt 0 ] ; do
			case "$1" in
				--identity-bot)
					identityAsBot="true" ; shift
				;;
				--message-from-stdin|--from-stdin)
					fromStdin="true" ; bodySourceKind="stdin" ; shift
				;;
				--address-to)
					if [ $# -lt 2 ] || [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-send-message: --address-to requires a value (a team member name, a Slack user id, or a conversation id)" >&2
						set +e ; return 1
					fi
					addressToList="$addressToList $2" ; shift 2
				;;
				--message-text)
					if [ $# -lt 2 ] ; then
						echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-send-message: --message-text requires a value" >&2
						set +e ; return 1
					fi
					messageText="$2" ; messageTextGiven="true" ; shift 2
				;;
				--message-text-from-file)
					if [ -z "$2" ] || [ ! -f "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-send-message: --message-text-from-file: file not found: $2" >&2
						set +e ; return 1
					fi
					messageText="$( cat "$2" )" ; messageTextGiven="true" ; shift 2
				;;
				--from-file)
					if [ -z "$2" ] || [ ! -f "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-send-message: --from-file: file not found: $2" >&2
						set +e ; return 1
					fi
					stdinContent="$( cat "$2" )"
					fromStdin="true"
					bodySourceKind="file"
					shift 2
				;;
				--format)
					format="$2" ; shift 2
				;;
				--*)
					echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-send-message: unrecognized option: $1 (if you need literal text starting with '--', use --from-stdin/--from-file instead of trailing argv)" >&2
					set +e ; return 1
				;;
				*)
					textArgs="$textArgs $1" ; shift
				;;
			esac
		done

		local rawText blocksJson sourceText
		if [ "$fromStdin" = "true" ] ; then
			[ -n "$stdinContent" ] || stdinContent="$( cat )"
			sourceText="$stdinContent"
		else
			sourceText="${textArgs# }"
		fi

		local slackMentionMap=""

		local slackFormatRegistry="markdown|converter|body|argv stdin file
blocks|verbatim|caller|stdin file"

		local formatEntry formatValidSet formatBlocksGen formatTextGen formatBodySources
		formatValidSet="$( printf '%s\n' "$slackFormatRegistry" | LC_ALL=C awk -F'|' 'NF { printf "%s%s", sep, $1 ; sep="|" }' )"
		formatEntry="$( printf '%s\n' "$slackFormatRegistry" | LC_ALL=C awk -F'|' -v want="$format" '$1 == want { print ; exit }' )"

		if [ -z "$formatEntry" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-send-message: unrecognized --format '$format' -- accepted: $formatValidSet" >&2
			set +e ; return 1
		fi
		formatBlocksGen="$( printf '%s\n' "$formatEntry" | LC_ALL=C awk -F'|' '{ print $2 }' )"
		formatTextGen="$( printf '%s\n' "$formatEntry" | LC_ALL=C awk -F'|' '{ print $3 }' )"
		formatBodySources="$( printf '%s\n' "$formatEntry" | LC_ALL=C awk -F'|' '{ print $4 }' )"

		case " $formatBodySources " in
			*" $bodySourceKind "*) ;;
			*)
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-send-message: --format $format does not accept a body from '$bodySourceKind' -- accepted for this format: $formatBodySources (use --from-stdin or --from-file <path>)" >&2
				set +e ; return 1
			;;
		esac

		if [ -z "$sourceText" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-send-message: no text/blocks content given" >&2
			set +e ; return 1
		fi

		local sendIdentity="bot" memberUserToken=""
		memberUserToken="$( DistroAgentsTools --member-config-option "$memberName" --select SLACK_USER_TOKEN 2>/dev/null || true )"

		local routineAuthored="false"
		case "$memberName" in
			routine-*) routineAuthored="true" ;;
		esac

		if [ "$identityAsBot" = "true" ] ; then
			sendIdentity="bot"
		elif [ "$routineAuthored" = "true" ] ; then
			sendIdentity="bot"
		elif [ -n "$memberUserToken" ] ; then
			sendIdentity="user"
		fi

		## human-owner: bot identity is the shared team DM, never single-party -- own token, or relay via magic-coordinator.
		local relayedForMember="false"
		case "$target" in
			human-owner|human-owner:*)
				if [ "$identityAsBot" = "true" ] || [ -z "$memberUserToken" ] ; then
					if [ "$memberName" != "magic-coordinator" ] ; then
						memberUserToken="$( DistroAgentsTools --member-config-option magic-coordinator --select SLACK_USER_TOKEN 2>/dev/null || true )"
						relayedForMember="true"
					fi
					if [ -z "$memberUserToken" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-send-message: no native SLACK_USER_TOKEN for '$memberName', and magic-coordinator (the relay target for a token-less member) has none configured either -- there is no path to human-owner that isn't the team-private shared bot DM. Configure one of the two before this send can succeed." >&2
						set +e ; return 1
					fi
				fi
				sendIdentity="user"
			;;
		esac

		## Who the message is from. Built always -- the identity swap below
		## needs it too -- but prepended only where the Slack account shown
		## is not the member's own: a bot post, or one relayed for them.
		local fromMarks fromMark attributionLine
		fromMarks="$( AgentsToolsCommsSlackMemberMarks "$memberName" )" || fromMarks=$'\t'"$memberName"
		fromMark="${fromMarks%%$'\t'*}"
		attributionLine="From: ${fromMark:+$fromMark }$memberName @${fromMarks#*$'\t'}"

		## Who the message is for. Always present, and always labelled: Slack
		## rewrites the fallback text of a blocks message and flattens its
		## line breaks, so nothing may depend on a line's own position.
		local addressedText="To:" addressedElems="{\"type\":\"text\",\"text\":\"To:\"},"
		local addrWho addrMarks addrMark addrAlias addrSep=" "
		for addrWho in $addressToList ; do
			addressedText="$addressedText$addrSep"
			addressedElems="$addressedElems{\"type\":\"text\",\"text\":\"$addrSep\"},"
			case "$addrWho" in
				U[A-Z0-9][A-Z0-9]*)
					## A real Slack account: the structured element in blocks,
					## the escape form in text. Different forms, same field.
					addressedText="$addressedText<@$addrWho>"
					addressedElems="$addressedElems{\"type\":\"user\",\"user_id\":\"$addrWho\"},"
				;;
				C[A-Z0-9][A-Z0-9]*|D[A-Z0-9][A-Z0-9]*|G[A-Z0-9][A-Z0-9]*)
					addressedText="$addressedText<#$addrWho>"
					addressedElems="$addressedElems{\"type\":\"channel\",\"channel_id\":\"$addrWho\"},"
				;;
				*@*)
					echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-send-message: --address-to '$addrWho': an email addressee is a declared direction that is not built yet. Pass a team member name, a Slack user id, or a conversation id." >&2
					set +e ; return 1
				;;
				*)
					## The name reaches the payload as a JSON string, so it is
					## held to the same bare-name shape as the sender's own.
					AgentsToolsAssertBareName "$addrWho" "--address-to" member-comms-slack-send-message || { set +e ; return 1 ; }
					addrMarks="$( AgentsToolsCommsSlackMemberMarks "$addrWho" )" || {
						echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-send-message: --address-to '$addrWho': no such team member -- expected $HOME/.claude/skills/$addrWho/$addrWho.basic.md" >&2
						set +e ; return 1
					}
					addrMark="${addrMarks%%$'\t'*}" ; addrAlias="${addrMarks#*$'\t'}"
					addressedText="$addressedText${addrMark:+$addrMark }$addrWho @$addrAlias"
					case "$addrMark" in
						:*:)	addressedElems="$addressedElems{\"type\":\"emoji\",\"name\":\"${addrMark//:/}\"},{\"type\":\"text\",\"text\":\" $addrWho @$addrAlias\"}," ;;
						*)	addressedElems="$addressedElems{\"type\":\"text\",\"text\":\"${addrMark:+$addrMark }$addrWho @$addrAlias\"}," ;;
					esac
				;;
			esac
			addrSep="; "
		done
		## No named addressee: the message is for whoever the conversation holds.
		if [ -z "$addressToList" ] ; then
			addressedText="$addressedText @here"
			addressedElems="$addressedElems{\"type\":\"text\",\"text\":\" @here\"},"
		fi


		## ---- blocks generator ----
		case "$formatBlocksGen" in
			converter)
				blocksJson="$( printf '%s\n' "$sourceText" | LC_ALL=C awk -v mentionMap="$slackMentionMap" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsSlackBlocksBuild.awk" )"
			;;
			verbatim)
				blocksJson="$sourceText"
			;;
		esac

		## ---- text generator ----
		case "$formatTextGen" in
			body)
				rawText="$sourceText"
			;;
			caller)
				if [ "$messageTextGiven" = "true" ] ; then
					rawText="$messageText"
				else
					rawText="$( printf '%s' "$sourceText" | python3 "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsSlackBlocksTextVersion.py" )"
					if [ -z "$rawText" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-send-message: --format $format: could not generate a text version from these blocks, and none was supplied. Pass --message-text <text> or --message-text-from-file <path> -- what the message SAYS, in plain text, not a transcription of the blocks." >&2
						set +e ; return 1
					fi
				fi
			;;
		esac

		if [ -n "$blocksJson" ] ; then
			if ! printf '%s' "$blocksJson" | DistroAgentsTools --intern-validate-json ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-send-message: --format $format content failed validate-json (see above)" >&2
				set +e ; return 1
			fi
			local blocksTrimmed
			blocksTrimmed="$( printf '%s' "$blocksJson" | LC_ALL=C awk 'BEGIN{RS="\0"} { gsub(/^[ \t\r\n]+/, ""); gsub(/[ \t\r\n]+$/, ""); printf "%s", $0 }' )"
			case "$blocksTrimmed" in
				'['*']')
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-send-message: --format $format content is valid JSON but not a bare array (must start with '[' and end with ']')" >&2
					set +e ; return 1
				;;
			esac
		fi


		rawText="$addressedText${rawText:+$'\n'$rawText}"
		if [ -n "$blocksJson" ] ; then
			local addressedBlocks="[{\"type\":\"rich_text\",\"elements\":[{\"type\":\"rich_text_section\",\"elements\":[${addressedElems%,}]}]}]"
			if [ "$blocksJson" != "[]" ] ; then
				blocksJson="${addressedBlocks%"]"},${blocksJson#"["}"
			else
				blocksJson="$addressedBlocks"
			fi
		fi

		if [ "$sendIdentity" = "bot" ] || [ "$relayedForMember" = "true" ] ; then
			## text version: the characters that version uses.
			rawText="$attributionLine${rawText:+$'\n'$rawText}"
			## blocks version: the same line, built as the structured element
			## that version uses, then prepended as its own block.
			if [ -n "$blocksJson" ] ; then
				local attributionBlocks
				attributionBlocks="$( printf '%s\n' "$attributionLine" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsSlackBlocksBuild.awk" )"
				if [ -n "$attributionBlocks" ] && [ "$blocksJson" != "[]" ] ; then
					blocksJson="${attributionBlocks%"]"},${blocksJson#"["}"
				elif [ -n "$attributionBlocks" ] ; then
					blocksJson="$attributionBlocks"
				fi
			fi
		fi

		if [ -z "$rawText" ] && [ -z "$blocksJson" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-send-message: no text/blocks content given" >&2
			set +e ; return 1
		fi

		if [ -n "$blocksJson" ] ; then
			local blocksProblems blocksProblemsRc=0
			blocksProblems="$( printf '%s' "$blocksJson" | python3 "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsBlockKitValidate.py" )" || blocksProblemsRc=$?
			if [ "$blocksProblemsRc" != "0" ] || [ -n "$blocksProblems" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-send-message: these blocks are not a payload Slack accepts, so nothing was sent (validator rc=$blocksProblemsRc):" >&2
				printf '%s\n' "$blocksProblems" >&2
				set +e ; return 1
			fi
		fi

		local escapedText
		escapedText="$( printf '%s' "$rawText" | LC_ALL=C awk -f "$MYXROOT/include/data/agentMcpJsonEscape.awk" )"

		local payload="{\"channel\":\"$channel\",\"text\":\"$escapedText\""
		[ -z "$threadTs" ] || payload="$payload,\"thread_ts\":\"$threadTs\""
		[ -z "$blocksJson" ] || payload="$payload,\"blocks\":$blocksJson"
		payload="$payload}"

		local tokenLabel
		if [ "$sendIdentity" = "user" ] ; then
			tokenLabel='SLACK_USER_TOKEN'
		else
			tokenLabel='SLACK_BOT_TOKEN'
		fi

		echo "# $MDSC_CMD --member-comms-slack-send-message: POST https://slack.com/api/chat.postMessage using ${sendIdentity} token for $memberName -H 'Authorization: Bearer \$$tokenLabel' -H 'Content-type: application/json' -d '$payload'" >&2

		local token botTokenSource=""
		if [ "$sendIdentity" = "user" ] ; then
			token="$memberUserToken"
		else
			local botTokenLine=""
			botTokenLine="$( AgentsToolsResolveSlackBotToken "$memberName" )" || botTokenLine=""
			read -r botTokenSource token <<< "$botTokenLine"
		fi
		if [ -z "$token" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-send-message: no usable Slack token configured for $memberName (member SLACK_USER_TOKEN, the member's own SLACK_BOT_TOKEN, or the team's own SLACK_BOT_TOKEN in magic-team scope)" >&2
			set +e ; return 1
		fi

		local headerFile
		headerFile="$( mktemp )" || { set +e ; return 1 ; }
		chmod 600 "$headerFile"
		trap 'rm -f "$headerFile"' EXIT
		printf 'Authorization: Bearer %s\n' "$token" > "$headerFile"

		local authUserId=""
		if [ "$sendIdentity" = "user" ] ; then
			local authResp
			authResp="$( curl -sS --connect-timeout 10 --max-time 120 https://slack.com/api/auth.test -H @"$headerFile" 2>&1 )"
			local authUserIdRc=0
			authUserId="$( printf '%s\n' "$authResp" | LC_ALL=C awk -v path=user_id -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsSlackJsonField.awk" )" || authUserIdRc=$?
			if [ "$authUserIdRc" != "0" ] || [ -z "$authUserId" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-send-message: could not confirm auth.test user_id for $memberName SLACK_USER_TOKEN (user_id reader rc=$authUserIdRc)" >&2
				echo "# Response: $authResp" >&2
				rm -f "$headerFile"
				trap - EXIT
				set +e ; return 1
			fi
		fi

		local response attempt=1 maxAttempts=5 backoff=2 sent="false" joinAttempted="false" identitySwapped="false" permanentVerdict=""
		while [ "$attempt" -le "$maxAttempts" ] ; do
			response="$( curl -sS --connect-timeout 10 --max-time 120 -X POST "https://slack.com/api/chat.postMessage" \
				-H @"$headerFile" \
				-H "Content-type: application/json" \
				-d "$payload" 2>&1 )"
			if printf '%s' "$response" | grep -q '"ok":true' ; then
				sent="true"
				break
			fi
			if [ "$sendIdentity" = "bot" ] && [ "$joinAttempted" = "false" ] && [ -z "$threadTs" ] && printf '%s' "$response" | grep -q '"error":"not_in_channel"' ; then
				joinAttempted="true"
				local joinResponse
				joinResponse="$( curl -sS --connect-timeout 10 --max-time 120 -X POST "https://slack.com/api/conversations.join" \
					-H @"$headerFile" \
					-H "Content-type: application/x-www-form-urlencoded" \
					--data-urlencode "channel=$channel" 2>&1 )"
				echo "# $MDSC_CMD --member-comms-slack-send-message: auto-join attempt for bot token on channel=$channel -- $joinResponse" >&2
				if printf '%s' "$joinResponse" | grep -q '"ok":true' ; then
					continue
				fi
			fi
			## not_in_channel is the same permanent unreachable-conversation verdict as channel_not_found -- no retry clears either.
			if [ "$identitySwapped" = "false" ] && [ "$sendIdentity" = "user" ] && printf '%s' "$response" | grep -qE '"error":"(channel_not_found|not_in_channel)"' ; then
				identitySwapped="true"
				local botToken="" swapTokenLine="" swapTokenSource=""
				swapTokenLine="$( AgentsToolsResolveSlackBotToken "$memberName" )" || swapTokenLine=""
				read -r swapTokenSource botToken <<< "$swapTokenLine"
				if [ -n "$botToken" ] ; then
					botTokenSource="$swapTokenSource"
					sendIdentity="bot"
					token="$botToken"
					printf 'Authorization: Bearer %s\n' "$token" > "$headerFile"
					## Attribution only under the shared bot -- a member's own bot is already itself.
					if [ "$swapTokenSource" = "shared-bot-token" ] ; then
						rawText="$attributionLine${rawText:+$'\n'$rawText}"
						if [ -n "$blocksJson" ] ; then
							local swapBlocks
							swapBlocks="$( printf '%s\n' "$attributionLine" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsSlackBlocksBuild.awk" )"
							[ -z "$swapBlocks" ] || blocksJson="${swapBlocks%"]"},${blocksJson#"["}"
						fi
						escapedText="$( printf '%s' "$rawText" | LC_ALL=C awk -f "$MYXROOT/include/data/agentMcpJsonEscape.awk" )"
						payload="{\"channel\":\"$channel\",\"text\":\"$escapedText\""
						[ -z "$threadTs" ] || payload="$payload,\"thread_ts\":\"$threadTs\""
						[ -z "$blocksJson" ] || payload="$payload,\"blocks\":$blocksJson"
						payload="$payload}"
					fi
					echo "# $MDSC_CMD --member-comms-slack-send-message: the acting user identity cannot reach this conversation, retrying once under bot identity -- $response" >&2
					continue
				fi
			fi
			case "$response" in
				*'"error":"invalid_blocks"'*)
					permanentVerdict="Slack answered and rejected the blocks as invalid"
					echo "# $MDSC_CMD --member-comms-slack-send-message: $permanentVerdict -- not retried, no retry can change a payload -- $response" >&2
					break
				;;
				*'"error":"not_in_channel"'*|*'"error":"channel_not_found"'*|*'"error":"is_archived"'*)
					permanentVerdict="the conversation cannot be reached under $sendIdentity identity"
					echo "# $MDSC_CMD --member-comms-slack-send-message: permanent verdict under $sendIdentity identity and no recovery applies -- not retried -- $response" >&2
					break
				;;
			esac
			echo "# $MDSC_CMD --member-comms-slack-send-message: attempt $attempt/$maxAttempts did not confirm ok:true, retrying in ${backoff}s -- $response" >&2
			sleep "$backoff"
			attempt=$(( attempt + 1 ))
			backoff=$(( backoff * 2 ))
		done

		rm -f "$headerFile"
		trap - EXIT

		if [ "$sent" = "true" ] ; then
			if [ "$sendIdentity" = "user" ] ; then
				local responseMessageUser="" responseMessageUserRc=0
				responseMessageUser="$( printf '%s\n' "$response" | LC_ALL=C awk -v path=message.user -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsSlackJsonField.awk" )" || responseMessageUserRc=$?
				if [ "$responseMessageUserRc" != "0" ] ; then
					echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-send-message: member SLACK_USER_TOKEN send for $memberName could not be confirmed as message.user=$authUserId -- the response carries no readable message.user (reader rc=$responseMessageUserRc), so the control reached no verdict, which is not a pass" >&2
					echo "# Response: $response" >&2
					set +e ; return 1
				fi
				if [ "$responseMessageUser" != "$authUserId" ] ; then
					echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-send-message: member SLACK_USER_TOKEN send for $memberName did not confirm message.user=$authUserId (actual message.user=$responseMessageUser)" >&2
					echo "# Response: $response" >&2
					set +e ; return 1
				fi
			fi
			printf '%s\n' "$response"
			return 0
		fi

		if [ -n "$permanentVerdict" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-send-message: nothing was posted -- $permanentVerdict. Slack answered, so comms are not stuck and no email is sent." >&2
			set +e ; return 1
		fi

		echo "⛔ $MDSC_CMD --member-comms-slack-send-message: Slack did not confirm after $maxAttempts attempts -- notifying by email that Slack comms are stuck" >&2
		local fallbackUser
		fallbackUser="$( DistroAgentsTools --agents-config-option magic-coordinator --select EMAIL_USER )"
		if [ -z "$fallbackUser" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-send-message: no EMAIL_USER configured, cannot notify" >&2
			set +e ; return 1
		fi
		DistroAgentsTools --member-comms-email-send magic-coordinator "$fallbackUser" -- \
			"Slack comms stuck -- message queued for target $target" -- \
			"Slack did not confirm this send after $maxAttempts retries -- comms to Slack appear stuck." "" \
			"Nothing was rerouted to email -- this is a notification only. The" \
			"message below stays queued for Slack and should go out once it" \
			"recovers; retry --member-comms-slack-send-message manually if it doesn't." "" \
			"Team-member: $memberName" "Target: $target" "" \
			"Queued message:" "$rawText" "" \
			"Last Slack error response:" "$response" \
			|| echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-send-message: the notification email failed too" >&2
		echo "⛔ ERROR: $MDSC_CMD --member-comms-slack-send-message: nothing was posted to Slack -- the email is a notification, not a delivery" >&2
		set +e ; return 1
	;;

		*)
			echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
			set +e ; return 1
		;;
esac
