#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.SessionControlStart.include -- how the control thread of a coworking session
## (--intern-session-control, AgentsTools.InternSessionControl.include) is started, and
## started again where it has died. Sourced, never run. Functions only.
##
## ONE FUNCTION STARTS A THREAD, AgentsToolsSessionControlStart, whoever asks: the console
## (--manager-session-control-start), the advance input scan, the main loop, and the spawner
## when it opens a session. It takes the id of the session and nothing of its caller. The
## thread is started detached, as the spawner starts a run that is not waited for
## (AgentsTools.InternOpAgentSpawnProxy.include): a process group of its own, a hangup
## ignored, nothing its starter had open kept open, its input /dev/null and its output the
## log of the thread, control/log of the session's folder; and nothing of a member's
## session in its environment. The function does not wait for it. The lock of the thread is
## the guard against a second one of the same session, so a start is safe to make at any
## time: while a thread lives it starts nothing and answers `alive`, which is no error.
##
## WHICH SESSION NEEDS A THREAD: one that is not finished, by the rows the list of sessions
## reads (AgentsToolsSessionControlJudged): a run of it is alive on this host, or the
## record of a run of this host is still open. Not one that is finished. Not one whose open
## records are all runs of another host, or name no host or no run: nothing here can
## measure those, so a thread would watch them for good and learn nothing. And not one that
## a start its caller waits on opened: that caller watches it for as long as it lasts
## (AgentsToolsSessionControlWaited).
##
## THE CHECK NOW, AgentsToolsSessionControlCheck, is the same for the console's `--all`, the
## advance input scan and each iteration of the main loop: of the measured rows it is
## given, each session that needs a thread and has none alive gets one. It is cheap, and
## may be called often: it reads the rows its caller measured, the pid file of each session
## that needs a thread, the process list for those pids in one call, and it starts nothing
## where a thread lives.
## AND IT STARTS NO STORM. A thread whose shell ends within seconds of its start puts
## itself back, five times in a row at most (AgentsToolsSessionControlAgain). A check that
## started such a thread again at every call would multiply those five by every caller and
## every call. So the check leaves a session alone for agentsSessionControlPauseSeconds
## after the last line of the log of its thread was written. Every start writes a line
## there, this file's own, and so does every put-back and every end of a thread. The three
## callers read that one file, so together they start the thread of one session once in
## that time at most. A start by name, the console's --session-id and the spawner's, is
## made at once: it is one start for one act.
##

type AgentsToolsRegistryProcessesBegan > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.Registries.include"

## For how long the check now leaves a session alone after the last line of the log of its
## thread, in seconds; and for how long the console asks whether a thread it started took
## the lock of its session.
agentsSessionControlPauseSeconds=300
agentsSessionControlHoldSeconds=10

## Which of the sessions given have a control thread that lives now, `<session id> <pid>` a
## line. A thread keeps a pid file and a lock, which is a link, in control/ of the session's
## folder for as long as it lives, each naming it as `<pid> <start>`. It lives while the
## process one of the two names is still that process: the same pid begun at another time is
## another process, and a session with neither has no thread. It is the reading the list of
## sessions shows a thread by (AgentsToolsManagerSessionControls,
## AgentsTools.ManagerSession.include), so what the list calls alive is left alone here. The
## files are read by the shell, and the process list is asked once for all of them.
AgentsToolsSessionControlLive(){ ## -- stdin: session ids, a line each
	local liveSession liveLine livePid liveFrom liveSeen livePairs="" liveNow="" liveNl=$'\n'
	while IFS= read -r liveSession ; do
		case "$liveSession" in ''|-|.|..|*/*|*[[:space:]]*) continue ;; esac
		for liveFrom in pid lock ; do
			liveLine=""
			if [ "$liveFrom" = "pid" ] ; then
				{ IFS= read -r liveLine < "$MMDAPP/.local/agents/sessions/$liveSession/control/pid" ; } 2> /dev/null || :
			elif [ -L "$MMDAPP/.local/agents/sessions/$liveSession/control/lock" ] ; then
				liveLine="$( readlink "$MMDAPP/.local/agents/sessions/$liveSession/control/lock" 2> /dev/null )" || liveLine=""
			fi
			livePid="${liveLine%% *}"
			case "$livePid" in ''|*[!0123456789]*) continue ;; esac
			case "$liveLine" in "$livePid "?*) ;; *) continue ;; esac
			case "$livePairs" in *"$liveSession $liveLine$liveNl"*) continue ;; esac
			livePairs="$livePairs$liveSession $liveLine$liveNl"
		done
	done
	[ -n "$livePairs" ] || return 0
	liveNow="$( printf '%s' "$livePairs" | LC_ALL=C awk '{ print $2 ; }' | AgentsToolsRegistryProcessesBegan )" || liveNow=""
	## One number the system takes for no process id leaves that reading empty: then each by itself.
	if [ -z "$liveNow" ] ; then
		case "${livePairs%"$liveNl"}" in
			*"$liveNl"*) liveNow="$( printf '%s' "$livePairs" | while read -r liveSession livePid liveLine ; do printf '%s\n' "$livePid" | AgentsToolsRegistryProcessesBegan ; done )" || liveNow="" ;;
		esac
	fi
	[ -n "$liveNow" ] || return 0
	liveSeen="$liveNl"
	while read -r liveSession liveLine ; do
		[ -n "$liveSession" ] || continue
		case "$liveSeen" in *"$liveNl$liveSession$liveNl"*) continue ;; esac
		case "$liveNl$liveNow$liveNl" in *"$liveNl$liveLine$liveNl"*) printf '%s %s\n' "$liveSession" "${liveLine%% *}" ; liveSeen="$liveSeen$liveSession$liveNl" ;; esac
	done <<< "$livePairs"
	return 0
}

## WHAT A THREAD THAT DIED LEFT IN A SESSION THAT NEEDS NONE. A thread that ends in order
## takes its pid file and its lock with it. One that was ended the hard way leaves both,
## each naming a process that is no longer that process, and the list of sessions shows a
## session by them as one whose thread is gone. Where the session needs a thread, the next
## start takes the lock over and writes the pid file anew. Where it needs none, nothing
## ever would: so the caller that answers that a session needs none removes them here, and
## the session then reads as one that has no thread. Exactly those two files, and only
## where neither names a thread that lives: each is read first, the process list is asked
## after (AgentsToolsSessionControlLive), and a file is removed only while it still holds
## what was read. A lock that is no link is no lock of a thread, and stays. Nothing else of
## control/ is touched: the log of the thread and the state it kept stay as they are.
## Prints nothing. rc 0 always: a file that cannot be removed stays, and reads as before.
AgentsToolsSessionControlLeftovers(){ ## session id
	local leftSession="${1:-}" leftDir leftPid="" leftLock="" leftNow=""
	case "$leftSession" in ''|-|.|..|*/*|*[[:space:]]*) return 0 ;; esac
	leftDir="$MMDAPP/.local/agents/sessions/$leftSession/control"
	[ -f "$leftDir/pid" ] || [ -L "$leftDir/lock" ] || return 0
	[ ! -f "$leftDir/pid" ] || { IFS= read -r leftPid < "$leftDir/pid" ; } 2> /dev/null || :
	[ ! -L "$leftDir/lock" ] || leftLock="$( readlink "$leftDir/lock" 2> /dev/null )" || leftLock=""
	[ -z "$( printf '%s\n' "$leftSession" | AgentsToolsSessionControlLive )" ] || return 0
	if [ -f "$leftDir/pid" ] ; then
		leftNow=""
		{ IFS= read -r leftNow < "$leftDir/pid" ; } 2> /dev/null || :
		[ "$leftNow" != "$leftPid" ] || rm -f "$leftDir/pid" 2> /dev/null || :
	fi
	if [ -L "$leftDir/lock" ] ; then
		leftNow="$( readlink "$leftDir/lock" 2> /dev/null )" || leftNow=""
		[ "$leftNow" != "$leftLock" ] || rm -f "$leftDir/lock" 2> /dev/null || :
	fi
	return 0
}

## What measured rows of the sessions registry say of each session, a line a session in the
## order the sessions come: `<session id> <word> <hosts>`. `running`: a run of it is alive
## on this host, whatever its record says. `open`: none is, and the record of a run of this
## host is still open. `foreign`: neither, and a record still open is a run of another
## host, whose names follow with a comma between them. `unmeasured`: none of these, and a
## record still open names no host or no run, so that nothing can tell its run alive or
## gone. `finished`: no run is alive and every record is closed. The thread reads its own
## session so too (AgentsToolsSessionControlJudge), but for the fourth word: a record that
## names no host or no run is open for it, since a thread that runs must not call such a
## session finished. The rows are the thirteen words the render prints (measuredRows of
## AgentsToolsRegistryMeasureRows), the last of them a state: any other line is no row, and
## a row with no session id names no session.
AgentsToolsSessionControlJudged(){ ## -- stdin: measured rows
	LC_ALL=C awk '
		NF != 13 || $2 == "-" { next ; }
		$13 != "running" && $13 != "waiting" && $13 != "finished" && $13 != "unclosed" && $13 != "unknown-foreign" { next ; }
		{
			if ( ! ( $2 in judgedSeen ) ) { judgedSeen[$2] = 1 ; judgedOrder[++judgedCount] = $2 ; }
			if ( $12 == "running" ) { judgedAlive[$2]++ ; next ; }
			if ( $13 == "finished" ) { next ; }
			if ( $13 == "unknown-foreign" ) {
				judgedForeign[$2]++ ;
				if ( index( "," judgedHosts[$2] ",", "," $4 "," ) == 0 ) { judgedHosts[$2] = judgedHosts[$2] ( judgedHosts[$2] == "" ? "" : "," ) $4 ; }
				next ;
			}
			if ( $12 == "no-process" ) { judgedOpen[$2]++ ; next ; }
			judgedUnmeasured[$2]++ ;
		}
		END {
			for ( judgedAt = 1 ; judgedAt <= judgedCount ; judgedAt++ ) {
				judgedId = judgedOrder[judgedAt] ;
				judgedWord = "finished" ;
				if ( judgedAlive[judgedId] ) { judgedWord = "running" ; } else if ( judgedOpen[judgedId] ) { judgedWord = "open" ; } else if ( judgedForeign[judgedId] ) { judgedWord = "foreign" ; } else if ( judgedUnmeasured[judgedId] ) { judgedWord = "unmeasured" ; }
				print judgedId, judgedWord, ( judgedHosts[judgedId] == "" ? "-" : judgedHosts[judgedId] ) ;
			}
		}
	'
}

## Whether the start that opened a session is one its caller waits on: rc 0 it is. Such a
## start is told by the transcript of its run, the record of it in the team data, found
## through the run's own store (sessions/<id>/transcript): its first line, START, names the
## run and ends `wait=true` (AgentsTranscriptStart, as the spawner calls it). The run that
## opened a session has the session's id as its own. The spawn record has no word for it,
## and a session whose founder has no transcript is not known to be waited on.
AgentsToolsSessionControlWaited(){ ## session id
	local waitedPath="" waitedLine=""
	case "${1:-}" in ''|-|.|..|*/*|*[[:space:]]*) return 1 ;; esac
	{ IFS= read -r waitedPath < "$MMDAPP/.local/agents/sessions/$1/transcript" ; } 2> /dev/null || :
	[ -n "$waitedPath" ] || return 1
	{ IFS= read -r waitedLine < "$waitedPath" ; } 2> /dev/null || :
	case "$waitedLine " in *" START session=$1 "*" wait=true "*) return 0 ;; esac
	return 1
}

## When a file was last written, as seconds since 1970; nothing where that cannot be read.
## stat(1) differs by platform: each form is tried, and only a number is an answer.
AgentsToolsSessionControlWritten(){ ## file
	local writtenAt
	writtenAt="$( stat -f '%m' "$1" 2> /dev/null )" || writtenAt=""
	case "$writtenAt" in ''|*[!0123456789]*) writtenAt="$( stat -c '%Y' "$1" 2> /dev/null )" || writtenAt="" ;; esac
	case "$writtenAt" in ''|*[!0123456789]*) return 0 ;; esac
	printf '%s\n' "$writtenAt"
}

## STARTS THE CONTROL THREAD OF ONE SESSION, detached, and does not wait for it. Prints one
## line, what it did:
##   alive <pid>          a thread of that session lives: nothing was started. rc 0.
##   started <pid>        a process was started to be the thread, which it becomes once it
##                        holds the lock of its session, within a second or so. rc 0.
##   failed - <reason>    no process was started. rc 1.
## The process is started as the tooling script with the operation and the id of its session
## as its arguments, which is what makes it no run of that session and shows it in the
## process list (the thread refuses any other form). Its own process group, a hangup
## ignored, the descriptors 3 to 63 closed, its input /dev/null, its output and its errors
## appended to control/log, where the thread points them itself once it holds its lock. The
## names that carry a member's session are taken out of its environment.
## One line of that log is this function's: the start it made, with the process it started
## and when that process began, as a pid file names a process. What the process says before
## it holds the lock stands in that log too: a start that is refused says there why.
## The folder control/ is made here where the session has a folder already. A session with
## none gets one only where a record carries the id as its session-id, as the thread itself
## asks: a folder made for an id that names nothing would be taken for a session.
AgentsToolsSessionControlStart(){ ## session id
	local startSession="${1:-}" startStore startDir startLive startTool startMonitor startPid="" startBegan startDrop
	case "$startSession" in
		''|-|.|..|*/*|*[[:space:]]*)
			printf 'failed - %s\n' "'$startSession' is no id of a session: one name, with no '/' and no space"
			return 1
		;;
	esac
	startLive="$( printf '%s\n' "$startSession" | AgentsToolsSessionControlLive )" || startLive=""
	if [ -n "$startLive" ] ; then
		printf 'alive %s\n' "${startLive#* }"
		return 0
	fi
	startStore="$MMDAPP/.local/agents/sessions/$startSession"
	startDir="$startStore/control"
	if [ ! -d "$startStore" ] ; then
		## The names go to grep on a pipe, never as its arguments: a store of any size is read.
		if [ ! -d "$MMDAPP/.local/agents/spawned" ] || [ -z "$( printf '%s\0' "$MMDAPP/.local/agents/spawned"/*/*.md | LC_ALL=C xargs -0 grep -l -x -F -- "session-id: $startSession" 2> /dev/null | LC_ALL=C sed -n '1p' )" ] ; then
			printf 'failed - %s\n' "'$startSession' names no session of this workspace: no folder of a session has that name, and no record carries it as its session-id"
			return 1
		fi
	fi
	if ! mkdir -p "$startDir" 2> /dev/null || ! { printf '' >> "$startDir/log" ; } 2> /dev/null ; then
		printf 'failed - %s\n' "the log of the thread could not be written: $startDir/log"
		return 1
	fi
	startTool="$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
	if [ ! -f "$startTool" ] ; then
		printf 'failed - %s\n' "the tooling script is not at $startTool"
		return 1
	fi
	## Its own process group, as the spawner gives a run one, and the job control of the
	## caller left as it was found: on only in a shell of its own that had it on.
	startMonitor="$BASH_SUBSHELL:$-"
	set -m
	(
		trap '' HUP
		set +e
		for startDrop in ${!MDAT_SPAWN_@} MDAT_SESSION_ID MDAT_SESSION_THREAD MDAT_CONVERSATION_THREADS harnessSessionId harnessAgent CLAUDE_CODE_SESSION_ID ; do
			unset "$startDrop"
		done
		for (( startDrop = 3 ; startDrop < 64 ; startDrop++ )) ; do
			eval "exec $startDrop>&-"
		done
		exec "$BASH" "$startTool" --intern-session-control --run --session-id "$startSession"
	) < /dev/null >> "$startDir/log" 2>&1 &
	startPid="$!"
	case "$startMonitor" in 0:*m*) ;; *) set +m ;; esac
	case "$startPid" in
		''|*[!0123456789]*)
			printf 'failed - %s\n' "the process of the thread could not be started"
			return 1
		;;
	esac
	disown "$startPid" 2> /dev/null || :
	startBegan="$( printf '%s\n' "$startPid" | AgentsToolsRegistryProcessesBegan )" || startBegan=""
	{
		if [ -n "$startBegan" ] ; then
			printf '%s a start of the control thread of session %s is made: pid %s, begun %s\n' "$( date -u +%Y-%m-%dT%H:%M:%SZ )" "$startSession" "$startPid" "${startBegan#* }"
		else
			printf '%s a start of the control thread of session %s is made: pid %s, which has ended already\n' "$( date -u +%Y-%m-%dT%H:%M:%SZ )" "$startSession" "$startPid"
		fi >> "$startDir/log"
	} 2> /dev/null || :
	printf 'started %s\n' "$startPid"
	return 0
}

## A START IN FLIGHT: the process that a start of the thread of this session made within the
## last agentsSessionControlHoldSeconds, while it is still that process. It holds the lock of
## its session in a moment, or is refused by it, and until then no pid file names it: so a
## starter that comes right behind another, as the members of one session that are started
## one after the other do, would start a second process for the lock to refuse. The spawner
## asks this first and starts none while one is on its way. Read from the line every start
## writes into the log of the thread, the last such line, with the time it carries; a
## process that is still there after that time is no start in flight, and the next start is
## made. Prints its pid; nothing where there is none. rc 0 always.
AgentsToolsSessionControlStarting(){ ## session id
	local flightLog flightLine="" flightAt="" flightPid="" flightBegan="" flightSince=""
	case "${1:-}" in ''|-|.|..|*/*|*[[:space:]]*) return 0 ;; esac
	flightLog="$MMDAPP/.local/agents/sessions/$1/control/log"
	[ -f "$flightLog" ] || return 0
	flightLine="$( LC_ALL=C tail -n 40 "$flightLog" 2> /dev/null | LC_ALL=C sed -n 's/^\([0-9TZ:-][0-9TZ:-]*\) a start of the control thread of session .* is made: pid \([0-9][0-9]*\), begun \([^ ]*\)$/\1 \2 \3/p' | LC_ALL=C tail -n 1 )" || flightLine=""
	[ -n "$flightLine" ] || return 0
	read -r flightAt flightPid flightBegan <<< "$flightLine" || :
	flightSince="$( date -u -v-"$agentsSessionControlHoldSeconds"S +%Y-%m-%dT%H:%M:%SZ 2> /dev/null || date -u -d "$agentsSessionControlHoldSeconds seconds ago" +%Y-%m-%dT%H:%M:%SZ 2> /dev/null )" || flightSince=""
	## Both are the same form of a moment, so they are in order as texts are.
	[ -n "$flightSince" ] && [[ "$flightAt" > "$flightSince" ]] || return 0
	[ "$( printf '%s\n' "$flightPid" | AgentsToolsRegistryProcessesBegan )" = "$flightPid $flightBegan" ] || return 0
	printf '%s\n' "$flightPid"
	return 0
}

## WHAT BECAME OF A START, for a caller that tells a person: the console alone asks. Waits
## until the process that was started holds the session, or has ended, the seconds given at
## most, and prints one line:
##   started <pid>        that process is the thread of the session now. With words after
##                        it: it was the thread and has ended since, or it has not taken
##                        the lock within the time and is a process still.
##   alive <pid>          another thread holds the session: the start was refused by the
##                        lock, which is the lock's own rule.
##   failed - <reason>    the process ended and was never the thread: the reason is what
##                        it said in the log of the thread, its last error line since the
##                        start.
## rc 0 for the first two, rc 1 for the third. It signals nothing and ends nothing.
AgentsToolsSessionControlStartOutcome(){ ## session id, pid of the process that was started, seconds to wait at most
	local outcomeSession="$1" outcomePid="$2" outcomeLeft=$(( ${3:-0} * 5 )) outcomeLive outcomeLog outcomeSince outcomeWhy
	while : ; do
		outcomeLive="$( printf '%s\n' "$outcomeSession" | AgentsToolsSessionControlLive )" || outcomeLive=""
		if [ -n "$outcomeLive" ] ; then
			if [ "${outcomeLive#* }" = "$outcomePid" ] ; then printf 'started %s\n' "$outcomePid" ; else printf 'alive %s\n' "${outcomeLive#* }" ; fi
			return 0
		fi
		[ -n "$( printf '%s\n' "$outcomePid" | AgentsToolsRegistryProcessesBegan )" ] || break
		if [ "$outcomeLeft" -le 0 ] ; then
			printf 'started %s %s\n' "$outcomePid" "it had not taken the lock of its session after ${3:-0} seconds, and is a process still"
			return 0
		fi
		sleep 0.2 2> /dev/null || sleep 1
		outcomeLeft=$(( outcomeLeft - 1 ))
	done
	## It has ended. What it said since the start that made it, in the log of the thread.
	outcomeLog="$MMDAPP/.local/agents/sessions/$outcomeSession/control/log"
	outcomeSince="$( LC_ALL=C awk -v wantPid="$outcomePid" '
		index( $0, " is made: pid " wantPid "," ) > 0 { sinceText = "" ; sinceAny = 1 ; next ; }
		sinceAny { sinceText = sinceText $0 "\n" ; }
		END { printf "%s", sinceText ; }
	' "$outcomeLog" 2> /dev/null )" || outcomeSince=""
	## Its lines may stand before the line of its start, which is written once it is started.
	[ -n "$outcomeSince" ] || outcomeSince="$( LC_ALL=C tail -n 20 "$outcomeLog" 2> /dev/null )" || outcomeSince=""
	case "$outcomeSince" in
		*"the control thread of session $outcomeSession, pid $outcomePid, ends: "*)
			outcomeWhy="${outcomeSince##*"the control thread of session $outcomeSession, pid $outcomePid, ends: "}"
			printf 'started %s %s\n' "$outcomePid" "it was the thread and has ended since: ${outcomeWhy%%$'\n'*}"
			return 0
		;;
	esac
	outcomeWhy="$( printf '%s\n' "$outcomeSince" | LC_ALL=C sed -n 's/^.*ERROR: //p' | LC_ALL=C tail -n 1 )" || outcomeWhy=""
	[ -n "$outcomeWhy" ] || outcomeWhy="the process that was started, pid $outcomePid, ended before it held the lock of the session, and left no word why in $outcomeLog"
	printf 'failed - %s\n' "$outcomeWhy"
	return 1
}

## THE CHECK NOW. Of the measured rows on its input, each session that needs a thread and
## has none alive gets one, by AgentsToolsSessionControlStart. Prints a line for each such
## session, and for no other:
##   <session id> started <pid>
##   <session id> alive <pid>          a thread came to live between the look and the start
##   <session id> held - <reason>      left alone: the log of its thread was written less
##                                     than agentsSessionControlPauseSeconds ago
##   <session id> failed - <reason>    no process was started
## A session that is finished, one whose open records nothing here can measure, one that a
## start its caller waits on opened and one whose thread lives have no line. rc 1 only where
## the rows could not be read; a start that fails is a line, never a failure of the check.
AgentsToolsSessionControlCheck(){ ## -- stdin: measured rows
	local checkJudged checkWant="" checkLive checkSession checkWord checkHosts checkLog checkWritten checkNow="" checkAnswer checkNl=$'\n'
	checkJudged="$( AgentsToolsSessionControlJudged )" || return 1
	while read -r checkSession checkWord checkHosts ; do
		case "$checkWord" in running|open) checkWant="$checkWant$checkSession$checkNl" ;; esac
	done <<< "$checkJudged"
	[ -n "$checkWant" ] || return 0
	checkLive="$checkNl$( printf '%s' "$checkWant" | AgentsToolsSessionControlLive )" || checkLive=""
	while IFS= read -r checkSession ; do
		[ -n "$checkSession" ] || continue
		case "$checkLive$checkNl" in *"$checkNl$checkSession "*) continue ;; esac
		! AgentsToolsSessionControlWaited "$checkSession" || continue
		checkLog="$MMDAPP/.local/agents/sessions/$checkSession/control/log"
		if [ -f "$checkLog" ] ; then
			checkWritten="$( AgentsToolsSessionControlWritten "$checkLog" )" || checkWritten=""
			[ -n "$checkNow" ] || checkNow="$( date +%s 2> /dev/null )" || checkNow=""
			case "$checkWritten:$checkNow" in
				:*|*:|*[!0123456789:]*) ;;
				*)
					## A time that is ahead of the clock says nothing of how long ago it was.
					if [ "$checkNow" -ge "$checkWritten" ] && [ "$(( checkNow - checkWritten ))" -lt "$agentsSessionControlPauseSeconds" ] ; then
						printf '%s held - %s\n' "$checkSession" "the log of its thread was written $(( checkNow - checkWritten )) seconds ago, and a check starts the thread of one session once in $agentsSessionControlPauseSeconds seconds at most: a thread that has just ended is not started again at once"
						continue
					fi
				;;
			esac
		fi
		checkAnswer="$( AgentsToolsSessionControlStart "$checkSession" )" || :
		printf '%s %s\n' "$checkSession" "${checkAnswer:-failed - the start said nothing}"
	done <<< "$checkWant"
	return 0
}

## The same check for a caller that has measured nothing: the sessions registry of this
## workspace is rebuilt, as a reader that passes by does, and its rows measured where a
## row's live and state are derived (AgentsToolsRegistryMeasureRows). A workspace no session
## ever ran in has nothing to check. rc 1, nothing started, where the registry cannot be
## rebuilt.
AgentsToolsSessionControlCheckWorkspace(){
	local measuredRows="" measuredDated="" measuredAny="false"
	[ -d "$MMDAPP/.local/agents/spawned" ] || return 0
	AgentsToolsRegistrySpawnedSessionsRebuild || return 1
	AgentsToolsRegistryMeasureRows "$( AgentsToolsRegistryFile spawned-sessions )"
	printf '%s' "$measuredRows" | AgentsToolsSessionControlCheck
}
