#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.InternOpBoardTrash.include -- the --intern-op-board-trash op
## for DistroAgentsTools.fn.sh's dispatcher. Sourced lazily from that exact
## op's own dispatcher arm via the standard $MDLT_ORIGIN-based path. Not
## standalone: relies on being dot-sourced for $1/$@/$MDSC_CMD.
##

case "$1" in

	--intern-op-board-trash)
		shift
		## A direct call is still an op, and the commit message names whichever
		## one ran -- so the default is this op's own name, not a placeholder.
		local opContext="--intern-op-board-trash"
		local ctxWanted="" ctxArg
		for ctxArg in "$@" ; do
			if [ -n "$ctxWanted" ] ; then
				opContext="$ctxArg" ; ctxWanted="" ; continue
			fi
			if [ "$ctxArg" = "--context" ] ; then ctxWanted="1" ; fi
		done

		local callingMember="$1"
		shift || true
		if [ -z "$callingMember" ] ; then
			echo "$MDSC_CMD: board-trash: ⛔ ERROR: syntax is <team-member> <board-state> <item-name> [--context <caller-op>], or <team-member> --from-inbox:<member> <item-name> [--context <caller-op>]" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$callingMember" "<team-member>" board-trash || { set +e ; return 1 ; }

		if [ "${1#--from-inbox:}" != "$1" ] ; then
			local inboxMember="${1#--from-inbox:}"
			shift
			local inboxItemName="$1"
			shift || true
			if [ -z "$inboxMember" ] || [ -z "$inboxItemName" ] ; then
				echo "$MDSC_CMD: board-trash: ⛔ ERROR: syntax is <team-member> --from-inbox:<member> <item-name> [--context <caller-op>]" >&2
				set +e ; return 1
			fi
			if [ "$1" = "--context" ] ; then
				if [ -z "${2:-}" ] ; then
					echo "$MDSC_CMD: board-trash: ⛔ ERROR: --context: value required" >&2
					set +e ; return 1
				fi
				shift 2
			fi
			if [ $# -gt 0 ] ; then
				echo "$MDSC_CMD: board-trash: ⛔ ERROR: invalid option: $1" >&2
				set +e ; return 1
			fi
			AgentsToolsAssertBareName "$inboxMember" "--from-inbox: member name" board-trash || { set +e ; return 1 ; }
			AgentsToolsAssertBareName "$inboxItemName" "<item-name>" board-trash || { set +e ; return 1 ; }
			case "$inboxItemName" in
				*.md) ;;
				*)
					echo "$MDSC_CMD: board-trash: ⛔ ERROR: <item-name> must end in .md -- every inbox item is a markdown document: $inboxItemName" >&2
					set +e ; return 1
				;;
			esac
			## DELIBERATELY ABSENT: no inbox type-prefix whitelist. An inbox is
			## written with note-/inquiry-/reflection- items, but the ones this op
			## relocates are task-/proposal-/change-/interview-. A whitelist would
			## reject exactly the misfiled board-type document this arm exists to
			## remove. Do not add one.
			[ -n "${MDAT_DATA_ROOT:-}" ] || {
				echo "$MDSC_CMD: board-trash: ⛔ ERROR: MDAT_DATA_ROOT is not set" >&2
				set +e ; return 1
			}
			## Git-tracked gate: .git presence only, independent of TEAM_DATA_GIT_REMOTE.
			local repoRoot=""
			repoRoot="$( git -C "$MDAT_DATA_ROOT" rev-parse --show-toplevel 2>/dev/null )" || repoRoot=""

			## Source resolution. BOTH path segments are FIXED LITERALS this op
			## appends -- the inbox root, and `processed/` under it. A caller
			## passes a bare item name, never a path segment. `cd` + `pwd -P`
			## rather than `realpath` (not POSIX) or `readlink -f` (absent on
			## macOS before Monterey).
			##
			## `archive: true` IS NOT CONSULTED HERE, deliberately: it governs the
			## heartbeat GC's automatic retention clock, not a member naming one
			## file. An inbox item has no board state to be diverted into, so
			## honouring it could only mean refusing -- and a refusal on a header
			## is the deadlock this arm exists to break, since no tooling edits
			## frontmatter in place once an item sits in the legacy processed/.
			local inboxBase="" inboxDirResolved=""
			inboxBase="$( cd "$MDAT_DATA_ROOT/inboxes" 2>/dev/null && pwd -P )" || inboxBase=""
			if [ -z "$inboxBase" ] ; then
				echo "$MDSC_CMD: board-trash: ⛔ ERROR: no such inbox root: $MDAT_DATA_ROOT/inboxes" >&2
				set +e ; return 1
			fi
			## Both the inbox ROOT and its legacy processed/ are searched, ROOT
			## FIRST: a member's own inspection path resolves the same way, so
			## inverting the order would delete a copy the caller could never
			## have read. Items are now marked processed in place in the root
			## (`processed-at`), so processed/ only holds items drained before
			## that change, read-only until the GC empties it; a basename held in
			## both is the root copy.
			local inboxRootDir="$MDAT_DATA_ROOT/inboxes/$inboxMember"
			local inboxProcessedDir="$MDAT_DATA_ROOT/inboxes/$inboxMember/processed"
			local inboxSourcePath="" inboxCandidateDir=""
			for inboxCandidateDir in "$inboxRootDir" "$inboxProcessedDir" ; do
				inboxDirResolved="$( cd "$inboxCandidateDir" 2>/dev/null && pwd -P )" || inboxDirResolved=""
				if [ -z "$inboxDirResolved" ] ; then continue ; fi
				## Per candidate, never once for the pair: a processed/ reached
				## through a symlink out of the tree is not vouched for by its
				## parent having been fine. Containment tested WITH the separator
				## -- "$inboxBase"/* , never a bare "$inboxBase"* prefix, which
				## /data/inboxes-evil/x passes. The non-empty check above is
				## load-bearing: with an empty base the pattern is "/*", which
				## matches /etc -- measured on bash 3.2.
				case "$inboxDirResolved" in
					"$inboxBase"/*) ;;
					*)
						echo "$MDSC_CMD: board-trash: ⛔ ERROR: resolved inbox directory escapes the inbox root ($inboxBase): $inboxDirResolved" >&2
						set +e ; return 1
					;;
				esac
				## `if`, never `[ -f x ] && { ... ; break ; }`: the AND-OR form
				## leaves the loop's exit status at 1 when the last candidate
				## misses, a live fault where such a loop ends a function.
				if [ -f "$inboxDirResolved/$inboxItemName" ] ; then
					inboxSourcePath="$inboxDirResolved/$inboxItemName"
					break
				fi
			done
			if [ -z "$inboxSourcePath" ] ; then
				## Both searched directories are named: on a total miss there is
				## no resolved path to print.
				echo "$MDSC_CMD: board-trash: ⛔ ERROR: item not found in $inboxRootDir or $inboxProcessedDir: $inboxItemName" >&2
				set +e ; return 1
			fi
			## An item git never knew is committed first, so the deletion below is recorded
			## over it and history keeps it like any tracked item.
			if [ -n "$repoRoot" ] && [ -z "$( git -C "$repoRoot" ls-files -- "$inboxSourcePath" 2>/dev/null )" ] ; then
				. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.TeamDataCommit.include"
				AgentsToolsTeamDataCommitPaths "board-trash: keep ${inboxSourcePath#"$MDAT_DATA_ROOT"/} in history before deleting it" "$inboxSourcePath"
				## HEAD, not the index: staged-but-uncommitted is not in history.
				if [ -z "$( git -C "$repoRoot" ls-tree --name-only HEAD -- "$inboxSourcePath" 2>/dev/null )" ] ; then
					echo "$MDSC_CMD: board-trash: ⛔ ERROR: could not commit the never-committed $inboxSourcePath before deleting it, so it was left in place" >&2
					set +e ; return 1
				fi
			fi
			if [ -n "$repoRoot" ] ; then
				rm -f -- "$inboxSourcePath"
				local gitOut="" gitRc=0
				gitOut="$( git -C "$repoRoot" add -- "$inboxSourcePath" 2>&1 )" || gitRc=$?
				if [ "$gitRc" -ne 0 ] ; then
					echo "$MDSC_CMD: board-trash: ⛔ ERROR: git add failed for $inboxSourcePath: $gitOut" >&2
					set +e ; return 1
				fi
				gitOut="$( git -C "$repoRoot" commit -m "- $opContext, $callingMember" -- "$inboxSourcePath" 2>&1 )" || gitRc=$?
				if [ "$gitRc" -ne 0 ] ; then
					echo "$MDSC_CMD: board-trash: ⛔ ERROR: git commit failed for $inboxSourcePath: $gitOut" >&2
					set +e ; return 1
				fi
				echo "# $MDSC_CMD: board-trash: deleted and committed ${inboxSourcePath#"$MDAT_DATA_ROOT"/}" >&2
			else
				## trash/ is flat, has several writers, and `mv` cannot refuse a
				## collision: this test is the only thing that reports one.
				local inboxTrashPath="$MDAT_DATA_ROOT/trash/$inboxItemName"
				mkdir -p "$MDAT_DATA_ROOT/trash"
				if [ -e "$inboxTrashPath" ] ; then
					echo "$MDSC_CMD: board-trash: ⛔ ERROR: trash/ already holds that name, refusing to overwrite it: $inboxTrashPath" >&2
					set +e ; return 1
				fi
				mv "$inboxSourcePath" "$inboxTrashPath"
				## Arrival in trash/ starts that copy's own retention clock:
				## `mv` preserves mtime, so the item would arrive expired.
				touch "$inboxTrashPath"
				echo "# $MDSC_CMD: board-trash: moved ${inboxSourcePath#"$MDAT_DATA_ROOT"/} to ${inboxTrashPath#"$MDAT_DATA_ROOT"/}" >&2
			fi
			return 0
		fi

		local boardState="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$boardState" ] || [ -z "$itemName" ] ; then
			echo "$MDSC_CMD: board-trash: ⛔ ERROR: syntax is <team-member> <board-state> <item-name>" >&2
			set +e ; return 1
		fi
		local untrashMode=""
		while [ $# -gt 0 ] ; do
			case "$1" in
				--untrash) untrashMode=1 ; shift ;;
				--context)
					if [ -z "${2:-}" ] ; then
						echo "$MDSC_CMD: board-trash: ⛔ ERROR: --context: value required" >&2
						set +e ; return 1
					fi
					shift 2
				;;
				*)
					echo "$MDSC_CMD: board-trash: ⛔ ERROR: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		case "$boardState" in
			backlog|pending|running|review|blocked|parked|processed|archived|retained)
			;;
			*)
				echo "$MDSC_CMD: board-trash: ⛔ ERROR: invalid board-state: $boardState" >&2
				set +e ; return 1
			;;
		esac
		AgentsToolsAssertBareName "$itemName" "<item-name>" board-trash || { set +e ; return 1 ; }

		[ -n "${MDAT_DATA_ROOT:-}" ] || {
			echo "$MDSC_CMD: board-trash: ⛔ ERROR: MDAT_DATA_ROOT is not set" >&2
			set +e ; return 1
		}
		local repoRoot=""
		repoRoot="$( git -C "$MDAT_DATA_ROOT" rev-parse --show-toplevel 2>/dev/null )" || repoRoot=""

		## Restore: only a store without git keeps a trashed item in trash/; a git store's copy is its history.
		if [ -n "$untrashMode" ] ; then
			if [ -n "$repoRoot" ] ; then
				echo "$MDSC_CMD: board-trash: ⛔ ERROR: --untrash: a git store keeps trashed items only in its history; no tooling op restores from it; ask the coordinator -- nothing was changed" >&2
				set +e ; return 1
			fi
			local untrashSource="$MDAT_DATA_ROOT/trash/$itemName" untrashTarget="$MDAT_DATA_ROOT/board/$boardState/$itemName"
			if [ ! -f "$untrashSource" ] ; then
				echo "$MDSC_CMD: board-trash: ⛔ ERROR: --untrash: not in trash/: $untrashSource" >&2
				set +e ; return 1
			fi
			if [ -e "$untrashTarget" ] ; then
				echo "$MDSC_CMD: board-trash: ⛔ ERROR: --untrash: the board already holds that name, refusing to overwrite it: $untrashTarget" >&2
				set +e ; return 1
			fi
			mkdir -p "$MDAT_DATA_ROOT/board/$boardState" && mv "$untrashSource" "$untrashTarget" || {
				echo "$MDSC_CMD: board-trash: ⛔ ERROR: --untrash: could not move $untrashSource back to $untrashTarget" >&2
				set +e ; return 1
			}
			echo "# $MDSC_CMD: board-trash: restored trash/$itemName to board/$boardState/" >&2
			return 0
		fi

		local sourcePath="$MDAT_DATA_ROOT/board/$boardState/$itemName"
		if [ ! -f "$sourcePath" ] ; then
			echo "$MDSC_CMD: board-trash: ⛔ ERROR: item not found: $sourcePath" >&2
			set +e ; return 1
		fi
		## Same never-committed case as the inbox arm above: committed first, then deleted.
		if [ -n "$repoRoot" ] && [ -z "$( git -C "$repoRoot" ls-files -- "$sourcePath" 2>/dev/null )" ] ; then
			. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.TeamDataCommit.include"
			AgentsToolsTeamDataCommitPaths "board-trash: keep ${sourcePath#"$MDAT_DATA_ROOT"/} in history before deleting it" "$sourcePath"
			## HEAD, not the index: staged-but-uncommitted is not in history.
			if [ -z "$( git -C "$repoRoot" ls-tree --name-only HEAD -- "$sourcePath" 2>/dev/null )" ] ; then
				echo "$MDSC_CMD: board-trash: ⛔ ERROR: could not commit the never-committed $sourcePath before deleting it, so it was left in place" >&2
				set +e ; return 1
			fi
		fi
		if [ -n "$repoRoot" ] ; then
			rm -f -- "$sourcePath"
			local gitOut="" gitRc=0
			gitOut="$( git -C "$repoRoot" add -- "$sourcePath" 2>&1 )" || gitRc=$?
			if [ "$gitRc" -ne 0 ] ; then
				echo "$MDSC_CMD: board-trash: ⛔ ERROR: git add failed for $sourcePath: $gitOut" >&2
				set +e ; return 1
			fi
			gitOut="$( git -C "$repoRoot" commit -m "- $opContext, $callingMember" -- "$sourcePath" 2>&1 )" || gitRc=$?
			if [ "$gitRc" -ne 0 ] ; then
				echo "$MDSC_CMD: board-trash: ⛔ ERROR: git commit failed for $sourcePath: $gitOut" >&2
				set +e ; return 1
			fi
			echo "# $MDSC_CMD: board-trash: deleted and committed ${sourcePath#"$MDAT_DATA_ROOT"/}" >&2
		else
			## Same flat-trash/ collision refusal as the inbox arm above.
			local targetPath="$MDAT_DATA_ROOT/trash/$itemName"
			mkdir -p "$MDAT_DATA_ROOT/trash"
			if [ -e "$targetPath" ] ; then
				echo "$MDSC_CMD: board-trash: ⛔ ERROR: trash/ already holds that name, refusing to overwrite it: $targetPath" >&2
				set +e ; return 1
			fi
			mv "$sourcePath" "$targetPath"
			## Same fresh retention clock as the inbox arm above.
			touch "$targetPath"
			echo "# $MDSC_CMD: board-trash: moved ${sourcePath#"$MDAT_DATA_ROOT"/} to ${targetPath#"$MDAT_DATA_ROOT"/}" >&2
		fi
		return 0
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
