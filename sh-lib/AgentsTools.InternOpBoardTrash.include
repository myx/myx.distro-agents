#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.InternOpBoardTrash.include -- the --intern-op-board-trash op
## for DistroAgentsTools.fn.sh's dispatcher. Sourced lazily from that exact
## op's own dispatcher arm via the standard $MDLT_ORIGIN-based path. Not
## standalone: relies on being dot-sourced for $1/$@/$MDSC_CMD. One
## intern-op primitive per file, same convention as
## AgentsTools.InternOpBoardRename.include -- not bundled with it.
##
## Explicit board-item <-> trash/ relocation, both directions via one op.
## trash/ is a standalone sibling of board/ under the team data directory
## (--intern-config-board-location's own root) -- not one of board/'s own
## states. <board-state> in the --untrash direction names the RESTORE
## target, not a state trash/ itself belongs to.
##
## GIT-GATED TRASHING, per the human-owner's final GC-deletion spec: when
## $MDAT_DATA_ROOT is git-tracked (`git -C "$MDAT_DATA_ROOT" rev-parse
## --show-toplevel` succeeds -- .git PRESENCE ONLY, same convention as
## AgentsTools.InternTeamDataFinalGcDeletion.include, independent of
## TEAM_DATA_GIT_REMOTE), trashing an item actually deletes it and commits
## the deletion with message "- <op name>, <team-member>", instead of
## moving it to trash/. Not git-tracked, the move-to-trash/ behaviour is
## unchanged. <team-member>, the acting member, is a leading positional on
## BOTH source forms below purely to feed that commit message.
##
## TWO SOURCES, discriminated on the first token after <team-member>:
##   --intern-op-board-trash <team-member> <board-state> <item-name> [--untrash] [--context <op>]
##   --intern-op-board-trash <team-member> --from-inbox:<member> <item-name> [--context <op>]
## Board states never begin with '--', so the discriminant is unambiguous.
##
## "both directions via one op", above, describes the BOARD source only.
## The inbox source never relocates via --untrash -- --untrash is refused
## for it unconditionally (see the arm below), regardless of git state.
## Once git-tracked, its trashing is also a real delete-and-commit, so
## nothing survives anywhere; not git-tracked, it now moves to trash/ same
## as the board source, recoverable only by hand -- this op still won't
## restore it either way. Note the syntax lines above accordingly:
## [--untrash] appears on the board form and on no other.
##
## --untrash ITSELF is refused outright on the board form too, once
## git-tracked: trashing under git never populates trash/, so there is
## nothing there to restore -- see that arm below for the explicit,
## git-mode-aware refusal message (same shape as the inbox-source refusal
## above it).
##
## No --help entry: internal plumbing, called by
## --magic-heartbeat-board-item-trash and --librarian-inbox-item-trash.
##

case "$1" in

	--intern-op-board-trash)
		shift
		## --context <caller-op>: see AgentsTools.InternOpBoardUpsertMoveEdit.include's
		## own copy of this block for the full reasoning. Pre-scanned before any
		## validation so every message here can name the invoking operation.
		## This op takes positionals rather than an option loop, so the
		## consumption is the explicit --context branch further down, after
		## --untrash.
		local opContext="<no --context given>"
		local ctxWanted="" ctxArg
		for ctxArg in "$@" ; do
			if [ -n "$ctxWanted" ] ; then
				opContext="$ctxArg" ; ctxWanted="" ; continue
			fi
			if [ "$ctxArg" = "--context" ] ; then ctxWanted="1" ; fi
		done

		## <team-member>: the acting member, consumed first on BOTH source
		## forms below -- feeds the git-commit message's own
		## "- <op name>, <team-member>" shape further down, nothing else.
		local callingMember="$1"
		shift || true
		if [ -z "$callingMember" ] ; then
			echo "$MDSC_CMD: board-trash: ⛔ ERROR: syntax is <team-member> <board-state> <item-name> [--untrash] [--context <caller-op>], or <team-member> --from-inbox:<member> <item-name> [--context <caller-op>]" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$callingMember" "<team-member>" board-trash || { set +e ; return 1 ; }

		##
		## FIRST-TOKEN DISCRIMINANT -- inbox source. Everything below this
		## `fi` is the board-sourced arm.
		##
		if [ "${1#--from-inbox:}" != "$1" ] ; then
			local inboxMember="${1#--from-inbox:}"
			shift
			local inboxItemName="$1"
			shift || true
			if [ -z "$inboxMember" ] || [ -z "$inboxItemName" ] ; then
				echo "$MDSC_CMD: board-trash: ⛔ ERROR: syntax is <team-member> --from-inbox:<member> <item-name> [--context <caller-op>]" >&2
				set +e ; return 1
			fi
			##
			## HAZARD: --untrash is REFUSED for an inbox-sourced item, and this
			## refusal is a decision, not a missing feature -- unconditional,
			## regardless of git state. --untrash restores into board/<state>;
			## an inbox-sourced item never came from a board state, so there is
			## no correct place to put it back. Accepting it would deposit the
			## item into some board state folder, exit 0, and read as success --
			## a wrong-place restore that reports success is strictly worse than
			## a refusal. Recording per-item provenance (where each trashed item
			## actually came from) is the better long-term answer; it is
			## deliberately NOT being rushed in alongside this arm, so until it
			## exists the honest behaviour is to refuse.
			##
			if [ "$1" = "--untrash" ] ; then
				echo "$MDSC_CMD: board-trash: ⛔ ERROR: --untrash is not supported for an inbox-sourced item -- it restores into board/<state>, and an item trashed out of inboxes/$inboxMember/processed/ has no board state to return to. Restore it by hand, or wait for per-item trash provenance (deliberately not added with this arm)." >&2
				set +e ; return 1
			fi
			if [ "$1" = "--context" ] ; then
				if [ -z "${2:-}" ] ; then
					echo "$MDSC_CMD: board-trash: ⛔ ERROR: --context: value required" >&2
					set +e ; return 1
				fi
				shift 2
			fi
			if [ $# -gt 0 ] ; then
				echo "$MDSC_CMD: board-trash: ⛔ ERROR: invalid option: $1" >&2
				set +e ; return 1
			fi
			AgentsToolsAssertBareName "$inboxMember" "--from-inbox: member name" board-trash || { set +e ; return 1 ; }
			AgentsToolsAssertBareName "$inboxItemName" "<item-name>" board-trash || { set +e ; return 1 ; }
			case "$inboxItemName" in
				*.md) ;;
				*)
					echo "$MDSC_CMD: board-trash: ⛔ ERROR: <item-name> must end in .md -- every inbox item is a markdown document: $inboxItemName" >&2
					set +e ; return 1
				;;
			esac
			##
			## DELIBERATELY ABSENT: no inbox type-prefix whitelist. The types an
			## inbox is *written* with are note-/inquiry-/reflection-, but the
			## items this op exists to relocate are task-/proposal-/change-/
			## interview-. A prefix whitelist would reject exactly the files the
			## operation was built to move. Do not add one.
			##
			[ -n "${MDAT_DATA_ROOT:-}" ] || {
				echo "$MDSC_CMD: board-trash: ⛔ ERROR: MDAT_DATA_ROOT is not set" >&2
				set +e ; return 1
			}
			## Git-tracked gate, same .git-presence-only test as the board arm
			## below and as AgentsTools.InternTeamDataFinalGcDeletion.include's
			## own -- independent of TEAM_DATA_GIT_REMOTE.
			local repoRoot=""
			repoRoot="$( git -C "$MDAT_DATA_ROOT" rev-parse --show-toplevel 2>/dev/null )" || repoRoot=""

			##
			## Source resolution. `processed/` is a FIXED LITERAL this op
			## appends -- deliberately not caller-supplied. Measured: the whole
			## domain of that path segment is one value (6 of the 13 inboxes
			## carry a `processed` subdirectory, nothing else, no deeper
			## nesting). The literal can be widened into a parameter later; a
			## parameter could never be narrowed back. Not an oversight.
			##
			## `cd` + `pwd -P` rather than `realpath` (not POSIX) or
			## `readlink -f` (absent on macOS before Monterey).
			##
			local inboxBase="" inboxDirResolved=""
			inboxBase="$( cd "$MDAT_DATA_ROOT/inboxes" 2>/dev/null && pwd -P )" || inboxBase=""
			if [ -z "$inboxBase" ] ; then
				echo "$MDSC_CMD: board-trash: ⛔ ERROR: no such inbox root: $MDAT_DATA_ROOT/inboxes" >&2
				set +e ; return 1
			fi
			inboxDirResolved="$( cd "$MDAT_DATA_ROOT/inboxes/$inboxMember/processed" 2>/dev/null && pwd -P )" || inboxDirResolved=""
			if [ -z "$inboxDirResolved" ] ; then
				echo "$MDSC_CMD: board-trash: ⛔ ERROR: no such inbox processed directory: $MDAT_DATA_ROOT/inboxes/$inboxMember/processed" >&2
				set +e ; return 1
			fi
			## Containment tested WITH the separator -- "$inboxBase"/* , never a
			## bare "$inboxBase"* prefix: /data/inboxes-evil/x passes the bare
			## prefix test and correctly fails this one.
			case "$inboxDirResolved" in
				"$inboxBase"/*) ;;
				*)
					echo "$MDSC_CMD: board-trash: ⛔ ERROR: resolved inbox directory escapes the inbox root ($inboxBase): $inboxDirResolved" >&2
					set +e ; return 1
				;;
			esac
			local inboxSourcePath="$inboxDirResolved/$inboxItemName"
			if [ ! -f "$inboxSourcePath" ] ; then
				echo "$MDSC_CMD: board-trash: ⛔ ERROR: item not found: $inboxSourcePath" >&2
				set +e ; return 1
			fi
			## `--` before the operands is independent of the leading-'-'
			## rejection above: validation guards bad input, `--` guards a later
			## edit that bypasses validation.
			if [ -n "$repoRoot" ] ; then
				rm -f -- "$inboxSourcePath"
				local gitOut="" gitRc=0
				gitOut="$( git -C "$repoRoot" add -- "$inboxSourcePath" 2>&1 )" || gitRc=$?
				if [ "$gitRc" -ne 0 ] ; then
					echo "$MDSC_CMD: board-trash: ⛔ ERROR: git add failed for $inboxSourcePath: $gitOut" >&2
					set +e ; return 1
				fi
				gitOut="$( git -C "$repoRoot" commit -m "- $opContext, $callingMember" -- "$inboxSourcePath" 2>&1 )" || gitRc=$?
				if [ "$gitRc" -ne 0 ] ; then
					echo "$MDSC_CMD: board-trash: ⛔ ERROR: git commit failed for $inboxSourcePath: $gitOut" >&2
					set +e ; return 1
				fi
				echo "# $MDSC_CMD: board-trash: deleted and committed ${inboxSourcePath#"$MDAT_DATA_ROOT"/}" >&2
			else
				local inboxTrashPath="$MDAT_DATA_ROOT/trash/$inboxItemName"
				mv "$inboxSourcePath" "$inboxTrashPath"
				echo "# $MDSC_CMD: board-trash: moved ${inboxSourcePath#"$MDAT_DATA_ROOT"/} to ${inboxTrashPath#"$MDAT_DATA_ROOT"/}" >&2
			fi
			return 0
		fi

		local boardState="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$boardState" ] || [ -z "$itemName" ] ; then
			echo "$MDSC_CMD: board-trash: ⛔ ERROR: syntax is <team-member> <board-state> <item-name> [--untrash]" >&2
			set +e ; return 1
		fi
		local doUntrash="false"
		if [ "$1" = "--untrash" ] ; then
			doUntrash="true"
			shift
		fi
		## Consumes the --context pair the pre-scan above already read. Placed
		## after --untrash so callers append it last, same order the pre-scan
		## and the trailing arity guard below both expect.
		if [ "$1" = "--context" ] ; then
			if [ -z "${2:-}" ] ; then
				echo "$MDSC_CMD: board-trash: ⛔ ERROR: --context: value required" >&2
				set +e ; return 1
			fi
			shift 2
		fi
		if [ $# -gt 0 ] ; then
			echo "$MDSC_CMD: board-trash: ⛔ ERROR: invalid option: $1" >&2
			set +e ; return 1
		fi
		case "$boardState" in
			backlog|pending|running|blocked|parked|processed|archived|retained)
			;;
			*)
				echo "$MDSC_CMD: board-trash: ⛔ ERROR: invalid board-state: $boardState" >&2
				set +e ; return 1
			;;
		esac
		AgentsToolsAssertBareName "$itemName" "<item-name>" board-trash || { set +e ; return 1 ; }

		[ -n "${MDAT_DATA_ROOT:-}" ] || {
			echo "$MDSC_CMD: board-trash: ⛔ ERROR: MDAT_DATA_ROOT is not set" >&2
			set +e ; return 1
		}
		## Git-tracked gate, same .git-presence-only test as the inbox arm
		## above and as AgentsTools.InternTeamDataFinalGcDeletion.include's
		## own -- independent of TEAM_DATA_GIT_REMOTE.
		local repoRoot=""
		repoRoot="$( git -C "$MDAT_DATA_ROOT" rev-parse --show-toplevel 2>/dev/null )" || repoRoot=""

		if [ "$doUntrash" = "true" ] ; then
			##
			## Once git-tracked, trashing never populates trash/ (see below) --
			## nothing is ever there to restore. Refusing here, explicitly, is
			## the same decision as the inbox-source refusal above: falling
			## through to the "not found in trash/" check below would read as
			## an ordinary missing-item error and hide the real reason.
			##
			if [ -n "$repoRoot" ] ; then
				echo "$MDSC_CMD: board-trash: ⛔ ERROR: --untrash is not supported once team-data is git-tracked ($repoRoot) -- trashing there deletes the item outright and commits the deletion, so nothing is ever placed in trash/ to restore. Recover it from git history instead." >&2
				set +e ; return 1
			fi
			local sourcePath="$MDAT_DATA_ROOT/trash/$itemName"
			local targetDir="$MDAT_DATA_ROOT/board/$boardState"
			local targetPath="$targetDir/$itemName"
			if [ ! -f "$sourcePath" ] ; then
				echo "$MDSC_CMD: board-trash: ⛔ ERROR: --untrash: item not found in trash/: $sourcePath" >&2
				set +e ; return 1
			fi
			if [ ! -d "$targetDir" ] ; then
				echo "$MDSC_CMD: board-trash: ⛔ ERROR: --untrash: no such board state directory: $targetDir" >&2
				set +e ; return 1
			fi
			mv "$sourcePath" "$targetPath"
			echo "# $MDSC_CMD: board-trash: restored ${sourcePath#"$MDAT_DATA_ROOT"/} to ${targetPath#"$MDAT_DATA_ROOT"/}" >&2
		else
			local sourcePath="$MDAT_DATA_ROOT/board/$boardState/$itemName"
			if [ ! -f "$sourcePath" ] ; then
				echo "$MDSC_CMD: board-trash: ⛔ ERROR: item not found: $sourcePath" >&2
				set +e ; return 1
			fi
			if [ -n "$repoRoot" ] ; then
				rm -f -- "$sourcePath"
				local gitOut="" gitRc=0
				gitOut="$( git -C "$repoRoot" add -- "$sourcePath" 2>&1 )" || gitRc=$?
				if [ "$gitRc" -ne 0 ] ; then
					echo "$MDSC_CMD: board-trash: ⛔ ERROR: git add failed for $sourcePath: $gitOut" >&2
					set +e ; return 1
				fi
				gitOut="$( git -C "$repoRoot" commit -m "- $opContext, $callingMember" -- "$sourcePath" 2>&1 )" || gitRc=$?
				if [ "$gitRc" -ne 0 ] ; then
					echo "$MDSC_CMD: board-trash: ⛔ ERROR: git commit failed for $sourcePath: $gitOut" >&2
					set +e ; return 1
				fi
				echo "# $MDSC_CMD: board-trash: deleted and committed ${sourcePath#"$MDAT_DATA_ROOT"/}" >&2
			else
				local targetPath="$MDAT_DATA_ROOT/trash/$itemName"
				mv "$sourcePath" "$targetPath"
				echo "# $MDSC_CMD: board-trash: moved ${sourcePath#"$MDAT_DATA_ROOT"/} to ${targetPath#"$MDAT_DATA_ROOT"/}" >&2
			fi
		fi
		return 0
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
