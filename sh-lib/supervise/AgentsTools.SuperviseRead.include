#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only
type AgentsSlackIdentityId > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/slack/AgentsTools.SlackIdentities.include"

##
## AgentsTools.SuperviseRead.include -- the supervisor reads one run by its id (epic S13.4): its log tail, its transcript, its
## session thread and its CheckList, from the run's own record and store. Sourced, never run; functions only.
##
## WHY IT IS NOT A --manager-* OPERATION. Those are the console's own and are refused from inside a member's session
## (AgentsToolsManagerCallerCheck). A supervisor is magic-coordinator's own run, so --manager-session-read and
## --manager-session-checklist-read are closed to it. Nothing read another run's session thread at all. This operation is the
## supervisor's, so AgentsToolsSurfaceCaller admits exactly that caller.
##
## ONE RUN A ROW A SECTION, TAB-separated:
##   `run <run-id> <member> <session> <status> <live>`    what the record and the process list say
##   `transcript <path|->` then `tail <line>`             the last --tail lines of every part of it
##   `thread <channel:thread|->` then `message <speaker> <text>`
##   `checklist <member> <path|->` then `item <line>`
##   `log <path|->` then `logline <line>`                 with --log
## A `-` in a path column says the run keeps none of that, and its rows are not printed.
##

## --supervise-read <run-id> [--tail <lines>] [--thread-lines <lines>] [--no-thread] [--no-checklist] [--log]
type AgentsToolsSuperviseInWorkspace > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/supervise/AgentsTools.SuperviseWorkspace.include"
AgentsToolsSuperviseRead(){ ## <run-id> [--tail <n>] [--thread-lines <n>] [--no-thread] [--no-checklist] [--log] [--workspace <path>]
	type AgentsToolsSpawnRuns > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/run/AgentsTools.RunProcesses.include"
	## `--workspace <path>`: the run is of that workspace, and this runs again there without it (AgentsTools.SuperviseWorkspace.include).
	! AgentsToolsSuperviseWorkspaceGiven "$@" || { AgentsToolsSuperviseInWorkspace AgentsToolsSuperviseRead "$@" ; return $? ; }
	local readRun="" readTail=40 readThreadLines=30 readThread=yes readChecklist=yes readLog=no
	local readTab=$'\t' readRecord readMember readSession readStatus readSandbox readLine readAny readThreadValue readMemberId
	while [ $# -gt 0 ] ; do
		case "$1" in
			--tail) [ $# -ge 2 ] || { echo "$MDSC_CMD: ⛔ ERROR: --tail requires a count" >&2 ; return 1 ; } ; readTail="$2" ; shift 2 ;;
			--thread-lines) [ $# -ge 2 ] || { echo "$MDSC_CMD: ⛔ ERROR: --thread-lines requires a count" >&2 ; return 1 ; } ; readThreadLines="$2" ; shift 2 ;;
			--no-thread) readThread=no ; shift ;;
			--no-checklist) readChecklist=no ; shift ;;
			--log) readLog=yes ; shift ;;
			-*) echo "$MDSC_CMD: ⛔ ERROR: --supervise-read: invalid option: $1" >&2 ; return 1 ;;
			*)
				[ -z "$readRun" ] || { echo "$MDSC_CMD: ⛔ ERROR: --supervise-read: takes one run id, got a second: $1" >&2 ; return 1 ; }
				readRun="$1" ; shift
			;;
		esac
	done
	case "$readRun" in ''|*/*|.|..)
		echo "$MDSC_CMD: ⛔ ERROR: --supervise-read: syntax is <run-id> [--tail <n>] [--thread-lines <n>] [--no-thread] [--no-checklist] [--log]" >&2 ; return 1 ;;
	esac
	for readAny in "$readTail" "$readThreadLines" ; do
		case "$readAny" in ''|*[!0123456789]*|0) echo "$MDSC_CMD: ⛔ ERROR: --supervise-read: a count must be a whole number above zero, got: $readAny" >&2 ; return 1 ;; esac
	done
	type AgentsToolsSpawnRecord > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/run/AgentsTools.RunRecords.include"
	type AgentsToolsFrontmatterKey > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/common/AgentsTools.FrontmatterKey.include"
	type AgentsSessionRunSandboxInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/spawn/AgentsTools.SpawnSandbox.include"
	type AgentsTranscriptRunTail > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionTranscript.include"
	readRecord="$( AgentsToolsSpawnRecord "$readRun" )"
	[ -n "$readRecord" ] || { echo "$MDSC_CMD: ⛔ ERROR: --supervise-read: no record of this workspace carries the run $readRun" >&2 ; return 1 ; }
	AgentsSessionRunSandboxInto readSandbox "$readRun" || readSandbox=""
	readMember="$( AgentsToolsFrontmatterKey "$readRecord" owner )"
	readSession="$( AgentsToolsFrontmatterKey "$readRecord" session-id )"
	readStatus="$( AgentsToolsFrontmatterKey "$readRecord" status )"
	readAny=gone
	AgentsToolsSpawnRuns "$readRun" "$readRecord" > /dev/null 2>&1 && readAny=running
	printf 'run\t%s\t%s\t%s\t%s\t%s\n' "$readRun" "${readMember:--}" "${readSession:--}" "${readStatus:--}" "$readAny"
	## The transcript: every part of it, its last lines taken together, from its owner. A run that kept none reads `-`.
	## THE RUN'S OWN TRANSCRIPT FIRST: the session's pointers name the log of its FIRST run, so a later run of the session
	## (a restart, a second leg) read from them alone was read from an old log that ended before it began.
	readAny="-"
	while IFS= read -r readLine || [ -n "$readLine" ] ; do
		if [ "$readAny" = "-" ] ; then [ -n "$readLine" ] || break ; readAny="$readLine" ; printf 'transcript\t%s\n' "$readAny" ; continue ; fi
		printf 'tail\t%s\n' "$readLine"
	done <<< "$( AgentsTranscriptRunTail "$readRun" "$readSandbox" "$readSession" "$readTail" )"
	[ "$readAny" != "-" ] || printf 'transcript\t-\n'
	## The thread: the session's own, read from the chat file by the one reader of it, and cut to its last messages.
	if [ "$readThread" = yes ] ; then
		readThreadValue="$( AgentsToolsFrontmatterKey "$readRecord" session-thread )"
		case "$readThreadValue" in ''|-) readThreadValue="$( AgentsSpawnedThreadOfRecord "$readRecord" )" ;; esac
		printf 'thread\t%s\n' "${readThreadValue:--}"
		if [ -n "$readThreadValue" ] ; then
			type AgentsToolsSessionChatThreadMessages > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionChat.include"
			readMemberId="$( AgentsSlackIdentityId "${readMember:--}" 2> /dev/null )" || readMemberId=""
			AgentsToolsSessionChatThreadMessages "${readSession:-$readRun}" "$readThreadValue" "${readMember:--}" "$readMemberId" "$readThreadLines" \
				| while IFS= read -r readLine ; do printf 'message\t%s\n' "$readLine" ; done
		fi
	fi
	## The CheckList: the file the CheckList tool keeps for that member, in the sandbox of the run.
	if [ "$readChecklist" = yes ] ; then
		readAny="-"
		case "$readMember" in ''|-|.|..|*/*) ;; *)
			while IFS= read -r readLine || [ -n "$readLine" ] ; do
				if [ "$readAny" = "-" ] ; then [ -n "$readLine" ] || break ; readAny="$readLine" ; printf 'checklist\t%s\t%s\n' "$readMember" "$readAny" ; continue ; fi
				[ -n "$readLine" ] || continue
				printf 'item\t%s\n' "$readLine"
			done <<< "$( AgentsSessionSandboxChecklistLines "$readSandbox" "$readMember" )"
		;; esac
		[ "$readAny" != "-" ] || printf 'checklist\t%s\t-\n' "${readMember:--}"
	fi
	## The session log: the run's own, in its sandbox, else in the store of its session.
	if [ "$readLog" = yes ] ; then
		readAny="-"
		while IFS= read -r readLine || [ -n "$readLine" ] ; do
			if [ "$readAny" = "-" ] ; then [ -n "$readLine" ] || break ; readAny="$readLine" ; printf 'log\t%s\n' "$readAny" ; continue ; fi
			printf 'logline\t%s\n' "$readLine"
		done <<< "$( AgentsSessionSandboxLogTail "$readSandbox" "${readSession:-$readRun}" "$readTail" )"
		[ "$readAny" != "-" ] || printf 'log\t-\n'
	fi
	return 0
}
