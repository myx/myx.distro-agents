#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

## AgentsHarnessHooksLoad.include -- how the PreToolUse hook list is loaded from a
## workspace's .claude/settings.json: the one loader, sourced by AgentsHarnessHooks.sh
## (at every harness start) and by the installer's --make-harness-indices (to write the
## index the harness then reads instead).
##
## THE INDEX, .local/agents/harness.hooks.index, holds what this loader concluded --
## the list, the fault, the skipped count -- beside the exact inputs it concluded it from:
## the settings.json content, the deny-reroute key list, and this file's own content. The
## harness takes the index only while all three are byte for byte what they are now,
## so a settings.json edited since, a policy changed since or a loader upgraded since is
## loaded the slow way, with the same answer. Nothing in the index is ever trusted
## beyond that comparison, and that comparison is builtins only.
##
## Format, version 1, every free-text field encoded for `printf '%b'` (backslash doubled,
## newline as \n, TAB as \t):
##   myx.distro harness.hooks.index 1
## then one section per origin a harness may run from, each:
##   source <TAB> present:<settings.json content>
##   reroute <TAB> <the reroute key list>
##   loader <TAB> <this file's content>
##   fault <TAB> <fault>
##   skipped <TAB> <count>
##   list <TAB> <the matcher<TAB>command list>
##   end

agentsHooksLoadHere="${harnessHere:-$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib}"

## The settings.json walk, unchanged from the block it was lifted out of: every value it
## sets is the global the rest of AgentsHarnessHooks.sh reads. Called only where the
## caller has established the settings file exists, and no fault is set yet.
AgentsHarnessHooksLoadSettings(){
	if [ ! -f "$MMDAPP/.claude/settings.json" ] || [ ! -r "$MMDAPP/.claude/settings.json" ] ; then
		harnessHooksFault="$MMDAPP/.claude/settings.json exists but is not a readable file"
	else
		harnessHooksDoc="$( cat "$MMDAPP/.claude/settings.json" )"
		harnessHooksRc=0
		harnessHooksEntryCount="$( printf '%s\n' "$harnessHooksDoc" | LC_ALL=C awk -v path=hooks.PreToolUse.__count -v optional=1 -f "$agentsHooksLoadHere/AgentsHarnessJsonField.awk" 2>/dev/null )" || harnessHooksRc=$?
		## rc 3 is the settled "this workspace configures no PreToolUse hook" answer and
		## leaves everything below inert; anything else is a document we cannot vouch for.
		if [ "$harnessHooksRc" != "0" ] && [ "$harnessHooksRc" != "3" ] ; then
			harnessHooksFault="$MMDAPP/.claude/settings.json did not parse as one JSON object (rc=$harnessHooksRc)"
		elif [ "$harnessHooksRc" = "0" ] ; then
			harnessHooksEntry=0
			while [ "$harnessHooksEntry" -lt "$harnessHooksEntryCount" ] 2>/dev/null ; do
				## An absent matcher is claude's own "every tool", so rc 3 leaves it empty.
				harnessHooksMatcher="$( printf '%s\n' "$harnessHooksDoc" | LC_ALL=C awk -v path="hooks.PreToolUse.$harnessHooksEntry.matcher" -v optional=1 -f "$agentsHooksLoadHere/AgentsHarnessJsonField.awk" 2>/dev/null )" || harnessHooksMatcher=""
				harnessHooksRc=0
				harnessHooksInnerCount="$( printf '%s\n' "$harnessHooksDoc" | LC_ALL=C awk -v path="hooks.PreToolUse.$harnessHooksEntry.hooks.__count" -v optional=1 -f "$agentsHooksLoadHere/AgentsHarnessJsonField.awk" 2>/dev/null )" || harnessHooksRc=$?
				if [ "$harnessHooksRc" != "0" ] ; then
					harnessHooksFault="hooks.PreToolUse[$harnessHooksEntry] carries no readable hooks array"
					break
				fi
				harnessHooksInner=0
				while [ "$harnessHooksInner" -lt "$harnessHooksInnerCount" ] 2>/dev/null ; do
					harnessHooksType="$( printf '%s\n' "$harnessHooksDoc" | LC_ALL=C awk -v path="hooks.PreToolUse.$harnessHooksEntry.hooks.$harnessHooksInner.type" -v optional=1 -f "$agentsHooksLoadHere/AgentsHarnessJsonField.awk" 2>/dev/null )" || harnessHooksType=""
					harnessHooksCommand="$( printf '%s\n' "$harnessHooksDoc" | LC_ALL=C awk -v path="hooks.PreToolUse.$harnessHooksEntry.hooks.$harnessHooksInner.command" -v optional=1 -f "$agentsHooksLoadHere/AgentsHarnessJsonField.awk" 2>/dev/null )" || harnessHooksCommand=""
					## A type this cannot run, and a separator inside a field, are both
					## "not understood" -- which is refusal to proceed, never a silent skip.
					if [ "$harnessHooksType" != "command" ] || [ -z "$harnessHooksCommand" ] ; then
						harnessHooksFault="hooks.PreToolUse[$harnessHooksEntry].hooks[$harnessHooksInner] is not a runnable command hook"
						break
					fi
					## The class filter, and it sits here rather than in the decision
					## path so a skipped entry never reaches one. Matched as a plain
					## substring of the command, the same way the installed hooks are
					## already recognised, and by builtins alone.
					harnessHooksReroute=""
					for harnessHooksRerouteKey in ${harnessHooksRerouteKeys[@]+"${harnessHooksRerouteKeys[@]}"} ; do
						case "$harnessHooksCommand" in
							*"$harnessHooksRerouteKey"*) harnessHooksReroute=1 ; break ;;
						esac
					done
					if [ -n "$harnessHooksReroute" ] ; then
						harnessHooksSkipped=$(( harnessHooksSkipped + 1 ))
						harnessHooksInner=$(( harnessHooksInner + 1 ))
						continue
					fi
					case "$harnessHooksMatcher$harnessHooksCommand" in
						*$'\t'*|*$'\n'*)
							harnessHooksFault="hooks.PreToolUse[$harnessHooksEntry] carries a tab or newline this cannot represent"
							break
						;;
					esac
					harnessHooksList="${harnessHooksList}${harnessHooksMatcher}"$'\t'"${harnessHooksCommand}"$'\n'
					harnessHooksInner=$(( harnessHooksInner + 1 ))
				done
				[ -z "$harnessHooksFault" ] || break
				harnessHooksEntry=$(( harnessHooksEntry + 1 ))
			done
		fi
	fi
}

## Encoded for `printf '%b'`, into agentsHooksEnc; decoded, into agentsHooksDec.
agentsHooksEnc=""
agentsHooksDec=""
AgentsHarnessHooksEnc(){ ## text
	agentsHooksEnc="${1//\\/\\\\}"
	agentsHooksEnc="${agentsHooksEnc//$'\n'/\\n}"
	agentsHooksEnc="${agentsHooksEnc//$'\t'/\\t}"
}
AgentsHarnessHooksDec(){ ## encoded text -- never `printf -v` an empty result: bash 3.2 keeps the last buffer
	agentsHooksDec=""
	[ -z "$1" ] || printf -v agentsHooksDec '%b' "$1"
}

## A file's whole content by builtins, into agentsHooksRaw; non-zero when unreadable.
agentsHooksRaw=""
AgentsHarnessHooksRaw(){ ## file
	agentsHooksRaw=""
	[ -f "$1" ] && [ -r "$1" ] || return 1
	IFS= read -r -d '' agentsHooksRaw < "$1" || :
}

## One section of the index, on stdout, for the origin this shell runs from: this
## loader's own answer for the workspace's settings.json, beside the reroute key list the
## caller computed as the harness computes it. Non-zero, printing nothing, when there is
## no readable settings.json -- the harness then loads exactly as before -- or it changed
## while this ran. One section per origin, as the roots index has; the file as a whole is
## the caller's to write atomically.
AgentsHarnessHooksIndexSection(){ ## workspace, reroute key list
	local writeWorkspace="$1" writeReroute="$2" writeSource writeLoader writeOut
	AgentsHarnessHooksRaw "$writeWorkspace/.claude/settings.json" || return 1
	writeSource="$agentsHooksRaw"
	AgentsHarnessHooksRaw "$agentsHooksLoadHere/AgentsHarnessHooksLoad.include" || return 1
	writeLoader="$agentsHooksRaw"
	writeOut="$(
		MMDAPP="$writeWorkspace"
		harnessHooksList="" harnessHooksFault="" harnessHooksSkipped=0
		harnessHooksRerouteKeys=()
		while IFS= read -r harnessHooksRerouteKey ; do
			[ -n "$harnessHooksRerouteKey" ] || continue
			harnessHooksRerouteKeys+=( "$harnessHooksRerouteKey" )
		done <<< "$writeReroute"
		AgentsHarnessHooksLoadSettings
		AgentsHarnessHooksEnc "present:$writeSource" ; printf 'source\t%s\n' "$agentsHooksEnc"
		AgentsHarnessHooksEnc "$writeReroute" ; printf 'reroute\t%s\n' "$agentsHooksEnc"
		AgentsHarnessHooksEnc "$writeLoader" ; printf 'loader\t%s\n' "$agentsHooksEnc"
		AgentsHarnessHooksEnc "$harnessHooksFault" ; printf 'fault\t%s\n' "$agentsHooksEnc"
		printf 'skipped\t%s\n' "$harnessHooksSkipped"
		AgentsHarnessHooksEnc "$harnessHooksList" ; printf 'list\t%s\n' "$agentsHooksEnc"
		printf 'end'
	)" || return 1
	## The settings must still be what was loaded, or the section would vouch for another file.
	AgentsHarnessHooksRaw "$writeWorkspace/.claude/settings.json" && [ "$agentsHooksRaw" = "$writeSource" ] || return 1
	printf '%s\n' "$writeOut"
}

## Sets harnessHooksList/Fault/Skipped from the index and answers zero only when one of
## its sections vouches for exactly these inputs: this settings.json content, this reroute
## key list ($harnessHooksRerouteList as the caller computed it) and this loader.
AgentsHarnessHooksIndexUse(){ ## settings file, index file
	local useLine useTag useRest useSource="" useReroute="" useLoader="" useFault="" useSkipped="" useList="" useIndexRaw useWant useLoaderNow
	AgentsHarnessHooksRaw "$2" || return 1
	useIndexRaw="$agentsHooksRaw"
	case "$useIndexRaw" in "myx.distro harness.hooks.index 1"$'\n'*) ;; *) return 1 ;; esac
	AgentsHarnessHooksRaw "$1" || return 1
	useWant="present:$agentsHooksRaw"
	AgentsHarnessHooksRaw "$agentsHooksLoadHere/AgentsHarnessHooksLoad.include" || return 1
	useLoaderNow="$agentsHooksRaw"
	while IFS= read -r useLine ; do
		useTag="${useLine%%$'\t'*}"
		useRest="${useLine#*$'\t'}"
		case "$useTag" in
			source) useSource="$useRest" ; useReroute="" useLoader="" useFault="" useSkipped="" useList="" ;;
			reroute) useReroute="$useRest" ;;
			loader) useLoader="$useRest" ;;
			fault) useFault="$useRest" ;;
			skipped) useSkipped="$useRest" ;;
			list) useList="$useRest" ;;
			end)
				[ -n "$useSkipped" ] || continue
				AgentsHarnessHooksDec "$useSource" ; [ "$agentsHooksDec" = "$useWant" ] || continue
				AgentsHarnessHooksDec "$useReroute" ; [ "$agentsHooksDec" = "$harnessHooksRerouteList" ] || continue
				AgentsHarnessHooksDec "$useLoader" ; [ "$agentsHooksDec" = "$useLoaderNow" ] || continue
				AgentsHarnessHooksDec "$useFault" ; harnessHooksFault="$agentsHooksDec"
				AgentsHarnessHooksDec "$useList" ; harnessHooksList="$agentsHooksDec"
				harnessHooksSkipped="$useSkipped"
				return 0
			;;
		esac
	done <<< "${useIndexRaw%$'\n'}"
	return 1
}
