#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

## AgentsTools.InternOpAtlassianCheck.include -- the operation `--intern-op-atlassian-check`, sourced by AgentsTools.InternOpAtlassianCall.include with the operation's arguments.
	type AgentsToolsAtlassianCall > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/atlassian/AgentsTools.AtlassianRequest.include"
		shift
		local checkMember="" checkProduct=""
		while [ $# -gt 0 ] ; do
			case "$1" in
				--member|--product)
					if [ -z "${2:-}" ] ; then
						printf '%s\n' "⛔ ERROR: $MDSC_CMD --intern-op-atlassian-check: $1 value missing" >&2
						set +e ; return 1
					fi
					case "$1" in
						--member)  checkMember="$2" ;;
						--product) checkProduct="$2" ;;
					esac
					shift 2
				;;
				*)
					printf '%s\n' "⛔ ERROR: $MDSC_CMD --intern-op-atlassian-check: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$checkMember" ] || [ -z "$checkProduct" ] ; then
			printf '%s\n' "⛔ ERROR: $MDSC_CMD --intern-op-atlassian-check: syntax is --member <team-member> --product jira|confluence -- the acting member is required, since this operation exists to say which Atlassian account that member's own credential resolves to" >&2
			set +e ; return 1
		fi
		## Each product names its own current-user endpoint; there is no shared one.
		local checkPath
		case "$checkProduct" in
			jira)       checkPath="/rest/api/3/myself" ;;
			confluence) checkPath="/wiki/rest/api/user/current" ;;
			*)
				printf '%s\n' "⛔ ERROR: $MDSC_CMD --intern-op-atlassian-check: --product invalid: $checkProduct" >&2
				set +e ; return 1
			;;
		esac
		local checkRc=0
		AgentsToolsAtlassianCall "$checkMember" "$checkProduct" GET "$checkPath" intern-op-atlassian-check "" || checkRc=$?
		if [ "$checkRc" -ne 0 ] ; then
			set +e ; return "$checkRc"
		fi
		return 0
