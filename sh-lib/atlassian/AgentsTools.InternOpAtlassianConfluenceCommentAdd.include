#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

## AgentsTools.InternOpAtlassianConfluenceCommentAdd.include -- the operation `--intern-op-atlassian-confluence-comment-add`, sourced by AgentsTools.InternOpAtlassianCall.include with the operation's arguments.
	type AgentsToolsAtlassianCall > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/atlassian/AgentsTools.AtlassianRequest.include"
		shift
		local confCAMember="" confCAPageId="" confCABodyStorage="" confCABodyGiven="false" confCAParentCommentId="" confCAContext="intern-op-atlassian-confluence-comment-add"
		while [ $# -gt 0 ] ; do
			case "$1" in
				--member)  shift ; [ -n "${1:-}" ] || { printf '%s\n' "⛔ ERROR: $MDSC_CMD --$confCAContext: --member value missing" >&2 ; set +e ; return 1 ; } ; confCAMember="$1" ; shift ;;
				--page-id) shift ; [ -n "${1:-}" ] || { printf '%s\n' "⛔ ERROR: $MDSC_CMD --$confCAContext: --page-id value missing" >&2 ; set +e ; return 1 ; } ; confCAPageId="$1" ; shift ;;
				--body-storage)
					shift ; [ -n "${1:-}" ] || { printf '%s\n' "⛔ ERROR: $MDSC_CMD --$confCAContext: --body-storage value missing" >&2 ; set +e ; return 1 ; }
					confCABodyStorage="$1" ; confCABodyGiven="true" ; shift
				;;
				--body-storage-from-stdin)
					confCABodyStorage="$( cat )" ; confCABodyGiven="true" ; shift
				;;
				--body-storage-from-file)
					shift
					if [ -z "${1:-}" ] || [ ! -f "$1" ] ; then
						printf '%s\n' "⛔ ERROR: $MDSC_CMD --$confCAContext: --body-storage-from-file: file not found: ${1:-}" >&2
						set +e ; return 1
					fi
					confCABodyStorage="$( cat "$1" )" ; confCABodyGiven="true" ; shift
				;;
				--parent-comment-id) shift ; [ -n "${1:-}" ] || { printf '%s\n' "⛔ ERROR: $MDSC_CMD --$confCAContext: --parent-comment-id value missing" >&2 ; set +e ; return 1 ; } ; confCAParentCommentId="$1" ; shift ;;
				--context) shift ; [ -n "${1:-}" ] || { printf '%s\n' "⛔ ERROR: $MDSC_CMD --$confCAContext: --context value missing" >&2 ; set +e ; return 1 ; } ; confCAContext="$1" ; shift ;;
				*)
					printf '%s\n' "⛔ ERROR: $MDSC_CMD --$confCAContext: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$confCAMember" ] || [ -z "$confCAPageId" ] ; then
			printf '%s\n' "⛔ ERROR: $MDSC_CMD --$confCAContext: syntax is --member <team-member> --page-id <page-id> (--body-storage <html>|--body-storage-from-stdin|--body-storage-from-file <path>) [--parent-comment-id <id>] [--context <caller>] -- there is no ADF path here, same as the read side: the body is always Confluence's own storage format" >&2
			set +e ; return 1
		fi
		AgentsToolsAtlassianAssertNumber "$confCAPageId" "<page-id>" "$confCAContext" || { set +e ; return 1 ; }
		if [ "$confCABodyGiven" != "true" ] ; then
			printf '%s\n' "⛔ ERROR: $MDSC_CMD --$confCAContext: --body-storage|--body-storage-from-stdin|--body-storage-from-file missing" >&2
			set +e ; return 1
		fi
		if [ -n "$confCAParentCommentId" ] ; then
			case "$confCAParentCommentId" in
				*[!0123456789]*)
					printf '%s\n' "⛔ ERROR: $MDSC_CMD --$confCAContext: --parent-comment-id not a number: $confCAParentCommentId" >&2
					set +e ; return 1
				;;
			esac
			local confCAParentBody confCAParentRc=0
			confCAParentBody="$( AgentsToolsAtlassianCall "$confCAMember" confluence GET "/wiki/api/v2/footer-comments/$confCAParentCommentId" "$confCAContext" "" )" || confCAParentRc=$?
			if [ "$confCAParentRc" -ne 0 ] ; then
				set +e ; return "$confCAParentRc"
			fi
			local confCAParentPageId="$( printf '%s\n' "$confCAParentBody" | LC_ALL=C awk -v path=pageId -v optional=1 -v dialect=atlassian -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsHarnessJsonField.awk" 2>/dev/null )"
			if [ "$confCAParentPageId" != "$confCAPageId" ] ; then
				printf '%s\n' "⛔ ERROR: $MDSC_CMD --$confCAContext: parent comment $confCAParentCommentId belongs to page ${confCAParentPageId:-<not stated in the response>}, not page $confCAPageId -- the reply was NOT posted" >&2
				set +e ; return 1
			fi
		fi
		local confCAPageIdEsc confCABodyEsc
		confCAPageIdEsc="$( printf '%s' "$confCAPageId" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/mcp/AgentsMcpJsonEscape.awk" )"
		confCABodyEsc="$( printf '%s' "$confCABodyStorage" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/mcp/AgentsMcpJsonEscape.awk" )"
		local confCABody
		if [ -n "$confCAParentCommentId" ] ; then
			confCABody="{\"parentCommentId\":\"$confCAParentCommentId\",\"body\":{\"representation\":\"storage\",\"value\":\"$confCABodyEsc\"}}"
		else
			confCABody="{\"pageId\":\"$confCAPageIdEsc\",\"body\":{\"representation\":\"storage\",\"value\":\"$confCABodyEsc\"}}"
		fi
		local confCARc=0
		AgentsToolsAtlassianCall "$confCAMember" confluence POST /wiki/api/v2/footer-comments "$confCAContext" "$confCABody" || confCARc=$?
		if [ "$confCARc" -ne 0 ] ; then
			set +e ; return "$confCARc"
		fi
		return 0
