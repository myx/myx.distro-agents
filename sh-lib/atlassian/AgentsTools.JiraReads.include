#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.JiraReads.include -- Jira reads as the acting member: one issue, its remote links, and the agile board and sprint reads.
## Sourced, never run. Functions only. Each function loads what it calls itself.
##

AgentsToolsJiraAgileRead() {
	type AgentsToolsAtlassianCall > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/atlassian/AgentsTools.AtlassianRequest.include"
	local agileMember="$1" agilePath="$2" agileContext="$3" agileStartAt="$4" agileLimit="$5" agileArray="$6"
	local agileJoin="?"
	case "$agilePath" in *'?'*) agileJoin="&" ;; esac
	if [ -n "$agileStartAt" ] ; then agilePath="$agilePath${agileJoin}startAt=$agileStartAt" ; agileJoin="&" ; fi
	## Jira spells the page size maxResults; --limit is this package's own
	## caller-facing spelling, shared with the Confluence listings.
	if [ -n "$agileLimit" ] ; then agilePath="$agilePath${agileJoin}maxResults=$agileLimit" ; fi
	local agileBody agileRc=0
	agileBody="$( AgentsToolsAtlassianCall "$agileMember" jira GET "$agilePath" "$agileContext" "" )" || agileRc=$?
	if [ "$agileRc" -ne 0 ] ; then
		return "$agileRc"
	fi
	printf '%s\n' "$agileBody"
	if [ -n "$agileArray" ] ; then
		local agileFieldAwk="$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsHarnessJsonField.awk"
		local agileTotal="$( printf '%s\n' "$agileBody" | LC_ALL=C awk -v path=total -v optional=1 -v dialect=atlassian -f "$agileFieldAwk" 2>/dev/null )"
		local agileRespStart="$( printf '%s\n' "$agileBody" | LC_ALL=C awk -v path=startAt -v optional=1 -v dialect=atlassian -f "$agileFieldAwk" 2>/dev/null )"
		local agileRows agileCount=0 agileRowsRc=0
		agileRows="$( printf '%s\n' "$agileBody" | LC_ALL=C awk -v array="$agileArray" -v want=key -v mode=records -v dialect=atlassian -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsHarnessJsonField.awk" 2>/dev/null )" || agileRowsRc=$?
		if [ "$agileRowsRc" -ne 0 ] ; then
			printf '%s\n' "# $agileContext: more: unknown -- this response carried no readable $agileArray array, so the rows on this page cannot be counted. That is NOT a confirmation that the page is complete" >&2
			return 0
		fi
		[ -z "$agileRows" ] || agileCount="$( printf '%s\n' "$agileRows" | LC_ALL=C awk 'END { print NR ; }' )"
		case "$agileTotal" in
			''|*[!0123456789]*)
				printf '%s\n' "# $agileContext: more: unknown -- this response carried no numeric total, so whether rows exist beyond the $agileCount here cannot be told from it. That is NOT a confirmation that the page is complete" >&2
			;;
			*)
				case "$agileRespStart" in
					''|*[!0123456789]*)
						printf '%s\n' "# $agileContext: more: unknown -- this response carried no numeric startAt, so completeness cannot be computed from it. That is NOT a confirmation that the page is complete" >&2
					;;
					*)
						if [ "$(( agileRespStart + agileCount ))" -lt "$agileTotal" ] ; then
							printf '%s\n' "# $agileContext: more: yes -- $agileTotal rows in total; this page starts at $agileRespStart and carries $agileCount, so the rest were not read. Pass $(( agileRespStart + agileCount )) back as --start-at" >&2
						elif [ "$agileCount" -eq 0 ] ; then
							printf '%s\n' "# $agileContext: more: no -- $agileTotal rows in total; this page starts at $agileRespStart and carries none" >&2
						else
							printf '%s\n' "# $agileContext: more: no -- $agileTotal rows in total; this page starts at $agileRespStart and ends at the last of them" >&2
						fi
					;;
				esac
			;;
		esac
		return 0
	fi
	local agileIsLast="$( printf '%s\n' "$agileBody" | LC_ALL=C awk -v path=isLast -v optional=1 -v dialect=atlassian -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsHarnessJsonField.awk" 2>/dev/null )"
	case "$agileIsLast" in
		true)
			printf '%s\n' "# $agileContext: more: no -- the site reported isLast=true, so the rows above are the complete set visible to $agileMember" >&2
		;;
		false)
			printf '%s\n' "# $agileContext: more: yes -- MORE RESULTS EXIST beyond this page and were not read. Read this page's own startAt and maxResults from the body above and pass their sum back as --start-at" >&2
		;;
		*)
			printf '%s\n' "# $agileContext: more: unknown -- this response carried no isLast field, so whether more results exist cannot be told from it. That is NOT a confirmation that the page is complete" >&2
		;;
	esac
	return 0
}

## One Jira issue, read as the acting member: in-context helper, no operation of its own
## (MAGIC.md, section 1). Diagnostics on stderr; the description (adf), the rendered
## description, or the whole raw body on stdout. Exit codes as in this file's header.
AgentsToolsAtlassianJiraIssueRead() { ## --member <team-member> --issue-key <issue-key> [--format adf|rendered|raw] [--context <caller>]
	type AgentsToolsAtlassianArgsOnce > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/atlassian/AgentsTools.AtlassianRequest.include"
	local MDSC_CMD='DistroAgentsTools'
	AgentsToolsAtlassianArgsOnce "$@" || { set +e ; return 1 ; }
	local jiraReadMember="" jiraReadKeyArg="" jiraReadFormat="" jiraReadContext="atlassian-jira-issue-read"
	while [ $# -gt 0 ] ; do
		case "$1" in
			--member|--issue-key|--format|--context)
				if [ -z "${2:-}" ] ; then
					printf '%s\n' "⛔ ERROR: $MDSC_CMD --$jiraReadContext: $1 value missing" >&2
					set +e ; return 1
				fi
				case "$1" in
					--member)    jiraReadMember="$2" ;;
					--issue-key) jiraReadKeyArg="$2" ;;
					--format)    jiraReadFormat="$2" ;;
					--context)   jiraReadContext="$2" ;;
				esac
				shift 2
			;;
			*)
				printf '%s\n' "⛔ ERROR: $MDSC_CMD --$jiraReadContext: invalid option: $1" >&2
				set +e ; return 1
			;;
		esac
	done
	if [ -z "$jiraReadMember" ] || [ -z "$jiraReadKeyArg" ] ; then
		printf '%s\n' "⛔ ERROR: $MDSC_CMD --$jiraReadContext: syntax is --member <team-member> --issue-key <issue-key> [--format adf|rendered|raw] [--context <caller>] -- the acting member is required, since an issue is readable only by identities its project is shared with" >&2
		set +e ; return 1
	fi
	AgentsToolsAssertBareName "$jiraReadKeyArg" "<issue-key>" "$jiraReadContext" || { set +e ; return 1 ; }
	[ -n "$jiraReadFormat" ] || jiraReadFormat=adf
	case "$jiraReadFormat" in
		adf|rendered|raw) ;;
		*) printf '%s\n' "⛔ ERROR: $MDSC_CMD --$jiraReadContext: --format invalid: $jiraReadFormat" >&2 ; set +e ; return 1 ;;
	esac
	## raw asks for every field (--fields-json/--update-json on the write side
	## is unconstrained, so a fixed field list cannot speak for what a write
	## could change); adf/rendered keep the original fixed, human-read list.
	local jiraReadFieldsParam="summary,status,assignee,reporter,priority,issuetype,resolution,labels,created,updated,description"
	[ "$jiraReadFormat" = raw ] && jiraReadFieldsParam="*all"
	local jiraReadPath="/rest/api/3/issue/$( AgentsToolsAtlassianUrlEncode "$jiraReadKeyArg" )?fields=$( AgentsToolsAtlassianUrlEncode "$jiraReadFieldsParam" )"
	[ "$jiraReadFormat" = rendered ] && jiraReadPath="${jiraReadPath}&expand=renderedFields"
	local jiraReadBody jiraReadRc=0
	jiraReadBody="$( AgentsToolsAtlassianCall "$jiraReadMember" jira GET "$jiraReadPath" "$jiraReadContext" "" )" || jiraReadRc=$?
	if [ "$jiraReadRc" -ne 0 ] ; then
		set +e ; return "$jiraReadRc"
	fi
	local jiraReadFieldAwk="$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsHarnessJsonField.awk"
	local jiraReadKeySeen="$( printf '%s\n' "$jiraReadBody" | LC_ALL=C awk -v path=key -v optional=1 -v dialect=atlassian -f "$jiraReadFieldAwk" 2>/dev/null )"
	[ -n "$jiraReadKeySeen" ] || jiraReadKeySeen="$jiraReadKeyArg"
	local jiraReadLabels="$( printf '%s\n' "$jiraReadBody" | LC_ALL=C awk -v path=fields.labels -v raw=1 -v dialect=atlassian -f "$jiraReadFieldAwk" 2>/dev/null | sed -e 's/^\[//' -e 's/\]$//' -e 's/"//g' )"
	printf '# issue %s: type=%s status=%s resolution=%s assignee=%s reporter=%s priority=%s created=%s updated=%s labels=%s format=%s\n' \
		"$jiraReadKeySeen" \
		"$( printf '%s\n' "$jiraReadBody" | LC_ALL=C awk -v path=fields.issuetype.name -v optional=1 -v dialect=atlassian -f "$jiraReadFieldAwk" 2>/dev/null )" \
		"$( printf '%s\n' "$jiraReadBody" | LC_ALL=C awk -v path=fields.status.name -v optional=1 -v dialect=atlassian -f "$jiraReadFieldAwk" 2>/dev/null )" \
		"$( printf '%s\n' "$jiraReadBody" | LC_ALL=C awk -v path=fields.resolution.name -v optional=1 -v dialect=atlassian -f "$jiraReadFieldAwk" 2>/dev/null )" \
		"$( printf '%s\n' "$jiraReadBody" | LC_ALL=C awk -v path=fields.assignee.displayName -v optional=1 -v dialect=atlassian -f "$jiraReadFieldAwk" 2>/dev/null )" \
		"$( printf '%s\n' "$jiraReadBody" | LC_ALL=C awk -v path=fields.reporter.displayName -v optional=1 -v dialect=atlassian -f "$jiraReadFieldAwk" 2>/dev/null )" \
		"$( printf '%s\n' "$jiraReadBody" | LC_ALL=C awk -v path=fields.priority.name -v optional=1 -v dialect=atlassian -f "$jiraReadFieldAwk" 2>/dev/null )" \
		"$( printf '%s\n' "$jiraReadBody" | LC_ALL=C awk -v path=fields.created -v optional=1 -v dialect=atlassian -f "$jiraReadFieldAwk" 2>/dev/null )" \
		"$( printf '%s\n' "$jiraReadBody" | LC_ALL=C awk -v path=fields.updated -v optional=1 -v dialect=atlassian -f "$jiraReadFieldAwk" 2>/dev/null )" \
		"$jiraReadLabels" \
		"$jiraReadFormat" >&2
	printf '# issue %s: summary=%s\n' "$jiraReadKeySeen" "$( printf '%s\n' "$jiraReadBody" | LC_ALL=C awk -v path=fields.summary -v optional=1 -v dialect=atlassian -f "$jiraReadFieldAwk" 2>/dev/null )" >&2
	if [ "$jiraReadFormat" = raw ] ; then
		## The already-fetched response body, verbatim -- every field the API
		## returned for this issue, not only the 10 named ones above. No second
		## call: this is the same $jiraReadBody the diagnostics just read from.
		printf '%s' "$jiraReadBody"
		return 0
	fi
	if [ "$jiraReadFormat" = rendered ] ; then
		local jiraReadRendered="$( printf '%s\n' "$jiraReadBody" | LC_ALL=C awk -v path=renderedFields.description -v dialect=atlassian -f "$jiraReadFieldAwk" 2>/dev/null )"
		if [ -z "$jiraReadRendered" ] ; then
			printf '%s\n' "⛔ ERROR: $MDSC_CMD --$jiraReadContext: renderedFields description unreadable" >&2
			set +e ; return 3
		fi
		printf '%s' "$jiraReadRendered"
		return 0
	fi
	local jiraReadDescription jiraReadDescRc=0
	jiraReadDescription="$( printf '%s\n' "$jiraReadBody" | LC_ALL=C awk -v path=fields.description -v raw=1 -v dialect=atlassian -f "$jiraReadFieldAwk" 2>/dev/null )" || jiraReadDescRc=$?
	if [ "$jiraReadDescRc" -ne 0 ] ; then
		printf '%s\n' "⛔ ERROR: $MDSC_CMD --$jiraReadContext: description field unreadable" >&2
		set +e ; return 3
	fi
	if [ -z "$jiraReadDescription" ] ; then
		printf '%s\n' "# issue $jiraReadKeySeen: this issue really has no description -- the field was returned and its value is null, which is an answer, not a failed read" >&2
	else
		printf '%s\n' "$jiraReadDescription"
	fi
	return 0
}

## The remote links an issue holds, read as the acting member: in-context helper, no
## operation of its own (MAGIC.md, section 1). The site answers one bare array, and the
## package's reader takes one object, so the body is wrapped under one key before it is
## read; a body that is no array then reads as UNKNOWN rather than as no links.
AgentsToolsAtlassianJiraIssueLinkList() { ## --member <team-member> --issue-key <issue-key> [--context <caller>]
	type AgentsToolsAtlassianArgsOnce > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/atlassian/AgentsTools.AtlassianRequest.include"
	local MDSC_CMD='DistroAgentsTools'
	AgentsToolsAtlassianArgsOnce "$@" || { set +e ; return 1 ; }
	local jiraLLMember="" jiraLLKeyArg="" jiraLLContext="atlassian-jira-issue-link-list"
	while [ $# -gt 0 ] ; do
		case "$1" in
			--member|--issue-key|--context)
				if [ -z "${2:-}" ] ; then
					printf '%s\n' "⛔ ERROR: $MDSC_CMD --$jiraLLContext: $1 value missing" >&2
					set +e ; return 1
				fi
				case "$1" in
					--member)    jiraLLMember="$2" ;;
					--issue-key) jiraLLKeyArg="$2" ;;
					--context)   jiraLLContext="$2" ;;
				esac
				shift 2
			;;
			*)
				printf '%s\n' "⛔ ERROR: $MDSC_CMD --$jiraLLContext: invalid option: $1" >&2
				set +e ; return 1
			;;
		esac
	done
	if [ -z "$jiraLLMember" ] || [ -z "$jiraLLKeyArg" ] ; then
		printf '%s\n' "⛔ ERROR: $MDSC_CMD --$jiraLLContext: syntax is --member <team-member> --issue-key <issue-key> [--context <caller>] -- the acting member is required, since an issue is readable only by identities its project is shared with" >&2
		set +e ; return 1
	fi
	AgentsToolsAssertBareName "$jiraLLKeyArg" "<issue-key>" "$jiraLLContext" || { set +e ; return 1 ; }
	local jiraLLBody jiraLLRc=0
	jiraLLBody="$( AgentsToolsAtlassianCall "$jiraLLMember" jira GET "/rest/api/3/issue/$( AgentsToolsAtlassianUrlEncode "$jiraLLKeyArg" )/remotelink" "$jiraLLContext" "" )" || jiraLLRc=$?
	if [ "$jiraLLRc" -ne 0 ] ; then
		set +e ; return "$jiraLLRc"
	fi
	local jiraLLRows jiraLLRowsRc=0
	jiraLLRows="$( printf '{"links":%s}\n' "$jiraLLBody" | LC_ALL=C awk -v array=links -v want='id,object.url,object.title' -v mode=records -v dialect=atlassian -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsHarnessJsonField.awk" )" || jiraLLRowsRc=$?
	if [ "$jiraLLRowsRc" -ne 0 ] ; then
		printf '%s\n' "⛔ ERROR: $MDSC_CMD --$jiraLLContext: the remote links of issue $jiraLLKeyArg are UNKNOWN, not empty -- the answer was not the array of links this operation reads" >&2
		set +e ; return 3
	fi
	printf 'LINK_ID\tURL\tTITLE\n'
	[ -z "$jiraLLRows" ] || printf '%s\n' "$jiraLLRows"
	printf '%s\n' "# $jiraLLContext: more: unknown -- this endpoint's answer carries no total and no paging field, so it cannot say whether it holds every link the issue has" >&2
	return 0
}
