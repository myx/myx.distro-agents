#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## The manager screen of the agents console: starts sh-lib/AgentsManagerScreen.py in
## this terminal, for this workspace, with this dispatcher as its one way to the
## tooling. Sourced from DistroAgentsTools.fn.sh's `--intern-manager` arm; needs
## $1/$@/$MDSC_CMD from dot-sourcing. It is what the console's `--manager` runs: a
## generated console is a snapshot, so this name stays while the screen changes.
## It hands the screen the interface style of the start (THE STYLE OF THIS START, below):
## the screen's own code knows nothing of where a saved style is kept.
## The screen itself says, in one line, where it cannot start: a Python with no
## curses module, or no terminal.
##

case "$1" in

	--intern-manager)
		shift

		## Its one option: the interface style of this start alone, handed on as it is given.
		local managerStyle=""
		if [ "${1:-}" = "--style" ] && [ $# -eq 2 ] && [ -n "$2" ] ; then
			managerStyle="$2"
			shift 2
		fi

		if [ $# -gt 0 ] ; then
			printf '%s\n' "$MDSC_CMD --intern-manager -- starts the manager screen of the agents console in this terminal. Its one option is --style <name>, the interface style of this start." >&2
			printf '%s\n' "" >&2
			printf '%s\n' "  $MDSC_CMD --intern-manager [--style <name>]" >&2
			set +e ; return 1
		fi

		set +e

		local managerScreenFile="$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsManagerScreen.py"
		if [ ! -r "$managerScreenFile" ] ; then
			echo "$MDSC_CMD --intern-manager: ⛔ ERROR: the manager screen is missing or unreadable: $managerScreenFile" >&2
			return 1
		fi
		if ! command -v python3 > /dev/null 2>&1 ; then
			echo "$MDSC_CMD --intern-manager: ⛔ ERROR: the manager screen needs python3, and none is in PATH." >&2
			return 1
		fi

		## THE STYLE OF THIS START, the first of these that is there: the one named on the
		## command; the one the environment names (MDAT_MANAGER_STYLE), which the screen reads
		## itself, so nothing is handed on for it; the one the user saved, handed on as --style;
		## else the screen's own default. The saved one is asked of the digest of the settings,
		## whose line of the style says where its value comes from: it reads `user` only where
		## the environment names no style and the user saved one. So what the digest shows is
		## what a start takes. Where the digest cannot be read, nothing is handed on.
		if [ -z "$managerStyle" ] ; then
			managerStyle="$( DistroAgentsTools --manager-config-digest interface 2> /dev/null < /dev/null | LC_ALL=C awk -F'\t' '$1 == "line" && $4 == "MDAT_MANAGER_STYLE" && $7 == "user" { print $6 ; exit ; }' )" || managerStyle=""
		fi

		set -- --workspace "$MMDAPP" --tools "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
		[ -z "$managerStyle" ] || set -- "$@" --style "$managerStyle"

		## -I: nothing of the caller's own Python setup reaches the screen. -B: no bytecode is written into the source tree.
		python3 -I -B "$managerScreenFile" "$@"
		return $?
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;

esac
