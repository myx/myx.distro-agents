#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.InternOpSlackCheck.include -- the sweep machinery's own Slack
## reader: --intern-op-slack-check.
##
## Split out of the former single comms include (now gone, its arms divided
## between AgentsTools.MemberCommsSlack.include, AgentsTools.MemberCommsEmail.include and
## AgentsTools.MemberCommsTrello.include), where it was the one tenant that did not
## carry the --member-comms-<service>-<verb> name. It has
## its own file now for the same reason every other --intern-op-* primitive
## does (--intern-op-slack-call, --intern-op-check-slack-scopes,
## --intern-op-data-read and the rest): one internal primitive per include,
## reached from the dispatcher by its exact name. Leaving it among the Slack
## member ops would also have forced the --member-comms-slack-* route back
## into a by-name enumeration, which is precisely what the comms split exists
## to retire.
##
## Sourced lazily from DistroAgentsTools.fn.sh; relies on being dot-sourced
## for $1/$@/$MDSC_CMD and for the shared helper
## DistroAgentsToolsResolveTarget, which stays in the dispatcher because
## AgentsTools.MagicComms.include, AgentsTools.Member.include and
## AgentsTools.InternOpSessionContextScan.include all call it too.
##
## Internal rather than member-facing, but it still takes <team-member> first
## and that member IS the acting identity: the reader must know whose Slack
## identity the conversation is being read as.
##
## Supported operations:
##   --intern-op-slack-check
##
## THE API'S STATUS CODE IS NOT THE ANSWER TO THE QUESTION THE CALLER ASKED.
## An empty result must not read as success. What this arm reports is the
## outcome of the QUESTION its caller asked ("is there a reply?"), and Slack's
## own ok:true/ok:false is only evidence toward that answer, never the answer
## itself. The tolerance or the loud failure lives HERE, interpreting the
## result: --intern-op-slack-call's contract, that an ok:false never surfaces
## as rc 0, stays exactly as it is. Outcomes are told apart by POSITIVE tests
## on what is present -- a found element, a named error code -- never by a
## negation against an empty result, which is indistinguishable from "could
## not see anything".
##

case "$1" in

		## Reads Slack activity for ONE specific target -- a required
		## <magic-team|human-owner|event-track|event-alert|<conversation-id>|<channel>:<ts>>,
		## no "check everything" mode (that's --magic-sweep-input-scan's
		## job specifically, see AgentsTools.MagicSweep.include; conflating
		## the two is a real design bug). Deliberately
		## does NOT parse the Slack JSON response internally -- see the
		## --pretty/--raw handling near the bottom of this branch. Target
		## grammar mirrors --member-comms-slack-send-message's
		## (magic-team|human-owner|event-track|event-alert|<conversation-id>|<channel>:<ts>)
		## so a bare channel name means "history" and a <channel>:<ts> pair
		## means "replies in that thread" -- no new addressing scheme
		## invented. A bare <conversation-id> is accepted here too, and it
		## reads that conversation's history exactly as a bare alias does:
		## a new accepted spelling of an existing behaviour, not a new one.
		##
		## ONE TARGET IS NOT ALWAYS ONE CONVERSATION. The bare `human-owner`
		## target names a PARTY, and that party holds one DM per team identity,
		## so it reads both of them and merges them -- see this arm's own
		## fan-out block for the full reasoning, its per-DM counterparty
		## assertion, and the three outcomes it can report. Every other target
		## names exactly one conversation and is completely unaffected.
		--intern-op-slack-check)
			shift
			## Scope declaration for THIS arm's own endpoints. Declared separately
			## rather than shared with --member-comms-slack-read, and deliberately not
			## copied from it wholesale: each op owns its own contract, so one
			## changing its calls never silently moves another's requirements.
			## The two lists currently coincide, and that coincidence is not a
			## reason to merge them.
			##
			## conversations.history (bare channel target) / conversations.replies
			##   (<channel>:<ts> target) -- the *:history set.
			## conversations.info, when a caller turns the counterparty control on
			##   -- the *:read set, already declared here, so it adds nothing new.
			##   The bare `human-owner` target turns that control on itself, once
			##   per DM (see this arm's own fan-out block below), and reaches
			##   conversations.info a second time there as the cheapest carrier for
			##   the per-identity DM open -- same endpoint, same *:read set, so the
			##   declaration below is unchanged by it.
			## conversations.open, reached inside --intern-op-slack-call whenever
			##   --resolve-target below classifies the target as a party id (U/W)
			##   and a DM has to be opened under this call's own identity -- that
			##   is im:write, and it was missing from this declaration while the
			##   call path already reached it. The bare `human-owner` target reaches
			##   it once per identity rather than once in total; that changes how
			##   often it is called, never which scope it needs.
			if [ "$1" = "--print-required-scopes" ] ; then
				printf '%s\n' channels:read channels:history groups:read groups:history im:read im:history mpim:read mpim:history im:write
				return 0
			fi
			## <team-member> IS THE ACTING IDENTITY -- same change, same reason, as
			## --member-comms-slack-read's own leading argument, and made together with it
			## because this arm is the sweep machinery's own reader: a member-facing
			## scan built on a hardcoded `magic-coordinator` returns another
			## identity's conversations and reports them as the member's. Declared
			## separately here rather than shared with the sibling arm, the same way
			## the scope declarations above already are: each op owns its own
			## contract.
			local memberName="$1"
			shift || true
			if [ -z "$memberName" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --intern-op-slack-check: syntax is <team-member> <magic-team|human-owner|event-track|event-alert|<conversation-id>|<channel>:<ts>> [--oldest <ts>] [--identity-bot] [--raw] -- the acting member is required, since a direct conversation belongs to one identity and the member decides which conversation is read" >&2
				set +e ; return 1
			fi
			AgentsToolsAssertBareName "$memberName" "<team-member>" "$MDSC_CMD --intern-op-slack-check" || { set +e ; return 1 ; }
			case "$memberName" in
				routine-*)
					## Same routine-* carve-out as the sibling arms.
				;;
				*)
					if [ ! -d "$HOME/.claude/skills/$memberName" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --intern-op-slack-check: no such member skill directory: $HOME/.claude/skills/$memberName" >&2
						set +e ; return 1
					fi
				;;
			esac

			local target="$1"
			shift || true

			if [ -z "$target" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --intern-op-slack-check: target required (magic-team|human-owner|event-track|event-alert|<conversation-id>|<channel>:<ts>)" >&2
				set +e ; return 1
			fi

			## Pretty (formatted "ts | user | text" lines) is the default, not
			## an opt-in. --raw is the escape hatch for the rare case the full raw JSON is
			## actually needed (e.g. inspecting reply_count/thread metadata
			## fields the pretty formatter doesn't surface).
			##
			## --identity-bot is the same modifier the mutating arms already
			## carry, spelled identically here on purpose: this op resolves an
			## identity exactly as they do, and a caller that has learned the
			## flag on one arm must not find a second spelling on another.
			## Absent, the selection is left untouched, which is the identity
			## rule (member's own user token when it has one, else the team bot)
			## rather than a default this arm invents.
			local oldest pretty="true" identityAsBot="false"
			while [ $# -gt 0 ] ; do
				case "$1" in
					--oldest)
						oldest="$2" ; shift 2
					;;
					--raw)
						pretty="false" ; shift
					;;
					--identity-bot)
						identityAsBot="true" ; shift
					;;
					*)
						echo "⛔ ERROR: $MDSC_CMD --intern-op-slack-check: invalid option: $1" >&2
						set +e ; return 1
					;;
				esac
			done

			local resolved rc channel threadTs
			resolved="$( DistroAgentsToolsResolveTarget "$target" )" && rc=0 || rc=$?
			case "$rc" in
				0)
					channel="$( printf '%s\n' "$resolved" | sed -n 's/^CHANNEL=//p' )"
					## Unit-2 forward compatibility, deliberately INERT today: the
					## resolver emits no USER_ID= line yet, so this is "" and every
					## branch below behaves exactly as before. It exists so the
					## Unit-3 resolver flip has a reader already in place here --
					## the flip is gated on all seven of these existing.
					local targetUserId=""
					targetUserId="$( printf '%s\n' "$resolved" | sed -n 's/^USER_ID=//p' )" || targetUserId=""
					threadTs="$( printf '%s\n' "$resolved" | sed -n 's/^THREAD_TS=//p' )"
				;;
				2)
					echo "⛔ ERROR: $MDSC_CMD --intern-op-slack-check: unrecognized target: $target" >&2
					set +e ; return 1
				;;
				*)
					## The key named here must be the key that ACTUALLY backs the
					## target that failed. This op accepts four aliases, and naming a
					## fixed pair sent an `event-track`/`event-alert` reader to two
					## keys that have nothing to do with what they typed -- worse than
					## naming no key at all, because it reads as authoritative.
					##
					## Derived from the alias rather than listing all four: the reader
					## lands on exactly one key and does not have to work out which of
					## a list is theirs. The arms mirror DistroAgentsToolsResolveTarget's
					## own alias arms, stripping any `:<ts>` suffix the same way.
					##
					## A non-alias target (<conversation-id> or <channel>:<ts>) is
					## backed by NO config key -- it carried its own channel and that
					## channel came out empty -- so it is told that, instead of being
					## pointed at a key that was never involved.
					local targetKey=""
					case "${target%%:*}" in
						event-track)	targetKey="SLACK_CHANNEL_EVENT_TRACK" ;;
						event-alert)	targetKey="SLACK_CHANNEL_EVENT_ALERT" ;;
						magic-team)	targetKey="SLACK_CHANNEL_MAGIC_TEAM" ;;
						human-owner)	targetKey="SLACK_CHANNEL_HUMAN_OWNER" ;;
					esac
					if [ -n "$targetKey" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --intern-op-slack-check: could not resolve a channel for target '$target' -- check $targetKey in .local/.agents" >&2
					else
						echo "⛔ ERROR: $MDSC_CMD --intern-op-slack-check: could not resolve a channel for target '$target' -- it names a conversation directly, so no config key backs it; its channel part is empty" >&2
					fi
					set +e ; return 1
				;;
			esac

			## THE `human-owner` TARGET IS TWO CONVERSATIONS, NOT ONE.
			##
			## The team holds two Slack identities -- a member's own USER identity
			## and the shared BOT identity -- and the human-owner holds a separate
			## DM with each of them. Both DMs are real, both stay active, and the
			## human-owner's own messages land in whichever one they were written
			## in. A single-identity read therefore sees exactly one of the two and
			## reports the other one's contents as simply absent, which is the
			## defect this fan-out closes: the human-owner has ruled that this
			## target reads BOTH.
			##
			## WHY THE COUNTERPARTY CONTROL CANNOT TELL THE TWO DMs APART -- stated
			## here so nobody later "optimises" this block into a deduplicator.
			## Both DMs report the SAME counterparty, the human-owner, because that
			## is who both conversations are with. So --expect-counterparty answers
			## `match` for both, and it is CORRECT to: two DMs legitimately sharing
			## one counterparty is the normal, expected shape here, never a
			## collision, never a duplicate, never an error to reconcile. The
			## control answers exactly one question -- "is this conversation with
			## the party I expect?" -- and it is NOT an identity discriminator; it
			## cannot be used as one and must never be made into one. That is
			## precisely why the assertion below is run PER DM, individually: one
			## DM's verdict is never reused for the other, and the two DMs are
			## never compared against each other to decide anything.
			##
			## WHICH DM EACH LEG REACHES IS NOT DECIDED HERE, AND NO DM ID IS
			## HARDCODED. The party id comes from the resolver above, exactly as it
			## does for every other target, and --intern-op-slack-call opens the DM
			## for that party under whichever identity is acting -- a DM channel
			## belongs to one identity pair, so the acting identity IS the selector.
			## Each leg therefore names its own identity explicitly. That is an
			## enumeration of the two identities this one target genuinely spans,
			## not an identity downgrade: nothing here substitutes one identity for
			## another, and a leg whose identity is unavailable fails loud and
			## visibly rather than quietly collapsing onto the other identity's DM
			## and reporting one conversation twice as if it were two.
			##
			## SCOPE, deliberately narrow: the BARE `human-owner` target only, and
			## only while the resolver hands back a party id (U/W). `human-owner:<ts>`
			## names one exact message, which exists in exactly one of the two DMs,
			## so fanning it out would report a perfectly good thread read as
			## partial -- it keeps today's single-conversation behaviour untouched.
			## magic-team, event-track, event-alert and any explicit <channel>:<ts>
			## are single-conversation by construction and never reach this branch:
			## the `case` below matches one literal target word and nothing else.
			local fanOutParty=""
			case "$target" in
				human-owner)
					## Positive test on the id kind this fan-out needs, never a
					## negation against some other kind: only a party id can be
					## opened as a DM per identity. A human-owner alias configured
					## as a conversation id (C/D/G) names ONE fixed conversation
					## that belongs to one identity pair already, and falls through
					## to the single-conversation path below unchanged.
					case "$channel" in
						U*|W*) fanOutParty="$channel" ;;
					esac
				;;
			esac

			if [ -n "$fanOutParty" ] ; then
				echo "## target=$target channel=$fanOutParty (party id -- reads BOTH human-owner DMs, one per identity)"

				## One scratch directory, one trap, cleared at this block's own
				## single exit point below -- the same discipline the delete/edit
				## arms apply to their single diagnostic file, widened only because
				## this block holds several per-leg files at once. `mktemp -d`
				## creates it 0700 on Darwin/FreeBSD/Linux alike, which is what the
				## sibling arms' own `chmod 600` buys per file; the permission is on
				## the directory here so every file inside inherits the protection.
				local fanDir
				fanDir="$( mktemp -d )" || { set +e ; return 1 ; }
				trap 'rm -rf "$fanDir"' EXIT

				## Literal tab, built once. Used as the merge record's own field
				## separator below, for both `sort -t` and `awk -F`, so the two
				## always agree on what a field boundary is.
				local tabChar
				tabChar="$( printf '\t' )"

				local legIdentity legIndex=0
				local legOkCount=0
				local legProvenance="" legFailReport=""
				for legIdentity in user bot ; do
					legIndex=$(( legIndex + 1 ))
					local legDm="" legReason="" legDiag="" legRc=0 legResponse=""
					local legDmRc=0
					local legDiagFile="$fanDir/diag.$legIndex"
					## This leg's own DM-discovery response body, kept as a file
					## rather than a variable for the same reason $legDiagFile is:
					## the id this leg needs is read out of it by an awk pass, and
					## a file the reader opens directly cannot lose a trailing byte
					## the way a command substitution around the whole body would.
					local legInfoFile="$fanDir/info.$legIndex"

					## One leg, one failure variable, one break -- the same
					## single-failure-branch shape --intern-op-slack-call itself
					## uses. A leg that breaks out with $legReason set has failed;
					## a leg that reaches the bottom has succeeded. There is no
					## third state and no branch that substitutes the other
					## identity to make this leg succeed.
					while true ; do
						## STEP 1 -- discover THIS identity's own DM with the party.
						## conversations.info is simply the cheapest endpoint that
						## can carry --resolve-dm's own per-identity DM open.
						## --resolve-dm opens the DM under the acting identity and
						## injects it as that same call's `channel=` argument, so
						## the body conversations.info answers with IS that DM's own
						## channel object: `channel.id` in it is precisely the id
						## this leg needs. Nothing is hardcoded, and no DM id is
						## ever carried in config -- a DM id belongs to one identity
						## pair, so shared config is the one place it can never
						## correctly live.
						##
						## THE RESPONSE BODY IS KEPT, NOT DISCARDED, AND THAT IS THE
						## POINT. This call used to send stdout to /dev/null and
						## then recover the id from a DM_CHANNEL= line the op echoed
						## on stderr -- throwing away the body that already held the
						## value, to read a second copy of it out of a wire field
						## that existed for no other purpose. The field is gone (see
						## AgentsTools.InternOpSlackCall.include's own structured-
						## fields header); the body it duplicated is read here
						## directly, by full key path, through the same
						## sh-lib/AgentsSlackJsonField.awk every other Slack field
						## read in this package goes through.
						legRc=0
						DistroAgentsTools --intern-op-slack-call "$memberName" \
							--api conversations.info \
							--resolve-dm "$fanOutParty" \
							--identity "$legIdentity" \
							--context "--intern-op-slack-check human-owner ($legIdentity identity, DM discovery)" \
							>"$legInfoFile" 2>"$legDiagFile" || legRc=$?
						legDiag="$( cat "$legDiagFile" )"
						## Replayed unconditionally, same as the react/delete/edit
						## arms: the op's own words stay visible next to whatever
						## this block concludes from them.
						[ -z "$legDiag" ] || printf '%s\n' "$legDiag" >&2
						if [ "$legRc" != "0" ] ; then
							legReason="$( printf '%s\n' "$legDiag" | LC_ALL=C awk 'NF { last = $0; } END { if ( last != "" ) print last; }' )"
							break
						fi
						## PRESENCE IS THE READER'S EXIT STATUS, TESTED POSITIVELY,
						## never the printed string tested for emptiness -- the
						## reader's own contract, and the reason this leg can still
						## tell apart the two states it has always told apart:
						##   rc 3 -- the discovery call SUCCEEDED and this payload
						##           simply carries no channel.id, i.e. no DM for
						##           this party under this identity. A real,
						##           positive state of a call that worked.
						##   rc 1 -- the body was not a parseable Slack API response
						##           at all; the call's own rc said nothing was
						##           wrong, so this is the failed-read state and is
						##           NOT reported as "no DM".
						## `optional=1` is deliberately NOT passed: an absent
						## channel.id here is a fault worth seeing in the log, not
						## an expected optional field.
						legDmRc=0
						legDm="$( LC_ALL=C awk -v path=channel.id \
							-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsSlackJsonField.awk" \
							"$legInfoFile" )" || legDmRc=$?
						if [ "$legDmRc" = "3" ] ; then
							legReason="the DM-discovery call succeeded but reported no DM for party $fanOutParty under the $legIdentity identity -- its own conversations.info body carries no channel.id (field reader rc 3: that path is absent from this payload, which is not the same as a present-but-empty value)"
							break
						fi
						if [ "$legDmRc" != "0" ] ; then
							legReason="the DM-discovery call succeeded but its own conversations.info body could not be read for party $fanOutParty under the $legIdentity identity (field reader rc=$legDmRc -- 1: the body was not a parseable Slack API response, 2: the reader was called without a key path). This is a FAILED READ, not an absent DM: nothing here says whether that DM exists"
							break
						fi
						## Reached only on rc 0, so the path was genuinely present.
						## This is a value check, not the presence test -- presence
						## is already settled above. `channel.id` holding the empty
						## string is a state JSON can express and Slack never should:
						## an empty channel id is exactly what must not reach the
						## read below, the same refusal --intern-op-slack-call makes
						## at its own conversations.open site.
						if [ -z "$legDm" ] ; then
							legReason="the DM-discovery call reported channel.id as PRESENT but empty for party $fanOutParty under the $legIdentity identity -- refusing to carry an empty channel id into the conversation read"
							break
						fi

						## STEP 2 -- assert THIS DM's counterparty, individually,
						## then read it. Both happen inside one op call, and in
						## that order: --expect-counterparty runs before the API
						## call, so a DM that fails the assertion is never read.
						## The expected party is the resolver's own value, not a
						## constant written here. Per DM, never once for the pair,
						## for the reason this block's own header states.
						## ACTING MEMBER, NOT A CONSTANT -- and it must be the SAME
						## member STEP 1 discovered $legDm under, a few lines above.
						## A DM channel id belongs to one identity pair (this block's
						## own header states exactly that), so discovering the id as
						## member X and then reading it back as somebody else is the
						## identity substitution this whole arm exists to prevent,
						## committed inside a single loop iteration.
						local legOpArgs=( "$memberName" --api conversations.history \
							--resolve-target "$legDm" \
							--expect-counterparty "$fanOutParty" \
							--identity "$legIdentity" )
						## Positive test on presence: an absent --oldest is "not
						## asked for", exactly as on the single-conversation path.
						if [ -n "$oldest" ] ; then
							legOpArgs+=( --form "oldest=$oldest" )
						fi
						legOpArgs+=( --context "--intern-op-slack-check human-owner ($legIdentity identity, DM $legDm)" )

						echo "# $MDSC_CMD --intern-op-slack-check: GET conversations.history channel=$legDm (human-owner DM under $legIdentity identity, counterparty asserted against $fanOutParty)${oldest:+ oldest=$oldest}" >&2
						legRc=0
						legResponse="$( DistroAgentsTools --intern-op-slack-call "${legOpArgs[@]}" 2>"$legDiagFile" )" || legRc=$?
						legDiag="$( cat "$legDiagFile" )"
						[ -z "$legDiag" ] || printf '%s\n' "$legDiag" >&2
						if [ "$legRc" != "0" ] ; then
							legReason="$( printf '%s\n' "$legDiag" | LC_ALL=C awk 'NF { last = $0; } END { if ( last != "" ) print last; }' )"
							break
						fi

						## STEP 3 -- carry this leg's payload out with its own
						## provenance attached. --raw keeps the two API responses
						## as two labelled responses and never glues them into one
						## body: a concatenation of two JSON documents is not a
						## Slack response, and anything parsing it as one would be
						## parsing something no API ever returned.
						if [ "$pretty" = "true" ] ; then
							local legFmtRc=0
							printf '%s\n' "$legResponse" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsSlackMessagesFormat.awk" > "$fanDir/fmt.$legIndex" || legFmtRc=$?
							if [ "$legFmtRc" != "0" ] ; then
								legReason="the response was read but could not be formatted (the formatter's own error is above)"
								break
							fi
							## Merge record: <ts> <leg> <line-no> <dm> <H|C> <line>.
							## The formatter emits one record per message as
							## "<ts> | <user> | <text>", and a message text may
							## itself contain newlines, so a record can span
							## several physical lines. The head line is recognised
							## by a POSITIVE test for the record shape the
							## formatter actually prints -- a ts followed by
							## " | " -- and every following physical line inherits
							## that record's ts as a continuation, so a multi-line
							## message can never be torn apart by the sort below.
							## <leg> and <line-no> are the tie-breakers that make
							## the order total and therefore reproducible: same
							## two responses in, byte-identical merge out, with no
							## reliance on `sort -s` stability.
							local legTagRc=0
							LC_ALL=C awk -v dmId="$legDm" -v legIndex="$legIndex" '
								{
									if ( $0 ~ /^[0-9][0-9]*\.[0-9][0-9]* \| / ) {
										recTs = $0;
										sub(/ .*/, "", recTs);
										recKind = "H";
									} else {
										recKind = "C";
									}
									print recTs "\t" legIndex "\t" NR "\t" dmId "\t" recKind "\t" $0;
								}
							' "$fanDir/fmt.$legIndex" >> "$fanDir/merged" || legTagRc=$?
							if [ "$legTagRc" != "0" ] ; then
								legReason="the response was read and formatted but could not be tagged with its own DM for the merge"
								break
							fi
						else
							{
								printf '## dm=%s identity=%s (this DM'"'"'s own raw API response follows)\n' "$legDm" "$legIdentity"
								printf '%s\n' "$legResponse"
							} >> "$fanDir/raw"
						fi
						break
					done

					## Per-leg outcome recorded as its own line, whichever way it
					## went. A failed leg is named -- its identity, its DM when one
					## was discovered, and the reason -- so a reader never has to
					## work out which of the two conversations is missing from the
					## output below.
					if [ -n "$legReason" ] ; then
						legProvenance="$legProvenance## dm=${legDm:-<not resolved>} identity=$legIdentity status=FAILED reason=$legReason
"
						legFailReport="$legFailReport the $legIdentity identity's DM (${legDm:-not resolved}) with party $fanOutParty -- $legReason ;"
						continue
					fi
					legOkCount=$(( legOkCount + 1 ))
					legProvenance="$legProvenance## dm=$legDm identity=$legIdentity status=ok
"
				done

				## Provenance header first, always both legs, then the payload.
				printf '%s' "$legProvenance"

				if [ "$pretty" = "true" ] ; then
					if [ -f "$fanDir/merged" ] ; then
						## Chronological across BOTH DMs, by ts, with each message
						## line carrying the DM it came from as its first column.
						## Lexicographic on the ts field, deliberately not numeric:
						## a Slack ts is a fixed-width "<10-digit seconds>.<6
						## digits>" string, so byte order IS time order here, and a
						## string compare cannot lose the microsecond digits the
						## way a float conversion can.
						LC_ALL=C sort -t "$tabChar" -k1,1 -k2,2n -k3,3n "$fanDir/merged" \
							| LC_ALL=C awk -F "$tabChar" '
								{
									body = $6;
									for ( i = 7 ; i <= NF ; i++ ) { body = body "\t" $i; }
									if ( $5 == "H" ) { print $4 " | " body; }
									else { print body; }
								}
							'
					fi
				else
					if [ -f "$fanDir/raw" ] ; then
						cat "$fanDir/raw"
					fi
				fi

				rm -rf "$fanDir"
				trap - EXIT

				## THREE OUTCOMES, TOLD APART AND GIVEN THEIR OWN rc. Collapsing a
				## partial read into one clean status is the "NOT SCANNED at rc=0"
				## defect this package has already paid for twice; it is not made a
				## third time here. Callers already treat any non-zero as failure,
				## so the distinct codes only add information to a result that was
				## going to be a failure anyway.
				##   both-succeeded  -- rc 0
				##   one-succeeded   -- rc 3, and the failed DM is named above
				##   neither-succeeded -- rc 4
				## Counted from legs that actually succeeded -- a positive count,
				## never a negation against an empty output, which is exactly what
				## "could not see anything" also looks like.
				if [ "$legOkCount" = "2" ] ; then
					echo "# $MDSC_CMD --intern-op-slack-check: BOTH human-owner DMs read (one per identity, each asserted individually against party $fanOutParty). The lines above are the two conversations merged chronologically, each carrying its own DM id." >&2
					return 0
				fi
				if [ "$legOkCount" = "1" ] ; then
					echo "⛔ ERROR: $MDSC_CMD --intern-op-slack-check: PARTIAL -- only ONE of the human-owner's two DMs was read. Failed:$legFailReport The output above is therefore HALF the conversation: a message the human-owner sent in the failed DM is absent from it, and nothing here supports concluding that no such message exists. Fix the named leg and read again before treating this as an answer. rc=3 means exactly this partial state, distinct from rc=4 (neither DM read) and from rc=1 (this operation failed before any fan-out)." >&2
					set +e ; return 3
				fi
				echo "⛔ ERROR: $MDSC_CMD --intern-op-slack-check: NEITHER of the human-owner's two DMs was read. Failed:$legFailReport Nothing was read at all, so nothing whatsoever is known from this call about what the human-owner has or has not written. rc=4 means exactly this, distinct from rc=3 (one DM read, one failed)." >&2
				set +e ; return 4
			fi

			echo "## target=$target channel=$channel"

			local apiMethod
			if [ -n "$threadTs" ] ; then
				apiMethod="conversations.replies"
			else
				apiMethod="conversations.history"
			fi

			echo "# $MDSC_CMD --intern-op-slack-check: GET $apiMethod channel=$channel${threadTs:+ ts=$threadTs}${oldest:+ oldest=$oldest}" >&2

			## The Slack call itself is delegated to --intern-op-slack-call --
			## THE one place Slack is called (see that file's own header). This
			## arm therefore has no token read, no header file and no curl of its
			## own: routing the call through the op IS this site's SLACK_BOT_TOKEN
			## migration, one change, not a delegation with a private copy of the
			## old machinery left beside it.
			##
			## No identity is named here beyond what the caller asked for and
			## what the target itself declares. Left alone, the op classifies
			## $channel and derives the target kind from it, so a party or DM
			## target is read under the member's own native identity -- the same
			## identity the send path writes with, therefore the same
			## conversation -- while a channel target takes the op's own bot
			## downgrade and behaves exactly as it did before this change.
			##
			## What --identity-bot changes, and why the flag has to exist: a DM
			## belongs to ONE identity pair, so the member's user identity and
			## the team bot hold two DIFFERENT DMs with the same person and
			## neither can read the other's. Without a selector this arm could
			## only ever reach whichever DM the default identity happens to own,
			## and the other one was unreachable for check with no workaround
			## available to a caller -- not a permissions problem, just a
			## missing argument. Translated to the intern op's own --identity
			## spelling right here; the intern op keeps its two-valued form and
			## is unchanged.
			##
			## This site is reached only by a target that is NOT the bare
			## `human-owner` one: that target returns from its own fan-out block
			## above, which reads both DMs, one per identity, and is deliberately
			## untouched by this flag.
			## THE ACTING MEMBER, NOT A CONSTANT. This is the single-conversation
			## path -- every target except the bare `human-owner` one -- and it is
			## where the session-context scan's own two reads land, so a literal
			## here is what made a member-facing sweep return somebody else's
			## conversations.
			local opArgs=( "$memberName" --api "$apiMethod" --resolve-target "$channel" )
			if [ "$identityAsBot" = "true" ] ; then
				opArgs+=( --identity bot )
			fi
			## Positive tests on presence, never a negation against empty: an
			## absent ts and an absent oldest are "not asked for", and each stays
			## distinguishable from a supplied one.
			if [ -n "$threadTs" ] ; then
				opArgs+=( --form "ts=$threadTs" )
			fi
			if [ -n "$oldest" ] ; then
				opArgs+=( --form "oldest=$oldest" )
			fi
			opArgs+=( --context "--intern-op-slack-check" )

			## No retry logic here, by design -- applies to the whole --check-*
			## family, not just this op: if a check fails, it fails, full stop.
			##
			## The response is captured first and replayed into the formatter,
			## rather than piping the op straight into awk. The op's rc is the
			## outcome -- it is what turns Slack's HTTP-200-with-ok:false into a
			## real failure -- and a pipeline reports only its LAST command's
			## status, so piping the op directly would discard exactly the signal
			## this migration exists to gain. The data shape is unchanged either
			## way: the op prints the response on stdout, every diagnostic and
			## every structured field (ACTING_IDENTITY=, RESPONSE_BODY_STATE=,
			## COUNTERPARTY_MATCH=) on stderr. This path reads none of them; it
			## needs the body, and the body is on stdout.
			local response callRc=0
			response="$( DistroAgentsTools --intern-op-slack-call "${opArgs[@]}" )" || callRc=$?
			if [ "$callRc" != "0" ] ; then
				set +e ; return 1
			fi

			## --pretty pipes the response through this repo's own
			## sh-lib/AgentsSlackMessagesFormat.awk (reuses myx.common's
			## agentMcpJsonParseRequest.awk parsing engine verbatim, just a
			## different leaf-emission target -- lives here, not in
			## myx.common, since it's 100% specific to this tool's own
			## Slack-reading need) to print clean "ts | user | text" lines
			## directly -- this is the actual fix for the "why does every
			## caller keep hand-rolling a python3 -c 'import json...'
			## one-liner just to read a Slack reply" pattern, not another
			## one-off workaround.
			local awkStatus=0
			if [ "$pretty" = "true" ] ; then
				printf '%s\n' "$response" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsSlackMessagesFormat.awk" || awkStatus=$?
			else
				printf '%s\n' "$response"
			fi

			if [ "$awkStatus" != "0" ] ; then
				set +e ; return 1
			fi
			return 0
		;;

		*)
			echo "⛔ ERROR: $MDSC_CMD: invalid option: $1 -- rejected by AgentsTools.InternOpSlackCheck.include's own default (*) branch, the operation group sourced by the dispatcher's by-name --intern-op-slack-check route; no operation of that name is defined in this include" >&2
			set +e ; return 1
		;;
esac
