#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.RoutineRootHarness.include -- the routine a root-harness session runs: the mint keeps
## `magic-coordinator.root-harness.routine` in the session's folder (`root-session.routine`). Its
## `access-control:` rows are the session's profile; the one permission chain refuses the tools they deny,
## in the MCP request and in the harness alike. Sourced by the mint (AgentsTools.RootSession.include), by
## the permission chain (AgentsTools.PermissionHolds.include), by the caller check and by the spawn proxy.
## Functions only; no `--` operation of its own.
##

agentsRootHarnessRoutine="magic-coordinator.root-harness.routine.md"
agentsRootHarnessRoutineName="root-session.routine"

## Records the routine of one session, whole or not at all, by one rename. rc 1 where the folder is not there or the write fails.
AgentsToolsRootHarnessRoutineWrite(){ ## session dir
	local routinePath="${1%/}/$agentsRootHarnessRoutineName" routineTemp=""
	[ -d "${1:-}" ] || return 1
	routineTemp="$( mktemp "$routinePath.XXXXXX" 2> /dev/null )" || return 1
	printf '%s\n' "$agentsRootHarnessRoutine" > "$routineTemp" 2> /dev/null && mv -f "$routineTemp" "$routinePath" 2> /dev/null || { rm -f "$routineTemp" ; return 1 ; }
	return 0
}

## The routine recorded for one session, into the named variable: a routine file's name; rc 1, nothing set, where there is none.
## The workspace is this one unless one is named. No process: a caller that reads another workspace's store asks here.
AgentsToolsRootHarnessRoutineInto(){ ## variable, session, workspace (default MMDAPP)
	local routineFolder="" routineLine=""
	printf -v "$1" '%s' ""
	type AgentsSessionFolderInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.include" || return 1
	AgentsSessionFolderInto routineFolder "${3:-${MMDAPP:-}}" "${2:-}" || return 1
	[ -f "$routineFolder/$agentsRootHarnessRoutineName" ] || return 1
	IFS= read -r routineLine < "$routineFolder/$agentsRootHarnessRoutineName" || :
	case "$routineLine" in
		*.routine.md) case "$routineLine" in */*|*[[:space:]]*) return 1 ;; esac ; printf -v "$1" '%s' "$routineLine" ; return 0 ;;
	esac
	return 1
}

## The routine recorded for one session, a routine file's name; rc 1, nothing printed, where there is none. Never a path.
AgentsToolsRootHarnessRoutineRead(){ ## session
	local routineDir="" routineLine=""
	type AgentsToolsSessionChatDir > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionChat.include" || return 1
	routineDir="$( AgentsToolsSessionChatDir "${1:-}" 2> /dev/null )" || return 1
	[ -n "$routineDir" ] && [ -f "$routineDir/$agentsRootHarnessRoutineName" ] || return 1
	IFS= read -r routineLine < "$routineDir/$agentsRootHarnessRoutineName" || :
	case "$routineLine" in
		*.routine.md) case "$routineLine" in */*|*[[:space:]]*) return 1 ;; esac ; printf '%s\n' "$routineLine" ;;
		*) return 1 ;;
	esac
}
