#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.MagicCoordinatorState.include -- the operations of the
## coordinator's state note (the note whose file name keeps "heartbeat-state-and-lock": the
## document of its standing directives and its lock), and two operations that are about the whole
## team: the configuration check and the test report. Sourced lazily from the
## dispatcher's arm for these names via the standard $MDLT_ORIGIN-based path. Not
## standalone: relies on being dot-sourced for $1/$@/$MDSC_CMD.
##

case "$1" in

	--spawn-prompt)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/magic/AgentsTools.OpSpawnPrompt.include"
	;;

	--config-check)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/magic/AgentsTools.OpConfigCheck.include"
	;;

	--state-note-lock-acquire)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/magic/AgentsTools.OpStateNoteLockAcquire.include"
	;;


	--intern-op-state-note-upsert)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/magic/AgentsTools.InternOpStateNoteUpsert.include"
	;;

	--state-note-read)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/magic/AgentsTools.OpStateNoteRead.include"
	;;

	--send-report)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/magic/AgentsTools.OpSendReport.include"
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
