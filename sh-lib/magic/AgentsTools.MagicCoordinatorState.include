#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.MagicCoordinatorState.include -- the operations of the
## coordinator's state note (the note whose file name keeps "heartbeat-state-and-lock": the
## document of its standing directives and its lock), and two operations that are about the whole
## team: the configuration check and the test report. Sourced lazily from the
## dispatcher's arm for these names via the standard $MDLT_ORIGIN-based path. Not
## standalone: relies on being dot-sourced for $1/$@/$MDSC_CMD.
##

## Where an inbox item lives (F4.3).
type AgentsToolsInboxDir > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/inbox/AgentsTools.InboxPlace.include"

. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.RecheckDate.include"

## One frontmatter field's value from a note, bounded to the block between the
## first two `---` lines; empty when the note or the field is absent.
AgentsToolsStateNoteField(){ ## <path> <field>
	[ -f "$1" ] || return 0
	LC_ALL=C awk -v fieldName="$2" '
		{ sub(/\r$/, "") ; }
		$0 == "---" { fmDepth++ ; if (fmDepth >= 2) exit ; next ; }
		fmDepth == 1 && index($0, fieldName ": ") == 1 { print substr($0, length(fieldName) + 3) ; exit ; }
	' "$1"
}

## Live counts, read at call time and never stored: one `<state>: <n>` line per
## board state, counting the *.md files directly in that state's folder.
AgentsToolsBoardCounts(){
	local countState countFile countN
	for countState in backlog pending running review blocked parked processed archived retained ; do
		countN=0
		for countFile in "$MDAT_DATA_ROOT/board/$countState"/*.md ; do
			[ -f "$countFile" ] && countN=$(( countN + 1 ))
		done
		printf '%s: %s\n' "$countState" "$countN"
	done
}

## The active and blocked items, one `<state>/<item-filename>` line each, at
## most 40, then one `(+<n> more)` line for the rest; `(none)` when empty.
AgentsToolsBoardActiveItems(){
	local activeState activeFile activeN=0 activeCap=40 activeRows="" activeTokens
	## Token totals, summed now over what sits under each item (AgentsTools.SessionTranscript.include).
	if . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionTranscript.include" 2>/dev/null ; then
		activeRows="$( cd "$MDAT_DATA_ROOT/board" 2>/dev/null && AgentsSessionTokensRollupRows running/*.md review/*.md pending/*.md blocked/*.md 2>/dev/null )"
	fi
	for activeState in running review pending blocked ; do
		for activeFile in "$MDAT_DATA_ROOT/board/$activeState"/*.md ; do
			[ -f "$activeFile" ] || continue
			activeN=$(( activeN + 1 ))
			activeTokens=""
			[ -z "$activeRows" ] || activeTokens="$( AgentsSessionTokensRollupText "$( AgentsSessionTokensRollupRowOf "$activeRows" "${activeFile##*/}" )" )"
			[ "$activeN" -gt "$activeCap" ] || printf '%s/%s%s\n' "$activeState" "${activeFile##*/}" "${activeTokens:+ -- $activeTokens}"
		done
	done
	[ "$activeN" -le "$activeCap" ] || printf '(+%s more)\n' "$(( activeN - activeCap ))"
	[ "$activeN" -gt 0 ] || printf '(none)\n'
	return 0
}

type AgentsToolsItemUpsert > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.InternOpItem.include"

case "$1" in

	--spawn-prompt)
		shift
		local callingMember="$1"
		shift || true
		if [ -z "$callingMember" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --spawn-prompt: syntax is <team-member> [--from-board <board-item-name> [--board-state <state>]...] [--from-vault <audit-item-name>] [--from-audit <vault-item-name>] [--session-thread:event-track|magic-team] [--description <text>] [--wait]" >&2
			set +e ; return 1
		fi
		## The team itself is no member, and is refused in the line every start refuses it
		## in, ahead of the list below: the one check of a start, which the proxy asks again
		## of whoever passes here (AgentsToolsTeamMemberStartCheck, AgentsTools.TeamRegistry.include).
		type AgentsToolsTeamMemberStartCheck > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.TeamRegistry.include"
		AgentsToolsTeamMemberStartCheck "$callingMember" "" "--spawn-prompt" || { set +e ; return 1 ; }
		case "$callingMember" in
			magic-coordinator)
				;;
			*)
				echo "⛔ ERROR: $MDSC_CMD --spawn-prompt: unsupported caller: $callingMember (allowed: magic-coordinator)" >&2
				set +e ; return 1
			;;
		esac
		## Craft the dispatch-doc mode this relay needs -- not an agent-facing flag.
		## A stdin/--from-file brief names no tracking item, so one is minted: that
		## document carries the session id, and it is the only thing ListAgents
		## reads, TaskOutput resolves and TaskStop acts on. This passed `none` until
		## 2026-09-23, which left every helper spawned this way unlistable and
		## unstoppable. The board-running dispatch-*-spawn-proxy pile-up `none` was
		## answering is closed at the other end instead: the spawn op moves a
		## dispatch item it created itself out of `running` when the child ends.
		## advance's --from-board/--from-vault/--from-audit relay reuses the named
		## item as its own tracking document, unchanged.
		local spawnDispatchDoc="create" spawnProxyArg
		for spawnProxyArg in "$@" ; do
			case "$spawnProxyArg" in
				--from-board|--from-vault|--from-audit) spawnDispatchDoc="reuse" ; break ;;
			esac
		done
		DistroAgentsTools --intern-op-agent-spawn-proxy "$callingMember" "$@" --dispatch-doc:"$spawnDispatchDoc" --context --spawn-prompt
		return $?
	;;

	--config-check)
		shift
		if [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --config-check: takes no arguments" >&2
			set +e ; return 1
		fi
		DistroAgentsTools --intern-op-check-configs magic-coordinator \
			--optional "EMAIL_IMAP_HOST:<host>" \
			--optional "EMAIL_USER:<email-address>" \
			--optional "EMAIL_APP_PASSWORD:<app-password>" \
			--optional "TRELLO_KEY:<key>" \
			--optional "TRELLO_TOKEN:<token>" \
			--expect-secret EMAIL_APP_PASSWORD \
			--expect-secret TRELLO_KEY \
			--expect-secret TRELLO_TOKEN \
			--context --config-check
		local configRc=$?
		DistroAgentsTools --intern-op-check-configs magic-team \
			--required "SLACK_CHANNEL_MAGIC_TEAM:<channel-id>" \
			--required "SLACK_CHANNEL_HUMAN_OWNER:<user-id>" \
			--optional "SLACK_CHANNEL_EVENT_TRACK:<channel-id>" \
			--optional "SLACK_CHANNEL_EVENT_ALERT:<channel-id>" \
			--expect-id-kind SLACK_CHANNEL_EVENT_TRACK:channel \
			--expect-id-kind SLACK_CHANNEL_EVENT_ALERT:channel \
			--expect-id-kind SLACK_CHANNEL_MAGIC_TEAM:channel \
			--expect-id-kind SLACK_CHANNEL_HUMAN_OWNER:user \
			--context --config-check || configRc=1
		## Unset, the team data is the workspace's own store, which the resolver
		## already answered; a setting is an override and is checked as one.
		if [ -n "$( DistroAgentsTools --agents-config-option magic-coordinator --select TEAM_DATA_DIRECTORY 2>/dev/null )" ] ; then
			DistroAgentsTools --intern-op-check-configs magic-coordinator \
				--optional "TEAM_DATA_DIRECTORY:<path>" \
				--expect-path-exists "TEAM_DATA_DIRECTORY:${MDAT_DATA_ROOT:-}" \
				--context --config-check || configRc=1
		else
			echo "TEAM_DATA_DIRECTORY: OK"
			echo "  note: not set, so the team data is this workspace's own store"
			echo "  path: $MDAT_DATA_ROOT"
		fi
		DistroAgentsTools --intern-op-check-configs magic-team \
			--optional "SLACK_BOT_TOKEN:<token>" \
			--optional "TEAM_DATA_GIT_REMOTE:<git-remote-url>" \
			--expect-secret SLACK_BOT_TOKEN \
			--resolve-slack-workspace-into SLACK_WORKSPACE_DOMAIN \
			--context --config-check || true
		## The main loop's readiness floor, applied the same way here: the schedule starts sessions.
		if [ -z "$( DistroAgentsTools --agents-config-option magic-team --select SPAWN_CLI_SERVICE 2>/dev/null )" ] ; then
			echo "SPAWN_CLI_SERVICE: FAIL"
			echo "  fail: Agent CLI service is not set, so its spawns cannot start -- set it with DistroAgentsTools.fn.sh --owner-setup-claude --apply (or --owner-setup-copilot --apply)"
			configRc=1
		else
			echo "SPAWN_CLI_SERVICE: OK"
		fi
		## The team posts to Slack: with none of the tokens a coordinator send can
		## resolve to, every send it makes fails, so having none is a FAIL.
		if [ -z "$( DistroAgentsTools --agents-config-option magic-coordinator --select SLACK_USER_TOKEN 2>/dev/null )" ] \
			&& [ -z "$( DistroAgentsTools --agents-config-option magic-coordinator --select SLACK_BOT_TOKEN 2>/dev/null )" ] \
			&& [ -z "$( DistroAgentsTools --agents-config-option magic-team --select SLACK_BOT_TOKEN 2>/dev/null )" ]
		then
			echo "SLACK_TOKEN: FAIL"
			echo "  fail: no SLACK_USER_TOKEN or SLACK_BOT_TOKEN for magic-coordinator, and no SLACK_BOT_TOKEN for magic-team, so the team cannot post to Slack"
			configRc=1
		else
			echo "SLACK_TOKEN: OK"
		fi
		## Her own identity is her user token's account. The user_id printed here is
		## the one every user-token send is confirmed against (message.user) by
		## --slack-send-message itself. Never gates: WARN only.
		local identToken="" identResp="" identUserId=""
		identToken="$( DistroAgentsTools --agents-config-option magic-coordinator --select SLACK_USER_TOKEN 2>/dev/null )" || identToken=""
		if [ -z "$identToken" ] ; then
			echo "SLACK_AUTH_IDENTITY: WARN"
			echo "  warn: magic-coordinator has no SLACK_USER_TOKEN, so she posts under a bot identity, never her own"
			echo "  fix:  printf '%s' '<xoxp-token>' | DistroAgentsTools.fn.sh --agents-config-option magic-coordinator --upsert-from-stdin SLACK_USER_TOKEN"
		else
			identResp="$( curl -sS --connect-timeout 10 --max-time 30 https://slack.com/api/auth.test -H @- <<< "Authorization: Bearer $identToken" 2>/dev/null )" || identResp=""
			identUserId="$( printf '%s\n' "$identResp" | LC_ALL=C awk -v path=user_id -v optional=1 -v dialect=slack -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsHarnessJsonField.awk" 2>/dev/null )" || identUserId=""
			if [ -n "$identUserId" ] && printf '%s' "$identResp" | grep -q '"ok":true' ; then
				echo "SLACK_AUTH_IDENTITY: OK"
				echo "  user_id: $identUserId -- the account her user-token sends are confirmed against"
			else
				echo "SLACK_AUTH_IDENTITY: WARN"
				echo "  warn: auth.test on magic-coordinator's SLACK_USER_TOKEN returned no user_id, so her own identity is not established"
				echo "  fix:  replace SLACK_USER_TOKEN with a valid user token for her own Slack account"
			fi
		fi
		DistroAgentsTools --intern-op-slack-check-scopes magic-coordinator \
			--scope-source --slack-send-message \
			--scope-source AgentsToolsSlackCheck \
			--scope-source --slack-read \
			--scope-source --slack-react \
			--scope-source --slack-resolve-ids \
			--context --config-check || true
		return "$configRc"
		return $?
	;;

	--state-note-lock-acquire)
		shift
		local callingMember="$1" ; shift || true
		local ownerLabel="$1" ; shift || true
		if [ -z "$callingMember" ] || [ -z "$ownerLabel" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --state-note-lock-acquire: <team-member> <owner-label> required" >&2
			set +e ; return 1
		fi
		if [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --state-note-lock-acquire: invalid option: $1" >&2
			set +e ; return 1
		fi
		local recheckDate
		recheckDate="$( AgentsToolsRecheckDate 15 )"
		AgentsToolsItemRead "$callingMember" \
			note-20260809T155000Z-heartbeat-state-and-lock.md \
			--acquire-lock "$ownerLabel" \
			--header:upsert:state:heartbeat-running \
			--header:upsert:recheck-date:"$recheckDate" \
			--context --state-note-lock-acquire
		return $?
	;;


	--intern-op-state-note-upsert)
		shift
		local callingMember="$1"
		shift || true
		if [ -z "$callingMember" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-op-state-note-upsert: syntax is <team-member> -- content via stdin, --from-file <path>, or --edit-patch-from-stdin" >&2
			set +e ; return 1
		fi
		## This document is always magic-coordinator's own -- the target path
		## below is a fixed literal, never derived from $callingMember. A
		## caller passing any other name would otherwise silently write into
		## magic-coordinator's own state note under a different member's
		## belief that it wrote its own; fail loud instead of ignoring the
		## argument silently.
		if [ "$callingMember" != "magic-coordinator" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-op-state-note-upsert: <team-member> must be magic-coordinator -- this document has no other owner (got: $callingMember)" >&2
			set +e ; return 1
		fi
		[ -n "${MDAT_DATA_ROOT:-}" ] || {
			echo "⛔ ERROR: $MDSC_CMD --intern-op-state-note-upsert: MDAT_DATA_ROOT is not set" >&2
			set +e ; return 1
		}
		local stateDir="$( AgentsToolsInboxDir magic-coordinator )"
		mkdir -p "$stateDir" || {
			echo "⛔ ERROR: $MDSC_CMD --intern-op-state-note-upsert: can't create inbox directory: $stateDir" >&2
			set +e ; return 1
		}
		## Same document --state-note-lock-acquire writes, not a separate
		## file -- state and lock used to be two documents, and the state one never carried a session-id, so
		## nothing here could ever detect a stolen/expired lock. Merged
		## 2026-09-09; see MAGIC.md.
		local target="$stateDir/note-20260809T155000Z-heartbeat-state-and-lock.md"
		if [ ! -f "$target" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-op-state-note-upsert: $target does not exist -- acquire the lock first (--state-note-lock-acquire)" >&2
			set +e ; return 1
		fi
		local content contentFromFile="false" bodyMode="" bodyModeCount=0
		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-file)
					if [ -z "$2" ] || [ ! -f "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --intern-op-state-note-upsert: --from-file: file not found: $2" >&2
						set +e ; return 1
					fi
					content="$( cat "$2" )"
					contentFromFile="true"
					bodyMode="file"
					bodyModeCount=$(( bodyModeCount + 1 ))
					shift 2
				;;
				--edit-patch-from-stdin)
					bodyMode="patch"
					bodyModeCount=$(( bodyModeCount + 1 ))
					shift
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --intern-op-state-note-upsert: unrecognized argument: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ "$bodyModeCount" -gt 1 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-op-state-note-upsert: --from-file and --edit-patch-from-stdin are mutually exclusive" >&2
			set +e ; return 1
		fi
		if [ "$bodyMode" = "patch" ] ; then
			local patchJson existingContent
			patchJson="$( cat )"
			if [ -f "$target" ] ; then existingContent="$( cat "$target" )" ; else existingContent="" ; fi
			content="$( printf '%s%s' "$patchJson" "$existingContent" | python3 "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsBoardItemPatchApply.py" )" || { set +e ; return 1 ; }
		else
			[ "$contentFromFile" = "true" ] || content="$( cat )"
			## Reported, never refused, and this one is not a tier choice. This
			## note's own active-project field runs well past the word cap, and it
			## is rewritten at every state write, so no count of it stays true.
			. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.OutputStyle.include"
			printf '%s' "$content" | AgentsToolsOutputStyleRefusal "$callingMember" "" "state note" "" none || :
		fi
		## An empty write erases the stored state, directives and all.
		if [ -z "$content" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-op-state-note-upsert: empty content -- refusing to erase the stored state note" >&2
			set +e ; return 1
		fi
		## Normalize CRLF before any frontmatter/body split below -- a caller
		## supplying Windows line endings otherwise defeats every literal
		## "---" match ($0=="---" never matches "---\r"), and both extraction
		## passes below then silently produce nothing rather than erroring,
		## which would wipe the document on write with no error at all
		## (measured; see MAGIC.md). $target itself is never touched here --
		## it is always written by this same tooling and is always LF.
		content="$( printf '%s\n' "$content" | LC_ALL=C awk '{ sub(/\r$/, "") ; print }' )"
		## Preserve the lock-owned frontmatter fields (type/from/date/owner/
		## state/recheck-date/session-id) exactly as they currently stand --
		## never hand-named, so a lock-side field added later survives too.
		## $content carries its own state-only frontmatter (last-iteration-
		## date etc.) plus body; splice the two frontmatter blocks together
		## and keep $content's own body verbatim. A body-input mode replaces
		## the WHOLE document (see reflection-20260908T1023Z), which is
		## exactly why the lock fields have to be re-spliced in here rather
		## than trusted to survive on their own.
		## Filtered to an explicit allowlist, not "every field currently on
		## the document" -- the document also carries state fields from the
		## LAST state-upsert call (last-iteration-date, today-stage, etc.),
		## and those must be REPLACED by this call's own callerFields, never
		## unioned alongside them. A duplicate key also breaks every reader
		## here that takes the first match and stops (see session-id's own
		## awk above), so the stale copy would silently win forever.
		local lockFields callerFields callerBody
		lockFields="$( LC_ALL=C awk '
			NR==1 { if ($0=="---") { inFM=1 ; } ; next ; }
			inFM {
				if ($0=="---") exit
				if ($0 ~ /^(type|from|date|owner|state|recheck-date|session-id): /) print
			}
		' "$target" )"
		if [ -z "$lockFields" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-op-state-note-upsert: $target has no readable frontmatter -- refusing to overwrite a document in an unexpected shape" >&2
			set +e ; return 1
		fi
		## Every state write while a session holds the lock also refreshes it (recheck-date,
		## now + 15 minutes), so a holder that keeps writing never reads as a crashed one.
		## Only while the note says heartbeat-running (the stored value of a held lock): a
		## finished or foreign state is carried over untouched.
		if printf '%s\n' "$lockFields" | LC_ALL=C grep -qx 'state: heartbeat-running' ; then
			local refreshDate
			refreshDate="$( AgentsToolsRecheckDate 15 )"
			lockFields="$( printf '%s\n' "$lockFields" | LC_ALL=C awk -v recheck="recheck-date: $refreshDate" '
				/^recheck-date: / { print recheck ; done = 1 ; next ; }
				{ print ; }
				END { if (!done) print recheck ; }
			' )"
		fi
		## Excludes the same lock-owned allowlist $lockFields already carries,
		## not just "print everything" -- --edit-patch-from-stdin's own body
		## source reconstructs $content from $target's OWN existing content
		## (AgentsBoardItemPatchApply.py patches and returns the whole
		## document, frontmatter included), so $content's frontmatter would
		## otherwise still carry the lock fields verbatim and duplicate every
		## one of them alongside $lockFields below (measured). No live caller
		## uses --edit-patch-from-stdin on this op today, but the op accepts
		## it, so this excludes rather than trusts the caller never to.
		callerFields="$( printf '%s\n' "$content" | LC_ALL=C awk '
			NR==1 { if ($0=="---") { inFM=1 ; } ; next ; }
			inFM {
				if ($0=="---") exit
				if ($0 !~ /^(type|from|date|owner|state|recheck-date|session-id): /) print
			}
		' )"
		## A caller supplying no frontmatter at all (just body) is a valid
		## input -- callerFields alone empty is fine. This is NOT the same
		## check as the "both empty" guard below.
		callerBody="$( printf '%s\n' "$content" | LC_ALL=C awk '
			NR==1 { if ($0=="---") { hasFm=1 ; } ; }
			hasFm {
				if ($0=="---") { delims++ ; next ; }
				if (delims >= 2) print
				next
			}
			{ print ; }
		' )"
		## Strip callerBody's own leading blank line(s) before splicing --
		## $mergedContent below always adds exactly one separating blank line
		## of its own. Without this strip, feeding a full previously-read
		## record back in (state-read piped straight into state-upsert,
		## documented as this op's own normal write-back shape) carries that
		## record's OWN already-separated body, whose leading blank line(s)
		## then stack with the template's, growing by one blank line every
		## round-trip (measured live: 2 blank lines after one such cycle,
		## 3 after two). Normalizing to zero leading blanks here, then always
		## adding exactly one, makes the separator idempotent regardless of
		## how many blank lines the input happened to carry.
		callerBody="$( printf '%s\n' "$callerBody" | LC_ALL=C awk '
			BEGIN { started = 0 ; }
			{ if (!started && $0 == "") next ; started = 1 ; print ; }
		' )"
		## Defense in depth: whatever the cause (a future edge case, not only
		## the two fixed above), extraction producing nothing at all from a
		## non-empty $content must never fall through to a silent lock-only
		## write -- fail loud instead, same as the empty-content guard above.
		if [ -z "$callerFields" ] && [ -z "$callerBody" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-op-state-note-upsert: content parsed to empty fields and empty body -- refusing to overwrite the stored state note with a lock-only document" >&2
			set +e ; return 1
		fi
		## The date and time of the write are the tooling's to stamp; a value the caller
		## gives wins. last-test-email-sent belongs to --send-report,
		## so a caller that leaves it out keeps the stored one.
		local stampLines="" carriedTestSent
		case $'\n'"$callerFields" in *$'\n''last-iteration-date: '*) ;; *) stampLines="${stampLines}last-iteration-date: $( date +%Y-%m-%d )"$'\n' ;; esac
		case $'\n'"$callerFields" in *$'\n''last-iteration-timestamp: '*) ;; *) stampLines="${stampLines}last-iteration-timestamp: $( date -u +%Y-%m-%dT%H:%M:%SZ )"$'\n' ;; esac
		case $'\n'"$callerFields" in
			*$'\n''last-test-email-sent: '*) ;;
			*)
				carriedTestSent="$( AgentsToolsStateNoteField "$target" last-test-email-sent )"
				[ -z "$carriedTestSent" ] || stampLines="${stampLines}last-test-email-sent: $carriedTestSent"$'\n'
			;;
		esac
		if [ -n "$stampLines" ] ; then
			if [ -n "$callerFields" ] ; then callerFields="$callerFields"$'\n'"${stampLines%$'\n'}" ; else callerFields="${stampLines%$'\n'}" ; fi
		fi
		local mergedContent
		mergedContent="$( printf -- '---\n%s\n%s\n---\n\n%s' "$lockFields" "$callerFields" "$callerBody" )"
		## Delegates to the same git-backed, session-id-checked primitive the
		## lock note already uses -- the target now genuinely carries a
		## session-id (it is the same document), so the stale/stolen-lock
		## check this primitive already does applies to this write too,
		## which it never could when this was a separate, lock-blind file.
		printf '%s\n' "$mergedContent" | AgentsToolsItemUpsert magic-coordinator \
			note-20260809T155000Z-heartbeat-state-and-lock.md \
			--upsert-from-stdin \
			--commit-message "* main-loop, state-note, $( date -u +%Y-%m-%dT%H:%M:%SZ )" \
			--context --intern-op-state-note-upsert
		return $?
	;;

	## Read-only. Prints the record on stdout, or NO_STATE when nothing is
	## stored yet.
	--state-note-read)
		shift
		local callingMember="$1"
		shift || true
		if [ -z "$callingMember" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --state-note-read: <team-member> required" >&2
			set +e ; return 1
		fi
		if [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --state-note-read: takes no arguments" >&2
			set +e ; return 1
		fi
		## This document is always magic-coordinator's own -- the target path
		## below is a fixed literal, never derived from $callingMember. A
		## caller passing any other name would otherwise silently read
		## magic-coordinator's own state note under a different member's
		## belief that it read its own; fail loud instead of ignoring the
		## argument silently.
		if [ "$callingMember" != "magic-coordinator" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --state-note-read: <team-member> must be magic-coordinator -- this document has no other owner (got: $callingMember)" >&2
			set +e ; return 1
		fi
		[ -n "${MDAT_DATA_ROOT:-}" ] || {
			echo "⛔ ERROR: $MDSC_CMD --state-note-read: MDAT_DATA_ROOT is not set" >&2
			set +e ; return 1
		}
		## Same document --state-note-lock-acquire/-refresh/-close-unlock
		## and --intern-op-state-note-upsert all write -- must match exactly.
		local target="$( AgentsToolsInboxDir magic-coordinator )/note-20260809T155000Z-heartbeat-state-and-lock.md"
		if [ -f "$target" ] ; then
			cat "$target"
		else
			echo "NO_STATE"
		fi
		return 0
	;;

	## The hourly test report: due only once an hour has passed since the note's
	## last-test-email-sent; built from the board counts and active items; sent through --email-send to human-owner's
	## EMAIL_USER; stamps last-test-email-sent once sent.
	--send-report)
		shift
		local callingMember="$1"
		shift || true
		if [ -z "$callingMember" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --send-report: <team-member> required" >&2
			set +e ; return 1
		fi
		if [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --send-report: invalid option: $1 -- takes <team-member> only" >&2
			set +e ; return 1
		fi
		if [ "$callingMember" != "magic-coordinator" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --send-report: <team-member> must be magic-coordinator -- the state note it stamps has no other owner (got: $callingMember)" >&2
			set +e ; return 1
		fi
		[ -n "${MDAT_DATA_ROOT:-}" ] || {
			echo "⛔ ERROR: $MDSC_CMD --send-report: MDAT_DATA_ROOT is not set" >&2
			set +e ; return 1
		}
		local reportNote="$( AgentsToolsInboxDir magic-coordinator )/note-20260809T155000Z-heartbeat-state-and-lock.md"
		if [ ! -f "$reportNote" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --send-report: $reportNote does not exist -- acquire the lock first (--state-note-lock-acquire)" >&2
			set +e ; return 1
		fi
		local reportLastSent reportLastEpoch="" reportNowEpoch
		reportNowEpoch="$( date +%s )"
		reportLastSent="$( AgentsToolsStateNoteField "$reportNote" last-test-email-sent )"
		if [ -n "$reportLastSent" ] ; then
			reportLastEpoch="$( printf '%s\n' "$reportLastSent" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/output/LocalIsoToEpoch.awk" 2>/dev/null )" || reportLastEpoch=""
		fi
		if [ -n "$reportLastEpoch" ] && [ "$(( reportNowEpoch - reportLastEpoch ))" -lt 3600 ] ; then
			echo "NOT_DUE:last-test-email-sent=$reportLastSent:due-in=$(( 3600 - ( reportNowEpoch - reportLastEpoch ) ))s"
			return 0
		fi
		local reportTo
		reportTo="$( DistroAgentsTools --agents-config-option human-owner --select EMAIL_USER 2>/dev/null )"
		if [ -z "$reportTo" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --send-report: EMAIL_USER is not set in human-owner's own scope in .local/.agents -- nowhere to send the report" >&2
			set +e ; return 1
		fi
		local reportStamp reportSubject reportBody
		reportStamp="$( date -u +%Y-%m-%dT%H:%M:%SZ )"
		reportSubject="Test report $reportStamp"
		reportBody="$(
			printf 'Test report at %s.\n\n' "$reportStamp"
			printf 'Board counts:\n\n'
			AgentsToolsBoardCounts | sed 's/^/- /'
			printf '\nActive and blocked items:\n\n'
			AgentsToolsBoardActiveItems | sed 's/^/- /'
		)"
		printf '%s\n' "$reportBody" | DistroAgentsTools --intern-op-comms-email-send "$callingMember" "$reportTo" -- "$reportSubject" -- --text-group report --from-stdin || {
			echo "⛔ ERROR: $MDSC_CMD --send-report: the send failed, so last-test-email-sent is not stamped" >&2
			set +e ; return 1
		}
		AgentsToolsItemUpsert magic-coordinator \
			note-20260809T155000Z-heartbeat-state-and-lock.md \
			--header:upsert:last-test-email-sent:"$reportStamp" \
			--commit-message "* main-loop, test report, $reportStamp" \
			--context --send-report || { set +e ; return 1 ; }
		echo "SENT:to=$reportTo:last-test-email-sent=$reportStamp"
		return 0
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
