		done
		local opRc=0
		DistroAgentsTools --intern-op-atlassian-confluence-page-update --member "$actingMember" --context confluence-page-update --page-id "$pageId" "$@" || opRc=$?
		if [ "$opRc" -ne 0 ] ; then set +e ; return "$opRc" ; fi
		return 0
	;;

	--confluence-comment-add)
		shift
		local actingMember="${1:-}" pageId="${2:-}"
		shift || { printf '%s\n' "⛔ ERROR: $MDSC_CMD --confluence-comment-add: <team-member> missing" >&2 ; set +e ; return 1 ; }
		[ -n "$actingMember" ] || { printf '%s\n' "⛔ ERROR: $MDSC_CMD --confluence-comment-add: <team-member> missing" >&2 ; set +e ; return 1 ; }
		shift || { printf '%s\n' "⛔ ERROR: $MDSC_CMD --confluence-comment-add: <page-id> missing" >&2 ; set +e ; return 1 ; }
		case "$pageId" in
			''|-*)
				printf '%s\n' "⛔ ERROR: $MDSC_CMD --confluence-comment-add: <page-id> missing" >&2
				set +e ; return 1
			;;
		esac
		AgentsToolsAssertBareName "$actingMember" "<team-member>" confluence-comment-add || { set +e ; return 1 ; }
		case "$actingMember" in
			magic-coordinator) ;;
			*)
				printf '%s\n' "⛔ ERROR: $MDSC_CMD --confluence-comment-add: runs only as magic-coordinator, and $actingMember is not it -- the client-facing write is --client-comms-confluence-comment-add" >&2
				set +e ; return 1
			;;
		esac
		local stubArg stubTakesValue=""
		for stubArg in "$@" ; do
			if [ -n "$stubTakesValue" ] ; then
				stubTakesValue=""
				continue
			fi
			case "$stubArg" in
				--body-storage|--body-storage-from-file|--parent-comment-id) stubTakesValue=yes ;;
				--body-storage-from-stdin) ;;
				*)
					printf '%s\n' "⛔ ERROR: $MDSC_CMD --confluence-comment-add: unexpected: $stubArg" >&2
					set +e ; return 1
				;;
			esac
		done
		local opRc=0
		DistroAgentsTools --intern-op-atlassian-confluence-comment-add --member "$actingMember" --context confluence-comment-add --page-id "$pageId" "$@" || opRc=$?
		if [ "$opRc" -ne 0 ] ; then set +e ; return "$opRc" ; fi
		return 0
	;;

	--confluence-page-delete)
		shift || :
		local actingMember="${1:-}" pageId="${2:-}"
		shift || { printf '%s\n' "⛔ ERROR: $MDSC_CMD --confluence-page-delete: <team-member> missing" >&2 ; set +e ; return 1 ; }
		[ -n "$actingMember" ] || { printf '%s\n' "⛔ ERROR: $MDSC_CMD --confluence-page-delete: <team-member> missing" >&2 ; set +e ; return 1 ; }
		shift || { printf '%s\n' "⛔ ERROR: $MDSC_CMD --confluence-page-delete: <page-id> missing" >&2 ; set +e ; return 1 ; }
		[ -n "$pageId" ] || { printf '%s\n' "⛔ ERROR: $MDSC_CMD --confluence-page-delete: <page-id> missing" >&2 ; set +e ; return 1 ; }
		case "$#:${1:-}" in
			0:) ;;
			*) printf '%s\n' "⛔ ERROR: $MDSC_CMD --confluence-page-delete: not accepted: $actingMember $pageId $*" >&2 ; set +e ; return 1 ;;
		esac
		AgentsToolsAssertBareName "$actingMember" "<team-member>" confluence-page-delete || { set +e ; return 1 ; }
		case "$actingMember" in
			magic-coordinator) ;;
			*)
				printf '%s\n' "⛔ ERROR: $MDSC_CMD --confluence-page-delete: runs only as magic-coordinator, and $actingMember is not it -- the client-facing write is --client-comms-confluence-page-delete" >&2
				set +e ; return 1
			;;
		esac
		local opRc=0
		DistroAgentsTools --intern-op-atlassian-confluence-page-delete --member "$actingMember" --context confluence-page-delete --page-id "$pageId" || opRc=$?
		if [ "$opRc" -ne 0 ] ; then set +e ; return "$opRc" ; fi
		return 0
	;;

	## The retired names of its two helpers are reported, never swallowed.
	--intern-op-comms-slack-resolve-ids|--intern-op-comms-slack-conversations-roster)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;

	## DEFINITIONS-ONLY SOURCE: a caller sourcing this file for its helpers. Nothing to dispatch.
	*)
		:
	;;
esac
