#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.MagicSpawnSession.include -- --spawn-session. Starts a coworking
## session and spawns its initial members in one call, each one carrying the resolved
## routine's own automatic brief (AgentsTools.InternOpAgentSpawnProxy.include's --routine/
## --routine-default). The first member spawned starts the session; every further one
## joins it by the session id the first spawn reports. Help pairing: MAGIC.md,
## "--spawn-session: starting a routine's own initial members".
##

## THE AGENT-LESS PARENT of a partitioned spawn (a `<type>-*` in the routine's own executors or the
## caller's, or several members the caller names): it runs no agent of its own -- no CLI is launched --
## watches the member sessions it spawned, and finishes itself once all of them are done. It owns the
## run as its caller: its owner is the calling member, it reports where the caller is, and each child
## reports there too (`--reports-to`), so their handbacks and escalations reach the caller with no hop.
## Its record is written by --spawn-session before the first child starts; this watcher, started detached once the children
## are, closes it when the last child closes (AgentsToolsSpawnSessionParentClose), and housekeeping does where the watcher is gone.
AgentsToolsSpawnSessionParent(){ ## parent session id
	local watchRecord="$MMDAPP/.local/agents/spawned/$1/$1.spawn.md"
	type AgentsToolsSpawnSessionParentClose > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SpawnSandbox.include" || return 1
	while sleep 2 ; do
		## Its own record removed is its tree removed; one closed already was closed by housekeeping.
		[ -f "$watchRecord" ] && [ "$( AgentsToolsSpawnSandboxRecordHeader "$watchRecord" status )" = spawn-started ] || return 0
		! AgentsToolsSpawnSessionParentClose "$watchRecord" || return 0
	done
}

case "$1" in

	--spawn-session)
		shift
		local routineSelector="" routineDefault="false" sessionNameOrComment="" sessionDescription=""
		local sessionCliService="" sessionSettingsWorkspace=""
		local spawnMembers=()
		while [ $# -gt 0 ] ; do
			case "$1" in
				--routine)
					if [ -z "${2:-}" ] ; then
						echo "$MDSC_CMD: spawn-session: ⛔ ERROR: --routine requires <selector>" >&2
						set +e ; return 1
					fi
					routineSelector="$2"
					shift 2
				;;
				--routine-default)
					routineDefault="true"
					shift
				;;
				--session-name-or-comment)
					if [ -z "${2:-}" ] ; then
						echo "$MDSC_CMD: spawn-session: ⛔ ERROR: --session-name-or-comment requires <text>" >&2
						set +e ; return 1
					fi
					sessionNameOrComment="$2"
					shift 2
				;;
				## What the spawn is for, in the caller's words: passed to every spawn of this call
				## unchanged, as --intern-op-agent-spawn-proxy takes it.
				--description)
					if [ -z "${2:-}" ] ; then
						echo "$MDSC_CMD: spawn-session: ⛔ ERROR: --description requires <text>" >&2
						set +e ; return 1
					fi
					sessionDescription="$2"
					shift 2
				;;
				## The two spawn settings a task may carry of its own: the agent CLI service every
				## spawn of this call runs on, and the workspace whose spawn settings it is started
				## with. Passed to each unchanged, as --intern-op-agent-spawn-proxy takes them, and
				## checked there: a value it refuses stops the call at its first spawn.
				--spawn-cli-service)
					if [ -z "${2:-}" ] ; then
						echo "$MDSC_CMD: spawn-session: ⛔ ERROR: --spawn-cli-service requires <cli-name>" >&2
						set +e ; return 1
					fi
					sessionCliService="$2"
					shift 2
				;;
				--spawn-settings-workspace)
					if [ -z "${2:-}" ] ; then
						echo "$MDSC_CMD: spawn-session: ⛔ ERROR: --spawn-settings-workspace requires <workspace-name>" >&2
						set +e ; return 1
					fi
					sessionSettingsWorkspace="$2"
					shift 2
				;;
				--*)
					echo "$MDSC_CMD: spawn-session: ⛔ ERROR: invalid option: $1 -- syntax is (--routine <selector>|--routine-default) [--session-name-or-comment <text>] [--description <text>] [--spawn-cli-service <cli-name>] [--spawn-settings-workspace <workspace-name>] [<team-member>...]" >&2
					set +e ; return 1
				;;
				*)
					spawnMembers+=( "$1" )
					shift
				;;
			esac
		done
		if [ -n "$routineSelector" ] && [ "$routineDefault" = "true" ] ; then
			echo "$MDSC_CMD: spawn-session: ⛔ ERROR: use only one of --routine <selector> | --routine-default" >&2
			set +e ; return 1
		fi
		if [ -z "$routineSelector" ] && [ "$routineDefault" != "true" ] ; then
			echo "$MDSC_CMD: spawn-session: ⛔ ERROR: exactly one of --routine <selector> | --routine-default is required" >&2
			set +e ; return 1
		fi

		## The task text, read once so every spawned member gets the same stdin;
		## emptiness is each spawn's own --intern-op-agent-spawn-proxy call to judge.
		local spawnTaskText
		spawnTaskText="$( cat )"

		## Resolved once, so every member spawned from this one call carries the same
		## routine file even if the tree changes mid-call -- a selector re-resolved
		## per spawn could otherwise split one session across two routine files.
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SpawnRoutine.include"
		## A member of any workspace is spawnable from here: the member directory, not this workspace's own index alone.
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.TeamRegistry.include"
		if [ "$routineDefault" = "true" ] ; then
			routineSelector="$( AgentsToolsSpawnRoutineDefaultName )" || { set +e ; return 1 ; }
		fi
		local resolvedRoutineFile
		resolvedRoutineFile="$( AgentsToolsSpawnRoutineResolve "$routineSelector" )" || { set +e ; return 1 ; }
		local routineContract
		routineContract="$( AgentsToolsSpawnRoutineContractCheck "$resolvedRoutineFile" )" || { set +e ; return 1 ; }
		local resolvedRoutineName="${resolvedRoutineFile##*/}"

		## The routine's own executors and invitees lines, read once and kept: the roster the
		## executors name starts the routine when no member is named, and a `<type>-*` among them
		## partitions the run into one session per member under an agent-less parent.
		local routineExecutorsLine routineInviteesLine
		{
			IFS= read -r routineExecutorsLine
			IFS= read -r routineInviteesLine
		} <<< "$( AgentsToolsSpawnRoutineContractExecutorsInvitees "$routineContract" )"

		## No positional members: fall back to the routine's own executors line. A
		## value that is not a comma-separated list of existing members --
		## "magic-team"/"*" (this file's own "any member" shorthand, per
		## magic-team/reference/skill-folder-model.md) or prose -- names no spawnable roster and is
		## refused, asking for explicit members instead of guessing one.
		local rosterExpanded="false"
		if [ ${#spawnMembers[@]} -eq 0 ] ; then
			local execCandidate execRoster="" execRosterWhy=""
			## The one rule of what a routine starts by itself (AgentsToolsSpawnRoutineExecutorsRoster),
			## which --manager-routine-list prints for a console.
			if execRoster="$( AgentsToolsSpawnRoutineExecutorsRoster "$routineExecutorsLine" )" ; then
				while IFS= read -r execCandidate ; do
					[ -z "$execCandidate" ] || spawnMembers+=( "$execCandidate" )
				done <<< "$execRoster"
				rosterExpanded="true"
			else
				execRosterWhy="$execRoster"
			fi
			if [ ${#spawnMembers[@]} -eq 0 ] ; then
				case "$execRosterWhy" in
					choice-required*)
						echo "$MDSC_CMD: spawn-session: ⛔ ERROR: $resolvedRoutineName's own executors ('$routineExecutorsLine') names a choice (<type>-?): name the one member to start -- nothing was started. Its candidates:" >&2
						printf '%s\n' "$execRosterWhy" | LC_ALL=C sed -e '1d' -e 's/^/  /' >&2 ;;
					none-of-type*)
						## The star stands for a type, and fail on NONE: the hint names the type the caller wrote
						## and the two things they can pass instead, as the validator's row does.
						echo "$MDSC_CMD: spawn-session: ⛔ ERROR: $resolvedRoutineName's own executors ('$routineExecutorsLine') names no member of the type ${execRosterWhy#none-of-type$'\t'} on any workspace of this machine -- name the members to start instead, or write a <type>-* whose type has members; nothing was started" >&2 ;;
					all-present-members)
						echo "$MDSC_CMD: spawn-session: ⛔ ERROR: $resolvedRoutineName's own executors ('$routineExecutorsLine') names the participants-only word all-present-members -- name the members to start instead" >&2 ;;
					*)
						echo "$MDSC_CMD: spawn-session: ⛔ ERROR: $resolvedRoutineName's own executors ('$routineExecutorsLine') is not a plain comma-separated list of existing members -- pass explicit <team-member>... instead" >&2 ;;
				esac
				set +e ; return 1
			fi
		fi

		## A caller's own `<type>-*` names every member of the type and partitions the run; its `<type>-?` is a
		## choice the caller makes, refused with its candidates, by the one rule (AgentsToolsSpawnRoutineEntryMembers).
		local callerWild="false"
		if [ "$rosterExpanded" = "false" ] ; then
			local callerEntry callerOut callerOne callerExpanded=()
			for callerEntry in "${spawnMembers[@]}" ; do
				case "$callerEntry" in
					*-\*|*-\?)
						if ! callerOut="$( AgentsToolsSpawnRoutineEntryMembers "$callerEntry" )" ; then
							case "$callerOut" in
								choice-required*)
									echo "$MDSC_CMD: spawn-session: ⛔ ERROR: $callerEntry is a choice: name the one member to start -- nothing was started. Its candidates:" >&2
									printf '%s\n' "$callerOut" | LC_ALL=C sed -e '1d' -e 's/^/  /' >&2 ;;
								*) echo "$MDSC_CMD: spawn-session: ⛔ ERROR: $callerEntry names no member of the type ${callerEntry%??} on any workspace of this machine -- nothing was started" >&2 ;;
							esac
							set +e ; return 1
						fi
						callerWild="true"
					;;
					*) callerOut="$callerEntry" ;;
				esac
				while IFS= read -r callerOne ; do
					[ -z "$callerOne" ] || callerExpanded+=( "$callerOne" )
				done <<< "$callerOut"
			done
			spawnMembers=( "${callerExpanded[@]}" )
		fi

		## Who is in the session is the routine's own say, its frontmatter: the coordinator is
		## there where the routine, or the kind routine it inherits from (a default setting, not
		## a rule), names it in `executors:`, and nowhere else. Nothing is added here.

		## Every member is asked before the first is started, so a call that names one
		## wrong member starts nobody and leaves no half of a session behind: that its
		## name is a bare one; that it is a member at all, by the member directory, as
		## a member of any workspace of this machine is; and that nothing runs as an
		## identity record, the check every start makes (AgentsToolsTeamMemberStartCheck,
		## which the spawn proxy asks of each spawn).
		local spawnCheckMember spawnCheckFolder
		for spawnCheckMember in "${spawnMembers[@]}" ; do
			AgentsToolsAssertBareName "$spawnCheckMember" "<team-member>" spawn-session || { set +e ; return 1 ; }
			if ! spawnCheckFolder="$( AgentsToolsTeamMemberDirectory "$spawnCheckMember" )" ; then
				echo "$MDSC_CMD: spawn-session: ⛔ ERROR: no such team member: $spawnCheckMember" >&2
				set +e ; return 1
			fi
			AgentsToolsTeamMemberStartCheck "$spawnCheckMember" "$spawnCheckFolder" "--spawn-session" || { set +e ; return 1 ; }
		done

		## A `<type>-*` among the routine's own executors or the caller's, and two or more members the
		## caller names, partition the run: one session per member, under one agent-less parent session
		## (the tooling's own new session) that owns the run as its caller, watches them, posts to Slack,
		## and finishes itself once all are done. The routine's own concrete list of executors is one
		## coworking session of all of them, as it always was.
		local partitionRoster="$callerWild" execEntry
		if [ "$rosterExpanded" = "true" ] ; then
			for execEntry in ${routineExecutorsLine//,/ } ; do
				case "$execEntry" in *-'*') partitionRoster="true" ;; esac
			done
		elif [ ${#spawnMembers[@]} -ge 2 ] ; then
			partitionRoster="true"
		fi

		## The first spawn starts the session; every further one joins it by the
		## session id the first spawn's own output reports. An executor commands
		## only the members it spawned itself (magic-team.coworking.routine's own
		## rule), which is why this call never spawns the routine's invitees.
		local spawnSessionId="" spawnMember spawnOut
		local spawnFirst="true"
		local partitionParentId="" partitionChildren="" partitionMember="" partitionSession="" partitionThread="" partitionReports=""
		local partitionRecord="" partitionFailed="" partitionTemp partitionWatcher partitionStart
		if [ "$partitionRoster" = "true" ] ; then
			## The caller the parent stands for: its member, its session and its thread, read before any spawn.
			type AgentsToolsRunRouteValid > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SpawnSandbox.include" || { set +e ; return 1 ; }
			partitionMember="$( AgentsToolsActingMember 2> /dev/null )" || partitionMember=""
			partitionSession="$( AgentsToolsSessionCurrentId )"
			partitionThread="$( AgentsToolsSessionCurrentThreadFind 2> /dev/null )" || partitionThread=""
			## Where the caller is: its session and member, else its member, else the person at the console, as the spawn proxy names one.
			if [ -n "$partitionMember" ] && [ -n "$partitionSession" ] ; then
				partitionReports="$partitionSession:$partitionMember"
			elif [ -n "$partitionMember" ] ; then
				partitionReports="$partitionMember"
			else
				partitionReports="$( id -un 2> /dev/null )" || partitionReports=""
				partitionReports="${partitionReports:-${USER:-${LOGNAME:-}}}"
				[ -z "$partitionReports" ] || partitionReports="user-$partitionReports"
			fi
			AgentsToolsRunRouteValid "$partitionReports" || partitionReports=""
			## The parent session is minted here, agent-less, and the members are its children, each its
			## own session (the same routine run on each, with its own scope), so their handbacks and
			## escalations reach the parent and nobody's work blocks another's.
			partitionParentId="$( uuidgen 2>/dev/null | LC_ALL=C tr 'ABCDEF' 'abcdef' )"
			if [ -z "$partitionParentId" ] ; then
				echo "$MDSC_CMD: spawn-session: ⛔ ERROR: uuidgen produced no session id for the agent-less parent -- refusing to partition" >&2
				set +e ; return 1
			fi
			## The caller's thread is the parent's, so a child's session-parent is that thread from its first post.
			if [ -n "$partitionThread" ] ; then
				mkdir -p "$MMDAPP/.local/agents/sessions/$partitionParentId" && printf '%s\n' "$partitionThread" > "$MMDAPP/.local/agents/sessions/$partitionParentId/session.thread" \
					|| { echo "$MDSC_CMD: spawn-session: ⛔ ERROR: could not record the caller's thread for the agent-less parent $partitionParentId -- nothing was started" >&2 ; set +e ; return 1 ; }
			fi
			## Its own record, written by the tooling before the first child starts, so a child's start finds its parent there.
			partitionRecord="$MMDAPP/.local/agents/spawned/$partitionParentId/$partitionParentId.spawn.md"
			mkdir -p "${partitionRecord%/*}" && {
				printf '%s\n' "---"
				printf 'session-id: %s\n' "$partitionParentId"
				printf 'spawn-id: %s\n' "$partitionParentId"
				printf 'owner: %s\n' "${partitionMember:-human-owner}"
				printf 'start-context: %s\n' "spawned"
				printf 'parent-spawn-id: %s\n' "${MDAT_SPAWN_SESSION_ID:-none}"
				printf 'routine: %s\n' "$resolvedRoutineName"
				printf 'session-comment: agent-less parent of %s\n' "$resolvedRoutineName"
				[ -z "$partitionThread" ] || printf 'session-thread: %s\n' "$partitionThread"
				[ -z "$partitionReports" ] || printf 'reports-to: %s\n' "$partitionReports"
				printf 'agent-less: %s\n' "true"
				printf 'children:\n'
				printf 'status: %s\n' "spawn-started"
				printf 'started-at: %s\n' "$( date +"%Y-%m-%d %H:%M %z" )"
				printf '%s\n' "---"
				printf '\n# Agent-less parent session: %s\n' "$partitionParentId"
			} > "$partitionRecord" || { echo "$MDSC_CMD: spawn-session: ⛔ ERROR: could not write the record of the agent-less parent $partitionParentId -- nothing was started" >&2 ; set +e ; return 1 ; }
		fi
		for spawnMember in "${spawnMembers[@]}" ; do
			local spawnArgs=( "$spawnMember" --dispatch-doc:create )
			if [ "$routineDefault" = "true" ] ; then
				spawnArgs+=( --routine-default )
			else
				spawnArgs+=( --routine "$routineSelector" )
			fi
			[ -z "$sessionNameOrComment" ] || spawnArgs+=( --session-name-or-comment "$sessionNameOrComment" )
			[ -z "$sessionDescription" ] || spawnArgs+=( --description "$sessionDescription" )
			[ -z "$sessionCliService" ] || spawnArgs+=( --spawn-cli-service "$sessionCliService" )
			[ -z "$sessionSettingsWorkspace" ] || spawnArgs+=( --spawn-settings-workspace "$sessionSettingsWorkspace" )
			if [ "$partitionRoster" = "true" ] ; then
				[ -z "$partitionReports" ] || spawnArgs+=( --reports-to "$partitionReports" )
				spawnOut="$( printf '%s\n' "$spawnTaskText" | DistroAgentsTools --intern-op-agent-spawn-proxy "${spawnArgs[@]}" --session-new --parent-session "$partitionParentId" --context --spawn-session )" \
					|| { partitionFailed="the spawn of $spawnMember failed" ; break ; }
				local partitionChildId
				partitionChildId="$( printf '%s\n' "$spawnOut" | LC_ALL=C awk -F= '$1 == "SESSION_ID" { print $2 ; exit ; }' )"
				[ -n "$partitionChildId" ] || { partitionFailed="the spawn of $spawnMember reported no SESSION_ID" ; break ; }
				partitionChildren="$partitionChildren${partitionChildren:+ }$partitionChildId"
			elif [ "$spawnFirst" = "true" ] ; then
				## This operation starts a session, so its first spawn asks for one of its own:
				## otherwise it would be brought into the calling session's.
				spawnOut="$( printf '%s\n' "$spawnTaskText" | DistroAgentsTools --intern-op-agent-spawn-proxy "${spawnArgs[@]}" --session-new --context --spawn-session )" || { set +e ; return 1 ; }
				spawnSessionId="$( printf '%s\n' "$spawnOut" | LC_ALL=C awk -F= '$1 == "SESSION_ID" { print $2 ; exit ; }' )"
				if [ -z "$spawnSessionId" ] ; then
					echo "$MDSC_CMD: spawn-session: ⛔ ERROR: the first spawn ($spawnMember) reported no SESSION_ID -- refusing to spawn the rest into no session" >&2
					set +e ; return 1
				fi
				spawnFirst="false"
			else
				spawnArgs+=( --session-id "$spawnSessionId" )
				printf '%s\n' "$spawnTaskText" | DistroAgentsTools --intern-op-agent-spawn-proxy "${spawnArgs[@]}" --context --spawn-session > /dev/null || { set +e ; return 1 ; }
			fi
		done
		if [ "$partitionRoster" = "true" ] ; then
			## The children started, a failure partway included, are the parent's: named on its record, and its watcher starts over
			## them, detached, so it outlives this call as a session does. Its pid and host are on the record, for liveness.
			partitionTemp="$( mktemp "$partitionRecord.tmp.XXXXXX" )" \
				&& LC_ALL=C awk -v kids="$partitionChildren" '$0 == "children:" { print "children: " kids ; next ; } { print ; }' "$partitionRecord" > "$partitionTemp" \
				&& chmod 644 "$partitionTemp" && mv -f "$partitionTemp" "$partitionRecord" \
				|| { echo "$MDSC_CMD: spawn-session: ⛔ ERROR: could not name the children ${partitionChildren:-none} on the record of the agent-less parent $partitionParentId" >&2 ; set +e ; return 1 ; }
			mkdir -p "$MMDAPP/.local/agents/sessions" 2>/dev/null || :
			( AgentsToolsSpawnSessionParent "$partitionParentId" ) >> "$MMDAPP/.local/agents/sessions/$partitionParentId.log" 2>&1 &
			partitionWatcher=$!
			type AgentsToolsRegistryProcessStart > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.Registries.include"
			partitionStart="$( AgentsToolsRegistryProcessStart "$partitionWatcher" )"
			partitionTemp="$( mktemp "$partitionRecord.tmp.XXXXXX" )" \
				&& LC_ALL=C awk -v host="$( hostname -s 2> /dev/null || echo unknown )" -v run="$partitionWatcher${partitionStart:+ $partitionStart}" \
					'$0 == "---" && ++fence == 2 { print "host: " host ; print "run-process: " run ; } { print ; }' "$partitionRecord" > "$partitionTemp" \
				&& chmod 644 "$partitionTemp" && mv -f "$partitionTemp" "$partitionRecord" \
				|| echo "$MDSC_CMD: spawn-session: ⚠️ WARNING: the watcher of the agent-less parent $partitionParentId runs as $partitionWatcher, and its record could not say so" >&2
			if [ -n "$partitionFailed" ] ; then
				echo "$MDSC_CMD: spawn-session: ⛔ ERROR: $partitionFailed -- the agent-less parent $partitionParentId watches the children already started, and closes over them: ${partitionChildren:-none}" >&2
				set +e ; return 1
			fi
			echo "SESSION_ID=$partitionParentId"
			echo "ROUTINE=$resolvedRoutineName"
			echo "MEMBERS=${spawnMembers[*]}"
			echo "CHILDREN=$partitionChildren"
			return 0
		fi
		echo "SESSION_ID=$spawnSessionId"
		echo "ROUTINE=$resolvedRoutineName"
		echo "MEMBERS=${spawnMembers[*]}"
		return 0
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
