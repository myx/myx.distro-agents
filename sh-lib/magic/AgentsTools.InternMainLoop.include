#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## Caller-less daemon loop: one iteration is housekeeping, the configuration check
## and the schedule's steps (all scripts, no agent), then a sleep, repeated forever,
## no cap. It starts no routine of its own: the routines the schedule declares are
## started through the spawner, by the schedule's steps.
## Sourced from DistroAgentsTools.fn.sh's `--intern-main-loop` arm; needs
## $1/$@/$MDSC_CMD from dot-sourcing. Mirrors --intern-mcp-server's own shape:
## usage blurb on no flag, set +e/set -e discipline.
##

case "$1" in

	--intern-main-loop)
		shift

		## Never run without a mode: an accidental invocation hangs forever.
		local mainLoopMode=''
		case "$1" in
			--run) mainLoopMode='--run' ;;
			--one) mainLoopMode='--one' ;;
		esac
		if [ -z "$mainLoopMode" ] ; then
			printf '%s\n' "$MDSC_CMD --intern-main-loop -- runs the housekeeping, the configuration check and the schedule's steps, again and again, normal daemon loop, no cap." >&2
			printf '%s\n' "" >&2
			printf '%s\n' "  $MDSC_CMD --intern-main-loop --run" >&2
			printf '%s\n' "      Run one iteration, sleep, repeat -- forever, until killed." >&2
			printf '%s\n' "      This is the basement layer that RUNS own-service mode, not merely gated behind it already being up." >&2
			printf '%s\n' "" >&2
			printf '%s\n' "  $MDSC_CMD --intern-main-loop --one" >&2
			printf '%s\n' "      Run exactly one iteration and return its status. No sleep, no repeat." >&2
			printf '%s\n' "      Runs the same readiness check, so it is also how that gate is exercised by hand." >&2
			printf '%s\n' "" >&2
			printf '%s\n' "Runs a short readiness check first and prints a compact report; the loop is entered only when all required settings are present." >&2
			set +e ; return 1
		fi
		shift

		if [ 0 -lt $# ] ; then
			printf '%s\n' "$MDSC_CMD: main-loop $mainLoopMode: ⛔ ERROR: takes no further arguments: $*" >&2
			set +e ; return 1
		fi

		set +e

		## Every catalogue option this operation reads takes its scope from the catalogue,
		## never restated here, so a key the catalogue moves to another scope is followed.
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/config/AgentsTools.OwnerSetupOptionSpec.include"
		local mainLoopOptionSpec

		## Short readiness check, run from here and shown as a compact,
		## plain-language report before the loop is entered. check-configs only
		## PROBES presence here (every key --optional); the readiness report owns
		## the floor policy -- which items gate, and how Basic comms is satisfied
		## by any one transport -- and its own exit (PIPESTATUS[1]) is the gate.
		## The floor is the team data root + Basic comms + SPAWN_CLI_SERVICE,
		## the last two read in one probe per catalogue scope; the event-track and
		## event-alert channels are probed for the report but never gate.
		## The report goes to STDERR, like the per-iteration lines below: this
		## operation is a daemon loop whose whole life is watched on stderr, so
		## the readiness verdict belongs on the same stream as everything else
		## it says. Nothing consumes this report on stdout -- the awk's exit is
		## the machine-readable half, and PIPESTATUS[1] survives the redirect:
		## the group is one pipeline stage, so the awk is still stage 1.
		{
			## Team data is never unset: without TEAM_DATA_DIRECTORY the resolver
			## gives the workspace's own store, so the floor reads that answer.
			[ -z "${MDAT_DATA_ROOT:-}" ] || echo "TEAM_DATA_DIRECTORY: OK"
			## One probe per distinct catalogue scope, each carrying the keys that scope holds.
			local mainLoopReadyItems="SLACK_CHANNEL_MAGIC_TEAM:<channel-id> SLACK_CHANNEL_HUMAN_OWNER:<user-id> SLACK_CHANNEL_EVENT_TRACK:<channel-id> SLACK_CHANNEL_EVENT_ALERT:<channel-id> SPAWN_CLI_SERVICE:<cli-name>"
			local mainLoopReadyScope mainLoopReadyItem mainLoopReadyArgs
			for mainLoopReadyScope in $(
				for mainLoopReadyItem in $mainLoopReadyItems ; do
					mainLoopOptionSpec="$( AgentsToolsOwnerSetupOptionSpec "${mainLoopReadyItem%%:*}" )"
					printf '%s\n' "${mainLoopOptionSpec%%|*}"
				done | LC_ALL=C sort -u
			) ; do
				## Split unquoted on purpose: every item is one word with no glob character.
				mainLoopReadyArgs=""
				for mainLoopReadyItem in $mainLoopReadyItems ; do
					mainLoopOptionSpec="$( AgentsToolsOwnerSetupOptionSpec "${mainLoopReadyItem%%:*}" )"
					[ "${mainLoopOptionSpec%%|*}" = "$mainLoopReadyScope" ] || continue
					mainLoopReadyArgs="$mainLoopReadyArgs --optional $mainLoopReadyItem"
				done
				DistroAgentsTools --intern-op-check-configs "$mainLoopReadyScope" $mainLoopReadyArgs \
					--context --intern-main-loop 2>&1
			done
			## Sign-in state of the selected CLI, as one more verdict line into the
			## same awk, asked with this workspace's own stored credential in scope
			## -- the console exports exactly these names before it execs, so
			## probing without them reports a machine that spawns perfectly well as
			## signed out. The export lives in the probe's own subshell.
			## Reported, never gating: the CLI's own answer is the only reliable
			## one, so a CLI that cannot answer -- any but claude, one too old for
			## `auth status`, one absent from PATH -- yields SKIP rather than a
			## verdict, and no output shape this does not recognise can refuse a
			## machine that works. `claude auth status` reads local state only,
			## ~0.3s once at startup, stdin closed so nothing can prompt; it
			## answers loggedIn true for an API key and for a Bedrock/Vertex
			## provider too, so those working setups are not misread as signed out.
			mainLoopOptionSpec="$( AgentsToolsOwnerSetupOptionSpec SPAWN_CLI_SERVICE )"
			case "$( DistroAgentsTools --agents-config-option "${mainLoopOptionSpec%%|*}" --select SPAWN_CLI_SERVICE 2>/dev/null )" in
				claude)
					case "$(
						for mainLoopAuthKey in ANTHROPIC_API_KEY CLAUDE_CODE_OAUTH_TOKEN ; do
							mainLoopOptionSpec="$( AgentsToolsOwnerSetupOptionSpec "$mainLoopAuthKey" )"
							mainLoopAuthValue="$( DistroAgentsTools --agents-config-option "${mainLoopOptionSpec%%|*}" --select "$mainLoopAuthKey" 2>/dev/null )"
							[ -n "$mainLoopAuthValue" ] || continue
							export "$mainLoopAuthKey=$mainLoopAuthValue"
						done
						claude auth status </dev/null 2>/dev/null
					)" in
						*'"loggedIn": true'*)  echo "SPAWN_CLI_AUTHENTICATED: OK" ;;
						*'"loggedIn": false'*) echo "SPAWN_CLI_AUTHENTICATED: FAIL" ;;
						*)                     echo "SPAWN_CLI_AUTHENTICATED: SKIP" ;;
					esac
				;;
				*) echo "SPAWN_CLI_AUTHENTICATED: SKIP" ;;
			esac
		} | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/magic/AgentsMainLoopReadinessReport.awk" >&2
		if [ 0 -ne "${PIPESTATUS[1]}" ] ; then
			return 1
		fi

		local sleepSeconds mainLoopRc nextDelaySeconds maxDelaySeconds
		sleepSeconds="$( DistroAgentsTools --agents-config-option magic-coordinator --select-default MAIN_LOOP_RESTART_DELAY_SECONDS 29 )"
		case "$sleepSeconds" in *[!0123456789]*|'') sleepSeconds=29 ;; esac
		maxDelaySeconds="$( DistroAgentsTools --agents-config-option magic-coordinator --select-default MAIN_LOOP_RESTART_DELAY_MAX_SECONDS 1200 )"
		case "$maxDelaySeconds" in *[!0123456789]*|'') maxDelaySeconds=1200 ;; esac
		nextDelaySeconds="$sleepSeconds"

		## Team data is pulled by the loop, not by the deploy, and only when a remote is
		## configured. The branch is passed explicitly and never left empty: clonePull
		## compares the checkout against "${branch:-master}" AND "${branch:-main}", so an
		## empty value deletes any checkout on a third branch and re-clones it every
		## iteration. A configured value collapses both arms to one correct test.
		local mainLoopDataRemote mainLoopDataBranch
		mainLoopOptionSpec="$( AgentsToolsOwnerSetupOptionSpec TEAM_DATA_GIT_REMOTE )"
		mainLoopDataRemote="$( DistroAgentsTools --agents-config-option "${mainLoopOptionSpec%%|*}" --select TEAM_DATA_GIT_REMOTE 2>/dev/null )"
		mainLoopOptionSpec="$( AgentsToolsOwnerSetupOptionSpec TEAM_DATA_BRANCH )"
		mainLoopDataBranch="$( DistroAgentsTools --agents-config-option "${mainLoopOptionSpec%%|*}" --select-default TEAM_DATA_BRANCH main )"
		[ -n "$mainLoopDataBranch" ] || mainLoopDataBranch="main"
		local mainLoopTeamData="skipped" mainLoopTeamDataFailures=0

		## Read from outside by a health check, so it is an interface rather than scratch:
		## it lives beside the other durable command data, is world-readable, and is
		## written atomically. Nothing secret may ever be added to it.
		local mainLoopStateFile="$MMDAPP/.local/agents/main-loop.state"
		local mainLoopConsecutiveFailures=0

		local mainLoopInterrupted="false"
		## One Ctrl-C stops the loop outright: the iteration in flight ends at its next step and the loop returns.
		trap 'mainLoopInterrupted="true"' INT TERM

		## Health reporting must never kill what it reports on, so every step is swallowed:
		## set -e is in force and a failing mktemp, write, chmod or mv would end the loop.
		## Atomic by the same recipe as the console -- chmod before the rename, because mv
		## carries the temp's mode -- so an external reader never sees a half-written file.
		AgentsToolsMainLoopWriteState() {
			local stateOutcome="$1" stateTemp
			(
				mkdir -p "$MMDAPP/.local/agents"
				stateTemp="$( mktemp "$mainLoopStateFile.XXXXXX" )"
				{
					printf 'MAIN_LOOP_LAST_OUTCOME=%s\n' "$stateOutcome"
					printf 'MAIN_LOOP_LAST_ITERATION_UTC=%s\n' "$( date -u +%Y-%m-%dT%H:%M:%SZ )"
					printf 'MAIN_LOOP_CONSECUTIVE_FAILURES=%s\n' "$mainLoopConsecutiveFailures"
					printf 'MAIN_LOOP_CURRENT_DELAY_SECONDS=%s\n' "$nextDelaySeconds"
					printf 'MAIN_LOOP_TEAM_DATA=%s\n' "$mainLoopTeamData"
					printf 'MAIN_LOOP_TEAM_DATA_CONSECUTIVE_FAILURES=%s\n' "$mainLoopTeamDataFailures"
				} > "$stateTemp"
				chmod 644 "$stateTemp"
				mv "$stateTemp" "$mainLoopStateFile"
			) 2>/dev/null || echo "# $MDSC_CMD --intern-main-loop: could not write $mainLoopStateFile -- the loop is unaffected, the health check is blind" >&2
		}

		## Non-fatal by design: a network fault must not stop a loop that can still serve
		## its local copy, and failing the iteration would lengthen the backoff -- making
		## the loop do LESS work exactly when its data is stale. clonePull self-cleans a
		## failed clone, so there is never a partial checkout to run against, and its own
		## ConnectTimeout/BatchMode exports bound an unreachable remote to ~15-45s rather
		## than hanging an unattended box. Persistent staleness is reported in the state
		## file rather than logged and forgotten.
		AgentsToolsMainLoopSyncTeamData() {
			[ -n "$mainLoopDataRemote" ] || { mainLoopTeamData="skipped" ; return 0 ; }
			if [ -z "${MYXROOT:-}" ] || [ ! -f "$MYXROOT/bin/git/clonePull.Common" ] || [ ! -f "$MYXROOT/bin/git/cloneSync.Common" ] ; then
				mainLoopTeamData="skipped"
				echo "# $MDSC_CMD --intern-main-loop: team-data sync skipped -- myx.common git/clonePull or git/cloneSync unreachable" >&2
				return 0
			fi
			## A store holding content and not yet a clone -- the default store, used
			## before a remote was set -- is adopted by cloneSync, which commits it and
			## pushes it into an EMPTY remote; clonePull refuses a non-empty directory.
			## The branch travels as init.defaultBranch so that first commit is on the
			## branch clonePull later tracks: any other makes it delete the checkout.
			local syncCommand="clonePull"
			## A store that is a repository with no origin, or another one, is given the remote
			## first: clonePull's own `remote set-url` fails on a repository with none, before it
			## reaches the remote (AgentsToolsTeamDataRemoteAlign).
			. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.TeamDataCommit.include"
			[ ! -e "$MDAT_DATA_ROOT/.git" ] || AgentsToolsTeamDataRemoteAlign "main-loop iteration" "$mainLoopDataRemote" || :
			if [ -d "$MDAT_DATA_ROOT" ] && [ ! -d "$MDAT_DATA_ROOT/.git" ] && [ -n "$( ls -A "$MDAT_DATA_ROOT" 2>/dev/null )" ] ; then
				syncCommand="cloneSync"
			fi
			if ( GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=init.defaultBranch GIT_CONFIG_VALUE_0="$mainLoopDataBranch" \
				"$MYXROOT/bin/git/$syncCommand.Common" "$MDAT_DATA_ROOT" "$mainLoopDataRemote" "$mainLoopDataBranch" >&2 ) ; then
				mainLoopTeamData="ok" ; mainLoopTeamDataFailures=0
			else
				mainLoopTeamData="stale" ; mainLoopTeamDataFailures=$(( mainLoopTeamDataFailures + 1 ))
				echo "# $MDSC_CMD --intern-main-loop: team-data sync failed ($mainLoopTeamDataFailures in a row), continuing on the local copy" >&2
				[ "$syncCommand" != "cloneSync" ] || echo "# $MDSC_CMD --intern-main-loop: $MDAT_DATA_ROOT holds local content and is not a clone: it is adopted only into an empty remote, so merge it with $mainLoopDataRemote by hand" >&2
			fi
			## After the pull: commits still local from earlier closes go out here.
			. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.TeamDataCommit.include"
			AgentsToolsTeamDataPushIfAhead "main-loop iteration"
			return 0
		}

		## The configuration check, run as a script and no agent: the check of the team's settings, tokens and channels. It
		## runs no more than once in 30 minutes while it passes (it asks Slack), and in each iteration while its last result is
		## a failure. Its answer and the time are kept in main-loop.config-check.last. A FAIL line is said on stderr with its
		## reason; any FAIL is a failed check. Prints nothing; the answer is $? (0 passed, 1 failed).
		AgentsToolsMainLoopConfigCheck() {
			local checkFile="$MMDAPP/.local/agents/main-loop.config-check.last" checkNow checkLastRc="" checkLastAt="" checkOut checkRc
			checkNow="$( date +%s )"
			{ read -r checkLastRc checkLastAt < "$checkFile" ; } 2> /dev/null || :
			case "$checkLastAt" in ''|*[!0123456789]*) checkLastAt=0 ; checkLastRc="" ;; esac
			if [ "$checkLastRc" = 0 ] && [ "$checkNow" -ge "$checkLastAt" ] && [ "$(( checkNow - checkLastAt ))" -lt 1800 ] ; then
				return 0
			fi
			checkOut="$( DistroAgentsTools --magic-config-check < /dev/null 2>&1 )" && checkRc=0 || checkRc=1
			if [ "$checkRc" = 0 ] ; then
				echo "# $MDSC_CMD --intern-main-loop: ✅ configuration check passed, the next in 30 minutes" >&2
			else
				echo "# $MDSC_CMD --intern-main-loop: ⛔ configuration check FAILED:" >&2
				printf '%s\n' "$checkOut" | LC_ALL=C grep -e ': FAIL$' -e '^  fail:' -e 'ERROR: .* is not configured' | LC_ALL=C sed -e 's/^/#   /' >&2 || :
			fi
			mkdir -p "$MMDAPP/.local/agents" \
				&& printf '%s %s\n' "$checkRc" "$checkNow" > "$MMDAPP/.local/agents/main-loop.config-check.last.$$" \
				&& mv -f "$MMDAPP/.local/agents/main-loop.config-check.last.$$" "$checkFile" \
				|| { rm -f "$MMDAPP/.local/agents/main-loop.config-check.last.$$" ; echo "# $MDSC_CMD --intern-main-loop: the result of the configuration check could not be kept" >&2 ; }
			return "$checkRc"
		}

		## One iteration: the configuration check (first: it takes seconds, and the steps below read the state of the workspace as it stands when they
		## run), the housekeeping, then the schedule's steps, which run only when the check passed. The result is left in $mainLoopRc.
		AgentsToolsMainLoopIteration() {
			mainLoopRc=0
			local mainLoopConfigOk=""
			if AgentsToolsMainLoopConfigCheck ; then mainLoopConfigOk="yes" ; else mainLoopRc=1 ; fi
			AgentsToolsMainLoopSyncTeamData
			. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SpawnSandbox.include"
			AgentsToolsSpawnSandboxSweep "--intern-main-loop"
			## Each parent session's list of its children, rebuilt from the spawn records in
			## one pass, before anything is spawned. Logged, never fatal: lists that could not
			## be rebuilt stay unmarked, and every harness then scans every record.
			. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.ChildrenIndex.include" \
				&& AgentsToolsChildrenIndexRepair "$MMDAPP" \
				&& echo "# $MDSC_CMD --intern-main-loop: children lists rebuilt under .local/agents/children" >&2 \
				|| echo "# $MDSC_CMD --intern-main-loop: the children lists could not be rebuilt -- every harness scans every spawn record until an iteration rebuilds them" >&2
			## The board's housekeeping, by script and no agent (F3.1, F7.12), so the work-duty session of the coordinator reads a board that is
			## settled: what a dead spawn left open is closed (AgentsToolsAdvanceSpawnHousekeeping), and the edges of the dependencies are made
			## whole and the dependencies computed, once for each change of the board (AgentsToolsBoardDependencies). A line for each thing done;
			## never fatal. The control threads are the loop's own check, a step below (the housekeeping of a manual start does both).
			local mainLoopHouse="" mainLoopHouseLine
			mainLoopHouse="$(
				set +e
				. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.Registries.include" > /dev/null 2>&1 || exit 1
				. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/magic/AgentsTools.SpawnHousekeeping.include" > /dev/null 2>&1 || exit 1
				. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.BoardDependencies.include" > /dev/null 2>&1 || exit 1
				AgentsToolsAdvanceSpawnHousekeeping 24 magic-coordinator no-threads 2>&1 > /dev/null
				AgentsToolsBoardDependencies 2> /dev/null
			)" || mainLoopHouse="housekeeping: the board's housekeeping could not run"
			while IFS= read -r mainLoopHouseLine ; do
				[ -z "$mainLoopHouseLine" ] || echo "# $MDSC_CMD --intern-main-loop: $mainLoopHouseLine" >&2
			done <<< "$mainLoopHouse"
			## Answers to questions whose session has ended, collected by the tooling before
			## anything is spawned, each going to its asker's inbox. The result is kept as a
			## file (pending-collect.last) that a work-duty scan reads; no model
			## does the collecting.
			mkdir -p "$MMDAPP/.local/agents" \
				&& DistroAgentsTools --intern-op-pending-reply-collect --ended --context --intern-main-loop \
					> "$MMDAPP/.local/agents/pending-collect.last.$$" 2>/dev/null \
				&& mv -f "$MMDAPP/.local/agents/pending-collect.last.$$" "$MMDAPP/.local/agents/pending-collect.last" \
				&& echo "# $MDSC_CMD --intern-main-loop: $( tail -1 "$MMDAPP/.local/agents/pending-collect.last" )" >&2 \
				|| { rm -f "$MMDAPP/.local/agents/pending-collect.last.$$" ; echo "# $MDSC_CMD --intern-main-loop: the pending-reply collect could not run" >&2 ; }
			## Reminders for the asks the collect left waiting, on the 30m / 2h / daily schedule
			## stamped in each record (AgentsTools.PendingReplyRemind.include). Tooling only; a
			## failure is logged and the iteration goes on. It never closes an ask.
			mkdir -p "$MMDAPP/.local/agents" \
				&& (
					. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.PendingReplyCollect.include"
					. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.PendingReplyRemind.include"
					AgentsToolsPendingReplyRemindRun
				) > "$MMDAPP/.local/agents/pending-remind.last.$$" 2>/dev/null \
				&& mv -f "$MMDAPP/.local/agents/pending-remind.last.$$" "$MMDAPP/.local/agents/pending-remind.last" \
				&& echo "# $MDSC_CMD --intern-main-loop: $( tail -1 "$MMDAPP/.local/agents/pending-remind.last" )" >&2 \
				|| { rm -f "$MMDAPP/.local/agents/pending-remind.last.$$" ; echo "# $MDSC_CMD --intern-main-loop: the pending-reply reminders could not run" >&2 ; }
			## The on-demand check of the health of the sessions, included here because the loop
			## runs: the control thread of each session of this workspace that is not finished and
			## has none alive is started, detached and never waited for
			## (AgentsToolsSessionControlCheckWorkspace, AgentsTools.SessionControlStart.include).
			## Local files and the process list only, in a subshell of its own. Logged, never
			## fatal: a check that fails leaves the iteration as it was.
			local mainLoopControl="" mainLoopControlSession mainLoopControlWord mainLoopControlPid mainLoopControlWhy mainLoopControlStarted="" mainLoopControlCount=0
			if mainLoopControl="$(
				set +e
				. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.Registries.include" || exit 1
				. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionControlStart.include" || exit 1
				AgentsToolsSessionControlCheckWorkspace 2> /dev/null
			)" ; then
				while read -r mainLoopControlSession mainLoopControlWord mainLoopControlPid mainLoopControlWhy ; do
					case "$mainLoopControlWord" in
						started) mainLoopControlStarted="$mainLoopControlStarted $mainLoopControlSession" ; mainLoopControlCount=$(( mainLoopControlCount + 1 )) ;;
						failed) echo "# $MDSC_CMD --intern-main-loop: the control thread of session $mainLoopControlSession could not be started: $mainLoopControlWhy" >&2 ;;
					esac
				done <<< "$mainLoopControl"
				[ "$mainLoopControlCount" -eq 0 ] || echo "# $MDSC_CMD --intern-main-loop: started the control thread of $mainLoopControlCount session(s):$mainLoopControlStarted" >&2
			else
				echo "# $MDSC_CMD --intern-main-loop: the control threads of the sessions could not be checked -- the iteration goes on" >&2
			fi
			## The collection of the sources an input scan reads (F4.2): a full team rig keeps the one background thread that updates them,
			## checked here as a control thread is. It is wanted by this very iteration, started where none lives and a source of the
			## members a scan reads is configured, and looked at no more than once in five minutes. One word, logged when something was
			## done; never fatal.
			local mainLoopCollect=""
			mainLoopCollect="$(
				set +e
				. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.CollectThread.include" 2> /dev/null || exit 1
				AgentsToolsCollectThreadCheck main-loop 2> /dev/null
			)" || mainLoopCollect="failed - the check could not run"
			case "$mainLoopCollect" in
				started*|failed*) echo "# $MDSC_CMD --intern-main-loop: the source collector: $mainLoopCollect" >&2 ;;
			esac
			## The schedule (F7.5): the autorun of the routines that declare one, the work-duty sessions the flags allow, and the learning
			## inquiry for each session that ended (AgentsTools.DispatcherLoop.include). The decisions are Dispatcher's: the loop asks, and
			## starts through the spawner. One line for each thing done; never fatal. They run only
			## when the configuration check passed: a failed check is the iteration's failure (the backoff applies), and starts nothing.
			local mainLoopSchedule="" mainLoopScheduleLine
			[ "$mainLoopInterrupted" = "false" ] || return 0
			if [ -n "$mainLoopConfigOk" ] ; then
				mainLoopSchedule="$(
					set +e
					. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.DispatcherLoop.include" 2> /dev/null || exit 1
					AgentsToolsScheduleLoop 2> /dev/null
				)" || mainLoopSchedule="schedule: the steps could not run"
				while IFS= read -r mainLoopScheduleLine ; do
					[ -z "$mainLoopScheduleLine" ] || echo "# $MDSC_CMD --intern-main-loop: $mainLoopScheduleLine" >&2
				done <<< "$mainLoopSchedule"
			else
				echo "# $MDSC_CMD --intern-main-loop: the schedule's starts are skipped in this iteration" >&2
			fi
		}

		## Every clean-stop path writes "stopped" before returning. That is the whole point
		## of a state file over a success flag: a reader can tell a loop deliberately
		## stopped from one wedged or crashed, which a timestamp alone cannot. The three
		## interrupt returns below are exactly the paths a bottom-of-loop write would miss.
		AgentsToolsMainLoopStopped() {
			AgentsToolsMainLoopWriteState stopped
			echo "# $MDSC_CMD --intern-main-loop: interrupted, stopping" >&2
		}

		## One look: same iteration, no sleep, no loop to leave.
		if [ '--one' = "$mainLoopMode" ] ; then
			AgentsToolsMainLoopIteration
			trap - INT TERM
			[ "$mainLoopInterrupted" = "false" ] || { AgentsToolsMainLoopStopped ; return 130 ; }
			[ 0 -eq "$mainLoopRc" ] || echo "# $MDSC_CMD --intern-main-loop: iteration FAILED, the configuration check failed" >&2
			[ 0 -eq "$mainLoopRc" ] && mainLoopConsecutiveFailures=0 || mainLoopConsecutiveFailures=1
			[ 0 -eq "$mainLoopRc" ] && AgentsToolsMainLoopWriteState ok || AgentsToolsMainLoopWriteState failed
			return "$mainLoopRc"
		fi

		while true ; do
			AgentsToolsMainLoopIteration
			[ "$mainLoopInterrupted" = "false" ] || { trap - INT TERM ; AgentsToolsMainLoopStopped ; return 130 ; }
			[ 0 -eq "$mainLoopRc" ] || echo "# $MDSC_CMD --intern-main-loop: iteration FAILED, the configuration check failed" >&2

			## Consecutive failures lengthen the wait; the delay is the state, so doubling stops at the ceiling and cannot overflow.
			if [ 0 -eq "$mainLoopRc" ] ; then
				nextDelaySeconds="$sleepSeconds"
				mainLoopConsecutiveFailures=0
				## The progress flag advances only here, on an iteration that passed; --one
				## never reaches it. Unset outside a rig, where nothing reads a flag.
				[ -z "${MDAT_MAIN_LOOP_PROGRESS_FILE:-}" ] || touch -- "$MDAT_MAIN_LOOP_PROGRESS_FILE" 2>/dev/null \
					|| echo "# $MDSC_CMD --intern-main-loop: could not touch $MDAT_MAIN_LOOP_PROGRESS_FILE -- the loop is unaffected, the progress check will read it as stale" >&2
			else
				mainLoopConsecutiveFailures=$(( mainLoopConsecutiveFailures + 1 ))
				[ "$nextDelaySeconds" -ge "$maxDelaySeconds" ] || nextDelaySeconds=$(( nextDelaySeconds * 2 ))
			fi
			[ "$nextDelaySeconds" -le "$maxDelaySeconds" ] || nextDelaySeconds="$maxDelaySeconds"
			## Written after the delay is computed and before it is served: the reader's
			## question is "should I have heard from you by now?", which needs the tolerance
			## for the silence about to start, not the one already over.
			[ 0 -eq "$mainLoopRc" ] && AgentsToolsMainLoopWriteState ok || AgentsToolsMainLoopWriteState failed
			echo "# $MDSC_CMD --intern-main-loop: iteration ended, sleeping ${nextDelaySeconds}s before the next one" >&2
			sleep "$nextDelaySeconds"
			[ "$mainLoopInterrupted" = "false" ] || { trap - INT TERM ; AgentsToolsMainLoopStopped ; return 130 ; }
		done
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;

esac
