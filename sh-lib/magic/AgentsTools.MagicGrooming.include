			set +e ; return 1
		fi
		if [ -z "$owner" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --grooming-to-archived: --owner-header-value <value> is required" >&2
			set +e ; return 1
		fi
		local fromStateVal="${fromStateArg#--from-state:}"
		local groomedAt ; groomedAt="$( date +"%Y-%m-%d %H:%M %z" )"
		mkdir -p "$MDAT_DATA_ROOT/board/archived" || {
			echo "⛔ ERROR: $MDSC_CMD --grooming-to-archived: can't create board state directory: $MDAT_DATA_ROOT/board/archived" >&2
			set +e ; return 1
		}
		DistroAgentsTools --intern-op-board-upsert-move-edit archived "$itemName" \
			"$fromStateArg" \
			--header:upsert:owner:"$owner" \
			--header:upsert:groomed-at:"$groomedAt" \
			--header:upsert:groomed-from:"$fromStateVal" \
			--header:upsert:track:true \
			--context --grooming-to-archived \
			"${passthrough[@]}" || return $?
		## An archive ends the item's child, ordered and recorded (AgentsTools.ReviewFlow.include):
		## only on a real move into archived, and never failing the move.
		if [ "$fromStateVal" != archived ] && [ -f "$MDAT_DATA_ROOT/board/archived/$itemName" ] ; then
			. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.ReviewFlow.include"
			AgentsReviewEndChild "$callingMember" "$MDAT_DATA_ROOT/board/archived/$itemName" archived || :
		fi
		return 0
	;;

	## routine-grooming does NOT move items into board-retained, and this op
	## is not evidence that it does.
	--grooming-to-retained)
		shift
		## <team-member> captured for future logging/validation, unused today
		local callingMember="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$callingMember" ] || [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --grooming-to-retained: syntax is <team-member> <item-filename> --from-state:<state> --owner-header-value <value> [--header:<upsert|append|remove>:name[:value]]... [--upsert-from-stdin|--edit-script-from-stdin:<py|awk>|--edit-patch-from-stdin]" >&2
			set +e ; return 1
		fi
		local fromStateArg="" owner=""
		local passthrough=()
		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-state:*) fromStateArg="$1" ; shift ;;
				--owner-header-value)
					if [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --grooming-to-retained: --owner-header-value: value required" >&2
						set +e ; return 1
					fi
					owner="$2" ; shift 2
				;;
				--recheck-in) passthrough+=( "$1" "${2:-}" ) ; shift ; shift || true ;;
				--header:*|--upsert-from-stdin|--edit-script-from-stdin:*|--edit-patch-from-stdin)
					passthrough+=( "$1" ) ; shift
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --grooming-to-retained: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$fromStateArg" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --grooming-to-retained: --from-state:<state> is required" >&2
			set +e ; return 1
		fi
		if [ -z "$owner" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --grooming-to-retained: --owner-header-value <value> is required" >&2
			set +e ; return 1
		fi
		local fromStateVal="${fromStateArg#--from-state:}"
		local groomedAt ; groomedAt="$( date +"%Y-%m-%d %H:%M %z" )"
		mkdir -p "$MDAT_DATA_ROOT/board/retained" || {
			echo "⛔ ERROR: $MDSC_CMD --grooming-to-retained: can't create board state directory: $MDAT_DATA_ROOT/board/retained" >&2
			set +e ; return 1
		}
		DistroAgentsTools --intern-op-board-upsert-move-edit retained "$itemName" \
			"$fromStateArg" \
			--header:upsert:owner:"$owner" \
			--header:upsert:groomed-at:"$groomedAt" \
			--header:upsert:groomed-from:"$fromStateVal" \
			--header:upsert:track:true \
			--context --grooming-to-retained \
			"${passthrough[@]}"
		return $?
	;;

	## groomed-from is deliberately NOT stamped by any create arm.
	--grooming-create-backlog)
		local createOp="$1"
		local createState="backlog"
		shift
		## <team-member> captured for future logging/validation, unused today
		local callingMember="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$callingMember" ] || [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD $createOp: syntax is <team-member> <item-filename> --owner-header-value <value> (--upsert-from-stdin|--edit-script-from-stdin:<py|awk>|--edit-patch-from-stdin) [--header:<upsert|append|remove>:name[:value]]..." >&2
			set +e ; return 1
		fi
		local owner="" bodyMode=""
		local passthrough=()
		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-state:*)
					echo "⛔ ERROR: $MDSC_CMD $createOp: --from-state: is not valid here -- this op creates a board-item, and a created item has no source state. Use --grooming-to-${createState} to move an item that already exists." >&2
					set +e ; return 1
				;;
				--owner-header-value)
					if [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD $createOp: --owner-header-value: value required" >&2
						set +e ; return 1
					fi
					owner="$2" ; shift 2
				;;
				--upsert-from-stdin|--edit-script-from-stdin:*|--edit-patch-from-stdin)
					bodyMode="$1"
					passthrough+=( "$1" ) ; shift
				;;
				--recheck-in) passthrough+=( "$1" "${2:-}" ) ; shift ; shift || true ;;
				--header:*)
					passthrough+=( "$1" ) ; shift
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD $createOp: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$owner" ] ; then
			echo "⛔ ERROR: $MDSC_CMD $createOp: --owner-header-value <value> is required" >&2
			set +e ; return 1
		fi
		if [ -z "$bodyMode" ] ; then
			echo "⛔ ERROR: $MDSC_CMD $createOp: one body-input mode is required on create (--upsert-from-stdin|--edit-script-from-stdin:<py|awk>|--edit-patch-from-stdin) -- a created board-item has no existing body to carry forward, and filing an empty one is never intended" >&2
			set +e ; return 1
		fi
		local groomedAt ; groomedAt="$( date +"%Y-%m-%d %H:%M %z" )"
		mkdir -p "$MDAT_DATA_ROOT/board/$createState" || {
			echo "⛔ ERROR: $MDSC_CMD --grooming-create-backlog: can't create board state directory: $MDAT_DATA_ROOT/board/$createState" >&2
			set +e ; return 1
		}
		DistroAgentsTools --intern-op-board-upsert-move-edit "$createState" "$itemName" \
			--create \
			--acting-member:"$callingMember" \
			--header:upsert:owner:"$owner" \
			--header:upsert:groomed-at:"$groomedAt" \
			--header:upsert:track:true \
			--context "$createOp" \
			"${passthrough[@]}"
		return $?
	;;

	--grooming-create-processed)
		local createOp="$1"
