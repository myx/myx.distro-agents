		if [ -z "$owner" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --grooming-to-processed: --owner-header-value <value> is required" >&2
			set +e ; return 1
		fi
		local fromStateVal="${fromStateArg#--from-state:}"
		local groomedAt ; groomedAt="$( date +"%Y-%m-%d %H:%M %z" )"
		local processedAt ; processedAt="$( date +"%Y-%m-%d %H:%M %z" )"
		mkdir -p "$MDAT_DATA_ROOT/board/processed" || {
			echo "⛔ ERROR: $MDSC_CMD --grooming-to-processed: can't create board state directory: $MDAT_DATA_ROOT/board/processed" >&2
			set +e ; return 1
		}
		DistroAgentsTools --intern-op-board-upsert-move-edit processed "$itemName" \
			"$fromStateArg" \
			--header:upsert:owner:"$owner" \
			--header:upsert:groomed-at:"$groomedAt" \
			--header:upsert:groomed-from:"$fromStateVal" \
			--header:upsert:processed-at:"$processedAt" \
			--header:upsert:track:true \
			--context --grooming-to-processed \
			"${passthrough[@]}"
		return $?
	;;

	--grooming-to-parked)
		shift
		## <team-member> captured for future logging/validation, unused today
		local callingMember="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$callingMember" ] || [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --grooming-to-parked: syntax is <team-member> <item-filename> --from-state:<state> --owner-header-value <value> [--header:<upsert|append|remove>:name[:value]]... [--upsert-from-stdin|--edit-script-from-stdin:<py|awk>|--edit-patch-from-stdin]" >&2
