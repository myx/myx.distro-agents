					if [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --grooming-to-processed: --owner-header-value: value required" >&2
						set +e ; return 1
					fi
					owner="$2" ; shift 2
				;;
				--recheck-in) passthrough+=( "$1" "${2:-}" ) ; shift ; shift || true ;;
