	--grooming-to-blocked)
		shift
		## <team-member> captured for future logging/validation, unused today
		local callingMember="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$callingMember" ] || [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --grooming-to-blocked: syntax is <team-member> <item-filename> --from-state:<state> --owner-header-value <value> [--header:<upsert|append|remove>:name[:value]]... [--upsert-from-stdin|--edit-script-from-stdin:<py|awk>|--edit-patch-from-stdin]" >&2
			set +e ; return 1
		fi
		local fromStateArg="" owner=""
		local passthrough=()
		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-state:*) fromStateArg="$1" ; shift ;;
				--owner-header-value)
					if [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --grooming-to-blocked: --owner-header-value: value required" >&2
						set +e ; return 1
					fi
					owner="$2" ; shift 2
				;;
				--recheck-in) passthrough+=( "$1" "${2:-}" ) ; shift ; shift || true ;;
				--header:*|--upsert-from-stdin|--edit-script-from-stdin:*|--edit-patch-from-stdin)
					passthrough+=( "$1" ) ; shift
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --grooming-to-blocked: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$fromStateArg" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --grooming-to-blocked: --from-state:<state> is required" >&2
			set +e ; return 1
		fi
		if [ -z "$owner" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --grooming-to-blocked: --owner-header-value <value> is required" >&2
			set +e ; return 1
		fi
		local fromStateVal="${fromStateArg#--from-state:}"
		local groomedAt ; groomedAt="$( date +"%Y-%m-%d %H:%M %z" )"
		local hasExecutionReceipt="false" passthroughEntry
		for passthroughEntry in "${passthrough[@]}" ; do
			case "$passthroughEntry" in
				--header:upsert:execution-receipt:*|--header:append:execution-receipt:*)
					hasExecutionReceipt="true"
				;;
			esac
		done
		if [ "$hasExecutionReceipt" = "false" ] ; then
			local blockedAt ; blockedAt="$( date +"%Y-%m-%d %H:%M %z" )"
			passthrough+=( "--header:upsert:execution-receipt:blocked:$blockedAt" )
		fi
		mkdir -p "$MDAT_DATA_ROOT/board/blocked" || {
			echo "⛔ ERROR: $MDSC_CMD --grooming-to-blocked: can't create board state directory: $MDAT_DATA_ROOT/board/blocked" >&2
			set +e ; return 1
		}
		DistroAgentsTools --intern-op-board-upsert-move-edit blocked "$itemName" \
			"$fromStateArg" \
			--header:upsert:owner:"$owner" \
			--header:upsert:groomed-at:"$groomedAt" \
			--header:upsert:groomed-from:"$fromStateVal" \
			--header:upsert:track:true \
			--context --grooming-to-blocked \
			"${passthrough[@]}"
		return $?
	;;

	--grooming-to-running)
		shift
		## <team-member> captured for future logging/validation, unused today
