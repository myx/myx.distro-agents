			--header:upsert:groomed-at:"$groomedAt" \
			--header:upsert:track:true \
			--context "$createOp" \
			"${passthrough[@]}"
		return $?
	;;

	--intern-op-grooming-input-scan)
		shift
		## <team-member> captured for future logging/validation, unused today
		local callingMember="$1"
		shift || true
		if [ -z "$callingMember" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --intern-op-grooming-input-scan: syntax is <team-member>" >&2
			set +e ; return 1
		fi
		if [ $# -gt 0 ] ; then
			case "$1" in
				--*)
					echo "⛔ ERROR: $MDSC_CMD --intern-op-grooming-input-scan: invalid option: $1 -- syntax is <team-member>, no other arguments -- an input-scan reads all baseline-relevant items itself. SEE Skill magic-team/magic-team.grooming.routine.md" >&2
					set +e ; return 1
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --intern-op-grooming-input-scan: syntax is <team-member>, no other arguments -- an input-scan reads all baseline-relevant items itself, an item name is not a parameter. SEE Skill magic-team/magic-team.grooming.routine.md" >&2
					set +e ; return 1
				;;
			esac
		fi
		[ -n "${MDAT_DATA_ROOT:-}" ] || {
			echo "⛔ ERROR: $MDSC_CMD --intern-op-grooming-input-scan: MDAT_DATA_ROOT is not set" >&2
			set +e ; return 1
		}
		printf '%s\n\n' "## state-and-lock (routine-grooming)"
		local lockNote="$( AgentsToolsInboxDir magic-coordinator )/note-20260809T154332Z-grooming-state-and-lock.md"
		if [ -f "$lockNote" ] ; then cat "$lockNote" ; else echo "(no state-and-lock note recorded yet)" ; fi
		printf '\n%s\n\n' "## team-roster (cache)"
		DistroAgentsTools --get-roster "$callingMember"
		## The board scope below is already all types / any owner, so an item a
		## client-* member filed on the board has always been visible here. An
		## INBOX item was not: the scan read inboxes/<calling member>/ alone, and an
		## inquiry the communication sweep filed into inboxes/client-ndm/ was
		## invisible. Each client-* member's inbox is widened into the same scan,
		## read-only -- grooming never acts as that identity and never writes into
		## that inbox; --do-inbox-also-member widens the read and nothing else. Same
		## "the members that exist, not the ones a cache remembers" enumeration
		## --intern-op-sweep-input-scan uses; the roster note is a cache and does not
		## decide which inboxes are in scope. Moved here from the advance scan, which
		## no longer reads inquiries.
		## Every workspace's clients, from the member directory (AgentsTools.TeamRegistry.include).
		local groomingInboxAlso=() groomingClientDir groomingClientName
		type AgentsToolsTeamMemberDirectoryText > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.TeamRegistry.include"
		while IFS=$'\t' read -r groomingClientName groomingClientDir ; do
			case "$groomingClientName" in client-*) ;; *) continue ;; esac
			if [ -d "$groomingClientDir" ] ; then
				AgentsToolsAssertBareName "$groomingClientName" "<team-member>" magic-grooming-input-scan || { set +e ; return 1 ; }
				## The acting member's own inbox is already the scan's first section.
				if [ "$groomingClientName" != "$callingMember" ] ; then
					groomingInboxAlso+=( --do-inbox-also-member "$groomingClientName" )
				fi
			fi
		done <<< "$( AgentsToolsTeamMemberDirectoryText )"
		printf '\n%s\n\n' "## board digest"
		DistroAgentsTools --intern-op-session-context-scan "$callingMember" \
			--state backlog --state pending --state running --state review --state blocked --state parked \
			--all-types \
			--do-inbox-inquiry-active --do-inbox-reflections \
			--do-inbox-notes --do-inbox-other \
			--no-slack --no-email --no-trello \
			--no-board-related \
			"${groomingInboxAlso[@]+"${groomingInboxAlso[@]}"}" \
			--context --intern-op-grooming-input-scan
		local groomingScanRc=$?
		## The review items this routine reviews on this run (AgentsTools.ReviewFlow.include).
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.ReviewFlow.include"
		printf '\n%s\n\n' "## review items addressed to grooming.routine"
		AgentsReviewItemsForRoutine grooming
		return $groomingScanRc
	;;


	--grooming-lock-refresh)
		shift
		local callingMember="$1" ; shift || true
		if [ -z "$callingMember" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --grooming-lock-refresh: <team-member> required" >&2
			set +e ; return 1
		fi
		if [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --grooming-lock-refresh: invalid option: $1" >&2
			set +e ; return 1
		fi
		local recheckDate
		recheckDate="$( AgentsToolsRecheckDate 30 )"
		AgentsToolsItemUpsert "$callingMember" \
			note-20260809T154332Z-grooming-state-and-lock.md \
			--update-lock \
			--header:upsert:state:grooming-running \
			--header:upsert:recheck-date:"$recheckDate" \
			--context --grooming-lock-refresh
		return $?
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
