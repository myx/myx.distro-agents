#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.MagicGrooming.include -- routine-grooming's own --grooming-*
## operation group of DistroAgentsItems.fn.sh. Sourced lazily from the arm of the tool file that owns its names (sh-lib/harness/AgentsContext.FrontTable.include).
## Not standalone: relies on being dot-sourced for $1/$@/$MDSC_CMD.
##

## Where an inbox item lives (F4.3).
type AgentsToolsInboxDir > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/inbox/AgentsTools.InboxPlace.include"

. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.RecheckDate.include"

type AgentsToolsItemUpsert > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.InternOpItem.include"

case "$1" in

	--grooming-to-backlog)
		shift
		local callingMember="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$callingMember" ] || [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --grooming-to-backlog: syntax is <team-member> <item-filename> --from-state:<state> --owner-header-value <value> [--header:<upsert|append|remove>:name[:value]]... [--upsert-from-stdin|--edit-script-from-stdin:<py|awk>|--edit-patch-from-stdin]" >&2
			set +e ; return 1
		fi
		local fromStateArg="" owner=""
		local passthrough=()
		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-state:*) fromStateArg="$1" ; shift ;;
				--owner-header-value)
					if [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --grooming-to-backlog: --owner-header-value: value required" >&2
						set +e ; return 1
					fi
					owner="$2" ; shift 2
				;;
				--recheck-in) passthrough+=( "$1" "${2:-}" ) ; shift ; shift || true ;;
				--header:*|--upsert-from-stdin|--edit-script-from-stdin:*|--edit-patch-from-stdin)
					passthrough+=( "$1" ) ; shift
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --grooming-to-backlog: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$fromStateArg" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --grooming-to-backlog: --from-state:<state> is required" >&2
			set +e ; return 1
		fi
		if [ -z "$owner" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --grooming-to-backlog: --owner-header-value <value> is required" >&2
			set +e ; return 1
		fi
		local fromStateVal="${fromStateArg#--from-state:}"
		local groomedAt ; groomedAt="$( date +"%Y-%m-%d %H:%M %z" )"
		## Back in backlog an item is unassessed, so its approval is cleared here and
		## check-backlog-promote re-earns it. A caller's own approved-by/approved-at
		## header in this call stands untouched.
		local approvalClear=( --header:remove:approved-by --header:remove:approved-at ) pt
		for pt in "${passthrough[@]+"${passthrough[@]}"}" ; do
			case "$pt" in
				--header:*:approved-by|--header:*:approved-by:*|--header:*:approved-at|--header:*:approved-at:*) approvalClear=() ; break ;;
			esac
		done
		mkdir -p "$MDAT_DATA_ROOT/board/backlog" || {
			echo "⛔ ERROR: $MDSC_CMD --grooming-to-backlog: can't create board state directory: $MDAT_DATA_ROOT/board/backlog" >&2
			set +e ; return 1
		}
		DistroAgentsTools --intern-op-board-upsert-move-edit backlog "$itemName" \
			"$fromStateArg" \
			--header:upsert:owner:"$owner" \
			--header:upsert:groomed-at:"$groomedAt" \
			--header:upsert:groomed-from:"$fromStateVal" \
			--header:upsert:track:true \
			--context --grooming-to-backlog \
			"${approvalClear[@]+"${approvalClear[@]}"}" \
			"${passthrough[@]+"${passthrough[@]}"}"
		return $?
	;;

	--grooming-to-pending)
		shift
		## <team-member> captured for future logging/validation, unused today
		local callingMember="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$callingMember" ] || [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --grooming-to-pending: syntax is <team-member> <item-filename> --from-state:<state> --owner-header-value <value> [--header:<upsert|append|remove>:name[:value]]... [--upsert-from-stdin|--edit-script-from-stdin:<py|awk>|--edit-patch-from-stdin]" >&2
			set +e ; return 1
		fi
		local fromStateArg="" owner=""
		local passthrough=()
		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-state:*) fromStateArg="$1" ; shift ;;
				--owner-header-value)
					if [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --grooming-to-pending: --owner-header-value: value required" >&2
						set +e ; return 1
					fi
					owner="$2" ; shift 2
				;;
				--recheck-in) passthrough+=( "$1" "${2:-}" ) ; shift ; shift || true ;;
				--header:*|--upsert-from-stdin|--edit-script-from-stdin:*|--edit-patch-from-stdin)
					passthrough+=( "$1" ) ; shift
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --grooming-to-pending: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$fromStateArg" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --grooming-to-pending: --from-state:<state> is required" >&2
			set +e ; return 1
		fi
		if [ -z "$owner" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --grooming-to-pending: --owner-header-value <value> is required" >&2
			set +e ; return 1
		fi
		local fromStateVal="${fromStateArg#--from-state:}"
		local groomedAt ; groomedAt="$( date +"%Y-%m-%d %H:%M %z" )"
		mkdir -p "$MDAT_DATA_ROOT/board/pending" || {
			echo "⛔ ERROR: $MDSC_CMD --grooming-to-pending: can't create board state directory: $MDAT_DATA_ROOT/board/pending" >&2
			set +e ; return 1
		}
		DistroAgentsTools --intern-op-board-upsert-move-edit pending "$itemName" \
			"$fromStateArg" \
			--header:upsert:owner:"$owner" \
			--header:upsert:groomed-at:"$groomedAt" \
			--header:upsert:groomed-from:"$fromStateVal" \
			--header:upsert:track:true \
			--context --grooming-to-pending \
			"${passthrough[@]}"
		return $?
	;;

	--grooming-to-processed)
		shift
		## <team-member> captured for future logging/validation, unused today
		local callingMember="$1"
		shift || true
		local itemName="$1"
		shift || true
