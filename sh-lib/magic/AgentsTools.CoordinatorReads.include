#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.CoordinatorReads.include -- the coordinator's own read-only readers: one
## frontmatter field of the state note, and the board's live counts and active items.
## Sourced for its functions only; runs nothing at load.
##

## One frontmatter field's value from a note, bounded to the block between the
## first two `---` lines; empty when the note or the field is absent.
type AgentsToolsBoardReady > /dev/null 2>&1 || { . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.BoardStates.include" ; }
AgentsToolsStateNoteField(){ ## <path> <field>
	[ -f "$1" ] || return 0
	LC_ALL=C awk -v fieldName="$2" '
		{ sub(/\r$/, "") ; }
		$0 == "---" { fmDepth++ ; if (fmDepth >= 2) exit ; next ; }
		fmDepth == 1 && index($0, fieldName ": ") == 1 { print substr($0, length(fieldName) + 3) ; exit ; }
	' "$1"
}

## Live counts, read at call time and never stored: one `<state>: <n>` line per
## board state, counting the *.md files directly in that state's folder.
AgentsToolsBoardCounts(){
	local countState countFile countN
	for countState in $agentsBoardStates ; do
		countN=0
		type AgentsToolsBoardItemsInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.ItemDecisions.include" ; local countFileItems ; AgentsToolsBoardItemsInto countFileItems "" "$countState"
		for countFile in ${countFileItems[@]+"${countFileItems[@]}"} ; do
			[ -f "$countFile" ] && countN=$(( countN + 1 ))
		done
		printf '%s: %s\n' "$countState" "$countN"
	done
}

## The active and blocked items, one `<state>/<item-filename>` line each, at
## most 40, then one `(+<n> more)` line for the rest; `(none)` when empty.
AgentsToolsBoardActiveItems(){
type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
	local activeN=0 activeCap=40 activeRows="" activeTokens
	## Token totals, summed now over what sits under each item (AgentsTools.SessionTranscript.include).
	. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionTranscript.include"
	## The items by `<state>/<name>`, as the roll-up keys them, from the board's one walk, in state order. Only the
	## items shown get their token text: the rest are counted.
	local activeItems activeKeys=() activeOne activeKey
	type AgentsToolsBoardItemsInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.ItemDecisions.include"
	AgentsToolsBoardItemsInto activeItems "" $agentsBoardUnderwayStates
	for activeOne in ${activeItems[@]+"${activeItems[@]}"} ; do activeKey="${activeOne%/*}" ; activeKeys+=( "${activeKey##*/}/${activeOne##*/}" ) ; done
	activeRows="$( AgentsSessionTokensRollupRows ${activeKeys[@]+"${activeKeys[@]}"} 2>/dev/null )"
	## ONE PASS FOR EVERY LINE (the call-path rule: no process a row). Each item's row was looked up and rendered by two
	## processes over the same rows -- up to eighty small ones for one read (measured 2026-11-26 10:05). The wording stays
	## `AgentsSessionTokensRollupText`'s own: `tokens: in=.. cache-read=.. cache-write=.. out=..`, and the sub-session count
	## only where it is above zero.
	printf '%s\n' "$activeRows" | LC_ALL=C awk -F'\t' -v keys="${activeKeys[*]}" -v cap="$activeCap" '
		BEGIN { keyTotal = split(keys, keyList, " ") }
		NF >= 6 { rowOf[$1] = $0 }
		END {
			shown = 0
			for (keyAt = 1 ; keyAt <= keyTotal ; keyAt++) {
				key = keyList[keyAt] ; bare = key ; sub(/^.*\//, "", bare) ; sub(/\.md$/, "", bare)
				shown++
				if (shown > cap) continue
				line = key
				if (bare in rowOf) {
					split(rowOf[bare], field, "\t")
					line = line " -- tokens: in=" field[2] " cache-read=" field[3] " cache-write=" field[4] " out=" field[5]
					if (field[6] + 0 > 0) line = line " (incl. " field[6] " sub-session" (field[6] + 0 == 1 ? "" : "s") ")"
				}
				print line
			}
			if (shown > cap) print "(+" (shown - cap) " more)"
			if (shown == 0) print "(none)"
		}'
	return 0
}
