#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.MagicTeamData.include -- the team-data store's own
## --commit-pending operation of DistroAgentsItems.fn.sh. Sourced lazily from the arm of the tool file that owns its names (sh-lib/harness/AgentsContext.FrontTable.include).
## Not standalone: relies on being dot-sourced for $1/$@/$MDSC_CMD.
##
## Every other team-data op commits only the paths it writes itself. This one
## commits whatever is pending under $MDAT_DATA_ROOT -- additions, edits and
## deletions -- in one commit, then syncs the store with its remote by myx.common's
## git/cloneSync, which pulls and pushes. A conflict between origin and the local commits is settled and committed
## (AgentsToolsTeamDataMergeSettle) and the sync runs again, so it always pushes and no conflict is committed. It exists
## for work left uncommitted, and it is magic-coordinator's only.
##

case "$1" in

	--commit-pending)
		shift
		local callingMember="$1"
		shift || true
		if [ -z "$callingMember" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --commit-pending: syntax is <team-member> [--commit-message <message>] [--no-push]" >&2
			set +e ; return 1
		fi
		## A team-wide write: one owner, and a caller passing any other name fails loud.
		if [ "$callingMember" != "magic-coordinator" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --commit-pending: <team-member> must be magic-coordinator -- this commits the whole team-data store and has no other owner (got: $callingMember)" >&2
			set +e ; return 1
		fi
		local commitMessage="* team-data pending, magic-coordinator" noPush="false"
		while [ $# -gt 0 ] ; do
			case "$1" in
				--commit-message)
					if [ -z "${2:-}" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --commit-pending: --commit-message: value required" >&2
						set +e ; return 1
					fi
					commitMessage="$2"
					shift 2
				;;
				--no-push)
					noPush="true" ; shift
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --commit-pending: unrecognized argument: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		[ -n "${MDAT_DATA_ROOT:-}" ] && [ -d "$MDAT_DATA_ROOT" ] || {
			echo "⛔ ERROR: $MDSC_CMD --commit-pending: MDAT_DATA_ROOT is not set or is not a directory: ${MDAT_DATA_ROOT:-<unset>}" >&2
			set +e ; return 1
		}

		local repoRoot="" originUrl="" gitOut="" gitRc=0
		set +e
		originUrl="$( DistroAgentsTools --agents-config-option magic-team --select TEAM_DATA_GIT_REMOTE 2>/dev/null )"
		repoRoot="$( git -C "$MDAT_DATA_ROOT" rev-parse --show-toplevel 2>/dev/null )"
		set -e
		if [ -z "$repoRoot" ] ; then
			## git's own reason, its first line, such as the dubious ownership of a repository another account owns.
			gitOut="$( git -C "$MDAT_DATA_ROOT" rev-parse --show-toplevel 2>&1 >/dev/null | head -n 1 )" || gitOut=""
			echo "⛔ ERROR: $MDSC_CMD --commit-pending: $MDAT_DATA_ROOT is not in a git repository git can use (git: ${gitOut:-no message}), so there is nothing to commit into" >&2
			set +e ; return 1
		fi

		## An interrupted operation is reported and left for a person: nothing here repairs it.
		local gitDir="" interrupted=""
		gitDir="$( git -C "$MDAT_DATA_ROOT" rev-parse --absolute-git-dir 2>/dev/null )" || gitDir=""
		if [ -z "$gitDir" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --commit-pending: could not locate the repository's .git directory, nothing committed" >&2
			set +e ; return 1
		fi
		## A merge an earlier sync left unfinished is settled, not left for a person: no conflict is ever committed, and the commits go out.
		if [ -e "$gitDir/MERGE_HEAD" ] ; then
			type AgentsToolsTeamDataMergeSettle > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.TeamDataCommit.include"
			set +e ; AgentsToolsTeamDataMergeSettle "--commit-pending" ; set -e
		fi
		[ ! -e "$gitDir/index.lock" ] || interrupted="$interrupted index.lock"
		[ ! -e "$gitDir/MERGE_HEAD" ] || interrupted="$interrupted merge"
		[ ! -e "$gitDir/CHERRY_PICK_HEAD" ] || interrupted="$interrupted cherry-pick"
		[ ! -e "$gitDir/REVERT_HEAD" ] || interrupted="$interrupted revert"
		[ ! -d "$gitDir/rebase-merge" ] && [ ! -d "$gitDir/rebase-apply" ] || interrupted="$interrupted rebase"
		if [ -n "$interrupted" ] ; then
			echo "TEAM-DATA-REFUSED: the repository shows an interrupted operation:$interrupted -- it is not repaired here, and nothing was committed"
			echo "⛔ ERROR: $MDSC_CMD --commit-pending: interrupted operation in $gitDir:$interrupted" >&2
			set +e ; return 1
		fi

		## Every pathspec is `.` run from the store itself, so nothing outside
		## $MDAT_DATA_ROOT is staged or committed, even when the store sits inside
		## a larger repository or that repository has other paths staged.
		set +e
		gitOut="$( git -C "$MDAT_DATA_ROOT" add -A -- . 2>&1 )"
		gitRc=$?
		set -e
		if [ "$gitRc" -ne 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --commit-pending: git add failed under $MDAT_DATA_ROOT, nothing committed: $gitOut" >&2
			set +e ; return 1
		fi
		local pendingList=""
		set +e
		pendingList="$( git -C "$MDAT_DATA_ROOT" diff --cached --name-status --relative -- . 2>&1 )"
		gitRc=$?
		set -e
		if [ "$gitRc" -ne 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --commit-pending: could not list the staged paths, nothing committed: $pendingList" >&2
			set +e ; return 1
		fi
		local commitId=""
		if [ -z "$pendingList" ] ; then
			## Nothing to commit is not nothing to push: commits already ahead of
			## origin still go out below, under the same guards and read-back.
			echo "TEAM-DATA-NOTHING-PENDING: $MDAT_DATA_ROOT"
			commitId="$( git -C "$MDAT_DATA_ROOT" rev-parse --short HEAD 2>/dev/null )" || commitId="<unknown>"
		else
			set +e
			gitOut="$( git -C "$MDAT_DATA_ROOT" commit -m "$commitMessage" -m "$pendingList" -- . 2>&1 )"
			gitRc=$?
			set -e
			if [ "$gitRc" -ne 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --commit-pending: git commit failed; the paths stay staged, nothing is committed: $gitOut" >&2
				set +e ; return 1
			fi
			commitId="$( git -C "$MDAT_DATA_ROOT" rev-parse --short HEAD 2>/dev/null )" || commitId="<unknown>"
			echo "TEAM-DATA-COMMITTED: $commitId $( printf '%s\n' "$pendingList" | wc -l | tr -d '[:space:]' ) path(s) under $MDAT_DATA_ROOT"
			printf '%s\n' "$pendingList"
		fi

		if [ -z "$originUrl" ] ; then
			echo "TEAM-DATA-NOT-PUSHED: no TEAM_DATA_GIT_REMOTE is configured"
			return 0
		fi
		if [ "$noPush" = "true" ] ; then
			echo "TEAM-DATA-NOT-PUSHED: --no-push"
			return 0
		fi
		## A push sends the whole branch, so it is scoped the way the commit is only
		## when the store is its repository's own root, and only to team-data's remote.
		local storeRoot="" repoOrigin=""
		storeRoot="$( cd "$MDAT_DATA_ROOT" && pwd -P )" || storeRoot=""
		if [ -z "$storeRoot" ] || [ "$storeRoot" != "$( cd "$repoRoot" && pwd -P )" ] ; then
			echo "TEAM-DATA-NOT-PUSHED: the store is inside $repoRoot, whose branch is not team-data's alone to push"
			return 0
		fi
		repoOrigin="$( git -C "$repoRoot" remote get-url origin 2>/dev/null )" || repoOrigin=""
		if [ "$repoOrigin" != "$originUrl" ] ; then
			echo "TEAM-DATA-NOT-PUSHED: origin of $repoRoot is '${repoOrigin:-<none>}', not TEAM_DATA_GIT_REMOTE '$originUrl'"
			return 0
		fi

		## The sync is myx.common's git/cloneSync on the store, with TEAM_DATA_GIT_REMOTE and the
		## branch the store is on, which it keeps: it pulls, origin's commits merged in and never
		## rebased, and pushes what is ahead. Its own output is shown.
		local headFull="" headBranch="" remoteHead="" syncRc=0
		headBranch="$( git -C "$repoRoot" rev-parse --abbrev-ref HEAD 2>/dev/null )" || headBranch=""
		set +e
		GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=pull.rebase GIT_CONFIG_VALUE_0=false \
			"${MYXROOT:-}/bin/git/cloneSync.Common" "$repoRoot" "$originUrl" "$headBranch" >&2
		syncRc=$?
		## The pull met a conflict: it is settled and committed, and the sync runs again, so the push goes out (AgentsToolsTeamDataMergeSettle).
		if [ "$syncRc" -ne 0 ] && [ -e "$gitDir/MERGE_HEAD" ] ; then
			type AgentsToolsTeamDataMergeSettle > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.TeamDataCommit.include"
			if AgentsToolsTeamDataMergeSettle "--commit-pending" ; then
				GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=pull.rebase GIT_CONFIG_VALUE_0=false \
					"${MYXROOT:-}/bin/git/cloneSync.Common" "$repoRoot" "$originUrl" "$headBranch" >&2
				syncRc=$?
			fi
		fi
		set -e
		if [ "$syncRc" -ne 0 ] ; then
			echo "TEAM-DATA-NOT-PUSHED: the push failed; commit $commitId is local only"
			echo "⛔ ERROR: $MDSC_CMD --commit-pending: committed $commitId but git/cloneSync failed (rc $syncRc), its output is above" >&2
			set +e ; return 1
		fi
		## Read back: the remote branch must now name this very commit.
		headFull="$( git -C "$repoRoot" rev-parse HEAD 2>/dev/null )" || headFull=""
		remoteHead="$( git -C "$repoRoot" ls-remote origin "refs/heads/$headBranch" 2>/dev/null | LC_ALL=C awk 'NR == 1 { print $1 ; }' )" || remoteHead=""
		if [ -z "$headFull" ] || [ "$remoteHead" != "$headFull" ] ; then
			echo "TEAM-DATA-NOT-PUSHED: the push reported success but origin's $headBranch reads back '${remoteHead:-<nothing>}', not $headFull"
			echo "⛔ ERROR: $MDSC_CMD --commit-pending: committed $commitId, push not confirmed by read-back" >&2
			set +e ; return 1
		fi
		echo "TEAM-DATA-PUSHED: $commitId to origin, read back as origin/$headBranch = $headFull"
		return 0
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
