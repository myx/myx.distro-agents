#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

## AgentsTools.OpConfigCheck.include -- the operation `--config-check`, sourced by AgentsTools.MagicCoordinatorState.include with the operation's arguments.
		shift
		if [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --config-check: takes no arguments" >&2
			set +e ; return 1
		fi
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/config/AgentsTools.InternOpCheckConfigs.include" --intern-op-check-configs magic-coordinator \
			--optional "EMAIL_IMAP_HOST:<host>" \
			--optional "EMAIL_USER:<email-address>" \
			--optional "EMAIL_APP_PASSWORD:<app-password>" \
			--optional "TRELLO_KEY:<key>" \
			--optional "TRELLO_TOKEN:<token>" \
			--expect-secret EMAIL_APP_PASSWORD \
			--expect-secret TRELLO_KEY \
			--expect-secret TRELLO_TOKEN \
			--context --config-check
		local configRc=$?
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/config/AgentsTools.InternOpCheckConfigs.include" --intern-op-check-configs magic-team \
			--required "SLACK_CHANNEL_MAGIC_TEAM:<channel-id>" \
			--required "SLACK_CHANNEL_HUMAN_OWNER:<user-id>" \
			--optional "SLACK_CHANNEL_EVENT_TRACK:<channel-id>" \
			--optional "SLACK_CHANNEL_EVENT_ALERT:<channel-id>" \
			--expect-id-kind SLACK_CHANNEL_EVENT_TRACK:channel \
			--expect-id-kind SLACK_CHANNEL_EVENT_ALERT:channel \
			--expect-id-kind SLACK_CHANNEL_MAGIC_TEAM:channel \
			--expect-id-kind SLACK_CHANNEL_HUMAN_OWNER:user \
			--context --config-check || configRc=1
		## EACH KEY IN THE SCOPE ITS CONSUMER READS: EMAIL_USER above is the coordinator's own mailbox login, and --send-report reads
		## another one, human-owner's own (the address the report goes to), and refuses where only the coordinator's stands.
		echo "# human-owner's own scope, which --send-report reads:"
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/config/AgentsTools.InternOpCheckConfigs.include" --intern-op-check-configs human-owner \
			--optional "EMAIL_USER:<email-address>" \
			--context --config-check || configRc=1
		## Unset, the team data is the workspace's own store, which the resolver
		## already answered; a setting is an override and is checked as one.
		type AgentsToolsConfigOption > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/settings/AgentsTools.ConfigOption.include"
		if [ -n "$( AgentsToolsConfigOption magic-coordinator --select TEAM_DATA_DIRECTORY 2>/dev/null )" ] ; then
			. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/config/AgentsTools.InternOpCheckConfigs.include" --intern-op-check-configs magic-coordinator \
				--optional "TEAM_DATA_DIRECTORY:<path>" \
				--expect-path-exists "TEAM_DATA_DIRECTORY:${MDAT_DATA_ROOT:-}" \
				--context --config-check || configRc=1
		else
			echo "TEAM_DATA_DIRECTORY: OK"
			echo "  note: not set, so the team data is this workspace's own store"
			echo "  path: $MDAT_DATA_ROOT"
		fi
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/config/AgentsTools.InternOpCheckConfigs.include" --intern-op-check-configs magic-team \
			--optional "SLACK_BOT_TOKEN:<token>" \
			--optional "TEAM_DATA_GIT_REMOTE:<git-remote-url>" \
			--expect-secret SLACK_BOT_TOKEN \
			--resolve-slack-workspace-into SLACK_WORKSPACE_DOMAIN \
			--context --config-check || true
		## The reflection setting, and the halves it names: one WARN naming the keys a chosen
		## half lacks, and silence where the model is none or every chosen half is whole.
		## A token with no half stays silent by design, and a WARN never gates this call.
		type AgentsToolsReflectHalfLacks > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/settings/AgentsTools.ReflectSetting.include"
		local stateReflectModel="" stateReflectLine=""
		stateReflectModel="$( AgentsToolsConfigOption magic-team --select REFLECT_MODELS 2> /dev/null )" || stateReflectModel=""
		if [ -n "$stateReflectModel" ] && ! AgentsToolsReflectModelsParse "$stateReflectModel" > /dev/null 2>&1 ; then
			echo "REFLECT_MODELS: WARN"
			echo "  warn: the stored value is neither none nor <board>+<documents> over the closed lists, so no half is read from it"
			echo "  fix:  DistroAgentsTools.fn.sh --agents-config-option magic-team --upsert REFLECT_MODELS none"
		elif [ -n "$stateReflectModel" ] ; then
			while IFS= read -r stateReflectLine ; do
				[ -n "$stateReflectLine" ] || continue
				echo "REFLECT_MODELS: WARN"
				echo "  warn: the ${stateReflectLine%% *} half is selected and this workspace lacks: $( printf '%s' "${stateReflectLine#* }" | LC_ALL=C sed 's/ /, /g' )"
				echo "  fix:  DistroAgentsTools.fn.sh --owner-setup-reflection --apply"
			done <<< "$( AgentsToolsReflectHalfLacks "$stateReflectModel" )"
		fi
		## The main loop's readiness floor, applied the same way here: the schedule starts sessions. The CLI service is
		## the preset's of the tier, so a tier setting is what stands; the resolved CLI itself is shown beside it.
		local stateCli=""
		stateCli="$( . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.ReviewFlow.include" ; AgentsReviewCliResolved "" )"
		if [ -z "$stateCli" ] || [ "$stateCli" = "none" ] ; then
			echo "SPAWN_TIER_NORMAL: FAIL"
			echo "  fail: no tier is set, so no preset names the agent CLI a spawn runs on -- set SPAWN_TIER_NORMAL with DistroAgentsTools.fn.sh --owner-setup-claude --apply (or --owner-setup-copilot --apply)"
			configRc=1
		else
			echo "SPAWN_TIER_NORMAL: OK"
		fi
		## The team posts to Slack: with none of the tokens a coordinator send can
		## resolve to, every send it makes fails, so having none is a FAIL.
		type AgentsToolsConfigOption > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/settings/AgentsTools.ConfigOption.include"
		if [ -z "$( AgentsToolsConfigOption magic-coordinator --select SLACK_USER_TOKEN 2>/dev/null )" ] \
			&& [ -z "$( AgentsToolsConfigOption magic-coordinator --select SLACK_BOT_TOKEN 2>/dev/null )" ] \
			&& [ -z "$( AgentsToolsConfigOption magic-team --select SLACK_BOT_TOKEN 2>/dev/null )" ]
		then
			echo "SLACK_TOKEN: FAIL"
			echo "  fail: no SLACK_USER_TOKEN or SLACK_BOT_TOKEN for magic-coordinator, and no SLACK_BOT_TOKEN for magic-team, so the team cannot post to Slack"
			configRc=1
		else
			echo "SLACK_TOKEN: OK"
		fi
		## Her own identity is her user token's account. The user_id printed here is
		## the one every user-token send is confirmed against (message.user) by
		## --slack-send-message itself. Never gates: WARN only.
		local identToken="" identResp="" identUserId=""
		type AgentsToolsConfigOption > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/settings/AgentsTools.ConfigOption.include"
		identToken="$( AgentsToolsConfigOption magic-coordinator --select SLACK_USER_TOKEN 2>/dev/null )" || identToken=""
		if [ -z "$identToken" ] ; then
			echo "SLACK_AUTH_IDENTITY: WARN"
			echo "  warn: magic-coordinator has no SLACK_USER_TOKEN, so she posts under a bot identity, never her own"
			echo "  fix:  printf '%s' '<xoxp-token>' | DistroAgentsTools.fn.sh --agents-config-option magic-coordinator --upsert-from-stdin SLACK_USER_TOKEN"
		else
			identResp="$( curl -sS --connect-timeout 10 --max-time 30 https://slack.com/api/auth.test -H @- <<< "Authorization: Bearer $identToken" 2>/dev/null )" || identResp=""
			identUserId="$( printf '%s\n' "$identResp" | LC_ALL=C awk -v path=user_id -v optional=1 -v dialect=slack -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsHarnessJsonField.awk" 2>/dev/null )" || identUserId=""
			if [ -n "$identUserId" ] && printf '%s' "$identResp" | grep -q '"ok":true' ; then
				echo "SLACK_AUTH_IDENTITY: OK"
				echo "  user_id: $identUserId -- the account her user-token sends are confirmed against"
			else
				echo "SLACK_AUTH_IDENTITY: WARN"
				echo "  warn: auth.test on magic-coordinator's SLACK_USER_TOKEN returned no user_id, so her own identity is not established"
				echo "  fix:  replace SLACK_USER_TOKEN with a valid user token for her own Slack account"
			fi
		fi
		type AgentsToolsCommsSlackRun > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/slack/AgentsTools.CommsSlack.include"
		AgentsToolsCommsSlackRun --intern-op-slack-check-scopes magic-coordinator \
			--scope-source --slack-send-message \
			--scope-source AgentsToolsSlackCheck \
			--scope-source --slack-read \
			--scope-source --slack-react \
			--scope-source --slack-resolve-ids \
			--context --config-check || true
		return "$configRc"
		return $?
