#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.MagicAdvance.include -- routine-advance's own --advance-*
## operation group (DistroAgentsItems.fn.sh, and --advance-sleep-run of AgentDispatcherTools.fn.sh).
## Sourced lazily from the arm of the tool file that owns its names (sh-lib/harness/AgentsContext.FrontTable.include).
## Not standalone: relies on being dot-sourced for $1/$@/$MDSC_CMD.
##
## The two lock paths resync the board through myx.common git/cloneSync
## whenever TEAM_DATA_GIT_REMOTE is set, and the acquire path refuses a lock
## it cannot prove is the actual head's. See MAGIC.md, "The advance lock
## paths: resync, conflict check, and the unlock order".
##

## Where an inbox item lives (F4.3).
type AgentsToolsInboxDir > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/inbox/AgentsTools.InboxPlace.include"

## The resync, the conflict check and the head check the lock paths run, shared by every routine lock
## (AgentsTools.RoutineLock.include): the advance lock's own protocol, made general (F6.2).
. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/magic/AgentsTools.RoutineLock.include"

. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/magic/AgentsTools.SpawnHousekeeping.include"

. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.RecheckDate.include"
. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.BoardRoundScan.include"

type AgentsToolsItemUpsert > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.InternOpItem.include"

case "$1" in

	--advance-to-running)
		shift
		local callingMember="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$callingMember" ] || [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --advance-to-running: syntax is <team-member> <item-filename> --from-state:<state> [--header:<upsert|append|remove>:name[:value]]... [--upsert-from-stdin|--edit-script-from-stdin:<py|awk>|--edit-patch-from-stdin]" >&2
			set +e ; return 1
		fi
		local fromStateArg=""
		local passthrough=()
		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-state:*) fromStateArg="$1" ; shift ;;
				--recheck-in) passthrough+=( "$1" "${2:-}" ) ; shift ; shift || true ;;
				--header:*|--upsert-from-stdin|--edit-script-from-stdin:*|--edit-patch-from-stdin)
					passthrough+=( "$1" ) ; shift
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --advance-to-running: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$fromStateArg" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --advance-to-running: --from-state:<state> is required" >&2
			set +e ; return 1
		fi
		local startedAt ; startedAt="$( date +"%Y-%m-%d %H:%M %z" )"
		mkdir -p "$MDAT_DATA_ROOT/board/running" || {
			echo "⛔ ERROR: $MDSC_CMD --advance-to-running: can't create board state directory: $MDAT_DATA_ROOT/board/running" >&2
			set +e ; return 1
		}
		## Stamped on a move only: a same-state edit of an item already running keeps the
		## started-at it has, as the help says.
		local startedArgs=( --header:upsert:started-at:"$startedAt" )
		[ "$fromStateArg" != "--from-state:running" ] || startedArgs=()
		DistroAgentsTools --intern-op-board-upsert-move-edit running "$itemName" \
			"$fromStateArg" \
			${startedArgs[@]+"${startedArgs[@]}"} \
			--context --advance-to-running \
			${passthrough[@]+"${passthrough[@]}"}
		return $?
	;;

	--advance-to-parked)
		shift
		## <team-member> captured for future logging/validation, unused today
		local callingMember="$1"
		shift || true
		local itemName="$1"
		shift || true
		if [ -z "$callingMember" ] || [ -z "$itemName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --advance-to-parked: syntax is <team-member> <item-filename> --from-state:<state> [--header:<upsert|append|remove>:name[:value]]... [--upsert-from-stdin|--edit-script-from-stdin:<py|awk>|--edit-patch-from-stdin]" >&2
			set +e ; return 1
		fi
		local fromStateArg=""
		local passthrough=()
		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-state:*) fromStateArg="$1" ; shift ;;
				--recheck-in) passthrough+=( "$1" "${2:-}" ) ; shift ; shift || true ;;
				--header:*|--upsert-from-stdin|--edit-script-from-stdin:*|--edit-patch-from-stdin)
					passthrough+=( "$1" ) ; shift
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --advance-to-parked: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$fromStateArg" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --advance-to-parked: --from-state:<state> is required" >&2
			set +e ; return 1
		fi
		mkdir -p "$MDAT_DATA_ROOT/board/parked" || {
			echo "⛔ ERROR: $MDSC_CMD --advance-to-parked: can't create board state directory: $MDAT_DATA_ROOT/board/parked" >&2
			set +e ; return 1
		}
		DistroAgentsTools --intern-op-board-upsert-move-edit parked "$itemName" \
			"$fromStateArg" \
			--context --advance-to-parked \
			"${passthrough[@]}"
		return $?
	;;

	--advance-batch-outcome)
		shift
		local callingMember="$1"
		shift || true
		if [ -z "$callingMember" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --advance-batch-outcome: syntax is <team-member> --items:<item-filename>:<outcome>:<execution-receipt>[,...]" >&2
			set +e ; return 1
		fi
		local itemsArg=""
		while [ $# -gt 0 ] ; do
			case "$1" in
				--items:*)
					if [ -n "$itemsArg" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --advance-batch-outcome: --items: given more than once" >&2
						set +e ; return 1
					fi
					itemsArg="${1#--items:}"
					shift
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --advance-batch-outcome: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$itemsArg" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --advance-batch-outcome: --items:<item-filename>:<outcome>:<execution-receipt>[,...] is required" >&2
			set +e ; return 1
		fi

		local itemsRemaining="$itemsArg"
		local spec itemName rest outcome receipt itemCount=0 failCount=0
		while [ -n "$itemsRemaining" ] ; do
			case "$itemsRemaining" in
				*,*) spec="${itemsRemaining%%,*}" ; itemsRemaining="${itemsRemaining#*,}" ;;
				*)   spec="$itemsRemaining" ; itemsRemaining="" ;;
			esac
			[ -z "$spec" ] && continue
			itemCount=$(( itemCount + 1 ))
			itemName="${spec%%:*}"
			rest="${spec#*:}"
			if [ "$rest" = "$spec" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --advance-batch-outcome: malformed entry (need <item-filename>:<outcome>:<execution-receipt>): $spec" >&2
				set +e ; return 1
			fi
			outcome="${rest%%:*}"
			receipt="${rest#*:}"
			if [ "$receipt" = "$rest" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --advance-batch-outcome: malformed entry (need <item-filename>:<outcome>:<execution-receipt>): $spec" >&2
				set +e ; return 1
			fi
			AgentsToolsAssertBareName "$itemName" "<item-filename> (in --items entry: $spec)" advance-batch-outcome || { set +e ; return 1 ; }
			case "$outcome" in
				nudged|respawned|redispatched|flagged-once|no-action) ;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --advance-batch-outcome: invalid outcome in entry $spec: $outcome" >&2
					set +e ; return 1
				;;
			esac
			if [ -z "$receipt" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --advance-batch-outcome: entry $spec: execution-receipt required" >&2
				set +e ; return 1
			fi
			if ! DistroAgentsTools --intern-op-board-upsert-move-edit running "$itemName" \
				--from-state:running \
				--header:upsert:outcome:"$outcome" \
				--header:upsert:execution-receipt:"$receipt" \
				--context --advance-batch-outcome
			then
				failCount=$(( failCount + 1 ))
			fi
		done

		if [ "$itemCount" -eq 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --advance-batch-outcome: --items: no item entries found" >&2
			set +e ; return 1
		fi
		if [ "$failCount" -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --advance-batch-outcome: $failCount of $itemCount item(s) failed" >&2
			set +e ; return 1
		fi
		echo "# $MDSC_CMD --advance-batch-outcome: recorded outcomes for $itemCount item(s)" >&2
		return 0
	;;

	## Fixed 5-loop countdown-then-continue signal. No options.
	--advance-sleep-run)
		shift
		if [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --advance-sleep-run: takes no arguments" >&2
			set +e ; return 1
		fi
		## Five one-second loops, the owner's own specification.
		local remaining=5
		while [ "$remaining" -gt 0 ] ; do
			echo "$remaining"
			sleep 1
			remaining=$(( remaining - 1 ))
		done
		printf 'All Done.\nPLEASE CONTINUE!\n'
		return 0
	;;


	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
