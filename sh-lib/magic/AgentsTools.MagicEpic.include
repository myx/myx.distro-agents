#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.MagicEpic.include -- the epic operations (W1 of the refactorings epic). One operation,
## `--epic-update`, edits an epic, so no routine edits one by hand:
##   --epic-update <epic-file|epic-item> --set-status <feature-id> <status>
##   --epic-update <epic-file|epic-item> --add-settled <feature-id> <text...>
## Two reads let any member see an epic through the tooling (S23.8):
##   --epic-read <epic-file|epic-item> [--feature <feature-id>]   the epic whole, or one feature's section
##   --epic-list [<folder>]                                     the vault's epic items, or each *.epic.md of the folder
## An epic is a vault document of `vault-item.epic-blueprint` (`epic-blueprint-<date>-<matter>.md`), or the plain source file it was
## moved from, named by a path under a `todo-sketchpad` folder with no `..` part.
## `--set-status` writes the `Status:` line that stands under the `## <feature-id>` heading (it replaces the line
## where one stands, else inserts it after the heading). `--set-status <feature-id>.<n> done <text...>` closes one
## item: it and its nested lines leave, and `## Done` gets `- <feature-id>.<n>: <text>`, the caller's text.
## `--set-status <feature-id> done` closes the feature, and is refused while an item stands: then the feature's
## lines leave and `## Done` gets one line, its id and what holds now -- the feature's settled text, else its
## heading's title. `--add-settled` adds the rule as one plain present-tense line under the same heading, after its
## `Status:` line, with no date and no owner. Both refuse where the feature is not there or stands more than once.
## An id is `S<n>` or `S<n>.<m>`, and it stands exactly once: as a heading that bears it, else as the one item
## `<m>. ` of the feature in force where that item stands. A heading wins where a list item carries the same id,
## and stderr names both places. The id owns a span of lines, and every operation here works on that span.
## A vault item is edited as a copy and handed to `--upsert-vault-epic-blueprint`, so its contract check and its commit both
## happen at the one vault write. A plain source file is edited in place and never committed: the owner commits what
## is applied. Sourced from AgentDispatcherTools.fn.sh's arm for the name; relies on $1/$@/$MDSC_CMD.
##

## What a closed feature holds now, for its one line in `## Done`: the last line of its span that is neither
## blank nor a `Status:` line, the `**Settled <date> (<owner>).** ` stamp taken off where one stands; else the
## line the span opens on, the id taken off it. Printed, one line.
AgentsToolsMagicEpicDoneText(){ ## file, the span's first line, its last line, the id
	LC_ALL=C awk -v spanFirst="$2" -v spanLast="$3" -v idText="$4" '
		NR < spanFirst || NR > spanLast { next ; }
		NR == spanFirst { title = $0 ; sub( /^#+ /, "", title ) ; if ( index( title, idText " " ) == 1 ) title = substr( title, length( idText ) + 2 ) ; sub( /^[-:] /, "", title ) ; next ; }
		$0 ~ /^Status: / { next ; }
		NF { held = $0 ; sub( /^[[:space:]]*\*\*Settled [^*]*\*\*[[:space:]]*/, "", held ) ; }
		END { print ( held != "" ? held : title ) ; }
	' "$1"
}

## Where one epic id stands: the heading that bears it, else the one numbered item of the feature in force there.
## A heading wins where a list item carries the same id, and stderr names both places. Prints `<heading|item> <first> <last>`
## -- the place it stands, and the span of lines it owns -- and returns 1 with the sentence the callers share where it
## stands nowhere or more than once.
AgentsToolsMagicEpicPlace(){ ## the epic file, the id, the operation as the caller's own message shows it
	local placeOut=""
	placeOut="$( EPIC_ID="$2" EPIC_FILE="$1" PLACE_OP="$3" LC_ALL=C awk -v cmdText="$MDSC_CMD" '
		function headingName(textIn,   rest) { rest = textIn ; sub( /^#+ /, "", rest ) ; sub( /[ \t].*$/, "", rest ) ; return rest ; }
		function idShaped(textIn) { return textIn ~ /^S[0-9]+(\.[0-9]+)?$/ ; }
		function fault(textIn) { printf "⛔ ERROR: %s %s: %s in %s\n", cmdText, ENVIRON["PLACE_OP"], textIn, ENVIRON["EPIC_FILE"] > "/dev/stderr" ; exit 1 ; }
		BEGIN {
			idText = ENVIRON["EPIC_ID"] ; dotAt = 0 ;
			for (at = length( idText ) ; at > 0 ; at--) if ( substr( idText, at, 1 ) == "." ) { dotAt = at ; break ; }
			featureText = ( dotAt ? substr( idText, 1, dotAt - 1 ) : idText ) ;
			itemText = ( dotAt ? substr( idText, dotAt + 1 ) : "" ) ;
			fenced = 0 ; spaceText = "" ; spaceLevel = 0 ; headCount = 0 ; headFirst = 0 ; headLast = 0 ; headLevel = 0 ;
			itemTotal = 0 ; itemFirst = 0 ; itemLast = 0 ; itemOpen = 0 ;
		}
		{
			if ( index( $0, "```" ) == 1 ) { fenced = ! fenced ; next ; }
			if ( fenced ) { next ; }
			if ( itemOpen && $0 ~ /^[ \t]/ ) { itemLast = FNR ; next ; }
			itemOpen = 0
			if ( match( $0, /^#+ / ) ) {
				level = RLENGTH - 1 ; nameText = headingName( $0 ) ;
				if ( headFirst > 0 && headLast == 0 && level <= headLevel ) { headLast = FNR - 1 ; }
				if ( idShaped( nameText ) ) { spaceText = nameText ; spaceLevel = level ; }
				else if ( spaceText != "" && level <= spaceLevel ) { spaceText = "" ; }
				if ( nameText == idText ) { if ( headFirst == 0 ) { headFirst = FNR ; headLevel = level ; } ; headCount++ ; }
				next
			}
			if ( itemText != "" && spaceText == featureText && $0 ~ ( "^" itemText "[.][ \t]" ) ) { itemTotal++ ; itemFirst = FNR ; itemLast = FNR ; itemOpen = 1 ; }
		}
		END {
			if ( headCount > 1 ) fault( ( itemText == "" ? "feature " : "item " ) idText " must stand exactly once" )
			if ( headFirst > 0 ) {
				if ( headLast == 0 ) headLast = FNR
				if ( itemTotal > 0 ) printf "⚠️ WARNING: %s %s: %s stands as a heading at line %d and as item %s of %s at line %d -- the heading is the one used\n", cmdText, ENVIRON["PLACE_OP"], idText, headFirst, itemText, featureText, itemFirst > "/dev/stderr"
				printf "heading %d %d\n", headFirst, headLast ; exit 0
			}
			if ( itemTotal == 1 ) { printf "item %d %d\n", itemFirst, itemLast ; exit 0 ; }
			fault( ( itemText == "" ? "feature " : "item " ) idText " must stand exactly once" )
		}
	' "$1" )" || return 1
	printf '%s\n' "$placeOut"
}

## An epic is written only as magic-coordinator, which owns it. Any member reads one, with no ask.
AgentsToolsMagicEpicCaller(){ ## the operation, write (the default) or read
	[ "${2:-write}" != read ] || return 0
	type AgentsToolsSurfaceCaller > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/magic/AgentsTools.CoordinatorSurface.include"
	AgentsToolsSurfaceCaller "$1" write
}

## The path in the vault of the epic item a call names, rc 1 where the argument is no vault epic name.
AgentsToolsMagicEpicVaultPath(){ ## the argument
	local vaultName="$1"
	case "$vaultName" in
		*/*|'') return 1 ;;
		epic-blueprint-*.md) ;;
		## a name with no extension is the Markdown document of that name (the ruling in AgentsTools.InternOpVaultAudit.include)
		epic-blueprint-*.*) return 1 ;;
		epic-blueprint-*) vaultName="$vaultName.md" ;;
		*) return 1 ;;
	esac
	## A vault epic is reached only by a valid name of its contract (AgentsToolsDocValidateVaultItemName): an invalid one is refused, said once.
	type AgentsToolsDocValidateVaultItemName > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.DocValidate.include"
	local vaultNameFault=""
	vaultNameFault="$( AgentsToolsDocValidateVaultItemName "$vaultName" )" || { echo "⛔ ERROR: $MDSC_CMD: $vaultNameFault" >&2 ; return 1 ; }
	[ -n "${MDAT_DATA_ROOT:-}" ] || return 1
	type AgentsToolsVaultItemPath > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/vault/AgentsTools.VaultPlace.include"
	AgentsToolsVaultItemPath "$vaultName"
}

## A vault epic's edited copy becomes the item through the one vault write, which checks it and commits it. A plain source
## file is a plain file no longer, and the copy takes its place. Either way the copy goes.
AgentsToolsMagicEpicPut(){ ## the built copy, the file it was built from, the vault item's name (empty for a plain file)
	local putMember
	if [ -z "$3" ] ; then
		mv -f -- "$1" "$2" || { rm -f -- "$1" ; return 1 ; }
		return 0
	fi
	type AgentsToolsActingMember > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.ActingMember.include"
	putMember="$( AgentsToolsActingMember )" ; putMember="${putMember:-magic-coordinator}"
	## The member goes as --team-member (S21.3): the front door places the acting member first for this operation, and a positional one here
	## was read as the item name ("magic-coordinator.md does not start with the type word").
	"${MDAT_BASH:-bash}" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsItems.fn.sh" --upsert-vault-epic-blueprint --team-member "$putMember" "$3" --from-file "$1" || { rm -f -- "$1" ; return 1 ; }
	rm -f -- "$1"
}

## A path a read may name: under a `todo-sketchpad` folder, with no `..` part.
AgentsToolsMagicEpicReadPlace(){ ## the operation, the path
	case "/$2" in
		*/todo-sketchpad|*/todo-sketchpad/*) ;;
		*) echo "⛔ ERROR: $MDSC_CMD $1: $2 is not under a todo-sketchpad folder -- the epics are read there and nowhere else" >&2 ; return 1 ;;
	esac
	case "/$2/" in
		*/../*) echo "⛔ ERROR: $MDSC_CMD $1: $2 has a .. part -- name the file by its own path" >&2 ; return 1 ;;
	esac
	return 0
}

## The edit is made against a scratch copy and moved over the file, so a failed write never leaves a half file.
AgentsToolsMagicEpicTemp(){ ## prints a fresh scratch path in the calling session's own folder
	local epicBase="$MMDAPP/.local/temp"
	[ -z "${MDAT_SPAWN_SANDBOX_ROOT:-}" ] || epicBase="$MDAT_SPAWN_SANDBOX_ROOT/output"
	mkdir -p "$epicBase" || return 1
	mktemp "$epicBase/AgentsEpic.XXXXXX"
}

## An epic's judgement of a change, behind this file rather than behind a name of its own: the epic
## file and the feature id are read here, the pair is kept on the change's record, and the settle
## core lands the verdict. No sub-flag of `--epic-update` names it while the naming is open.
AgentsToolsMagicEpicSettleChange(){ ## epic file, feature id, record id, parts (may be empty), words
	local epicSettleFile="$1" epicSettleFeature="$2" epicSettleRecord="$3" epicSettleParts="${4:-}" epicSettleText="${5:-}" epicSettleDir="" epicSettleShown
	AgentsToolsMagicEpicPlace "$epicSettleFile" "$epicSettleFeature" "--epic-update" > /dev/null || return 1
	type AgentsToolsUndoFind > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/undo/AgentsTools.UndoRecord.include"
	epicSettleDir="$( AgentsToolsUndoFind "$epicSettleRecord" "" )" || return 1
	epicSettleShown="${epicSettleFile##*/}"
	AgentsToolsUndoSet "$epicSettleDir" epic "$epicSettleShown" || { echo "⛔ ERROR: $MDSC_CMD --epic-update: the change's epic item could not be kept" >&2 ; return 1 ; }
	AgentsToolsUndoSet "$epicSettleDir" feature "$epicSettleFeature" || { echo "⛔ ERROR: $MDSC_CMD --epic-update: the change's feature id could not be kept" >&2 ; return 1 ; }
	AgentsToolsUndoSettleCore "$epicSettleDir" magic-coordinator "$epicSettleParts" "$epicSettleText"
}

case "$1" in

	--epic-update)
		shift
		## The member comes first, placed by the common layer from --team-member or the environment (S21.3): the syntax index declares it,
		## and a body that did not take it read the member's name as the epic file.
		local epicMember="${1:-}"
		shift || true
		local epicFile="${1:-}" epicMode="${2:-}"
		shift 2 || true
		if [ -z "$epicFile" ] || [ -z "$epicMode" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --epic-update: syntax is <epic-file> (--set-status <feature-id> <status>|<feature-id>.<n> done <text...>|--add-settled <feature-id> <text...>)" >&2
			set +e ; return 1
		fi
		AgentsToolsMagicEpicCaller "--epic-update" || { set +e ; return 1 ; }
		## A vault epic item is the source, and its own name is what the edit reports.
		local epicVaultName="" epicShown="$epicFile"
		if AgentsToolsMagicEpicVaultPath "$epicFile" > /dev/null ; then
			epicVaultName="$epicFile" ; epicShown="$epicVaultName"
			epicFile="$( AgentsToolsMagicEpicVaultPath "$epicVaultName" )"
			[ -f "$epicFile" ] || { echo "⛔ ERROR: $MDSC_CMD --epic-update: no such vault epic item: $epicVaultName" >&2 ; set +e ; return 1 ; }
		elif [ ! -f "$epicFile" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --epic-update: no such epic file: $epicFile" >&2
			set +e ; return 1
		fi
		case "$epicMode" in

			--set-status)
				local statusItemId="${1:-}" featureId="${1:-}" featureStatus="${2:-}" statusTemp statusDoneText statusDoneLine statusKind statusPlace statusSpan statusItemCount
				shift 2 || true
				if [ -z "$statusItemId" ] || [ -z "$featureStatus" ] ; then
					echo "⛔ ERROR: $MDSC_CMD --epic-update --set-status: syntax is <feature-id> <status>, or <feature-id>.<n> done <text...>" >&2
					set +e ; return 1
				fi
				case "${featureId##*.}" in
					*[!0-9]*)
						[ "$featureId" = "${featureId%.*}" ] || { echo "⛔ ERROR: $MDSC_CMD --epic-update --set-status: $statusItemId is no item id -- the form is <feature-id>.<n>" >&2 ; set +e ; return 1 ; }
						## An id with no item number is a feature's, and its status is one word: no text rides on it.
						[ $# -eq 0 ] || { echo "⛔ ERROR: $MDSC_CMD --epic-update --set-status: invalid option: $1 -- the status is one line, passed as one argument" >&2 ; set +e ; return 1 ; }
					;;
				esac
				## What the id names settles the branch: the heading that bears it, else the one item of its feature.
				## A dotted id is no item on its own say, since a `### S18.4` heading carries a dotted id of its own.
				statusPlace="$( AgentsToolsMagicEpicPlace "$epicFile" "$statusItemId" "--epic-update --set-status" )" || { set +e ; return 1 ; }
				statusKind="${statusPlace%% *}" ; statusSpan="${statusPlace#* }"
				## An item closes on its own id, with the caller's text: it and its nested lines leave, and `## Done` gets one line.
				if [ "$statusKind" = item ] ; then
					[ "$featureStatus" = done ] || { echo "⛔ ERROR: $MDSC_CMD --epic-update --set-status: only done closes an item: <feature-id>.<n> done <text...>" >&2 ; set +e ; return 1 ; }
					[ $# -gt 0 ] || { echo "⛔ ERROR: $MDSC_CMD --epic-update --set-status: the closed item's text is needed" >&2 ; set +e ; return 1 ; }
					statusDoneText="$( printf '%s ' "$@" | LC_ALL=C sed 's/ $//' )"
					statusDoneLine="- $statusItemId: $statusDoneText"
					statusTemp="$( AgentsToolsMagicEpicTemp )" || { set +e ; return 1 ; }
					## The line goes through the environment, never -v, which decodes a backslash in it (MAGIC.md section 3).
					EPIC_LINE="$statusDoneLine" LC_ALL=C awk -v spanFirst="${statusSpan%% *}" -v spanLast="${statusSpan##* }" '
						function emit(lineIn) { print lineIn ; lastBlank = ( lineIn ~ /^[ \t]*$/ ) ; }
						BEGIN { line = ENVIRON["EPIC_LINE"] ; seenDone = 0 ; lastBlank = 0 ; heldBlank = 0 ; }
						{
							if ( $0 == "## Done" ) { seenDone = 1 ; }
							if ( NR >= spanFirst && NR <= spanLast ) { next ; }
							## The blank line the closed item leaves behind goes only where one does not already stand.
							if ( NR == spanLast + 1 && $0 ~ /^[ \t]*$/ ) { heldBlank = 1 ; next ; }
							if ( heldBlank && ! lastBlank ) { emit( "" ) ; }
							heldBlank = 0
							emit( $0 )
						}
						END { if ( ! seenDone ) { emit( "" ) ; emit( "## Done" ) ; } ; emit( line ) ; }
					' "$epicFile" > "$statusTemp" || { rm -f -- "$statusTemp" ; set +e ; return 1 ; }
					LC_ALL=C grep -q -F -x -- "$statusDoneLine" "$statusTemp" || { rm -f -- "$statusTemp" ; echo "⛔ ERROR: $MDSC_CMD --epic-update --set-status: the line is not in $epicShown after the write -- nothing was closed" >&2 ; set +e ; return 1 ; }
					AgentsToolsMagicEpicPut "$statusTemp" "$epicFile" "$epicVaultName" || { set +e ; return 1 ; }
					printf 'EPIC: %s: %s closed: %s\n' "${epicShown##*/}" "$statusItemId" "$statusDoneText"
					set +e ; return 0
				fi
				[ $# -eq 0 ] || { echo "⛔ ERROR: $MDSC_CMD --epic-update --set-status: invalid option: $1 -- the status is one line, passed as one argument" >&2 ; set +e ; return 1 ; }
				## A feature closes only once it holds no item, and becomes one line of `## Done`. The section stands
				## last, so a file without one gets it at its own end.
				if [ "$featureStatus" = done ] ; then
					statusItemCount="$( LC_ALL=C awk -v spanFirst="${statusSpan%% *}" -v spanLast="${statusSpan##* }" '
						NR > spanFirst && NR <= spanLast && $0 ~ /^[0-9]+\. / { count++ ; }
						END { print count + 0 ; }
					' "$epicFile" )"
					[ "$statusItemCount" -eq 0 ] || {
						echo "⛔ ERROR: $MDSC_CMD --epic-update --set-status: feature $featureId holds $statusItemCount open item(s) -- close each by its own id first: <feature-id>.<n> done <text...>" >&2
						set +e ; return 1
					}
					statusDoneText="$( AgentsToolsMagicEpicDoneText "$epicFile" "${statusSpan%% *}" "${statusSpan##* }" "$featureId" )"
					statusDoneLine="- $featureId: $statusDoneText"
					statusTemp="$( AgentsToolsMagicEpicTemp )" || { set +e ; return 1 ; }
					EPIC_LINE="$statusDoneLine" LC_ALL=C awk -v spanFirst="${statusSpan%% *}" -v spanLast="${statusSpan##* }" '
						BEGIN { line = ENVIRON["EPIC_LINE"] ; seenDone = 0 ; }
						{
							if ( $0 == "## Done" ) { seenDone = 1 ; }
							if ( NR >= spanFirst && NR <= spanLast ) { next ; }
							print
						}
						END { if ( ! seenDone ) { print "" ; print "## Done" ; } ; print line ; }
					' "$epicFile" > "$statusTemp" || { rm -f -- "$statusTemp" ; set +e ; return 1 ; }
					LC_ALL=C grep -q -F -x -- "$statusDoneLine" "$statusTemp" || { rm -f -- "$statusTemp" ; echo "⛔ ERROR: $MDSC_CMD --epic-update --set-status: the line is not in $epicShown after the write -- nothing was closed" >&2 ; set +e ; return 1 ; }
					AgentsToolsMagicEpicPut "$statusTemp" "$epicFile" "$epicVaultName" || { set +e ; return 1 ; }
					printf 'EPIC: %s: %s closed: %s\n' "${epicShown##*/}" "$featureId" "$statusDoneText"
					set +e ; return 0
				fi
				statusTemp="$( AgentsToolsMagicEpicTemp )" || { set +e ; return 1 ; }
				EPIC_LINE="Status: $featureStatus" LC_ALL=C awk -v spanFirst="${statusSpan%% *}" -v spanLast="${statusSpan##* }" '
					BEGIN { new = ENVIRON["EPIC_LINE"] ; placed = 0 ; }
					{
						## A feature with no Status: line gets it at the end of its span, and one that has it keeps its place.
						if ( NR > spanFirst && NR <= spanLast && $0 ~ /^Status: / ) { print new ; placed = 1 ; next ; }
						print
						if ( NR == spanLast && ! placed ) { print new ; print "" ; placed = 1 ; }
					}
				' "$epicFile" > "$statusTemp" || { rm -f -- "$statusTemp" ; set +e ; return 1 ; }
					AgentsToolsMagicEpicPut "$statusTemp" "$epicFile" "$epicVaultName" || { set +e ; return 1 ; }
					printf 'EPIC: %s: %s status set to %s\n' "${epicShown##*/}" "$featureId" "$featureStatus"
			;;

			--add-settled)
				local featureId="${1:-}" settledTemp settledWord
				shift || true
				if [ -z "$featureId" ] ; then
					echo "⛔ ERROR: $MDSC_CMD --epic-update --add-settled: syntax is <feature-id> <text...>" >&2
					set +e ; return 1
				fi
				## The rule stands as itself: no date, no owner, wherever the word of either stands among the text.
				for settledWord in "$@" ; do
					case "$settledWord" in
						--date|--owner) echo "⛔ ERROR: $MDSC_CMD --epic-update --add-settled: $settledWord is gone -- the rule is written plain, with no date and no owner" >&2 ; set +e ; return 1 ;;
					esac
				done
				local settledText settledLine settledSpan
				settledText="$( printf '%s ' "$@" | LC_ALL=C sed 's/ $//' )"
				[ -n "$settledText" ] || { echo "⛔ ERROR: $MDSC_CMD --epic-update --add-settled: the settled text is needed" >&2 ; set +e ; return 1 ; }
				settledSpan="$( AgentsToolsMagicEpicPlace "$epicFile" "$featureId" "--epic-update --add-settled" )" || { set +e ; return 1 ; }
				settledSpan="${settledSpan#* }"
				settledLine="$settledText"
				settledTemp="$( AgentsToolsMagicEpicTemp )" || { set +e ; return 1 ; }
				EPIC_LINE="$settledLine" LC_ALL=C awk -v spanFirst="${settledSpan%% *}" -v spanLast="${settledSpan##* }" '
					BEGIN { line = ENVIRON["EPIC_LINE"] ; placed = 0 ; }
					{
						## A feature with no Status: line gets the settlement before the span ends, not only at the end of the file.
						if ( NR > spanFirst && NR <= spanLast && $0 ~ /^Status: / ) { print $0 ; print "" ; print line ; placed = 1 ; next ; }
						if ( NR == spanLast && ! placed ) { print "" ; print line ; placed = 1 ; }
						print
					}
				' "$epicFile" > "$settledTemp" || { rm -f -- "$settledTemp" ; set +e ; return 1 ; }
				LC_ALL=C grep -q -F -x -- "$settledLine" "$settledTemp" || { rm -f -- "$settledTemp" ; echo "⛔ ERROR: $MDSC_CMD --epic-update --add-settled: the line is not in $epicShown after the write -- nothing was settled" >&2 ; set +e ; return 1 ; }
				AgentsToolsMagicEpicPut "$settledTemp" "$epicFile" "$epicVaultName" || { set +e ; return 1 ; }
				printf 'EPIC: %s: %s settled: %s\n' "${epicShown##*/}" "$featureId" "$settledText"
			;;

			*)
				echo "⛔ ERROR: $MDSC_CMD --epic-update: $epicMode is not --set-status or --add-settled" >&2
				set +e ; return 1
			;;
		esac
	;;

	--epic-read)
		shift
		local readFile="${1:-}" readFeature=""
		if [ -z "$readFile" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --epic-read: syntax is <epic-file> [--feature <feature-id>]" >&2
			set +e ; return 1
		fi
		shift
		case "${1:-}" in
			'') ;;
			--feature)
				readFeature="${2:-}"
				if [ -z "$readFeature" ] || [ $# -ne 2 ] ; then
					echo "⛔ ERROR: $MDSC_CMD --epic-read: syntax is <epic-file> [--feature <feature-id>]" >&2
					set +e ; return 1
				fi
			;;
			*) echo "⛔ ERROR: $MDSC_CMD --epic-read: invalid option: $1" >&2 ; set +e ; return 1 ;;
		esac
		AgentsToolsMagicEpicCaller "--epic-read" read || { set +e ; return 1 ; }
		local readVaultPath=""
		if readVaultPath="$( AgentsToolsMagicEpicVaultPath "$readFile" )" ; then
			[ -f "$readVaultPath" ] || { echo "⛔ ERROR: $MDSC_CMD --epic-read: no such vault epic item: $readFile" >&2 ; set +e ; return 1 ; }
			readFile="$readVaultPath"
		else
			AgentsToolsMagicEpicReadPlace "--epic-read" "$readFile" || { set +e ; return 1 ; }
			if [ ! -f "$readFile" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --epic-read: no such epic file: $readFile" >&2
				set +e ; return 1
			fi
		fi
		if [ -z "$readFeature" ] ; then
			cat -- "$readFile" || { set +e ; return 1 ; }
		else
			## One id prints the lines it owns: a feature's whole section, down to the next heading, or one item and its nested lines.
			local readSpan=""
			readSpan="$( AgentsToolsMagicEpicPlace "$readFile" "$readFeature" "--epic-read --feature" )" || { set +e ; return 1 ; }
			readSpan="${readSpan#* }"
			LC_ALL=C awk -v spanFirst="${readSpan%% *}" -v spanLast="${readSpan##* }" 'NR >= spanFirst && NR <= spanLast' "$readFile" || { set +e ; return 1 ; }
		fi
	;;

	--epic-list)
		shift
		local listDir="${1:-}" listFile listCount listFound=no
		AgentsToolsMagicEpicCaller "--epic-list" read || { set +e ; return 1 ; }
		## No folder: the epics are the vault's own items.
		if [ $# -eq 0 ] ; then
			[ -n "${MDAT_DATA_ROOT:-}" ] || { echo "⛔ ERROR: $MDSC_CMD --epic-list: MDAT_DATA_ROOT is not set" >&2 ; set +e ; return 1 ; }
			type AgentsToolsVaultFilesInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/vault/AgentsTools.VaultPlace.include"
			local listFiles=()
			AgentsToolsVaultFilesInto listFiles epic-blueprint-
			for listFile in ${listFiles[@]+"${listFiles[@]}"} ; do
				## An epic is read by its bare name from the vault folder, so an item in a folder of it is no epic to list.
				[ "${listFile%/*}" = "$MDAT_DATA_ROOT/vault" ] || continue
				case "${listFile##*/}" in epic-blueprint-*.md) ;; *) continue ;; esac
				listFound=yes
				## An item under an invalid name is listed as refused, never as an epic to use.
				if ! AgentsToolsMagicEpicVaultPath "${listFile##*/}" > /dev/null 2>&1 ; then
					printf '%s REFUSED: no valid epic-blueprint name, so no read and no write reaches it\n' "${listFile##*/}"
					continue
				fi
				listCount="$( LC_ALL=C awk 'index( $0, "## " ) == 1 { n++ ; } END { print n + 0 ; }' "$listFile" )"
				printf '%s %s sections\n' "${listFile##*/}" "$listCount"
			done
			[ "$listFound" = yes ] || printf 'EPIC-LIST: no epic item in %s/vault\n' "$MDAT_DATA_ROOT"
			return 0
		fi
		if [ $# -ne 1 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --epic-list: syntax is [<folder>]" >&2
			set +e ; return 1
		fi
		AgentsToolsMagicEpicReadPlace "--epic-list" "$listDir" || { set +e ; return 1 ; }
		if [ ! -d "$listDir" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --epic-list: no such folder: $listDir" >&2
			set +e ; return 1
		fi
		for listFile in "$listDir"/*.epic.md ; do
			[ -f "$listFile" ] || continue
			listFound=yes
			listCount="$( LC_ALL=C awk 'index( $0, "## " ) == 1 { n++ ; } END { print n + 0 ; }' "$listFile" )"
			printf '%s %s sections\n' "${listFile##*/}" "$listCount"
		done
		[ "$listFound" = yes ] || printf 'EPIC-LIST: no epic file in %s\n' "$listDir"
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
