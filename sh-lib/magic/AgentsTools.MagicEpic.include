#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.MagicEpic.include -- the epic operations (W1 of the refactorings epic). One operation,
## `--epic-update`, edits an epic, so no routine edits one by hand:
##   --epic-update <epic-file|epic-item> --set-status <feature-id> <status>
##   --epic-update <epic-file|epic-item> --add-settled <feature-id> <text...>
## Two reads let any member see an epic through the tooling (S23.8):
##   --epic-read <epic-file|epic-item> [--feature <feature-id>]   the epic whole, or one feature's section
##   --epic-list [<folder>]                                     the vault's epic items, or each *.epic.md of the folder
## An epic is a vault document of `vault-item.epic-blueprint` (`epic-blueprint-<date>-<matter>.md`), or the plain source file it was
## moved from, named by a path under a `todo-sketchpad` folder with no `..` part.
## `--set-status` writes the `Status:` line that stands under the `## <feature-id>` heading (it replaces the line
## where one stands, else inserts it after the heading). `--set-status <feature-id>.<n> done <text...>` closes one
## item: it and its nested lines leave, and `## Done` gets `- <feature-id>.<n>: <text>`, the caller's text.
## `--set-status <feature-id> done` closes the feature, and is refused while an item stands: then the feature's
## lines leave and `## Done` gets one line, its id and what holds now -- the feature's settled text, else its
## heading's title. `--add-settled` adds the rule as one plain present-tense line under the same heading, after its
## `Status:` line, with no date and no owner. Both refuse where the feature is not there or stands more than once.
## A vault item is edited as a copy and handed to `--upsert-vault-epic-blueprint`, so its contract check and its commit both
## happen at the one vault write. A plain source file is edited in place and never committed: the owner commits what
## is applied. Sourced from AgentDispatcherTools.fn.sh's arm for the name; relies on $1/$@/$MDSC_CMD.
##

## How many `## <feature-id> ` headings stand in an epic file.
AgentsToolsMagicEpicFeatureCount(){ ## file, feature-id
	LC_ALL=C awk -v want="## $2 " 'index( $0, want ) == 1 { n++ } END { print n + 0 }' "$1"
}

## What a closed feature holds now, for its one line in `## Done`: the last line of its own body that is neither
## blank nor a `Status:` line, the `**Settled <date> (<owner>).** ` stamp taken off where one stands; else its own
## heading's title, without the separator after the id. Printed, one line.
AgentsToolsMagicEpicDoneText(){ ## file, feature-id
	LC_ALL=C awk -v want="## $2 " '
		index( $0, want ) == 1 { inFeature = 1 ; title = substr( $0, length( want ) + 1 ) ; sub( /^[-:] /, "", title ) ; next }
		! inFeature { next }
		$0 ~ /^## / || $0 ~ /^# / { exit }
		$0 ~ /^Status: / { next }
		NF { held = $0 ; sub( /^[[:space:]]*\*\*Settled [^*]*\*\*[[:space:]]*/, "", held ) }
		END { print ( held != "" ? held : title ) }
	' "$1"
}

## An epic is written only as magic-coordinator, which owns it. Any member reads one, with no ask.
AgentsToolsMagicEpicCaller(){ ## the operation, write (the default) or read
	[ "${2:-write}" != read ] || return 0
	type AgentsToolsSurfaceCaller > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.CoordinatorSurface.include"
	AgentsToolsSurfaceCaller "$1" write
}

## The path in the vault of the epic item a call names, rc 1 where the argument is no vault epic name.
AgentsToolsMagicEpicVaultPath(){ ## the argument
	case "$1" in
		*/*|'') return 1 ;;
		epic-blueprint-*.md) ;;
		*) return 1 ;;
	esac
	[ -n "${MDAT_DATA_ROOT:-}" ] || return 1
	printf '%s/vault/%s\n' "$MDAT_DATA_ROOT" "$1"
}

## A vault epic's edited copy becomes the item through the one vault write, which checks it and commits it. A plain source
## file is a plain file no longer, and the copy takes its place. Either way the copy goes.
AgentsToolsMagicEpicPut(){ ## the built copy, the file it was built from, the vault item's name (empty for a plain file)
	local putMember
	if [ -z "$3" ] ; then
		mv -f -- "$1" "$2" || { rm -f -- "$1" ; return 1 ; }
		return 0
	fi
	type AgentsToolsActingMember > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.CallerCheck.include"
	putMember="$( AgentsToolsActingMember )" ; putMember="${putMember:-magic-coordinator}"
	"${MDAT_BASH:-bash}" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsItems.fn.sh" --upsert-vault-epic-blueprint "$putMember" "$3" --from-file "$1" || { rm -f -- "$1" ; return 1 ; }
	rm -f -- "$1"
}

## A path a read may name: under a `todo-sketchpad` folder, with no `..` part.
AgentsToolsMagicEpicReadPlace(){ ## the operation, the path
	case "/$2" in
		*/todo-sketchpad|*/todo-sketchpad/*) ;;
		*) echo "⛔ ERROR: $MDSC_CMD $1: $2 is not under a todo-sketchpad folder -- the epics are read there and nowhere else" >&2 ; return 1 ;;
	esac
	case "/$2/" in
		*/../*) echo "⛔ ERROR: $MDSC_CMD $1: $2 has a .. part -- name the file by its own path" >&2 ; return 1 ;;
	esac
	return 0
}

## The edit is made against a scratch copy and moved over the file, so a failed write never leaves a half file.
AgentsToolsMagicEpicTemp(){ ## prints a fresh scratch path in the calling session's own folder
	local epicBase="$MMDAPP/.local/temp"
	[ -z "${MDAT_SPAWN_SANDBOX_ROOT:-}" ] || epicBase="$MDAT_SPAWN_SANDBOX_ROOT/output"
	mkdir -p "$epicBase" || return 1
	mktemp "$epicBase/AgentsEpic.XXXXXX"
}

case "$1" in

	--epic-update)
		shift
		local epicFile="${1:-}" epicMode="${2:-}"
		shift 2 || true
		if [ -z "$epicFile" ] || [ -z "$epicMode" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --epic-update: syntax is <epic-file> (--set-status <feature-id> <status>|<feature-id>.<n> done <text...>|--add-settled <feature-id> <text...>)" >&2
			set +e ; return 1
		fi
		AgentsToolsMagicEpicCaller "--epic-update" || { set +e ; return 1 ; }
		## A vault epic item is the source, and its own name is what the edit reports.
		local epicVaultName="" epicShown="$epicFile"
		if AgentsToolsMagicEpicVaultPath "$epicFile" > /dev/null ; then
			epicVaultName="$epicFile" ; epicShown="$epicVaultName"
			epicFile="$( AgentsToolsMagicEpicVaultPath "$epicVaultName" )"
			[ -f "$epicFile" ] || { echo "⛔ ERROR: $MDSC_CMD --epic-update: no such vault epic item: $epicVaultName" >&2 ; set +e ; return 1 ; }
		elif [ ! -f "$epicFile" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --epic-update: no such epic file: $epicFile" >&2
			set +e ; return 1
		fi
		case "$epicMode" in

			--set-status)
				local statusItemId="${1:-}" featureId="${1:-}" featureStatus="${2:-}" statusTemp statusDoneText statusDoneLine statusItemN="" statusItemCount
				shift 2 || true
				if [ -z "$statusItemId" ] || [ -z "$featureStatus" ] ; then
					echo "⛔ ERROR: $MDSC_CMD --epic-update --set-status: syntax is <feature-id> <status>, or <feature-id>.<n> done <text...>" >&2
					set +e ; return 1
				fi
				## An id with a dot closes one item of its feature; the feature id alone is the feature.
				case "$featureId" in
					*.*) statusItemN="${featureId##*.}" ; featureId="${featureId%.*}" ;;
				esac
				if [ -n "$statusItemN" ] ; then
					case "$statusItemN" in
						*[!0-9]*) echo "⛔ ERROR: $MDSC_CMD --epic-update --set-status: $statusItemId is no item id -- the form is <feature-id>.<n>" >&2 ; set +e ; return 1 ;;
					esac
				fi
				## An item closes on its own id, with the caller's text: it and its nested lines leave, and `## Done` gets one line.
				if [ -n "$statusItemN" ] ; then
					[ "$featureStatus" = done ] || { echo "⛔ ERROR: $MDSC_CMD --epic-update --set-status: only done closes an item: <feature-id>.<n> done <text...>" >&2 ; set +e ; return 1 ; }
					[ $# -gt 0 ] || { echo "⛔ ERROR: $MDSC_CMD --epic-update --set-status: the closed item's text is needed" >&2 ; set +e ; return 1 ; }
					[ "$( AgentsToolsMagicEpicFeatureCount "$epicFile" "$featureId" )" -eq 1 ] || {
						echo "⛔ ERROR: $MDSC_CMD --epic-update --set-status: feature $featureId must stand exactly once in $epicFile" >&2
						set +e ; return 1
					}
					statusDoneText="$( printf '%s ' "$@" | LC_ALL=C sed 's/ $//' )"
					statusItemCount="$( LC_ALL=C awk -v want="## $featureId " -v n="$statusItemN" '
						index( $0, want ) == 1 { inFeature = 1 ; next }
						! inFeature { next }
						$0 ~ /^## / || $0 ~ /^# / { exit }
						$0 ~ ( "^" n "[.][ \t]" ) { count++ }
						END { print count + 0 }
					' "$epicFile" )"
					[ "$statusItemCount" -eq 1 ] || {
						echo "⛔ ERROR: $MDSC_CMD --epic-update --set-status: item $statusItemId must stand exactly once in $epicFile" >&2
						set +e ; return 1
					}
					statusDoneLine="- $statusItemId: $statusDoneText"
					statusTemp="$( AgentsToolsMagicEpicTemp )" || { set +e ; return 1 ; }
					LC_ALL=C awk -v want="## $featureId " -v n="$statusItemN" -v line="$statusDoneLine" '
						function emit(lineIn) { print lineIn ; lastBlank = ( lineIn ~ /^[ \t]*$/ ) ; }
						BEGIN { inFeature = 0 ; seenDone = 0 ; skipping = 0 ; heldBlank = 0 ; closed = 0 ; lastBlank = 0 }
						{
							if ( $0 == "## Done" ) { seenDone = 1 }
							if ( skipping ) {
								if ( $0 ~ /^[ \t]/ ) { next }
								if ( $0 ~ /^[ \t]*$/ ) { heldBlank = 1 ; next }
								skipping = 0
								if ( heldBlank && ! lastBlank ) { emit( "" ) }
								heldBlank = 0
							}
							if ( inFeature && ( $0 ~ /^## / || $0 ~ /^# / ) ) { inFeature = 0 }
							if ( ! inFeature && index( $0, want ) == 1 ) { inFeature = 1 ; emit( $0 ) ; next }
							if ( inFeature && ! closed && $0 ~ ( "^" n "[.][ \t]" ) ) { closed = 1 ; skipping = 1 ; next }
							emit( $0 )
						}
						END { if ( ! seenDone ) { emit( "" ) ; emit( "## Done" ) } ; emit( line ) }
					' "$epicFile" > "$statusTemp" || { rm -f -- "$statusTemp" ; set +e ; return 1 ; }
					LC_ALL=C grep -q -F -x -- "$statusDoneLine" "$statusTemp" || { rm -f -- "$statusTemp" ; echo "⛔ ERROR: $MDSC_CMD --epic-update --set-status: the line is not in $epicShown after the write -- nothing was closed" >&2 ; set +e ; return 1 ; }
					AgentsToolsMagicEpicPut "$statusTemp" "$epicFile" "$epicVaultName" || { set +e ; return 1 ; }
					printf 'EPIC: %s: %s closed: %s\n' "${epicShown##*/}" "$statusItemId" "$statusDoneText"
					set +e ; return 0
				fi
				[ $# -eq 0 ] || { echo "⛔ ERROR: $MDSC_CMD --epic-update --set-status: invalid option: $1 -- the status is one line, passed as one argument" >&2 ; set +e ; return 1 ; }
				[ "$( AgentsToolsMagicEpicFeatureCount "$epicFile" "$featureId" )" -eq 1 ] || {
					echo "⛔ ERROR: $MDSC_CMD --epic-update --set-status: feature $featureId must stand exactly once in $epicFile" >&2
					set +e ; return 1
				}
				## A feature closes only once it holds no item, and becomes one line of `## Done`. The section stands
				## last, so a file without one gets it at its own end.
				if [ "$featureStatus" = done ] ; then
					statusItemCount="$( LC_ALL=C awk -v want="## $featureId " '
						index( $0, want ) == 1 { inFeature = 1 ; next }
						! inFeature { next }
						$0 ~ /^## / || $0 ~ /^# / { exit }
						$0 ~ /^[0-9]+\. / { count++ }
						END { print count + 0 }
					' "$epicFile" )"
					[ "$statusItemCount" -eq 0 ] || {
						echo "⛔ ERROR: $MDSC_CMD --epic-update --set-status: feature $featureId holds $statusItemCount open item(s) -- close each by its own id first: <feature-id>.<n> done <text...>" >&2
						set +e ; return 1
					}
					statusDoneText="$( AgentsToolsMagicEpicDoneText "$epicFile" "$featureId" )"
					statusDoneLine="- $featureId: $statusDoneText"
					statusTemp="$( AgentsToolsMagicEpicTemp )" || { set +e ; return 1 ; }
					LC_ALL=C awk -v want="## $featureId " -v line="$statusDoneLine" '
						BEGIN { inFeature = 0 ; seenDone = 0 }
						{
							if ( $0 == "## Done" ) { seenDone = 1 }
							if ( inFeature ) {
								if ( $0 ~ /^## / || $0 ~ /^# / ) { inFeature = 0 } else { next }
							} else if ( index( $0, want ) == 1 ) { inFeature = 1 ; next }
							print
						}
						END { if ( ! seenDone ) { print "" ; print "## Done" } ; print line }
					' "$epicFile" > "$statusTemp" || { rm -f -- "$statusTemp" ; set +e ; return 1 ; }
					LC_ALL=C grep -q -F -x -- "$statusDoneLine" "$statusTemp" || { rm -f -- "$statusTemp" ; echo "⛔ ERROR: $MDSC_CMD --epic-update --set-status: the line is not in $epicShown after the write -- nothing was closed" >&2 ; set +e ; return 1 ; }
					AgentsToolsMagicEpicPut "$statusTemp" "$epicFile" "$epicVaultName" || { set +e ; return 1 ; }
					printf 'EPIC: %s: %s closed: %s\n' "${epicShown##*/}" "$featureId" "$statusDoneText"
					set +e ; return 0
				fi
				statusTemp="$( AgentsToolsMagicEpicTemp )" || { set +e ; return 1 ; }
				LC_ALL=C awk -v want="## $featureId " -v new="Status: $featureStatus" '
					BEGIN { inFeature = 0 ; placed = 0 }
					{
						if ( ! inFeature ) {
							if ( index( $0, want ) == 1 ) { inFeature = 1 ; print ; next }
							print ; next
						}
						## A feature with no Status: line gets it before the next heading, not only at the end of the file.
						if ( $0 ~ /^## / || $0 ~ /^# / ) { if ( ! placed ) { print new ; print "" ; placed = 1 } ; inFeature = 0 ; print ; next }
						if ( ! placed && $0 ~ /^Status: / ) { print new ; placed = 1 ; next }
						print
					}
					END { if ( ! placed && inFeature ) { print "" ; print new } }
				' "$epicFile" > "$statusTemp" || { rm -f -- "$statusTemp" ; set +e ; return 1 ; }
					AgentsToolsMagicEpicPut "$statusTemp" "$epicFile" "$epicVaultName" || { set +e ; return 1 ; }
					printf 'EPIC: %s: %s status set to %s\n' "${epicShown##*/}" "$featureId" "$featureStatus"
			;;

			--add-settled)
				local featureId="${1:-}" settledTemp settledWord
				shift || true
				if [ -z "$featureId" ] ; then
					echo "⛔ ERROR: $MDSC_CMD --epic-update --add-settled: syntax is <feature-id> <text...>" >&2
					set +e ; return 1
				fi
				## The rule stands as itself: no date, no owner, wherever the word of either stands among the text.
				for settledWord in "$@" ; do
					case "$settledWord" in
						--date|--owner) echo "⛔ ERROR: $MDSC_CMD --epic-update --add-settled: $settledWord is gone -- the rule is written plain, with no date and no owner" >&2 ; set +e ; return 1 ;;
					esac
				done
				local settledText settledLine
				settledText="$( printf '%s ' "$@" | LC_ALL=C sed 's/ $//' )"
				[ -n "$settledText" ] || { echo "⛔ ERROR: $MDSC_CMD --epic-update --add-settled: the settled text is needed" >&2 ; set +e ; return 1 ; }
				[ "$( AgentsToolsMagicEpicFeatureCount "$epicFile" "$featureId" )" -eq 1 ] || {
					echo "⛔ ERROR: $MDSC_CMD --epic-update --add-settled: feature $featureId must stand exactly once in $epicFile. A rule is added under its feature with --add-settled, and an item is closed with --set-status <feature-id>.<n> done <text...>" >&2
					set +e ; return 1
				}
				settledLine="$settledText"
				settledTemp="$( AgentsToolsMagicEpicTemp )" || { set +e ; return 1 ; }
				LC_ALL=C awk -v want="## $featureId " -v line="$settledLine" '
					BEGIN { inFeature = 0 ; placed = 0 }
					{
						if ( ! inFeature ) {
							if ( index( $0, want ) == 1 ) { inFeature = 1 ; print ; next }
							print ; next
						}
						## A feature with no Status: line gets the settlement before the next heading, not only at the end of the file.
						if ( $0 ~ /^## / || $0 ~ /^# / ) { if ( ! placed ) { print line ; print "" ; placed = 1 } ; inFeature = 0 ; print ; next }
						if ( ! placed && $0 ~ /^Status: / ) { print $0 ; print "" ; print line ; placed = 1 ; next }
						print
					}
					END { if ( ! placed && inFeature ) { print "" ; print line } }
				' "$epicFile" > "$settledTemp" || { rm -f -- "$settledTemp" ; set +e ; return 1 ; }
				LC_ALL=C grep -q -F -x -- "$settledLine" "$settledTemp" || { rm -f -- "$settledTemp" ; echo "⛔ ERROR: $MDSC_CMD --epic-update --add-settled: the line is not in $epicShown after the write -- nothing was settled" >&2 ; set +e ; return 1 ; }
				AgentsToolsMagicEpicPut "$settledTemp" "$epicFile" "$epicVaultName" || { set +e ; return 1 ; }
				printf 'EPIC: %s: %s settled: %s\n' "${epicShown##*/}" "$featureId" "$settledText"
			;;

			*)
				echo "⛔ ERROR: $MDSC_CMD --epic-update: $epicMode is not --set-status or --add-settled" >&2
				set +e ; return 1
			;;
		esac
	;;

	--epic-read)
		shift
		local readFile="${1:-}" readFeature=""
		if [ -z "$readFile" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --epic-read: syntax is <epic-file> [--feature <feature-id>]" >&2
			set +e ; return 1
		fi
		shift
		case "${1:-}" in
			'') ;;
			--feature)
				readFeature="${2:-}"
				if [ -z "$readFeature" ] || [ $# -ne 2 ] ; then
					echo "⛔ ERROR: $MDSC_CMD --epic-read: syntax is <epic-file> [--feature <feature-id>]" >&2
					set +e ; return 1
				fi
			;;
			*) echo "⛔ ERROR: $MDSC_CMD --epic-read: invalid option: $1" >&2 ; set +e ; return 1 ;;
		esac
		AgentsToolsMagicEpicCaller "--epic-read" read || { set +e ; return 1 ; }
		local readVaultPath=""
		if readVaultPath="$( AgentsToolsMagicEpicVaultPath "$readFile" )" ; then
			[ -f "$readVaultPath" ] || { echo "⛔ ERROR: $MDSC_CMD --epic-read: no such vault epic item: $readFile" >&2 ; set +e ; return 1 ; }
			readFile="$readVaultPath"
		else
			AgentsToolsMagicEpicReadPlace "--epic-read" "$readFile" || { set +e ; return 1 ; }
			if [ ! -f "$readFile" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --epic-read: no such epic file: $readFile" >&2
				set +e ; return 1
			fi
		fi
		if [ -z "$readFeature" ] ; then
			cat -- "$readFile" || { set +e ; return 1 ; }
		else
			[ "$( AgentsToolsMagicEpicFeatureCount "$readFile" "$readFeature" )" -eq 1 ] || {
				echo "⛔ ERROR: $MDSC_CMD --epic-read: feature $readFeature must stand exactly once in $readFile" >&2
				set +e ; return 1
			}
			LC_ALL=C awk -v want="## $readFeature " '
				index( $0, want ) == 1 { on = 1 ; print ; next }
				on && ( $0 ~ /^## / || $0 ~ /^# / ) { exit }
				on { print }
			' "$readFile" || { set +e ; return 1 ; }
		fi
	;;

	--epic-list)
		shift
		local listDir="${1:-}" listFile listCount listFound=no
		AgentsToolsMagicEpicCaller "--epic-list" read || { set +e ; return 1 ; }
		## No folder: the epics are the vault's own items.
		if [ $# -eq 0 ] ; then
			[ -n "${MDAT_DATA_ROOT:-}" ] || { echo "⛔ ERROR: $MDSC_CMD --epic-list: MDAT_DATA_ROOT is not set" >&2 ; set +e ; return 1 ; }
			for listFile in "$MDAT_DATA_ROOT"/vault/epic-blueprint-*.md ; do
				[ -f "$listFile" ] || continue
				listFound=yes
				listCount="$( LC_ALL=C awk 'index( $0, "## " ) == 1 { n++ } END { print n + 0 }' "$listFile" )"
				printf '%s %s sections\n' "${listFile##*/}" "$listCount"
			done
			[ "$listFound" = yes ] || printf 'EPIC-LIST: no epic item in %s/vault\n' "$MDAT_DATA_ROOT"
			return 0
		fi
		if [ $# -ne 1 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --epic-list: syntax is [<folder>]" >&2
			set +e ; return 1
		fi
		AgentsToolsMagicEpicReadPlace "--epic-list" "$listDir" || { set +e ; return 1 ; }
		if [ ! -d "$listDir" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --epic-list: no such folder: $listDir" >&2
			set +e ; return 1
		fi
		for listFile in "$listDir"/*.epic.md ; do
			[ -f "$listFile" ] || continue
			listFound=yes
			listCount="$( LC_ALL=C awk 'index( $0, "## " ) == 1 { n++ } END { print n + 0 }' "$listFile" )"
			printf '%s %s sections\n' "${listFile##*/}" "$listCount"
		done
		[ "$listFound" = yes ] || printf 'EPIC-LIST: no epic file in %s\n' "$listDir"
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
