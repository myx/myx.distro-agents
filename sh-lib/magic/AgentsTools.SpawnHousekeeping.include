#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.SpawnHousekeeping.include -- the acting half of the board's pass, by the tooling and no agent (F3.1, F7.12): what a dead spawn
## left open is closed. Sourced, never run; functions only. Called by the main loop at each iteration (the board is settled for the work-duty
## session of the coordinator to read), and by the take of the advance lock (AgentsToolsRoutineLockTakeOwn: the call is idempotent).
##

## The acting half of the board's pass: the main loop runs it at each iteration, and the take of the advance lock once it is taken; the scans only read.
## Closes what a dead spawn left open, silently on stdout, so the reads after it see the moved items: a started sandbox record whose session
## is dead (a local one by process list, any other by age), the dispatch item it links, a running dispatch item whose own record already ended,
## and a review item whose reviewer session has ended. And starts the control thread of each session that needs one and has none alive.
## THE HANDBACK NOBODY READ (S27.3): a review item still waiting for its verdict past the review
## limit is a problem, and the scan says it from outside, by listing and checking, so a run parked
## on a handback nobody looked at is told to the member that should have read it. Run before the
## reviewer fallback, so an item whose reviewer is gone is escalated to the member the fallback
## gives it, not to one that has ended. Prints one REVIEW-UNSEEN line per item raised.
AgentsToolsReviewUnseenEscalate(){ ## the member the scan acts as
	local unBy="$1" unPath unItem unSince unLimit unNow unReviewer unTold unSeen unMark
	type AgentsReviewWaitLimit > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.ReviewFlow.include" 2> /dev/null || return 0
	type AgentsToolsSpawnSandboxRecordHeader > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SpawnSandbox.include" 2> /dev/null || return 0
	unLimit="$( AgentsReviewWaitLimit )"
	unNow="$( date +%s )"
	for unPath in "$MDAT_DATA_ROOT"/board/review/*.md ; do
		[ -f "$unPath" ] || continue
		unItem="${unPath##*/}"
		## An item already raised is left alone: one escalation per review entry, kept beside the item.
		unSince="$( AgentsToolsSpawnSandboxRecordHeader "$unPath" review-since-epoch )"
		case "$unSince" in ''|*[!0123456789]*) continue ;; esac
		unSeen=$(( unNow - unSince ))
		[ "$unSeen" -ge "$unLimit" ] || continue
		unReviewer="$( AgentsToolsSpawnSandboxRecordHeader "$unPath" review-by )"
		case "$unReviewer" in ''|human-owner|*.routine|*:*) unTold=magic-coordinator ;; *) unTold="$unReviewer" ;; esac
		unMark="$MDAT_DATA_ROOT/board/review/.unseen-$unItem"
		[ ! -f "$unMark" ] || continue
		mkdir -p "${unMark%/*}" 2> /dev/null && : > "$unMark" 2> /dev/null || continue
		## The mark is a write into the store like any other, and it outlives the pass that made it: it leaves an entry, and
		## the one thread commits it. Without one it sat untracked, beside 132 others, until a person's --commit-pending.
		type AgentsToolsTeamDataCommitPaths > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.TeamDataCommit.include" 2> /dev/null || :
		type AgentsToolsTeamDataCommitPaths > /dev/null 2>&1 || continue
		AgentsToolsTeamDataCommitPaths "review-unseen mark, ${unItem%.md}" "$unMark" > /dev/null 2>&1 || :
		AgentsToolsSpawnProxyStaleHandbackTell "$unBy" "$unTold" "$unItem" "$unSeen" || :
		printf 'REVIEW-UNSEEN: %s waited %ss for a verdict, told to %s\n' "$unItem" "$unSeen" "$unTold"
	done
	return 0
}

## An open ask whose asking run is gone is closed as that run's record is: withdrawn, with no verdict, once nothing
## touched it for 15 minutes. An ask whose asker cannot be measured, or that names none, goes after the stale hours. The asker-live measure is
## the pending read's own (AgentsToolsPendingReplyAskers); only asks of this host are measured. One line per ask withdrawn.
AgentsToolsPendingAskHousekeeping(){ ## stale hours, calling member
	local askHours="$1" askBy askRoot="$MMDAPP/.local/agents/pending" askFile askId askSession askHost askIds="" askLive askThisHost askQuiet
	askThisHost="$( hostname -s 2> /dev/null )"
	for askFile in "$askRoot"/*.md ; do
		[ -f "$askFile" ] && LC_ALL=C grep -q -x 'status: reply-pending' "$askFile" || continue
		askSession="$( LC_ALL=C sed -n 's/^session-id: //p' "$askFile" | head -1 )"
		[ -z "$askSession" ] || [ "$askSession" = "-" ] || askIds="${askIds}${askSession}"$'\n'
	done
	## The include runs its own operation when sourced, and fails it with no arguments: only the function it defines is wanted.
	type AgentsToolsPendingReplyAskers > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.MemberPendingReply.include" < /dev/null > /dev/null 2>&1
	type AgentsToolsPendingReplyAskers > /dev/null 2>&1 || return 0
	askLive="$( printf '%s' "$askIds" | LC_ALL=C sort -u | AgentsToolsPendingReplyAskers )"
	for askFile in "$askRoot"/*.md ; do
		[ -f "$askFile" ] && LC_ALL=C grep -q -x 'status: reply-pending' "$askFile" || continue
		askHost="$( LC_ALL=C sed -n 's/^host: //p' "$askFile" | head -1 )"
		[ -z "$askHost" ] || [ "$askHost" = "$askThisHost" ] || continue
		askSession="$( LC_ALL=C sed -n 's/^session-id: //p' "$askFile" | head -1 )"
		case "$askSession" in
			''|-) askQuiet=$(( askHours * 60 )) ;;
			*)
				case "$( printf '%s\n' "$askLive" | LC_ALL=C awk -v want="$askSession" '$1 == want { print $2 ; exit }' )" in
					no-process|session-ended) askQuiet=15 ;;
					no-spawn-record) askQuiet=$(( askHours * 60 )) ;;
					*) continue ;;
				esac
			;;
		esac
		[ -z "$( find "$askFile" -mmin -"$askQuiet" 2> /dev/null )" ] || continue
		askId="${askFile##*/}" ; askId="${askId%.md}"
		## The asker withdraws its own: the tooling acts for the ended run, as it closes that run's record.
		askBy="$( LC_ALL=C sed -n 's/^owner: //p' "$askFile" | head -1 )"
		[ -n "$askBy" ] || continue
		"$BASH" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsSession.fn.sh" --settle-pending-reply --team-member "$askBy" "$askId" \
			--reason "the run that asked it has ended, so nobody is there to take the answer" --withdraw > /dev/null 2>&1 || :
		## A post that could not be edited fails the call after the close: the record's own state says what happened.
		if ! LC_ALL=C grep -q -x 'status: reply-pending' "$askRoot/$askId.md" 2> /dev/null ; then
			printf 'housekeeping: withdrew ask %s, its asker %s has ended\n' "$askId" "${askSession:-unrecorded}"
		fi
	done
	return 0
}

AgentsToolsAdvanceSpawnHousekeeping(){ ## stale hours, calling member, [no-threads: the control threads are left to the caller's own check]
	local staleHours="$1" spawnRoot="$MMDAPP/.local/agents/spawned"
	local measureText startedRows rowTracking rowSession rowParent rowHost rowOwner rowStatus rowExit rowSpawn rowAgentLog rowSessionThread rowWorkspace rowLive rowState
	local reviewBy reviewId reviewDir sessionKind housekeepingLog=""
	type AgentsToolsTeamMemberDirectory > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.TeamRegistry.include"
	## The one place the outcome word of a closed-by-tooling spawn is spelled; the status values are `spawn-` and `dispatch-` plus it.
	local endedOutcome="ended-without-close"
	local recordPath recordCandidate recordStatus recordExit rowSide linkField linkStem itemName itemState itemPath itemSpawn itemOutput targetState closeOutcome
	local controlLines controlSession controlWord controlPid controlWhy controlStarted="" controlCount=0
	measureText="$( AgentsToolsRegistryRenderSpawnedSessions agents )"
	case "$measureText" in
		*"**NOTE:** no scan was made"*) return 0 ;;
	esac
	startedRows="$( printf '%s\n' "$measureText" | LC_ALL=C awk 'NF == 13 && $6 == "spawn-started" && $8 != "-" { print ; }' )"
	type AgentsToolsSessionControlDeathHeld > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionControlDeath.include" 2> /dev/null || :
	while read -r rowTracking rowSession rowParent rowHost rowOwner rowStatus rowExit rowSpawn rowAgentLog rowSessionThread rowWorkspace rowLive rowState ; do
		[ -n "$rowTracking" ] || continue
		recordPath="$spawnRoot/$rowTracking/$rowSpawn.spawn.md"
		[ -f "$recordPath" ] || continue
		case "$rowLive" in
			running) continue ;;
			gone)
				[ "$rowState" != waiting ] || continue
				## A death that the control thread of its session keeps and has not settled is that thread's while it lives: it tells it and asks about it, and this pass
				## neither closes nor tells that run (AgentsToolsSessionControlDeathHeld). With no thread alive the run is closed here as before.
				! AgentsToolsSessionControlDeathHeld "$rowSession" "$rowSpawn" 2> /dev/null || continue
				[ -z "$( find "$spawnRoot/$rowTracking" "$MMDAPP/.local/agents/sessions/$rowSpawn" "$MMDAPP/.local/agents/sessions/$rowSession" -type f -mmin -15 2> /dev/null | head -1 )" ] || continue
				rowSide=local
			;;
			*)
				if AgentsToolsRegistryPendingSessionOpen "$rowSession" ; then continue ; fi
				[ -z "$( find "$spawnRoot/$rowTracking" "$MMDAPP/.local/agents/sessions/$rowSpawn" "$MMDAPP/.local/agents/sessions/$rowSession" -type f -mmin -"$(( staleHours * 60 ))" 2> /dev/null | head -1 )" ] || continue
				rowSide=foreign
			;;
		esac
		[ "$( AgentsToolsSpawnSandboxRecordHeader "$recordPath" status )" = spawn-started ] || continue
		## An agent-less parent whose watcher is gone is closed from its children's outcomes, once they all have closed and none is
		## queued; else its watcher is started again, from its run-process and host (AgentsToolsSpawnSessionParentRevive).
		if [ "$( AgentsToolsSpawnSandboxRecordHeader "$recordPath" agent-less )" = true ] ; then
			if AgentsToolsSpawnSessionParentClose "$recordPath" ; then
				housekeepingLog="${housekeepingLog}housekeeping: closed agent-less parent $rowTracking $rowSpawn from its children"$'\n'
			elif AgentsToolsSpawnSessionParentRevive "$recordPath" ; then
				housekeepingLog="${housekeepingLog}housekeeping: started again the watcher of agent-less parent $rowTracking $rowSpawn"$'\n'
			fi
			continue
		fi
		AgentsToolsSpawnProxyCloseSandbox "$recordPath" "$endedOutcome" unknown
		if [ "$( AgentsToolsSpawnSandboxRecordHeader "$recordPath" status )" != "spawn-$endedOutcome" ] ; then
			AgentsToolsDaemonLine "⚠️ WARNING: $MDSC_CMD routine lock take (advance): could not close the record of spawn $rowSpawn in $rowTracking"
			continue
		fi
		housekeepingLog="${housekeepingLog}housekeeping: closed record $rowTracking $rowSpawn"$'\n'
		itemOutput="$( AgentsToolsSpawnSandboxRecordHeader "$recordPath" output-file )"
		[ -n "$itemOutput" ] || itemOutput="-"
		for linkField in spawns spawned-by ; do
			linkStem="$( AgentsToolsSpawnSandboxRecordHeader "$recordPath" "$linkField" )"
			[ -n "$linkStem" ] || continue
			itemName="${linkStem%.md}.md"
			itemState="$( AgentsToolsSpawnProxyBoardStateOf "$itemName" )"
			[ -n "$itemState" ] || continue
			itemPath="$MDAT_DATA_ROOT/board/$itemState/$itemName"
			[ "$( AgentsToolsSpawnSandboxRecordHeader "$itemPath" status )" = dispatch-started ] || continue
			## An item that names a newer spawn belongs to that one, not to this dead record.
			itemSpawn="$( AgentsToolsSpawnSandboxRecordHeader "$itemPath" spawn-id )"
			[ -z "$itemSpawn" ] || [ "$itemSpawn" = "-" ] || [ "$itemSpawn" = "$rowSpawn" ] || continue
			targetState="$itemState"
			[ "$linkField" != spawns ] || [ "$itemState" != running ] || targetState=review
			AgentsToolsSpawnProxyCloseDispatch "$itemName" "" unknown "$itemOutput" "$endedOutcome" "$itemState" "$targetState" > /dev/null 2>&1
			if [ "$( AgentsToolsSpawnSandboxRecordHeader "$MDAT_DATA_ROOT/board/$targetState/$itemName" status )" = "dispatch-$endedOutcome" ] ; then
				housekeepingLog="${housekeepingLog}housekeeping: $itemName $itemState->$targetState $endedOutcome"$'\n'
			fi
		done
		## Its end is told to the session that requested it, as its supervising shell would have told it (AgentsToolsSpawnProxyEndNotice): for a run of this host
		## whose shell is not there to tell it. A shell that still lives tells it at its own close (AgentsToolsRegistryRecordedSupervisor). Once, since this pass
		## closes a record once; behind the record and the item, and nothing of it in what the scan prints.
		[ "$rowSide" != local ] || [ "$( AgentsToolsRegistryRecordedSupervisor "$recordPath" 2> /dev/null )" = "alive" ] || AgentsToolsSpawnProxyEndNotice "$recordPath" > /dev/null || :
	done <<< "$startedRows"
	for itemPath in "$MDAT_DATA_ROOT"/board/running/dispatch-*.md ; do
		[ -f "$itemPath" ] || continue
		[ "$( AgentsToolsSpawnSandboxRecordHeader "$itemPath" status )" = dispatch-started ] || continue
		itemName="${itemPath##*/}"
		itemSpawn="$( AgentsToolsSpawnSandboxRecordHeader "$itemPath" spawn-id )"
		recordPath=""
		if [ -n "$itemSpawn" ] && [ "$itemSpawn" != "-" ] ; then
			for recordCandidate in "$spawnRoot"/*/"$itemSpawn.spawn.md" ; do
				[ ! -f "$recordCandidate" ] || { recordPath="$recordCandidate" ; break ; }
			done
		fi
		if [ -n "$recordPath" ] ; then
			recordStatus="$( AgentsToolsSpawnSandboxRecordHeader "$recordPath" status )"
			case "$recordStatus" in ''|spawn-started) continue ;; esac
			closeOutcome="${recordStatus#spawn-}"
			recordExit="$( AgentsToolsSpawnSandboxRecordHeader "$recordPath" exit-code )"
			[ -n "$recordExit" ] || recordExit="unknown"
			itemOutput="$( AgentsToolsSpawnSandboxRecordHeader "$recordPath" output-file )"
			[ -n "$itemOutput" ] || itemOutput="-"
		else
			[ -z "$( find "$itemPath" -mmin -"$(( staleHours * 60 ))" 2> /dev/null | head -1 )" ] || continue
			closeOutcome="$endedOutcome" ; recordExit="unknown" ; itemOutput="-"
		fi
		AgentsToolsSpawnProxyCloseDispatch "$itemName" "" "$recordExit" "$itemOutput" "$closeOutcome" running review > /dev/null 2>&1
		if [ -f "$MDAT_DATA_ROOT/board/review/$itemName" ] ; then
			housekeepingLog="${housekeepingLog}housekeeping: $itemName running->review $closeOutcome"$'\n'
		fi
	done
	## An open ask whose asker has ended is withdrawn, as its run's record is closed.
	housekeepingLog="${housekeepingLog}$( AgentsToolsPendingAskHousekeeping "$staleHours" "$2" )
"
	## A started record that names no spawn id has no run to measure: it closes once nothing in it changed for the stale hours.
	for recordPath in "$spawnRoot"/*/*.spawn.md ; do
		[ -f "$recordPath" ] || continue
		[ "$( AgentsToolsSpawnSandboxRecordHeader "$recordPath" status )" = spawn-started ] || continue
		case "$( AgentsToolsSpawnSandboxRecordHeader "$recordPath" spawn-id )" in ''|-) ;; *) continue ;; esac
		[ -z "$( find "${recordPath%/*}" -type f -mmin -"$(( staleHours * 60 ))" 2> /dev/null | head -1 )" ] || continue
		AgentsToolsSpawnProxyCloseSandbox "$recordPath" "$endedOutcome" unknown > /dev/null 2>&1
		[ "$( AgentsToolsSpawnSandboxRecordHeader "$recordPath" status )" != "spawn-$endedOutcome" ] || housekeepingLog="${housekeepingLog}housekeeping: closed record ${recordPath#$spawnRoot/}, which names no spawn id"$'\n'
	done
	## A sandbox whose launch never wrote its record is a failed launch: a launch writes it within minutes, so after an hour it gets a record saying so,
	## so it stays listed, as every sandbox is, and reads failed rather than unclosed.
	local emptyDir emptyName
	for emptyDir in "$spawnRoot"/*/ ; do
		[ -d "$emptyDir" ] || continue
		emptyName="${emptyDir%/}" ; emptyName="${emptyName##*/}"
		ls "$emptyDir"*.spawn.md > /dev/null 2>&1 && continue
		[ -z "$( find "$emptyDir" "$MMDAPP/.local/agents/sessions/$emptyName" -mmin -60 2> /dev/null | head -1 )" ] || continue
		printf -- '---\nsession-id: -\nspawn-id: -\ntracking-name: %s\nhost: %s\nstatus: spawn-failed\nexit-code: unknown\nstarted-at: %s\nsession-comment: launch never wrote its record\n---\n\nClosed by housekeeping: the launch made this sandbox and ended before writing its record.\n' \
			"$emptyName" "$( hostname -s 2> /dev/null )" "$( date -r "$emptyDir" +"%Y-%m-%d %H:%M %z" 2> /dev/null )" > "$emptyDir$emptyName.spawn.md" 2> /dev/null \
			&& housekeepingLog="${housekeepingLog}housekeeping: closed sandbox $emptyName as a failed launch, which wrote no record"$'\n'
	done
	## A review item that has waited past the limit for a verdict is raised to its reviewer (S27.3).
	housekeepingLog="${housekeepingLog}$( AgentsToolsReviewUnseenEscalate "$2" )
"
	## A review item whose named reviewer session has ended goes to the coordinator. A bare member name, `human-owner`, a live session and a missing review-by stay as they are.
	measureText="$( AgentsToolsRegistryRenderSpawnedSessions agents )"
	for itemPath in "$MDAT_DATA_ROOT"/board/review/*.md ; do
		[ -f "$itemPath" ] || continue
		itemName="${itemPath##*/}"
		reviewBy="$( AgentsToolsSpawnSandboxRecordHeader "$itemPath" review-by )"
		case "$reviewBy" in
			## A routine reviews on its own next run, from its own input scan: grooming.routine, advance.routine, any <routine>.
			''|human-owner|*.routine) continue ;;
			*:*) reviewId="${reviewBy%%:*}" ;;
			magic-*|keeper-*|warden-*|partner-*|client-*|oncall-*|expert-*) continue ;;
			## A member of any workspace stays too (AgentsTools.TeamRegistry.include), not this one's own index alone.
			*) if reviewDir="$( AgentsToolsTeamMemberDirectory "$reviewBy" )" && [ -f "$reviewDir/SKILL.md" ] ; then continue ; fi ; reviewId="$reviewBy" ;;
		esac
		## The live column is the twelfth word and the state the thirteenth (S27.4): a live run reads its activity word, never `running`.
		sessionKind="$( printf '%s\n' "$measureText" | LC_ALL=C awk -v wantSession="$reviewId" '
			NF == 13 && $2 == wantSession { sawRow = 1 ; if ( $12 == "running" || $13 == "waiting" ) { sawLive = 1 ; } }
			END { if ( sawLive ) { print "live" ; } else if ( sawRow ) { print "ended" ; } }
		' )"
		case "$sessionKind:$reviewId" in
			live:*) continue ;;
			ended:*) ;;
			## No row, and a store of its own (a root session among them): ended only when that store
			## says so (AgentsToolsGrantsSessionEnded, its record, else the marker its SessionEnd hook
			## writes), never by age. An id with no store at all, by age as before.
			*/*|:.|:..|:) [ -z "$( find "$itemPath" -mmin -"$(( staleHours * 60 ))" 2> /dev/null | head -1 )" ] || continue ;;
			*)
				if [ -d "$MMDAPP/.local/agents/sessions/$reviewId" ] ; then
					type AgentsToolsGrantsSessionEnded > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.Grants.include"
					AgentsToolsGrantsSessionEnded "$MMDAPP/.local/agents/sessions/$reviewId" || continue
				else
					[ -z "$( find "$itemPath" -mmin -"$(( staleHours * 60 ))" 2> /dev/null | head -1 )" ] || continue
				fi
			;;
		esac
		type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
		if DistroAgentsTools --intern-op-board-upsert-move-edit review "$itemName" --from-state:review \
			--header:upsert:review-by:magic-coordinator --context "routine lock take (advance)" > /dev/null 2>&1 ; then
			housekeepingLog="${housekeepingLog}housekeeping: $itemName review-by -> magic-coordinator"$'\n'
		fi
	done
	## AN END MARK A REFUSAL OR A RATE LIMIT LEFT (S6.37): the root message of a session whose marks Slack did not take
	## is asked again here, by the pass that already runs over the dead records. One that lands becomes the session's end.
	type AgentsToolsSpawnProxyRootMarkRetry > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SpawnSandbox.include" 2> /dev/null || :
	AgentsToolsSpawnProxyRootMarkRetry || :
	if [ "${3:-}" = no-threads ] ; then
		AgentsToolsHousekeepingReport "$2" "${housekeepingLog%$'\n'}"
		return 0
	fi
	## The on-demand check of the health of the sessions: the control thread of each session that is not finished and has none alive is started,
	## detached and never waited for (AgentsToolsSessionControlCheck, AgentsTools.SessionControlStart.include). By the rows measured above, once
	## the dead records are closed: nothing is measured for it. One line of the report says what was started, and only when a thread was;
	## a thread that could not be started is one warning on the daemon line, and the pass goes on.
	type AgentsToolsSessionControlCheck > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionControlStart.include" 2> /dev/null || :
	controlLines="$( printf '%s\n' "$measureText" | AgentsToolsSessionControlCheck 2> /dev/null )" || controlLines=""
	while read -r controlSession controlWord controlPid controlWhy ; do
		case "$controlWord" in
			started) controlStarted="$controlStarted $controlSession" ; controlCount=$(( controlCount + 1 )) ;;
			failed) AgentsToolsDaemonLine "⚠️ WARNING: $MDSC_CMD routine lock take (advance): the control thread of session $controlSession could not be started: $controlWhy" ;;
		esac
	done <<< "$controlLines"
	[ "$controlCount" -eq 0 ] || housekeepingLog="${housekeepingLog}housekeeping: started the control thread of $controlCount session(s):$controlStarted"$'\n'
	## What was done never enters the lock's output; it goes to the event-track thread of this spawn's coworking session.
	AgentsToolsHousekeepingReport "$2" "${housekeepingLog%$'\n'}"
	return 0
}
