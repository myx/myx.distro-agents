#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.MemberCommsTrello.include -- the raw per-member Trello comms
## operations (unread-notification check and single-notification read).
## Split out of the former single comms include, which carried Slack, email
## and Trello in one file and no longer exists; the Slack and email arms now
## live in AgentsTools.MemberCommsSlack.include and AgentsTools.MemberCommsEmail.include.
##
## Sourced lazily from DistroAgentsTools.fn.sh; relies on being dot-sourced
## for $1/$@/$MDSC_CMD.
##
## EVERY OP HERE TAKES <team-member> FIRST, and that member IS the acting
## identity -- which is why `comms` is a namespace layer UNDER the member
## prefix, --member-comms-<service>-<verb>, rather than a prefix of its own.
## The name says who acts before it says through which service. A Trello
## notification feed belongs to one account, so the member decides whose feed
## is read at all.
##
## THE DISPATCHER REACHES THIS FILE BY THE --member-comms-trello-* GLOB, so
## adding a --member-comms-trello-* op costs no dispatcher line. NOTE that the
## --magic-comms-trello-* ops are a different family with their own route and their
## own include (AgentsTools.MagicTrello.include); this glob does not reach
## them and must not be widened to.
##
## Supported operations:
##   --member-comms-trello-check   --member-comms-trello-read
##
## THE API'S STATUS CODE IS NOT THE ANSWER TO THE QUESTION THE CALLER ASKED.
## An empty result must not read as success: a failed notifications call means
## the unread list is UNKNOWN, not empty, and an HTTP error status counts as a
## failure here rather than as an empty body. Each arm reports the outcome of
## the QUESTION its caller asked, and curl's own exit status is only evidence
## toward that answer, never the answer itself. Outcomes are told apart by
## POSITIVE tests on what is present, never by a negation against an empty
## result, which is indistinguishable from "could not see anything".
##

case "$1" in

		## Same rationale as --member-comms-email-check in
		## AgentsTools.MemberCommsEmail.include -- Trello's own read side of
		## the same precoded-tooling gap. Unread notifications only (matches
		## the comms-sweep routine's Check step), not a full board read.
		--member-comms-trello-check)
			shift
			## <team-member> IS THE ACTING IDENTITY, for the same reason and with the
			## same validation shape as --member-comms-email-check in
			## AgentsTools.MemberCommsEmail.include and --member-comms-slack-read in
			## AgentsTools.MemberCommsSlack.include: a Trello notification feed belongs to
			## one identity, `members/me` resolves against whichever token is
			## presented, and so the member decides whose unread list this even is.
			## All of it runs BEFORE any network call.
			local memberName="$1"
			shift || true
			if [ -z "$memberName" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-trello-check: syntax is <team-member> -- the acting member is required, since a Trello notification feed belongs to one identity and the member decides whose unread list is read" >&2
				set +e ; return 1
			fi
			AgentsToolsAssertBareName "$memberName" "<team-member>" member-comms-trello-check || { set +e ; return 1 ; }
			case "$memberName" in
				routine-*)
					## A routine acting as caller has no skill directory and is not
					## expected to grow one -- same treatment, same reason, as
					## --member-comms-slack-read's own carve-out.
				;;
				*)
					if [ ! -d "$HOME/.claude/skills/$memberName" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --member-comms-trello-check: no such member skill directory: $HOME/.claude/skills/$memberName" >&2
						set +e ; return 1
					fi
				;;
			esac
			## Strictly the acting member's own scope, no fallback -- see
			## --member-comms-email-check's own note for why a fallback would
			## recreate the accepted-and-ignored defect this argument exists to end.
			local trelloKey trelloToken
			trelloKey="$( DistroAgentsTools --agents-config-option "$memberName" --select TRELLO_KEY )"
			trelloToken="$( DistroAgentsTools --agents-config-option "$memberName" --select TRELLO_TOKEN )"
			if [ -z "$trelloKey" ] || [ -z "$trelloToken" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-trello-check: TRELLO_KEY/TRELLO_TOKEN not fully set in ${memberName}'s own scope in .local/.agents" >&2
				set +e ; return 1
			fi
			local trelloNewline=$'\n'
			case "$trelloKey$trelloToken" in
				*"$trelloNewline"*)
					echo "⛔ ERROR: $MDSC_CMD --member-comms-trello-check: TRELLO_KEY/TRELLO_TOKEN in ${memberName}'s own scope in .local/.agents contains a newline -- a Trello credential never legitimately does, so the config is corrupted; the value is NOT stripped or repaired here, since a newline breaks out of the header into a second directive line and silently hiding a corrupted credential is worse than failing" >&2
					set +e ; return 1
				;;
			esac
			## THE CREDENTIALS NEVER APPEAR ON A COMMAND LINE. `key=`/`token=` in the
			## query string put both of them in argv, world-readable through `ps`,
			## and a URL is additionally the thing most likely to be echoed into a
			## log or an error message verbatim. Trello's own documented
			## `Authorization: OAuth` header carries them instead, written to a
			## mode-600 temp file and read back with `-H @file` -- the same mechanism
			## AgentsTools.InternOpSlackCall.include already uses for the Slack
			## bearer token, not a new one invented here. The URL that remains
			## carries no secret at all.
			local headerFile
			headerFile="$( mktemp )" || { set +e ; return 1 ; }
			chmod 600 "$headerFile"
			trap 'rm -f "$headerFile"' EXIT
			printf 'Authorization: OAuth oauth_consumer_key="%s", oauth_token="%s"\n' "$trelloKey" "$trelloToken" > "$headerFile"
			## -sS and "|| rc=$?", matching the email arms in
			## AgentsTools.MemberCommsEmail.include for exactly the reasons stated
			## there: -s alone swallows curl's own error text, and a
			## bare call followed by `return $?` cannot run at all under the active
			## set -e -- errexit aborts first, so the status is never read and a
			## failed check is indistinguishable from an empty one.
			local trelloRc=0
			curl -sS --connect-timeout 10 --max-time 120 -H @"$headerFile" \
				"https://api.trello.com/1/members/me/notifications?read_filter=unread" || trelloRc=$?
			rm -f "$headerFile"
			trap - EXIT
			if [ "$trelloRc" -ne 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-trello-check: Trello members/me/notifications?read_filter=unread failed as $memberName (curl rc=$trelloRc) -- the unread notification list is UNKNOWN, not empty; curl's own error is on the line above" >&2
				set +e ; return "$trelloRc"
			fi
			return 0
		;;

		## Full detail for one specific Trello notification by id -- the
		## comms-sweep's own unit of "a message" for Trello (per
		## --member-comms-trello-check's own read_filter=unread notifications list).
		## Contrast with --member-comms-trello-check's unread-list-only scan.
		--member-comms-trello-read)
			shift
			## <team-member> IS THE ACTING IDENTITY, for the same reason and with the
			## same validation shape as --member-comms-trello-check above: a
			## notification is visible only to the identity it was raised for, so the
			## member decides whose notification this id is resolved against. All of
			## it runs BEFORE any network call.
			local memberName="$1"
			shift || true
			if [ -z "$memberName" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-trello-read: syntax is <team-member> <notification-id> -- the acting member is required, since a notification is visible only to the identity it was raised for" >&2
				set +e ; return 1
			fi
			AgentsToolsAssertBareName "$memberName" "<team-member>" member-comms-trello-read || { set +e ; return 1 ; }
			case "$memberName" in
				routine-*)
					## A routine acting as caller has no skill directory and is not
					## expected to grow one -- same treatment, same reason, as
					## --member-comms-slack-read's own carve-out.
				;;
				*)
					if [ ! -d "$HOME/.claude/skills/$memberName" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --member-comms-trello-read: no such member skill directory: $HOME/.claude/skills/$memberName" >&2
						set +e ; return 1
					fi
				;;
			esac
			local notificationId="$1"
			shift || true
			if [ -z "$notificationId" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-trello-read: notification id required" >&2
				set +e ; return 1
			fi

			## Strictly the acting member's own scope, no fallback -- see
			## --member-comms-email-check's own note for why a fallback would
			## recreate the accepted-and-ignored defect this argument exists to end.
			local trelloKey trelloToken
			trelloKey="$( DistroAgentsTools --agents-config-option "$memberName" --select TRELLO_KEY )"
			trelloToken="$( DistroAgentsTools --agents-config-option "$memberName" --select TRELLO_TOKEN )"
			if [ -z "$trelloKey" ] || [ -z "$trelloToken" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-trello-read: TRELLO_KEY/TRELLO_TOKEN not fully set in ${memberName}'s own scope in .local/.agents" >&2
				set +e ; return 1
			fi
			local trelloNewline=$'\n'
			case "$trelloKey$trelloToken" in
				*"$trelloNewline"*)
					echo "⛔ ERROR: $MDSC_CMD --member-comms-trello-read: TRELLO_KEY/TRELLO_TOKEN in ${memberName}'s own scope in .local/.agents contains a newline -- a Trello credential never legitimately does, so the config is corrupted; the value is NOT stripped or repaired here, since a newline breaks out of the header into a second curl config line and silently hiding a corrupted credential is worse than failing" >&2
					set +e ; return 1
				;;
			esac

			## THE CREDENTIALS NEVER APPEAR ON A COMMAND LINE, for exactly the
			## reasons stated on --member-comms-trello-check above -- but by a
			## different mechanism, deliberately. The same `Authorization: OAuth`
			## header is written as a `header = "..."` line into `curl -K -`
			## (curl's "read options from this file", `-` meaning stdin) instead
			## of a mode-600 temp file read back with `-H @file`. Do not "align"
			## the two: a temp file needs cleanup, and cleanup is the part that
			## actually fails -- this package left netrc files holding a live
			## SMTP password in $TMPDIR for ~14 hours when a `trap` was missing.
			## `-K -` writes no file, so there is nothing to leak and nothing to
			## forget to remove. The trade is real, and it is the escaping below:
			## `-H @file` takes its line as-is, with no escape processing, so a
			## key or token cannot corrupt it however it is spelled.
			##
			## THE QUOTING AND ESCAPING ARE LOAD-BEARING, not tidiness. A `-K`
			## config value ends at the first whitespace unless the whole value is
			## double-quoted, and this header contains spaces -- unquoted it
			## truncates to a bare `Authorization:`, which is curl's own idiom for
			## REMOVING a header, so the request would go out carrying no
			## credential at all. Inside the quoted value curl still processes `\`
			## and `"` as escapes, so an unescaped one arriving in a key or token
			## would close the value early -- curl then discards the rest of that
			## physical line and sends the truncated remains as the credential,
			## again with nothing in curl's own output to notice it by. Hence `\`
			## first, then `"`, in that order.
			local trelloKeyEsc trelloTokenEsc
			trelloKeyEsc="${trelloKey//\\/\\\\}"
			trelloKeyEsc="${trelloKeyEsc//\"/\\\"}"
			trelloTokenEsc="${trelloToken//\\/\\\\}"
			trelloTokenEsc="${trelloTokenEsc//\"/\\\"}"
			echo "# $MDSC_CMD --member-comms-trello-read: fetching full notification id=$notificationId" >&2
			## -sS and "|| trelloRc=$?", matching --member-comms-trello-check
			## above in this file and the email arms in
			## AgentsTools.MemberCommsEmail.include, for exactly the reasons stated
			## there: -s alone swallows curl's own error text, and a bare call
			## followed by `return $?` cannot run at all under the active set -e.
			## --fail-with-body, not --fail: curl exits 0 for a 4xx/5xx response,
			## so without one of them an HTTP error would be reported as success,
			## but plain --fail also discards the response body -- and this op's
			## product IS the body (see this arm's header above), so a failure
			## would then have nothing to say why. --fail-with-body keeps the body
			## and still exits non-zero, which is what makes the error line below's
			## "an HTTP error status counts as a failure here" actually true.
			local trelloRc=0
			printf 'header = "Authorization: OAuth oauth_consumer_key=\\"%s\\", oauth_token=\\"%s\\""\n' \
				"$trelloKeyEsc" "$trelloTokenEsc" \
				| curl -sS --connect-timeout 10 --max-time 120 --fail-with-body -K - \
					"https://api.trello.com/1/notifications/${notificationId}?fields=all&member=true&memberCreator=true&card=true&card_fields=all&board=true&board_fields=all" || trelloRc=$?
			if [ "$trelloRc" -ne 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-trello-read: Trello notifications/${notificationId} failed as $memberName (curl rc=$trelloRc) -- the notification content is UNKNOWN, not empty, and an HTTP error status counts as a failure here; curl's own error is on the line above" >&2
				set +e ; return "$trelloRc"
			fi
			return 0
		;;

		## The acting side's OWN Trello identity -- whoever the TRELLO_KEY/
		## TRELLO_TOKEN in <team-member>'s scope actually resolve to. Printed as
		## KEY=VALUE lines, the same consumable shape --magic-comms-slack-resolve-ids
		## already hands its caller for the Slack side of the same question.
		--member-comms-trello-whoami)
			shift
			## <team-member> IS THE ACTING IDENTITY, same validation shape and
			## same reason as --member-comms-trello-check above: `members/me`
			## resolves against whichever token is presented, and this op exists
			## precisely to say which one that is.
			local memberName="$1"
			shift || true
			if [ -z "$memberName" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-trello-whoami: syntax is <team-member> -- the acting member is required, since members/me resolves against whichever token is presented" >&2
				set +e ; return 1
			fi
			AgentsToolsAssertBareName "$memberName" "<team-member>" member-comms-trello-whoami || { set +e ; return 1 ; }
			case "$memberName" in
				routine-*)
					## Same carve-out, same reason, as the two arms above.
				;;
				*)
					if [ ! -d "$HOME/.claude/skills/$memberName" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --member-comms-trello-whoami: no such member skill directory: $HOME/.claude/skills/$memberName" >&2
						set +e ; return 1
					fi
				;;
			esac
			local trelloKey trelloToken
			trelloKey="$( DistroAgentsTools --agents-config-option "$memberName" --select TRELLO_KEY )"
			trelloToken="$( DistroAgentsTools --agents-config-option "$memberName" --select TRELLO_TOKEN )"
			if [ -z "$trelloKey" ] || [ -z "$trelloToken" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-trello-whoami: TRELLO_KEY/TRELLO_TOKEN not fully set in ${memberName}'s own scope in .local/.agents" >&2
				set +e ; return 1
			fi
			local trelloNewline=$'\n'
			case "$trelloKey$trelloToken" in
				*"$trelloNewline"*)
					echo "⛔ ERROR: $MDSC_CMD --member-comms-trello-whoami: TRELLO_KEY/TRELLO_TOKEN in ${memberName}'s own scope in .local/.agents contains a newline -- a Trello credential never legitimately does, so the config is corrupted; the value is NOT stripped or repaired here, since a newline breaks out of the header into a second curl config line and silently hiding a corrupted credential is worse than failing" >&2
					set +e ; return 1
				;;
			esac

			## THE CREDENTIALS NEVER APPEAR ON A COMMAND LINE -- the `curl -K -`
			## mechanism of --member-comms-trello-read above, verbatim, including
			## its `\` then `"` escaping order. No temp file, so nothing to trap
			## and nothing to leak.
			local trelloKeyEsc trelloTokenEsc
			trelloKeyEsc="${trelloKey//\\/\\\\}"
			trelloKeyEsc="${trelloKeyEsc//\"/\\\"}"
			trelloTokenEsc="${trelloToken//\\/\\\\}"
			trelloTokenEsc="${trelloTokenEsc//\"/\\\"}"
			## `fields=id,username` keeps the response a flat two-key object, so
			## the reader below cannot pick up a same-named key from a nested
			## object -- the failure mode AgentsSlackJsonField.awk's own header
			## documents at length.
			local trelloRc=0 trelloMe=""
			trelloMe="$( printf 'header = "Authorization: OAuth oauth_consumer_key=\\"%s\\", oauth_token=\\"%s\\""\n' \
				"$trelloKeyEsc" "$trelloTokenEsc" \
				| curl -sS --connect-timeout 10 --max-time 120 --fail-with-body -K - \
					"https://api.trello.com/1/members/me?fields=id,username" )" || trelloRc=$?
			if [ "$trelloRc" -ne 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-trello-whoami: Trello members/me failed as $memberName (curl rc=$trelloRc) -- the acting identity is UNKNOWN, not absent; curl's own error is on the line above" >&2
				set +e ; return "$trelloRc"
			fi
			printf '%s\n' "$trelloMe" | LC_ALL=C awk '
				function field(k,   v) {
					if (!match(body, "\"" k "\"[ \t]*:[ \t]*\"[^\"]*\"")) return ""
					v = substr(body, RSTART, RLENGTH)
					sub(/^"[^"]*"[ \t]*:[ \t]*"/, "", v)
					sub(/"$/, "", v)
					return v
				}
				{ body = body $0 }
				END {
					id = field("id") ; user = field("username")
					if (id == "" || user == "") {
						printf("⛔ ERROR: --member-comms-trello-whoami: members/me carried no id/username -- the acting identity is UNKNOWN, not absent\n") > "/dev/stderr"
						exit 1
					}
					printf("TRELLO_USER_ID=%s\nTRELLO_USERNAME=%s\n", id, user)
				}
			' || { set +e ; return 1 ; }
			return 0
		;;

		*)
			echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
			set +e ; return 1
		;;
esac
