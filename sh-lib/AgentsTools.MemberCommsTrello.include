#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.MemberCommsTrello.include -- the raw per-member Trello comms
## operations (unread-notification check and single-notification read).
##

case "$1" in

		--member-comms-trello-check)
			shift
			local memberName="$1"
			shift || true
			if [ -z "$memberName" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-trello-check: syntax is <team-member> -- the acting member is required, since a Trello notification feed belongs to one identity and the member decides whose unread list is read" >&2
				set +e ; return 1
			fi
			AgentsToolsAssertBareName "$memberName" "<team-member>" member-comms-trello-check || { set +e ; return 1 ; }
			case "$memberName" in
				routine-*)
				;;
				*)
					if [ ! -d "$HOME/.claude/skills/$memberName" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --member-comms-trello-check: no such member skill directory: $HOME/.claude/skills/$memberName" >&2
						set +e ; return 1
					fi
				;;
			esac
			local trelloKey trelloToken
			trelloKey="$( DistroAgentsTools --agents-config-option "$memberName" --select TRELLO_KEY )"
			trelloToken="$( DistroAgentsTools --agents-config-option "$memberName" --select TRELLO_TOKEN )"
			if [ -z "$trelloKey" ] || [ -z "$trelloToken" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-trello-check: TRELLO_KEY/TRELLO_TOKEN not fully set in ${memberName}'s own scope in .local/.agents" >&2
				set +e ; return 1
			fi
			local trelloNewline=$'\n'
			case "$trelloKey$trelloToken" in
				*"$trelloNewline"*)
					echo "⛔ ERROR: $MDSC_CMD --member-comms-trello-check: TRELLO_KEY/TRELLO_TOKEN in ${memberName}'s own scope in .local/.agents contains a newline -- a Trello credential never legitimately does, so the config is corrupted; the value is NOT stripped or repaired here, since a newline breaks out of the header into a second directive line and silently hiding a corrupted credential is worse than failing" >&2
					set +e ; return 1
				;;
			esac
			local headerFile
			headerFile="$( mktemp )" || { set +e ; return 1 ; }
			chmod 600 "$headerFile"
			trap 'rm -f "$headerFile"' EXIT
			printf 'Authorization: OAuth oauth_consumer_key="%s", oauth_token="%s"\n' "$trelloKey" "$trelloToken" > "$headerFile"
			local trelloRc=0
			curl -sS --connect-timeout 10 --max-time 120 -H @"$headerFile" \
				"https://api.trello.com/1/members/me/notifications?read_filter=unread" || trelloRc=$?
			rm -f "$headerFile"
			trap - EXIT
			if [ "$trelloRc" -ne 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-trello-check: Trello members/me/notifications?read_filter=unread failed as $memberName (curl rc=$trelloRc) -- the unread notification list is UNKNOWN, not empty; curl's own error is on the line above" >&2
				set +e ; return "$trelloRc"
			fi
			return 0
		;;

		--member-comms-trello-read)
			shift
			local memberName="$1"
			shift || true
			if [ -z "$memberName" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-trello-read: syntax is <team-member> <notification-id> -- the acting member is required, since a notification is visible only to the identity it was raised for" >&2
				set +e ; return 1
			fi
			AgentsToolsAssertBareName "$memberName" "<team-member>" member-comms-trello-read || { set +e ; return 1 ; }
			case "$memberName" in
				routine-*)
				;;
				*)
					if [ ! -d "$HOME/.claude/skills/$memberName" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --member-comms-trello-read: no such member skill directory: $HOME/.claude/skills/$memberName" >&2
						set +e ; return 1
					fi
				;;
			esac
			local notificationId="$1"
			shift || true
			if [ -z "$notificationId" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-trello-read: notification id required" >&2
				set +e ; return 1
			fi

			local trelloKey trelloToken
			trelloKey="$( DistroAgentsTools --agents-config-option "$memberName" --select TRELLO_KEY )"
			trelloToken="$( DistroAgentsTools --agents-config-option "$memberName" --select TRELLO_TOKEN )"
			if [ -z "$trelloKey" ] || [ -z "$trelloToken" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-trello-read: TRELLO_KEY/TRELLO_TOKEN not fully set in ${memberName}'s own scope in .local/.agents" >&2
				set +e ; return 1
			fi
			local trelloNewline=$'\n'
			case "$trelloKey$trelloToken" in
				*"$trelloNewline"*)
					echo "⛔ ERROR: $MDSC_CMD --member-comms-trello-read: TRELLO_KEY/TRELLO_TOKEN in ${memberName}'s own scope in .local/.agents contains a newline -- a Trello credential never legitimately does, so the config is corrupted; the value is NOT stripped or repaired here, since a newline breaks out of the header into a second curl config line and silently hiding a corrupted credential is worse than failing" >&2
					set +e ; return 1
				;;
			esac

			local trelloKeyEsc trelloTokenEsc
			trelloKeyEsc="${trelloKey//\\/\\\\}"
			trelloKeyEsc="${trelloKeyEsc//\"/\\\"}"
			trelloTokenEsc="${trelloToken//\\/\\\\}"
			trelloTokenEsc="${trelloTokenEsc//\"/\\\"}"
			echo "# $MDSC_CMD --member-comms-trello-read: fetching full notification id=$notificationId" >&2
			local trelloRc=0
			printf 'header = "Authorization: OAuth oauth_consumer_key=\\"%s\\", oauth_token=\\"%s\\""\n' \
				"$trelloKeyEsc" "$trelloTokenEsc" \
				| curl -sS --connect-timeout 10 --max-time 120 --fail-with-body -K - \
					"https://api.trello.com/1/notifications/${notificationId}?fields=all&member=true&memberCreator=true&card=true&card_fields=all&board=true&board_fields=all" || trelloRc=$?
			if [ "$trelloRc" -ne 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-trello-read: Trello notifications/${notificationId} failed as $memberName (curl rc=$trelloRc) -- the notification content is UNKNOWN, not empty, and an HTTP error status counts as a failure here; curl's own error is on the line above" >&2
				set +e ; return "$trelloRc"
			fi
			return 0
		;;

		--member-comms-trello-whoami)
			shift
			local memberName="$1"
			shift || true
			if [ -z "$memberName" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-trello-whoami: syntax is <team-member> -- the acting member is required, since members/me resolves against whichever token is presented" >&2
				set +e ; return 1
			fi
			AgentsToolsAssertBareName "$memberName" "<team-member>" member-comms-trello-whoami || { set +e ; return 1 ; }
			case "$memberName" in
				routine-*)
					## Same carve-out, same reason, as the two arms above.
				;;
				*)
					if [ ! -d "$HOME/.claude/skills/$memberName" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --member-comms-trello-whoami: no such member skill directory: $HOME/.claude/skills/$memberName" >&2
						set +e ; return 1
					fi
				;;
			esac
			local trelloKey trelloToken
			trelloKey="$( DistroAgentsTools --agents-config-option "$memberName" --select TRELLO_KEY )"
			trelloToken="$( DistroAgentsTools --agents-config-option "$memberName" --select TRELLO_TOKEN )"
			if [ -z "$trelloKey" ] || [ -z "$trelloToken" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-trello-whoami: TRELLO_KEY/TRELLO_TOKEN not fully set in ${memberName}'s own scope in .local/.agents" >&2
				set +e ; return 1
			fi
			local trelloNewline=$'\n'
			case "$trelloKey$trelloToken" in
				*"$trelloNewline"*)
					echo "⛔ ERROR: $MDSC_CMD --member-comms-trello-whoami: TRELLO_KEY/TRELLO_TOKEN in ${memberName}'s own scope in .local/.agents contains a newline -- a Trello credential never legitimately does, so the config is corrupted; the value is NOT stripped or repaired here, since a newline breaks out of the header into a second curl config line and silently hiding a corrupted credential is worse than failing" >&2
					set +e ; return 1
				;;
			esac

			local trelloKeyEsc trelloTokenEsc
			trelloKeyEsc="${trelloKey//\\/\\\\}"
			trelloKeyEsc="${trelloKeyEsc//\"/\\\"}"
			trelloTokenEsc="${trelloToken//\\/\\\\}"
			trelloTokenEsc="${trelloTokenEsc//\"/\\\"}"
			local trelloRc=0 trelloMe=""
			trelloMe="$( printf 'header = "Authorization: OAuth oauth_consumer_key=\\"%s\\", oauth_token=\\"%s\\""\n' \
				"$trelloKeyEsc" "$trelloTokenEsc" \
				| curl -sS --connect-timeout 10 --max-time 120 --fail-with-body -K - \
					"https://api.trello.com/1/members/me?fields=id,username" )" || trelloRc=$?
			if [ "$trelloRc" -ne 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-trello-whoami: Trello members/me failed as $memberName (curl rc=$trelloRc) -- the acting identity is UNKNOWN, not absent; curl's own error is on the line above" >&2
				set +e ; return "$trelloRc"
			fi
			printf '%s\n' "$trelloMe" | LC_ALL=C awk '
				function field(k,   v) {
					if (!match(body, "\"" k "\"[ \t]*:[ \t]*\"[^\"]*\"")) return ""
					v = substr(body, RSTART, RLENGTH)
					sub(/^"[^"]*"[ \t]*:[ \t]*"/, "", v)
					sub(/"$/, "", v)
					return v
				}
				{ body = body $0 }
				END {
					id = field("id") ; user = field("username")
					if (id == "" || user == "") {
						printf("⛔ ERROR: --member-comms-trello-whoami: members/me carried no id/username -- the acting identity is UNKNOWN, not absent\n") > "/dev/stderr"
						exit 1
					}
					printf("TRELLO_USER_ID=%s\nTRELLO_USERNAME=%s\n", id, user)
				}
			' || { set +e ; return 1 ; }
			return 0
		;;

		*)
			echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
			set +e ; return 1
		;;
esac
