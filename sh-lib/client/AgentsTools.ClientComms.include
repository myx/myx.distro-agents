#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

## Snapshots a resource's full current content before a write below that could
## lose it -- read, then save byte for byte through the existing generic item
## store (AgentsToolsItemUpsert --from-audit), never a new read or write
## primitive. Either the read or the save failing refuses the whole write: it
## returns 1 and the caller must not reach its live write call. On success it
## prints SNAPSHOT_ID=<name> to stderr before that live call runs. No secret
## or credential value is ever in scope here -- the read op's own output
## carries none. The read is an in-context Atlassian read helper, named with its arguments.
AgentsToolsClientCommsSnapshotBeforeWrite(){ ## actingMember, writeOp, system, resourceType, resourceId, read-helper-and-args...
	local snapMember="$1" snapWriteOp="$2" snapSystem="$3" snapResourceType="$4" snapResourceId="$5"
	shift 5
	local snapTime snapName snapBody snapRc=0 snapTmp
	snapTime="$( date -u +%Y%m%dT%H%M%SZ )"
	snapName="snapshot-$snapTime-$snapSystem-$snapResourceType-$snapResourceId.md"
	type AgentsToolsAtlassianJiraIssueRead > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/atlassian/AgentsTools.JiraReads.include"
	snapBody="$( "$@" --context "$snapWriteOp-snapshot" 2>/dev/null )" || snapRc=$?
	if [ "$snapRc" -ne 0 ] ; then
		printf '%s\n' "⛔ ERROR: $MDSC_CMD --$snapWriteOp: could not read the current $snapResourceType to snapshot it -- refusing the write" >&2
		return 1
	fi
	## A file of this snapshot's own, by mktemp and never by $$, which every subshell of one shell shares.
	mkdir -p "$MMDAPP/.local/temp" && snapTmp="$( mktemp "$MMDAPP/.local/temp/mdat-snapshot.XXXXXX" )" || {
		printf '%s\n' "⛔ ERROR: $MDSC_CMD --$snapWriteOp: could not create the snapshot scratch directory -- refusing the write" >&2
		return 1
	}
	## The frontmatter is filled from the tool-side template (sh-lib/templates/audit-item.snapshot.document.format.md)
	## by the one shared filler; the body, the resource's content, is appended after it byte for byte.
	type AgentsToolsToolingTemplateFill > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.ToolingTemplate.include"
	local snapSlotsFile
	snapSlotsFile="$( mktemp "$MMDAPP/.local/temp/mdat-snapshot-slots.XXXXXX" )" || { rm -f "$snapTmp" ; printf '%s\n' "⛔ ERROR: $MDSC_CMD --$snapWriteOp: could not create the snapshot slots scratch file -- refusing the write" >&2 ; return 1 ; }
	printf '%s' \
		"system: $snapSystem"$'\n' \
		"resource-type: $snapResourceType"$'\n' \
		"resource-id: $snapResourceId"$'\n' \
		"write-op: $snapWriteOp"$'\n' \
		"captured-by: $snapMember"$'\n' \
		"captured-at: $snapTime"$'\n' > "$snapSlotsFile" || { rm -f "$snapTmp" "$snapSlotsFile" ; return 1 ; }
	VDS_SLOTS="$snapSlotsFile" AgentsToolsToolingTemplateFill "audit-item.snapshot.document.format.md" vault/AgentsVaultAuditDocumentFill.awk > "$snapTmp" || {
		rm -f "$snapTmp" "$snapSlotsFile"
		printf '%s\n' "⛔ ERROR: $MDSC_CMD --$snapWriteOp: the snapshot frontmatter could not be filled -- refusing the write" >&2
		return 1
	}
	rm -f "$snapSlotsFile"
	printf '%s\n' "$snapBody" >> "$snapTmp"
	AgentsToolsItemUpsert "$snapMember" --from-audit "$snapName" --from-file "$snapTmp" --context "$snapWriteOp-snapshot" --commit-message "audit snapshot: $snapName"
	snapRc=$?
	rm -f "$snapTmp"
	if [ "$snapRc" -ne 0 ] ; then
		printf '%s\n' "⛔ ERROR: $MDSC_CMD --$snapWriteOp: could not save the pre-write snapshot -- refusing the write" >&2
		return 1
	fi
	printf '%s\n' "SNAPSHOT_ID=$snapName" >&2
	return 0
}

type AgentsToolsItemUpsert > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/items/AgentsTools.InternOpItem.include"

case "$1" in

	## The 21 Jira and Confluence client-comms stubs, one branch. A bash 3.2
	## case pattern cannot take its alternatives from a variable, so the names
	## sit literally here; the inner case sets each op's own values, and one
	## common body validates and builds the arguments, then reaches the Atlassian
	## layer once (the intern call, or its helper for the two read ops). Error
	## messages stay byte for byte as they were, their per-op parts set above.
	--client-comms-jira-board-list|--client-comms-jira-board-read|--client-comms-jira-board-issue-search|--client-comms-jira-sprint-list|--client-comms-jira-sprint-issue-search|--client-comms-jira-issue-search|--client-comms-jira-issue-read|--client-comms-jira-comment-read|--client-comms-jira-issue-create|--client-comms-jira-issue-update|--client-comms-jira-issue-transition|--client-comms-jira-comment-add|--client-comms-jira-issue-delete|--client-comms-confluence-space-list|--client-comms-confluence-page-read|--client-comms-confluence-page-search|--client-comms-confluence-comment-read|--client-comms-confluence-page-create|--client-comms-confluence-page-update|--client-comms-confluence-comment-add|--client-comms-confluence-page-delete)
		local fwdOp="${1#--}" fwdShort="${1#--client-comms-}" fwdSecondFlag="" fwdSecondLabel="" fwdRestKind="" fwdStubValues="" fwdStubNoValues="" fwdMemberVerb="" fwdMemberSystem="" fwdHelper="" fwdSnapSystem="" fwdSnapResourceType="" fwdSnapReadHelper="" fwdSnapRaw=""
		shift
		case "$fwdShort" in
			jira-board-list) fwdRestKind=startAt ; fwdMemberVerb=reads ; fwdMemberSystem=Jira ;;
			jira-board-read) fwdSecondFlag=--board-id ; fwdSecondLabel='<board-id>' ; fwdRestKind=none ; fwdMemberVerb=reads ; fwdMemberSystem=Jira ;;
			jira-board-issue-search) fwdSecondFlag=--board-id ; fwdSecondLabel='<board-id>' ; fwdRestKind=startAt ; fwdMemberVerb=reads ; fwdMemberSystem=Jira ;;
			jira-sprint-list) fwdSecondFlag=--board-id ; fwdSecondLabel='<board-id>' ; fwdRestKind=startAt ; fwdMemberVerb=reads ; fwdMemberSystem=Jira ;;
			jira-sprint-issue-search) fwdSecondFlag=--sprint-id ; fwdSecondLabel='<sprint-id>' ; fwdRestKind=startAt ; fwdMemberVerb=reads ; fwdMemberSystem=Jira ;;
			jira-issue-search) fwdSecondFlag=--jql ; fwdSecondLabel='<jql>' ; fwdRestKind=limit ; fwdMemberVerb=reads ; fwdMemberSystem=Jira ;;
			jira-issue-read) fwdSecondFlag=--issue-key ; fwdSecondLabel='<issue-key>' ; fwdRestKind=format ; fwdMemberVerb=reads ; fwdMemberSystem=Jira ; fwdHelper=AgentsToolsAtlassianJiraIssueRead ;;
			jira-comment-read) fwdSecondFlag=--issue-key ; fwdSecondLabel='<issue-key>' ; fwdRestKind=commentRead ; fwdMemberVerb=reads ; fwdMemberSystem=Jira ;;
			jira-issue-create) fwdRestKind=stub ; fwdStubValues='--project --issuetype --summary --description-adf --description-adf-from-file --fields-json' ; fwdStubNoValues='--description-adf-from-stdin' ; fwdMemberVerb='writes to' ; fwdMemberSystem=Jira ;;
			jira-issue-update) fwdSecondFlag=--issue-key ; fwdSecondLabel='<issue-key>' ; fwdRestKind=stub ; fwdStubValues='--fields-json --update-json' ; fwdStubNoValues='--notify-users' ; fwdMemberVerb='writes to' ; fwdMemberSystem=Jira ; fwdSnapSystem=jira ; fwdSnapResourceType=issue ; fwdSnapReadHelper=AgentsToolsAtlassianJiraIssueRead ; fwdSnapRaw='--format raw' ;;
			jira-issue-transition) fwdSecondFlag=--issue-key ; fwdSecondLabel='<issue-key>' ; fwdRestKind=stub ; fwdStubValues='--to-status --fields-json --comment-adf --comment-adf-from-file' ; fwdStubNoValues='--comment-adf-from-stdin' ; fwdMemberVerb='writes to' ; fwdMemberSystem=Jira ; fwdSnapSystem=jira ; fwdSnapResourceType=issue ; fwdSnapReadHelper=AgentsToolsAtlassianJiraIssueRead ; fwdSnapRaw='--format raw' ;;
			jira-comment-add) fwdSecondFlag=--issue-key ; fwdSecondLabel='<issue-key>' ; fwdRestKind=stub ; fwdStubValues='--body-adf --body-adf-from-file' ; fwdStubNoValues='--body-adf-from-stdin' ; fwdMemberVerb='writes to' ; fwdMemberSystem=Jira ;;
			jira-issue-delete) fwdSecondFlag=--issue-key ; fwdSecondLabel='<issue-key>' ; fwdRestKind=none ; fwdMemberVerb='writes to' ; fwdMemberSystem=Jira ; fwdSnapSystem=jira ; fwdSnapResourceType=issue ; fwdSnapReadHelper=AgentsToolsAtlassianJiraIssueRead ; fwdSnapRaw='--format raw' ;;
			confluence-space-list) fwdRestKind=cursor ; fwdMemberVerb=reads ; fwdMemberSystem=Confluence ;;
			confluence-page-read) fwdSecondFlag=--page-id ; fwdSecondLabel='<page-id>' ; fwdRestKind=pageRead ; fwdMemberVerb=reads ; fwdMemberSystem=Confluence ; fwdHelper=AgentsToolsAtlassianConfluencePageRead ;;
			confluence-page-search) fwdSecondFlag=--cql ; fwdSecondLabel='<cql>' ; fwdRestKind=limit ; fwdMemberVerb=reads ; fwdMemberSystem=Confluence ;;
			confluence-comment-read) fwdSecondFlag=--page-id ; fwdSecondLabel='<page-id>' ; fwdRestKind=none ; fwdMemberVerb=reads ; fwdMemberSystem=Confluence ;;
			confluence-page-create) fwdRestKind=stub ; fwdStubValues='--space --space-id --title --parent-id --body-storage --body-storage-from-file' ; fwdStubNoValues='--body-storage-from-stdin' ; fwdMemberVerb='writes to' ; fwdMemberSystem=Confluence ;;
			confluence-page-update) fwdSecondFlag=--page-id ; fwdSecondLabel='<page-id>' ; fwdRestKind=stub ; fwdStubValues='--version --title --status --space-id --body-storage --body-storage-from-file' ; fwdStubNoValues='--body-storage-from-stdin' ; fwdMemberVerb='writes to' ; fwdMemberSystem=Confluence ; fwdSnapSystem=confluence ; fwdSnapResourceType=page ; fwdSnapReadHelper=AgentsToolsAtlassianConfluencePageRead ;;
			confluence-comment-add) fwdSecondFlag=--page-id ; fwdSecondLabel='<page-id>' ; fwdRestKind=stub ; fwdStubValues='--body-storage --body-storage-from-file --parent-comment-id' ; fwdStubNoValues='--body-storage-from-stdin' ; fwdMemberVerb='writes to' ; fwdMemberSystem=Confluence ;;
			confluence-page-delete) fwdSecondFlag=--page-id ; fwdSecondLabel='<page-id>' ; fwdRestKind=none ; fwdMemberVerb='writes to' ; fwdMemberSystem=Confluence ; fwdSnapSystem=confluence ; fwdSnapResourceType=page ; fwdSnapReadHelper=AgentsToolsAtlassianConfluencePageRead ;;
		esac
		local actingMember="${1:-}"
		shift || { printf '%s\n' "⛔ ERROR: $MDSC_CMD --$fwdOp: <team-member> missing" >&2 ; set +e ; return 1 ; }
		[ -n "$actingMember" ] || { printf '%s\n' "⛔ ERROR: $MDSC_CMD --$fwdOp: <team-member> missing" >&2 ; set +e ; return 1 ; }
		if [ -n "$fwdSecondFlag" ] ; then
			local fwdSecondValue="${1:-}"
			shift || { printf '%s\n' "⛔ ERROR: $MDSC_CMD --$fwdOp: $fwdSecondLabel missing" >&2 ; set +e ; return 1 ; }
			if [ "$fwdRestKind" = stub ] ; then
				case "$fwdSecondValue" in ''|-*) printf '%s\n' "⛔ ERROR: $MDSC_CMD --$fwdOp: $fwdSecondLabel missing" >&2 ; set +e ; return 1 ;; esac
			else
				[ -n "$fwdSecondValue" ] || { printf '%s\n' "⛔ ERROR: $MDSC_CMD --$fwdOp: $fwdSecondLabel missing" >&2 ; set +e ; return 1 ; }
			fi
		fi
		if [ "$fwdRestKind" = stub ] ; then
			AgentsToolsAssertBareName "$actingMember" "<team-member>" "$fwdOp" || { set +e ; return 1 ; }
			case "$actingMember" in
				client-*) ;;
				*)
					printf '%s\n' "⛔ ERROR: $MDSC_CMD --$fwdOp: runs only as a client-* member, and $actingMember is not one -- this family $fwdMemberVerb an external organisation's own $fwdMemberSystem under that member's own credential" >&2
					set +e ; return 1
				;;
			esac
			local fwdStubArg fwdStubTakesValue=""
			for fwdStubArg in "$@" ; do
				if [ -n "$fwdStubTakesValue" ] ; then
					fwdStubTakesValue=""
					continue
				fi
				case " $fwdStubValues " in
					*" $fwdStubArg "*)
						fwdStubTakesValue=yes
						continue
					;;
				esac
				case " $fwdStubNoValues " in
					*" $fwdStubArg "*) continue ;;
				esac
				printf '%s\n' "⛔ ERROR: $MDSC_CMD --$fwdOp: unexpected: $fwdStubArg" >&2
				set +e ; return 1
			done
		else
			local fwdNotAcceptedArgs="$actingMember"
			if [ -n "$fwdSecondFlag" ] ; then fwdNotAcceptedArgs="$actingMember $fwdSecondValue" ; fi
			case "$fwdRestKind" in
				none)
					case "$#:${1:-}" in
						0:) ;;
						*) printf '%s\n' "⛔ ERROR: $MDSC_CMD --$fwdOp: not accepted: $fwdNotAcceptedArgs $*" >&2 ; set +e ; return 1 ;;
					esac
				;;
				startAt)
					case "$#:${1:-}" in
						0:|2:--start-at) ;;
						*) printf '%s\n' "⛔ ERROR: $MDSC_CMD --$fwdOp: not accepted: $fwdNotAcceptedArgs $*" >&2 ; set +e ; return 1 ;;
					esac
				;;
				cursor)
					case "$#:${1:-}" in
						0:|2:--cursor) ;;
						*) printf '%s\n' "⛔ ERROR: $MDSC_CMD --$fwdOp: not accepted: $fwdNotAcceptedArgs $*" >&2 ; set +e ; return 1 ;;
					esac
				;;
				limit)
					case "$#:${1:-}" in
						0:|2:--limit) ;;
						*) printf '%s\n' "⛔ ERROR: $MDSC_CMD --$fwdOp: not accepted: $fwdNotAcceptedArgs $*" >&2 ; set +e ; return 1 ;;
					esac
				;;
				format)
					case "$#:${1:-}" in
						0:|2:--format) ;;
						*) printf '%s\n' "⛔ ERROR: $MDSC_CMD --$fwdOp: not accepted: $fwdNotAcceptedArgs $*" >&2 ; set +e ; return 1 ;;
					esac
				;;
				commentRead)
					case "$#:${1:-}:${3:-}" in
						0::|2:--format:|2:--start-at:|4:--format:--start-at|4:--start-at:--format) ;;
						*) printf '%s\n' "⛔ ERROR: $MDSC_CMD --$fwdOp: not accepted: $fwdNotAcceptedArgs $*" >&2 ; set +e ; return 1 ;;
					esac
				;;
				pageRead)
					case "$#:${1:-}:${3:-}" in
						0::|2:--format:|2:--version:|4:--format:--version|4:--version:--format) ;;
						*) printf '%s\n' "⛔ ERROR: $MDSC_CMD --$fwdOp: not accepted: $fwdNotAcceptedArgs $*" >&2 ; set +e ; return 1 ;;
					esac
				;;
			esac
			AgentsToolsAssertBareName "$actingMember" "<team-member>" "$fwdOp" || { set +e ; return 1 ; }
			case "$actingMember" in
				client-*) ;;
				*)
					printf '%s\n' "⛔ ERROR: $MDSC_CMD --$fwdOp: runs only as a client-* member, and $actingMember is not one -- this family $fwdMemberVerb an external organisation's own $fwdMemberSystem under that member's own credential" >&2
					set +e ; return 1
				;;
			esac
		fi
		if [ -n "$fwdSnapSystem" ] ; then
			AgentsToolsClientCommsSnapshotBeforeWrite "$actingMember" "$fwdOp" "$fwdSnapSystem" "$fwdSnapResourceType" "$fwdSecondValue" \
				"$fwdSnapReadHelper" --member "$actingMember" "$fwdSecondFlag" "$fwdSecondValue" $fwdSnapRaw || { set +e ; return 1 ; }
		fi
		local fwdInternArgs=( --member "$actingMember" --context "$fwdOp" )
		if [ -n "$fwdSecondFlag" ] ; then fwdInternArgs+=( "$fwdSecondFlag" "$fwdSecondValue" ) ; fi
		if [ "$fwdRestKind" != none ] ; then fwdInternArgs+=( "$@" ) ; fi
		local fwdOpRc=0
		if [ -n "$fwdHelper" ] ; then
			type "$fwdHelper" > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/atlassian/AgentsTools.InternOpAtlassianCall.include"
			"$fwdHelper" "${fwdInternArgs[@]}" || fwdOpRc=$?
		else
			. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/atlassian/AgentsTools.InternOpAtlassianCall.include" "--intern-op-atlassian-$fwdShort" "${fwdInternArgs[@]}" || fwdOpRc=$?
		fi
		if [ "$fwdOpRc" -ne 0 ] ; then set +e ; return "$fwdOpRc" ; fi
		return 0
	;;

	*)
		printf '%s\n' "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
