#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

## AgentsTools.InternOpCommsSlackProfileSet.include -- the operation `--intern-op-comms-slack-profile-set`, sourced by AgentsTools.MemberCommsSlackProfile.include with the operation's arguments.
		shift
		if [ "$1" = "--print-required-scopes" ] ; then
			printf '%s\n' users.profile:read users.profile:write users:read users:write dnd:read dnd:write
			return 0
		fi
		local profileMember="$1"
		shift || true
		if [ -z "$profileMember" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --slack-profile-set: <team-member> missing" >&2
			set +e ; return 1
		fi
		type AgentsToolsAssertBareName > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.BareName.include"
		AgentsToolsAssertBareName "$profileMember" "<team-member>" slack-profile-set || { set +e ; return 1 ; }
		case "$profileMember" in
			routine-*)
				## Inverted carve-out: the sibling arms exempt routine-* from the
				## skill-directory check, this one refuses it outright.
				echo "⛔ ERROR: $MDSC_CMD --slack-profile-set: a routine-* caller is REFUSED by this operation -- a routine is bot-authored by the one identity rule every Slack op here shares, and it owns no Slack account, so it has no profile, presence or do-not-disturb state to write. Nothing was changed. Name the team-member whose own account should carry this persona instead. Refused here, and with its own message, so the cause is not misreported as a missing user token." >&2
				set +e ; return 1
			;;
			*)
				if [ ! -d "$MDAT_SKILLSET_ROOT/$profileMember" ] ; then
					echo "⛔ ERROR: $MDSC_CMD --slack-profile-set: no such member skill directory: $MDAT_SKILLSET_ROOT/$profileMember" >&2
					set +e ; return 1
				fi
			;;
		esac
		local profileFieldCount=0
		local profileDisplayNameGiven="false" profileDisplayName=""
		local profileTitleGiven="false" profileTitle=""
		local profileStatusTextGiven="false" profileStatusText=""
		local profileStatusEmojiGiven="false" profileStatusEmoji=""
		local profileStatusExpiryGiven="false" profileStatusExpiry=""
		local profileEmail=""
		local profileAvatarGiven="false" profileAvatarPath=""
		local profilePresence=""
		local profileSnoozeMode="" profileSnoozeMinutes=""
		while [ $# -gt 0 ] ; do
			case "$1" in
				--display-name|--title|--status-text|--status-emoji)
					## Positional presence, not a non-empty test: `--status-text ""`
					## is how a status is cleared.
					if [ $# -lt 2 ] ; then
						echo "⛔ ERROR: $MDSC_CMD --slack-profile-set: $1 value missing" >&2
						set +e ; return 1
					fi
					case "$1" in
						--display-name)
							if [ "$profileDisplayNameGiven" = "true" ] ; then
								echo "⛔ ERROR: $MDSC_CMD --slack-profile-set: --display-name is not repeatable -- one value, one field" >&2
								set +e ; return 1
							fi
							profileDisplayNameGiven="true" ; profileDisplayName="$2"
						;;
						--title)
							if [ "$profileTitleGiven" = "true" ] ; then
								echo "⛔ ERROR: $MDSC_CMD --slack-profile-set: --title is not repeatable -- one value, one field" >&2
								set +e ; return 1
							fi
							profileTitleGiven="true" ; profileTitle="$2"
						;;
						--status-text)
							if [ "$profileStatusTextGiven" = "true" ] ; then
								echo "⛔ ERROR: $MDSC_CMD --slack-profile-set: --status-text is not repeatable -- one value, one field" >&2
								set +e ; return 1
							fi
							profileStatusTextGiven="true" ; profileStatusText="$2"
						;;
						--status-emoji)
							if [ "$profileStatusEmojiGiven" = "true" ] ; then
								echo "⛔ ERROR: $MDSC_CMD --slack-profile-set: --status-emoji is not repeatable -- one value, one field" >&2
								set +e ; return 1
							fi
							profileStatusEmojiGiven="true" ; profileStatusEmoji="$2"
						;;
					esac
					profileFieldCount=$(( profileFieldCount + 1 ))
					shift 2
				;;
				--status-expiry)
					if [ "$profileStatusExpiryGiven" = "true" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --slack-profile-set: --status-expiry is not repeatable -- one value, one field" >&2
						set +e ; return 1
					fi
					if [ -z "${2:-}" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --slack-profile-set: --status-expiry value missing" >&2
						set +e ; return 1
					fi
					if ! printf '%s\n' "$2" | LC_ALL=C grep -qE '^[0-9][0-9]*$' ; then
						echo "⛔ ERROR: $MDSC_CMD --slack-profile-set: --status-expiry: not epoch seconds: $2" >&2
						set +e ; return 1
					fi
					profileStatusExpiryGiven="true" ; profileStatusExpiry="$2"
					profileFieldCount=$(( profileFieldCount + 1 ))
					shift 2
				;;
				--email)
					if [ -n "$profileEmail" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --slack-profile-set: --email is not repeatable -- one address, one account" >&2
						set +e ; return 1
					fi
					if ! printf '%s\n' "${2:-}" | LC_ALL=C grep -qE '^[^[:space:]@]+@[^[:space:]@]+$' ; then
						echo "⛔ ERROR: $MDSC_CMD --slack-profile-set: --email is not an address: '${2:-}'. Slack requires a name before an @ and a domain after it, with no spaces, and an empty value is not one either -- this operation sets an address, it cannot clear one. Checked at parse time and not left to the API call: a malformed one would read as applied while the account kept its old one. Nothing was changed." >&2
						set +e ; return 1
					fi
					profileEmail="${2:-}"
					profileFieldCount=$(( profileFieldCount + 1 ))
					shift 2
				;;
				--presence)
					if [ -n "$profilePresence" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --slack-profile-set: --presence is not repeatable -- one presence decision" >&2
						set +e ; return 1
					fi
					case "${2:-}" in
						auto|away)
							profilePresence="$2"
						;;
						*)
							echo "⛔ ERROR: $MDSC_CMD --slack-profile-set: --presence must be 'auto' or 'away', got: ${2:-}. Slack's users.setPresence accepts those two values and no others; there is no 'active' to set, because a user reads active only while a client holds a connection." >&2
							set +e ; return 1
						;;
					esac
					profileFieldCount=$(( profileFieldCount + 1 ))
					shift 2
				;;
				--snooze)
					if [ -n "$profileSnoozeMode" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --slack-profile-set: --snooze and --snooze-end are mutually exclusive, and neither is repeatable -- one snooze decision, one spelling" >&2
						set +e ; return 1
					fi
					if [ -z "${2:-}" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --slack-profile-set: --snooze value missing" >&2
						set +e ; return 1
					fi
					if ! printf '%s\n' "$2" | LC_ALL=C grep -qE '^[0-9][0-9]*$' || [ "$2" = "0" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --slack-profile-set: --snooze requires a positive whole number of minutes, got: $2. To end a snooze instead of starting one, pass --snooze-end." >&2
						set +e ; return 1
					fi
					profileSnoozeMode="set" ; profileSnoozeMinutes="$2"
					profileFieldCount=$(( profileFieldCount + 1 ))
					shift 2
				;;
				--snooze-end)
					if [ -n "$profileSnoozeMode" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --slack-profile-set: --snooze and --snooze-end are mutually exclusive, and neither is repeatable -- one snooze decision, one spelling" >&2
						set +e ; return 1
					fi
					profileSnoozeMode="end"
					profileFieldCount=$(( profileFieldCount + 1 ))
					shift
				;;
				--avatar)
					if [ "$profileAvatarGiven" = "true" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --slack-profile-set: --avatar is not repeatable -- one image, one account" >&2
						set +e ; return 1
					fi
					if [ -z "${2:-}" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --slack-profile-set: --avatar value missing" >&2
						set +e ; return 1
					fi
					case "$2" in
						*';'*|*','*)
							echo "⛔ ERROR: $MDSC_CMD --slack-profile-set: --avatar: the path must not contain ';' or ',': $2. Those two characters are not this tool's restriction and not Slack's -- curl's own multipart value syntax reads ';' as the start of part metadata and ',' as a multi-file separator, so such a path is consumed as syntax instead of as a filename and the upload fails at transport as a generic error naming nothing. Refused here, where the cause is still visible. Nothing was changed." >&2
							set +e ; return 1
						;;
					esac
					if [ ! -f "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --slack-profile-set: --avatar: no such file: $2. Checked at parse time and not left to the upload call: with four facets in this operation, a path that does not resolve would otherwise surface only after the profile fields had already been written, leaving the persona half-configured. Nothing was changed. A directory, or a path that is not a regular file, fails here too." >&2
						set +e ; return 1
					fi
					profileAvatarGiven="true" ; profileAvatarPath="$2"
					profileFieldCount=$(( profileFieldCount + 1 ))
					shift 2
				;;
				--identity-bot)
					echo "⛔ ERROR: $MDSC_CMD --slack-profile-set: --identity-bot is REFUSED by this operation -- users.profile:write, users:write and dnd:write are user-token scopes, and a bot owns no persona whose display name, status, presence or do-not-disturb state this could set: the call would either fail outright or write some other account's state. This is not a permission that could be granted. The flag is rejected rather than accepted-and-ignored on purpose, because acting under the member's own user identity while the caller asked for the bot would be a silent identity substitution. Exactly three operations refuse --identity-bot: --slack-search-messages, --slack-profile-set and --slack-profile-get. The message, reaction and file operations accept it; the --member-comms-slack-presence-* and --member-comms-slack-socket-* operations do not take the flag at all. Nothing was changed. Re-run without the flag to act under the member's own user identity." >&2
					set +e ; return 1
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --slack-profile-set: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ "$profileFieldCount" -eq 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --slack-profile-set: at least one field is required -- pass one or more of --display-name, --title, --status-text, --status-emoji, --status-expiry, --email, --avatar, --presence, --snooze or --snooze-end. Nothing was changed. An empty string IS a value here: --status-text '' clears the status and counts as a field." >&2
			set +e ; return 1
		fi
		## Slack refuses an emptied status field unless its partner travels with it; hoisted to parse time like --avatar above.
		local profileClearing=""
		if [ "$profileStatusTextGiven" = "true" ] && [ -z "$profileStatusText" ] && [ "$profileStatusEmojiGiven" != "true" ] ; then profileClearing="--status-text ''" ; fi
		if [ "$profileStatusEmojiGiven" = "true" ] && [ -z "$profileStatusEmoji" ] && [ "$profileStatusTextGiven" != "true" ] ; then profileClearing="--status-emoji ''" ; fi
		if [ -n "$profileClearing" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --slack-profile-set: $profileClearing empties one of the two status fields while the other is not passed at all, and Slack refuses that outright -- users.profile.set answers must_clear_both_status_text_and_status_emoji unless status_text and status_emoji travel in the same request. Measured: a request carrying BOTH is accepted whatever the two values are, so pass --status-text and --status-emoji together here, both empty to clear the status. Checked at parse time and not left to the API call: this operation writes four facets, and a refusal raised by Slack would surface only after the rest of the profile had already been written, leaving the persona half-configured. Nothing was changed." >&2
			set +e ; return 1
		fi
		local profileFieldsJson="" profileEscaped=""
		if [ "$profileDisplayNameGiven" = "true" ] ; then
			profileEscaped="$( printf '%s' "$profileDisplayName" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/mcp/AgentsMcpJsonEscape.awk" )"
			profileFieldsJson="$profileFieldsJson,\"display_name\":\"$profileEscaped\""
		fi
		if [ "$profileTitleGiven" = "true" ] ; then
			profileEscaped="$( printf '%s' "$profileTitle" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/mcp/AgentsMcpJsonEscape.awk" )"
			profileFieldsJson="$profileFieldsJson,\"title\":\"$profileEscaped\""
		fi
		if [ "$profileStatusTextGiven" = "true" ] ; then
			profileEscaped="$( printf '%s' "$profileStatusText" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/mcp/AgentsMcpJsonEscape.awk" )"
			profileFieldsJson="$profileFieldsJson,\"status_text\":\"$profileEscaped\""
		fi
		if [ "$profileStatusEmojiGiven" = "true" ] ; then
			profileEscaped="$( printf '%s' "$profileStatusEmoji" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/mcp/AgentsMcpJsonEscape.awk" )"
			profileFieldsJson="$profileFieldsJson,\"status_emoji\":\"$profileEscaped\""
		fi
		if [ "$profileStatusExpiryGiven" = "true" ] ; then
			profileFieldsJson="$profileFieldsJson,\"status_expiration\":$profileStatusExpiry"
		fi
		if [ -n "$profileEmail" ] ; then
			profileEscaped="$( printf '%s' "$profileEmail" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/mcp/AgentsMcpJsonEscape.awk" )"
			profileFieldsJson="$profileFieldsJson,\"email\":\"$profileEscaped\""
		fi
		if [ -n "$profileFieldsJson" ] ; then
			profileFieldsJson="{\"profile\":{${profileFieldsJson#,}}}"
		fi
		local profileFailed=0 profileApplied=0
		local profileResponse="" profileRc=0
		if [ -n "$profileFieldsJson" ] ; then
			profileRc=0
			profileResponse="$( AgentsToolsCommsSlackProfileCall --slack-profile-set profile \
				"POST users.profile.set (acting member $profileMember)" \
				"$profileMember" --api users.profile.set --json-body "$profileFieldsJson" \
				--identity user --context "--slack-profile-set" )" || profileRc=$?
			printf '%s\n' PROFILE_SET_FACET=profile
			if [ "$profileRc" = "0" ] ; then
				printf '%s\n' PROFILE_SET_STATE=applied
				printf '%s\n' "$profileResponse"
				profileApplied=$(( profileApplied + 1 ))
			else
				printf '%s\n' PROFILE_SET_STATE=failed
				profileFailed=$(( profileFailed + 1 ))
			fi
		else
			printf '%s\n' PROFILE_SET_FACET=profile
			printf '%s\n' PROFILE_SET_STATE=not-requested
		fi
		if [ "$profileAvatarGiven" = "true" ] ; then
			profileRc=0
			profileResponse="$( AgentsToolsCommsSlackProfileCall --slack-profile-set avatar \
				"POST users.setPhoto image=$profileAvatarPath (acting member $profileMember)" \
				"$profileMember" --api users.setPhoto --upload-file "image=$profileAvatarPath" \
				--identity user --context "--slack-profile-set" )" || profileRc=$?
			printf '%s\n' PROFILE_SET_FACET=avatar
			if [ "$profileRc" = "0" ] ; then
				printf '%s\n' PROFILE_SET_STATE=applied
				printf '%s\n' "$profileResponse"
				profileApplied=$(( profileApplied + 1 ))
			else
				printf '%s\n' PROFILE_SET_STATE=failed
				profileFailed=$(( profileFailed + 1 ))
			fi
		else
			printf '%s\n' PROFILE_SET_FACET=avatar
			printf '%s\n' PROFILE_SET_STATE=not-requested
		fi
		if [ -n "$profilePresence" ] ; then
			profileRc=0
			profileResponse="$( AgentsToolsCommsSlackProfileCall --slack-profile-set presence \
				"POST users.setPresence presence=$profilePresence (acting member $profileMember)" \
				"$profileMember" --api users.setPresence --form "presence=$profilePresence" \
				--identity user --context "--slack-profile-set" )" || profileRc=$?
			printf '%s\n' PROFILE_SET_FACET=presence
			if [ "$profileRc" = "0" ] ; then
				printf '%s\n' PROFILE_SET_STATE=applied
				printf '%s\n' "$profileResponse"
				profileApplied=$(( profileApplied + 1 ))
			else
				printf '%s\n' PROFILE_SET_STATE=failed
				profileFailed=$(( profileFailed + 1 ))
			fi
		else
			printf '%s\n' PROFILE_SET_FACET=presence
			printf '%s\n' PROFILE_SET_STATE=not-requested
		fi
		case "$profileSnoozeMode" in
			set)
				profileRc=0
				profileResponse="$( AgentsToolsCommsSlackProfileCall --slack-profile-set dnd \
					"POST dnd.setSnooze num_minutes=$profileSnoozeMinutes (acting member $profileMember)" \
					"$profileMember" --api dnd.setSnooze --form "num_minutes=$profileSnoozeMinutes" \
					--identity user --context "--slack-profile-set" )" || profileRc=$?
			;;
			end)
				profileRc=0
				profileResponse="$( AgentsToolsCommsSlackProfileCall --slack-profile-set dnd \
					"POST dnd.endSnooze (acting member $profileMember)" \
					"$profileMember" --api dnd.endSnooze \
					--identity user --context "--slack-profile-set" )" || profileRc=$?
			;;
		esac
		printf '%s\n' PROFILE_SET_FACET=dnd
		if [ -z "$profileSnoozeMode" ] ; then
			printf '%s\n' PROFILE_SET_STATE=not-requested
		elif [ "$profileRc" = "0" ] ; then
			printf '%s\n' PROFILE_SET_STATE=applied
			printf '%s\n' "$profileResponse"
			profileApplied=$(( profileApplied + 1 ))
		else
			printf '%s\n' PROFILE_SET_STATE=failed
			profileFailed=$(( profileFailed + 1 ))
		fi
		echo "# $MDSC_CMD --slack-profile-set: $profileApplied facet(s) applied, $profileFailed not applied (acting member $profileMember)" >&2
		if [ "$profileFailed" != "0" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --slack-profile-set: $profileFailed facet(s) were NOT applied -- read the per-facet PROFILE_SET_STATE lines above. A non-zero exit here never means the whole call failed: the facets reported applied really were applied, nothing was rolled back, and nothing was retried under another identity." >&2
			set +e ; return 1
		fi
		return 0
