#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only
type AgentsSessionThread > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.include"
type AgentsSlackIdentityId > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/slack/AgentsTools.SlackIdentities.include"

## The prose that stood here is in the package's MAGIC.md, under "AgentsTools.InternOpCommsSlackSend.include".

type AgentsToolsCommsSlackRun > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/slack/AgentsTools.CommsSlack.include"

type AgentsToolsCommsSlackPresentationField > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/slack/AgentsTools.CommsSlackPresentation.include"

AgentsToolsCommsSlackAliasShown(){ ## name as the line shows it, alias
	type AgentsToolsAssertBareName > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.BareName.include"
	[ "$2" = "$1" ] || printf '@%s' "$2"
}
case "$1" in

	--intern-op-comms-slack-send-message)
		shift
		if [ "$1" = "--print-required-scopes" ] ; then
			printf '%s\n' chat:write users:read channels:read 'channels:join|channels:write' im:write mpim:write
			return 0
		fi
		local memberName="$1"
		shift || true
		if [ -z "$memberName" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --slack-send-message: <team-member> missing" >&2
			set +e ; return 1
		fi
		type AgentsToolsAssertBareName > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.BareName.include"
		AgentsToolsAssertBareName "$memberName" "<team-member>" slack-send-message || { set +e ; return 1 ; }
		## A routine, and a person at a console (user-<account>, F6.10, F11.6), have no skill folder: neither is a member.
		case "$memberName" in
			routine-*|user-*)
			;;
			*)
				AgentsToolsSlackMemberPresent "$memberName" --slack-send-message || { set +e ; return 1 ; }
			;;
		esac
		local target="$1"
		shift || true
		if [ -z "$target" ] && ! AgentsToolsCommsClientSide "$memberName" ; then
			type AgentsToolsCommsPrintbackSessionOwnTarget > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.CommsPrintback.include"
			## Its own refusal is the member's: a tier whose channel is absent, and the public tier, say there why.
			target="$( AgentsToolsCommsPrintbackSessionOwnTarget )" || target=""
		fi
		if [ -z "$target" ] ; then
			if AgentsToolsCommsClientSide "$memberName" ; then
				echo "⛔ ERROR: $MDSC_CMD --slack-send-message: <target> missing${MDAT_COMMS_OP:+ in $MDAT_COMMS_OP} -- on the side of the other organisation a conversation or a person is named by its id. The session thread, the default of --slack-send-message, is our own organisation's. Nothing was sent." >&2
				set +e ; return 1
			fi
			echo "⛔ ERROR: $MDSC_CMD --slack-send-message: <target> missing" >&2
			set +e ; return 1
		fi
		case "$target" in
			printback:*)
				type AgentsToolsCommsPrintbackSendMessage > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.CommsPrintback.include"
				local printbackRc=0
				AgentsToolsCommsPrintbackSendMessage "$target" "$memberName" "$@" || printbackRc=$?
				set +e ; return "$printbackRc"
			;;
		esac
		## A client: address puts this send on the side of the other organisation, for a client-*
		## member only (MDAT_COMMS_SIDE, AgentsTools.CommsSlack.include): said here, ahead of
		## everything that reads a setting or names a person.
		case "$memberName:$target" in
			client-*:client:*) local -x MDAT_COMMS_SIDE=client ;;
			*:client:*)
				echo "⛔ ERROR: $MDSC_CMD --slack-send-message: $( AgentsToolsSlackOneWayLine "$target" "$memberName" ) Nothing was sent." >&2
				set +e ; return 1
			;;
		esac
		## A team-member name, with or without :<ts>, is that member's own Slack DM where it has an account. The named aliases come first.

		## It is an address of our own organisation, so on the client side it is refused as one.
		local targetMember="${target#client:}" targetMemberId="" wakeMember=""
		targetMember="${targetMember%%:*}"
		case "$targetMember" in
			event-track|event-alert|magic-team|human-owner|session-current|session-parent|''|*[!abcdefghijklmnopqrstuvwxyz0123456789-]*) ;;
			*)
				type AgentsToolsTeamMemberDirectory > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.TeamRegistry.include"
				if AgentsToolsTeamMemberDirectory "$targetMember" > /dev/null ; then
					if AgentsToolsCommsClientSide "$memberName" ; then
						echo "⛔ ERROR: $MDSC_CMD --slack-send-message: $( AgentsToolsSlackOneWayLine "$target" "$memberName" ) Nothing was sent." >&2
						set +e ; return 1
					fi
					targetMemberId="$( AgentsToolsCommsSlackMentionUserId "$targetMember" )"
					if [ -z "$targetMemberId" ] ; then
						## A member holding a token whose account could not be read is a fault, never a member without a DM.
						type AgentsToolsConfigOption > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/settings/AgentsTools.ConfigOption.include"
						if AgentsToolsCommsOwnSettingsApply "$targetMember" && [ -n "$( AgentsToolsConfigOption "$targetMember" --select "$( AgentsToolsCommsClientKey "$targetMember" SLACK_USER_TOKEN )" 2>/dev/null )" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --slack-send-message: team member '$targetMember' holds a Slack user token but its account could not be read, so nothing was sent and its inbox was not used" >&2
							set +e ; return 1
						fi
						echo "⛔ ERROR: $MDSC_CMD --slack-send-message: NO-SLACK-DM: team member '$targetMember' has no Slack DM channel of its own" >&2
						set +e ; return 1
					fi
					## THE WAKE MARKER of the member this message is addressed to (AgentsTools.WakeMarker.include): its
					## waiting session hears of the message within a tick of the post, instead of at its next look of the
					## costly Slack source. Written only once the post succeeded, further below.
					wakeMember="$targetMember"
					target="$targetMemberId${target#"$targetMember"}"
				fi
			;;
		esac
		if [ "$target" = "magic-team" ] ; then
			local dutyTold=""
			case " $* " in *" --told "*) dutyTold="argv" ;; esac
			if [ -z "$dutyTold" ] && [ -n "${MDAT_SPAWN_SESSION_ID:-}" ] && [ -f "${MDAT_SPAWN_SANDBOX_ROOT:-}/${MDAT_SPAWN_SESSION_ID:-}.spawn.md" ] \
				&& LC_ALL=C grep -q -x 'day-first: yes' "$MDAT_SPAWN_SANDBOX_ROOT/$MDAT_SPAWN_SESSION_ID.spawn.md" 2> /dev/null \
				&& ! LC_ALL=C awk -F '\t' -v run="$MDAT_SPAWN_SESSION_ID" '$3 == "magic-team" && $NF == run { found = 1 ; exit ; } END { exit found ? 0 : 1 ; }' "$MMDAPP/.local/agents/comms-slack-send.$( date -u +%Y-%m ).log" 2> /dev/null ; then
				dutyTold="day-first"
			fi
			if [ -z "$dutyTold" ] && [ -n "${MDAT_SPAWN_SESSION_ID:-}" ] ; then
				## A CONSOLE MEMBER IS NO RUN: with no session, `magic-team` is the team channel and nothing is rerouted -- the
				## check `AgentsSlackSendIdentityCheck` measured a member's channel send arriving as the bot in the human-owner's
				## conversation, and this guard is what puts it on the channel (W2, task 2026-11-26T0605Z). A run keeps the
				## reroute below, so it still posts in its session's thread and never at the channel root.
				## The coordinator's duty-session thread comes before the human-owner's conversation: that is where it reads its runs.
				local runDuty="" runDutyThread=""
				runDuty="$( head -1 "${MMDAPP:-/nonexistent}/.local/agents/schedule/duty-session/magic-coordinator" 2> /dev/null )" || runDuty=""
				case "$runDuty" in ''|*/*|.|..) ;; *) runDutyThread="$( AgentsSessionThread "$runDuty" )" || runDutyThread="" ;; esac
				case "$runDutyThread" in [CDG][A-Z0-9]*:[0-9]*.[0-9]*) ;; *) runDutyThread="" ;; esac
				local runWhere=""
				for runWhere in session-current session-parent $runDutyThread human-owner ; do
					type DistroAgentsToolsResolveTarget > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.CommsResolveTarget.include"
					DistroAgentsToolsResolveTarget "$runWhere" "$memberName" > /dev/null 2>&1 && break
					runWhere=""
				done
				if [ -n "$runWhere" ] ; then
					target="$runWhere"
					case " $* " in *" --address-to "*) ;; *) set -- "$@" --address-to magic-coordinator ;; esac
					echo "# $MDSC_CMD --slack-send-message: a run posts in its session's thread, never at the root of the team channel: delivered to $runWhere, addressed to magic-coordinator. The channel takes a step told to post there (--told) or a work-duty's day-first greeting." >&2
				fi
			fi
		fi
		## A SESSION ADDRESS THAT CANNOT BE RESOLVED (session-current or session-parent: an opener that failed, a session with no thread)
		## falls through to the parent session's thread, the coordinator's duty-session thread, and only then the human-owner's
		## conversation with the bot, addressed to magic-coordinator: never nowhere, never the channel root.
		type DistroAgentsToolsResolveTarget > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.CommsResolveTarget.include"
		if { [ "$target" = "session-current" ] || [ "$target" = "session-parent" ] ; } && ! DistroAgentsToolsResolveTarget "$target" "$memberName" > /dev/null 2>&1 ; then
			## The coordinator's duty-session thread comes before the human-owner's conversation: that is where it reads its runs.
			local runDuty="" runDutyThread=""
			runDuty="$( head -1 "${MMDAPP:-/nonexistent}/.local/agents/schedule/duty-session/magic-coordinator" 2> /dev/null )" || runDuty=""
			case "$runDuty" in ''|*/*|.|..) ;; *) runDutyThread="$( AgentsSessionThread "$runDuty" )" || runDutyThread="" ;; esac
			case "$runDutyThread" in [CDG][A-Z0-9]*:[0-9]*.[0-9]*) ;; *) runDutyThread="" ;; esac
			local runFallback=""
			for runFallback in $( [ "$target" = session-current ] && printf 'session-parent' ) $runDutyThread human-owner ; do
				DistroAgentsToolsResolveTarget "$runFallback" "$memberName" > /dev/null 2>&1 && break
				runFallback=""
			done
			if [ -n "$runFallback" ] ; then
				target="$runFallback"
				case " $* " in *" --address-to "*) ;; *) set -- "$@" --address-to magic-coordinator ;; esac
				echo "# $MDSC_CMD --slack-send-message: this session has no thread of its own, so the post goes to $runFallback, addressed to magic-coordinator." >&2
			fi
		fi
		type AgentsToolsOwedRepliesNewest > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.OwedReplies.include" || echo "⛔ ERROR: $MDSC_CMD --slack-send-message: AgentsTools.OwedReplies.include did not load, so no owed reply is looked up" >&2
		type AgentsToolsRequestThreadInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.SessionThreads.include" || echo "⛔ ERROR: $MDSC_CMD --slack-send-message: AgentsTools.SessionThreads.include did not load, so no request thread is looked up" >&2
		## A POST TO THE HUMAN-OWNER ANSWERS IN THE THREAD OF HIS OPEN MESSAGE (his rule): the newest reply this member owes him
		## (schedule/owed/<member>), if younger than three owed-reply bounds, is the target. The request thread is no part of this step, as its person may not be him.
		## With none, the step below applies where his conversation resolves to a channel id. --told and --update-ts keep the post as written.
		## His account is magic-team's SLACK_CHANNEL_HUMAN_OWNER where that is an account id, else the mention cache. The cache is
		## emptied at each lock cycle and refilled only by a lookup, so it cannot be the only source.
		local outsideOwner=""
		type AgentsToolsConfigOption > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/settings/AgentsTools.ConfigOption.include"
		outsideOwner="$( AgentsToolsConfigOption magic-team --select SLACK_CHANNEL_HUMAN_OWNER 2> /dev/null )" || outsideOwner=""
		case "$outsideOwner" in [UW][A-Z0-9]*) ;; *) outsideOwner="$( AgentsSlackIdentityId human-owner )" ;; esac
		if [ "$target" = "human-owner" ] ; then
			case " $* " in *" --update-ts "*|*" --told "*) ;; *)
				local ownerOwed="" ownerAge="${MDAT_OWED_REPLY_SECONDS:-1800}"
				case "$ownerAge" in ''|*[!0123456789]*|0) ownerAge=1800 ;; esac
				[ -z "$outsideOwner" ] || AgentsToolsOwedRepliesNewest ownerOwed "$memberName" "" "$outsideOwner" "$(( 10#$ownerAge * 3 ))" || ownerOwed=""
				if [ -n "$ownerOwed" ] ; then
					target="$ownerOwed"
					echo "# $MDSC_CMD --slack-send-message: the human-owner asked in the thread $ownerOwed, so this message answers there." >&2
				fi
			;; esac
		fi
		AgentsToolsEmitRequestDetailHeader "$memberName" "$target"
		local resolved rc channel="" threadTs="" failoverRouting="" addressSessionId=""
		resolved="$( DistroAgentsToolsResolveTarget "$target" "$memberName" )" && rc=0 || rc=$?
		case "$rc" in
			0)
				channel="$( printf '%s\n' "$resolved" | sed -n 's/^CHANNEL=//p' )"
				## A client: marker has said its side above; Slack is given the id alone.
				channel="${channel#client:}"
				## Unit-2 forward compatibility -- "" until the Unit-3 flip.
				local targetUserId=""
				targetUserId="$( printf '%s\n' "$resolved" | sed -n 's/^USER_ID=//p' )" || targetUserId=""
				if [ -n "$targetUserId" ] ; then
					channel="$targetUserId"
				fi
				threadTs="$( printf '%s\n' "$resolved" | sed -n 's/^THREAD_TS=//p' )"
				## A SESSION ADDRESS NAMES ITS SESSION BY ID (S12.15, S12.29): the resolver read it from the session store, so the copy
				## into that session's chat file is made by the id given, never by matching thread files across workspaces.
				addressSessionId="$( printf '%s\n' "$resolved" | sed -n 's/^SESSION_ID=//p' )" || addressSessionId=""
				case "$channel" in
					printback:*)
						type AgentsToolsCommsPrintbackSendMessage > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.CommsPrintback.include"
						local resolvedPrintbackRc=0
						AgentsToolsCommsPrintbackSendMessage "$channel" "$memberName" "$@" || resolvedPrintbackRc=$?
						set +e ; return "$resolvedPrintbackRc"
					;;
				esac
			;;
			2)
				echo "⛔ ERROR: $MDSC_CMD --slack-send-message: unrecognized target: $target" >&2
				set +e ; return 1
			;;
			## A session address that names nowhere: the resolver's own line, why and what to pass instead.
			3)
				echo "⛔ ERROR: $MDSC_CMD --slack-send-message: $resolved Nothing was sent." >&2
				set +e ; return 1
			;;
			*)
				local targetKey=""
				type AgentsToolsCommsChannelSlackKey > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.CommsChannel.include"
				targetKey="$( AgentsToolsCommsChannelSlackKey "${target%%:*}" )" || targetKey=""
				if [ -n "$targetKey" ] ; then
					echo "⛔ ERROR: $MDSC_CMD --slack-send-message: could not resolve a channel for target '$target' -- check the $targetKey setting" >&2
				else
					echo "⛔ ERROR: $MDSC_CMD --slack-send-message: could not resolve a channel for target '$target' -- it names a conversation directly, so no config key backs it; its channel part is empty" >&2
				fi
				set +e ; return 1
			;;
		esac
		## A TOP-LEVEL POST WHERE A REPLY IS OWED GOES INTO THAT THREAD. The newest fresh owed reply there takes it,
		## else the thread this session was started for. The owed one comes first, as in SendMessage. --told and --update-ts keep the post as written.
		local answerWhere="" answerWhy="" answerAge="${MDAT_OWED_REPLY_SECONDS:-1800}"
		if [ -z "$threadTs" ] ; then
			case "$channel" in [CDG][A-Z0-9]*)
				case " $* " in *" --update-ts "*|*" --told "*) ;; *)
					case "$answerAge" in ''|*[!0123456789]*|0) answerAge=1800 ;; esac
					if AgentsToolsOwedRepliesNewest answerWhere "$memberName" "$channel" "" "$(( 10#$answerAge * 3 ))" ; then
						answerWhy="the person asked in the thread slack:$answerWhere"
					elif AgentsToolsRequestThreadInto answerWhere && [ "${answerWhere%%:*}" = "$channel" ] ; then
						answerWhy="this session was started for the message in the thread $answerWhere"
					else
						answerWhere=""
					fi
					if [ -n "$answerWhere" ] ; then
						threadTs="${answerWhere#*:}"
						echo "# $MDSC_CMD --slack-send-message: $answerWhy, so this message goes there. --told posts it at the top." >&2
					fi
				;; esac
			;; esac
		fi
		local outsidePerson="false" outsideParty=""
		case "$channel" in D[A-Z0-9]*)
			case "$memberName" in client-*) ;; *)
				local outsideInfo="" outsideAuthor="" outsideRead=""
				## The conversation is read under the identity that is in it: the member's own account first, the team bot's where that
				## account is not a party (the human-owner's conversation with the bot is such a one).
				local outsideIdentity
				for outsideIdentity in "" bot ; do
					outsideInfo="$( AgentsToolsCommsSlackRun --intern-op-slack-call "$memberName" --api conversations.info --resolve-target "$channel" ${outsideIdentity:+--identity "$outsideIdentity"} --context "--slack-send-message" 2> /dev/null )" || outsideInfo=""
					outsideParty="$( printf '%s\n' "$outsideInfo" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsHarnessJsonField.awk" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/slack/AgentsSlackConversationCounterparty.awk" 2> /dev/null )" || outsideParty=""
					[ -z "$outsideParty" ] || break
				done
				if [ -z "$outsideParty" ] ; then
					echo "⛔ ERROR: $MDSC_CMD --slack-send-message: whose direct conversation $channel is could not be read, so nothing is posted there: a message to a person goes under their own message, and the person must be known. Nothing was posted. NEXT: send it as the reply to their message, target <conversation>:<ts of their message>; where the person is not known, DistroAgentsContacts.fn.sh --contacted-by <their account> first; where the conversation still cannot be read, file this line to magic-coordinator with post-inquiry and do not retry." >&2
					set +e ; return 1
				fi
				if [ "$outsideParty" != "$outsideOwner" ] && ! AgentsSlackIdentityOwn "$outsideParty" ; then
					type AgentsToolsContactAssertKnown > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/contacts/AgentsTools.InternContact.include"
					AgentsToolsContactAssertKnown "$memberName" --tool slack-send-message --target "$outsideParty" || { set +e ; return 1 ; }
					outsidePerson="true"
				fi
			;; esac
		;; esac
		local format="markdown" fromStdin="false" identityAsBot="false" textGroup=""
		local textArgs stdinContent
		local bodySourceKind="argv"
		## The text version of a caller-supplied blocks payload. Not a
		## transcription of their blocks -- what the message SAYS, in text.
		local messageText="" messageTextGiven="false"
		## Addressees, repeatable. WHO THE MESSAGE IS FOR -- deliberately not
		## the operation's own target, which is the conversation it goes TO.
		local addressToList="" wakeAddressed=""
		## A reply into a thread also shown in the conversation itself (Slack's
		## reply_broadcast), so it is seen where it would otherwise sit buried.
		local replyBroadcast="false" updateTs=""
		local sendTracking=""
		[ "${MDAT_SEND_FLOOR:-}" = "hold" ] || sendTracking=",\"tracking\":\"tooling\""
		local sendOrigin="" sendOriginRecord="" sendOriginLine="" sendOriginN=0 sendStackFrame=""
		if [ -n "${MDAT_SPAWN_SESSION_ID:-}" ] ; then
			## Its own sandbox record: a spawned run keeps one there. A session minted by a root harness keeps none, so its routine is
			## the one its mint wrote in the session's own folder. Both are one file at a known path: a send is a call path, and it
			## never walks the store to find a record.
			sendOriginRecord="${MDAT_SPAWN_SANDBOX_ROOT:+$MDAT_SPAWN_SANDBOX_ROOT/}$MDAT_SPAWN_SESSION_ID.spawn.md"
			[ -f "$sendOriginRecord" ] || sendOriginRecord=""
			[ -z "$sendOriginRecord" ] || while IFS= read -r sendOriginLine && [ "$sendOriginN" -lt 60 ] ; do
				sendOriginN=$(( sendOriginN + 1 ))
				## THE FRAME IN FORCE, NEVER THE LINE THE START WROTE (S6.27): `routine:` names the routine the run started on, and a switch
				## records itself in the stack alone, so a run that replaced its routine kept posting under the one it left. The last
				## `current` frame is the routine the run is on now, and it ends the read.
				case "$sendOriginLine" in
					'routine: '*) [ -n "$sendOrigin" ] || sendOrigin="${sendOriginLine#routine: }" ;;
					'routine-stack: '*':current'*) sendStackFrame="${sendOriginLine#routine-stack: }" ; sendStackFrame="${sendStackFrame%:current}" ; break ;;
				esac
			done < "$sendOriginRecord"
			if [ -z "$sendOrigin" ] ; then
				type AgentsToolsRootHarnessRoutineInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/routine/AgentsTools.RoutineRootHarness.include"
				AgentsToolsRootHarnessRoutineInto sendOrigin "$MDAT_SPAWN_SESSION_ID" "${MMDAPP:-}" || sendOrigin=""
			fi
			[ -z "$sendStackFrame" ] || sendOrigin="$sendStackFrame"
			sendOrigin="${sendOrigin%.routine.md}" ; sendOrigin="${sendOrigin#*.}"
			case "$sendOrigin" in *[!A-Za-z0-9._-]*) sendOrigin="" ;; esac
		else
			sendOrigin="console"
		fi
		[ -z "$sendOrigin" ] || sendTracking="$sendTracking,\"origin\":\"$sendOrigin\""
		local sendMetadata="{\"event_type\":\"magic_sender\",\"event_payload\":{\"sender\":\"$memberName\"$sendTracking}}"
		local defaultMetadata="$sendMetadata" sendAgain="" ownerNow=""
		while [ $# -gt 0 ] ; do
			case "$1" in
				--identity-bot)
					identityAsBot="true" ; shift
				;;
				## The routine step told this work-duty to post to the team channel (the default above reads it from argv).
				--told)
					shift
				;;
				## A repeat of a message sent to the same place within the half hour, meant as such.
				--again)
					sendAgain="true" ; shift
				;;
				--metadata)
					if [ $# -lt 2 ] || [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --slack-send-message: --metadata value missing (a JSON object: {\"event_type\":...,\"event_payload\":{...}})" >&2
						set +e ; return 1
					fi
					type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
					if ! printf '%s' "$2" | DistroAgentsTools --intern-validate-json ; then
						echo "⛔ ERROR: $MDSC_CMD --slack-send-message: --metadata is not valid JSON" >&2
						set +e ; return 1
					fi
					case "$2" in
						*\\*)
							echo "⛔ ERROR: $MDSC_CMD --slack-send-message: --metadata holds a backslash escape, and none is taken there: a key or a value written with one cannot be checked. Nothing was sent." >&2
							set +e ; return 1
						;;
					esac
					if printf '%s' "$2" | LC_ALL=C tr -d ' \t\r\n' | LC_ALL=C sed "s/\"sender\":\"$memberName\"//g" | LC_ALL=C grep -q '"sender":' ; then
						echo "⛔ ERROR: $MDSC_CMD --slack-send-message: --metadata names another sender than $memberName, the member this send acts as. A message carries its own member as its sender, and no other. Nothing was sent. NEXT: send it again with --metadata naming $memberName as its sender, or without --metadata." >&2
						set +e ; return 1
					fi
					sendMetadata="$2" ; shift 2
				;;
				--reply-broadcast)
					replyBroadcast="true" ; shift
				;;
				## Edits one message the acting identity posted, in place, instead of posting a new
				## one (chat.update): the same text and blocks this send would post, with the same
				## author line and under the same floor, so an edit shows what a send would.
				--update-ts)
					case "${2:-}" in
						''|*[!0123456789.]*)
							echo "⛔ ERROR: $MDSC_CMD --slack-send-message: --update-ts needs the ts of the message to edit, got: ${2:-<none>}" >&2
							set +e ; return 1
						;;
					esac
					updateTs="$2" ; shift 2
				;;
				--message-from-stdin|--from-stdin)
					fromStdin="true" ; bodySourceKind="stdin" ; shift
				;;
				--address-to)
					if [ $# -lt 2 ] || [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --slack-send-message: --address-to value missing" >&2
						set +e ; return 1
					fi
					addressToList="$addressToList $2" ; shift 2
				;;
				--message-text)
					if [ $# -lt 2 ] ; then
						echo "⛔ ERROR: $MDSC_CMD --slack-send-message: --message-text value missing" >&2
						set +e ; return 1
					fi
					messageText="$2" ; messageTextGiven="true" ; shift 2
				;;
				--message-text-from-file)
					if [ $# -lt 2 ] ; then
						echo "⛔ ERROR: $MDSC_CMD --slack-send-message: --message-text-from-file value missing" >&2
						set +e ; return 1
					fi
					if [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --slack-send-message: --message-text-from-file invalid: ${2:-<no value>}" >&2
						set +e ; return 1
					fi
					if [ ! -f "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --slack-send-message: --message-text-from-file: file not found: $2" >&2
						set +e ; return 1
					fi
					messageText="$( cat "$2" )" ; messageTextGiven="true" ; shift 2
				;;
				--from-file)
					if [ $# -lt 2 ] ; then
						echo "⛔ ERROR: $MDSC_CMD --slack-send-message: --from-file value missing" >&2
						set +e ; return 1
					fi
					if [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --slack-send-message: --from-file invalid: ${2:-<no value>}" >&2
						set +e ; return 1
					fi
					if [ ! -f "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --slack-send-message: --from-file: file not found: $2" >&2
						set +e ; return 1
					fi
					stdinContent="$( cat "$2" )"
					fromStdin="file"
					bodySourceKind="file"
					shift 2
				;;
				--format)
					if [ $# -lt 2 ] ; then
						echo "⛔ ERROR: $MDSC_CMD --slack-send-message: --format value missing" >&2
						set +e ; return 1
					fi
					format="$2" ; shift 2
				;;
				## The floor applies with no argument at all. This names the shape an
				## explicit exception takes, never which default a caller gets.
				--text-group)
					if [ $# -lt 2 ] ; then
						echo "⛔ ERROR: $MDSC_CMD --slack-send-message: --text-group value missing -- report, brief or relay, and message is what every send carries without it" >&2
						set +e ; return 1
					fi
					textGroup="$2" ; shift 2
				;;
				--*)
					echo "⛔ ERROR: $MDSC_CMD --slack-send-message: unrecognized option: $1 (if you need literal text starting with '--', use --from-stdin/--from-file instead of trailing argv)" >&2
					set +e ; return 1
				;;
				*)
					textArgs="$textArgs $1" ; shift
				;;
			esac
		done
		local rawText blocksJson sourceText
		if [ "$fromStdin" = "file" ] && [ -n "$textArgs" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --slack-send-message: --from-file given alongside trailing body argv -- use one or the other, not both" >&2
			set +e ; return 1
		fi
		if [ "$fromStdin" = "true" ] && [ -n "$textArgs" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --slack-send-message: --from-stdin given alongside trailing body argv -- use one or the other, not both" >&2
			set +e ; return 1
		fi
		if [ "$fromStdin" != "false" ] ; then
			[ "$fromStdin" = "file" ] || [ -n "$stdinContent" ] || stdinContent="$( cat )"
			sourceText="$stdinContent"
		else
			sourceText="${textArgs# }"
		fi
		local slackFormatRegistry="markdown|converter|body|argv stdin file
blocks|verbatim|caller|stdin file"
		local formatEntry formatValidSet formatBlocksGen formatTextGen formatBodySources
		formatValidSet="$( printf '%s\n' "$slackFormatRegistry" | LC_ALL=C awk -F'|' 'NF { printf "%s%s", sep, $1 ; sep="|" ; }' )"
		formatEntry="$( printf '%s\n' "$slackFormatRegistry" | LC_ALL=C awk -F'|' -v want="$format" '$1 == want { print ; exit ; }' )"
		if [ -z "$formatEntry" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --slack-send-message: unrecognized --format '$format' -- accepted: $formatValidSet" >&2
			set +e ; return 1
		fi
		formatBlocksGen="$( printf '%s\n' "$formatEntry" | LC_ALL=C awk -F'|' '{ print $2 ; }' )"
		formatTextGen="$( printf '%s\n' "$formatEntry" | LC_ALL=C awk -F'|' '{ print $3 ; }' )"
		formatBodySources="$( printf '%s\n' "$formatEntry" | LC_ALL=C awk -F'|' '{ print $4 ; }' )"
		case " $formatBodySources " in
			*" $bodySourceKind "*) ;;
			*)
				echo "⛔ ERROR: $MDSC_CMD --slack-send-message: --format $format does not accept a body from '$bodySourceKind' -- accepted for this format: $formatBodySources (use --from-stdin or --from-file <path>)" >&2
				set +e ; return 1
			;;
		esac
		if [ -z "$sourceText" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --slack-send-message: no text/blocks content given" >&2
			set +e ; return 1
		fi
		## The member's own token is read by the side of this send (AgentsToolsCommsOwnSettingsApply).
		local sendIdentity="bot" memberUserToken=""
		if AgentsToolsCommsClientSide "$memberName" ; then
			memberUserToken="${CLIENT_SLACK_USER_TOKEN:-}"
		else
			memberUserToken="${SLACK_USER_TOKEN:-}"
		fi
		type AgentsToolsConfigOption > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/settings/AgentsTools.ConfigOption.include"
		[ -n "$memberUserToken" ] || memberUserToken="$( AgentsToolsCommsOwnSettingsApply "$memberName" && AgentsToolsConfigOption "$memberName" --select "$( AgentsToolsCommsClientKey "$memberName" SLACK_USER_TOKEN )" 2>/dev/null || true )"
		## A routine's send is the team bot's, and so is a person's at a console: neither holds an account of its own.
		local routineAuthored="false"
		case "$memberName" in
			routine-*|user-*) routineAuthored="true" ;;
		esac
		if [ "$identityAsBot" = "true" ] ; then
			sendIdentity="bot"
		elif [ "$routineAuthored" = "true" ] ; then
			sendIdentity="bot"
		elif [ -n "$memberUserToken" ] ; then
			sendIdentity="user"
		fi
		if [ "$sendIdentity" = "user" ] && [ -z "$threadTs" ] && [ -n "$outsideOwner" ] && { [ "$channel" = "$outsideOwner" ] || [ "$outsideParty" = "$outsideOwner" ] ; } ; then
			sendIdentity="bot"
			echo "# $MDSC_CMD --slack-send-message: a message to the human-owner goes under the team bot, into his conversation with the bot, never under a member's own account into the persona's direct message with him: sent as the bot." >&2
		fi
		local presentExternal="false" earlyBotResolved="false" earlyBotTokenLine=""
		case "$memberName" in
			client-*)
				if [ "$sendIdentity" = "user" ] ; then
					[ -z "$memberUserToken" ] || presentExternal="true"
				else
					earlyBotTokenLine="$( AgentsToolsResolveSlackBotToken "$memberName" )" || earlyBotTokenLine=""
					earlyBotResolved="true"
					case "$earlyBotTokenLine" in
						"member-bot-token "*) presentExternal="true" ;;
					esac
				fi
			;;
		esac
		local externalMark="" externalName="" externalAlias="" externalFirst externalFamily externalPres externalMissing=""
		if [ "$presentExternal" = "true" ] ; then
			externalPres="$( AgentsToolsCommsSlackMemberPresentation "$memberName" )" || externalPres=""
			## The persona member's name is the registries include's, and its own reader sources it in the subshell
			## of a command substitution only: a shell that has read neither has no name to fall back on.
			type AgentsToolsRegistryWrite > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.Registries.include"
			type AgentsToolsMemberInvited > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.MemberWorkspace.include"
			[ -n "$externalPres" ] || ! AgentsToolsMemberInvited "$memberName" || externalPres="$( AgentsToolsCommsSlackMemberPresentation "$registryPersonaMember" )" || externalPres=""
			externalMark="$( AgentsToolsCommsSlackPresentationField 1 "$externalPres" )"
			externalFirst="$( AgentsToolsCommsSlackPresentationField 2 "$externalPres" )"
			externalFamily="$( AgentsToolsCommsSlackPresentationField 3 "$externalPres" )"
			externalAlias="$( AgentsToolsCommsSlackPresentationField 4 "$externalPres" )"
			[ -n "$externalFirst" ] || externalMissing="first-name"
			[ -n "$externalFamily" ] || externalMissing="$externalMissing${externalMissing:+, }family-name"
			[ -n "$externalAlias" ] || externalMissing="$externalMissing${externalMissing:+, }alias"
			if [ -n "$externalMissing" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --slack-send-message: the external presentation needs the persona row in the team-members-names registry (--make-agents-indices): missing $externalMissing; nothing was sent" >&2
				set +e ; return 1
			fi
			externalName="$externalFirst $externalFamily"
			## The default metadata names the member; an external payload carries no internal identifier.
			[ "$sendMetadata" != "$defaultMetadata" ] || sendMetadata=""
		fi
		local slackMentionMap="" mentionName mentionId
		for mentionName in $( printf '%s\n' "$sourceText" | LC_ALL=C awk '
			{
				rest = $0 ;
				while ( ( at = index( rest, "@" ) ) > 0 ) {
					rest = substr( rest, at + 1 ) ;
					name = rest ;
					sub( /[[:space:]].*$/, "", name ) ;
					if ( name ~ /^[A-Za-z0-9._-]+$/ && name !~ /^[-.]/ && !( name in seen ) ) {
						seen[name] = 1 ;
						print name ;
					}
					rest = substr( rest, length( name ) + 1 ) ;
				}
			}
		' ) ; do
			type AgentsToolsTeamMemberDirectory > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.TeamRegistry.include"
			AgentsToolsTeamMemberDirectory "$mentionName" > /dev/null || continue
			## A client has its only Slack account in another workspace, so its id renders wrongly here: it is mapped only as the sender itself in an external send.
			case "$mentionName" in
				client-*) { [ "$presentExternal" = "true" ] && [ "$mentionName" = "$memberName" ] ; } || continue ;;
			esac
			mentionId="$( AgentsToolsCommsSlackMentionUserId "$mentionName" )" || mentionId=""
			[ -n "$mentionId" ] || continue
			slackMentionMap="$slackMentionMap${slackMentionMap:+;}$mentionName=$mentionId"
		done
		local headerOpen="[{\"type\":\"rich_text\",\"elements\":[{\"type\":\"rich_text_section\",\"elements\":["
		## Who the message is from. Built always -- the identity swap below
		## needs it too -- but inserted only where the Slack account shown
		## is not the member's own: a bot post.
		local fromPres fromMark="" fromName="$memberName" fromAlias="$memberName" fromElems=""
		if [ "$presentExternal" = "true" ] ; then
			fromMark="$externalMark" ; fromName="$externalName" ; fromAlias="$externalAlias"
		elif [ "$routineAuthored" != "true" ] ; then
			## Inside our own team a member is shown as its team sees it: its icon, never none,
			## and its in-team alias (AgentsToolsCommsSlackMemberTeamPresentation). A routine is
			## no member, and keeps its name alone.
			fromPres="$( AgentsToolsCommsSlackMemberTeamPresentation "$memberName" sender )"
			fromMark="${fromPres%%$'\t'*}" ; fromAlias="${fromPres#*$'\t'}"
			[ -n "$fromAlias" ] || fromAlias="$memberName"
		fi
		## Its alias stands beside its name only where it is another word (AgentsToolsCommsSlackAliasShown).
		local fromShown
		fromShown="$( AgentsToolsCommsSlackAliasShown "$fromName" "$fromAlias" )"
		## The origin routine follows the alias in parentheses, outside the poster's own session thread and inside the team only
		## (sendOrigin above): `@dispatchr (supervision-session)`, the form the owner named. The header parsers accept the
		## parenthesised tail after an alias and after a bare name (AgentsDismissalMatch.awk, AgentsEscalationVerdict.awk).
		if [ -n "${sendOrigin:-}" ] && [ "$target" != "session-current" ] && [ "$presentExternal" != "true" ] ; then
			fromShown="${fromShown:+$fromShown }($sendOrigin)"
		fi
		local fromText="${fromMark:+$fromMark }*_${fromName}_* ${fromShown:+$fromShown }"
		case "$fromMark" in
			"")	;;
			:*:)	fromElems="{\"type\":\"emoji\",\"name\":\"${fromMark//:/}\"},{\"type\":\"text\",\"text\":\" \"}," ;;
			*)	fromElems="{\"type\":\"text\",\"text\":\"$fromMark \"}," ;;
		esac
		fromElems="$fromElems{\"type\":\"text\",\"text\":\"$fromName\",\"style\":{\"bold\":true,\"italic\":true}},{\"type\":\"text\",\"text\":\" ${fromShown:+$fromShown }\"},"
		local addressInferred=""
		## A REPLY ANSWERS A PERSON, AND IS ADDRESSED TO THEM: in any conversation and any thread, the author of the message at the target ts, read from
		## Slack, is the reply's addressee, whether the caller named anyone or not. Only a
		## person counts: a bot's message, the team's own accounts (the mention cache) and the posting account leave the addressee to the caller.
		local replyAuthor=""
		case "$channel" in U*) ;; *)
			if [ -n "$threadTs" ] ; then
				local rpArgs rpInfo="" rpSelf=""
				rpArgs=( "$memberName" --api conversations.replies --resolve-target "$channel" --form "ts=$threadTs" --form "oldest=$threadTs" --form inclusive=true --form limit=1 )
				[ "$sendIdentity" != "bot" ] || rpArgs+=( --identity bot )
				rpArgs+=( --context "--slack-send-message" )
				local rpErr="" rpErrFile=""
				rpErrFile="$( mktemp "$MMDAPP/.local/temp/mdat-reply-parent.XXXXXX" 2> /dev/null )" || rpErrFile=""
				rpInfo="$( AgentsToolsCommsSlackRun --intern-op-slack-call ${rpArgs[@]+"${rpArgs[@]}"} 2> "${rpErrFile:-/dev/null}" )" || rpInfo=""
				[ -z "$rpErrFile" ] || { rpErr="$( cat "$rpErrFile" 2> /dev/null )" ; rm -f "$rpErrFile" ; }
				local rpMessage="" rpSelectRc=0
				rpMessage="$( printf '%s\n' "$rpInfo" | LC_ALL=C awk -v wantTs="$threadTs" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsHarnessJsonField.awk" \
					-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/slack/AgentsSlackMessageSelect.awk" 2> /dev/null )" || { rpSelectRc=$? ; rpMessage="" ; }
				## A REPLY GOES UNDER A MESSAGE OF THIS VERY CONVERSATION, OR NOWHERE: Slack answered and holds no message of that ts here (selector
				## rc 1, or thread_not_found), so a post would land at the top level of this conversation, a channel's root for a reply meant for a thread elsewhere.
				## Refused before anything is posted. A read that failed (rc 2, no access) says nothing either way and stops nothing.
				case "$rpErr" in *'"error":"thread_not_found"'*) rpSelectRc=1 ;; esac
				if [ "$rpSelectRc" = 1 ] && [ -z "$updateTs" ] ; then
					echo "⛔ ERROR: $MDSC_CMD --slack-send-message: the thread $channel:$threadTs is no thread of this conversation: Slack holds no message of that ts here, and a reply under it would be posted at the top level of $channel. Nothing was sent. NEXT: reply in the conversation the message was read from, with the <conversation>:<ts> it was read as (its Wait or read line names both); never move a ts to another conversation.${answerWhy:+ The thread was taken because $answerWhy. Pass --told to post at the top instead.}" >&2
					set +e ; return 1
				fi
				replyAuthor="$( printf '%s\n' "$rpMessage" | LC_ALL=C awk -v path=messages.0.user -v optional=1 -v dialect=slack \
					-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsHarnessJsonField.awk" 2> /dev/null )" || replyAuthor=""
				case "$replyAuthor" in U[A-Z0-9][A-Z0-9]*) ;; *) replyAuthor="" ;; esac
				## A message a bot posted (the team's own bot, an integration) answers to no person: the addressee stays the caller's.
				! printf '%s' "$rpMessage" | LC_ALL=C grep -q -E '"bot_id":"|"subtype":"bot_message"' || replyAuthor=""
				## Nor does one Slack itself posted to: USLACKBOT is Slack's own account, in no member's row and no contact's.
				case "$replyAuthor" in USLACKBOT) replyAuthor="" ;; esac
				## A message the sending member posted itself answers to no person either: its own account is never a contact to check.
				[ -z "$replyAuthor" ] || [ "$replyAuthor" != "$( AgentsToolsCommsSlackMentionUserId "$memberName" 2> /dev/null )" ] || replyAuthor=""
				## Nor does one the team bot's own account posted (a session root, a console's message): the bot is the team, never a contact.
				if [ -n "$replyAuthor" ] ; then
					local replyBotId=""
					replyBotId="$( AgentsToolsCommsSlackRun --intern-op-slack-call "$memberName" --api auth.test --identity bot --context "--slack-send-message" 2> /dev/null \
						| LC_ALL=C awk -v path=user_id -v optional=1 -v dialect=slack -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsHarnessJsonField.awk" 2> /dev/null )" || replyBotId=""
					[ -z "$replyBotId" ] || [ "$replyAuthor" != "$replyBotId" ] || replyAuthor=""
				fi
				if [ -n "$replyAuthor" ] && AgentsSlackIdentityKnown "$replyAuthor" && [ "$replyAuthor" != "$( AgentsSlackIdentityId human-owner )" ] ; then
					replyAuthor=""
				fi
				## A POST OF THE TOOLING'S OWN NEVER INFERS THE HUMAN-OWNER: it names him only where its caller does, as an ask of his level does.
				[ "${MDAT_SEND_FLOOR:-}" = "hold" ] || [ "$replyAuthor" != "$outsideOwner" ] || replyAuthor=""
			fi
		;; esac
		[ -z "${addressToList// /}" ] || [ "$replyAuthor" != "$outsideOwner" ] || replyAuthor=""
		if [ -n "$replyAuthor" ] ; then
			[ -z "${addressToList// /}" ] || [ "${addressToList// /}" = "$replyAuthor" ] || echo "# $MDSC_CMD --slack-send-message: this reply answers $replyAuthor's message ($channel:$threadTs), so it is addressed to $replyAuthor, not to${addressToList}." >&2
			addressToList=" $replyAuthor"
			if [ "$replyAuthor" != "$outsideOwner" ] ; then
				type AgentsToolsContactAssertKnown > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/contacts/AgentsTools.InternContact.include"
				AgentsToolsContactAssertKnown "$memberName" --tool slack-send-message --target "$replyAuthor" || { set +e ; return 1 ; }
			fi
		fi
		## A STATUS POST NAMES NOBODY (2026-11-10: duty status notices in the human-owner's conversation carried his mention): a send to
		## session-current or session-parent is the run's own record, read by whoever reads the session, so no other party is inferred
		## as its addressee. A caller that wants a person named names them.
		if [ -z "$addressToList" ] && [ "$target" != "session-current" ] && [ "$target" != "session-parent" ] ; then
			local dmParties="" dmInfo="" dmIsMpim="" dmSelfId="" dmParty="" dmIndex=0 dmKept=""
			local dmArgs
			case "$channel" in
				U[A-Z0-9][A-Z0-9]*)
					dmParties=" $channel"
				;;
				*)
					dmArgs=( "$memberName" --api conversations.info --resolve-target "$channel" )
					[ "$sendIdentity" != "bot" ] || dmArgs+=( --identity bot )
					dmArgs+=( --context "--slack-send-message" )
					dmInfo="$( AgentsToolsCommsSlackRun --intern-op-slack-call ${dmArgs[@]+"${dmArgs[@]}"} )" || dmInfo=""
					dmParty="$( printf '%s\n' "$dmInfo" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsHarnessJsonField.awk" \
					-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/slack/AgentsSlackConversationCounterparty.awk" )" || dmParty=""
					if [ -n "$dmParty" ] ; then
						dmParties=" $dmParty"
					else
						dmIsMpim="$( printf '%s\n' "$dmInfo" | LC_ALL=C awk -v path=channel.is_mpim -v optional=1 -v dialect=slack -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsHarnessJsonField.awk" )" || dmIsMpim=""
					fi
					if [ "$dmIsMpim" = "true" ] ; then
						dmArgs=( "$memberName" --api conversations.members --form "channel=$channel" --form limit=100 )
						[ "$sendIdentity" != "bot" ] || dmArgs+=( --identity bot )
						dmArgs+=( --context "--slack-send-message" )
						dmInfo="$( AgentsToolsCommsSlackRun --intern-op-slack-call ${dmArgs[@]+"${dmArgs[@]}"} )" || dmInfo=""
						while : ; do
							dmParty="$( printf '%s\n' "$dmInfo" | LC_ALL=C awk -v path="members.$dmIndex" -v optional=1 -v dialect=slack -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsHarnessJsonField.awk" )" || dmParty=""
							[ -n "$dmParty" ] || break
							dmParties="$dmParties $dmParty"
							dmIndex=$(( dmIndex + 1 ))
						done
					fi
				;;
			esac
			if [ -n "$dmParties" ] ; then
				dmArgs=( "$memberName" --api auth.test )
				[ "$sendIdentity" != "bot" ] || dmArgs+=( --identity bot )
				dmArgs+=( --context "--slack-send-message" )
				dmInfo="$( AgentsToolsCommsSlackRun --intern-op-slack-call ${dmArgs[@]+"${dmArgs[@]}"} )" || dmInfo=""
				dmSelfId="$( printf '%s\n' "$dmInfo" | LC_ALL=C awk -v path=user_id -v optional=1 -v dialect=slack -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsHarnessJsonField.awk" )" || dmSelfId=""
				if [ -z "$dmSelfId" ] ; then
					echo "# $MDSC_CMD --slack-send-message: auth.test did not answer with the posting account's user id, so the addressee list for $channel is NOT known to exclude the sender -- it is sent as inferred rather than failing the send over a header field." >&2
				else
					for dmParty in $dmParties ; do
						[ "$dmParty" = "$dmSelfId" ] || dmKept="$dmKept $dmParty"
					done
					dmParties="$dmKept"
				fi
			fi
			## Nor is he ever the other party of his conversation, for any post, whatever its target: an ask names him, and a readback answers his own message.
			dmKept=""
			for dmParty in $dmParties ; do [ "$dmParty" = "$outsideOwner" ] || dmKept="$dmKept $dmParty" ; done
			dmParties="$dmKept"
			addressToList="$dmParties"
			addressInferred="true"
		fi
		if [ -n "$addressToList" ] && [ "$addressInferred" != "true" ] ; then
			case "$channel" in
				D[A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9]*)
					local imArgs imInfo imParty imWho
					imArgs=( "$memberName" --api conversations.info --resolve-target "$channel" )
					[ "$sendIdentity" != "bot" ] || imArgs+=( --identity bot )
					imArgs+=( --context "--slack-send-message" )
					imInfo="$( AgentsToolsCommsSlackRun --intern-op-slack-call ${imArgs[@]+"${imArgs[@]}"} )" || imInfo=""
					imParty="$( printf '%s\n' "$imInfo" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsHarnessJsonField.awk" \
						-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/slack/AgentsSlackConversationCounterparty.awk" )" || imParty=""
					if [ -n "$imParty" ] && [ "$imParty" != "$outsideOwner" ] ; then
						local imKept="" imSwapped=""
						for imWho in $addressToList ; do
							case "$imWho" in
								U[A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9]*)
									if [ "$imWho" != "$imParty" ] ; then
										imSwapped="$imSwapped $imWho" ; imWho="$imParty"
									fi
								;;
							esac
							case " $imKept " in *" $imWho "*) ;; *) imKept="$imKept $imWho" ;; esac
						done
						addressToList="${imKept# }"
						[ -z "$imSwapped" ] || echo "# $MDSC_CMD --slack-send-message: the direct message $channel is with $imParty, so the message is addressed to that party in place of${imSwapped}." >&2
					fi
				;;
			esac
		fi
		## Who the message is for.
		local addressedText="" addressedElems=""
		local addressedIds="" addressedMembers=""
		local addrWho addrMarks addrMark addrName addrAlias addrUserId addrHandleText addrHandleElems
		for addrWho in $addressToList ; do
			## A client: addressee is a person or a conversation of the other organisation, by id,
			## and is named in a send on that side only.
			case "$addrWho" in
				client:*)
					if ! AgentsToolsCommsClientSide "$memberName" ; then
						echo "⛔ ERROR: $MDSC_CMD --slack-send-message: --address-to '$addrWho': a client: addressee is of the other organisation, and this send is on our own organisation's side. Address it in a send to a client: target, or in a --client-* operation. Nothing was sent." >&2
						set +e ; return 1
					fi
					addrWho="${addrWho#client:}"
				;;
			esac
			if [ -n "$addressedText" ] ; then
				addressedText="$addressedText; "
				addressedElems="$addressedElems{\"type\":\"text\",\"text\":\"; \"},"
			fi
			local addrKind=""
			case "$addrWho" in
				*[!ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789]*) ;;
				U????????*) addrKind="account" ;;
				C????????*|D????????*|G????????*) addrKind="place" ;;
				U??*) [ "$addressInferred" != "true" ] || addrKind="account" ;;
				C??*|D??*|G??*) [ "$addressInferred" != "true" ] || addrKind="place" ;;
			esac
			case "$addrKind" in
				account|place)
					if [ "$addressInferred" != "true" ] && [ "$addrWho" != "$channel" ] && [ "$addrWho" != "$replyAuthor" ] ; then
						type AgentsToolsContactAssertKnown > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/contacts/AgentsTools.InternContact.include"
						AgentsToolsContactAssertKnown "$memberName" --tool slack-send-message --target "$addrWho" || { set +e ; return 1 ; }
					fi
				;;
			esac
			case "$addrKind:$addrWho" in
				account:*)
					## A real Slack account: the structured element in blocks,
					## the escape form in text. Different forms, same field.
					addressedText="$addressedText<@$addrWho>"
					addressedIds="$addressedIds$addrWho "
					addressedElems="$addressedElems{\"type\":\"user\",\"user_id\":\"$addrWho\"},"
				;;
				place:*)
					addressedText="$addressedText<#$addrWho>"
					addressedElems="$addressedElems{\"type\":\"channel\",\"channel_id\":\"$addrWho\"},"
				;;
				*:@here|*:@channel)
					## Said by the caller, never defaulted: the one way a send pings everyone in the place.
					addressedText="$addressedText<!${addrWho#@}>"
					addressedElems="$addressedElems{\"type\":\"broadcast\",\"range\":\"${addrWho#@}\"},"
				;;
				*@*)
					echo "⛔ ERROR: $MDSC_CMD --slack-send-message: --address-to '$addrWho': an email addressee is a declared direction that is not built yet. Pass a team member name, a Slack user id, or a conversation id." >&2
					set +e ; return 1
				;;
				*)
					## A team member, by its name. The name reaches the payload as a JSON string, so
					## it is held to the same bare-name shape as the sender's own. A word that is
					## neither a member nor an id names nobody: refused in one line that says so.
					type AgentsToolsTeamMemberDirectory > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.TeamRegistry.include"
					## A CONTACT BY ITS ID: a word that is no team member but a contact's id is that person's Slack account, read from the record.
					## A record holding no Slack id, or more than one, is refused and says so: the person is never guessed.
					if AgentsToolsAssertBareName "$addrWho" "--address-to" slack-send-message 2> /dev/null && ! AgentsToolsTeamMemberDirectory "$addrWho" > /dev/null 2>&1 ; then
						local addrRecord="" addrIds=""
						addrRecord="$( "$BASH" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsContacts.fn.sh" --contact-record "$addrWho" 2> /dev/null < /dev/null )" || addrRecord=""
						if [ -n "$addrRecord" ] ; then
							addrIds="$( printf '%s\n' "$addrRecord" | LC_ALL=C sed -n 's/^slack-id: //p' | LC_ALL=C tr ', ' '\n\n' | LC_ALL=C sed -n 's/^[^:]*:\(U[A-Z0-9]\{8,\}\)$/\1/p' | LC_ALL=C sort -u )"
							case "$addrIds" in
								U*[!A-Z0-9]*|"")
									echo "⛔ ERROR: $MDSC_CMD --slack-send-message: --address-to '$addrWho': the contact record holds ${addrIds:+more than one Slack id}${addrIds:-no Slack id}, so the person cannot be addressed here. Nothing was sent. NEXT: a reply needs no --address-to, it goes to the author of the message it answers -- send it again without it. A new message: take the account from the message they wrote (its user, or user_record in --slack-read), and address that account; DistroAgentsContacts.fn.sh --contacted-by <that account> records it where they are an organisation contact." >&2
									set +e ; return 1
								;;
							esac
							addressedText="$addressedText<@$addrIds>"
							addressedIds="$addressedIds$addrIds "
							addressedElems="$addressedElems{\"type\":\"user\",\"user_id\":\"$addrIds\"},"
							continue
						fi
					fi
					if ! AgentsToolsAssertBareName "$addrWho" "--address-to" slack-send-message 2> /dev/null || ! AgentsToolsTeamMemberDirectory "$addrWho" > /dev/null ; then
						echo "⛔ ERROR: $MDSC_CMD --slack-send-message: --address-to '$addrWho': no such team member and no contact of that id -- expected a team member the tooling holds, or a contact id the store holds. The word is no Slack id either: an account is U and a conversation C, D or G, then upper-case letters and digits only, nine characters or more in all. Nothing was sent. NEXT: a reply needs no --address-to, it goes to the author of the message it answers -- send it again without it. A person: address their account as it stands on their message (its user, or user_record in --slack-read), never a name; DistroAgentsContacts.fn.sh --find-contact <word> shows whether a contact is meant." >&2
						set +e ; return 1
					fi
					## Inside our own team an addressee is shown as a sender is (AgentsToolsCommsSlackMemberTeamPresentation); a member with no row reads as its name.
					## In a client's presentation to the other organisation it is read from its row as it stands, and a client addressee is settled below.
					addrName="$addrWho"
					if [ "$presentExternal" = "true" ] ; then
						addrMarks="$( AgentsToolsCommsSlackMemberPresentation "$addrWho" )" || addrMarks=""
						addrMark="$( AgentsToolsCommsSlackPresentationField 1 "$addrMarks" )" ; addrAlias="$( AgentsToolsCommsSlackPresentationField 4 "$addrMarks" )"
					else
						addrMarks="$( AgentsToolsCommsSlackMemberTeamPresentation "$addrWho" addressee )"
						addrMark="${addrMarks%%$'\t'*}" ; addrAlias="${addrMarks#*$'\t'}"
					fi
					[ -n "$addrAlias" ] || addrAlias="$addrWho"
					case "$addrWho" in
						client-*)
							addrUserId=""
							if [ "$presentExternal" = "true" ] ; then
								[ "$addrWho" != "$memberName" ] || addrUserId="$( AgentsToolsCommsSlackMentionUserId "$addrWho" )" || addrUserId=""
								if [ -n "$( AgentsToolsCommsSlackPresentationField 2 "$addrMarks" )" ] && [ -n "$( AgentsToolsCommsSlackPresentationField 3 "$addrMarks" )" ] && [ -n "$( AgentsToolsCommsSlackPresentationField 4 "$addrMarks" )" ] ; then
									addrName="$( AgentsToolsCommsSlackPresentationField 2 "$addrMarks" ) $( AgentsToolsCommsSlackPresentationField 3 "$addrMarks" )"
								else
									addrMark="$externalMark" ; addrName="$externalName" ; addrAlias="$externalAlias"
								fi
							fi
						;;
						*)
							addrUserId="$( AgentsToolsCommsSlackMentionUserId "$addrWho" )" || addrUserId=""
						;;
					esac
					if [ -n "$addrUserId" ] ; then
						addrHandleText="<@$addrUserId>"
						addressedIds="$addressedIds$addrUserId "
						addrHandleElems="{\"type\":\"text\",\"text\":\" \"},{\"type\":\"user\",\"user_id\":\"$addrUserId\"},"
					else
						## A member with no account of its own: named by its member name among those
						## whose answer counts (SENT_MESSAGE_ADDRESSEE_MEMBERS), where a reader tells its
						## reply by the sender recorded on it. Never a client: its account is elsewhere.
						case "$addrWho" in client-*) ;; *) addressedMembers="$addressedMembers$addrWho " ;; esac
						## Its alias, where that is another word than its name (AgentsToolsCommsSlackAliasShown).
						addrHandleText="$( AgentsToolsCommsSlackAliasShown "$addrName" "$addrAlias" )"
						addrHandleElems=""
						[ -z "$addrHandleText" ] || addrHandleElems="{\"type\":\"text\",\"text\":\" $addrHandleText\"},"
					fi
					addressedText="$addressedText${addrMark:+$addrMark }*_${addrName}_*${addrHandleText:+ $addrHandleText}"
					case "$addrMark" in
						"")	;;
						:*:)	addressedElems="$addressedElems{\"type\":\"emoji\",\"name\":\"${addrMark//:/}\"},{\"type\":\"text\",\"text\":\" \"}," ;;
						*)	addressedElems="$addressedElems{\"type\":\"text\",\"text\":\"$addrMark \"}," ;;
					esac
					addressedElems="$addressedElems{\"type\":\"text\",\"text\":\"$addrName\",\"style\":{\"bold\":true,\"italic\":true}},$addrHandleElems"
				;;
			esac
		done
		if [ -z "$addressToList" ] ; then
			addressedText="this conversation"
			addressedElems="{\"type\":\"text\",\"text\":\"this conversation\"},"
		fi
		## ---- blocks generator ----
		case "$formatBlocksGen" in
			converter)
				blocksJson="$( printf '%s\n' "$sourceText" | LC_ALL=C awk -v mentionMap="$slackMentionMap" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/slack/AgentsSlackBlocksBuild.awk" )"
			;;
			verbatim)
				blocksJson="$sourceText"
			;;
		esac
		## ---- text generator ----
		case "$formatTextGen" in
			body)
				rawText="$sourceText"
			;;
			caller)
				if [ "$messageTextGiven" = "true" ] ; then
					rawText="$messageText"
				else
					rawText="$( printf '%s' "$sourceText" | python3 "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/slack/AgentsSlackBlocksTextVersion.py" )"
					if [ -z "$rawText" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --slack-send-message: --format $format: could not generate a text version from these blocks, and none was supplied. Pass --message-text <text> or --message-text-from-file <path> -- what the message SAYS, in plain text, not a transcription of the blocks." >&2
						set +e ; return 1
					fi
				fi
			;;
		esac
		if [ -n "$blocksJson" ] ; then
			type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
			if ! printf '%s' "$blocksJson" | DistroAgentsTools --intern-validate-json ; then
				echo "⛔ ERROR: $MDSC_CMD --slack-send-message: --format $format content failed validate-json (see above)" >&2
				set +e ; return 1
			fi
			local blocksTrimmed
			blocksTrimmed="$( printf '%s' "$blocksJson" | LC_ALL=C awk 'BEGIN{RS="\004" ; } { gsub(/^[ \t\r\n]+/, ""); gsub(/[ \t\r\n]+$/, ""); printf "%s", $0 ; }' )"
			case "$blocksTrimmed" in
				'['*']')
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --slack-send-message: --format $format content is valid JSON but not a bare array (must start with '[' and end with ']')" >&2
					set +e ; return 1
				;;
			esac
		fi
		## What the session chat file records of this message (F9.1): the body as it is, before the header Slack shows is put on it.
		local chatBody="$rawText"
		if LC_ALL=C grep -q -E '(^|[^@<A-Z0-9])[UW][A-Z0-9]{8,}([^A-Z0-9>]|$)' <<< "$rawText" ; then
			local bareId bareSaid bareRow bareIds
			bareIds="$( printf '%s\n' "$rawText" | LC_ALL=C grep -o -E '(^|[^@<A-Z0-9])[UW][A-Z0-9]{8,}([^A-Z0-9>]|$)' | LC_ALL=C grep -o -E '[UW][A-Z0-9]{8,}' | sort -u )"
			for bareId in $bareIds ; do
				bareSaid=""
				bareRow="$( "$BASH" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsContacts.fn.sh" --find-contact "$bareId" 2> /dev/null | LC_ALL=C awk -F '\t' '$1 == "contact" { print ; exit ; }' )" || bareRow=""
				if [ -n "$bareRow" ] ; then
					bareSaid="$( printf '%s\n' "$bareRow" | LC_ALL=C awk -F '\t' '{ printf "%s%s", $3, ( $4 != "" && $4 != "-" ? ", " $4 : "" ) ; }' )"
				fi
				[ -n "$bareSaid" ] || bareSaid="an account with no record"
				rawText="$( printf '%s\n' "$rawText" | LC_ALL=C awk -v id="$bareId" -v said="$bareSaid" '
					{
						out = "" ; s = $0
						while ( ( at = index( s, id ) ) > 0 ) {
							before = substr( s, 1, at - 1 ) ; after = substr( s, at + length( id ) )
							pre = ( at > 1 ? substr( s, at - 1, 1 ) : "" ) ; post = substr( after, 1, 1 )
							if ( pre ~ /[@<A-Z0-9]/ || post ~ /[A-Z0-9>]/ ) { out = out before id ; s = after ; continue ; }
							out = out before said ; s = after
						}
						print out s
					}' )"
				echo "# $MDSC_CMD --slack-send-message: the account id $bareId in the body is said as '$bareSaid'." >&2
			done
		fi
		rawText="→ $addressedText.${rawText:+$'\n'$rawText}"
		if [ -n "$blocksJson" ] ; then
			local headerBlock="$headerOpen{\"type\":\"text\",\"text\":\"→ \"},$addressedElems{\"type\":\"text\",\"text\":\".\"}]}]}]"
			if [ "$blocksJson" != "[]" ] ; then
				blocksJson="${headerBlock%"]"},${blocksJson#"["}"
			else
				blocksJson="$headerBlock"
			fi
		fi
		rawText="$fromText$rawText"
		[ -z "$blocksJson" ] || blocksJson="$headerOpen$fromElems${blocksJson#"$headerOpen"}"
		if [ -z "$rawText" ] && [ -z "$blocksJson" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --slack-send-message: no text/blocks content given" >&2
			set +e ; return 1
		fi
		if [ "$presentExternal" = "true" ] ; then
			type AgentsToolsContactAssertKnown > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/contacts/AgentsTools.InternContact.include"
			AgentsToolsContactAssertKnown "$memberName" \
				--tool slack-send-message --target "$channel" \
				--message "$rawText" || { set +e ; return 1 ; }
		fi
		if [ -n "$blocksJson" ] ; then
			local blocksProblems blocksProblemsRc=0
			blocksProblems="$( printf '%s' "$blocksJson" | python3 "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/slack/AgentsBlockKitValidate.py" )" || blocksProblemsRc=$?
			if [ "$blocksProblemsRc" != "0" ] || [ -n "$blocksProblems" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --slack-send-message: these blocks are not a payload Slack accepts, so nothing was sent (validator rc=$blocksProblemsRc):" >&2
				printf '%s\n' "$blocksProblems" >&2
				set +e ; return 1
			fi
		fi
		local escapedText
		escapedText="$( printf '%s' "$rawText" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/mcp/AgentsMcpJsonEscape.awk" )"
		local payload="{\"channel\":\"$channel\",\"text\":\"$escapedText\""
		## A new post goes to chat.postMessage. An update (--update-ts) names the message it
		## edits and goes to chat.update, with none of what only a new post takes.
		local sendApi="chat.postMessage"
		if [ -n "$updateTs" ] ; then
			sendApi="chat.update"
			payload="$payload,\"ts\":\"$updateTs\""
		else
			[ -z "$threadTs" ] || payload="$payload,\"thread_ts\":\"$threadTs\""
			[ -z "$threadTs" ] || [ "$replyBroadcast" != "true" ] || payload="$payload,\"reply_broadcast\":true"
		fi
		[ -z "$blocksJson" ] || payload="$payload,\"blocks\":$blocksJson"
		[ -z "$sendMetadata" ] || [ -n "$updateTs" ] || payload="$payload,\"metadata\":$sendMetadata"
		payload="$payload}"
		local tokenLabel
		if [ "$sendIdentity" = "user" ] ; then
			tokenLabel="$( AgentsToolsCommsClientKey "$memberName" SLACK_USER_TOKEN )"
		else
			tokenLabel="$( AgentsToolsCommsClientKey "$memberName" SLACK_BOT_TOKEN )"
		fi
		echo "# $MDSC_CMD --slack-send-message: POST https://slack.com/api/$sendApi using ${sendIdentity} token for $memberName -H 'Authorization: Bearer \$$tokenLabel' -H 'Content-type: application/json' -d '$payload'" >&2
		local token botTokenSource=""
		if [ "$sendIdentity" = "user" ] ; then
			token="$memberUserToken"
		else
			local botTokenLine=""
			if [ "$earlyBotResolved" = "true" ] ; then
				botTokenLine="$earlyBotTokenLine"
			else
				botTokenLine="$( AgentsToolsResolveSlackBotToken "$memberName" )" || botTokenLine=""
			fi
			read -r botTokenSource token <<< "$botTokenLine"
		fi
		if [ -z "$token" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --slack-send-message: no usable Slack token configured for $memberName (member SLACK_USER_TOKEN, the member's own SLACK_BOT_TOKEN, or the team's own SLACK_BOT_TOKEN in magic-team scope)$( AgentsToolsSlackSideNote "$memberName" ) NEXT: this is the setup, not the message -- do not retry; file this line to magic-coordinator with post-inquiry, and carry on with work that needs no Slack." >&2
			set +e ; return 1
		fi
		## HIS WORDS NEVER GO TO A CHANNEL: a body that carries the human-owner's quoted words, the verbatim marker a
		## relay of his answer wears, is sent to a direct conversation alone (a D… id, or a person's U… or W… id, which posts into the direct conversation). A channel, public or private, is
		## read by people his words were not typed for. There is no override: a ruling goes to a channel in the sender's own words.
		case "${messageText:-$sourceText}" in
			*"Human-owner verbatim"*|*"human-owner verbatim"*)
				case "$channel" in
					D*|U*|W*) ;;
					*)
						echo "⛔ ERROR: $MDSC_CMD --slack-send-message: the message quotes the human-owner (Human-owner verbatim) and $channel is a channel, not a direct conversation: his words never go to a channel. A relay of his answer goes to the asker's DM; a ruling for a channel is said in your own words. Nothing was posted." >&2
						set +e ; return 1
					;;
				esac
			;;
		esac
		## NO TALK OF HIM IN A CHANNEL: a member's own message that names the human-owner, what he said, wrote or asked,
		## goes to a direct conversation alone (a D… id, or a person's U… or W… id). A channel is for the work's state and decision, never for who said what and how. There is
		## no override: the message is said again without him. A send of the tooling's own (MDAT_SEND_FLOOR not `hold`) is not looked at.
		if [ "${MDAT_SEND_FLOOR:-}" = "hold" ] ; then
			case "$channel" in
				D*|U*|W*) ;;
				*)
					if printf '%s' "${messageText:-$sourceText}" | LC_ALL=C grep -q -i -E 'human[- ]owner|\<he (wrote|said|asked|ruled|told|answered)\>|\<his (ruling|word|words|answer|order)\>' ; then
						echo "⛔ ERROR: $MDSC_CMD --slack-send-message: the message talks of the human-owner (who said, wrote or asked what) and $channel is a channel, not a direct conversation: a channel carries the work's state and the decision, never who said what. Say the state or the decision without him, and send it again. Nothing was posted." >&2
						set +e ; return 1
					fi
				;;
			esac
		fi
		## A member's own post to its session thread never tags the human-owner: the tag subscribes him to every later post there. An ask and a readback go their own way.
		## The session thread is the one the post resolved to: a raw <conversation>:<ts> of that thread is the same post as session-current.
		if [ "${MDAT_SEND_FLOOR:-}" = "hold" ] ; then
			## His account as this send read it above (outsideOwner): the setting first, then the cache, which a mention lookup may have reset since.
			local ownerWhere ownerResolved
			case " $addressToList " in
				*" human-owner "*|*" ${outsideOwner:-human-owner} "*)
					for ownerWhere in session-current session-parent ; do
						ownerResolved="$( DistroAgentsToolsResolveTarget "$ownerWhere" "$memberName" 2> /dev/null )" || continue
						[ "$( LC_ALL=C sed -n 's/^CHANNEL=//p' <<< "$ownerResolved" ):$( LC_ALL=C sed -n 's/^THREAD_TS=//p' <<< "$ownerResolved" )" = "$channel:$threadTs" ] || continue
						echo "⛔ ERROR: $MDSC_CMD --slack-send-message: a post to the session thread is addressed to the human-owner, and that tag subscribes him to every later post there. Address it to magic-coordinator; ask him with an ask tool, or read back his own message in reply to it. Nothing was posted." >&2
						set +e ; return 1
					done
				;;
			esac
		fi
		if [ "$format" != "blocks" ] ; then
			local floorGating="none" floorText="$sourceText" floorRc=0
			[ "${MDAT_SEND_FLOOR:-}" != "hold" ] || floorGating="word-cap semicolon paragraph-gate"
			[ -z "${MDAT_SEND_PROSE_FILE:-}" ] || [ ! -f "$MDAT_SEND_PROSE_FILE" ] || floorText="$( cat "$MDAT_SEND_PROSE_FILE" )"
			type AgentsToolsOutputStyleRefusal > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.OutputStyle.include"
			[ "${MDAT_SEND_FLOOR:-}" != "hold" ] || printf '%s' "$floorText" | AgentsToolsOutputStyleRetiredMarker || { floorRc=$? ; set +e ; return "$floorRc" ; }
			printf '%s' "$floorText" | AgentsToolsOutputStyleRefusal "$memberName" "$textGroup" "$target" "$botTokenSource" "$floorGating" || { floorRc=$? ; set +e ; return "$floorRc" ; }
		fi
		if [ "$textGroup" = "relay" ] ; then
			type AgentsToolsApplyReportFaults > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.ApplyReport.include"
			local relayApplyFaults="" relayApplyRc=0
			relayApplyFaults="$( printf '%s\n' "${messageText:-$sourceText}" | AgentsToolsApplyReportFaults )" || relayApplyRc=$?
			if [ "$relayApplyRc" != 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --slack-send-message: this relay says a file was applied, and it does not give that file its place path and its read-back. Nothing was posted. A line names the file as <place>:<path>, a registered place name, a colon and a path relative to that place, and a read-back (cmp against the staged file, or its hash). What is missing:" >&2
				printf '%s\n' "$relayApplyFaults" >&2
				set +e ; return 1
			fi
		fi
		local sentBody="${messageText:-$sourceText}"
		if [ -z "$sendAgain" ] && [ -n "${MDAT_SPAWN_SESSION_ID:-}" ] && [ -n "$sentBody" ] ; then
			local sentRecent="" sentKey sentAt sentTo sentText sentSum sentNow
			AgentsSessionSentRecentInto sentRecent "$MDAT_SPAWN_SESSION_ID"
			sentSum="$( printf '%s' "$sentBody" | LC_ALL=C cksum )" ; sentSum="${sentSum%% *}"
			sentKey="${channel}:${threadTs}"
			sentNow="${ownerNow:-$( date +%s )}"
			if [ -n "$sentRecent" ] ; then
				while IFS=$'\t' read -r sentAt sentTo sentText ; do
					[ "$sentTo" = "$sentKey" ] && [ "$sentText" = "$sentSum" ] || continue
					case "$sentAt" in ''|*[!0-9]*) continue ;; esac
					if [ $(( sentNow - sentAt )) -lt 1800 ] ; then
						echo "⛔ ERROR: $MDSC_CMD --slack-send-message: the same message was sent to $sentKey $(( ( sentNow - sentAt ) / 60 )) minutes ago: a repeat is a loop, not a correction. Say the new thing, or pass --again where the repeat is meant. Nothing was posted." >&2
						set +e ; return 1
					fi
				done <<< "$sentRecent"
			fi
			AgentsSessionSentRecentAdd "$MDAT_SPAWN_SESSION_ID" "$sentNow" "$sentKey" "$sentSum"
		fi
		## Token on curl's stdin, never argv -- keeps it out of ps. Reassigned
		## in place at the identity swap below, as the header file was rewritten.
		local authHeader="Authorization: Bearer $token"
		local sendLogDir="$MMDAPP/.local/agents"
		local sendLog=""
		AgentsToolsSlackSendLogMigrate(){ ## once: split the pre-monthly comms-slack-send.log by month
			local migOld="$sendLogDir/comms-slack-send.log" migLock="$sendLogDir/comms-slack-send.migrate.lock" migMonth
			[ -f "$migOld" ] || return 0
			mkdir "$migLock" 2>/dev/null || return 0
			## Only when no monthly file exists yet for any month the old file holds.
			for migMonth in $( LC_ALL=C awk -F'\t' '$1 ~ /^[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T/ { m = substr($1, 1, 4) "-" substr($1, 5, 2) ; if (!(m in seen)) { seen[m] = 1 ; print m ; } ; }' "$migOld" ) ; do
				[ ! -e "$sendLogDir/comms-slack-send.$migMonth.log" ] || { rmdir "$migLock" 2>/dev/null ; return 0 ; }
			done
			## A line whose time is unreadable stays with the month of the line before it,
			## or of the first readable line when it leads the file.
			LC_ALL=C awk -F'\t' -v dir="$sendLogDir" '
				$1 ~ /^[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T/ { m = substr($1, 1, 4) "-" substr($1, 5, 2) ; }
				m == "" { held[++h] = $0 ; next ; }
				{ f = dir "/comms-slack-send." m ".log" ; for (i = 1 ; i <= h ; i++) print held[i] >> f ; h = 0 ; print >> f ; }
			' "$migOld" && mv -f "$migOld" "$migOld.migrated"
			rmdir "$migLock" 2>/dev/null
			return 0
		}
		AgentsToolsSlackSendLogLine(){ ## ok|failed, reason
			local logReason logStamp logSession
			logReason="$( printf '%s' "$2" | LC_ALL=C tr -c 'A-Za-z0-9_.:=/ -' '_' )"
			logStamp="$( date -u +%Y%m%dT%H%M%SZ )"
			logSession="$( printf '%s' "${harnessSessionId:-${MDAT_SPAWN_SESSION_ID:-${CLAUDE_CODE_SESSION_ID:-}}}" | LC_ALL=C tr '\t\n\r' '___' )"
			sendLog="$sendLogDir/comms-slack-send.${logStamp:0:4}-${logStamp:4:2}.log"
			{ mkdir -p "$sendLogDir" && AgentsToolsSlackSendLogMigrate && printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$logStamp" "$memberName" "$target" "$channel" "$sendIdentity" "$1" "$logReason" "${logSession:--}" >> "$sendLog" ; } 2>/dev/null \
				|| echo "⚠️ WARNING: $MDSC_CMD --slack-send-message: could not append this send's outcome to $sendLog" >&2
		}
		AgentsToolsSlackSendErrorCode(){ ## Slack's error code from $response, alone
			printf '%s' "$response" | LC_ALL=C sed -n 's/.*"error":"\([a-z_]*\)".*/\1/p' | head -n 1
		}
		AgentsToolsSlackSendChatKeep(){ ## retry|unknown|refused, why
			[ -n "$chatRecord" ] || return 0
			## A send on the side of the other organisation presents the member under that side's names, with that side's own settings:
			## the writer reads none of them, so it posts none of those again.
			if [ "$1" = "retry" ] && AgentsToolsCommsClientSide "$memberName" ; then
				set -- refused "a send on the side of the other organisation is not posted again by the writer, which does not read that side's settings"
			fi
			if [ "$1" = "retry" ] ; then
				local keepOut=""
				type AgentsToolsCommsCacheOutboxAppend > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.CommsCache.include"
				AgentsToolsCommsCacheSlackDir "$memberName" "$( [ "$sendIdentity" != "bot" ] || printf true )" "$channel" "$threadTs" 2> /dev/null || :
				keepOut="${agentsCommsCacheDir:-}"
				if [ -n "$keepOut" ] && [ -n "${channel:-}" ] \
					&& AgentsToolsCommsCacheOutboxAppend "$keepOut" "$chatKey" "$chatNo" "$memberName" "$sendIdentity" "$sendApi" "$payload" "" "$postLocalId" ; then
					return 0
				fi
			fi
			type AgentsToolsSessionCommsOutboxKeep > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionComms.include"
			AgentsToolsSessionCommsOutboxKeep "$chatKey" "$chatNo" "$1" "$memberName" "$sendIdentity" "$sendApi" "$payload" "$2" 2> /dev/null || :
			return 0
		}
		local authUserId=""
		if [ "$sendIdentity" = "user" ] ; then
			local authResp="" authUserIdRc=0 authCache="$MMDAPP/.local/cache/comms/slack/.user-id-$memberName.txt" authCacheAt="" authCacheId="" authNow
			## The member's own user id is kept a day (it never changes for a member): a send then makes no auth.test round trip.
			## A post whose message.user differs drops it, below.
			authNow="$( date +%s )"
			[ ! -f "$authCache" ] || { read -r authCacheAt authCacheId ; } 2> /dev/null < "$authCache" || authCacheAt=""
			case "$authCacheAt:$authCacheId" in
				[0-9]*:U[A-Z0-9]*) [ $(( authNow - authCacheAt )) -lt 86400 ] && authUserId="$authCacheId" ;;
			esac
			if [ -z "$authUserId" ] ; then
			authResp="$( curl -sS --connect-timeout 10 --max-time 120 https://slack.com/api/auth.test -H @- <<< "$authHeader" 2>&1 )"
			authUserId="$( printf '%s\n' "$authResp" | LC_ALL=C awk -v path=user_id -v dialect=slack -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsHarnessJsonField.awk" )" || authUserIdRc=$?
			case "$authUserIdRc:$authUserId" in
				0:U[A-Z0-9]*) { mkdir -p "${authCache%/*}" && authTmp="$( mktemp "$authCache.XXXXXX" )" && printf '%s %s\n' "$authNow" "$authUserId" > "$authTmp" && mv -f "$authTmp" "$authCache" ; } 2> /dev/null || : ;;
			esac
			fi
			if [ "$authUserIdRc" != "0" ] || [ -z "$authUserId" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --slack-send-message: could not confirm auth.test user_id for $memberName SLACK_USER_TOKEN (user_id reader rc=$authUserIdRc)" >&2
				echo "# Response: $authResp" >&2
				AgentsToolsSlackSendLogLine failed "not posted: auth.test user_id not confirmed"
				set +e ; return 1
			fi
		fi
		## RECORDED FIRST, POSTED AFTER (F9.1): the message goes into the chat file of the run's session before Slack is
		## called, and takes its ts and its thread once Slack has taken it. An edit changes a message already there and
		## records nothing; a call with no session records nothing. Quiet, and never a reason for a send to fail.
		## `MDAT_CHAT_RECORD=none` keeps a send out of that file: the detour's private part is recorded on the private
		## conversation's own record alone, and the session keeps the pointer line instead.
		local chatRecord="" chatKey="" chatNo=""
		if [ -z "$updateTs" ] && [ "${MDAT_CHAT_RECORD:-own}" != "none" ] ; then
			type AgentsToolsSessionChatSend > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionChat.include"
			chatRecord="$( AgentsToolsSessionChatSend "$memberName" "$addressToList" "$chatBody" 2> /dev/null )" || chatRecord=""
			chatKey="${chatRecord%% *}" ; chatNo="${chatRecord##* }"
		fi
		## STORED ONCE, AT POST TIME (S1 item 11): before Slack is called, the message our tooling posts is a line of the cache with a
		## local id of its own, whether it goes now or waits in an outbox. Its ts is recorded against that id once Slack answers.
		## THE STORE'S OWN FOLDER IS KEPT: the link's resolve uses the ts Slack answered, the store's uses threadTs, so they differ.
		local postLocalId="" postStoreDir=""
		if [ -z "$updateTs" ] && [ -n "${channel:-}" ] ; then
			type AgentsToolsCommsCachePostStore > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.CommsCache.include"
			AgentsToolsCommsCacheSlackDir "$memberName" "$( [ "$sendIdentity" = "bot" ] && printf true || printf false )" "$channel" "${threadTs:-}" 2> /dev/null || agentsCommsCacheDir=""
			postStoreDir="${agentsCommsCacheDir:-}"
			[ -z "${agentsCommsCacheDir:-}" ] || postLocalId="$( AgentsToolsCommsCachePostStore "$agentsCommsCacheDir" "$memberName" "$chatBody" "${threadTs:+$channel:$threadTs}" "$( [ "$sendIdentity" = "bot" ] && printf true || printf false )" 2> /dev/null )" || postLocalId=""
		fi
		## THE RECEIVING SESSION'S CHAT FILE IS ITS PRIMARY CHANNEL (S12.15, AgentsToolsSessionChatDeliverCopy): a message into the thread
		## of another session is recorded in that session's file too, before Slack is called, so a report or a DISMISSED addressed to a
		## member there reaches its run whatever Slack lets that run read. Our own organisation's threads only, and never an edit.
		local chatCopies=""
		if [ -z "$updateTs" ] && [ -n "${threadTs:-}" ] && [ -n "${channel:-}" ] && ! AgentsToolsCommsClientSide "$memberName" ; then
			type AgentsToolsSessionChatDeliverCopy > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionChatCopies.include"
			! type AgentsToolsSessionChatDeliverCopy > /dev/null 2>&1 \
				|| chatCopies="$( AgentsToolsSessionChatDeliverCopy "${MDAT_SESSION_ID:-${harnessSessionId:-${MDAT_SPAWN_SESSION_ID:-${CLAUDE_CODE_SESSION_ID:-}}}}" "$memberName" "$addressToList" "$channel:$threadTs" "$chatBody" "${addressSessionId:-}" 2> /dev/null )" || chatCopies=""
		fi
		## THE SESSION THREAD IS ASYNC (), for a caller that asks (MDAT_SEND_ASYNC=true, the SendMessage tool): a post

		## to the run's own session thread, recorded above, goes to the session's outbox while the comms reader runs, and the call
		## returns at once. The reader posts it and stamps its ts in the chat file, which every reader of the session reads.
		if [ "${MDAT_SEND_ASYNC:-}" = "true" ] && [ -n "$chatRecord" ] && [ -z "$updateTs" ] && [ -n "${threadTs:-}" ] ; then
			local asyncOwn="" asyncLock="" asyncPid=""
			asyncOwn="$( AgentsToolsSessionChatThread "$chatKey" 2> /dev/null )" || asyncOwn=""
			if [ -L "$MMDAPP/.local/agents/comms/lock" ] ; then
				asyncLock="$( readlink "$MMDAPP/.local/agents/comms/lock" 2> /dev/null )" || asyncLock=""
			else
				asyncLock="$( cat "$MMDAPP/.local/agents/comms/lock" 2> /dev/null )" || asyncLock=""
			fi
			asyncPid="${asyncLock%% *}"
			case "$asyncPid" in ''|*[!0-9]*) asyncPid="" ;; esac
			## The thread of this host's own session, or of another session of this host whose chat file took the copy above: both are posts the
			## chat files already carry, so Slack's copy of them is queued. Any other thread is a person's, and is posted before the call returns.
			if { [ "$asyncOwn" = "$channel:$threadTs" ] || [ -n "$chatCopies" ] ; } && [ -n "$asyncPid" ] && kill -0 "$asyncPid" 2> /dev/null ; then
				AgentsToolsSessionChatStamp "$chatKey" "$chatNo" - "$channel:$threadTs" 2> /dev/null || :
				type AgentsToolsSessionChatCopiesKeep > /dev/null 2>&1 || [ -z "$chatCopies" ] || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionChatCopies.include"
				[ -z "$chatCopies" ] || AgentsToolsSessionChatCopiesKeep "$chatKey" "$chatNo" "$chatCopies" 2> /dev/null || :
				## Into the outbox of the session thread's channel in the comms cache (S21.13), which the comms reader pushes in order;
				## the session's own outbox where that cannot take it, or for the other organisation's side, which the writer refuses.
				type AgentsToolsCommsCacheOutboxAppend > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.CommsCache.include"
				if AgentsToolsCommsClientSide "$memberName" || ! type AgentsToolsCommsCacheOutboxAppend > /dev/null 2>&1 \
					|| ! AgentsToolsCommsCacheSlackDir "$memberName" "$( [ "$sendIdentity" = "bot" ] && printf true || printf false )" "$channel" "$threadTs" \
					|| ! AgentsToolsCommsCacheOutboxAppend "$agentsCommsCacheDir" "$chatKey" "$chatNo" "$memberName" "$sendIdentity" "$sendApi" "$payload" "" "$postLocalId" ; then
					AgentsToolsSlackSendChatKeep retry "queued for the comms reader: an async post to the session thread"
				fi
				printf '{"ok":true,"queued":true,"channel":"%s","message":{"thread_ts":"%s"}}\n' "$channel" "$threadTs"
				echo "SENT_MESSAGE_CHANNEL=$channel" >&2
				echo "SENT_MESSAGE_TS=" >&2
				echo "SENT_MESSAGE_THREAD_TS=$threadTs" >&2
				## The reply the member owed here is answered (AgentsTools.OwedReplies.include).
				type AgentsToolsOwedRepliesClear > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.OwedReplies.include"
				type AgentsToolsOwedRepliesClear > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.OwedReplies.include"
				AgentsToolsOwedRepliesClear "$memberName" slack "$channel" "$threadTs"
				echo "SENT_MESSAGE_LOCAL=$chatKey:$chatNo" >&2
				echo "SENT_MESSAGE_ADDRESSEES=${addressedIds% }" >&2
				[ -z "$addressedMembers" ] || echo "SENT_MESSAGE_ADDRESSEE_MEMBERS=${addressedMembers% }" >&2
				AgentsToolsCommsSlackUnreachableReport "$addressedMembers" "$memberName"
				echo "# $MDSC_CMD --slack-send-message: queued as block $chatNo of session $chatKey; the comms reader posts it to $channel:$threadTs" >&2
				AgentsToolsSlackSendLogLine ok "queued block $chatNo for the comms reader"
				if [ -n "$wakeMember$addressedMembers" ] ; then
					type AgentsToolsWakeTouch > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/wait/AgentsTools.WakeMarker.include"
					[ -z "$wakeMember" ] || AgentsToolsWakeTouch "$wakeMember" "$memberName" || :
					## A post into a thread, addressed to a member there, wakes it within a tick, the same as its own DM
					## does (load incident: a coordinator post addressed to magic-tester in its thread never woke a
					## 90-minute Wait).
					for wakeAddressed in $addressedMembers ; do [ "$wakeAddressed" = "$wakeMember" ] || AgentsToolsWakeTouch "$wakeAddressed" "$memberName" || : ; done
				fi
				## EVERY RUN THAT TOOK A COPY IS WOKEN (S27.9): a post into a session's own thread is that run's mail, whether
				## or not the text names a member. A run whose wait naps on its next look at the thread reads it minutes later
				## otherwise, which is what the owner reported: a coordinator's message to a run sat unread.
				if [ -n "$chatCopies" ] ; then
					type AgentsToolsSessionChatWakeCopies > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionChatCopies.include"
					AgentsToolsSessionChatWakeCopies "$chatCopies" "$memberName" || :
				fi
				return 0
			fi
		fi
		## A new post into the event-track channel keeps the channel's outbox rules (AgentsTools.EventTrackSend.include): what is
		## queued for the channel goes first, in its order; this message waits out the 7 s window since the channel's last message;
		## and the moment it was posted is noted, so the next post waits its window from it.
		local trackQueue=""
		case "$target" in
			event-track|event-track:*)
				if [ -z "$updateTs" ] ; then
					type AgentsEventTrackPostSend > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/event-track/AgentsTools.InternOpEventTrackPost.include"
					type AgentsToolsEventTrackSendDrain > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/event-track/AgentsTools.EventTrackSend.include"
					trackQueue="$( AgentsToolsEventTrackSendDir "$channel" 2> /dev/null )" || trackQueue=""
					if [ -n "$trackQueue" ] ; then
						AgentsToolsEventTrackSendDrain "$trackQueue" AgentsEventTrackPostSend > /dev/null 2>&1 || :
						AgentsToolsEventTrackSendPace "$trackQueue"
					fi
				fi
			;;
		esac
		local response attempt=1 maxAttempts=5 backoff=2 sent="false" joinAttempted="false" identitySwapped="false" permanentVerdict="" sendRc sendUnknown=""
		while [ "$attempt" -le "$maxAttempts" ] ; do
			## The body travels in a file, never argv, which a long message outgrows; stdin is the header's.
			sendRc=0
			## 200, above curl's own exit codes, is this machine failing before curl ran: nothing was sent, and it is said as such.
			response="$( mkdir -p "$MMDAPP/.local/temp" && bodyFile="$( mktemp "$MMDAPP/.local/temp/mdat-slack-send.XXXXXX" )" || exit 200
				trap 'rm -f "$bodyFile"' EXIT
				printf '%s' "$payload" > "$bodyFile" || exit 200
				curl -sS --connect-timeout 10 --max-time 120 -X POST "https://slack.com/api/$sendApi" \
				-H @- \
				-H "Content-type: application/json" \
				--data-binary "@$bodyFile" <<< "$authHeader" 2>&1 )" || sendRc=$?
			if printf '%s' "$response" | grep -q '"ok":true' ; then
				sent="true"
				break
			fi
			## A post is not idempotent. curl failing to resolve or to connect (6, 7) sent
			## nothing, so it is retried. Any other transport failure may have reached Slack
			## with the reply lost, and a retry could post it twice -- so it is not retried.
			case "$sendRc" in
				0|6|7) ;;
				200)
					echo "⛔ ERROR: $MDSC_CMD --slack-send-message: nothing was posted -- the message body could not be staged under $MMDAPP/.local/temp, so curl never ran" >&2
					AgentsToolsSlackSendLogLine failed "not posted: the body could not be staged locally"
					AgentsToolsSlackSendChatKeep retry "the body could not be staged locally"
					set +e ; return 1
				;;
				*)
					sendUnknown="curl exited $sendRc after the request may have reached Slack"
					echo "# $MDSC_CMD --slack-send-message: $sendUnknown -- not retried, a retry could post it twice -- $response" >&2
					break
				;;
			esac
			## An edit (--update-ts) changes one message that is already there, so what Slack
			## answers to it is a verdict: only a rate limit is tried again, and no recovery
			## below applies, since each of them would act under another identity or elsewhere.
			if [ -n "$updateTs" ] ; then
				case "$response" in
					*'"error":"ratelimited"'*|*'"error":"rate_limited"'*) ;;
					*'"ok":false'*)
						permanentVerdict="Slack answered and did not edit it"
						echo "# $MDSC_CMD --slack-send-message: $permanentVerdict -- not retried, its answer to an edit is a verdict -- $response" >&2
						break
					;;
				esac
			fi
			if [ "$sendIdentity" = "bot" ] && [ "$joinAttempted" = "false" ] && [ -z "$threadTs" ] && printf '%s' "$response" | grep -q '"error":"not_in_channel"' ; then
				joinAttempted="true"
				local joinResponse
				joinResponse="$( curl -sS --connect-timeout 10 --max-time 120 -X POST "https://slack.com/api/conversations.join" \
					-H @- \
					-H "Content-type: application/x-www-form-urlencoded" \
					--data-urlencode "channel=$channel" <<< "$authHeader" 2>&1 )"
				echo "# $MDSC_CMD --slack-send-message: auto-join attempt for bot token on channel=$channel -- $joinResponse" >&2
				if printf '%s' "$joinResponse" | grep -q '"ok":true' ; then
					continue
				fi
			fi
			## not_in_channel is the same permanent unreachable-conversation verdict as channel_not_found -- no retry clears either.
			if [ "$identitySwapped" = "false" ] && [ "$sendIdentity" = "user" ] && printf '%s' "$response" | grep -qE '"error":"(channel_not_found|not_in_channel)"' ; then
				identitySwapped="true"
				local botToken="" swapTokenLine="" swapTokenSource=""
				swapTokenLine="$( AgentsToolsResolveSlackBotToken "$memberName" )" || swapTokenLine=""
				read -r swapTokenSource botToken <<< "$swapTokenLine"
				## The payload already presents the client under its external names, which only the member's own bot token may post: a swap to the shared bot would show it in our workspace.
				if [ "$presentExternal" = "true" ] && [ "$swapTokenSource" != "member-bot-token" ] ; then
					botToken=""
				fi
				## A REPLY GOES TO THE CONVERSATION OF THE MESSAGE IT ANSWERS. The bot may stand in a conversation of its own with the same person, where the
				## parent of this thread is not: posted there under a thread ts that is none of that conversation, the reply lands at its top level, elsewhere
				## than the person reads. So a swap to the bot is made for a thread only where the bot can see the parent in this very conversation.
				if [ -n "$botToken" ] && [ -n "${threadTs:-}" ] ; then
					local swapParent=""
					swapParent="$( curl -sS --connect-timeout 10 --max-time 60 -X POST "https://slack.com/api/conversations.replies" \
						-H @- --data-urlencode "channel=$channel" --data-urlencode "ts=$threadTs" --data-urlencode "limit=1" <<< "Authorization: Bearer $botToken" 2>&1 )"
					if ! printf '%s' "$swapParent" | grep -q '"ok":true' || ! printf '%s' "$swapParent" | grep -q "\"ts\":\"$threadTs\"" ; then
						permanentVerdict="the thread $channel:$threadTs cannot be reached under bot identity either: its parent message is not in that conversation, so the reply would land at the top level of another conversation. Reply in the conversation the message was read from"
						echo "# $MDSC_CMD --slack-send-message: $permanentVerdict -- not retried -- $swapParent" >&2
						botToken=""
						break
					fi
				fi
				if [ -n "$botToken" ] ; then
					botTokenSource="$swapTokenSource"
					sendIdentity="bot"
					token="$botToken"
					authHeader="Authorization: Bearer $token"
					## The sender is already in rawText/payload from the unconditional
					## build above, under either identity, so this swap changes only
					## the token and resends the same payload -- nothing to re-add here.
					echo "# $MDSC_CMD --slack-send-message: the acting user identity cannot reach this conversation, retrying once under bot identity -- $response" >&2
					continue
				fi
			fi
			## THE SWAP THE OTHER WAY: the bot is no member of a persona's direct message with the owner, so a post there under the bot is channel_not_found,
			## while the member's own account stands in it. Once only, on the flag the swap above shares, so the two never trade places. Not for the client side or an external
			## presentation, nor for a top-level message to the human-owner, which stays the bot's. A thread is entered only where the user sees its parent in this conversation.
			if [ "$identitySwapped" = "false" ] && [ "$sendIdentity" = "bot" ] && [ -n "$memberUserToken" ] && [ "$presentExternal" = "false" ] && ! AgentsToolsCommsClientSide "$memberName" \
				&& { [ -n "${threadTs:-}" ] || [ -z "$outsideOwner" ] || { [ "$channel" != "$outsideOwner" ] && [ "$outsideParty" != "$outsideOwner" ] ; } ; } \
				&& printf '%s' "$response" | grep -qE '"error":"(channel_not_found|not_in_channel)"' ; then
				identitySwapped="true"
				local swapUserId="" swapUserAuth="" swapUserParent=""
				if [ -n "${threadTs:-}" ] ; then
					swapUserParent="$( curl -sS --connect-timeout 10 --max-time 60 -X POST "https://slack.com/api/conversations.replies" \
						-H @- --data-urlencode "channel=$channel" --data-urlencode "ts=$threadTs" --data-urlencode "limit=1" <<< "Authorization: Bearer $memberUserToken" 2>&1 )"
					if ! printf '%s' "$swapUserParent" | grep -q '"ok":true' || ! printf '%s' "$swapUserParent" | grep -q "\"ts\":\"$threadTs\"" ; then
						echo "# $MDSC_CMD --slack-send-message: the thread $channel:$threadTs is not seen under user identity either, so it is not entered under it -- $swapUserParent" >&2
						swapUserId="-"
					fi
				fi
				if [ -z "$swapUserId" ] ; then
					swapUserAuth="$( curl -sS --connect-timeout 10 --max-time 120 https://slack.com/api/auth.test -H @- <<< "Authorization: Bearer $memberUserToken" 2>&1 )"
					swapUserId="$( printf '%s\n' "$swapUserAuth" | LC_ALL=C awk -v path=user_id -v dialect=slack -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsHarnessJsonField.awk" )" || swapUserId=""
				fi
				case "$swapUserId" in
					U[A-Z0-9]*)
						botTokenSource=""
						sendIdentity="user"
						token="$memberUserToken"
						authHeader="Authorization: Bearer $token"
						authUserId="$swapUserId"
						echo "# $MDSC_CMD --slack-send-message: the bot cannot reach this conversation, retrying once under the acting user identity -- $response" >&2
						continue
					;;
				esac
			fi
			case "$response" in
				*'"error":"invalid_blocks"'*)
					permanentVerdict="Slack answered and rejected the blocks as invalid"
					echo "# $MDSC_CMD --slack-send-message: $permanentVerdict -- not retried, no retry can change a payload -- $response" >&2
					break
				;;
				*'"error":"not_in_channel"'*|*'"error":"channel_not_found"'*|*'"error":"is_archived"'*)
					## Said with the Slack this send used and the workspace that came from: a
					## conversation of another Slack is not found here, which is no missing bot.
					permanentVerdict="the conversation cannot be reached under $sendIdentity identity. This send used $( AgentsToolsSlackWhere "$memberName" ), and a conversation of another Slack does not exist there"
					echo "# $MDSC_CMD --slack-send-message: permanent verdict under $sendIdentity identity and no recovery applies -- not retried -- $response" >&2
					break
				;;
				## A rate limit is the one answer of Slack that another try can change.
				*'"error":"ratelimited"'*|*'"error":"rate_limited"'*) ;;
				## Any other answer of Slack is its verdict on this post: the same post sent again
				## gets the same answer, so it is said once and never retried.
				*'"ok":false'*)
					permanentVerdict="Slack answered and refused it ($( AgentsToolsSlackSendErrorCode ))"
					echo "# $MDSC_CMD --slack-send-message: $permanentVerdict -- not retried, only a rate limit is tried again -- $response" >&2
					break
				;;
			esac
			echo "# $MDSC_CMD --slack-send-message: attempt $attempt/$maxAttempts did not confirm ok:true, retrying in ${backoff}s -- $response" >&2
			sleep "$backoff"
			attempt=$(( attempt + 1 ))
			backoff=$(( backoff * 2 ))
		done
		if [ "$sent" = "true" ] ; then
			[ -z "$trackQueue" ] || AgentsToolsEventTrackSendNote "$trackQueue"
			if [ "$sendIdentity" = "user" ] ; then
				local responseMessageUser="" responseMessageUserRc=0
				responseMessageUser="$( printf '%s\n' "$response" | LC_ALL=C awk -v path=message.user -v dialect=slack -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsHarnessJsonField.awk" )" || responseMessageUserRc=$?
				if [ "$responseMessageUserRc" != "0" ] ; then
					echo "⛔ ERROR: $MDSC_CMD --slack-send-message: THE MESSAGE WAS POSTED -- do not send it again. member SLACK_USER_TOKEN send for $memberName could not be confirmed as message.user=$authUserId -- the response carries no readable message.user (reader rc=$responseMessageUserRc), so the control reached no verdict, which is not a pass" >&2
					echo "# Response: $response" >&2
					AgentsToolsSlackSendLogLine failed "posted, but message.user not readable"
					set +e ; return 1
				fi
				[ "$responseMessageUser" = "$authUserId" ] || rm -f "$MMDAPP/.local/cache/comms/slack/.user-id-$memberName.txt" 2> /dev/null
				if [ "$responseMessageUser" != "$authUserId" ] ; then
					echo "⛔ ERROR: $MDSC_CMD --slack-send-message: THE MESSAGE WAS POSTED -- do not send it again. member SLACK_USER_TOKEN send for $memberName did not confirm message.user=$authUserId (actual message.user=$responseMessageUser)" >&2
					echo "# Response: $response" >&2
					AgentsToolsSlackSendLogLine failed "posted, but not as message.user=$authUserId"
					set +e ; return 1
				fi
			fi
			local sentTs="" sentChannel="" sentThreadTs="" sentTsRc=0 sentChannelRc=0
			sentChannel="$( printf '%s\n' "$response" | LC_ALL=C awk -v path=channel -v optional=1 -v dialect=slack -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsHarnessJsonField.awk" )" || sentChannelRc=$?
			sentTs="$( printf '%s\n' "$response" | LC_ALL=C awk -v path=message.ts -v optional=1 -v dialect=slack -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsHarnessJsonField.awk" )" || sentTsRc=$?
			## A message posted into a thread carries that thread ts, and a message that
			## starts one carries none -- in which case it is the thread itself. Absent is
			## the documented shape here and not a failure, so this rc is not read.
			sentThreadTs="$( printf '%s\n' "$response" | LC_ALL=C awk -v path=message.thread_ts -v optional=1 -v dialect=slack -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsHarnessJsonField.awk" )" || sentThreadTs=""
			[ -n "$sentThreadTs" ] || sentThreadTs="$sentTs"
			## A post on the client side is reported under its client: address, so a reply, a
			## reaction or a wait given this value reaches the same side.
			! AgentsToolsCommsClientSide "$memberName" || [ -z "$sentChannel" ] || sentChannel="client:$sentChannel"
			if [ "$sentChannelRc" = "0" ] && [ "$sentTsRc" = "0" ] && [ -n "$sentChannel" ] && [ -n "$sentTs" ] ; then
				echo "SENT_MESSAGE_CHANNEL=$sentChannel" >&2
				echo "SENT_MESSAGE_TS=$sentTs" >&2
				echo "SENT_MESSAGE_THREAD_TS=$sentThreadTs" >&2
				## The reply the member owed here is answered (AgentsTools.OwedReplies.include). THE MESSAGE ANSWERED IS
				## THE ONE THE SEND AIMED AT, never the thread Slack answered with: Slack flattens a reply under a
				## message inside a thread to that thread's ROOT, so a clear on the answer leaves the message's own
				## line owed for ever, and a clear on the root would answer a message nobody replied to.
				type AgentsToolsOwedRepliesClear > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.OwedReplies.include"
				if [ -n "${threadTs:-}" ] ; then
					AgentsToolsOwedRepliesClear "$memberName" slack "$channel" "$threadTs"
				else
					AgentsToolsOwedRepliesClear "$memberName" slack "$channel" "$sentThreadTs"
				fi
			else
				echo "SENT_MESSAGE_CHANNEL=" >&2
				echo "SENT_MESSAGE_TS=" >&2
				echo "SENT_MESSAGE_THREAD_TS=" >&2
				echo "# $MDSC_CMD --slack-send-message: THIS WAS POSTED, and the response carries no readable channel with message.ts beside it (channel reader rc=$sentChannelRc, ts reader rc=$sentTsRc), so THE THREAD OF THIS MESSAGE IS NOT KNOWN. A caller waiting on a reply to it must not fall back to the whole conversation: nothing there would be known to be a reply to this." >&2
			fi
			## Empty when the message named nobody, or named only accounts with no Slack id
			## of their own. Empty is a stated value: a wait cannot qualify an answer
			## without it, and must say so rather than accept whatever arrives.
			echo "SENT_MESSAGE_ADDRESSEES=${addressedIds% }" >&2
			[ -z "$addressedMembers" ] || echo "SENT_MESSAGE_ADDRESSEE_MEMBERS=${addressedMembers% }" >&2
				AgentsToolsCommsSlackUnreachableReport "$addressedMembers" "$memberName"
			## The block recorded before the post takes the ts and the thread Slack gave it, so a later read of the thread knows it.
			[ -z "$chatRecord" ] || [ -z "$sentTs" ] || AgentsToolsSessionChatStamp "$chatKey" "$chatNo" "$sentTs" "${sentChannel#client:}:$sentThreadTs" 2> /dev/null || :
			## THE TS RECORDED AGAINST THE LOCAL ID (S1 item 11): the post's own line stays the message, and this line is the
			## reference that says which Slack message it became.
			if [ -n "$postLocalId" ] && [ -n "$sentTs" ] ; then
				type AgentsToolsCommsCachePostLink > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.CommsCache.include"
				[ -n "$postStoreDir" ] || AgentsToolsCommsCacheSlackDir "$memberName" "$( [ "$sendIdentity" = "bot" ] && printf true || printf false )" "${sentChannel#client:}" "${sentThreadTs:-}" 2> /dev/null || :
				[ -z "$postStoreDir" ] || agentsCommsCacheDir="$postStoreDir"
				[ -z "${agentsCommsCacheDir:-}" ] || AgentsToolsCommsCachePostLink "$agentsCommsCacheDir" "$memberName" "$postLocalId" "" "$sentTs" "$chatBody" || :
			fi
			## Its copies in the receiving sessions' files take the same ts, and keep their thread (AgentsToolsSessionChatDeliverStamp).
			type AgentsToolsSessionChatDeliverStamp > /dev/null 2>&1 || [ -z "$chatCopies" ] || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionChatCopies.include"
			[ -z "$chatCopies" ] || [ -z "$sentTs" ] || AgentsToolsSessionChatDeliverStamp "$chatCopies" "$sentTs" 2> /dev/null || :
			AgentsToolsSlackSendLogLine ok "$( [ -n "$updateTs" ] && printf 'edited' || printf 'posted' ) ts=$sentTs"
			if [ -n "$wakeMember$addressedMembers" ] && [ -z "$updateTs" ] ; then
				type AgentsToolsWakeTouch > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/wait/AgentsTools.WakeMarker.include"
				[ -z "$wakeMember" ] || AgentsToolsWakeTouch "$wakeMember" "$memberName" || :
				for wakeAddressed in $addressedMembers ; do [ "$wakeAddressed" = "$wakeMember" ] || AgentsToolsWakeTouch "$wakeAddressed" "$memberName" || : ; done
			fi
			## EVERY RUN THAT TOOK A COPY IS WOKEN (S27.9): a post into a session's own thread is that run's mail, whether or
			## not the text names a member. A run whose wait naps on its next look at the thread reads it minutes later otherwise.
			if [ -n "$chatCopies" ] && [ -z "$updateTs" ] ; then
				type AgentsToolsSessionChatWakeCopies > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionChatCopies.include"
				AgentsToolsSessionChatWakeCopies "$chatCopies" "$memberName" || :
			fi
			printf '%s\n' "$response"
			return 0
		fi
		## An edit that did not happen is said as that. The message it would have changed stands
		## as it was, so nothing is queued for it, and no email says comms are stuck.
		if [ -n "$updateTs" ] ; then
			if [ -n "$sendUnknown" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --slack-send-message: WHETHER $channel:$updateTs WAS EDITED IS UNKNOWN -- $sendUnknown. The same edit sent again changes nothing more." >&2
				AgentsToolsSlackSendLogLine failed "unknown whether edited: $sendUnknown"
			else
				echo "⛔ ERROR: $MDSC_CMD --slack-send-message: the message $channel:$updateTs was NOT edited -- ${permanentVerdict:-Slack did not confirm after $maxAttempts attempts}. It stands as it was: an edit is not queued, and no email is sent." >&2
				AgentsToolsSlackSendLogLine failed "not edited: ${permanentVerdict:-no ok:true after $maxAttempts attempts} error=$( AgentsToolsSlackSendErrorCode )"
			fi
			set +e ; return 1
		fi
		if [ -n "$sendUnknown" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --slack-send-message: WHETHER THIS WAS POSTED IS UNKNOWN -- $sendUnknown. Read the conversation before sending it again, or it may appear twice." >&2
			AgentsToolsSlackSendLogLine failed "unknown whether posted: $sendUnknown"
			AgentsToolsSlackSendChatKeep unknown "$sendUnknown"
			set +e ; return 1
		fi
		if [ -n "$permanentVerdict" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --slack-send-message: nothing was posted -- $permanentVerdict. Slack answered, so comms are not stuck and no email is sent." >&2
			AgentsToolsSlackSendLogLine failed "not posted: $permanentVerdict error=$( AgentsToolsSlackSendErrorCode )"
			AgentsToolsSlackSendChatKeep refused "$permanentVerdict"
			set +e ; return 1
		fi
		AgentsToolsSlackSendLogLine failed "not posted: no ok:true after $maxAttempts attempts error=$( AgentsToolsSlackSendErrorCode )"
		AgentsToolsSlackSendChatKeep retry "no ok:true after $maxAttempts attempts"
		echo "⛔ $MDSC_CMD --slack-send-message: Slack did not confirm after $maxAttempts attempts -- notifying by email that Slack comms are stuck" >&2
		local fallbackUser
		type AgentsToolsConfigOption > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/settings/AgentsTools.ConfigOption.include"
		fallbackUser="$( AgentsToolsConfigOption magic-coordinator --select EMAIL_USER )"
		if [ -z "$fallbackUser" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --slack-send-message: no EMAIL_USER configured, cannot notify" >&2
			set +e ; return 1
		fi
		type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
		DistroAgentsTools --intern-op-comms-email-send magic-coordinator "$fallbackUser" -- \
			"Slack comms stuck -- message queued for target $target" -- \
			"Slack did not confirm this send after $maxAttempts retries -- comms to Slack appear stuck." "" \
			"Nothing was rerouted to email -- this is a notification only. The" \
			"message below stays queued for Slack and should go out once it" \
			"recovers; retry --slack-send-message manually if it doesn't." "" \
			"Team-member: $memberName" "Target: $target" "" \
			"Queued message:" "$rawText" "" \
			"Last Slack error response:" "$response" \
			|| echo "⛔ ERROR: $MDSC_CMD --slack-send-message: the notification email failed too" >&2
		echo "⛔ ERROR: $MDSC_CMD --slack-send-message: nothing was posted to Slack -- the email is a notification, not a delivery" >&2
		set +e ; return 1
	;;
esac
