#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.InternOpCommsSlackRead.include -- --slack-read.
## Sourced lazily from AgentsTools.MemberCommsSlack.include by its own arm, and only by it; relies on being
## dot-sourced for $1/$@/$MDSC_CMD. Rationale and mechanism: myx.distro-agents/MAGIC.md.
##

type AgentsToolsTempClaim > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/common/AgentsTools.TempFiles.include"
type AgentsToolsCommsSlackRun > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/slack/AgentsTools.CommsSlack.include"

case "$1" in

		--intern-op-comms-slack-read)
			shift
			local memberName="$1"
			shift || true
			if [ -z "$memberName" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --slack-read: <team-member> missing" >&2
				set +e ; return 1
			fi
			type AgentsToolsAssertBareName > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.BareName.include"
			AgentsToolsAssertBareName "$memberName" "<team-member>" slack-read || { set +e ; return 1 ; }
			case "$memberName" in
				routine-*)
				;;
				*)
					AgentsToolsSlackMemberPresent "$memberName" --slack-read || { set +e ; return 1 ; }
				;;
			esac
			local target="$1"
			shift || true
			if [ -z "$target" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --slack-read: target required -- <channel>:<ts> for one message, or a bare <channel>/<conversation-id>/magic-team/human-owner/event-track/event-alert for that conversation's own messages." >&2
				set +e ; return 1
			fi
			local wantThread="false" identityAsBot="false" readOldest="" readWait="" readTtl=""
			while [ $# -gt 0 ] ; do
				case "$1" in
					--thread)
						wantThread="true" ; shift
					;;
					## Bare-channel form only: a conversation is paged to its end,
					## so a busy channel needs a floor or the page cap ends the read.
					--oldest)
						if [ -z "${2:-}" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --slack-read: --oldest: value required (<epoch>[.<micros>])" >&2
							set +e ; return 1
						fi
						readOldest="$2" ; shift 2
					;;
					## A member's own read on the cache's terms (the owner's design): served from the cache, or waited for on the comms
					## service thread by the folder's fifo for up to <seconds>; never a call of the reader's own.
					--wait)
						case "${2:-}" in ''|*[!0-9]*) echo "⛔ ERROR: $MDSC_CMD --slack-read: --wait: whole seconds required" >&2 ; set +e ; return 1 ;; esac
						readWait="$2" ; shift 2
					;;
					## The age this call accepts, in whole seconds: it overrides MDAT_SLACK_THREAD_CACHE_SECONDS here. Not --wait,
					## which is the budget for waiting on the comms thread.
					--ttl)
						case "${2:-}" in ''|*[!0-9]*) echo "⛔ ERROR: $MDSC_CMD --slack-read: --ttl: whole seconds required" >&2 ; set +e ; return 1 ;; esac
						readTtl="$2" ; shift 2
					;;
					--identity-bot)
						identityAsBot="true" ; shift
					;;
					*)
						echo "⛔ ERROR: $MDSC_CMD --slack-read: invalid option: $1" >&2
						set +e ; return 1
					;;
				esac
			done
			## A READ TAKES THE IDENTITY FALLBACK OF A SEND: what a send posted under the bot, because the member's user identity could not reach the conversation, is read back
			## under the bot as well. The read goes once as asked; where Slack says channel_not_found, not_in_channel or thread_not_found (a thread the bot started in its own DM) it goes once more under the bot, in the same call
			## (no second process). --identity-bot asked is final.
			local resolved rc channel threadTs
			type DistroAgentsToolsResolveTarget > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.CommsResolveTarget.include"
			resolved="$( DistroAgentsToolsResolveTarget "$target" "$memberName" )" && rc=0 || rc=$?
			case "$rc" in
				0)
					channel="$( printf '%s\n' "$resolved" | sed -n 's/^CHANNEL=//p' )"
					local targetUserId=""
					targetUserId="$( printf '%s\n' "$resolved" | sed -n 's/^USER_ID=//p' )" || targetUserId=""
					threadTs="$( printf '%s\n' "$resolved" | sed -n 's/^THREAD_TS=//p' )"
				;;
				## A session address that names nowhere: the resolver's own line, why and what to pass instead.
				3)
					echo "⛔ ERROR: $MDSC_CMD --slack-read: $resolved" >&2
					set +e ; return 1
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --slack-read: could not resolve target '$target' -- pass <channel>:<ts> for one message, or a bare channel/conversation for its own messages" >&2
					set +e ; return 1
				;;
			esac
			local readErrFile="" readRc=0
			mkdir -p "$MMDAPP/.local/temp" 2> /dev/null && readErrFile="$( mktemp "$MMDAPP/.local/temp/mdat-slack-read.XXXXXX" 2> /dev/null )" || readErrFile=""
			AgentsToolsTempClaim "$readErrFile"
			## No <ts>: the target names a conversation, not a message. Read the
			## conversation itself -- the case a caller is in when it wants the ts
			## of something just posted and so cannot supply one. AgentsToolsSlackCheck
			## already reads a whole conversation through the paged reader; this is
			## that read, reached under the member-facing name.
			if [ -z "$threadTs" ] ; then
				if [ "$wantThread" = "true" ] ; then
					echo "⛔ ERROR: $MDSC_CMD --slack-read: --thread reads one thread and needs that thread's parent <ts> -- pass <channel>:<ts> --thread, or drop --thread to read the conversation" >&2
					[ -z "$readErrFile" ] || rm -f "$readErrFile"
					set +e ; return 1
				fi
				## A WHOLE CONVERSATION IS READ FROM A FLOOR (S12.22): a read with no floor is cached as floor 0, the whole history.
				if [ -z "$readOldest" ] ; then
					echo "⛔ ERROR: $MDSC_CMD --slack-read: a whole conversation is read from a floor, and this read named none. Pass --oldest <epoch>[.<micros>] -- a conversation read from the start is cached as floor 0, the whole history, and costs every read after it. A single message keeps its own form." >&2
					[ -z "$readErrFile" ] || rm -f "$readErrFile"
					set +e ; return 1
				fi
				## THE AGE THIS CALL ACCEPTS: its own --ttl, else the setting the cache reads at, else the thread default.
				local convTtl="${readTtl:-${MDAT_SLACK_THREAD_CACHE_SECONDS:-15}}"
				case "$convTtl" in ''|*[!0-9]*) convTtl=15 ;; esac
				## HUMAN-OWNER READS BOTH DMs, EACH FROM THE CACHE: the macro names one party, and its two conversations are
				## keyed one per identity, exactly as a read naming that conversation id keys them, so a later read of that id
				## is served the same entry. A leg the cache does not hold is not fetched here: the comms thread fills it.
				## So this read answers partial or absent rather than an empty conversation.
				local hoParty=""
				case "$channel" in
					U*|W*) hoParty="$channel" ;;
					*) hoParty="" ;;
				esac
				if [ "$target" = "human-owner" ] && [ -n "$hoParty" ] ; then
					local hoProvenance="" hoFailReport="" hoMerged="" hoSorted="" hoOkCount=0 hoLegIndex=0 hoLegArgs=() tabChar=$'\t'
					local hoLegIdentity hoLegDm hoLegInfo hoLegOut hoLegTagged hoLegReason hoLegRc hoLegDmRc
					type AgentsToolsCommsSlackRun > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/slack/AgentsTools.CommsSlack.include"
					type AgentsToolsMemberCommsSlackRun > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/slack/AgentsTools.MemberCommsSlack.include"
					for hoLegIdentity in user bot ; do
						hoLegIndex=$(( hoLegIndex + 1 ))
						hoLegRc=0 hoLegDm="" hoLegReason="" hoLegOut="" hoLegTagged=""
						## EACH LEG LEARNS ITS OWN CONVERSATION, then reads it as a read naming that id does.
						hoLegInfo="$( AgentsToolsCommsSlackRun --intern-op-slack-call "$memberName" --api conversations.info --resolve-dm "$hoParty" --identity "$hoLegIdentity" --context "--slack-read human-owner ($hoLegIdentity identity, DM discovery)" )" || hoLegRc=$?
						if [ "$hoLegRc" != "0" ] ; then
							hoLegReason="the discovery call failed (rc=$hoLegRc), and its own diagnostic is above"
						else
							hoLegDmRc=0
							hoLegDm="$( LC_ALL=C awk -v path=channel.id -v dialect=slack -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsHarnessJsonField.awk" <<< "$hoLegInfo" )" || hoLegDmRc=$?
							if [ "$hoLegDmRc" != "0" ] || [ -z "$hoLegDm" ] ; then
								hoLegReason="the discovery call reported no usable channel id (field reader rc=$hoLegDmRc), so that conversation was never read"
							fi
						fi
						if [ -z "$hoLegReason" ] ; then
							## THE LEG ASKS THE CACHE ALONE: the comms thread is the one thing that fills an entry.
							## It carries the age this call accepts, and the budget the caller gave.
							hoLegArgs=( "$memberName" "$hoLegDm" --oldest "$readOldest" --ttl "$convTtl" --wait "${readWait:-0}" )
							[ "$hoLegIdentity" = "user" ] || hoLegArgs+=( --identity-bot )
							hoLegRc=0
							hoLegOut="$( AgentsToolsMemberCommsSlackRun --intern-op-comms-slack-read "${hoLegArgs[@]}" )" || hoLegRc=$?
							case "$hoLegRc" in
								0) ;;
								3) hoLegReason="the cache does not hold that conversation yet (rc=3), so the comms thread fills it and this read is unread" ;;
								*) hoLegReason="that conversation was not served (rc=$hoLegRc), and its own diagnostic is above" ;;
							esac
						fi
						if [ -z "$hoLegReason" ] ; then
							## EACH SERVED LINE IS TAGGED WITH ITS CONVERSATION AND ITS RECORD, for the chronological merge below.
							hoLegTagged="$( printf '%s\n' "$hoLegOut" | LC_ALL=C awk -v dmId="$hoLegDm" -v legIndex="$hoLegIndex" '
								/^## / { next ; }
								/^[[:space:]]*$/ { next ; }
								{
									if ( $0 ~ /^[0-9][0-9]*\.[0-9][0-9]* \| / ) { recTs = $0 ; sub(/ .*/, "", recTs) ; recKind = "H" ; }
									else { recKind = "C" ; }
									print recTs "\t" legIndex "\t" NR "\t" dmId "\t" recKind "\t" $0 ;
								}' )" || hoLegReason="its rendering could not be tagged for the merge"
							[ -z "$hoLegTagged" ] || hoMerged="$hoMerged$hoLegTagged"$'\n'
						fi
						if [ -n "$hoLegReason" ] ; then
							hoProvenance="$hoProvenance## dm=${hoLegDm:-<not resolved>} identity=$hoLegIdentity status=FAILED reason=$hoLegReason"$'\n'
							hoFailReport="$hoFailReport the $hoLegIdentity identity conversation (${hoLegDm:-not resolved}) -- $hoLegReason ;"
							continue
						fi
						hoOkCount=$(( hoOkCount + 1 ))
						hoProvenance="$hoProvenance## dm=$hoLegDm identity=$hoLegIdentity status=ok"$'\n'
					done
		printf '## target=%s channel=%s (party id -- reads BOTH human-owner DMs, one per identity, each from the cache)\n' "$target" "$hoParty"
					## Provenance first, always both legs, then the payload.
					printf '%s' "$hoProvenance"
					if [ -n "$hoMerged" ] ; then
						hoSorted="$( LC_ALL=C sort -t "$tabChar" -k1,1 -k2,2n -k3,3n <<< "${hoMerged%$'\n'}" )" || {
							echo "⛔ ERROR: $MDSC_CMD --slack-read: the lines served could not be sorted into one chronological conversation, so nothing is concluded from this call." >&2
							set +e ; return 1
						}
						LC_ALL=C awk -F "$tabChar" '
							{
								body = $6 ;
								for ( i = 7 ; i <= NF ; i++ ) { body = body "\t" $i ; }
								if ( $5 == "H" ) { print $4 " | " body ; }
								else { print body ; }
							}' <<< "$hoSorted" || {
							echo "⛔ ERROR: $MDSC_CMD --slack-read: the lines served were sorted but could not be rendered, so what is above is not the answer, and nothing is concluded from this call." >&2
							set +e ; return 1
						}
					fi
					if [ "$hoOkCount" = "2" ] ; then
						if [ -n "$hoMerged" ] ; then
							echo "# $MDSC_CMD --slack-read: BOTH human-owner DMs served from the cache, one entry per identity. The lines above are the two conversations merged chronologically, each carrying its own conversation id." >&2
						else
							echo "# $MDSC_CMD --slack-read: BOTH human-owner DMs served from the cache, and neither holds a message after ${readOldest}." >&2
						fi
						return 0
					fi
					if [ "$hoOkCount" = "1" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --slack-read: PARTIAL -- only ONE of the human-owner’s two DMs was served. Failed:$hoFailReport The output above is therefore HALF the conversation: a message the human-owner sent in the other DM is absent from it, and nothing here supports concluding that no such message exists. Fix the named leg and read again before treating this as an answer. rc=3 means exactly this partial state, distinct from rc=4 (neither DM served) and from rc=1 (this operation failed before any fan-out)." >&2
						set +e ; return 3
					fi
					echo "⛔ ERROR: $MDSC_CMD --slack-read: NEITHER of the human-owner’s two DMs was served. Failed:$hoFailReport Nothing was read at all, so nothing whatsoever is known from this call about what the human-owner has or has not written. rc=4 means exactly this, distinct from rc=3 (one DM served, one not)." >&2
					set +e ; return 4
				fi
				## THROUGH THE COMMS CACHE (AgentsTools.CommsCache.include), slack/<channel>: a read from a floor it covers is served from
				## it; once its TTL has passed only what came after its newest is pulled from Slack and added. ONE PATH (epic S21.13).
				local convFile="" convTmp="" convAt="" convFrom="" convNewest="" convNow="" convKey convFetch="$readOldest"
				local convFloorNum="${readOldest%%.*}"
				type AgentsToolsCommsCacheSlackDir > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.CommsCache.include"
				## --wait <seconds>: this read is on the cache's terms, waiting on the comms service thread for that long at most.
				[ -z "$readWait" ] || { MDAT_COMMS_CACHE_ONLY="true" ; MDAT_COMMS_CACHE_WAIT_SECONDS="$readWait" ; }
				if [ -n "${MMDAPP:-}" ] && [ "$convTtl" != 0 ] && AgentsToolsCommsCacheSlackDir "$memberName" "$identityAsBot" "$channel" ; then
					convFile="$agentsCommsCacheDir"
					convNow="$( date +%s )"
					if AgentsToolsCommsCacheState "$convFile" ; then
						convAt="$agentsCommsCacheAt" convFrom="$agentsCommsCacheFrom" convNewest="$agentsCommsCacheNewest"
					fi
					AgentsToolsCommsCacheInterest "$convFile" "$convNow" "$convTtl"
					## A WAIT'S READ IS CACHE ONLY (MDAT_COMMS_CACHE_ONLY=true) on a team rig: the one comms thread ingests what is of interest
					## (AgentsToolsCommsCachePullWatched), so this read serves what the cache holds, fresh or stale, and never fetches or
					## refreshes by itself. A channel the cache does not cover yet is left to the thread as its recipe in `.want`, and is
					## read as unread (rc 3).
					if [ "${MDAT_COMMS_CACHE_ONLY:-}" = "true" ] && [ "${MDAT_COMMS_CACHE_PULLER:-}" != "true" ] ; then
						## FRESH, inside the reader's TTL and covering the floor: served as it stands. Else wanted from the thread and, with a
						## budget, waited for by the folder's fifo; what came is served, and a stale folder nothing refreshed in time is served
						## as it stands rather than read as nothing.
						if [ -n "$convAt" ] && [ -d "$convFile" ] && [ $(( convNow - convAt )) -lt "$convTtl" ] && [ "${convFrom%%.*}" -le "$convFloorNum" ] && AgentsToolsCommsCacheServe "$convFile" "$readOldest" head ; then
							echo "# $MDSC_CMD --slack-read: conversation $channel served from the cache, read $(( convNow - convAt ))s ago, the comms thread pulls it" >&2
							[ -z "$readErrFile" ] || rm -f "$readErrFile"
							return 0
						fi
						AgentsToolsCommsCacheWanted "$convFile" "slack-conversation $channel $memberName $identityAsBot $readOldest"
						## WAIT OR UNREAD, by the request: with a budget (MDAT_COMMS_CACHE_WAIT_SECONDS) the read waits on the thread's pull by
						## the folder's fifo, then serves what came; with none it is unread at once.
						if AgentsToolsCommsCacheWaitReady "$convFile" "${MDAT_COMMS_CACHE_WAIT_SECONDS:-0}" && AgentsToolsCommsCacheState "$convFile" ; then
							convAt="$agentsCommsCacheAt" convFrom="$agentsCommsCacheFrom" convNewest="$agentsCommsCacheNewest"
							if [ -n "$convAt" ] && [ "${convFrom%%.*}" -le "$convFloorNum" ] && AgentsToolsCommsCacheServe "$convFile" "$readOldest" head ; then
								echo "# $MDSC_CMD --slack-read: conversation $channel served from the cache after the comms thread pulled it" >&2
								[ -z "$readErrFile" ] || rm -f "$readErrFile"
								return 0
							fi
						fi
						## Nothing came in time: a stale folder that covers the floor is served as it stands; one not in the cache yet is unread.
						if AgentsToolsCommsCacheState "$convFile" && [ "${agentsCommsCacheFrom%%.*}" -le "$convFloorNum" ] && AgentsToolsCommsCacheServe "$convFile" "$readOldest" head ; then
							echo "# $MDSC_CMD --slack-read: conversation $channel served from the cache as it stands, read $(( convNow - agentsCommsCacheAt ))s ago, the comms thread pulls it" >&2
							[ -z "$readErrFile" ] || rm -f "$readErrFile"
							return 0
						fi
						echo "# $MDSC_CMD --slack-read: conversation $channel is not in the cache yet, the comms thread pulls it, and this read is unread" >&2
						return 3
					fi
					## Covered: the cache starts at or before this floor. Fresh: inside its TTL, served as it is.
					if [ -n "$convAt" ] && [ -d "$convFile" ] && [ "${convFrom%%.*}" -le "$convFloorNum" ] ; then
						if [ $(( convNow - convAt )) -lt "$convTtl" ] ; then
							if AgentsToolsCommsCacheServe "$convFile" "$readOldest" head ; then
								## THE CUT-OFF APPLIED IS STATED (S12.23): the floor the answer starts from is the one asked, or the start where none was.
								echo "# $MDSC_CMD --slack-read: conversation $channel served from the cache, read $(( convNow - convAt ))s ago, from ${readOldest:-the start}" >&2
								[ -z "$readErrFile" ] || rm -f "$readErrFile"
								return 0
							fi
						fi
						convFetch="$convNewest"
					else
						convFrom=""
					fi
					## STALE IS ENOUGH for a call that waits no longer than the TTL (MDAT_COMMS_CACHE_STALE_OK): it is served what
					## the cache covers at once, and the comms thread fills it. A reader starts no pull of its own.
					if [ "${MDAT_COMMS_CACHE_STALE_OK:-}" = "true" ] && [ -n "$convFrom" ] && AgentsToolsCommsCacheServe "$convFile" "$readOldest" head ; then
						echo "# $MDSC_CMD --slack-read: conversation $channel served from the cache as it stands, the comms thread pulls it, from ${readOldest:-the start}" >&2
						[ -z "$readErrFile" ] || rm -f "$readErrFile"
						return 0
					fi
					## One pull at a time: where another holds the channel, what the cache covers is served as it stands.
					if ! AgentsToolsCommsCachePullTake "$convFile" "$convNow" ; then
						## One pull at a time: a miss waits for the one that runs, and is served what it brought.
						if AgentsToolsCommsCachePullAwait "$convFile" && AgentsToolsCommsCacheState "$convFile" && [ "${agentsCommsCacheFrom%%.*}" -le "$convFloorNum" ] && AgentsToolsCommsCacheServe "$convFile" "$readOldest" head ; then
							echo "# $MDSC_CMD --slack-read: conversation $channel served from the cache after the pull that ran, from ${readOldest:-the start}" >&2
							[ -z "$readErrFile" ] || rm -f "$readErrFile"
							return 0
						fi
						if [ -n "$convFrom" ] && AgentsToolsCommsCacheServe "$convFile" "$readOldest" head ; then
							echo "# $MDSC_CMD --slack-read: conversation $channel served from the cache while another pull runs, from ${readOldest:-the start}" >&2
							[ -z "$readErrFile" ] || rm -f "$readErrFile"
							return 0
						fi
						convFile="" convFetch="$readOldest"
					fi
					[ -z "$convFile" ] || { mkdir -p "$convFile" 2> /dev/null && convTmp="$( mktemp "$convFile/read.XXXXXX" 2> /dev/null )" ; } || { AgentsToolsCommsCachePullGive "$convFile" ; convFile="" ; convTmp="" ; convFetch="$readOldest" ; }
					AgentsToolsTempClaim "$convTmp"
				fi
				echo "# $MDSC_CMD --slack-read: GET conversations.history channel=$channel${convFetch:+ oldest=$convFetch} (whole conversation, acting member $memberName)" >&2
				local conversationArgs=( "$memberName" "$channel" )
				local convOut="$convTmp"
				[ "$identityAsBot" = "false" ] || conversationArgs+=( --identity-bot )
				[ -z "$convFetch" ] || conversationArgs+=( --oldest "$convFetch" )
				## Bounded as a thread read is (AgentsToolsSlackReadBounded): a read that never answers ends at the bound. Outside the cache it reads into a scratch file.
				[ -n "$convOut" ] || [ -z "$readErrFile" ] || convOut="$( mktemp "$MMDAPP/.local/temp/mdat-slack-read-conv.XXXXXX" 2> /dev/null )" || convOut=""
				AgentsToolsTempClaim "$convOut"
				if [ -z "$convOut" ] || [ -z "$readErrFile" ] ; then
					echo "⛔ ERROR: $MDSC_CMD --slack-read: could not make a scratch file for the read in $MMDAPP/.local/temp" >&2
					[ -z "$readErrFile" ] || rm -f "$readErrFile"
					[ -z "$convTmp" ] || { rm -f "$convTmp" ; AgentsToolsCommsCachePullGive "$convFile" ; }
					set +e ; return 1
				fi
				AgentsToolsSlackReadBounded "$convOut" "$readErrFile" AgentsToolsSlackCheck ${conversationArgs[@]+"${conversationArgs[@]}"} || readRc=$?
				if [ "$readRc" != "0" ] && [ "$identityAsBot" = "false" ] && ! AgentsToolsCommsClientSide "$memberName" && LC_ALL=C grep -q -E 'channel_not_found|not_in_channel|thread_not_found' "$readErrFile" 2> /dev/null ; then
					cat "$readErrFile" >&2
					echo "# $MDSC_CMD --slack-read: the acting user identity cannot reach this conversation, reading once under bot identity" >&2
					readRc=0
					AgentsToolsSlackReadBounded "$convOut" "$readErrFile" AgentsToolsSlackCheck ${conversationArgs[@]+"${conversationArgs[@]}"} --identity-bot || readRc=$?
				fi
				{ cat "$readErrFile" >&2 ; rm -f "$readErrFile" ; }
				if [ -z "$convTmp" ] ; then
					[ "$readRc" != "0" ] || cat "$convOut" || readRc=1
					rm -f "$convOut"
				fi
				if [ -n "$convTmp" ] ; then
					if [ "$readRc" = "0" ] && AgentsToolsCommsCacheMerge "$convFile" "$convTmp" "${convFrom:-${readOldest:-0}}" "$convNow" "slack-conversation $channel $memberName $identityAsBot" ; then
						AgentsToolsCommsCacheServe "$convFile" "$readOldest" head || readRc=1
					else
						## The cache could not take it: the caller still gets what was read.
						[ "$readRc" != "0" ] || cat "$convTmp" || readRc=1
					fi
					rm -f "$convTmp"
					AgentsToolsCommsCachePullGive "$convFile"
				fi
				[ "$readRc" = "0" ] || { set +e ; return 1 ; }
				return 0
			fi
			if [ -n "$readOldest" ] && [ "$wantThread" != "true" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --slack-read: --oldest bounds how far back a conversation or a thread is read, and '$target' names one message -- drop --oldest, or drop the :<ts>, or add --thread" >&2
				[ -z "$readErrFile" ] || rm -f "$readErrFile"
				set +e ; return 1
			fi
			local identityArgs=() oldestArgs=()
			if [ "$identityAsBot" = "true" ] ; then
				identityArgs+=( --identity bot )
			fi
			## A thread read from a ts on (the communications reader's, F9.3): Slack returns the parent and the replies after it.
			[ -z "$readOldest" ] || oldestArgs+=( --form "oldest=$readOldest" )
			if [ "$wantThread" = "true" ] ; then
				echo "# $MDSC_CMD --slack-read: GET conversations.replies channel=$channel ts=$threadTs${readOldest:+ oldest=$readOldest} (${readOldest:+replies after it of the }full thread, acting member $memberName)" >&2
				## Slack drops a message's own metadata.event_payload from this
				## endpoint's reply unless this form field asks for it -- live-
				## verified in this workspace: event_type alone survives without
				## it, event_payload only with it.
				local threadFile="" threadErrFile=""
				mkdir -p "$MMDAPP/.local/temp" 2> /dev/null || :
				threadFile="$( mktemp "$MMDAPP/.local/temp/mdat-slack-read-thread.XXXXXX" 2> /dev/null )" || threadFile=""
				AgentsToolsTempClaim "$threadFile"
				[ -z "$threadFile" ] || threadErrFile="$( mktemp "$MMDAPP/.local/temp/mdat-slack-read-thread-err.XXXXXX" 2> /dev/null )" || threadErrFile=""
				AgentsToolsTempClaim "$threadErrFile"
				[ -n "$threadErrFile" ] || { echo "⛔ ERROR: $MDSC_CMD --slack-read: could not make a scratch file for the read in $MMDAPP/.local/temp" >&2 ; [ -z "$readErrFile" ] || rm -f "$readErrFile" ; set +e ; return 1 ; }
				AgentsToolsSlackReadBounded "$threadFile" "$threadErrFile" \
					AgentsToolsCommsSlackRun --intern-op-slack-call "$memberName" \
					--api conversations.replies \
					--resolve-target "$channel" \
					--form "ts=$threadTs" \
					--form "include_all_metadata=true" \
					${oldestArgs[@]+"${oldestArgs[@]}"} \
					${identityArgs[@]+"${identityArgs[@]}"} \
					--context "--slack-read" || readRc=$?
				if [ "$readRc" != "0" ] && [ "$identityAsBot" = "false" ] && ! AgentsToolsCommsClientSide "$memberName" && LC_ALL=C grep -q -E 'channel_not_found|not_in_channel|thread_not_found' "$threadErrFile" 2> /dev/null ; then
					cat "$threadErrFile" >&2
					echo "# $MDSC_CMD --slack-read: the acting user identity cannot reach this conversation, reading once under bot identity" >&2
					readRc=0
					AgentsToolsSlackReadBounded "$threadFile" "$threadErrFile" \
						AgentsToolsCommsSlackRun --intern-op-slack-call "$memberName" \
						--api conversations.replies \
						--resolve-target "$channel" \
						--form "ts=$threadTs" \
						--form "include_all_metadata=true" \
						${oldestArgs[@]+"${oldestArgs[@]}"} \
						--identity bot \
						--context "--slack-read" || readRc=$?
				fi
				[ -z "$readErrFile" ] || { cat "$readErrFile" >&2 ; rm -f "$readErrFile" ; }
				if [ "$readRc" != "0" ] ; then
					cat "$threadErrFile" >&2
					rm -f "$threadFile" "$threadErrFile" 2> /dev/null || :
					set +e ; return 1
				fi
				cat "$threadErrFile" >&2
				cat "$threadFile"
				rm -f "$threadFile" "$threadErrFile" 2> /dev/null || :
			else
				## ONE MESSAGE IS READ AS ONE MESSAGE. conversations.replies answers for a reply's
				## own ts, and `oldest` with `inclusive` starts its answer AT that ts, so `limit=1`
				## makes Slack return that one message plus the thread's parent. Asking for the
				## thread instead cost a whole event-track thread's body on every single-message
				## read, and a 32-minute burn on one live read (S12).
				echo "# $MDSC_CMD --slack-read: GET conversations.replies channel=$channel ts=$threadTs (single message, oldest=$threadTs inclusive limit=1, acting member $memberName)" >&2
				local response callRc=0 responseFile="" responseErrFile=""
				mkdir -p "$MMDAPP/.local/temp" 2> /dev/null || :
				responseFile="$( mktemp "$MMDAPP/.local/temp/mdat-slack-read-one.XXXXXX" 2> /dev/null )" || responseFile=""
				AgentsToolsTempClaim "$responseFile"
				[ -z "$responseFile" ] || responseErrFile="$( mktemp "$MMDAPP/.local/temp/mdat-slack-read-one-err.XXXXXX" 2> /dev/null )" || responseErrFile=""
				AgentsToolsTempClaim "$responseErrFile"
				[ -n "$responseErrFile" ] || { echo "⛔ ERROR: $MDSC_CMD --slack-read: could not make a scratch file for the read in $MMDAPP/.local/temp" >&2 ; set +e ; return 1 ; }
				AgentsToolsSlackReadBounded "$responseFile" "$responseErrFile" \
					AgentsToolsCommsSlackRun --intern-op-slack-call "$memberName" \
					--api conversations.replies \
					--resolve-target "$channel" \
					--form "ts=$threadTs" \
					--form "oldest=$threadTs" \
					--form "inclusive=true" \
					--form "limit=1" \
					--form "include_all_metadata=true" \
					${identityArgs[@]+"${identityArgs[@]}"} \
					--context "--slack-read" || callRc=$?
				if [ "$callRc" != "0" ] && [ "$identityAsBot" = "false" ] && ! AgentsToolsCommsClientSide "$memberName" && LC_ALL=C grep -q -E 'channel_not_found|not_in_channel|thread_not_found' "$responseErrFile" 2> /dev/null ; then
					cat "$responseErrFile" >&2
					echo "# $MDSC_CMD --slack-read: the acting user identity cannot reach this conversation, reading once under bot identity" >&2
					callRc=0
					AgentsToolsSlackReadBounded "$responseFile" "$responseErrFile" \
						AgentsToolsCommsSlackRun --intern-op-slack-call "$memberName" \
						--api conversations.replies \
						--resolve-target "$channel" \
						--form "ts=$threadTs" \
						--form "oldest=$threadTs" \
						--form "inclusive=true" \
						--form "limit=1" \
						--form "include_all_metadata=true" \
						--identity bot \
						--context "--slack-read" || callRc=$?
				fi
				[ -z "$readErrFile" ] || { cat "$readErrFile" >&2 ; rm -f "$readErrFile" ; }
				if [ "$callRc" != "0" ] ; then
					cat "$responseErrFile" >&2
					rm -f "$responseFile" "$responseErrFile" 2> /dev/null || :
					set +e ; return 1
				fi
				local selectStatus=0
				LC_ALL=C awk -v wantTs="$threadTs" \
					-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsHarnessJsonField.awk" \
					-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/slack/AgentsSlackMessageSelect.awk" < "$responseFile" || selectStatus=$?
				cat "$responseErrFile" >&2
				rm -f "$responseFile" "$responseErrFile" 2> /dev/null || :
				case "$selectStatus" in
					0)
					;;
					1)
						echo "⛔ ERROR: $MDSC_CMD --slack-read: COULD NOT READ $channel:$threadTs -- conversations.replies answered successfully but returned no message carrying that exact ts. This is a failed read, NOT an empty conversation: do not conclude the message is absent or unanswered from this result. Check the ts and the channel, then read again." >&2
						set +e ; return 1
					;;
					*)
						echo "⛔ ERROR: $MDSC_CMD --slack-read: COULD NOT READ $channel:$threadTs -- the conversations.replies response could not be parsed as an API response, or Slack refused it (see the selector's own error above). Nothing was read, so nothing about that message is known from this call." >&2
						set +e ; return 1
					;;
				esac
			fi
			return 0
		;;
esac
