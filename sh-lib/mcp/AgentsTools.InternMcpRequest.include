#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## One `myx.distro` MCP request, in a process of its own. Sourced from
## DistroAgentsTools.fn.sh's `--intern-mcp-request` arm, which the server in
## AgentsTools.InternMcpServer.include starts once per message it reads.
## The message is on stdin; the JSON-RPC wire is fd 3, and stdout is stderr,
## so nothing but a response frame ever reaches the wire.
## Everything this answers with is read HERE, on every request -- the tool floor,
## the identity, the access roots, the workspace context -- so an edit applies on
## the next call and nothing depends on when the server started.
## Scratch lives under the SERVER's $MMDAPP/.local/temp/agent-mcp.<server pid>/,
## written out in full at each use. set -e rules and design notes: see MAGIC.md.
##

## Bounded, and never reclaims: the holder writes to a pipe the MCP host may stop
## draining, so a timeout cannot mean it is gone. The caller drops its response.
AgentsMcpWireLockAcquire(){
	local mcpLockSpin=0 mcpLockWaited=0
	while ! mkdir "$MMDAPP/.local/temp/agent-mcp.$mcpServerPid/wire.lock" 2>/dev/null ; do
		mcpLockSpin=$(( mcpLockSpin + 1 ))
		[ 500 -le "$mcpLockSpin" ] || continue
		sleep 1
		mcpLockSpin=0
		mcpLockWaited=$(( mcpLockWaited + 1 ))
		[ 30 -le "$mcpLockWaited" ] || continue
		return 1
	done
	return 0
}

## Whether a mint of the root-harness session, read before this request, has not ended: its marker (AgentsTools.InternMcpServer.include) is there.
AgentsMcpMintPending(){
	local pendingMarker pendingSeq
	for pendingMarker in "$MMDAPP/.local/temp/agent-mcp.$mcpServerPid"/mint-pending.* ; do
		[ -e "$pendingMarker" ] || continue
		pendingSeq="${pendingMarker##*.}"
		case "$pendingSeq" in ''|*[!0123456789]*) continue ;; esac
		[ "$pendingSeq" -lt "$AGENTS_MCP_REQ_SEQ" ] && return 0
	done
	return 1
}

AgentsMcpSendResult(){
	[ -n "$1" ] || return 0
	if ! AgentsMcpWireLockAcquire ; then
		printf '%s\n' "$MDSC_CMD: mcp-request: ⛔ ERROR: wire lock not acquired after 30s -- DROPPING the response for request id $1. Another handler holds the wire and its write to the MCP host has not completed; the lock is never taken from it." >&2
		return 0
	fi
	printf '{"jsonrpc":"2.0","id":%s,"result":%s}\n' "$1" "$2" >&3
	rmdir "$MMDAPP/.local/temp/agent-mcp.$mcpServerPid/wire.lock" 2>/dev/null
	return 0
}

## mcpErrText is held: escaping forks awk, which must stay outside the lock.
AgentsMcpSendError(){
	local mcpErrText=''
	## Kept for the call's transcript line, which follows the response.
	mcpCallError="$3"
	[ -n "$1" ] || return 0
	mcpErrText="$( printf '%s' "$3" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/mcp/AgentsMcpJsonEscape.awk" )" || mcpErrText=''
	if ! AgentsMcpWireLockAcquire ; then
		printf '%s\n' "$MDSC_CMD: mcp-request: ⛔ ERROR: wire lock not acquired after 30s -- DROPPING the error response for request id $1 (code $2). Another handler holds the wire and its write to the MCP host has not completed; the lock is never taken from it." >&2
		return 0
	fi
	printf '{"jsonrpc":"2.0","id":%s,"error":{"code":%s,"message":"%s"}}\n' "$1" "$2" "$mcpErrText" >&3
	rmdir "$MMDAPP/.local/temp/agent-mcp.$mcpServerPid/wire.lock" 2>/dev/null
	return 0
}

## A tool this server lists, for BatchTools: rc 0 it serves it.
AgentsMcpBatchServes(){ ## tool name
	case "$1" in ''|*'"'*|*'\'*) return 1 ;; esac
	case "$mcpToolsListJson" in *"{\"name\":\"$1\","*) return 0 ;; esac
	return 1
}
## One call of a batch: a request of its own, exactly as this server makes one, its sequence number its own
## (a million to each request, then the call), its reply's own result text on stdout, rc 1 where the reply
## marks an error.
AgentsMcpBatchCall(){ ## tool name, arguments file, call number
	local callWire="$2.wire" callCount callAt callText="" callField="$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsHarnessJsonField.awk"
	printf '{"jsonrpc":"2.0","id":%s,"method":"tools/call","params":{"name":"%s","arguments":%s}}\n' "$3" "$1" "$( cat "$2" )" \
		| "$BASH" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh" --intern-mcp-request "$mcpServerPid" "$(( AGENTS_MCP_REQ_SEQ * 1000000 + $3 ))" 3> "$callWire" > /dev/null 2>&1
	callCount="$( LC_ALL=C awk -v path=result.content.__count -v optional=1 -f "$callField" "$callWire" 2> /dev/null )"
	case "$callCount" in
		''|*[!0123456789]*)
			callText="$( LC_ALL=C awk -v path=error.message -v optional=1 -f "$callField" "$callWire" 2> /dev/null )"
			printf 'ERROR: %s\n' "${callText:-the call gave no reply}" ; return 1
		;;
	esac
	## The tool's own result: the last text part, since a path tool's head part goes first.
	callAt=$(( callCount - 1 ))
	while [ "$callAt" -ge 0 ] ; do
		if [ "$( LC_ALL=C awk -v path="result.content.$callAt.type" -v optional=1 -f "$callField" "$callWire" 2> /dev/null )" = text ] ; then
			callText="$( LC_ALL=C awk -v path="result.content.$callAt.text" -v optional=1 -f "$callField" "$callWire" 2> /dev/null )"
			break
		fi
		callAt=$(( callAt - 1 ))
	done
	printf '%s\n' "$callText"
	[ "$( LC_ALL=C awk -v path=result.isError -v optional=1 -f "$callField" "$callWire" 2> /dev/null )" != true ] || return 1
	return 0
}

## The text of this server's own tool result -- execute, a job's poll or kill -- as a JSON
## string, finished first by the one reply layer (AgentsTranscriptReplyFinish, the session transcript
## include tools/call sources): a long result is kept in the session's folder before it is encoded, so
## the JSON carries only the reference. A harness tool is finished by the harness and never here.
AgentsMcpReplyText(){ ## tool name, result
	local replyText="$2"
	! type AgentsTranscriptReplyFinish > /dev/null 2>&1 || replyText="$( AgentsTranscriptReplyFinish "$1" "$2" )" || replyText="$2"
	printf '%s' "$replyText" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/mcp/AgentsMcpJsonEscape.awk"
}

## THE NOTICES THIS SESSION'S NEXT FOREGROUND CALL SURFACES (F3.3): one line per notice the spawn proxy
## recorded on the session's printback channel and the digest has not surfaced yet
## (AgentsToolsCommsPrintbackNoticeDigest, AgentsTools.CommsPrintback.include), as a content part of its
## own beside the result -- never inside the tool's output, which stays exactly what the tool printed.
## The digest marks each notice as delivered before this prints it, so a second call carries none. A
## server that carries no session, and a call of a batch, carries none: the batch's reply has the one.
AgentsMcpReplyNoticePart(){
	[ -z "${MDAT_REPLY_IN_BATCH:-}" ] || return 0
	[ -n "${mcpRootSessionId:-}" ] || return 0
	type AgentsToolsCommsPrintbackNoticeDigest > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.CommsPrintback.include" 2> /dev/null || return 0
	local noticePart=""
	noticePart="$( AgentsToolsCommsPrintbackNoticeDigest "$mcpRootSessionId" "${MDAT_SPAWN_AGENT:-magic-coordinator}" 2> /dev/null )" || noticePart=""
	[ -z "$noticePart" ] || printf ',{"type":"text","text":"%s"}' "$( printf '%s' "$noticePart" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/mcp/AgentsMcpJsonEscape.awk" )"
}

## What a result carries beside its own output, each as a text item of its own: the date (AgentsTranscriptReplyDate,
## the one reply layer) and the floor it prints, then the notices (AgentsMcpReplyNoticePart). Printed with their
## leading commas, for every result this server sends, a harness tool's included. A call of a batch carries none:
## the batch's reply has the one.
AgentsMcpReplyBesidePart(){
	[ -z "${MDAT_REPLY_IN_BATCH:-}" ] || return 0
	if type AgentsTranscriptReplyBeside > /dev/null 2>&1 ; then
		printf ',{"type":"text","text":"%s"}' "$( AgentsTranscriptReplyBeside | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/mcp/AgentsMcpJsonEscape.awk" )"
	fi
	AgentsMcpReplyNoticePart
}

## A notification carries no id and is never answered, so it has a sender of its own.
AgentsMcpSendNotification(){
	if ! AgentsMcpWireLockAcquire ; then
		printf '%s\n' "$MDSC_CMD: mcp-request: ⛔ ERROR: wire lock not acquired after 30s -- DROPPING the notification $1." >&2
		return 0
	fi
	printf '{"jsonrpc":"2.0","method":"%s"}\n' "$1" >&3
	rmdir "$MMDAPP/.local/temp/agent-mcp.$mcpServerPid/wire.lock" 2>/dev/null
	return 0
}

## One notifications/progress line for a call still running. The token is the raw JSON value the
## client sent (string or number). Written under the wire lock like every frame, so it is one
## whole line, and never once the stop file exists: the call's result is then about to go out,
## and no progress may follow it.
## rc 1 only when the write itself failed: the client end of the wire is gone.
AgentsMcpSendProgress(){ ## raw token, progress, stop file
	local progressRc=0
	AgentsMcpWireLockAcquire || return 0
	[ -f "$3" ] || printf '{"jsonrpc":"2.0","method":"notifications/progress","params":{"progressToken":%s,"progress":%s,"message":"still waiting"}}\n' "$1" "$2" >&3 || progressRc=1
	rmdir "$MMDAPP/.local/temp/agent-mcp.$mcpServerPid/wire.lock" 2>/dev/null
	return "$progressRc"
}

## The heartbeat of one long tools/call: a progress frame every <seconds> while <pid> runs,
## until the stop file appears. TERM only cuts its sleep short. The caller removes the stop
## file, and only after this has exited, so no frame can follow the result. A frame that
## cannot be written means the client is gone, so the call it watches is ended too, rather
## than left polling for the rest of its long bound (pid leads its own process group).
AgentsMcpProgressBeat(){ ## raw token, seconds, pid, stop file
	local beatCount=0 beatSleep=""
	trap '' PIPE
	trap '[ -z "$beatSleep" ] || kill "$beatSleep" 2>/dev/null' TERM
	while [ ! -f "$4" ] && kill -0 "$3" 2>/dev/null ; do
		sleep "$2" &
		beatSleep=$!
		wait "$beatSleep"
		beatSleep=""
		[ ! -f "$4" ] || break
		kill -0 "$3" 2>/dev/null || break
		beatCount=$(( beatCount + 1 ))
		AgentsMcpSendProgress "$1" "$beatCount" "$4" 2>/dev/null || {
			printf '%s\n' "$MDSC_CMD: mcp-request: progress frame not written, the client is gone -- ending the call it was for" >&2
			kill -TERM -- "-$3" 2>/dev/null
			break
		}
	done
	return 0
}

## The pid a job's pid file names: its first word. The file holds one line, `<pid> <start>`, the
## leader of the job's process group and when it began, as AgentsToolsRegistryProcessesBegan read it
## when the job was started, put in place together by one rename. A file written before start times
## were kept, or for a job that had ended before its start could be read, holds the pid alone.
AgentsMcpJobPid(){ ## job directory
	local jobKept=""
	[ ! -f "$1/pid" ] || IFS= read -r jobKept < "$1/pid" || :
	printf '%s\n' "${jobKept%% *}"
}

## The watchdog of one call that is waited for, a served harness tool or a script of execute: a call
## that does not come back is ended at its bound, so a wedged one cannot hold its handler for the
## process's whole life. The call leads a process group of its own (set -m) and the whole group is
## ended: TERM first, for a script with traps of its own, KILL five seconds later for what ignores
## it. The kill file is written before the first signal, and only where one is sent, so the handler
## tells a timeout from the call's own exit. ITS HANDLER ENDS IT ONLY WHILE IT HAS NOT FIRED: with the call
## that came back in time. Once the kill file is there it is left to finish, whether or not the handler has
## collected the leader, so what ignored the polite end is still ended by the hard one.
## A WATCHDOG WHOSE HANDLER WAS ENDED HARD LIVES ON, and wakes at its bound, up to hours later, with
## a number: by then the pid may be another process, and as a group it is every process of a
## stranger's group. So it keeps when the call began, read as the watchdog starts by the one reading
## a process is kept by (AgentsToolsRegistryProcessesBegan, loaded in the watchdog's own shell), and
## signals the group by its number only while its leader is still that process: at the bound, where
## the members are read too (AgentsToolsRegistryGroupBegan), and again before the KILL. Once the
## TERM has ended the leader the number is no longer the call's, and what is left is ended one
## process at a time: those members that are still the processes they were, and what they started
## since (AgentsToolsRegistryGroupLeft). Where no start can be read, nothing is signalled by the
## number alone.
AgentsMcpCallWatch(){ ## seconds, pid of the call (the leader of its process group), kill file
	local watchBegan watchMembers watchLeft
	type AgentsToolsRegistryGroupLeft > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.Registries.include" 2> /dev/null
	watchBegan="$( printf '%s\n' "$2" | AgentsToolsRegistryProcessesBegan 2> /dev/null )"
	sleep "$1"
	watchMembers="$( AgentsToolsRegistryGroupBegan "$watchBegan" 2> /dev/null )" && { : > "$3" ; kill -TERM -- "-$2" 2>/dev/null ; } || return 0
	sleep 5
	if [ "$( printf '%s\n' "$2" | AgentsToolsRegistryProcessesBegan 2> /dev/null )" = "$watchBegan" ] ; then kill -KILL -- "-$2" 2>/dev/null ; return 0 ; fi
	watchLeft="$( AgentsToolsRegistryGroupLeft "$2" "$watchMembers" 2> /dev/null )"
	[ -z "$watchLeft" ] || kill -KILL $watchLeft 2>/dev/null
	return 0
}

case "$1" in

	--intern-mcp-request)
		shift

		## Started by the server, never by hand: the server's pid names the scratch
		## root and the wire lock, and the sequence number names this request's files.
		if [ 2 -ne $# ] ; then
			printf '%s\n' "$MDSC_CMD: mcp-request: ⛔ ERROR: takes exactly <server pid> <sequence>, started by --intern-mcp-server --run only: $*" >&2
			set +e ; return 1
		fi
		## Each tested on its own, by enumerated digits: a bracket range is collation-dependent.
		for mcpNumberArg in "$1" "$2" ; do
			case "$mcpNumberArg" in
				''|*[!0123456789]*)
					printf '%s\n' "$MDSC_CMD: mcp-request: ⛔ ERROR: <server pid> and <sequence> are both numbers: '$1' '$2'" >&2
					set +e ; return 1
				;;
			esac
		done
		mcpServerPid="$1"
		AGENTS_MCP_REQ_SEQ="$2"
		shift 2

		set +e

		if [ ! -d "$MMDAPP/.local/temp/agent-mcp.$mcpServerPid" ] ; then
			printf '%s\n' "$MDSC_CMD: mcp-request: ⛔ ERROR: no server scratch root at $MMDAPP/.local/temp/agent-mcp.$mcpServerPid -- this request has no server to answer through" >&2
			return 1
		fi
		## THE SESSION THIS SERVER CARRIES (F1.2), when it carries one. RootSession keeps it in
		## this server's scratch root, one line: its id, a space, its token
		## (AgentsTools.RootSession.include, AgentsToolsRootSessionStore). Every request is a
		## process of its own, so the harness can only be told from here: AgentsHarnessSessionKey
		## reads MDAT_SPAWN_SESSION_ID first, else the client's CLAUDE_CODE_SESSION_ID, and the
		## member is resolved on the call as a spawn's is (MDAT_SPAWN_AGENT, else the root
		## session's magic-coordinator). NOTHING IS SET WHEN THERE IS NO STORE: a server that
		## carries no session answers exactly as it did before this block existed. The id is
		## held to a bare name, the gate every session folder is chosen by; the token is not
		## read, since serving that session proves nothing about adopting it.
		## A mint of the root-harness session read before this request is still pending: this request waits for it, so its profile binds this call too (epic S18.3).
		## Bounded at a minute; a mint that has not ended by then leaves the call refused (fail closed), never run ungated.
		mcpMintStuck=''
		mcpMintLeft=300
		while [ "$mcpMintLeft" -gt 0 ] && AgentsMcpMintPending ; do
			sleep 0.2
			mcpMintLeft=$(( mcpMintLeft - 1 ))
		done
		! AgentsMcpMintPending || mcpMintStuck=1
		mcpRootSessionId=''
		if [ -s "$MMDAPP/.local/temp/agent-mcp.$mcpServerPid/root-session" ] ; then
			IFS=' ' read -r mcpRootSessionId mcpRootSessionHeldToken < "$MMDAPP/.local/temp/agent-mcp.$mcpServerPid/root-session" || :
			case "$mcpRootSessionId" in
				''|.|..|*/*|*[[:space:]]*) mcpRootSessionId='' ;;
			esac
			[ -z "$mcpRootSessionId" ] || export MDAT_SPAWN_SESSION_ID="$mcpRootSessionId"
		fi
		## Its own request directory: requests are parsed in parallel now, so one shared
		## req/ would hand this request the next one's fields.
		if ! mkdir -p "$MMDAPP/.local/temp/agent-mcp.$mcpServerPid/req.$AGENTS_MCP_REQ_SEQ" ; then
			printf '%s\n' "$MDSC_CMD: mcp-request: ⛔ ERROR: cannot create request scratch directory, skipping one message" >&2
			return 1
		fi

		mcpLine="$( cat )"
		printf '%s\n' "$mcpLine" | LC_ALL=C awk -v outDir="$MMDAPP/.local/temp/agent-mcp.$mcpServerPid/req.$AGENTS_MCP_REQ_SEQ" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/mcp/AgentsMcpJsonParseRequest.awk"

		mcpMethod='' ; mcpId='' ; mcpToolName=''
		[ ! -f "$MMDAPP/.local/temp/agent-mcp.$mcpServerPid/req.$AGENTS_MCP_REQ_SEQ/method" ] || IFS= read -r mcpMethod < "$MMDAPP/.local/temp/agent-mcp.$mcpServerPid/req.$AGENTS_MCP_REQ_SEQ/method" || true
		[ ! -f "$MMDAPP/.local/temp/agent-mcp.$mcpServerPid/req.$AGENTS_MCP_REQ_SEQ/tool_name" ] || IFS= read -r mcpToolName < "$MMDAPP/.local/temp/agent-mcp.$mcpServerPid/req.$AGENTS_MCP_REQ_SEQ/tool_name" || true
		[ ! -f "$MMDAPP/.local/temp/agent-mcp.$mcpServerPid/req.$AGENTS_MCP_REQ_SEQ/has_id" ] || IFS= read -r mcpId < "$MMDAPP/.local/temp/agent-mcp.$mcpServerPid/req.$AGENTS_MCP_REQ_SEQ/id" || true
		## $(cat) not read: a script spans lines.
		mcpScript="$( cat "$MMDAPP/.local/temp/agent-mcp.$mcpServerPid/req.$AGENTS_MCP_REQ_SEQ/arg_command" 2>/dev/null || true )"
		## Optional per-call workspace override; empty means "this server's own MMDAPP", unchanged.
		mcpWorkspace="$( cat "$MMDAPP/.local/temp/agent-mcp.$mcpServerPid/req.$AGENTS_MCP_REQ_SEQ/arg_workspace" 2>/dev/null || true )"
		mcpTimeout="$( cat "$MMDAPP/.local/temp/agent-mcp.$mcpServerPid/req.$AGENTS_MCP_REQ_SEQ/arg_timeout" 2>/dev/null || true )"
		mcpBackground="$( cat "$MMDAPP/.local/temp/agent-mcp.$mcpServerPid/req.$AGENTS_MCP_REQ_SEQ/arg_background" 2>/dev/null || true )"
		mcpJob="$( cat "$MMDAPP/.local/temp/agent-mcp.$mcpServerPid/req.$AGENTS_MCP_REQ_SEQ/arg_job" 2>/dev/null || true )"
		mcpAction="$( cat "$MMDAPP/.local/temp/agent-mcp.$mcpServerPid/req.$AGENTS_MCP_REQ_SEQ/arg_action" 2>/dev/null || true )"
		mcpMergeStderr="$( cat "$MMDAPP/.local/temp/agent-mcp.$mcpServerPid/req.$AGENTS_MCP_REQ_SEQ/arg_merge_stderr" 2>/dev/null || true )"
		## RootSession's own arguments: the operation, and for adopt the id and the token mint printed.
		mcpRootSessionOp="$( cat "$MMDAPP/.local/temp/agent-mcp.$mcpServerPid/req.$AGENTS_MCP_REQ_SEQ/arg_operation" 2>/dev/null || true )"
		mcpRootSessionGiven="$( cat "$MMDAPP/.local/temp/agent-mcp.$mcpServerPid/req.$AGENTS_MCP_REQ_SEQ/arg_session" 2>/dev/null || true )"
		mcpRootSessionToken="$( cat "$MMDAPP/.local/temp/agent-mcp.$mcpServerPid/req.$AGENTS_MCP_REQ_SEQ/arg_token" 2>/dev/null || true )"
		## Where a script's stderr goes: 1 is the result (the default), 4 is the daemon side. Only an explicit false moves it.
		mcpStderrFd=1
		[ "false" != "$mcpMergeStderr" ] || mcpStderrFd=4
		## A secondary tool call: the operation, and its own positional args, parsed into files
		## by AgentsMcpJsonParseRequest.awk (arg_operation, arg_args_<n>).
		mcpSecondaryOp="$( cat "$MMDAPP/.local/temp/agent-mcp.$mcpServerPid/req.$AGENTS_MCP_REQ_SEQ/arg_operation" 2>/dev/null || true )"
		mcpSecondaryArgsCount="$( cat "$MMDAPP/.local/temp/agent-mcp.$mcpServerPid/req.$AGENTS_MCP_REQ_SEQ/arg_args_count" 2>/dev/null || true )"
		case "$mcpSecondaryArgsCount" in ''|*[!0123456789]*) mcpSecondaryArgsCount=0 ;; esac
		mcpSecondaryArgs=()
		mcpSecondaryAt=0
		while [ "$mcpSecondaryAt" -lt "$mcpSecondaryArgsCount" ] ; do
			mcpSecondaryArgs+=( "$( cat "$MMDAPP/.local/temp/agent-mcp.$mcpServerPid/req.$AGENTS_MCP_REQ_SEQ/arg_args_$mcpSecondaryAt" 2>/dev/null || true )" )
			mcpSecondaryAt=$(( mcpSecondaryAt + 1 ))
		done
		rm -rf "$MMDAPP/.local/temp/agent-mcp.$mcpServerPid/req.$AGENTS_MCP_REQ_SEQ"

		## The harness tool floor, rendered for THIS request from the same wire declarations
		## the model is offered, so a tool added, changed or removed there is served on the
		## next call. Only the two methods that use it pay for it. Nothing here is a second
		## list: AgentsHarnessMcpMirror.sh derives it, and a render that fails leaves this
		## request served by `execute` alone rather than by a floor nobody rendered.
		## Two tools are LISTED but not served: Bash, because arbitrary command execution
		## is myx.common's own method, and WorkspaceContextExecute beside it; tools/call
		## still names what to use instead, for Bash. A basic tool that
		## refuses only where it has no place to write, CheckList, stays listed like any
		## other and refuses at execution -- the floor is never made to depend on a session.
		## THE TEST WHEN A NEW HARNESS TOOL LANDS: a tool that takes a command, or that
		## hands back a handle only its own process can resolve, belongs on this list.
		## Nothing else applies it, so MAGIC.md's own `A harness tool joins the served MCP
		## floor by default` states it where a reader adding a tool will actually meet it.
		## A marker inherited from an outer copy of this server means we were reached
		## through another server: we then serve `execute` only, so enumeration cannot
		## descend through us a second time.
		## WorkspaceContextExecute is unserved beside Bash for the same reason: it runs a
		## caller-supplied script, and this server serves its own 'execute' as the twin.
		## The two are still LISTED, with a description that says they run in the harness, so the harness and this server list the same tools (AgentsHarnessUnserved.include).
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsHarnessUnserved.include"
		mcpUnservedToolNames="$( printf '%s' "$agentsUnservedOnMcp" | LC_ALL=C tr '\n' ' ' )"
		mcpUnservedEntriesJson=''
		[ -n "${MDAT_MCP_SERVED_MARKER:-}" ] || mcpUnservedEntriesJson="$( AgentsToolsUnservedMcpEntries )"
		mcpServedToolsJson=''
		case "$mcpMethod" in
			tools/list|tools/call)
				if [ -n "${MDAT_MCP_SERVED_MARKER:-}" ] ; then
					[ "tools/list" != "$mcpMethod" ] || printf '%s\n' "$MDSC_CMD: mcp-request: reached through another MCP server (MDAT_MCP_SERVED_MARKER is set) -- serving 'execute' only, and declining every harness tool, so enumeration cannot recurse through this server." >&2
				else
					## CheckList is ALWAYS served: the sketch's own line -- "No gate: no permission check
					## and no hook decides CheckList. It refuses only at execution, where it has no place
					## to write." So nothing here asks the harness whether it may be offered, and no
					## identity decides it; the tool refuses, with its own reason, when it is called and
					## there is nowhere to keep the list.
					mcpServedToolsJson="$( bash "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsHarnessMcpMirror.sh" "" "$mcpUnservedToolNames" )" || mcpServedToolsJson=''
					case "$mcpServedToolsJson" in
						'['*']')
							## The array's own brackets go: the entries are spliced ahead of `execute`.
							mcpServedToolsJson="${mcpServedToolsJson#\[}"
							mcpServedToolsJson="${mcpServedToolsJson%\]},"
						;;
						*)
							printf '%s\n' "$MDSC_CMD: mcp-request: ⛔ ERROR: the harness tool floor did not render, so ONLY 'execute' is served to this request. The mirror's own error is above; repair the declaration it names in sh-lib/harness/AgentsOpenAiChatWire.sh." >&2
							mcpServedToolsJson=''
						;;
					esac
				fi
			;;
		esac

		## The secondary tools: one per tool file that reaches outside the team's own
		## process-flow, rendered from the front table that routes them. They are this
		## server's own, so they are withheld through another server beside execute.
		mcpSecondaryToolsJson=''
		[ -n "${MDAT_MCP_SERVED_MARKER:-}" ] || mcpSecondaryToolsJson="$( bash "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/mcp/AgentsMcpSecondaryMirror.sh" )" || mcpSecondaryToolsJson=''
		case "$mcpSecondaryToolsJson" in
			'['*']')
				mcpSecondaryToolsJson="${mcpSecondaryToolsJson#\[}"
				mcpSecondaryToolsJson="${mcpSecondaryToolsJson%\]},"
			;;
			'')
			;;
			*)
				printf '%s\n' "$MDSC_CMD: mcp-request: ⛔ ERROR: the secondary tools did not render, so none is served to this request. The mirror's own error is above." >&2
				mcpSecondaryToolsJson=''
			;;
		esac

		## The server's own RootSession tool, beside execute: the one root-harness session this
		## server instance carries (AgentsTools.RootSession.include). Like the secondary tools it
		## is withheld through another server, so a nested enumeration still sees execute alone.
		mcpRootSessionToolJson=''
		[ -n "${MDAT_MCP_SERVED_MARKER:-}" ] || mcpRootSessionToolJson='{"name":"RootSession","description":"Mint, adopt or read the root-harness session this server instance carries. operation=mint mints one and returns its id, the token that proves it and where to use it; operation=adopt adopts an id with the token mint printed; operation=info returns the session this server already carries. Results name this server, never a path. Pass description to give a short description of why.","inputSchema":{"type":"object","properties":{"operation":{"type":"string","description":"Required. mint, adopt or info: mint a new session, adopt one with its id and token, or read the session this server carries."},"session":{"type":"string","description":"Optional, adopt only. The session id mint printed."},"token":{"type":"string","description":"Optional, adopt only. The token mint printed with that id; an id without its token is refused."},"description":{"type":"string","description":"Optional. One short sentence: why this call is made, what you expect from it. Recorded as your stated intent in the transcript and the tracking feed; it does not change what the tool does."}},"required":["operation"]}},'

		mcpToolsListJson='{"tools":['"$mcpServedToolsJson$mcpUnservedEntriesJson$mcpSecondaryToolsJson$mcpRootSessionToolJson"'{"name":"execute","description":"Run a shell script with the myx.distro workspace environment already set up, and return its combined stdout and stderr and its exit status. A post goes through ThisSession post, a question or a wait through AskQuestion or Wait, never through this tool. MMDAPP is the workspace root and MDLT_ORIGIN the tooling tree, which may differ. DistroAgentsTools, DistroAgentsContext, Agents, Require, Distro, Action and DistroSystemContext are defined, and variables you already set are kept. The default input tier of the workspace is selected, the one its tools pick when run directly there, so a script needing another, such as source, selects it itself. Load a tool with Require before calling it through Distro. For example: DistroSystemContext --distro-from-source ; Require ListDistroProjects ; Distro ListDistroProjects --select-all. Pass description to give a short description of why.","inputSchema":{"type":"object","properties":{"command":{"type":"string","description":"The shell script to run. May span multiple lines. Leave it out, and give job, to poll a background job."},"workspace":{"type":"string","description":"Optional. Absolute path of another myx.distro workspace, one with its own .local, to run this one call against. MMDAPP moves to it and MDLT_ORIGIN stays unchanged. Default: the workspace this server runs for."},"timeout":{"type":"integer","description":"Optional, foreground calls only. Seconds before the script is killed. Default 600, maximum 3600. On timeout the error names the file holding the partial output."},"background":{"type":"boolean","description":"Optional. true starts the script and returns at once with a job id. Use it for anything long, such as a build, deploy or sync. A background job has no timeout. Poll it with job and no command."},"job":{"type":"integer","description":"Optional. The id of a background job this server started. Give it without command to read the output since your last poll, and whether the job is still running or its exit code."},"action":{"type":"string","description":"Optional, only with job. kill stops the job. Leave it out to poll."},"merge_stderr":{"type":"boolean","description":"Optional. Default true: the script stderr is part of the result. false: it goes to the daemon log instead, so a command that needs both streams merges them itself with 2>&1."},"description":{"type":"string","description":"Optional. One short sentence: why this call is made, what you expect from it. Recorded as your stated intent in the transcript and the tracking feed; it does not change what the tool does."}},"required":[]}}]}'

		case "$mcpMethod" in
			initialize)
				AgentsMcpSendResult "$mcpId" '{"protocolVersion":"2025-06-18","capabilities":{"tools":{"listChanged":false}},"serverInfo":{"name":"myx.distro","version":"1.0.0"}}'
			;;
			notifications/*)
				## No response ever; cancelled is a no-op while nothing is tracked.
				:
			;;
			ping)
				AgentsMcpSendResult "$mcpId" '{}'
			;;
			tools/list)
				AgentsMcpSendResult "$mcpId" "$mcpToolsListJson"
			;;
			tools/call)
				mcpJobsDir="$MMDAPP/.local/temp/agent-mcp.$mcpServerPid/jobs"
				## The session transcript hooks (AgentsTools.SessionTranscript.include): each call's
				## tool line goes to the session's transcript and, with its session, to the daemon log.
				mcpCallError='' ; mcpTranscript=''
				if [ -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionTranscript.include" ] \
					&& . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionTranscript.include" 2>/dev/null ; then
					mcpTranscript=1
					agentsTranscriptT0="$( AgentsTranscriptNowMs )"
				fi

				## Membership in the floor rendered above, and only for a name that is
				## actually there. The name is matched as a whole quoted JSON value in the
				## entry's own `{"name":` envelope, and quoted in the pattern, so no
				## character a caller puts in it acts as a glob. The name arrives decoded,
				## so one carrying a quote or a backslash could end inside a later field
				## of an entry; such a name is never a tool and is never matched.
				mcpIsHarnessTool=''
				case "$mcpToolName" in
					''|*'"'*|*'\'*) ;;
					*)
						case "$mcpServedToolsJson" in
							*"{\"name\":\"$mcpToolName\","*) mcpIsHarnessTool=1 ;;
						esac
					;;
				esac
				## A tool that asks is known by its table (AgentsTools.AskPost.include): each blocks
				## on its answer as Wait does, and a second name of them, listed nowhere, is still
				## taken wherever the floor is served.
				mcpIsAskTool=''
				if [ -n "$mcpServedToolsJson" ] && . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.AskPost.include" 2>/dev/null && AgentsToolsAskToolRow "$mcpToolName" ; then
					mcpIsAskTool=1 ; mcpIsHarnessTool=1
				fi

				## A secondary tool: one per served tool file (agentsFrontSecondary), the operation
				## passed as an argument. Not a harness tool; withheld through another server by the
				## branch below, so membership alone says this name is a secondary tool.
				mcpIsSecondaryTool=''
				case "$mcpToolName" in
					''|*'"'*|*'\'*) ;;
					*)
						case " $( printf '%s' "$agentsFrontSecondary" | LC_ALL=C tr '\n' ' ' ) " in
							*" $mcpToolName "*) mcpIsSecondaryTool=1 ;;
						esac
					;;
				esac

				## Bash is listed, described as harness-only, but not served: a call that
				## names it is told where to run commands instead of being refused with
				## nothing to go on.
				## The deny rows of the routine the session runs (epic S18.3, S18.5; AgentsTools.PermissionHolds.include): the tool list is the same for everyone, and a tool a row
				## denies is refused here, at call time, with the hint that names the owner and how to ask. The root-harness session's profile is that routine's rows.
				mcpRootRefusal=''
				if [ -n "${mcpRootSessionId:-}" ] && [ "RootSession" != "$mcpToolName" ] ; then
					type AgentsToolsPermissionDenyRefusal > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.PermissionHolds.include" 2> /dev/null || :
					mcpRootRefusal="$( AgentsToolsPermissionDenyRefusal "${MDAT_SPAWN_AGENT:-magic-coordinator}" "$mcpToolName" "" "$mcpRootSessionId" 2> /dev/null )" || mcpRootRefusal=''
				fi
				if [ -n "${mcpMintStuck:-}" ] && [ "RootSession" != "$mcpToolName" ] ; then
					AgentsMcpSendError "$mcpId" -32602 "The root-harness session of this server is still being minted, so no tool is run until its profile binds; nothing was run. Call again once RootSession has answered."
				elif [ -n "$mcpRootRefusal" ] ; then
					AgentsMcpSendError "$mcpId" -32602 "$mcpRootRefusal"
				elif [ "Bash" = "$mcpToolName" ] ; then
					AgentsMcpSendError "$mcpId" -32602 "Bash is not served by this server. Use your own client's shell tool; where that is refused, use this server's own 'execute', which evaluates a shell script with the myx.distro workspace context already established."

				## BatchTools, by the one engine (AgentsTools.BatchTools.include): each call a request of its own, as
				## this server serves it alone, so a call is any tool this server lists. Its own line goes to the transcript.
				elif [ "BatchTools" = "$mcpToolName" ] && [ -z "${MDAT_MCP_SERVED_MARKER:-}" ] ; then
					mcpIsHarnessTool=''
					mcpToolArgs="$( printf '%s\n' "$mcpLine" | LC_ALL=C awk -v path="params.arguments" -v mode=raw -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsHarnessJsonField.awk" 2>/dev/null )" || mcpToolArgs=''
					[ -n "$mcpToolArgs" ] || mcpToolArgs='{}'
					if . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsTools.BatchTools.include" 2>/dev/null ; then
						mcpOutput="$( AgentsToolsBatchRun AgentsMcpBatchCall AgentsMcpBatchServes "$mcpToolArgs" )"
					else
						mcpOutput='ERROR: BatchTools: its engine is missing from this package -- nothing was run.'
					fi
					mcpIsError='false'
					case "$mcpOutput" in ERROR:*) mcpIsError='true' ;; esac
					AgentsMcpSendResult "$mcpId" "$( printf '{"content":[{"type":"text","text":"%s"}%s],"isError":%s}' "$( AgentsMcpReplyText "$mcpToolName" "$mcpOutput" )" "$( AgentsMcpReplyBesidePart )" "$mcpIsError" )"

				## Any other tool the floor rendered: run exactly that one tool in the
				## harness and return its output. The harness may leave a background
				## child, and a $( ) capture waits on the pipe's writers rather than on
				## the process -- so the output goes to a file and the pid is waited on,
				## the same shape the execute path below already uses for the same reason.
				elif [ -n "$mcpIsHarnessTool" ] ; then
					## Lifted RAW out of the request and handed over unchanged: these
					## bytes are already escaped for JSON, and escaping them again
					## corrupts every value that carried an escape.
					mcpToolArgs="$( printf '%s\n' "$mcpLine" | LC_ALL=C awk -v path="params.arguments" -v mode=raw -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsHarnessJsonField.awk" 2>/dev/null )" || mcpToolArgs=''
					[ -n "$mcpToolArgs" ] || mcpToolArgs='{}'

					mcpOutFile="$MMDAPP/.local/temp/agent-mcp.$mcpServerPid/tool.$AGENTS_MCP_REQ_SEQ"
					mcpKillFile="$MMDAPP/.local/temp/agent-mcp.$mcpServerPid/toolkilled.$AGENTS_MCP_REQ_SEQ"
					rm -f "$mcpKillFile"

					## STDOUT ONLY is the result. The harness announces the call and
					## names its hook source on stderr, and folding that in would put
					## those lines inside the file a Read returned. A path tool's request
					## and result summary come back through the .head file instead, and
					## go out as their own content part. A refusal is already
					## on stdout, as `ERROR: ...`, so nothing a caller needs is lost.
					## The bound is this server's cap rather than its default, and no
					## caller argument sets it: `timeout` belongs to Wait and to
					## the tools that ask themselves. They block by design and carry their
					## own inner bound, every other tool is quick, and each request
					## already runs in its own job -- so a long call holds its own
					## handler and never this server. The watchdog exists only so a
					## wedged call cannot hold that handler for the process's whole life.
					## WAIT ON THIS PATH. A Wait with no timeout of its own returns by a bound the
					## harness takes from MDAT_MCP_WAIT_SERVED_BOUND: MDAT_MCP_WAIT_BOUND (default
					## 1700), safely under a native client idle cutoff of about 1800s. When the call
					## carries params._meta.progressToken, a notifications/progress frame goes out
					## every MDAT_MCP_PROGRESS_SECONDS (default 60) while it runs, and the bound is
					## MDAT_MCP_WAIT_BOUND_PROGRESS (default 14400): Claude Code resets its idle
					## cutoff on each progress frame. No token, no frame, and the safe bound holds.
					## A tool that asks gets the same: it blocks on the answer through the same
					## served wait bound, in rounds that can outlast the cutoff together.
					mcpProgressToken='' ; mcpWaitBound='' ; mcpToolWatch=3600
					if [ "Wait" = "$mcpToolName" ] || [ -n "$mcpIsAskTool" ] ; then
						mcpWaitBound="${MDAT_MCP_WAIT_BOUND:-1700}"
						case "$mcpWaitBound" in ''|*[!0123456789]*) mcpWaitBound=1700 ;; esac
						mcpProgressToken="$( printf '%s\n' "$mcpLine" | LC_ALL=C awk -v path="params._meta.progressToken" -v mode=raw -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsHarnessJsonField.awk" 2>/dev/null )" || mcpProgressToken=''
						## A JSON string or an integer only, as the protocol allows.
						case "$mcpProgressToken" in
							'"'*'"') ;;
							''|*[!0123456789-]*|-|*?-*) mcpProgressToken='' ;;
						esac
						mcpProgressSeconds="${MDAT_MCP_PROGRESS_SECONDS:-60}"
						case "$mcpProgressSeconds" in ''|0|*[!0123456789]*) mcpProgressSeconds=60 ;; esac
						if [ -n "$mcpProgressToken" ] ; then
							mcpWaitBound="${MDAT_MCP_WAIT_BOUND_PROGRESS:-14400}"
							case "$mcpWaitBound" in ''|*[!0123456789]*) mcpWaitBound=14400 ;; esac
						fi
						## The watchdog outlives the bound, so it still only catches a wedged call.
						[ "$mcpWaitBound" -lt 3300 ] || mcpToolWatch=$(( mcpWaitBound + 300 ))
					fi

					mcpExitCode=0
					set -m
					( printf '%s\n' "$mcpToolArgs" | MDAT_MCP_WAIT_SERVED_BOUND="$mcpWaitBound" MDAT_MCP_RESULT_HEAD_FILE="$mcpOutFile.head" MDAT_MCP_RESULT_IMAGE_FILE="$mcpOutFile.image" "$BASH" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsUniversalHarness.sh" --intern-tool "$mcpToolName" ) > "$mcpOutFile" 3>&- &
					mcpCmdPid=$!
					AgentsMcpCallWatch "$mcpToolWatch" "$mcpCmdPid" "$mcpKillFile" 3>&- &
					mcpWatchPid=$!
					set +m
					## The heartbeat keeps fd 3: it is the one child that writes to the wire.
					mcpBeatPid='' ; mcpBeatStop="$mcpOutFile.beatstop"
					rm -f "$mcpBeatStop"
					if [ -n "$mcpProgressToken" ] ; then
						AgentsMcpProgressBeat "$mcpProgressToken" "$mcpProgressSeconds" "$mcpCmdPid" "$mcpBeatStop" &
						mcpBeatPid=$!
					fi

					wait "$mcpCmdPid" || mcpExitCode=$?
					## The watchdog is ended with a call that came back in time. One that has fired, its
					## kill file written, is left to finish: the leader it asked to end is collected here at
					## once, and what ignored that is ended five seconds on. The answer does not wait for it.
					## One ended here as it was about to fire may have left its kill file: it finishes
					## nothing, so no timeout is said for it.
					if [ ! -f "$mcpKillFile" ] ; then
						kill -TERM -- "-$mcpWatchPid" 2>/dev/null
						wait "$mcpWatchPid" 2>/dev/null
						[ ! -f "$mcpKillFile" ] || rm -f "$mcpKillFile"
					fi
					## Stopped before the result is sent: past the stop file no frame is written.
					if [ -n "$mcpBeatPid" ] ; then
						: > "$mcpBeatStop"
						kill -TERM "$mcpBeatPid" 2>/dev/null
					fi
					set +e

					mcpOutput="$( < "$mcpOutFile" )"
					mcpHead="" ; [ ! -f "$mcpOutFile.head" ] || { mcpHead="$( < "$mcpOutFile.head" )" ; rm -f "$mcpOutFile.head" ; }
					mcpIsError='false'
					if [ -f "$mcpKillFile" ] ; then
						mcpIsError='true'
						## What is known as the answer goes out: the watchdog asked the call's group to end, and
						## ends what is left of it five seconds after it asked.
						mcpOutput="$mcpOutput"$'\n'"[$mcpToolName timed out after ${mcpToolWatch}s and was asked to end; whatever of it is left is killed five seconds after that; partial output above is kept at: $mcpOutFile]"
						rm -f "$mcpKillFile"
					elif [ 0 -ne "$mcpExitCode" ] ; then
						## The harness exits non-zero on its own ERROR result, which is
						## already the text above -- so this marks it rather than
						## restating it, and names a crash where there is no text at all.
						mcpIsError='true'
						[ -n "$mcpOutput" ] || mcpOutput="[$mcpToolName produced no output and exited $mcpExitCode -- the harness's own diagnostics are on this server's stderr]"
						rm -f "$mcpOutFile"
					else
						rm -f "$mcpOutFile"
					fi
					## Every harness tool prints its own result line, so nothing at all with a
					## clean exit is a broken contract, never a quiet success.
					if [ -z "$mcpOutput" ] ; then
						mcpIsError='true'
						mcpOutput="ERROR: $mcpToolName returned nothing and exited $mcpExitCode, so whether it ran, and what it changed, is unknown. Check its effect before relying on it, then retry."
					fi

					mcpContent="{\"type\":\"text\",\"text\":\"$( printf '%s' "$mcpOutput" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/mcp/AgentsMcpJsonEscape.awk" )\"}$( AgentsMcpReplyBesidePart )"
					[ -z "$mcpHead" ] || mcpContent="{\"type\":\"text\",\"text\":\"$( printf '%s' "$mcpHead" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/mcp/AgentsMcpJsonEscape.awk" )\"},$mcpContent"
					[ ! -f "$mcpOutFile.image" ] || { IFS=$'\t' read -r mcpImageMime mcpImageData < "$mcpOutFile.image" ; rm -f "$mcpOutFile.image" ; mcpContent="$mcpContent,{\"type\":\"image\",\"data\":\"$mcpImageData\",\"mimeType\":\"$mcpImageMime\"}" ; }
					AgentsMcpSendResult "$mcpId" "{\"content\":[$mcpContent],\"isError\":$mcpIsError}"
					## After the result, so the response never waits on the last sleep of the heartbeat.
					if [ -n "$mcpBeatPid" ] ; then
						wait "$mcpBeatPid" 2>/dev/null
						rm -f "$mcpBeatStop"
					fi

				## A secondary tool: run the operation it names on the tool file it is, through the
				## same dispatcher every member call uses. The operation may fork a service client,
				## so its output goes to a file and the pid is waited on, never a $( ) capture.
				elif [ -n "$mcpIsSecondaryTool" ] ; then
					if [ -z "$mcpSecondaryOp" ] ; then
						AgentsMcpSendError "$mcpId" -32602 "$mcpToolName requires a non-empty 'operation': the operation to run, such as --slack-send-message."
					elif ! AgentsToolsFrontKnows "$mcpToolName" "$mcpSecondaryOp" ; then
						AgentsMcpSendError "$mcpId" -32602 "$mcpToolName: not an operation of that tool file, or not one: $mcpSecondaryOp"
					else
						mcpOutFile="$MMDAPP/.local/temp/agent-mcp.$mcpServerPid/tool.$AGENTS_MCP_REQ_SEQ"
						mcpKillFile="$MMDAPP/.local/temp/agent-mcp.$mcpServerPid/toolkilled.$AGENTS_MCP_REQ_SEQ"
						rm -f "$mcpKillFile"
						mcpExitCode=0
						set -m
						( DistroAgentsTools "$mcpSecondaryOp" "${mcpSecondaryArgs[@]}" ) > "$mcpOutFile" 3>&- 2>&1 &
						mcpCmdPid=$!
						AgentsMcpCallWatch 3600 "$mcpCmdPid" "$mcpKillFile" 3>&- &
						mcpWatchPid=$!
						set +m
						wait "$mcpCmdPid" || mcpExitCode=$?
						if [ ! -f "$mcpKillFile" ] ; then
							kill -TERM -- "-$mcpWatchPid" 2>/dev/null
							wait "$mcpWatchPid" 2>/dev/null
							[ ! -f "$mcpKillFile" ] || rm -f "$mcpKillFile"
						fi
						set +e
						mcpOutput="$( < "$mcpOutFile" )"
						mcpIsError='false'
						if [ -f "$mcpKillFile" ] ; then
							mcpIsError='true'
							mcpOutput="$mcpOutput"$'\n'"[$mcpToolName timed out after 3600s and was asked to end; partial output above is kept at: $mcpOutFile]"
							rm -f "$mcpKillFile"
						elif [ 0 -ne "$mcpExitCode" ] ; then
							mcpIsError='true'
							[ -n "$mcpOutput" ] || mcpOutput="[$mcpToolName produced no output and exited $mcpExitCode]"
							rm -f "$mcpOutFile"
						else
							rm -f "$mcpOutFile"
						fi
						[ -n "$mcpOutput" ] || { mcpIsError='true' ; mcpOutput="ERROR: $mcpToolName returned nothing and exited $mcpExitCode, so whether it ran, and what it changed, is unknown. Check its effect before relying on it, then retry." ; }
						AgentsMcpSendResult "$mcpId" "$( printf '{"content":[{"type":"text","text":"%s"}%s],"isError":%s}' "$( AgentsMcpReplyText "$mcpToolName" "$mcpOutput" )" "$( AgentsMcpReplyBesidePart )" "$mcpIsError" )"
					fi

				## RootSession: the one root-harness session this server instance carries, minted on
				## its first call and returned by every later one. The server owns it beside execute,
				## so it is not on the harness tool floor; the include is sourced on the call that
				## uses it, and its refusal is a tool result (`isError`), never an unknown tool.
				elif [ "RootSession" = "$mcpToolName" ] && [ -z "${MDAT_MCP_SERVED_MARKER:-}" ] ; then
					. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/mcp/AgentsTools.RootSession.include"
					mcpRootSessionRc=0
					mcpOutput="$( AgentsToolsRootSessionServe "$mcpServerPid" "$mcpRootSessionOp" "$mcpRootSessionGiven" "$mcpRootSessionToken" )" || mcpRootSessionRc=$?
					rm -f "$MMDAPP/.local/temp/agent-mcp.$mcpServerPid/mint-pending.$AGENTS_MCP_REQ_SEQ"
					mcpIsError='false'
					[ 0 -eq "$mcpRootSessionRc" ] || mcpIsError='true'
					[ -n "$mcpOutput" ] || mcpOutput='ERROR: RootSession returned nothing, so whether the session was made is unknown.'
					AgentsMcpSendResult "$mcpId" "$( printf '{"content":[{"type":"text","text":"%s"}%s],"isError":%s}' "$( AgentsMcpReplyText "$mcpToolName" "$mcpOutput" )" "$( AgentsMcpReplyBesidePart )" "$mcpIsError" )"

				## Reached through another server: say which bound refused this, because
				## the same name works on the server the host registered directly, and
				## `unknown tool` would send a caller looking for a fault that is not there.
				elif [ -n "${MDAT_MCP_SERVED_MARKER:-}" ] && [ "execute" != "$mcpToolName" ] ; then
					AgentsMcpSendError "$mcpId" -32602 "This server was reached through another MCP server, so it serves 'execute' only and declines every harness tool -- otherwise an enumeration could descend through copies of this server without end. Call '$mcpToolName' on the myx.distro server your host registered directly."

				elif [ "execute" != "$mcpToolName" ] ; then
					AgentsMcpSendError "$mcpId" -32602 "Unknown tool: $mcpToolName"

				## A job named, no command: poll or kill a script already running.
				elif [ -n "$mcpJob" ] ; then
					case "$mcpJob" in
						*[!0-9]*) AgentsMcpSendError "$mcpId" -32602 "job must be the numeric id returned by a background start: $mcpJob" ;;
						*)
							if [ ! -d "$mcpJobsDir/$mcpJob" ] ; then
								AgentsMcpSendError "$mcpId" -32602 "no such job in this server: $mcpJob"
							else
								## One line, `<pid> <start>`: the job's leader and when it began (AgentsMcpJobPid).
								mcpJobKept="$( cat "$mcpJobsDir/$mcpJob/pid" 2>/dev/null || true )"
								mcpJobPid="${mcpJobKept%% *}"
								if [ "kill" = "$mcpAction" ] ; then
									## Signals the job's whole process group: the pid is its leader, so
									## the script and everything it forked go together. TERM to the pid
									## alone kills the wrapper and leaves the real work running.
									## The file may be of any age and its pid a number the system has given
									## again, so the group of that number is this job's only while its leader
									## is still the process that began when the file says
									## (AgentsToolsRegistryProcessesBegan). Where it is not, the job has ended,
									## whoever has the number now. Where the file holds no start and a process
									## has that number, nothing shows whose it is: nothing is signalled by the
									## number alone, and the caller is told so.
									mcpIsError='false'
									type AgentsToolsRegistryProcessesBegan > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.Registries.include" 2> /dev/null
									if [ -n "$mcpJobPid" ] && [ "$( printf '%s\n' "$mcpJobPid" | AgentsToolsRegistryProcessesBegan 2> /dev/null )" = "$mcpJobKept" ] && kill -TERM -- "-$mcpJobPid" 2>/dev/null ; then
										mcpOutput="[job $mcpJob: TERM sent to process group $mcpJobPid]"
									elif [ -n "$mcpJobPid" ] && [ "$mcpJobPid" = "$mcpJobKept" ] && kill -0 "$mcpJobPid" 2>/dev/null ; then
										mcpIsError='true'
										mcpOutput="[job $mcpJob: NOT signalled. Its pid file names pid $mcpJobPid with no start time, and a process has that number now: nothing shows that it is this job, so nothing is signalled by the number alone. Check it (ps -o pid,pgid,lstart,command -p $mcpJobPid) and end it yourself if it is this job.]"
									else
										mcpOutput="[job $mcpJob: already finished, nothing to kill]"
									fi
									AgentsMcpSendResult "$mcpId" "$( printf '{"content":[{"type":"text","text":"%s"}%s],"isError":%s}' "$( AgentsMcpReplyText "$mcpToolName" "$mcpOutput" )" "$( AgentsMcpReplyBesidePart )" "$mcpIsError" )"
								else
									## Only what is NEW since the last poll, so polling a long build does
									## not re-deliver everything each time.
									mcpCursor="$( cat "$mcpJobsDir/$mcpJob/cursor" 2>/dev/null || true )"
									case "$mcpCursor" in ''|*[!0-9]*) mcpCursor=0 ;; esac
									mcpJobRunning=''
									[ -z "$mcpJobPid" ] || ! kill -0 "$mcpJobPid" 2>/dev/null || mcpJobRunning=1
									mcpJobLabel=''
									[ ! -f "$mcpJobsDir/$mcpJob/description" ] || mcpJobLabel=" ($( cat "$mcpJobsDir/$mcpJob/description" ))"
									## A running job hands out whole lines only while it runs, so no event is split
									## across two polls. The rest goes out once the job has ended.
									if [ -n "$mcpJobLabel" ] && [ -n "$mcpJobRunning" ] ; then
										tail -c "+$(( mcpCursor + 1 ))" "$mcpJobsDir/$mcpJob/out" > "$mcpJobsDir/$mcpJob/lines.$AGENTS_MCP_REQ_SEQ" 2>/dev/null
										mcpLineCount="$( LC_ALL=C tr -cd '\n' < "$mcpJobsDir/$mcpJob/lines.$AGENTS_MCP_REQ_SEQ" | wc -c | tr -d ' ' )"
										mcpOutput=''
										## BSD head refuses -n 0, so no whole line means no read at all.
										if [ 0 -lt "${mcpLineCount:-0}" ] ; then
											mcpOutput="$( head -n "$mcpLineCount" "$mcpJobsDir/$mcpJob/lines.$AGENTS_MCP_REQ_SEQ" )"
											printf '%s\n' "$(( mcpCursor + $( head -n "$mcpLineCount" "$mcpJobsDir/$mcpJob/lines.$AGENTS_MCP_REQ_SEQ" | wc -c ) ))" > "$mcpJobsDir/$mcpJob/cursor"
										fi
										rm -f "$mcpJobsDir/$mcpJob/lines.$AGENTS_MCP_REQ_SEQ"
									else
										tail -c "+$(( mcpCursor + 1 ))" "$mcpJobsDir/$mcpJob/out" > "$mcpJobsDir/$mcpJob/lines.$AGENTS_MCP_REQ_SEQ" 2>/dev/null
										mcpOutput="$( < "$mcpJobsDir/$mcpJob/lines.$AGENTS_MCP_REQ_SEQ" )"
										printf '%s\n' "$(( mcpCursor + $( wc -c < "$mcpJobsDir/$mcpJob/lines.$AGENTS_MCP_REQ_SEQ" ) ))" > "$mcpJobsDir/$mcpJob/cursor"
										rm -f "$mcpJobsDir/$mcpJob/lines.$AGENTS_MCP_REQ_SEQ"
									fi

									## rc is written by the job itself, so its absence on a job no longer
									## running is a real distinction and never reported as an exit code.
									if [ -n "$mcpJobRunning" ] ; then
										mcpOutput="$mcpOutput"$'\n'"[job $mcpJob$mcpJobLabel: still running, pid $mcpJobPid -- poll again for more]"
									elif [ -f "$mcpJobsDir/$mcpJob/rc" ] ; then
										mcpOutput="$mcpOutput"$'\n'"[job $mcpJob$mcpJobLabel: finished, exit code $( cat "$mcpJobsDir/$mcpJob/rc" )]"
									elif [ -f "$mcpJobsDir/$mcpJob/timedout" ] ; then
										mcpOutput="$mcpOutput"$'\n'"[job $mcpJob$mcpJobLabel: timed out after $( cat "$mcpJobsDir/$mcpJob/timedout" )ms and was killed]"
									else
										mcpOutput="$mcpOutput"$'\n'"[job $mcpJob$mcpJobLabel: stopped before it could finish -- killed, or died without recording an exit code]"
									fi
									[ -n "$mcpOutput" ] || mcpOutput='(no new output)'
									AgentsMcpSendResult "$mcpId" "$( printf '{"content":[{"type":"text","text":"%s"}%s],"isError":false}' "$( AgentsMcpReplyText "$mcpToolName" "$mcpOutput" )" "$( AgentsMcpReplyBesidePart )" )"
								fi
							fi
						;;
					esac

				elif [ -z "$mcpScript" ] ; then
					AgentsMcpSendError "$mcpId" -32602 "execute requires a non-empty 'command' argument, or a 'job' id to poll or kill"
				elif [ -n "$mcpWorkspace" ] && [ ! -d "$mcpWorkspace/.local" ] ; then
					AgentsMcpSendError "$mcpId" -32602 "workspace has no .local, not a set-up myx.distro workspace: $mcpWorkspace"
				## Starts and returns at once, with a job id to poll and to kill by.
				## No timeout is imposed: a bound is what a foreground call needs,
				## because nothing can watch it, and a job the caller can see needs none.
				elif [ "true" = "$mcpBackground" ] ; then
					mcpJobId="$AGENTS_MCP_REQ_SEQ"
					mkdir -p "$mcpJobsDir/$mcpJobId"
					: > "$mcpJobsDir/$mcpJobId/out"
					printf '0\n' > "$mcpJobsDir/$mcpJobId/cursor"
					mcpErrFile="$mcpJobsDir/$mcpJobId/out"

					## set -m puts the job in a process group of its own, so the recorded
					## $! is its leader and one signal reaches everything the script forked.
					## The whole pipeline goes inside the subshell for that: with a bare
					## pipeline, $! is its LAST process and the group id is its first.
					set -m
					if [ -n "$mcpWorkspace" ] ; then
						(
							mcpJobRc=0
							exec 4>&2
							if [ "false" = "$mcpMergeStderr" ] ; then exec 5>&4 ; else exec 5>> "$mcpErrFile" ; fi
							printf '%s\n' "$mcpScript" | ( exec "$BASH" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh" --intern-mcp-execute --workspace "$mcpWorkspace" ) >> "$mcpJobsDir/$mcpJobId/out" 4>&2 2>&5 5>&- || mcpJobRc=$?
							printf '%s\n' "$mcpJobRc" > "$mcpJobsDir/$mcpJobId/rc"
						) 3>&- &
					else
						(
							mcpJobRc=0
							exec 4>&2
							if [ "false" = "$mcpMergeStderr" ] ; then exec 5>&4 ; else exec 5>> "$mcpErrFile" ; fi
							printf '%s\n' "$mcpScript" | DistroAgentsTools --intern-mcp-execute >> "$mcpJobsDir/$mcpJobId/out" 4>&2 2>&5 5>&- || mcpJobRc=$?
							printf '%s\n' "$mcpJobRc" > "$mcpJobsDir/$mcpJobId/rc"
						) 3>&- &
					fi
					mcpJobPid=$!
					set +m
					## Kept with when it began, read here as the job starts, and put in place with the
					## pid by one rename (the directory is this request's alone): the kill action signals
					## the group of that number only while its leader is still that process.
					type AgentsToolsRegistryProcessesBegan > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.Registries.include" 2> /dev/null
					mcpJobKept="$( printf '%s\n' "$mcpJobPid" | AgentsToolsRegistryProcessesBegan 2> /dev/null )"
					printf '%s\n' "${mcpJobKept:-$mcpJobPid}" > "$mcpJobsDir/$mcpJobId/pid.aside" && mv -f "$mcpJobsDir/$mcpJobId/pid.aside" "$mcpJobsDir/$mcpJobId/pid"

					mcpOutput="[job $mcpJobId started, pid $mcpJobPid]"$'\n'"[poll it:  $mcpToolName with job=$mcpJobId]"$'\n'"[stop it:  $mcpToolName with job=$mcpJobId action=kill]"$'\n'"[log file: $mcpJobsDir/$mcpJobId/out]"
					AgentsMcpSendResult "$mcpId" "$( printf '{"content":[{"type":"text","text":"%s"}%s],"isError":false}' "$( AgentsMcpReplyText "$mcpToolName" "$mcpOutput" )" "$( AgentsMcpReplyBesidePart )" )"

				else
					## Seconds. A non-numeric or absent value takes the default rather than
					## failing the call, so a caller that never knew this argument exists
					## keeps working; the cap stops one call holding the server for an hour.
					case "$mcpTimeout" in
						''|*[!0-9]*) mcpTimeout=600 ;;
						*) [ "$mcpTimeout" -ge 1 ] 2>/dev/null || mcpTimeout=600 ;;
					esac
					[ "$mcpTimeout" -le 3600 ] || mcpTimeout=3600

					mcpOutFile="$MMDAPP/.local/temp/agent-mcp.$mcpServerPid/out.$AGENTS_MCP_REQ_SEQ"
					mcpKillFile="$MMDAPP/.local/temp/agent-mcp.$mcpServerPid/killed.$AGENTS_MCP_REQ_SEQ"
					rm -f "$mcpKillFile"

					## Both forks run under set -m, each in a process group of its own, so
					## one signal reaches the whole tree and the watchdog's own sleep dies
					## with it. Pipeline inside the subshell so $! is the group leader.
					mcpExitCode=0
					set -m
					if [ -n "$mcpWorkspace" ] ; then
						( printf '%s\n' "$mcpScript" | ( exec "$BASH" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh" --intern-mcp-execute --workspace "$mcpWorkspace" ) ) > "$mcpOutFile" 4>&2 2>&$mcpStderrFd 3>&- &
					else
						( printf '%s\n' "$mcpScript" | DistroAgentsTools --intern-mcp-execute ) > "$mcpOutFile" 4>&2 2>&$mcpStderrFd 3>&- &
					fi
					mcpCmdPid=$!

					## Marks the kill before sending it, so the wait below tells a timeout
					## from the script's own non-zero exit; TERM first for a script with
					## traps of its own, KILL after a grace period for one that ignores it.
					AgentsMcpCallWatch "$mcpTimeout" "$mcpCmdPid" "$mcpKillFile" 3>&- &
					mcpWatchPid=$!
					set +m

					wait "$mcpCmdPid" || mcpExitCode=$?
					## Ended with a script that came back in time; left to finish once it has fired, as above.
					if [ ! -f "$mcpKillFile" ] ; then
						kill -TERM -- "-$mcpWatchPid" 2>/dev/null
						wait "$mcpWatchPid" 2>/dev/null
						[ ! -f "$mcpKillFile" ] || rm -f "$mcpKillFile"
					fi
					set +e

					mcpOutput="$( < "$mcpOutFile" )"

					mcpIsError='false'
					if [ -f "$mcpKillFile" ] ; then
						## The partial output is kept and its path named: a timeout is when
						## the caller most needs to see how far the command got.
						mcpIsError='true'
						mcpOutput="$mcpOutput"$'\n'"[timed out after ${mcpTimeout}s and was asked to end; whatever of it is left is killed five seconds after that; partial output above is kept at: $mcpOutFile]"
						rm -f "$mcpKillFile"
					elif [ 0 -ne "$mcpExitCode" ] ; then
						mcpIsError='true'
						mcpOutput="$mcpOutput"$'\n'"[exit code: $mcpExitCode]"
						rm -f "$mcpOutFile"
					else
						rm -f "$mcpOutFile"
					fi
					[ -n "$mcpOutput" ] || mcpOutput='(no output)'

					AgentsMcpSendResult "$mcpId" "$( printf '{"content":[{"type":"text","text":"%s"}%s],"isError":%s}' "$( AgentsMcpReplyText "$mcpToolName" "$mcpOutput" )" "$( AgentsMcpReplyBesidePart )" "$mcpIsError" )"
				fi
				## After the response: the tool line of every call but a harness tool, whose
				## served harness writes its own -- execute, and every refusal here.
				[ -z "$mcpTranscript" ] || [ -n "$mcpIsHarnessTool" ] \
					|| AgentsTranscriptMcpCallDone "$mcpToolName" "$mcpLine" "${mcpOutput:-}" "${mcpIsError:-false}" "$mcpCallError" >&2 || :
			;;
			'')
				AgentsMcpSendError "$mcpId" -32700 "Parse error"
			;;
			*)
				AgentsMcpSendError "$mcpId" -32601 "Method not found: $mcpMethod"
			;;
		esac
		return 0
	;;

	*)
		printf '%s\n' "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;

esac
