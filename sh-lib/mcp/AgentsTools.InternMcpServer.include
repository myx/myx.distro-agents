#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## The `myx.distro` MCP stdio server. Sourced from DistroAgentsTools.fn.sh's
## `--intern-mcp-server` arm; needs $1/$@/$MDSC_CMD from dot-sourcing.
## A launcher and nothing more: it holds MMDAPP and MDLT_ORIGIN, reads one message
## at a time, and starts `--intern-mcp-request` for each in a fresh process, which
## reads everything else -- the tool floor, identity, access, workspace context --
## on that call. Nothing a request is answered from depends on when this started.
## stdout is the JSON-RPC wire, handed to each request as its fd 3; every
## diagnostic goes to stderr. Every scratch file lives under the scratch root of this server,
## `agent-mcp.<pid>` in the calling session's output folder where it has one, the workspace's
## .local/temp otherwise, written out in full at each use.
## set -e rules, portability floor and design notes: see MAGIC.md.
##


case "$1" in

	--intern-mcp-server)
		shift

		## Never serve without --run: an accidental stdin loop hangs forever.
		if [ "--run" != "$1" ] ; then
			printf '%s\n' "$MDSC_CMD --intern-mcp-server -- MCP stdio server registered as 'myx.distro'." >&2
			printf '%s\n' "" >&2
			printf '%s\n' "  $MDSC_CMD --intern-mcp-server --run" >&2
			printf '%s\n' "      Speak JSON-RPC 2.0 over stdin/stdout until stdin closes." >&2
			printf '%s\n' "      Launched by an MCP host, not by hand." >&2
			printf '%s\n' "" >&2
			printf '%s\n' "Exposes 'execute', backed by $MDSC_CMD --intern-mcp-execute, plus the" >&2
			printf '%s\n' "harness tool floor rendered by sh-lib/harness/AgentsHarnessMcpMirror.sh and run one" >&2
			printf '%s\n' "call at a time by sh-lib/harness/AgentsUniversalHarness.sh --intern-tool. Bash is not" >&2
			printf '%s\n' "among them: a caller runs commands with its own shell tool, or 'execute'." >&2
			set +e ; return 1
		fi
		shift

		if [ 0 -lt $# ] ; then
			printf '%s\n' "$MDSC_CMD: mcp-server --run: ⛔ ERROR: takes no further arguments: $*" >&2
			set +e ; return 1
		fi

		set +e

		## MMDAPP is frozen into the host registration at install time.
		if [ ! -d "$MMDAPP/.local" ] ; then
			printf '%s\n' "$MDSC_CMD: mcp-server: ⛔ ERROR: MMDAPP is not a set-up myx.distro workspace: $MMDAPP -- the MCP host registration freezes this path at install time and it no longer resolves. Re-run DistroAgentsTools.fn.sh --make-workspace-integrations from that workspace to rewrite it." >&2
			return 1
		fi

		## The scratch root of this server: the calling session's output folder where it has one, the workspace's
		## .local/temp otherwise (MAGIC.md, "Scratch paths").
		mcpScratchBase="$MMDAPP/.local/temp"
		[ -z "${MDAT_SPAWN_SANDBOX_ROOT:-}" ] || mcpScratchBase="$MDAT_SPAWN_SANDBOX_ROOT/output"
		mcpScratchRoot="$mcpScratchBase/agent-mcp.$$"
		rm -rf "$mcpScratchRoot"
		if ! mkdir -p "$mcpScratchRoot" ; then
			printf '%s\n' "$MDSC_CMD: mcp-server: ⛔ ERROR: cannot create scratch directory $mcpScratchRoot" >&2
			return 1
		fi
		AGENTS_MCP_REQ_SEQ=0
		## NO REQUEST OUTLIVES ITS SERVER (S12.3), as the myx.common server has it: each request handler is kept in flight as
		## `<pid> <start>` under inflight/, and the server's end signals each that is still the process it kept, what it started
		## first, deepest first, then the handler. A background job a call detached is a process of the session, not of a request: it
		## is kept under jobs/ and is not in flight here.
		mkdir -p "$mcpScratchRoot/inflight" 2> /dev/null || :
		type AgentsToolsRegistryProcessesBegan > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.Registries.include" 2> /dev/null || :
		## Every pid below one, deepest first: a grandchild a request forked goes with it. One ps a level, at the end alone.
		AgentsToolsMcpServerEndDescendants(){ ## pid
			local endChild
			## The children are read a line each, whatever the field separator of this shell is at the end: a trap runs with the one the loop left.
			while IFS= read -r endChild ; do
				case "$endChild" in ''|*[!0-9]*) continue ;; esac
				AgentsToolsMcpServerEndDescendants "$endChild"
			done <<< "$( ps -ax -o pid=,ppid= 2> /dev/null | LC_ALL=C awk -v parent="$1" '$2 == parent { print $1 }' )"
			kill -TERM "$1" 2> /dev/null || :
		}
		## Ends every request still in flight: one kept as `<pid> <start>`, signalled only while its pid is still the process that began then.
		AgentsToolsMcpServerEndInflight(){
			local endFile endPid endBegan endNow
			[ -d "$mcpScratchRoot/inflight" ] || return 0
			for endFile in "$mcpScratchRoot/inflight"/* ; do
				[ -f "$endFile" ] || continue
				IFS=' ' read -r endPid endBegan < "$endFile" 2> /dev/null || continue
				case "$endPid" in ''|*[!0-9]*) continue ;; esac
				endNow="$( printf '%s\n' "$endPid" | AgentsToolsRegistryProcessesBegan 2> /dev/null )"
				[ -n "$endNow" ] && [ "$endNow" = "$endPid $endBegan" ] || continue
				AgentsToolsMcpServerEndDescendants "$endPid"
			done
		}
		## A signal ends the server: removing the scratch root and reading on would leave
		## every later request with nowhere to answer from, and the host waiting on it.
		trap 'AgentsToolsMcpServerEndInflight ; rm -rf "$mcpScratchRoot"' EXIT
		trap 'exit 130' INT
		trap 'exit 143' TERM

		## The tool list of this run, rendered once, now: every request reads this copy (AgentsTools.McpToolList.include), so it is the same for the whole run.
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/mcp/AgentsTools.McpToolList.include"
		AgentsToolsMcpToolListRender "$mcpScratchRoot/tools.d" || printf '%s\n' "$MDSC_CMD: mcp-server: ⛔ ERROR: the tool list of this run could not be rendered; each request will say so" >&2

		## Check-init witness; stderr only.
		printf '%s\n' "# myx.distro agentMcp: pid=$$ origin=$MDLT_ORIGIN root=$MMDAPP scratch=$mcpScratchRoot -- every request is served by a fresh --intern-mcp-request" >&2

		## `|| [ -n ... ]` keeps a final line that has no trailing newline.
		while IFS= read -r mcpLine || [ -n "$mcpLine" ] ; do
			[ -n "$mcpLine" ] || continue
			AGENTS_MCP_REQ_SEQ=$(( AGENTS_MCP_REQ_SEQ + 1 ))
			## A mint of the root-harness session is marked pending as its line is read, before any later request starts; a request that arrives meanwhile waits for it.
			case "$mcpLine" in
				*'"RootSession"'*) case "$mcpLine" in *'"mint"'*) : > "$mcpScratchRoot/mint-pending.$AGENTS_MCP_REQ_SEQ" ;; esac ;;
			esac
			## THE SESSION THE CLIENT NAMES AT ITS HANDSHAKE (owner 2026-10-31) is kept here, in the order the messages are
			## read, so the next request of this server already carries it: every request is a process of its own, and one of
			## them writing it would race the request that follows.
			case "$mcpLine" in
				*'"method":"initialize"'*'"sessionId":"'*)
					mcpNamedSession="$( printf '%s\n' "$mcpLine" | LC_ALL=C sed -n 's/.*"sessionId":"\([A-Za-z0-9._-]*\)".*/\1/p' | head -1 )"
					case "$mcpNamedSession" in
						''|.|..) ;;
						*) printf '%s\n' "$mcpNamedSession" > "$mcpScratchRoot/client-session" 2>/dev/null || : ;;
					esac
				;;
			esac
			## One process per message, so a slow request delays only its own response
			## and the next message is read at once. What this shell derived at start
			## from configuration is dropped first -- the team-data root, MYXROOT and
			## the distro index state -- so the request resolves them again, now.
			## MMDAPP and the origin pair stay, and so does the skillset root: it is
			## the one a caller may hand in (every rig does), it names a directory
			## rather than a setting, and the members inside it are read per call.
			## The message goes in on stdin; the wire goes in as fd 3 and the
			## request's own stdout is stderr, so nothing it or anything it runs
			## prints can land on the wire.
			(
				unset MDAT_DATA_ROOT MYXROOT MDSC_OPTION MDSC_INMODE MDSC_SOURCE MDSC_CACHED MDSC_OUTPUT MDSC_MEMORY
				for mcpStaleIndex in ${!MDSC_ID*} ; do unset "$mcpStaleIndex" ; done
				printf '%s\n' "$mcpLine" | exec "$BASH" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh" --intern-mcp-request "$$" "$AGENTS_MCP_REQ_SEQ" 3>&1 1>&2
			) < /dev/null &
			## The handler is kept in flight with when it began, so the end signals this process and never a later one of the same number.
			printf '%s\n' "$!" | AgentsToolsRegistryProcessesBegan 2> /dev/null > "$mcpScratchRoot/inflight/$AGENTS_MCP_REQ_SEQ" || :
		done
		wait

		rm -rf "$mcpScratchRoot"
		trap - EXIT INT TERM
		return 0
	;;

	*)
		printf '%s\n' "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;

esac
