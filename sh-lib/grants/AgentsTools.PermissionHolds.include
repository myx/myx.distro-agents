#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.PermissionHolds.include -- what a member HOLDS, computed by tooling only.
##
## A permission is <tool>:<target>. The tool is Read, Edit, Write or Execute with a path
## or a <path>/** pattern; any other tool name with an optional target (WebFetch with a
## URL prefix written <prefix>*, WebSearch, Agent); cred with a secret's name; spend with
## a budget or target. A member holds one through the first of these layers that has it:
##
##   human-owner  holds everything. His accounts: the name itself, and the team's
##                configured SLACK_CHANNEL_HUMAN_OWNER account.
##   floor        (a) every member: the team tools below, and the floor rows the grants index
##                holds for it (AgentsTools.Grants.include: .local/temp/**, the source docs,
##                the readable member directories, the reference roots), with its session's
##                own sandbox and this origin's skillset added here.
##   standing     (b) the member's own rows in the grants index, every row declared for `*`
##                unrolled there: a write row (allow-write, Edit(...) in the registry) is every
##                file tool on its glob; a read row (allow-read) the read tools only; a tool
##                row is <tool>[:<target>].
##   ceiling      no file tool writes in a read-only place, through any layer.
##   routine      the `access-control:` of the routine the session runs, for that session only
##                (AgentsToolsPermissionRoutineHolds).
##   set, planned, passed, granted -- (c), (d), (e): grants of a session or a task in the
##                session store (AgentsToolsPermissionGrantScan), never `once` ones.
##
## A routine's allow and a session or task grant to Edit or Write a path read it too -- Read,
## Grep and Glob, never the other way (AgentsToolsGrantsToolCovers, AgentsTools.Grants.include).
##
## cred and spend are held by the human-owner only, unless a session or task grant, or the
## allows of a routine the human-owner maintains, names them: no floor or standing layer
## ever does.
##
## Sourced, never run. Functions only.
##

## THE TEAM FLOOR'S TOOLS: the one place they are named.
agentsPermissionFloorTools=" Skill SendMessage Wait SubagentHandback AskUserQuestion AskQuestion ConfirmReadback EscalateDecision RequestPermission ProposeApprove ToolSearch ListAgents TaskOutput TaskStop PushNotification SessionTranscriptAppend ReportFindings ListMcpResourcesTool ReadMcpResourceTool ReadMcpResourceDirTool "
## The file tools a path permission speaks for, and the ones of them that only read.
agentsPermissionFileTools=" Read Edit Write Execute Grep Glob "
agentsPermissionReadTools=" Read Grep Glob "
## THE TOOLS AN ENTRY OF A PERMISSION NAMES: the one place they are listed. Every name a gate
## asks this model about, or that it gives a meaning of its own: the file tools; the native
## client's own of them, MultiEdit and NotebookEdit, which its hook decides as Edit, and its
## Bash, whose target is the command; WebFetch and Artifact, which the harness asks a grant
## for, with WebSearch and Agent, each held by its name; cred and spend, the human-owner's
## unless granted. A tool a gate comes to ask about is one more word here.
agentsPermissionEntryTools=" Read Grep Glob Edit Write MultiEdit NotebookEdit Execute Bash WebFetch WebSearch Agent Artifact cred spend "
## The board states an item is still open in; a task grant lives only while its item does.
agentsPermissionOpenStates="running review blocked pending backlog parked"
## HOW MANY CALLS ASKED ALONE the human-owner answers for one session and one task: the one
## place the number stands. Once he has answered that many, the next call of that session for
## that task is not asked alone: it goes back to its asker, to be asked with everything else
## the task still needs, as one Permission set (--intern-op-permission-single-asks).
agentsPermissionSingleAsks=1

## Whether a permission entry may name a tool: one of the list above; a tool of the team
## floor, which every member holds already; or a tool of an MCP server, named by its own
## name, `mcp__<server>__<tool>`, and on no list. Taken as written: `read` is no tool.
AgentsToolsPermissionEntryToolKnown(){ ## tool name
	case "$1" in
		''|*[[:space:]]*) return 1 ;;
		mcp__?*__?*) return 0 ;;
	esac
	case "$agentsPermissionEntryTools$agentsPermissionFloorTools" in
		*" $1 "*) return 0 ;;
	esac
	return 1
}

## True for the human-owner, by name, by his configured Slack account, or by the account at the
## console mapped to him (HUMAN_OWNER_CONSOLE_ACCOUNT): the person at that console IS the owner
## there, so a verdict only he gives -- a review, a held change, a proposal -- is his own, and
## what he holds is everything, as his own name holds.
AgentsToolsPermissionIsHumanOwner(){ ## who
	local ownerAccount
	case "$1" in
		human-owner) return 0 ;;
		''|magic-*|keeper-*|partner-*|client-*) return 1 ;;
	esac
	## The console mapping, read by the one reader of it. A person's name is `user-<account>`,
	## so only such a name asks it; no member name ever does.
	case "$1" in
		user-*)
			type AgentsToolsAuthorityOwnerNamed > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.Authority.include"
			AgentsToolsAuthorityOwnerNamed "$1" && return 0
		;;
	esac
	ownerAccount="$( DistroAgentsTools --agents-config-option magic-team --select SLACK_CHANNEL_HUMAN_OWNER 2>/dev/null )" || ownerAccount=""
	[ -n "$ownerAccount" ] && [ "$ownerAccount" = "$1" ] && return 0
	return 1
}

## A CONTACT AS A GRANTEE (F7.10): `contact:<id>`, the id of a person of the contacts store (DistroAgentsContacts.fn.sh), is the owner of a
## refusal logged for what a contact asked, and the holder a chain question about a contact is asked of. The one place such a name is
## read; it is allowed only where a grantee enters the chain (the refusal log, grant-open, grant-read), and nowhere a member is named.
## AgentsToolsPermissionContactId prints the id of a name of that form (rc 2: not of that form, rc 1: an id that is none);
## AgentsToolsPermissionContactRecord prints the path of the contact's record (rc 1: no such contact is recorded).
AgentsToolsPermissionContactId(){ ## name
	local contactId
	case "$1" in contact:?*) contactId="${1#contact:}" ;; *) return 2 ;; esac
	case "$contactId" in -*|*[!abcdefghijklmnopqrstuvwxyz0123456789-]*) return 1 ;; esac
	[ "${#contactId}" -le 64 ] || return 1
	printf '%s' "$contactId"
}
AgentsToolsPermissionContactRecord(){ ## name
	local recordId
	recordId="$( AgentsToolsPermissionContactId "$1" )" || return 1
	[ -n "${MDAT_DATA_ROOT:-}" ] && [ -f "$MDAT_DATA_ROOT/contacts/persons/$recordId.md" ] || return 1
	printf '%s' "$MDAT_DATA_ROOT/contacts/persons/$recordId.md"
}
## The name of a refusal's owner or of a grantee: a bare name, or a contact that is recorded.
AgentsToolsPermissionGranteeAssert(){ ## name, label, context
	case "$1" in
		contact:*)
			AgentsToolsPermissionContactRecord "$1" > /dev/null || {
				echo "$MDSC_CMD: $3: ❗ ASSERT: $2 names a contact that is not recorded (contact:<id> of the contacts store, DistroAgentsContacts.fn.sh --find-contact): $1" >&2
				return 1
			}
		;;
		*) AgentsToolsAssertBareName "$1" "$2" "$3" ;;
	esac
}
## The standing grants of a contact: the entries of the `allows:` of its record, `contact:<tool>:<target>:<granted-by>:<time>`, comma-separated, the
## way a task's are of its board item. Prints each as a TAB-separated row "<tool> <natural target> <granted by> <time>". rc 1 for no record.
AgentsToolsPermissionContactAllowsList(){ ## contact:<id>
	local listFile listAllows listEntry listRest listTool listTarget listBy listTime
	listFile="$( AgentsToolsPermissionContactRecord "$1" )" || return 1
	listAllows="$( AgentsToolsPermissionField "$listFile" allows )"
	while [ -n "$listAllows" ] ; do
		listEntry="${listAllows%%,*}"
		if [ "$listEntry" != "$listAllows" ] ; then listAllows="${listAllows#*,}" ; else listAllows="" ; fi
		listEntry="${listEntry# }"
		[ "${listEntry%%:*}" = "contact" ] || continue
		listRest="${listEntry#*:}"
		listTool="${listRest%%:*}" ; listRest="${listRest#*:}"
		listTarget="${listRest%%:*}" ; listRest="${listRest#*:}"
		listBy="${listRest%%:*}" ; listTime="${listRest#*:}"
		[ -n "$listTool" ] && [ -n "$listTarget" ] && [ -n "$listBy" ] || continue
		printf '%s\t%s\t%s\t%s\n' "$listTool" "$( AgentsToolsPermissionUnescape "$listTarget" )" "$listBy" "$listTime"
	done
}
## Whether a contact's standing grants cover a call, as far as their signer holds what they name: prints "contact <id>" and rc 0, else rc 1.
AgentsToolsPermissionContactAllows(){ ## contact:<id>, tool, wanted target
	local allowTool allowTarget allowBy allowTime
	type AgentsToolsGrantsToolCovers > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.Grants.include"
	while IFS=$'\t' read -r allowTool allowTarget allowBy allowTime ; do
		[ -n "$allowTool" ] || continue
		AgentsToolsGrantsToolCovers "$allowTool" "$2" || continue
		AgentsToolsPermissionCovers "$allowTarget" "$3" || continue
		AgentsToolsPermissionHolds "$allowBy" "$allowTool" "$allowTarget" > /dev/null || continue
		printf 'contact %s' "${1#contact:}"
		return 0
	done <<< "$( AgentsToolsPermissionContactAllowsList "$1" )"
	return 1
}
## The member a post about a refusal or a grant is made as: the owner, and for a contact the member whose session it happens in.
AgentsToolsPermissionPoster(){ ## owner
	local posterMember
	case "$1" in
		contact:*)
			type AgentsToolsActingMember > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.CallerCheck.include"
			posterMember="$( AgentsToolsActingMember )"
			printf '%s' "${posterMember:-magic-coordinator}"
		;;
		*) printf '%s' "$1" ;;
	esac
}

## A grants field back to its natural value (AgentsToolsPermissionEscape's inverse, for
## the characters a pattern can carry).
AgentsToolsPermissionUnescape(){ ## grants-field value
	local unValue="$1"
	unValue="${unValue//%3A/:}"
	unValue="${unValue//%2C/,}"
	unValue="${unValue//%25/%}"
	printf '%s' "$unValue"
}

## A refusal record's target back to its natural value, as AgentsHarnessRefusedTargetDecode reads it.
AgentsToolsPermissionRecordDecode(){ ## record-form value
	local decValue="$1"
	decValue="${decValue//%0A/$'\n'}"
	decValue="${decValue//%0D/$'\r'}"
	decValue="${decValue//%20/ }"
	decValue="${decValue//%09/$'\t'}"
	decValue="${decValue//%25/%}"
	printf '%s' "$decValue"
}

## Whether a held target covers a wanted one: the same text; empty, * or ** for any;
## <path>/** for that path and everything under it; a URL prefix written <prefix>* for
## every URL starting with it. Nothing else is a pattern, so a command ending in * is
## only ever itself. A wanted pattern is covered when it lies inside the held one, and a
## wanted target with a .. segment is never covered by a pattern.
AgentsToolsPermissionCovers(){ ## held target, wanted target
	local coverHave="$1" coverWant="$2" coverPrefix
	case "$coverHave" in
		''|'*'|'**') return 0 ;;
	esac
	[ "$coverHave" != "$coverWant" ] || return 0
	case "$coverWant" in
		*/../*|*/..|../*|..) return 1 ;;
	esac
	case "$coverHave" in
		*/'**')
			coverPrefix="${coverHave%/\*\*}"
			[ "$coverWant" != "$coverPrefix" ] || return 0
			case "$coverWant" in
				"$coverPrefix"/*) return 0 ;;
			esac
		;;
		*://*'*')
			coverPrefix="${coverHave%\*}"
			case "$coverWant" in
				"$coverPrefix"*) return 0 ;;
			esac
		;;
	esac
	return 1
}

## The floor's file roots for one member that the grants index cannot hold, one absolute path
## per line: with a session, the output/ of that session's own sandbox, where its spawn record
## is the member's, and for reading its input/ too and this origin's own skillset. The rest of
## the floor is in the grants index (AgentsTools.Grants.include), as the member's floor rows.
AgentsToolsPermissionFloorRoots(){ ## workspace, member, read|write, session id (optional)
	local floorWs="$1" floorMember="$2" floorPurpose="$3" floorSession="${4:-}" floorRecord floorDir
	[ -n "$floorWs" ] && [ -n "$floorMember" ] || return 0
	case "$floorSession" in
		''|*/*|.|..) ;;
		*)
			for floorRecord in "$floorWs/.local/agents/spawned"/*/"$floorSession.spawn.md" ; do
				[ -f "$floorRecord" ] || continue
				[ "$( AgentsToolsPermissionField "$floorRecord" owner )" = "$floorMember" ] || continue
				floorDir="${floorRecord%/*}"
				printf '%s\n' "$floorDir/output"
				[ "$floorPurpose" != "read" ] || printf '%s\n' "$floorDir/input"
			done
		;;
	esac
	[ "$floorPurpose" = "read" ] || return 0
	[ -z "${MDLT_ORIGIN:-}" ] || printf '%s\n' "$MDLT_ORIGIN/myx/myx.distro-agents/skillset"
	return 0
}

## The member's own rows of the grants index -- its standing rows, every row declared for
## `*` among them, and its floor rows -- as "<verb>\t<glob or tool text>\t<pattern>\t<layer>".
AgentsToolsPermissionStandingRows(){ ## member
	type AgentsToolsGrantsMemberRows > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.Grants.include"
	AgentsToolsGrantsMemberRows "${MMDAPP:-}" "$1" 2>/dev/null || :
}

## The member's own deny rows from project.inf: rc 0 where one covers the call, printing `standing-deny`.
## deny-write takes away Edit and Write on its glob, deny-read Read, Grep and Glob, deny-tool the tool it names.
## All denies together override all allows together.
AgentsToolsPermissionStandingDenied(){ ## member, tool, natural target
	local denyVerb denyGlob denyPattern denyLayer denyRowTool denyRowTarget
	while IFS=$'\t' read -r denyVerb denyGlob denyPattern denyLayer ; do
		[ -n "$denyGlob" ] || continue
		case "$denyVerb" in
			deny-tool)
				denyRowTool="${denyGlob%%:*}" ; denyRowTarget=""
				case "$denyGlob" in *:*) denyRowTarget="${denyGlob#*:}" ;; esac
				[ "$denyRowTool" = "$2" ] || continue
				AgentsToolsPermissionCovers "$denyRowTarget" "$3" || continue
			;;
			deny-write)
				case " Edit Write " in *" $2 "*) ;; *) continue ;; esac
				AgentsToolsGrantsCovers "$denyGlob" "$denyPattern" "$3" || continue
			;;
			deny-read)
				case "$agentsPermissionReadTools" in *" $2 "*) ;; *) continue ;; esac
				AgentsToolsGrantsCovers "$denyGlob" "$denyPattern" "$3" || continue
			;;
			*) continue ;;
		esac
		printf 'standing-deny'
		return 0
	done <<< "$( AgentsToolsPermissionStandingRows "$1" )"
	return 1
}

## True while an item is on the board in an open state.
AgentsToolsPermissionItemOpen(){ ## item name
	local openName="${1##*/}" openState
	openName="${openName%.md}"
	[ -n "$openName" ] && [ -n "${MDAT_DATA_ROOT:-}" ] || return 1
	for openState in $agentsPermissionOpenStates ; do
		[ ! -f "$MDAT_DATA_ROOT/board/$openState/$openName.md" ] || return 0
	done
	return 1
}

## One front-matter field of a record, or empty.
AgentsToolsPermissionField(){ ## file, field
	local fieldLine fieldFront=""
	[ -f "$1" ] || return 0
	while IFS= read -r fieldLine ; do
		case "$fieldFront:$fieldLine" in
			':---') fieldFront=1 ;;
			'1:---') return 0 ;;
			"1:$2: "*) printf '%s' "${fieldLine#"$2: "}" ; return 0 ;;
			'1:# '*) return 0 ;;
		esac
	done < "$1"
	return 0
}

## The store a grant for a session's participants is written to: the coworking session it
## joined, from its spawn record, else the session's own. Every participant reads it
## (AgentsToolsPermissionRelatedStores), and a member it spawned reads it as its parent's.
AgentsToolsPermissionShareStore(){ ## session id
	local shareRecord shareSession=""
	case "$1" in ''|*/*|.|..) return 0 ;; esac
	for shareRecord in "${MMDAPP:-}/.local/agents/spawned"/*/"$1.spawn.md" ; do
		[ -f "$shareRecord" ] || continue
		shareSession="$( AgentsToolsPermissionField "$shareRecord" session-id )"
		break
	done
	case "$shareSession" in ''|*/*|.|..) shareSession="$1" ;; esac
	printf '%s' "$shareSession"
}

## The session stores a session's grants are read from, one id per line, each once: its
## own, the coworking session's it joined, and the parent session's that spawned it (where
## a member passing part of its job on keeps what it passed). Every grant in them is still
## the reading member's own only.
AgentsToolsPermissionRelatedStores(){ ## session id
	local relRecord relCow="" relParent=""
	case "$1" in ''|*/*|.|..) return 0 ;; esac
	for relRecord in "${MMDAPP:-}/.local/agents/spawned"/*/"$1.spawn.md" ; do
		[ -f "$relRecord" ] || continue
		relCow="$( AgentsToolsPermissionField "$relRecord" session-id )"
		relParent="$( AgentsToolsPermissionField "$relRecord" parent-spawn-id )"
		break
	done
	printf '%s\n' "$1" "$relCow" "$relParent" | LC_ALL=C awk 'NF && $0 !~ /\// && $0 != "." && $0 != ".." && !seenStore[$0]++ { print ; }'
}

## Whether an Allow once opened at <time>, the grants line's own UTC stamp (YYYYMMDDTHHMMZ,
## or YYYYMMDDTHHMMSSZ), is still live: one never used lapses MDAT_PERMISSION_ONCE_TTL
## seconds after it was opened (whole seconds, default 300), for reads and writes alike,
## and is then absent. A stamp that cannot be read is a lapsed one.
AgentsToolsPermissionOnceLive(){ ## grant time
	local liveTtl="${MDAT_PERMISSION_ONCE_TTL:-300}" liveStamp="$1" liveIso liveAt liveNow
	case "$liveTtl" in ''|*[!0123456789]*) liveTtl=300 ;; esac
	[ "$liveTtl" -gt 0 ] || liveTtl=300
	case "${#liveStamp}" in
		14) liveIso="${liveStamp:0:4}-${liveStamp:4:2}-${liveStamp:6:2}T${liveStamp:9:2}:${liveStamp:11:2}:00Z" ;;
		16) liveIso="${liveStamp:0:4}-${liveStamp:4:2}-${liveStamp:6:2}T${liveStamp:9:2}:${liveStamp:11:2}:${liveStamp:13:2}Z" ;;
		*) return 1 ;;
	esac
	[ "${liveStamp:8:1}" = T ] && [ "${liveStamp:$(( ${#liveStamp} - 1 ))}" = Z ] || return 1
	case "${liveStamp:0:8}${liveStamp:9:$(( ${#liveStamp} - 10 ))}" in *[!0123456789]*) return 1 ;; esac
	liveAt="$( printf '%s\n' "$liveIso" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/output/LocalIsoToEpoch.awk" 2>/dev/null )" || return 1
	liveNow="$( date -u +%s )" || return 1
	case "$liveAt$liveNow" in ''|*[!0123456789]*) return 1 ;; esac
	[ $(( liveNow - liveAt )) -le "$liveTtl" ]
}

## The first live grant of one session store for this member, tool and target, printed
## as "<kind> <ref>". use: a `once` grant still unconsumed and inside its TTL counts too;
## hold: it never does.
## A grant answering a refusal matches its exact target; a passed or set grant matches by
## AgentsToolsPermissionCovers. Every grant is the member's own (its record's owner),
## signed by someone else; a task grant lives while its item is open, a session grant while
## its store's session runs, and none once revoked. A session or task grant to Edit or Write
## speaks for a read of its target too (AgentsToolsGrantsToolCovers); a once for its own tool.
## item-runs: the store is one of the member's other runs on the same board item, read for its
## session grants, which end as the caller checked (AgentsToolsPermissionItemRunsScan), not
## with that run, and for its task grants. item-runs-task: for its task grants alone, what
## those runs share for the session having ended.
AgentsToolsPermissionGrantScan(){ ## session dir, member, tool, natural target, use|hold|item-runs|item-runs-task, store a once is used up in (default: the session dir)
	local scanDir="$1" scanMember="$2" scanTool="$3" scanWant="$4" scanMode="$5" scanConsumed="${6:-$1}"
	local scanEntry scanKind scanRest scanEntryTool scanEntryTarget scanBy scanTime scanRef scanWantEsc scanTask
	[ -f "$scanDir/grants" ] || return 1
	type AgentsToolsGrantsToolCovers > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.Grants.include"
	scanWantEsc="$( AgentsToolsPermissionEscape "$scanWant" )"
	while IFS= read -r scanEntry ; do
		scanKind="${scanEntry%%:*}" ; scanRest="${scanEntry#*:}"
		scanEntryTool="${scanRest%%:*}" ; scanRest="${scanRest#*:}"
		scanEntryTarget="${scanRest%%:*}" ; scanRest="${scanRest#*:}"
		scanBy="${scanRest%%:*}" ; scanRest="${scanRest#*:}"
		scanTime="${scanRest%%:*}"
		scanRef="${scanRest#*:}"
		AgentsToolsGrantsToolCovers "$scanEntryTool" "$scanTool" || continue
		[ -n "$scanBy" ] && [ "$scanBy" != "$scanMember" ] || continue
		case "$scanRef" in
			''|*/*|.|..) continue ;;
		esac
		[ -f "$scanDir/$scanRef.md" ] || continue
		[ "$( AgentsToolsPermissionField "$scanDir/$scanRef.md" owner )" = "$scanMember" ] || continue
		## Revoked: a marker beside its record (--revoke-permission).
		[ ! -e "$scanDir/revoked/$scanRef" ] || continue
		case "$scanRef" in
			refusal-*) [ "$scanEntryTarget" = "$scanWantEsc" ] || continue ;;
			*) AgentsToolsPermissionCovers "$( AgentsToolsPermissionUnescape "$scanEntryTarget" )" "$scanWant" || continue ;;
		esac
		case "$scanKind" in
			session)
				## A session grant ends with the session whose store holds it.
				[ "$scanMode" != "item-runs-task" ] || continue
				if [ "$scanMode" != "item-runs" ] ; then
					type AgentsToolsGrantsSessionEnded > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.Grants.include"
					! AgentsToolsGrantsSessionEnded "$scanDir" || continue
				fi
			;;
			once)
				[ "$scanMode" = "use" ] && [ "$scanEntryTool" = "$scanTool" ] || continue
				[ ! -d "$scanConsumed/consumed/$scanRef" ] || continue
				AgentsToolsPermissionOnceLive "$scanTime" || continue
			;;
			task)
				scanTask="$( AgentsToolsPermissionField "$scanDir/$scanRef.md" task )"
				[ -n "$scanTask" ] || { [ ! -f "$scanDir/$scanRef.task" ] || IFS= read -r scanTask < "$scanDir/$scanRef.task" || : ; }
				AgentsToolsPermissionItemOpen "$scanTask" || continue
			;;
			*) continue ;;
		esac
		printf '%s %s\n' "$scanKind" "$scanRef"
		return 0
	done < "$scanDir/grants"
	return 1
}

## The first live session or task grant a member holds through another run of its own on the
## same board item in the same coworking session, printed as "<kind> <ref>": a review return or
## a resume starts the run again under a new id. What was allowed it for the session holds
## until the item is closed or that session ends (AgentsToolsGrantsItemRuns); what was allowed
## it for a task holds while the item that grant names is open, as in the run it was given to.
## rc 1 for none.
AgentsToolsPermissionItemRunsScan(){ ## member, tool, natural target, session id
	local runsDir runsFound runsMode=item-runs
	[ -n "$1" ] && [ -n "$4" ] && [ -n "${MMDAPP:-}" ] || return 1
	type AgentsToolsGrantsItemRuns > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.Grants.include"
	AgentsToolsGrantsItemRuns "${MMDAPP%/}" "$4" "$1" || return 1
	AgentsToolsGrantsItemRunsLive "$agentsGrantsItemRunsItem" "$agentsGrantsItemRunsSession" || runsMode=item-runs-task
	while IFS= read -r runsDir ; do
		[ -n "$runsDir" ] || continue
		runsFound="$( AgentsToolsPermissionGrantScan "$runsDir" "$1" "$2" "$3" "$runsMode" )" || continue
		printf '%s\n' "$runsFound"
		return 0
	done <<< "$agentsGrantsItemRunsStores"
	return 1
}

## The layer a scanned grant came from, by its reference.
AgentsToolsPermissionGrantLayer(){ ## ref
	case "$1" in
		set-*) printf 'set' ;;
		pass-*) printf 'passed' ;;
		*) printf 'granted' ;;
	esac
}

## The routine a session runs: the `routine:` its spawn record was written with, else the
## one of the coworking session it joined. A routine file's basename, or empty.
AgentsToolsPermissionSessionRoutine(){ ## session id
	local srSession="$1" srRecord srCow="" srRoutine=""
	case "$srSession" in ''|*/*|.|..) return 0 ;; esac
	for srRecord in "${MMDAPP:-}/.local/agents/spawned"/*/"$srSession.spawn.md" ; do
		[ -f "$srRecord" ] || continue
		srRoutine="$( AgentsToolsPermissionField "$srRecord" routine )"
		srCow="$( AgentsToolsPermissionField "$srRecord" session-id )"
		break
	done
	## A root-harness session has no spawn record: the routine its mint kept in its folder is the one it runs.
	if [ -z "$srRoutine" ] && [ -z "$srCow" ] ; then
		type AgentsToolsRootHarnessRoutineRead > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.RootHarnessKind.include" 2> /dev/null || :
		srRoutine="$( AgentsToolsRootHarnessRoutineRead "$srSession" 2> /dev/null )" || srRoutine=""
	fi
	if [ -z "$srRoutine" ] && [ -n "$srCow" ] && [ "$srCow" != "$srSession" ] ; then
		case "$srCow" in
			*/*|.|..) ;;
			*)
				for srRecord in "${MMDAPP:-}/.local/agents/spawned"/*/"$srCow.spawn.md" ; do
					[ -f "$srRecord" ] || continue
					srRoutine="$( AgentsToolsPermissionField "$srRecord" routine )"
					break
				done
			;;
		esac
	fi
	case "$srRoutine" in
		*.routine.md) ;;
		*) srRoutine="" ;;
	esac
	case "$srRoutine" in */*) srRoutine="" ;; esac
	printf '%s' "$srRoutine"
}

## The routine's `access-control:` line: comma-separated rows `<member|executors|participants>:<verb>:<value>`.
## Verbs: allow-read, allow-write, allow-tool and the deny twins. A path value is a glob; a tool value is `<tool>[:<target>]`.
## Prints the rows of one kind as `<who>:<tool>[:<target>]`: write is Edit and Write, read is Read, Grep and Glob. A malformed row is left out.
AgentsToolsPermissionAccessEntries(){ ## access-control value, allow|deny
	local accRest="${1:-}" accKind="${2:-}" accRow accWho accVerb accValue accEntry accOut=""
	while [ -n "$accRest" ] ; do
		accRow="${accRest%%,*}"
		if [ "$accRow" != "$accRest" ] ; then accRest="${accRest#*,}" ; else accRest="" ; fi
		accRow="${accRow#"${accRow%%[![:space:]]*}"}" ; accRow="${accRow%"${accRow##*[![:space:]]}"}"
		case "$accRow" in *:*:*) ;; *) continue ;; esac
		accWho="${accRow%%:*}" ; accRow="${accRow#*:}"
		accVerb="${accRow%%:*}" ; accValue="${accRow#*:}"
		[ -n "$accWho" ] && [ -n "$accValue" ] || continue
		case "$accVerb" in
			"$accKind"-tool) accEntry="$accWho:$accValue" ;;
			"$accKind"-write) accEntry="$accWho:Edit:$accValue,$accWho:Write:$accValue" ;;
			"$accKind"-read) accEntry="$accWho:Read:$accValue,$accWho:Grep:$accValue,$accWho:Glob:$accValue" ;;
			*) continue ;;
		esac
		accOut="$accOut${accOut:+,}$accEntry"
	done
	printf '%s' "$accOut"
}

## The routine layer: while a session runs a routine, that routine's frontmatter `access-control:` allow rows
## grant its participants (AgentsToolsPermissionAccessEntries), a target escaped as a tracking document's is and a relative path taken from the
## workspace. Only a participant of the session is granted; `executors` are the routine's
## own executors among them (magic-team or * there: every participant). A routine changes
## only with all its maintainers agreeing, so its allows count as approved by them: with
## human-owner among them every entry stands; without, a cred or spend entry is ignored and
## any other is honoured only when one maintainer holds it, else ignored, said on stderr.
## An entry to Edit or Write a path reads it too (AgentsToolsGrantsToolCovers).
## Prints "routine <routine-name>" and returns 0, or returns 1.
AgentsToolsPermissionRoutineHolds(){ ## member, tool, natural target, session id
	local rhMember="$1" rhTool="$2" rhWant="$3" rhSession="$4" rhRoutine rhFile="" rhMember2 rhDir rhLine
	local rhExecutors="" rhMaintainers="" rhAllows="" rhEntry rhWho rhRest rhEntryTool rhEntryTarget rhOne rhApproved rhParticipants=""
	[ -n "$rhMember" ] && [ -n "$rhTool" ] && [ -n "$rhSession" ] && [ -n "${MMDAPP:-}" ] || return 1
	rhRoutine="$( AgentsToolsPermissionSessionRoutine "$rhSession" )"
	[ -n "$rhRoutine" ] || return 1
	## The routine file by its exact name, in every member's folder.
	type AgentsToolsTeamMemberDirectoryText > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.TeamRegistry.include"
	type AgentsToolsGrantsToolCovers > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.Grants.include"
	while IFS=$'\t' read -r rhMember2 rhDir ; do
		[ -n "$rhDir" ] && [ -f "$rhDir/$rhRoutine" ] || continue
		rhFile="$rhDir/$rhRoutine"
		break
	done <<< "$( AgentsToolsTeamMemberDirectoryText 2>/dev/null )"
	[ -n "$rhFile" ] || return 1
	while IFS= read -r rhLine ; do
		case "$rhLine" in
			'executors: '*) rhExecutors="${rhLine#executors: }" ;;
			'maintainers: '*) rhMaintainers="${rhLine#maintainers: }" ;;
			'access-control: '*) rhAllows="$( AgentsToolsPermissionAccessEntries "${rhLine#access-control: }" allow )" ;;
		esac
	done <<< "$( LC_ALL=C awk -v headers="executors"$'\034'"maintainers"$'\034'"access-control" \
		-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsBoardItemFrontmatterPrintSelected.awk" "$rhFile" 2>/dev/null )"
	[ -n "$rhAllows" ] || return 1
	rhExecutors=" $( printf '%s' "$rhExecutors" | LC_ALL=C tr ',\t' '  ' ) "
	rhMaintainers=" $( printf '%s' "$rhMaintainers" | LC_ALL=C tr ',\t' '  ' ) "
	while [ -n "$rhAllows" ] ; do
		rhEntry="${rhAllows%%,*}"
		if [ "$rhEntry" != "$rhAllows" ] ; then rhAllows="${rhAllows#*,}" ; else rhAllows="" ; fi
		rhEntry="${rhEntry#"${rhEntry%%[![:space:]]*}"}" ; rhEntry="${rhEntry%"${rhEntry##*[![:space:]]}"}"
		case "$rhEntry" in *:*) ;; *) continue ;; esac
		rhWho="${rhEntry%%:*}" ; rhRest="${rhEntry#*:}"
		rhEntryTool="${rhRest%%:*}" ; rhEntryTarget=""
		case "$rhRest" in *:*) rhEntryTarget="$( AgentsToolsPermissionUnescape "${rhRest#*:}" )" ;; esac
		AgentsToolsGrantsToolCovers "$rhEntryTool" "$rhTool" || continue
		## A relative path is the workspace's.
		case "$agentsPermissionFileTools" in
			*" $rhEntryTool "*)
				case "$rhEntryTarget" in
					''|'*'|'**'|/*) ;;
					*) rhEntryTarget="${MMDAPP%/}/$rhEntryTarget" ;;
				esac
			;;
		esac
		AgentsToolsPermissionCovers "$rhEntryTarget" "$rhWant" || continue
		## Who: the member named, the routine's executors, or every participant -- in this session.
		case "$rhWho" in
			participants) ;;
			executors)
				case "$rhExecutors" in
					*" $rhMember "*|*" magic-team "*|*" * "*) ;;
					*) continue ;;
				esac
			;;
			*) [ "$rhWho" = "$rhMember" ] || continue ;;
		esac
		[ -n "$rhParticipants" ] || rhParticipants="$( AgentsToolsPermissionParticipants "$rhSession" "" )"
		printf '%s\n' "$rhParticipants" | LC_ALL=C grep -q -x -F -- "$rhMember" || continue
		## Approved by its maintainers.
		case "$rhMaintainers" in
			*" human-owner "*) ;;
			*)
				case "$rhEntryTool" in
					cred|spend)
						echo "⚠️ WARNING: routine ${rhRoutine%.md}: access-control row $rhEntry is ignored: a $rhEntryTool row needs human-owner among its maintainers" >&2
						continue
					;;
				esac
				rhApproved=""
				for rhOne in $rhMaintainers ; do
					AgentsToolsPermissionHolds "$rhOne" "$rhEntryTool" "$rhEntryTarget" > /dev/null || continue
					rhApproved="$rhOne"
					break
				done
				if [ -z "$rhApproved" ] ; then
					echo "⚠️ WARNING: routine ${rhRoutine%.md}: access-control row $rhEntry is ignored: none of its maintainers holds it" >&2
					continue
				fi
			;;
		esac
		printf 'routine %s' "${rhRoutine%.md}"
		return 0
	done
	return 1
}

## The routine layer's DENY: while a session runs a routine, the deny rows of its frontmatter `access-control:` (deny-read, deny-write, deny-tool,
## AgentsToolsPermissionAccessEntries) revoke from its participants. A deny wins over every allow, the routine's own and any other layer's included: a member
## a deny row names, with a target that covers the call, does not hold it, whatever another layer grants (AgentsToolsPermissionHolds). The human-owner is
## never refused. Prints "routine-deny <routine-name>" and returns 0 where denied, else 1.
AgentsToolsPermissionRoutineDenies(){ ## member, tool, natural target, session id
	local dnMember="$1" dnTool="$2" dnWant="$3" dnSession="$4" dnRoutine dnFile="" dnMember2 dnDir dnLine
	local dnExecutors="" dnDenies="" dnEntry dnWho dnRest dnEntryTool dnEntryTarget dnParticipants=""
	[ -n "$dnMember" ] && [ -n "$dnTool" ] && [ -n "$dnSession" ] && [ -n "${MMDAPP:-}" ] || return 1
	dnRoutine="$( AgentsToolsPermissionSessionRoutine "$dnSession" )"
	[ -n "$dnRoutine" ] || return 1
	type AgentsToolsTeamMemberDirectoryText > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.TeamRegistry.include"
	type AgentsToolsGrantsToolCovers > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.Grants.include"
	while IFS=$'\t' read -r dnMember2 dnDir ; do
		[ -n "$dnDir" ] && [ -f "$dnDir/$dnRoutine" ] || continue
		dnFile="$dnDir/$dnRoutine"
		break
	done <<< "$( AgentsToolsTeamMemberDirectoryText 2>/dev/null )"
	[ -n "$dnFile" ] || return 1
	while IFS= read -r dnLine ; do
		case "$dnLine" in
			'executors: '*) dnExecutors="${dnLine#executors: }" ;;
			'access-control: '*) dnDenies="$( AgentsToolsPermissionAccessEntries "${dnLine#access-control: }" deny )" ;;
		esac
	done <<< "$( LC_ALL=C awk -v headers="executors"$'\034'"access-control" \
		-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsBoardItemFrontmatterPrintSelected.awk" "$dnFile" 2>/dev/null )"
	[ -n "$dnDenies" ] || return 1
	dnExecutors=" $( printf '%s' "$dnExecutors" | LC_ALL=C tr ',\t' '  ' ) "
	while [ -n "$dnDenies" ] ; do
		dnEntry="${dnDenies%%,*}"
		if [ "$dnEntry" != "$dnDenies" ] ; then dnDenies="${dnDenies#*,}" ; else dnDenies="" ; fi
		dnEntry="${dnEntry#"${dnEntry%%[![:space:]]*}"}" ; dnEntry="${dnEntry%"${dnEntry##*[![:space:]]}"}"
		case "$dnEntry" in *:*) ;; *) continue ;; esac
		dnWho="${dnEntry%%:*}" ; dnRest="${dnEntry#*:}"
		dnEntryTool="${dnRest%%:*}" ; dnEntryTarget=""
		case "$dnRest" in *:*) dnEntryTarget="$( AgentsToolsPermissionUnescape "${dnRest#*:}" )" ;; esac
		[ "$dnEntryTool" = "$dnTool" ] || continue
		case "$agentsPermissionFileTools" in
			*" $dnEntryTool "*)
				case "$dnEntryTarget" in
					''|'*'|'**'|/*) ;;
					*) dnEntryTarget="${MMDAPP%/}/$dnEntryTarget" ;;
				esac
			;;
		esac
		AgentsToolsPermissionCovers "$dnEntryTarget" "$dnWant" || continue
		case "$dnWho" in
			participants) ;;
			executors)
				case "$dnExecutors" in
					*" $dnMember "*|*" magic-team "*|*" * "*) ;;
					*) continue ;;
				esac
			;;
			*) [ "$dnWho" = "$dnMember" ] || continue ;;
		esac
		[ -n "$dnParticipants" ] || dnParticipants="$( AgentsToolsPermissionParticipants "$dnSession" "" )"
		printf '%s\n' "$dnParticipants" | LC_ALL=C grep -q -x -F -- "$dnMember" || continue
		printf 'routine-deny %s' "${dnRoutine%.md}"
		return 0
	done
	return 1
}

## The first live session or task grant that covers a call, printed as `<kind> <ref>`: a grant of an
## approved set, which is the owner's own word and which a standing deny row (project.inf) does not
## take away. A routine's deny rows still win over it. rc 1 where none covers the call.
AgentsToolsPermissionSetCovers(){ ## member, tool, natural target, session id
	local setcMember="$1" setcTool="$2" setcTarget="$3" setcSession="${4:-}" setcStore setcFound
	[ -n "$setcMember" ] && [ -n "$setcTool" ] && [ -n "$setcSession" ] && [ -n "${MMDAPP:-}" ] || return 1
	case "$setcSession" in */*|.|..) return 1 ;; esac
	while IFS= read -r setcStore ; do
		[ -n "$setcStore" ] || continue
		if setcFound="$( AgentsToolsPermissionGrantScan "$MMDAPP/.local/agents/sessions/$setcStore" "$setcMember" "$setcTool" "$setcTarget" hold )" ; then
			printf '%s' "$setcFound"
			return 0
		fi
	done <<< "$( AgentsToolsPermissionRelatedStores "$setcSession" )"
	return 1
}

## The refusal of a call a routine's deny rows cover: rc 0 and the hint printed (the tool, the routine whose rows deny it, who owns the limit and how to ask),
## rc 1 and nothing printed where no deny row covers the call. The name of the tool is the caller's own word and is printed back only if it is a plain name.
## With `record` as its fifth word the refusal is recorded and its id printed under the hint, so the member can ask
## for the call by that id. The harness records its own, and passes nothing here.
AgentsToolsPermissionDenyRefusal(){ ## member, tool, natural target, session id, record (optional)
	local denyLayer denyName denyTool="${2:-}" denyWhy denyId="" denyTools
	case "$denyTool" in ''|*[!A-Za-z0-9_]*) denyTool="this call" ;; esac
	## CheckList has no gate (sketch 3.4): no permission row decides it. It refuses only at execution, where it has no place to write.
	[ "$denyTool" != "CheckList" ] || return 1
	if denyLayer="$( AgentsToolsPermissionRoutineDenies "${1:-}" "${2:-}" "${3:-}" "${4:-}" 2> /dev/null )" ; then
		denyName="${denyLayer#routine-deny }"
		denyWhy="the access-control rows of its routine $denyName"
	elif AgentsToolsPermissionStandingDenied "${1:-}" "${2:-}" "${3:-}" > /dev/null 2>&1 ; then
		## The run's own session folder is its sandbox (epic 20261026 S8 item 2): a read there, such as a result the tooling kept and named, is never denied.
		case "${2:-}:${3:-}" in
			Read:"$MMDAPP/.local/agents/sessions/${4:-.}/"*|Grep:"$MMDAPP/.local/agents/sessions/${4:-.}/"*|Glob:"$MMDAPP/.local/agents/sessions/${4:-.}/"*) [ -z "${4:-}" ] || return 1 ;;
		esac
		## An approved set's grant is the owner's own word, and outranks a standing deny row.
		AgentsToolsPermissionSetCovers "${1:-}" "${2:-}" "${3:-}" "${4:-}" > /dev/null && return 1
		denyWhy="a deny row declared for ${1:-} in project.inf"
	else
		return 1
	fi
	printf 'ERROR: %s is denied to this session by %s. The owner of the limit is the human-owner; to ask for it, call RequestPermission naming the tool and why, or hand the work to a session that has it. Nothing was done.\n' "$denyTool" "$denyWhy"
	## The id RequestPermission takes: a denial the member sees is a refusal it can escalate.
	[ "${5:-}" != record ] || {
		denyTools="$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
		case "${1:-}:${4:-}" in
			:*|*:) printf 'REFUSAL-ID: none -- this session has no team identity or session id, so the refusal was not recorded and cannot be escalated by id.\n' ; return 0 ;;
		esac
		denyId="$( "$BASH" "$denyTools" --intern-op-permission-refusal-log "${1}" --session-id "${4}" --tool "${2}" --target "${3}" --reason "denied by $denyWhy" 2> /dev/null | LC_ALL=C sed -n 's/^\(refusal-[0-9a-f-]*\)$/\1/p' | head -1 )"
		case "$denyId" in
			refusal-*) printf 'REFUSAL-ID: %s\n' "$denyId" ;;
			*) printf 'REFUSAL-ID: none -- recording the refusal failed, so it cannot be escalated by id.\n' ;;
		esac
	}
	return 0
}

## The access block of a spawn brief: the refused tools and paths and what the routine adds for this member,
## from the standing deny rows and the routine's `access-control:` rows, then always the line that says how to ask for more.
AgentsToolsPermissionAccessBlock(){ ## member, routine file (optional)
	local abMember="${1:-}" abFile="${2:-}" abLine abAccess="" abExecutors="" abRow abRest abWho abVerb abValue abOne abGlob abDenyTool="" abDenyRead="" abDenyWrite="" abAddTool="" abAddRead="" abAddWrite="" abIsExec=""
	if [ -n "$abFile" ] && [ -f "$abFile" ] ; then
		while IFS= read -r abLine ; do
			case "$abLine" in
				'access-control: '*) abAccess="${abLine#access-control: }" ;;
				'executors: '*) abExecutors="${abLine#executors: }" ;;
			esac
		done < <( LC_ALL=C awk 'NR == 1 && $0 == "---" { fm = 1 ; next ; } fm && $0 == "---" { exit ; } fm { print ; }' "$abFile" )
	fi
	case ", ${abExecutors//,/ ,} ," in *" $abMember ,"*|*" magic-team ,"*|*" * ,"*) abIsExec=1 ;; esac
	abRest="$abAccess"
	while [ -n "$abRest" ] ; do
		abRow="${abRest%%,*}"
		if [ "$abRow" != "$abRest" ] ; then abRest="${abRest#*,}" ; else abRest="" ; fi
		abRow="${abRow#"${abRow%%[![:space:]]*}"}" ; abRow="${abRow%"${abRow##*[![:space:]]}"}"
		case "$abRow" in *:*:*) ;; *) continue ;; esac
		abWho="${abRow%%:*}" ; abRow="${abRow#*:}" ; abVerb="${abRow%%:*}" ; abValue="${abRow#*:}"
		case "$abWho" in
			participants|"$abMember") ;;
			executors) [ -n "$abIsExec" ] || continue ;;
			*) continue ;;
		esac
		case "$abVerb" in
			deny-tool) abDenyTool="$abDenyTool${abDenyTool:+, }$abValue" ;;
			deny-read) abDenyRead="$abDenyRead${abDenyRead:+, }$abValue" ;;
			deny-write) abDenyWrite="$abDenyWrite${abDenyWrite:+, }$abValue" ;;
			allow-tool) abAddTool="$abAddTool${abAddTool:+, }$abValue" ;;
			allow-read) abAddRead="$abAddRead${abAddRead:+, }$abValue" ;;
			allow-write) abAddWrite="$abAddWrite${abAddWrite:+, }$abValue" ;;
		esac
	done
	if [ -n "${MMDAPP:-}" ] && [ -n "$abMember" ] ; then
		type AgentsToolsGrantsMemberRows > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.Grants.include" 2> /dev/null || :
		while IFS=$'\t' read -r abVerb abGlob abOne abRest ; do
			abGlob="${abGlob#"$MMDAPP"/}"
			case "$abVerb" in
				deny-tool) abDenyTool="$abDenyTool${abDenyTool:+, }$abGlob" ;;
				deny-read) abDenyRead="$abDenyRead${abDenyRead:+, }$abGlob" ;;
				deny-write) abDenyWrite="$abDenyWrite${abDenyWrite:+, }$abGlob" ;;
			esac
		done < <( AgentsToolsGrantsMemberRows "$MMDAPP" "$abMember" 2> /dev/null )
	fi
	[ -z "$abDenyTool" ] || printf 'refused tools: %s\n' "$abDenyTool"
	[ -z "$abDenyRead" ] || printf 'refused reads: %s\n' "$abDenyRead"
	[ -z "$abDenyWrite" ] || printf 'refused writes: %s\n' "$abDenyWrite"
	{ [ -z "$abDenyRead" ] && [ -z "$abDenyWrite" ] ; } || printf 'always open: your sandbox, the input/ and output/ folders\n'
	[ -z "$abAddTool" ] || printf 'your routine adds tools: %s\n' "$abAddTool"
	[ -z "$abAddRead" ] || printf 'your routine adds reads: %s\n' "$abAddRead"
	[ -z "$abAddWrite" ] || printf 'your routine adds writes: %s\n' "$abAddWrite"
	printf 'to ask for more: call RequestPermission naming the tool or path and why; the human-owner decides. Your other standing rows: --list-permissions.\n'
}

## Whether <member> holds <tool> <target>, and through which layer: prints the layer and
## returns 0, or returns 1. With a session, its grants count too: the session's own store
## and the store of the coworking session it joined.
AgentsToolsPermissionHolds(){ ## member, tool, natural target, session id (optional)
	local holdMember="$1" holdTool="$2" holdTarget="$3" holdSession="${4:-}"
	local holdRoot holdVerb holdGlob holdPattern holdLayer holdRowTool holdRowTools holdRowTarget holdPurpose holdDir holdFound holdSandbox=""
	[ -n "$holdMember" ] && [ -n "$holdTool" ] || return 1
	if AgentsToolsPermissionIsHumanOwner "$holdMember" ; then
		printf 'human-owner'
		return 0
	fi
	## The session's own sandbox, input/ and output/, is exempt from every deny row.
	holdSandbox=""
	if [ -n "$holdSession" ] && [ -n "${MMDAPP:-}" ] && [ -n "$holdTarget" ] ; then
		while IFS= read -r holdRoot ; do
			case "$holdRoot" in */input|*/output) ;; *) continue ;; esac
			AgentsToolsPermissionCovers "${holdRoot%/}/**" "$holdTarget" || continue
			holdSandbox=1 ; break
		done <<< "$( AgentsToolsPermissionFloorRoots "$MMDAPP" "$holdMember" read "$holdSession" )"
	fi
	## The member's own deny rows (project.inf) win over every allow of every layer but one: an
	## approved set of a session or task, which is the owner's own word (epic S21, entry 20).
	[ -n "$holdSandbox" ] || ! AgentsToolsPermissionStandingDenied "$holdMember" "$holdTool" "$holdTarget" > /dev/null \
		|| AgentsToolsPermissionSetCovers "$holdMember" "$holdTool" "$holdTarget" "$holdSession" > /dev/null || return 1
	## A routine's deny rows win over every layer below, the routine's allows and the session grants included.
	[ -n "$holdSandbox" ] || ! AgentsToolsPermissionRoutineDenies "$holdMember" "$holdTool" "$holdTarget" "$holdSession" || return 1
	## A read-only place is written by nobody else, through any layer: its ceiling caps them all.
	case " Edit Write Execute " in
		*" $holdTool "*)
			type AgentsToolsGrantsCeilingPlace > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.Grants.include"
			case "$holdTarget" in
				/*) ! AgentsToolsGrantsCeilingPlace "${MMDAPP:-}" "$holdTarget" > /dev/null || return 1 ;;
			esac
		;;
	esac
	case "$holdTool" in
		cred|spend) ;;
		*)
			## (a) the floor's tools
			case "$agentsPermissionFloorTools" in
				*" $holdTool "*) printf 'floor' ; return 0 ;;
			esac
			## (b) standing rows, then (a) the floor's files, as the grants index unrolled them
			## for this member: a write row speaks for every file tool, a read row (allow-read)
			## for the read tools only, a tool row for <tool>[:<target>].
			while IFS=$'\t' read -r holdVerb holdGlob holdPattern holdLayer ; do
				[ -n "$holdGlob" ] || continue
				case "$holdVerb" in
					tool)
						holdRowTool="${holdGlob%%:*}" ; holdRowTarget=""
						case "$holdGlob" in
							*:*) holdRowTarget="${holdGlob#*:}" ;;
						esac
						[ "$holdRowTool" = "$holdTool" ] || continue
						AgentsToolsPermissionCovers "$holdRowTarget" "$holdTarget" || continue
						printf 'standing'
						return 0
					;;
					write) holdRowTools="$agentsPermissionFileTools" ;;
					read) holdRowTools="$agentsPermissionReadTools" ;;
					*) continue ;;
				esac
				case "$holdRowTools" in
					*" $holdTool "*) ;;
					*) continue ;;
				esac
				AgentsToolsGrantsCovers "$holdGlob" "$holdPattern" "$holdTarget" || continue
				printf '%s' "$holdLayer"
				return 0
			done <<< "$( AgentsToolsPermissionStandingRows "$holdMember" )"
			## (a) the floor's files the index cannot hold: the session's own sandbox
			case "$agentsPermissionFileTools" in
				*" $holdTool "*)
					holdPurpose=write
					case "$agentsPermissionReadTools" in
						*" $holdTool "*) holdPurpose=read ;;
					esac
					while IFS= read -r holdRoot ; do
						case "$holdRoot" in
							/*) ;;
							*) continue ;;
						esac
						AgentsToolsPermissionCovers "${holdRoot%/}/**" "$holdTarget" || continue
						printf 'floor'
						return 0
					done <<< "$( AgentsToolsPermissionFloorRoots "${MMDAPP:-}" "$holdMember" "$holdPurpose" "$holdSession" )"
				;;
			esac
		;;
	esac
	## The routine this session runs, for its run only.
	! AgentsToolsPermissionRoutineHolds "$holdMember" "$holdTool" "$holdTarget" "$holdSession" || return 0
	## (c), (d), (e): the session's grants, never a once.
	[ -n "$holdSession" ] && [ -n "${MMDAPP:-}" ] || return 1
	case "$holdSession" in */*|.|..) return 1 ;; esac
	while IFS= read -r holdDir ; do
		[ -n "$holdDir" ] || continue
		holdFound="$( AgentsToolsPermissionGrantScan "$MMDAPP/.local/agents/sessions/$holdDir" "$holdMember" "$holdTool" "$holdTarget" hold )" || continue
		AgentsToolsPermissionGrantLayer "${holdFound#* }"
		printf ' %s' "$holdFound"
		return 0
	done <<< "$( AgentsToolsPermissionRelatedStores "$holdSession" )"
	## The session and task grants of its other runs on the same board item, which a restart keeps.
	if holdFound="$( AgentsToolsPermissionItemRunsScan "$holdMember" "$holdTool" "$holdTarget" "$holdSession" )" ; then
		AgentsToolsPermissionGrantLayer "${holdFound#* }"
		printf ' %s' "$holdFound"
		return 0
	fi
	return 1
}

## The participants of a session and of a task, one member per line, each once: every
## spawn record of the session (its own, the coworking session's, the ones it spawned,
## the one that spawned it), the task item's owner and `participants:`, and the owner
## of every dispatch item tracking it.
AgentsToolsPermissionParticipants(){ ## session id (may be empty), task item (may be empty)
	local partSession="$1" partTask="${2:-}" partCow="" partParent="" partRecord partPath partItem
	{
		if [ -n "$partSession" ] && [ -n "${MMDAPP:-}" ] ; then
			case "$partSession" in */*|.|..) partSession="" ;; esac
		fi
		if [ -n "$partSession" ] && [ -n "${MMDAPP:-}" ] ; then
			for partRecord in "$MMDAPP/.local/agents/spawned"/*/"$partSession.spawn.md" ; do
				[ -f "$partRecord" ] || continue
				partCow="$( AgentsToolsPermissionField "$partRecord" session-id )"
				partParent="$( AgentsToolsPermissionField "$partRecord" parent-spawn-id )"
				break
			done
			LC_ALL=C awk -v ownSession="$partSession" -v cowSession="${partCow:-$partSession}" -v parentSession="$partParent" '
				FNR == 1 { front = 0 ; recSession = "" ; recSpawn = "" ; recParent = "" ; recOwner = "" ; }
				$0 == "---" {
					front++ ;
					if ( front == 2 && recOwner != "" ) {
						if ( recSession == cowSession || recSession == ownSession || recSpawn == ownSession || recParent == ownSession || ( parentSession != "" && recSpawn == parentSession ) ) { print recOwner ; }
					}
					next ;
				}
				front == 1 && index( $0, "session-id: " ) == 1 { recSession = substr( $0, 13 ) ; }
				front == 1 && index( $0, "spawn-id: " ) == 1 { recSpawn = substr( $0, 11 ) ; }
				front == 1 && index( $0, "parent-spawn-id: " ) == 1 { recParent = substr( $0, 18 ) ; }
				front == 1 && index( $0, "owner: " ) == 1 { recOwner = substr( $0, 8 ) ; }
			' "$MMDAPP/.local/agents/spawned"/*/*.spawn.md 2>/dev/null || :
		fi
		## A root-harness session has no spawn record: the coordinator is its one participant.
		if [ -n "$partSession" ] && [ -n "${MMDAPP:-}" ] ; then
			type AgentsToolsRootHarnessRoutineRead > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.RootHarnessKind.include" 2> /dev/null || :
			! AgentsToolsRootHarnessRoutineRead "$partSession" > /dev/null 2>&1 || printf 'magic-coordinator\n'
		fi
		if [ -n "$partTask" ] && [ -n "${MDAT_DATA_ROOT:-}" ] ; then
			partItem="${partTask##*/}" ; partItem="${partItem%.md}"
			for partPath in "$MDAT_DATA_ROOT"/board/*/"$partItem.md" ; do
				[ -f "$partPath" ] || continue
				AgentsToolsPermissionField "$partPath" owner ; printf '\n'
				AgentsToolsPermissionField "$partPath" participants | LC_ALL=C tr ', ' '\n\n' ; printf '\n'
				break
			done
			for partPath in "$MDAT_DATA_ROOT"/board/*/dispatch-*.md ; do
				[ -f "$partPath" ] || continue
				case "$( AgentsToolsPermissionField "$partPath" tracks )" in
					"$partItem"|"$partItem.md") AgentsToolsPermissionField "$partPath" owner ; printf '\n' ;;
				esac
			done
		fi
	} | LC_ALL=C awk 'NF && !seenMember[$1]++ { print $1 ; }'
}

## Who holds <tool> <target> among the participants, as "<member> <layer>" lines, the
## human-owner always last: the chain a request it does not hold is routed up.
AgentsToolsPermissionHolders(){ ## tool, natural target, session id, task item, excluded members (space-separated)
	local hdTool="$1" hdTarget="$2" hdSession="$3" hdTask="$4" hdExclude=" ${5:-} " hdMember hdLayer
	while IFS= read -r hdMember ; do
		[ -n "$hdMember" ] && [ "$hdMember" != "human-owner" ] || continue
		case "$hdExclude" in *" $hdMember "*) continue ;; esac
		hdLayer="$( AgentsToolsPermissionHolds "$hdMember" "$hdTool" "$hdTarget" "$hdSession" )" || continue
		printf '%s %s\n' "$hdMember" "${hdLayer%% *}"
	done <<< "$( AgentsToolsPermissionParticipants "$hdSession" "$hdTask" )"
	printf 'human-owner human-owner\n'
}
