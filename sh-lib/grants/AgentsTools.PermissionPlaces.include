#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.PermissionPlaces.include -- a target placed: resolved as the gate resolves it, named by its registered place, and widened to its folder or project.
## Sourced, never run. Functions only. Loaded by AgentsTools.InternOpPermission.include,
## which also loads AgentsTools.PermissionHolds.include and AgentsTools.Grants.include.
##

## A path resolved exactly as the harness gate resolves it (AgentsHarnessPathAllowed in
## AgentsUniversalHarness.sh), so a refusal or grant keyed here matches one keyed there:
## the parent through pwd -P, then a symlink leaf that ends at an existing file followed
## to that file. Prints the path as given where it does not resolve.
AgentsToolsPermissionResolvePath(){ ## path
	local resolvePath="$1" resolveReal resolveHops=0 resolveLink resolveDir
	case "$resolvePath" in
		/*) ;;
		*) printf '%s' "$resolvePath" ; return 0 ;;
	esac
	if [ -d "$resolvePath" ] ; then
		resolveReal="$( cd "$resolvePath" 2>/dev/null && pwd -P )" || resolveReal=""
	else
		resolveDir="${resolvePath%/*}"
		[ -n "$resolveDir" ] || resolveDir="/"
		resolveReal="$( cd "$resolveDir" 2>/dev/null && pwd -P )" || resolveReal=""
		if [ -n "$resolveReal" ] ; then
			case "$resolveReal" in
				*/) resolveReal="$resolveReal${resolvePath##*/}" ;;
				*)  resolveReal="$resolveReal/${resolvePath##*/}" ;;
			esac
		fi
	fi
	[ -n "$resolveReal" ] || { printf '%s' "$resolvePath" ; return 0 ; }
	while [ -L "$resolveReal" ] && [ -e "$resolveReal" ] ; do
		resolveHops=$(( resolveHops + 1 ))
		[ "$resolveHops" -le 40 ] || break
		resolveLink="$( readlink "$resolveReal" 2>/dev/null )" || break
		[ -n "$resolveLink" ] || break
		case "$resolveLink" in
			/*) ;;
			*) resolveLink="${resolveReal%/*}/$resolveLink" ;;
		esac
		resolveDir="${resolveLink%/*}"
		[ -n "$resolveDir" ] || resolveDir="/"
		resolveDir="$( cd "$resolveDir" 2>/dev/null && pwd -P )" || break
		case "$resolveDir" in
			*/) resolveReal="$resolveDir${resolveLink##*/}" ;;
			*)  resolveReal="$resolveDir/${resolveLink##*/}" ;;
		esac
	done
	printf '%s' "$resolveReal"
}

## The workspace a member is set up in, for naming a target by the place that member's own grant
## came from. A folder two workspaces both name is then named by the member's own, never guessed
## between them. Nothing when the machine does not know the member. Its home workspace first
## (member-homes.registry), else the one its member row declares.
AgentsToolsPermissionMemberWorkspace(){ ## member
	local memberPlaceWs memberPlaceFile
	[ -n "${1:-}" ] || return 0
	memberPlaceFile="${HOME:-}/.agents/magic-team/member-homes.registry"
	memberPlaceWs="$( LC_ALL=C awk -F'\t' -v who="$1" '$1 == who && $2 != "" { print $2 ; exit ; }' "$memberPlaceFile" 2> /dev/null )" || memberPlaceWs=""
	if [ -z "$memberPlaceWs" ] ; then
		memberPlaceFile="${HOME:-}/.agents/magic-team/members.registry"
		memberPlaceWs="$( LC_ALL=C awk -F'\t' -v who="$1" '$1 == who && $2 != "" { print $2 ; exit ; }' "$memberPlaceFile" 2> /dev/null )" || memberPlaceWs=""
	fi
	[ -z "$memberPlaceWs" ] || printf '%s\n' "${memberPlaceWs%/}"
}

## The registered place a natural target lies in, as name:relative (--intern-directory-of), a
## <path>/** pattern keeping its /**. Nothing for a target that is no absolute path, or lies in
## no place. A hint only: a grant is matched by its path. The place is resolved in the workspace
## given, and in this one where none is: a folder two workspaces name alike is named by the
## asking member's own, never by a guess over both.
AgentsToolsPermissionPlaceHint(){ ## natural target, [workspace]
	local hintBase="$1" hintTail="" hintOf hintRoot="${2:-${MMDAPP:-}}"
	case "$hintBase" in /*) ;; *) return 0 ;; esac
	case "$hintBase" in *$'\n'*|*$'\t'*) return 0 ;; esac
	case "$hintBase" in */'**') hintBase="${hintBase%/\*\*}" ; hintTail="/**" ;; esac
	type LocalToolsPlacesOf > /dev/null 2>&1 \
		|| { [ ! -f "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/places/LocalTools.Places.include" ] || . "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/places/LocalTools.Places.include" ; }
	hintOf="$( LocalToolsPlacesOf "${hintRoot%/}" "$hintBase" 2> /dev/null )" || return 0
	[ -n "$hintOf" ] || return 0
	case "$hintOf:$hintTail" in *':.:/**') hintOf="${hintOf%.}" ; hintTail="**" ;; esac
	printf '%s%s' "$hintOf" "$hintTail"
}

## A target as a post shows it to a person: by its location root, `<place>:<relative path>`,
## where it lies in a registered place, and then never its absolute path beside it; as given
## where it lies in none. One resolver, the place hint above. A record keeps the exact
## target: only what is posted is shown this way.
AgentsToolsPermissionShownTarget(){ ## natural target, [workspace]
	local shownPlace=""
	[ -n "${1:-}" ] || return 0
	shownPlace="$( AgentsToolsPermissionPlaceHint "$1" "${2:-}" )" || shownPlace=""
	printf '%s' "${shownPlace:-$1}"
}

## A write tool asked for in a read-only place is refused before anything is asked or granted,
## naming the route to take instead: the session sandbox output/ when the session has one,
## else another suitable location. rc 1 refused, said on stderr; 0 otherwise.
AgentsToolsPermissionCeilingRefuse(){ ## tool, natural target, session id, entry as asked
	type AgentsToolsGrantsCeilingPlace > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.Grants.include"
	local ceilBase="$2" ceilPlace ceilRecord ceilRoute="find another suitable location"
	case " Edit Write Execute " in *" $1 "*) ;; *) return 0 ;; esac
	case "$ceilBase" in /*) ;; *) return 0 ;; esac
	case "$ceilBase" in */'**') ceilBase="${ceilBase%/\*\*}" ;; esac
	ceilBase="$( AgentsToolsPermissionResolvePath "$ceilBase" )"
	ceilPlace="$( AgentsToolsGrantsCeilingPlace "${MMDAPP%/}" "$ceilBase" )" || return 0
	case "$3" in
		''|*/*|.|..) ;;
		*)
			type AgentsSessionRunRecordInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.include"
			AgentsSessionRunRecordInto ceilRecord "$3" || :
			for ceilRecord in ${ceilRecord:+"$ceilRecord"} ; do
				[ -f "$ceilRecord" ] || continue
				ceilRoute="write to the session sandbox output/ instead, or a folder under it: ${ceilRecord%/*}/output/"
				break
			done
		;;
	esac
	echo "$MDSC_CMD: ⛔ ERROR: $ceilPlace is a read-only place, so no write is granted there: $4 -- $ceilRoute" >&2
	return 1
}

## THE FOLDER OF A REFUSED FILE, as one more answer of a single permission may grant it:
## `<tool>:<folder>/**`, natural -- the tool of the refused call, for the folder its file
## lies in, and nothing wider; for a target that is a folder itself, that folder. Printed
## only where that can be right: the tool is one a path permission speaks for
## (agentsPermissionFileTools); the target is an absolute path that is no pattern and has no
## `..` segment, line break or tab; the folder is not the root of the file system, the home
## directory, or the root of a workspace this machine knows, so that this one answer never
## gives a whole workspace; and a write is never offered in a read-only place
## (AgentsToolsPermissionCeilingRefuse). rc 1, nothing printed, otherwise.
AgentsToolsPermissionFolderEntry(){ ## tool, natural target, session id
	local folderTool="$1" folderOf="$2" folderRoot
	case "$agentsPermissionFileTools" in
		*" $folderTool "*) ;;
		*) return 1 ;;
	esac
	case "$folderOf" in
		/*) ;;
		*) return 1 ;;
	esac
	case "$folderOf" in
		*/../*|*/..|*'*'*|*'?'*|*'['*|*$'\n'*|*$'\r'*|*$'\t'*) return 1 ;;
	esac
	[ -d "$folderOf" ] || folderOf="${folderOf%/*}"
	folderOf="${folderOf%/}"
	[ -n "$folderOf" ] && [ "$folderOf" != "${HOME%/}" ] || return 1
	type LocalToolsPlacesWorkspaceRoots > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/places/LocalTools.Places.include" || return 1
	while IFS= read -r folderRoot ; do
		[ -n "$folderRoot" ] || continue
		[ "$folderRoot" != "$folderOf" ] && [ "$( AgentsToolsPermissionResolvePath "$folderRoot" )" != "$folderOf" ] || return 1
	done <<< "$( LocalToolsPlacesWorkspaceRoots "${MMDAPP%/}" 2> /dev/null )"
	AgentsToolsPermissionCeilingRefuse "$folderTool" "$folderOf/**" "$3" "$folderTool:$folderOf/**" 2> /dev/null || return 1
	printf '%s:%s/**' "$folderTool" "$folderOf"
}

## THE PROJECT OF A REFUSED FILE, as one more answer of a single permission may grant it
## beside the folder: `<tool>:<project>/**`, natural -- the tool of the refused call, for the
## project its file lies in, every file of that project beside it. A project is a project the
## distro tooling names under a workspace's source tree: the nearest folder at or above the file
## that it answers for, asked through its own operation (AgentsDistroProjectNearest). Printed only
## where the folder answer is offered (AgentsToolsPermissionFolderEntry), so under every limit
## that one has, and only where the project is wider than the folder: where it is the very
## folder of the file the two would grant the same, and the folder answer alone is offered.
## The source tree itself is never a project, and the project folder is held to the limits of
## a folder answer too: never the root of a workspace, never a write in a read-only place. A
## path written with an empty or a `.` segment is walked up by no rule here, so it has no
## project to offer. rc 1, nothing printed, otherwise.
AgentsToolsPermissionProjectEntry(){ ## tool, natural target, session id
	local projectFolder projectOf projectRoot projectBase projectTree=""
	projectFolder="$( AgentsToolsPermissionFolderEntry "$1" "$2" "$3" )" || return 1
	projectFolder="${projectFolder#*:}" ; projectFolder="${projectFolder%/\*\*}"
	case "$projectFolder/" in
		*//*|*/./*) return 1 ;;
	esac
	type LocalToolsPlacesWorkspaceRoots > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/places/LocalTools.Places.include" || return 1
	## The source tree that holds the folder: of a workspace root as it is listed, or as it
	## resolves; the deepest one, where a workspace lies inside the tree of another.
	while IFS= read -r projectRoot ; do
		[ -n "$projectRoot" ] || continue
		for projectBase in "$projectRoot" "$( AgentsToolsPermissionResolvePath "$projectRoot" )" ; do
			case "$projectFolder" in
				"$projectBase/source/"?*)
					case "$projectTree/" in
						"$projectBase/source/"*) ;;
						*) projectTree="$projectBase/source" ;;
					esac
				;;
			esac
		done
	done <<< "$( LocalToolsPlacesWorkspaceRoots "${MMDAPP%/}" 2> /dev/null )"
	[ -n "$projectTree" ] || return 1
	## The nearest project at or above the folder: the distro tooling's own answer (AgentsDistroProjectNearest), never a test of
	## its project.inf. No project, or the project is the very folder of the file, offers the folder answer alone.
	type AgentsDistroProjectNearest > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/distro/AgentsTools.DistroDoor.include" || return 1
	projectOf="$( AgentsDistroProjectNearest "$projectTree" "$projectFolder" )" || return 1
	[ "$projectOf" != "$projectFolder" ] || return 1
	## What is printed is the folder answer of the project folder, so under its every limit.
	AgentsToolsPermissionFolderEntry "$1" "$projectOf" "$3"
}

## One permission entry made ready to ask for: split into permEntryTool and permEntryTarget, an
## @<name>[:<glob>] target resolved through --intern-directory-resolve to a path under that
## place (the glob a path, ** or <path>/**, relative, never with a .. segment), and
## permEntryPlace its place as name:relative, a hint, or empty. A write in a read-only place is
## refused. rc 1, said on stderr.
AgentsToolsPermissionEntryPlace(){ ## entry, session id
	type AgentsToolsPermissionEntrySplit > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.PermissionRecord.include"
	local placeName placeGlob placePath
	permEntryPlace=""
	AgentsToolsPermissionEntrySplit "$1" permission-set-request || return 1
	## `<place>:<relative>` is the form a member is asked to write, and the same entry as
	## `@<place>:<relative>`: normalised here, so one arm reads both and a display keeps the
	## name the member wrote. A path in no place is written as it is, absolute. A URL is no
	## path and names no place: WebFetch's target is a URL prefix, `https://host/**` included,
	## and it is kept as written.
	case "$permEntryTarget" in
		http://*|https://*) ;;
		/*|@*) ;;
		*:*) permEntryTarget="@$permEntryTarget" ;;
	esac
	case "$permEntryTarget" in
		@*)
			placeName="${permEntryTarget#@}" ; placeGlob=""
			case "$placeName" in *:*) placeGlob="${placeName#*:}" ; placeName="${placeName%%:*}" ;; esac
			case "/$placeGlob/" in
				*/../*) echo "$MDSC_CMD: ⛔ ERROR: an entry glob has a .. segment: $1" >&2 ; return 1 ;;
			esac
			case "$placeGlob" in
				/*) echo "$MDSC_CMD: ⛔ ERROR: an entry glob is relative to its place, never absolute: $1" >&2 ; return 1 ;;
			esac
			case "${placeGlob%/\*\*}" in
				'**'|'') ;;
				*'*'*|*'?'*|*'['*) echo "$MDSC_CMD: ⛔ ERROR: an entry glob is a path, ** or <path>/** under its place, no other pattern: $1" >&2 ; return 1 ;;
			esac
			type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
			placePath="$( DistroAgentsTools --intern-directory-resolve "$placeName" )" || {
				echo "$MDSC_CMD: ⛔ ERROR: the entry names no place this workspace can resolve, so nothing is asked: $1" >&2
				return 1
			}
			placePath="$( AgentsToolsPermissionResolvePath "$placePath" )"
			## The path under the place is resolved too: a link there and its target are one target.
			case "$placeGlob" in
				''|'**') permEntryTarget="${placePath%/}/**" ; permEntryPlace="$placeName:**" ;;
				*/'**') permEntryTarget="$( AgentsToolsPermissionResolvePath "${placePath%/}/${placeGlob%/\*\*}" )/**" ; permEntryPlace="$placeName:$placeGlob" ;;
				*) permEntryTarget="$( AgentsToolsPermissionResolvePath "${placePath%/}/$placeGlob" )" ; permEntryPlace="$placeName:$placeGlob" ;;
			esac
		;;
		*) permEntryPlace="$( AgentsToolsPermissionPlaceHint "$permEntryTarget" )" ;;
	esac
	AgentsToolsPermissionCeilingRefuse "$permEntryTool" "$permEntryTarget" "$2" "$1" || return 1
	return 0
}
