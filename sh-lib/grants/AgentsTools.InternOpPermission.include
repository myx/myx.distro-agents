#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.InternOpPermission.include -- refusal records and grants, per session.
##
## ONE OPERATION, ONE FILE: each operation below is one function in its own file,
## AgentsTools.InternOpPermission<Op>.include, loaded only when that operation is called. The
## helpers are in the parts, AgentsTools.Permission*.include, one concern each; each function
## loads what it calls itself. A caller that needs one helper sources the part that holds it:
##   type AgentsToolsPermissionSetApply > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.PermissionSetApply.include"

## Sourced with no operation, this file loads every part (DEFINITIONS-ONLY SOURCE, below).
##
## A permission refusal is a logged fact with an id, never a verdict. It is recorded
## in the session's own store before anything is posted, so an escalation can name
## it and a grant can take its tool and target from it rather than from the text of
## a request. The store is local runtime state and never a git tree:
## .local/agents/sessions/<session-id>/, beside the pending-reply store.

##

case "$1" in

	--intern-op-permission-hook)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.InternOpPermissionHook.include"
	;;

	--intern-op-permission-refusal-log)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.InternOpPermissionRefusalLog.include"
	;;

	--intern-op-permission-grant-open)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.InternOpPermissionGrantOpen.include"
	;;

	--intern-op-permission-route)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.InternOpPermissionRoute.include"
	;;

	--intern-op-permission-grant-read)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.InternOpPermissionGrantRead.include"
	;;

	--intern-op-permission-contact-holds)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.InternOpPermissionContactHolds.include"
	;;

	--intern-op-permission-grant-consume)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.InternOpPermissionGrantConsume.include"
	;;

	--intern-op-permission-place)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.InternOpPermissionPlace.include"
	;;

	--intern-op-permission-folder)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.InternOpPermissionFolder.include"
	;;

	--intern-op-permission-holds)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.InternOpPermissionHolds.include"
	;;

	--pass-permission|--intern-op-permission-pass)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.InternOpPermissionPass.include"
	;;

	--request-permission-set|--intern-op-permission-set-ask)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.InternOpPermissionSetAsk.include"
	;;

	--intern-op-permission-single-asks)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.InternOpPermissionSingleAsks.include"
	;;

	--intern-op-permission-escalation-input-scan)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.InternOpPermissionEscalationInputScan.include"
	;;

	--revoke-permission|--intern-op-permission-revoke)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.InternOpPermissionRevoke.include"
	;;

	--list-permissions|--intern-op-permission-list)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.InternOpPermissionList.include"
	;;

	## A permission operation this file does not implement -- the retired
	## --intern-op-permission-holders and -set-apply among them -- is reported, never swallowed.
	--intern-op-permission-*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;

	## DEFINITIONS-ONLY SOURCE: a caller sourcing this file for its helpers. Nothing to dispatch: every part is loaded.
	*)
		type AgentsToolsPermissionEscapeRecord > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.PermissionRecord.include"
		type AgentsToolsPermissionRefusalWhere > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.PermissionPosts.include"
		type AgentsToolsPermissionPlannedIgnored > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.PermissionHook.include"
		type AgentsToolsPermissionResolvePath > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.PermissionPlaces.include"
		type AgentsToolsPermissionEscalationAsk > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.PermissionParticipants.include"
		type AgentsToolsPermissionSetFill > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.PermissionSetPost.include"
		type AgentsToolsPermissionItemRow > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.PermissionSetApply.include"
		type AgentsToolsPermissionEntryToolKnown > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.PermissionHolds.include"
		type AgentsToolsGrantsHoldsDir > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.Grants.include"
	;;

esac
