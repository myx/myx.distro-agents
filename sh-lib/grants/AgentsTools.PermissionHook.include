#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.PermissionHook.include -- the answer a PermissionRequest hook gives Claude Code, and the planned allows it ignores.
## Sourced, never run. Functions only. Loaded by AgentsTools.InternOpPermission.include,
## which also loads AgentsTools.PermissionHolds.include and AgentsTools.Grants.include.
##

## One ignored planned allow, said once per session: a marker keyed by the entry's cksum
## stops the same entry being posted on every call it could not admit. Advisory: a post
## that does not happen never changes a verdict.
AgentsToolsPermissionPlannedIgnored(){ ## member, session id, dispatch item, entry, reason
	type AgentsToolsPermissionSessionDir > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.PermissionRecord.include"
	type AgentsToolsPermissionEventTrack > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.PermissionPosts.include"
	local ignoredDir ignoredKey
	ignoredDir="$( AgentsToolsPermissionSessionDir "$2" )" || return 0
	ignoredKey="$( printf '%s' "$4" | LC_ALL=C cksum | LC_ALL=C tr ' ' '-' )" || return 0
	mkdir "$ignoredDir/planned-ignored-$ignoredKey" 2>/dev/null || return 0
	AgentsToolsPermissionEventTrack "$1" "$2" --kind refusal --session-id "$2" --field what="Planned allow ignored" \
		--field dispatch="$3" --field entry="$4" --field reason="$5" --field caller="$1"
	return 0
}

## One PermissionRequest decision, as Claude Code reads it from a hook's stdout.
AgentsToolsPermissionHookDecision(){ ## allow|deny, message (deny only)
	if [ "$1" = "allow" ] ; then
		printf '{"hookSpecificOutput":{"hookEventName":"PermissionRequest","decision":{"behavior":"allow"}}}\n'
		return 0
	fi
	printf '{"hookSpecificOutput":{"hookEventName":"PermissionRequest","decision":{"behavior":"deny","message":"%s"}}}\n' \
		"$( printf '%s' "$2" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/mcp/AgentsMcpJsonEscape.awk" )"
}
