#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.PermissionSetApply.include -- an approved permission set applied: an item's access-control rows read as entries, and the grants opened.
## Sourced, never run. Functions only. Loaded by AgentsTools.InternOpPermission.include,
## which also loads AgentsTools.PermissionHolds.include and AgentsTools.Grants.include.
##

## An item's `access-control:` holds rows `participants:<verb>:<value>:<granted-by>:<stamp>` (verbs allow-read, allow-write, allow-tool; allow-tool's value is `<tool>:<target>`).
## A dispatch item's rows hold for its session, the tracked item's for its task. Read is Read; Edit and Write are write; any other tool is allow-tool.
AgentsToolsPermissionItemRow(){ ## tool, %-escaped target, granted-by, stamp
	local rowVerb rowValue
	case "$1" in
		Read) rowVerb=allow-read ; rowValue="$2" ;;
		Edit|Write) rowVerb=allow-write ; rowValue="$2" ;;
		*)
			rowVerb=allow-tool ; rowValue="$1:$2"
			## A tool with no target is written with `-`, which AgentsToolsPermissionItemEntries reads
			## back as that very tool: the item's contract wants six `:`-separated fields, and a tool
			## whose target is empty (WebFetch, cred:) would give five, so the whole write is refused.
			[ -n "$2" ] || rowValue="$1:-"
		;;
	esac
	printf 'participants:%s:%s:%s:%s' "$rowVerb" "$rowValue" "$3" "$4"
}

## An item's rows as the entries `<kind>:<tool>:<target>:<granted-by>:<stamp>` the planned-allow reader checks: read expands to Read, Grep, Glob; write to Edit, Write.
## A row of another shape is passed on with its colons shown as `|`, for the reader to report once.
AgentsToolsPermissionItemEntries(){ ## rows, kind (session|task)
	local rowsList="$1" rowOne rowRest rowVerb rowStamp rowBy rowValue rowTool rowTarget rowOut="" rowAdd
	while [ -n "$rowsList" ] ; do
		rowOne="${rowsList%%,*}"
		if [ "$rowOne" != "$rowsList" ] ; then rowsList="${rowsList#*,}" ; else rowsList="" ; fi
		rowOne="${rowOne# }"
		[ -n "$rowOne" ] || continue
		rowAdd=""
		rowRest="${rowOne#*:}"
		rowVerb="${rowRest%%:*}" ; rowRest="${rowRest#*:}"
		rowStamp="${rowRest##*:}"
		rowRest="${rowRest%:*}"
		rowBy="${rowRest##*:}" ; rowValue="${rowRest%:*}"
		if [ "${rowOne%%:*}" = participants ] && [ "$rowRest" != "${rowRest%:*}" ] && [ -n "$rowValue" ] && [ -n "$rowBy" ] && [ -n "$rowStamp" ] ; then
			case "$rowVerb" in
				allow-read) rowAdd="$2:Read:$rowValue:$rowBy:$rowStamp,$2:Grep:$rowValue:$rowBy:$rowStamp,$2:Glob:$rowValue:$rowBy:$rowStamp" ;;
				allow-write) rowAdd="$2:Edit:$rowValue:$rowBy:$rowStamp,$2:Write:$rowValue:$rowBy:$rowStamp" ;;
				allow-tool)
					rowTool="${rowValue%%:*}" ; rowTarget="${rowValue#*:}"
					[ "$rowTool" != "$rowValue" ] && [ -n "$rowTool" ] && [ -n "$rowTarget" ] && rowAdd="$2:$rowTool:$rowTarget:$rowBy:$rowStamp"
				;;
			esac
		fi
		[ -n "$rowAdd" ] || rowAdd="${rowOne//:/|}"
		rowOut="${rowOut:+$rowOut,}$rowAdd"
	done
	printf '%s' "$rowOut"
}

## An approved permission set, applied: a grant of the set's scope for every
## participant and every extra entry, signed by the approver; for a task, also the
## item's `access-control:` rows, so a later dispatch tracking it carries the set; and the set on
## the item's Decisions. Called by the escalation verdict path only.
## Applied a second time for the same request -- an apply completed after it stopped
## (AgentsToolsEscalationApply) -- it writes only what is not there yet: a participant keeps
## the set record it has, a grant line that stands is not written again, the item's access-control rows
## take no entry twice, and its Decisions no second line. A participant's grants are said
## in the tracking-thread only by the run that wrote one of them.
AgentsToolsPermissionSetApply(){ ## <pending-id> <approver>
	type AgentsToolsPermissionNewRef > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.PermissionRecord.include"
	type AgentsToolsPermissionAnswerPost > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.PermissionPosts.include"
	type AgentsToolsPermissionShareStore > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.PermissionHolds.include"
	type AgentsToolsGrantsStoreTouch > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.Grants.include"
	local MDSC_CMD='DistroAgentsTools permission-set-apply'
	. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.BareName.include"
	type AgentsToolsDecisionsItemPath > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.ItemDecisions.include"
	local applySetId="${1:-}" applySetBy="${2:-}" applySetFile applySetLine applySetScope="" applySetItem="" applySetSession="" applySetParts="" applySetEntries="" applySetPlaces="" applySetPurposes=""
	if [ -z "$applySetId" ] || [ -z "$applySetBy" ] ; then
		echo "$MDSC_CMD: ⛔ ERROR: syntax is <pending-id> <approver>" >&2
		set +e ; return 1
	fi
	AgentsToolsAssertBareName "$applySetId" "<pending-id>" permission-set-apply || { set +e ; return 1 ; }
	AgentsToolsAssertBareName "$applySetBy" "<approver>" permission-set-apply || { set +e ; return 1 ; }
	applySetFile="$MMDAPP/.local/agents/pending/$applySetId.set"
	[ -f "$applySetFile" ] || { echo "$MDSC_CMD: ⛔ ERROR: no permission set is recorded for $applySetId" >&2 ; set +e ; return 1 ; }
	while IFS= read -r applySetLine ; do
		case "$applySetLine" in
			'scope: '*) applySetScope="${applySetLine#scope: }" ;;
			'item: '*) applySetItem="${applySetLine#item: }" ;;
			'session-id: '*) applySetSession="${applySetLine#session-id: }" ;;
			'participants: '*) applySetParts="${applySetLine#participants: }" ;;
			'entry: '*) applySetEntries="${applySetEntries}${applySetLine#entry: }"$'\n' ;;
			'place: '*) applySetPlaces="${applySetPlaces}${applySetLine#place: }"$'\n' ;;
			'purpose: '*) applySetPurposes="${applySetPurposes}${applySetLine#purpose: }"$'\n' ;;
		esac
	done < "$applySetFile"
	[ -n "$applySetEntries" ] || { echo "$MDSC_CMD: ⛔ ERROR: the permission set $applySetId names no entry" >&2 ; set +e ; return 1 ; }
	local applySetTime applySetPart applySetRef applySetDir applySetCount=0 applySetAllows="" applySetText="" permEntryTool permEntryTarget
	applySetTime="$( date -u +%Y%m%dT%H%MZ )"
	## Grants for the participants, in the session's store.
	if [ -n "$applySetSession" ] && AgentsToolsAssertBareName "$applySetSession" "session-id" permission-set-apply 2>/dev/null ; then
		type AgentsSessionFolderInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.include"
		AgentsSessionFolderInto applySetDir "$MMDAPP" "$( AgentsToolsPermissionShareStore "$applySetSession" )" || {
			echo "$MDSC_CMD: ⛔ ERROR: $applySetSession is no session of this workspace, so nothing is applied" >&2
			set +e ; return 1
		}
		mkdir -p "$applySetDir" 2>/dev/null || { echo "$MDSC_CMD: ⛔ ERROR: can't create the session store for $applySetSession" >&2 ; set +e ; return 1 ; }
		for applySetPart in $applySetParts ; do
			AgentsToolsAssertBareName "$applySetPart" "participant" permission-set-apply 2>/dev/null || continue
			## The set record this participant has from this request already, where an apply stopped.
			local applySetHave applySetWrote=0
			applySetRef=""
			for applySetHave in "$applySetDir"/set-*.md ; do
				[ -f "$applySetHave" ] || continue
				LC_ALL=C grep -q -x -F -- "escalation: $applySetId" "$applySetHave" && LC_ALL=C grep -q -x -F -- "owner: $applySetPart" "$applySetHave" || continue
				applySetRef="${applySetHave##*/}" ; applySetRef="${applySetRef%.md}"
				break
			done
			if [ -z "$applySetRef" ] ; then
				applySetRef="$( AgentsToolsPermissionNewRef set- )" || { echo "$MDSC_CMD: ⛔ ERROR: no id could be generated" >&2 ; set +e ; return 1 ; }
				{
					printf '%s\n' "---"
					printf 'status: %s\n' "set"
					printf 'owner: %s\n' "$applySetPart"
					printf 'approved-by: %s\n' "$applySetBy"
					printf 'session-id: %s\n' "$applySetSession"
					printf 'kind: %s\n' "$applySetScope"
					[ "$applySetScope" != "task" ] || printf 'task: %s\n' "$applySetItem"
					printf 'escalation: %s\n' "$applySetId"
					printf '%s\n' "---"
					printf '\n# Permission set\n\n'
					printf '%s' "$applySetEntries" | LC_ALL=C awk 'NF { print "- " $0 ; }'
					## What the asker said the access is for, by place: why this grant was given. The
					## grants line itself has no field for a text.
					if [ -n "$applySetPurposes" ] ; then
						printf '\n## What the access is for\n\n'
						printf '%s' "$applySetPurposes" | LC_ALL=C awk -F'\t' 'NF >= 2 { print "- " $1 ": " $2 ; }'
					fi
				} > "$applySetDir/$applySetRef.md" || { echo "$MDSC_CMD: ⛔ ERROR: can't write the set record for $applySetPart" >&2 ; set +e ; return 1 ; }
				## The places its entries were asked by, as name:relative, beside it.
				[ -z "$applySetPlaces" ] || printf '%s' "$applySetPlaces" > "$applySetDir/$applySetRef.places" \
					|| echo "⚠️ WARNING: $MDSC_CMD: the places of the set grants for $applySetPart were not recorded" >&2
			fi
			while IFS= read -r applySetLine ; do
				[ -n "$applySetLine" ] || continue
				AgentsToolsPermissionEntrySplit "$applySetLine" permission-set-apply 2>/dev/null || continue
				applySetCount=$(( applySetCount + 1 ))
				## The line of this record for this entry, whenever it was stamped: there, it stands.
				! LC_ALL=C awk -F: -v want="$applySetScope:$permEntryTool:$( AgentsToolsPermissionEscape "$permEntryTarget" ):$applySetBy:" -v ref="$applySetRef" \
					'$NF == ref && index( $0, want ) == 1 { found = 1 ; exit ; } END { exit ! found ; }' "$applySetDir/grants" 2>/dev/null || continue
				printf '%s:%s:%s:%s:%s:%s\n' "$applySetScope" "$permEntryTool" "$( AgentsToolsPermissionEscape "$permEntryTarget" )" "$applySetBy" "$applySetTime" "$applySetRef" >> "$applySetDir/grants" \
					|| { echo "$MDSC_CMD: ⛔ ERROR: can't write the set grants for $applySetPart" >&2 ; set +e ; return 1 ; }
				applySetWrote=$(( applySetWrote + 1 ))
			done <<< "$applySetEntries"
			## Interim, until the grants move into the session file itself: that file is written again now.
			[ "$applySetWrote" -eq 0 ] || AgentsToolsGrantsStoreTouch "$applySetDir"
			## The set's grants for this participant, said once in the session's tracking-thread.
			[ "$applySetWrote" -gt 0 ] || continue
			AgentsToolsPermissionAnswerPost grant "$applySetPart" "$applySetDir" "$applySetSession" "$applySetRef" "" "" "$applySetBy" \
				"set, $applySetScope$( [ "$applySetScope" != "task" ] || printf ' %s' "$applySetItem" )" "" \
				"permission set $applySetId, $( printf '%s\n' "$applySetEntries" | LC_ALL=C grep -c . ) permission(s)"
		done
	fi
	## The entries, as the item's planned allows (a task set) and on its Decisions.
	while IFS= read -r applySetLine ; do
		[ -n "$applySetLine" ] || continue
		AgentsToolsPermissionEntrySplit "$applySetLine" permission-set-apply 2>/dev/null || continue
		applySetAllows="${applySetAllows:+$applySetAllows,}$( AgentsToolsPermissionItemRow "$permEntryTool" "$( AgentsToolsPermissionEscape "$permEntryTarget" )" "$applySetBy" "$applySetTime" )"
		applySetText="${applySetText:+$applySetText, }$applySetLine"
	done <<< "$applySetEntries"
	local applySetPath applySetState applySetOld applySetAdd="" applySetOne
	if [ "$applySetScope" = "task" ] && applySetPath="$( AgentsToolsDecisionsItemPath "$applySetItem" )" ; then
		applySetState="${applySetPath%/*}" ; applySetState="${applySetState##*/}"
		applySetOld="$( AgentsToolsDecisionsField "$applySetPath" access-control | LC_ALL=C sed 's/, */,/g' )" || applySetOld=""
		## Only what the item does not carry from this approver already, whenever it was stamped.
		while IFS= read -r applySetOne ; do
			[ -n "$applySetOne" ] || continue
			case ",$applySetOld," in *",${applySetOne%:*}:"*) continue ;; esac
			applySetAdd="${applySetAdd:+$applySetAdd,}$applySetOne"
		done < <( printf '%s\n' "$applySetAllows" | LC_ALL=C tr ',' '\n' )
		type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
		[ -z "$applySetAdd" ] || printf '{ print ; }\n' | DistroAgentsTools --intern-op-board-upsert-move-edit "$applySetState" "${applySetPath##*/}" --from-state:"$applySetState" \
			--edit-script-from-stdin:awk "--header:upsert:access-control:$( printf '%s' "${applySetOld:+$applySetOld,}$applySetAdd" | LC_ALL=C sed 's/,/, /g' )" \
			--context "$MDSC_CMD" --log-verb:updated > /dev/null 2>&1 \
			|| echo "⚠️ WARNING: $MDSC_CMD: the set is granted, but not written as $applySetItem's access-control, so a later dispatch tracking it does not carry it" >&2
	fi
	## On the item's Decisions once: the line of this request, there already, is not written again.
	## A set that names no item -- a session's own calls, asked with no board item to record
	## them on (--intern-op-escalation-permission-add) -- has no Decisions.
	[ -z "$applySetItem" ] \
	|| { applySetPath="$( AgentsToolsDecisionsItemPath "$applySetItem" 2>/dev/null )" && LC_ALL=C grep -F -- "permission set approved for the " "$applySetPath" 2>/dev/null | LC_ALL=C grep -q -F -- "($applySetId)" ; } \
	|| DistroAgentsTools --intern-op-decisions-append "$applySetBy" "$applySetItem" --kind verdict \
		--text "permission set approved for the $applySetScope ($applySetParts): $applySetText" --source "$applySetId" \
		--context "$MDSC_CMD" > /dev/null 2>&1 \
		|| echo "⚠️ WARNING: $MDSC_CMD: the set is granted, but not recorded on $applySetItem's Decisions" >&2
	## A session-id was given but nothing was written for it -- an empty or malformed one (the assert at
	## the top of the session block failed quietly), or every participant's own assert failed: never
	## reported as a success (S21.20, the tester's own incident: a GRANT line naming 0 entries closed
	## the escalation as allowed with nothing stored).
	if [ -n "$applySetSession" ] && [ "$applySetCount" -eq 0 ] ; then
		echo "$MDSC_CMD: ⛔ ERROR: a session-id was given ($applySetSession) but no entry could be written for it -- check it is a bare session id, with no path characters, and that every participant is a bare name" >&2
		set +e ; return 1
	fi
	printf 'GRANT: set %s entries for %s\n' "$applySetCount" "${applySetParts:-nobody}"
	return 0
}
