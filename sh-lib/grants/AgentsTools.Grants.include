#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

## rc 0 where the folder holds at least one directory of its own, a package: a glob, never a `find` process (call-path audit
## row 12). A link is not a directory of its own, as `find -type d` read it.
AgentsToolsGrantsHoldsDir(){ ## folder
	local holdsDir
	for holdsDir in "$1"/*/ ; do
		[ -d "$holdsDir" ] && [ ! -L "${holdsDir%/}" ] && return 0
	done
	return 1
}

## The prose that stood here is in the package's MAGIC.md, under "AgentsTools.Grants.include".

agentsGrantsHere="${harnessHere:-$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib}"
agentsGrantsIndexVersion="myx.distro grants.index 1"
agentsGrantsSessionVersion="myx.distro session.permissions.index 2"
agentsGrantsHeader=""
agentsGrantsIndexFile=""
agentsGrantsIndexText=""

## The index header: its format, and what its floor was read under.
AgentsToolsGrantsIndexHeader(){ ## workspace -- sets agentsGrantsHeader
	type AgentsToolsSkillsetRootInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.MemberWorkspace.Root.include"
	AgentsToolsSkillsetRootInto agentsGrantsSkillsetRoot "$1"
	agentsGrantsHeader="$agentsGrantsIndexVersion"$'\t'"MDAT_SKILLSET_ROOT=$agentsGrantsSkillsetRoot"$'\t'"HOME=${HOME:-}"
}

AgentsToolsGrantsIndexFresh(){ ## workspace, index file
	local freshWs="${1%/}" freshFile="$2" freshHead="" freshShared="${HOME:-}/.agents/magic-team" freshSrc freshRoot freshName
	[ -f "$freshFile" ] || return 1
	IFS= read -r freshHead < "$freshFile" || return 1
	AgentsToolsGrantsIndexHeader "$freshWs"
	[ "$freshHead" = "$agentsGrantsHeader" ] || return 1
	type LocalToolsPlacesHomeSkills > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/places/LocalTools.Places.include" || return 1
	LocalToolsPlacesHomeSkills || :
	for freshSrc in \
		"$freshWs/.local/agents/permissions.registry" "$freshWs/.local/agents/directories.registry" "$freshWs/.local/agents/members.index" \
		"$freshShared/permissions.registry" "$freshShared/directories.registry" "$freshShared/members.registry" "$freshShared/member-homes.registry" \
		"$freshShared/known-workspaces.registry" "$freshShared/known-workspaces.registry.imported" "$agentsGrantsSkillsetRoot" "$localPlacesHomeSkills" \
		"$agentsGrantsHere/grants/AgentsTools.Grants.include" "$agentsGrantsHere/grants/AgentsGrantsPattern.awk" "$agentsGrantsHere/grants/AgentsGrantsIndexBuild.awk" \
		"$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/places/LocalTools.Places.include" \
	; do
		[ ! -e "$freshSrc" ] || [ "$freshFile" -nt "$freshSrc" ] || return 1
	done
	if [ -f "$freshShared/permissions.registry" ] ; then
		while IFS= read -r freshRoot ; do
			case "$freshRoot" in /*) ;; *) continue ;; esac
			freshSrc="${freshRoot%/}/.local/agents/permissions.registry"
			[ ! -e "$freshSrc" ] || [ "$freshFile" -nt "$freshSrc" ] || return 1
		done < "$freshShared/permissions.registry"
	fi
	if [ -f "$freshShared/directories.registry" ] ; then
		while IFS=$'\t' read -r freshName freshRoot ; do
			case "$freshRoot" in /*) ;; *) continue ;; esac
			freshSrc="${freshRoot%/}/.local/agents/directories.registry"
			[ ! -e "$freshSrc" ] || [ "$freshFile" -nt "$freshSrc" ] || return 1
		done < "$freshShared/directories.registry"
	fi
	return 0
}

AgentsToolsGrantsMemberSkills(){ ## workspace
	local skillsSource skillsEntry skillsName skillsReal skillsSeen=$'\n'
	type LocalToolsPlacesHomeSkills > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/places/LocalTools.Places.include" || return 0
	LocalToolsPlacesHomeSkills || return 0
	skillsSource="$( cd "${1%/}/source" 2> /dev/null && pwd -P )" || skillsSource=""
	for skillsEntry in "$localPlacesHomeSkills"/*/ ; do
		skillsEntry="${skillsEntry%/}"
		[ -d "$skillsEntry" ] || continue
		skillsName="${skillsEntry##*/}"
		[ -f "$skillsEntry/$skillsName.basic.md" ] || continue
		! LC_ALL=C grep -q '^status: reference-only' "$skillsEntry/SKILL.md" 2> /dev/null || continue
		skillsReal="$( cd "$skillsEntry" 2> /dev/null && pwd -P )" || continue
		if [ -L "$skillsEntry" ] ; then
			[ -n "$skillsSource" ] || continue
			case "$skillsReal/" in "$skillsSource"/*) ;; *) continue ;; esac
		fi
		case "$skillsSeen" in *$'\n'"$skillsReal"$'\n'*) continue ;; esac
		skillsSeen="$skillsSeen$skillsReal"$'\n'
		printf '%s\n' "$skillsReal"
	done
}

## The whole index on stdout, computed: non-zero, the output then no index, on a failure.
AgentsToolsGrantsIndexText(){ ## workspace
	local textWs="${1%/}" textStream textReal textRoot
	[ -n "$textWs" ] || return 1
	type LocalToolsPlacesMergedText > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/places/LocalTools.Places.include" || return 1
	type AgentsToolsTeamGrantRows > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.TeamRegistry.include" || return 1
	type AgentsToolsClientAccessRootsMembers > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/client/AgentsTools.ClientAccessRoots.include" || return 1
	AgentsToolsGrantsIndexHeader "$textWs"
	textStream="$(
		printf 'head\t%s\n' "$agentsGrantsHeader"
		MDAT_SKILLSET_ROOT="$agentsGrantsSkillsetRoot" AgentsToolsTeamMemberDirectoryText | LC_ALL=C awk -F'\t' 'NF && $1 != "" { print "member\t" $1 ; }'
		## the places before the grants, which are capped by their ceilings as they are read
		agentsGrantsPlaces="$( LocalToolsPlacesMergedText "$textWs" quiet )"
		agentsGrantsRoots="$( LocalToolsPlacesWorkspaceRoots "$textWs" )"
		printf '%s\n' "$agentsGrantsPlaces" | LC_ALL=C awk -F'\t' -v OFS='\t' 'NF >= 4 { print "place", $1, $2, $3, $4 ; }'
		while IFS= read -r textRoot ; do
			[ -n "$textRoot" ] || continue
			printf 'grant\tmagic-librarian:%s:skillset:approve:Edit(/%s/**.md)\n' "${textWs##*/}" "$textRoot"
		done <<< "$( AgentsToolsGrantsMemberSkills "$textWs" )"
		AgentsToolsTeamGrantRows "$textWs" permissions.registry | LC_ALL=C awk '{ print "grant\t" $0 ; }'
		## The temp floor holds for the given workspace itself, whatever folder it sits in. The
		## source rows below hold for a workspace of the machine, and come from that list alone.
		printf 'floor\twrite\t%s/.local/temp/**\n' "$textWs"
		while IFS= read -r textRoot ; do
			[ -n "$textRoot" ] || continue
			printf 'floor\twrite\t%s/.local/temp/**\n' "$textRoot"
			printf 'floor\tread\t%s/source/**/%s\n' "$textRoot" MAGIC.md "$textRoot" README.md "$textRoot" 'docs/**.md'
			## Every member reads an epic with no ask -- S6.41 and S17.4 -- wherever in source/ it sits.
			printf 'floor\tread\t%s/source/**.epic.md\n' "$textRoot"
			printf 'floor\twrite\t%s/source/**/MAGIC.md\n' "$textRoot"
			## The standing read of magic-librarian, as the registry of each such workspace
			## carries it, here too so it never waits on the next --make-agents-indices there.
			printf 'grant\tmagic-librarian:%s:builtin:Read(/%s/source/**)\n' "${textRoot##*/}" "$textRoot"
		done <<< "$agentsGrantsRoots"
		MDAT_SKILLSET_ROOT="$agentsGrantsSkillsetRoot" AgentsToolsClientAccessRootsMembers readable | LC_ALL=C awk '/^\// { print "floor\tread\t" $0 "/**" ; }'
		[ -z "${HOME:-}" ] || printf 'floor\tread\t%s/.claude/skills/**\n' "${HOME%/}"
	)" || return 1
	## Every literal directory a path starts with, resolved as the harness resolves the path
	## it checks, in one subshell: the nearest existing one through `cd -P`, the rest kept.
	## Each pattern opened by its own `(`: bash 3.2 misparses a bare `x)` inside `$( )`.
	textReal="$(
		unset CDPATH
		while IFS= read -r textBase ; do
			case "$textBase" in (/?*) ;; (*) continue ;; esac
			textProbe="$textBase" textRest=""
			while [ "$textProbe" != "/" ] && [ ! -d "$textProbe" ] ; do
				textRest="/${textProbe##*/}$textRest" ; textProbe="${textProbe%/*}" ; [ -n "$textProbe" ] || textProbe="/"
			done
			cd "$textProbe" 2> /dev/null && cd -P . 2> /dev/null || continue
			[ "${PWD%/}$textRest" = "$textBase" ] || printf 'real\t%s\t%s\n' "$textBase" "${PWD%/}$textRest"
		done <<< "$( printf '%s\n' "$textStream" | LC_ALL=C awk -v mode=bases -f "$agentsGrantsHere/grants/AgentsGrantsPattern.awk" -f "$agentsGrantsHere/grants/AgentsGrantsIndexBuild.awk" )"
	)"
	printf '%s\n%s\n' "$textReal" "$textStream" | LC_ALL=C awk -v self="${textWs##*/}" -f "$agentsGrantsHere/grants/AgentsGrantsPattern.awk" -f "$agentsGrantsHere/grants/AgentsGrantsIndexBuild.awk"
}

AgentsToolsGrantsIndexWrite(){ ## workspace
	local writeFile="${1%/}/.local/agents/grants.index" writeTemp writeSliceDir writeSliceNew
	## One index per member set root, so callers under different roots never rebuild each other's: the workspace's own root keeps the plain name.
	type AgentsToolsSkillsetRootInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.MemberWorkspace.Root.include"
	AgentsToolsSkillsetRootInto agentsGrantsSkillsetRoot "$1"
	[ "$agentsGrantsSkillsetRoot" = "${1%/}/.local/agents/members" ] || writeFile="$writeFile.${agentsGrantsSkillsetRoot//[!A-Za-z0-9._-]/_}"
	writeTemp="$( mktemp "$writeFile.XXXXXX" )" || writeTemp=""
	if [ -z "$writeTemp" ] || ! ( AgentsToolsGrantsIndexText "$1" ) > "$writeTemp" ; then
		[ -z "$writeTemp" ] || rm -f -- "$writeTemp"
		echo "⛔ ERROR: grants: the grants index generator failed -- $writeFile left unchanged" >&2
		return 1
	fi
	writeSliceDir="$writeFile.by-member"
	writeSliceNew="$( mktemp -d "$writeSliceDir.new.XXXXXX" )" || writeSliceNew=""
	[ -n "$writeSliceNew" ] || { rm -f -- "$writeTemp" ; return 1 ; }
	if ! ( umask 022 ; writeSliceNew="$writeSliceNew" LC_ALL=C awk -F'\t' '
		BEGIN { writeSlicePass = 1 ; writeSliceMemberCount = 0 ; writeSliceOutDir = ENVIRON["writeSliceNew"] ; }
		FNR == 1 && NR > 1 { writeSlicePass = 2 ; next ; }
		writeSlicePass == 1 {
			if ( FNR > 1 && $1 != "*" && $1 != "end" && ! ( $1 in writeSliceSeen ) ) { writeSliceSeen[$1] = 1 ; writeSliceMember[++writeSliceMemberCount] = $1 ; }
			next
		}
		{
			if ( $1 == "end" ) next
			if ( $1 == "*" ) { for ( writeSliceI = 1 ; writeSliceI <= writeSliceMemberCount ; writeSliceI++ ) print $0 >> ( writeSliceOutDir "/" writeSliceMember[writeSliceI] ) ; next ; }
			print $0 >> ( writeSliceOutDir "/" $1 )
		}
	' "$writeTemp" "$writeTemp" ) ; then
		rm -rf -- "$writeSliceNew" "$writeTemp"
		return 1
	fi
	chmod 755 "$writeSliceNew" || { rm -rf -- "$writeSliceNew" "$writeTemp" ; return 1 ; }
	chmod 644 "$writeTemp" || { rm -rf -- "$writeSliceNew" "$writeTemp" ; return 1 ; }
	[ ! -e "$writeSliceDir" ] || rm -rf -- "$writeSliceDir"
	[ ! -e "$writeSliceDir" ] || { rm -rf -- "$writeSliceNew" "$writeTemp" ; return 1 ; }
	mv -f -- "$writeSliceNew" "$writeSliceDir" || { rm -rf -- "$writeSliceNew" "$writeTemp" ; return 1 ; }
	mv -f -- "$writeTemp" "$writeFile" || { rm -f -- "$writeTemp" ; return 1 ; }
}

## A current index for a reader: agentsGrantsIndexFile names it, or, where .local/agents
## cannot be written, agentsGrantsIndexText holds it, computed in memory. A stale or missing
## one is rebuilt first; one whose rebuild failed is read as it stood. rc 1 with neither.
AgentsToolsGrantsIndexEnsure(){ ## workspace
	local ensureWs="${1%/}" ensureDir ensureFile
	agentsGrantsIndexFile="" ; agentsGrantsIndexText=""
	[ -n "$ensureWs" ] && [ -d "$ensureWs" ] || return 1
	ensureDir="$ensureWs/.local/agents" ; ensureFile="$ensureDir/grants.index"
	## One index per member set root, so callers under different roots never rebuild each other's: the workspace's own root keeps the plain name.
	type AgentsToolsSkillsetRootInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.MemberWorkspace.Root.include"
	AgentsToolsSkillsetRootInto agentsGrantsSkillsetRoot "$ensureWs"
	[ "$agentsGrantsSkillsetRoot" = "$ensureWs/.local/agents/members" ] || ensureFile="$ensureFile.${agentsGrantsSkillsetRoot//[!A-Za-z0-9._-]/_}"
	if AgentsToolsGrantsIndexFresh "$ensureWs" "$ensureFile" ; then
		agentsGrantsIndexFile="$ensureFile" ; return 0
	fi
	[ -d "$ensureDir" ] || mkdir -p "$ensureDir" 2> /dev/null || :
	if [ -d "$ensureDir" ] && [ -w "$ensureDir" ] ; then
		if AgentsToolsGrantsIndexWrite "$ensureWs" || [ -f "$ensureFile" ] ; then
			agentsGrantsIndexFile="$ensureFile" ; return 0
		fi
		return 1
	fi
	agentsGrantsIndexText="$( AgentsToolsGrantsIndexText "$ensureWs" )" || { agentsGrantsIndexText="" ; return 1 ; }
	return 0
}

## One member's rows of the index, `verb<TAB>glob<TAB>pattern<TAB>from`, read, write and tool
## rows only, from the current index. Nothing printed when there is none.
AgentsToolsGrantsMemberRows(){ ## workspace, member
	local rowsWho rowsVerb rowsGlob rowsPattern rowsFrom rowsRest
	AgentsToolsGrantsIndexEnsure "$1" || return 0
	while IFS=$'\t' read -r rowsWho rowsVerb rowsGlob rowsPattern rowsFrom rowsRest ; do
		[ "$rowsWho" = "$2" ] || continue
		case "$rowsVerb" in read|write|tool|deny-read|deny-write|deny-tool) printf '%s\t%s\t%s\t%s\n' "$rowsVerb" "$rowsGlob" "$rowsPattern" "$rowsFrom" ;; esac
	done < <( if [ -n "$agentsGrantsIndexFile" ] ; then cat "$agentsGrantsIndexFile" ; else printf '%s\n' "$agentsGrantsIndexText" ; fi )
}

## The read-only place a path lies in, by the ceiling rows of the current index: the deepest
## place holding it decides. Prints its name, rc 0; rc 1 when the path may be written.
AgentsToolsGrantsCeilingPlace(){ ## workspace, resolved path
	local ceilWho ceilVerb ceilGlob ceilPattern ceilCeiling ceilName
	AgentsToolsGrantsIndexEnsure "$1" || return 1
	while IFS=$'\t' read -r ceilWho ceilVerb ceilGlob ceilPattern ceilCeiling ceilName ; do
		[ "$ceilWho" = "*" ] && [ "$ceilVerb" = ceiling ] || continue
		[[ $2 == $ceilPattern ]] || continue
		[ "$ceilCeiling" = read-only ] || return 1
		printf '%s' "$ceilName"
		return 0
	done < <( if [ -n "$agentsGrantsIndexFile" ] ; then cat "$agentsGrantsIndexFile" ; else printf '%s\n' "$agentsGrantsIndexText" ; fi )
	return 1
}

## Whether a held grant glob covers a wanted target: the same text, or the target matching
## the glob's pattern. A wanted target with a .. segment is covered by its own text only.
AgentsToolsGrantsCovers(){ ## glob, pattern, wanted target
	[ "$1" != "$3" ] || return 0
	case "$3" in */../*|*/..|../*|..) return 1 ;; esac
	[[ $3 == $2 ]]
}

AgentsToolsGrantsToolCovers(){ ## granted tool, called tool
	[ "$1" != "$2" ] || return 0
	case "$1:$2" in Edit:Read|Edit:Grep|Edit:Glob|Write:Read|Write:Grep|Write:Glob) return 0 ;; esac
	return 1
}

## ---- the declared grants: the permissions registry -----------------------------------------

## A place of the merged list (agentsGrantsPlaces), by the name a grant gives it -- the name
## as the list writes it, or name@workspace -- of kind workspace only, or of any kind. Sets
## agentsGrantsPlacePath and agentsGrantsPlaceCeiling; rc 1 when no place is named so.
AgentsToolsGrantsPlaceFind(){ ## name, workspace|any
	local findName findKind findCeiling findPath findRoot findRest
	agentsGrantsPlacePath="" ; agentsGrantsPlaceCeiling=""
	while IFS=$'\t' read -r findName findKind findCeiling findPath findRoot findRest ; do
		case "$findPath" in /*) ;; *) continue ;; esac
		[ "$2" != workspace ] || [ "$findKind" = workspace ] || continue
		[ "$findName" = "$1" ] || [ "$findName@${findRoot##*/}" = "$1" ] || continue
		agentsGrantsPlacePath="${findPath%/}" ; agentsGrantsPlaceCeiling="$findCeiling"
		return 0
	done <<< "$agentsGrantsPlaces"
	return 1
}

## Every place of the merged list (agentsGrantsPlaces) of kind workspace whose name -- the
## name before any @workspace -- matches a shell pattern: its path on stdout, each once.
## None matching is no error: rc 0, nothing printed.
AgentsToolsGrantsPlaceMatch(){ ## pattern
	local matchName matchKind matchCeiling matchPath matchRest matchSeen=$'\n'
	while IFS=$'\t' read -r matchName matchKind matchCeiling matchPath matchRest ; do
		case "$matchPath" in /*) ;; *) continue ;; esac
		[ "$matchKind" = workspace ] || continue
		case "${matchName%@*}" in $1) ;; *) continue ;; esac
		matchPath="${matchPath%/}"
		case "$matchSeen" in *$'\n'"$matchPath"$'\n'*) continue ;; esac
		matchSeen="$matchSeen$matchPath"$'\n'
		printf '%s\n' "$matchPath"
	done <<< "$agentsGrantsPlaces"
	return 0
}

AgentsToolsGrantsRegistryWrite(){ ## workspace, op name for messages
	local regWs regName regOp="$2" regText regRc=0 regRows regTags regRoot regSkillsetRoot regOtherName regOtherText regOtherRc
	local regFile regTagsFile regLock regWait=0 regOld=""
	regWs="$( cd "${1%/}" 2> /dev/null && pwd )" || { echo "⛔ ERROR: $regOp: workspace not found: $1" >&2 ; return 1 ; }
	regName="${regWs##*/}"
	type LocalToolsPlacesMergedText > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/places/LocalTools.Places.include" || return 1
	type AgentsToolsTeamGrantPointerUpsert > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.TeamRegistry.include" || return 1
	type AgentsToolsClientAccessRootsMembers > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/client/AgentsTools.ClientAccessRoots.include" || return 1
	type AgentsToolsSkillsetRootInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.MemberWorkspace.Root.include" || return 1
	agentsGrantsPlaces="$( LocalToolsPlacesMergedText "$regWs" quiet )"
	agentsGrantsRoots="$( LocalToolsPlacesWorkspaceRoots "$regWs" )"
	type AgentsToolsGrantsDeclaredText > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.Grants.Declared.include"
	regText="$( AgentsToolsGrantsDeclaredText "$regWs" "$regOp" )" || regRc=$?
	if [ "$regRc" != 0 ] ; then
		[ "$regRc" = 3 ] || echo "🙋 WARNING: $regOp: declared allow-write was not determined for workspace $regWs, its permissions registry is kept as it stood" >&2
		return 0
	fi
	regFile="$regWs/.local/agents/permissions.registry"
	regTagsFile="$regWs/.local/agents/permissions-tags.registry"
	[ ! -f "$regFile" ] || regOld="$( cat "$regFile" )"
	regRows="$( printf '%s\n' "$regText" | LC_ALL=C sed -n 's/^row	//p' )"
	regTags="$( printf '%s\n' "$regText" | LC_ALL=C sed -n 's/^tag	//p' )"
	## Acting members only: nobody is granted write on the identity record.
	AgentsToolsSkillsetRootInto regSkillsetRoot "$regWs"
	while IFS= read -r regRoot ; do
		[ -n "$regRoot" ] || continue
		regRows="$regRows"$'\n'"${regRoot##*/}:$regName:member:Edit(/$regRoot/**)"
	done <<< "$( MDAT_SKILLSET_ROOT="$regSkillsetRoot" AgentsToolsClientAccessRootsMembers acting )"
	regRows="$regRows"$'\n'"magic-librarian:$regName:builtin:Read(/$regWs/source/**)"
	## AN INSTALL IS OF ITS OWN WORKSPACE ALONE (the human-owner): no other workspace's declares are read or carried here.
	## Each workspace's rows are its own data, rewritten whole under its lock, and only when
	## they change; every other workspace's are theirs and never touched.
	mkdir -p "${regFile%/*}" || { echo "⛔ ERROR: $regOp: cannot create ${regFile%/*}" >&2 ; return 1 ; }
	regLock="$regFile.lock"
	until mkdir "$regLock" 2> /dev/null ; do
		regWait=$(( regWait + 1 ))
		if [ "$regWait" -ge 10 ] ; then
			echo "⛔ ERROR: $regOp: permissions registry busy, lock not acquired after $regWait attempts: $regLock -- no grant was reconciled for workspace $regName" >&2
			return 1
		fi
		sleep 1
	done
	regRc=0
	printf '%s\n' "$regRows" | LC_ALL=C awk 'NF && !seenRow[$0]++' > "$regFile.tmp.$$" || regRc=1
	if [ "$regRc" = 0 ] && ! cmp -s "$regFile.tmp.$$" "$regFile" ; then
		mv -f "$regFile.tmp.$$" "$regFile" || regRc=1
	fi
	rm -f "$regFile.tmp.$$" 2> /dev/null
	if [ "$regRc" = 0 ] ; then
		{ printf '%s\n' "# generated by $regOp -- do not hand-edit, this file is fully rewritten on every run" ; printf '%s\n' "$regTags" | LC_ALL=C awk 'NF && !seenTag[$0]++' ; } > "$regTagsFile.tmp.$$" \
			&& { cmp -s "$regTagsFile.tmp.$$" "$regTagsFile" || mv -f "$regTagsFile.tmp.$$" "$regTagsFile" ; } || regRc=1
		rm -f "$regTagsFile.tmp.$$" 2> /dev/null
	fi
	rmdir "$regLock" 2> /dev/null || :
	if [ "$regRc" != 0 ] ; then
		echo "⛔ ERROR: $regOp: permissions registry rewrite failed for workspace $regName" >&2
		return 1
	fi
	AgentsToolsTeamGrantPointerUpsert "$regWs" || {
		echo "⛔ ERROR: $regOp: could not record $regWs in ${HOME:-}/.agents/magic-team/permissions.registry" >&2
		return 1
	}
	echo "# $regOp: wrote $regFile ($( printf '%s\n' "$regRows" | LC_ALL=C awk 'NF && !seenRow[$0]++' | LC_ALL=C grep -c . ) rows)" >&2
	return 0
}

## ---- the session's own index -------------------------------------------------------------

## The session stores a session's grants are read from, one directory per line, each once:
## its own, the coworking session's it joined, the parent session's that spawned it, by its
## spawn record (AgentsToolsPermissionRelatedStores), read with builtins.
AgentsToolsGrantsSessionStores(){ ## workspace, session id
	local storesWs="${1%/}" storesRecord storesLine storesFront storesCow="" storesParent="" storesSeen=$'\n' storesOne storesFolder
	type AgentsSessionRunRecordInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.include"
	AgentsSessionRunRecordInto storesRecord "$2" "$storesWs" || :
	for storesRecord in ${storesRecord:+"$storesRecord"} ; do
		[ -f "$storesRecord" ] || continue
		storesFront=""
		while IFS= read -r storesLine ; do
			case "$storesFront:$storesLine" in
				':---') storesFront=1 ;;
				'1:---'|'1:# '*) break ;;
				'1:session-id: '*) storesCow="${storesLine#session-id: }" ;;
				'1:parent-spawn-id: '*) storesParent="${storesLine#parent-spawn-id: }" ;;
				':'*) break ;;
			esac
		done < "$storesRecord"
		break
	done
	for storesOne in "$2" "$storesCow" "$storesParent" ; do
		case "$storesOne" in ''|*/*|.|..) continue ;; esac
		case "$storesSeen" in *$'\n'"$storesOne"$'\n'*) continue ;; esac
		storesSeen="$storesSeen$storesOne"$'\n'
		AgentsSessionFolderInto storesFolder "$storesWs" "$storesOne" || continue
		printf '%s\n' "$storesFolder"
	done
}

AgentsToolsGrantsRunSeats(){ ## workspace, session id
	local seatsWs="${1%/}" seatsSession="$2" seatsRecord seatsFront seatsLine seatsOwn="" seatsRefs=""
	local seatsReviewId seatsPath seatsSeen=$'\n' seatsRef seatsFolder seatsState
	case "$seatsSession" in ''|*/*|.|..) return 1 ;; esac
	type AgentsToolsBoardItemHeadersInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.ItemDecisions.include"
	[ -n "$seatsWs" ] || return 1
	type AgentsSessionRunRecordInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.include"
	AgentsSessionRunRecordInto seatsRecord "$seatsSession" "$seatsWs" || :
	for seatsRecord in ${seatsRecord:+"$seatsRecord"} ; do
		[ -f "$seatsRecord" ] || continue
		seatsFront=""
		while IFS= read -r seatsLine ; do
			case "$seatsFront:$seatsLine" in
				':---') seatsFront=1 ;;
				'1:---'|'1:# '*) break ;;
				'1:spawns: '*) seatsOwn="${seatsLine#spawns: }" ; seatsOwn="${seatsOwn%% *}" ; seatsOwn="${seatsOwn%.md}" ;;
				':'*) break ;;
			esac
		done < "$seatsRecord"
		break
	done
	case "$seatsOwn" in ''|*/*|.|..) return 1 ;; esac
	## The runs it spawned: each of their records names this run as its parent. From the parent's
	## children list where the lists are marked complete, else one grep over all the records
	## (AgentsToolsSpawnedChildRecords): this runs on every gate call, so it never forks once per record.
	type AgentsToolsSpawnedChildRecords > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.StartedRecords.include"
	while IFS= read -r seatsRecord ; do
		[ -f "$seatsRecord" ] || continue
		seatsReviewId="${seatsRecord##*/}" ; seatsReviewId="${seatsReviewId%.spawn.md}"
		case "$seatsSeen" in *$'\n'"$seatsReviewId"$'\n'*) continue ;; esac
		seatsSeen="$seatsSeen$seatsReviewId"$'\n'
		AgentsSessionFolderInto seatsFolder "$seatsWs" "$seatsReviewId" || continue
		printf '%s\n%s/output\n' "$seatsFolder" "${seatsRecord%/*}"
	done < <( AgentsToolsSpawnedChildRecords "$seatsSession" "$seatsWs" )
	## The peers its own dispatch item cites, `references:` naming them in item-names form.
	AgentsToolsBoardItemHeadersInto "$seatsOwn" seatsState seatsRefs=references || :
	for seatsRef in ${seatsRefs//,/ } ; do
		seatsRef="${seatsRef%.md}"
		case "$seatsRef" in ''|*/*|.|..) continue ;; esac
		seatsReviewId=""
		AgentsToolsBoardItemHeadersInto "$seatsRef" seatsState seatsReviewId=session-id || :
		case "$seatsReviewId" in ''|*/*|.|..) continue ;; esac
		case "$seatsSeen" in *$'\n'"$seatsReviewId"$'\n'*) continue ;; esac
		seatsSeen="$seatsSeen$seatsReviewId"$'\n'
		AgentsSessionFolderInto seatsFolder "$seatsWs" "$seatsReviewId" || continue
		printf '%s\n' "$seatsFolder"
		type AgentsSessionRunRecordInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.include"
		AgentsSessionRunRecordInto seatsPath "$seatsReviewId" "$seatsWs" || :
		for seatsPath in ${seatsPath:+"$seatsPath"} ; do
			[ -f "$seatsPath" ] || continue
			printf '%s/output\n' "${seatsPath%/*}"
			break
		done
	done
	return 0
}

AgentsToolsGrantsSessionEnded(){ ## session id, workspace (default MMDAPP)
	local endedId="" endedStore=""
	type AgentsSessionFolderInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.include" || return 1
	AgentsSessionFolderInto endedStore "${2:-${MMDAPP:-}}" "${1:-}" || return 1
	AgentsToolsGrantsStoreEnded "$endedStore"
}

## The same verdict for a store whose folder the caller already holds: the granted stores of a member's own runs, one a loop.
AgentsToolsGrantsStoreEnded(){ ## session store directory
	local endedStore="${1%/}" endedRoot endedId endedRecord endedLine endedFront endedSeen=""
	endedRoot="$endedStore"
	endedId="${endedRoot##*/}" ; endedRoot="${endedRoot%/*}" ; endedRoot="${endedRoot%/*}/spawned"
	case "$endedId" in ''|.|..) return 1 ;; esac
	for endedRecord in "$endedRoot"/*/"$endedId.spawn.md" ; do
		[ -f "$endedRecord" ] || continue
		endedSeen=1
		endedFront=""
		while IFS= read -r endedLine ; do
			case "$endedFront:$endedLine" in
				':---') endedFront=1 ;;
				'1:status: spawn-started') return 1 ;;
				## A session whose first launch failed may run on under a later spawn of its own folder: it has not ended while one is started.
				'1:status: spawn-'*)
					LC_ALL=C grep -qs '^status: spawn-started$' "$endedRoot/$endedId"/*.spawn.md && return 1
					## A session that wrote its own chat, roster or log after this record ran on, whatever the record says (S21.4).
					local endedOwn endedFresh=""
					for endedOwn in "$endedStore/session.chat" "$endedStore/dms-roster" "$endedStore/session.log" ; do
						[ -f "$endedOwn" ] && [ "$endedOwn" -nt "$endedRecord" ] && { endedFresh=1 ; break ; }
					done
					[ -z "$endedFresh" ] || return 1
					return 0
				;;
				'1:---'|'1:# '*|':'*) break ;;
			esac
		done < "$endedRecord"
	done
	[ -z "$endedSeen" ] && [ -e "$endedStore/ended" ]
}

## ---- one member's runs on one board item ---------------------------------------------------

AgentsToolsGrantsItemRuns(){ ## workspace, session id, member
	local runsWs="${1%/}" runsRecord runsFound="" runsKind runsValue runsItem="" runsSession="" runsStores="" runsCow="" runsCandidate runsFiles=() runsFolder
	agentsGrantsItemRunsItem="" ; agentsGrantsItemRunsSession="" ; agentsGrantsItemRunsStores=""
	case "$2" in ''|*/*|.|..) return 1 ;; esac
	[ -n "$runsWs" ] && [ -n "$3" ] || return 1
	## No record, no awk: a root session has none.
	type AgentsSessionRunRecordInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.include"
	AgentsSessionRunRecordInto runsRecord "$2" "$runsWs" || :
	for runsRecord in ${runsRecord:+"$runsRecord"} ; do
		[ ! -f "$runsRecord" ] || { runsFound=1 ; break ; }
	done
	[ -n "$runsFound" ] || return 1
	## The share is only within the run's own coworking session, so its candidates are that session's
	## records, from the kept per-session list (AgentsTools.StartedRecords.include), never every record
	## on a gate call. The session that one of these runs started is in the list too: its id is that run's.
	type AgentsToolsFrontmatterKey > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/common/AgentsTools.FrontmatterKey.include"
	runsCow="$( AgentsToolsFrontmatterKey "$runsRecord" session-id )" || runsCow=""
	case "$runsCow" in ''|*/*|.|..) return 1 ;; esac
	type AgentsToolsSpawnedSessionRecords > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.StartedRecords.include"
	while IFS= read -r runsCandidate ; do
		[ -n "$runsCandidate" ] && [ -f "$runsCandidate" ] || continue
		runsFiles+=( "$runsCandidate" )
	done < <( MMDAPP="$runsWs" AgentsToolsSpawnedSessionRecords "$runsCow" own )
	[ "${#runsFiles[@]}" -gt 0 ] || return 1
	while IFS=$'\t' read -r runsKind runsValue ; do
		case "$runsKind" in
			item) runsItem="$runsValue" ;;
			session) [ "$runsValue" = "-" ] || { AgentsSessionFolderInto runsFolder "$runsWs" "$runsValue" && runsSession="$runsFolder" ; } ;;
			store) AgentsSessionFolderInto runsFolder "$runsWs" "$runsValue" || continue ; runsStores="$runsStores$runsFolder"$'\n' ;;
		esac
	done < <( agentsGrantsItemRunsMember="$3" agentsGrantsItemRunsOwn="$2" LC_ALL=C awk -f "$agentsGrantsHere/grants/AgentsGrantsItemRuns.awk" ${runsFiles[@]+"${runsFiles[@]}"} 2> /dev/null )
	[ -n "$runsItem" ] && [ -n "$runsStores" ] || return 1
	agentsGrantsItemRunsItem="$runsItem" ; agentsGrantsItemRunsSession="$runsSession" ; agentsGrantsItemRunsStores="${runsStores%$'\n'}"
	return 0
}

## Whether what a member's runs on one item share is still live, by builtins only: the item is
## on the board in an open state, and the coworking session has not ended. Without the team
## data root the item cannot be read, and nothing is live.
AgentsToolsGrantsItemRunsLive(){ ## item, coworking session store (may be empty)
	[ -n "$1" ] && [ -n "${MDAT_DATA_ROOT:-}" ] || return 1
	[ -z "$2" ] || ! AgentsToolsGrantsStoreEnded "$2" || return 1
	type AgentsToolsBoardItemInStates > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.ItemDecisions.include"
	AgentsToolsBoardItemInStates "$1" ${agentsPermissionOpenStates:-running review blocked pending backlog parked}
}

AgentsToolsGrantsItemRunsLines(){ ## the session's own stores, one per line; task (optional)
	local linesStore linesOnly
	while IFS= read -r linesStore ; do
		[ -n "$linesStore" ] || continue
		linesOnly="${2:-only}"
		case $'\n'"$1"$'\n' in *$'\n'"$linesStore"$'\n'*) [ -z "${2:-}" ] || continue ; linesOnly="" ;; esac
		printf '%s\t%s\t%s\t%s\n' "$linesStore" "$agentsGrantsItemRunsItem" "${agentsGrantsItemRunsSession:--}" "$linesOnly"
	done <<< "$agentsGrantsItemRunsStores"
}

AgentsToolsGrantsSessionText(){ ## workspace, member, session id, sandbox input, sandbox output, origin skillset
	local textStore textRest textFiles=() agentsGrantsEnded="" agentsGrantsStores agentsGrantsItemRuns="" agentsGrantsRunSeats=""
	local textOwn=""
	type AgentsSessionFolderInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.include"
	AgentsSessionFolderInto textOwn "$1" "$3" || :
	local agentsGrantsSessionHeader agentsGrantsSandboxIn="$4" agentsGrantsSandboxOut="$5" agentsGrantsOrigin=""
	[ -z "$6" ] || agentsGrantsOrigin="$( cd "$6" 2> /dev/null && pwd -P )" || agentsGrantsOrigin=""
	agentsGrantsStores="$( AgentsToolsGrantsSessionStores "$1" "$3" )"
	## The run seats of this run alone (S6.41): the session record and the output/ folder of every
	## run it reviews, added as the floor's own rows, so a reviewer reads what it reviews with no ask.
	agentsGrantsRunSeats="$( AgentsToolsGrantsRunSeats "$1" "$3" )" || agentsGrantsRunSeats=""
	if AgentsToolsGrantsItemRuns "$1" "$3" "$2" ; then
		agentsGrantsItemRuns="$( AgentsToolsGrantsItemRunsLines "$agentsGrantsStores" )"
		while IFS=$'\t' read -r textStore textRest ; do
			case "$textRest" in *$'\t'only) agentsGrantsStores="$agentsGrantsStores"$'\n'"$textStore" ;; esac
		done <<< "$agentsGrantsItemRuns"
	fi
	while IFS= read -r textStore ; do
		[ -n "$textStore" ] || continue
		[ "$textStore" = "$textOwn" ] || AgentsToolsGrantsJoinedAdd "$textStore" "$textOwn"
		[ -f "$textStore/grants" ] || continue
		textFiles+=( "$textStore/grants" )
		## A store whose session has ended: its session grants are dropped here.
		! AgentsToolsGrantsStoreEnded "$textStore" || agentsGrantsEnded="$agentsGrantsEnded$textStore"$'\n'
	done <<< "$agentsGrantsStores"
	## The header a session file is written under: its format, the member, and the floor it adds.
	## AgentsToolsGrantsSessionRewrite reads these fields back, so a writer needs nothing else.
	agentsGrantsSessionHeader="$agentsGrantsSessionVersion"$'\t'"$2"$'\t'"$4"$'\t'"$5"$'\t'"$6"
	export agentsGrantsEnded agentsGrantsStores agentsGrantsItemRuns agentsGrantsRunSeats
	export agentsGrantsSessionHeader agentsGrantsSandboxIn agentsGrantsSandboxOut agentsGrantsOrigin
	if [ -n "$agentsGrantsIndexFile" ] ; then
		LC_ALL=C awk -v member="$2" -v commonApart=1 \
			-f "$agentsGrantsHere/grants/AgentsGrantsPattern.awk" -f "$agentsGrantsHere/grants/AgentsGrantsSessionIndex.awk" \
			"$agentsGrantsIndexFile" ${textFiles[@]+"${textFiles[@]}"}
	else
		printf '%s\n' "$agentsGrantsIndexText" | LC_ALL=C awk -v member="$2" -v commonApart=1 \
			-f "$agentsGrantsHere/grants/AgentsGrantsPattern.awk" -f "$agentsGrantsHere/grants/AgentsGrantsSessionIndex.awk" \
			- ${textFiles[@]+"${textFiles[@]}"}
	fi
}

AgentsToolsGrantsSessionEnsure(){ ## workspace, member, session id (may be empty), sandbox input, sandbox output, origin skillset
	local ensureWs="${1%/}"
	AgentsToolsGrantsSessionLocate "$ensureWs" "$2" "$3"
	if [ ! -f "$agentsGrantsIndexFile" ] ; then
		AgentsToolsGrantsIndexEnsure "$ensureWs" || return 1
	fi
	if [ -n "$agentsGrantsSessionFile" ] ; then
		[ -f "$agentsGrantsSessionFile" ] && return 0
		AgentsToolsGrantsSessionWrite "$ensureWs" "$2" "$3" "$4" "$5" "$6" && return 0
		agentsGrantsSessionFile=""
	fi
	agentsGrantsSessionText="$( AgentsToolsGrantsSessionText "$ensureWs" "$2" "$3" "$4" "$5" "$6" )" || { agentsGrantsSessionText="" ; return 1 ; }
	return 0
}

AgentsToolsGrantsSessionCheckRows(){ ## tool, resolved path, own session store
	local checkKind checkA checkB checkC checkD checkE checkWrite="" checkCeiling="" checkNow checkTtl checkApprove="${agentsGrantsCommonApprove:-}" checkApproveFrom="${agentsGrantsCommonApproveFrom:-}"
	agentsGrantsCheckLayer="" ; agentsGrantsCheckOnce="" ; agentsGrantsCheckPlace="" ; agentsGrantsCheckFrom=""
	case " Edit Write Execute " in *" $1 "*) checkWrite=1 ;; esac
	while IFS=$'\t' read -r checkKind checkA checkB checkC checkD checkE ; do
		case "$checkKind" in
			ceiling)
				[ -n "$checkWrite" ] && [ -z "$checkCeiling" ] || continue
				[[ $2 == $checkA ]] || continue
				checkCeiling=1
				[ "$checkB" = read-only ] || continue
				agentsGrantsCheckPlace="$checkC"
				return 3
			;;
			approve)
				[ -z "$checkApprove" ] || continue
				case "$checkA" in *" $1 "*) ;; *) continue ;; esac
				[[ $2 == $checkB ]] || continue
				checkApprove="$checkC" ; checkApproveFrom="$checkD"
			;;
			allow)
				## Never ahead of an approval: only a grant given for the work admits such a call.
				[ -z "$checkApprove" ] || continue
				case "$checkA" in *" $1 "*) ;; *) continue ;; esac
				[[ $2 == $checkB ]] || continue
				agentsGrantsCheckLayer="$checkC" ; agentsGrantsCheckFrom="$checkD"
				return 0
			;;
			session)
				AgentsToolsGrantsToolCovers "$checkA" "$1" && [[ $2 == $checkB ]] || continue
				## Its session may have ended since the rebuild: a joined store's end touches nothing here.
				[ -z "$checkD" ] || ! AgentsToolsGrantsStoreEnded "$checkD" || continue
				agentsGrantsCheckLayer="session $checkC"
				return 0
			;;
			runs)
				AgentsToolsGrantsToolCovers "$checkA" "$1" && [[ $2 == $checkB ]] || continue
				## Given to another run of the member on the same item: while that item is open and that session runs.
				[ "$checkE" != "-" ] || checkE=""
				AgentsToolsGrantsItemRunsLive "$checkD" "$checkE" || continue
				agentsGrantsCheckLayer="session $checkC"
				return 0
			;;
			task)
				AgentsToolsGrantsToolCovers "$checkA" "$1" && [[ $2 == $checkB ]] || continue
				[ -n "${MDAT_DATA_ROOT:-}" ] || continue
				type AgentsToolsBoardItemInStates > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.ItemDecisions.include"
				! AgentsToolsBoardItemInStates "$checkC" ${agentsPermissionOpenStates:-running review blocked pending backlog parked} || { agentsGrantsCheckLayer="task $checkC" ; return 0 ; }
			;;
			once)
				[ "$checkA" = "$1" ] && [[ $2 == $checkB ]] || continue
				[ ! -d "$3/consumed/$checkD" ] || continue
				checkTtl="${MDAT_PERMISSION_ONCE_TTL:-300}"
				case "$checkTtl" in ''|*[!0123456789]*) checkTtl=300 ;; esac
				[ "$checkTtl" -gt 0 ] || checkTtl=300
				checkNow="$( date -u +%s )" || continue
				case "$checkNow" in ''|*[!0123456789]*) continue ;; esac
				[ $(( checkNow - checkC )) -le "$checkTtl" ] || continue
				agentsGrantsCheckLayer="once $checkD" ; agentsGrantsCheckOnce="$checkD"
				return 0
			;;
			end) break ;;
		esac
	done
	[ -z "$checkApprove" ] || { agentsGrantsCheckLayer="approve $checkApprove" ; agentsGrantsCheckFrom="$checkApproveFrom" ; return 4 ; }
	return 1
}

AgentsToolsGrantsCommonCheckRows(){ ## tool, resolved path, member
	local rowWho rowVerb rowGlob rowPattern rowFifth rowSixth rowTools rowWrite="" rowCeiling="" rowAllow="" rowLayer="" rowFrom=""
	agentsGrantsCommonApprove="" ; agentsGrantsCommonApproveFrom=""
	agentsGrantsCheckLayer="" ; agentsGrantsCheckOnce="" ; agentsGrantsCheckPlace="" ; agentsGrantsCheckFrom=""
	case " Edit Write Execute " in *" $1 "*) rowWrite=1 ;; esac
	while IFS=$'\t' read -r rowWho rowVerb rowGlob rowPattern rowFifth rowSixth ; do
		case "$rowWho" in
			"*")
				[ "$rowVerb" = ceiling ] && [ -n "$rowWrite" ] && [ -z "$rowCeiling" ] || continue
				[[ $2 == $rowPattern ]] || continue
				rowCeiling=1
				[ "$rowFifth" = read-only ] || continue
				agentsGrantsCheckPlace="$rowSixth"
				return 3
			;;
			"$3")
				case "$rowVerb" in
					read) rowTools=" Read Grep Glob " ;;
					write) rowTools=" Read Edit Write Execute Grep Glob " ;;
					approve) rowTools=" Edit Write " ;;
					*) continue ;;
				esac
				case "$rowTools" in *" $1 "*) ;; *) continue ;; esac
				[[ $2 == $rowPattern ]] || continue
				if [ "$rowVerb" = approve ] ; then
					[ -n "$agentsGrantsCommonApprove" ] || { agentsGrantsCommonApprove="$rowFifth" ; agentsGrantsCommonApproveFrom="$rowSixth" ; }
				elif [ -z "$rowAllow" ] ; then
					rowAllow=1 ; rowLayer="$rowFifth" ; rowFrom="$rowSixth"
				fi
			;;
		esac
	done
	[ -z "$agentsGrantsCommonApprove" ] && [ -n "$rowAllow" ] || return 1
	agentsGrantsCheckLayer="$rowLayer" ; agentsGrantsCheckFrom="$rowFrom"
	return 0
}

## Where the two files of a check are. It tests and builds nothing: the session file is written
## at run start and by whatever changes it, and the grants index by the builder.
AgentsToolsGrantsSessionLocate(){ ## workspace, member, session id (may be empty)
	local locateWs="${1%/}"
	type AgentsToolsSkillsetRootInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.MemberWorkspace.Root.include"
	agentsGrantsCheckMember="$2" ; agentsGrantsSessionFile="" ; agentsGrantsSessionText="" ; agentsGrantsIndexText=""
	AgentsToolsSkillsetRootInto agentsGrantsSkillsetRoot "$locateWs"
	agentsGrantsIndexFile="$locateWs/.local/agents/grants.index"
	[ "$agentsGrantsSkillsetRoot" = "$locateWs/.local/agents/members" ] || agentsGrantsIndexFile="$agentsGrantsIndexFile.${agentsGrantsSkillsetRoot//[!A-Za-z0-9._-]/_}"
	case "$3" in
		''|*/*|.|..) ;;
		*) agentsGrantsSessionFile="$locateWs/.local/agents/sessions/$3/permissions.$2.index" ;;
	esac
}

## Writes a session's own file, into a temp file beside it, then mv -f. Run start and every
## writer of the session's grants call it, never a check.
AgentsToolsGrantsSessionWrite(){ ## workspace, member, session id, sandbox input, sandbox output, origin skillset
	local writeWs="${1%/}" writeFile writeTemp
	AgentsToolsGrantsSessionLocate "$writeWs" "$2" "$3"
	writeFile="$agentsGrantsSessionFile"
	[ -n "$writeFile" ] && [ -f "$agentsGrantsIndexFile" ] || return 1
	mkdir -p "${writeFile%/*}" 2> /dev/null || return 1
	writeTemp="$( mktemp "$writeFile.XXXXXX" 2> /dev/null )" || return 1
	if ( AgentsToolsGrantsSessionText "$writeWs" "$2" "$3" "$4" "$5" "$6" ) > "$writeTemp" && chmod 644 "$writeTemp" && mv -f -- "$writeTemp" "$writeFile" ; then
		return 0
	fi
	rm -f -- "$writeTemp"
	echo "⛔ ERROR: grants: the session permission file of $3 could not be written -- $writeFile left unchanged" >&2
	return 1
}

## Writes one session file again, from the fields of its own header.
AgentsToolsGrantsSessionRewrite(){ ## session permission file
	local rewriteLine="" rewriteMember rewriteIn rewriteOut rewriteOrigin rewriteDir="${1%/*}" rewriteWs="" rewriteSession=""
	[ -f "$1" ] || return 0
	type AgentsSessionStorePartsInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.include"
	IFS= read -r rewriteLine < "$1" || return 0
	rewriteLine="${rewriteLine#*$'\t'}"
	rewriteMember="${rewriteLine%%$'\t'*}" ; rewriteLine="${rewriteLine#*$'\t'}"
	rewriteIn="${rewriteLine%%$'\t'*}" ; rewriteLine="${rewriteLine#*$'\t'}"
	rewriteOut="${rewriteLine%%$'\t'*}" ; rewriteLine="${rewriteLine#*$'\t'}"
	rewriteOrigin="${rewriteLine%%$'\t'*}"
	AgentsSessionStorePartsInto rewriteWs rewriteSession "$rewriteDir" || return 1
	AgentsToolsGrantsSessionWrite "$rewriteWs" "$rewriteMember" "$rewriteSession" "$rewriteIn" "$rewriteOut" "$rewriteOrigin"
}

## A store whose grants another session's file joins records that session, so a change of its
## grants rewrites that file too (AgentsToolsGrantsStoreTouch).
AgentsToolsGrantsJoinedAdd(){ ## joined store, joining store
	## A store with no grant yet has no folder: it is made here, or its first grant would never reach this session.
	mkdir -p "$1" 2> /dev/null || return 0
	LC_ALL=C grep -qxF -- "$2" "$1/grants.joined" 2> /dev/null || printf '%s\n' "$2" >> "$1/grants.joined" 2> /dev/null || :
}

## One file-tool call decided by the two files: the grants index, then the session's own. It takes the session id and the workspace,
## and asks the session store for that session's folder: no caller builds a path into the session store to hand it over.
AgentsToolsGrantsSessionCheck(){ ## tool, resolved path, session id, workspace (default MMDAPP)
	local commonRc=0 commonSlice="" checkStore=""
	type AgentsSessionFolderInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.include" || return 1
	AgentsSessionFolderInto checkStore "${4:-${MMDAPP:-}}" "${3:-}" || checkStore=""
	if [ -n "${agentsGrantsIndexFile:-}" ] && [ -f "$agentsGrantsIndexFile" ] ; then
		commonSlice="$agentsGrantsIndexFile.by-member/${agentsGrantsCheckMember:-}"
		if [ -f "$commonSlice" ] && [ ! "$agentsGrantsIndexFile" -nt "$commonSlice" ] ; then
			AgentsToolsGrantsCommonCheckRows "$1" "$2" "${agentsGrantsCheckMember:-}" < "$commonSlice" || commonRc=$?
		else
			AgentsToolsGrantsCommonCheckRows "$1" "$2" "${agentsGrantsCheckMember:-}" < "$agentsGrantsIndexFile" || commonRc=$?
		fi
	else
		AgentsToolsGrantsCommonCheckRows "$1" "$2" "${agentsGrantsCheckMember:-}" <<< "${agentsGrantsIndexText:-}" || commonRc=$?
	fi
	case "$commonRc" in 0|3) return "$commonRc" ;; esac
	if [ -n "$agentsGrantsSessionFile" ] && [ -f "$agentsGrantsSessionFile" ] ; then
		AgentsToolsGrantsSessionCheckRows "$1" "$2" "$checkStore" < "$agentsGrantsSessionFile"
	else
		AgentsToolsGrantsSessionCheckRows "$1" "$2" "$checkStore" <<< "${agentsGrantsSessionText:-}"
	fi
}

## Whether the call that check decided last was decided by magic-librarian's standing write on
## a team member's skill file (AgentsToolsGrantsMemberSkills), by the origin of its row: a
## read it admitted, or an Edit or a Write it holds for approval (rc 4).
AgentsToolsGrantsCheckSkillset(){
	case "$agentsGrantsCheckFrom" in ?*:skillset) return 0 ;; esac
	return 1
}

## A session's grants or seats changed: opening, using up or revoking a grant, or a spawn
## that names this session its parent. Every session file holding them is written again now.
## It takes the session id and the workspace, and asks the session store for the folder.
AgentsToolsGrantsStoreTouch(){ ## session id, workspace (default MMDAPP)
	local touchStore=""
	type AgentsSessionFolderInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.include" || return 1
	AgentsSessionFolderInto touchStore "${2:-${MMDAPP:-}}" "${1:-}" || return 0
	AgentsToolsGrantsStoreTouchDir "$touchStore"
}

## The same, for a store whose folder the caller already holds: the granted stores of a member's own runs, one a loop.
AgentsToolsGrantsStoreTouchDir(){ ## session store directory
	local touchFile touchJoined
	[ -d "$1" ] || return 0
	touch "$1/grants" 2> /dev/null || :
	for touchFile in "$1"/permissions.*.index ; do
		AgentsToolsGrantsSessionRewrite "$touchFile" || :
	done
	[ -f "$1/grants.joined" ] || return 0
	while IFS= read -r touchJoined ; do
		for touchFile in "$touchJoined"/permissions.*.index ; do
			AgentsToolsGrantsSessionRewrite "$touchFile" || :
		done
	done < "$1/grants.joined"
}

AgentsToolsGrantsMemberList(){ ## workspace, member, session id (may be empty)
	local listWs="${1%/}" listStores listStore listUsed listFiles=() listTtl listRest listKind listRun listItem listCow listShared="" listRecords=()
	local agentsGrantsEnded="" agentsGrantsUsed="" agentsGrantsBoard="${MDAT_DATA_ROOT:+$MDAT_DATA_ROOT/board}" agentsGrantsItemRuns=""
	local agentsGrantsOpenStates="${agentsPermissionOpenStates:-running review blocked pending backlog parked}"
	type AgentsSessionFolderInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.include"
	AgentsToolsGrantsIndexEnsure "$listWs" || return 1
	if [ -n "$3" ] ; then
		listStores="$( AgentsToolsGrantsSessionStores "$listWs" "$3" )"
		if AgentsToolsGrantsItemRuns "$listWs" "$3" "$2" ; then
			AgentsToolsGrantsItemRunsLive "$agentsGrantsItemRunsItem" "$agentsGrantsItemRunsSession" || listShared=task
			agentsGrantsItemRuns="$( AgentsToolsGrantsItemRunsLines "$listStores" "$listShared" )"
			while IFS=$'\t' read -r listStore listRest ; do
				case "$listRest" in *$'\t'only|*$'\t'task) listStores="$listStores"$'\n'"$listStore" ;; esac
			done <<< "$agentsGrantsItemRuns"
		fi
	else
		type AgentsSessionFoldersFind > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.include"
		listStores="$( AgentsSessionFoldersFind "$listWs" grants )"
		type AgentsToolsSpawnedAllRecordsInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.StartedRecords.include"
		AgentsToolsSpawnedAllRecordsInto listRecords "$listWs"
		if [ "${#listRecords[@]}" -gt 0 ] ; then
			while IFS=$'\t' read -r listKind listRun listItem listCow ; do
				[ "$listKind" = run ] || continue
				AgentsSessionFolderInto listStore "$listWs" "$listRun" || continue
				[ -f "$listStore/grants" ] && AgentsToolsGrantsStoreEnded "$listStore" || continue
				if [ "$listCow" = "-" ] ; then listCow="" ; else AgentsSessionFolderInto listCow "$listWs" "$listCow" || continue ; fi
				AgentsToolsGrantsItemRunsLive "$listItem" "$listCow" || continue
				agentsGrantsItemRuns="$agentsGrantsItemRuns$listStore"$'\t'"$listItem"$'\t'"${listCow:--}"$'\t\n'
			done < <( agentsGrantsItemRunsMember="$2" agentsGrantsItemRunsOwn="" LC_ALL=C awk -f "$agentsGrantsHere/grants/AgentsGrantsItemRuns.awk" ${listRecords[@]+"${listRecords[@]}"} 2> /dev/null )
		fi
	fi
	while IFS= read -r listStore ; do
		[ -n "$listStore" ] && [ -f "$listStore/grants" ] || continue
		listFiles+=( "$listStore/grants" )
		! AgentsToolsGrantsStoreEnded "$listStore" || agentsGrantsEnded="$agentsGrantsEnded$listStore"$'\n'
		for listUsed in "$listStore/consumed"/* ; do
			[ ! -d "$listUsed" ] || agentsGrantsUsed="$agentsGrantsUsed$listUsed"$'\n'
		done
	done <<< "$listStores"
	listTtl="${MDAT_PERMISSION_ONCE_TTL:-300}"
	case "$listTtl" in ''|*[!0123456789]*) listTtl=300 ;; esac
	[ "$listTtl" -gt 0 ] || listTtl=300
	export agentsGrantsEnded agentsGrantsUsed agentsGrantsBoard agentsGrantsOpenStates agentsGrantsItemRuns
	{ if [ -n "$agentsGrantsIndexFile" ] ; then cat "$agentsGrantsIndexFile" ; else printf '%s\n' "$agentsGrantsIndexText" ; fi ; } \
		| LC_ALL=C awk -v mode=list -v member="$2" -v now="$( date -u +%s )" -v ttl="$listTtl" \
			-f "$agentsGrantsHere/grants/AgentsGrantsPattern.awk" -f "$agentsGrantsHere/grants/AgentsGrantsSessionIndex.awk" \
			- ${listFiles[@]+"${listFiles[@]}"}
}
