#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## Caller-less daemon loop: spawns magic-coordinator.heartbeat.routine's own
## next-iteration pass, sleeps, repeats forever, no cap. Sourced from
## DistroAgentsTools.fn.sh's `--intern-main-loop` arm; needs $1/$@/$MDSC_CMD
## from dot-sourcing. Mirrors --intern-mcp-server's own shape: usage blurb
## on no flag, set +e/set -e discipline.
##

case "$1" in

	--intern-main-loop)
		shift

		## Never run without a mode: an accidental invocation hangs forever.
		local mainLoopMode=''
		case "$1" in
			--run) mainLoopMode='--run' ;;
			--one) mainLoopMode='--one' ;;
		esac
		if [ -z "$mainLoopMode" ] ; then
			printf '%s\n' "$MDSC_CMD --intern-main-loop -- spawns and keeps magic-coordinator.heartbeat.routine's own next-iteration cycle running forever, normal daemon/respawn-loop, no cap." >&2
			printf '%s\n' "" >&2
			printf '%s\n' "  $MDSC_CMD --intern-main-loop --run" >&2
			printf '%s\n' "      Spawn one heartbeat next-iteration, sleep, repeat -- forever, until killed." >&2
			printf '%s\n' "      This is the basement layer that RUNS own-service mode, not merely gated behind it already being up." >&2
			printf '%s\n' "" >&2
			printf '%s\n' "  $MDSC_CMD --intern-main-loop --one" >&2
			printf '%s\n' "      Spawn exactly one heartbeat next-iteration and return its status. No sleep, no repeat." >&2
			printf '%s\n' "      Runs the same readiness check, so it is also how that gate is exercised by hand." >&2
			printf '%s\n' "" >&2
			printf '%s\n' "Runs a short readiness check first and prints a compact report; the loop is entered only when all required settings are present." >&2
			set +e ; return 1
		fi
		shift

		if [ 0 -lt $# ] ; then
			printf '%s\n' "$MDSC_CMD: main-loop $mainLoopMode: ⛔ ERROR: takes no further arguments: $*" >&2
			set +e ; return 1
		fi

		set +e

		## Short readiness check, run from here and shown as a compact,
		## plain-language report before the loop is entered. check-configs only
		## PROBES presence here (every key --optional); the readiness report owns
		## the floor policy -- which items gate, and how Basic comms is satisfied
		## by any one transport -- and its own exit (PIPESTATUS[1]) is the gate.
		## The floor is TEAM_DATA_DIRECTORY + Basic comms + SPAWN_CLI_SERVICE,
		## which is magic-team's and needs the second probe; the event-track and
		## event-alert channels are probed for the report but never gate.
		## The report goes to STDERR, like the per-iteration lines below: this
		## operation is a daemon loop whose whole life is watched on stderr, so
		## the readiness verdict belongs on the same stream as everything else
		## it says. Nothing consumes this report on stdout -- the awk's exit is
		## the machine-readable half, and PIPESTATUS[1] survives the redirect:
		## the group is one pipeline stage, so the awk is still stage 1.
		{
			DistroAgentsTools --intern-op-check-configs magic-coordinator \
				--optional "TEAM_DATA_DIRECTORY:<path>" \
				--optional "SLACK_CHANNEL_MAGIC_TEAM:<channel-id>" \
				--optional "SLACK_CHANNEL_HUMAN_OWNER:<user-id>" \
				--optional "SLACK_CHANNEL_EVENT_TRACK:<channel-id>" \
				--optional "SLACK_CHANNEL_EVENT_ALERT:<channel-id>" \
				--context --intern-main-loop 2>&1
			DistroAgentsTools --intern-op-check-configs magic-team \
				--optional "SPAWN_CLI_SERVICE:<cli-name>" \
				--context --intern-main-loop 2>&1
			## Sign-in state of the selected CLI, as one more verdict line into the
			## same awk, asked with this workspace's own stored credential in scope
			## -- the console exports exactly these names before it execs, so
			## probing without them reports a machine that spawns perfectly well as
			## signed out. The export lives in the probe's own subshell.
			## Reported, never gating: the CLI's own answer is the only reliable
			## one, so a CLI that cannot answer -- any but claude, one too old for
			## `auth status`, one absent from PATH -- yields SKIP rather than a
			## verdict, and no output shape this does not recognise can refuse a
			## machine that works. `claude auth status` reads local state only,
			## ~0.3s once at startup, stdin closed so nothing can prompt; it
			## answers loggedIn true for an API key and for a Bedrock/Vertex
			## provider too, so those working setups are not misread as signed out.
			case "$( DistroAgentsTools --agents-config-option magic-team --select SPAWN_CLI_SERVICE 2>/dev/null )" in
				claude)
					case "$(
						for mainLoopAuthKey in ANTHROPIC_API_KEY CLAUDE_CODE_OAUTH_TOKEN ; do
							mainLoopAuthValue="$( DistroAgentsTools --agents-config-option magic-team --select "$mainLoopAuthKey" 2>/dev/null )"
							[ -n "$mainLoopAuthValue" ] || continue
							export "$mainLoopAuthKey=$mainLoopAuthValue"
						done
						claude auth status </dev/null 2>/dev/null
					)" in
						*'"loggedIn": true'*)  echo "SPAWN_CLI_AUTHENTICATED: OK" ;;
						*'"loggedIn": false'*) echo "SPAWN_CLI_AUTHENTICATED: FAIL" ;;
						*)                     echo "SPAWN_CLI_AUTHENTICATED: SKIP" ;;
					esac
				;;
				*) echo "SPAWN_CLI_AUTHENTICATED: SKIP" ;;
			esac
		} | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsMainLoopReadinessReport.awk" >&2
		if [ 0 -ne "${PIPESTATUS[1]}" ] ; then
			return 1
		fi

		## The spawn brief is a real file now, so it can be missing, empty or
		## unreadable -- which the spawn proxy only reports further down, as
		## "empty spawn context". The path is a constant and the file ships with
		## the code, so this is a startup failure, checked once here, never a
		## per-iteration test that would turn a permanent misconfiguration into
		## an endless backoff.
		local mainLoopBriefFile="$MDLT_ORIGIN/myx/myx.distro-agents/skillset/magic-team/magic-team/dispatches/main-loop-next-iteration.prompt-packet.verbatim.md"
		if [ ! -r "$mainLoopBriefFile" ] || [ ! -s "$mainLoopBriefFile" ] ; then
			echo "$MDSC_CMD: main-loop $mainLoopMode: ⛔ ERROR: spawn brief missing, empty or unreadable: $mainLoopBriefFile" >&2
			return 1
		fi

		local sleepSeconds spawnRc nextDelaySeconds maxDelaySeconds mainLoopCliService
		## The spawn proxy reports LAUNCHED/STATUS/EXIT_CODE on stdout. A command
		## substitution would wait on pipe EOF and hang on any lingering child, so the
		## documented remedy is a file plus a backgrounded command whose own PID $! is.
		local mainLoopStatusFile="$MMDAPP/.local/temp/mdat-main-loop-status.$$" mainLoopExitCode
		sleepSeconds="$( DistroAgentsTools --agents-config-option magic-coordinator --select-default MAIN_LOOP_RESTART_DELAY_SECONDS 29 )"
		case "$sleepSeconds" in *[!0123456789]*|'') sleepSeconds=29 ;; esac
		maxDelaySeconds="$( DistroAgentsTools --agents-config-option magic-coordinator --select-default MAIN_LOOP_RESTART_DELAY_MAX_SECONDS 1200 )"
		case "$maxDelaySeconds" in *[!0123456789]*|'') maxDelaySeconds=1200 ;; esac
		nextDelaySeconds="$sleepSeconds"

		## Team data is pulled by the loop, not by the deploy, and only when a remote is
		## configured. The branch is passed explicitly and never left empty: clonePull
		## compares the checkout against "${branch:-master}" AND "${branch:-main}", so an
		## empty value deletes any checkout on a third branch and re-clones it every
		## iteration. A configured value collapses both arms to one correct test.
		local mainLoopDataRemote mainLoopDataBranch
		mainLoopDataRemote="$( DistroAgentsTools --agents-config-option magic-team --select TEAM_DATA_GIT_REMOTE 2>/dev/null )"
		mainLoopDataBranch="$( DistroAgentsTools --agents-config-option magic-team --select-default TEAM_DATA_BRANCH main )"
		[ -n "$mainLoopDataBranch" ] || mainLoopDataBranch="main"
		local mainLoopTeamData="skipped" mainLoopTeamDataFailures=0

		## Read from outside by a health check, so it is an interface rather than scratch:
		## it lives beside the other durable command data, is world-readable, and is
		## written atomically. Nothing secret may ever be added to it.
		local mainLoopStateFile="$MMDAPP/.local/agents/main-loop.state"
		local mainLoopConsecutiveFailures=0

		local mainLoopInterrupted="false" mainLoopSpawnPid=""
		## One Ctrl-C must kill whatever's in flight and stop the loop outright.
		## Without this, SIGINT only interrupts the currently blocked `wait`
		## (bash's own special case for that builtin) and the loop sails on to
		## the next iteration -- forwarded to $mainLoopSpawnPid (empty during
		## the sleep below, where a plain foreground `sleep` just dies on the
		## signal by itself); that PID's own trap (the spawn-proxy's --wait
		## block) forwards further down the real child chain, same pattern as
		## the console script's own claude-streaming fix.
		trap 'mainLoopInterrupted="true" ; [ -z "$mainLoopSpawnPid" ] || kill -TERM "$mainLoopSpawnPid" 2>/dev/null' INT TERM

		## Health reporting must never kill what it reports on, so every step is swallowed:
		## set -e is in force and a failing mktemp, write, chmod or mv would end the loop.
		## Atomic by the same recipe as the console -- chmod before the rename, because mv
		## carries the temp's mode -- so an external reader never sees a half-written file.
		AgentsToolsMainLoopWriteState() {
			local stateOutcome="$1" stateTemp
			(
				mkdir -p "$MMDAPP/.local/agents"
				stateTemp="$( mktemp "$mainLoopStateFile.XXXXXX" )"
				{
					printf 'MAIN_LOOP_LAST_OUTCOME=%s\n' "$stateOutcome"
					printf 'MAIN_LOOP_LAST_ITERATION_UTC=%s\n' "$( date -u +%Y-%m-%dT%H:%M:%SZ )"
					printf 'MAIN_LOOP_CONSECUTIVE_FAILURES=%s\n' "$mainLoopConsecutiveFailures"
					printf 'MAIN_LOOP_CURRENT_DELAY_SECONDS=%s\n' "$nextDelaySeconds"
					printf 'MAIN_LOOP_TEAM_DATA=%s\n' "$mainLoopTeamData"
					printf 'MAIN_LOOP_TEAM_DATA_CONSECUTIVE_FAILURES=%s\n' "$mainLoopTeamDataFailures"
				} > "$stateTemp"
				chmod 644 "$stateTemp"
				mv "$stateTemp" "$mainLoopStateFile"
			) 2>/dev/null || echo "# $MDSC_CMD --intern-main-loop: could not write $mainLoopStateFile -- the loop is unaffected, the health check is blind" >&2
		}

		## Non-fatal by design: a network fault must not stop a loop that can still serve
		## its local copy, and failing the iteration would lengthen the backoff -- making
		## the loop do LESS work exactly when its data is stale. clonePull self-cleans a
		## failed clone, so there is never a partial checkout to run against, and its own
		## ConnectTimeout/BatchMode exports bound an unreachable remote to ~15-45s rather
		## than hanging an unattended box. Persistent staleness is reported in the state
		## file rather than logged and forgotten.
		AgentsToolsMainLoopSyncTeamData() {
			[ -n "$mainLoopDataRemote" ] || { mainLoopTeamData="skipped" ; return 0 ; }
			if [ -z "${MYXROOT:-}" ] || [ ! -f "$MYXROOT/bin/git/clonePull.Common" ] ; then
				mainLoopTeamData="skipped"
				echo "# $MDSC_CMD --intern-main-loop: team-data sync skipped -- myx.common git/clonePull unreachable" >&2
				return 0
			fi
			if ( "$MYXROOT/bin/git/clonePull.Common" "$MDAT_DATA_ROOT" "$mainLoopDataRemote" "$mainLoopDataBranch" >&2 ) ; then
				mainLoopTeamData="ok" ; mainLoopTeamDataFailures=0
			else
				mainLoopTeamData="stale" ; mainLoopTeamDataFailures=$(( mainLoopTeamDataFailures + 1 ))
				echo "# $MDSC_CMD --intern-main-loop: team-data sync failed ($mainLoopTeamDataFailures in a row), continuing on the local copy" >&2
			fi
			return 0
		}

		## One heartbeat pass, spawn to reaped child, leaving the child's status in $spawnRc.
		AgentsToolsMainLoopIteration() {
			AgentsToolsMainLoopSyncTeamData
			## The spawn runs --wait, so without these lines the caller is silent for a whole iteration.
			echo "# $MDSC_CMD --intern-main-loop: heartbeat iteration starting" >&2
			## Named here so the choice is visible from the output itself, not only
			## discoverable by reading config. SPAWN_CLI_SERVICE is guaranteed set by
			## the time this line runs: the readiness check earlier in this same
			## operation already gates entry on its presence, returning 1 before
			## this is ever called if it's unset. "not set" below
			## is a defensive label only, never expected to actually print.
			mainLoopCliService="$( DistroAgentsTools --agents-config-option magic-team --select SPAWN_CLI_SERVICE 2>/dev/null )"
			echo "# $MDSC_CMD --intern-main-loop: 🤖 spawning via ${mainLoopCliService:-not set}" >&2
			## Captured rather than merged into stderr: these five lines are the contract.
			## Cost of capturing, accepted knowingly: they reach the log after the spawn
			## ends instead of streaming live, so a long --wait goes quiet where it did not.
			mkdir -p "$MMDAPP/.local/temp"
			cat "$mainLoopBriefFile" | DistroAgentsTools --magic-heartbeat-spawn-proxy magic-coordinator --wait > "$mainLoopStatusFile" &
			mainLoopSpawnPid=$!
			spawnRc=0
			wait "$mainLoopSpawnPid" 2>/dev/null || spawnRc=$?
			while kill -0 "$mainLoopSpawnPid" 2>/dev/null ; do
				spawnRc=0
				wait "$mainLoopSpawnPid" 2>/dev/null || spawnRc=$?
			done
			mainLoopSpawnPid=""
			## Nothing may sit between a wait and its spawnRc above: any diagnostic there
			## becomes what $? reports. Everything below runs once the status is already held.
			cat "$mainLoopStatusFile" >&2 2>/dev/null || :
			## Required positively. Absent, empty, unreadable or truncated all read as
			## failure -- never look for LAUNCHED=false and take its absence for success.
			if ! grep -q '^LAUNCHED=true$' "$mainLoopStatusFile" 2>/dev/null ; then
				[ 0 -ne "$spawnRc" ] || spawnRc=1
			fi
			## Two sources of truth, and the verdict is their union: the process status
			## catches a writer that died before writing, the contract catches the rest.
			mainLoopExitCode="$( sed -n 's/^EXIT_CODE=//p' "$mainLoopStatusFile" 2>/dev/null | tail -1 )"
			case "$mainLoopExitCode" in
				''|*[!0123456789]*|0) ;;
				*) [ 0 -ne "$spawnRc" ] || spawnRc="$mainLoopExitCode" ;;
			esac
			rm -f "$mainLoopStatusFile"
		}

		## Every clean-stop path writes "stopped" before returning. That is the whole point
		## of a state file over a success flag: a reader can tell a loop deliberately
		## stopped from one wedged or crashed, which a timestamp alone cannot. The three
		## interrupt returns below are exactly the paths a bottom-of-loop write would miss.
		AgentsToolsMainLoopStopped() {
			AgentsToolsMainLoopWriteState stopped
			echo "# $MDSC_CMD --intern-main-loop: interrupted, stopping" >&2
		}

		## One look: same iteration, no sleep, no loop to leave.
		if [ '--one' = "$mainLoopMode" ] ; then
			AgentsToolsMainLoopIteration
			trap - INT TERM
			[ "$mainLoopInterrupted" = "false" ] || { AgentsToolsMainLoopStopped ; return 130 ; }
			[ 0 -eq "$spawnRc" ] || echo "# $MDSC_CMD --intern-main-loop: iteration FAILED, spawn proxy rc=$spawnRc -- the spawned session's own output is in the log named by the OUTPUT_FILE line above" >&2
			[ 0 -eq "$spawnRc" ] && mainLoopConsecutiveFailures=0 || mainLoopConsecutiveFailures=1
			[ 0 -eq "$spawnRc" ] && AgentsToolsMainLoopWriteState ok || AgentsToolsMainLoopWriteState failed
			return "$spawnRc"
		fi

		while true ; do
			AgentsToolsMainLoopIteration
			[ "$mainLoopInterrupted" = "false" ] || { trap - INT TERM ; AgentsToolsMainLoopStopped ; return 130 ; }
			[ 0 -eq "$spawnRc" ] || echo "# $MDSC_CMD --intern-main-loop: iteration FAILED, spawn proxy rc=$spawnRc -- the spawned session's own output is in the log named by the OUTPUT_FILE line above" >&2

			## Consecutive failures lengthen the wait; the delay is the state, so doubling stops at the ceiling and cannot overflow.
			if [ 0 -eq "$spawnRc" ] ; then
				nextDelaySeconds="$sleepSeconds"
				mainLoopConsecutiveFailures=0
			else
				mainLoopConsecutiveFailures=$(( mainLoopConsecutiveFailures + 1 ))
				[ "$nextDelaySeconds" -ge "$maxDelaySeconds" ] || nextDelaySeconds=$(( nextDelaySeconds * 2 ))
			fi
			[ "$nextDelaySeconds" -le "$maxDelaySeconds" ] || nextDelaySeconds="$maxDelaySeconds"
			## Written after the delay is computed and before it is served: the reader's
			## question is "should I have heard from you by now?", which needs the tolerance
			## for the silence about to start, not the one already over.
			[ 0 -eq "$spawnRc" ] && AgentsToolsMainLoopWriteState ok || AgentsToolsMainLoopWriteState failed
			echo "# $MDSC_CMD --intern-main-loop: iteration ended, sleeping ${nextDelaySeconds}s before the next one" >&2
			sleep "$nextDelaySeconds"
			[ "$mainLoopInterrupted" = "false" ] || { trap - INT TERM ; AgentsToolsMainLoopStopped ; return 130 ; }
		done
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;

esac
