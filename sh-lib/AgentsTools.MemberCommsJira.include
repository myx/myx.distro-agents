#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.MemberCommsJira.include -- the raw per-member Jira Cloud comms
## operations (identity, JQL search, issue read, comment read). READ SIDE ONLY:
## nothing here creates or edits an issue, a comment or a field.
##

## Assigns into the CALLER's already-declared locals: jiraSite jiraUser jiraToken
AgentsToolsJiraResolveMember() {
	local opName="$1"
	local memberName="$2"

	AgentsToolsAssertBareName "$memberName" "<team-member>" "$opName" || return 1
	case "$memberName" in
		routine-*)
			## A routine acting as caller has no skill directory and is not expected to grow one.
		;;
		*)
			if [ ! -d "$MDAT_SKILLSET_ROOT/$memberName" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --$opName: no such member skill directory: $MDAT_SKILLSET_ROOT/$memberName" >&2
				return 1
			fi
		;;
	esac

	## Strictly the acting member's own scope, no fallback: an Atlassian API token
	## IS an identity, and acting under the wrong one raises no error at all.
	jiraSite="$( DistroAgentsTools --agents-config-option "$memberName" --select JIRA_SITE )"
	jiraUser="$( DistroAgentsTools --agents-config-option "$memberName" --select JIRA_USER )"
	jiraToken="$( DistroAgentsTools --agents-config-option "$memberName" --select JIRA_API_TOKEN )"
	if [ -z "$jiraSite" ] || [ -z "$jiraUser" ] || [ -z "$jiraToken" ] ; then
		echo "⛔ ERROR: $MDSC_CMD --$opName: JIRA_SITE/JIRA_USER/JIRA_API_TOKEN not fully set in ${memberName}'s own scope in .local/.agents. Jira keeps its own key set even where one Atlassian token also serves Confluence, so a CONFLUENCE_* value is never read here" >&2
		return 1
	fi

	## An embedded newline means the stored config is corrupted, and it is refused
	## rather than stripped: the resulting 401 reads as a revoked credential.
	local jiraNewline=$'\n'
	case "$jiraSite$jiraUser$jiraToken" in
		*"$jiraNewline"*)
			echo "⛔ ERROR: $MDSC_CMD --$opName: JIRA_SITE/JIRA_USER/JIRA_API_TOKEN in ${memberName}'s own scope in .local/.agents contains a newline -- none of them ever legitimately does, so the config is corrupted. The value is NOT stripped or repaired here: the resulting 401 would be misread as a revoked credential" >&2
			return 1
		;;
	esac
	return 0
}

## One invocation of the Jira worker, credentials passed ONLY through the
## environment -- never argv, never a file.
AgentsToolsJiraCall() {
	AGENTS_JIRA_SITE="$jiraSite" \
	AGENTS_JIRA_USER="$jiraUser" \
	AGENTS_JIRA_API_TOKEN="$jiraToken" \
	AGENTS_JIRA_OP="$1" \
	AGENTS_JIRA_ISSUE_KEY="${jiraIssueKey:-}" \
	AGENTS_JIRA_JQL="${jiraJql:-}" \
	AGENTS_JIRA_LIMIT="${jiraLimit:-}" \
	AGENTS_JIRA_FORMAT="${jiraFormat:-}" \
	python3 "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsJiraApiCall.py"
}

## The shared Atlassian layer, sourced for its definitions only. Its own case
## ends in a branch that does nothing when $1 is none of its own operations, so
## this dispatches nothing and is safe to repeat.
. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.InternOpAtlassianCall.include"

## One paged Agile-API read: the shared transport, the body on stdout, and the
## one truncation signal these endpoints carry. Arguments are acting member,
## path, calling context. It reads nothing from a caller's frame, so no arm
## owes it a declaration.
AgentsToolsJiraAgileRead() {
	local agileBody agileRc=0
	agileBody="$( AgentsToolsAtlassianCall "$1" jira GET "$2" "$3" "" )" || agileRc=$?
	if [ "$agileRc" -ne 0 ] ; then
		echo "⛔ ERROR: $MDSC_CMD --$3: COULD NOT READ $2 as $1 (rc=$agileRc) -- the result set is UNKNOWN, not empty; the diagnostic above is the site's own" >&2
		return "$agileRc"
	fi
	printf '%s\n' "$agileBody"
	## isLast is the only truncation signal these endpoints carry, and its
	## absence is UNKNOWN rather than a confirmation that the page is the set.
	local agileIsLast="$( printf '%s\n' "$agileBody" | LC_ALL=C awk -v path=isLast -v optional=1 -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsAtlassianJsonField.awk" 2>/dev/null )"
	case "$agileIsLast" in
		true) ;;
		false)
			echo "# $MDSC_CMD --$3: isLast=false -- MORE RESULTS EXIST beyond this page and were not read. What is above is a prefix of the set, not the set" >&2
		;;
		*)
			echo "# $MDSC_CMD --$3: this response carried no isLast field, so whether more results exist is UNKNOWN -- it is not a confirmation that the page is complete" >&2
		;;
	esac
	return 0
}

case "$1" in

		--member-comms-jira-whoami)
			shift
			local memberName="$1"
			shift || true
			if [ -z "$memberName" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-whoami: syntax is <team-member> -- the acting member is required, since an API token resolves to exactly one Atlassian account and this operation exists to say which one" >&2
				set +e ; return 1
			fi
			if [ $# -gt 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-whoami: takes exactly one argument" >&2
				set +e ; return 1
			fi
			local jiraSite jiraUser jiraToken
			AgentsToolsJiraResolveMember member-comms-jira-whoami "$memberName" || { set +e ; return 1 ; }
			local jiraRc=0
			AgentsToolsJiraCall whoami || jiraRc=$?
			if [ "$jiraRc" -ne 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-whoami: COULD NOT DETERMINE which Atlassian account ${memberName}'s credential resolves to (worker rc=$jiraRc) -- the acting identity is UNKNOWN, which is NOT the same as anonymous; the worker's own diagnostic is above" >&2
				set +e ; return "$jiraRc"
			fi
			return 0
		;;

		--member-comms-jira-issue-search)
			shift
			local memberName="$1"
			shift || true
			local jiraJql="$1"
			shift || true
			if [ -z "$memberName" ] || [ -z "$jiraJql" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-search: syntax is <team-member> <jql> [--limit <n>] -- the acting member is required, since a search returns only what that identity can see. Jira refuses an unrestricted query, so the JQL names at least one restriction: project = DATA ORDER BY updated DESC" >&2
				set +e ; return 1
			fi
			local jiraLimit=""
			while [ $# -gt 0 ] ; do
				case "$1" in
					--limit)
						shift
						if [ -z "$1" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-search: --limit requires a value" >&2
							set +e ; return 1
						fi
						jiraLimit="$1" ; shift
					;;
					*)
						echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-search: invalid option: $1" >&2
						set +e ; return 1
					;;
				esac
			done
			local jiraSite jiraUser jiraToken
			AgentsToolsJiraResolveMember member-comms-jira-issue-search "$memberName" || { set +e ; return 1 ; }
			local jiraRc=0
			AgentsToolsJiraCall issue-search || jiraRc=$?
			if [ "$jiraRc" -ne 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-search: COULD NOT SEARCH as $memberName (worker rc=$jiraRc) -- the result set is UNKNOWN, not empty; nothing is known from this call about whether any issue matches. The worker's own diagnostic is above" >&2
				set +e ; return "$jiraRc"
			fi
			return 0
		;;

		--member-comms-jira-issue-read)
			shift
			local memberName="$1"
			shift || true
			local jiraIssueKey="$1"
			shift || true
			if [ -z "$memberName" ] || [ -z "$jiraIssueKey" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-read: syntax is <team-member> <issue-key> [--format adf|rendered] -- the acting member is required, since an issue is readable only by identities its project is shared with" >&2
				set +e ; return 1
			fi
			AgentsToolsAssertBareName "$jiraIssueKey" "<issue-key>" member-comms-jira-issue-read || { set +e ; return 1 ; }
			local jiraFormat=""
			while [ $# -gt 0 ] ; do
				case "$1" in
					--format)
						shift
						if [ -z "$1" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-read: --format requires a value: adf or rendered" >&2
							set +e ; return 1
						fi
						jiraFormat="$1" ; shift
					;;
					*)
						echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-read: invalid option: $1" >&2
						set +e ; return 1
					;;
				esac
			done
			local jiraSite jiraUser jiraToken
			AgentsToolsJiraResolveMember member-comms-jira-issue-read "$memberName" || { set +e ; return 1 ; }
			local jiraRc=0
			AgentsToolsJiraCall issue-read || jiraRc=$?
			if [ "$jiraRc" -ne 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-read: COULD NOT READ issue $jiraIssueKey as $memberName (worker rc=$jiraRc) -- the content is UNKNOWN, not empty. Note a 404 from Jira does NOT establish that the issue is absent: it returns 404 both for a missing issue and for one this account cannot see. The worker's own diagnostic is above" >&2
				set +e ; return "$jiraRc"
			fi
			return 0
		;;

		## One issue's comments, as TSV with its own header row. Same --format
		## meaning as issue-read, applied to each comment body.
		--member-comms-jira-comment-read)
			shift
			local memberName="$1"
			shift || true
			local jiraIssueKey="$1"
			shift || true
			if [ -z "$memberName" ] || [ -z "$jiraIssueKey" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-comment-read: syntax is <team-member> <issue-key> [--format adf|rendered] -- the acting member is required, since comments are visible only to identities the issue is shared with" >&2
				set +e ; return 1
			fi
			AgentsToolsAssertBareName "$jiraIssueKey" "<issue-key>" member-comms-jira-comment-read || { set +e ; return 1 ; }
			local jiraFormat=""
			while [ $# -gt 0 ] ; do
				case "$1" in
					--format)
						shift
						if [ -z "$1" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-comment-read: --format requires a value: adf or rendered" >&2
							set +e ; return 1
						fi
						jiraFormat="$1" ; shift
					;;
					*)
						echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-comment-read: invalid option: $1" >&2
						set +e ; return 1
					;;
				esac
			done
			local jiraSite jiraUser jiraToken
			AgentsToolsJiraResolveMember member-comms-jira-comment-read "$memberName" || { set +e ; return 1 ; }
			local jiraRc=0
			AgentsToolsJiraCall comment-read || jiraRc=$?
			if [ "$jiraRc" -ne 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-comment-read: COULD NOT READ comments on issue $jiraIssueKey as $memberName (worker rc=$jiraRc) -- the comment list is UNKNOWN, not empty; the worker's own diagnostic is above" >&2
				set +e ; return "$jiraRc"
			fi
			return 0
		;;

		--member-comms-jira-board-list)
			shift
			local memberName="$1"
			shift || true
			if [ -z "$memberName" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-board-list: syntax is <team-member> -- the acting member is required, since a board is visible only to identities its project is shared with" >&2
				set +e ; return 1
			fi
			if [ $# -gt 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-board-list: takes exactly one argument" >&2
				set +e ; return 1
			fi
			local jiraRc=0
			AgentsToolsJiraAgileRead "$memberName" /rest/agile/1.0/board member-comms-jira-board-list || jiraRc=$?
			if [ "$jiraRc" -ne 0 ] ; then set +e ; return "$jiraRc" ; fi
			return 0
		;;

		--member-comms-jira-board-read)
			shift
			local memberName="$1"
			shift || true
			local jiraBoardId="$1"
			shift || true
			if [ -z "$memberName" ] || [ -z "$jiraBoardId" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-board-read: syntax is <team-member> <board-id> -- the acting member is required, since a board is visible only to identities its project is shared with" >&2
				set +e ; return 1
			fi
			if [ $# -gt 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-board-read: takes exactly two arguments" >&2
				set +e ; return 1
			fi
			## A board id is a whole number. Enumerated, never a bracket range.
			case "$jiraBoardId" in
				*[!0123456789]*)
					echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-board-read: <board-id> must be a whole number, got: $jiraBoardId" >&2
					set +e ; return 1
				;;
			esac
			## One board is a single object rather than a page, so it carries no
			## isLast and is read through the transport directly.
			local jiraRc=0
			AgentsToolsAtlassianCall "$memberName" jira GET "/rest/agile/1.0/board/$jiraBoardId" member-comms-jira-board-read "" || jiraRc=$?
			if [ "$jiraRc" -ne 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-board-read: COULD NOT READ board $jiraBoardId as $memberName (rc=$jiraRc) -- the board is UNKNOWN, not absent. A 404 from Jira does NOT establish that the board does not exist: it answers 404 both for a missing board and for one this account cannot see" >&2
				set +e ; return "$jiraRc"
			fi
			return 0
		;;

		--member-comms-jira-board-issue-search)
			shift
			local memberName="$1"
			shift || true
			local jiraBoardId="$1"
			shift || true
			if [ -z "$memberName" ] || [ -z "$jiraBoardId" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-board-issue-search: syntax is <team-member> <board-id> -- the acting member is required, since the issues returned are only those that identity can see" >&2
				set +e ; return 1
			fi
			if [ $# -gt 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-board-issue-search: takes exactly two arguments" >&2
				set +e ; return 1
			fi
			case "$jiraBoardId" in
				*[!0123456789]*)
					echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-board-issue-search: <board-id> must be a whole number, got: $jiraBoardId" >&2
					set +e ; return 1
				;;
			esac
			local jiraRc=0
			AgentsToolsJiraAgileRead "$memberName" "/rest/agile/1.0/board/$jiraBoardId/issue" member-comms-jira-board-issue-search || jiraRc=$?
			if [ "$jiraRc" -ne 0 ] ; then set +e ; return "$jiraRc" ; fi
			return 0
		;;

		--member-comms-jira-sprint-list)
			shift
			local memberName="$1"
			shift || true
			local jiraBoardId="$1"
			shift || true
			if [ -z "$memberName" ] || [ -z "$jiraBoardId" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-sprint-list: syntax is <team-member> <board-id> -- a sprint belongs to a board, and the acting member is required since the board is visible only to identities it is shared with" >&2
				set +e ; return 1
			fi
			if [ $# -gt 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-sprint-list: takes exactly two arguments" >&2
				set +e ; return 1
			fi
			case "$jiraBoardId" in
				*[!0123456789]*)
					echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-sprint-list: <board-id> must be a whole number, got: $jiraBoardId" >&2
					set +e ; return 1
				;;
			esac
			local jiraRc=0
			AgentsToolsJiraAgileRead "$memberName" "/rest/agile/1.0/board/$jiraBoardId/sprint" member-comms-jira-sprint-list || jiraRc=$?
			if [ "$jiraRc" -ne 0 ] ; then set +e ; return "$jiraRc" ; fi
			return 0
		;;

		--member-comms-jira-sprint-issue-search)
			shift
			local memberName="$1"
			shift || true
			local jiraSprintId="$1"
			shift || true
			if [ -z "$memberName" ] || [ -z "$jiraSprintId" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-sprint-issue-search: syntax is <team-member> <sprint-id> -- the acting member is required, since the issues returned are only those that identity can see" >&2
				set +e ; return 1
			fi
			if [ $# -gt 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-sprint-issue-search: takes exactly two arguments" >&2
				set +e ; return 1
			fi
			case "$jiraSprintId" in
				*[!0123456789]*)
					echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-sprint-issue-search: <sprint-id> must be a whole number, got: $jiraSprintId" >&2
					set +e ; return 1
				;;
			esac
			local jiraRc=0
			AgentsToolsJiraAgileRead "$memberName" "/rest/agile/1.0/sprint/$jiraSprintId/issue" member-comms-jira-sprint-issue-search || jiraRc=$?
			if [ "$jiraRc" -ne 0 ] ; then set +e ; return "$jiraRc" ; fi
			return 0
		;;

		## A --member-comms-jira-* name this file does not implement. Reported,
		## never swallowed.
		--member-comms-jira-*)
			echo "⛔ ERROR: $MDSC_CMD: unknown --member-comms-jira-* operation: $1 -- the supported operations are --member-comms-jira-whoami, --member-comms-jira-issue-search, --member-comms-jira-issue-read, --member-comms-jira-comment-read, --member-comms-jira-board-list, --member-comms-jira-board-read, --member-comms-jira-board-issue-search, --member-comms-jira-sprint-list and --member-comms-jira-sprint-issue-search" >&2
			set +e ; return 1
		;;

		## DEFINITIONS-ONLY SOURCE. Nothing to dispatch, and nothing is an error:
		## the supported way for another include to reach this file's helpers.
		*)
			:
		;;

esac
