#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

case "$1" in

		## The member stubs. Each acts under the named member's own credentials, so a spawned
		## session names only itself (AgentsToolsActingMemberCheck); tooling calls the
		## --intern-op-comms-jira-* implementation below directly.
		--member-comms-jira-board-list|--member-comms-jira-board-read|--member-comms-jira-board-issue-search|--member-comms-jira-sprint-list|--member-comms-jira-sprint-issue-search|--member-comms-jira-issue-read)
			[ -z "${2:-}" ] || AgentsToolsActingMemberCheck "$2" "${1#--}" || { set +e ; return 1 ; }
			DistroAgentsTools "--intern-op-${1#--member-}" "${@:2}"
			return $?
		;;

		--intern-op-comms-jira-board-list)
			shift
			local actingMember="${1:-}"
			shift || { printf '%s\n' "⛔ ERROR: $MDSC_CMD --member-comms-jira-board-list: <team-member> missing" >&2 ; set +e ; return 1 ; }
			[ -n "$actingMember" ] || { printf '%s\n' "⛔ ERROR: $MDSC_CMD --member-comms-jira-board-list: <team-member> missing" >&2 ; set +e ; return 1 ; }
			case "$#:${1:-}" in
				0:|2:--start-at) ;;
				*) printf '%s\n' "⛔ ERROR: $MDSC_CMD --member-comms-jira-board-list: not accepted: $actingMember $*" >&2 ; set +e ; return 1 ;;
			esac
			local opRc=0
			DistroAgentsTools --intern-op-atlassian-jira-board-list --member "$actingMember" --context member-comms-jira-board-list "$@" || opRc=$?
			if [ "$opRc" -ne 0 ] ; then set +e ; return "$opRc" ; fi
			return 0
		;;

		--intern-op-comms-jira-board-read)
			shift
			local actingMember="${1:-}" boardId="${2:-}"
			shift || { printf '%s\n' "⛔ ERROR: $MDSC_CMD --member-comms-jira-board-read: <team-member> missing" >&2 ; set +e ; return 1 ; }
			[ -n "$actingMember" ] || { printf '%s\n' "⛔ ERROR: $MDSC_CMD --member-comms-jira-board-read: <team-member> missing" >&2 ; set +e ; return 1 ; }
			shift || { printf '%s\n' "⛔ ERROR: $MDSC_CMD --member-comms-jira-board-read: <board-id> missing" >&2 ; set +e ; return 1 ; }
			[ -n "$boardId" ] || { printf '%s\n' "⛔ ERROR: $MDSC_CMD --member-comms-jira-board-read: <board-id> missing" >&2 ; set +e ; return 1 ; }
			case "$#:${1:-}" in
				0:) ;;
				*) printf '%s\n' "⛔ ERROR: $MDSC_CMD --member-comms-jira-board-read: not accepted: $actingMember $boardId $*" >&2 ; set +e ; return 1 ;;
			esac
			local opRc=0
			DistroAgentsTools --intern-op-atlassian-jira-board-read --member "$actingMember" --context member-comms-jira-board-read --board-id "$boardId" || opRc=$?
			if [ "$opRc" -ne 0 ] ; then set +e ; return "$opRc" ; fi
			return 0
		;;

		--intern-op-comms-jira-board-issue-search)
			shift
			local actingMember="${1:-}" boardId="${2:-}"
			shift || { printf '%s\n' "⛔ ERROR: $MDSC_CMD --member-comms-jira-board-issue-search: <team-member> missing" >&2 ; set +e ; return 1 ; }
			[ -n "$actingMember" ] || { printf '%s\n' "⛔ ERROR: $MDSC_CMD --member-comms-jira-board-issue-search: <team-member> missing" >&2 ; set +e ; return 1 ; }
			shift || { printf '%s\n' "⛔ ERROR: $MDSC_CMD --member-comms-jira-board-issue-search: <board-id> missing" >&2 ; set +e ; return 1 ; }
			[ -n "$boardId" ] || { printf '%s\n' "⛔ ERROR: $MDSC_CMD --member-comms-jira-board-issue-search: <board-id> missing" >&2 ; set +e ; return 1 ; }
			case "$#:${1:-}" in
				0:|2:--start-at) ;;
				*) printf '%s\n' "⛔ ERROR: $MDSC_CMD --member-comms-jira-board-issue-search: not accepted: $actingMember $boardId $*" >&2 ; set +e ; return 1 ;;
			esac
			local opRc=0
			DistroAgentsTools --intern-op-atlassian-jira-board-issue-search --member "$actingMember" --context member-comms-jira-board-issue-search --board-id "$boardId" "$@" || opRc=$?
			if [ "$opRc" -ne 0 ] ; then set +e ; return "$opRc" ; fi
			return 0
		;;

		--intern-op-comms-jira-sprint-list)
			shift
			local actingMember="${1:-}" boardId="${2:-}"
			shift || { printf '%s\n' "⛔ ERROR: $MDSC_CMD --member-comms-jira-sprint-list: <team-member> missing" >&2 ; set +e ; return 1 ; }
			[ -n "$actingMember" ] || { printf '%s\n' "⛔ ERROR: $MDSC_CMD --member-comms-jira-sprint-list: <team-member> missing" >&2 ; set +e ; return 1 ; }
			shift || { printf '%s\n' "⛔ ERROR: $MDSC_CMD --member-comms-jira-sprint-list: <board-id> missing" >&2 ; set +e ; return 1 ; }
			[ -n "$boardId" ] || { printf '%s\n' "⛔ ERROR: $MDSC_CMD --member-comms-jira-sprint-list: <board-id> missing" >&2 ; set +e ; return 1 ; }
			case "$#:${1:-}" in
				0:|2:--start-at) ;;
				*) printf '%s\n' "⛔ ERROR: $MDSC_CMD --member-comms-jira-sprint-list: not accepted: $actingMember $boardId $*" >&2 ; set +e ; return 1 ;;
			esac
			local opRc=0
			DistroAgentsTools --intern-op-atlassian-jira-sprint-list --member "$actingMember" --context member-comms-jira-sprint-list --board-id "$boardId" "$@" || opRc=$?
			if [ "$opRc" -ne 0 ] ; then set +e ; return "$opRc" ; fi
			return 0
		;;

		--intern-op-comms-jira-sprint-issue-search)
			shift
			local actingMember="${1:-}" sprintId="${2:-}"
			shift || { printf '%s\n' "⛔ ERROR: $MDSC_CMD --member-comms-jira-sprint-issue-search: <team-member> missing" >&2 ; set +e ; return 1 ; }
			[ -n "$actingMember" ] || { printf '%s\n' "⛔ ERROR: $MDSC_CMD --member-comms-jira-sprint-issue-search: <team-member> missing" >&2 ; set +e ; return 1 ; }
			shift || { printf '%s\n' "⛔ ERROR: $MDSC_CMD --member-comms-jira-sprint-issue-search: <sprint-id> missing" >&2 ; set +e ; return 1 ; }
			[ -n "$sprintId" ] || { printf '%s\n' "⛔ ERROR: $MDSC_CMD --member-comms-jira-sprint-issue-search: <sprint-id> missing" >&2 ; set +e ; return 1 ; }
			case "$#:${1:-}" in
				0:|2:--start-at) ;;
				*) printf '%s\n' "⛔ ERROR: $MDSC_CMD --member-comms-jira-sprint-issue-search: not accepted: $actingMember $sprintId $*" >&2 ; set +e ; return 1 ;;
			esac
			local opRc=0
			DistroAgentsTools --intern-op-atlassian-jira-sprint-issue-search --member "$actingMember" --context member-comms-jira-sprint-issue-search --sprint-id "$sprintId" "$@" || opRc=$?
			if [ "$opRc" -ne 0 ] ; then set +e ; return "$opRc" ; fi
			return 0
		;;

		--intern-op-comms-jira-issue-read)
			shift
			local actingMember="${1:-}" issueKey="${2:-}"
			shift || { printf '%s\n' "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-read: <team-member> missing" >&2 ; set +e ; return 1 ; }
			[ -n "$actingMember" ] || { printf '%s\n' "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-read: <team-member> missing" >&2 ; set +e ; return 1 ; }
			shift || { printf '%s\n' "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-read: <issue-key> missing" >&2 ; set +e ; return 1 ; }
			[ -n "$issueKey" ] || { printf '%s\n' "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-read: <issue-key> missing" >&2 ; set +e ; return 1 ; }
			case "$#:${1:-}" in
				0:|2:--format) ;;
				*) printf '%s\n' "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-read: not accepted: $actingMember $issueKey $*" >&2 ; set +e ; return 1 ;;
			esac
			local opRc=0
			type AgentsToolsAtlassianJiraIssueRead > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.InternOpAtlassianCall.include"
			AgentsToolsAtlassianJiraIssueRead --member "$actingMember" --context member-comms-jira-issue-read --issue-key "$issueKey" "$@" || opRc=$?
			if [ "$opRc" -ne 0 ] ; then set +e ; return "$opRc" ; fi
			return 0
		;;

		--member-comms-jira-*|--intern-op-comms-jira-*)
			printf '%s\n' "⛔ ERROR: $MDSC_CMD: unknown --member-comms-jira-* operation: $1 -- the supported operations are --member-comms-jira-board-list, --member-comms-jira-board-read, --member-comms-jira-board-issue-search, --member-comms-jira-sprint-list, --member-comms-jira-sprint-issue-search and --member-comms-jira-issue-read" >&2
			set +e ; return 1
		;;

		## DEFINITIONS-ONLY SOURCE. Nothing to dispatch, and nothing is an error:
		## the supported way for another include to reach this file's helpers.
		*)
			:
		;;

esac
