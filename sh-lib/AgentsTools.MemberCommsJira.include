#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.MemberCommsJira.include -- the raw per-member Jira Cloud comms
## operations: identity, JQL search, issue read, comment read, issue create,
## issue update, issue transition, comment add. Transport is the shared
## Atlassian layer (AgentsTools.InternOpAtlassianCall.include) plus the two
## Atlassian JSON readers beside it; the one write-side JSON merge/validation
## step (AgentsAtlassianJsonObjectMerge.py) is the only Python involved.
##

## The shared Atlassian layer, sourced for its definitions only. Its own case
## ends in a branch that does nothing when $1 is none of its own operations, so
## this dispatches nothing and is safe to repeat.
. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.InternOpAtlassianCall.include"

## One paged Agile-API read: the shared transport, the body on stdout, and the
## one truncation signal these endpoints carry. Arguments are acting member,
## path, calling context, and an optional continuation value from a prior
## call's own response (its startAt plus its maxResults, summed by the
## caller) -- passed through verbatim as this request's own startAt, never
## parsed or normalized here. It reads nothing else from a caller's frame, so
## no arm owes it a declaration.
AgentsToolsJiraAgileRead() {
	local agilePath="$2"
	if [ -n "${4:-}" ] ; then
		case "$agilePath" in
			*'?'*) agilePath="${agilePath}&startAt=$4" ;;
			*)     agilePath="${agilePath}?startAt=$4" ;;
		esac
	fi
	local agileBody agileRc=0
	agileBody="$( AgentsToolsAtlassianCall "$1" jira GET "$agilePath" "$3" "" )" || agileRc=$?
	if [ "$agileRc" -ne 0 ] ; then
		echo "⛔ ERROR: $MDSC_CMD --$3: COULD NOT READ $agilePath as $1 (rc=$agileRc) -- the result set is UNKNOWN, not empty; the diagnostic above is the site's own" >&2
		return "$agileRc"
	fi
	printf '%s\n' "$agileBody"
	## isLast is the only truncation signal these endpoints carry, and its
	## absence is UNKNOWN rather than a confirmation that the page is the set.
	local agileIsLast="$( printf '%s\n' "$agileBody" | LC_ALL=C awk -v path=isLast -v optional=1 -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsAtlassianJsonField.awk" 2>/dev/null )"
	case "$agileIsLast" in
		true) ;;
		false)
			echo "# $MDSC_CMD --$3: isLast=false -- MORE RESULTS EXIST beyond this page and were not read. Read this page's own startAt and maxResults from the body above and pass their sum back as this operation's own --start-at to continue" >&2
		;;
		*)
			echo "# $MDSC_CMD --$3: this response carried no isLast field, so whether more results exist is UNKNOWN -- it is not a confirmation that the page is complete" >&2
		;;
	esac
	return 0
}

## Validates that a caller-supplied ADF document (an issue description, a
## comment body) is at least syntactically valid JSON before it is spliced
## into a request body -- a malformed value here would otherwise surface as a
## confusing Atlassian 400 instead of a clear local one. Arguments: the JSON
## text, a label for the error, and the calling context.
AgentsToolsJiraAdfValidate() {
	local adfText="$1" adfLabel="$2" adfContext="$3"
	if ! python3 -c "import json,sys; json.loads(sys.argv[1])" "$adfText" >/dev/null 2>&1 ; then
		echo "⛔ ERROR: $MDSC_CMD --$adfContext: $adfLabel is not valid JSON -- an Atlassian Document Format value is a full JSON document ({\"type\":\"doc\",\"version\":1,\"content\":[...]}), and the value passed did not parse as one" >&2
		return 1
	fi
	return 0
}

case "$1" in

		--member-comms-jira-whoami)
			shift
			local memberName="$1"
			shift || true
			if [ -z "$memberName" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-whoami: syntax is <team-member> -- the acting member is required, since an API token resolves to exactly one Atlassian account and this operation exists to say which one" >&2
				set +e ; return 1
			fi
			if [ $# -gt 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-whoami: takes exactly one argument" >&2
				set +e ; return 1
			fi
			local jiraBody jiraRc=0
			jiraBody="$( AgentsToolsAtlassianCall "$memberName" jira GET /rest/api/3/myself member-comms-jira-whoami "" )" || jiraRc=$?
			if [ "$jiraRc" -ne 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-whoami: COULD NOT DETERMINE which Atlassian account ${memberName}'s credential resolves to (rc=$jiraRc) -- the acting identity is UNKNOWN, which is NOT the same as anonymous; the diagnostic above is the site's own" >&2
				set +e ; return "$jiraRc"
			fi
			local jiraFieldAwk="$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsAtlassianJsonField.awk"
			local jiraAccountId="$( printf '%s\n' "$jiraBody" | LC_ALL=C awk -v path=accountId -f "$jiraFieldAwk" 2>/dev/null )"
			if [ -z "$jiraAccountId" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-whoami: the current-user call returned no accountId, so the acting identity is UNKNOWN. This is a POSITIVE test on what is present: an empty user is not evidence of an anonymous identity, it is evidence the question was not answered" >&2
				set +e ; return 3
			fi
			printf 'JIRA_ACCOUNT_ID=%s\n' "$jiraAccountId"
			printf 'JIRA_ACCOUNT_EMAIL=%s\n' "$( printf '%s\n' "$jiraBody" | LC_ALL=C awk -v path=emailAddress -v optional=1 -f "$jiraFieldAwk" 2>/dev/null )"
			printf 'JIRA_ACCOUNT_NAME=%s\n' "$( printf '%s\n' "$jiraBody" | LC_ALL=C awk -v path=displayName -v optional=1 -f "$jiraFieldAwk" 2>/dev/null )"
			return 0
		;;

		--member-comms-jira-issue-search)
			shift
			local memberName="$1"
			shift || true
			local jiraJql="$1"
			shift || true
			if [ -z "$memberName" ] || [ -z "$jiraJql" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-search: syntax is <team-member> <jql> [--limit <n>] -- the acting member is required, since a search returns only what that identity can see. Jira refuses an unrestricted query, so the JQL names at least one restriction: project = DATA ORDER BY updated DESC" >&2
				set +e ; return 1
			fi
			local jiraLimit=""
			while [ $# -gt 0 ] ; do
				case "$1" in
					--limit)
						shift
						if [ -z "$1" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-search: --limit requires a value" >&2
							set +e ; return 1
						fi
						jiraLimit="$1" ; shift
					;;
					*)
						echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-search: invalid option: $1" >&2
						set +e ; return 1
					;;
				esac
			done
			[ -n "$jiraLimit" ] || jiraLimit=25
			local jiraSearchPath="/rest/api/3/search/jql?jql=$( AgentsToolsAtlassianUrlEncode "$jiraJql" )&maxResults=$( AgentsToolsAtlassianUrlEncode "$jiraLimit" )&fields=$( AgentsToolsAtlassianUrlEncode "summary,status,issuetype,assignee,updated" )"
			local jiraBody jiraRc=0
			jiraBody="$( AgentsToolsAtlassianCall "$memberName" jira GET "$jiraSearchPath" member-comms-jira-issue-search "" )" || jiraRc=$?
			if [ "$jiraRc" -ne 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-search: COULD NOT SEARCH as $memberName (rc=$jiraRc) -- the result set is UNKNOWN, not empty; nothing is known from this call about whether any issue matches. The diagnostic above is the site's own" >&2
				set +e ; return "$jiraRc"
			fi
			local jiraRows jiraRowsRc=0
			jiraRows="$( printf '%s\n' "$jiraBody" | LC_ALL=C awk -v array=issues -v want='key,fields.issuetype.name,fields.status.name,fields.assignee.displayName,fields.updated,fields.summary' -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsAtlassianListRecords.awk" )" || jiraRowsRc=$?
			if [ "$jiraRowsRc" -ne 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-search: the search response did not carry a readable issues array (rc=$jiraRowsRc) -- the result set is UNKNOWN, not empty" >&2
				set +e ; return 3
			fi
			printf 'ISSUE_KEY\tTYPE\tSTATUS\tASSIGNEE\tUPDATED\tSUMMARY\n'
			[ -z "$jiraRows" ] || printf '%s\n' "$jiraRows"
			## Jira answers a query naming a project that does not exist, and one that
			## is not JQL at all, with HTTP 200 and no issues -- so an empty page is
			## not evidence about the issues, only about this query.
			if [ -z "$jiraRows" ] ; then
				echo "# member-comms-jira-issue-search: the query ran and matched nothing. Jira answers an unresolvable or malformed query with an empty page rather than an error, so this does NOT establish that no issue matches what you meant: re-check the query itself. The JQL as sent: $jiraJql" >&2
			fi
			## /search/jql pages by token and reports no total, so the only
			## truncation signal a caller gets is isLast.
			local jiraIsLast="$( printf '%s\n' "$jiraBody" | LC_ALL=C awk -v path=isLast -v optional=1 -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsAtlassianJsonField.awk" 2>/dev/null )"
			if [ "$jiraIsLast" = "false" ] ; then
				echo "# member-comms-jira-issue-search: more issues match beyond this page -- Jira reports isLast=false. This endpoint returns no total, so how many more is unknown; raise --limit or narrow the query" >&2
			fi
			return 0
		;;

		--member-comms-jira-issue-read)
			shift
			local memberName="$1"
			shift || true
			local jiraIssueKey="$1"
			shift || true
			if [ -z "$memberName" ] || [ -z "$jiraIssueKey" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-read: syntax is <team-member> <issue-key> [--format adf|rendered] -- the acting member is required, since an issue is readable only by identities its project is shared with" >&2
				set +e ; return 1
			fi
			AgentsToolsAssertBareName "$jiraIssueKey" "<issue-key>" member-comms-jira-issue-read || { set +e ; return 1 ; }
			local jiraFormat=""
			while [ $# -gt 0 ] ; do
				case "$1" in
					--format)
						shift
						if [ -z "$1" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-read: --format requires a value: adf or rendered" >&2
							set +e ; return 1
						fi
						jiraFormat="$1" ; shift
					;;
					*)
						echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-read: invalid option: $1" >&2
						set +e ; return 1
					;;
				esac
			done
			[ -n "$jiraFormat" ] || jiraFormat=adf
			local jiraReadPath="/rest/api/3/issue/$( AgentsToolsAtlassianUrlEncode "$jiraIssueKey" )?fields=$( AgentsToolsAtlassianUrlEncode "summary,status,assignee,reporter,priority,issuetype,resolution,labels,created,updated,description" )"
			[ "$jiraFormat" = rendered ] && jiraReadPath="${jiraReadPath}&expand=renderedFields"
			local jiraBody jiraRc=0
			jiraBody="$( AgentsToolsAtlassianCall "$memberName" jira GET "$jiraReadPath" member-comms-jira-issue-read "" )" || jiraRc=$?
			if [ "$jiraRc" -ne 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-read: COULD NOT READ issue $jiraIssueKey as $memberName (rc=$jiraRc) -- the content is UNKNOWN, not empty. Note a 404 from Jira does NOT establish that the issue is absent: it returns 404 both for a missing issue and for one this account cannot see. The diagnostic above is the site's own" >&2
				set +e ; return "$jiraRc"
			fi
			local jiraFieldAwk="$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsAtlassianJsonField.awk"
			local jiraReadKey="$( printf '%s\n' "$jiraBody" | LC_ALL=C awk -v path=key -v optional=1 -f "$jiraFieldAwk" 2>/dev/null )"
			[ -n "$jiraReadKey" ] || jiraReadKey="$jiraIssueKey"
			## Jira labels carry no comma, quote or bracket, so the raw array text
			## (e.g. ["alpha","beta"]) is joined by stripping just those three.
			local jiraLabels="$( printf '%s\n' "$jiraBody" | LC_ALL=C awk -v path=fields.labels -v raw=1 -f "$jiraFieldAwk" 2>/dev/null | sed -e 's/^\[//' -e 's/\]$//' -e 's/"//g' )"
			printf '# issue %s: type=%s status=%s resolution=%s assignee=%s reporter=%s priority=%s created=%s updated=%s labels=%s format=%s\n' \
				"$jiraReadKey" \
				"$( printf '%s\n' "$jiraBody" | LC_ALL=C awk -v path=fields.issuetype.name -v optional=1 -f "$jiraFieldAwk" 2>/dev/null )" \
				"$( printf '%s\n' "$jiraBody" | LC_ALL=C awk -v path=fields.status.name -v optional=1 -f "$jiraFieldAwk" 2>/dev/null )" \
				"$( printf '%s\n' "$jiraBody" | LC_ALL=C awk -v path=fields.resolution.name -v optional=1 -f "$jiraFieldAwk" 2>/dev/null )" \
				"$( printf '%s\n' "$jiraBody" | LC_ALL=C awk -v path=fields.assignee.displayName -v optional=1 -f "$jiraFieldAwk" 2>/dev/null )" \
				"$( printf '%s\n' "$jiraBody" | LC_ALL=C awk -v path=fields.reporter.displayName -v optional=1 -f "$jiraFieldAwk" 2>/dev/null )" \
				"$( printf '%s\n' "$jiraBody" | LC_ALL=C awk -v path=fields.priority.name -v optional=1 -f "$jiraFieldAwk" 2>/dev/null )" \
				"$( printf '%s\n' "$jiraBody" | LC_ALL=C awk -v path=fields.created -v optional=1 -f "$jiraFieldAwk" 2>/dev/null )" \
				"$( printf '%s\n' "$jiraBody" | LC_ALL=C awk -v path=fields.updated -v optional=1 -f "$jiraFieldAwk" 2>/dev/null )" \
				"$jiraLabels" \
				"$jiraFormat" >&2
			printf '# issue %s: summary=%s\n' "$jiraReadKey" "$( printf '%s\n' "$jiraBody" | LC_ALL=C awk -v path=fields.summary -v optional=1 -f "$jiraFieldAwk" 2>/dev/null )" >&2
			if [ "$jiraFormat" = rendered ] ; then
				local jiraRendered="$( printf '%s\n' "$jiraBody" | LC_ALL=C awk -v path=renderedFields.description -f "$jiraFieldAwk" 2>/dev/null )"
				if [ -z "$jiraRendered" ] ; then
					echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-read: the issue was returned without a renderedFields description, so the rendered body is UNKNOWN rather than empty" >&2
					set +e ; return 3
				fi
				printf '%s' "$jiraRendered"
				return 0
			fi
			local jiraDescription jiraDescRc=0
			jiraDescription="$( printf '%s\n' "$jiraBody" | LC_ALL=C awk -v path=fields.description -v raw=1 -f "$jiraFieldAwk" 2>/dev/null )" || jiraDescRc=$?
			if [ "$jiraDescRc" -ne 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-read: the issue's description field could not be read (rc=$jiraDescRc) -- either the field is entirely absent or the response did not parse, so its content is UNKNOWN rather than absent" >&2
				set +e ; return 3
			fi
			if [ -z "$jiraDescription" ] ; then
				echo "# issue $jiraReadKey: this issue really has no description -- the field was returned and its value is null, which is an answer, not a failed read" >&2
			else
				printf '%s\n' "$jiraDescription"
			fi
			return 0
		;;

		--member-comms-jira-issue-create)
			shift
			local memberName="$1"
			shift || true
			if [ -z "$memberName" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-create: syntax is <team-member> --project <key> --issuetype <name> --summary <text> [--description-adf <json>|--description-adf-from-stdin|--description-adf-from-file <path>] [--fields-json <json>] -- the acting member is required, since the issue is created under that identity and only in a project it can see" >&2
				set +e ; return 1
			fi
			local jiraProject="" jiraIssuetype="" jiraSummary="" jiraSummaryGiven="false"
			local jiraDescriptionAdf="" jiraDescriptionGiven="false" jiraFieldsJson=""
			while [ $# -gt 0 ] ; do
				case "$1" in
					--project)
						shift
						if [ -z "${1:-}" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-create: --project requires a value" >&2
							set +e ; return 1
						fi
						jiraProject="$1" ; shift
					;;
					--issuetype)
						shift
						if [ -z "${1:-}" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-create: --issuetype requires a value" >&2
							set +e ; return 1
						fi
						jiraIssuetype="$1" ; shift
					;;
					--summary)
						shift
						if [ -z "${1:-}" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-create: --summary requires a value" >&2
							set +e ; return 1
						fi
						jiraSummary="$1" ; jiraSummaryGiven="true" ; shift
					;;
					--description-adf)
						shift
						if [ -z "${1:-}" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-create: --description-adf requires a value" >&2
							set +e ; return 1
						fi
						jiraDescriptionAdf="$1" ; jiraDescriptionGiven="true" ; shift
					;;
					--description-adf-from-stdin)
						jiraDescriptionAdf="$( cat )" ; jiraDescriptionGiven="true" ; shift
					;;
					--description-adf-from-file)
						shift
						if [ -z "${1:-}" ] || [ ! -f "$1" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-create: --description-adf-from-file: file not found: ${1:-}" >&2
							set +e ; return 1
						fi
						jiraDescriptionAdf="$( cat "$1" )" ; jiraDescriptionGiven="true" ; shift
					;;
					--fields-json)
						shift
						if [ -z "${1:-}" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-create: --fields-json requires a value" >&2
							set +e ; return 1
						fi
						jiraFieldsJson="$1" ; shift
					;;
					*)
						echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-create: invalid option: $1" >&2
						set +e ; return 1
					;;
				esac
			done
			if [ -z "$jiraProject" ] || [ -z "$jiraIssuetype" ] || [ "$jiraSummaryGiven" != "true" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-create: --project, --issuetype and --summary are all required. Everything else depends on that project's own create screen (a subtask, for instance, additionally needs fields.parent.key) -- pass it via --fields-json. This operation never fetches that project's own createmeta to validate fields it usually already knows apply; a caller targeting an unfamiliar project/issuetype should read /rest/api/3/issue/createmeta/{project}/issuetypes/{issueTypeId} itself first" >&2
				set +e ; return 1
			fi
			if [ "$jiraDescriptionGiven" = "true" ] ; then
				AgentsToolsJiraAdfValidate "$jiraDescriptionAdf" "--description-adf" member-comms-jira-issue-create || { set +e ; return 1 ; }
			fi
			local jiraProjectEsc jiraIssuetypeEsc jiraSummaryEsc
			jiraProjectEsc="$( printf '%s' "$jiraProject" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsMcpJsonEscape.awk" )"
			jiraIssuetypeEsc="$( printf '%s' "$jiraIssuetype" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsMcpJsonEscape.awk" )"
			jiraSummaryEsc="$( printf '%s' "$jiraSummary" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsMcpJsonEscape.awk" )"
			local jiraCreateFields="{\"project\":{\"key\":\"$jiraProjectEsc\"},\"issuetype\":{\"name\":\"$jiraIssuetypeEsc\"},\"summary\":\"$jiraSummaryEsc\""
			[ "$jiraDescriptionGiven" = "true" ] && jiraCreateFields="$jiraCreateFields,\"description\":$jiraDescriptionAdf"
			jiraCreateFields="$jiraCreateFields}"
			if [ -n "$jiraFieldsJson" ] ; then
				jiraCreateFields="$( python3 "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsAtlassianJsonObjectMerge.py" "$jiraCreateFields" "$jiraFieldsJson" )" || {
					echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-create: --fields-json was rejected (see diagnostic above) -- nothing was created" >&2
					set +e ; return 1
				}
			fi
			local jiraRc=0
			AgentsToolsAtlassianCall "$memberName" jira POST /rest/api/3/issue member-comms-jira-issue-create "{\"fields\":$jiraCreateFields}" || jiraRc=$?
			if [ "$jiraRc" -ne 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-create: COULD NOT CREATE the issue as $memberName (rc=$jiraRc) -- the diagnostic above is the site's own. HTTP 400 there is a real field-validation rejection from this project's own create screen (Atlassian's own errors object is in that diagnostic), never the shared layer's generic UNKNOWN. Any other UNKNOWN (a timeout, a 5xx) must NEVER be retried blindly: Jira's create endpoint has no idempotency key, so a retry can leave two issues behind with no way to tell from here -- check the project in Jira itself before trying again" >&2
				set +e ; return "$jiraRc"
			fi
			return 0
		;;

		--member-comms-jira-issue-update)
			shift
			local memberName="$1"
			shift || true
			local jiraIssueKey="$1"
			shift || true
			if [ -z "$memberName" ] || [ -z "$jiraIssueKey" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-update: syntax is <team-member> <issue-key> [--fields-json <json>] [--update-json <json>] [--notify-users] -- at least one of --fields-json/--update-json is required. --fields-json is the WHOLE fields object, plain set-semantics per field it names (an array field such as labels is a full replace, not an append: read the current array first if only adding one value); --update-json is Jira's own {\"field\":[{\"add\":...}/{\"remove\":...}/{\"set\":...}]} shape for precise add/remove on a multi-value field. fields.status is refused in either shape -- move an issue's status through --member-comms-jira-issue-transition instead, never through this operation. There is no read-before-write here: this is ordinary last-write-wins" >&2
				set +e ; return 1
			fi
			AgentsToolsAssertBareName "$jiraIssueKey" "<issue-key>" member-comms-jira-issue-update || { set +e ; return 1 ; }
			local jiraFieldsJson="" jiraUpdateJson="" jiraNotifyUsers="false"
			while [ $# -gt 0 ] ; do
				case "$1" in
					--fields-json)
						shift
						if [ -z "${1:-}" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-update: --fields-json requires a value" >&2
							set +e ; return 1
						fi
						jiraFieldsJson="$1" ; shift
					;;
					--update-json)
						shift
						if [ -z "${1:-}" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-update: --update-json requires a value" >&2
							set +e ; return 1
						fi
						jiraUpdateJson="$1" ; shift
					;;
					--notify-users)
						jiraNotifyUsers="true" ; shift
					;;
					*)
						echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-update: invalid option: $1" >&2
						set +e ; return 1
					;;
				esac
			done
			if [ -z "$jiraFieldsJson" ] && [ -z "$jiraUpdateJson" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-update: at least one of --fields-json or --update-json is required -- nothing was changed" >&2
				set +e ; return 1
			fi
			local jiraUpdateBody="{" jiraUpdateHasPart="false"
			if [ -n "$jiraFieldsJson" ] ; then
				local jiraMergedFields=""
				jiraMergedFields="$( python3 "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsAtlassianJsonObjectMerge.py" "{}" "$jiraFieldsJson" status )" || {
					echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-update: --fields-json was rejected (see diagnostic above) -- nothing was changed" >&2
					set +e ; return 1
				}
				jiraUpdateBody="$jiraUpdateBody\"fields\":$jiraMergedFields"
				jiraUpdateHasPart="true"
			fi
			if [ -n "$jiraUpdateJson" ] ; then
				local jiraMergedUpdate=""
				jiraMergedUpdate="$( python3 "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsAtlassianJsonObjectMerge.py" "{}" "$jiraUpdateJson" status )" || {
					echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-update: --update-json was rejected (see diagnostic above) -- nothing was changed" >&2
					set +e ; return 1
				}
				[ "$jiraUpdateHasPart" = "true" ] && jiraUpdateBody="$jiraUpdateBody,"
				jiraUpdateBody="$jiraUpdateBody\"update\":$jiraMergedUpdate"
			fi
			jiraUpdateBody="$jiraUpdateBody}"
			local jiraRc=0
			AgentsToolsAtlassianCall "$memberName" jira PUT "/rest/api/3/issue/$( AgentsToolsAtlassianUrlEncode "$jiraIssueKey" )?notifyUsers=$jiraNotifyUsers" member-comms-jira-issue-update "$jiraUpdateBody" || jiraRc=$?
			if [ "$jiraRc" -ne 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-update: COULD NOT UPDATE issue $jiraIssueKey as $memberName (rc=$jiraRc) -- the diagnostic above is the site's own. HTTP 400 there means an invalid or read-only field for that project's own screen; HTTP 404 means the issue is absent or invisible" >&2
				set +e ; return "$jiraRc"
			fi
			return 0
		;;

		--member-comms-jira-issue-transition)
			shift
			local memberName="$1"
			shift || true
			local jiraIssueKey="$1"
			shift || true
			if [ -z "$memberName" ] || [ -z "$jiraIssueKey" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-transition: syntax is <team-member> <issue-key> --to-status <name> [--fields-json <json>] [--comment-adf <json>|--comment-adf-from-stdin|--comment-adf-from-file <path>] -- <name> is matched exactly (never fuzzily) against each transition CURRENTLY AVAILABLE from this issue's own status, by that transition's own destination status name (to.name), never by the transition's own action label" >&2
				set +e ; return 1
			fi
			AgentsToolsAssertBareName "$jiraIssueKey" "<issue-key>" member-comms-jira-issue-transition || { set +e ; return 1 ; }
			local jiraToStatus="" jiraFieldsJson="" jiraCommentAdf="" jiraCommentGiven="false"
			while [ $# -gt 0 ] ; do
				case "$1" in
					--to-status)
						shift
						if [ -z "${1:-}" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-transition: --to-status requires a value" >&2
							set +e ; return 1
						fi
						jiraToStatus="$1" ; shift
					;;
					--fields-json)
						shift
						if [ -z "${1:-}" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-transition: --fields-json requires a value" >&2
							set +e ; return 1
						fi
						jiraFieldsJson="$1" ; shift
					;;
					--comment-adf)
						shift
						if [ -z "${1:-}" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-transition: --comment-adf requires a value" >&2
							set +e ; return 1
						fi
						jiraCommentAdf="$1" ; jiraCommentGiven="true" ; shift
					;;
					--comment-adf-from-stdin)
						jiraCommentAdf="$( cat )" ; jiraCommentGiven="true" ; shift
					;;
					--comment-adf-from-file)
						shift
						if [ -z "${1:-}" ] || [ ! -f "$1" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-transition: --comment-adf-from-file: file not found: ${1:-}" >&2
							set +e ; return 1
						fi
						jiraCommentAdf="$( cat "$1" )" ; jiraCommentGiven="true" ; shift
					;;
					*)
						echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-transition: invalid option: $1" >&2
						set +e ; return 1
					;;
				esac
			done
			if [ -z "$jiraToStatus" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-transition: --to-status is required" >&2
				set +e ; return 1
			fi
			if [ "$jiraCommentGiven" = "true" ] ; then
				AgentsToolsJiraAdfValidate "$jiraCommentAdf" "--comment-adf" member-comms-jira-issue-transition || { set +e ; return 1 ; }
			fi

			## The lookup is internal and mandatory, run immediately before the POST:
			## a transition id is workflow- and status-specific plumbing an agent has
			## no legitimate way to already hold, and a caller-cached id could go
			## stale exactly like a Confluence version -- but unlike Confluence's
			## version, nothing is lost by always re-resolving right before the
			## write, so it is never caller-supplied.
			local jiraListBody jiraListRc=0
			jiraListBody="$( AgentsToolsAtlassianCall "$memberName" jira GET "/rest/api/3/issue/$( AgentsToolsAtlassianUrlEncode "$jiraIssueKey" )/transitions" member-comms-jira-issue-transition "" )" || jiraListRc=$?
			if [ "$jiraListRc" -ne 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-transition: COULD NOT READ the available transitions for issue $jiraIssueKey as $memberName (rc=$jiraListRc) -- nothing was changed. The diagnostic above is the site's own" >&2
				set +e ; return "$jiraListRc"
			fi
			local jiraTransitionRows jiraTransitionRowsRc=0
			jiraTransitionRows="$( printf '%s\n' "$jiraListBody" | LC_ALL=C awk -v array=transitions -v want='id,name,to.name' -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsAtlassianListRecords.awk" )" || jiraTransitionRowsRc=$?
			if [ "$jiraTransitionRowsRc" -ne 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-transition: the transitions call returned no transitions array (rc=$jiraTransitionRowsRc) -- nothing was changed" >&2
				set +e ; return 1
			fi
			local jiraMatchedIds jiraMatchCount
			jiraMatchedIds="$( printf '%s\n' "$jiraTransitionRows" | LC_ALL=C awk -F'\t' -v want="$jiraToStatus" '$3 == want { print $1 }' )"
			jiraMatchCount=0
			[ -z "$jiraMatchedIds" ] || jiraMatchCount="$( printf '%s\n' "$jiraMatchedIds" | awk 'END { print NR }' )"
			if [ "$jiraMatchCount" -eq 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-transition: no transition leads to a status named exactly '$jiraToStatus' from issue $jiraIssueKey's own current status -- nothing was changed. Transitions available from here (action -> destination status):" >&2
				printf '%s\n' "$jiraTransitionRows" | LC_ALL=C awk -F'\t' '{ print "#   " $2 " -> " $3 }' >&2
				set +e ; return 1
			fi
			if [ "$jiraMatchCount" -gt 1 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-transition: '$jiraToStatus' matched $jiraMatchCount transitions from issue $jiraIssueKey's own current status -- ambiguous, so nothing was changed. This is never fuzzy-resolved" >&2
				set +e ; return 1
			fi
			local jiraTransitionId="$jiraMatchedIds"
			local jiraTransitionIdEsc
			jiraTransitionIdEsc="$( printf '%s' "$jiraTransitionId" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsMcpJsonEscape.awk" )"
			local jiraTransitionBody="{\"transition\":{\"id\":\"$jiraTransitionIdEsc\"}"
			if [ -n "$jiraFieldsJson" ] ; then
				local jiraMergedFields=""
				jiraMergedFields="$( python3 "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsAtlassianJsonObjectMerge.py" "{}" "$jiraFieldsJson" )" || {
					echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-transition: --fields-json was rejected (see diagnostic above) -- nothing was changed" >&2
					set +e ; return 1
				}
				jiraTransitionBody="$jiraTransitionBody,\"fields\":$jiraMergedFields"
			fi
			if [ "$jiraCommentGiven" = "true" ] ; then
				jiraTransitionBody="$jiraTransitionBody,\"update\":{\"comment\":[{\"add\":{\"body\":$jiraCommentAdf}}]}"
			fi
			jiraTransitionBody="$jiraTransitionBody}"
			local jiraRc=0
			AgentsToolsAtlassianCall "$memberName" jira POST "/rest/api/3/issue/$( AgentsToolsAtlassianUrlEncode "$jiraIssueKey" )/transitions" member-comms-jira-issue-transition "$jiraTransitionBody" || jiraRc=$?
			if [ "$jiraRc" -ne 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-issue-transition: COULD NOT TRANSITION issue $jiraIssueKey to '$jiraToStatus' as $memberName (rc=$jiraRc) -- the diagnostic above is the site's own. HTTP 400 here usually means the issue moved again in the race between the lookup above and this call, or a field this workflow's screen requires (commonly resolution) was not supplied via --fields-json -- re-run to re-resolve the transition" >&2
				set +e ; return "$jiraRc"
			fi
			echo "# $MDSC_CMD --member-comms-jira-issue-transition: issue $jiraIssueKey transitioned to '$jiraToStatus' (transition id $jiraTransitionId)" >&2
			return 0
		;;

		## One issue's comments, as TSV with its own header row. Same --format
		## meaning as issue-read, applied to each comment body.
		--member-comms-jira-comment-read)
			shift
			local memberName="$1"
			shift || true
			local jiraIssueKey="$1"
			shift || true
			if [ -z "$memberName" ] || [ -z "$jiraIssueKey" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-comment-read: syntax is <team-member> <issue-key> [--format adf|rendered] -- the acting member is required, since comments are visible only to identities the issue is shared with" >&2
				set +e ; return 1
			fi
			AgentsToolsAssertBareName "$jiraIssueKey" "<issue-key>" member-comms-jira-comment-read || { set +e ; return 1 ; }
			local jiraFormat=""
			while [ $# -gt 0 ] ; do
				case "$1" in
					--format)
						shift
						if [ -z "$1" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-comment-read: --format requires a value: adf or rendered" >&2
							set +e ; return 1
						fi
						jiraFormat="$1" ; shift
					;;
					*)
						echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-comment-read: invalid option: $1" >&2
						set +e ; return 1
					;;
				esac
			done
			[ -n "$jiraFormat" ] || jiraFormat=adf
			local jiraCommentPath="/rest/api/3/issue/$( AgentsToolsAtlassianUrlEncode "$jiraIssueKey" )/comment?maxResults=100"
			[ "$jiraFormat" = rendered ] && jiraCommentPath="${jiraCommentPath}&expand=renderedBody"
			local jiraBody jiraRc=0
			jiraBody="$( AgentsToolsAtlassianCall "$memberName" jira GET "$jiraCommentPath" member-comms-jira-comment-read "" )" || jiraRc=$?
			if [ "$jiraRc" -ne 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-comment-read: COULD NOT READ comments on issue $jiraIssueKey as $memberName (rc=$jiraRc) -- the comment list is UNKNOWN, not empty; the diagnostic above is the site's own" >&2
				set +e ; return "$jiraRc"
			fi
			## adf comment bodies are a JSON document, not a scalar, so that one
			## field is captured raw -- the same rule issue-read's description
			## follows. rendered bodies are already plain HTML text.
			local jiraCommentWant='id,author.accountId,author.displayName,created,updated'
			local jiraCommentRawFlag=()
			if [ "$jiraFormat" = rendered ] ; then
				jiraCommentWant="${jiraCommentWant},renderedBody"
			else
				jiraCommentWant="${jiraCommentWant},body"
				jiraCommentRawFlag=( -v raw=body )
			fi
			local jiraRows jiraRowsRc=0
			jiraRows="$( printf '%s\n' "$jiraBody" | LC_ALL=C awk -v array=comments -v want="$jiraCommentWant" "${jiraCommentRawFlag[@]}" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsAtlassianListRecords.awk" )" || jiraRowsRc=$?
			if [ "$jiraRowsRc" -ne 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-comment-read: the comments call returned no comments field, so the comment list is UNKNOWN rather than empty" >&2
				set +e ; return 3
			fi
			printf 'COMMENT_ID\tAUTHOR_ID\tAUTHOR_NAME\tCREATED\tUPDATED\tBODY\n'
			[ -z "$jiraRows" ] || printf '%s\n' "$jiraRows"
			## This endpoint does report a total, so truncation is stated exactly.
			local jiraFieldAwk="$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsAtlassianJsonField.awk"
			local jiraTotal="$( printf '%s\n' "$jiraBody" | LC_ALL=C awk -v path=total -v optional=1 -f "$jiraFieldAwk" 2>/dev/null )"
			local jiraEmitted=0
			[ -z "$jiraRows" ] || jiraEmitted="$( printf '%s\n' "$jiraRows" | awk 'END { print NR }' )"
			case "$jiraTotal" in
				*[!0123456789]*|"") ;;
				*)
					if [ "$jiraTotal" -gt "$jiraEmitted" ] ; then
						echo "# member-comms-jira-comment-read: issue $jiraIssueKey has $jiraTotal comments and this page carries $jiraEmitted -- the rest were not read" >&2
					fi
				;;
			esac
			return 0
		;;

		--member-comms-jira-comment-add)
			shift
			local memberName="$1"
			shift || true
			local jiraIssueKey="$1"
			shift || true
			if [ -z "$memberName" ] || [ -z "$jiraIssueKey" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-comment-add: syntax is <team-member> <issue-key> (--body-adf <json>|--body-adf-from-stdin|--body-adf-from-file <path>) -- the acting member is required, since the comment is posted under that identity. There is no visibility (role/group) restriction here: every comment this posts is visible to everyone the issue is already shared with" >&2
				set +e ; return 1
			fi
			AgentsToolsAssertBareName "$jiraIssueKey" "<issue-key>" member-comms-jira-comment-add || { set +e ; return 1 ; }
			local jiraBodyAdf="" jiraBodyGiven="false"
			while [ $# -gt 0 ] ; do
				case "$1" in
					--body-adf)
						shift
						if [ -z "${1:-}" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-comment-add: --body-adf requires a value" >&2
							set +e ; return 1
						fi
						jiraBodyAdf="$1" ; jiraBodyGiven="true" ; shift
					;;
					--body-adf-from-stdin)
						jiraBodyAdf="$( cat )" ; jiraBodyGiven="true" ; shift
					;;
					--body-adf-from-file)
						shift
						if [ -z "${1:-}" ] || [ ! -f "$1" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-comment-add: --body-adf-from-file: file not found: ${1:-}" >&2
							set +e ; return 1
						fi
						jiraBodyAdf="$( cat "$1" )" ; jiraBodyGiven="true" ; shift
					;;
					*)
						echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-comment-add: invalid option: $1" >&2
						set +e ; return 1
					;;
				esac
			done
			if [ "$jiraBodyGiven" != "true" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-comment-add: one of --body-adf, --body-adf-from-stdin or --body-adf-from-file is required" >&2
				set +e ; return 1
			fi
			AgentsToolsJiraAdfValidate "$jiraBodyAdf" "--body-adf" member-comms-jira-comment-add || { set +e ; return 1 ; }
			local jiraRc=0
			AgentsToolsAtlassianCall "$memberName" jira POST "/rest/api/3/issue/$( AgentsToolsAtlassianUrlEncode "$jiraIssueKey" )/comment" member-comms-jira-comment-add "{\"body\":$jiraBodyAdf}" || jiraRc=$?
			if [ "$jiraRc" -ne 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-comment-add: COULD NOT COMMENT on issue $jiraIssueKey as $memberName (rc=$jiraRc) -- the diagnostic above is the site's own. HTTP 400 there means malformed ADF; HTTP 404 means the issue is absent or invisible" >&2
				set +e ; return "$jiraRc"
			fi
			return 0
		;;

		--member-comms-jira-board-list)
			shift
			local memberName="$1"
			shift || true
			if [ -z "$memberName" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-board-list: syntax is <team-member> [--start-at <n>] -- the acting member is required, since a board is visible only to identities its project is shared with. --start-at continues a prior isLast=false page: pass back that page's own startAt plus its maxResults, verbatim" >&2
				set +e ; return 1
			fi
			local jiraStartAt=""
			while [ $# -gt 0 ] ; do
				case "$1" in
					--start-at)
						shift
						if [ -z "$1" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-board-list: --start-at requires a value" >&2
							set +e ; return 1
						fi
						jiraStartAt="$1" ; shift
					;;
					*)
						echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-board-list: invalid option: $1" >&2
						set +e ; return 1
					;;
				esac
			done
			local jiraRc=0
			AgentsToolsJiraAgileRead "$memberName" /rest/agile/1.0/board member-comms-jira-board-list "$jiraStartAt" || jiraRc=$?
			if [ "$jiraRc" -ne 0 ] ; then set +e ; return "$jiraRc" ; fi
			return 0
		;;

		--member-comms-jira-board-read)
			shift
			local memberName="$1"
			shift || true
			local jiraBoardId="$1"
			shift || true
			if [ -z "$memberName" ] || [ -z "$jiraBoardId" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-board-read: syntax is <team-member> <board-id> -- the acting member is required, since a board is visible only to identities its project is shared with" >&2
				set +e ; return 1
			fi
			if [ $# -gt 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-board-read: takes exactly two arguments" >&2
				set +e ; return 1
			fi
			## A board id is a whole number. Enumerated, never a bracket range.
			case "$jiraBoardId" in
				*[!0123456789]*)
					echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-board-read: <board-id> must be a whole number, got: $jiraBoardId" >&2
					set +e ; return 1
				;;
			esac
			## One board is a single object rather than a page, so it carries no
			## isLast and is read through the transport directly.
			local jiraRc=0
			AgentsToolsAtlassianCall "$memberName" jira GET "/rest/agile/1.0/board/$jiraBoardId" member-comms-jira-board-read "" || jiraRc=$?
			if [ "$jiraRc" -ne 0 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-board-read: COULD NOT READ board $jiraBoardId as $memberName (rc=$jiraRc) -- the board is UNKNOWN, not absent. A 404 from Jira does NOT establish that the board does not exist: it answers 404 both for a missing board and for one this account cannot see" >&2
				set +e ; return "$jiraRc"
			fi
			return 0
		;;

		--member-comms-jira-board-issue-search)
			shift
			local memberName="$1"
			shift || true
			local jiraBoardId="$1"
			shift || true
			if [ -z "$memberName" ] || [ -z "$jiraBoardId" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-board-issue-search: syntax is <team-member> <board-id> [--start-at <n>] -- the acting member is required, since the issues returned are only those that identity can see" >&2
				set +e ; return 1
			fi
			case "$jiraBoardId" in
				*[!0123456789]*)
					echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-board-issue-search: <board-id> must be a whole number, got: $jiraBoardId" >&2
					set +e ; return 1
				;;
			esac
			local jiraStartAt=""
			while [ $# -gt 0 ] ; do
				case "$1" in
					--start-at)
						shift
						if [ -z "$1" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-board-issue-search: --start-at requires a value" >&2
							set +e ; return 1
						fi
						jiraStartAt="$1" ; shift
					;;
					*)
						echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-board-issue-search: invalid option: $1" >&2
						set +e ; return 1
					;;
				esac
			done
			local jiraRc=0
			AgentsToolsJiraAgileRead "$memberName" "/rest/agile/1.0/board/$jiraBoardId/issue" member-comms-jira-board-issue-search "$jiraStartAt" || jiraRc=$?
			if [ "$jiraRc" -ne 0 ] ; then set +e ; return "$jiraRc" ; fi
			return 0
		;;

		--member-comms-jira-sprint-list)
			shift
			local memberName="$1"
			shift || true
			local jiraBoardId="$1"
			shift || true
			if [ -z "$memberName" ] || [ -z "$jiraBoardId" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-sprint-list: syntax is <team-member> <board-id> [--start-at <n>] -- a sprint belongs to a board, and the acting member is required since the board is visible only to identities it is shared with" >&2
				set +e ; return 1
			fi
			case "$jiraBoardId" in
				*[!0123456789]*)
					echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-sprint-list: <board-id> must be a whole number, got: $jiraBoardId" >&2
					set +e ; return 1
				;;
			esac
			local jiraStartAt=""
			while [ $# -gt 0 ] ; do
				case "$1" in
					--start-at)
						shift
						if [ -z "$1" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-sprint-list: --start-at requires a value" >&2
							set +e ; return 1
						fi
						jiraStartAt="$1" ; shift
					;;
					*)
						echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-sprint-list: invalid option: $1" >&2
						set +e ; return 1
					;;
				esac
			done
			local jiraRc=0
			AgentsToolsJiraAgileRead "$memberName" "/rest/agile/1.0/board/$jiraBoardId/sprint" member-comms-jira-sprint-list "$jiraStartAt" || jiraRc=$?
			if [ "$jiraRc" -ne 0 ] ; then set +e ; return "$jiraRc" ; fi
			return 0
		;;

		--member-comms-jira-sprint-issue-search)
			shift
			local memberName="$1"
			shift || true
			local jiraSprintId="$1"
			shift || true
			if [ -z "$memberName" ] || [ -z "$jiraSprintId" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-sprint-issue-search: syntax is <team-member> <sprint-id> [--start-at <n>] -- the acting member is required, since the issues returned are only those that identity can see" >&2
				set +e ; return 1
			fi
			case "$jiraSprintId" in
				*[!0123456789]*)
					echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-sprint-issue-search: <sprint-id> must be a whole number, got: $jiraSprintId" >&2
					set +e ; return 1
				;;
			esac
			local jiraStartAt=""
			while [ $# -gt 0 ] ; do
				case "$1" in
					--start-at)
						shift
						if [ -z "$1" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-sprint-issue-search: --start-at requires a value" >&2
							set +e ; return 1
						fi
						jiraStartAt="$1" ; shift
					;;
					*)
						echo "⛔ ERROR: $MDSC_CMD --member-comms-jira-sprint-issue-search: invalid option: $1" >&2
						set +e ; return 1
					;;
				esac
			done
			local jiraRc=0
			AgentsToolsJiraAgileRead "$memberName" "/rest/agile/1.0/sprint/$jiraSprintId/issue" member-comms-jira-sprint-issue-search "$jiraStartAt" || jiraRc=$?
			if [ "$jiraRc" -ne 0 ] ; then set +e ; return "$jiraRc" ; fi
			return 0
		;;

		## A --member-comms-jira-* name this file does not implement. Reported,
		## never swallowed.
		--member-comms-jira-*)
			echo "⛔ ERROR: $MDSC_CMD: unknown --member-comms-jira-* operation: $1 -- the supported operations are --member-comms-jira-whoami, --member-comms-jira-issue-search, --member-comms-jira-issue-read, --member-comms-jira-issue-create, --member-comms-jira-issue-update, --member-comms-jira-issue-transition, --member-comms-jira-comment-read, --member-comms-jira-comment-add, --member-comms-jira-board-list, --member-comms-jira-board-read, --member-comms-jira-board-issue-search, --member-comms-jira-sprint-list and --member-comms-jira-sprint-issue-search" >&2
			set +e ; return 1
		;;

		## DEFINITIONS-ONLY SOURCE. Nothing to dispatch, and nothing is an error:
		## the supported way for another include to reach this file's helpers.
		*)
			:
		;;

esac
