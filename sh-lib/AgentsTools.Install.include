#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only


case "$1" in

	--install-skillset-symlinks)
		shift

		local scope="workspace" workspaceArg scopeExplicit="false" removeMode="false" targetRootArg
		##
		while [ $# -gt 0 ] ; do
			## 
			case "$1" in
				--remove)
					removeMode="true" ; shift
				;;
				--scope)
					case "$2" in
						workspace|user-home)
						;;
						*)
							echo "⛔ ERROR: $MDSC_CMD --install-skillset-symlinks: --scope must be workspace or user-home" >&2
							set +e ; return 1
						;;
					esac
					scope="$2" ; scopeExplicit="true" ; shift 2
				;;
				--workspace)
					if [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --install-skillset-symlinks: --workspace requires a value" >&2
						set +e ; return 1
					fi
					workspaceArg="$2" ; shift 2
				;;
				--target-root)
					if [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --install-skillset-symlinks: --target-root requires a value" >&2
						set +e ; return 1
					fi
					targetRootArg="$2" ; shift 2
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --install-skillset-symlinks: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done

		local workspace="${workspaceArg:-$MMDAPP}"
		[ -d "$workspace" ] && workspace="$( cd "$workspace" && pwd )"

		if [ ! -f "$workspace/.local/myx/myx.distro-.local/sh-lib/LocalContext.include" ] ; then
			if [ "$scope" = "workspace" ] ; then
				if [ "$scopeExplicit" = "true" ] ; then
					echo "⛔ ERROR: $MDSC_CMD --install-skillset-symlinks: not a set-up myx.distro workspace: $workspace" >&2
					set +e ; return 1
				fi
				scope="user-home"
			fi
		fi

		local bundleRoot="$MDLT_ORIGIN/myx/myx.distro-agents/skillset/magic-team"
		if [ "$removeMode" != "true" ] && [ ! -d "$bundleRoot" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --install-skillset-symlinks: bundle directory does not exist: $bundleRoot" >&2
			set +e ; return 1
		fi

		local targetRoot
		if [ -z "$targetRootArg" ] ; then
			local fanRoots fanRoot fanStatus=0
			case "$scope" in
				user-home)
					fanRoots="$HOME/.agents/skills"$'\n'"$HOME/.copilot/skills"$'\n'"$HOME/.claude/skills"
				;;
				workspace)
					fanRoots="$workspace/.agents/skills"$'\n'"$workspace/.claude/skills"
				;;
			esac
			local ownsReport="false"
			if [ -z "$MDSC_SKILLSET_REPORT" ] ; then
				MDSC_SKILLSET_REPORT="$( mktemp "${TMPDIR:-/tmp}/magic-skillset.XXXXXX" )" || { set +e ; return 1 ; }
				export MDSC_SKILLSET_REPORT ; ownsReport="true"
			fi
			while IFS= read -r fanRoot ; do
				[ -n "$fanRoot" ] || continue
				if [ "$removeMode" = "true" ] ; then
					DistroAgentsTools --install-skillset-symlinks --remove --scope "$scope" --workspace "$workspace" --target-root "$fanRoot" || fanStatus=1
				else
					DistroAgentsTools --install-skillset-symlinks --scope "$scope" --workspace "$workspace" --target-root "$fanRoot" || fanStatus=1
				fi
			done <<< "$fanRoots"
			if [ "$ownsReport" = "true" ] ; then
				DistroAgentsTools --install-skillset-report-render
				rm -f "$MDSC_SKILLSET_REPORT" ; unset MDSC_SKILLSET_REPORT
			fi
			if [ "$fanStatus" != "0" ] ; then
				set +e ; return 1
			fi
			return 0
		fi

		targetRoot="$targetRootArg"
		mkdir -p "$targetRoot" || {
			echo "⛔ ERROR: $MDSC_CMD --install-skillset-symlinks: cannot create target directory: $targetRoot" >&2
			set +e ; return 1
		}

		local memberNames memberDir
		if [ "$removeMode" = "true" ] ; then
			memberNames=""
			echo "# $MDSC_CMD --install-skillset-symlinks --remove: removing every line owned by this workspace, linking skipped" >&2
		else
			memberNames="$(
				for memberDir in "$bundleRoot"/*/ ; do
					[ -d "${memberDir%/}" ] || continue
					basename "${memberDir%/}"
				done | sort -u
			)"
		fi

		local hadError="false" memberName memberTarget memberBundled memberActual
		local ownedMembers="" newLinks="" regChanges="" keptMembers="" deletedMembers="" errorMembers=""
		while IFS= read -r memberName ; do
			[ -n "$memberName" ] || continue
			[ "$memberName" != "trash" ] || continue
			memberTarget="$targetRoot/$memberName"
			memberBundled="$bundleRoot/$memberName"
			if [ -L "$memberTarget" ] && [ ! -e "$memberTarget" ] ; then
				echo "# $MDSC_CMD --install-skillset-symlinks: $memberTarget is a dangling symlink (points at $( readlink "$memberTarget" ), which does not exist) -- reclaiming the slot" >&2
				if ! rm -f "$memberTarget" ; then
					echo "⛔ ERROR: $MDSC_CMD --install-skillset-symlinks: failed to remove dangling symlink: $memberTarget" >&2
					errorMembers="${errorMembers}${memberName} " ; hadError="true"
					continue
				fi
			elif [ -L "$memberTarget" ] ; then
				memberActual="$( readlink "$memberTarget" )"
				if [ "$memberActual" != "$memberBundled" ] ; then
					keptMembers="${keptMembers}${memberName} "
				fi
				## register where the link actually points, not where it would have been
				## pointed: a kept link we did not create is not ours to claim, and a later
				## --remove pass must not act on a stale claim to the bundled path.
				ownedMembers="${ownedMembers}${memberName} ${memberActual}"$'\n'
				continue
			fi
			if [ -e "$memberTarget" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --install-skillset-symlinks: real content at $memberTarget, will not overwrite (bundle already has $memberBundled)" >&2
				errorMembers="${errorMembers}${memberName} " ; hadError="true"
				continue
			fi
			if ! ln -s "$memberBundled" "$memberTarget" ; then
				echo "⛔ ERROR: $MDSC_CMD --install-skillset-symlinks: failed to create symlink: $memberTarget" >&2
				errorMembers="${errorMembers}${memberName} " ; hadError="true"
				continue
			fi
			ownedMembers="${ownedMembers}${memberName} ${memberBundled}"$'\n'
			newLinks="${newLinks}${memberName} "
		done <<< "$memberNames"

		local workspaceName registryFile compositeRoot originRoot
		workspaceName="$( basename "$workspace" )"
		registryFile="$targetRoot/.linked.magic-team.members.txt"
		compositeRoot="$workspace/.local/agents/magic-team-composite"
		## $bundleRoot is itself rooted in MDLT_ORIGIN, so a link into MDLT_ORIGIN is the
		## intended install -- classified below rather than left to the catch-all. A workspace
		## that does not vendor its own myx.distro-* copy resolves MDLT_ORIGIN to a sibling
		## workspace, which is normal and not a conflict. Fall back to $compositeRoot when
		## MDLT_ORIGIN is empty: that duplicates an existing arm (harmless) instead of
		## degrading the pattern to "/*", which would swallow every path.
		originRoot="${MDLT_ORIGIN:-}"
		[ -n "$originRoot" ] || originRoot="$compositeRoot"

		local declaresTool="$MDLT_ORIGIN/myx/myx.distro-system/sh-scripts/ListDistroDeclares.fn.sh"
		local projectsTool="$MDLT_ORIGIN/myx/myx.distro-system/sh-scripts/ListDistroProjects.fn.sh"
		local selectedProjects selectStatus declaredMembers declaredStatus
		local memberSources=""

		local discoveryTrusted="true"

		if [ "$removeMode" = "true" ] ; then
			memberSources=""
		elif [ ! -f "$declaresTool" ] || [ ! -f "$projectsTool" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --install-skillset-symlinks: COULD-NOT-CHECK declared team-members: missing ListDistroDeclares.fn.sh ($declaresTool) or ListDistroProjects.fn.sh ($projectsTool)" >&2
			hadError="true" ; discoveryTrusted="false"
		else
			local selectErrFile declaredErrFile
			selectErrFile="$( mktemp "${TMPDIR:-/tmp}/agents-install-select.XXXXXX" )" || selectErrFile=""
			declaredErrFile="$( mktemp "${TMPDIR:-/tmp}/agents-install-declared.XXXXXX" )" || declaredErrFile=""

			selectStatus=0
			selectedProjects="$( MMDAPP="$workspace" "$projectsTool" --distro-source-only --select-all 2>"${selectErrFile:-/dev/null}" )" || selectStatus=$?

			declaredStatus=0
			declaredMembers="$( MMDAPP="$workspace" MDSC_SELECT_PROJECTS="$selectedProjects" "$declaresTool" --distro-source-only --select-from-env --filter-and-cut 'magic-team:team-member' 2>"${declaredErrFile:-/dev/null}" )" || declaredStatus=$?

			if [ "$selectStatus" != "0" ] || [ "$( printf '%s' "$selectedProjects" | grep -c '' )" = "0" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --install-skillset-symlinks: COULD-NOT-CHECK declared team-members: no projects could be selected in workspace $workspace (ListDistroProjects --distro-source-only --select-all exited $selectStatus)" >&2
				[ -z "$selectErrFile" ] || [ ! -s "$selectErrFile" ] || sed 's/^/#   ListDistroProjects: /' "$selectErrFile" >&2
				hadError="true" ; discoveryTrusted="false"
			elif [ "$declaredStatus" != "0" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --install-skillset-symlinks: COULD-NOT-CHECK declared team-members: ListDistroDeclares --filter-and-cut exited $declaredStatus for workspace $workspace" >&2
				[ -z "$declaredErrFile" ] || [ ! -s "$declaredErrFile" ] || sed 's/^/#   ListDistroDeclares: /' "$declaredErrFile" >&2
				hadError="true" ; discoveryTrusted="false"
			else

					local dLine dProject dRest dSkillsetPath dHostGlob dMember dHostShort dHostFull
					dHostShort="$( hostname -s 2>/dev/null )" || dHostShort=""
					dHostFull="$( hostname 2>/dev/null )" || dHostFull=""
					while IFS= read -r dLine ; do
						[ -n "$dLine" ] || continue
						dProject="${dLine%% *}"
						dRest="${dLine#* }"
						dHostGlob="${dRest##*:}"
						dSkillsetPath="${dRest%:*}"
						dMember="$( basename "$dSkillsetPath" )"
						if [ -z "$dHostGlob" ] || [ "$dSkillsetPath" = "$dRest" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --install-skillset-symlinks: malformed team-member declare in $dProject: magic-team:team-member:$dRest (expected skillset/<name>:<host-glob>)" >&2
							hadError="true"
							continue
						fi
						case "$dHostShort" in
							$dHostGlob) ;;
							*)
								case "$dHostFull" in
									$dHostGlob) ;;
									*)
										continue
									;;
								esac
							;;
						esac
						if [ ! -d "$workspace/source/$dProject/$dSkillsetPath" ] ; then
							echo "⛔ ERROR: $MDSC_CMD --install-skillset-symlinks: $dProject declares team-member $dMember but its skillset directory is missing: $workspace/source/$dProject/$dSkillsetPath" >&2
							hadError="true"
							continue
						fi
						memberSources="${memberSources}${dMember} ${workspace}/source/${dProject}/${dSkillsetPath}"$'\n'
					done <<< "$declaredMembers"
			fi
			rm -f "$selectErrFile" "$declaredErrFile" 2>/dev/null || true
		fi

		local dcMember dcSources dcCount dcLinkTarget dcSrc
		for dcMember in $( printf '%s' "$memberSources" | awk 'NF { print $1 }' | sort -u ) ; do
			dcSources="$( printf '%s\n' "$memberSources" | awk -v m="$dcMember" '$1 == m { sub(/^[^ ]+ /, ""); print }' )"
			dcCount="$( printf '%s' "$dcSources" | grep -c '' )"

			if printf '%s\n' "$ownedMembers" | awk -v m="$dcMember" 'NF && $1 == m { hit = 1 } END { exit !hit }' ; then
				echo "🙋 WARNING: $MDSC_CMD --install-skillset-symlinks: NAME COLLISION on team-member $dcMember -- it is both bundled and declared by a workspace project. The bundled copy holds the slot $targetRoot/$dcMember and stays registered; the declared source(s) below are NOT linked and NOT registered, and will be shadowed until one of the two is renamed:" >&2
				while IFS= read -r dcSrc ; do
					[ -n "$dcSrc" ] || continue
					echo "#   shadowed declared source: $dcSrc" >&2
				done <<< "$dcSources"
				continue
			fi

			if [ "$dcCount" = "1" ] ; then
				dcLinkTarget="$dcSources"
			else
				echo "# $MDSC_CMD --install-skillset-symlinks: composite team-member $dcMember from $dcCount source project(s)" >&2

				local dcCollisions
				dcCollisions="$(
					while IFS= read -r dcSrc ; do
						[ -n "$dcSrc" ] || continue
						( cd "$dcSrc" && find -L . -type f -print ) | sed 's|^\./||'
					done <<< "$dcSources" | sort | uniq -d
				)"
				if [ -n "$dcCollisions" ] ; then
					echo "🙋 WARNING: $MDSC_CMD --install-skillset-symlinks: composite $dcMember has $( printf '%s' "$dcCollisions" | grep -c '' ) colliding path(s) across its sources; later source wins per path:" >&2
					while IFS= read -r dcCollision ; do
						[ -n "$dcCollision" ] || continue
						echo "#   collision: $dcCollision" >&2
					done <<< "$dcCollisions"
				fi

				local dcTarget="$compositeRoot/$dcMember"
				if [ -L "$dcTarget" ] ; then
					echo "⛔ ERROR: $MDSC_CMD --install-skillset-symlinks: composite build path is a symlink, refusing to clear it: $dcTarget" >&2
					hadError="true"
					continue
				fi
				if [ -e "$dcTarget" ] && [ ! -d "$dcTarget" ] ; then
					echo "⛔ ERROR: $MDSC_CMD --install-skillset-symlinks: composite build path exists and is not a directory: $dcTarget" >&2
					hadError="true"
					continue
				fi
				rm -rf "$dcTarget" 2>/dev/null || true
				mkdir -p "$dcTarget" || {
					echo "⛔ ERROR: $MDSC_CMD --install-skillset-symlinks: can't create composite directory: $dcTarget" >&2
					hadError="true"
					continue
				}
				local dcRsyncFailed="false"
				while IFS= read -r dcSrc ; do
					[ -n "$dcSrc" ] || continue
					if ! rsync -a -I "$dcSrc/" "$dcTarget/" ; then
						echo "⛔ ERROR: $MDSC_CMD --install-skillset-symlinks: rsync failed for composite $dcMember source: $dcSrc" >&2
						dcRsyncFailed="true"
					fi
				done <<< "$dcSources"
				if [ "$dcRsyncFailed" = "true" ] ; then
					hadError="true"
					continue
				fi
				dcLinkTarget="$dcTarget"
			fi

			local dcSlot="$targetRoot/$dcMember"
			if [ -L "$dcSlot" ] && [ ! -e "$dcSlot" ] ; then
				echo "# $MDSC_CMD --install-skillset-symlinks: $dcSlot is a dangling symlink (points at $( readlink "$dcSlot" ), which does not exist) -- reclaiming the slot" >&2
				if ! rm -f "$dcSlot" ; then
					echo "⛔ ERROR: $MDSC_CMD --install-skillset-symlinks: failed to remove dangling symlink: $dcSlot" >&2
					hadError="true"
					continue
				fi
			elif [ -L "$dcSlot" ] ; then
				if [ "$( readlink "$dcSlot" )" != "$dcLinkTarget" ] ; then
					keptMembers="${keptMembers}${dcMember} "
				fi
				ownedMembers="${ownedMembers}${dcMember} ${dcLinkTarget}"$'\n'
				continue
			fi
			if [ -e "$dcSlot" ] ; then
				echo "⛔ ERROR: $MDSC_CMD --install-skillset-symlinks: real content at $dcSlot, won't overwrite (declared source is $dcLinkTarget)" >&2
				errorMembers="${errorMembers}${dcMember} " ; hadError="true"
				continue
			fi
			if ! ln -s "$dcLinkTarget" "$dcSlot" ; then
				echo "⛔ ERROR: $MDSC_CMD --install-skillset-symlinks: failed to create symlink: $dcSlot" >&2
				errorMembers="${errorMembers}${dcMember} " ; hadError="true"
				continue
			fi
			ownedMembers="${ownedMembers}${dcMember} ${dcLinkTarget}"$'\n'
			newLinks="${newLinks}${dcMember} "
		done

		if [ "$removeMode" != "true" ] ; then
			local unclaimedDir unclaimedName
			for unclaimedDir in "$bundleRoot"/*/ ; do
				[ -d "${unclaimedDir%/}" ] || continue
				unclaimedName="$( basename "${unclaimedDir%/}" )"
				[ "$unclaimedName" != "trash" ] || continue
				if ! printf '%s\n' "$ownedMembers" | awk -v m="$unclaimedName" 'NF && $1 == m { hit = 1 } END { exit !hit }' ; then
					echo "⛔ ERROR: $MDSC_CMD --install-skillset-symlinks: bundled team-member $unclaimedName was not installed into $targetRoot and will not load" >&2
				fi
			done
		fi

		local regLock="$registryFile.lock" regWait=0 regLocked="false"
		while true ; do
			if mkdir "$regLock" 2>/dev/null ; then
				regLocked="true"
				break
			fi
			regWait=$(( regWait + 1 ))
			if [ "$regWait" -gt 10 ] ; then
				echo "⛔ ERROR: $MDSC_CMD --install-skillset-symlinks: registry busy, lock not acquired after $regWait attempts: $regLock" >&2
				hadError="true"
				break
			fi
			sleep 1
		done

		if [ "$regLocked" = "true" ] ; then
			[ -f "$registryFile" ] || : > "$registryFile"

			local regEntry regName regResolved regType regRel regLine regTmp
			while IFS= read -r regEntry ; do
				[ -n "$regEntry" ] || continue
				regName="${regEntry%% *}"
				regResolved="${regEntry#* }"
				case "$regResolved" in
					"$compositeRoot"/*)      regType=".local-merged"   ; regRel="${regResolved#$workspace/.local/}" ;;
					"$workspace/.local/"*)   regType=".local-symlink"  ; regRel="${regResolved#$workspace/.local/}" ;;
					"$workspace/source/"*)   regType="source-symlink"  ; regRel="${regResolved#$workspace/source/}" ;;
					## last of the known-good arms: a vendored copy matches one of the three
					## above first, so this one only speaks for an origin outside $workspace.
					"$originRoot"/*)         regType="origin-symlink"  ; regRel="${regResolved#$originRoot/}" ;;
					*)
						echo "🙋 WARNING: $MDSC_CMD --install-skillset-symlinks: not registered, points outside both workspace $workspace and origin $originRoot (pre-existing link kept, not ours to claim): $regName -> $regResolved" >&2
						continue
					;;
				esac
				regLine="$regName:$workspaceName:$regType:$regRel"

				if awk -F: -v m="$regName" -v w="$workspaceName" -v t="$regType" -v p="$regRel" '
					$1 == m && $2 == w && $3 == t && substr( $0, length($1) + length($2) + length($3) + 4 ) == p { hit = 1 }
					END { exit !hit }
				' "$registryFile" 2>/dev/null ; then
					continue
				fi
				if awk -F: -v m="$regName" -v w="$workspaceName" '$1 == m && $2 == w { hit = 1 } END { exit !hit }' "$registryFile" 2>/dev/null ; then
					regTmp="$registryFile.tmp.$$"
					if awk -F: -v m="$regName" -v w="$workspaceName" '!( $1 == m && $2 == w )' "$registryFile" > "$regTmp" ; then
						printf '%s\n' "$regLine" >> "$regTmp"
						if ! mv -f "$regTmp" "$registryFile" ; then
							echo "⛔ ERROR: $MDSC_CMD --install-skillset-symlinks: registry rewrite failed for $regLine" >&2
							rm -f "$regTmp" 2>/dev/null || true
							hadError="true"
							continue
						fi
					else
						echo "⛔ ERROR: $MDSC_CMD --install-skillset-symlinks: registry read failed while rewriting $regLine -- registry left untouched" >&2
						rm -f "$regTmp" 2>/dev/null || true
						hadError="true"
						continue
					fi
				else
					printf '%s\n' "$regLine" >> "$registryFile"
				fi
				regChanges="${regChanges}${regName} "
			done <<< "$ownedMembers"

			if [ "$discoveryTrusted" != "true" ] ; then
				echo "🙋 WARNING: $MDSC_CMD --install-skillset-symlinks: discovery could not be trusted this run -- removing NOTHING. An unreadable or empty member list is never read as 'every member disappeared'." >&2
			elif [ "$hadError" = "true" ] ; then
				echo "🙋 WARNING: $MDSC_CMD --install-skillset-symlinks: errors earlier this run -- removing NOTHING, this run's member list is not a complete picture of the workspace." >&2
			else
				local rcOwned rcEntry rcName rcType rcRel rcPath rcSlot rcTmp
				rcOwned="$(
					awk -F: -v w="$workspaceName" '
						$2 == w {
							rest = substr( $0, length($1) + length($2) + length($3) + 4 )
							printf "%s\t%s\t%s\n", $1, $3, rest
						}
					' "$registryFile"
				)"
				while IFS="$( printf '\t' )" read -r rcName rcType rcRel ; do
					[ -n "$rcName" ] || continue
					if printf '%s\n' "$ownedMembers" | awk -v m="$rcName" 'NF && $1 == m { hit = 1 } END { exit !hit }' ; then
						continue
					fi

					case "$rcType" in
						source-symlink) rcPath="$workspace/source/$rcRel" ;;
						*)              rcPath="$workspace/.local/$rcRel" ;;
					esac
					if [ "$removeMode" != "true" ] && [ -e "$rcPath" ] ; then
						continue
					fi

					rcTmp="$registryFile.tmp.$$"
					if ! awk -F: -v m="$rcName" -v w="$workspaceName" '!( $1 == m && $2 == w )' "$registryFile" > "$rcTmp" ; then
						echo "⛔ ERROR: $MDSC_CMD --install-skillset-symlinks: registry read failed while removing $rcName:$workspaceName -- registry left untouched" >&2
						rm -f "$rcTmp" 2>/dev/null || true
						hadError="true"
						continue
					fi
					if ! mv -f "$rcTmp" "$registryFile" ; then
						echo "⛔ ERROR: $MDSC_CMD --install-skillset-symlinks: registry rewrite failed removing $rcName:$workspaceName" >&2
						rm -f "$rcTmp" 2>/dev/null || true
						hadError="true"
						continue
					fi
					deletedMembers="${deletedMembers}${rcName} "

					if awk -F: -v m="$rcName" '$1 == m { hit = 1 } END { exit !hit }' "$registryFile" 2>/dev/null ; then
						continue
					fi
					rcSlot="$targetRoot/$rcName"
					if [ -L "$rcSlot" ] ; then
						if rm -f "$rcSlot" ; then
							echo "🔗 unlinked $rcName, no workspace registers it any more" >&2
						else
							echo "⛔ ERROR: $MDSC_CMD --install-skillset-symlinks: failed to unlink: $rcSlot" >&2
							hadError="true"
						fi
					elif [ -e "$rcSlot" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --install-skillset-symlinks: $rcSlot is not a symlink, refusing to remove real content" >&2
						hadError="true"
					fi
				done <<< "$rcOwned"
			fi

			rmdir "$regLock" 2>/dev/null || true
		fi

		local shortRoot="$targetRoot" reportScope="home" reportEntry reportName reportWho
		local regLineName regLineWs regLineRest regLineTarget foreignMembers=""

		## members another workspace registered into this same root: present and real, not ours to touch,
		## but they are in the root and the count has to say so
		if [ -f "$registryFile" ] ; then
			## the same root is often shared by several workspaces (e.g. two workspaces both
			## registering into ~/.claude/skills under their own workspace name) -- one registry
			## line per registering workspace, but it is still one real slot: dedupe by name
			while IFS=: read -r regLineName regLineWs regLineRest ; do
				[ -n "$regLineName" ] || continue
				[ "$regLineWs" != "$workspaceName" ] || continue
				[ -e "$targetRoot/$regLineName" ] || continue
				case " $foreignMembers " in *" $regLineName "*) continue ;; esac
				## already reported via ownedMembers -- this workspace registers it too,
				## a second (foreign) registry line for the same name is not a second slot.
				## ownedMembers is "name path" pairs, one per line -- match the name field, not a substring.
				printf '%s\n' "$ownedMembers" | awk -v m="$regLineName" 'NF && $1 == m { hit = 1 } END { exit !hit }' && continue
				foreignMembers="${foreignMembers}${regLineName} "
			done < "$registryFile"
		fi
		case "$shortRoot" in
			"$workspace"/*) shortRoot=".${shortRoot#$workspace}" ;;
			"$HOME"/*) shortRoot="~${shortRoot#$HOME}" ;;
		esac
		[ "$scope" != "workspace" ] || reportScope="workspace"

		if [ "$removeMode" != "true" ] ; then
			## one record per member; the caller owning the report renders them as a single table at the end
			if [ -n "$MDSC_SKILLSET_REPORT" ] ; then
				{
					while IFS= read -r reportEntry ; do
						[ -n "$reportEntry" ] || continue
						reportName="${reportEntry%% *}"
						case " $errorMembers " in *" $reportName "*) continue ;; esac
						## `status: reference-only` marks the non-acting human record; every acting member is `active`
						reportWho="🤖"
						if grep -q '^status: reference-only' "${reportEntry#* }/SKILL.md" 2>/dev/null ; then reportWho="👤" ; fi
						case " $newLinks $regChanges " in
							*" $reportName "*) printf '%s\t%s\t%s\t%s\n' "$reportName" "$reportScope" "updated" "$reportWho" ;;
							*) printf '%s\t%s\t%s\t%s\n' "$reportName" "$reportScope" "kept" "$reportWho" ;;
						esac
					done <<< "$ownedMembers"
					for reportName in $errorMembers ; do printf '%s\t%s\t%s\t%s\n' "$reportName" "$reportScope" "error" "🤖" ; done
					for reportName in $deletedMembers ; do printf '%s\t%s\t%s\t%s\n' "$reportName" "$reportScope" "deleted" "🤖" ; done
					for reportName in $foreignMembers ; do
						reportWho="🤖"
						regLineTarget="$( readlink "$targetRoot/$reportName" 2>/dev/null )" || regLineTarget=""
						if [ -n "$regLineTarget" ] && grep -q '^status: reference-only' "$regLineTarget/SKILL.md" 2>/dev/null ; then reportWho="👤" ; fi
						printf '%s\t%s\t%s\t%s\n' "$reportName" "$reportScope" "kept" "$reportWho"
					done
				} >> "$MDSC_SKILLSET_REPORT"
			fi
			## progress while the roots are worked through; the table lands once, after all of them
			echo "🔗 $shortRoot: $(( $( printf '%s' "$ownedMembers" | grep -c '' ) + $( printf '%s' "$foreignMembers" | wc -w ) )) members" >&2
		fi

		if [ "$hadError" = "true" ] ; then
			set +e ; return 1
		fi
		return 0
	;;

	--install-skillset-report-render)
		shift
		[ -s "$MDSC_SKILLSET_REPORT" ] || return 0
		LC_ALL=C awk -F'\t' '
			{
				seen[$1] = 1 ; refs[$1]++ ; scope[$1 "|" $2] = 1 ; who[$1] = $4
				if ( $3 == "error" ) rank[$1] = 4
				else if ( $3 == "deleted" && rank[$1] < 3 ) rank[$1] = 3
				else if ( $3 == "updated" && rank[$1] < 2 ) rank[$1] = 2
				else if ( rank[$1] < 1 ) rank[$1] = 1
			}
			END {
				n = 0
				for ( m in seen ) order[++n] = m
				for ( i = 1 ; i < n ; i++ ) for ( j = i + 1 ; j <= n ; j++ ) if ( order[j] < order[i] ) { t = order[i] ; order[i] = order[j] ; order[j] = t ; }
				printf "🔗 magic-team skillset: %d members\n", n
				printf "   %-2s %-20s %-8s %5s %5s %6s\n", "", "MEMBER", "OP", "REFS", "HOME", "WSPACE"
				for ( i = 1 ; i <= n ; i++ ) {
					m = order[i]
					op = ( rank[m] == 4 ) ? "ERROR" : ( rank[m] == 3 ) ? "DELETED" : ( rank[m] == 2 ) ? "UPDATED" : "KEPT"
					printf "   %-2s %-20s %-8s %5d %5s %6s\n", who[m], m, op, refs[m], \
						( ( m "|home" ) in scope ) ? "yes" : "-", \
						( ( m "|workspace" ) in scope ) ? "yes" : "-"
				}
			}
		' "$MDSC_SKILLSET_REPORT" >&2
		return 0
	;;

	--install-claude-permissions)
		shift
		if [ "$#" -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD --install-claude-permissions: invalid option: $1" >&2
			set +e ; return 1
		fi

		## $HOME-scoped: Claude Code's own global settings file, same scope as
		## --install-vscode-integrations' ~/.claude.json write above. The Slack
		## deny below must hold in every workspace, which only this file gives.
		local settingsFile="$HOME/.claude/settings.json"
		if [ ! -f "$settingsFile" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --install-claude-permissions: not found: $settingsFile" >&2
			set +e ; return 1
		fi

		## $MDAT_DATA_ROOT is already resolved by DistroAgentsTools() at entry
		## (from TEAM_DATA_DIRECTORY) -- reused as-is, never re-derived.
		if [ -z "${MDAT_DATA_ROOT:-}" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --install-claude-permissions: MDAT_DATA_ROOT could not be resolved (TEAM_DATA_DIRECTORY not configured) -- refusing to write $settingsFile without a real board path" >&2
			set +e ; return 1
		fi
		local boardRoot="$MDAT_DATA_ROOT/board"

		## Every acting (non reference-only) member's real skillset directory,
		## enumerated fresh from $HOME/.claude/skills -- same reference-only
		## test --install-skillset-symlinks uses, same cd+pwd -P resolution
		## idiom used elsewhere in this file.
		local skillsRoot="$HOME/.claude/skills"
		local memberPathsFile
		memberPathsFile="$( mktemp "${TMPDIR:-/tmp}/agents-claude-permissions-members.XXXXXX" )" || {
			echo "⛔ ERROR: $MDSC_CMD --install-claude-permissions: mktemp failed" >&2
			set +e ; return 1
		}
		local memberEntry memberName memberReal
		for memberEntry in "$skillsRoot"/*/ ; do
			[ -d "${memberEntry%/}" ] || continue
			memberName="$( basename "${memberEntry%/}" )"
			[ "$memberName" != "trash" ] || continue
			memberReal="$( cd "${memberEntry%/}" 2>/dev/null && pwd -P )" || continue
			[ -n "$memberReal" ] || continue
			if [ -f "$memberReal/SKILL.md" ] && grep -q '^status: reference-only' "$memberReal/SKILL.md" 2>/dev/null ; then
				continue
			fi
			printf '%s\n' "$memberReal" >> "$memberPathsFile"
		done
		sort -u -o "$memberPathsFile" "$memberPathsFile"
		local memberCount
		memberCount="$( grep -c '' "$memberPathsFile" )"

		local settingsTmp
		settingsTmp="$( mktemp "$settingsFile.XXXXXX" )" || {
			echo "⛔ ERROR: $MDSC_CMD --install-claude-permissions: mktemp failed beside $settingsFile" >&2
			rm -f "$memberPathsFile"
			set +e ; return 1
		}

		## mcp__myx_distro__execute: mandated by this workspace's own CLAUDE.md.
		## Agent/Task: coordinator dispatch/fan-out. No Bash grant: nothing here
		## needs one; a future pass adding one should prefer scoped prefixes
		## (e.g. `Bash(git status:*)`) over a bare `Bash` grant.
		local staticAllowJson='["mcp__myx_distro__execute", "Agent", "Task"]'
		## Native Slack MCP tool, hard-blocked -- separate path from the team's
		## own sanctioned --member-comms-slack-* Bash ops, which this cannot reach.
		local denyAddJson='["mcp__claude_ai_Slack"]'

		if ! MYX_CLAUDEPERMS_BOARD_ROOT="$boardRoot" \
			MYX_CLAUDEPERMS_STATIC_ALLOW_JSON="$staticAllowJson" \
			MYX_CLAUDEPERMS_DENY_ADD_JSON="$denyAddJson" \
			MYX_CLAUDEPERMS_MEMBERS_FILE="$memberPathsFile" \
			LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsClaudeSettingsPermissionsUpsert.awk" \
			"$settingsFile" > "$settingsTmp" ; then
			echo "⛔ ERROR: $MDSC_CMD --install-claude-permissions: permissions merge failed, $settingsFile left untouched" >&2
			rm -f "$settingsTmp" "$memberPathsFile"
			set +e ; return 1
		fi
		rm -f "$memberPathsFile"

		if cmp -s "$settingsTmp" "$settingsFile" ; then
			rm -f "$settingsTmp"
			echo "✅ claude permissions already current: $settingsFile (board: $boardRoot, $memberCount member grant(s))" >&2
			return 0
		fi

		if ! chmod 0644 "$settingsTmp" || ! mv -f "$settingsTmp" "$settingsFile" ; then
			echo "⛔ ERROR: $MDSC_CMD --install-claude-permissions: could not install $settingsFile" >&2
			rm -f "$settingsTmp"
			set +e ; return 1
		fi

		echo "✅ claude permissions installed: $settingsFile (board: $boardRoot, $memberCount member grant(s))" >&2
		return 0
	;;

	--install-workspace-restrictions)
		shift

		local workspaceArg
		while [ "$#" -gt 0 ] ; do
			case "$1" in
				--workspace)
					if [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --install-workspace-restrictions: --workspace requires a value" >&2
						set +e ; return 1
					fi
					workspaceArg="$2" ; shift 2
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --install-workspace-restrictions: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done

		local workspace="${workspaceArg:-$MMDAPP}"
		if [ ! -d "$workspace" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --install-workspace-restrictions: workspace not found: $workspace" >&2
			set +e ; return 1
		fi
		workspace="$( cd "$workspace" && pwd )"

		local claudeDir="$workspace/.claude"
		local hooksDir="$claudeDir/hooks"
		mkdir -p "$hooksDir" || {
			echo "⛔ ERROR: $MDSC_CMD --install-workspace-restrictions: cannot create $hooksDir" >&2
			set +e ; return 1
		}

		local settingsFile="$claudeDir/settings.json"
		if [ ! -f "$settingsFile" ] ; then
			printf '{}\n' > "$settingsFile" || {
				echo "⛔ ERROR: $MDSC_CMD --install-workspace-restrictions: cannot create $settingsFile" >&2
				set +e ; return 1
			}
		fi

		## Two hook scripts, kept separate from each other and from the
		## already hand-verified protect-memory-md.sh (Edit/Write on
		## MEMORY.md, untouched by this op): the plain permissions.deny
		## array cannot carry a custom denial reason (only a PreToolUse
		## hook's permissionDecisionReason can), so every one of these
		## restrictions needs hook logic, not a deny-array entry alone.
		## Regenerated every run (tmp+cmp+mv, like the mcp.json upserts
		## above) so drift is corrected but a no-op run touches nothing.
		local hooksFailed=0

		local readHookFile="$hooksDir/deny-memory-md-read.sh"
		local readHookTmp
		readHookTmp="$( mktemp "$readHookFile.XXXXXX" )" || { hooksFailed=1 ; }
		if [ -n "$readHookTmp" ] ; then
			cat > "$readHookTmp" <<'HOOKEOF'
#!/bin/bash
# Denies Read on the memory-system's MEMORY.md index file, with a reason,
# since the plain permissions.deny array cannot carry a custom denial
# message. Sibling to protect-memory-md.sh (Edit/Write) -- kept as its own
# file rather than merged into it, so that already-verified script is never
# touched by an unrelated change.
INPUT=$(cat)
FILE_PATH=$(echo "$INPUT" | jq -r '.tool_input.file_path // empty')

if [[ "$FILE_PATH" == */.claude/projects/*/memory/MEMORY.md ]]; then
	echo '{
		"hookSpecificOutput": {
			"hookEventName": "PreToolUse",
			"permissionDecision": "deny",
			"permissionDecisionReason": "read workspace, repository and project MAGIC.md"
		}
	}'
	exit 0
fi

exit 0
HOOKEOF
			if [ "$?" != "0" ] || ! chmod 0755 "$readHookTmp" ; then
				echo "⛔ ERROR: $MDSC_CMD --install-workspace-restrictions: could not write $readHookFile" >&2
				rm -f "$readHookTmp"
				hooksFailed=1
			elif cmp -s "$readHookTmp" "$readHookFile" 2>/dev/null ; then
				rm -f "$readHookTmp"
			elif ! mv -f "$readHookTmp" "$readHookFile" ; then
				echo "⛔ ERROR: $MDSC_CMD --install-workspace-restrictions: could not install $readHookFile" >&2
				rm -f "$readHookTmp"
				hooksFailed=1
			fi
		else
			echo "⛔ ERROR: $MDSC_CMD --install-workspace-restrictions: mktemp failed beside $readHookFile" >&2
		fi

		local bashHookFile="$hooksDir/deny-bash-tool.sh"
		local bashHookTmp
		bashHookTmp="$( mktemp "$bashHookFile.XXXXXX" )" || { hooksFailed=1 ; }
		if [ -n "$bashHookTmp" ] ; then
			cat > "$bashHookTmp" <<'HOOKEOF'
#!/bin/bash
# Denies all Bash tool usage wholesale -- git, rm, mv, python3, every command
# -- with a reason, since the plain permissions.deny array cannot carry a
# custom denial message. Workspace-wide: no file-path scoping, every Bash
# call is denied regardless of what it would run.
cat >/dev/null
echo '{
	"hookSpecificOutput": {
		"hookEventName": "PreToolUse",
		"permissionDecision": "deny",
		"permissionDecisionReason": "always use myx.distro MCP TOOLING to properly execute shell commands"
	}
}'
exit 0
HOOKEOF
			if [ "$?" != "0" ] || ! chmod 0755 "$bashHookTmp" ; then
				echo "⛔ ERROR: $MDSC_CMD --install-workspace-restrictions: could not write $bashHookFile" >&2
				rm -f "$bashHookTmp"
				hooksFailed=1
			elif cmp -s "$bashHookTmp" "$bashHookFile" 2>/dev/null ; then
				rm -f "$bashHookTmp"
			elif ! mv -f "$bashHookTmp" "$bashHookFile" ; then
				echo "⛔ ERROR: $MDSC_CMD --install-workspace-restrictions: could not install $bashHookFile" >&2
				rm -f "$bashHookTmp"
				hooksFailed=1
			fi
		else
			echo "⛔ ERROR: $MDSC_CMD --install-workspace-restrictions: mktemp failed beside $bashHookFile" >&2
		fi

		if [ "$hooksFailed" != "0" ] ; then
			set +e ; return 1
		fi

		## permissions.deny: bare "Bash" denies the whole tool (same shape as
		## --install-claude-permissions' own bare "mcp__claude_ai_Slack"
		## entry), which already fully covers every command run through
		## Bash -- python3, rm, mv, everything -- since none of them are
		## reachable any other way. The three scoped patterns underneath are
		## deliberate defense-in-depth, not required for the block to hold
		## today: if the wholesale "Bash" entry (or the PreToolUse hook
		## above) is ever loosened or removed later, these narrower
		## patterns keep python3/rm/mv denied on their own. "Bash(rm *)"
		## and "Bash(mv *)" mirror this same workspace's own
		## $HOME/.claude/settings.json global deny-array pattern shape
		## (space before the wildcard); that global entry has no custom
		## reason and denies user-scope only, so it does not substitute for
		## either the workspace-scoped entry here or the reason-bearing
		## hook above.
		local denyAddJson='["Bash", "Bash(mv *)", "Bash(python3*)", "Bash(rm *)"]'

		local hooksDescFile
		hooksDescFile="$( mktemp "${TMPDIR:-/tmp}/agents-ws-restrictions-hooks.XXXXXX" )" || {
			echo "⛔ ERROR: $MDSC_CMD --install-workspace-restrictions: mktemp failed" >&2
			set +e ; return 1
		}
		{
			printf '%s\t%s\n' ".claude/hooks/deny-memory-md-read.sh" '{"matcher": "Read", "hooks": [{"type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/deny-memory-md-read.sh"}]}'
			printf '%s\t%s\n' ".claude/hooks/deny-bash-tool.sh" '{"matcher": "Bash", "hooks": [{"type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/deny-bash-tool.sh"}]}'
		} > "$hooksDescFile"

		local settingsTmp
		settingsTmp="$( mktemp "$settingsFile.XXXXXX" )" || {
			echo "⛔ ERROR: $MDSC_CMD --install-workspace-restrictions: mktemp failed beside $settingsFile" >&2
			rm -f "$hooksDescFile"
			set +e ; return 1
		}

		## Standing Read allow-grant on this workspace's own source/ tree --
		## covers every source-symlinked skillset file (--install-skillset-symlinks
		## links a member's skills-dir slot into here), so a plain skillset/
		## MAGIC.md read never triggers an interactive permission prompt.
		## Resolved per-target-workspace, same as $claudeDir/$hooksDir above --
		## never hardcoded to one workspace.
		local sourceRoot="$workspace/source"

		## Fixed extra reference roots -- real, external filesystem locations
		## outside any target workspace's own source/ tree that this
		## ecosystem's agents routinely need plain Read access to, the SAME
		## roots for every target workspace (unlike $sourceRoot above, never
		## workspace-derived). Kept short and evidenced, not speculative --
		## add an entry here only once live use actually hits the permission
		## prompt for it, the same way this one was found.
		##   /Volumes/workspace/myx -- the canonical, editable AE3 legacy
		##   Eclipse-project checkout (keeper-ae3's own Domain anchor; distinct
		##   from ws-myx.ae3-devel, which is pull-only and already reached via
		##   its own vendored source/ tree). A separate filesystem mount, so
		##   $sourceRoot above never covers it. Confirmed live, 2026-08-30:
		##   AE3/XHTML investigation work reading files under it (e.g.
		##   CurrentValues.js, show.xsl.tpl, HTMLEmitter.java,
		##   SerializerFactoryHtmlScriptStyleFix.java) hit the interactive
		##   permission prompt every time.
		local allowExtraRootsJson='["/Volumes/workspace/myx"]'

		if ! MYX_WSRESTRICT_DENY_ADD_JSON="$denyAddJson" \
			MYX_WSRESTRICT_HOOKS_FILE="$hooksDescFile" \
			MYX_WSRESTRICT_ALLOW_SOURCE_ROOT="$sourceRoot" \
			MYX_WSRESTRICT_ALLOW_EXTRA_ROOTS_JSON="$allowExtraRootsJson" \
			LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsClaudeWorkspaceRestrictionsUpsert.awk" \
			"$settingsFile" > "$settingsTmp" ; then
			echo "⛔ ERROR: $MDSC_CMD --install-workspace-restrictions: settings merge failed, $settingsFile left untouched" >&2
			rm -f "$settingsTmp" "$hooksDescFile"
			set +e ; return 1
		fi
		rm -f "$hooksDescFile"

		if cmp -s "$settingsTmp" "$settingsFile" ; then
			rm -f "$settingsTmp"
			echo "✅ workspace restrictions already current: $settingsFile" >&2
			return 0
		fi

		if ! chmod 0644 "$settingsTmp" || ! mv -f "$settingsTmp" "$settingsFile" ; then
			echo "⛔ ERROR: $MDSC_CMD --install-workspace-restrictions: could not install $settingsFile" >&2
			rm -f "$settingsTmp"
			set +e ; return 1
		fi

		echo "✅ workspace restrictions installed: $settingsFile" >&2
		return 0
	;;

	--install-workspace-integrations)
		shift

		local scope workspaceArg quiet="false"
		while [ "$#" -gt 0 ] ; do
			case "$1" in
				--quiet)
					quiet="true" ; shift
				;;
				--scope)
					if [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --install-workspace-integrations: --scope requires a value" >&2
						set +e ; return 1
					fi
					scope="$2" ; shift 2
				;;
				--workspace)
					if [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD --install-workspace-integrations: --workspace requires a value" >&2
						set +e ; return 1
					fi
					workspaceArg="$2" ; shift 2
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --install-workspace-integrations: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done

		local workspace="${workspaceArg:-$MMDAPP}"
		if [ ! -d "$workspace" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --install-workspace-integrations: workspace not found: $workspace" >&2
			set +e ; return 1
		fi
		workspace="$( cd "$workspace" && pwd )"

		DistroAgentsTools --install-vscode-integrations --workspace "$workspace" || { set +e ; return 1 ; }

		local ownsReport="false"
		if [ -z "$MDSC_SKILLSET_REPORT" ] ; then
			MDSC_SKILLSET_REPORT="$( mktemp "${TMPDIR:-/tmp}/magic-skillset.XXXXXX" )" || { set +e ; return 1 ; }
			export MDSC_SKILLSET_REPORT ; ownsReport="true"
		fi
		if [ -n "$scope" ] ; then
			DistroAgentsTools --install-skillset-symlinks --scope "$scope" --workspace "$workspace" || { set +e ; return 1 ; }
		else
			DistroAgentsTools --install-skillset-symlinks --scope user-home --workspace "$workspace" || { set +e ; return 1 ; }
			DistroAgentsTools --install-skillset-symlinks --scope workspace --workspace "$workspace" || { set +e ; return 1 ; }
		fi
		if [ "$ownsReport" = "true" ] ; then
			DistroAgentsTools --install-skillset-report-render
			rm -f "$MDSC_SKILLSET_REPORT" ; unset MDSC_SKILLSET_REPORT
		fi

		DistroAgentsTools --install-claude-permissions || { set +e ; return 1 ; }

		## Standing Read allow-grant on this workspace's own source/ tree -- same
		## mechanism --install-workspace-restrictions uses for its own allow
		## entry, called here too (deny-add/hooks/extra-roots all empty) so this
		## lands for EVERY workspace that runs plain integration setup, not only
		## the ones that separately opt into --install-workspace-restrictions.
		## Originally landed restrictions-only by mistake: most workspaces never
		## run --install-workspace-restrictions (an opt-in hardening op), so the
		## original 2026-08-14 ask ("pre-grant skillset read permission... after
		## all setup") was never actually solved for them. Extra reference roots
		## (e.g. /Volumes/workspace/myx) stay restrictions-only, deliberately:
		## those are evidenced needs specific to a hardened workspace's own real
		## work, not something every workspace running plain setup should get by
		## default.
		local claudeDir="$workspace/.claude"
		mkdir -p "$claudeDir" || { echo "⛔ ERROR: $MDSC_CMD --install-workspace-integrations: cannot create $claudeDir" >&2 ; set +e ; return 1 ; }
		local settingsFile="$claudeDir/settings.json"
		if [ ! -f "$settingsFile" ] ; then
			printf '{}\n' > "$settingsFile" || { echo "⛔ ERROR: $MDSC_CMD --install-workspace-integrations: cannot create $settingsFile" >&2 ; set +e ; return 1 ; }
		fi
		local allowHooksDescFile
		allowHooksDescFile="$( mktemp "${TMPDIR:-/tmp}/agents-ws-integrations-hooks.XXXXXX" )" || {
			echo "⛔ ERROR: $MDSC_CMD --install-workspace-integrations: mktemp failed" >&2
			set +e ; return 1
		}
		local allowSettingsTmp
		allowSettingsTmp="$( mktemp "$settingsFile.XXXXXX" )" || {
			echo "⛔ ERROR: $MDSC_CMD --install-workspace-integrations: mktemp failed beside $settingsFile" >&2
			rm -f "$allowHooksDescFile"
			set +e ; return 1
		}
		if ! MYX_WSRESTRICT_DENY_ADD_JSON='[]' \
			MYX_WSRESTRICT_HOOKS_FILE="$allowHooksDescFile" \
			MYX_WSRESTRICT_ALLOW_SOURCE_ROOT="$workspace/source" \
			MYX_WSRESTRICT_ALLOW_EXTRA_ROOTS_JSON='[]' \
			LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsClaudeWorkspaceRestrictionsUpsert.awk" \
			"$settingsFile" > "$allowSettingsTmp" ; then
			echo "⛔ ERROR: $MDSC_CMD --install-workspace-integrations: settings merge failed, $settingsFile left untouched" >&2
			rm -f "$allowSettingsTmp" "$allowHooksDescFile"
			set +e ; return 1
		fi
		rm -f "$allowHooksDescFile"
		if cmp -s "$allowSettingsTmp" "$settingsFile" ; then
			rm -f "$allowSettingsTmp"
		elif ! chmod 0644 "$allowSettingsTmp" || ! mv -f "$allowSettingsTmp" "$settingsFile" ; then
			echo "⛔ ERROR: $MDSC_CMD --install-workspace-integrations: could not install $settingsFile" >&2
			rm -f "$allowSettingsTmp"
			set +e ; return 1
		fi

		## --quiet used to drop the step narration that is now gone; the op's one outcome line always prints
		echo "✅ workspace integrations installed" >&2
		return 0
	;;

	--install-vscode-integrations)
		shift

		local workspaceArg
		while [ "$#" -gt 0 ] ; do
			case "$1" in
				--workspace)
					workspaceArg="$2" ; shift 2
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD --install-vscode-integrations: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done

		local workspace
		workspace="${workspaceArg:-$MMDAPP}"
		if [ ! -d "$workspace" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --install-vscode-integrations: workspace not found: $workspace" >&2
			set +e ; return 1
		fi
		workspace="$( cd "$workspace" && pwd )"

		local localContextMarker="$workspace/.local/myx/myx.distro-.local/sh-lib/LocalContext.include"
		if [ ! -f "$localContextMarker" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --install-vscode-integrations: not a set-up myx.distro workspace (missing $localContextMarker)" >&2
			set +e ; return 1
		fi

		local failed=0

		echo "# workspace: $workspace" >&2

		local mcpRoot="" mcpRootFound=""
		if [ -n "$MYXROOT" ] && [ -f "$MYXROOT/bin/lib/agentMcpServer.Common" ] ; then
			mcpRootFound="$MYXROOT"
			[ -x "$MYXROOT/bin/lib/agentMcpServer.Common" ] && mcpRoot="$MYXROOT"
		fi
		if [ -z "$mcpRoot" ] && command -v myx.common >/dev/null 2>&1 ; then
			local root
			root="$( myx.common which lib/catMarkdown 2>/dev/null )"
			root="${root%/bin/lib/catMarkdown*}"
			if [ -n "$root" ] && [ -f "$root/bin/lib/agentMcpServer.Common" ] ; then
				[ -n "$mcpRootFound" ] || mcpRootFound="$root"
				[ -x "$root/bin/lib/agentMcpServer.Common" ] && mcpRoot="$root"
			fi
		fi

		local serverScript=""
		[ -z "$mcpRoot" ] || serverScript="$mcpRoot/bin/lib/agentMcpServer.Common"

		local vscodeMcpDir="$workspace/.vscode"
		mkdir -p "$vscodeMcpDir"

		if [ -z "$serverScript" ] ; then
			if [ -n "$mcpRootFound" ] ; then
				echo "⛔ ERROR: mcp-server-path found but not executable: $mcpRootFound/bin/lib/agentMcpServer.Common" >&2
				echo "   fix with: chmod +x $mcpRootFound/bin/lib/agentMcpServer.Common" >&2
			else
				echo "⛔ ERROR: mcp-server-path unresolved (bin/lib/agentMcpServer.Common not found under workspace/.local, workspace source, or a globally installed myx.common)" >&2
			fi
			failed=1
		else
			local homeSetup="$mcpRoot/bin/setup/agentMcp.Common"
			if [ ! -x "$homeSetup" ] ; then
				echo "⛔ ERROR: mcp-home not present/executable, ~/.claude.json local scope NOT registered: $homeSetup" >&2
				failed=1
			elif ! MYXROOT="$mcpRoot" MYX_AGENTMCP_TARGET_CWD="$workspace" "$homeSetup" ; then
				## agentMcp.Common prints its own one-line outcome
				echo "⛔ ERROR: mcp-home ~/.claude.json local-scope registration did not complete (see above)" >&2
				failed=1
			fi

			local escapedWorkspace
			escapedWorkspace="$( printf '%s' "$workspace" | LC_ALL=C awk -f "$mcpRoot/include/data/agentMcpJsonEscape.awk" )"
			local mmdappEnvJson="{\"MMDAPP\":\"$escapedWorkspace\"}"

			local mcpTarget
			for mcpTarget in \
				"$vscodeMcpDir/mcp.json:servers" \
				"$workspace/.mcp.json:mcpServers" \
			; do
				local mcpFile="${mcpTarget%%:*}"
				local mcpKey="${mcpTarget#*:}"
				local mcpSource mcpTmp mcpErr mcpRc=0
				mcpSource="$mcpFile"
				[ -f "$mcpSource" ] || mcpSource=/dev/null
				if ! mcpTmp="$( mktemp "$mcpFile.XXXXXX" )" ; then
					echo "⛔ ERROR: mcp-tmp beside $mcpFile" >&2
					failed=1
					continue
				fi
				mcpErr="$( MYX_MCPUPSERT_TOPKEY="$mcpKey" \
					MYX_MCPUPSERT_ENTRYKEY="myx.common" \
					MYX_MCPUPSERT_COMMAND="$serverScript" \
					MYX_MCPUPSERT_ARGS='["--run"]' \
					MYX_MCPUPSERT_ENV="$mmdappEnvJson" \
					LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsMcpServerJsonUpsert.awk" "$mcpSource" 2>&1 >"$mcpTmp" )" || mcpRc=$?
				if [ "$mcpRc" -ne 0 ] ; then
					echo "⛔ ERROR: mcp-upsert $mcpFile: $mcpErr" >&2
					rm -f "$mcpTmp"
					failed=1
					continue
				fi
				if [ "$mcpSource" != /dev/null ] && cmp -s "$mcpTmp" "$mcpSource" ; then
					rm -f "$mcpTmp"
				else
					if ! chmod 0644 "$mcpTmp" || ! mv -f "$mcpTmp" "$mcpFile" ; then
						echo "⛔ ERROR: mcp-install $mcpFile" >&2
						rm -f "$mcpTmp"
						failed=1
						continue
					fi
					if ! chmod 0644 "$mcpFile" ; then
						echo "⛔ ERROR: mcp-chmod $mcpFile" >&2
						failed=1
					fi
				fi
				local mcpVerdict
				mcpVerdict="$( MYX_MCPVERIFY_TOPKEY="$mcpKey" MYX_MCPVERIFY_COMMAND="$serverScript" \
					LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsMcpServerJsonVerify.awk" "$mcpFile" )"
				if [ "$mcpVerdict" = "OK" ] ; then
					echo "🔌 myx.common registered in ${mcpFile#$workspace/}" >&2
				else
					echo "⛔ ERROR: mcp-check ${mcpFile#$workspace/}: $mcpVerdict" >&2
					failed=1
				fi
			done

			local distroServerScript="$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
			local distroUpsert="$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsMcpServerJsonUpsert.awk"
			if [ "$workspace" != "$MMDAPP" ] ; then
				echo "🙋 WARNING: myx.distro skipped, it registers only when run from its own workspace" >&2
			elif [ ! -x "$distroServerScript" ] ; then
				echo "⛔ ERROR: mcp-distro-path missing or not executable: $distroServerScript" >&2
				failed=1
			else
				local distroTarget
				for distroTarget in \
					"$vscodeMcpDir/mcp.json:servers" \
					"$workspace/.mcp.json:mcpServers" \
				; do
					local distroFile="${distroTarget%%:*}"
					local distroKey="${distroTarget#*:}"
					local distroTmp distroErr distroRc=0
					if ! distroTmp="$( mktemp "$distroFile.XXXXXX" )" ; then
						echo "⛔ ERROR: mcp-distro-tmp beside $distroFile" >&2
						failed=1
						continue
					fi
					distroErr="$( MYX_MCPUPSERT_TOPKEY="$distroKey" \
						MYX_MCPUPSERT_ENTRYKEY="myx.distro" \
						MYX_MCPUPSERT_COMMAND="$distroServerScript" \
						MYX_MCPUPSERT_ARGS='["--intern-mcp-server","--run"]' \
						MYX_MCPUPSERT_ENV="$mmdappEnvJson" \
						LC_ALL=C awk -f "$distroUpsert" "$distroFile" 2>&1 >"$distroTmp" )" || distroRc=$?
					if [ "$distroRc" -ne 0 ] ; then
						echo "⛔ ERROR: mcp-distro-upsert $distroFile: $distroErr" >&2
						rm -f "$distroTmp"
						failed=1
						continue
					fi
					if cmp -s "$distroTmp" "$distroFile" ; then
						rm -f "$distroTmp"
					else
						if ! chmod 0644 "$distroTmp" || ! mv -f "$distroTmp" "$distroFile" ; then
							echo "⛔ ERROR: mcp-distro-install $distroFile" >&2
							rm -f "$distroTmp"
							failed=1
							continue
						fi
					fi
					if MYX_MCPUPSERT_TOPKEY="$distroKey" \
						MYX_MCPUPSERT_ENTRYKEY="myx.distro" \
						MYX_MCPUPSERT_COMMAND="$distroServerScript" \
						MYX_MCPUPSERT_ARGS='["--intern-mcp-server","--run"]' \
						MYX_MCPUPSERT_ENV="$mmdappEnvJson" \
						LC_ALL=C awk -f "$distroUpsert" "$distroFile" 2>/dev/null \
						| cmp -s - "$distroFile" ; then
						echo "🔌 myx.distro registered in ${distroFile#$workspace/}" >&2
					else
						echo "⛔ ERROR: mcp-distro-check ${distroFile#$workspace/}" >&2
						failed=1
					fi
				done
			fi
		fi

		if [ ! -x "$workspace/DistroSourceConsole.sh" ] ; then
			echo "🙋 WARNING: code-workspace not regenerated, no executable DistroSourceConsole.sh -- chat.agentSkillsLocations stays absent" >&2
		elif ! echo 'DistroSourceTools.fn.sh --make-code-workspace --quiet' | "$workspace/DistroSourceConsole.sh" --non-interactive >&2 ; then
			echo "⛔ ERROR: code-workspace regeneration (DistroSourceTools --make-code-workspace) failed for $workspace" >&2
			failed=1
		else
			local wsFile="$workspace/${workspace##*/}.code-workspace"
			if grep -q 'chat\.agentSkillsLocations' "$wsFile" 2>/dev/null ; then
				echo "🧰 code-workspace regenerated: ${wsFile#$workspace/}" >&2
			else
				echo "⛔ ERROR: code-workspace-check: chat.agentSkillsLocations absent from ${wsFile#$workspace/} -- magic-team members will not be discoverable by the VS Code chat client" >&2
				failed=1
			fi
		fi


		if [ "$failed" -eq 0 ] ; then
			echo "✅ vscode integrations installed" >&2
			return 0
		fi

		echo "⛔ ERROR: vscode integrations incomplete, see the errors above" >&2
		set +e ; return 1
	;;
	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
