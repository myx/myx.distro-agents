#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.ClientAccessRoots.include -- the single source of the client
## access-root set.
##
## ONE place names which absolute filesystem roots a client (a dispatched
## agent CLI running in a workspace) is granted read/write access to. Every
## consumer -- the claude settings writers AND the copilot launch fragment --
## takes whatever this yields, so adding or changing a root is a single edit
## HERE, never a change rippling across the installer, the launcher and the
## awk merge scripts.
##
## The set is deliberately NOT treated as fixed or complete: reference roots
## and member/source derivations can be added or changed over time. Keep the
## pieces below simple and independent so the settings side and the fragment
## side can be refactored in parallel without colliding.
##
## Read and write are separate sets, not one set spelled twice: a member may be
## readable by every client and writable by none. Each producer below says which
## it yields, and a consumer asks for the one its own grant means.
##
## Output contract: each function prints raw absolute paths, one per line,
## with NO formatting, quoting or flags -- the raw material each consumer
## formats its own way (a JSON `Read(...)`/`Edit(...)`/`Write(...)` grant on
## the settings side, an `--add-dir <root>` token on the copilot side).
##
## Dot-sourced (relies on $MDAT_SKILLSET_ROOT / $MDAT_DATA_ROOT already
## resolved by the caller, exactly as the claude settings writers already
## require).
##

## Member skill directories, resolved to their real (symlink-followed) locations
## under the resolved skillset root. Skips `trash`. Sorted-unique.
## Purpose picks the set, and the two differ by exactly one rule:
##   acting   -- excludes a `status: reference-only` member. Nobody may write the
##               identity record, and nobody may be spawned as it.
##   readable -- includes it. The escalation path every session must be able to
##               read lives inside one, so a read grant that skipped it would
##               make the mandated route unreadable.
## Required, never defaulted: a purpose guessed wrong is a silently wrong grant.
##   $1 = acting | readable
AgentsToolsClientAccessRootsMembers(){
	local memberPurpose="$1"
	case "$memberPurpose" in
		acting|readable) : ;;
		*)
			echo "⛔ ERROR: AgentsToolsClientAccessRootsMembers: purpose must be 'acting' or 'readable', got: ${memberPurpose:-<none>}" >&2
			return 1
		;;
	esac
	local skillsRoot="$MDAT_SKILLSET_ROOT"
	[ -d "$skillsRoot" ] || return 0
	local memberEntry memberName memberReal
	for memberEntry in "$skillsRoot"/*/ ; do
		[ -d "${memberEntry%/}" ] || continue
		memberName="$( basename "${memberEntry%/}" )"
		[ "$memberName" != "trash" ] || continue
		memberReal="$( cd "${memberEntry%/}" 2>/dev/null && pwd -P )" || continue
		[ -n "$memberReal" ] || continue
		if [ "$memberPurpose" = "acting" ] && [ -f "$memberReal/SKILL.md" ] && grep -q '^status: reference-only' "$memberReal/SKILL.md" 2>/dev/null ; then
			continue
		fi
		printf '%s\n' "$memberReal"
	done | sort -u
}

## Reference roots by purpose, required and never defaulted -- a purpose
## guessed wrong is a silently wrong grant, same rule as the member split above.
##   read  -- skillset under $MDLT_ORIGIN, the global symlinked skills dir, and
##            the machine's own CLIENT_ACCESS_ROOTS_EXTRA; non-absolute dropped.
##   write -- the team scratchpad, plus the named member's own two scopes;
##            unnamed yields the team's alone, since everyone's own is nobody's.
##   $1 = read | write, $2 = workspace root, $3 = member name (write only)
AgentsToolsClientAccessReferenceRoots(){
	local rootsPurpose="$1" workspace="${2:-$MMDAPP}" memberName="$3"
	case "$rootsPurpose" in
		read|write) : ;;
		*)
			echo "⛔ ERROR: AgentsToolsClientAccessReferenceRoots: purpose must be 'read' or 'write', got: ${rootsPurpose:-<none>}" >&2
			return 1
		;;
	esac
	if [ "$rootsPurpose" = "write" ] ; then
		[ -n "$workspace" ] || return 0
		printf '%s\n' "$workspace/.local/temp/team"
		[ -n "$memberName" ] || return 0
		printf '%s\n' "$workspace/.local/temp/member/$memberName" "$workspace/.local/temp/task/$memberName"
		return 0
	fi
	[ -z "${MDLT_ORIGIN:-}" ] || printf '%s\n' "$MDLT_ORIGIN/myx/myx.distro-agents/skillset"
	printf '%s\n' "$HOME/.claude/skills"
	[ -s "$workspace/.local/.agents/magic-team.agent.env" ] || return 0
	local configuredRoots
	configuredRoots="$( MMDAPP="$workspace" ; DistroAgentsTools --agents-config-option magic-team --select CLIENT_ACCESS_ROOTS_EXTRA || : )"
	[ -n "$configuredRoots" ] || return 0
	printf '%s\n' "$configuredRoots" | LC_ALL=C awk -F: '{ for ( rootIndex = 1 ; rootIndex <= NF ; rootIndex++ ) if ( $rootIndex ~ /^\// ) print $rootIndex ; }'
}

## Declared allow-write grants, each widened to the narrowest directory that
## contains everything its glob can match. A client's whole permission surface
## on the copilot side is `--add-dir <root>`: a glob cannot be expressed there,
## so the containing root is what honours a declared grant at all, and the
## widening is the known and accepted cost of honouring it.
## Read from the permissions registry, which is already every workspace's rows
## unioned and de-duplicated -- so a grant declared in one workspace reaches a
## client started in another, and one member's grant is every member's.
AgentsToolsClientAccessGrantRoots(){
	local registryFile="$HOME/.claude/skills/.linked.magic-team.permissions.txt"
	[ -s "$registryFile" ] || return 0
	## Field 4 is taken whole by offset, never by splitting, so a grant carrying
	## its own colons survives -- the same rule the permissions projection uses.
	LC_ALL=C awk -F: '
		NF >= 4 {
			grantText = substr( $0, length($1) + length($2) + length($3) + 4 )
			if ( grantText !~ /^Edit\(\// ) next
			grantPath = substr( grantText, 6, length( grantText ) - 6 )
			sub( /^\/\//, "/", grantPath )
			rootPath = ""
			segmentCount = split( grantPath, pathSegment, "/" )
			for ( segmentIndex = 2 ; segmentIndex <= segmentCount ; segmentIndex++ ) {
				if ( pathSegment[segmentIndex] ~ /[*?[]/ ) break
				rootPath = rootPath "/" pathSegment[segmentIndex]
			}
			if ( rootPath != "" && !seenRoot[rootPath]++ ) print rootPath ;
		}
	' "$registryFile"
}

## Widens a declared Edit(/path/glob) grant text to the narrowest directory
## containing everything its glob can match -- e.g. Edit(/a/b/**) -> /a/b.
## Shared by the write side (the copilot access-tag sidecar, written by
## AgentsTools.Install.include's workspace-scope grant loop, which already
## has the selector and root in hand) and available to any future reader, so
## a grant is never widened two different ways by two different pieces of
## code. Prints nothing for a non-Edit(/...) grant.
##   $1 = grant text, e.g. "Edit(/foo/bar/**)"
AgentsToolsClientAccessWidenGrantRoot(){
	case "$1" in
		'Edit(/'*) : ;;
		*) return 0 ;;
	esac
	LC_ALL=C awk -v grantText="$1" 'BEGIN {
		grantPath = substr( grantText, 6, length( grantText ) - 6 )
		sub( /^\/\//, "/", grantPath )
		rootPath = ""
		segmentCount = split( grantPath, pathSegment, "/" )
		for ( segmentIndex = 2 ; segmentIndex <= segmentCount ; segmentIndex++ ) {
			if ( pathSegment[segmentIndex] ~ /[*?[]/ ) break
			rootPath = rootPath "/" pathSegment[segmentIndex]
		}
		if ( rootPath != "" ) print rootPath
	}'
}

## Reads a root's provenance tag (own/explicit/wildcard) for the copilot
## access fragment. own-workspace and explicit-name grant roots are safe to
## create at install time; a wildcard-swept root (matched only because a
## workspace:* selector walked the ENTIRE workspace registry, not because
## anything named it) is never created -- only live-checked at spawn time,
## since the registry can list a workspace that was never a real tooling
## install (see MAGIC.md's "Scratch and temp paths" section). Prints nothing
## if untagged -- the caller decides the default, since a non-grant root
## (board/member/source/reference) and a grant root with no recorded tag
## default differently.
##   $1 = the widened root path to look up.
AgentsToolsClientAccessRootTag(){
	local tagsFile="$HOME/.claude/skills/.linked.magic-team.permissions-tags.txt"
	[ -s "$tagsFile" ] || return 0
	## Field 4 taken whole by offset, same discipline as the main registry --
	## a colon inside a path must never be read as a field separator.
	LC_ALL=C awk -F: -v wantRoot="$1" '
		NF >= 4 {
			rowRoot = substr( $0, length($1) + length($2) + length($3) + 4 )
			if ( rowRoot == wantRoot ) { print $3 ; exit }
		}
	' "$tagsFile"
}

## The complete flat root set one client is granted, one absolute path per line:
## readable member dirs, the workspace source tree, both reference sets and the
## declared grants. `--add-dir` carries no verb, so read and write arrive here
## as one union -- the vendor CLIs' own limit, not this model's; a client that
## can be told a verb asks the two producers above for the half it means.
## The board is absent by design; the CALLER rejects an empty set.
##   $1 = workspace root, $2 = member name, for its own scratchpads
AgentsToolsClientAccessRoots(){
	local workspace="$1" memberName="$2"
	## Sorted-unique: the declared grants re-derive roots the functions above
	## already yield, and a repeated root is a duplicate `--add-dir`.
	{
		AgentsToolsClientAccessRootsMembers readable
		if [ -n "$workspace" ] ; then
			printf '%s\n' "$workspace/source"
		fi
		AgentsToolsClientAccessReferenceRoots read "$workspace"
		AgentsToolsClientAccessReferenceRoots write "$workspace" "$memberName"
		AgentsToolsClientAccessGrantRoots
	} | LC_ALL=C sort -u
}
