#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.ClientAccessRoots.include -- the single source of the client
## access-root set.
##
## ONE place names which absolute filesystem roots a client (a dispatched
## agent CLI running in a workspace) is granted read/write access to. Every
## consumer -- the claude settings writers AND the copilot launch fragment --
## takes whatever this yields, so adding or changing a root is a single edit
## HERE, never a change rippling across the installer, the launcher and the
## awk merge scripts.
##
## The set is deliberately NOT treated as fixed or complete: reference roots
## and member/source derivations can be added or changed over time. Keep the
## pieces below simple and independent so the settings side and the fragment
## side can be refactored in parallel without colliding.
##
## Read and write are separate sets, not one set spelled twice: a member may be
## readable by every client and writable by none. Each producer below says which
## it yields, and a consumer asks for the one its own grant means.
##
## Output contract: each function prints raw absolute paths, one per line,
## with NO formatting, quoting or flags -- the raw material each consumer
## formats its own way (a JSON `Read(...)`/`Edit(...)`/`Write(...)` grant on
## the settings side, an `--add-dir <root>` token on the copilot side).
##
## Dot-sourced (relies on $MDAT_SKILLSET_ROOT / $MDAT_DATA_ROOT already
## resolved by the caller, exactly as the claude settings writers already
## require).
##

## Member skill directories, resolved to their real (symlink-followed) locations
## under the resolved skillset root -- the member index's members/ view
## (AgentsTools.TeamRegistry.include), which holds this workspace's own members only:
## a member of another workspace is granted by its own workspace. Never a vendor link folder. Skips
## `trash`. Sorted-unique.
## Purpose picks the set, and the two differ by exactly one rule:
##   acting   -- excludes a `status: reference-only` member. Nobody may write the
##               identity record, and nobody may be spawned as it.
##   readable -- includes it. The escalation path every session must be able to
##               read lives inside one, so a read grant that skipped it would
##               make the mandated route unreadable.
## Required, never defaulted: a purpose guessed wrong is a silently wrong grant.
##   $1 = acting | readable
AgentsToolsClientAccessRootsMembers(){
	local memberPurpose="$1"
	case "$memberPurpose" in
		acting|readable) : ;;
		*)
			echo "⛔ ERROR: AgentsToolsClientAccessRootsMembers: purpose must be 'acting' or 'readable', got: ${memberPurpose:-<none>}" >&2
			return 1
		;;
	esac
	set --
	[ -z "${MDAT_SKILLSET_ROOT:-}" ] || [ ! -d "$MDAT_SKILLSET_ROOT" ] || set -- "$MDAT_SKILLSET_ROOT"/*/
	local memberEntry memberName memberReal
	for memberEntry in "$@" ; do
		[ -d "${memberEntry%/}" ] || continue
		memberName="${memberEntry%/}" ; memberName="${memberName##*/}"
		[ "$memberName" != "trash" ] || continue
		memberReal="$( cd "${memberEntry%/}" 2>/dev/null && pwd -P )" || continue
		[ -n "$memberReal" ] || continue
		if [ "$memberPurpose" = "acting" ] && [ -f "$memberReal/SKILL.md" ] && grep -q '^status: reference-only' "$memberReal/SKILL.md" 2>/dev/null ; then
			continue
		fi
		printf '%s\n' "$memberReal"
	done | sort -u
}

## Reference roots by purpose, required and never defaulted -- a purpose
## guessed wrong is a silently wrong grant, same rule as the member split above.
##   read  -- skillset under $MDLT_ORIGIN, and the global symlinked skills dir.
##   write -- the team scratchpad, plus the named member's own two scopes;
##            unnamed yields the team's alone, since everyone's own is nobody's.
##   $1 = read | write, $2 = workspace root, $3 = member name (write only)
AgentsToolsClientAccessReferenceRoots(){
	local rootsPurpose="$1" workspace="${2:-$MMDAPP}" memberName="$3"
	case "$rootsPurpose" in
		read|write) : ;;
		*)
			echo "⛔ ERROR: AgentsToolsClientAccessReferenceRoots: purpose must be 'read' or 'write', got: ${rootsPurpose:-<none>}" >&2
			return 1
		;;
	esac
	if [ "$rootsPurpose" = "write" ] ; then
		[ -n "$workspace" ] || return 0
		printf '%s\n' "$workspace/.local/temp/team"
		[ -n "$memberName" ] || return 0
		printf '%s\n' "$workspace/.local/temp/member/$memberName" "$workspace/.local/temp/task/$memberName"
		return 0
	fi
	## Places outside these are registered places with grants on them
	## (AgentsTools.Places.include, AgentsTools.Grants.include), never a configured list.
	[ -z "${MDLT_ORIGIN:-}" ] || printf '%s\n' "$MDLT_ORIGIN/myx/myx.distro-agents/skillset"
	printf '%s\n' "$HOME/.claude/skills"
	return 0
}

## Declared allow-write grants (Edit rows), each widened to the narrowest directory that
## contains everything its glob can match. A client's whole permission surface
## on the copilot side is `--add-dir <root>`: a glob cannot be expressed there,
## so the containing root is what honours a declared grant at all, and the
## widening is the known and accepted cost of honouring it.
## Read from every workspace's own permissions registry, this workspace's first and
## then each one the shared pointers name (AgentsToolsTeamGrantRows) -- so a grant
## declared in one workspace reaches a client started in another.
## With a member named, only that member's own rows and every row declared for `*`, which
## names every member: what our harness writes with is that member's layers, never the union. With none (a client acting as no member, and
## the native clients' settings, which carry no member), every member's rows.
## Edit(...) rows only: a declared allow-read is a Read(...) row and never a write root.
##   $1 = member name (optional)
AgentsToolsClientAccessGrantRoots(){
	AgentsToolsClientAccessGrantRootsOf Edit "${1:-}"
}

## Declared allow-read grants, Read(...) rows, widened the same way -- read roots only,
## joining the read union (AgentsToolsClientAccessRoots) and never a write set.
##   $1 = member name (optional)
AgentsToolsClientAccessReadGrantRoots(){
	AgentsToolsClientAccessGrantRootsOf Read "${1:-}"
}

## The one reader and widener of both: the rows whose grant is <verb>(/...).
##   $1 = Edit | Read, $2 = member name (optional)
AgentsToolsClientAccessGrantRootsOf(){
	type AgentsToolsTeamGrantRows >/dev/null 2>&1 || . "${harnessHere:-$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib}/AgentsTools.TeamRegistry.include" || return 1
	## Field 4 is taken whole by offset, never by splitting, so a grant carrying
	## its own colons survives -- the same rule the permissions projection uses.
	AgentsToolsTeamGrantRows "${MMDAPP:-}" permissions.registry | LC_ALL=C awk -F: -v grantVerb="$1" -v wantMember="${2:-}" '
		NF >= 4 && ( wantMember == "" || $1 == wantMember || $1 == "*" ) {
			grantText = substr( $0, length($1) + length($2) + length($3) + 4 )
			if ( index( grantText, grantVerb "(/" ) != 1 ) next
			grantPath = substr( grantText, length( grantVerb ) + 2, length( grantText ) - length( grantVerb ) - 2 )
			sub( /^\/\//, "/", grantPath )
			rootPath = ""
			segmentCount = split( grantPath, pathSegment, "/" )
			for ( segmentIndex = 2 ; segmentIndex <= segmentCount ; segmentIndex++ ) {
				if ( pathSegment[segmentIndex] ~ /[*?[]/ ) break
				rootPath = rootPath "/" pathSegment[segmentIndex]
			}
			if ( rootPath != "" && !seenRoot[rootPath]++ ) print rootPath ;
		}
	'
}

## Widens a declared Edit(/path/glob) grant text to the narrowest directory
## containing everything its glob can match -- e.g. Edit(/a/b/**) -> /a/b.
## Shared by the write side (the copilot access-tag sidecar, written by
## AgentsTools.Install.include's workspace-scope grant loop, which already
## has the selector and root in hand) and available to any future reader, so
## a grant is never widened two different ways by two different pieces of
## code. A declared allow-read's Read(/...) is widened alike -- the two verbs are
## the same length, so one offset serves both. Prints nothing for any other grant.
##   $1 = grant text, e.g. "Edit(/foo/bar/**)"
AgentsToolsClientAccessWidenGrantRoot(){
	case "$1" in
		'Edit(/'*|'Read(/'*) : ;;
		*) return 0 ;;
	esac
	LC_ALL=C awk -v grantText="$1" 'BEGIN {
		grantPath = substr( grantText, 6, length( grantText ) - 6 )
		sub( /^\/\//, "/", grantPath )
		rootPath = ""
		segmentCount = split( grantPath, pathSegment, "/" )
		for ( segmentIndex = 2 ; segmentIndex <= segmentCount ; segmentIndex++ ) {
			if ( pathSegment[segmentIndex] ~ /[*?[]/ ) break
			rootPath = rootPath "/" pathSegment[segmentIndex]
		}
		if ( rootPath != "" ) print rootPath
	}'
}

## Reads a root's provenance tag (own/explicit/wildcard) for the copilot
## access fragment. own-workspace and explicit-name grant roots are safe to
## create at install time; a wildcard-swept root (matched only because a
## workspace:* selector walked the ENTIRE workspace registry, not because
## anything named it) is never created -- only live-checked at spawn time,
## since the registry can list a workspace that was never a real tooling
## install (see MAGIC.md's "Scratch and temp paths" section). Prints nothing
## if untagged -- the caller decides the default, since a non-grant root
## (board/member/source/reference) and a grant root with no recorded tag
## default differently.
##   $1 = the widened root path to look up.
AgentsToolsClientAccessRootTag(){
	type AgentsToolsTeamGrantRows >/dev/null 2>&1 || . "${harnessHere:-$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib}/AgentsTools.TeamRegistry.include" || return 1
	## Field 4 taken whole by offset, same discipline as the main registry --
	## a colon inside a path must never be read as a field separator.
	AgentsToolsTeamGrantRows "${MMDAPP:-}" permissions-tags.registry | LC_ALL=C awk -F: -v wantRoot="$1" '
		NF >= 4 {
			rowRoot = substr( $0, length($1) + length($2) + length($3) + 4 )
			if ( rowRoot == wantRoot ) { print $3 ; exit ; }
		}
	'
}

## The complete flat root set one client is granted, one absolute path per line:
## readable member dirs, the workspace source tree, both reference sets and the
## declared grants, allow-write and allow-read. `--add-dir` carries no verb, so read and write arrive here
## as one union -- the vendor CLIs' own limit, not this model's; a client that
## can be told a verb asks the two producers above for the half it means.
## The board is absent by design; the CALLER rejects an empty set.
## A producer that fails fails the whole set, rc 1 with its own message on stderr:
## a short set at rc 0 is indistinguishable from a complete one.
## With a grant member named, the declared grants are that member's own rows and every `*` row: the
## set is then the roots that one member may read, widened -- its read floor's roots plus its
## own Edit and Read rows -- for a client that takes roots; the harness decides a named
## member's file tools by its session permission index instead (AgentsTools.Grants.include).
## Unnamed, every member's, as before.
##   $1 = workspace root, $2 = member name, for its own scratchpads,
##   $3 = grant member (optional)
AgentsToolsClientAccessRoots(){
	local workspace="$1" memberName="$2" grantMember="${3:-}" accessRoots
	accessRoots="$( AgentsToolsClientAccessRootsMembers readable )" || return 1
	[ -z "$workspace" ] || accessRoots="$accessRoots"$'\n'"$workspace/source"
	accessRoots="$accessRoots"$'\n'"$( AgentsToolsClientAccessReferenceRoots read "$workspace" )" || return 1
	accessRoots="$accessRoots"$'\n'"$( AgentsToolsClientAccessReferenceRoots write "$workspace" "$memberName" )" || return 1
	accessRoots="$accessRoots"$'\n'"$( AgentsToolsClientAccessGrantRoots "$grantMember" )" || return 1
	accessRoots="$accessRoots"$'\n'"$( AgentsToolsClientAccessReadGrantRoots "$grantMember" )" || return 1
	## Sorted-unique: the declared grants re-derive roots the functions above
	## already yield, and a repeated root is a duplicate `--add-dir`.
	printf '%s\n' "$accessRoots" | LC_ALL=C sort -u | LC_ALL=C awk 'NF'
}

## The roots one member is granted, read off the finished grants index (AgentsTools.Grants.include),
## one absolute path per line, sorted-unique: each of its floor and standing read and write rows
## that names a whole directory, `<dir>/**`, and this origin's skillset, which every session index
## adds to the floor. A row whose glob holds a wildcard before that end (`source/**/MAGIC.md`,
## `source/**/sh-test/**`, `docs/*.md`) is no root: widened it would be its whole literal base, all
## of source/ for the floor, so it stays with the decision made at each call (the harness gate, a
## client hook). Never the union of every member, and never all of source/ unless granted.
## Purpose picks the set, required and never defaulted:
##   read      every root it may read or write: its read rows and its write rows, a read-only
##             place included -- also the set for a flag that carries no verb (--add-dir)
##   write     its write rows only, which the index already caps to read in a read-only place
## A stale or missing index is rebuilt first; rc 1, said on stderr, when none can be had.
##   $1 = workspace root, $2 = member name, $3 = read | write
AgentsToolsClientAccessMemberRoots(){
	local memberWs="${1%/}" memberName="$2" memberPurpose="$3" memberWho memberVerb memberGlob memberPattern memberRest
	local memberBase memberRoots="" memberOrigin
	case "$memberPurpose" in
		read|write) : ;;
		*)
			echo "⛔ ERROR: AgentsToolsClientAccessMemberRoots: purpose must be 'read' or 'write', got: ${memberPurpose:-<none>}" >&2
			return 1
		;;
	esac
	if [ -z "$memberWs" ] || [ -z "$memberName" ] ; then
		echo "⛔ ERROR: AgentsToolsClientAccessMemberRoots: a workspace and a member are both required" >&2
		return 1
	fi
	type AgentsToolsGrantsIndexEnsure >/dev/null 2>&1 || . "${harnessHere:-$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib}/AgentsTools.Grants.include" || return 1
	if ! AgentsToolsGrantsIndexEnsure "$memberWs" ; then
		echo "⛔ ERROR: AgentsToolsClientAccessMemberRoots: no grants index could be read or built for $memberWs" >&2
		return 1
	fi
	while IFS=$'\t' read -r memberWho memberVerb memberGlob memberPattern memberRest ; do
		[ "$memberWho" = "$memberName" ] || continue
		case "$memberVerb" in
			write) : ;;
			read) [ "$memberPurpose" != write ] || continue ;;
			*) continue ;;
		esac
		case "$memberGlob" in
			/?*/'**') memberBase="${memberGlob%/\*\*}" ;;
			*) continue ;;
		esac
		case "$memberBase" in *'*'*|*'?'*|*'['*) continue ;; esac
		memberRoots="$memberRoots$memberBase"$'\n'
	done < <( if [ -n "$agentsGrantsIndexFile" ] ; then cat "$agentsGrantsIndexFile" ; else printf '%s\n' "$agentsGrantsIndexText" ; fi )
	if [ "$memberPurpose" != write ] && [ -n "${MDLT_ORIGIN:-}" ] ; then
		memberOrigin="$( cd "$MDLT_ORIGIN/myx/myx.distro-agents/skillset" 2>/dev/null && pwd -P )" || memberOrigin=""
		[ -z "$memberOrigin" ] || memberRoots="$memberRoots$memberOrigin"$'\n'
	fi
	printf '%s' "$memberRoots" | LC_ALL=C sort -u | LC_ALL=C awk 'NF'
}
