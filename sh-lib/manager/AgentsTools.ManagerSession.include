#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.ManagerSession.include -- the --manager-session-* operations of the console: the `case` that
## sources each operation file with the operation's arguments. Sourced from the `--manager-session-*)` arm of
## AgentsTools.Manager.include; who may call was asked where the family is dispatched. The functions the
## operations call live in AgentsTools.ManagerSessionRows.include, ManagerSessionKill, ManagerRunActivity and ManagerConsoleIdentity, which an operation loads as it needs them.
##

case "$1" in

	--manager-session-list)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/manager/AgentsTools.OpManagerSessionList.include"
	;;

	--manager-session-read)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/manager/AgentsTools.OpManagerSessionRead.include"
	;;

	--manager-session-transcript-read)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/manager/AgentsTools.OpManagerSessionTranscriptRead.include"
	;;

	--manager-session-checklist-read)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/manager/AgentsTools.OpManagerSessionChecklistRead.include"
	;;

	--manager-session-kill)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/manager/AgentsTools.OpManagerSessionKill.include"
	;;

	--manager-session-effort)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/manager/AgentsTools.OpManagerSessionEffort.include"
	;;

	--manager-session-stop)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/manager/AgentsTools.OpManagerSessionStop.include"
	;;

	--manager-session-restart)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/manager/AgentsTools.OpManagerSessionRestart.include"
	;;

	--manager-session-pause|--manager-session-resume)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/manager/AgentsTools.OpManagerSessionResume.include"
	;;

	--manager-session-control-start)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/manager/AgentsTools.OpManagerSessionControlStart.include"
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
