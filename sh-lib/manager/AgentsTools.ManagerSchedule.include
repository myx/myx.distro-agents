#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.ManagerSchedule.include -- the --manager-schedule-* operations: the console's own view of the
## scheduler's flags, and the console's own way to set them. Sourced from the `--manager-schedule-*)` arm of AgentsTools.Manager.include; who may call
## was asked where the family is dispatched.
##
## The flags are derived, never stored (AgentsTools.DispatcherSchedule.include); the read below takes them from that file's own functions and computes
## no flag a second way. The write arms hold no rule of their own either: each hands its words to the dispatcher's own function, so a value that
## function refuses is refused here, and nothing is stored.
##

type AgentsToolsScheduleCurrentFlags > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.DispatcherSchedule.include"

case "$1" in

	## Prints rows of TAB-separated fields, the first naming the row:
	##   now     <epoch> <weekday> <HH:MM> <timezone, or `host`>
	##   flag    <name> <yes|no> <note, or ->            the eight flags now, in the order of --current-flags, holding among them:
	##                                                   a hold the screen did not show was one nobody saw or cleared there
	##   switch  <seconds|-> <what>                      the nearest change of a flag that is planned or has a TTL: worktime-starts,
	##                                                   worktime-ends, or <flag>-ends; `-` and `none` where nothing is planned
	##   cell    <weekday> <hour 00-23> <flags, or ->    one row for each weekday (mon..sun) and hour, 168 rows
	--manager-schedule-read)
		local scheduleOp="$1" scheduleEpoch scheduleOffset scheduleDay scheduleSeconds scheduleName scheduleFlag scheduleLine scheduleZone
		local scheduleWork scheduleWeekend scheduleStart scheduleUntil scheduleDays scheduleNext scheduleWhat="none" scheduleLeft scheduleOverride scheduleKey scheduleMember scheduleDir scheduleMemberFlag scheduleMemberLeft
		if [ $# -gt 1 ] ; then
			echo "⛔ ERROR: $MDSC_CMD $scheduleOp: takes no argument, got: $2" >&2
			set +e ; return 1
		fi
		AgentsToolsScheduleTools || { set +e ; return 1 ; }
		read -r scheduleEpoch scheduleOffset scheduleDay scheduleSeconds <<< "$( AgentsToolsScheduleClock )"
		scheduleName="$( AgentsToolsScheduleDayName "$scheduleDay" )"
		scheduleZone="$( AgentsToolsScheduleSetting MDAT_SCHEDULE_TIMEZONE )"
		printf 'now\t%s\t%s\t%02d:%02d\t%s\n' "$scheduleEpoch" "$scheduleName" "$(( scheduleSeconds / 3600 ))" "$(( scheduleSeconds % 3600 / 60 ))" "${scheduleZone:-host}"
		for scheduleFlag in worktime weekend holidays holding emergency overtime learning supervised ; do
			scheduleLine="$( AgentsToolsScheduleFlagLine "$scheduleFlag" "$scheduleName" "$scheduleSeconds" "$scheduleEpoch" )"
			scheduleLine="${scheduleLine#*: }"
			case "$scheduleLine" in
				"yes "*|"no "*) printf 'flag\t%s\t%s\t%s\n' "$scheduleFlag" "${scheduleLine%% *}" "${scheduleLine#* }" ;;
				*) printf 'flag\t%s\t%s\t-\n' "$scheduleFlag" "$scheduleLine" ;;
			esac
		done
		## THE MEMBERS' OWN FLAGS (AgentsToolsScheduleMemberFlag): the entry row of vacation, which is set for one member, and a row `<flag>:<member>` for each member whose
		## vacation or overtime holds now, so a person sees who is on one and clears it from its own row.
		type AgentsToolsTeamMemberDirectoryText > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.TeamRegistry.include" 2> /dev/null || :
		printf 'flag\tvacation\tper member\t-\n'
		while IFS=$'\t' read -r scheduleMember scheduleDir ; do
			[ -n "$scheduleDir" ] || continue
			case "$scheduleMember" in human-owner|magic-team) continue ;; esac
			for scheduleMemberFlag in vacation overtime ; do
				scheduleMemberLeft="$( AgentsToolsScheduleMemberFlag "$scheduleMemberFlag" "$scheduleMember" "$scheduleEpoch" )"
				case "$scheduleMemberLeft" in
					'') ;;
					on) printf 'flag\t%s:%s\tyes\t-\n' "$scheduleMemberFlag" "$scheduleMember" ;;
					*) printf 'flag\t%s:%s\tyes\t(%s seconds left)\n' "$scheduleMemberFlag" "$scheduleMember" "$scheduleMemberLeft" ;;
				esac
			done
		done <<< "$( AgentsToolsTeamMemberDirectoryText 2> /dev/null )"
		scheduleWork="$( AgentsToolsScheduleValue MDAT_SCHEDULE_WORKTIME )" || :
		scheduleWeekend="$( AgentsToolsScheduleValue MDAT_SCHEDULE_WEEKEND )" || :
		## The nearest change: worktime's next boundary and the end of each override that has a TTL.
		scheduleNext=""
		read -r scheduleStart scheduleUntil scheduleDays <<< "$scheduleWork"
		if [ "$( AgentsToolsScheduleWorktime "$scheduleName" "$scheduleSeconds" "$scheduleEpoch" )" = "yes" ] && scheduleLeft="$( AgentsToolsScheduleTimeSeconds "$scheduleUntil" )" ; then
			scheduleNext=$(( scheduleLeft - scheduleSeconds )) ; scheduleWhat="worktime-ends"
		else
			scheduleLeft="$( AgentsToolsScheduleNextWorkStart "$scheduleEpoch" "$scheduleOffset" )"
			[ -z "$scheduleLeft" ] || { scheduleNext=$(( scheduleLeft - scheduleEpoch )) ; scheduleWhat="worktime-starts" ; }
		fi
		for scheduleKey in holidays emergency overtime ; do
			scheduleOverride="$( AgentsToolsScheduleOverrideLeft "MDAT_SCHEDULE_$( printf '%s' "$scheduleKey" | LC_ALL=C tr 'a-z' 'A-Z' )" "$scheduleEpoch" )"
			case "$scheduleOverride" in
				''|on) ;;
				*) if [ -z "$scheduleNext" ] || [ "$scheduleOverride" -lt "$scheduleNext" ] ; then scheduleNext="$scheduleOverride" ; scheduleWhat="$scheduleKey-ends" ; fi ;;
			esac
		done
		printf 'switch\t%s\t%s\n' "${scheduleNext:--}" "$scheduleWhat"
		SCH_WORKTIME="$scheduleWork" SCH_WEEKEND="$scheduleWeekend" SCH_EPOCH="$scheduleEpoch" SCH_OFFSET="$scheduleOffset" SCH_TODAY="$scheduleDay" \
			SCH_HOLIDAYS="$( AgentsToolsScheduleSetting MDAT_SCHEDULE_HOLIDAYS )" SCH_EMERGENCY="$( AgentsToolsScheduleSetting MDAT_SCHEDULE_EMERGENCY )" \
			SCH_OVERTIME="$( AgentsToolsScheduleSetting MDAT_SCHEDULE_OVERTIME )" SCH_LEARNING="$( AgentsToolsScheduleSetting MDAT_SCHEDULE_LEARNING )" \
			SCH_SUPERVISED="$( AgentsToolsScheduleSetting MDAT_SCHEDULE_SUPERVISED )" \
			LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/manager/AgentsManagerScheduleGrid.awk" < /dev/null
		return 0
	;;

	## An override of a flag, and the two settings a person sets: each is the dispatcher's own function, and it prints the flag's line as the read gives it.
	--manager-schedule-override-flag)
		local scheduleOverrideOp="$1"
		shift
		AgentsToolsScheduleTools || { set +e ; return 1 ; }
		AgentsToolsScheduleOverride "$scheduleOverrideOp" "$@"
		return $?
	;;

	--manager-schedule-set-worktime)
		shift
		AgentsToolsScheduleTools || { set +e ; return 1 ; }
		AgentsToolsScheduleSet --set-worktime "$@"
		return $?
	;;

	--manager-schedule-set-weekend)
		shift
		AgentsToolsScheduleTools || { set +e ; return 1 ; }
		AgentsToolsScheduleSet --set-weekend "$@"
		return $?
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
