#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.ManagerScopeAgents.include -- what the agents register for `Scope Settings` (F11.7), the console view of `.local` (sh-lib/config/scope-settings.list).
## It names the scopes of the agents (each member's, the team's, each routine's and each preset's), the keys the console knows of a preset and of the tiers, and how a credential is printed.
## It is for viewing and for the writes of the setting reader: nothing else is written here.
##

type AgentsToolsTeamMemberDirectory > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.TeamRegistry.include"
type AgentsToolsPresetCredentialKeys > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/config/AgentsTools.Preset.include"
type AgentsToolsCredentialShown > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/config/AgentsTools.CredentialDisplay.include"
type AgentsToolsManagerConfigKeySecret > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/manager/AgentsTools.ManagerConfig.include" --definitions-only > /dev/null 2>&1 || :
type LocalToolsManagerScopeNameOk > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/manager/LocalTools.ManagerScope.include" --definitions-only > /dev/null 2>&1 || :

## The scopes of the agents, one a line as `.local` lists them: the id, `Agents`, the name, the file, and that it may be deleted.
AgentsToolsManagerScopeAgentsSources(){
	local sourceFile sourceName
	for sourceFile in "${MMDAPP%/}/.local/.agents"/*.agent.env ; do
		[ -f "$sourceFile" ] || continue
		sourceName="${sourceFile##*/}" ; sourceName="${sourceName%.agent.env}"
		LocalToolsManagerScopeNameOk "$sourceName" || continue
		printf 'agents:%s\tAgents\t%s\t%s\tyes\n' "$sourceName" "$sourceName" "$sourceFile"
	done
	return 0
}

## The read and the write of a scope of the agents: a write through the dispatcher, whose write checks (a preset's, the tiers') it must pass.
AgentsToolsManagerScopeAgentsCall(){ ## `read` or `write`, then the reader's arguments
	local callHow="$1" ; shift
	if [ "$callHow" = write ] ; then
		DistroAgentsTools --agents-config-option "$scopeName" "$@"
	else
		( set -- --agents-config-option "$scopeName" "$@" ; . "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/LocalTools.Config.include" )
	fi
}

## A member of the team that holds no file of settings yet is a scope all the same, for its tiers (F10.2): it is not listed, and the first key written makes its file.
AgentsToolsManagerScopeAgentsUnlisted(){ ## id
	local unlistedName="${1#agents:}"
	if [ "$unlistedName" != "magic-team" ] && LocalToolsManagerScopeNameOk "$unlistedName" && AgentsToolsTeamMemberDirectory "$unlistedName" > /dev/null 2>&1 ; then
		printf '%s\tAgents\t%s\t%s\tno\n' "$1" "$unlistedName" "${MMDAPP%/}/.local/.agents/$unlistedName.agent.env"
	fi
	return 0
}

## A scope of the agents made, empty: its file in the agents' folder, with the mode the others have.
AgentsToolsManagerScopeAgentsCreate(){ ## name of the scope
	LocalToolsManagerScopeNameOk "$1" || return 1
	mkdir -p "${MMDAPP%/}/.local/.agents" || return 1
	( umask 007 ; : > "${MMDAPP%/}/.local/.agents/$1.agent.env" ) || return 1
	return 0
}

## Who keeps a preset from being deleted: the presets that extend it, and the tiers that name it. Nothing for any other scope of the agents.
AgentsToolsManagerScopeAgentsGuard(){ ## name of the scope
	case "$1" in
		preset-*) AgentsToolsPresetUsers "${1#preset-}" ;;
	esac
	return 0
}

## THE KEYS OF A SCOPE OF THE AGENTS THAT THE CONSOLE KNOWS (F10.1, F10.2, F11.7): what a preset takes and what a tier takes, so a variable is edited by its kind.
## One line a key, TAB-separated: the key, its kind (`choice`, `number`, `text` or `locked`), what it takes, and its description.
## What it takes is `<value>=<label>,...` for a choice, `<smallest>..<largest>` for a number, `-` for a text, and the reason for a locked one.
## The lists are the preset include's own (AgentsTools.Preset.include): the CLI services, the efforts, the input cache lifetimes, the credentials of the service.
## A preset takes the parameters of a preset; the team's and a member's scope take the three tiers, each `<preset>[:<effort>]`, chosen from the presets this workspace holds.
## No value holds a blank, a `,`, a `=` or a `|`.
AgentsToolsManagerScopeAgentsKnown(){ ## the name of the scope of the agents
	local knownName="$1" knownFile knownOne knownList="" knownEfforts="" knownService="" knownKey knownEffort knownPreset
	case "$knownName" in
		preset-*)
			for knownFile in "${MMDAPP%/}/.local/.agents"/preset-*.agent.env ; do
				[ -f "$knownFile" ] || continue
				knownOne="${knownFile##*/preset-}" ; knownOne="${knownOne%.agent.env}"
				[ "preset-$knownOne" = "$knownName" ] || knownList="$knownList${knownList:+,}$knownOne=$knownOne"
			done
			if [ -n "$knownList" ] ; then
				printf 'PRESET_EXTEND\tchoice\t%s\tThe_preset_whose_parameters_this_one_inherits.\n' "$knownList"
			else
				printf 'PRESET_EXTEND\tlocked\tthere_is_no_other_preset_to_extend\tThe_preset_whose_parameters_this_one_inherits.\n'
			fi
			knownList=""
			for knownOne in $agentsPresetCliServices ; do knownList="$knownList${knownList:+,}$knownOne=$knownOne" ; done
			if [ -n "$( AgentsToolsPresetRead "$MMDAPP" "$knownName" PRESET_EXTEND )" ] ; then
				printf 'PRESET_CLI_SERVICE\tlocked\tit_extends_a_preset:_the_CLI_service_is_the_parents,_and_cannot_be_edited\tThe_CLI_service_of_the_preset.\n'
			else
				printf 'PRESET_CLI_SERVICE\tchoice\t%s\tThe_CLI_service_of_a_preset_that_extends_none.\n' "$knownList"
			fi
			## The endpoint is inherited by every preset that extends, and the service's own
			## wherever its leg states one. Neither is a choice the form offers: those rows are
			## locked, and a preset that must point elsewhere is edited by hand. Only a service
			## with no endpoint of its own (universal) takes one, in its own form.
			knownParent="$( AgentsToolsPresetRead "$MMDAPP" "$knownName" PRESET_EXTEND )"
			knownService=""
			[ -z "$( AgentsToolsPresetRead "$MMDAPP" "$knownName" PRESET_EXTEND )" ] || knownService="$( AgentsToolsPresetEffective "$MMDAPP" "${knownName#preset-}" PRESET_CLI_SERVICE 2> /dev/null )" || knownService=""
			[ -n "$knownService" ] || knownService="$( AgentsToolsPresetRead "$MMDAPP" "$knownName" PRESET_CLI_SERVICE )"
			knownList=""
			for knownFile in "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/"Agents*Harness.sh ; do
				[ -f "$knownFile" ] || continue
				knownOne="${knownFile##*/Agents}" ; knownOne="${knownOne%Harness.sh}"
				knownOne="$( printf '%s' "$knownOne" | LC_ALL=C tr 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' 'abcdefghijklmnopqrstuvwxyz' )"
				[ "$knownOne" = "$knownService" ] || continue
				knownList="$( LC_ALL=C sed -n 's/^HARNESS_ENDPOINT="\([^"]*\)".*/\1/p' "$knownFile" 2> /dev/null )"
				## An endpoint the leg takes from the environment is the preset's to give, not the service's own.
				case "$knownList" in '$'*) knownList="" ;; esac
				break
			done
			if [ -n "$knownParent" ] ; then
				printf 'PRESET_ENDPOINT_URL\tlocked\tit_extends_%s:_the_endpoint_is_inherited,_and_edited_by_hand_where_it_must_differ\tThe_endpoint_of_the_service.\n' "$knownParent"
			elif [ -n "$knownList" ] ; then
				printf 'PRESET_ENDPOINT_URL\tlocked\t%s_states_its_own_endpoint,_so_the_form_does_not_offer_one._Edited_by_hand_where_it_must_differ.\tThe_endpoint_of_the_service.\n' "$knownService"
			else
				printf 'PRESET_ENDPOINT_URL\ttext\t-\tThe_endpoint_this_service_is_reached_at,_https_only._Unset_leaves_it_to_the_service.\n'
			fi
			printf 'PRESET_MODEL_OR_MACRO\ttext\t-\tThe_model,_or_a_macro:_%s.\n' "$( printf '%s' "$agentsPresetMacros" | LC_ALL=C tr ' ' ',' )"
			## The effort a person is offered is the one list agentsPresetEfforts, in its order: unset is the service's
			## own default. A value already held is shown as it is, an older name (default, hard) among them.
			knownList=""
			for knownOne in $agentsPresetEfforts ; do knownList="$knownList${knownList:+,}$knownOne=$knownOne" ; done
			printf 'PRESET_EFFORT\tchoice\t%s\tThe_effort,_optional.\n' "$knownList"
			knownList=""
			for knownOne in $agentsPresetCacheTimes ; do knownList="$knownList${knownList:+,}$knownOne=$knownOne" ; done
			printf 'PRESET_INPUT_CACHE_TIME\tchoice\t%s\tHow_long_the_input_cache_of_a_spawn_lives.\n' "$knownList"
			printf 'PRESET_CONTEXT_MAX_SIZE\tnumber\t1000..10000000\tThe_restart_threshold,_in_tokens:_a_run_that_reaches_it_summarises_and_starts_again._Unset_uses_the_service_window_less_its_output_maximum.\n'
			printf 'PRESET_EXTRA_SPAWN_LINE\ttext\t-\tA_line_the_owner_adds_to_every_dispatch_of_this_preset.\n'
			if [ -z "$( AgentsToolsPresetRead "$MMDAPP" "$knownName" PRESET_EXTEND )" ] ; then
				knownService="$( AgentsToolsPresetRead "$MMDAPP" "$knownName" PRESET_CLI_SERVICE )"
				for knownKey in $( AgentsToolsPresetCredentialKeys "$knownService" ) ; do
					printf '%s\ttext\t-\tA_credential_of_%s.\n' "$knownKey" "$knownService"
				done
			fi
		;;
		*)
			## the tiers: of the team, and optionally of a member; the scope of anything else holds none
			case "$knownName" in magic-team) ;; *) AgentsToolsTeamMemberDirectory "$knownName" > /dev/null 2>&1 || return 0 ;; esac
			for knownFile in "${MMDAPP%/}/.local/.agents"/preset-*.agent.env ; do
				[ -f "$knownFile" ] || continue
				knownPreset="${knownFile##*/preset-}" ; knownPreset="${knownPreset%.agent.env}"
				knownList="$knownList${knownList:+,}$knownPreset"
			done
			## The kind `tier`: two selectors, the preset and the effort. Its values are the presets, a slash, and the efforts of the one list that
			## lift a tier; unset is the form's own empty choice, so the list is walked without it. The value itself stays
			## `<preset>[:<effort>]`, and an effort a value already holds (default, hard) is shown by the screen with them.
			## A workspace with no preset still has its own settings: the tiers are then locked, with the reason, and the rows after them stand as they always did.
			if [ -n "$knownList" ] ; then
				knownEfforts=""
				for knownOne in $agentsPresetEfforts ; do
					[ "$knownOne" = unset ] && continue
					knownEfforts="$knownEfforts${knownEfforts:+,}$knownOne"
				done
				knownList="$knownList/$knownEfforts"
				printf 'SPAWN_TIER_LOW\ttier\t%s\tThe_preset_(and_its_effort)_of_the_low_tier.\n' "$knownList"
				printf 'SPAWN_TIER_NORMAL\ttier\t%s\tThe_preset_(and_its_effort)_of_the_normal_tier.\n' "$knownList"
				printf 'SPAWN_TIER_HIGH\ttier\t%s\tThe_preset_(and_its_effort)_of_the_high_tier.\n' "$knownList"
			else
				printf 'SPAWN_TIER_LOW\tlocked\tthere_is_no_preset_to_choose\tThe_preset_(and_its_effort)_of_the_low_tier;_made_with_the_first_preset.\n'
				printf 'SPAWN_TIER_NORMAL\tlocked\tthere_is_no_preset_to_choose\tThe_preset_(and_its_effort)_of_the_normal_tier;_made_with_the_first_preset.\n'
				printf 'SPAWN_TIER_HIGH\tlocked\tthere_is_no_preset_to_choose\tThe_preset_(and_its_effort)_of_the_high_tier;_made_with_the_first_preset.\n'
			fi
			## The harness's own knobs, read by every spawn of this workspace that runs on a leg.
			printf 'HARNESS_STREAM_ATTEMPTS\tnumber\t1..10\tHow_many_attempts_one_round_may_make_before_it_gives_up.\n'
			printf 'HARNESS_RETRY_DELAY\tnumber\t0..30\tSeconds_before_the_first_retry;_each_later_one_doubles_up_to_30.\n'
			printf 'HARNESS_PARALLEL_TOOL_CALLS\tchoice\ton=on,off=off\tWhether_a_server_that_takes_parallel_tool_calls_is_told_so.\n'
			## The account at the console that IS the human-owner: its answers are his own, and the
			## authority gate confirms with him instead of asking a session's thread. Read by
			## AgentsToolsAuthorityOwnerMapped, and until it was declared here it could be set NOWHERE.
			if [ "$knownName" = magic-team ] ; then
				printf 'HUMAN_OWNER_CONSOLE_ACCOUNT\ttext\t-\tThe_account_at_the_console_that_is_the_human-owner;_its_answers_are_his_own.\n'
				## The owners role (epic T8): its members, and the quorum rule of each kind of decision.
				## A console account is never a member; these rows name only authenticated accounts.
				printf 'HUMAN_OWNER_MEMBERS\ttext\t-\tThe_owners_role_s_members,_authenticated_accounts,_space-separated.\n'
				printf 'HUMAN_OWNER_QUORUM\ttext\t-\tThe_quorum_rule_of_each_kind_of_decision,_as_kind=rule_pairs.\n'
			fi
		;;
	esac
	return 0
}

