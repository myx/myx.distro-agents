#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## The manager screen of the agents console, the console app: starts
## sh-lib/manager/AgentsManagerScreen.py in this terminal, for this workspace, with this dispatcher
## as its one way to the tooling. Sourced from DistroAgentsTools.fn.sh's `--manager` arm;
## needs $1/$@/$MDSC_CMD from dot-sourcing. It is what the console's `--manager` runs: a
## generated console is a snapshot, so this name stays while the screen changes.
## `--manager` is not of the `--manager-*` family, on purpose: that family is the shell
## console user's fallback and the internals the screen reads through.
## It hands the screen the interface style of the start (THE STYLE OF THIS START, below):
## the screen's own code knows nothing of where a saved style is kept. So too the spacers
## of its lists (THE SPACERS OF THIS START, below).
## The screen itself says, in one line, where it cannot start: a Python with no
## curses module, or no terminal.
##

case "$1" in

	--manager)
		shift

		## Its one option: the interface style of this start alone, handed on as it is given.
		local managerStyle=""
		if [ "${1:-}" = "--style" ] && [ $# -eq 2 ] && [ -n "$2" ] ; then
			managerStyle="$2"
			shift 2
		fi

		if [ $# -gt 0 ] ; then
			printf '%s\n' "$MDSC_CMD --manager -- starts the manager screen of the agents console in this terminal. Its one option is --style <name>, the interface style of this start." >&2
			printf '%s\n' "" >&2
			printf '%s\n' "  $MDSC_CMD --manager [--style <name>]" >&2
			set +e ; return 1
		fi

		set +e

		local managerScreenFile="$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/manager/AgentsManagerScreen.py"
		if [ ! -r "$managerScreenFile" ] ; then
			echo "$MDSC_CMD --manager: ⛔ ERROR: the manager screen is missing or unreadable: $managerScreenFile" >&2
			return 1
		fi
		if ! command -v python3 > /dev/null 2>&1 ; then
			echo "$MDSC_CMD --manager: ⛔ ERROR: the manager screen needs python3, and none is in PATH." >&2
			return 1
		fi

		## THE STYLE OF THIS START, the first of these that is there: the one named on the
		## command; the one the environment names (MDAT_MANAGER_STYLE), which the screen reads
		## itself, so nothing is handed on for it; the one the user saved, handed on as --style;
		## else the screen's own default. The saved one is asked of the digest of the settings,
		## whose line of the style says where its value comes from: it reads `user` only where
		## the environment names no style and the user saved one. So what the digest shows is
		## what a start takes. Where the digest cannot be read, nothing is handed on.
		if [ -z "$managerStyle" ] ; then
			managerStyle="$( DistroAgentsTools --manager-config-digest interface 2> /dev/null < /dev/null | LC_ALL=C awk -F'\t' '$1 == "line" && $4 == "MDAT_MANAGER_STYLE" && $7 == "user" { print $6 ; exit ; }' )" || managerStyle=""
		fi

		## THE SPACERS OF THIS START: MDLT_CONSOLE_SPACERS, a console setting of .local, the
		## user's own, beside MDLT_CONSOLE_HISTORY, and no setting of the agents. `disable`
		## turns off the blank lines between the groups of the screen's lists. The one the
		## environment names first, which the screen reads itself; else the one the user saved,
		## read by the reader every console's rc asks, handed on in the screen's environment
		## alone, and only where there is one.
		if [ -z "${MDLT_CONSOLE_SPACERS:-}" ] ; then
			local managerSpacers
			managerSpacers="$( set -- --.local-config-option-select-default MDLT_CONSOLE_SPACERS "" ; . "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/LocalTools.Config.include" 2> /dev/null < /dev/null )" || managerSpacers=""
			[ -z "$managerSpacers" ] || local -x MDLT_CONSOLE_SPACERS="$managerSpacers"
		fi

		set -- --workspace "$MMDAPP" --tools "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
		[ -z "$managerStyle" ] || set -- "$@" --style "$managerStyle"

		## -I: nothing of the caller's own Python setup reaches the screen. -B: no bytecode is written into the source tree.
		python3 -I -B "$managerScreenFile" "$@"
		return $?
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;

esac
