#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

## AgentsTools.OpManagerPendingReplyAnswer.include -- the operation `--manager-pending-reply-answer`, sourced by AgentsTools.ManagerPendingReply.include with the operation's arguments.
## One open question answered from the console: with a word or a number of its own, with
## words where it takes words, or with its own negative answer. One row saying what
## became of it, its form the help entry's. The apply, the close and the confirmation in
## the thread are the one answer operation's; so is the line that says it came from here.
		local answerOp="$1" answerSyntax="--id <pending-id> (--answer <word|number|text>|--reject) [--text <words>]"
		local answerTyped="" answerWords="" answerMode="" answerAs answerAccount answerOut="" answerRc=0 answerWord answerOwn
		shift
		AgentsToolsManagerPendingRecord "$answerOp" "$answerSyntax" "$@" || { set +e ; return 1 ; }
		## The escalation words (F6.10, AgentsTools.Authority.include), taken out wherever they stand.
		type AgentsToolsAuthorityFlags > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.Authority.include"
		AgentsToolsAuthorityFlags ${managerPendingRest[@]+"${managerPendingRest[@]}"} || { set +e ; return 1 ; }
		set -- ${agentsAuthorityRest[@]+"${agentsAuthorityRest[@]}"}
		while [ $# -gt 0 ] ; do
			case "$1" in
				--answer|--text)
					if [ $# -lt 2 ] || [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD $answerOp: $1 needs a value -- syntax is $answerSyntax" >&2
						set +e ; return 1
					fi
					[ "$1" = "--answer" ] && answerTyped="$2" || answerWords="$2"
					shift 2
				;;
				--reject) answerMode="reject" ; shift ;;
				*)
					echo "⛔ ERROR: $MDSC_CMD $answerOp: syntax is $answerSyntax, got: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if { [ -z "$answerTyped" ] && [ -z "$answerMode" ] ; } || { [ -n "$answerTyped" ] && [ -n "$answerMode" ] ; } ; then
			echo "⛔ ERROR: $MDSC_CMD $answerOp: syntax is $answerSyntax, with --answer or --reject, one of them" >&2
			set +e ; return 1
		fi
		AgentsToolsManagerPendingOpen "$answerOp" || { set +e ; return 1 ; }
		## A request for the authority is answered by whom it asks, its answer acting on what it asked for.
		if [ -n "$( AgentsToolsEscalationField "$managerPendingFile" request-of )" ] ; then
			AgentsToolsAuthorityRequestAnswer "$managerPendingFile" "${answerTyped:-deny}" console || { set +e ; return 1 ; }
			return 0
		fi
		if [ -n "$answerMode" ] ; then
			answerTyped="$( AgentsToolsManagerPendingReject "$managerPendingFile" )"
			if [ -z "$answerTyped" ] ; then
				echo "⛔ ERROR: $MDSC_CMD $answerOp: $managerPendingId is a $( AgentsToolsEscalationField "$managerPendingFile" kind ) with no negative answer of its own, so it takes no reject -- nothing was done; answer it, or dismiss it" >&2
				set +e ; return 1
			fi
		fi
		answerAs="$( AgentsToolsManagerPendingStanding "$managerPendingFile" )" || answerAs=""
		## A verdict that is the human-owner's own is not given in another's name: at the console it
		## is his where the person there is the account mapped to him. From any other account it goes
		## to him as a confirmation, a yes or no in his own conversation naming the account, the verdict, the item and the
		## text; his yes gives the verdict as typed, his no leaves the review open. Never just a refusal.
		answerWord="$answerTyped"
		AgentsToolsManagerPendingPlain "$managerPendingFile" || answerWord="$( AgentsToolsEscalationTypedVerdict "$managerPendingFile" "$answerTyped" )"
		answerOwn=""
		case "$( AgentsToolsEscalationField "$managerPendingFile" kind )" in review|change|proposal) answerOwn="yes" ;; esac
		if [ -z "$answerAs" ] && [ -n "$answerOwn" ] ; then
			## No account at the console (the sweep that acts on his confirmation runs with none): only his own confirmation of this very answer lets it go on.
			answerAs="not-taken"
		fi
		if [ -z "$answerAs" ] ; then
			AgentsToolsManagerPendingNobody "$answerOp" ; set +e ; return 1
		fi
		if [ "$answerAs" = "not-taken" ] || [ "$( AgentsToolsManagerPendingOutcome "$managerPendingFile" "$answerAs" "${answerWord%% -- *}" )" = "not-taken" ] ; then
			## His confirmation of this very answer, given in his own channel: the answer is then his, as he gave it, under the account he answered with.
			## (AgentsToolsAuthorityApproved marks it acted on, so it lets one answer go.)
			if AgentsToolsAuthorityApproved "$managerPendingId" ; then
				answerAs="$( AgentsToolsAuthorityField "${MMDAPP:-/nonexistent}/.local/questions/$MDAT_AUTHORITY_REQUEST.md" answered-by )"
				[ -n "$answerAs" ] || { AgentsToolsManagerPendingNobody "$answerOp" ; set +e ; return 1 ; }
			else
				[ "$answerAs" != "not-taken" ] || { AgentsToolsManagerPendingNobody "$answerOp" ; set +e ; return 1 ; }
				local answerAsk=() answerWhat answerGateOut answerGateRc=0
				answerAsk=( --manager-pending-reply-answer --id "$managerPendingId" )
				if [ -n "$answerMode" ] ; then answerAsk+=( --reject ) ; else answerAsk+=( --answer "$answerTyped" ) ; fi
				[ -z "$answerWords" ] || answerAsk+=( --text "$answerWords" )
				answerWhat="the ${answerWord%% -- *} of the $( AgentsToolsEscalationField "$managerPendingFile" kind ) of $( AgentsToolsEscalationField "$managerPendingFile" item ) as your own verdict, typed at the console${answerWords:+, with the words: $answerWords}"
				agentsAuthorityForceConfirm=yes
				answerGateOut="$( AgentsToolsAuthorityGate "$answerWhat" "$managerPendingId" "" "$managerPendingFile" console ${answerAsk[@]+"${answerAsk[@]}"} )" || answerGateRc=$?
				agentsAuthorityForceConfirm=""
				[ -z "$answerGateOut" ] || printf '%s\n' "$answerGateOut"
				if [ "$answerGateRc" != 0 ] ; then
					echo "⛔ ERROR: $MDSC_CMD $answerOp: $managerPendingId is a $( AgentsToolsEscalationField "$managerPendingFile" kind ), whose verdict is the human-owner's own, and the confirmation asked of him could not be posted -- nothing was done; it stays open for $( AgentsToolsEscalationField "$managerPendingFile" address-to )" >&2
					set +e ; return 1
				fi
				return 0
			fi
		fi
		## THE AUTHORITY over the run that asked it (F6.10): its reports-to, the owners role, or a grant
		## of it -- asked only of an answer the question takes, so a wrong one is refused as one. The
		## human-owner's own verdict is not an act in another's name: it is his word at the console as
		## it is in his thread, and is applied without asking the authority over the run that asked.
		if ! AgentsToolsManagerPendingOwnVerdict "$managerPendingFile" "$answerAs" \
			&& { AgentsToolsManagerPendingPlain "$managerPendingFile" || [ -n "${answerWord%% -- *}" ] ; } ; then
			local answerAsker="" answerAskerRecord=""
			## A refusal is never gated (AgentsToolsAuthorityRefusing): the deny of a permission or a permission set, whoever it is asked of.
			case "$( AgentsToolsEscalationField "$managerPendingFile" kind )" in
				permission|permission-set) ! AgentsToolsAuthorityRefusing "${answerWord%% -- *}" || agentsAuthorityRefusing="yes" ;;
			esac
			answerAsker="$( AgentsToolsEscalationField "$managerPendingFile" session-id )"
			type AgentsSessionRunRecordInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.include"
			AgentsSessionRunRecordInto answerAskerRecord "$answerAsker" || :
			AgentsToolsAuthorityGate "answer question $managerPendingId with $( [ -n "$answerMode" ] && printf 'its reject' || printf '%s' "$answerTyped" )" "$managerPendingId" "$answerAskerRecord" "$managerPendingFile" console \
				"$answerOp" --id "$managerPendingId" $( [ -n "$answerMode" ] && printf -- '--reject' ) ${answerTyped:+--answer "$answerTyped"} ${answerWords:+--text "$answerWords"} || :
			AgentsToolsAuthorityExit || { set +e ; return "$agentsAuthorityExit" ; }
			[ -z "$( AgentsToolsAuthorityChosen )" ] || { answerTyped="$( AgentsToolsAuthorityChosen )" ; answerMode="" ; }
		fi
		answerAccount="$( AgentsToolsManagerPendingAccount )"
		## Recorded as the person at the console; what an allow may reach is the coordinator's holding, named to the apply (agentsEscalationCapacity).
		answerOut="$( agentsEscalationCapacity="$( AgentsToolsManagerPendingHolder "$managerPendingFile" )"
			. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.MemberEscalation.include" \
			--manager-pending-reply-answer "$answerAs" "$managerPendingId" "$answerTyped" "$answerWords" "$answerAccount" "$answerMode" )" || answerRc=$?
		## An applied answer closes its record, and a close retires it to pending/closed/ (retention,
		## T9): the path it was found at is stale then, so the row below reads the fields from
		## whichever store it now lives in.
		managerPendingFile="$( AgentsToolsPendingRecordPath "$managerPendingId" )" || :
		case "$answerRc:$answerOut" in
			0:*"ESCALATION: $managerPendingId answered"*)
				answerWords="$( AgentsToolsEscalationField "$managerPendingFile" verdict-text )"
				printf '%s\t%s\t%s\t%s\tconsole:%s\t%s\n' "$( [ -n "$answerMode" ] && printf 'rejected' || printf 'answered' )" "$managerPendingId" \
					"$( AgentsToolsEscalationField "$managerPendingFile" verdict )" "$answerAs" "$answerAccount" "${answerWords:--}"
				return 0
			;;
			0:*"ESCALATION: $managerPendingId rerouted"*)
				printf 'up-the-chain\t%s\t%s\t%s\tconsole:%s\t%s\n' "$managerPendingId" "$( AgentsToolsEscalationField "$managerPendingFile" address-to )" "$answerAs" "$answerAccount" \
					"$( AgentsToolsEscalationField "$managerPendingFile" reroute-reason )"
				return 0
			;;
		esac
		## Not applied: why, as the apply said it, and the question as it stands.
		printf '%s\n' "$answerOut" | LC_ALL=C sed -n 's/^VERDICT-REASON: /⛔ ERROR: not applied: /p' >&2
		set +e ; return 1
