#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

## AgentsTools.OpManagerPendingReplyAnswer.include -- the console's arm of answering a question. THE IMPLEMENTATION IS ONE:
## sh-lib/questions/AgentsTools.OpManagerPendingReplyAnswer.include serves `--answer-escalation` and
## `--manager-pending-reply-answer` alike, and this arm forwards to it with the arguments it was sourced with. The two copies
## had drifted apart (measured 2026-11-26: 134 lines here against 171 there, and this arm still refused the unified name), so
## they are one file now and cannot drift again.
. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.OpManagerPendingReplyAnswer.include"
