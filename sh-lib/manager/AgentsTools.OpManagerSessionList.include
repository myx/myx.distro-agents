#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

type AgentsToolsManagerSessionRows > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/manager/AgentsTools.ManagerSessionRows.include"

## AgentsTools.OpManagerSessionList.include -- the operation `--manager-session-list`, sourced by AgentsTools.ManagerSession.include with the operation's arguments.
## The sessions of this workspace, each with its runs, then one row of counters: TAB-separated
## rows a screen reads. Their form is the help entry's.
		local listOp="$1" listActive=""
		shift
		while [ $# -gt 0 ] ; do
			case "$1" in
				--active) listActive="active" ; shift ;;
				*)
					echo "⛔ ERROR: $MDSC_CMD $listOp: syntax is [--active], got: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		AgentsToolsManagerSessionRows "$listOp" "$listActive" || { set +e ; return 1 ; }
		## THE LIST OF THE SESSIONS ASKS FOR THE SCHEDULE: the manager screen reads it on every refresh, so a schedule thread that is dead is started
		## at the look (AgentsToolsScheduleThreadAskDue view: a live thread costs one read of its lock, and the store holds the once-a-minute throttle).
		type AgentsToolsScheduleThreadAskDue > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/schedule/AgentsTools.ScheduleThread.include"
		AgentsToolsScheduleThreadAskDue view > /dev/null 2>&1 || :
		return 0
