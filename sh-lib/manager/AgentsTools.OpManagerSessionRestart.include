#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only
type AgentsToolsSpawnRecord > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/run/AgentsTools.RunRecords.include"
type AgentsToolsRunRecorded > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/run/AgentsTools.RunProcesses.include"

type AgentsToolsManagerConsoleMember > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/manager/AgentsTools.ManagerConsoleIdentity.include"

## AgentsTools.OpManagerSessionRestart.include -- the operation `--manager-session-restart`, sourced by AgentsTools.ManagerSession.include with the operation's arguments.
## THE RESTART (S7.19, the human-owner's ruling: a restart is a start again of what has stopped or finished, never of what runs).
## <id> is a session's id, whose founding run is started again, or with --run one run's own. The run is started again by the one
## restart path the tooling has (AgentsReviewRestart, AgentsTools.ReviewFlow.include): in the same session, sandbox and board item,
## resumed from its kept context where that can be, else as a new process from its item with its Decisions first. A run that still
## lives is not touched: its row says `live`, and the stop or the kill comes first. A run no board item names cannot be started
## again: `no-item`. One `restart` row, `session run member outcome detail`, the outcome `resumed`, `new-process`, `live`,
## `no-item` or `failed`, the detail the item and what the restart said, its tabs and line ends spaces; a `none` row where the id
## names no record of this workspace.
		local restartOp="$1" restartId="" restartOwn="" restartBy restartRecord="" restartSpawn restartSession restartMember restartStatus restartItem="" restartOut="" restartOutcome restartDetail restartSyntax="--session-id <id> [--run]"
		shift
		while [ $# -gt 0 ] ; do
			case "$1" in
				--session-id)
					if [ $# -lt 2 ] || [ -z "$2" ] || [ "$2" = "-" ] ; then
						echo "⛔ ERROR: $MDSC_CMD $restartOp: --session-id needs an id -- syntax is $restartSyntax" >&2
						set +e ; return 1
					fi
					restartId="$2" ; shift 2
				;;
				--run) restartOwn="run" ; shift ;;
				*)
					echo "⛔ ERROR: $MDSC_CMD $restartOp: syntax is $restartSyntax, got: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$restartId" ] ; then
			echo "⛔ ERROR: $MDSC_CMD $restartOp: syntax is $restartSyntax, got no --session-id" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$restartId" "the session id" "$restartOp" || { set +e ; return 1 ; }
		restartBy="$( AgentsToolsManagerConsoleMember 2> /dev/null )" || restartBy="console"
		type AgentsToolsFrontmatterKey > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/common/AgentsTools.FrontmatterKey.include"
		## The record: the run's own, which for a session's id is its founding run's, whose spawn id is the session's; else the older
		## record that names the session alone (AgentsToolsRunOwnRecord). With --run only a run's own record is taken.
		restartRecord="$( AgentsToolsSpawnRecord "$restartId" < /dev/null )" || restartRecord=""
		[ -n "$restartRecord" ] || [ -n "$restartOwn" ] || restartRecord="$( AgentsToolsRunOwnRecord "$restartId" < /dev/null )" || restartRecord=""
		if [ -z "$restartRecord" ] ; then
			printf 'none\t%s\t-\t-\tno record of this workspace is named by that id\n' "$restartId"
			return 0
		fi
		restartSpawn="$( AgentsToolsFrontmatterKey "$restartRecord" spawn-id )"
		restartSession="$( AgentsToolsFrontmatterKey "$restartRecord" session-id )"
		case "$restartSpawn" in ''|-) restartSpawn="$restartSession" ;; esac
		restartMember="$( AgentsToolsFrontmatterKey "$restartRecord" owner )"
		restartStatus="$( AgentsToolsFrontmatterKey "$restartRecord" status )"
		if [ "$restartStatus" = "spawn-started" ] && AgentsToolsRunRecorded "$restartRecord" > /dev/null 2>&1 ; then
			printf 'restart\t%s\t%s\t%s\tlive\t%s\n' "$restartSession" "$restartSpawn" "${restartMember:--}" "the run still lives: stop or kill it first"
			return 0
		fi
		## ONE SESSION, ONE LIVE RUN: a restart over a session with another live run forks a second worker, and on 2026-11-25 that left
		## six harnesses on one session, every one writing the same context. Any live peer refuses the restart, whatever the named record says.
		type AgentsToolsSpawnedSessionRecords > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.StartedRecords.include"
		local restartPeer="" restartPeerLive=""
		while IFS= read -r restartPeer ; do
			[ -n "$restartPeer" ] && [ -f "$restartPeer" ] || continue
			[ "$( AgentsToolsFrontmatterKey "$restartPeer" spawn-id )" != "$restartSpawn" ] || continue
			AgentsToolsRunRecorded "$restartPeer" > /dev/null 2>&1 || continue
			restartPeerLive="$( AgentsToolsFrontmatterKey "$restartPeer" spawn-id )" ; break
		done <<< "$( AgentsToolsSpawnedSessionRecords "$restartSession" own 2> /dev/null )"
		if [ -n "$restartPeerLive" ] ; then
			printf 'restart\t%s\t%s\t%s\tlive\t%s\n' "$restartSession" "$restartSpawn" "${restartMember:--}" "another run of the session still lives: $restartPeerLive -- end it first, or use --run"
			return 0
		fi
		type AgentsReviewRestart > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.ReviewFlow.include"
		restartItem="$( AgentsReviewItemOfSession "$restartSpawn" )" || restartItem=""
		if [ -z "$restartItem" ] ; then
			printf 'restart\t%s\t%s\t%s\tno-item\t%s\n' "$restartSession" "$restartSpawn" "${restartMember:--}" "no board item names this run, so nothing can start it again"
			return 0
		fi
		## A RESTART IS A RETURN WITH NO CORRECTIONS: an item in review goes back to running first, moved as the return verdict moves it
		## (AgentsReviewVerdict, `return`). Left in review, the session's control thread ends the run this starts as soon as its closing
		## time passes, as one whose handback waited past the review limit (AgentsToolsSessionControlRelease).
		if AgentsReviewVerdictPath "$restartItem" review > /dev/null 2>&1 ; then
			AgentsReviewMoveWithSection "$restartItem" review running "## Review: restarted ($( date -u +%Y-%m-%dT%H:%MZ ), $restartBy)" "Started again by $restartBy, with no corrections." \
				--header:remove:review-since-epoch --header:remove:review-reason > /dev/null 2>&1 || {
				printf 'restart\t%s\t%s\t%s\tfailed\t%s\n' "$restartSession" "$restartSpawn" "${restartMember:--}" "${restartItem%.md}: the move back to running failed, so nothing was started"
				return 0
			}
		fi
		## The restart itself, in a subshell of its own: the tooling it calls leaves set -e behind. Its RETURN line is the detail.
		restartOut="$( AgentsReviewRestart "$restartItem" "$restartRecord" "" "$restartBy" 2>&1 )" && restartOutcome="restarted" || restartOutcome="failed"
		restartDetail="$( printf '%s\n' "$restartOut" | LC_ALL=C grep -m1 '^RETURN: ' )"
		[ -n "$restartDetail" ] || restartDetail="$( printf '%s\n' "$restartOut" | LC_ALL=C grep -m1 . )"
		if [ "$restartOutcome" = "restarted" ] ; then
			case "$restartDetail" in *" resuming "*) restartOutcome="resumed" ;; *) restartOutcome="new-process" ;; esac
		fi
		printf 'restart\t%s\t%s\t%s\t%s\t%s\n' "$restartSession" "$restartSpawn" "${restartMember:--}" "$restartOutcome" "${restartItem%.md}: $( printf '%s' "${restartDetail#RETURN: }" | LC_ALL=C tr '\t\n' '  ' )"
		return 0
