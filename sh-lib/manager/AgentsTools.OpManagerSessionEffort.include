#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

## AgentsTools.OpManagerSessionEffort.include -- the operation `--manager-session-effort`, sourced by AgentsTools.ManagerSession.include with the operation's arguments.
## The effort a running session asks of its model, changed while it runs (F10.7): written for the harness to read at its next
## round, the store's own effort value (AgentsSessionEffortSet; AgentsHarnessCacheWatch,
## AgentsUniversalHarness.sh). One row, TAB-separated, its form the help entry's. Nothing is signalled: the run reads it itself.
## A change discards the input token cache of the run that reads it, and that run says so when it does.
		local effortOp="$1" effortId effortValue effortFile effortRc
		shift
		if [ $# -ne 2 ] ; then
			echo "⛔ ERROR: $MDSC_CMD $effortOp: syntax is <session-id> <unset|none|low|normal|high>, got $# argument(s)" >&2
			set +e ; return 1
		fi
		effortId="$1" ; effortValue="$2"
		AgentsToolsAssertBareName "$effortId" "the session id" "$effortOp" || { set +e ; return 1 ; }
		case "$effortValue" in
			unset|none|low|normal|high) ;;
			*) echo "⛔ ERROR: $MDSC_CMD $effortOp: the effort is unset, none, low, normal or high -- nothing was saved" >&2 ; set +e ; return 1 ;;
		esac
		effortFile="" ; effortRc=0
		type AgentsSessionEffortSet > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.include"
		effortFile="$( AgentsSessionEffortSet "$effortId" "$effortValue" )" || effortRc=$?
		case "$effortRc" in
			0) ;;
			1) echo "⛔ ERROR: $MDSC_CMD $effortOp: no store of a session or of a run is named by that id in this workspace -- nothing was saved" >&2 ; set +e ; return 1 ;;
			*) echo "⛔ ERROR: $MDSC_CMD $effortOp: the effort could not be saved in the store of $effortId -- nothing was saved" >&2 ; set +e ; return 1 ;;
		esac
		printf 'effort\t%s\t%s\t%s\n' "$effortId" "$effortValue" "${effortFile//[[:space:]]/_}"
		return 0
