#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.ManagerPendingReply.include -- the --manager-pending-reply-* operations: the
## console's own way to the questions that wait on an answer. Sourced from the
## `--manager-pending-reply-*)` arm of AgentsTools.Manager.include; who may call was asked
## where the family is dispatched.
##
## Nothing here applies an answer or closes a record. An answer goes to the one place that
## applies a verdict, the answer arm of AgentsTools.MemberEscalation.include, which the
## members' own stubs reach too; a dismissal goes to the one withdraw, the settle arm of
## AgentsTools.MemberPendingReply.include. What is the console's own lies here: which
## answers a question takes, as rows a screen draws a dialog from; which of them is its
## reject; whose word an answer given at the console is (AgentsToolsManagerPendingStanding,
## the one place that says it); and the rows each operation prints.
##

type AgentsToolsEscalationTypedVerdict > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.MemberEscalation.include" --definitions-only

## WHOSE WORD an answer given at the console is: the member it stands as. The one place that
## says it. The person at the console, `user-<account>` (F6.10, Settled: "a console answers as
## user-<acct> under the authority rule, never as magic-coordinator"), for every question,
## whoever asked it and whoever it is addressed to: the answer is recorded, applied and
## confirmed under that name (`answered-by`, the grant's `by`, the line in the thread). WHO MAY
## ANSWER is the authority rule's alone (AgentsToolsAuthorityGate, asked of every answer below);
## the name is not what decides it. Where the system gives no account the console is nobody:
## nothing is printed and the rc is 1, since an answer is never recorded under a made-up name
## (AgentsToolsManagerPendingNobody says so).
AgentsToolsManagerPendingStanding(){ ## record file
	local standingName=""
	standingName="$( . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/manager/AgentsTools.ManagerSession.include" --definitions-only > /dev/null 2>&1 || :
		AgentsToolsManagerConsoleMember 2> /dev/null )" || return 1
	[ -n "$standingName" ] || return 1
	printf '%s\n' "$standingName"
}

## The refusal where there is no standing: nothing was read as, and nothing is recorded.
AgentsToolsManagerPendingNobody(){ ## operation
	echo "⛔ ERROR: $MDSC_CMD $1: the system gives no account for the person at the console, and an answer is not recorded under a made-up name -- nothing was done" >&2
}

## WHAT AN ALLOW MAY REACH from the console, as it always was: bounded by what magic-coordinator
## holds. An operator of the console stands at least equal to the coordinator and is nobody's
## asker, so what the coordinator does not hold goes up the chain, as its own answer does, and
## what is the human-owner's own stays the human-owner's. The grant is no wider for the person
## who answers than for the coordinator, and no narrower: only the name it is recorded under
## is the person's.
AgentsToolsManagerPendingHolder(){ ## record file
	printf 'magic-coordinator\n'
}

## What becomes of one answer given with that standing: `settles`, the question closes with
## it; `up-the-chain`, an allow of what that member does not hold, which is not applied, the
## request going to a holder or the human-owner (AgentsToolsEscalationReroute); `not-taken`,
## a verdict that is the human-owner's own -- a review, a held change, a proposal -- which
## is refused here and stays open for him. The holding is asked as the apply asks it.
AgentsToolsManagerPendingOutcome(){ ## record file, standing member, answer word
	local outcomeAsked outcomeSession outcomeWide="" outcomeHolder
	outcomeHolder="$( AgentsToolsManagerPendingHolder "$1" )"
	[ "$2" != "human-owner" ] || { printf 'settles\n' ; return 0 ; }
	case "$( AgentsToolsEscalationField "$1" kind ):$3" in
		review:*|change:*|proposal:*) printf 'not-taken\n' ; return 0 ;;
		permission:allow-folder|permission:allow-project)
			outcomeWide="$( AgentsToolsEscalationFolder "$1" "${3#allow-}" 2> /dev/null )" || outcomeWide=""
			[ -n "$outcomeWide" ] || { printf 'up-the-chain\n' ; return 0 ; }
		;;
		permission:allow-*|permission-set:allow-set) ;;
		*) printf 'settles\n' ; return 0 ;;
	esac
	outcomeSession="$( AgentsToolsEscalationField "$1" session-id )"
	while IFS= read -r outcomeAsked ; do
		[ -n "$outcomeAsked" ] || continue
		case "$( DistroAgentsTools --intern-op-permission-holds "$outcomeHolder" "${outcomeAsked%%$'\t'*}" "${outcomeAsked#*$'\t'}" \
			${outcomeSession:+--session-id "$outcomeSession"} 2> /dev/null | head -1 )" in
			'HOLDS '*) ;;
			*) printf 'up-the-chain\n' ; return 0 ;;
		esac
	done <<< "$( [ -n "$outcomeWide" ] && printf '%s\t%s\n' "${outcomeWide%%:*}" "${outcomeWide#*:}" || AgentsToolsEscalationAsked "$1" )"
	printf 'settles\n'
}

## The one negative answer of a kind, where it has one: what `--reject` gives. Nothing for a
## kind with none: a decision, and a question that asks for a choice or for words.
AgentsToolsManagerPendingReject(){ ## record file
	case "$( AgentsToolsEscalationField "$1" kind ):$( AgentsToolsEscalationField "$1" select )" in
		readback:*|question:yes-no|:yes-no) printf 'no\n' ;;
		permission:*|permission-set:*) printf 'deny\n' ;;
		proposal:*) printf 'rejected\n' ;;
		review:*|change:*) printf 'reject\n' ;;
	esac
}

## Whether a question takes words alone as its answer: a plain question with no answer form.
AgentsToolsManagerPendingPlain(){ ## record file
	case "$( AgentsToolsEscalationField "$1" kind )" in ''|question) ;; *) return 1 ;; esac
	[ -z "$( AgentsToolsEscalationField "$1" select )" ]
}

## The answers one question takes, a row each: `answer`, the number of an option or `-`,
## the word, what becomes of it for this operator, and its label or `-`. The words are the
## ones the reader of a reply takes for the kind (AgentsEscalationVerdict.awk); the options
## of a decision and of a question with a form are the record's own, numbered as its post
## numbers them. A plain question has no row: it takes words alone.
AgentsToolsManagerPendingAnswers(){ ## record file, standing member
	local answersKind answersForm answersWords="" answersWord answersLine answersNo=0 answersLabel
	answersKind="$( AgentsToolsEscalationField "$1" kind )" ; answersForm="$( AgentsToolsEscalationField "$1" select )"
	case "${answersKind:-question}:$answersForm" in
		readback:*) answersWords="yes no correct" ;;
		question:yes-no) answersWords="yes no" ;;
		permission:*)
			answersWords="allow-once allow-session allow-task"
			[ -z "$( AgentsToolsEscalationFolderOffered "$1" )" ] || answersWords="$answersWords allow-folder"
			[ -z "$( AgentsToolsEscalationFolderOffered "$1" project )" ] || answersWords="$answersWords allow-project"
			[ -z "$( AgentsToolsEscalationFolderOffered "$1" contact )" ] || answersWords="$answersWords allow-contact"
			answersWords="$answersWords deny"
		;;
		permission-set:*) answersWords="allow-set edit deny" ;;
		proposal:*) answersWords="approved rejected" ;;
		review:*) answersWords="accept return reject" ;;
		change:*) answersWords="approve reject" ;;
		decision:*|question:one|question:many)
			[ -f "${1%.md}.options" ] || return 0
			while IFS= read -r answersLine || [ -n "$answersLine" ] ; do
				[ -n "$answersLine" ] || continue
				answersNo=$(( answersNo + 1 ))
				answersLine="${answersLine#- }"
				answersWord="${answersLine%%[ $'\t']*}" ; answersLabel="${answersLine#"$answersWord"}"
				answersWord="$( printf '%s' "${answersWord%:}" | LC_ALL=C tr 'A-Z' 'a-z' )"
				answersLabel="$( printf '%s' "$answersLabel" | LC_ALL=C sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]/ /g' )"
				printf 'answer\t%s\t%s\t%s\t%s\n' "$answersNo" "$answersWord" "$( AgentsToolsManagerPendingOutcome "$1" "$2" "$answersWord" )" "${answersLabel:--}"
			done < "${1%.md}.options"
			return 0
		;;
	esac
	for answersWord in $answersWords ; do
		printf 'answer\t-\t%s\t%s\t-\n' "$answersWord" "$( AgentsToolsManagerPendingOutcome "$1" "$2" "$answersWord" )"
	done
}

## The web link of a question's own message, by the one maker of such a link
## (AgentsToolsSpawnProxyPostLink): nothing where the workspace's Slack address is not known
## or the record names no message.
AgentsToolsManagerPendingLink(){ ## record file
	local linkChannel linkTs linkOwner
	linkChannel="$( AgentsToolsEscalationField "$1" channel )" ; linkTs="$( AgentsToolsEscalationField "$1" question-ts )"
	linkOwner="$( AgentsToolsEscalationField "$1" owner )"
	[ -n "$linkChannel" ] && [ -n "$linkTs" ] && [ -n "$linkOwner" ] || return 0
	( . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.InternOpAgentSpawnProxy.include" --definitions-only > /dev/null 2>&1 || :
		AgentsToolsSpawnProxyPostLink "$linkOwner" "$linkChannel:$linkTs" ) 2> /dev/null || :
}

## The account at the console, as a kill is recorded under it (AgentsToolsManagerConsoleUser).
AgentsToolsManagerPendingAccount(){
	local accountName=""
	accountName="$( . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/manager/AgentsTools.ManagerSession.include" --definitions-only > /dev/null 2>&1 || :
		AgentsToolsManagerConsoleUser 2> /dev/null )" || accountName=""
	printf '%s\n' "${accountName:-unknown}"
}

## The record an operation names with `--id <pending-id>`, as managerPendingId and
## managerPendingFile; the words after it are left in managerPendingRest. rc 1, with the one
## error line, where the syntax is not met or there is no such record.
AgentsToolsManagerPendingRecord(){ ## the operation as it was called, its syntax, the arguments...
	local recordOp="$1" recordSyntax="$2"
	shift 2
	managerPendingId="" ; managerPendingFile="" ; managerPendingRest=()
	while [ $# -gt 0 ] ; do
		case "$1" in
			--id)
				if [ $# -lt 2 ] || [ -z "$2" ] || [ "$2" = "-" ] ; then
					echo "⛔ ERROR: $MDSC_CMD $recordOp: --id needs a pending id -- syntax is $recordSyntax" >&2
					return 1
				fi
				managerPendingId="$2" ; shift 2
			;;
			*) managerPendingRest=( "${managerPendingRest[@]}" "$1" ) ; shift ;;
		esac
	done
	if [ -z "$managerPendingId" ] ; then
		echo "⛔ ERROR: $MDSC_CMD $recordOp: syntax is $recordSyntax, got no --id" >&2
		return 1
	fi
	AgentsToolsAssertBareName "$managerPendingId" "<pending-id>" "${recordOp#--}" || return 1
	## In either store: the asks, and the requests for the authority (AgentsToolsPendingRecordPath).
	type AgentsToolsPendingRecordPath > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.Authority.include"
	managerPendingFile="$( AgentsToolsPendingRecordPath "$managerPendingId" )" || {
		echo "⛔ ERROR: $MDSC_CMD $recordOp: no pending question $managerPendingId -- nothing was done" >&2
		return 1
	}
}

## Refuses a record that is not open, with the one line that says how it was closed.
AgentsToolsManagerPendingOpen(){ ## the operation as it was called
	local openStatus
	openStatus="$( AgentsToolsEscalationField "$managerPendingFile" status )"
	case "$openStatus" in
		reply-pending) return 0 ;;
		reply-received)
			echo "⛔ ERROR: $MDSC_CMD $1: $managerPendingId is answered already, with \"$( AgentsToolsEscalationField "$managerPendingFile" verdict )\" by $( AgentsToolsEscalationField "$managerPendingFile" answered-by ) -- nothing was done" >&2
		;;
		*)
			echo "⛔ ERROR: $MDSC_CMD $1: $managerPendingId is not pending, it is ${openStatus:-of no status}$( [ "$openStatus" != withdrawn ] || printf ' by %s' "$( AgentsToolsEscalationField "$managerPendingFile" withdrawn-by )" ) -- nothing was done" >&2
		;;
	esac
	return 1
}

case "$1" in

	## What can be done with one question: one `question` row, then an `answer` row for each
	## answer it takes while it is open. TAB-separated, their form the help entry's. Changes
	## nothing, and reads no thread.
	--manager-pending-reply-read)
		local readOp="$1" readAs readStatus readText="-" readReject="-" readDismiss="no" readField readRow=""
		shift
		AgentsToolsManagerPendingRecord "$readOp" "--id <pending-id>" "$@" || { set +e ; return 1 ; }
		if [ "${#managerPendingRest[@]}" -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD $readOp: syntax is --id <pending-id>, got: ${managerPendingRest[0]}" >&2
			set +e ; return 1
		fi
		readAs="$( AgentsToolsManagerPendingStanding "$managerPendingFile" )" || { AgentsToolsManagerPendingNobody "$readOp" ; set +e ; return 1 ; }
		readStatus="$( AgentsToolsEscalationField "$managerPendingFile" status )"
		if [ "$readStatus" = "reply-pending" ] ; then
			readDismiss="yes" ; readText="words"
			! AgentsToolsManagerPendingPlain "$managerPendingFile" || readText="answer"
			readReject="$( AgentsToolsManagerPendingReject "$managerPendingFile" )"
		fi
		for readField in kind select owner address-to ; do
			readField="$( AgentsToolsEscalationField "$managerPendingFile" "$readField" )"
			readRow="$readRow"$'\t'"${readField:--}"
		done
		readField="$( AgentsToolsManagerPendingLink "$managerPendingFile" )"
		printf 'question\t%s\t%s%s\t%s\t%s\t%s\t%s\t%s\n' "$managerPendingId" "${readStatus:--}" "$readRow" "$readAs" "$readText" "${readReject:--}" "$readDismiss" "${readField:--}"
		[ "$readStatus" != "reply-pending" ] || AgentsToolsManagerPendingAnswers "$managerPendingFile" "$readAs"
		return 0
	;;

	## One open question answered from the console: with a word or a number of its own, with
	## words where it takes words, or with its own negative answer. One row saying what
	## became of it, its form the help entry's. The apply, the close and the confirmation in
	## the thread are the one answer operation's; so is the line that says it came from here.
	--manager-pending-reply-answer)
		local answerOp="$1" answerSyntax="--id <pending-id> (--answer <word|number|text>|--reject) [--text <words>]"
		local answerTyped="" answerWords="" answerMode="" answerAs answerAccount answerOut="" answerRc=0 answerWord
		shift
		AgentsToolsManagerPendingRecord "$answerOp" "$answerSyntax" "$@" || { set +e ; return 1 ; }
		## The escalation words (F6.10, AgentsTools.Authority.include), taken out wherever they stand.
		type AgentsToolsAuthorityGate > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.Authority.include"
		AgentsToolsAuthorityFlags "${managerPendingRest[@]}" || { set +e ; return 1 ; }
		set -- "${agentsAuthorityRest[@]}"
		while [ $# -gt 0 ] ; do
			case "$1" in
				--answer|--text)
					if [ $# -lt 2 ] || [ -z "$2" ] ; then
						echo "⛔ ERROR: $MDSC_CMD $answerOp: $1 needs a value -- syntax is $answerSyntax" >&2
						set +e ; return 1
					fi
					[ "$1" = "--answer" ] && answerTyped="$2" || answerWords="$2"
					shift 2
				;;
				--reject) answerMode="reject" ; shift ;;
				*)
					echo "⛔ ERROR: $MDSC_CMD $answerOp: syntax is $answerSyntax, got: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if { [ -z "$answerTyped" ] && [ -z "$answerMode" ] ; } || { [ -n "$answerTyped" ] && [ -n "$answerMode" ] ; } ; then
			echo "⛔ ERROR: $MDSC_CMD $answerOp: syntax is $answerSyntax, with --answer or --reject, one of them" >&2
			set +e ; return 1
		fi
		AgentsToolsManagerPendingOpen "$answerOp" || { set +e ; return 1 ; }
		## A request for the authority is answered by whom it asks, its answer acting on what it asked for.
		if [ -n "$( AgentsToolsEscalationField "$managerPendingFile" request-of )" ] ; then
			AgentsToolsAuthorityRequestAnswer "$managerPendingFile" "${answerTyped:-deny}" || { set +e ; return 1 ; }
			return 0
		fi
		if [ -n "$answerMode" ] ; then
			answerTyped="$( AgentsToolsManagerPendingReject "$managerPendingFile" )"
			if [ -z "$answerTyped" ] ; then
				echo "⛔ ERROR: $MDSC_CMD $answerOp: $managerPendingId is a $( AgentsToolsEscalationField "$managerPendingFile" kind ) with no negative answer of its own, so it takes no reject -- nothing was done; answer it, or dismiss it" >&2
				set +e ; return 1
			fi
		fi
		answerAs="$( AgentsToolsManagerPendingStanding "$managerPendingFile" )" || { AgentsToolsManagerPendingNobody "$answerOp" ; set +e ; return 1 ; }
		## A verdict that is the human-owner's own is not given in another's name.
		answerWord="$answerTyped"
		AgentsToolsManagerPendingPlain "$managerPendingFile" || answerWord="$( AgentsToolsEscalationTypedVerdict "$managerPendingFile" "$answerTyped" )"
		if [ "$( AgentsToolsManagerPendingOutcome "$managerPendingFile" "$answerAs" "${answerWord%% -- *}" )" = "not-taken" ] ; then
			echo "⛔ ERROR: $MDSC_CMD $answerOp: $managerPendingId is a $( AgentsToolsEscalationField "$managerPendingFile" kind ), whose verdict is the human-owner's own, and an answer from the console stands as $answerAs's -- nothing was done; it stays open for $( AgentsToolsEscalationField "$managerPendingFile" address-to )" >&2
			set +e ; return 1
		fi
		## THE AUTHORITY over the run that asked it (F6.10): its reports-to, the owners role, or a grant
		## of it -- asked only of an answer the question takes, so a wrong one is refused as one.
		if AgentsToolsManagerPendingPlain "$managerPendingFile" || [ -n "${answerWord%% -- *}" ] ; then
			local answerAsker="" answerAskerRecord=""
			answerAsker="$( AgentsToolsEscalationField "$managerPendingFile" session-id )"
			type AgentsToolsSessionRunRecord > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SpawnSandbox.include"
			answerAskerRecord="$( AgentsToolsSessionRunRecord "$answerAsker" )" || answerAskerRecord=""
			AgentsToolsAuthorityGate "answer question $managerPendingId with $( [ -n "$answerMode" ] && printf 'its reject' || printf '%s' "$answerTyped" )" "$managerPendingId" "$answerAskerRecord" "$managerPendingFile" console \
				"$answerOp" --id "$managerPendingId" $( [ -n "$answerMode" ] && printf -- '--reject' ) ${answerTyped:+--answer "$answerTyped"} ${answerWords:+--text "$answerWords"} || :
			AgentsToolsAuthorityExit || { set +e ; return "$agentsAuthorityExit" ; }
			[ -z "$( AgentsToolsAuthorityChosen )" ] || { answerTyped="$( AgentsToolsAuthorityChosen )" ; answerMode="" ; }
		fi
		answerAccount="$( AgentsToolsManagerPendingAccount )"
		## Recorded as the person at the console; what an allow may reach is the coordinator's holding, named to the apply (agentsEscalationCapacity).
		answerOut="$( agentsEscalationCapacity="$( AgentsToolsManagerPendingHolder "$managerPendingFile" )"
			. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.MemberEscalation.include" \
			--manager-pending-reply-answer "$answerAs" "$managerPendingId" "$answerTyped" "$answerWords" "$answerAccount" "$answerMode" )" || answerRc=$?
		case "$answerRc:$answerOut" in
			0:*"ESCALATION: $managerPendingId answered"*)
				answerWords="$( AgentsToolsEscalationField "$managerPendingFile" verdict-text )"
				printf '%s\t%s\t%s\t%s\tconsole:%s\t%s\n' "$( [ -n "$answerMode" ] && printf 'rejected' || printf 'answered' )" "$managerPendingId" \
					"$( AgentsToolsEscalationField "$managerPendingFile" verdict )" "$answerAs" "$answerAccount" "${answerWords:--}"
				return 0
			;;
			0:*"ESCALATION: $managerPendingId rerouted"*)
				printf 'up-the-chain\t%s\t%s\t%s\tconsole:%s\t%s\n' "$managerPendingId" "$( AgentsToolsEscalationField "$managerPendingFile" address-to )" "$answerAs" "$answerAccount" \
					"$( AgentsToolsEscalationField "$managerPendingFile" reroute-reason )"
				return 0
			;;
		esac
		## Not applied: why, as the apply said it, and the question as it stands.
		printf '%s\n' "$answerOut" | LC_ALL=C sed -n 's/^VERDICT-REASON: /⛔ ERROR: not applied: /p' >&2
		set +e ; return 1
	;;

	## One open question closed with no answer, from the console: the withdraw every asker has
	## for its own question, done here for any member's, with an optional reason. One row.
	--manager-pending-reply-dismiss)
		local dismissOp="$1" dismissSyntax="--id <pending-id> [--reason <text>]" dismissReason="" dismissAccount dismissOut="" dismissRc=0
		shift
		AgentsToolsManagerPendingRecord "$dismissOp" "$dismissSyntax" "$@" || { set +e ; return 1 ; }
		type AgentsToolsAuthorityGate > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.Authority.include"
		AgentsToolsAuthorityFlags "${managerPendingRest[@]}" || { set +e ; return 1 ; }
		set -- "${agentsAuthorityRest[@]}"
		while [ $# -gt 0 ] ; do
			case "$1" in
				--reason)
					if [ $# -lt 2 ] ; then
						echo "⛔ ERROR: $MDSC_CMD $dismissOp: --reason needs a text -- syntax is $dismissSyntax" >&2
						set +e ; return 1
					fi
					dismissReason="$2" ; shift 2
				;;
				*)
					echo "⛔ ERROR: $MDSC_CMD $dismissOp: syntax is $dismissSyntax, got: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		AgentsToolsManagerPendingOpen "$dismissOp" || { set +e ; return 1 ; }
		## THE AUTHORITY over the run that asked it -- except a run already ended by a kill, which
		## an authorised kill of it finishes by dismissing its questions (AgentsToolsManagerSessionFinish).
		local dismissAsker="" dismissAskerRecord=""
		dismissAsker="$( AgentsToolsEscalationField "$managerPendingFile" session-id )"
		type AgentsToolsSessionRunRecord > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SpawnSandbox.include"
		dismissAskerRecord="$( AgentsToolsSessionRunRecord "$dismissAsker" )" || dismissAskerRecord=""
		if [ -z "$dismissAskerRecord" ] || [ -z "$( AgentsToolsEscalationField "$dismissAskerRecord" killed-by )" ] ; then
			AgentsToolsAuthorityGate "dismiss question $managerPendingId" "$managerPendingId" "$dismissAskerRecord" "" console \
				"$dismissOp" --id "$managerPendingId" --reason "$dismissReason" || :
			AgentsToolsAuthorityExit || { set +e ; return "$agentsAuthorityExit" ; }
		fi
		dismissAccount="$( AgentsToolsManagerPendingAccount )"
		dismissOut="$( . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.MemberPendingReply.include" \
			--manager-pending-reply-dismiss "$dismissAccount" "$managerPendingId" --reason "$dismissReason" )" || dismissRc=$?
		case "$dismissRc:$dismissOut" in
			0:*"WITHDRAWN $managerPendingId"*)
				printf 'dismissed\t%s\tconsole:%s\t%s\n' "$managerPendingId" "$dismissAccount" "$( printf '%s' "${dismissReason:--}" | LC_ALL=C tr '\t\r\n' '   ' )"
				return 0
			;;
		esac
		echo "⛔ ERROR: $MDSC_CMD $dismissOp: $managerPendingId was not dismissed, and stays as it was" >&2
		set +e ; return 1
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
