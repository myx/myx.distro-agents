#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.ManagerConfig.include -- the --manager-config-* operations: the console's own
## view of the settings of this workspace, as they are. Sourced from the `--manager-config-*)`
## arm of AgentsTools.Manager.include; who may call was asked where the family is dispatched.
##
## FOR VIEWING, but for one operation. The digest writes nothing: no setting, no registry,
## no file. --manager-config-set saves one changeable setting, a declared one, and nothing
## else. The declarations, the readers and the writers the two operations share are
## AgentsTools.ManagerSettings.include, loaded here before the arm runs.
##

type AgentsToolsManagerConfigKeySecret > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/manager/AgentsTools.ManagerSettings.include"

case "$1" in

	--manager-config-digest)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/manager/AgentsTools.OpManagerConfigDigest.include"
	;;

	--manager-config-set)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/manager/AgentsTools.OpManagerConfigSet.include"
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
