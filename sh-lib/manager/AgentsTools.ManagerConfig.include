#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.ManagerConfig.include -- the --manager-config-* operations: the console's own
## view of the settings of this workspace, as they are. Sourced from the `--manager-config-*)`
## arm of AgentsTools.Manager.include; who may call was asked where the family is dispatched.
##
## FOR VIEWING, but for one operation. The digest writes nothing: no setting, no registry,
## no file. --manager-config-set saves one changeable setting, a declared one, and nothing
## else (THE CHANGEABLE SETTINGS, below). A value is read by
## the setting reader of the sibling package, one key a call (LocalTools.Config.include, as
## AgentsContext.UseAgentsTools.include reads the team data directory), and the names of a
## scope's keys by the names-only reader (AgentsToolsScopeKeyNames). The form of the setting
## reader that prints every line of a scope prints a secret like any value: it is never
## called here.
##
## A CREDENTIAL IS PRINTED IN ONE FORM, the first quarter of its value and a `*` for the rest
## (AgentsToolsCredentialShown, AgentsTools.CredentialDisplay.include): in a row, in a message and
## in a file. Its line says that it is set, with that form as its value, or that it is not.
## A password inside a URL is masked alone (AgentsToolsCredentialUrlShown) in the settings views of the
## console only, which read the digest in full; everywhere else the mask is per key.
##
## WHICH KEY IS A CREDENTIAL. This plugin enumerates them, in the one place
## AgentsToolsManagerConfigKeySecret: the keys the catalogue of the owner setup marks secret
## (AgentsToolsOwnerSetupOptionSpec) and the credentials the harness legs read. Every other key
## shows its value as it is.
##

## Where an inbox item lives (F4.3).
type AgentsToolsInboxDir > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/inbox/AgentsTools.InboxPlace.include"

type AgentsToolsOwnerSetupOptionSpec > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/config/AgentsTools.OwnerSetupOptionSpec.include"
type AgentsToolsCredentialShown > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/config/AgentsTools.CredentialDisplay.include"
type AgentsToolsPlacesListText > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.Places.include"
type AgentsToolsCliServiceWaitRound > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsTools.CliService.include"
type AgentsToolsScopeKeyNames > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.MemberWorkspace.include"

## The subjects of the digest, in the order a person looks for them, which is the order
## they are printed in whatever the order they are asked in.
agentsManagerConfigSubjects="workspace cli systems loop scopes interface console control knowledge"

## THE LABELS: what a screen calls each subject and each line, and what it says of a line, in
## the one declaration of them. One row on a line of its own,
## `<subject>|<group>|<key>|<label>|<belongs>|<description>`:
##   a row with no group and no key names the subject itself, and has no more than its label;
##   a row with a group and no key names that group, for the row the digest in full gives
##   each group ahead of its lines, and has no more than its label either: capitalised words,
##   more than one, where the group is a word of this file's, and `{name}`, the group as it
##   is written, where the group is a name, a CLI's, a system's, a scope's. A group that no
##   such row fits gets the label `-`, and AgentsManagerConfigDigestCheck fails on it;
##   <group> and <key> name a line as the digest prints it, an absent key as `-`. `*` stands
##   for any, and a word that ends with `*` for every word that begins so. The first row that
##   fits a line names it, so the row of one key stands ahead of a row for any;
##   <label> is capitalised words, more than one, never the bare key. `{words}` in it stands
##   for the words of the key itself, capitalised, with `Setting` after a key of one word;
##   `{name}` for the key as it stands, where the key is a name: a place's, a scope's;
##   <belongs> is which of the two a line is. `settings`: what a user sets for himself in
##   this workspace, and what may be changed while things run and is read by itself at its
##   next use; each of them is a row of THE CHANGEABLE SETTINGS. `configuration`: what is
##   deployed and configured for the workspace or the machine, and everything measured; no
##   such line is changed from a console now, a wizard will change it;
##   <description> is one or two plain sentences: what the line is, and what changes it or
##   what a change of it does. NEVER A VALUE IN IT, and nothing of a secret: no digit, no
##   path, no assignment.
## A row for any key is for lines whose keys are not this file's: the places registered, the
## scopes and their keys, the credentials a harness leg declares, what the main loop left in
## its state file. Every line this file prints under a key of its own has a row of its own,
## so a new one cannot come without its label and its description: a line that no row fits
## gets `-` for both, and AgentsManagerConfigDigestCheck fails on it.
agentsManagerConfigLabels="workspace|||Workspace Paths||
workspace|paths||Workspace Folders||
workspace|places||Registered Places||
workspace|mode||Workspace Role||
workspace|paths|workspace-root|Workspace Root|configuration|The root folder of this workspace, which every path of the tooling starts from. It is where the workspace was installed.
workspace|paths|tooling-origin|Tooling Origin|configuration|The source tree the tooling runs from. It follows the console origin of the workspace, at the next start of a console.
workspace|paths|team-data-root|Team Data Root|configuration|The folder that holds the board and the inboxes of the team. It follows the team data directory the owner setup saves.
workspace|paths|session-records|Session Records|configuration|The folder the record of every started run is kept in. The tooling makes it at the first start of a run.
workspace|paths|session-stores|Session Stores|configuration|The folder each session keeps its own store in. The tooling makes it at the first session.
workspace|paths|settings|Scope Settings Folder|configuration|The folder that holds one settings file for each scope, the team's and each member's. Only its owner and its group can read it.
workspace|mode|MDAT_WORKSPACE_MODE|Workspace Mode|configuration|What this workspace is to the team. Just agents: it works inline and can start sessions with the native consoles of this computer, but keeps no documents, no reflections and the like. Remote rig client: it will start sessions on a remote rig or dispatch documents to it; that is not built yet, so it acts as just agents for now. Team rig: it is a rig itself, which uses and maintains the team data here, with a shared persistence for it or none. The installer of the workspace sets it in the settings of the team, and where nothing sets it the workspace is just agents.
workspace|mode|full-team-rig|Full Team Rig|configuration|Whether this workspace is a full team rig: a team rig whose team data has a shared persistence configured, today a git remote. Only a full team rig checks the team data and the main loop and judges them. It is measured at the call.
workspace|places|*|Registered Place {name}|configuration|The path of the place registered under this name. A place is registered and forgotten by the owner's own operations, or declared by a project.
cli|||CLI Services||
cli|workspace||Workspace Defaults||
cli|*||{name}||
cli|workspace|SPAWN_CLI_SERVICE|Spawn CLI Service|configuration|The agent CLI this workspace starts for a member and for the console. A change reaches every next start, so it is made by the owner setup.
cli|workspace|SPAWN_HARNESS_TIER|Spawn Harness Tier|configuration|The tier a harness leg is asked for at a start. What it may be is each leg's own, so it is set by the owner setup.
cli|workspace|WAIT_ROUND_SECONDS|Wait Round Seconds|configuration|How long a wait that brings nothing runs before it comes back, for every CLI service. A round longer than a CLI allows ends the waits of running sessions, so it is set by the owner setup.
cli|workspace|WAIT_COLLECT_SECONDS|Wait Collect Seconds|configuration|How long the work-duty input scan collects the team channel before it returns, in seconds. A tagged message ends the collect at once. A minute when it is not set.
cli|workspace|spawn-settings-workspace|Spawn Settings Workspace|configuration|The workspace the spawn settings are read from. It is found at the call, from the settings of the team.
cli|*|present|CLI Present|configuration|Whether this vendor CLI is on the machine, with the path of its binary. It is measured at the call.
cli|*|usable|CLI Usable|configuration|Whether a start on this CLI can work: a harness leg with one of its credentials set, a vendor CLI where its binary is. It is measured at the call.
cli|*|wait-round|CLI Wait Round|configuration|How long a wait runs on this CLI before it comes back, in seconds: the round of the workspace where one is set, else the CLI's own.
cli|*|*|{words}|configuration|A credential the harness leg of this CLI reads. If it is set, its first quarter is shown and the rest is masked. The owner setup saves it.
systems|||Outside Systems||
systems|*||{name}||
systems|*|-|No Scope Configured|configuration|No scope of this workspace holds a setting of this system, so no member reaches it from here.
systems|*|*|Scope {name}|configuration|Whether this scope holds the settings of this system, with the keys it still lacks. The owner setup saves the settings themselves.
loop|||Main Loop And Heartbeat||
loop|main-loop||Main Loop State||
loop|heartbeat||Heartbeat State||
loop|main-loop|state-file|Main Loop State File|configuration|The file the main loop leaves after every iteration. It says how the last one ended and when.
loop|main-loop|MAIN_LOOP_*|{words}|configuration|What the last iteration of the main loop left in its state file. The loop writes it, and nothing reads a change made by hand.
loop|heartbeat|state-note|Heartbeat State Note|configuration|The note the heartbeat keeps in the team data, with its lock.
loop|heartbeat|state|Heartbeat State|configuration|The state the heartbeat wrote into its note at its last turn.
loop|heartbeat|recheck-date|Heartbeat Recheck Date|configuration|The date until which the lock of the heartbeat holds. The heartbeat moves it at every turn.
loop|heartbeat|last-iteration-timestamp|Heartbeat Last Iteration|configuration|When the heartbeat last finished a turn of its own.
loop|heartbeat|running|Heartbeat Running|configuration|Whether the heartbeat runs now: its note says so and its lock is still held.
scopes|||Scope Settings||
scopes|*||{name}||
scopes|*|*|{words}|configuration|A setting of this scope, saved in its own settings file. The owner setup saves it, and a credential among them shows its first quarter and masks the rest.
interface|||Interface Settings||
interface|style||Screen Style||
interface|style|MDAT_MANAGER_STYLE|Interface Style|settings|How the manager screen is drawn: its windows, its frames and its colours. A change is the look of the screen at its next start, for this user in this workspace.
console|||Console Behaviour||
console|history||Shell History||
console|origin||Tooling Origin||
console|detail||Tool Verbosity||
console|history|MDLT_CONSOLE_HISTORY|Console History Type|settings|Where a console of this workspace keeps the shell history of this user. A change is read by each console at its next start, and what a console wrote already stays in the file it wrote.
console|origin|MDLT_CONSOLE_ORIGIN|Console Tooling Origin|settings|Which code every console of this workspace runs, from its next start: its own installed copy, or the tooling of a workspace that has it. A console and a session that run already keep what they started with, and it is changed for everybody who works here. An origin whose tooling is older or broken can leave every console of this workspace unable to start, the manager among them: then take the line of this key out of the settings file of the workspace by hand.
console|detail|MDLT_CONSOLE_DETAIL|Console Verbosity|settings|How much the tools say of what they do in a console this user starts: nothing more, each step, or every detail for finding a fault. It is read at the next start of a console, and today by the agents console alone: the other consoles of the family do not read it yet.
control|||Session Control||
control|request||Control Request||
control|kill||Control Kill||
control|request|SESSION_CONTROL_REQUEST_SECONDS|Control Request Seconds|settings|How many seconds a console waits for the control thread of a session to take a request. After that the console takes the request back and carries it out itself, and a change is read at the next request.
control|kill|SESSION_CONTROL_KILL_SECONDS|Control Kill Seconds|settings|How many seconds the carrying out of a kill request may take before it ends its own work. A change is read at the next request, by the console and by the control thread.
knowledge|||Knowledge Store||
knowledge|store||Store Switch||
knowledge|store|MDAT_KNOWLEDGE_STORE|Knowledge Store Switch|settings|Whether this workspace keeps a vector store of what the team knows, in addition to its MAGIC.md files. It is off unless it is turned on. The installer of the knowledge store makes the environment the store needs, from binary packages, and where that cannot be done the store stays off and the Knowledge tool reads MAGIC.md alone. A change is read at the next use."

## THE MODE OF THE WORKSPACE, the owner's: what this workspace is to the team, one of
## three, set by the installer of the workspace in the settings of the team, where the
## tooling keeps the workspace's own settings (AgentsToolsManagerConfigTeamFile), and read
## by AgentsToolsManagerConfigMode alone. `just-agents`: it works inline and can start
## sessions with the native consoles of this computer, but keeps no documents, no
## reflections and the like. `rig-client`: it will start sessions on a remote rig or
## dispatch documents to it; declared and not built, it acts as `just-agents`. `team-rig`:
## it is a rig itself, which uses and maintains the team data here, with a shared
## persistence for it or none; no server setup makes one so, its installer does. Where
## nothing sets one of them it is `just-agents`: nothing is inferred. A FULL TEAM RIG is a
## `team-rig` whose team data has a shared persistence configured, today a git remote:
## only a full team rig checks the main loop and judges it. Only a team rig has a main
## loop at all. What `just-agents` does not do is its meaning here, and nothing more yet.
agentsManagerConfigModeKey="MDAT_WORKSPACE_MODE"
agentsManagerConfigModes="just-agents rig-client team-rig"
agentsManagerConfigModeTakes="just-agents=Just Agents,rig-client=Remote Rig Client,team-rig=Team Rig"

## The words of a key that stand whole in capitals in a label made of the key's own words.
agentsManagerConfigLabelCapitals="API CLI ID IMAP SMTP URL UTC XAI"

## The credentials a harness leg declares for itself, as words, from the file of that leg.
AgentsToolsManagerConfigLegKeys(){ ## leg file
	LC_ALL=C sed -n 's/^HARNESS_CREDENTIAL_NAMES=//p' "$1" 2> /dev/null | LC_ALL=C tr -c 'A-Z0-9_' ' ' || :
}

## Whether a key is a credential: rc 0 when it is, rc 1 when it is not.
##   a key the catalogue marks secret is one;
##   so is a key a harness leg declares among the credentials it reads (read once, then kept);
##   every other key is none, and shows its value.
AgentsToolsManagerConfigKeySecret(){ ## key
	local secretSpec secretFile secretLegs=""
	secretSpec="$( AgentsToolsOwnerSetupOptionSpec "$1" )" || secretSpec=""
	if [ -n "$secretSpec" ] ; then
		secretSpec="${secretSpec#*|}" ; secretSpec="${secretSpec#*|}"
		[ "${secretSpec%%|*}" != "secret" ] || return 0
	fi
	if [ -z "${agentsManagerConfigLegKeys+x}" ] ; then
		for secretFile in "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/"Agents*Harness.sh ; do
			secretLegs="$secretLegs $( AgentsToolsManagerConfigLegKeys "$secretFile" )"
		done
		agentsManagerConfigLegKeys="$secretLegs "
	fi
	case "$agentsManagerConfigLegKeys" in *" $1 "*) return 0 ;; esac
	return 1
}

## One value of one scope of this workspace, by the setting reader of the sibling package:
## the last line that sets the key, and nothing where none does.
AgentsToolsManagerConfigValue(){ ## scope, key
	(
		set -- --agents-config-option "$1" --select "$2"
		. "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/LocalTools.Config.include"
	) 2> /dev/null || :
}

## Whether a scope of this workspace holds a value under a key: rc 0 when it does. The value
## goes through a pipe and into no variable, so a secret asked for here is held nowhere.
AgentsToolsManagerConfigHolds(){ ## scope, key
	AgentsToolsManagerConfigValue "$1" "$2" | LC_ALL=C grep -q .
}

## The value of a spawn setting: asked of the dispatcher's own operation, so it is read from
## the workspace named to pay where one is (AgentsToolsConfigOptionElsewhere).
AgentsToolsManagerConfigSpawnValue(){ ## key
	DistroAgentsTools --agents-config-option magic-team --select "$1" 2> /dev/null || :
}

## The keys the catalogue of the owner setup holds, one a line, in its own order: the labels
## of its arms, read from the catalogue itself, which has no list of them beside its arms.
AgentsToolsManagerConfigCatalogueKeys(){
	LC_ALL=C sed -n 's/^		\([A-Z][A-Z0-9_]*\))$/\1/p' "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/config/AgentsTools.OwnerSetupOptionSpec.include" 2> /dev/null || :
}

## The scopes of this workspace, one a line: each scope file, by its name, whether it holds
## a key or not.
AgentsToolsManagerConfigScopeNames(){
	local scopeFile
	for scopeFile in "${MMDAPP%/}/.local/.agents"/*.agent.env ; do
		[ -f "$scopeFile" ] || continue
		scopeFile="${scopeFile##*/}"
		printf '%s\n' "${scopeFile%.agent.env}"
	done
	return 0
}

## The keys a scope of this workspace holds whose names begin with a prefix, one a line,
## each once, in the order of its file: names only, by the names-only reader. A line that is
## a comment is no key, as the setting reader takes it. And only the name of a setting is a
## key here, capital letters, digits and `_` after a first letter: what stands ahead of the
## `=` of any other line may be anything, a secret pasted with an `=` in it among them, so
## such a line is never listed. With `say` their count is noted, by scope, never by text.
AgentsToolsManagerConfigScopeKeys(){ ## scope, key prefix (may be empty), `say` to note the lines left out (may be empty)
	local keysText keysOne keysOdd=0
	keysText="$( AgentsToolsScopeKeyNames "${MMDAPP%/}" "$1" "${2:-}" "" )" || keysText=""
	while [ -n "$keysText" ] ; do
		keysOne="${keysText%%, *}"
		if [ "$keysOne" = "$keysText" ] ; then keysText="" ; else keysText="${keysText#*, }" ; fi
		case "$keysOne" in
			''|'#'*) continue ;;
			[!ABCDEFGHIJKLMNOPQRSTUVWXYZ]*|*[!ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_]*) keysOdd=$(( keysOdd + 1 )) ; continue ;;
		esac
		printf '%s\n' "$keysOne"
	done
	[ "$keysOdd" = 0 ] || [ -z "${3:-}" ] || echo "# $MDSC_CMD --manager-config-digest: the scope '$1' holds $keysOdd line(s) whose name is not a setting's -- capital letters, digits and _ -- so they are not listed" >&2
	return 0
}

## One `line` row. Every field is made one field: a run of whitespace in it reads `_`, and an
## empty one reads `-`, as in a registry. What a subject adds to its lines stands after the
## value, at the end of the row, so whoever reads the first six fields reads them as before.
AgentsToolsManagerConfigLine(){ ## subject, group, key, state, value (may be empty), then the fields a subject adds at the end
	local lineField lineRow="line"
	for lineField in "$1" "$2" "$3" "$4" "${5:-}" "${@:6}" ; do
		while : ; do
			case "$lineField" in
				*[[:space:]][[:space:]]*) lineField="${lineField//[[:space:]][[:space:]]/ }" ;;
				*) break ;;
			esac
		done
		lineField="${lineField//[[:space:]]/_}"
		lineRow="$lineRow	${lineField:--}"
	done
	printf '%s\n' "$lineRow"
}

## The line of a path: set where the path is there, missing where it is not, with the path
## either way.
AgentsToolsManagerConfigPathLine(){ ## subject, group, key, path
	if [ -n "$4" ] && [ -e "$4" ] ; then
		AgentsToolsManagerConfigLine "$1" "$2" "$3" set "$4"
	else
		AgentsToolsManagerConfigLine "$1" "$2" "$3" missing "$4"
	fi
}

## The line of one key of one scope of this workspace: a credential as set, with its value in
## the one form of AgentsToolsCredentialShown, or not set; any other key with its value, and
## missing where it has none. A password inside a URL under such a key is masked alone in the
## digest in full only (digestFull, the arm's): the settings views of the console read it so.

AgentsToolsManagerConfigKeyLine(){ ## subject, group, scope, key
	local keyValue keyShown
	keyValue="$( AgentsToolsManagerConfigValue "$3" "$4" )" || keyValue=""
	if AgentsToolsManagerConfigKeySecret "$4" ; then
		if [ -n "$keyValue" ] ; then
			AgentsToolsManagerConfigLine "$1" "$2" "$4" secret-set "$( AgentsToolsCredentialShown "$keyValue" )"
		else
			AgentsToolsManagerConfigLine "$1" "$2" "$4" secret-missing ""
		fi
		return 0
	fi
	if [ -z "$keyValue" ] ; then
		AgentsToolsManagerConfigLine "$1" "$2" "$4" missing ""
	elif [ -n "${digestFull:-}" ] && keyShown="$( AgentsToolsCredentialUrlShown "$keyValue" )" ; then
		AgentsToolsManagerConfigLine "$1" "$2" "$4" secret-set "$keyShown"
	else
		AgentsToolsManagerConfigLine "$1" "$2" "$4" set "$keyValue"
	fi
}

## Gives the rows of a subject what THE LABELS say of them: reads its `subject` row and its
## `line` rows, and prints each with its label as one more field at its end; with `full`,
## each line in full, with its description, whether it can be changed and which of the two
## it belongs to (AgentsManagerConfigLabels.awk, which says the forms). No subject and no
## line maker knows a label: a row gets its own here, where every row of the digest passes.
AgentsToolsManagerConfigLabelled(){ ## `full` (may be empty)
	{
		printf '%s\n' "$agentsManagerConfigLabels"
		printf '\034\n'
		cat
	} | LC_ALL=C awk -v capitals="$agentsManagerConfigLabelCapitals" -v full="${1:+1}" -v earlier="$agentsManagerConfigEarlierForm" -v deployed="$agentsManagerConfigDeployed" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/manager/AgentsManagerConfigLabels.awk"
}

## THE WORKSPACE AND ITS PATHS: the root of the workspace, the origin the tooling runs from,
## the root of the team data as the context resolved it, the two stores of the sessions, the
## folder of the scopes; then each registered place with its path, as --owner-workspace-list
## gives them, one that is absent or not known as missing.
AgentsToolsManagerConfigWorkspace(){
	local placeName placeKind placeCeiling placePath placeState modeValue modeSource modeFull
	AgentsToolsManagerConfigPathLine workspace paths workspace-root "${MMDAPP%/}"
	AgentsToolsManagerConfigPathLine workspace paths tooling-origin "${MDLT_ORIGIN%/}"
	AgentsToolsManagerConfigPathLine workspace paths team-data-root "${MDAT_DATA_ROOT:-}"
	AgentsToolsManagerConfigPathLine workspace paths session-records "${MMDAPP%/}/.local/agents/spawned"
	AgentsToolsManagerConfigPathLine workspace paths session-stores "${MMDAPP%/}/.local/agents/sessions"
	AgentsToolsManagerConfigPathLine workspace paths settings "${MMDAPP%/}/.local/.agents"
	## The mode, with where it comes from, what it takes, its kind, its scope and its file, as
	## a changeable line has them; it belongs to the configuration all the same.
	read -r modeValue modeSource modeFull <<< "$( AgentsToolsManagerConfigMode )" || :
	AgentsToolsManagerConfigLine workspace mode "$agentsManagerConfigModeKey" set "${modeValue:-just-agents}" "${modeSource:-default}" "$agentsManagerConfigModeTakes" choice workspace "$( AgentsToolsManagerConfigTeamFile )"
	if [ "$modeFull" = "yes" ] ; then
		AgentsToolsManagerConfigLine workspace mode full-team-rig set yes
	else
		AgentsToolsManagerConfigLine workspace mode full-team-rig missing no
	fi
	while IFS='	' read -r placeName placeKind placeCeiling placePath placeState ; do
		[ -n "$placeName" ] || continue
		[ "$placePath" != "-" ] || placePath=""
		if [ "$placeState" = "present" ] ; then
			AgentsToolsManagerConfigLine workspace places "$placeName" set "$placePath"
		else
			AgentsToolsManagerConfigLine workspace places "$placeName" missing "$placePath"
		fi
	done <<< "$( AgentsToolsPlacesListText "${MMDAPP%/}" )"
	return 0
}

## The mode of this workspace, `<mode> <source> <full>`: the mode the settings of the team
## set, `workspace`, else `just-agents`, `default` (THE MODE OF THE WORKSPACE); and `yes`
## where it is a full team rig, a `team-rig` whose team data has a git remote, else `no`. Whether
## the remote is set is asked through a pipe that keeps no text of it, of the scope the
## catalogue of the owner setup names for it.
AgentsToolsManagerConfigMode(){
	local modeValue modeSource="workspace" modeFull="no" modeSpec
	modeValue="$( AgentsToolsManagerConfigTeamValue "$agentsManagerConfigModeKey" )" || modeValue=""
	case " $agentsManagerConfigModes " in
		*" ${modeValue:-.} "*) ;;
		*) modeValue="just-agents" ; modeSource="default" ;;
	esac
	if [ "$modeValue" = "team-rig" ] ; then
		modeSpec="$( AgentsToolsOwnerSetupOptionSpec TEAM_DATA_GIT_REMOTE 2> /dev/null )" || modeSpec=""
		[ -z "$modeSpec" ] || ! AgentsToolsManagerConfigHolds "${modeSpec%%|*}" TEAM_DATA_GIT_REMOTE || modeFull="yes"
	fi
	printf '%s %s %s\n' "$modeValue" "$modeSource" "$modeFull"
}

## THE CLI SERVICES. First what the workspace asks for: its service, its harness tier, its
## one wait round for every service, and the workspace its spawn settings are read from.
## Then each CLI the console knows, by the console's own declaration, and each harness leg
## beside them: of a vendor CLI whether it is present, by its binary, and of a leg nothing
## such, since it lies in sh-lib beside the tooling (the owner: "it is always present it is in
## sh-lib"); the credentials a leg declares for itself, each set, in the one form of a credential, or not; whether it is
## usable, which a leg is with one of its credentials set and a vendor CLI where its binary
## is, since it works off the sign-in of the machine; and its wait round.
AgentsToolsManagerConfigCli(){
	local cliHere="$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib" cliKnown cliVendor cliLegs="" cliLeg cliName cliFile cliKey cliKeys cliValue cliPath cliUsable
	for cliKey in SPAWN_CLI_SERVICE SPAWN_HARNESS_TIER WAIT_ROUND_SECONDS WAIT_COLLECT_SECONDS ; do
		cliValue="$( DistroAgentsTools --agents-config-option magic-team --select "$cliKey" 2> /dev/null )" || cliValue=""
		if [ -n "$cliValue" ] ; then
			AgentsToolsManagerConfigLine cli workspace "$cliKey" set "$cliValue"
		else
			AgentsToolsManagerConfigLine cli workspace "$cliKey" missing ""
		fi
	done
	if cliPath="$( AgentsToolsSpawnSettingsWorkspace 2> /dev/null )" ; then
		AgentsToolsManagerConfigLine cli workspace spawn-settings-workspace set "${cliPath:-${MMDAPP%/}}"
	else
		AgentsToolsManagerConfigLine cli workspace spawn-settings-workspace missing ""
	fi
	cliKnown="$( LC_ALL=C sed -n 's/^DAGC_KNOWN_CLIS="\(.*\)"$/\1/p' "$cliHere/manager/AgentsConsoleShellScript.template.sh" 2> /dev/null )" || cliKnown=""
	cliVendor="$( LC_ALL=C sed -n 's/^DAGC_VENDOR_CLIS="\(.*\)"$/\1/p' "$cliHere/manager/AgentsConsoleShellScript.template.sh" 2> /dev/null )" || cliVendor=""
	## A harness leg is a file that declares its provider, and its name is that file's, in
	## small letters: one the console's list does not name yet stands after it, as in the
	## console. Name and file are kept two lines a leg, since a path may hold any separator.
	for cliFile in "$cliHere/harness/"Agents*Harness.sh ; do
		[ -f "$cliFile" ] || continue
		LC_ALL=C grep -q '^HARNESS_PROVIDER_NAME=' "$cliFile" || continue
		cliName="${cliFile##*/Agents}"
		cliName="$( printf '%s' "${cliName%Harness.sh}" | LC_ALL=C tr 'A-Z' 'a-z' )"
		cliLegs="$cliLegs$cliName"$'\n'"$cliFile"$'\n'
		case " $cliKnown " in *" $cliName "*) ;; *) cliKnown="$cliKnown${cliKnown:+ }$cliName" ;; esac
	done
	for cliName in $cliKnown ; do
		cliKeys="" ; cliUsable="no" ; cliFile="" ; cliLeg=""
		## A vendor name is never a leg's: it means the vendor's own binary, named without -native.
		case " $cliVendor " in
			*" $cliName "*) ;;
			*)
				while IFS= read -r cliPath ; do
					if [ -z "$cliLeg" ] ; then cliLeg="$cliPath" ; continue ; fi
					[ "$cliLeg" != "$cliName" ] || cliFile="$cliPath"
					cliLeg=""
				done <<< "$cliLegs"
			;;
		esac
		if [ -n "$cliFile" ] ; then
			cliKeys="$( AgentsToolsManagerConfigLegKeys "$cliFile" )" || cliKeys=""
			case "$cliKeys" in *[!\ ]*) ;; *) cliUsable="yes" ;; esac
			for cliKey in $cliKeys ; do
				cliValue="$( AgentsToolsManagerConfigSpawnValue "$cliKey" )"
				if [ -n "$cliValue" ] ; then
					AgentsToolsManagerConfigLine cli "$cliName" "$cliKey" secret-set "$( AgentsToolsCredentialShown "$cliValue" )"
					cliUsable="yes"
				else
					AgentsToolsManagerConfigLine cli "$cliName" "$cliKey" secret-missing ""
				fi
			done
		elif cliPath="$( command -v "${cliName%-native}" 2> /dev/null )" && [ -n "$cliPath" ] ; then
			AgentsToolsManagerConfigLine cli "$cliName" present set "$cliPath"
			cliUsable="yes"
		else
			AgentsToolsManagerConfigLine cli "$cliName" present missing ""
		fi
		if [ "$cliUsable" = "yes" ] ; then
			AgentsToolsManagerConfigLine cli "$cliName" usable set yes
		else
			AgentsToolsManagerConfigLine cli "$cliName" usable missing no
		fi
		AgentsToolsManagerConfigLine cli "$cliName" wait-round set "$( AgentsToolsCliServiceWaitRound "$cliName" )"
	done
	return 0
}

## THE OUTSIDE SYSTEMS, the team's own Slack first: the systems a member's settings are
## named after (agentsMemberSettingSystems), each one group. One line a scope: each scope
## the catalogue keeps a key of the system in, then each other scope that holds a key of it.
## The line reads set where the scope holds a value under a key of the system, and missing
## where it holds none; its value names what is lacking there, by key: each key of the
## catalogue for that scope with no value, then each key the scope holds with none. A
## system with no line of a scope has one line under no scope, missing. The catalogue is the
## only list of the keys a system needs, and it holds the team's own: what a member's scope
## lacks of a system beyond its empty keys is not known here, and not said.
AgentsToolsManagerConfigSystems(){
	local sysName sysGroup sysScope sysScopes sysCatalogue="" sysKey sysSpec sysKeys sysSeen sysLacking sysHolds sysAny
	while IFS= read -r sysKey ; do
		[ -n "$sysKey" ] || continue
		sysSpec="$( AgentsToolsOwnerSetupOptionSpec "$sysKey" )" || sysSpec=""
		## An entry of scope `-` belongs to no one scope: it is no key the team's scope lacks.
		[ -z "$sysSpec" ] || [ "${sysSpec%%|*}" = "-" ] || sysCatalogue="$sysCatalogue$sysKey ${sysSpec%%|*}"$'\n'
	done <<< "$( AgentsToolsManagerConfigCatalogueKeys )"
	for sysName in $agentsMemberSettingSystems ; do
		sysGroup="$( printf '%s' "$sysName" | LC_ALL=C tr 'A-Z' 'a-z' )"
		sysScopes=""
		while read -r sysKey sysScope ; do
			case "$sysKey" in "$sysName"_*) ;; *) continue ;; esac
			case $'\n'"$sysScopes" in *$'\n'"$sysScope"$'\n'*) ;; *) sysScopes="$sysScopes$sysScope"$'\n' ;; esac
		done <<< "$sysCatalogue"
		while IFS= read -r sysScope ; do
			[ -n "$sysScope" ] || continue
			case $'\n'"$sysScopes" in *$'\n'"$sysScope"$'\n'*) continue ;; esac
			! AgentsToolsScopeHoldsKeys "${MMDAPP%/}" "$sysScope" "${sysName}_" || sysScopes="$sysScopes$sysScope"$'\n'
		done <<< "$( AgentsToolsManagerConfigScopeNames )"
		sysAny="false"
		while IFS= read -r sysScope ; do
			[ -n "$sysScope" ] || continue
			sysAny="true" ; sysHolds="false" ; sysLacking="" ; sysKeys="" ; sysSeen=$'\n'
			while read -r sysKey sysSpec ; do
				case "$sysKey" in "$sysName"_*) ;; *) continue ;; esac
				[ "$sysSpec" = "$sysScope" ] || continue
				sysKeys="$sysKeys$sysKey"$'\n'
			done <<< "$sysCatalogue"
			sysKeys="$sysKeys$( AgentsToolsManagerConfigScopeKeys "$sysScope" "${sysName}_" )"
			while IFS= read -r sysKey ; do
				[ -n "$sysKey" ] || continue
				case "$sysSeen" in *$'\n'"$sysKey"$'\n'*) continue ;; esac
				sysSeen="$sysSeen$sysKey"$'\n'
				if AgentsToolsManagerConfigHolds "$sysScope" "$sysKey" ; then
					sysHolds="true"
				else
					sysLacking="$sysLacking${sysLacking:+,}$sysKey"
				fi
			done <<< "$sysKeys"
			if [ "$sysHolds" = "true" ] ; then
				AgentsToolsManagerConfigLine systems "$sysGroup" "$sysScope" set "$sysLacking"
			else
				AgentsToolsManagerConfigLine systems "$sysGroup" "$sysScope" missing "$sysLacking"
			fi
		done <<< "$sysScopes"
		[ "$sysAny" = "true" ] || AgentsToolsManagerConfigLine systems "$sysGroup" "" missing ""
	done
	return 0
}

## THE MAIN LOOP AND THE HEARTBEAT, by what the tooling keeps of each. The main loop leaves
## its state file after every iteration, which says how the last one ended and when; no file
## says that a loop runs now, so none is said here. The heartbeat keeps its note in the team
## data, with its lock: it runs while the note reads heartbeat-running and its recheck date
## is not yet a minute past, which is what the lock operations take for a held lock.
AgentsToolsManagerConfigLoop(){
	local loopFile="${MMDAPP%/}/.local/agents/main-loop.state" loopLine loopKey
	local loopNote="$( AgentsToolsInboxDir magic-coordinator )/note-20260809T155000Z-heartbeat-state-and-lock.md"
	local loopState="" loopRecheck="" loopEpoch="" loopRuns="no"
	## Only a team rig runs the main loop: in any other mode nothing of it is said.
	case "$( AgentsToolsManagerConfigMode )" in "team-rig "*) ;; *) return 0 ;; esac
	if [ -f "$loopFile" ] && [ -r "$loopFile" ] ; then
		AgentsToolsManagerConfigLine loop main-loop state-file set "$loopFile"
		while IFS= read -r loopLine || [ -n "$loopLine" ] ; do
			case "$loopLine" in
				MAIN_LOOP_*=?*) AgentsToolsManagerConfigLine loop main-loop "${loopLine%%=*}" set "${loopLine#*=}" ;;
				MAIN_LOOP_*=) AgentsToolsManagerConfigLine loop main-loop "${loopLine%%=*}" missing "" ;;
			esac
		done < "$loopFile"
	else
		AgentsToolsManagerConfigLine loop main-loop state-file missing "$loopFile"
	fi
	if [ -f "$loopNote" ] && [ -r "$loopNote" ] ; then
		AgentsToolsManagerConfigLine loop heartbeat state-note set "$loopNote"
		while IFS= read -r loopLine ; do
			loopKey="${loopLine%%: *}"
			loopLine="${loopLine#"$loopKey": }"
			[ "$loopKey" != "state" ] || loopState="$loopLine"
			[ "$loopKey" != "recheck-date" ] || loopRecheck="$loopLine"
			if [ -n "$loopLine" ] ; then
				AgentsToolsManagerConfigLine loop heartbeat "$loopKey" set "$loopLine"
			else
				AgentsToolsManagerConfigLine loop heartbeat "$loopKey" missing ""
			fi
		done <<< "$( LC_ALL=C awk -v headers="state"$'\034'"recheck-date"$'\034'"last-iteration-timestamp" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsBoardItemFrontmatterPrintSelected.awk" "$loopNote" 2> /dev/null )"
		if [ "$loopState" = "heartbeat-running" ] && [ -n "$loopRecheck" ] ; then
			loopEpoch="$( printf '%s\n' "$loopRecheck" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/output/LocalIsoToEpoch.awk" 2> /dev/null )" || loopEpoch=""
			case "$loopEpoch" in
				''|*[!0123456789]*) ;;
				*) [ "$(( $( date +%s ) - loopEpoch ))" -ge 60 ] || loopRuns="yes" ;;
			esac
		fi
	else
		AgentsToolsManagerConfigLine loop heartbeat state-note missing "$loopNote"
	fi
	if [ "$loopRuns" = "yes" ] ; then
		AgentsToolsManagerConfigLine loop heartbeat running set yes
	else
		AgentsToolsManagerConfigLine loop heartbeat running missing no
	fi
	return 0
}

## THE SCOPES WITH THEIR KEYS: each scope of this workspace that holds a key, one group a
## scope, each key in the order of its file. A scope with no key is left out: the existence
## of a scope file says nothing. A scope file that cannot be read is said, and left out, and
## so is the count of the lines of a scope whose name is not a setting's.
AgentsToolsManagerConfigScopes(){
	local scopesName scopesKey
	while IFS= read -r scopesName ; do
		[ -n "$scopesName" ] || continue
		if [ ! -r "${MMDAPP%/}/.local/.agents/$scopesName.agent.env" ] ; then
			echo "# $MDSC_CMD --manager-config-digest: the scope '$scopesName' cannot be read, so its keys are not listed" >&2
			continue
		fi
		while IFS= read -r scopesKey ; do
			[ -n "$scopesKey" ] || continue
			AgentsToolsManagerConfigKeyLine scopes "$scopesName" "$scopesName" "$scopesKey"
		done <<< "$( AgentsToolsManagerConfigScopeKeys "$scopesName" "" say )"
	done <<< "$( AgentsToolsManagerConfigScopeNames )"
	return 0
}

## THE CHANGEABLE SETTINGS: the declared few a console may change, and no other. They are
## the lines that belong to the `settings` (THE LABELS): what a user sets for himself, and
## what may be changed while things run. One row a setting, on a line of its own, its fields
## parted by `|`:
##   the subject and the group of its line in the digest;
##   its key, under which it is saved;
##   its kind: `choice`, one of the values its row lists; `number`, a whole number from its
##   smallest to its largest;
##   where its value is read, in the order of reading, blanks between: `environment`, the
##   variable of the environment that bears its key; `user`, the settings of the user who
##   runs the call, in this workspace; `system`, the workspace's own settings file, which
##   the consoles read after the user's; `team`, the settings of the team in this workspace.
##   It is saved in the first of `user` and `team` its row names: the user's own scope, or
##   the workspace's, for everybody;
##   its default, the value where nothing sets it;
##   what it takes: for a choice the values in the order they are offered, parted by commas,
##   each `<value>=<label>`; for a number `<smallest>..<largest>`. No value holds a blank,
##   and no value and no label a `,`, a `=` or a `|`.
## Another changeable setting is one more row here, with its row in THE LABELS: the digest
## and the writer go by the rows and know no setting by name. NO SECRET IS KEPT HERE: the
## writer saves nothing but a value that a row takes, so no text of a caller's reaches a file.
## EACH IS HERE BECAUSE the tooling reads it at its next use, a wrong value cannot be saved,
## and no running session is broken by a change:
##   MDAT_MANAGER_STYLE   the user's own: the look of the manager screen at its next start,
##       `<style>-<colours>` (the styles and the colours the screen declares, STYLES and
##       COLOURS in AgentsManagerScreen.py, which AgentsManagerConfigInterfaceCheck holds
##       against this row).
##   MDLT_CONSOLE_HISTORY   the user's own: which history file a console takes at its next
##       start. Every console's rc reads it, the user's own first. An unknown value stops a
##       console, so only its six are taken.
##   SESSION_CONTROL_REQUEST_SECONDS, SESSION_CONTROL_KILL_SECONDS   dynamic: the two bounds
##       of a request to a control thread, read at each request. A value that is no number
##       reads as the default, and a kill never depends on either. Their ranges are set
##       here: the tooling itself reads any whole number above nought.
##   MDLT_CONSOLE_ORIGIN, MDLT_CONSOLE_DETAIL   by the owner's own order. The origin is
##       the workspace's, where every console loads its tooling from at its next start: what
##       it takes is made at the call (`@origins`, AgentsToolsManagerConfigOrigins), and it
##       is saved in the workspace's own settings file, which its row names after its other
##       fields. The detail is the user's own, what MDSC_DETAIL is in a console the user
##       starts: today the agents console alone reads it (console-agents-bashrc.rc).
## AN EMPTY VALUE IS NO VALUE: the writer never saves one. Given an empty value it takes the
## key out of the file, by the reader's own operation that removes one, and the setting is
## its default again. A setting whose default is that nothing is set has an empty default
## here, and the first of its choices has no value ahead of its `=`: choosing it is giving
## the empty value.
## NOT HERE, each a line of the configuration: the CLI service, the harness tier and the wait
## round of the workspace (deployed; a round longer than a CLI allows ends the waits of
## running sessions). The tick and the other seconds of a control thread are no line at all:
## a running thread reads them.
agentsManagerConfigSettings="interface|style|MDAT_MANAGER_STYLE|choice|environment user|tv-system|nu-system=Magic - System,nu-blue=Magic - Dark/Blue,nu-gray=Magic - Light/Gray,tv-system=Turbo Vision - System,tv-blue=Turbo Vision - Dark/Blue,tv-gray=Turbo Vision - Light/Gray,bw-system=Basic B/W - System,bw-dark=Basic B/W - Dark/Blue,bw-light=Basic B/W - Light/Gray
console|history|MDLT_CONSOLE_HISTORY|choice|user system|workspace-personal|workspace-personal=Per User In This Workspace,workspace-separate=Per User And Per Console,workspace-shared=Shared By All Users,local-machine-home=In The Home Of The User,bash-default=The File Bash Uses,user-default=As The User Has It
console|origin|MDLT_CONSOLE_ORIGIN|choice|user system||@origins|system
console|detail|MDLT_CONSOLE_DETAIL|choice|user||=<default> (none),true=true (track),full=full (debug)
control|request|SESSION_CONTROL_REQUEST_SECONDS|number|team|5|1..60
control|kill|SESSION_CONTROL_KILL_SECONDS|number|team|30|5..600
knowledge|store|MDAT_KNOWLEDGE_STORE|choice|environment team|off|off=Off,on=On"

## THE OTHER NAMES of a value of a changeable setting: a name it had before, or a second name
## of it, each with the value it means, which it is read as and saved as. One row a setting,
## `<key>|<name>=<value>,...`.
##   MDAT_MANAGER_STYLE   a style alone, from before a style had its colours: each the one it
##       was drawn in then (the screen's STYLES "bare"), Magic by its name of then; and the
##       colours of Turbo Vision and of Magic by the names of every style, dark for blue and
##       light for gray (the screen's COLOURS).
agentsManagerConfigFormer="MDAT_MANAGER_STYLE|tv=tv-system,bw=bw-system,magic=nu-gray,tv-dark=tv-blue,tv-light=tv-gray,nu-dark=nu-blue,nu-light=nu-gray,magic-system=nu-system,magic-blue=nu-blue,magic-dark=nu-blue,magic-gray=nu-gray,magic-light=nu-gray"

## The subjects whose changeable lines keep, where the digest is not asked in full, the form
## they had first: where the value comes from and what it takes ahead of the label.
agentsManagerConfigEarlierForm="interface"

## Why no line of the configuration is changed from a console: the words of its field.
agentsManagerConfigDeployed="set at deployment: a wizard will change it"

## The file the user who runs the call has for settings of their own in this workspace, where
## the setting reader of the sibling package keeps its scope of the current user. rc 1, and
## nothing printed, where the operating system gives that user no name.
AgentsToolsManagerConfigUserFile(){
	local userName
	userName="$( id -un 2> /dev/null )" || userName=""
	[ -n "$userName" ] || return 1
	printf '%s\n' "${MMDAPP%/}/.local/home/$userName/MDLT.settings.env"
}

## One of the user's own settings in this workspace, by the setting reader of the sibling
## package in its scope of the current user: the last line that sets the key, and nothing
## where none does. The user is the one the operating system says runs the call, whatever
## the environment names, so nobody else's settings are read. Reading makes no file.
AgentsToolsManagerConfigUserValue(){ ## key
	(
		USER="$( id -un 2> /dev/null )" ; [ -n "$USER" ] || exit 0
		set -- --custom-config-option --select "$1"
		. "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/LocalTools.Config.include"
	) 2> /dev/null || :
}

## Saves one of the user's own settings in this workspace, by the same reader in the same
## scope for the same user: every line that set the key is replaced by one, and the other
## lines stay. The reader writes a temp file beside the settings file, named by the id of
## the shell, and puts it in place by a rename. It says nothing where that fails, so whoever
## saves reads the value back.
AgentsToolsManagerConfigUserSave(){ ## key, value
	(
		USER="$( id -un 2> /dev/null )" ; [ -n "$USER" ] || exit 1
		set -- --custom-config-option --upsert "$1" "$2"
		. "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/LocalTools.Config.include"
	) > /dev/null 2>&1
}

## One setting of the workspace's own settings file, which the consoles read after the
## user's: by the same reader, in its scope of the workspace. Reading makes no file.
AgentsToolsManagerConfigSystemValue(){ ## key
	(
		set -- --system-config-option --select "$1"
		. "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/LocalTools.Config.include"
	) 2> /dev/null || :
}

## The workspace's own settings file, and its two writers: the same reader in its scope of
## the workspace, which saves a key for everybody and takes one out. Taking a key out of a
## file that is not there makes none.
AgentsToolsManagerConfigSystemFile(){
	printf '%s\n' "${MMDAPP%/}/.local/MDLT.settings.env"
}
AgentsToolsManagerConfigSystemSave(){ ## key, value
	(
		set -- --system-config-option --upsert "$1" "$2"
		. "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/LocalTools.Config.include"
	) > /dev/null 2>&1
}
AgentsToolsManagerConfigSystemDrop(){ ## key
	[ -f "$( AgentsToolsManagerConfigSystemFile )" ] || return 0
	(
		set -- --system-config-option --delete "$1"
		. "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/LocalTools.Config.include"
	) > /dev/null 2>&1
}
## Takes one of the user's own settings out of the user's file, by the reader in its scope of
## the current user, for the user the operating system names.
AgentsToolsManagerConfigUserDrop(){ ## key
	local dropFile
	dropFile="$( AgentsToolsManagerConfigUserFile )" || return 1
	[ -f "$dropFile" ] || return 0
	(
		USER="$( id -un 2> /dev/null )" ; [ -n "$USER" ] || exit 1
		set -- --custom-config-option --delete "$1"
		. "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/LocalTools.Config.include"
	) > /dev/null 2>&1
}

## THE ORIGINS A WORKSPACE MAY TAKE ITS TOOLING FROM, made at the call, `<value>=<label>` with
## commas between: no value, its own installed copy; then the `source` of each registered
## workspace that has the tool family there; then the `.local` of each that has it there, but
## for this workspace's own, which is the default. A workspace is one the places know
## (AgentsToolsPlacesMergedText) whose folder is there and can be entered. IT HAS THE FAMILY
## where the three files stand that a console loads first from its origin: the context of
## the agents console, which the context itself asks for before it takes a `source`, the
## settings reader, and the context every other context loads.
AgentsToolsManagerConfigOriginHas(){ ## origin
	[ -f "$1/myx/myx.distro-agents/sh-lib/harness/AgentsContext.include" ] && [ -f "$1/myx/myx.distro-.local/sh-lib/LocalTools.Config.include" ] && [ -f "$1/myx/myx.distro-system/sh-lib/SystemContext.include" ]
}
AgentsToolsManagerConfigOrigins(){
	local originsName originsKind originsCeiling originsPath originsRest originsSource="" originsLocal="" originsSeen=$'\n' originsHere="${MMDAPP%/}"
	while IFS=$'\t' read -r originsName originsKind originsCeiling originsPath originsRest ; do
		[ "$originsKind" = "workspace" ] || continue
		originsPath="${originsPath%/}"
		case "$originsPath" in /*) ;; *) continue ;; esac
		case "$originsPath$originsName" in *,*|*=*|*'|'*|*[[:space:]]*) continue ;; esac
		case "$originsSeen" in *$'\n'"$originsPath"$'\n'*) continue ;; esac
		originsSeen="$originsSeen$originsPath"$'\n'
		[ -d "$originsPath" ] && [ -r "$originsPath" ] && [ -x "$originsPath" ] || continue
		! AgentsToolsManagerConfigOriginHas "$originsPath/source" || originsSource="$originsSource,$originsPath/source=$originsName (source)"
		[ "$originsPath" = "$originsHere" ] || ! AgentsToolsManagerConfigOriginHas "$originsPath/.local" || originsLocal="$originsLocal,$originsPath/.local=$originsName (.local)"
	done <<< "$( AgentsToolsPlacesMergedText "$originsHere" quiet 2> /dev/null )"
	printf '%s\n' "=<default> (own .local)$originsSource$originsLocal"
}

## What the origin is now and where that comes from, `<value> <source>`, as a console reads
## it: the user's own setting first, then the workspace's. Its own installed copy, however it
## is written, is no value, from `default`; its own source tree reads by its path. A value
## that is none of those offered is given as it stands: a path set by hand.
AgentsToolsManagerConfigOriginNow(){
	local originValue originSource=user
	originValue="$( AgentsToolsManagerConfigUserValue MDLT_CONSOLE_ORIGIN )" || originValue=""
	case "$originValue" in ''|"''"|'""') originValue="" ;; esac
	if [ -z "$originValue" ] ; then
		originSource=workspace
		originValue="$( AgentsToolsManagerConfigSystemValue MDLT_CONSOLE_ORIGIN )" || originValue=""
	fi
	originValue="${originValue#"${MMDAPP%/}/"}"
	case "$originValue" in
		''|"''"|'""'|.local) printf '%s\n' " default" ; return 0 ;;
		source) originValue="${MMDAPP%/}/source" ;;
	esac
	case "$originValue" in *[[:space:]]*|*,*|*=*|*'|'*) printf '%s\n' " default" ; return 0 ;; esac
	printf '%s %s\n' "$originValue" "$originSource"
}

## What a changeable setting takes, as its row says it or, where the row names a list made
## at the call, as that list stands now.
AgentsToolsManagerConfigSettingOffers(){ ## what its row says it takes
	case "$1" in
		@origins) AgentsToolsManagerConfigOrigins ;;
		*) printf '%s\n' "$1" ;;
	esac
}

## The file the settings of the team are kept in, in this workspace.
AgentsToolsManagerConfigTeamFile(){
	printf '%s\n' "${MMDAPP%/}/.local/.agents/magic-team.agent.env"
}

## One setting of the team in this workspace, by the tooling's own operation, as every
## reader of such a setting asks it.
AgentsToolsManagerConfigTeamValue(){ ## key
	DistroAgentsTools --agents-config-option magic-team --select "$1" 2> /dev/null < /dev/null || :
}

## Saves one setting of the team in this workspace, by that same operation: the tooling's
## own writer of a workspace's settings, which is the setting reader of the sibling package.
## It writes as that reader writes the user's, a temp file named by the id of the shell and
## put in place by a rename, with nothing said where that fails: whoever saves reads the
## value back.
AgentsToolsManagerConfigTeamSave(){ ## key, value
	DistroAgentsTools --agents-config-option magic-team --upsert "$1" "$2" > /dev/null 2>&1 < /dev/null
}
## Takes one setting of the team out of its file, by that same operation. Where the file is
## not there, there is nothing to take out, and none is made.
AgentsToolsManagerConfigTeamDrop(){ ## key
	[ -f "$( AgentsToolsManagerConfigTeamFile )" ] || return 0
	DistroAgentsTools --agents-config-option magic-team --delete "$1" > /dev/null 2>&1 < /dev/null
}

## Whether a value is one a setting takes: rc 0 where it is. A choice takes the values of
## its row. A number takes, to be saved, a whole number from its smallest to its largest,
## written in digits alone with no nought ahead; and as it is read, `read` given, any whole
## number above nought of up to seven digits, which is what the tooling itself reads.
AgentsToolsManagerConfigSettingTakes(){ ## kind, what it takes, value, `read` (may be empty)
	case "$3" in ''|*,*|*=*|*'|'*) return 1 ;; esac
	case "$1" in
		choice)
			case ",$2" in *",$3="*) return 0 ;; esac
		;;
		number)
			case "$3" in *[!0123456789]*|0*|????????*) return 1 ;; esac
			[ -z "${4:-}" ] || return 0
			[ "$3" -ge "${2%%..*}" ] && [ "$3" -le "${2##*..}" ] && return 0
		;;
	esac
	return 1
}

## The value a value of a setting means: another name of one of its key (THE OTHER NAMES) the
## value it stands for, any other itself.
AgentsToolsManagerConfigSettingFormer(){ ## key, value
	local formerKey formerPairs
	while IFS='|' read -r formerKey formerPairs ; do
		[ "$formerKey" = "$1" ] && [ -n "$2" ] || continue
		case ",$formerPairs," in
			*",$2="*)
				formerPairs=",$formerPairs,"
				formerPairs="${formerPairs#*,"$2"=}"
				printf '%s\n' "${formerPairs%%,*}"
				return 0
			;;
		esac
	done <<< "$agentsManagerConfigFormer"
	printf '%s\n' "$2"
}

## What a changeable setting is now and where that comes from, `<value> <source>`: the first
## place of its row that holds a value it takes. `environment`, `user`, or `workspace` for
## the workspace's own file and for the settings of the team alike; else its default,
## `default`. Another name of a value is the value it means. A value that is none it takes
## counts as not given, wherever it stands.
AgentsToolsManagerConfigSettingNow(){ ## key, kind, places, default, what it takes
	local nowKey="$1" nowPlace nowValue nowSource
	for nowPlace in $3 ; do
		case "$nowPlace" in
			environment) nowValue="${!nowKey:-}" ; nowSource=environment ;;
			user) nowValue="$( AgentsToolsManagerConfigUserValue "$nowKey" )" || nowValue="" ; nowSource=user ;;
			system) nowValue="$( AgentsToolsManagerConfigSystemValue "$nowKey" )" || nowValue="" ; nowSource=workspace ;;
			team) nowValue="$( AgentsToolsManagerConfigTeamValue "$nowKey" )" || nowValue="" ; nowSource=workspace ;;
			*) continue ;;
		esac
		nowValue="$( AgentsToolsManagerConfigSettingFormer "$nowKey" "$nowValue" )" || nowValue=""
		if AgentsToolsManagerConfigSettingTakes "$2" "$5" "$nowValue" read ; then
			printf '%s %s\n' "$nowValue" "$nowSource"
			return 0
		fi
	done
	printf '%s %s\n' "$4" default
	return 0
}

## Where a changeable setting is saved, `<scope> <file>` with a TAB between them: the user's
## own file where its row names `user`, else the settings of the team, the workspace's.
AgentsToolsManagerConfigSettingPlace(){ ## places, where its row says it is saved (may be empty)
	if [ "${2:-}" = "system" ] ; then
		printf 'workspace\t%s\n' "$( AgentsToolsManagerConfigSystemFile )"
		return 0
	fi
	case " $1 " in
		*" user "*) printf 'user\t%s\n' "$( AgentsToolsManagerConfigUserFile )" ;;
		*" team "*) printf 'workspace\t%s\n' "$( AgentsToolsManagerConfigTeamFile )" ;;
		*) return 1 ;;
	esac
}

## The lines of the changeable settings of one subject, one for each row of THE CHANGEABLE
## SETTINGS that names it: its key, `set`, and what it is now; then five fields more, where
## that comes from, what it takes, its kind, its scope and the file it is saved in. The
## labeller puts them where the form of the row has them.
AgentsToolsManagerConfigDeclared(){ ## subject
	local declaredSubject declaredGroup declaredKey declaredKind declaredPlaces declaredDefault declaredTakes declaredSave declaredNow declaredScope declaredFile declaredOffers
	while IFS='|' read -r declaredSubject declaredGroup declaredKey declaredKind declaredPlaces declaredDefault declaredTakes declaredSave ; do
		[ "$declaredSubject" = "$1" ] && [ -n "$declaredKey" ] || continue
		declaredOffers="$( AgentsToolsManagerConfigSettingOffers "$declaredTakes" )" || declaredOffers=""
		if [ "$declaredTakes" = "@origins" ] ; then
			## The origin as it is, also where it is none of those offered: it is then one more
			## of what the line lists, marked as set by hand.
			declaredNow="$( AgentsToolsManagerConfigOriginNow )" || declaredNow=" default"
			[ -z "${declaredNow%% *}" ] || AgentsToolsManagerConfigSettingTakes choice "$declaredOffers" "${declaredNow%% *}" read || declaredOffers="$declaredOffers,${declaredNow%% *}=${declaredNow%% *} (set by hand)"
		else
			declaredNow="$( AgentsToolsManagerConfigSettingNow "$declaredKey" "$declaredKind" "$declaredPlaces" "$declaredDefault" "$declaredOffers" )" || declaredNow=""
		fi
		declaredTakes="$declaredOffers"
		declaredScope="" ; declaredFile=""
		IFS=$'\t' read -r declaredScope declaredFile <<< "$( AgentsToolsManagerConfigSettingPlace "$declaredPlaces" "${declaredSave:-}" )"
		AgentsToolsManagerConfigLine "$1" "$declaredGroup" "$declaredKey" set "${declaredNow%% *}" "${declaredNow#* }" "$declaredTakes" "$declaredKind" "$declaredScope" "$declaredFile"
	done <<< "$agentsManagerConfigSettings"
	return 0
}

case "$1" in

	## The settings of this workspace as they are, by subject: TAB-separated rows a screen
	## reads. Their form is the help entry's.
	--manager-config-digest)
		local digestOp="$1" digestName digestKnown digestFound digestWanted=" " digestLines digestLine digestCount digestFull=""
		shift
		## Each line in full, where that is asked ahead of every name.
		if [ "${1:-}" = "--full" ] ; then
			digestFull="full"
			shift
		fi
		for digestName in "$@" ; do
			digestFound="false"
			for digestKnown in $agentsManagerConfigSubjects ; do
				[ "$digestKnown" != "$digestName" ] || digestFound="true"
			done
			if [ "$digestFound" != "true" ] ; then
				echo "⛔ ERROR: $MDSC_CMD $digestOp: '$digestName' is none of its subjects -- nothing was printed. Its subjects: ${agentsManagerConfigSubjects// /, }" >&2
				set +e ; return 1
			fi
			digestWanted="$digestWanted$digestName "
		done
		[ $# -gt 0 ] || digestWanted=" $agentsManagerConfigSubjects "
		for digestName in $agentsManagerConfigSubjects ; do
			case "$digestWanted" in *" $digestName "*) ;; *) continue ;; esac
			case "$digestName" in
				workspace) digestLines="$( AgentsToolsManagerConfigWorkspace )" || digestLines="" ;;
				cli) digestLines="$( AgentsToolsManagerConfigCli )" || digestLines="" ;;
				systems) digestLines="$( AgentsToolsManagerConfigSystems )" || digestLines="" ;;
				loop) digestLines="$( AgentsToolsManagerConfigLoop )" || digestLines="" ; [ -n "$digestLines" ] || continue ;;
				scopes) digestLines="$( AgentsToolsManagerConfigScopes )" || digestLines="" ;;
				interface|console|control|knowledge) digestLines="$( AgentsToolsManagerConfigDeclared "$digestName" )" || digestLines="" ;;
			esac
			digestCount=0
			if [ -n "$digestLines" ] ; then
				while IFS= read -r digestLine ; do
					digestCount=$(( digestCount + 1 ))
				done <<< "$digestLines"
			fi
			{
				printf 'subject\t%s\t%s\n' "$digestName" "$digestCount"
				[ -z "$digestLines" ] || printf '%s\n' "$digestLines"
			} | AgentsToolsManagerConfigLabelled "$digestFull"
		done
		return 0
	;;

	## Saves one changeable setting, a row of THE CHANGEABLE SETTINGS, and nothing else: the
	## one operation here that writes. A key of the configuration is none of them, and is
	## refused as any other. AN EMPTY VALUE REMOVES THE SETTING: its key is taken out of the
	## file, and no key with nothing after it is ever written. One row a program reads. Its
	## form is the help entry's.
	--manager-config-set)
		local setOp="$1" setSubject setGroup setKey setKind setPlaces setDefault setTakes setSave setKeys="" setFound="" setValues="" setHow="" setWhere="" setNone="" setScope="" setFile="" setSaved
		shift
		if [ $# -ne 2 ] ; then
			echo "⛔ ERROR: $MDSC_CMD $setOp: syntax is $setOp <key> <value>, got $# argument(s) -- nothing was saved" >&2
			set +e ; return 1
		fi
		while IFS='|' read -r setSubject setGroup setKey setKind setPlaces setDefault setTakes setSave ; do
			[ -n "$setKey" ] || continue
			setKeys="$setKeys${setKeys:+, }$setKey"
			[ "$setKey" != "$1" ] || { setFound="$setKind" ; setValues="$setTakes" ; setHow="$setPlaces" ; setWhere="${setSave:-}" ; setNone="$setDefault" ; }
		done <<< "$agentsManagerConfigSettings"
		## Nothing that was given is repeated in a refusal: a word that is no key and no value
		## of a setting may be anything, a secret pasted by mistake among it.
		if [ -z "$setFound" ] ; then
			echo "⛔ ERROR: $MDSC_CMD $setOp: the key given is none of the changeable settings -- nothing was saved. Its keys: $setKeys" >&2
			set +e ; return 1
		fi
		[ -z "$setFound" ] || setValues="$( AgentsToolsManagerConfigSettingOffers "$setValues" )" || setValues=""
		## another name of a value is saved as the value it means
		set -- "$1" "$( AgentsToolsManagerConfigSettingFormer "$1" "$2" )"
		if [ -n "$2" ] && ! AgentsToolsManagerConfigSettingTakes "$setFound" "$setValues" "$2" "" ; then
			if [ "$setFound" = "number" ] ; then
				echo "⛔ ERROR: $MDSC_CMD $setOp: the value given is no whole number from ${setValues%%..*} to ${setValues##*..}, which $1 takes -- nothing was saved" >&2
			else
				setValues="$( printf '%s\n' "$setValues" | LC_ALL=C sed -e 's/^=[^,]*,//' -e 's/=[^,]*//g' -e 's/,/, /g' )"
				echo "⛔ ERROR: $MDSC_CMD $setOp: the value given is none of the values of $1 -- nothing was saved. Its values: $setValues" >&2
			fi
			set +e ; return 1
		fi
		IFS=$'\t' read -r setScope setFile <<< "$( AgentsToolsManagerConfigSettingPlace "$setHow" "$setWhere" )"
		if [ -z "$setFile" ] ; then
			echo "⛔ ERROR: $MDSC_CMD $setOp: there is no file to save $1 in: the operating system gives the user who runs this call no name -- nothing was saved" >&2
			set +e ; return 1
		fi
		## A setting of the workspace is changed for everybody. Whoever reaches this arm is the
		## console's operator, who stands at least equal to magic-coordinator: a member's
		## session, magic-coordinator's among them, was refused where the family is dispatched.
		## The empty value: the key is taken out, where the setting is kept, by the operation
		## that removes one, and what the file holds of it then is read back. Its row says so,
		## with the default the setting is at now.
		if [ -z "$2" ] ; then
			if [ "$setWhere" = "system" ] ; then
				AgentsToolsManagerConfigSystemDrop "$1" || :
				setSaved="$( AgentsToolsManagerConfigSystemValue "$1" )" || setSaved="?"
			elif [ "$setScope" = "user" ] ; then
				AgentsToolsManagerConfigUserDrop "$1" || :
				setSaved="$( AgentsToolsManagerConfigUserValue "$1" )" || setSaved="?"
			else
				AgentsToolsManagerConfigTeamDrop "$1" || :
				setSaved="$( AgentsToolsManagerConfigTeamValue "$1" )" || setSaved="?"
			fi
			if [ -n "$setSaved" ] ; then
				echo "⛔ ERROR: $MDSC_CMD $setOp: $1 could not be removed: $setFile still holds it after the write" >&2
				set +e ; return 1
			fi
			printf 'removed\t%s\t%s\t%s\t%s\n' "$1" "${setNone:--}" "$setScope" "${setFile//[[:space:]]/_}"
			return 0
		elif [ "$setWhere" = "system" ] ; then
			AgentsToolsManagerConfigSystemSave "$1" "$2" || :
			setSaved="$( AgentsToolsManagerConfigSystemValue "$1" )" || setSaved=""
		elif [ "$setScope" = "user" ] ; then
			AgentsToolsManagerConfigUserSave "$1" "$2" || :
			setSaved="$( AgentsToolsManagerConfigUserValue "$1" )" || setSaved=""
		else
			AgentsToolsManagerConfigTeamSave "$1" "$2" || :
			setSaved="$( AgentsToolsManagerConfigTeamValue "$1" )" || setSaved=""
		fi
		if [ "$setSaved" != "$2" ] ; then
			echo "⛔ ERROR: $MDSC_CMD $setOp: $1 could not be saved: $setFile does not hold the value after the write" >&2
			set +e ; return 1
		fi
		printf 'saved\t%s\t%s\t%s\t%s\n' "$1" "$setSaved" "$setScope" "${setFile//[[:space:]]/_}"
		return 0
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
