#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.ManagerDashboard.include -- the panels the agents register in the Dashboard: the most
## vital figures of this workspace and of its team, each panel a set of figures under one label that a
## screen draws as a titled box. The readers only: the operation that prints them is `.local`'s
## (--manager-dashboard-read, myx.distro-.local/sh-lib/manager/LocalTools.ManagerDashboard.include), which
## sources this file for the readers the list of panels of the agents names (sh-lib/config/dashboard-panels.list).
##
## A PANEL is a small set of FIGURES under one label. A screen draws it with no knowledge of
## what is in it: every figure carries its own label, its unit, a level, and, where it is a part of
## a whole, the share it is of it, for a bar. THE PANELS HAVE ONE DECLARATION, the list file: another
## panel is one more line there and its reader here. A panel that has no honest figure on this host
## is left out, never guessed.
##
## EVERY FIGURE IS READ THE WAY ITS SUBJECT ALREADY READS IT, never a second way. The
## sessions are the rows the list of sessions prints, by its own awk and its own measuring
## (AgentsManagerSessionRows.awk, AgentsToolsRegistryMeasureRows), an asker is alive as the
## read of the questions says it (AgentsToolsPendingReplyAskers), the members are the
## machine's directory of them, the main loop and the heartbeat are the lines of the digest
## of the settings (AgentsToolsManagerConfigLoop). What only the system knows is asked of
## the system, by the command each of macOS, Linux and FreeBSD has for it, and a figure the
## host has no command for is left out.
##
## ONE PANEL RUNS GIT, the git state of the team data, local calls alone and only where it is
## asked for by its name (the list says `named`): every other panel runs none.
## FOR VIEWING, AND CHEAP: a screen reads it every ten seconds. NO REGISTRY IS REBUILT: the
## two registries of the sessions are read as they lie, as the list of sessions left them,
## and only what no file holds is measured at the call, which runs are alive. No transcript
## and no record of a run is opened; of a question that waits, its header alone. The rest
## and what is slow to read and changes seldom is KEPT (LocalToolsManagerDashboardKeep).
## NO git command is run, of no kind, and nothing reaches another host. A SECRET IS NEVER
## PRINTED and none is read: of the scopes only the one setting that names the CLI service is asked,
## by its name, and only that it is set is kept (AgentsToolsManagerDashboardCliSet); no path of a
## secret is a figure.
##

type AgentsToolsRegistryMeasureRows > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.Registries.include"
type AgentsToolsTeamMemberDirectoryText > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/team-data/AgentsTools.TeamRegistry.include"

## What the readers of the sessions keep of one call, which the operation starts as one process: the counts of the rows
## of the sessions (AgentsToolsManagerDashboardSessionCounts), read once, and the rows themselves for the sessions that rank.
dashboardSessions="" ; dashboardSize="" ; dashboardDeaths=0 ; dashboardSessionRows=""
sessionsRunning=0 ; sessionsWaiting=0 ; sessionsUnclosed=0 ; sessionsPaused=0 ; agentsWorking=0 ; agentsWaiting=0 ; controlAlive=0 ; controlGone=0
tokensRunning=0 ; tokensToday=0 ; tokensPartial=0 ; tokensRunningSessions=0 ; tokensTodaySessions=0 ; membersLive=0


## For how long the size of the team data is kept once it was measured, in seconds.
agentsManagerDashboardSizeSeconds=600

## For how long the git state of the team data is kept, in seconds. Its panel is printed only where it is asked for by its name (the list of panels says so).
agentsManagerDashboardGitSeconds=30

## The states of the board in the order their counts are printed; a folder of the board
## that is none of them follows, in the order of its name.
agentsManagerDashboardBoardStates="running review blocked pending backlog parked retained processed archived"

## THE SESSIONS OF THIS WORKSPACE, AS THE LIST OF SESSIONS PRINTS THEM, with no registry
## rebuilt: its `session`, `run` and `counters` rows, by the list's own awk, from the
## registry of the sessions as it lies, each row measured now by the one rule
## (AgentsToolsRegistryMeasureRows), a live run asked whether it waits and a session whether
## its control thread lives by the list's own two readers. Prints nothing where the registry
## is not there: no list of sessions was read in this workspace yet. Run in a subshell that
## has sourced the list's include for those two readers.
## ONLY THE SESSIONS THAT CAN COUNT ARE MEASURED. The one rule walks every row in the shell,
## which is what the list costs, and nearly every row is of a session that ended long ago.
## So the rule is given a copy of the registry that holds, whole, each session that has a
## row which is not closed, or that an open ask names by its session or by its run, or that
## closed today, or whose control thread left a pid file or a lock. A session left out has
## every record closed, no open ask, no end of today and no control thread: the rule reads
## it `finished`, and it is in no figure here. A row is closed by the three words the rule
## itself takes for closed (AgentsToolsRegistryDeriveStateFromSet); a status that is none of
## them is kept. The copy is a file of the tooling's own temp folder, removed in the same
## call; where none can be made the whole registry is measured, which costs what the list
## costs.
## ONE THING THE LIST SEES AND THIS DOES NOT: a process that still runs as a run whose record
## is closed, in a session all of whose records are closed. The list reads such a session
## `running`; here it is not measured, since the process list is read in the one place a
## row's live is derived and nowhere in this family, and that place gives the runs of a
## registry file only together with the walk of every row.
AgentsToolsManagerDashboardSessionMeasured(){
	local rowsFile rowsPending rowsSpawn rowsWaiting=" " rowsStat="" rowsControl="" rowsNarrow="" rowsMeasure
	local measuredRows="" measuredDated="" measuredAny="false"
	rowsFile="$( AgentsToolsRegistryFile spawned-sessions )"
	[ -f "$rowsFile" ] || return 0
	rowsPending="$( AgentsToolsRegistryFile pending-replies )"
	[ -f "$rowsPending" ] || rowsPending="/dev/null"
	rowsMeasure="$rowsFile"
	rowsControl="$( AgentsToolsManagerSessionControls )" || rowsControl=""
	if mkdir -p "${MMDAPP%/}/.local/temp" 2> /dev/null && rowsNarrow="$( mktemp "${MMDAPP%/}/.local/temp/mdat-manager-dashboard.sessions.XXXXXX" 2> /dev/null )" ; then
		if MDAT_DASHBOARD_CONTROL="$rowsControl" MDAT_DASHBOARD_PENDING="$rowsPending" LC_ALL=C awk -v todayDate="$dashboardToday" '
			BEGIN {
				controlTotal = split(ENVIRON["MDAT_DASHBOARD_CONTROL"], controlLines, "\n") ;
				for (controlAt = 1 ; controlAt <= controlTotal ; controlAt++) if (split(controlLines[controlAt], controlWords, " ") >= 2) controlOf[controlWords[1]] = 1 ;
				pendingFile = ENVIRON["MDAT_DASHBOARD_PENDING"] ;
				while (pendingFile != "" && ( getline pendingLine < pendingFile ) > 0) {
					if (split(pendingLine, pendingWords, " ") < 3) continue ;
					if (( pendingWords[2] == "ask" && pendingWords[5] == "reply-pending" ) || pendingWords[2] == "board-item") askedOf[pendingWords[3]] = 1 ;
				}
			}
			FNR == 1 { narrowPass++ ; }
			{ sessionKey = ( $2 == "-" ? $1 : $2 ) ; }
			narrowPass == 1 {
				if (!( $6 == "spawn-succeeded" || $6 == "spawn-failed" || $6 == "spawn-ended-without-close" ) || ( sessionKey in controlOf ) || ( $1 in askedOf ) || ( $2 in askedOf ) || ( $8 in askedOf ) || ( todayDate != "" && substr($13, 1, 10) == todayDate )) keptOf[sessionKey] = 1 ;
				next ;
			}
			( sessionKey in keptOf ) { print ; }
		' "$rowsFile" "$rowsFile" > "$rowsNarrow" 2> /dev/null ; then
			rowsMeasure="$rowsNarrow"
		fi
	fi
	AgentsToolsRegistryMeasureRows "$rowsMeasure" "" "" 16
	[ -z "$rowsNarrow" ] || rm -f "$rowsNarrow" 2> /dev/null || :
	if stat -f '%m' / > /dev/null 2>&1 ; then
		rowsStat="bsd"
	elif stat -c '%Y' / > /dev/null 2>&1 ; then
		rowsStat="gnu"
	fi
	while IFS= read -r rowsSpawn ; do
		[ -n "$rowsSpawn" ] || continue
		[ "$( AgentsToolsManagerRunActivity "$rowsSpawn" "$rowsStat" )" != "waiting" ] || rowsWaiting="$rowsWaiting$rowsSpawn "
	done <<< "$( printf '%s' "$measuredDated" | LC_ALL=C awk 'NF == 18 && $12 == "running" { print $8 ; }' )"
	printf '%s' "$measuredDated" \
		| MDAT_MANAGER_WAITING="$rowsWaiting" MDAT_MANAGER_CONTROL="$rowsControl" MDAT_MANAGER_AGENTS="$MMDAPP/.local/agents" LC_ALL=C awk -v loadAverage="-" -v hostName="-" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/manager/AgentsManagerSessionTokens.awk" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/manager/AgentsManagerDateMinutes.awk" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/manager/AgentsManagerSessionRows.awk" "$rowsPending" - \
		| LC_ALL=C cut -f6-
	return 0
}

## Those rows counted, once a call, for the three blocks that read them, into the
## operation's own variables: the sessions by their state, the control threads that live
## and that are gone, the counters of the list as it prints them, the tokens of the
## sessions that run and of those that finished today and how many sessions they are of, and
## the members with a live run. dashboardSessions is empty where there are no rows to count;
## dashboardSessionRows keeps the rows, for the panel that ranks the sessions.
AgentsToolsManagerDashboardSessionCounts(){
	local countsRows
	[ -z "$dashboardSessions" ] || return 0
	dashboardSessions="none"
	countsRows="$( . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/manager/AgentsTools.ManagerSession.include" --definitions-only > /dev/null 2>&1 || :
		AgentsToolsManagerDashboardSessionMeasured 2> /dev/null )" || countsRows=""
	[ -n "$countsRows" ] || return 0
	dashboardSessionRows="$countsRows"
	read -r dashboardSessions sessionsRunning sessionsWaiting sessionsUnclosed sessionsPaused agentsWorking agentsWaiting controlAlive controlGone tokensRunning tokensToday tokensPartial membersLive tokensRunningSessions tokensTodaySessions <<< "$( printf '%s\n' "$countsRows" | LC_ALL=C awk -F'\t' -v todayDate="$dashboardToday" '
		$1 == "session" {
			sessionStates[$4]++ ;
			if ($11 == "alive") controlAlive++ ; else if ($11 == "gone") controlGone++ ;
			## The tokens of a session that runs now, and of one whose last run closed today.
			if ($4 == "running" || ( $4 == "finished" && substr($6, 1, 10) == todayDate )) {
				tokenFigure = $12 ; tokenWhole = 1 ;
				if (sub(/\+$/, "", tokenFigure)) tokenWhole = 0 ;
				if (tokenFigure !~ /^[0-9]+$/) { tokenWhole = 0 ; tokenFigure = 0 ; }
				if ($4 == "running") tokensRunning += tokenFigure ; else tokensToday += tokenFigure ;
				if ($12 ~ /^[0-9]+[+]?$/) { if ($4 == "running") runningSessions++ ; else todaySessions++ ; }
				if (!tokenWhole) tokensPartial++ ;
			}
			next ;
		}
		$1 == "run" && $6 == "running" { if (!( $4 in memberLive )) { memberLive[$4] = 1 ; membersLive++ ; } next ; }
		$1 == "counters" { countersSeen = 1 ; sessionsPaused = $3 ; agentsWorking = $4 ; agentsWaiting = $5 ; next ; }
		END {
			if (!countersSeen) { print "none" ; exit ; }
			printf "read %d %d %d %d %d %d %d %d %.0f %.0f %d %d %d %d\n", sessionStates["running"], sessionStates["waiting"], sessionStates["unclosed"], sessionsPaused, agentsWorking, agentsWaiting, controlAlive, controlGone, tokensRunning, tokensToday, tokensPartial, membersLive, runningSessions, todaySessions ;
		}
	' )" || dashboardSessions="none"
	return 0
}

## How many sessions keep a death that stands unanswered, in dashboardDeaths: a line of the
## session's control/dead that is not settled and has one question more than answers, which
## is how its own reader says an answer is awaited (AgentsToolsSessionControlDeathCount).
## The folders are listed by the shell, and a file is read only where a session has one.
AgentsToolsManagerDashboardDeaths(){
	local deathFile deathLine deathOpen
	dashboardDeaths=0
	for deathFile in "$MMDAPP/.local/agents/sessions"/*/control/dead ; do
		[ -f "$deathFile" ] && [ -s "$deathFile" ] || continue
		type AgentsToolsSessionControlDeathCount > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionControlDeath.include"
		deathOpen=""
		while IFS= read -r deathLine || [ -n "$deathLine" ] ; do
			case " $deathLine " in *" settled="*) continue ;; esac
			[ "$( AgentsToolsSessionControlDeathCount "$deathLine" asked )" -gt "$( AgentsToolsSessionControlDeathCount "$deathLine" answer )" ] || continue
			deathOpen="yes"
			break
		done < "$deathFile"
		[ -z "$deathOpen" ] || dashboardDeaths=$(( dashboardDeaths + 1 ))
	done
	return 0
}

## SESSIONS AND AGENTS. Left out where no list of sessions was read in this workspace yet.
AgentsToolsManagerDashboardSessions(){
	local sessionsLive sessionsLevel
	AgentsToolsManagerDashboardSessionCounts
	[ "$dashboardSessions" = "read" ] || return 0
	AgentsToolsManagerDashboardDeaths
	LocalToolsManagerDashboardFigure sessions sessions-running "Sessions Running" "$sessionsRunning" count - ""
	LocalToolsManagerDashboardFigure sessions sessions-waiting "Sessions Waiting" "$sessionsWaiting" count - ""
	sessionsLevel="ok" ; [ "$sessionsUnclosed" = 0 ] || sessionsLevel="warn"
	LocalToolsManagerDashboardFigure sessions sessions-unclosed "Sessions Unclosed" "$sessionsUnclosed" count "$sessionsLevel" ""
	LocalToolsManagerDashboardFigure sessions sessions-paused "Sessions Paused" "$sessionsPaused" count - ""
	sessionsLive=$(( agentsWorking + agentsWaiting ))
	LocalToolsManagerDashboardShare "$agentsWorking" "$sessionsLive"
	LocalToolsManagerDashboardFigure sessions agents-working "Agents Working" "$agentsWorking" count - "$dashboardShare"
	LocalToolsManagerDashboardShare "$agentsWaiting" "$sessionsLive"
	LocalToolsManagerDashboardFigure sessions agents-waiting "Agents Waiting" "$agentsWaiting" count - "$dashboardShare"
	LocalToolsManagerDashboardFigure sessions control-alive "Control Threads Alive" "$controlAlive" count - ""
	sessionsLevel="ok" ; [ "$controlGone" = 0 ] || sessionsLevel="warn"
	LocalToolsManagerDashboardFigure sessions control-gone "Control Threads Gone" "$controlGone" count "$sessionsLevel" ""
	sessionsLevel="ok" ; [ "$dashboardDeaths" = 0 ] || sessionsLevel="warn"
	LocalToolsManagerDashboardFigure sessions deaths-unanswered "Deaths Unanswered" "$dashboardDeaths" count "$sessionsLevel" ""
	return 0
}

## PENDING QUESTIONS: the asks that are open in the registry as it lies. Of each, its
## record's header alone is read, for whom it is addressed to, when it was asked and on
## which host; whether its asker lives is measured now, for the asks of this host, by the
## reader the read of the questions has for it (AgentsToolsPendingReplyAskers), which reads
## the process list once. Left out where the registry is not there.
AgentsToolsManagerDashboardPending(){
	local pendingFile pendingDir="$MMDAPP/.local/agents/pending" pendingHost pendingKey pendingAsker pendingOn pendingTo pendingAt
	local pendingCount=0 pendingOwner=0 pendingGone=0 pendingOldest="" pendingAskers="" pendingDates="" pendingFacts="" pendingLive="" pendingLevel
	pendingFile="$( AgentsToolsRegistryFile pending-replies )"
	[ -f "$pendingFile" ] || return 0
	pendingHost="$( hostname -s 2> /dev/null )" || pendingHost=""
	[ -n "$pendingHost" ] || pendingHost="unknown"
	set --
	while read -r pendingKey pendingAsker ; do
		[ -n "$pendingKey" ] || continue
		pendingCount=$(( pendingCount + 1 ))
		case "$pendingKey" in */*|.|..) continue ;; esac
		[ ! -f "$pendingDir/$pendingKey" ] || set -- "$@" "$pendingDir/$pendingKey"
	done <<< "$( LC_ALL=C awk '$2 == "ask" && $5 == "reply-pending" { print $1, $3 ; }' "$pendingFile" 2> /dev/null )"
	if [ $# -gt 0 ] ; then
		## One line a record, from its header: host, address-to, session-id, and asked-at as the ISO reader takes it.
		pendingFacts="$( LC_ALL=C awk '
			function factsOut() {
				if (factsAt ~ /^[0-9][0-9][0-9][0-9]-[01][0-9]-[0-3][0-9] [0-2][0-9]:[0-5][0-9] [-+][0-9][0-9][0-9][0-9]$/) factsAt = substr(factsAt, 1, 10) "T" substr(factsAt, 12, 5) ":00" substr(factsAt, 18) ;
				else factsAt = "-" ;
				printf "%s\t%s\t%s\t%s\n", factsHost, factsTo, factsAsker, factsAt ;
			}
			FNR == 1 { if (NR > 1) factsOut() ; factsDashes = 0 ; factsHost = "-" ; factsTo = "-" ; factsAsker = "-" ; factsAt = "-" ; }
			$0 == "---" { factsDashes++ ; next ; }
			factsDashes != 1 { next ; }
			index($0, "host: ") == 1 { factsHost = substr($0, 7) ; gsub(/[ \t]/, "_", factsHost) ; next ; }
			index($0, "address-to: ") == 1 { factsTo = substr($0, 13) ; gsub(/[ \t]/, "_", factsTo) ; next ; }
			index($0, "session-id: ") == 1 { factsAsker = substr($0, 13) ; gsub(/[ \t]/, "_", factsAsker) ; next ; }
			index($0, "asked-at: ") == 1 { factsAt = substr($0, 11) ; next ; }
			END { if (NR > 0) factsOut() ; }
		' "$@" 2> /dev/null )" || pendingFacts=""
	fi
	while IFS=$'\t' read -r pendingOn pendingTo pendingAsker pendingAt ; do
		[ -n "$pendingOn" ] || continue
		[ "$pendingTo" != "human-owner" ] || pendingOwner=$(( pendingOwner + 1 ))
		[ "$pendingOn" != "$pendingHost" ] || [ -z "$pendingAsker" ] || [ "$pendingAsker" = "-" ] || pendingAskers="$pendingAskers$pendingAsker"$'\n'
		[ -z "$pendingAt" ] || [ "$pendingAt" = "-" ] || pendingDates="$pendingDates$pendingAt"$'\n'
	done <<< "$pendingFacts"
	if [ -n "$pendingAskers" ] ; then
		pendingLive="$( . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.MemberPendingReply.include" --definitions-only > /dev/null 2>&1 || :
			printf '%s' "$pendingAskers" | LC_ALL=C sort -u | AgentsToolsPendingReplyAskers 2> /dev/null )" || pendingLive=""
		## An asker is gone by the two words the list of the questions marks it by.
		pendingGone="$( { printf '%s\n=\n' "$pendingLive" ; printf '%s' "$pendingAskers" ; } | LC_ALL=C awk '
			$0 == "=" { goneRead = 1 ; next ; }
			! goneRead { if ($2 == "no-process" || $2 == "session-ended") goneOf[$1] = 1 ; next ; }
			( $1 in goneOf ) { goneCount++ ; }
			END { print goneCount + 0 ; }
		' )" || pendingGone=0
	fi
	if [ -n "$pendingDates" ] ; then
		pendingOldest="$( printf '%s' "$pendingDates" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-.local/sh-lib/output/LocalIsoToEpoch.awk" 2> /dev/null | LC_ALL=C sort -n | LC_ALL=C awk 'NR == 1 && $1 ~ /^[0-9]+$/ { print $1 ; }' )" || pendingOldest=""
	fi
	LocalToolsManagerDashboardFigure pending open "Questions Open" "$pendingCount" count - ""
	pendingLevel="ok" ; [ "$pendingGone" = 0 ] || pendingLevel="warn"
	LocalToolsManagerDashboardShare "$pendingGone" "$pendingCount"
	LocalToolsManagerDashboardFigure pending asker-gone "Asker Is Gone" "$pendingGone" count "$pendingLevel" "$dashboardShare"
	LocalToolsManagerDashboardShare "$pendingOwner" "$pendingCount"
	LocalToolsManagerDashboardFigure pending human-owner "For The Human Owner" "$pendingOwner" count - "$dashboardShare"
	[ -z "$pendingOldest" ] || [ "$dashboardNow" -lt "$pendingOldest" ] || LocalToolsManagerDashboardFigure pending oldest-age "Oldest Question Age" "$(( dashboardNow - pendingOldest ))" seconds - ""
	return 0
}

## WHETHER AN AI CLI SERVICE IS SET UP for use in this workspace on this machine (F11.4: the tokens are shown only
## where one is), rc 0; rc 1 where it is not. A CLI is named by the workspace's SPAWN_CLI_SERVICE, or by a preset one of its tier
## settings (SPAWN_TIER_LOW, _NORMAL, _HIGH) chooses, which has the CLI service of its own or of the preset it extends; and
## a CLI that is named is set up where the digest of the settings reads it `usable yes` on this host
## (AgentsToolsManagerConfigCli: a leg with one of its credentials set, a vendor CLI present in the path). The settings are
## asked by their names, and only that a CLI is set up is kept (LocalToolsManagerDashboardKeep), for
## agentsManagerDashboardSizeSeconds. A value of a credential is read by the digest's reader and never printed here.
AgentsToolsManagerDashboardCliSet(){
	local cliWords="" cliRoot cliNamed="" cliOne cliSpec cliLines cliRow cliSubject cliGroup cliKey cliState cliValue cliRest
	if LocalToolsManagerDashboardKept cli-service "$agentsManagerDashboardSizeSeconds" "${MMDAPP%/}" ; then
		cliWords="$dashboardKept"
	else
		type AgentsToolsPresetRead > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/config/AgentsTools.Preset.include"
		cliRoot="$( AgentsToolsPresetPayRoot 2> /dev/null )" || cliRoot="${MMDAPP%/}"
		cliNamed="$( AgentsToolsPresetRead "${MMDAPP%/}" magic-team SPAWN_CLI_SERVICE )"
		for cliOne in LOW NORMAL HIGH ; do
			cliSpec="$( AgentsToolsPresetRead "$cliRoot" magic-team "SPAWN_TIER_$cliOne" )"
			[ -n "$cliSpec" ] || continue
			cliSpec="$( AgentsToolsPresetEffective "$cliRoot" "${cliSpec%%:*}" PRESET_CLI_SERVICE 2> /dev/null )" || cliSpec=""
			[ -z "$cliSpec" ] || cliNamed="$cliNamed $cliSpec"
		done
		cliWords="none"
		if [ -n "${cliNamed// /}" ] ; then
			cliLines="$( . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/manager/AgentsTools.ManagerConfig.include" --definitions-only > /dev/null 2>&1 || :
				AgentsToolsManagerConfigCli 2> /dev/null )" || cliLines=""
			while IFS=$'\t' read -r cliRow cliSubject cliGroup cliKey cliState cliValue cliRest ; do
				[ "$cliRow" = "line" ] && [ "$cliSubject" = "cli" ] && [ "$cliKey" = "usable" ] && [ "$cliState" = "set" ] && [ "$cliValue" = "yes" ] || continue
				case " $cliNamed " in *" $cliGroup "*) cliWords="set" ; break ;; esac
			done <<< "$cliLines"
		fi
		LocalToolsManagerDashboardKeep cli-service "${MMDAPP%/}" "$cliWords" || :
	fi
	[ "$cliWords" = "set" ]
}

## TOKENS. What a total covers: in, cache read, cache write and out, all added, of every run
## of a session, as the list of sessions has them from the store of each run. `running` is
## the sessions that run now; `finished-today` those whose last run closed on this host's
## date of today; `not-whole` how many of those sessions have a run with no known figures,
## so that their total is less than they used. No transcript is opened for any of it. Left out
## where no AI CLI service is set up (AgentsToolsManagerDashboardCliSet).
AgentsToolsManagerDashboardTokens(){
	AgentsToolsManagerDashboardCliSet || return 0
	AgentsToolsManagerDashboardSessionCounts
	[ "$dashboardSessions" = "read" ] || return 0
	LocalToolsManagerDashboardFigure tokens running "Running Sessions Tokens" "$tokensRunning" count - ""
	LocalToolsManagerDashboardFigure tokens finished-today "Finished Today Tokens" "$tokensToday" count - ""
	LocalToolsManagerDashboardFigure tokens not-whole "Sessions Not Whole" "$tokensPartial" count - ""
	return 0
}

## THE LONGER PANEL of `Agents: Tokens`: the same figures as the panel of the Dashboard, with how many sessions each
## total is of and what a session of them took on average (a whole number, the total over the sessions that have a
## figure). Left out as the shorter panel is.
AgentsToolsManagerDashboardTokensLong(){
	AgentsToolsManagerDashboardCliSet || return 0
	AgentsToolsManagerDashboardSessionCounts
	[ "$dashboardSessions" = "read" ] || return 0
	LocalToolsManagerDashboardFigure tokens running "Running Sessions Tokens" "$tokensRunning" count - ""
	LocalToolsManagerDashboardFigure tokens running-sessions "Running Sessions Counted" "$tokensRunningSessions" count - ""
	[ "$tokensRunningSessions" -eq 0 ] || LocalToolsManagerDashboardFigure tokens running-average "Average Per Running Session" "$(( tokensRunning / tokensRunningSessions ))" count - ""
	LocalToolsManagerDashboardFigure tokens finished-today "Finished Today Tokens" "$tokensToday" count - ""
	LocalToolsManagerDashboardFigure tokens finished-today-sessions "Finished Today Sessions Counted" "$tokensTodaySessions" count - ""
	[ "$tokensTodaySessions" -eq 0 ] || LocalToolsManagerDashboardFigure tokens finished-today-average "Average Per Finished Session" "$(( tokensToday / tokensTodaySessions ))" count - ""
	LocalToolsManagerDashboardFigure tokens not-whole "Sessions Not Whole" "$tokensPartial" count - ""
	return 0
}

## THE SESSIONS THAT TOOK THE MOST TOKENS, from the same rows of the list of sessions (agentsManagerDashboardTopSessions
## of them, the most first): those that count in the panel above, the sessions that are not finished and those that finished
## today, as the rows are measured (AgentsToolsManagerDashboardSessionMeasured). Each is a figure named by the session, its name where
## it has one, else its id, and the total of its runs; a total that is less than the session used ends its label with `+`.
## A session with no known figures is not ranked. Left out as the shorter panel is.
agentsManagerDashboardTopSessions=5
AgentsToolsManagerDashboardTopSessions(){
	local topTokens topLabel topPlace=0
	AgentsToolsManagerDashboardCliSet || return 0
	AgentsToolsManagerDashboardSessionCounts
	[ "$dashboardSessions" = "read" ] || return 0
	while IFS=$'\t' read -r topTokens topLabel ; do
		[ -n "$topLabel" ] || continue
		topPlace=$(( topPlace + 1 ))
		LocalToolsManagerDashboardFigure top-sessions "top-$topPlace" "$topLabel" "$topTokens" count - ""
	done <<< "$( printf '%s\n' "$dashboardSessionRows" | LC_ALL=C awk -F'\t' -v todayDate="$dashboardToday" '
		$1 == "session" && $12 ~ /^[0-9]+[+]?$/ && ( $4 != "finished" || substr($6, 1, 10) == todayDate ) {
			label = ( $3 == "-" || $3 == "" ) ? $2 : $3 ; gsub(/[ \t]/, "_", label ) ; label = substr(label, 1, 40) ;
			figure = $12 ; if (sub(/[+]$/, "", figure)) label = label "+" ;
			printf "%s\t%s\n", figure, label ;
		}
	' | LC_ALL=C sort -t "$(printf '\t')" -k1,1nr -s | LC_ALL=C head -n "$agentsManagerDashboardTopSessions" )"
	return 0
}

## THE TEAM: the members the machine's directory of members names, the team itself not
## counted, which is no member of it; how many of them can be started here, by what the one
## check of a start asks (a folder that is there, and no identity record); and how many
## have a run with a live process in a session of this workspace. The first two are a file
## of each member read, and change when a member is set up or taken away: they are kept
## (LocalToolsManagerDashboardKeep), and read again once what is kept is older than
## agentsManagerDashboardSizeSeconds. Who runs is measured at every call.
AgentsToolsManagerDashboardTeam(){
	local teamMember teamDir teamTotal=0 teamStart=0 teamRest
	if LocalToolsManagerDashboardKept team-members "$agentsManagerDashboardSizeSeconds" "${MMDAPP%/}" ; then
		read -r teamTotal teamStart teamRest <<< "$dashboardKept" || :
		case "$teamTotal$teamStart" in ''|*[!0123456789]*) teamTotal=0 ; teamStart=0 ; dashboardKept="" ;; esac
	fi
	if [ -z "$dashboardKept" ] ; then
		while IFS=$'\t' read -r teamMember teamDir ; do
			[ -n "$teamMember" ] || continue
			! AgentsToolsTeamMemberIsTeam "$teamMember" || continue
			teamTotal=$(( teamTotal + 1 ))
			[ -n "$teamDir" ] && [ -d "$teamDir" ] || continue
			! AgentsToolsTeamMemberReferenceOnly "$teamDir" || continue
			teamStart=$(( teamStart + 1 ))
		done <<< "$( AgentsToolsTeamMemberDirectoryText 2> /dev/null )"
		LocalToolsManagerDashboardKeep team-members "${MMDAPP%/}" "$teamTotal $teamStart" || :
	fi
	[ "$teamTotal" -gt 0 ] || return 0
	LocalToolsManagerDashboardFigure team members "Members Known" "$teamTotal" count - ""
	LocalToolsManagerDashboardShare "$teamStart" "$teamTotal"
	LocalToolsManagerDashboardFigure team startable "Members To Start" "$teamStart" count - "$dashboardShare"
	AgentsToolsManagerDashboardSessionCounts
	[ "$dashboardSessions" = "read" ] || return 0
	LocalToolsManagerDashboardShare "$membersLive" "$teamStart"
	LocalToolsManagerDashboardFigure team running "Members Running Now" "$membersLive" count - "$dashboardShare"
	return 0
}

## THE SIZE OF A FOLDER, MEASURED AND KEPT, in dashboardSize, in bytes; empty where it is
## not known. du(1) walks every file under the folder, which is the one slow thing here, so
## what it said is kept (LocalToolsManagerDashboardKeep) and a call walks nothing while
## that is of this folder and not older than agentsManagerDashboardSizeSeconds. With no
## folder to keep the answer in, the folder is not measured at all: it is never walked at
## every call.
AgentsToolsManagerDashboardSize(){ ## folder
	local sizeText="" sizeBlocks=""
	dashboardSize=""
	if LocalToolsManagerDashboardKept team-data-size "$agentsManagerDashboardSizeSeconds" "$1" ; then
		sizeBlocks="$dashboardKept"
	else
		mkdir -p "${MMDAPP%/}/.local/temp" 2> /dev/null && [ -w "${MMDAPP%/}/.local/temp" ] || return 0
		## du says what it could read and ends non-zero over what it could not: its figure is taken either way.
		sizeText="$( LC_ALL=C du -sk "$1" 2> /dev/null )" || :
		sizeBlocks="${sizeText%%[[:space:]]*}"
	fi
	case "$sizeBlocks" in ''|*[!0123456789]*|????????????????*) return 0 ;; esac
	[ -n "$dashboardKept" ] || LocalToolsManagerDashboardKeep team-data-size "$1" "$sizeBlocks" || return 0
	dashboardSize=$(( sizeBlocks * 1024 ))
	return 0
}

## TEAM DATA: where its root is, as the context resolved it, and whether it is there; its
## size, kept; and the items of its board by state, a folder of the board a state and a
## `.md` file of it an item, counted by the shell's own listing. NO git command is run: what
## only git knows of the team data, what is not committed and what is not pushed, is no
## figure here.
AgentsToolsManagerDashboardTeamData(){
	local dataRoot="${MDAT_DATA_ROOT:-}" dataState dataDir dataCounts="" dataCount dataLabel dataSeen=" "
	[ -n "$dataRoot" ] || return 0
	dataRoot="${dataRoot%/}"
	LocalToolsManagerDashboardFigure team-data root "Team Data Root" "$dataRoot" - - ""
	if [ ! -d "$dataRoot" ] ; then
		LocalToolsManagerDashboardFigure team-data present "Team Data Present" no - bad ""
		return 0
	fi
	LocalToolsManagerDashboardFigure team-data present "Team Data Present" yes - ok ""
	AgentsToolsManagerDashboardSize "$dataRoot"
	[ -z "$dashboardSize" ] || LocalToolsManagerDashboardFigure team-data size "Team Data Size" "$dashboardSize" bytes - ""
	AgentsToolsManagerDashboardStores "$dataRoot"
	[ -d "$dataRoot/board" ] || return 0
	for dataState in $agentsManagerDashboardBoardStates ; do
		dataSeen="$dataSeen$dataState "
		[ -d "$dataRoot/board/$dataState" ] || continue
		set -- "$dataRoot/board/$dataState"/*.md
		[ -f "$1" ] || set --
		dataCounts="$dataCounts$dataState $#"$'\n'
	done
	for dataDir in "$dataRoot/board"/*/ ; do
		[ -d "$dataDir" ] || continue
		dataState="${dataDir%/}" ; dataState="${dataState##*/}"
		case "$dataState" in *[!abcdefghijklmnopqrstuvwxyz0123456789-]*|'') continue ;; esac
		case "$dataSeen" in *" $dataState "*) continue ;; esac
		set -- "$dataDir"*.md
		[ -f "$1" ] || set --
		dataCounts="$dataCounts$dataState $#"$'\n'
	done
	[ -n "$dataCounts" ] || return 0
	## The label of a state is its words, capitalised, after `Board Items`.
	while read -r dataState dataCount dataLabel ; do
		[ -n "$dataState" ] || continue
		LocalToolsManagerDashboardFigure team-data "board-$dataState" "Board Items $dataLabel" "$dataCount" count - ""
	done <<< "$( printf '%s' "$dataCounts" | LC_ALL=C awk '{
		stateWords = split($1, stateWord, "-") ; stateLabel = "" ;
		for (stateAt = 1 ; stateAt <= stateWords ; stateAt++) stateLabel = stateLabel ( stateAt > 1 ? "_" : "" ) toupper(substr(stateWord[stateAt], 1, 1)) substr(stateWord[stateAt], 2) ;
		print $1, $2, stateLabel ;
	}' )"
	return 0
}

## THE AUDIT AND THE VAULT OF THE TEAM DATA, beside its board: of each of the two that is
## there, how many items it holds and how long ago its newest came; of the audit, which
## files its items by month, also how many came this month. An audit item is a file of
## `audit/` or of a month folder of it, a record or a session's log, dated by the stamp of its
## name, `<YYYYMMDD>T<HHMM>`,
## which a checkout keeps; a vault item is any file of `vault/` or of a folder of it, whose
## names are open, dated by the file. No item is opened. Kept as the size is.
AgentsToolsManagerDashboardStores(){ ## team data root
	local storesRoot="$1" storesWords="" storesMonth storesStat="" storesAudit="- - -" storesVault="- -"
	local storesItems storesThisMonth storesStamp storesCount storesNewest
	storesMonth="$( date -u '+%Y-%m' 2> /dev/null )" || storesMonth=""
	if LocalToolsManagerDashboardKept team-data-stores "$agentsManagerDashboardSizeSeconds" "$storesRoot" ; then
		storesWords="$dashboardKept"
	else
		if [ -d "$storesRoot/audit" ] ; then
			storesAudit="$( cd "$storesRoot/audit" 2> /dev/null && for storesItems in * */* ; do [ -f "$storesItems" ] && printf '%s\n' "$storesItems" ; done | LC_ALL=C awk -v month="$storesMonth" '
				{ items++ ; name = $0 ; folder = "" ; if ( index( name, "/" ) ) { folder = substr( name, 1, index( name, "/" ) - 1 ) ; sub( /^[^\/]*\//, "", name ) }
				  stamp = "" ; if ( match( name, /[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T[0-9][0-9][0-9][0-9]/ ) ) stamp = substr( name, RSTART, RLENGTH )
				  if ( stamp > newest ) newest = stamp
				  if ( folder == month || ( folder == "" && stamp != "" && substr( stamp, 1, 4 ) "-" substr( stamp, 5, 2 ) == month ) ) inMonth++ }
				END { printf "%d %d %s\n", items, inMonth, ( newest == "" ? "-" : newest ) }' )" || storesAudit="- - -"
		fi
		if [ -d "$storesRoot/vault" ] ; then
			if stat -f '%m' / > /dev/null 2>&1 ; then storesStat="-f %m" ; elif stat -c '%Y' / > /dev/null 2>&1 ; then storesStat="-c %Y" ; fi
			storesCount=0 ; storesNewest="-"
			for storesItems in "$storesRoot/vault"/* "$storesRoot/vault"/*/* ; do
				[ -f "$storesItems" ] || continue
				storesCount=$(( storesCount + 1 ))
				[ -n "$storesStat" ] || continue
				storesStamp="$( stat $storesStat "$storesItems" 2> /dev/null )" || continue
				case "$storesStamp" in ''|*[!0123456789]*) continue ;; esac
				[ "$storesNewest" != "-" ] && [ "$storesNewest" -ge "$storesStamp" ] || storesNewest="$storesStamp"
			done
			storesVault="$storesCount $storesNewest"
		fi
		storesWords="$storesAudit $storesVault"
		[ "$storesWords" = "- - - - -" ] || LocalToolsManagerDashboardKeep team-data-stores "$storesRoot" "$storesWords" || :
	fi
	read -r storesItems storesThisMonth storesStamp storesCount storesNewest <<< "$storesWords"
	case "$storesItems" in ''|*[!0123456789]*) ;; *)
		LocalToolsManagerDashboardFigure team-data audit-items "Audit Items" "$storesItems" count - ""
		LocalToolsManagerDashboardFigure team-data audit-month "Audit Items This Month" "${storesThisMonth:-0}" count - ""
		case "$storesStamp" in ????????T????)
			LocalToolsManagerDashboardAge "${storesStamp:0:4}-${storesStamp:4:2}-${storesStamp:6:2}T${storesStamp:9:2}:${storesStamp:11:2}:00Z"
			[ -z "$dashboardAge" ] || LocalToolsManagerDashboardFigure team-data audit-newest "Audit Newest Item" "$dashboardAge" seconds - ""
		;; esac
	;; esac
	case "$storesCount" in ''|*[!0123456789]*) ;; *)
		LocalToolsManagerDashboardFigure team-data vault-items "Vault Items" "$storesCount" count - ""
		case "$storesNewest" in ''|*[!0123456789]*) ;; *)
			[ "$dashboardNow" -lt "$storesNewest" ] || LocalToolsManagerDashboardFigure team-data vault-newest "Vault Newest Item" "$(( dashboardNow - storesNewest ))" seconds - ""
		;; esac
	;; esac
	return 0
}

## THE GIT STATE OF THE TEAM DATA, printed only where it is asked for by name (its one reader
## that runs git): local calls alone, no fetch, nothing reaches another host; kept for
## agentsManagerDashboardGitSeconds. Whether the store is a repository; where it is, its
## branch, the upstream it tracks, how many commits it is ahead and behind that as of its
## last fetch, how many paths under the store are not committed, and its last commit, how
## long ago and its subject. Judged only on a full team rig (AgentsToolsManagerConfigMode):
## ahead or behind or paths not committed `warn`, ahead and behind at once `bad`, else `ok`.
AgentsToolsManagerDashboardTeamDataGit(){
	local gitRoot="${MDAT_DATA_ROOT:-}" gitWords="" gitRepo gitBranch gitUpstream gitAhead gitBehind gitDirty gitEpoch gitSubject gitJudged="" gitLevel
	[ -n "$gitRoot" ] && [ -d "$gitRoot" ] || return 0
	gitRoot="${gitRoot%/}"
	if LocalToolsManagerDashboardKept team-data-git "$agentsManagerDashboardGitSeconds" "$gitRoot" ; then
		gitWords="$dashboardKept"
	else
		if [ "$( git -C "$gitRoot" rev-parse --is-inside-work-tree 2> /dev/null )" != "true" ] ; then
			gitWords="no"
		else
			gitBranch="$( git -C "$gitRoot" symbolic-ref --quiet --short HEAD 2> /dev/null )" || gitBranch="-"
			gitUpstream="$( git -C "$gitRoot" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2> /dev/null )" || gitUpstream="-"
			gitAhead="-" ; gitBehind="-"
			[ "${gitUpstream:--}" = "-" ] || read -r gitAhead gitBehind <<< "$( git -C "$gitRoot" rev-list --left-right --count 'HEAD...@{u}' 2> /dev/null )" || :
			gitDirty="$( git -C "$gitRoot" status --porcelain -- . 2> /dev/null | LC_ALL=C awk 'END { print NR }' )" || gitDirty="-"
			read -r gitEpoch gitSubject <<< "$( git -C "$gitRoot" log -1 --format='%ct %s' 2> /dev/null )" || :
			gitWords="yes ${gitBranch:--} ${gitUpstream:--} ${gitAhead:--} ${gitBehind:--} ${gitDirty:--} ${gitEpoch:--} ${gitSubject:-}"
		fi
		LocalToolsManagerDashboardKeep team-data-git "$gitRoot" "$gitWords" || :
	fi
	read -r gitRepo gitBranch gitUpstream gitAhead gitBehind gitDirty gitEpoch gitSubject <<< "$gitWords"
	LocalToolsManagerDashboardFigure team-data-git repository "Team Data Repository" "${gitRepo:-no}" - - ""
	[ "$gitRepo" = "yes" ] || return 0
	case "$( . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/manager/AgentsTools.ManagerConfig.include" --definitions-only > /dev/null 2>&1 || : ; AgentsToolsManagerConfigMode 2> /dev/null )" in *" yes") gitJudged="yes" ;; esac
	LocalToolsManagerDashboardFigure team-data-git branch "Team Data Branch" "$gitBranch" - - ""
	[ "$gitUpstream" = "-" ] || LocalToolsManagerDashboardFigure team-data-git upstream "Team Data Upstream" "$gitUpstream" - - ""
	case "$gitAhead:$gitBehind" in *[!0123456789:]*|:*|*:) ;; *)
		gitLevel="ok" ; [ "$gitAhead" = 0 ] && [ "$gitBehind" = 0 ] || gitLevel="warn" ; [ "$gitAhead" = 0 ] || [ "$gitBehind" = 0 ] || gitLevel="bad"
		[ -n "$gitJudged" ] || gitLevel="-"
		LocalToolsManagerDashboardFigure team-data-git ahead "Commits Ahead" "$gitAhead" count "$gitLevel" ""
		LocalToolsManagerDashboardFigure team-data-git behind "Commits Behind" "$gitBehind" count "$gitLevel" ""
	;; esac
	case "$gitDirty" in ''|*[!0123456789]*) ;; *)
		gitLevel="ok" ; [ "$gitDirty" = 0 ] || gitLevel="warn" ; [ -n "$gitJudged" ] || gitLevel="-"
		LocalToolsManagerDashboardFigure team-data-git uncommitted "Paths Not Committed" "$gitDirty" count "$gitLevel" ""
	;; esac
	case "$gitEpoch" in ''|*[!0123456789]*) ;; *)
		[ "$dashboardNow" -lt "$gitEpoch" ] || LocalToolsManagerDashboardFigure team-data-git last-commit "Last Commit" "$(( dashboardNow - gitEpoch ))" seconds - ""
		[ -z "$gitSubject" ] || LocalToolsManagerDashboardFigure team-data-git last-subject "Last Commit Subject" "$gitSubject" - - ""
	;; esac
	return 0
}

## THE MAIN LOOP AND THE HEARTBEAT, as the digest of the settings reads them, by its own
## reader (AgentsToolsManagerConfigLoop), whose lines are taken here: how the last iteration
## of the main loop ended, how long ago, and after how many failures in a row; the state of
## the heartbeat, how long ago its last iteration was, and whether it runs, which it does
## while its lock is held. Nothing the tooling keeps says that a main loop runs now, so
## that is no figure. Left out where no main loop left its state and no heartbeat its note,
## and in every mode of the workspace but `team-rig`, where the digest says nothing of it.
## Its figures are judged, `warn` and `bad`, only on a FULL TEAM RIG, whose team data has a git
## remote, as the digest's reader of the mode says (AgentsToolsManagerConfigMode, which
## asks whether one is set and keeps no text of it); elsewhere they are shown plain, `-`.
AgentsToolsManagerDashboardLoop(){
	local loopLines loopRow loopSubject loopGroup loopKey loopState loopValue loopRest loopLevel loopNote="" loopJudged=""
	loopLines="$( . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/manager/AgentsTools.ManagerConfig.include" --definitions-only > /dev/null 2>&1 || :
		printf 'mode\t%s\n' "$( AgentsToolsManagerConfigMode 2> /dev/null )"
		AgentsToolsManagerConfigLoop 2> /dev/null )" || loopLines=""
	while IFS=$'\t' read -r loopRow loopSubject loopGroup loopKey loopState loopValue loopRest ; do
		[ "$loopRow" != "mode" ] || { [ "${loopSubject##* }" != "yes" ] || loopJudged="yes" ; continue ; }
		[ "$loopRow" = "line" ] || continue
		case "$loopGroup:$loopKey:$loopState" in
			main-loop:MAIN_LOOP_LAST_OUTCOME:set)
				case "$loopValue" in ok) loopLevel="ok" ;; failed|timed-out) loopLevel="bad" ;; *) loopLevel="-" ;; esac
				[ -n "$loopJudged" ] || loopLevel="-"
				LocalToolsManagerDashboardFigure loop main-loop-outcome "Main Loop Last Outcome" "$loopValue" - "$loopLevel" ""
			;;
			main-loop:MAIN_LOOP_LAST_ITERATION_UTC:set)
				LocalToolsManagerDashboardAge "$loopValue"
				[ -z "$dashboardAge" ] || LocalToolsManagerDashboardFigure loop main-loop-age "Main Loop Last Iteration" "$dashboardAge" seconds - ""
			;;
			main-loop:MAIN_LOOP_CONSECUTIVE_FAILURES:set)
				case "$loopValue" in ''|*[!0123456789]*) continue ;; esac
				loopLevel="ok" ; [ "$loopValue" = 0 ] || loopLevel="warn"
				[ -n "$loopJudged" ] || loopLevel="-"
				LocalToolsManagerDashboardFigure loop main-loop-failures "Main Loop Consecutive Failures" "$loopValue" count "$loopLevel" ""
			;;
			heartbeat:state-note:set) loopNote="yes" ;;
			heartbeat:state:set) LocalToolsManagerDashboardFigure loop heartbeat-state "Heartbeat State" "$loopValue" - - "" ;;
			heartbeat:last-iteration-timestamp:set)
				LocalToolsManagerDashboardAge "$loopValue"
				[ -z "$dashboardAge" ] || LocalToolsManagerDashboardFigure loop heartbeat-age "Heartbeat Last Iteration" "$dashboardAge" seconds - ""
			;;
			heartbeat:running:*)
				[ -n "$loopNote" ] || continue
				case "$loopValue" in yes|no) LocalToolsManagerDashboardFigure loop heartbeat-running "Heartbeat Running" "$loopValue" - - "" ;; esac
			;;
		esac
	done <<< "$loopLines"
	return 0
}

## DISK SPACE as the agents register it: `.local`'s panel (the workspace and its temp folder), with the root of the team
## data added to the volumes it shows.
AgentsToolsManagerDashboardDisk(){
	local localManagerDashboardDiskVolumes
	localManagerDashboardDiskVolumes="team-data"$'\t'"Team_Data_Volume"$'\t'"${MDAT_DATA_ROOT:-}"
	LocalToolsManagerDashboardDisk
}

## TESTING: the retests that wait in the queue of the machine, which is one folder
## (AgentsTools.MemberRetest.include), a request a file of its `waiting`, and how long the
## oldest of them waits, by its own `asked` line. A request is named by the moment it was
## asked, so the first by name is the oldest. Left out where the queue is not there.
AgentsToolsManagerDashboardTesting(){
	local testingQueue testingLine testingAsked="" testingLines=0
	[ -n "${HOME:-}" ] || return 0
	testingQueue="$( AgentsToolsTeamSharedDir )/retest-queue/waiting"
	[ -d "$testingQueue" ] || return 0
	set -- "$testingQueue"/*.request
	[ -f "$1" ] || set --
	LocalToolsManagerDashboardFigure testing waiting "Retests Waiting" "$#" count - ""
	[ $# -gt 0 ] || return 0
	{
		while IFS= read -r testingLine && [ "$testingLines" -lt 20 ] ; do
			testingLines=$(( testingLines + 1 ))
			case "$testingLine" in 'asked: '*) testingAsked="${testingLine#asked: }" ; break ;; esac
		done < "$1"
	} 2> /dev/null || :
	LocalToolsManagerDashboardAge "$testingAsked"
	[ -z "$dashboardAge" ] || LocalToolsManagerDashboardFigure testing oldest-age "Oldest Retest Age" "$dashboardAge" seconds - ""
	return 0
}
