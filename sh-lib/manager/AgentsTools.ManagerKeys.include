#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.ManagerKeys.include -- the --manager-keys-* operations: the PUBLIC keys this
## server shows to others, for an operator to see and to copy. Sourced from the
## `--manager-keys-*)` arm of AgentsTools.Manager.include; who may call was asked where the
## family is dispatched.
##
## WHICH KEYS THEY ARE IS NOT DECIDED HERE. They are the keys the rig's own command prints,
## `mdci-public-keys` (mdci-packages-myx/setup.feature-mdci/data/os-commands), found where it
## finds them, in its two kinds:
##   add-to-git         the key the account uses for git, which an owner lists on a git host
##       as a deploy or user key: the one its ssh command names (`git config --global
##       core.sshCommand`, its `-i`), else the deploy key of the account under its home ($HOME),
##       else the generated default; and that default beside it where it is another key;
##   trust-on-connect   the ssh host keys of this server, which whoever connects to it
##       checks and accepts: /etc/ssh/ssh_host_*_key.pub.
## And a third kind, which that command does not print, found as the family's own outgoing
## ssh finds its identity (myx.distro-deploy/sh-lib/lib.distro-image.include, what
## DistroSshConnect is given): in the ssh home of the one who runs the tools, ~/.ssh where a
## command names no other, the first that is there of client.key, id_ecdsa, id_ed25519,
## id_rsa, client.rsa:
##   add-to-authorized-keys   the key the deploy and remote tools of this workspace connect
##       out with, which the owner of a target puts into its authorized keys.
## An ssh home a command names itself (--ssh-home, a folder of the workspace's source) is not
## known here: only the default one is listed.
## THAT COMMAND IS NOT RUN HERE: where a public file is missing it derives the key from the
## private one, and it asks every git repository whether the key reads it. Here ONLY A PUBLIC
## FILE IS EVER OPENED, a file whose name ends `.pub`, and ssh-keygen is given no other. Of a
## private key only whether it is there is asked, as the command asks it, to know which key
## the account uses: it is never opened, and nothing of it is printed. A place with no
## public file says so. Nothing is written, and nothing reaches another host.
##

## The home of the rig's account, and the account, as mdci-public-keys takes them. The home is the HOME of
## the one who runs the tools: on mdci that is /usr/local/mdci, the home of its console account.
AgentsToolsManagerKeysHome(){
	printf '%s\n' "$HOME"
}
AgentsToolsManagerKeysAccount(){
	sysrc -n mdcid_user 2> /dev/null || echo mdci
}

## The key the account uses for git, as mdci-public-keys finds it: the path of the private
## key, which is only named here. Its public file is that path with `.pub` after it.
AgentsToolsManagerKeysDeploy(){
	local deployHome deployCommand deployNamed
	deployHome="$( AgentsToolsManagerKeysHome )"
	deployCommand="$( git config --global --get core.sshCommand 2> /dev/null )" || deployCommand=""
	deployNamed="$( printf '%s\n' "$deployCommand" | LC_ALL=C sed -n 's/.* -i \([^ ]*\).*/\1/p' )"
	if [ -n "$deployNamed" ] ; then
		printf '%s\n' "$deployNamed"
	elif [ -f "$deployHome/deploy-keys/$( AgentsToolsManagerKeysAccount )" ] ; then
		printf '%s\n' "$deployHome/deploy-keys/$( AgentsToolsManagerKeysAccount )"
	else
		printf '%s\n' "$deployHome/.ssh/id_ed25519"
	fi
}

## The keys, one a line, `<key>|<label>|<group>|<what it is for>|<public file>|<why none>`, in
## the order mdci-public-keys prints them: the key for git, the generated default where it is
## another, then each host key by the name of its file, or one line for the host keys where
## none is; then the key the tools connect out with. <why none> says, for a key that may not
## be there, why no public key is read at its file where none is.
AgentsToolsManagerKeysDeclared(){
	local declaredDeploy declaredHome declaredHost="${MDAT_MANAGER_KEYS_HOST_DIR:-/etc/ssh}" declaredFile declaredName declaredAny=""
	declaredHome="$( AgentsToolsManagerKeysHome )"
	declaredDeploy="$( AgentsToolsManagerKeysDeploy )"
	printf '%s\n' "deploy|Deploy Key To Add To Git|add-to-git|the deploy key of this server, to list as a deploy key on each git repository it reads|$declaredDeploy.pub"
	if [ "$declaredDeploy" != "$declaredHome/.ssh/id_ed25519" ] && [ -f "$declaredHome/.ssh/id_ed25519" ] ; then
		printf '%s\n' "generated|Generated Key Not Used For Git|add-to-git|another key the account generated, not used for git unless a repository is set up with it|$declaredHome/.ssh/id_ed25519.pub"
	fi
	for declaredFile in "$declaredHost"/ssh_host_*_key.pub ; do
		[ -f "$declaredFile" ] || continue
		declaredName="${declaredFile##*/ssh_host_}" ; declaredName="${declaredName%_key.pub}"
		case "$declaredName" in ''|*[!abcdefghijklmnopqrstuvwxyz0123456789]*) continue ;; esac
		declaredAny="yes"
		printf '%s\n' "host-$declaredName|Host Key $( printf '%s' "$declaredName" | LC_ALL=C tr 'a-z' 'A-Z' ) To Trust On Connect|trust-on-connect|an ssh host key of this server, for the known hosts of those who connect to it|$declaredFile"
	done
	[ -n "$declaredAny" ] || printf '%s\n' "host|Host Key To Trust On Connect|trust-on-connect|an ssh host key of this server, for the known hosts of those who connect to it|$declaredHost/ssh_host_key.pub|no ssh host key file stands in $declaredHost"
	## The key the tools connect out with: the first identity of their five names in the ssh
	## home of the one who runs them. Whether each is there is asked, as the tools ask it;
	## none is opened.
	declaredHome="${HOME%/}/.ssh" ; declaredAny=""
	for declaredName in client.key id_ecdsa id_ed25519 id_rsa client.rsa ; do
		[ -f "$declaredHome/$declaredName" ] || continue
		declaredAny="$declaredName"
		break
	done
	if [ -n "$declaredAny" ] ; then
		printf '%s\n' "outgoing|Our Key For Targets' Authorized Keys|add-to-authorized-keys|the key the deploy and remote tools of this workspace connect out with, as the user who runs them, to a target that lists it in its authorized keys|$declaredHome/$declaredAny.pub|the identity the tools take, $declaredAny, has no public file beside it"
	else
		printf '%s\n' "outgoing|Our Key For Targets' Authorized Keys|add-to-authorized-keys|the key the deploy and remote tools of this workspace connect out with, as the user who runs them, to a target that lists it in its authorized keys|$declaredHome/id_ed25519.pub|no identity of the tools stands in $declaredHome: none of client.key, id_ecdsa, id_ed25519, id_rsa, client.rsa"
	fi
	return 0
}

## THE TWO GROUPS THE LIST SHOWS (F11.7): `ours`, every key of this server that others are to trust, whatever it is for (a git server, the known hosts
## of those who connect, another host's authorized keys: each key says what it is for), and `trusted`, the keys this account trusts, its own authorized
## keys, which are only listed. The three kinds above stay what the keys of `ours` are, for the paste and for what may be made.
AgentsToolsManagerKeysListed(){ ## kind of a declared key
	case "$1" in
		add-to-git|trust-on-connect|add-to-authorized-keys) printf '%s\n' "ours" ;;
		*) printf '%s\n' "$1" ;;
	esac
}

## What a group of keys is called on a screen, by its name.
AgentsToolsManagerKeysGroupLabel(){ ## group
	case "$1" in
		ours) printf '%s\n' "Our Keys To Trust" ;;
		trusted) printf '%s\n' "Keys We Trust" ;;
		*) printf '%s\n' "$1" ;;
	esac
}

## The keys this account trusts, the lines of its authorized keys that hold a public key: `<n>|<type>|<key>|<comment>`, in the order they stand. A line
## may have options ahead of the key, which are not shown. Read-only: nothing here changes the file, and nothing of it is a secret. The file is
## the account's own, in the ssh home of the one who runs the tools; rc 1, nothing printed, where there is none or it cannot be read.
AgentsToolsManagerKeysTrustedFile(){
	printf '%s\n' "${HOME%/}/.ssh/authorized_keys"
}
AgentsToolsManagerKeysTrusted(){
	local trustedFile
	trustedFile="$( AgentsToolsManagerKeysTrustedFile )"
	[ -f "$trustedFile" ] && [ -r "$trustedFile" ] || return 1
	LC_ALL=C awk '
		/^[ \t]*(#|$)/ { next ; }
		{
			for ( at = 1 ; at < NF ; at++ ) { if ( $at ~ /^(ssh-|ecdsa-|sk-)/ ) { break ; } }
			if ( at >= NF || $at !~ /^(ssh-|ecdsa-|sk-)/ || $(at + 1) !~ /^[A-Za-z0-9+\/=]+$/ ) { next ; }
			comment = "" ;
			for ( rest = at + 2 ; rest <= NF ; rest++ ) { comment = comment ( comment == "" ? "" : " " ) $rest ; }
			printf "%d|%s|%s|%s\n", ++total, $at, $(at + 1), comment ;
		}
	' "$trustedFile"
}

## The `key` row of one trusted key, as the row of an own key has it: always `present`, the line as it stands in the file (type, key, comment).
AgentsToolsManagerKeysTrustedRow(){ ## n, type, key, comment
	local trustedPrint trustedLabel trustedShort="$3" trustedLine="$2 $3${4:+ $4}"
	trustedPrint="$( printf '%s\n' "$2 $3" | ssh-keygen -l -f - 2> /dev/null | LC_ALL=C awk '{ print $2 ; exit }' )" || trustedPrint=""
	trustedLabel="${4:-Trusted Key $1}"
	[ "${#trustedShort}" -le 24 ] || trustedShort="${3:0:12}...${3: -8}"
	printf 'key\ttrusted-%s\t%s\ttrusted\t%s\t%s\t%s\t%s\t%s\tpresent\t%s\n' "$1" "$( AgentsToolsManagerKeysField "$trustedLabel" )" \
		"$( AgentsToolsManagerKeysField "a key this account trusts, from its authorized keys: whoever holds its private key may log in here" )" "$2" "${trustedPrint:--}" "$trustedShort" \
		"$( AgentsToolsManagerKeysField "$( AgentsToolsManagerKeysTrustedFile )" )" "$( AgentsToolsManagerKeysField "$trustedLine" )"
}

## One field of a row: its whitespace reads `_`, and an empty one `-`, as in a registry.
AgentsToolsManagerKeysField(){ ## text
	local fieldText="${1//[[:space:]]/_}"
	printf '%s' "${fieldText:--}"
}

## The first line of a public key file, where it is one: `<type> <key> [<comment>]`, the type
## a key type's name and the key in the letters of base64 alone. Sets keysLine, keysType and
## keysText; rc 1, all three empty, where the file is not there, cannot be read, is no `.pub`
## file, or holds no such line. NOTHING BUT A FILE NAMED `.pub` IS OPENED.
AgentsToolsManagerKeysPublic(){ ## public file
	keysLine="" ; keysType="" ; keysText=""
	case "$1" in *.pub) ;; *) return 1 ;; esac
	[ -f "$1" ] && [ -r "$1" ] || return 1
	IFS= read -r keysLine < "$1" || [ -n "$keysLine" ] || return 1
	keysType="${keysLine%% *}" ; keysText="${keysLine#* }" ; keysText="${keysText%% *}"
	case "$keysType" in ssh-*|ecdsa-*|sk-*) ;; *) keysLine="" ; keysType="" ; keysText="" ; return 1 ;; esac
	case "$keysText" in ''|*[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=]*) keysLine="" ; keysType="" ; keysText="" ; return 1 ;; esac
	return 0
}

## The line of a public key as one pastes it: for a key to add to git the public key line as
## its file has it, whole; for a host key the line of a known hosts file, the name of this
## host ahead of the type and the key, as mdci-public-keys prints it. From what
## AgentsToolsManagerKeysPublic set.
AgentsToolsManagerKeysPaste(){ ## group
	local pasteHost
	if [ "$1" = "trust-on-connect" ] ; then
		pasteHost="$( hostname 2> /dev/null )" || pasteHost=""
		printf '%s %s %s\n' "${pasteHost:-localhost}" "$keysType" "$keysText"
	else
		printf '%s\n' "$keysLine"
	fi
}

## The `key` row of one declared key: `present` with its type, its fingerprint, its key in
## short, the first twelve and the last eight letters, and, the last field, THE WHOLE PUBLIC
## LINE as one pastes it, its blanks written as every field has them: a public key is public,
## and nothing of it is held back. `absent`, with `-` for these, where no public key can be
## read at its file. The fingerprint is ssh-keygen's, of the public file. The short form
## stays where it stood for whoever reads the row by its places.
AgentsToolsManagerKeysRow(){ ## key, label, group, what it is for, public file
	local rowPrint="" rowShort="-" rowState="absent" rowPaste="" keysLine keysType keysText
	if AgentsToolsManagerKeysPublic "$5" ; then
		rowState="present"
		rowPaste="$( AgentsToolsManagerKeysPaste "$3" )"
		rowPrint="$( ssh-keygen -l -f "$5" 2> /dev/null | LC_ALL=C awk '{ print $2 ; exit }' )" || rowPrint=""
		rowShort="$keysText"
		[ "${#keysText}" -le 24 ] || rowShort="${keysText:0:12}...${keysText: -8}"
	fi
	printf 'key\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$1" "$( AgentsToolsManagerKeysField "$2" )" "$( AgentsToolsManagerKeysListed "$3" )" "$( AgentsToolsManagerKeysField "$4" )" "${keysType:--}" "${rowPrint:--}" "$rowShort" "$( AgentsToolsManagerKeysField "$5" )" "$rowState" "$( AgentsToolsManagerKeysField "$rowPaste" )"
}

## THE KEYS THIS WORKSPACE MAY MAKE, REPLACE AND REMOVE (F11.7): the three of the account that runs the tools, `deploy` (the
## key for git), `generated` (the generated default, where it is another) and `outgoing` (the key the tools connect out with). The
## ssh host keys of the server, `trust-on-connect`, are the system's and are never touched here. A key is the pair a private file
## and its public file stand for: the private file is the public file's name without `.pub`, as AgentsToolsManagerKeysDeclared names
## it. A key is made as the rig's own installer makes the git key: ed25519, no passphrase, its comment `<account>@<host>`.
## Into private, public and group (set by AgentsToolsManagerKeysMine): the files of the key a word names. rc 1, with the reason
## and nothing done, for a word that names none of the three.
AgentsToolsManagerKeysMine(){ ## operation, key
	local mineKey mineLabel mineGroup mineFor mineFile mineRest
	keysPrivate="" ; keysPublic="" ; keysGroup=""
	case "$2" in ''|*[!abcdefghijklmnopqrstuvwxyz0123456789-]*)
		echo "⛔ ERROR: $MDSC_CMD $1: syntax is $1 <key>, and the word given is no name of a key -- nothing was done" >&2
		return 1
	;; esac
	while IFS='|' read -r mineKey mineLabel mineGroup mineFor mineFile mineRest ; do
		[ "$mineKey" = "$2" ] || continue
		case "$mineGroup" in
			add-to-git|add-to-authorized-keys) ;;
			*) echo "⛔ ERROR: $MDSC_CMD $1: the key '$2' is a host key of this server, the system's, and is never made, replaced or removed here -- nothing was done" >&2 ; return 1 ;;
		esac
		keysPublic="$mineFile" ; keysPrivate="${mineFile%.pub}" ; keysGroup="$mineGroup"
		return 0
	done <<< "$( AgentsToolsManagerKeysDeclared )"
	echo "⛔ ERROR: $MDSC_CMD $1: no key is named '$2' -- nothing was done. The keys are those ${1%-*}-list prints" >&2
	return 1
}

## A key made: its private file and its public file, beside each other, in a folder of the account's own (mode 700 where it is made
## here). Made under a name of its own first, and put in place by a rename, so that a key it replaces stays whole until the new one is.
## rc 1, with the reason, where ssh-keygen is not there or does not make it.
AgentsToolsManagerKeysMake(){ ## operation, private file
	local makeDir makeAccount makeTemp
	command -v ssh-keygen > /dev/null 2>&1 || { echo "⛔ ERROR: $MDSC_CMD $1: ssh-keygen is not on the PATH -- nothing was done" >&2 ; return 1 ; }
	makeDir="${2%/*}"
	[ -d "$makeDir" ] || { mkdir -p "$makeDir" && chmod 700 "$makeDir" ; } || { echo "⛔ ERROR: $MDSC_CMD $1: the folder of the key could not be made -- nothing was done" >&2 ; return 1 ; }
	makeAccount="$( id -un 2> /dev/null )" || makeAccount=""
	makeTemp="$( mktemp -d "$2.new.XXXXXX" 2> /dev/null )" || { echo "⛔ ERROR: $MDSC_CMD $1: a folder for the new key could not be made beside it -- nothing was changed" >&2 ; return 1 ; }
	if ! ssh-keygen -q -t ed25519 -N '' -C "${makeAccount:-key}@$( hostname 2> /dev/null || echo localhost )" -f "$makeTemp/key" > /dev/null 2>&1 ; then
		rm -rf -- "$makeTemp"
		echo "⛔ ERROR: $MDSC_CMD $1: ssh-keygen did not make the key -- nothing was changed" >&2
		return 1
	fi
	chmod 600 "$makeTemp/key" && chmod 644 "$makeTemp/key.pub" && mv -f "$makeTemp/key.pub" "$2.pub" && mv -f "$makeTemp/key" "$2" || { rm -rf -- "$makeTemp" ; echo "⛔ ERROR: $MDSC_CMD $1: the new key could not be put in place" >&2 ; return 1 ; }
	rm -rf -- "$makeTemp"
	return 0
}

## The row that says a key was made, replaced or removed, from the pair as it stands: what happened, the key, its private file, its type
## and its fingerprint (`-` for a removed one).
AgentsToolsManagerKeysDone(){ ## what happened, key, private file
	local doneType="-" doneFinger="-" keysLine keysType keysText
	if AgentsToolsManagerKeysPublic "$3.pub" ; then
		doneType="$keysType"
		doneFinger="$( ssh-keygen -l -f "$3.pub" 2> /dev/null | LC_ALL=C awk '{ print $2 ; exit }' )" || doneFinger=""
	fi
	printf '%s\t%s\t%s\t%s\t%s\n' "$1" "$2" "$( AgentsToolsManagerKeysField "$3" )" "$doneType" "${doneFinger:--}"
}

## THE KEYS THIS ACCOUNT TRUSTS, ADDED AND REMOVED (C1): the native `authorized_keys` in the ssh home of the one who
## runs the tools, one line a public key, options, comments and blanks left as they stand. A key is added by its whole
## public line, as it is pasted, and removed by its name in the list, `trusted-<n>`. Nothing is reached, and nothing but
## that file is written: a public key is public, and the file holds no secret.

## The one public key line to trust, read whole from the standard input, and what it is: its type, its key, its
## comment. Sets keysLine (the line as it was read), keysType, keysText and keysComment; rc 1, all four empty, where
## the input is not exactly one such line: a key type, then the key in the letters of base64, then anything, with no
## control character and no second line.
AgentsToolsManagerKeysTrustedLine(){
	keysLine="" ; keysType="" ; keysText="" ; keysComment=""
	local trustAll
	## Read from the standard input with the shell itself: no unbounded reader is used here, and
	## the include opens no file of its own for it.
	trustAll="$( < /dev/stdin )" || return 1
	[ -n "$trustAll" ] || return 1
	## a command substitution ends where the line ends; any line end that is left is a second line
	case "$trustAll" in *$'\n'*) return 1 ;; esac
	case "$trustAll" in *[[:cntrl:]]*) return 1 ;; esac
	keysType="${trustAll%% *}" ; keysLine="$trustAll"
	[ "$keysType" != "$trustAll" ] || return 1
	keysText="${trustAll#* }"
	case "$keysText" in
		*' '*) keysComment="${keysText#* }" ; keysText="${keysText%% *}" ;;
		*) keysComment="" ;;
	esac
	case "$keysType" in ssh-*|ecdsa-*|sk-*) ;; *) return 1 ;; esac
	case "$keysText" in ''|*[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=]*) return 1 ;; esac
	return 0
}

## The fingerprint of a public key given by its type and its key, as ssh-keygen gives it; `-` where it cannot.
AgentsToolsManagerKeysTrustedFinger(){ ## type, key
	local fingerPrint
	fingerPrint="$( printf '%s %s\n' "$1" "$2" | ssh-keygen -l -f - 2> /dev/null | LC_ALL=C awk '{ print $2 ; exit }' )" || fingerPrint=""
	printf '%s' "${fingerPrint:--}"
}

## The row that says a key was added to or removed from the authorized keys: what happened, its number among them,
## the file, its type and its fingerprint.
AgentsToolsManagerKeysTrustedDone(){ ## what happened, n, file, type, fingerprint
	printf '%s\ttrusted-%s\t%s\t%s\t%s\n' "$1" "$2" "$( AgentsToolsManagerKeysField "$3" )" "$4" "$5"
}

## The mode of a file, to put it back after a write: BSD and GNU stat both.
AgentsToolsManagerKeysMode(){ ## file
	stat -f '%Lp' "$1" 2> /dev/null || stat -c '%a' "$1"
}
case "$1" in

	## The public keys of this server, one row each: TAB-separated rows a screen reads. Their
	## form is the help entry's.
	--manager-keys-list)
		local listOp="$1" listKey listLabel listGroup listFor listFile listWhy listAll listNow="" listRows listNote keysLine keysType keysText listShown listTrusted listN listType listText listComment listFileOf
		shift
		if [ $# -gt 0 ] ; then
			echo "⛔ ERROR: $MDSC_CMD $listOp: syntax is $listOp, got $# argument(s) -- nothing is shown" >&2
			set +e ; return 1
		fi
		## A group at a time, in the order its first key stands: one `group` row, with how many
		## keys it has, its label, and, where none of them can be read, why; then its keys.
		listAll="$( AgentsToolsManagerKeysDeclared )"
		while IFS='|' read -r listKey listLabel listGroup listFor listFile listWhy ; do
			[ -n "$listKey" ] || continue
			listShown="$( AgentsToolsManagerKeysListed "$listGroup" )"
			if [ "$listShown" != "$listNow" ] ; then
				[ -z "$listNow" ] || { printf 'group\t%s\t%s\t%s\t%s\n' "$listNow" "$( printf '%s\n' "$listRows" | LC_ALL=C grep -c . )" "$( AgentsToolsManagerKeysField "$( AgentsToolsManagerKeysGroupLabel "$listNow" )" )" "$( AgentsToolsManagerKeysField "$listNote" )" ; printf '%s\n' "$listRows" ; }
				listNow="$listShown" ; listRows="" ; listNote=""
			fi
			## why a key of the group cannot be read, each once, in the order the keys stand
			if ! AgentsToolsManagerKeysPublic "$listFile" ; then listNote="$listNote${listNote:+; }${listWhy:-no public key can be read at $listFile}" ; fi
			listRows="$listRows${listRows:+$'\n'}$( AgentsToolsManagerKeysRow "$listKey" "$listLabel" "$listGroup" "$listFor" "$listFile" )"
		done <<< "$listAll"
		[ -z "$listNow" ] || { printf 'group\t%s\t%s\t%s\t%s\n' "$listNow" "$( printf '%s\n' "$listRows" | LC_ALL=C grep -c . )" "$( AgentsToolsManagerKeysField "$( AgentsToolsManagerKeysGroupLabel "$listNow" )" )" "$( AgentsToolsManagerKeysField "$listNote" )" ; printf '%s\n' "$listRows" ; }
		## The keys this account trusts, read-only: the lines of its authorized keys that hold a public key.
		listFileOf="$( AgentsToolsManagerKeysTrustedFile )"
		if listTrusted="$( AgentsToolsManagerKeysTrusted )" && [ -n "$listTrusted" ] ; then
			printf 'group\ttrusted\t%s\t%s\t-\n' "$( printf '%s\n' "$listTrusted" | LC_ALL=C grep -c . )" "$( AgentsToolsManagerKeysField "$( AgentsToolsManagerKeysGroupLabel trusted )" )"
			while IFS='|' read -r listN listType listText listComment ; do
				AgentsToolsManagerKeysTrustedRow "$listN" "$listType" "$listText" "$listComment"
			done <<< "$listTrusted"
		else
			printf 'group\ttrusted\t0\t%s\t%s\n' "$( AgentsToolsManagerKeysField "$( AgentsToolsManagerKeysGroupLabel trusted )" )" "$( AgentsToolsManagerKeysField "$( [ -f "$listFileOf" ] && printf 'the authorized keys of this account, %s, hold no public key' "$listFileOf" || printf 'no authorized keys file stands at %s' "$listFileOf" )" )"
		fi
		return 0
	;;

	## One key by its name: its row, the line as one pastes it, and for the key for git the
	## repositories the rig keeps a list of. Its form is the help entry's.
	--manager-keys-read)
		local readOp="$1" readKey readLabel readGroup readFor readFile readFound="" readHost readProject readUrl keysLine keysType keysText
		shift
		if [ $# -ne 1 ] ; then
			echo "⛔ ERROR: $MDSC_CMD $readOp: syntax is $readOp <key>, got $# argument(s) -- nothing is shown" >&2
			set +e ; return 1
		fi
		case "$1" in ''|*[!abcdefghijklmnopqrstuvwxyz0123456789-]*)
			echo "⛔ ERROR: $MDSC_CMD $readOp: syntax is $readOp <key>, and the word given is no name of a key -- nothing is shown" >&2
			set +e ; return 1
		;; esac
		case "$1" in
			trusted-[0123456789]*)
				readFile="$( AgentsToolsManagerKeysTrusted | LC_ALL=C awk -F'|' -v want="${1#trusted-}" '$1 == want { print ; exit }' )"
				if [ -z "$readFile" ] ; then
					echo "⛔ ERROR: $MDSC_CMD $readOp: no key is named '$1' -- nothing is shown. The keys are those ${readOp%-read}-list prints" >&2
					set +e ; return 1
				fi
				IFS='|' read -r readKey readLabel readGroup readFor <<< "$readFile"
				AgentsToolsManagerKeysTrustedRow "$readKey" "$readLabel" "$readGroup" "$readFor"
				printf 'paste\t%s\n' "$readLabel $readGroup${readFor:+ $readFor}"
				return 0
			;;
		esac
		while IFS='|' read -r readKey readLabel readGroup readFor readFile readHost ; do
			[ "$readKey" = "$1" ] || continue
			readFound="yes"
			break
		done <<< "$( AgentsToolsManagerKeysDeclared )"
		if [ -z "$readFound" ] ; then
			echo "⛔ ERROR: $MDSC_CMD $readOp: no key is named '$1' -- nothing is shown. The keys are those ${readOp%-read}-list prints" >&2
			set +e ; return 1
		fi
		AgentsToolsManagerKeysRow "$readKey" "$readLabel" "$readGroup" "$readFor" "$readFile"
		AgentsToolsManagerKeysPublic "$readFile" || return 0
		## The line as one pastes it, its blanks kept: for git the public key line as its file
		## has it; for those who connect the line of a known hosts file, the name of this host
		## ahead of the type and the key, as mdci-public-keys prints it.
		printf 'paste\t%s\n' "$( AgentsToolsManagerKeysPaste "$readGroup" )"
		## Where the key for git is to be listed: the repositories the rig declares, which it
		## keeps for that command, a project and an address a line. None is asked anything.
		if [ "$readKey" = "deploy" ] && [ -r "$( AgentsToolsManagerKeysHome )/.mdci-source-repos.txt" ] ; then
			while IFS=$'\t' read -r readProject readUrl ; do
				[ -n "$readUrl" ] || continue
				case "$readUrl" in *://*:*@*) continue ;; esac
				printf 'register\t%s\t%s\n' "$( AgentsToolsManagerKeysField "$readProject" )" "$( AgentsToolsManagerKeysField "$readUrl" )"
			done < "$( AgentsToolsManagerKeysHome )/.mdci-source-repos.txt"
		fi
		return 0
	;;

	## A key made where there is none: the private file and its public file, nothing else touched. Refused where either file is already
	## there: a key that stands is replaced with --manager-keys-regenerate. One row `generated`: the key, its private file, its type, its
	## fingerprint.
	--manager-keys-generate)
		local generateOp="$1" keysPrivate keysPublic keysGroup
		[ $# -eq 2 ] || { echo "⛔ ERROR: $MDSC_CMD $generateOp: syntax is $generateOp <key>, got $(( $# - 1 )) argument(s) -- nothing was done" >&2 ; set +e ; return 1 ; }
		AgentsToolsManagerKeysMine "$generateOp" "$2" || { set +e ; return 1 ; }
		if [ -e "$keysPrivate" ] || [ -L "$keysPrivate" ] || [ -e "$keysPublic" ] || [ -L "$keysPublic" ] ; then
			echo "⛔ ERROR: $MDSC_CMD $generateOp: a file of the key '$2' is there already, and this makes a key only where there is none -- nothing was done. --manager-keys-regenerate replaces one" >&2
			set +e ; return 1
		fi
		AgentsToolsManagerKeysMake "$generateOp" "$keysPrivate" || { set +e ; return 1 ; }
		AgentsToolsManagerKeysDone generated "$2" "$keysPrivate"
		return 0
	;;

	## A key that stands is replaced by a new one, in the same files: the old pair stays whole until the new one is made, and is then
	## gone; whoever trusts the old public key trusts nothing of the new. Refused where the key has no private file or is no plain file.
	## One row `regenerated`, as `generated` has it.
	--manager-keys-regenerate)
		local regenerateOp="$1" keysPrivate keysPublic keysGroup
		[ $# -eq 2 ] || { echo "⛔ ERROR: $MDSC_CMD $regenerateOp: syntax is $regenerateOp <key>, got $(( $# - 1 )) argument(s) -- nothing was done" >&2 ; set +e ; return 1 ; }
		AgentsToolsManagerKeysMine "$regenerateOp" "$2" || { set +e ; return 1 ; }
		if [ -L "$keysPrivate" ] || [ ! -f "$keysPrivate" ] ; then
			echo "⛔ ERROR: $MDSC_CMD $regenerateOp: the key '$2' has no private file of its own to replace, a plain file -- nothing was done. --manager-keys-generate makes one" >&2
			set +e ; return 1
		fi
		AgentsToolsManagerKeysMake "$regenerateOp" "$keysPrivate" || { set +e ; return 1 ; }
		AgentsToolsManagerKeysDone regenerated "$2" "$keysPrivate"
		return 0
	;;

	## A key removed: its private file and its public file. Refused where there is no file of it. One row `deleted`.
	--manager-keys-delete)
		local deleteOp="$1" keysPrivate keysPublic keysGroup
		[ $# -eq 2 ] || { echo "⛔ ERROR: $MDSC_CMD $deleteOp: syntax is $deleteOp <key>, got $(( $# - 1 )) argument(s) -- nothing was done" >&2 ; set +e ; return 1 ; }
		AgentsToolsManagerKeysMine "$deleteOp" "$2" || { set +e ; return 1 ; }
		if [ ! -e "$keysPrivate" ] && [ ! -e "$keysPublic" ] ; then
			echo "⛔ ERROR: $MDSC_CMD $deleteOp: the key '$2' has no file to remove -- nothing was done" >&2
			set +e ; return 1
		fi
		rm -f -- "$keysPrivate" "$keysPublic" || { echo "⛔ ERROR: $MDSC_CMD $deleteOp: the files of '$2' could not be removed" >&2 ; set +e ; return 1 ; }
		if [ -e "$keysPrivate" ] || [ -e "$keysPublic" ] ; then
			echo "⛔ ERROR: $MDSC_CMD $deleteOp: a file of '$2' is still there after the removal" >&2
			set +e ; return 1
		fi
		AgentsToolsManagerKeysDone deleted "$2" "$keysPrivate"
		return 0
	;;

	## A public key line put into the account's own authorized keys: whoever holds its private key may then log in
	## here as the account. The line is read whole from the standard input, one line, a key type, then the key, then
	## anything; it is appended with a line end of its own. Refused where the input is not one such line, the key is
	## trusted already, or the file cannot be written. One row `added`.
	--manager-keys-trust-add)
		local addOp="$1" keysLine keysType keysText keysComment addFile addDir addCount addFinger addN addType addText addComment addFound="" addNew=""
		shift
		[ $# -eq 0 ] || { echo "⛔ ERROR: $MDSC_CMD $addOp: syntax is $addOp, the public key line on the standard input, got $# argument(s) -- nothing was added" >&2 ; set +e ; return 1 ; }
		if ! AgentsToolsManagerKeysTrustedLine ; then
			echo "⛔ ERROR: $MDSC_CMD $addOp: the standard input is not one public key line to trust, a key type, then the key, then anything -- nothing was added" >&2
			set +e ; return 1
		fi
		addFile="$( AgentsToolsManagerKeysTrustedFile )" ; addDir="${addFile%/*}"
		[ -f "$addFile" ] || addNew="yes"
		if [ ! -d "$addDir" ] ; then { mkdir -p "$addDir" && chmod 700 "$addDir" ; } || { echo "⛔ ERROR: $MDSC_CMD $addOp: the folder of the authorized keys could not be made -- nothing was added" >&2 ; set +e ; return 1 ; } ; fi
		if [ -f "$addFile" ] ; then
			[ -w "$addFile" ] || { echo "⛔ ERROR: $MDSC_CMD $addOp: the authorized keys file cannot be written: $addFile -- nothing was added" >&2 ; set +e ; return 1 ; }
			while IFS='|' read -r addN addType addText addComment ; do
				[ "$addType" != "$keysType" ] || [ "$addText" != "$keysText" ] || addFound="yes"
			done <<< "$( AgentsToolsManagerKeysTrusted 2> /dev/null )"
			[ -z "$addFound" ] || { echo "⛔ ERROR: $MDSC_CMD $addOp: that key is trusted already -- nothing was added" >&2 ; set +e ; return 1 ; }
			## the line goes on a line of its own: where the file does not end in a line end, one is put first
			[ -z "$( tail -c 1 "$addFile" 2> /dev/null )" ] || printf '\n' >> "$addFile" || { echo "⛔ ERROR: $MDSC_CMD $addOp: the authorized keys file could not be written: $addFile -- nothing was added" >&2 ; set +e ; return 1 ; }
		fi
		printf '%s\n' "$keysLine" >> "$addFile" || { echo "⛔ ERROR: $MDSC_CMD $addOp: the authorized keys file could not be written: $addFile -- nothing was added" >&2 ; set +e ; return 1 ; }
		## the account's own authorized keys, made with mode 600 where it was not there
		[ -z "$addNew" ] || chmod 600 "$addFile" 2> /dev/null
		addCount="$( AgentsToolsManagerKeysTrusted | LC_ALL=C grep -c . )"
		addFinger="$( AgentsToolsManagerKeysTrustedFinger "$keysType" "$keysText" )"
		AgentsToolsManagerKeysTrustedDone added "$addCount" "$addFile" "$keysType" "$addFinger"
		return 0
	;;

	## A trusted key removed: the one line that holds it is taken out of the account's authorized keys, and every
	## other line, options, comments and blanks, stays as it stands. It is named `trusted-<n>`, as --manager-keys-list
	## prints it, n counting from 1. Refused where the file is not there, holds no such key, or cannot be written.
	## One row `deleted`.
	--manager-keys-trust-delete)
		local deleteOp="$1" deleteKey="${2:-}" deleteN="" deleteFile deleteMode deleteTmp deleteFound="" deleteType deleteText deleteComment deleteFinger delN delType delText delComment
		shift
		[ $# -eq 1 ] || { echo "⛔ ERROR: $MDSC_CMD $deleteOp: syntax is $deleteOp <trusted-<n>>, got $# argument(s) -- nothing was done" >&2 ; set +e ; return 1 ; }
		case "$deleteKey" in
			trusted-[0123456789]*) deleteN="${deleteKey#trusted-}" ;;
			*) echo "⛔ ERROR: $MDSC_CMD $deleteOp: the word given is no trusted key, which --manager-keys-list names trusted-<n> -- nothing was done" >&2 ; set +e ; return 1 ;;
		esac
		case "$deleteN" in 0*|'') echo "⛔ ERROR: $MDSC_CMD $deleteOp: the word given is no trusted key, which --manager-keys-list names trusted-<n>, n counting from 1 -- nothing was done" >&2 ; set +e ; return 1 ;; esac
		deleteFile="$( AgentsToolsManagerKeysTrustedFile )"
		[ -f "$deleteFile" ] && [ -r "$deleteFile" ] || { echo "⛔ ERROR: $MDSC_CMD $deleteOp: no authorized keys file stands at $deleteFile -- nothing was done" >&2 ; set +e ; return 1 ; }
		while IFS='|' read -r delN deleteType deleteText deleteComment ; do
			[ "$delN" = "$deleteN" ] || continue
			deleteFound="yes" ; break
		done <<< "$( AgentsToolsManagerKeysTrusted )"
		[ -n "$deleteFound" ] || { echo "⛔ ERROR: $MDSC_CMD $deleteOp: the file holds no trusted key $deleteKey -- nothing was done" >&2 ; set +e ; return 1 ; }
		[ -w "$deleteFile" ] || { echo "⛔ ERROR: $MDSC_CMD $deleteOp: the authorized keys file cannot be written: $deleteFile -- nothing was done" >&2 ; set +e ; return 1 ; }
		deleteFinger="$( AgentsToolsManagerKeysTrustedFinger "$deleteType" "$deleteText" )"
		deleteMode="$( AgentsToolsManagerKeysMode "$deleteFile" )"
		deleteTmp="$( mktemp "$deleteFile.delete.XXXXXX" 2> /dev/null )" || { echo "⛔ ERROR: $MDSC_CMD $deleteOp: a file for the new authorized keys could not be made beside it -- nothing was changed" >&2 ; set +e ; return 1 ; }
		if ! LC_ALL=C awk -v n="$deleteN" '
			/^[ \t]*(#|$)/ { print ; next }
			{
				for ( at = 1 ; at < NF ; at++ ) { if ( $at ~ /^(ssh-|ecdsa-|sk-)/ ) { break } }
				if ( at < NF && $at ~ /^(ssh-|ecdsa-|sk-)/ && $(at + 1) ~ /^[A-Za-z0-9+\/=]+$/ ) {
					total++
					if ( total == n ) { next }
				}
				print
			}' "$deleteFile" > "$deleteTmp" ; then
			rm -f -- "$deleteTmp"
			echo "⛔ ERROR: $MDSC_CMD $deleteOp: the authorized keys could not be read -- nothing was changed" >&2
			set +e ; return 1
		fi
		[ -n "$deleteMode" ] && chmod "$deleteMode" "$deleteTmp" 2> /dev/null
		if ! mv -f -- "$deleteTmp" "$deleteFile" ; then
			rm -f -- "$deleteTmp"
			echo "⛔ ERROR: $MDSC_CMD $deleteOp: the new authorized keys could not be put in place -- nothing was changed" >&2
			set +e ; return 1
		fi
		AgentsToolsManagerKeysTrustedDone deleted "$deleteN" "$deleteFile" "$deleteType" "$deleteFinger"
		return 0
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
