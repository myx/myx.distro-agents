#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.MemberContact.include -- the contact-digest stub of DistroAgentsContacts.fn.sh. Sourced from the tool
## file's arm. Not standalone: relies on being dot-sourced for $1/$@/$MDSC_CMD.
##

case "$1" in

	## The contact-digest primitive. The acting member is the origin of the correspondence unless the caller names
	## another one, the member whose correspondence produced the digest, before the verdict word. Open to any member, and
	## sent under the sender's own credentials: a spawned session names only itself.
	--send-contact-digest)
		shift
		local digestMember="$1"
		shift || true
		local digestOrigin="$digestMember"
		if [ -z "$digestMember" ] ; then
			echo "⛔ ERROR: $MDSC_CMD --send-contact-digest: syntax is <team-member> [<origin team-member>] (--resolved|--needs-ruling) <text...>" >&2
			set +e ; return 1
		fi
		case "${1:-}" in
			--resolved|--needs-ruling) ;;
			'')
				echo "⛔ ERROR: $MDSC_CMD --send-contact-digest: syntax is <team-member> [<origin team-member>] (--resolved|--needs-ruling) <text...>" >&2
				set +e ; return 1
			;;
			*)
				digestOrigin="$1"
				shift || true
			;;
		esac
		AgentsToolsActingMemberCheck "$digestMember" send-contact-digest || { set +e ; return 1 ; }
		DistroAgentsTools --intern-op-contact-digest-send "$digestMember" "$digestOrigin" "$@" \
			--context --send-contact-digest
		return $?
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
