#!/usr/bin/env bash

##
## AgentsTools.InternOpAgentSpawnProxy.include -- internal spawn-proxy
## primitive for agent/routine wrappers. No --help entry.
##
## Syntax:
##   DistroAgentsTools.fn.sh --intern-op-agent-spawn-proxy <agent-or-meta-name>
##     [--from-file <path>]
##     [--from-board <board-item-name> [--board-state <state>]...]
##     [--from-vault <vault-item-name>]
##     [--from-audit <audit-item-name>]
##     [--wait]
##
## Body source is exactly one of: stdin (default), --from-file, --from-board,
## --from-vault, --from-audit.
##
## No more private package-storage receipt triplet -- unconditionally, same
## "document IS the tracking, always" principle as
## AgentsTools.InternOpItem.include. Two tracking variants instead:
##   1. --from-board/--from-vault/--from-audit: already names a tracking
##      document. Nothing new written -- reports TRACKING_ITEM=<name>.
##   2. stdin/--from-file: ad-hoc. A `dispatch-*` board-item is created in
##      board-running up front (magic-team.armed.md's dispatch-* type),
##      carrying the verbatim prompt as its "## Brief". On completion, same
##      item, same-state update (--from-state: running), `status:` header
##      dispatch-started -> dispatch-succeeded/-failed, `resolved-at`
##      stamped, real "## Result" section appended -- mirrors
##      board/running/dispatch-20260806T0000Z-skillset-storage-path-sweep.md's
##      own narrative-section shape. Async spawns close this from their own
##      background subshell once the child exits -- fire-and-forget for the
##      caller, not for the tracking document.
##
## Raw stdout/stderr of the spawned process is process mechanics, not board
## state: lands under $MDAT_DATA_ROOT/audit/<YYYY-MM>/, same dated-folder
## convention as --member-append-session-transcript. The prompt-content
## scratch file is an ordinary scratch file, never persisted.
##

## Closes one ad-hoc dispatch-* item once its spawned process has exited.
## Called from --wait (sync) and from async's own background subshell.
## Same-state update (--from-state: == running), appends "## Result", never
## fails the caller -- a closure failure only warns.
AgentsToolsSpawnProxyCloseDispatch(){
	local itemName="$1" briefBody="$2" childExit="$3" childOutputFile="$4"
	local outcome currentBody resultBody
	outcome="$( [ "$childExit" -eq 0 ] && echo succeeded || echo failed )"
	## --upsert-from-stdin below takes stdin verbatim as the WHOLE file, so
	## whatever is composed here has to be a complete board document,
	## frontmatter included -- exactly the same requirement the create side
	## has. Reading the item's current on-disk content is what makes that
	## true here: rebuilding from the in-memory $briefBody captured before
	## the spawn would write back a document whose frontmatter is only the
	## empty skeleton plus the two headers upserted right here, silently
	## dropping `owner` and `session-id` (and anything the spawned session
	## itself recorded meanwhile). `session-id` in particular IS the receipt
	## evidence -- a closed item that lost it no longer says which spawn
	## produced it.
	##
	## The $briefBody fallback below is unreachable by construction as this
	## stands: the read looks in board/running and the upsert that follows
	## uses --from-state:running, the same folder, so a failed read implies a
	## failed upsert and the fallback changes no outcome. It is kept only as
	## a guard, and named here because it is the one remaining path that
	## would write a DEGRADED body -- frontmatter reduced to the empty
	## skeleton plus the two headers upserted right here. It carries that
	## skeleton, so the header ops do still land on it. If either lookup is
	## ever changed independently of the other, this path comes alive and
	## silently reintroduces the frontmatter loss; change them together.
	currentBody="$( DistroAgentsTools --intern-op-data-read "$itemName" \
		--lookup-folder "$MDAT_DATA_ROOT/board/running" \
		--context --intern-op-agent-spawn-proxy )" || currentBody="$briefBody"
	resultBody="$( printf '%s\n' \
		"$currentBody" \
		"" \
		"## Result" \
		"" \
		"status: $outcome" \
		"exit-code: $childExit" \
		"output-file: $childOutputFile" \
		"completed-at: $( date -u +%Y-%m-%dT%H:%M:%SZ )" )"
	printf '%s\n' "$resultBody" | DistroAgentsTools --intern-op-board-upsert-move-edit running "$itemName" \
		--from-state:running \
		--header:upsert:status:dispatch-"$outcome" \
		--header:upsert:resolved-at:"$( date +"%Y-%m-%d %H:%M %z" )" \
		--upsert-from-stdin \
		--context --intern-op-agent-spawn-proxy \
		|| echo "⚠️ WARNING: --intern-op-agent-spawn-proxy: could not close dispatch item $itemName" >&2
	return 0
}

case "$1" in

	--intern-op-agent-spawn-proxy)
		shift
		## --context <caller-op>: see AgentsTools.InternOpBoardUpsertMoveEdit.include's
		## own copy of this block for the full reasoning. Pre-scanned before any
		## validation so every message here can name the invoking operation;
		## the option loop below consumes it again as an ordinary option.
		local opContext="<no --context given>"
		local ctxWanted="" ctxArg
		for ctxArg in "$@" ; do
			if [ -n "$ctxWanted" ] ; then
				opContext="$ctxArg" ; ctxWanted="" ; continue
			fi
			if [ "$ctxArg" = "--context" ] ; then ctxWanted="1" ; fi
		done
		local callerName="$1"
		shift || true
		local contextFromFile="false" waitMode="false" spawnContext=""
		local fromBoardName="" fromVaultName="" fromAuditName="" fromFilePath=""
		local sourceMode="stdin"
		local boardStates=()
		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-file)
					if [ -z "$2" ] || [ ! -f "$2" ] ; then
						echo "$MDSC_CMD: agent-spawn-proxy: ⛔ ERROR: --from-file: file not found: $2" >&2
						set +e ; return 1
					fi
					fromFilePath="$2"
					contextFromFile="true"
					sourceMode="file"
					shift 2
				;;
				--from-stdin)
					contextFromFile="true"
					sourceMode="stdin"
					shift 1
				;;
				--from-board)
					if [ -z "$2" ] ; then
						echo "$MDSC_CMD: agent-spawn-proxy: ⛔ ERROR: --from-board requires <board-item-name>" >&2
						set +e ; return 1
					fi
					fromBoardName="$2"
					sourceMode="board"
					shift 2
				;;
				--board-state)
					case "$2" in
						backlog|pending|running|blocked|parked|processed|archived|retained)
							boardStates+=( "$2" )
						;;
						*)
							echo "$MDSC_CMD: agent-spawn-proxy: ⛔ ERROR: invalid --board-state: $2" >&2
							set +e ; return 1
						;;
					esac
					shift 2
				;;
				--from-vault)
					if [ -z "$2" ] ; then
						echo "$MDSC_CMD: agent-spawn-proxy: ⛔ ERROR: --from-vault requires <vault-item-name>" >&2
						set +e ; return 1
					fi
					fromVaultName="$2"
					sourceMode="vault"
					shift 2
				;;
				--from-audit)
					if [ -z "$2" ] ; then
						echo "$MDSC_CMD: agent-spawn-proxy: ⛔ ERROR: --from-audit requires <audit-item-name>" >&2
						set +e ; return 1
					fi
					fromAuditName="$2"
					sourceMode="audit"
					shift 2
				;;
				--wait)
					waitMode="true"
					shift
				;;
				--context)
					if [ -z "${2:-}" ] ; then
						echo "$MDSC_CMD: agent-spawn-proxy: ⛔ ERROR: --context: value required" >&2
						set +e ; return 1
					fi
					shift 2
				;;
				*)
					echo "$MDSC_CMD: agent-spawn-proxy: ⛔ ERROR: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$callerName" ] ; then
			echo "$MDSC_CMD: agent-spawn-proxy: ⛔ ERROR: syntax is <agent-or-meta-name> [--from-board <board-item-name> [--board-state <state>]...] [--from-vault <vault-item-name>] [--from-audit <audit-item-name>] [--wait]" >&2
			set +e ; return 1
		fi
		local sourceCount=0
		[ "$contextFromFile" = "true" ] && sourceCount=$(( sourceCount + 1 ))
		[ -n "$fromBoardName" ] && sourceCount=$(( sourceCount + 1 ))
		[ -n "$fromVaultName" ] && sourceCount=$(( sourceCount + 1 ))
		[ -n "$fromAuditName" ] && sourceCount=$(( sourceCount + 1 ))
		if [ "$sourceCount" -gt 1 ] ; then
			echo "$MDSC_CMD: agent-spawn-proxy: ⛔ ERROR: use only one source selector: --from-board | --from-vault | --from-audit (or stdin default)" >&2
			set +e ; return 1
		fi
		if [ ${#boardStates[@]} -gt 0 ] && [ -z "$fromBoardName" ] ; then
			echo "$MDSC_CMD: agent-spawn-proxy: ⛔ ERROR: --board-state is only valid with --from-board" >&2
			set +e ; return 1
		fi
		[ -n "${MDAT_DATA_ROOT:-}" ] || {
			echo "$MDSC_CMD: agent-spawn-proxy: ⛔ ERROR: MDAT_DATA_ROOT is not set" >&2
			set +e ; return 1
		}

		## trackedMode="true" for the three source selectors that already name
		## a real tracking document (board/vault/audit); "false" for stdin/
		## --from-file, the two ad-hoc sources with no document behind them
		## yet. See this file's own header comment for the two-variant design.
		local trackedMode="false" trackedItemName=""
		local auditReadYearMonth=""
		case "$sourceMode" in
			file)
				spawnContext="$( cat "$fromFilePath" )"
			;;
			stdin)
				spawnContext="$( cat )"
			;;
			board)
				trackedMode="true"
				trackedItemName="$fromBoardName"
				AgentsToolsAssertBareName "$fromBoardName" "<board-item-name>" agent-spawn-proxy || { set +e ; return 1 ; }
				if [ ${#boardStates[@]} -eq 0 ] ; then
					boardStates=( backlog pending running blocked parked processed archived retained )
				fi
				## Propagates this op's own $opContext rather than naming itself:
				## the point of --context is the operation the caller actually
				## invoked, and that survives the extra intern-op hop only if it
				## is passed along.
				local readArgs=( --intern-op-data-read "$fromBoardName" --context "$opContext" ) boardState
				for boardState in "${boardStates[@]}" ; do
					readArgs+=( --lookup-folder "$MDAT_DATA_ROOT/board/$boardState" )
				done
				spawnContext="$( DistroAgentsTools "${readArgs[@]}" )" || { set +e ; return 1 ; }
			;;
			vault)
				trackedMode="true"
				trackedItemName="$fromVaultName"
				AgentsToolsAssertBareName "$fromVaultName" "<vault-item-name>" agent-spawn-proxy || { set +e ; return 1 ; }
				spawnContext="$( DistroAgentsTools --intern-op-data-read "$fromVaultName" --lookup-folder "$MDAT_DATA_ROOT/vault" --context "$opContext" )" || { set +e ; return 1 ; }
			;;
			audit)
				trackedMode="true"
				trackedItemName="$fromAuditName"
				AgentsToolsAssertBareName "$fromAuditName" "<audit-item-name>" agent-spawn-proxy || { set +e ; return 1 ; }
				## Propagates $opContext for the same reason as the board branch above.
				local auditReadArgs=( --intern-op-data-read "$fromAuditName" --context "$opContext" )
				case "$fromAuditName" in
					transcript-[0-9][0-9][0-9][0-9]-[0-9][0-9]-*)
						auditReadYearMonth="$( printf '%s' "$fromAuditName" | sed -E 's/^transcript-([0-9]{4})-([0-9]{2})-.*/\1-\2/' )"
						auditReadArgs+=( --lookup-folder "$MDAT_DATA_ROOT/audit/$auditReadYearMonth" )
					;;
				esac
				auditReadArgs+=( --lookup-folder "$MDAT_DATA_ROOT/audit" )
				spawnContext="$( DistroAgentsTools "${auditReadArgs[@]}" )" || { set +e ; return 1 ; }
			;;
			*)
				echo "$MDSC_CMD: agent-spawn-proxy: ⛔ ERROR: internal source mode error: $sourceMode" >&2
				set +e ; return 1
			;;
		esac

		if [ -z "$spawnContext" ] ; then
			echo "$MDSC_CMD: agent-spawn-proxy: ⛔ ERROR: empty spawn context" >&2
			set +e ; return 1
		fi
		if [ ! -x "$MMDAPP/DistroAgentsConsole.sh" ] ; then
			echo "$MDSC_CMD: agent-spawn-proxy: ⛔ ERROR: DistroAgentsConsole.sh is not executable at $MMDAPP" >&2
			set +e ; return 1
		fi

		local timestamp receiptId
		timestamp="$( date +%Y%m%dT%H%M%S )"
		receiptId="spawn-proxy-$timestamp-$$"

		## Raw process stdout/stderr -- actual process mechanics, not board
		## state -- lands under audit/<YYYY-MM>/, the same dated-folder
		## convention --member-append-session-transcript already uses
		## (AgentsTools.Member.include). Current UTC year-month, the same
		## fallback that op uses when a target name carries no date of its
		## own.
		local auditDir outputFile
		auditDir="$MDAT_DATA_ROOT/audit/$( date -u +%Y-%m )"
		mkdir -p "$auditDir" || {
			echo "$MDSC_CMD: agent-spawn-proxy: ⛔ ERROR: can't create audit directory: $auditDir" >&2
			set +e ; return 1
		}
		outputFile="$auditDir/$receiptId.output.log"

		## Prompt-content scratch file: an ordinary scratch file, never
		## persisted -- it exists only long enough for the spawned process's
		## own stdin redirect to read it, and is removed once that process has
		## exited (both wait and async paths).
		local contextFile
		contextFile="$MMDAPP/.local/temp/mdat-spawn-proxy-prompt.$$"
		mkdir -p "$MMDAPP/.local/temp" && : > "$contextFile" || {
			echo "$MDSC_CMD: agent-spawn-proxy: ⛔ ERROR: can't create prompt scratch file" >&2
			set +e ; return 1
		}
		printf '%s\n' "$spawnContext" > "$contextFile"

		## Ad-hoc sources only: create the dispatch-* tracking document BEFORE
		## the spawn runs, so a crash mid-spawn still leaves a real record of
		## what was asked. Body is title + "## Brief" (the verbatim prompt) --
		## the dispatch-* content-shape magic-team.armed.md documents: "body
		## holds the dispatch brief ... plus an update log". The "## Result"
		## section is the update-log entry, appended at closure below.
		local dispatchItemName="" dispatchBriefBody=""
		if [ "$trackedMode" = "false" ] ; then
			dispatchItemName="dispatch-$timestamp-spawn-proxy-$$.md"
			## Opens with the empty `---`/`---` frontmatter skeleton on
			## purpose. --intern-op-board-upsert-move-edit synthesizes that
			## skeleton itself ONLY when no body-input mode is given; the call
			## below passes --upsert-from-stdin, which takes stdin verbatim as
			## the whole file. Without the skeleton the --header:upsert: ops
			## have nowhere to land, AgentsBoardItemHeaderOpsApply.awk hits its
			## END guard ("header operation(s) requested, but this body has no
			## complete `---` frontmatter block") and fails the create -- which
			## aborted every stdin/--from-file spawn before it spawned
			## anything, unconditionally and independently of $spawnContext's
			## own content. Composing the complete document here, frontmatter
			## included, keeps the create a single atomic write rather than a
			## create-then-patch pair that would reintroduce the same split.
			dispatchBriefBody="$( printf '%s\n' \
				"---" \
				"---" \
				"" \
				"# Spawn-proxy dispatch: $callerName" \
				"" \
				"## Brief" \
				"" \
				"$spawnContext" )"
			## Calls --intern-op-board-upsert-move-edit directly rather than
			## through the --magic-board-create-running wrapper
			## (AgentsTools.MagicBoard.include): that wrapper's own arg-parsing
			## loop has no --context case (every --magic-board-* op in that file
			## sets its own fixed --context literal internally instead of
			## accepting one from its caller), so passing this op's own
			## --context $opContext through it always failed with "invalid
			## option: --context" -- unconditionally, regardless of
			## $spawnContext's own content. Going straight to the shared
			## intern-op primitive (which --magic-board-create-running itself
			## also just wraps) avoids that mismatch instead of working around
			## it.
			printf '%s\n' "$dispatchBriefBody" | DistroAgentsTools --intern-op-board-upsert-move-edit running "$dispatchItemName" \
				--create \
				--context "$opContext" \
				--upsert-from-stdin \
				--header:upsert:owner:"$callerName" \
				--header:upsert:status:dispatch-started \
				--header:upsert:session-id:"$receiptId" || {
				rm -f "$contextFile"
				echo "$MDSC_CMD: agent-spawn-proxy: ⛔ ERROR: could not create dispatch tracking item $dispatchItemName" >&2
				set +e ; return 1
			}
		fi

		if [ "$waitMode" = "true" ] ; then
			local exitCode
			set +e
			env MMDAPP="$MMDAPP" "$MMDAPP/DistroAgentsConsole.sh" --cli-auto --non-interactive < "$contextFile" > "$outputFile" 2>&1
			exitCode=$?
			set -e
			rm -f "$contextFile"
			if [ "$trackedMode" = "false" ] ; then
				AgentsToolsSpawnProxyCloseDispatch "$dispatchItemName" "$dispatchBriefBody" "$exitCode" "$outputFile"
			fi
			echo "RECEIPT_ID=$receiptId"
			if [ "$trackedMode" = "true" ] ; then
				echo "TRACKING_ITEM=$trackedItemName"
			else
				echo "DISPATCH_ITEM=$dispatchItemName"
			fi
			echo "STATUS=$( [ "$exitCode" -eq 0 ] && echo succeeded || echo failed )"
			echo "EXIT_CODE=$exitCode"
			echo "OUTPUT_FILE=$outputFile"
			if [ "$exitCode" -ne 0 ] ; then
				set +e ; return 1
			fi
			return 0
		fi

		## Async: fire-and-forget for the CALLER only. The subshell closes the
		## dispatch tracking document itself once the child actually exits, so
		## "document is updated and unlocked on completion" holds on the
		## common (non---wait) path too, not only when a caller happens to
		## block for it.
		(
			set +e
			env MMDAPP="$MMDAPP" "$MMDAPP/DistroAgentsConsole.sh" --cli-auto --non-interactive < "$contextFile"
			bgExitCode=$?
			set -e
			rm -f "$contextFile"
			if [ "$trackedMode" = "false" ] ; then
				AgentsToolsSpawnProxyCloseDispatch "$dispatchItemName" "$dispatchBriefBody" "$bgExitCode" "$outputFile"
			fi
		) > "$outputFile" 2>&1 &
		local spawnPid=$!
		echo "RECEIPT_ID=$receiptId"
		if [ "$trackedMode" = "true" ] ; then
			echo "TRACKING_ITEM=$trackedItemName"
		else
			echo "DISPATCH_ITEM=$dispatchItemName"
		fi
		echo "STATUS=started"
		echo "PID=$spawnPid"
		echo "OUTPUT_FILE=$outputFile"
		return 0
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
