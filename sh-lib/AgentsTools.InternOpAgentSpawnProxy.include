#!/usr/bin/env bash

##
## AgentsTools.InternOpAgentSpawnProxy.include -- internal spawn-proxy
## primitive for agent/routine wrappers. No --help entry.
##

## Success proof: the launcher prints DISTRO_CONSOLE_EXEC= only on a real exec.
## Its absence in captured output = silent no-op (rc=0 included) = failure.
AgentsToolsSpawnProxySawSentinel(){
	[ -n "$1" ] && grep -q '^DISTRO_CONSOLE_EXEC=' "$1" 2>/dev/null
}

## The agent CLI this spawn actually ran on, read back out of the same
## DISTRO_CONSOLE_EXEC= sentinel the launcher prints immediately before it
## execs. Deliberately read from the child's own output rather than recomputed
## here: the console owns the --cli/SPAWN_CLI_SERVICE/auto-scan resolution, so
## anything computed on this side could disagree with what actually ran, and an
## announcement that can disagree with the run is worse than none. Empty when
## no exec happened, which is the same condition SawSentinel calls a failure.
AgentsToolsSpawnProxyExecutedCli(){
	[ -n "$1" ] || return 0
	LC_ALL=C sed -n 's/^DISTRO_CONSOLE_EXEC=//p' "$1" 2>/dev/null | head -n 1
}

## One line, on stderr, naming the AI service this spawn actually used -- so a
## watcher of a --wait spawn (the main loop's own case) can see which service
## the iteration ran on. Prefix shape matches --intern-main-loop's own
## per-iteration lines: "# <command> <operation>: <message>".
AgentsToolsSpawnProxyAnnounceCli(){
	local announceOutputFile="$1" announceCli
	announceCli="$( AgentsToolsSpawnProxyExecutedCli "$announceOutputFile" )"
	echo "# $MDSC_CMD --intern-op-agent-spawn-proxy: 🤖 AI service used: ${announceCli:-none -- no agent CLI was launched}" >&2
}

AgentsToolsSpawnProxyCloseDispatch(){
	local itemName="$1" briefBody="$2" childExit="$3" childOutputFile="$4"
	local outcome currentBody resultBody
	outcome="$( AgentsToolsSpawnProxySawSentinel "$childOutputFile" && echo succeeded || echo failed )"
	currentBody="$( DistroAgentsTools --intern-op-data-read "$itemName" \
		--lookup-folder "$MDAT_DATA_ROOT/board/running" \
		--context --intern-op-agent-spawn-proxy )" || currentBody="$briefBody"
	resultBody="$( printf '%s\n' \
		"$currentBody" \
		"" \
		"## Result" \
		"" \
		"status: $outcome" \
		"exit-code: $childExit" \
		"output-file: $childOutputFile" \
		"completed-at: $( date -u +%Y-%m-%dT%H:%M:%SZ )" )"
	printf '%s\n' "$resultBody" | DistroAgentsTools --intern-op-board-upsert-move-edit running "$itemName" \
		--from-state:running \
		--header:upsert:status:dispatch-"$outcome" \
		--header:upsert:resolved-at:"$( date +"%Y-%m-%d %H:%M %z" )" \
		--upsert-from-stdin \
		--context --intern-op-agent-spawn-proxy \
		--log-verb:updated \
		|| echo "⚠️ WARNING: --intern-op-agent-spawn-proxy: could not close dispatch item $itemName" >&2
	return 0
}

case "$1" in

	--intern-op-agent-spawn-proxy)
		shift
		local opContext="<no --context given>"
		local ctxWanted="" ctxArg
		for ctxArg in "$@" ; do
			if [ -n "$ctxWanted" ] ; then
				opContext="$ctxArg" ; ctxWanted="" ; continue
			fi
			if [ "$ctxArg" = "--context" ] ; then ctxWanted="1" ; fi
		done
		local callerName="$1"
		shift || true
		local contextFromFile="false" waitMode="false" spawnContext=""
		local fromBoardName="" fromVaultName="" fromAuditName="" fromFilePath=""
		local sourceMode="stdin"
		local boardStates=()
		## Dispatch/tracking-document mode -- explicit, decoupled from the input
		## source (stdin vs --from-board no longer determines it). Each stub passes
		## exactly what its call needs; no default -- required below.
		local dispatchDocMode=""
		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-file)
					if [ -z "$2" ] || [ ! -f "$2" ] ; then
						echo "$MDSC_CMD: agent-spawn-proxy: ⛔ ERROR: --from-file: file not found: $2" >&2
						set +e ; return 1
					fi
					fromFilePath="$2"
					contextFromFile="true"
					sourceMode="file"
					shift 2
				;;
				--from-stdin)
					contextFromFile="true"
					sourceMode="stdin"
					shift 1
				;;
				--from-board)
					if [ -z "$2" ] ; then
						echo "$MDSC_CMD: agent-spawn-proxy: ⛔ ERROR: --from-board requires <board-item-name>" >&2
						set +e ; return 1
					fi
					fromBoardName="$2"
					sourceMode="board"
					shift 2
				;;
				--board-state)
					case "$2" in
						backlog|pending|running|blocked|parked|processed|archived|retained)
							boardStates+=( "$2" )
						;;
						*)
							echo "$MDSC_CMD: agent-spawn-proxy: ⛔ ERROR: invalid --board-state: $2" >&2
							set +e ; return 1
						;;
					esac
					shift 2
				;;
				--from-vault)
					if [ -z "$2" ] ; then
						echo "$MDSC_CMD: agent-spawn-proxy: ⛔ ERROR: --from-vault requires <vault-item-name>" >&2
						set +e ; return 1
					fi
					fromVaultName="$2"
					sourceMode="vault"
					shift 2
				;;
				--from-audit)
					if [ -z "$2" ] ; then
						echo "$MDSC_CMD: agent-spawn-proxy: ⛔ ERROR: --from-audit requires <audit-item-name>" >&2
						set +e ; return 1
					fi
					fromAuditName="$2"
					sourceMode="audit"
					shift 2
				;;
				--dispatch-doc:*)
					dispatchDocMode="${1#--dispatch-doc:}"
					case "$dispatchDocMode" in
						create|reuse|none) ;;
						*)
							echo "$MDSC_CMD: agent-spawn-proxy: ⛔ ERROR: --dispatch-doc: must be create|reuse|none: $dispatchDocMode" >&2
							set +e ; return 1
						;;
					esac
					shift
				;;
				--wait)
					waitMode="true"
					shift
				;;
				--context)
					if [ -z "${2:-}" ] ; then
						echo "$MDSC_CMD: agent-spawn-proxy: ⛔ ERROR: --context: value required" >&2
						set +e ; return 1
					fi
					shift 2
				;;
				*)
					echo "$MDSC_CMD: agent-spawn-proxy: ⛔ ERROR: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$callerName" ] ; then
			echo "$MDSC_CMD: agent-spawn-proxy: ⛔ ERROR: syntax is <agent-or-meta-name> [--from-board <board-item-name> [--board-state <state>]...] [--from-vault <vault-item-name>] [--from-audit <audit-item-name>] [--wait]" >&2
			set +e ; return 1
		fi
		local sourceCount=0
		[ "$contextFromFile" = "true" ] && sourceCount=$(( sourceCount + 1 ))
		[ -n "$fromBoardName" ] && sourceCount=$(( sourceCount + 1 ))
		[ -n "$fromVaultName" ] && sourceCount=$(( sourceCount + 1 ))
		[ -n "$fromAuditName" ] && sourceCount=$(( sourceCount + 1 ))
		if [ "$sourceCount" -gt 1 ] ; then
			echo "$MDSC_CMD: agent-spawn-proxy: ⛔ ERROR: use only one source selector: --from-board | --from-vault | --from-audit (or stdin default)" >&2
			set +e ; return 1
		fi
		if [ ${#boardStates[@]} -gt 0 ] && [ -z "$fromBoardName" ] ; then
			echo "$MDSC_CMD: agent-spawn-proxy: ⛔ ERROR: --board-state is only valid with --from-board" >&2
			set +e ; return 1
		fi
		[ -n "${MDAT_DATA_ROOT:-}" ] || {
			echo "$MDSC_CMD: agent-spawn-proxy: ⛔ ERROR: MDAT_DATA_ROOT is not set" >&2
			set +e ; return 1
		}

		local trackedMode="false" trackedItemName=""
		local auditReadYearMonth=""
		case "$sourceMode" in
			file)
				spawnContext="$( cat "$fromFilePath" )"
			;;
			stdin)
				spawnContext="$( cat )"
			;;
			board)
				trackedMode="true"
				trackedItemName="$fromBoardName"
				AgentsToolsAssertBareName "$fromBoardName" "<board-item-name>" agent-spawn-proxy || { set +e ; return 1 ; }
				if [ ${#boardStates[@]} -eq 0 ] ; then
					boardStates=( backlog pending running blocked parked processed archived retained )
				fi
				local readArgs=( --intern-op-data-read "$fromBoardName" --context "$opContext" ) boardState
				for boardState in "${boardStates[@]}" ; do
					readArgs+=( --lookup-folder "$MDAT_DATA_ROOT/board/$boardState" )
				done
				spawnContext="$( DistroAgentsTools "${readArgs[@]}" )" || { set +e ; return 1 ; }
			;;
			vault)
				trackedMode="true"
				trackedItemName="$fromVaultName"
				AgentsToolsAssertBareName "$fromVaultName" "<vault-item-name>" agent-spawn-proxy || { set +e ; return 1 ; }
				spawnContext="$( DistroAgentsTools --intern-op-data-read "$fromVaultName" --lookup-folder "$MDAT_DATA_ROOT/vault" --context "$opContext" )" || { set +e ; return 1 ; }
			;;
			audit)
				trackedMode="true"
				trackedItemName="$fromAuditName"
				AgentsToolsAssertBareName "$fromAuditName" "<audit-item-name>" agent-spawn-proxy || { set +e ; return 1 ; }
				## Propagates $opContext for the same reason as the board branch above.
				local auditReadArgs=( --intern-op-data-read "$fromAuditName" --context "$opContext" )
				case "$fromAuditName" in
					transcript-[0-9][0-9][0-9][0-9]-[0-9][0-9]-*)
						auditReadYearMonth="$( printf '%s' "$fromAuditName" | sed -E 's/^transcript-([0-9]{4})-([0-9]{2})-.*/\1-\2/' )"
						auditReadArgs+=( --lookup-folder "$MDAT_DATA_ROOT/audit/$auditReadYearMonth" )
					;;
				esac
				auditReadArgs+=( --lookup-folder "$MDAT_DATA_ROOT/audit" )
				spawnContext="$( DistroAgentsTools "${auditReadArgs[@]}" )" || { set +e ; return 1 ; }
			;;
			*)
				echo "$MDSC_CMD: agent-spawn-proxy: ⛔ ERROR: internal source mode error: $sourceMode" >&2
				set +e ; return 1
			;;
		esac

		if [ -z "$dispatchDocMode" ] ; then
			echo "$MDSC_CMD: agent-spawn-proxy: ⛔ ERROR: --dispatch-doc:create|reuse|none is required (each stub passes its own; no default)" >&2
			set +e ; return 1
		fi
		if [ "$dispatchDocMode" = "reuse" ] && [ "$trackedMode" != "true" ] ; then
			echo "$MDSC_CMD: agent-spawn-proxy: ⛔ ERROR: --dispatch-doc:reuse requires a --from-board/--from-vault/--from-audit source naming an existing tracking item" >&2
			set +e ; return 1
		fi

		if [ -z "$spawnContext" ] ; then
			echo "$MDSC_CMD: agent-spawn-proxy: ⛔ ERROR: empty spawn context" >&2
			set +e ; return 1
		fi
		if [ ! -x "$MMDAPP/DistroAgentsConsole.sh" ] ; then
			echo "$MDSC_CMD: agent-spawn-proxy: ⛔ ERROR: DistroAgentsConsole.sh is not executable at $MMDAPP" >&2
			set +e ; return 1
		fi

		## Configured-only: an agent-initiated spawn starts the CLI named by
		## SPAWN_CLI_SERVICE or it starts none. A console without the --cli-configured
		## arm cannot answer that -- it breaks out of its own option loop, runs its
		## hardcoded default interactively and still prints the success sentinel -- so
		## it is refused here rather than invoked.
		if ! grep -q 'cli-configured' "$MMDAPP/DistroAgentsConsole.sh" 2>/dev/null ; then
			echo "SETUP_STATUS=console-stale"
			echo "$MDSC_CMD: agent-spawn-proxy: ⛔ ERROR: $MMDAPP/DistroAgentsConsole.sh predates --cli-configured, so a configured spawn cannot be started here. Spawn an internal agent instead, or regenerate it with: $MMDAPP/.local/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh --make-workspace-integrations" >&2
			set +e ; return 1
		fi

		local timestamp receiptId
		timestamp="$( date +%Y%m%dT%H%M%S )"
		receiptId="spawn-proxy-$timestamp-$$"

		local auditDir outputFile
		auditDir="$MDAT_DATA_ROOT/audit/$( date -u +%Y-%m )"
		mkdir -p "$auditDir" || {
			echo "$MDSC_CMD: agent-spawn-proxy: ⛔ ERROR: can't create audit directory: $auditDir" >&2
			set +e ; return 1
		}
		outputFile="$auditDir/$receiptId.output.log"

		local dispatchItemName="" dispatchBriefBody=""
		if [ "$dispatchDocMode" = "create" ] ; then
			dispatchItemName="dispatch-$timestamp-spawn-proxy-$$.md"
			dispatchBriefBody="$( printf '%s\n' \
				"---" \
				"---" \
				"" \
				"# Spawn-proxy dispatch: $callerName" \
				"" \
				"## Brief" \
				"" \
				"$spawnContext" )"
			printf '%s\n' "$dispatchBriefBody" | DistroAgentsTools --intern-op-board-upsert-move-edit running "$dispatchItemName" \
				--create \
				--context "$opContext" \
				--upsert-from-stdin \
				--header:upsert:owner:"$callerName" \
				--header:upsert:status:dispatch-started \
				--header:upsert:session-id:"$receiptId" \
				--log-verb:created || {
				echo "$MDSC_CMD: agent-spawn-proxy: ⛔ ERROR: could not create dispatch tracking item $dispatchItemName" >&2
				set +e ; return 1
			}
		fi

		if [ "$waitMode" = "true" ] ; then
			local exitCode spawnPid watchPid timedOut waitTimeoutSeconds
			set +e
			waitTimeoutSeconds="$( DistroAgentsTools --agents-config-option magic-team --select-default SPAWN_WAIT_TIMEOUT_SECONDS 900 )"
			case "$waitTimeoutSeconds" in *[!0123456789]*|'') waitTimeoutSeconds=900 ;; esac
			env MMDAPP="$MMDAPP" "$MMDAPP/DistroAgentsConsole.sh" --cli-configured --non-interactive <<< "$spawnContext" > "$outputFile" 2>&1 &
			spawnPid=$!
			## The bound. A CLI that cannot arm does not exit, it sleeps, so an unbounded
			## wait holds the caller forever. TERM first so the CLI reaps its own
			## children; KILL after a grace period for one that ignores TERM. The
			## watcher's own exit status is how the foreground learns it fired -- a
			## subshell's status is the one value that escapes it, so nothing is named.
			(
				waitedSeconds=0
				while [ "$waitedSeconds" -lt "$waitTimeoutSeconds" ] ; do
					kill -0 "$spawnPid" 2>/dev/null || exit 0
					sleep 1
					waitedSeconds=$(( waitedSeconds + 1 ))
				done
				kill -TERM "$spawnPid" 2>/dev/null
				sleep 5
				kill -KILL "$spawnPid" 2>/dev/null
				exit 1
			) &
			watchPid=$!
			wait "$spawnPid" 2>/dev/null
			exitCode=$?
			wait "$watchPid" 2>/dev/null
			timedOut=$?
			set -e
			local sawSentinel="false"
			AgentsToolsSpawnProxySawSentinel "$outputFile" && sawSentinel="true"
			## The sentinel proves an exec happened, never that it finished; a killed
			## spawn prints it and then hangs, so a timeout is not a success.
			[ "$timedOut" = "0" ] || sawSentinel="false"
			AgentsToolsSpawnProxyAnnounceCli "$outputFile"
			if [ "$dispatchDocMode" = "create" ] ; then
				AgentsToolsSpawnProxyCloseDispatch "$dispatchItemName" "$dispatchBriefBody" "$exitCode" "$outputFile"
			fi
			echo "RECEIPT_ID=$receiptId"
			echo "DISPATCH_DOC=$dispatchDocMode"
			case "$dispatchDocMode" in
				create) echo "DISPATCH_ITEM=$dispatchItemName" ;;
				reuse)  echo "TRACKING_ITEM=$trackedItemName" ;;
			esac
			echo "STATUS=$( [ "$sawSentinel" = "true" ] && echo succeeded || echo failed )"
			echo "EXIT_CODE=$exitCode"
			## rc 5 from the console is its one structured answer: no external CLI
			## is selected in this workspace. It is reported as its own line so a
			## caller spawns an internal agent instead of reading the failure as a
			## CLI that broke, and re-runs nothing to find that out.
			[ "$exitCode" != "5" ] || echo "SETUP_STATUS=cli-not-configured"
			[ "$timedOut" = "0" ] || echo "TIMEOUT_SECONDS=$waitTimeoutSeconds"
			echo "OUTPUT_FILE=$outputFile"
			if [ "$sawSentinel" != "true" ] ; then
				set +e ; return 1
			fi
			return 0
		fi

		(
			set +e
			env MMDAPP="$MMDAPP" "$MMDAPP/DistroAgentsConsole.sh" --cli-configured --non-interactive <<< "$spawnContext"
			bgExitCode=$?
			set -e
			AgentsToolsSpawnProxyAnnounceCli "$outputFile"
			if [ "$dispatchDocMode" = "create" ] ; then
				AgentsToolsSpawnProxyCloseDispatch "$dispatchItemName" "$dispatchBriefBody" "$bgExitCode" "$outputFile"
			fi
		) > "$outputFile" 2>&1 &
		local spawnPid=$!
		echo "RECEIPT_ID=$receiptId"
		echo "DISPATCH_DOC=$dispatchDocMode"
		case "$dispatchDocMode" in
			create) echo "DISPATCH_ITEM=$dispatchItemName" ;;
			reuse)  echo "TRACKING_ITEM=$trackedItemName" ;;
		esac
		echo "STATUS=started"
		echo "PID=$spawnPid"
		echo "OUTPUT_FILE=$outputFile"
		return 0
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
