#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.PendingReplyCollect.include -- collects the answers to AskUserQuestion
## questions nobody is waiting on. Definitions only, sourced by the
## --intern-op-pending-reply-collect arm (AgentsTools.InternOpPendingReply.include).
##
## Each open record is read once and never waited on: one --member-wait-for-input round
## with a zero bound, over the question's own thread, since the question -- the same
## probe and the same answer rules a live wait uses. A plain question its item's Decisions
## already answer is closed from there. A readback, decision or permission is read only by
## the main loop's pass over ended and stale records, through the escalation op that reads
## and applies every verdict; a session's own collect never reads, closes or grants one.
##
## Pure tooling, run by the tooling itself: no model is called anywhere here.
##
## One line per record examined, first word the outcome:
##   ANSWERED <id> <tag> | <question first line> | <answer>   -- closed as received
##   UNMATCHED <id> <tag> | <question first line>              -- a reply seen and not taken
##   OPEN <id> <tag> | <question first line>                   -- nothing yet
##   UNREADABLE <id> <tag> | <why>                             -- nothing is known; stays open
##   ALREADY-CLOSED <id> <status>                              -- closed by another closer first
## then `COLLECT: answered=<n> unmatched=<n> open=<n> unreadable=<n>`.
##

## The header fields a collect needs, one line each as `<field>\t<value>`, in one pass.
AgentsToolsPendingReplyCollectFields(){ ## record file
	LC_ALL=C awk '
		$0 == "---" { dashes++ ; if ( dashes == 2 ) { inBody = 1 ; } next ; }
		dashes == 1 {
			colon = index($0, ": ") ;
			if ( colon > 1 ) { printf "%s\t%s\n", substr($0, 1, colon - 1), substr($0, colon + 2) ; }
			next ;
		}
		inBody && ! firstSeen && $0 !~ /^#/ && $0 !~ /^[ \t]*$/ { printf "first\t%s\n", $0 ; firstSeen = 1 ; }
	' "$1" 2>/dev/null
}

## Marks a record whose session has ended, so the main loop's collect finds it. Under
## the record's own lock, like every close.
AgentsToolsPendingReplyMarkEnded(){ ## pending id, record file
	local markLock markOps markBody
	. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.LocalLock.include"
	AgentsToolsLocalLockTake "pending-reply-$1" 30 || return 1
	markLock="$agentsLocalLockPath"
	markOps="$MMDAPP/.local/temp/mdat-pending-reply-mark.$$.$RANDOM"
	if [ "$( AgentsToolsPendingReplyCollectFieldOf "$2" status )" = "reply-pending" ] ; then
		printf 'upsert\tcollect\tended\n' > "$markOps" \
			&& markBody="$( LC_ALL=C awk -v opsFile="$markOps" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsBoardItemHeaderOpsApply.awk" < "$2" )" \
			&& [ -n "$markBody" ] && printf '%s\n' "$markBody" > "$2.$$" && mv -f "$2.$$" "$2"
		rm -f "$2.$$"
	fi
	rm -f "$markOps"
	AgentsToolsLocalLockGive "$markLock"
	return 0
}

## The sessions not known to have ended, as ` <id> <id> ... `: every session-id with a
## spawned-sessions row in state running (its process is alive on this host) or
## unknown-foreign (another host's, not closed, unmeasurable from here) -- the same render
## and states the review hand-over reads. A session with no spawn record is not listed.
AgentsToolsPendingReplySessionsRunning(){
	type AgentsToolsRegistryRenderSpawnedSessions > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.Registries.include"
	printf ' %s \n' "$( AgentsToolsRegistryRenderSpawnedSessions agents 2> /dev/null | LC_ALL=C awk '
		NF == 13 && $2 != "-" && ( $13 == "running" || $13 == "unknown-foreign" ) && ! seen[$2]++ { printf "%s ", $2 ; }
	' )"
}

## One field, for the rare single read.
AgentsToolsPendingReplyCollectFieldOf(){ ## record file, field
	LC_ALL=C awk -v key="$2" '
		$0 == "---" { dashes++ ; if ( dashes == 2 ) { exit ; } next ; }
		dashes == 1 && index($0, key ": ") == 1 { print substr($0, length(key) + 3) ; exit ; }
	' "$1" 2>/dev/null
}

## Collects one record. Prints its outcome line; sets collectOutcome and collectAnswer
## for the caller. The record is closed here only when it is answered.
AgentsToolsPendingReplyCollectOne(){ ## record file
	local oneFile="$1" oneId oneLine oneKey oneValue oneWork oneRc=0 oneBody oneHead oneClose
	local oneStatus="" oneKind="" oneOwner="" oneChannel="" oneQts="" oneTts="" oneAddr="" oneTag="" oneFirst="" oneItem=""
	collectOutcome="" ; collectAnswer=""
	oneId="${oneFile##*/}" ; oneId="${oneId%.md}"
	while IFS=$'\t' read -r oneKey oneValue ; do
		case "$oneKey" in
			status) oneStatus="$oneValue" ;;
			kind) oneKind="$oneValue" ;;
			owner) oneOwner="$oneValue" ;;
			channel) oneChannel="$oneValue" ;;
			question-ts) oneQts="$oneValue" ;;
			thread-ts) oneTts="$oneValue" ;;
			addressees) oneAddr="$oneValue" ;;
			question-tag) oneTag="$oneValue" ;;
			item) oneItem="$oneValue" ;;
			first) oneFirst="$oneValue" ;;
		esac
	done < <( AgentsToolsPendingReplyCollectFields "$oneFile" )
	[ "$oneStatus" = "reply-pending" ] || { collectOutcome="SKIPPED" ; return 0 ; }
	## A readback, decision or permission is read only for a session that is gone (collectTyped,
	## set by the main loop's pass): its verdict is read and applied by the escalation op, the one
	## place that does it, exactly as the asking session's own wait would have.
	case "$oneKind" in
		''|question) ;;
		*)
			[ -n "${collectTyped:-}" ] && [ -n "$oneOwner" ] || { collectOutcome="SKIPPED" ; return 0 ; }
			local oneRead oneVerdict
			oneRead="$( MDAT_PENDING_CLOSE_QUIET="${collectQuiet:-}" DistroAgentsTools --intern-op-escalation-read "$oneOwner" "$oneId" 2>/dev/null )" || oneRead=""
			oneVerdict="$( printf '%s\n' "$oneRead" | LC_ALL=C sed -n 's/^VERDICT: //p' | head -1 )"
			case "$oneRead" in
				*"ESCALATION: $oneId answered"*)
					collectOutcome="ANSWERED" ; collectAnswer="$oneVerdict"
					printf 'ANSWERED %s %s | %s | %s\n' "$oneId" "${oneTag:--}" "$oneFirst" "$oneVerdict"
				;;
				*"ESCALATION: $oneId open"*)
					collectOutcome="OPEN"
					printf 'OPEN %s %s | %s\n' "$oneId" "${oneTag:--}" "$oneFirst"
				;;
				*)
					collectOutcome="UNREADABLE"
					printf 'UNREADABLE %s %s | the escalation read gave no verdict and no open state\n' "$oneId" "${oneTag:--}"
				;;
			esac
			return 0
		;;
	esac
	## A question its item's Decisions already answer is closed with that answer, read from
	## there, so it is not recorded there a second time.
	## The item's own Decisions first, then those of the task it `tracks:`.
	local oneItemPath="" oneDecision=""
	if [ -n "$oneItem" ] ; then
		type AgentsToolsDecisionsEarlierTracked > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsTools.ItemDecisions.include"
		oneItemPath="$( AgentsToolsDecisionsItemPath "$oneItem" )" && oneDecision="$( AgentsToolsDecisionsEarlierTracked "$oneItemPath" "$oneFirst" )" || oneDecision=""
	fi
	if [ -n "$oneDecision" ] ; then
		collectAnswer="${oneDecision##* -> }" ; collectAnswer="${collectAnswer% (*} (from the Decisions of ${oneDecision%% | *})"
		oneRc=0
		oneClose="$( DistroAgentsTools --intern-op-pending-reply-close "$oneId" --if-open --status reply-received --no-decision ${collectQuiet:+--quiet} \
			--verdict "$collectAnswer" --answered-by decisions --context collect 2>/dev/null )" || oneRc=$?
		case "$oneRc" in
			0) collectOutcome="ANSWERED" ; printf 'ANSWERED %s %s | %s | %s\n' "$oneId" "${oneTag:--}" "$oneFirst" "$collectAnswer" ; return 0 ;;
			3) collectOutcome="ALREADY-CLOSED" ; printf '%s\n' "$oneClose" ; return 0 ;;
		esac
	fi
	if [ -z "$oneChannel" ] || [ -z "$oneQts" ] || [ -z "$oneTts" ] || [ -z "$oneAddr" ] || [ -z "$oneOwner" ] ; then
		collectOutcome="UNREADABLE"
		printf 'UNREADABLE %s %s | the record names no thread, question or addressee to read\n' "$oneId" "${oneTag:--}"
		return 0
	fi
	oneWork="$( mktemp "$MMDAPP/.local/temp/mdat-pending-collect.XXXXXX" )" || { collectOutcome="UNREADABLE" ; printf 'UNREADABLE %s %s | no work file\n' "$oneId" "${oneTag:--}" ; return 0 ; }
	DistroAgentsTools --intern-op-wait-for-input "$oneOwner" --wait-source "slack:$oneChannel:$oneTts" \
		--wait-timeout 0 --wait-since-utime "$oneQts" --wait-addressee "$oneAddr" > "$oneWork" 2> "$oneWork.err" || oneRc=$?
	if [ "$oneRc" != "0" ] || LC_ALL=C grep -q '^WAIT-NEVER-READ: ' "$oneWork" || ! LC_ALL=C grep -q -E '^WAIT-RESULT: (RECEIVED|TIMEOUT)$' "$oneWork" ; then
		collectOutcome="UNREADABLE"
		printf 'UNREADABLE %s %s | the thread could not be read, so nothing is known about it\n' "$oneId" "${oneTag:--}"
		rm -f "$oneWork" "$oneWork.err"
		return 0
	fi
	if LC_ALL=C grep -q '^WAIT-RESULT: TIMEOUT$' "$oneWork" ; then
		collectOutcome="OPEN"
		printf 'OPEN %s %s | %s\n' "$oneId" "${oneTag:--}" "$oneFirst"
		rm -f "$oneWork" "$oneWork.err"
		return 0
	fi
	oneBody="$( LC_ALL=C awk '
		$0 == "# --- what that source holds now follows ---" { inBody = 1 ; next ; }
		$0 == "# --- end ---" { inBody = 0 ; next ; }
		inBody { print ; }
	' "$oneWork" )"
	rm -f "$oneWork" "$oneWork.err"
	## An answer is a reply head or a reaction, exactly what ends a live wait on a question.
	oneHead="$( printf '%s\n' "$oneBody" | LC_ALL=C grep -m1 -E '^([0-9]+\.[0-9]+ \| |reaction on the question: )' )" || oneHead=""
	if [ -z "$oneHead" ] ; then
		collectOutcome="UNMATCHED"
		printf 'UNMATCHED %s %s | %s\n' "$oneId" "${oneTag:--}" "$oneFirst"
		return 0
	fi
	local oneBy="reaction" oneAnswerTs=""
	case "$oneHead" in
		'reaction on the question: '*)
			collectAnswer="$oneHead"
		;;
		*)
			oneAnswerTs="${oneHead%% *}"
			oneBy="${oneHead#* | }" ; oneBy="${oneBy%% |*}"
			collectAnswer="$( printf '%s\n' "$oneBody" | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsPendingReplyAnswerText.awk" )"
		;;
	esac
	oneRc=0
	oneClose="$( DistroAgentsTools --intern-op-pending-reply-close "$oneId" --if-open --status reply-received ${collectQuiet:+--quiet} \
		--verdict "$collectAnswer" --answered-by "$oneBy" ${oneAnswerTs:+--answer-ts "$oneAnswerTs"} --context collect 2>/dev/null )" || oneRc=$?
	case "$oneRc" in
		0)
			collectOutcome="ANSWERED"
			printf 'ANSWERED %s %s | %s | %s\n' "$oneId" "${oneTag:--}" "$oneFirst" "$collectAnswer"
			## The answer is the reply's first line; the rest of it and every later reply are its
			## clarifications, kept on the record and the item's Decisions.
			local oneClarify=""
			oneClarify="$( printf '%s\n' "$oneBody" | LC_ALL=C awk -v answerTs="${oneAnswerTs:-$oneQts}" \
				-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/AgentsPendingReplyClarifications.awk" 2>/dev/null )" || oneClarify=""
			[ -z "$oneClarify" ] || printf '%s\n' "$oneClarify" | DistroAgentsTools --intern-op-pending-reply-clarify "$oneId" --from-stdin --context collect > /dev/null 2>&1 \
				|| echo "$MDSC_CMD: ⚠️ WARNING: $oneId is closed, but its clarifications were not kept" >&2
		;;
		3)
			collectOutcome="ALREADY-CLOSED"
			printf '%s\n' "$oneClose"
		;;
		*)
			collectOutcome="OPEN"
			printf 'OPEN %s %s | %s -- an answer was seen, and the close failed, so it stays open\n' "$oneId" "${oneTag:--}" "$oneFirst"
		;;
	esac
	return 0
}
