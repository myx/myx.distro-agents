#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

## AgentsTools.InternOpPendingReplyClose.include -- the operation `--intern-op-pending-reply-close`, sourced by AgentsTools.InternOpPendingReply.include with the operation's arguments.
		shift
		MDSC_CMD="$MDSC_CMD --intern-op-pending-reply-close"
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsContext.UseAgentsTools.include"
		local pendingId="$1"
		shift || true
		local pendingStatus="" pendingVerdict="" pendingAnsweredBy="" pendingIfOpen="" pendingAnswerTs="" pendingMark=""
		local pendingAmend="" pendingAmendedBy="" pendingAmendReason="" pendingNoDecision="" pendingWithdrawnBy="" pendingWithdrawReason=""
		## Closed with no reaction: the main loop's pass closing an ask whose session still runs
		## (--quiet, or MDAT_PENDING_CLOSE_QUIET=1 through the escalation op it calls).
		local pendingQuiet="${MDAT_PENDING_CLOSE_QUIET:-}"
		while [ $# -gt 0 ] ; do
			case "$1" in
				--quiet)
					pendingQuiet=1
					shift
				;;
				## The answer came from the item's own Decisions, so it is not recorded there twice.
				--no-decision)
					pendingNoDecision=1
					shift
				;;
				## The ts of the reply taken as the answer, marked :eyes: once the record is closed.
				--answer-ts)
					pendingAnswerTs="${2:-}"
					shift 2
				;;
				## How the question is marked once closed: `answered` (the default) or `settled`.
				--resolved-as)
					case "${2:-}" in
						answered) pendingMark="white_check_mark" ;;
						settled) pendingMark="ballot_box_with_check" ;;
						*) echo "$MDSC_CMD: ⛔ ERROR: --resolved-as must be answered|settled: ${2:-}" >&2 ; set +e ; return 1 ;;
					esac
					shift 2
				;;
				## Closes only a record still waiting: of two closers racing on one record (a
				## live wait and a collect), the second finds it closed and says so, rc 3.
				--if-open)
					pendingIfOpen=1
					shift
				;;
				## Corrects a record already closed: its verdict and status are rewritten, and
				## who amended it and why are recorded; its close time and reactions stay as they were.
				--amend)
					pendingAmend=1
					shift
				;;
				--amended-by)
					pendingAmendedBy="${2:-}"
					shift 2
				;;
				--amend-reason)
					pendingAmendReason="${2:-}"
					shift 2
				;;
				--status)
					pendingStatus="${2:-}"
					shift 2
				;;
				--verdict)
					pendingVerdict="${2:-}"
					shift 2
				;;
				--answered-by)
					pendingAnsweredBy="${2:-}"
					shift 2
				;;
				## A question its asker withdrew (--status withdrawn): who, and why. No verdict.
				--withdrawn-by)
					pendingWithdrawnBy="${2:-}"
					shift 2
				;;
				--withdraw-reason)
					pendingWithdrawReason="${2:-}"
					shift 2
				;;
				--context)
					shift 2
				;;
				*)
					echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
					set +e ; return 1
				;;
			esac
		done
		if [ -z "$pendingId" ] || [ -z "$pendingStatus" ] ; then
			echo "$MDSC_CMD: ⛔ ERROR: syntax is <pending-reply-id> --status <reply-received|reply-unknown|withdrawn>" >&2
			set +e ; return 1
		fi
		AgentsToolsAssertBareName "$pendingId" "<pending-reply-id>" pending-reply-close || { set +e ; return 1 ; }
		case "$pendingStatus" in
			reply-received|reply-unknown) ;;
			## Withdrawn by its asker: never an answer, so it carries no verdict and grants or
			## decides nothing; who withdrew it and why are both required.
			withdrawn)
				if [ -n "$pendingVerdict" ] || [ -n "$pendingAmend" ] || [ -z "$pendingWithdrawnBy" ] || [ -z "$pendingWithdrawReason" ] ; then
					echo "$MDSC_CMD: ⛔ ERROR: --status withdrawn takes --withdrawn-by and --withdraw-reason, and never a --verdict or --amend" >&2
					set +e ; return 1
				fi
			;;
			*)
				## Enumerated rather than free text, because these direct different next
				## steps: a received reply resumes the work, an unknown is neither until
				## someone looks, and a withdrawn question needs nothing more. No timeout
				## status: a pending record never expires by age (MAGIC.md). An old record
				## already closed as reply-timeout is still read like any closed one.
				echo "$MDSC_CMD: ⛔ ERROR: --status must be reply-received|reply-unknown|withdrawn: $pendingStatus" >&2
				set +e ; return 1
			;;
		esac
		## A closed record lives in pending/closed/ (retention, T9): --amend corrects one there, a close of a live one finds it in pending/.
		## Any store the reader lists it from (AgentsToolsPendingRecordPath): the live store, its closed/, and the team's questions store,
		## where an ask about a contact's tier lives. A record that is listed can be closed.
		local pendingFile="$MMDAPP/.local/agents/pending/$pendingId.md"
		[ -f "$pendingFile" ] || pendingFile="$MMDAPP/.local/agents/pending/closed/$pendingId.md"
		if [ ! -f "$pendingFile" ] ; then
			type AgentsToolsPendingRecordPath > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.Authority.include"
			pendingFile="$( AgentsToolsPendingRecordPath "$pendingId" 2> /dev/null )" || pendingFile=""
		fi
		if [ ! -f "$pendingFile" ] ; then
			echo "$MDSC_CMD: ⛔ ERROR: no pending-reply record: $pendingId" >&2
			set +e ; return 1
		fi
		## Every close holds the record's own lock across its read and its write, so two
		## closers never interleave on one record.
		local pendingLock="" pendingNow=""
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/common/AgentsTools.LocalLock.include"
		if ! AgentsToolsLocalLockTake "pending-reply-$pendingId" 30 ; then
			echo "$MDSC_CMD: ⛔ ERROR: the lock on $pendingId could not be taken, so the record was left unchanged" >&2
			set +e ; return 1
		fi
		pendingLock="$agentsLocalLockPath"
		## Another closer's close moved the record to closed/ while this one waited on the lock (retention, T9): read it again where it is.
		[ -f "$pendingFile" ] || pendingFile="$MMDAPP/.local/agents/pending/closed/$pendingId.md"
		if [ -n "$pendingAmend" ] ; then
			type AgentsToolsFrontmatterKey > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/common/AgentsTools.FrontmatterKey.include"
			pendingNow="$( AgentsToolsFrontmatterKey "$pendingFile" status )"
			if [ "$pendingNow" = "reply-pending" ] || [ -z "$pendingAmendedBy" ] || [ -z "$pendingAmendReason" ] || [ -z "$pendingVerdict" ] ; then
				AgentsToolsLocalLockGive "$pendingLock"
				echo "$MDSC_CMD: ⛔ ERROR: --amend corrects a closed record only, and needs --verdict, --amended-by and --amend-reason; $pendingId is ${pendingNow:-unknown}, left as it is" >&2
				set +e ; return 1
			fi
		fi
		if [ -n "$pendingIfOpen" ] ; then
			type AgentsToolsFrontmatterKey > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/common/AgentsTools.FrontmatterKey.include"
			pendingNow="$( AgentsToolsFrontmatterKey "$pendingFile" status )"
			if [ "$pendingNow" != "reply-pending" ] ; then
				AgentsToolsLocalLockGive "$pendingLock"
				printf 'ALREADY-CLOSED %s %s\n' "$pendingId" "${pendingNow:-unknown}"
				set +e ; return 3
			fi
		fi
		## Applied by this package's own header writer, so no second frontmatter
		## parser exists and a failure leaves the record exactly as it was -- an open
		## record is recoverable by a rescan, a truncated one is not.
		local pendingOps pendingBody
		## A file of this close's own, by mktemp: $$ is one for every subshell of one shell, and $RANDOM beside it is no promise.
		mkdir -p "$MMDAPP/.local/temp" && pendingOps="$( mktemp "$MMDAPP/.local/temp/mdat-pending-reply-ops.XXXXXX" )" || { AgentsToolsLocalLockGive "$pendingLock" ; set +e ; return 1 ; }
		{
			printf 'upsert\tstatus\t%s\n' "$pendingStatus"
			if [ -n "$pendingAmend" ] ; then
				## What the correction corrected stays on the record: the first verdict and its giver.
				LC_ALL=C awk '
					NR > 1 && $0 == "---" { exit ; }
					index($0, "verdict: ") == 1 { printf "upsert\tamended-from\t%s\n", substr($0, 10) ; }
					index($0, "answered-by: ") == 1 { printf "upsert\tamended-from-answered-by\t%s\n", substr($0, 14) ; }
				' "$pendingFile"
				printf 'upsert\tamended-at\t%s\n' "$( date +"%Y-%m-%d %H:%M %z" )"
				printf 'upsert\tamended-by\t%s\n' "${pendingAmendedBy//$'\n'/ }"
				printf 'upsert\tamend-reason\t%s\n' "${pendingAmendReason//$'\n'/ }"
			else
				printf 'upsert\tresolved-at\t%s\n' "$( date +"%Y-%m-%d %H:%M %z" )"
				## The same moment in epoch seconds, which a reply's Slack ts compares with: a
				## plain reply after this question was closed answers nothing (AgentsTools.AskThread.include).
				printf 'upsert\tresolved-epoch\t%s\n' "$( date +%s )"
			fi
			[ -z "$pendingVerdict" ] || printf 'upsert\tverdict\t%s\n' "${pendingVerdict//$'\n'/ }"
			[ -z "$pendingAnsweredBy" ] || printf 'upsert\tanswered-by\t%s\n' "${pendingAnsweredBy//$'\n'/ }"
			[ -z "$pendingWithdrawnBy" ] || printf 'upsert\twithdrawn-by\t%s\n' "${pendingWithdrawnBy//$'\n'/ }"
			[ -z "$pendingWithdrawReason" ] || printf 'upsert\twithdraw-reason\t%s\n' "${pendingWithdrawReason//$'\n'/ }"
		} > "$pendingOps" || { rm -f "$pendingOps" ; AgentsToolsLocalLockGive "$pendingLock" ; set +e ; return 1 ; }
		pendingBody="$( LC_ALL=C awk -v opsFile="$pendingOps" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsBoardItemHeaderOpsApply.awk" < "$pendingFile" )" || pendingBody=""
		rm -f "$pendingOps"
		if [ -z "$pendingBody" ] ; then
			AgentsToolsLocalLockGive "$pendingLock"
			echo "$MDSC_CMD: ⚠️ WARNING: the record was left unchanged: $pendingFile" >&2
			set +e ; return 1
		fi
		## Aside, then one rename: the lock orders closers, but a reader takes no lock.
		{ printf '%s\n' "$pendingBody" > "$pendingFile.$$" && mv -f "$pendingFile.$$" "$pendingFile" ; } \
			|| { rm -f "$pendingFile.$$" ; AgentsToolsLocalLockGive "$pendingLock" ; set +e ; return 1 ; }
		AgentsToolsLocalLockGive "$pendingLock"
		## AN ANSWERED ASK RESTARTS THE REVIEW COUNT OF ITS SESSION (AgentsReviewWaitLeft): its moment goes in
		## one line beside the records, after the record's own rename, and never lowers a later one. Best effort.
		if [ "$pendingStatus" = "reply-received" ] && [ -z "$pendingAmend" ] ; then
			local answerSession answerEpoch answerKept=""
			type AgentsToolsFrontmatterKey > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/common/AgentsTools.FrontmatterKey.include"
			answerSession="$( AgentsToolsFrontmatterKey "$pendingFile" session-id )"
			answerEpoch="$( date +%s )"
			case "$answerSession" in ''|-|*/*|.|..) ;; *)
				mkdir -p "$MMDAPP/.local/agents/pending/answers" 2> /dev/null || :
				{ IFS= read -r answerKept < "$MMDAPP/.local/agents/pending/answers/$answerSession.epoch" ; } 2> /dev/null || answerKept=""
				case "$answerKept" in ''|*[!0123456789]*) ;; *) [ "$answerKept" -le "$answerEpoch" ] || answerEpoch="$answerKept" ;; esac
				## A WRITE THAT FAILED LEAVES NO FILE: absent reads as no answer, never as a stale one.
				printf '%s\n' "$answerEpoch" > "$MMDAPP/.local/agents/pending/answers/$answerSession.epoch" 2> /dev/null \
					|| rm -f "$MMDAPP/.local/agents/pending/answers/$answerSession.epoch" 2> /dev/null || :
			;;
			esac
		fi
		## AN ANSWERED ASK REACHES ITS ASKER ON THE SESSION FLOOR: one message on the asking session's printback channel in its chat file,
		## addressed to the member that asked (AgentsToolsPendingReplyFloorNotice). It names the ask, its question and its
		## result, so a run that rewound to its checkpoint since it asked still learns the answer and what it answers: a floor Wait or an
		## idle wait needs no `ask:` source to hear it. Best effort, after the record is closed; a session with no folder gets nothing.
		## An amended answer reaches the asker the same way, named as the correction it is (ASK-AMENDED), so a run that acted on the first
		## answer learns it changed.
		if [ "$pendingStatus" = "reply-received" ] ; then
			AgentsToolsPendingReplyFloorNotice "$pendingFile" "$pendingId" "$pendingVerdict" "${pendingAnsweredBy:-$pendingAmendedBy}" "${pendingAmend:+amended}" || :
		fi
		## THE OUTCOME ON THE ASK'S ITEM: one line on its Decisions (AgentsToolsDecisionsFromPending), and a blocker naming the ask
		## cleared, for every close -- answered, settled, unknown, withdrawn or amended -- unless the answer came from those Decisions
		## (--no-decision). Best effort: a record with no item records nothing, and a failed board edit never undoes the close.
		if [ -z "$pendingNoDecision" ] ; then
			type AgentsToolsDecisionsFromPending > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.ItemDecisions.include"
			AgentsToolsDecisionsFromPending "$pendingId" "$pendingFile" "$pendingStatus" "$pendingAmend" "$pendingAnswerTs" || :
		fi
		## A QUESTION CLOSED WITH NO VERDICT LEAVES THE ASK'S WAIT SOURCE (S21.6, owner 2026-10-30): a withdrawn one, or one settled elsewhere,
		## can never answer the wait that watches it. An answered one is carried by the one call that shows its closed note and is stored no
		## more (owner ruling 2026-10-31, AgentsWaitStateStore in AgentsTools.MemberWait.include): a later message in its thread reaches the
		## asker as the session floor's, never as a CLARIFIED of this question.
		if [ -z "$pendingVerdict" ] ; then
			local dropOwner="" dropSession=""
			type AgentsToolsFrontmatterKey > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/common/AgentsTools.FrontmatterKey.include"
			dropOwner="$( AgentsToolsFrontmatterKey "$pendingFile" owner )" || dropOwner=""
			dropSession="$( AgentsToolsFrontmatterKey "$pendingFile" session-id )" || dropSession=""
			if [ -n "$dropOwner" ] && [ -n "$dropSession" ] ; then
				type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
				DistroAgentsTools --intern-op-wait-for-input "$dropOwner" --wait-drop --wait-session-id "$dropSession" --wait-source "ask:$pendingId" > /dev/null 2>&1 || :
			fi
		fi
		## The outcome goes to the ask's item, where a reopened or continued task reads it.
		## A resolved question shows it where people look: :eyes: on the reply taken as its
		## answer, a mark on the question in its thread (:white_check_mark: answered,
		## :ballot_box_with_check: settled), the answer emoji the tooling placed there taken off
		## with that mark, and :white_check_mark: on the thread's opener in
		## the conversation once no question in that thread is open. Best effort, after the
		## record is closed: a reaction that fails is logged and never undoes the close. Never
		## an answer either: only an addressee's reaction answers.
		if [ "$pendingStatus" = "reply-received" ] && [ -z "$pendingAmend" ] && [ "$pendingQuiet" != "1" ] ; then
			local reactOwner="" reactChannel="" reactQuestion="" reactThread="" reactTo="" reactKind="" reactIdentity="" reactKey reactValue
			while IFS=$'\t' read -r reactKey reactValue ; do
				case "$reactKey" in
					owner) reactOwner="$reactValue" ;;
					channel) reactChannel="$reactValue" ;;
					question-ts) reactQuestion="$reactValue" ;;
					thread-ts) reactThread="$reactValue" ;;
					kind) reactKind="$reactValue" ;;
					ask-identity) reactIdentity="$reactValue" ;;
					communication-channel-id) reactTo="${reactValue#slack:}" ;;
				esac
			done < <( LC_ALL=C awk '
				$0 == "---" { dashes++ ; if ( dashes == 2 ) { exit ; } next ; }
				dashes == 1 {
					colon = index($0, ": ") ;
					if ( colon > 1 ) { printf "%s\t%s\n", substr($0, 1, colon - 1), substr($0, colon + 2) ; }
				}
			' "$pendingFile" )
			if [ -n "$reactOwner" ] && [ -n "$reactChannel" ] ; then
				[ -z "$pendingAnswerTs" ] || AgentsToolsPendingReplyReact "$reactOwner" "$reactChannel:$pendingAnswerTs" eyes "$pendingId" "$reactIdentity"
				## Never a mark on the root of a proposal: a check mark there is the human-owner's own
				## verdict, and the tooling puts none beside it. The two answer emoji it placed there itself
				## (F9.4) are taken off, as the identity that placed them, so what stands is his alone.
				if [ -n "$reactQuestion" ] && [ "$reactKind" = "proposal" ] ; then
					type AgentsToolsAskPostClose > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.AskPost.include"
					AgentsToolsAskPostClose "$pendingFile" "$reactQuestion" "" ""
				elif [ -n "$reactQuestion" ] ; then
					## The question takes no click any more: with its mark the tooling takes off that
					## post the answer emoji it placed there itself, the names its template gives for
					## its kind and answer form, under the identity that placed them
					## (AgentsToolsAskPostClose). The click of who answered is his own, and stays.
					## The prompt of a held change is also edited to its text without `How to answer`,
					## as one that was rejected is. Best effort, each step, as the mark is.
					type AgentsToolsAskPostClose > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.AskPost.include"
					AgentsToolsAskPostClose "$pendingFile" "$reactQuestion" "" "$( [ "$reactKind" != "change" ] || printf 'edit' )"
					AgentsToolsPendingReplyReact "$reactOwner" "$reactChannel:$reactQuestion" "${pendingMark:-white_check_mark}" "$pendingId" "$reactIdentity"
				fi
				## The opener is ours only where the question opened its own thread; a question
				## asked inside someone's thread (<channel>:<ts>) leaves that thread's root alone.
				## A question posted as the root of its own thread has no opener: it is that root,
				## and is marked above. Only records from before questions were posted that way
				## carry an opener ahead of the question.
				case "$reactTo" in
					*:*) ;;
					*)
						if [ -n "$reactThread" ] && [ "$reactThread" != "$reactQuestion" ] && ! AgentsToolsPendingReplyThreadHasOpen "$reactChannel" "$reactThread" ; then
							AgentsToolsPendingReplyReact "$reactOwner" "$reactChannel:$reactThread" white_check_mark "$pendingId" "$reactIdentity"
						fi
					;;
				esac
			fi
		fi
		## Retention (T9): a record closed here leaves the live store for pending/closed/, its sidecars (.options, .fields and the rest) with it, so
		## a scan of the store opens only the live ones. The record is already closed and read whole above; a failed move leaves it in place, still closed.
		## Only a record of the live store moves; one of the team's questions store stays where the team keeps it.
		if [ "$pendingStatus" != "reply-pending" ] && [ -f "$pendingFile" ] && [ "${pendingFile%/*}" = "$MMDAPP/.local/agents/pending" ] ; then
			mkdir -p "$MMDAPP/.local/agents/pending/closed" 2>/dev/null || :
			for pendingMove in "$pendingFile" "${pendingFile%.md}".* ; do
				## The .options, .fields and .set sidecars move with the record. The .answered claim directory stays in pending/
				## until the escalation apply has finished, and moves after that (AgentsToolsEscalationApplyFinish).
				[ -e "$pendingMove" ] || continue
				case "$pendingMove" in *.answered) continue ;; esac
				mv -f "$pendingMove" "$MMDAPP/.local/agents/pending/closed/$( basename "$pendingMove" )" 2>/dev/null || :
			done
		fi
		return 0
