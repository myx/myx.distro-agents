#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.Authority.include -- the authority to resolve, dismiss or end another run's
## question or the run itself (F6.10), and the request that escalates it. Sourced, never run.
## Functions only.
##
## WHO HOLDS IT. Over a run: whoever it reports to (AgentsToolsRunRoute, F6.8); over a whole
## session: whoever its founding run reports to. The owners role (human-owner) tops every chain,
## and acts only through its own authenticated channel: the answer of its own Slack account in a
## request's thread. Anyone else holds it where the owners role granted it by a recorded
## permission: a refusal of this rule, logged (tool `authority`), and granted with
## --intern-op-permission-grant-open. Never by a built-in equality.
## WHO CALLS. A spawned member's run is that member in its session; anyone else is the person at
## the console, `user-<account>`, and never the owners role: for THIS authority a console account
## mapped to an owner (HUMAN_OWNER_CONSOLE_ACCOUNT, scope magic-team) only sends a confirmation to
## that owner's own channel, a second factor, and only the owner's answer there acts. The same
## mapping is how a verdict only the owner gives -- a review, a held change, a proposal -- is
## recognized as his own when he gives it at that console (AgentsToolsPermissionIsHumanOwner): the
## person there IS the owner, and that is no grant of authority over another run.
## WITHOUT IT nothing is disabled: a bare call fails, naming the authority it needs and its two
## options. --escalate-wait [--timeout <s>] asks and waits, with no timeout by default: exit 0
## approved and acted, 1 denied, 124 at the timeout, where the request is withdrawn and its record
## kept, so nothing acts on it later. --escalate-enqueue asks and returns `PENDING <id>` on its
## first line, exit 0, and the action is taken when the answer arrives: given with the escalation
## answer, or read in its thread by the pending-collect sweep. --escalate-stop, with --escalate-wait,
## makes the wait answer to a signal the console sends it: TERM, INT or HUP end the wait and withdraw
## the request, its record kept, exit 130; USR1 ends the wait and leaves the request pending, as
## --escalate-enqueue makes it (`ENQUEUED <id>`), exit 0, so the sweep acts on its answer.
## A REQUEST is a pending question in the questions store, .local/questions/, in the one
## pending-question form (--intern-op-pending-reply-open --store questions), with the action it
## lets run kept beside it (<id>.action, one word a line). It goes to the caller's reports-to, then
## up its chain: from the console to the holder; from a member's run to where that run reports; and
## a coordinator never to a magic-coordinator, but to its parent session, else to the person who
## started it, else to the owners role. A choice among answers goes as a choice (kind decision,
## the question's options, beside an allow and a deny of the one proposed); a text to provide as
## a question (kind question, its reply the text, or an allow or a deny of the one proposed);
## anything else as a permission; an owner's confirmation as a readback.
##

## The questions store, where a request is kept.
AgentsToolsQuestionsStore(){
	printf '%s' "${MMDAPP:-/nonexistent}/.local/questions"
}

## The record of a pending question by its id, in either store: printed, rc 0; rc 1 where none is.
AgentsToolsPendingRecordPath(){ ## pending id
	local pathStore
	type AgentsToolsAssertBareName > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.BareName.include"
	AgentsToolsAssertBareName "$1" "<pending-id>" pending-record 2> /dev/null || return 1
	## A closed record lives in pending/closed/ (retention, T9): the live store first, then the closed one, then the questions store.
	for pathStore in "${MMDAPP:-/nonexistent}/.local/agents/pending" "${MMDAPP:-/nonexistent}/.local/agents/pending/closed" "$( AgentsToolsQuestionsStore )" ; do
		[ ! -f "$pathStore/$1.md" ] || { printf '%s' "$pathStore/$1.md" ; return 0 ; }
	done
	return 1
}

## One header of a record: its first `<name>: ` line within the frontmatter.
AgentsToolsAuthorityField(){ ## file, name
	[ -f "$1" ] || return 0
	LC_ALL=C awk -v wantField="$2" '$0 == "---" { if ( ++dashes == 2 ) { exit ; } next ; } dashes == 1 && index( $0, wantField ": " ) == 1 { print substr( $0, length( wantField ) + 3 ) ; exit ; }' "$1" 2> /dev/null
}

## Headers of a record set, `<name> <value>` pairs, one that is absent added at the end of the
## frontmatter: written beside it and put in its place by one rename.
AgentsToolsAuthorityFieldSet(){ ## file, name, value, ...
	local setFile="$1" setTemp="" setPairs=""
	shift
	[ -f "$setFile" ] || return 1
	while [ $# -ge 2 ] ; do
		setPairs="$setPairs$1"$'\t'"$( printf '%s' "$2" | LC_ALL=C tr '\r\n\t' '   ' )"$'\n'
		shift 2
	done
	setTemp="$( mktemp "$setFile.XXXXXX" 2> /dev/null )" || return 1
	agentsAuthoritySetPairs="$setPairs" LC_ALL=C awk '
		BEGIN { count = split( ENVIRON["agentsAuthoritySetPairs"], lines, "\n" ) ; for ( i = 1 ; i <= count ; i++ ) { if ( lines[i] == "" ) { continue ; } ; tab = index( lines[i], "\t" ) ; name = substr( lines[i], 1, tab - 1 ) ; value[name] = substr( lines[i], tab + 1 ) ; order[++names] = name ; } ; }
		$0 == "---" && ++dashes == 2 { for ( i = 1 ; i <= names ; i++ ) { if ( ! ( order[i] in done ) ) { print order[i] ": " value[order[i]] ; } ; } ; print ; next ; }
		dashes == 1 { for ( i = 1 ; i <= names ; i++ ) { if ( index( $0, order[i] ": " ) == 1 ) { print order[i] ": " value[order[i]] ; done[order[i]] = 1 ; next ; } ; } ; }
		{ print ; }
	' "$setFile" > "$setTemp" && mv -f "$setTemp" "$setFile" || { rm -f "$setTemp" ; return 1 ; }
}

## The account at the console, as every console operation records it.
AgentsToolsAuthorityAccount(){
	type AgentsToolsConsoleAccount > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.CallerCheck.include"
	AgentsToolsConsoleAccount || printf 'unknown\n'
}

## Who calls, set here: agentsAuthorityCallerKind `member` for a member's run, with
## agentsAuthorityCallerId the member, agentsAuthorityCallerRun its spawn id,
## agentsAuthorityCallerSession its session and agentsAuthorityCallerRecord its record; else
## `person`, with agentsAuthorityCallerId `user-<account>`.
AgentsToolsAuthorityCaller(){
	agentsAuthorityCallerKind="person" agentsAuthorityCallerId="user-$( AgentsToolsAuthorityAccount )"
	agentsAuthorityCallerRun="" agentsAuthorityCallerSession="" agentsAuthorityCallerRecord=""
	[ -n "${MDAT_SPAWN_AGENT:-}" ] || return 0
	type AgentsToolsSessionRunRecord > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SpawnSandbox.include"
	agentsAuthorityCallerKind="member" agentsAuthorityCallerId="$MDAT_SPAWN_AGENT" agentsAuthorityCallerRun="${MDAT_SPAWN_SESSION_ID:-}"
	agentsAuthorityCallerRecord="$( AgentsToolsSessionRunRecord "$agentsAuthorityCallerRun" )" || agentsAuthorityCallerRecord=""
	[ -z "$agentsAuthorityCallerRecord" ] || agentsAuthorityCallerSession="$( AgentsToolsAuthorityField "$agentsAuthorityCallerRecord" session-id )"
	[ -n "$agentsAuthorityCallerSession" ] || agentsAuthorityCallerSession="${MDAT_SESSION_ID:-$agentsAuthorityCallerRun}"
}

## The record of a session's founding run: printed, rc 0; rc 1 where none is found here.
AgentsToolsAuthorityFounder(){ ## session
	local founderRecord
	type AgentsToolsSessionRunExecutor > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SpawnSandbox.include"
	for founderRecord in $( LC_ALL=C grep -l -x -F "session-id: $1" "${MMDAPP:-/nonexistent}"/.local/agents/spawned/*/*.spawn.md 2> /dev/null ) ; do
		! AgentsToolsSessionRunExecutor "$founderRecord" || { printf '%s' "$founderRecord" ; return 0 ; }
	done
	return 1
}

## The record the authority over a whole session is asked of: its founding run's. Where no run
## of it is known as its founder, a run of it the caller does not hold the authority over, else
## any run of it -- so ending it takes the authority over every run it has. Printed, rc 0; rc 1
## where the session has no run here.
AgentsToolsAuthoritySessionRecord(){ ## session
	local sessionRecord="" sessionCandidate sessionAny=""
	sessionRecord="$( AgentsToolsAuthorityFounder "$1" )" && { printf '%s' "$sessionRecord" ; return 0 ; }
	AgentsToolsAuthorityCaller
	for sessionCandidate in $( LC_ALL=C grep -l -x -F "session-id: $1" "${MMDAPP:-/nonexistent}"/.local/agents/spawned/*/*.spawn.md 2> /dev/null ) ; do
		[ -n "$sessionAny" ] || sessionAny="$sessionCandidate"
		AgentsToolsAuthorityHolds "$( AgentsToolsRunRoute "$sessionCandidate" )" "$1" || { printf '%s' "$sessionCandidate" ; return 0 ; }
	done
	[ -n "$sessionAny" ] || return 1
	printf '%s' "$sessionAny"
}

## A session said plainly, for a request that names it: `<name or id> (<routine>, <members>)`, from its records. The name is the session's comment
## where it has one; the routine is the founding run's; the members are those that have a run in it.
AgentsToolsAuthoritySessionWords(){ ## session
	local wordsFile wordsName="" wordsRoutine="" wordsMembers="" wordsOwner
	for wordsFile in $( LC_ALL=C grep -l -x -F "session-id: $1" "${MMDAPP:-/nonexistent}"/.local/agents/spawned/*/*.spawn.md 2> /dev/null ) ; do
		[ -n "$wordsName" ] || wordsName="$( AgentsToolsAuthorityField "$wordsFile" session-comment )"
		[ -n "$wordsRoutine" ] || wordsRoutine="$( AgentsToolsAuthorityField "$wordsFile" routine )"
		wordsOwner="$( AgentsToolsAuthorityField "$wordsFile" owner )"
		[ -n "$wordsOwner" ] || continue
		case $'\n'"$wordsMembers"$'\n' in *$'\n'"$wordsOwner"$'\n'*) ;; *) wordsMembers="$wordsMembers${wordsMembers:+$'\n'}$wordsOwner" ;; esac
	done
	wordsMembers="$( printf '%s' "$wordsMembers" | LC_ALL=C tr '\n' ',' | LC_ALL=C sed 's/,/, /g' )"
	printf '%s' "${wordsName:-$1}"
	[ -z "$wordsRoutine$wordsMembers" ] || printf ' (%s%s)' "$wordsRoutine" "${wordsMembers:+${wordsRoutine:+, }$wordsMembers}"
}

## Whether the caller is an address (AgentsToolsAuthorityCaller first): the person it names, or
## its member (M, S:M, or S where the caller founded S). rc 0 it is.
AgentsToolsAuthorityAddressHeld(){ ## address
	local heldExecutor=""
	if [ "$agentsAuthorityCallerKind" = person ] ; then
		[ "$1" = "$agentsAuthorityCallerId" ]
		return
	fi
	[ -z "$agentsAuthorityCallerRecord" ] || ! AgentsToolsSessionRunExecutor "$agentsAuthorityCallerRecord" || heldExecutor="executor"
	AgentsToolsSessionAddressNames "$1" "$agentsAuthorityCallerSession" "$agentsAuthorityCallerId" "$heldExecutor"
}

## Whether the owners role granted the caller the authority in a session, by a recorded
## permission: a grant of a refusal of this rule whose record names the caller. rc 0 it did.
AgentsToolsAuthorityGranted(){ ## session
	local grantedFile grantedKind grantedTool grantedTarget grantedBy grantedStamp grantedRefusal
	[ -n "$1" ] || return 1
	grantedFile="${MMDAPP:-/nonexistent}/.local/agents/sessions/$1/grants"
	[ -f "$grantedFile" ] || return 1
	while IFS=: read -r grantedKind grantedTool grantedTarget grantedBy grantedStamp grantedRefusal ; do
		[ "$grantedTool" = authority ] || continue
		[ "$( AgentsToolsAuthorityField "${MMDAPP:-/nonexistent}/.local/agents/sessions/$1/$grantedRefusal.md" owner )" = "$agentsAuthorityCallerId" ] || continue
		return 0
	done < "$grantedFile"
	return 1
}

## Whether the caller holds the authority of a holder over a run of a session. rc 0 it does.
AgentsToolsAuthorityHolds(){ ## holder, session of the run acted on
	AgentsToolsAuthorityAddressHeld "$1" || AgentsToolsAuthorityGranted "$2"
}

## The account at the console that is the human-owner (HUMAN_OWNER_CONSOLE_ACCOUNT, scope
## magic-team): printed, rc 0; rc 1 where the console is mapped to no owner. THE ONE READ of it.
AgentsToolsAuthorityOwnerAccount(){
	local ownerAccount=""
	ownerAccount="$( "$BASH" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh" --agents-config-option magic-team --select HUMAN_OWNER_CONSOLE_ACCOUNT 2> /dev/null )" || ownerAccount=""
	[ -n "$ownerAccount" ] || return 1
	printf '%s\n' "$ownerAccount"
}

## Whether a name is the person at the console mapped to the human-owner, `user-<account>`: that
## person IS the owner there, so a verdict only he gives is his own. rc 0 it is. One account is
## mapped, and unset maps none.
AgentsToolsAuthorityOwnerNamed(){ ## member name
	local ownerAccount=""
	case "$1" in user-*) ;; *) return 1 ;; esac
	ownerAccount="$( AgentsToolsAuthorityOwnerAccount )" || return 1
	[ "user-$ownerAccount" = "$1" ]
}

## Whether the person at the console is mapped to an owner (HUMAN_OWNER_CONSOLE_ACCOUNT). rc 0 it is.
AgentsToolsAuthorityOwnerMapped(){
	[ "$agentsAuthorityCallerKind" = person ] || return 1
	AgentsToolsAuthorityOwnerNamed "$agentsAuthorityCallerId"
}

## The authenticated accounts of the owners role (HUMAN_OWNER_MEMBERS, T8), one per line. A console account
## (user-*) is never a member of the role, so those are dropped here; the role's own single answer channel
## (SLACK_CHANNEL_HUMAN_OWNER) is added by the caller beside them, never in place of them.
AgentsToolsAuthorityOwnerMembers(){
	local membersList="" membersLine
	membersList="$( "$BASH" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh" --agents-config-option magic-team --select HUMAN_OWNER_MEMBERS 2> /dev/null )" || membersList=""
	while IFS= read -r membersLine ; do
		[ -n "$membersLine" ] || continue
		case "$membersLine" in user-*) continue ;; esac
		printf '%s\n' "$membersLine"
	done <<< "$membersList"
}

## The quorum rule of a question kind (HUMAN_OWNER_QUORUM, T8): the <kind>=<rule> pair for the kind, one of
## all, first, any-approves, any-rejects or majority. Prints the rule, or `first` where none is set for the kind.
AgentsToolsAuthorityOwnerQuorum(){ ## question kind
	local quorumText="" quorumLine quorumRule
	quorumText="$( "$BASH" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh" --agents-config-option magic-team --select HUMAN_OWNER_QUORUM 2> /dev/null )" || quorumText=""
	while IFS= read -r quorumLine ; do
		case "$quorumLine" in
			"$1="*)
				quorumRule="${quorumLine#*=}"
				case "$quorumRule" in all|first|any-approves|any-rejects|majority) printf '%s\n' "$quorumRule" ; return 0 ;; esac
			;;
		esac
	done <<< "$quorumText"
	printf 'first\n'
}

## THE OWNERS ROLE (epic T8, the predecessor's F6.11). human-owner is a role with members, each
## an authenticated account, Slack or mail. Its members are HUMAN_OWNER_MEMBERS, one a line; a
## console account is never a member, so a `user-*` word is dropped. Unset, the role is the one
## SLACK_CHANNEL_HUMAN_OWNER account, as it always was. The console mapping above only routes a
## confirmation, never membership.
AgentsToolsOwnerRoleMembers(){
	local roleSetting="" roleMember roleList=""
	roleSetting="$( "$BASH" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh" --agents-config-option magic-team --select HUMAN_OWNER_MEMBERS 2> /dev/null )" || roleSetting=""
	roleSetting="$( printf '%s' "$roleSetting" | LC_ALL=C tr -s ' \t\r\n' ' ' )"
	for roleMember in $roleSetting ; do
		case "$roleMember" in ''|user-*) continue ;; esac
		roleList="$roleList${roleList:+$'\n'}$roleMember"
	done
	if [ -n "$roleList" ] ; then
		printf '%s\n' "$roleList"
		return 0
	fi
	"$BASH" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh" --agents-config-option magic-team --select SLACK_CHANNEL_HUMAN_OWNER 2> /dev/null
}

## The quorum rule of one kind of decision the owners role answers, from HUMAN_OWNER_QUORUM
## (`<kind>=<rule>` pairs): all, first, any-approves, any-rejects or majority. `first` where
## the setting names none for the kind, which is the single-owner rule and the old behaviour.
AgentsToolsOwnerQuorumRule(){ ## kind
	local quorumSetting="" quorumPair quorumKind quorumRule
	quorumSetting="$( "$BASH" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh" --agents-config-option magic-team --select HUMAN_OWNER_QUORUM 2> /dev/null )" || quorumSetting=""
	for quorumPair in $quorumSetting ; do
		quorumKind="${quorumPair%%=*}" ; quorumRule="${quorumPair#*=}"
		[ "$quorumKind" = "$1" ] || continue
		case "$quorumRule" in all|first|any-approves|any-rejects|majority) printf '%s\n' "$quorumRule" ; return 0 ;; esac
	done
	printf 'first\n'
}

## THE QUORUM DECISION of the owners role: the answers of its members, one vote per member, decided
## by the rule of the kind. Votes are `<member>=<verdict>` lines; a verdict is approving
## (AgentsToolsAuthorityApproving, or a decision's chosen option and a question's text, which are
## the member's own non-refusal answer) or refusing (AgentsToolsAuthorityRefusing). The rules are
## the access-control combines: first (the old path, not evaluated here), any-approves (permit
## overrides), any-rejects (deny overrides), all (unanimous, a reject vetoes) and majority (more
## than half). Prints `APPROVED <verdict> <member>`, `DENIED <verdict> <member>` or `OPEN`; the
## verdict carried is the first approving or refusing member's, in member order.
AgentsToolsOwnerQuorumDecide(){ ## rule, members (one a line), votes (one a line)
	local decRule="$1" decMembers="$2" decVotes="$3" decVote decMember decVerdict decWord
	local decFirstApprove="" decFirstReject="" decApproves=0 decRejects=0 decTotal=0
	decTotal="$( printf '%s\n' "$decMembers" | LC_ALL=C grep -c . )"
	while IFS= read -r decVote ; do
		[ -n "$decVote" ] || continue
		decMember="${decVote%%=*}" ; decVerdict="${decVote#*=}"
		decWord="$( printf '%s' "$decVerdict" | LC_ALL=C tr 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' 'abcdefghijklmnopqrstuvwxyz' )"
		if AgentsToolsAuthorityApproving "$decWord" ; then
			decApproves=$(( decApproves + 1 ))
			[ -n "$decFirstApprove" ] || decFirstApprove="$decVerdict $decMember"
		elif AgentsToolsAuthorityRefusing "$decWord" ; then
			decRejects=$(( decRejects + 1 ))
			[ -n "$decFirstReject" ] || decFirstReject="$decVerdict $decMember"
		else
			decApproves=$(( decApproves + 1 ))
			[ -n "$decFirstApprove" ] || decFirstApprove="$decVerdict $decMember"
		fi
	done <<< "$decVotes"
	case "$decRule" in
		any-approves)
			[ -z "$decFirstApprove" ] || { printf 'APPROVED %s\n' "$decFirstApprove" ; return 0 ; }
			[ -z "$decFirstReject" ] || { printf 'DENIED %s\n' "$decFirstReject" ; return 0 ; }
		;;
		any-rejects)
			[ -z "$decFirstReject" ] || { printf 'DENIED %s\n' "$decFirstReject" ; return 0 ; }
			[ -z "$decFirstApprove" ] || { printf 'APPROVED %s\n' "$decFirstApprove" ; return 0 ; }
		;;
		all)
			[ -z "$decFirstReject" ] || { printf 'DENIED %s\n' "$decFirstReject" ; return 0 ; }
			[ "$decApproves" -lt "$decTotal" ] || { printf 'APPROVED %s\n' "$decFirstApprove" ; return 0 ; }
		;;
		majority)
			[ "$decRejects" -le $(( decTotal / 2 )) ] || { printf 'DENIED %s\n' "$decFirstReject" ; return 0 ; }
			[ "$decApproves" -le $(( decTotal / 2 )) ] || { printf 'APPROVED %s\n' "$decFirstApprove" ; return 0 ; }
		;;
	esac
	printf 'OPEN\n'
	return 0
}

## The role-aware read of one request: where it asks the owners role with more than one member and
## a rule that is not `first`, each member's answer is read on its own and the rule decides them.
## rc 0, nothing printed, when this is no role case -- the caller then uses the single-answer path.
AgentsToolsAuthorityQuorumCase(){ ## request record, out: agentsAuthorityQuorumMembers, _Rule
	agentsAuthorityQuorumMembers="" agentsAuthorityQuorumRule=""
	[ "$( AgentsToolsAuthorityField "$1" address-to )" = human-owner ] || return 1
	agentsAuthorityQuorumMembers="$( AgentsToolsOwnerRoleMembers )" || agentsAuthorityQuorumMembers=""
	[ "$( printf '%s\n' "$agentsAuthorityQuorumMembers" | LC_ALL=C grep -c . )" -gt 1 ] || return 1
	agentsAuthorityQuorumRule="$( AgentsToolsOwnerQuorumRule "$( AgentsToolsAuthorityField "$1" kind )" )"
	[ "$agentsAuthorityQuorumRule" != first ] || return 1
	return 0
}

## Reads the answers of the owners role's members to one request, applies the kind's quorum rule,
## and settles the request where it is met. Prints one line for what it did; rc 2 where this is no
## role case, so the caller falls through to the single-answer path; rc 0 where it read and acted
## (settled it, or found it still open).
AgentsToolsAuthorityQuorumRead(){ ## request record
	local qFile="$1" qMember qOut qVerdict qVotes="" qDecide qWin qWinVerdict qWinAuthor
	AgentsToolsAuthorityQuorumCase "$qFile" || return 2
	type AgentsToolsEscalationThreadVerdict > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.MemberEscalation.include" --definitions-only 2> /dev/null || return 2
	for qMember in $agentsAuthorityQuorumMembers ; do
		qOut="$( AgentsToolsEscalationThreadVerdict "$( AgentsToolsAuthorityField "$qFile" owner )" "$qFile" "$( basename "$qFile" .md )" \
			"$( AgentsToolsAuthorityField "$qFile" channel )" "$( AgentsToolsAuthorityField "$qFile" question-ts )" "$( AgentsToolsAuthorityField "$qFile" thread-ts )" \
			"$qMember" true 2> /dev/null )" || qOut=""
		qVerdict="$( printf '%s\n' "$qOut" | head -1 )"
		case "${qVerdict%%$'\t'*}" in ''|OPEN|RETURNED|UNREADABLE) continue ;; esac
		qVerdict="${qVerdict%%$'\t'*}"
		case $'\n'"$qVotes"$'\n' in *$'\n'"$qMember="*) continue ;; esac
		qVotes="$qVotes$qMember=$qVerdict"$'\n'
	done
	qDecide="$( AgentsToolsOwnerQuorumDecide "$agentsAuthorityQuorumRule" "$agentsAuthorityQuorumMembers" "$qVotes" )" || qDecide=""
	qWin="${qDecide#* }"
	case "${qDecide%% *}" in
		APPROVED|DENIED)
			qWinVerdict="${qWin% *}" ; qWinAuthor="${qWin##* }"
			AgentsToolsAuthorityRequestSettle "$qFile" "$qWinVerdict" "${qWinAuthor:-the owners role}"
		;;
		*)
			## Not met yet: the request stays open, said as nothing, as the single-answer path's
			## OPEN is -- the waiter's own progress line says how long it has waited.
			return 0
		;;
	esac
}

## Where the caller's request goes: from the console, to the holder; from a member's run, to where
## that run reports; from a coordinator, never to a magic-coordinator, but to its parent session,
## else to the person who started it, else to the owners role.
AgentsToolsAuthorityTarget(){ ## holder
	local targetTo="" targetParent targetFounder targetMember
	[ "$agentsAuthorityCallerKind" = member ] || { printf '%s\n' "$1" ; return 0 ; }
	if [ "$agentsAuthorityCallerId" = magic-coordinator ] ; then
		targetParent="$( AgentsToolsAuthorityField "$agentsAuthorityCallerRecord" parent-session-id )"
		if [ -n "$targetParent" ] ; then
			targetMember=""
			targetFounder="$( AgentsToolsAuthorityFounder "$targetParent" )" && targetMember="$( AgentsToolsAuthorityField "$targetFounder" owner )"
			[ "$targetMember" = magic-coordinator ] || { printf '%s%s\n' "$targetParent" "${targetMember:+:$targetMember}" ; return 0 ; }
		fi
		targetTo="$( AgentsToolsAuthorityField "$agentsAuthorityCallerRecord" "$agentsRunRouteField" )"
		case "$targetTo" in user-?*) printf '%s\n' "$targetTo" ; return 0 ;; esac
		printf 'human-owner\n'
		return 0
	fi
	[ -n "$agentsAuthorityCallerRecord" ] && targetTo="$( AgentsToolsRunRoute "$agentsAuthorityCallerRecord" )" || targetTo=""
	case "$targetTo" in ''|none) targetTo="$1" ;; esac
	printf '%s\n' "$targetTo"
}

## The escalation words of an operation taken out of its arguments: agentsAuthorityMode
## (empty, enqueue or wait), agentsAuthorityTimeout, and the rest kept in agentsAuthorityRest.
## rc 1, said on stderr, for a timeout that is no whole number or goes with no wait.
AgentsToolsAuthorityFlags(){ ## arguments...
	agentsAuthorityMode="" agentsAuthorityTimeout="" agentsAuthorityStop="" agentsAuthorityRest=()
	while [ $# -gt 0 ] ; do
		case "$1" in
			--escalate-enqueue) agentsAuthorityMode="enqueue" ; shift ;;
			--escalate-wait) agentsAuthorityMode="wait" ; shift ;;
			--escalate-stop) agentsAuthorityStop="yes" ; shift ;;
			--timeout)
				case "${2:-}" in
					''|*[!0123456789]*) echo "⛔ ERROR: ${MDSC_CMD:-DistroAgentsTools}: --timeout needs a whole number of seconds, got: ${2:-}" >&2 ; return 1 ;;
				esac
				agentsAuthorityTimeout="$2" ; shift 2
			;;
			*) agentsAuthorityRest[${#agentsAuthorityRest[@]}]="$1" ; shift ;;
		esac
	done
	[ -z "$agentsAuthorityTimeout" ] || [ "$agentsAuthorityMode" = wait ] || { echo "⛔ ERROR: ${MDSC_CMD:-DistroAgentsTools}: --timeout goes with --escalate-wait" >&2 ; return 1 ; }
	[ -z "$agentsAuthorityStop" ] || [ "$agentsAuthorityMode" = wait ] || { echo "⛔ ERROR: ${MDSC_CMD:-DistroAgentsTools}: --escalate-stop goes with --escalate-wait" >&2 ; return 1 ; }
	return 0
}

## The words an approving answer of a request is, beside a choice of a decision's own.
AgentsToolsAuthorityApproving(){ ## verdict
	case "$1" in allow|allow-once|allow-session|allow-task|allow-contact|yes|correct) return 0 ;; esac
	return 1
}

## A REFUSAL IS NEVER GATED (F6.10, Settled): a refusal grants nothing, so a console person may deny any permission, permission-set or authority request, and dismiss
## any question, whoever it was asked of, the human-owner included. Only approving needs the authority. A review, a held change and a proposal stay the human-owner's own
## verdict (AgentsToolsManagerPendingOutcome says it is not taken), and an answer that is not a refusal is gated as it was. The one place that says which word refuses:
AgentsToolsAuthorityRefusing(){ ## verdict
	case "$1" in deny|reject|no) return 0 ;; esac
	return 1
}

## Whether the action now running was approved by its request (MDAT_AUTHORITY_REQUEST): the
## request of this very original, answered with an approval and not yet acted on. Taken here,
## marked as acted on, so it lets one action run. rc 0 approved.
AgentsToolsAuthorityApproved(){ ## original (pending id or spawn id)
	local approvedFile
	[ -n "${MDAT_AUTHORITY_REQUEST:-}" ] || return 1
	type AgentsToolsAssertBareName > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/member/AgentsTools.BareName.include"
	AgentsToolsAssertBareName "$MDAT_AUTHORITY_REQUEST" "the request" authority 2> /dev/null || return 1
	approvedFile="$( AgentsToolsQuestionsStore )/$MDAT_AUTHORITY_REQUEST.md"
	[ -f "$approvedFile" ] || return 1
	[ "$( AgentsToolsAuthorityField "$approvedFile" request-of )" = "$1" ] || return 1
	[ "$( AgentsToolsAuthorityField "$approvedFile" status )" = reply-received ] || return 1
	[ -z "$( AgentsToolsAuthorityField "$approvedFile" acted-at )" ] || return 1
	AgentsToolsAuthorityApproving "$( AgentsToolsAuthorityField "$approvedFile" verdict )" || [ -n "$( AgentsToolsAuthorityField "$approvedFile" chosen )" ] || return 1
	AgentsToolsAuthorityFieldSet "$approvedFile" acted-at "$( date +"%Y-%m-%d %H:%M %z" )"
}

## The choice the request that lets this action run carries, where its holder chose one: printed.
AgentsToolsAuthorityChosen(){
	[ -z "${agentsAuthorityChosenNow:-}" ] || { printf '%s\n' "$agentsAuthorityChosenNow" ; return 0 ; }
	[ -n "${MDAT_AUTHORITY_REQUEST:-}" ] || return 0
	AgentsToolsAuthorityField "$( AgentsToolsQuestionsStore )/$MDAT_AUTHORITY_REQUEST.md" chosen
}

## The refusal of a bare call, said where the caller reads it (agentsAuthorityStream `out`, a
## served tool's result; else stderr), and logged as a refusal of this rule, which the owners role
## can grant. rc 3.
AgentsToolsAuthorityRefuse(){ ## what is asked (words), holder, session of the run acted on, how the options are named (console|tool)
	local refuseOut="" refuseId=""
	refuseOut="$( "$BASH" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh" --intern-op-permission-refusal-log "$agentsAuthorityCallerId" \
		--session-id "${3:-none}" --tool authority --target "$2" --reason "$1" 2> /dev/null )" || refuseOut=""
	refuseId="$( printf '%s\n' "$refuseOut" | LC_ALL=C grep -o -E 'refusal-[0-9a-f-]+' | head -1 )"
	{
		printf '🙋 WARNING: %s: %s needs the authority of %s, which %s does not hold, so nothing was done.\n' "${MDSC_CMD:-DistroAgentsTools}" "$1" "$2" "$agentsAuthorityCallerId"
		if [ "${4:-console}" = tool ] ; then
			printf '  to ask %s and wait for the answer: the same call with escalate: "wait" (the console calls it --escalate-wait [--timeout <seconds>])\n' "$2"
			printf '  to ask %s and return at once: the same call with escalate: "enqueue" (the console calls it --escalate-enqueue)\n' "$2"
		else
			printf '  to ask %s and wait for the answer: the same call with --escalate-wait [--timeout <seconds>]\n' "$2"
			printf '  to ask %s and return at once: the same call with --escalate-enqueue\n' "$2"
		fi
		[ -z "$refuseId" ] || printf '  refusal %s: with it the owners role can grant %s this authority in session %s\n' "$refuseId" "$agentsAuthorityCallerId" "${3:-none}"
	} | if [ "${agentsAuthorityStream:-err}" = out ] ; then cat ; else cat >&2 ; fi
	return 3
}

## A request for the authority: posted to whom it asks and kept as a pending question in the
## questions store, the action it lets run beside it. A session with no thread of its own is no
## reason to refuse it: the request is asked of the owners role, which is reached without one.
## Prints `PENDING <id> <to>`; rc 0; rc 1 where it could not be made (said on stderr).
AgentsToolsAuthorityRequestOpen(){ ## mode (enqueue|wait), confirmation (yes|empty), to, session of the run acted on, original, what (words), original question record (or empty), action words...
	local openMode="$1" openConfirm="$2" openTo="$3" openSession="$4" openOriginal="$5" openWhat="$6" openQuestion="$7"
	shift 7
	local openKind="permission" openOptions="" openSender="magic-coordinator" openTarget="" openAddress="" openThread="" openFounder=""
	local openThreadSession="" openUnthreaded="" openUnasked=""
	local openOut openChannel openTs openThreadTs openAddressees openAsking openId openLine openText="" openRefusal openForm openReason openTaskText openOperation openSlotText="" openSlotChoices="" openFields="" openNames="" openMember
	## A choice among answers goes as a choice: its options, beside an allow and a deny of the one proposed.
	if [ -n "$openQuestion" ] && [ "$( AgentsToolsAuthorityField "$openQuestion" kind )" = decision ] && [ -s "${openQuestion%.md}.options" ] ; then
		openKind="decision"
		openOptions="$( cat "${openQuestion%.md}.options" ; printf -- '- allow-once: let %s do it as proposed\n- deny: refuse it\n' "$agentsAuthorityCallerId" )"
	fi
	## A text to provide goes as a question: the reply is the text, unless it allows or denies the one proposed.
	if [ -n "$openQuestion" ] && [ "$openKind" = permission ] && [ -z "$( AgentsToolsAuthorityField "$openQuestion" select )" ] ; then
		case "$( AgentsToolsAuthorityField "$openQuestion" kind )" in ''|question) openKind="question" ;; esac
	fi
	[ -z "$openConfirm" ] || { openKind="readback" ; openOptions="" ; }
	[ "$agentsAuthorityCallerKind" != member ] || openSender="$agentsAuthorityCallerId"
	## Where it is asked, as the ask tools ask (AgentsHarnessAsk): a person, and a confirmation, in
	## the owner's own conversation; a member, in the thread of the session it is in, a reply there
	## addressed to it; a session, in its own thread, addressed to its founding run's member.
	if [ -n "$openConfirm" ] ; then
		openTarget="human-owner" ; openAddress="human-owner"
	else
		case "$( AgentsToolsRunRouteKind "$openTo" )" in
			person|none) openTarget="human-owner" ; openAddress="human-owner" ;;
			member)
				openAddress="$openTo"
				openThreadSession="$openSession"
				openThread="$( LC_ALL=C sed -n '1p' "${MMDAPP:-/nonexistent}/.local/agents/sessions/$openSession/session.thread" 2> /dev/null )"
			;;
			session)
				case "$openTo" in
					*:*) openAddress="${openTo#*:}" ;;
					*) openFounder="$( AgentsToolsAuthorityFounder "$openTo" )" && openAddress="$( AgentsToolsAuthorityField "$openFounder" owner )" ;;
				esac
				openThreadSession="${openTo%%:*}"
				openThread="$( LC_ALL=C sed -n '1p' "${MMDAPP:-/nonexistent}/.local/agents/sessions/${openTo%%:*}/session.thread" 2> /dev/null )"
			;;
		esac
		## Asked as the ask tools ask a member: a reply in the session's thread, addressed to it.
		[ -n "$openTarget" ] || openTarget="$openThread"
		## A SESSION WITH NO THREAD OF ITS OWN IS STILL ASKED. A session that never had a thread,
		## or whose thread was not kept, has nowhere of its own to be asked in; refusing here is
		## what left a kill of such a session undone. The request goes to the owners role instead,
		## which tops every chain and is reached without a session thread, and once it is recorded
		## one warning says the session it could not be asked in and the request it was recorded
		## as, so whoever asked knows where its answer stands.
		if [ -z "$openTarget" ] ; then
			openUnthreaded="$openThreadSession" ; [ -n "$openUnthreaded" ] || openUnthreaded="$openSession"
			openUnasked="$openTo"
			openTo="human-owner" ; openTarget="human-owner" ; openAddress="human-owner"
		fi
	fi
	## Its text, in the form of a permission request (request-permission.post.format.md, with its `# Authority` words): the refused call said
	## plainly, why it is asked, how to answer, and the refusal this request logs by its id, which an `allow-session` is granted from.
	type AgentsToolsAskPostFill > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.AskPost.include"
	openRefusal="$( "$BASH" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh" --intern-op-permission-refusal-log "$agentsAuthorityCallerId" \
		--session-id "${openSession:-none}" --tool authority --target "$openTo" --reason "$openWhat" 2> /dev/null | LC_ALL=C grep -o -E 'refusal-[0-9a-f-]+' | head -1 )"
	if [ -z "$openRefusal" ] ; then
		echo "⛔ ERROR: ${MDSC_CMD:-DistroAgentsTools}: the request could not be posted: its refusal could not be logged, so nothing was asked" >&2
		return 1
	fi
	openOperation="${1:-}" ; [ "${openOperation:0:1}" != "@" ] || openOperation="${2:-a tool}"
	openForm="grant" ; [ -z "$openConfirm" ] || openForm="confirm"
	[ "$openKind" != question ] || openSlotText="yes"
	[ "$openKind" != decision ] || openSlotChoices="$openOptions"
	openReason="$( ASKP_BLOCK="Authority/reason" ASKP_F_requester="$agentsAuthorityCallerId" ASKP_F_holder="$openTo" AgentsToolsAskPostFill block request-permission.post.format.md "" 2> /dev/null )" || openReason=""
	openTaskText="$( ASKP_BLOCK="Authority/task" ASKP_F_requester="$agentsAuthorityCallerId" ASKP_F_operation="$openOperation" AgentsToolsAskPostFill block request-permission.post.format.md "" 2> /dev/null )" || openTaskText=""
	openText="$( export ASKP_F_refused_tool="$openWhat" ASKP_F_refused_for="$agentsAuthorityCallerId" ASKP_F_refusal_id="$openRefusal" ASKP_F_reason="$openReason" ASKP_F_task="$openTaskText" \
		ASKP_F_text="$openSlotText" ASKP_F_choices="$openSlotChoices" ; AgentsToolsAskPostFill post request-permission.post.format.md "$openForm" 2> /dev/null )" || openText=""
	if [ -z "$openText" ] ; then
		echo "⛔ ERROR: ${MDSC_CMD:-DistroAgentsTools}: the request could not be posted: its text could not be filled from sh-lib/templates/request-permission.post.format.md, so nothing was asked" >&2
		return 1
	fi
	[ -z "$openOptions" ] || [ "$openKind" != decision ] || openText="$openText"$'\n'"$openOptions"
	## The slots the post was filled with, kept beside a permission request's record: a later fill starts from them.
	[ "$openKind" != permission ] || openFields="$( AgentsToolsAskPostFieldsPack asked-as RequestPermission refused-tool "$openWhat" refused-for "$agentsAuthorityCallerId" refusal-id "$openRefusal" reason "$openReason" task "$openTaskText" )"
	openOut="$( printf '%s\n' "$openText" | "$BASH" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh" --intern-op-comms-slack-send-message "$openSender" "$openTarget" --identity-bot ${openAddress:+--address-to "$openAddress"} --from-stdin 2>&1 )" || {
		echo "⛔ ERROR: ${MDSC_CMD:-DistroAgentsTools}: the request to $openTo could not be posted, so nothing was asked: $( printf '%s\n' "$openOut" | LC_ALL=C grep -m1 'ERROR' )" >&2
		return 1
	}
	openChannel="$( printf '%s\n' "$openOut" | LC_ALL=C sed -n 's/^SENT_MESSAGE_CHANNEL=//p' | head -1 )"
	openTs="$( printf '%s\n' "$openOut" | LC_ALL=C sed -n 's/^SENT_MESSAGE_TS=//p' | head -1 )"
	openThreadTs="$( printf '%s\n' "$openOut" | LC_ALL=C sed -n 's/^SENT_MESSAGE_THREAD_TS=//p' | head -1 )"
	openAddressees="$( printf '%s\n' "$openOut" | LC_ALL=C sed -n 's/^SENT_MESSAGE_ADDRESSEES=//p' | head -1 ) $( printf '%s\n' "$openOut" | LC_ALL=C sed -n 's/^SENT_MESSAGE_ADDRESSEE_MEMBERS=//p' | head -1 )"
	## The owners role tops every chain: its members' accounts answer any request (epic T8). Where
	## the role is the one SLACK_CHANNEL_HUMAN_OWNER account, this is that account alone, as before.
	openAddressees="$openAddressees $( AgentsToolsOwnerRoleMembers 2> /dev/null | LC_ALL=C tr '\n' ' ' )"
	openAddressees="$( printf '%s' "$openAddressees" | LC_ALL=C tr -s ' ' ' ' | LC_ALL=C sed -e 's/^ //' -e 's/ $//' )"
	openAsking="$( printf '%s\n' "$openOut" | LC_ALL=C grep '^{' | LC_ALL=C awk -v path=message.user -v optional=1 -v dialect=slack -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsHarnessJsonField.awk" 2> /dev/null | head -1 )"
	[ -n "$openAsking" ] || openAsking="the-team-bot"
	openId="$( printf '%s\n' "$openText" | "$BASH" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh" --intern-op-pending-reply-open "$openSender" --store questions --to "$openChannel" \
		--session-id "$openSession" --kind "$openKind" --address-to "$openTo" --channel "$openChannel" --question-ts "$openTs" --thread-ts "${openThreadTs:-$openTs}" \
		--addressees "$openAddressees" --asking-accounts "$openAsking" --ask-identity bot ${openOptions:+--options "$openOptions"} \
		--request-of "$openOriginal" --requester "$agentsAuthorityCallerId" --requester-run "$agentsAuthorityCallerRun" --request-mode "$openMode" --request-what "$openWhat" ${openFields:+--fields "$openFields"} 2> /dev/null )" || openId=""
	if [ -z "$openId" ] ; then
		echo "⛔ ERROR: ${MDSC_CMD:-DistroAgentsTools}: the request to $openTo was posted but could not be kept, so its answer would act on nothing" >&2
		return 1
	fi
	AgentsToolsAuthorityFieldSet "$( AgentsToolsQuestionsStore )/$openId.md" refusal-id "$openRefusal" || :
	[ -z "$openUnthreaded" ] || printf '⚠️ WARNING: %s: no thread of its session is known (session %s), so the request to %s is asked of the owners role instead -- it is recorded as %s in the questions store, and answered in the owners-role conversation\n' \
		"${MDSC_CMD:-DistroAgentsTools}" "${openUnthreaded:-none}" "${openUnasked:-$openTo}" "$openId" >&2
	## The answer emoji go under the post, as the identity that posted it: the form's own, but for a request that asks for a text or a choice.
	if [ -z "$openSlotText$openSlotChoices" ] && [ -n "$openChannel" ] && [ -n "$openTs" ] ; then
		openNames="$( ASKP_F_text="" ASKP_F_choices="" AgentsToolsAskPostFill reactions request-permission.post.format.md "$openForm" 2> /dev/null )" || openNames=""
		[ -z "$openNames" ] || AgentsToolsAskPostReact "$openSender" "$openChannel:$openTs" bot add $openNames
	fi
	## The action it lets run, one word a line.
	for openLine in "$@" ; do printf '%s\n' "$openLine" ; done > "$( AgentsToolsQuestionsStore )/$openId.action" || {
		echo "⛔ ERROR: ${MDSC_CMD:-DistroAgentsTools}: the action of request $openId could not be kept, so its answer would act on nothing" >&2
		return 1
	}
	printf 'PENDING %s %s\n' "$openId" "$openTo"
}

## What becomes of a request's answer, set on its record: approved, with a decision's choice
## where one was chosen, or the text given to a text request (kind question), or denied. One that is not waited for is acted on here
## (AgentsToolsAuthorityRequestAct); a waited one by its waiter. Prints one line; rc 1 where the
## verdict is no answer of it.
AgentsToolsAuthorityRequestSettle(){ ## request record, verdict, answered by
	local settleFile="$1" settleVerdict settleBy="$3" settleChosen="" settleOption settleGrantOut=""
	settleVerdict="$( printf '%s' "$2" | LC_ALL=C tr 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' 'abcdefghijklmnopqrstuvwxyz' )"
	if ! AgentsToolsAuthorityApproving "$settleVerdict" ; then
		case "$settleVerdict" in
			deny|no) ;;
			*)
				## A text to provide: the answer, as it was written, is the text to give.
				if [ "$( AgentsToolsAuthorityField "$settleFile" kind )" = question ] && [ -n "$2" ] ; then
					settleChosen="$2" ; settleVerdict="text"
				else
					[ "$( AgentsToolsAuthorityField "$settleFile" kind )" = decision ] && [ -f "${settleFile%.md}.options" ] || { printf 'NOT-AN-ANSWER %s\n' "$settleVerdict" ; return 1 ; }
					while IFS= read -r settleOption ; do
						settleOption="${settleOption#- }" ; settleOption="${settleOption%%[ $'\t']*}" ; settleOption="${settleOption%:}"
						[ "$( printf '%s' "$settleOption" | LC_ALL=C tr 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' 'abcdefghijklmnopqrstuvwxyz' )" != "$settleVerdict" ] || settleChosen="$settleVerdict"
					done < "${settleFile%.md}.options"
					[ -n "$settleChosen" ] || { printf 'NOT-AN-ANSWER %s\n' "$settleVerdict" ; return 1 ; }
				fi
			;;
		esac
	fi
	## An allow for the session gives the requester the authority over the session while it lives: the `session` grant of the refusal this request logged,
	## signed by the answerer the answer reader names. Where it names nobody, or the grant cannot be written, nothing is granted and the request stays open.
	if [ "$settleVerdict" = "allow-session" ] ; then
		settleGrantOut="$( AgentsToolsAuthorityGrantSession "$settleFile" "$settleBy" 2>&1 )" || {
			printf 'NOT-GRANTED %s: %s -- nothing is granted, and the request stays open\n' "$( basename "$settleFile" .md )" "$( printf '%s\n' "$settleGrantOut" | LC_ALL=C sed -n '1s/^# [^:]*: //p' )"
			return 1
		}
	fi
	AgentsToolsAuthorityFieldSet "$settleFile" status reply-received verdict "$settleVerdict" answered-by "$settleBy" answered-at "$( date +"%Y-%m-%d %H:%M %z" )" ${settleChosen:+chosen "$settleChosen"} || return 1
	if ! AgentsToolsAuthorityApproving "$settleVerdict" && [ -z "$settleChosen" ] ; then
		printf 'DENIED %s\n' "$( basename "$settleFile" .md )"
		return 0
	fi
	[ "$( AgentsToolsAuthorityField "$settleFile" request-mode )" != wait ] || { printf 'APPROVED %s: its waiter acts\n' "$( basename "$settleFile" .md )" ; return 0 ; }
	AgentsToolsAuthorityRequestAct "$settleFile"
}

## The authority over a session given for as long as it lives (an `allow-session` of a request): the grant of the refusal the request logged, signed by
## whoever answered, as the answer reader names them. Never signed for anyone else: where it names nobody, none is written. The capacity it is bounded by
## is the owners role's, since the chain's authority was the answerer's to give (the gate asked). Prints GRANT, or says why none was written.
AgentsToolsAuthorityGrantSession(){ ## request record, answered by
	local grantFile="$1" grantBy="$2" grantSession grantRefusal grantOut
	grantSession="$( AgentsToolsAuthorityField "$grantFile" session-id )"
	grantRefusal="$( AgentsToolsAuthorityField "$grantFile" refusal-id )"
	[ -n "$grantSession" ] && [ "$grantSession" != none ] && [ -n "$grantRefusal" ] || { echo "# $( basename "$grantFile" .md ): no session grant was written: the request names no session or no refusal" >&2 ; return 1 ; }
	case "$grantBy" in ''|*[!A-Za-z0-9_.-]*) echo "# $( basename "$grantFile" .md ): the answer names nobody to sign the grant" >&2 ; return 1 ;; esac
	grantOut="$( "$BASH" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh" --intern-op-permission-grant-open "$grantBy" --session-id "$grantSession" --refusal-id "$grantRefusal" --kind session --holds-as human-owner 2>&1 )" || {
		echo "# $( basename "$grantFile" .md ): no session grant was written: $( printf '%s\n' "$grantOut" | LC_ALL=C grep -m1 'ERROR' )" >&2
		return 1
	}
	printf '%s\n' "$grantOut" | LC_ALL=C grep -m1 '^GRANT: '
}

## The action an approved request lets run, run once, as the one who asked for it. Prints one line.
AgentsToolsAuthorityRequestAct(){ ## request record
	local actFile="$1" actId actRun actBy actWords=() actWord actRc=0
	actId="$( basename "$actFile" .md )"
	[ -f "${actFile%.md}.action" ] || { printf 'NOT-ACTED %s: no action is kept beside it\n' "$actId" ; return 1 ; }
	while IFS= read -r actWord ; do actWords[${#actWords[@]}]="$actWord" ; done < "${actFile%.md}.action"
	actRun="$( AgentsToolsAuthorityField "$actFile" requester-run )"
	actBy="$( AgentsToolsAuthorityField "$actFile" requester )"
	if [ "${actWords[0]:-}" = "@harness" ] ; then
		printf '%s' "${actWords[2]:-}" | env -u CLAUDE_CODE_SESSION_ID MDAT_SPAWN_SESSION_ID="$actRun" MDAT_SPAWN_AGENT="$actBy" MDAT_AUTHORITY_REQUEST="$actId" \
			"$BASH" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsUniversalHarness.sh" --intern-tool "${actWords[1]:-}" > /dev/null 2>&1 || actRc=$?
	elif [ -n "$actRun" ] ; then
		env -u CLAUDE_CODE_SESSION_ID MDAT_SPAWN_SESSION_ID="$actRun" MDAT_SPAWN_AGENT="$actBy" MDAT_AUTHORITY_REQUEST="$actId" \
			"$BASH" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh" "${actWords[@]}" > /dev/null 2>&1 < /dev/null || actRc=$?
	else
		env -u CLAUDE_CODE_SESSION_ID -u MDAT_SPAWN_SESSION_ID -u MDAT_SPAWN_AGENT -u MDAT_SESSION_ID MDAT_AUTHORITY_REQUEST="$actId" \
			"$BASH" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh" "${actWords[@]}" > /dev/null 2>&1 < /dev/null || actRc=$?
	fi
	AgentsToolsAuthorityFieldSet "$actFile" act-result "$actRc" || :
	printf 'ACTED %s: %s, exit %s\n' "$actId" "${actWords[*]}" "$actRc"
	[ "$actRc" = 0 ]
}

## The waiter of a request: its answer awaited on its record, read once a second, with no bound
## unless one is given. rc 0 approved, 1 denied, 124 at the bound, where the request is withdrawn
## and its record kept, so nothing acts on it later. With --escalate-stop it answers to signals
## (agentsAuthorityStop): TERM, INT and HUP withdraw the request as the bound does, rc 130; USR1
## leaves it pending for the sweep, rc 125. An answer that stands on the record wins over a signal.
AgentsToolsAuthorityRequestWait(){ ## request id, bound in seconds (empty: none)
	local waitRc=0
	agentsAuthorityStopSaid=""
	## An interrupted or killed wait discards its request whatever else: TERM, INT and HUP
	## always withdraw it, so a wait ended without --escalate-stop cannot leave an open
	## request for a later sweep to act on. USR1, the --escalate-stop feature, leaves it
	## pending for the sweep instead.
	trap 'agentsAuthorityStopSaid=withdraw' TERM INT HUP
	[ -z "${agentsAuthorityStop:-}" ] || trap 'agentsAuthorityStopSaid=enqueue' USR1
	AgentsToolsAuthorityRequestWaitLoop "$@" || waitRc=$?
	trap - TERM INT HUP
	[ -z "${agentsAuthorityStop:-}" ] || trap - USR1
	return "$waitRc"
}
## The Slack post of a request the tooling itself discarded (a wait interrupted or killed):
## marked cancelled and edited away its How-to-answer part, as the asker's own withdraw does.
## Best effort, and after the record is already closed, so a failed post never undoes the close.
AgentsToolsAuthorityRequestDiscardPost(){ ## request record
	local discFile="$1" discChannel discTs
	discChannel="$( AgentsToolsAuthorityField "$discFile" channel )"
	discTs="$( AgentsToolsAuthorityField "$discFile" question-ts )"
	[ -n "$discChannel" ] && [ -n "$discTs" ] || return 0
	type AgentsToolsAskPostClose > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.AskPost.include" 2> /dev/null || return 0
	AgentsToolsAskPostClose "$discFile" "$discTs" cancelled edit
}

AgentsToolsAuthorityRequestWaitLoop(){ ## request id, bound in seconds (empty: none)
	local waitFile waitBegan waitReadAt=0 waitNow waitChecks=0 waitErrors=0 waitProgressAt waitProgressEvery="${MDAT_AUTHORITY_WAIT_PROGRESS_SECONDS:-300}"
	case "$waitProgressEvery" in ''|*[!0-9]*) waitProgressEvery=300 ;; esac
	waitFile="$( AgentsToolsQuestionsStore )/$1.md"
	waitBegan="$( date +%s )" ; waitProgressAt="$waitBegan"
	while : ; do
		case "$( AgentsToolsAuthorityField "$waitFile" status )" in
			reply-received)
				AgentsToolsAuthorityApproving "$( AgentsToolsAuthorityField "$waitFile" verdict )" || [ -n "$( AgentsToolsAuthorityField "$waitFile" chosen )" ] || return 1
				return 0
			;;
			withdrawn) return 1 ;;
		esac
		case "${agentsAuthorityStopSaid:-}" in
			withdraw)
				AgentsToolsAuthorityFieldSet "$waitFile" status withdrawn withdrawn-by "tooling (the wait was cancelled)" withdrawn-at "$( date +"%Y-%m-%d %H:%M %z" )" || :
				AgentsToolsAuthorityRequestDiscardPost "$waitFile" || :
				return 130
			;;
			enqueue)
				AgentsToolsAuthorityFieldSet "$waitFile" request-mode enqueue || :
				return 125
			;;
		esac
		if [ -n "$2" ] && [ $(( $( date +%s ) - waitBegan )) -ge "$2" ] ; then
			AgentsToolsAuthorityFieldSet "$waitFile" status withdrawn withdrawn-by "tooling (no answer within ${2}s)" withdrawn-at "$( date +"%Y-%m-%d %H:%M %z" )" || :
			return 124
		fi
		## THE WAITER READS ITS OWN REQUEST, as a member's Wait reads its ask, and at Wait's pace (its TTL for a post: AgentsToolsAuthorityWaitTtl): the reply or the click of
		## whoever may answer is looked for in the request's thread with the sweep's own reader and settle (AgentsToolsAuthorityRequestRead), so a request is answered with
		## no main loop or daemon running.
		waitNow="$( date +%s )"
		if [ $(( waitNow - waitReadAt )) -ge "$( AgentsToolsAuthorityWaitTtl "$waitFile" "$waitBegan" )" ] ; then
			waitReadAt="$waitNow"
			agentsAuthorityReadOutcome=""
			AgentsToolsAuthorityRequestRead "$waitFile" >&2 || :
			waitChecks=$(( waitChecks + 1 ))
			[ "${agentsAuthorityReadOutcome:-}" != unreadable ] || waitErrors=$(( waitErrors + 1 ))
			continue
		fi
		## It says now and then that it is alive: how long it has waited, and how many looks it has made, how many of them failed.
		if [ "$waitProgressEvery" -gt 0 ] && [ $(( waitNow - waitProgressAt )) -ge "$waitProgressEvery" ] ; then
			waitProgressAt="$waitNow"
			printf 'waiting %s, %d checks, %d errors (request %s)\n' "$( AgentsToolsAuthoritySpan $(( waitNow - waitBegan )) )" "$waitChecks" "$waitErrors" "$1" >&2
		fi
		sleep 1
	done
}

## The pace of the waiter, Wait's own TTL for a post: 5 seconds and 1 more for every 20 it has been quiet, from the newest thing seen of it (its ask, or the last
## reply that was told what to reply, or the start of this wait where that is later), with no cap, so a request nobody answers is looked at ever more rarely and never
## dropped.
AgentsToolsAuthorityWaitTtl(){ ## request record, the time this wait began
	local ttlNow ttlActivity ttlQuiet ttlOther
	ttlNow="$( date +%s )" ; ttlActivity="$( AgentsToolsAuthorityField "$1" question-ts )" ; ttlActivity="${ttlActivity%%.*}"
	case "$ttlActivity" in ''|*[!0-9]*) ;; *) [ "$ttlActivity" -ge "${2:-0}" ] || ttlActivity="${2:-0}" ;; esac
	for ttlOther in "$( AgentsToolsAuthorityField "$1" told-unclear )" "$( AgentsToolsAuthorityField "$1" told-unthreaded )" ; do
		ttlOther="${ttlOther%%.*}"
		case "$ttlOther" in ''|*[!0-9]*) continue ;; esac
		[ -n "$ttlActivity" ] && [ "$ttlOther" -le "$ttlActivity" ] || ttlActivity="$ttlOther"
	done
	case "$ttlActivity" in ''|*[!0-9]*) ttlActivity="$ttlNow" ;; esac
	ttlQuiet=$(( ttlNow - ttlActivity )) ; [ "$ttlQuiet" -ge 0 ] || ttlQuiet=0
	printf '%d\n' $(( ${MDAT_AUTHORITY_WAIT_READ_SECONDS:-5} + ttlQuiet / 20 ))
}

## A span of seconds in words: 40s, 12m, 5h, 5h 35m.
AgentsToolsAuthoritySpan(){ ## seconds
	if [ "$1" -lt 60 ] ; then printf '%ds\n' "$1"
	elif [ "$1" -lt 3600 ] ; then printf '%dm\n' $(( $1 / 60 ))
	elif [ $(( $1 % 3600 / 60 )) -eq 0 ] ; then printf '%dh\n' $(( $1 / 3600 ))
	else printf '%dh %dm\n' $(( $1 / 3600 )) $(( $1 % 3600 / 60 ))
	fi
}

## THE GATE, asked by every operation that acts on another run's question or on a run: whether
## the caller may act, set in agentsAuthorityOutcome -- `act` (it holds the authority, or its
## request is approved), `pending` (a request is made, and PENDING said), `refused` (said),
## `denied` or `timeout`. The escalation words are agentsAuthorityMode and agentsAuthorityTimeout
## (AgentsToolsAuthorityFlags); AgentsToolsAuthorityExit says what the operation returns.
AgentsToolsAuthorityGate(){ ## what (words), original (pending id or spawn id), run record acted on (or empty), original question record (or empty), how options are named (console|tool), action words...
	local gateWhat="$1" gateOriginal="$2" gateRecord="$3" gateQuestion="$4" gateNamed="$5" gateHolder gateSession="" gateTo gateOpened gateId gateRc=0 gateConfirm="" gateExisting gateAge
	shift 5
	agentsAuthorityOutcome="act" agentsAuthorityChosenNow=""
	## A refusal the caller says it is (agentsAuthorityRefusing, taken once) grants nothing: it is not gated.
	if [ -n "${agentsAuthorityRefusing:-}" ] ; then agentsAuthorityRefusing="" ; return 0 ; fi
	type AgentsToolsRunRoute > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SpawnSandbox.include"
	! AgentsToolsAuthorityApproved "$gateOriginal" || return 0
	AgentsToolsAuthorityCaller
	gateHolder="$( AgentsToolsRunRoute "$gateRecord" )"
	## The session of the run acted on: its record's; a run with no record here is a session of its own.
	[ -z "$gateRecord" ] || gateSession="$( AgentsToolsAuthorityField "$gateRecord" session-id )"
	[ -n "$gateSession" ] || [ -n "$gateQuestion" ] || gateSession="$gateOriginal"
	! AgentsToolsAuthorityHolds "$gateHolder" "$gateSession" || return 0
	## Whom a question is asked of answers it: the address it names (its `address-to`).
	[ -z "$gateQuestion" ] || ! AgentsToolsAuthorityAddressHeld "$( AgentsToolsAuthorityField "$gateQuestion" address-to )" || return 0
	## A console account mapped to an owner: the owner confirms, in its own channel.
	! AgentsToolsAuthorityOwnerMapped || gateConfirm="yes"
	if [ -z "${agentsAuthorityMode:-}" ] && [ -z "$gateConfirm" ] ; then
		agentsAuthorityOutcome="refused"
		AgentsToolsAuthorityRefuse "$gateWhat" "$gateHolder" "$gateSession" "$gateNamed"
		return 3
	fi
	if [ -n "$gateConfirm" ] ; then gateTo="human-owner" ; else gateTo="$( AgentsToolsAuthorityTarget "$gateHolder" )" ; fi
	## A call asks once. Asked again for the same action on the same original, it JOINS the request it made: that request is waited on by both, and its answer settles
	## both, whether the first was waited for or left to the sweep (an enqueued one becomes a waited one: whoever waits on it acts). Said plainly, never silent.
	gateExisting="$( AgentsToolsAuthorityOpenRequestFor "$gateOriginal" "$gateWhat" )"
	if [ -n "$gateExisting" ] ; then
		gateId="$gateExisting"
		if [ "${agentsAuthorityMode:-}" != wait ] ; then
			printf 'already asked as %s, pending: it acts when it is answered (the next sweep, or a wait on it: the same call with --escalate-wait)\n' "$gateId"
			agentsAuthorityOutcome="pending"
			return 0
		fi
		printf 'already asked as %s, waiting\n' "$gateId"
		AgentsToolsAuthorityFieldSet "$( AgentsToolsQuestionsStore )/$gateId.md" request-mode wait || :
	else
		gateOpened="$( AgentsToolsAuthorityRequestOpen "${agentsAuthorityMode:-enqueue}" "$gateConfirm" "$gateTo" "$gateSession" "$gateOriginal" "$gateWhat" "$gateQuestion" "$@" )" || {
			agentsAuthorityOutcome="refused" ; return 1
		}
		printf '%s\n' "$gateOpened"
		if [ "${agentsAuthorityMode:-}" != wait ] ; then
			## An enqueued request is acted on by the sweep of the main loop: where none has run on this host, that is said, and how else it is acted on.
			gateAge="$( AgentsToolsAuthoritySweepAge )"
			case "$gateAge" in never|[0-9]*)
				if [ "$gateAge" = never ] || [ "$gateAge" -gt "${MDAT_AUTHORITY_SWEEP_STALE_SECONDS:-900}" ] ; then
					printf 'NOTE: no main loop has swept the requests on this host (%s), so %s is acted on by the next sweep, or by a wait on it: the same call with --escalate-wait finds it and waits\n' \
						"$( [ "$gateAge" = never ] && printf 'never' || printf 'last %s ago' "$( AgentsToolsAuthoritySpan "$gateAge" )" )" "${gateOpened#PENDING }"
				fi
			;; esac
			agentsAuthorityOutcome="pending"
			return 0
		fi
		gateId="${gateOpened#PENDING }" ; gateId="${gateId%% *}"
	fi
	AgentsToolsAuthorityRequestWait "$gateId" "${agentsAuthorityTimeout:-}" || gateRc=$?
	case "$gateRc" in
		0)
			## Approved: this waiter acts now, and the request is marked as acted on.
			AgentsToolsAuthorityFieldSet "$( AgentsToolsQuestionsStore )/$gateId.md" acted-at "$( date +"%Y-%m-%d %H:%M %z" )" || :
			agentsAuthorityChosenNow="$( AgentsToolsAuthorityField "$( AgentsToolsQuestionsStore )/$gateId.md" chosen )"
			agentsAuthorityOutcome="act"
			return 0
		;;
		124) agentsAuthorityOutcome="timeout" ; return 124 ;;
		125)
			printf 'ENQUEUED %s: it is not waited for any more, and acts when the answer comes\n' "$gateId"
			agentsAuthorityOutcome="pending"
			return 0
		;;
		130)
			printf 'WITHDRAWN %s: the wait was cancelled and the request withdrawn, its record kept\n' "$gateId"
			agentsAuthorityOutcome="withdrawn"
			return 130
		;;
		*) agentsAuthorityOutcome="denied" ; return 1 ;;
	esac
}

## What the gate's outcome makes an operation do: rc 0 go on and act; rc 1 end, with the code it
## returns in agentsAuthorityExit -- 0 pending, 3 refused, 1 denied, 124 at the timeout.
AgentsToolsAuthorityExit(){
	agentsAuthorityExit=""
	case "${agentsAuthorityOutcome:-}" in
		act) return 0 ;;
		pending) agentsAuthorityExit=0 ;;
		refused) agentsAuthorityExit=3 ;;
		timeout) agentsAuthorityExit=124 ;;
		withdrawn) agentsAuthorityExit=130 ;;
		*) agentsAuthorityExit=1 ;;
	esac
	return 1
}

## A request answered with the escalation answer, by whom it asks, or by one the owners role
## granted the authority in its session (AgentsToolsAuthorityCaller first). Prints one line; rc 1
## where it is not that caller's to answer.
AgentsToolsAuthorityRequestAnswer(){ ## request record, verdict, console (where the caller is a person at the console: it may refuse any request)
	local answerTo
	AgentsToolsAuthorityCaller
	answerTo="$( AgentsToolsAuthorityField "$1" address-to )"
	if [ "$( AgentsToolsAuthorityField "$1" status )" != reply-pending ] ; then
		echo "⛔ ERROR: ${MDSC_CMD:-DistroAgentsTools}: request $( basename "$1" .md ) is not open, so it takes no answer" >&2
		return 1
	fi
	if ! AgentsToolsAuthorityAddressHeld "$answerTo" && ! AgentsToolsAuthorityGranted "$( AgentsToolsAuthorityField "$1" session-id )" && ! { [ "${3:-}" = console ] && AgentsToolsAuthorityRefusing "$2" ; } ; then
		echo "⛔ ERROR: ${MDSC_CMD:-DistroAgentsTools}: request $( basename "$1" .md ) asks $answerTo, and $agentsAuthorityCallerId is not that, so it cannot answer it" >&2
		return 1
	fi
	AgentsToolsAuthorityRequestSettle "$1" "$2" "$agentsAuthorityCallerId"
}

## The thread of one open request read, and the request settled by what stands there: the one step of the sweep, and of the waiter of that request. A request
## text-answered or answered by word or emoji is settled (AgentsToolsAuthorityRequestSettle); a reply that names no answer, and a message the owner wrote in the
## direct conversation outside the thread, answer nothing, and the person is told once what to reply (AgentsToolsAuthorityRequestTell). One line for what was done.
AgentsToolsAuthorityRequestRead(){ ## request record
	local readFile="$1" readOut readVerdict readAuthor readText readStamp
	[ "$( AgentsToolsAuthorityField "$readFile" status )" = reply-pending ] || return 0
	[ -n "$( AgentsToolsAuthorityField "$readFile" request-of )" ] || return 0
	## THE OWNERS ROLE (epic T8): a request to the role is answered by its members' conversation,
	## and the kind's quorum rule decides their answers. A single member, or the `first` rule, is
	## the single-answer path below, unchanged.
	if AgentsToolsAuthorityQuorumRead "$readFile" ; then
		return 0
	fi
	type AgentsToolsEscalationThreadVerdict > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.MemberEscalation.include" --definitions-only 2> /dev/null || return 0
	type AgentsToolsRunRoute > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SpawnSandbox.include" 2> /dev/null || :
	readOut="$( AgentsToolsEscalationThreadVerdict "$( AgentsToolsAuthorityField "$readFile" owner )" "$readFile" "$( basename "$readFile" .md )" \
		"$( AgentsToolsAuthorityField "$readFile" channel )" "$( AgentsToolsAuthorityField "$readFile" question-ts )" "$( AgentsToolsAuthorityField "$readFile" thread-ts )" \
		"$( AgentsToolsAuthorityField "$readFile" addressees )" true 2> /dev/null )" || readOut=""
	readVerdict="$( printf '%s\n' "$readOut" | head -1 )"
	agentsAuthorityReadOutcome="read" ; case "${readVerdict%%$'\t'*}" in ''|UNREADABLE) agentsAuthorityReadOutcome="unreadable" ;; esac
	if [ "${readVerdict%%$'\t'*}" = RETURNED ] && [ "$( AgentsToolsAuthorityField "$readFile" kind )" = question ] ; then
		readText="$( printf '%s\n' "$readOut" | LC_ALL=C awk -F'\t' '$1 == "CLARIFY" && $4 != "" { text = $0 ; sub( /^[^\t]*\t[^\t]*\t[^\t]*\t/, "", text ) ; print text "\t" $3 ; exit }' )"
		[ -z "$readText" ] || readVerdict="$readText"
	fi
	case "${readVerdict%%$'\t'*}" in
		''|UNREADABLE) return 0 ;;
		OPEN)
			## Nothing in the thread. A message the owner wrote in the direct conversation, outside the thread, is read by no one: said once, with what to reply.
			readStamp="$( AgentsToolsAuthorityRequestUnthreaded "$readFile" )"
			[ -z "$readStamp" ] || AgentsToolsAuthorityRequestTell "$readFile" unthreaded "$readStamp"
			return 0
		;;
		RETURNED)
			## A reply that names no answer: nothing is granted, the request stays open, and the person is told once what to reply.
			readStamp="$( AgentsToolsEscalationFloor "$readOut" )"
			[ -z "$readStamp" ] || AgentsToolsAuthorityRequestTell "$readFile" unclear "$readStamp"
			return 0
		;;
	esac
	readAuthor="${readVerdict#*$'\t'}"
	AgentsToolsAuthorityRequestSettle "$readFile" "${readVerdict%%$'\t'*}" "${readAuthor:-the owners role}"
}

## The newest message an accepted author wrote in the same direct conversation after the ask, outside its thread (a conversation's history holds no reply of a
## thread): its ts. Nothing for a request asked in a channel, or when none was written.
AgentsToolsAuthorityRequestUnthreaded(){ ## request record
	local unFile="$1" unChannel unTs unWork
	unChannel="$( AgentsToolsAuthorityField "$unFile" channel )" ; unTs="$( AgentsToolsAuthorityField "$unFile" question-ts )"
	case "$unChannel" in D*) ;; *) return 0 ;; esac
	[ -n "$unTs" ] && [ -n "$( AgentsToolsAuthorityField "$unFile" addressees )" ] || return 0
	unWork="$( "$BASH" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh" --intern-op-comms-slack-read "$( AgentsToolsAuthorityField "$unFile" owner )" \
		"$unChannel" --oldest "$unTs" --identity-bot 2> /dev/null )" || return 0
	printf '%s\n' "$unWork" \
		| LC_ALL=C awk -v authors=" $( AgentsToolsAuthorityField "$unFile" addressees ) " -v after="$unTs" '
			/^[0-9]+\.[0-9]+ \| / { split( $0, part, " \\| " ) ; if ( index( authors, " " part[2] " " ) > 0 && part[1] != after && part[1] > after ) { newest = part[1] ; } }
			END { print newest ; }'
}

## The post that says a request was withdrawn before an answer: a plain line to the request's thread, so the person who was
## asked knows the asker's wait ended (a signal, or its bound) and nothing acts on the request. Nothing is posted where the
## record names no thread. One line, WITHDREW.
AgentsToolsAuthorityRequestWithdrawn(){ ## request record
	local wdFile="$1" wdChannel wdTs wdTo
	wdChannel="$( AgentsToolsAuthorityField "$wdFile" channel )" ; wdTs="$( AgentsToolsAuthorityField "$wdFile" thread-ts )"
	[ -n "$wdChannel" ] && [ -n "$wdTs" ] || return 0
	wdTo="$( AgentsToolsAuthorityField "$wdFile" address-to )"
	printf '🙋 this request was withdrawn before an answer: the asker'"'"'s wait ended (a signal, or its bound), and nothing acts on it.\n' \
		| "$BASH" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh" --intern-op-comms-slack-send-message "$( AgentsToolsAuthorityField "$wdFile" owner )" \
		"$wdChannel:$wdTs" --from-stdin --identity-bot ${wdTo:+--address-to "$wdTo"} > /dev/null 2>&1 || :
	printf 'WITHDREW %s\n' "$( basename "$wdFile" .md )"
}

## Tells the person, once for what it answers, what to reply to a request that was not answered: a post in the request's thread by the team bot, from the block
## of the request's template (request-permission.post.format.md, `# Authority`), and the stamp kept on the record. kind: unclear (a reply that names no answer) or
## unthreaded (a message outside the thread). One line, TOLD.
AgentsToolsAuthorityRequestTell(){ ## request record, kind, stamp (the ts it is told for)
	local tellFile="$1" tellText tellTo tellId
	[ "$( AgentsToolsAuthorityField "$tellFile" "told-$2" )" != "$3" ] || return 0
	type AgentsToolsAskPostFill > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.AskPost.include" 2> /dev/null || return 0
	tellText="$( ASKP_BLOCK="Authority/$2" AgentsToolsAskPostFill block request-permission.post.format.md "" 2> /dev/null )" || tellText=""
	[ -n "$tellText" ] || return 0
	tellId="$( basename "$tellFile" .md )" ; tellTo="$( AgentsToolsAuthorityField "$tellFile" address-to )"
	AgentsToolsAuthorityFieldSet "$tellFile" "told-$2" "$3" || :
	printf '%s\n' "$tellText" | "$BASH" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh" --intern-op-comms-slack-send-message "$( AgentsToolsAuthorityField "$tellFile" owner )" \
		"$( AgentsToolsAuthorityField "$tellFile" channel ):$( AgentsToolsAuthorityField "$tellFile" thread-ts )" --from-stdin --identity-bot ${tellTo:+--address-to "$tellTo"} > /dev/null 2>&1 || :
	printf 'TOLD %s: %s -- %s\n' "$tellId" "$2" "$( printf '%s' "$tellText" | head -1 )"
}

## The sweep of the questions store: every open request whose answer stands in its thread is
## settled (AgentsToolsAuthorityRequestRead). A text request takes no answer word, so its
## thread reads as returned: its first reply there, as written, is its answer. One line for
## each that was. The time of the sweep is kept, so that a call that leaves a request for the
## sweep can say whether one runs on this host (AgentsToolsAuthoritySweepAge).
AgentsToolsAuthorityRequestsSweep(){
	local sweepFile
	type AgentsToolsEscalationThreadVerdict > /dev/null 2>&1 || return 0
	mkdir -p "${MMDAPP:-/nonexistent}/.local/temp" 2> /dev/null && date +%s > "${MMDAPP}/.local/temp/mdat-authority-sweep-at" 2> /dev/null || :
	for sweepFile in "$( AgentsToolsQuestionsStore )"/*.md ; do
		[ -f "$sweepFile" ] || continue
		AgentsToolsAuthorityRequestRead "$sweepFile" || :
	done
}

## THE CONSOLE POLLS ITS OWN REQUESTS, and only those: while it is open, the requests this caller itself made (enqueued or waited), no one's else, among them
## the team's process flow. Each is looked at as the wait looks at it (AgentsToolsAuthorityRequestRead, at Wait's TTL for a post, kept as `checked-at` on the record), and
## an answer found acts through the same tooling call (the settle of an enqueued request acts; a waited one is acted on by its waiter). One line for each that was settled.
AgentsToolsAuthorityRequestsPollOwn(){
	local pollFile pollNow pollChecked
	AgentsToolsAuthorityCaller
	## Only the person at the console polls: a member that reads its count polls nothing, since the process flow of the team is not the console's.
	[ "${agentsAuthorityCallerKind:-}" != member ] || return 0
	for pollFile in "$( AgentsToolsQuestionsStore )"/*.md ; do
		[ -f "$pollFile" ] || continue
		[ "$( AgentsToolsAuthorityField "$pollFile" status )" = reply-pending ] || continue
		[ -n "$( AgentsToolsAuthorityField "$pollFile" request-of )" ] || continue
		[ "$( AgentsToolsAuthorityField "$pollFile" requester )" = "$agentsAuthorityCallerId" ] || continue
		pollNow="$( date +%s )"
		pollChecked="$( AgentsToolsAuthorityField "$pollFile" checked-at )" ; case "$pollChecked" in ''|*[!0-9]*) pollChecked=0 ;; esac
		[ $(( pollNow - pollChecked )) -ge "$( AgentsToolsAuthorityWaitTtl "$pollFile" 0 )" ] || continue
		AgentsToolsAuthorityFieldSet "$pollFile" checked-at "$pollNow" || :
		AgentsToolsAuthorityRequestRead "$pollFile" || :
	done
}

## How long ago the sweep last ran on this host, in seconds, or `never`: a sweep is the main loop's pass.
AgentsToolsAuthoritySweepAge(){
	local sweepAt
	sweepAt="$( cat "${MMDAPP:-/nonexistent}/.local/temp/mdat-authority-sweep-at" 2> /dev/null )" || sweepAt=""
	case "$sweepAt" in ''|*[!0-9]*) printf 'never\n' ;; *) printf '%d\n' $(( $( date +%s ) - sweepAt )) ;; esac
}

## The open request this caller made for that very action on that original, if any: its id. A call asks once; asked again it finds the request it made.
AgentsToolsAuthorityOpenRequestFor(){ ## original, what (words)
	local openedFile
	for openedFile in "$( AgentsToolsQuestionsStore )"/*.md ; do
		[ -f "$openedFile" ] || continue
		[ "$( AgentsToolsAuthorityField "$openedFile" status )" = reply-pending ] || continue
		[ "$( AgentsToolsAuthorityField "$openedFile" request-of )" = "$1" ] || continue
		[ "$( AgentsToolsAuthorityField "$openedFile" request-what )" = "$2" ] || continue
		[ "$( AgentsToolsAuthorityField "$openedFile" requester )" = "${agentsAuthorityCallerId:-}" ] || continue
		basename "$openedFile" .md ; return 0
	done
}
