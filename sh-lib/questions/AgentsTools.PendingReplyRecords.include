#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.PendingReplyRecords.include -- the member-facing read of the pending-reply
## records AskQuestion leaves in $MMDAPP/.local/agents/pending: poll one's own open asks,
## read one record field, scan records as the read shows them, measure the askers that
## asked them, and find what lies beside one record. Definitions only: this file runs
## nothing at load. The records themselves are written and closed by
## AgentsTools.InternOpPendingReply.include; nothing here writes a record except through
## that close. The operations load this file from their own arm
## (AgentsTools.OpReadPendingReply.include, AgentsTools.OpSettlePendingReply.include,
## AgentsTools.OpAmendPendingReply.include), each with a guarded load line.
##
## PASSIVE DISCOVERY -- the owner's words: "I CANNOT ANSWER SAME QUESTION 10 TIMES". A plain ask
## answered by a reaction or a reply records that only when something probes it, which a `wait:
## false` ask never gets unless its own asker calls Wait. Every --read-pending-reply now checks
## each of the caller's own open asks the same way a live Wait would (AgentsWaitProbeAsk), through
## the same comms cache a thread read already uses there (AgentsWaitThreadCached): no reminder for
## one already answered, and no extra network call once the cache covers it.
## A reply is taken into its record by that record's collect (AgentsTools.PendingReplyCollect.include), because the harness resolve needs `harnessAgent`.
AgentsToolsPendingReplyPollOwn(){ ## <team-member>
	local pollMember="$1" pollFile pollId pollOut pollRc pollTs
	type AgentsWaitProbeAsk > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/wait/AgentsTools.MemberWaitAsk.include"
	set -- "$MMDAPP/.local/agents/pending"/*.md
	[ -f "$1" ] || return 0
	## The member's open asks, chosen in one pass over every record: the first status and owner lines above the record's first heading,
	## and an id that is a bare name.
	while IFS= read -r pollId ; do
		pollFile="$MMDAPP/.local/agents/pending/$pollId.md"
		pollOut="$( mkdir -p "$MMDAPP/.local/temp" 2> /dev/null && mktemp "$MMDAPP/.local/temp/mdat-pending-poll.XXXXXX" 2> /dev/null )" || continue
		pollRc=0
		AgentsWaitProbeAsk "$pollMember" "$pollId" "" "$pollOut" > /dev/null 2>&1 || pollRc=$?
		if [ "$pollRc" = "0" ] && LC_ALL=C grep -q -E '^([0-9]+\.[0-9]+ \| |reaction on the question: )' "$pollOut" 2>/dev/null ; then
			## A reply whose ts the record keeps already, as a clarification, is taken: only a newer one, or a click, is collected.
			pollTs="$( LC_ALL=C awk '/^[0-9]+\.[0-9]+ \| / { ts = $1 ; } END { print ts ; }' "$pollOut" 2> /dev/null )" || pollTs=""
			if [ -z "$pollTs" ] || ! LC_ALL=C grep -q -F -- "- $pollTs " "$pollFile" 2> /dev/null ; then
				"$BASH" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh" --intern-op-pending-reply-collect --id "$pollId" > /dev/null 2>&1 || :
			fi
		fi
		rm -f "$pollOut" "$pollOut".* 2> /dev/null
	done < <( LC_ALL=C awk -v who="$pollMember" '
		function decide( id ) {
			id = file ; sub( /^.*\//, "", id ) ; sub( /\.md$/, "", id )
			if ( file != "" && status == "reply-pending" && owner == who && id ~ /^[A-Za-z0-9._][A-Za-z0-9._-]*$/ && id != "." && id != ".." ) { print id ; }
		}
		FNR == 1 { decide() ; file = FILENAME ; status = "" ; owner = "" ; seenStatus = 0 ; seenOwner = 0 ; stop = 0 ; }
		stop { next ; }
		/^# / { stop = 1 ; next ; }
		!seenStatus && index( $0, "status: " ) == 1 { status = substr( $0, 9 ) ; seenStatus = 1 ; }
		!seenOwner && index( $0, "owner: " ) == 1 { owner = substr( $0, 8 ) ; seenOwner = 1 ; }
		END { decide() ; }
	' "$@" )
}

## One header field of a record, empty when absent. The header ends at its second `---`.
AgentsToolsPendingReplyField(){ ## record file, field name
	[ -f "$1" ] || return 0
	LC_ALL=C awk -v key="$2" '
		$0 == "---" { dashes++ ; if ( dashes == 2 ) { exit ; } next ; }
		dashes == 1 && index($0, key ": ") == 1 { print substr($0, length(key) + 3) ; exit ; }
	' "$1" 2>/dev/null
}

## The open ask a message stands on, if any: its pending id, empty where there is none. A message
## stands on an ask when it is that ask's question as first posted (`question-ts`), the version it
## was asked again as (`revision-ts`), or the parent of the thread it was posted in (`thread-ts`).
## One pass over the store, its header fields taken as AgentsToolsPendingReplyField takes them.
AgentsToolsPendingReplyOpenAt(){ ## channel, the message's ts
	local atChannel="$1" atTs="$2" atStore="$MMDAPP/.local/agents/pending"
	[ -n "$atChannel" ] && [ -n "$atTs" ] && [ -d "$atStore" ] || return 0
	set -- "$atStore"/*.md
	[ -f "$1" ] || return 0
	LC_ALL=C awk -v wantChannel="$atChannel" -v wantTs="$atTs" '
		function decide() {
			if ( status == "reply-pending" && channel == wantChannel && ( questionTs == wantTs || revisionTs == wantTs || threadTs == wantTs ) ) { print fileId ; found = 1 ; }
		}
		FNR == 1 { if ( found ) { exit ; } fileId = FILENAME ; sub( /^.*\//, "", fileId ) ; sub( /\.md$/, "", fileId ) ; status = "" ; channel = "" ; questionTs = "" ; revisionTs = "" ; threadTs = "" ; stop = 0 ; }
		stop { next ; }
		/^# / { stop = 1 ; next ; }
		index( $0, "status: " ) == 1 { status = substr( $0, 9 ) ; next }
		index( $0, "channel: " ) == 1 { channel = substr( $0, 10 ) ; next }
		index( $0, "question-ts: " ) == 1 { questionTs = substr( $0, 14 ) ; next }
		index( $0, "revision-ts: " ) == 1 { revisionTs = substr( $0, 14 ) ; next }
		index( $0, "thread-ts: " ) == 1 { threadTs = substr( $0, 12 ) ; next }
		END { if ( ! found ) { decide() ; } }
	' "$@"
}

## Prints records as the read shows them, in one awk pass over every file given:
## `PENDING-REPLY: <id>`, the header fields the read names, `question:` with the
## question's first line, then a blank line. -v owner keeps only that member's records,
## -v openOnly=1 only waiting ones, -v countLine=1 ends with `PENDING-REPLIES: <n>`, and -v countLine=only
## renders no record and prints only <n>.
## An open record also says, before its question, whether the run that asked it is alive
## (`asker-live:`): what was measured for its asking id, given here as the text
## AgentsToolsPendingReplyAskers printed, and this host's name, by which the ask of another
## host is told apart and left unmeasured.
AgentsToolsPendingReplyScan(){ ## owner filter (empty for any), open only (1 or empty), count line (1 or empty), askers measured, record files...
	local scanOwner="$1" scanOpen="$2" scanCount="$3" scanAskers="$4" scanHost
	shift 4
	scanHost="$( hostname -s 2>/dev/null )" || scanHost=""
	[ -n "$scanHost" ] || scanHost="unknown"
	printf '%s\n' "$scanAskers" | LC_ALL=C awk -v wantOwner="$scanOwner" -v openOnly="$scanOpen" -v countLine="$scanCount" -v askerHost="$scanHost" \
		-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsToolsPendingReplyScan.awk" - "$@"
}

## Whether the runs that asked are alive, for the asking ids on stdin, a line each: measured
## now, by the one rule a run is recognised by (AgentsToolsRegistryAskersLive,
## AgentsTools.Registries.include), and stored nowhere. The process list is read once, and
## only when there is an id to ask about.
AgentsToolsPendingReplyAskers(){ ## stdin: the asking ids, a line each
	type AgentsToolsRunProcessArgs > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/run/AgentsTools.RunProcesses.include"
	local askersIds
	askersIds="$( cat )"
	[ -n "$askersIds" ] || return 0
	type AgentsToolsRegistryAskersLive > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.RegistrySpawnedSessions.include"
	printf '%s\n' "$askersIds" | AgentsToolsRegistryAskersLive "$( AgentsToolsRunProcessArgs ; printf '%s' "$agentsProcessArgs" )"
}

## Where the stores keep more of one ask than its record, for the read of that one record,
## which prints it whole (AgentsToolsPendingReplyScan.awk, MDAT_PENDING_WHOLE). Sets
## replyWholeBeside, the names of what lies beside the record, its id taken off;
## replyWholeRefusal, the refusal record a permission names, as grants answers it
## (AgentsToolsPermissionRefusalRecordInto); and replyWholeChange, the folder of the held
## change whose own record names this ask, as grants answers it (AgentsChangeDir). Each is
## empty where there is none. Only what a store of this workspace holds: no thread is read.
AgentsToolsPendingReplyWholeFind(){ ## record file, pending id
	local wholeEntry wholeName wholeSession wholeRefusal
	replyWholeBeside="" ; replyWholeRefusal="" ; replyWholeChange=""
	for wholeEntry in "${1%.md}".* ; do
		[ -e "$wholeEntry" ] || continue
		wholeName="${wholeEntry##*/}" ; wholeName="${wholeName#"$2".}"
		[ "$wholeName" = "md" ] || replyWholeBeside="$replyWholeBeside$wholeName "
	done
	replyWholeBeside="${replyWholeBeside% }"
	wholeSession="$( AgentsToolsPendingReplyField "$1" session-id )"
	wholeRefusal="$( AgentsToolsPendingReplyField "$1" refusal-id )"
	case "$wholeRefusal" in
		''|.|..|*/*) ;;
		*)
			type AgentsToolsPermissionRefusalRecordInto > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.PermissionRecord.include"
			AgentsToolsPermissionRefusalRecordInto replyWholeRefusal "$wholeRefusal" "$wholeSession" || replyWholeRefusal=""
		;;
	esac
	case "$wholeSession" in
		''|.|..|*/*) ;;
		*)
			[ "$( AgentsToolsPendingReplyField "$1" kind )" != "change" ] || {
				type AgentsChangeDir > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.InternOpChange.include"
				replyWholeChange="$( AgentsChangeDir "$1" "$2" )" || replyWholeChange=""
			}
		;;
	esac
	return 0
}
