#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.MemberPendingReply.include -- the dispatcher arm of the member-facing
## pending-reply operations: --read-pending-reply, --settle-pending-reply, --amend-pending-reply,
## --reconcile-answered-status and the console's --manager-pending-reply-dismiss. Each arm sources its operation file
## (AgentsTools.OpReadPendingReply.include, AgentsTools.OpSettlePendingReply.include,
## AgentsTools.OpAmendPendingReply.include, AgentsTools.OpReconcileAnsweredStatus.include), which loads the shared reads it needs from
## AgentsTools.PendingReplyRecords.include. Sourced to run an operation, never for the
## functions; the reads live in the records library.
##


case "$1" in

	--read-pending-reply)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.OpReadPendingReply.include"
	;;

	--settle-pending-reply|--manager-pending-reply-dismiss)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.OpSettlePendingReply.include"
	;;

	--amend-pending-reply)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.OpAmendPendingReply.include"
	;;

	--reconcile-answered-status)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.OpReconcileAnsweredStatus.include"
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
