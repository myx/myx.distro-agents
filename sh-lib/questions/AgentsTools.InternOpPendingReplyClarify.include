#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

## AgentsTools.InternOpPendingReplyClarify.include -- the operation `--intern-op-pending-reply-clarify`, sourced by AgentsTools.InternOpPendingReply.include with the operation's arguments.
## Keeps the clarifications and corrections on a question's answer: the rest of the message
## its answer was read from, and every later message the person wrote in its thread
## (AgentsPendingReplyClarifications.awk). Read from stdin as "<ts>\t<author>\t<text>" lines;
## each new one is appended under the record's own `## Clarifications` section, and, where
## the question belongs to an item, as a `clarification` line on its Decisions. A message
## already kept, by its ts, is never kept twice. Open or closed records alike. Prints
## `CLARIFIED <id> <how many were new>`.
## --follow-floor <ts> also moves the record's `follow-floor` up to <ts>, never down: the
## last message of its thread already kept, from which a closed question's thread is still
## watched (AgentsWaitProbeAsk), so nothing kept comes back as new.
		shift
		MDSC_CMD="$MDSC_CMD --intern-op-pending-reply-clarify"
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/harness/AgentsContext.UseAgentsTools.include"
		local clarId="${1:-}" clarFile clarIn clarTs clarBy clarText clarNew="" clarCount=0 clarLock="" clarFloor="" clarFloorNow clarBody
		shift || true
		while [ $# -gt 0 ] ; do
			case "$1" in
				--from-stdin) shift ;;
				--follow-floor) clarFloor="${2:-}" ; shift 2 ;;
				--context) shift 2 ;;
				*)
					echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1 -- syntax is <pending-reply-id> --from-stdin" >&2
					set +e ; return 1
				;;
			esac
		done
		[ -n "$clarId" ] || { echo "$MDSC_CMD: ⛔ ERROR: syntax is <pending-reply-id> --from-stdin" >&2 ; set +e ; return 1 ; }
		AgentsToolsAssertBareName "$clarId" "<pending-reply-id>" pending-reply-clarify || { set +e ; return 1 ; }
		## Open or closed records alike, so a closed one is found in pending/closed/ (retention, T9).
		clarFile="$MMDAPP/.local/agents/pending/$clarId.md"
		[ -f "$clarFile" ] || clarFile="$MMDAPP/.local/agents/pending/closed/$clarId.md"
		[ -f "$clarFile" ] || { echo "$MDSC_CMD: ⛔ ERROR: no pending-reply record: $clarId" >&2 ; set +e ; return 1 ; }
		clarIn="$( cat )"
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/common/AgentsTools.LocalLock.include"
		AgentsToolsLocalLockTake "pending-reply-$clarId" 30 || { echo "$MDSC_CMD: ⛔ ERROR: the lock on $clarId could not be taken, so nothing was kept" >&2 ; set +e ; return 1 ; }
		clarLock="$agentsLocalLockPath"
		while IFS=$'\t' read -r clarTs clarBy clarText ; do
			[ -n "$clarTs" ] && [ -n "$clarText" ] || continue
			! LC_ALL=C grep -q -F -- "- $clarTs " "$clarFile" || continue
			case "$clarNew" in *"- $clarTs "*) continue ;; esac
			clarNew="$clarNew- $clarTs ${clarBy:-unknown}: ${clarText//$'\n'/ }"$'\n'
			clarCount=$(( clarCount + 1 ))
		done <<< "$clarIn"
		if [ -n "$clarNew" ] ; then
			{ LC_ALL=C grep -q -x -F '## Clarifications' "$clarFile" || printf '\n## Clarifications\n\n' ; printf '%s' "$clarNew" ; } >> "$clarFile" \
				|| { AgentsToolsLocalLockGive "$clarLock" ; echo "$MDSC_CMD: ⛔ ERROR: the clarifications could not be written to $clarFile" >&2 ; set +e ; return 1 ; }
		fi
		if [ -n "$clarFloor" ] ; then
			clarFloorNow="$( LC_ALL=C awk '$0 == "---" { if ( ++fm == 2 ) exit ; next ; } fm == 1 && index( $0, "follow-floor: " ) == 1 { print substr( $0, 15 ) ; exit ; }' "$clarFile" )"
			if [ -z "$clarFloorNow" ] || LC_ALL=C awk -v a="$clarFloor" -v b="$clarFloorNow" 'BEGIN {
				sa = a ; sub( /\..*$/, "", sa ) ; sb = b ; sub( /\..*$/, "", sb ) ;
				fa = a ; sub( /^[^.]*\.?/, "", fa ) ; fb = b ; sub( /^[^.]*\.?/, "", fb ) ;
				fa = substr( fa "000000", 1, 6 ) ; fb = substr( fb "000000", 1, 6 ) ;
				exit ( ( sa + 0 > sb + 0 || ( sa + 0 == sb + 0 && fa > fb ) ) ? 0 : 1 ) ; }' ; then
				local clarOps=""
				clarBody=""
				mkdir -p "$MMDAPP/.local/temp" && clarOps="$( mktemp "$MMDAPP/.local/temp/mdat-pending-reply-clarify-ops.XXXXXX" )" \
					&& printf 'upsert\tfollow-floor\t%s\n' "$clarFloor" > "$clarOps" \
					&& clarBody="$( LC_ALL=C awk -v opsFile="$clarOps" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsBoardItemHeaderOpsApply.awk" < "$clarFile" )" || clarBody=""
				[ -z "$clarOps" ] || rm -f "$clarOps"
				if [ -n "$clarBody" ] ; then
					{ printf '%s\n' "$clarBody" > "$clarFile.$$" && mv -f "$clarFile.$$" "$clarFile" ; } || rm -f "$clarFile.$$"
				else
					echo "$MDSC_CMD: ⚠️ WARNING: the follow floor of $clarId was not moved" >&2
				fi
			fi
		fi
		AgentsToolsLocalLockGive "$clarLock"
		if [ -n "$clarNew" ] ; then
			. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.ItemDecisions.include"
			while IFS= read -r clarText ; do
				[ -n "$clarText" ] || continue
				clarText="${clarText#- }" ; clarTs="${clarText%% *}" ; clarText="${clarText#* }" ; clarBy="${clarText%%: *}" ; clarText="${clarText#*: }"
				AgentsToolsDecisionsClarification "$clarId" "$clarFile" "$clarBy" "$clarText" "$clarTs"
			done <<< "$clarNew"
		fi
		printf 'CLARIFIED %s %s\n' "$clarId" "$clarCount"
		return 0
