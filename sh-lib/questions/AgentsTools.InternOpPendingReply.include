#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.InternOpPendingReply.include -- the pending-reply store.
##
## A question asked of a person is the commonest reason a session is waiting on
## something, and AskQuestion -- a Slack send plus a wait -- is where nearly all
## of them come from. Only some of those ever become board items. So the store is its
## own: one record per question asked, written when the question is posted and closed
## when the answer arrives or the wait ends. `pending-replies.registry` is a cache
## over this store and over the board items that did become items.
##
## A record is kept after it closes rather than deleted: a saved reply is what lets a
## session resume, and an unanswered question is what a re-ask is posted from. Purging
## is not this op's business.
##
## THE DISTINCTION THIS STORE EXISTS TO HOLD: a question that was never posted is not
## a question nobody answered. AskQuestion says so in its own words, and it is why
## nothing is recorded until the send has succeeded, and why a wait that could not be
## performed leaves the record open rather than closing it as unanswered.
##

## An answered ask, told to its asker on the session floor: one message on the session's printback channel (`printback:<session>`,
## F2.2) in the chat file of the session the record names, from the pending-reply store to the member that asked (`owner:`). That
## channel is the session's own whether the session has a thread or not (AgentsSessionChatRead.awk), and it needs no Slack post: a
## block with no conversation would read as a post not sent yet, which is nobody's floor. Its lines: `ASK-ANSWERED <id> (<kind>)`, the question's first
## line of text, `VERDICT: <verdict>` where it has one, and `ANSWERED-BY: <who>` where known. rc 1, nothing written, for a record
## that names no member or no session, or a session with no folder here: a folder is never made for it.
AgentsToolsPendingReplyFloorNotice(){ ## record file, pending id, verdict (may be empty), answered by (may be empty), `amended` for a correction (may be empty)
	local noticeOwner="" noticeSession="" noticeKind="" noticeQuestion="" noticeBody
	type AgentsToolsFrontmatterKey > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/common/AgentsTools.FrontmatterKey.include"
	noticeOwner="$( AgentsToolsFrontmatterKey "$1" owner )" || noticeOwner=""
	noticeSession="$( AgentsToolsFrontmatterKey "$1" session-id )" || noticeSession=""
	noticeKind="$( AgentsToolsFrontmatterKey "$1" kind )" || noticeKind=""
	case "$noticeOwner" in ''|-) return 1 ;; esac
	case "$noticeSession" in ''|-|*/*|.|..) return 1 ;; esac
	type AgentsSessionKnown > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.include"
	AgentsSessionKnown "$noticeSession" || return 1
	## The question: the first line of text under `# Question asked` that is no heading.
	noticeQuestion="$( LC_ALL=C awk '
		$0 == "---" { dashes++ ; next ; }
		dashes < 2 { next ; }
		$0 == "# Question asked" { inQuestion = 1 ; next ; }
		inQuestion && /^#/ { next ; }
		inQuestion && /[^[:space:]]/ { print ; exit ; }
	' "$1" 2> /dev/null | cut -c1-300 )" || noticeQuestion=""
	noticeBody="ASK-ANSWERED $2 (${noticeKind:-question})"
	[ "${5:-}" != "amended" ] || noticeBody="ASK-AMENDED $2 (${noticeKind:-question}): the answer given before is replaced by this one"
	[ -z "$noticeQuestion" ] || noticeBody="$noticeBody"$'\n'"QUESTION: $noticeQuestion"
	[ -z "$3" ] || noticeBody="$noticeBody"$'\n'"VERDICT: $3"
	[ -z "$4" ] || noticeBody="$noticeBody"$'\n'"ANSWERED-BY: $4"
	type AgentsToolsSessionChatAppend > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionChat.include" || return 1
	printf '%s\n' "$noticeBody" | AgentsToolsSessionChatAppend "$noticeSession" pending-reply "$noticeOwner" - "printback:$noticeSession" printback > /dev/null 2>&1
}

## One resolved mark on one message: under the identity the question was posted with, the
## one its record names (`ask-identity`), first, then the other one, since which identity
## may react differs by conversation. One the bot asked may stand where the member's own
## account is not, so its mark is the bot's at the first call.
## `already_reacted` is a success of the react op. A failure is logged and changes nothing.
AgentsToolsPendingReplyReact(){ ## member, <channel>:<ts>, emoji, pending id, the record's ask-identity (bot|member; empty: member)
	if [ "${5:-}" = "bot" ] ; then
		type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
		DistroAgentsTools --intern-op-comms-slack-react "$1" "$2" "$3" --identity-bot > /dev/null 2>&1 \
			|| DistroAgentsTools --intern-op-comms-slack-react "$1" "$2" "$3" > /dev/null 2>&1 \
			|| echo "$MDSC_CMD: ⚠️ WARNING: $4 is closed, but :$3: was not added on $2" >&2
		return 0
	fi
	type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
	DistroAgentsTools --intern-op-comms-slack-react "$1" "$2" "$3" > /dev/null 2>&1 \
		|| DistroAgentsTools --intern-op-comms-slack-react "$1" "$2" "$3" --identity-bot > /dev/null 2>&1 \
		|| echo "$MDSC_CMD: ⚠️ WARNING: $4 is closed, but :$3: was not added on $2" >&2
	return 0
}

## True while any question in that thread still waits.
AgentsToolsPendingReplyThreadHasOpen(){ ## channel, thread ts
	local openFile
	while IFS= read -r openFile ; do
		LC_ALL=C grep -q -x -F "channel: $1" "$openFile" && LC_ALL=C grep -q -x -F "status: reply-pending" "$openFile" && return 0
	done < <( LC_ALL=C grep -l -x -F "thread-ts: $2" "$MMDAPP/.local/agents/pending"/*.md 2>/dev/null )
	return 1
}

case "$1" in

	--intern-op-pending-reply-open)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.InternOpPendingReplyOpen.include"
	;;

	--intern-op-pending-reply-close)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.InternOpPendingReplyClose.include"
	;;

	--intern-op-pending-reply-clarify)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.InternOpPendingReplyClarify.include"
	;;

	--intern-op-pending-reply-revise)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.InternOpPendingReplyRevise.include"
	;;

	--intern-op-pending-reply-collect)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.InternOpPendingReplyCollect.include"
	;;

	--intern-op-pending-reply-earlier)
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.InternOpPendingReplyEarlier.include"
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid operation: $1" >&2
		set +e ; return 1
	;;

esac
