#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

## The prose that stood here is in the package's MAGIC.md, under "AgentsTools.PendingReplyCollect.include".

## The header fields a collect needs, one line each as `<field>\t<value>`, in one pass.
AgentsToolsPendingReplyCollectFields(){ ## record file
	LC_ALL=C awk '
		$0 == "---" { dashes++ ; if ( dashes == 2 ) { inBody = 1 ; } next ; }
		dashes == 1 {
			colon = index($0, ": ") ;
			if ( colon > 1 ) { printf "%s\t%s\n", substr($0, 1, colon - 1), substr($0, colon + 2) ; }
			next ;
		}
		inBody && ! firstSeen && $0 !~ /^#/ && $0 !~ /^[ \t]*$/ { printf "first\t%s\n", $0 ; firstSeen = 1 ; }
	' "$1" 2>/dev/null
}

## Marks a record whose session has ended, so the main loop's collect finds it. Under
## the record's own lock, like every close.
AgentsToolsPendingReplyMarkEnded(){ ## pending id, record file
	local markLock markOps markBody
	. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/common/AgentsTools.LocalLock.include"
	AgentsToolsLocalLockTake "pending-reply-$1" 30 || return 1
	markLock="$agentsLocalLockPath"
	## Its own file, by mktemp: $$ is one for every subshell of one shell, and $RANDOM beside it is no promise.
	markOps="$( mktemp "$MMDAPP/.local/temp/mdat-pending-reply-mark.XXXXXX" 2> /dev/null )" || markOps=""
	if [ "$( AgentsToolsPendingReplyCollectFieldOf "$2" status )" = "reply-pending" ] ; then
		printf 'upsert\tcollect\tended\n' > "$markOps" \
			&& markBody="$( LC_ALL=C awk -v opsFile="$markOps" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsBoardItemHeaderOpsApply.awk" < "$2" )" \
			&& [ -n "$markBody" ] && printf '%s\n' "$markBody" > "$2.$$" && mv -f "$2.$$" "$2"
		rm -f "$2.$$"
	fi
	rm -f "$markOps"
	AgentsToolsLocalLockGive "$markLock"
	return 0
}

AgentsToolsPendingReplySessionsRunning(){
	type AgentsToolsRegistryRenderSpawnedSessionsKept > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.RegistrySpawnedSessions.include"
	type AgentsToolsRunProcessArgs > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/run/AgentsTools.RunProcesses.include"
	local runningIds runningLine runningRoot
	type AgentsSessionKnown > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/session/AgentsTools.SessionStore.include"
	runningIds="$( AgentsToolsRegistryRenderSpawnedSessionsKept agents 60 2> /dev/null | LC_ALL=C awk '
		NF == 13 && $2 != "-" && ( $12 == "running" || ( $12 == "remote" && $13 == "unclosed" ) ) && ! seen[$2]++ { printf "%s ", $2 ; }
	' )"
	while IFS= read -r runningLine ; do
		runningRoot="${runningLine% *}"
		case "${runningLine##* }" in
			running) runningIds="$runningIds$runningRoot " ;;
			no-spawn-record) ! AgentsSessionKnown "$runningRoot" || runningIds="$runningIds$runningRoot " ;;
		esac
	done <<< "$( LC_ALL=C awk 'FNR == 1 { dashes = 0 ; } $0 == "---" { dashes++ ; next ; } dashes == 1 && index( $0, "session-id: " ) == 1 { print substr( $0, 13 ) ; }' "$MMDAPP/.local/agents/pending"/*.md 2> /dev/null | LC_ALL=C sort -u \
		| AgentsToolsRegistryAskersLive "$( AgentsToolsRunProcessArgs ; printf '%s' "$agentsProcessArgs" )" )"
	printf ' %s \n' "$runningIds"
}

## One field, for the rare single read.
AgentsToolsPendingReplyCollectFieldOf(){ ## record file, field
	LC_ALL=C awk -v key="$2" '
		$0 == "---" { dashes++ ; if ( dashes == 2 ) { exit ; } next ; }
		dashes == 1 && index($0, key ": ") == 1 { print substr($0, length(key) + 3) ; exit ; }
	' "$1" 2>/dev/null
}

## AN ANSWER THAT ARRIVED AFTER ITS SESSION ENDED GOES TO THE ASKER'S INBOX, where whoever runs
## as that member next finds it: one note, whose body is the collected line itself. A failed
## write is one warning, and never undoes the close the answer arrived with.
AgentsToolsPendingReplyAnsweredNote(){ ## the member whose inbox it goes to, the pending id, the collected ANSWERED line
	local notedTo="$1" notedId="$2" notedLine="${3:-}"
	type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
	{
		## The keys of the inbox-item.note contract the write gate holds it to: the owner, and a date-time; the gate fills the rest.
		printf -- '---\nowner: %s\ndate: %s\n---\n\n' "$notedTo" "$( date +'%Y-%m-%d %H:%M %z' )"
		printf '# Note: an answer arrived after your session ended\n\n'
		printf 'Pending reply `%s` is answered, and its record is closed. What the tooling collected:\n\n' "$notedId"
		printf -- '- %s\n' "${notedLine#ANSWERED }"
	} | DistroAgentsTools --intern-op-member-inbox-upsert "$notedTo" "note-$( date -u +%Y%m%dT%H%M%SZ )-answer-${notedId%%-*}.md" \
		--context "${MDSC_CMD:-DistroAgentsTools}" > /dev/null 2>&1 \
		|| echo "⚠️ WARNING: ${MDSC_CMD:-DistroAgentsTools}: $notedId is answered and closed, but the note to $notedTo's inbox was not written" >&2
	return 0
}

## Collects one record. Prints its outcome line; sets collectOutcome and collectAnswer
## for the caller. The record is closed here only when it is answered.
AgentsToolsPendingReplyCollectOne(){ ## record file
	local oneFile="$1" oneId oneLine oneKey oneValue oneWork oneRc=0 oneBody oneHead oneClose
	local oneStatus="" oneKind="" oneOwner="" oneChannel="" oneQts="" oneTts="" oneAddr="" oneTag="" oneFirst="" oneItem="" oneSelect="" oneIdentity=""
	collectOutcome="" ; collectAnswer=""
	oneId="${oneFile##*/}" ; oneId="${oneId%.md}"
	while IFS=$'\t' read -r oneKey oneValue ; do
		case "$oneKey" in
			status) oneStatus="$oneValue" ;;
			kind) oneKind="$oneValue" ;;
			owner) oneOwner="$oneValue" ;;
			channel) oneChannel="$oneValue" ;;
			question-ts) oneQts="$oneValue" ;;
			thread-ts) oneTts="$oneValue" ;;
			addressees) oneAddr="$oneValue" ;;
			question-tag) oneTag="$oneValue" ;;
			item) oneItem="$oneValue" ;;
			select) oneSelect="$oneValue" ;;
			ask-identity) oneIdentity="$oneValue" ;;
			first) oneFirst="$oneValue" ;;
		esac
	done < <( AgentsToolsPendingReplyCollectFields "$oneFile" )
	[ "$oneStatus" = "reply-pending" ] || { collectOutcome="SKIPPED" ; return 0 ; }
	## An ask that offers answers of its own is read by the form its options give it, which its
	## `select` field alone does not say (AgentsTools.PendingReplyOptionAsk.include).
	type AgentsToolsPendingReplyAnswerForm > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.PendingReplyOptionAsk.include"
	[ -n "$oneSelect" ] || oneSelect="$( AgentsToolsPendingReplyAnswerForm "$oneFile" )"
	## A held change is its session's own: at that session's end (collectMark) it is dropped, never
	## left for an approval nobody is there to hear (AgentsTools.InternOpChange.include).
	if [ "$oneKind" = "change" ] && [ -n "${collectMark:-}" ] ; then
		type AgentsChangeDrop > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.InternOpChange.include"
		AgentsChangeDrop "$oneFile" "$oneId" tooling "the session that made it has ended"
		collectOutcome="DROPPED"
		printf 'DROPPED %s %s | %s\n' "$oneId" "${oneTag:--}" "$oneFirst"
		return 0
	fi
	case "$oneKind:$oneSelect" in
		:|question:) ;;
		*)
			case "$oneKind" in ''|question) ;; *) [ -n "${collectTyped:-}" ] || { collectOutcome="SKIPPED" ; return 0 ; } ;; esac
			[ -n "$oneOwner" ] || { collectOutcome="SKIPPED" ; return 0 ; }
			local oneRead oneVerdict
			## Its output is kept where the read failed too: an unreadable thread says why there.
			type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
			oneRead="$( MDAT_PENDING_CLOSE_QUIET="${collectQuiet:-}" DistroAgentsTools --intern-op-escalation-read "$oneOwner" "$oneId" 2>/dev/null )" || :
			oneVerdict="$( printf '%s\n' "$oneRead" | LC_ALL=C sed -n 's/^VERDICT: //p' | head -1 )"
			case "$oneRead" in
				*"ESCALATION: $oneId answered"*)
					collectOutcome="ANSWERED" ; collectAnswer="$oneVerdict"
					printf 'ANSWERED %s %s | %s | %s\n' "$oneId" "${oneTag:--}" "$oneFirst" "$oneVerdict"
					## What he wrote with the verdict comes with it, under its line: the words on the
					## verdict's own line, and each message beside it, as the read gave them.
					printf '%s\n' "$oneRead" | LC_ALL=C grep -E '^(VERDICT-TEXT|CLARIFICATION): ' | LC_ALL=C sed 's/^/  /' || :
				;;
				*"ESCALATION: $oneId open"*)
					collectOutcome="OPEN"
					printf 'OPEN %s %s | %s\n' "$oneId" "${oneTag:--}" "$oneFirst"
				;;
				*)
					collectOutcome="UNREADABLE"
					oneVerdict="$( printf '%s\n' "$oneRead" | LC_ALL=C sed -n 's/^UNREADABLE-REASON: //p' | head -1 )"
					printf 'UNREADABLE %s %s | %s\n' "$oneId" "${oneTag:--}" "${oneVerdict:-the escalation read gave no verdict and no open state}"
				;;
			esac
			return 0
		;;
	esac
	## A question its item's Decisions already answer is closed with that answer, read from
	## there, so it is not recorded there a second time.
	## The item's own Decisions first, then those of the task it `tracks:`.
	local oneItemPath="" oneDecision=""
	if [ -n "$oneItem" ] ; then
		type AgentsToolsDecisionsEarlierTracked > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/board/AgentsTools.ItemDecisions.include"
		oneItemPath="$( AgentsToolsDecisionsItemPath "$oneItem" )" && oneDecision="$( AgentsToolsDecisionsEarlierTracked "$oneItemPath" "$oneFirst" )" || oneDecision=""
	fi
	if [ -n "$oneDecision" ] ; then
		collectAnswer="${oneDecision##* -> }" ; collectAnswer="${collectAnswer% (*} (from the Decisions of ${oneDecision%% | *})"
		oneRc=0
		type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
		oneClose="$( DistroAgentsTools --intern-op-pending-reply-close "$oneId" --if-open --status reply-received --no-decision ${collectQuiet:+--quiet} \
			--verdict "$collectAnswer" --answered-by decisions --context collect 2>/dev/null )" || oneRc=$?
		case "$oneRc" in
			0) collectOutcome="ANSWERED" ; printf 'ANSWERED %s %s | %s | %s\n' "$oneId" "${oneTag:--}" "$oneFirst" "$collectAnswer" ; return 0 ;;
			3) collectOutcome="ALREADY-CLOSED" ; printf '%s\n' "$oneClose" ; return 0 ;;
		esac
	fi
	if [ -z "$oneChannel" ] || [ -z "$oneQts" ] || [ -z "$oneTts" ] || [ -z "$oneAddr" ] || [ -z "$oneOwner" ] ; then
		collectOutcome="UNREADABLE"
		printf 'UNREADABLE %s %s | the record names no thread, question or addressee to read\n' "$oneId" "${oneTag:--}"
		return 0
	fi
	oneWork="$( mktemp "$MMDAPP/.local/temp/mdat-pending-collect.XXXXXX" )" || { collectOutcome="UNREADABLE" ; printf 'UNREADABLE %s %s | no work file\n' "$oneId" "${oneTag:--}" ; return 0 ; }
	## Read with the identity the question was asked with: one the bot posted may stand where
	## the member's own account is not (AgentsWaitProbeSlack, MDAT_WAIT_READ_AS_BOT).
	type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
	MDAT_WAIT_READ_AS_BOT="$( [ "$oneIdentity" = "bot" ] && printf 'true' || printf 'false' )" \
	DistroAgentsTools --intern-op-wait-for-input "$oneOwner" --wait-source "slack:$oneChannel:$oneTts" \
		--wait-timeout 0 --wait-since-utime "$oneQts" --wait-addressee "$oneAddr" > "$oneWork" 2> "$oneWork.err" || oneRc=$?
	if [ "$oneRc" != "0" ] || LC_ALL=C grep -q '^WAIT-NEVER-READ: ' "$oneWork" || ! LC_ALL=C grep -q -E '^WAIT-RESULT: (RECEIVED|TIMEOUT)$' "$oneWork" ; then
		collectOutcome="UNREADABLE"
		## Named: the conversation, the identity it was read with, and Slack's own error where the read gave one.
		local oneWhy=""
		oneWhy="$( LC_ALL=C sed -n 's/^.*"error":"\([^"]*\)".*$/\1/p' "$oneWork.err" "$oneWork" 2> /dev/null | head -1 )"
		printf 'UNREADABLE %s %s | the thread %s could not be read as %s%s, so nothing is known about it\n' "$oneId" "${oneTag:--}" "$oneChannel:$oneTts" \
			"$( [ "$oneIdentity" = "bot" ] && printf 'the team bot' || printf 'member %s' "$oneOwner" )" "${oneWhy:+: $oneWhy}"
		rm -f "$oneWork" "$oneWork.err"
		return 0
	fi
	if LC_ALL=C grep -q '^WAIT-RESULT: TIMEOUT$' "$oneWork" ; then
		collectOutcome="OPEN"
		printf 'OPEN %s %s | %s\n' "$oneId" "${oneTag:--}" "$oneFirst"
		rm -f "$oneWork" "$oneWork.err"
		return 0
	fi
	oneBody="$( LC_ALL=C awk '
		$0 == "# --- what that source holds now follows ---" { inBody = 1 ; next ; }
		$0 == "# --- end ---" { inBody = 0 ; next ; }
		inBody { print ; }
	' "$oneWork" )"
	rm -f "$oneWork" "$oneWork.err"
	## An answer is a reply head or a reaction, exactly what ends a live wait on a question.
	oneHead="$( printf '%s\n' "$oneBody" | LC_ALL=C grep -m1 -E '^([0-9]+\.[0-9]+ \| |reaction on the question: )' )" || oneHead=""
	if [ -z "$oneHead" ] ; then
		collectOutcome="UNMATCHED"
		printf 'UNMATCHED %s %s | %s\n' "$oneId" "${oneTag:--}" "$oneFirst"
		return 0
	fi
	local oneBy="reaction" oneAnswerTs=""
	case "$oneHead" in
		'reaction on the question: '*)
			## A reaction answers only where one of this ask's own marks answers it. A free-text ask
			## has no answers and no marks, so the :eyes: the tooling places on what it has read is no
			## answer there (AgentsTools.PendingReplyOptionAsk.include).
			[ -n "$oneSelect" ] || {
				collectOutcome="UNMATCHED"
				printf 'UNMATCHED %s %s | %s\n' "$oneId" "${oneTag:--}" "$oneFirst"
				return 0
			}
			collectAnswer="$oneHead"
		;;
		*)
			oneAnswerTs="${oneHead%% *}"
			oneBy="${oneHead#* | }" ; oneBy="${oneBy%% |*}"
			collectAnswer="$( printf '%s\n' "$oneBody" | ( LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsDismissalMatch.awk" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsPendingReplyOwnWords.awk" 2>/dev/null ) | LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsPendingReplyAnswerText.awk" )"
		;;
	esac
	oneRc=0
	type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
	oneClose="$( DistroAgentsTools --intern-op-pending-reply-close "$oneId" --if-open --status reply-received ${collectQuiet:+--quiet} \
		--verdict "$collectAnswer" --answered-by "$oneBy" ${oneAnswerTs:+--answer-ts "$oneAnswerTs"} --context collect 2>/dev/null )" || oneRc=$?
	case "$oneRc" in
		0)
			collectOutcome="ANSWERED"
			printf 'ANSWERED %s %s | %s | %s\n' "$oneId" "${oneTag:--}" "$oneFirst" "$collectAnswer"
			## The answer is the reply's first line; the rest of it and every later reply are its
			## clarifications, kept on the record and the item's Decisions.
			## Its thread stays watched from the newest message read here (AgentsWaitProbeAsk).
			local oneClarify="" oneFloor=""
			oneClarify="$( printf '%s\n' "$oneBody" | ( LC_ALL=C awk -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsDismissalMatch.awk" -f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsPendingReplyOwnWords.awk" 2>/dev/null ) | LC_ALL=C awk -v answerTs="${oneAnswerTs:-$oneQts}" \
				-f "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsPendingReplyClarifications.awk" 2>/dev/null )" || oneClarify=""
			## And they come with the answer, under its line, worded as the record keeps them.
			printf '%s\n' "$oneClarify" | LC_ALL=C awk -F'\t' 'NF >= 3 { saidText = $0 ; sub( /^[^\t]*\t[^\t]*\t/, "", saidText ) ; printf "  CLARIFICATION: %s %s: %s\n", $1, $2, saidText ; }'
			oneFloor="$( printf '%s\n' "$oneBody" | LC_ALL=C awk '/^[0-9]+\.[0-9]+ \| / { ts = $1 ; } END { print ts ; }' )"
			type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
			printf '%s\n' "$oneClarify" | DistroAgentsTools --intern-op-pending-reply-clarify "$oneId" --from-stdin --follow-floor "${oneFloor:-$oneQts}" --context collect > /dev/null 2>&1 \
				|| echo "$MDSC_CMD: ⚠️ WARNING: $oneId is closed, but its clarifications were not kept" >&2
		;;
		3)
			collectOutcome="ALREADY-CLOSED"
			printf '%s\n' "$oneClose"
		;;
		*)
			collectOutcome="OPEN"
			printf 'OPEN %s %s | %s -- an answer was seen, and the close failed, so it stays open\n' "$oneId" "${oneTag:--}" "$oneFirst"
		;;
	esac
	return 0
}
