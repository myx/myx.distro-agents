#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.MemberEscalation.include -- the dispatcher of the escalation operations.
##
## Sourced with one operation word: --read-escalation, --intern-op-escalation-read,
## --readback-escalation, --answer-escalation|--manager-pending-reply-answer,
## --intern-op-escalation-permission-add, or --forward-escalation. An arm that runs an
## operation loads the escalation library (AgentsTools.Escalation.include) for the functions
## it calls, then sources the operation file that runs it; --read-escalation re-dispatches
## through DistroAgentsTools. Nothing runs here at load: a caller that wants the functions
## alone sources the library directly.
##

case "$1" in

	## The member stub. It reads threads under the named member's own credentials, so a
	## spawned session names only itself (AgentsToolsActingMemberCheck); tooling calls the
	## --intern-op-escalation-read implementation below directly.
	--read-escalation)
		[ -z "${2:-}" ] || AgentsToolsActingMemberCheck "$2" "${1#--}" || { set +e ; return 1 ; }
		type DistroAgentsTools > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh"
		DistroAgentsTools --intern-op-escalation-read "${@:2}"
		return $?
	;;

	--intern-op-escalation-read)
		type AgentsToolsEscalationField > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.Escalation.include"
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.InternOpEscalationRead.include"
	;;

	--readback-escalation)
		type AgentsToolsEscalationField > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.Escalation.include"
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.OpReadbackEscalation.include"
	;;

	--answer-escalation|--manager-pending-reply-answer)
		type AgentsToolsEscalationField > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.Escalation.include"
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.OpManagerPendingReplyAnswer.include"
	;;

	--intern-op-escalation-permission-add)
		type AgentsToolsEscalationField > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.Escalation.include"
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.InternOpEscalationPermissionAdd.include"
	;;

	--forward-escalation)
		type AgentsToolsEscalationField > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.Escalation.include"
		. "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/questions/AgentsTools.OpForwardEscalation.include"
	;;

	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid operation: $1" >&2
		set +e ; return 1
	;;

esac
