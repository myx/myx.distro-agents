#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

##
## AgentsTools.AskPost.include -- the tools that ask a person, and the post each one makes.
##
## One table names them. Every name in it runs the one ask function of the harness
## (AgentsHarnessAsk, AgentsUniversalHarness.sh) with the kind its row presets, and posts
## from its own tooling template (sh-lib/templates/, AgentsTools.ToolingTemplate.include),
## filled by AgentsAskPostFill.awk. What a post was filled with is kept beside its
## pending-reply record, so the same text is filled again later: the question asked again,
## changed, or a post that no longer takes an answer.
##
## Sourced by the harness, the MCP request handler and the pending-reply operations.
## Function-only. The tooling is reached by its script path, so every caller can use it.
##

if ! type AgentsToolsAskToolRow > /dev/null 2>&1 ; then

	type AgentsToolsToolingTemplateFill > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/comms/AgentsTools.ToolingTemplate.include"

	## One row per name: `<tool>|<kind it presets>|<template>|<answer form>|<its own parameters>`.
	## An empty answer form is taken from the call's `select`, `text` with none. A row with no
	## kind is a second name of the tools above: it takes `kind` as a parameter, and every
	## parameter, and its template is only the skeleton of its post, which shows every field
	## whatever the kind -- the title, the options, the answer lines and the emoji are those of
	## the template of the call's kind. A further tool is one more row here and one more
	## template beside the others. A proposal's template also holds the root its thread opens
	## with (`## root`): its post is the reply under that root.
	## A row with no name is a kind no tool asks: a post the tooling makes itself -- the review
	## prompt of a handback (AgentsTools.ReviewFlow.include), the prompt of a change held for
	## approval (AgentsTools.InternOpChange.include) -- named here so its record is filled again
	## as any other is.
	agentsAskTools="AskQuestion|question|ask-question.post.format.md||question options select readback understood
ConfirmReadback|readback|confirm-readback.post.format.md|confirm|question understood source will_do
EscalateDecision|decision|escalate-decision.post.format.md|one|question options readback understood
RequestPermission|permission|request-permission.post.format.md|grant|question refusal_id reason task_ref entries
ProposeApprove|proposal|propose-approve.post.format.md|approve|question proposal document task_ref
|review|review-prompt.post.format.md|verdict|
|change|change-approve.post.format.md|approve|
AskUserQuestion||ask-user-question.post.format.md||*"
	## The parameters every one of them takes.
	agentsAskCommonArgs="to address_to context wait timeout wait_source as_bot pending_id withdraw revise description"

	agentsAskRowName="" ; agentsAskRowKind="" ; agentsAskRowTemplate="" ; agentsAskRowForm="" ; agentsAskRowArgs=""

	## The row of one tool name, an `mcp__<server>__` prefix dropped. Sets agentsAskRow*; rc 1,
	## with them empty, when the name asks nothing.
	AgentsToolsAskToolRow(){ ## tool name
		local rowWant="$1"
		case "$rowWant" in mcp__*__*) rowWant="${rowWant#mcp__}" ; rowWant="${rowWant#*__}" ;; esac
		if [ -n "$rowWant" ] ; then
			while IFS='|' read -r agentsAskRowName agentsAskRowKind agentsAskRowTemplate agentsAskRowForm agentsAskRowArgs ; do
				[ "$agentsAskRowName" != "$rowWant" ] || return 0
			done <<< "$agentsAskTools"
		fi
		agentsAskRowName="" ; agentsAskRowKind="" ; agentsAskRowTemplate="" ; agentsAskRowForm="" ; agentsAskRowArgs=""
		return 1
	}

	## The row that presets one kind: the tool a question of that kind is asked with. Sets
	## agentsAskRow*; rc 1 when no tool presets it.
	AgentsToolsAskKindRow(){ ## kind
		while IFS='|' read -r agentsAskRowName agentsAskRowKind agentsAskRowTemplate agentsAskRowForm agentsAskRowArgs ; do
			[ -z "$agentsAskRowKind" ] || [ "$agentsAskRowKind" != "${1:-question}" ] || return 0
		done <<< "$agentsAskTools"
		agentsAskRowName="" ; agentsAskRowKind="" ; agentsAskRowTemplate="" ; agentsAskRowForm="" ; agentsAskRowArgs=""
		return 1
	}

	## Every name that asks, space-separated.
	AgentsToolsAskToolNames(){
		local namesOut="" namesName namesRest
		while IFS='|' read -r namesName namesRest ; do
			[ -z "$namesName" ] || namesOut="$namesOut$namesName "
		done <<< "$agentsAskTools"
		printf '%s' "${namesOut% }"
	}

	## One ask post filled from a template. The slots travel in the caller's environment:
	## ASKP_OPTIONS, ASKP_REVISED, ASKP_BLOCK, ASKP_SKELETON and ASKP_F_<slot> (AgentsAskPostFill.awk).
	AgentsToolsAskPostFill(){ ## want (post|closed|reactions|block), template file name, answer form
		ASKP_WANT="$1" ASKP_FORM="$3" AgentsToolsToolingTemplateFill "$2" questions/AgentsAskPostFill.awk
	}

	## The slots a post is filled with, as kept beside its record (`<id>.fields`): one
	## `<slot><TAB><value>` line each, a backslash doubled and a line break written `\n`.
	AgentsToolsAskPostFieldsPack(){ ## slot, value, ...
		local packValue
		while [ $# -ge 2 ] ; do
			if [ -n "$2" ] ; then
				packValue="${2//\\/\\\\}"
				printf '%s\t%s\n' "$1" "${packValue//$'\n'/\\n}"
			fi
			shift 2
		done
	}

	## One header field of a pending-reply record, or empty.
	AgentsToolsAskPostField(){ ## record file, field
		local fieldLine
		[ -f "$1" ] || return 0
		while IFS= read -r fieldLine ; do
			case "$fieldLine" in
				"$2: "*) printf '%s' "${fieldLine#"$2: "}" ; return 0 ;;
				'# '*) return 0 ;;
			esac
		done < "$1"
	}

	## The template a post takes its skeleton from where that is not its kind's own: the one of
	## a second name of the tools (a row with no kind). Prints its path, or nothing.
	AgentsToolsAskPostSkeleton(){ ## tool name as called
		local skeletonName skeletonKind skeletonTemplate skeletonRest
		while IFS='|' read -r skeletonName skeletonKind skeletonTemplate skeletonRest ; do
			[ "$skeletonName" = "${1:-}" ] || continue
			[ -n "$skeletonKind" ] || [ -z "$skeletonTemplate" ] || AgentsToolsToolingTemplate "$skeletonTemplate"
			return 0
		done <<< "$agentsAskTools"
	}

	## A post filled again from its record: the kept slots, the options and the answer form of
	## the question, under the name it was asked by (the `asked-as` slot). By default as the
	## question stands now. With `first`, as it was first asked: once a question is asked
	## again, changed, what its first post was filled with is kept aside (`<id>.first.fields`,
	## `<id>.first.options`, `first-select`), since that post never changes with it. rc 3 when
	## the record keeps no slots (a question asked before they were kept) or names no template.
	## A permission set request keeps no slots: its post is filled again from its own record,
	## the `<id>.set` beside it, by its own template (AgentsToolsPermissionSetRecordFill,
	## AgentsTools.InternOpPermission.include), and is never asked again, changed.
	AgentsToolsAskPostRecordFill(){ ## want (post|closed|reactions|block), record file, optional block `<Section>/<heading>`, optional revised (1: its title carries the revised mark, 0: never; default: when the record has a revision), optional version (first)
		local fillBase="${2%.md}" fillSelectField="select"
		if [ -f "$fillBase.set" ] && [ "$( AgentsToolsAskPostField "$2" kind )" = "permission-set" ] ; then
			(
				type AgentsToolsPermissionSetRecordFill > /dev/null 2>&1 || . "$MDLT_ORIGIN/myx/myx.distro-agents/sh-lib/grants/AgentsTools.InternOpPermission.include" || exit 3
				AgentsToolsPermissionSetRecordFill "$1" "$2" "${3:-}"
			)
			return
		fi
		if [ "${5:-}" = "first" ] && [ -f "$fillBase.first.fields" ] ; then
			fillBase="$fillBase.first" ; fillSelectField="first-select"
		fi
		[ -f "$fillBase.fields" ] || return 3
		(
			AgentsToolsAskKindRow "$( AgentsToolsAskPostField "$2" kind )" || exit 3
			ASKP_SKELETON=""
			while IFS=$'\t' read -r fillSlot fillValue ; do
				case "$fillSlot" in ''|*[!a-z_-]*) continue ;; esac
				## Never `printf -v` an empty result: bash 3.2 then leaves the buffer of the one before.
				[ -z "$fillValue" ] || printf -v fillValue '%b' "$fillValue"
				[ "$fillSlot" != "asked-as" ] || ASKP_SKELETON="$( AgentsToolsAskPostSkeleton "$fillValue" )"
				export "ASKP_F_${fillSlot//-/_}=$fillValue"
			done < "$fillBase.fields"
			ASKP_OPTIONS="" ; [ ! -f "$fillBase.options" ] || ASKP_OPTIONS="$( cat "$fillBase.options" )"
			ASKP_BLOCK="${3:-}" ASKP_REVISED="${4:-}"
			[ -n "$ASKP_REVISED" ] || [ -z "$( AgentsToolsAskPostField "$2" revision-ts )" ] || ASKP_REVISED=1
			export ASKP_OPTIONS ASKP_BLOCK ASKP_REVISED ASKP_SKELETON
			fillForm="$agentsAskRowForm" ; [ -n "$fillForm" ] || fillForm="$( AgentsToolsAskPostField "$2" "$fillSelectField" )"
			AgentsToolsAskPostFill "$1" "$agentsAskRowTemplate" "${fillForm:-text}"
		)
	}

	## The tooling's own emoji on one post, placed or taken off under the identity that posted
	## it. Never an answer: only an addressee's reaction is. A failure is logged and never fails
	## the caller. `already_reacted`, and a reaction already gone, are successes of the op.
	AgentsToolsAskPostReact(){ ## member, <channel>:<ts>, identity (bot|member), add|remove, emoji names...
		local reactMember="$1" reactAt="$2" reactAs="$3" reactDo="$4" reactDone="added" reactName reactArgs
		shift 4
		[ -n "$reactMember" ] && [ -n "$reactAt" ] || return 0
		[ "$reactDo" != "remove" ] || reactDone="removed"
		for reactName in "$@" ; do
			[ -n "$reactName" ] || continue
			reactArgs=( "$reactMember" "$reactAt" "$reactName" )
			[ "$reactAs" != "bot" ] || reactArgs=( "${reactArgs[@]}" --identity-bot )
			[ "$reactDo" != "remove" ] || reactArgs=( "${reactArgs[@]}" --remove )
			"$BASH" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh" --intern-op-comms-slack-react "${reactArgs[@]}" > /dev/null 2>&1 \
				|| echo "⚠️ WARNING: ${MDSC_CMD:-ask-post}: :$reactName: could not be $reactDone on $reactAt, which changes nothing else" >&2
		done
		return 0
	}

	## A post that no longer takes an answer: the tooling's own answer emoji are taken off it,
	## it gets one mark (a heading under `# Marks` of its template; none where no mark is named:
	## an answered question gets its own where its record closes), and, when asked, it is
	## edited to the same post without its `How to answer` part. The edit is the member send
	## itself, told to update that message (--update-ts): the same author line, text and
	## blocks the post went out with, under the same floor, so what a person sees does change
	## and any body the send took is taken again. Each step is best effort.
	AgentsToolsAskPostClose(){ ## record file, post ts, mark (superseded|cancelled; empty: none), edit (edit|empty)
		local closeFile="$1" closeTs="$2" closeMark="$3" closeEdit="${4:-}" closeOwner closeChannel closeAs closeEmoji closeText closeRevised=1 closeVersion="" closeTarget closeTo closeArgs
		closeOwner="$( AgentsToolsAskPostField "$closeFile" owner )"
		closeChannel="$( AgentsToolsAskPostField "$closeFile" channel )"
		closeAs="$( AgentsToolsAskPostField "$closeFile" ask-identity )"
		[ -n "$closeOwner" ] && [ -n "$closeChannel" ] && [ -n "$closeTs" ] || return 0
		closeEmoji="$( AgentsToolsAskPostRecordFill reactions "$closeFile" 2>/dev/null )" || closeEmoji=""
		[ -z "$closeEmoji" ] || AgentsToolsAskPostReact "$closeOwner" "$closeChannel:$closeTs" "$closeAs" remove $closeEmoji
		closeEmoji=""
		[ -z "$closeMark" ] || closeEmoji="$( AgentsToolsAskPostRecordFill block "$closeFile" "Marks/$closeMark" 2>/dev/null )" || closeEmoji=""
		[ -z "$closeEmoji" ] || AgentsToolsAskPostReact "$closeOwner" "$closeChannel:$closeTs" "$closeAs" add $closeEmoji
		[ "$closeEdit" = "edit" ] || return 0
		## The question's first post is filled as it was first asked, with no revised mark. A
		## later version is filled as the question stands, and keeps that mark in its title.
		if [ "$closeTs" = "$( AgentsToolsAskPostField "$closeFile" question-ts )" ] ; then
			closeRevised=0 ; closeVersion="first"
		fi
		closeText="$( AgentsToolsAskPostRecordFill closed "$closeFile" "" "$closeRevised" "$closeVersion" 2>/dev/null )" || closeText=""
		if [ -z "$closeText" ] ; then
			echo "⚠️ WARNING: ${MDSC_CMD:-ask-post}: the post $closeChannel:$closeTs was not edited: its text could not be filled again from its record" >&2
			return 0
		fi
		## Sent to where the question was posted: its conversation, or the thread it was asked in.
		closeTarget="$closeChannel"
		[ "$( AgentsToolsAskPostField "$closeFile" thread-ts )" = "$( AgentsToolsAskPostField "$closeFile" question-ts )" ] \
			|| closeTarget="$closeChannel:$( AgentsToolsAskPostField "$closeFile" thread-ts )"
		closeArgs=( "$closeOwner" "$closeTarget" --update-ts "$closeTs" --from-stdin )
		[ "$closeAs" != "bot" ] || closeArgs=( "${closeArgs[@]}" --identity-bot )
		closeTo="$( AgentsToolsAskPostField "$closeFile" address-to )"
		[ -z "$closeTo" ] || closeArgs=( "${closeArgs[@]}" --address-to "$closeTo" )
		printf '%s' "$closeText" | "$BASH" "$MDLT_ORIGIN/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh" --intern-op-comms-slack-send-message "${closeArgs[@]}" > /dev/null 2>&1 \
			|| echo "⚠️ WARNING: ${MDSC_CMD:-ask-post}: the post $closeChannel:$closeTs could not be edited to drop its How to answer part, which changes nothing else" >&2
		return 0
	}

fi
