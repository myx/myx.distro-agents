
##
## AgentsTools.InternOpUrlPostBytes.include -- --intern-op-url-post-bytes.
## Sourced lazily via the standard $MDLT_ORIGIN path; relies on being
## dot-sourced for $1/$@/$MDSC_CMD. No --help entry: internal plumbing.
##
## POSTs a file's bytes as the raw request body to a URL the caller was handed.
## NO credential is attached. That is structural, not a suppressed flag: this op
## is deliberately not named --intern-op-slack-*, so the dispatcher never enters
## the arm defining the Slack credential resolvers and they do not exist here.
##
## Why it is a sibling rather than a mode of --intern-op-slack-call, why the URL
## is never quoted back, and why it installs no EXIT trap are in MAGIC.md.
##
## Syntax:
##   --intern-op-url-post-bytes --url <url> --body-file <path> [--context <caller-op>]
##
## Reports two line-anchored stderr fields on every exit path, read back with
## `sed -n 's/^POST_HTTP_STATUS=//p'` exactly as the sibling ops' fields are:
##   POST_HTTP_STATUS=<code>   the HTTP status curl saw.
##   POST_BYTES=<n>            bytes SENT, the same direction UPLOAD_BYTES uses:
##                             compared against the file's size on disk, it is
##                             what separates a truncated send from a refusal.
## Measured, curl 8.7.1: a transport failure still writes the -w line, as
## `000 0`, so the fields carry that rather than `not-reported`. `000` is curl's
## own "no HTTP status was received" and cannot collide with a real status; the
## rc and the transport-failure line are what say the transfer never happened.
## `not-reported` stays the initial value, for a curl that writes nothing.
##
## The response body is this op's stdout on a 2xx, as on --intern-op-slack-call's
## API path, and is discarded on every failure path -- see the site for why.
##

case "$1" in

	--intern-op-url-post-bytes)
		shift
		local postUrl="" postBodyFile=""
		while [ $# -gt 0 ] ; do
			case "$1" in
				--url)
					## Argv on purpose, not an oversight. A Slack token travels in a header
					## file to stay out of ps because it is long-lived and reused; this URL is
					## same-user, single-use and expiring. Ruled -- do not "make it consistent"
					## with the token path by adding a --url-from-file.
					if [ -z "${2:-}" ] ; then
						echo "$MDSC_CMD: url-post-bytes: ⛔ ERROR: --url: value required" >&2
						set +e ; return 1
					fi
					postUrl="$2" ; shift 2
				;;
				--body-file)
					if [ -z "${2:-}" ] ; then
						echo "$MDSC_CMD: url-post-bytes: ⛔ ERROR: --body-file: value required (the path whose bytes become the request body)" >&2
						set +e ; return 1
					fi
					postBodyFile="$2" ; shift 2
				;;
				--context)
					if [ -z "${2:-}" ] ; then
						echo "$MDSC_CMD: url-post-bytes: ⛔ ERROR: --context: value required" >&2
						set +e ; return 1
					fi
					shift 2
				;;
				*)
					## The offending argument is NOT quoted, unlike every sibling arm:
					## a bearer URL passed as a bare positional would land in the log.
					echo "$MDSC_CMD: url-post-bytes: ⛔ ERROR: unrecognised argument. This op takes --url <url>, --body-file <path> and an optional --context <caller-op>, and nothing positional. The argument is not quoted back: a URL passed here is a bearer capability, and this op never writes one into a message or a log." >&2
					set +e ; return 1
				;;
			esac
		done

		if [ -z "$postUrl" ] ; then
			echo "$MDSC_CMD: url-post-bytes: ⛔ ERROR: --url is required -- this call names nowhere to post to." >&2
			set +e ; return 1
		fi
		if [ -z "$postBodyFile" ] ; then
			echo "$MDSC_CMD: url-post-bytes: ⛔ ERROR: --body-file is required -- this call names no bytes to post." >&2
			set +e ; return 1
		fi
		if [ ! -f "$postBodyFile" ] ; then
			echo "$MDSC_CMD: url-post-bytes: ⛔ ERROR: --body-file: no such file: $postBodyFile" >&2
			set +e ; return 1
		fi

		## https only: the request body is the file's own bytes and this op attaches
		## nothing else that would protect them in transit.
		case "$postUrl" in
			https://*) ;;
			*)
				echo "$MDSC_CMD: url-post-bytes: ⛔ ERROR: --url refused: not an https URL. Nothing was sent. The value is not quoted back: a pre-signed upload URL is a bearer capability, possession of it is authorisation, and this op never writes one into a message or a log." >&2
				set +e ; return 1
			;;
		esac

		## Body to its own temp file so the -w line is all that is left in the
		## capture -- the split --intern-op-slack-call's upload arm already uses,
		## for its own stated reason: tail is exact against curl's fixed one-line
		## format and not against a body the server shapes.
		local postBodyOut=""
		postBodyOut="$( mktemp )" || { set +e ; return 1 ; }
		chmod 600 "$postBodyOut"

		## NO EXIT trap here, deliberately. A caller's own trap is live in this
		## shell when this op runs, and installing one replaces it silently.
		## curl's own stderr is discarded rather than captured for reporting: its
		## messages can carry the URL, which this op does not put anywhere.
		local postOut="" postRc=0
		postOut="$( curl -sS --connect-timeout 10 --max-time 120 -X POST "$postUrl" \
			--data-binary "@$postBodyFile" \
			-o "$postBodyOut" -w '%{http_code} %{size_upload}' 2>/dev/null )" || postRc=$?

		local postStatus="not-reported" postBytes="not-reported"
		## Digits enumerated, never a bracket range -- see MAGIC.md.
		case "$postOut" in
			[0123456789]*" "[0123456789]*)
				postStatus="${postOut%% *}"
				postBytes="${postOut##* }"
			;;
		esac
		printf 'POST_HTTP_STATUS=%s\n' "$postStatus" >&2
		printf 'POST_BYTES=%s\n' "$postBytes" >&2

		## The body is emitted ONLY on a 2xx, and discarded on every failure path.
		## Measured: a server's own error page echoes the request URL back inside
		## the body, so printing it on failure would publish the bearer capability
		## through the payload after every diagnostic here has carefully withheld it.
		if [ "$postRc" -ne 0 ] ; then
			rm -f "$postBodyOut"
			echo "$MDSC_CMD: url-post-bytes: ⛔ ERROR: POST transport failure, curl exit status $postRc. Neither the URL nor curl's own message is quoted: the URL is a bearer capability and curl's message can carry it." >&2
			set +e ; return 1
		fi
		case "$postStatus" in
			2??) ;;
			*)
				rm -f "$postBodyOut"
				echo "$MDSC_CMD: url-post-bytes: ⛔ ERROR: POST returned HTTP $postStatus, not a 2xx -- the bytes were not accepted. The response body is discarded rather than shown: a server's error page echoes the request URL back, and that URL is a bearer capability. POST_BYTES above is what was sent." >&2
				set +e ; return 1
			;;
		esac
		cat "$postBodyOut"
		rm -f "$postBodyOut"
		return 0
	;;

esac
